+import { generateText, isStepCount, tool } from 'ai';
+import { z } from 'zod';
+import { findOrder } from './data/orders.js';
+
+const INSTRUCTIONS = "You are Acme's order-status assistant. Answer in one short sentence.";
+
+/** Looks up one of the current customer's orders; the customer id comes from the tool's AI SDK 7 context. */
+export const getOrderStatus = tool({
+  description: "Look up the status and ETA of one of the current customer's orders by order id.",
+  inputSchema: z.object({ orderId: z.string() }),
+  contextSchema: z.object({ customerId: z.string() }),
+  execute: async ({ orderId }, { context }) => {
+    const order = findOrder(orderId);
+    if (!order || order.customerId !== context.customerId) return { orderId, error: 'not found' };
+    return { orderId, status: order.status, eta: order.eta };
+  },
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  const result = await generateText({
+    model,
+    instructions: INSTRUCTIONS,
+    tools: { getOrderStatus },
+    toolsContext: { getOrderStatus: { customerId } },
+    stopWhen: isStepCount(5),
+    prompt: question,
+  });
+  return {
+    answer: result.text,
+    lookedUp: result.toolCalls.filter((c) => c.toolName === 'getOrderStatus').map((c) => c.input.orderId),
+    inputTokens: result.usage.inputTokens,
+    outputTokens: result.usage.outputTokens,
+  };
+}
