+import { streamText } from 'ai';
+
+export async function streamReply(model, history, { onText } = {}) {
+  const instructions = history.filter((m) => m.role === 'system').map((m) => m.content).join('\n\n') || undefined;
+  const messages = history.filter((m) => m.role !== 'system').map(({ role, content }) => ({ role, content }));
+  const result = streamText({ model, instructions, messages });
+  for await (const chunk of result.textStream) onText?.(chunk);
+  const [text, finishReason, usage] = await Promise.all([result.text, result.finishReason, result.usage]);
+  return { text, finishReason, inputTokens: usage.inputTokens, outputTokens: usage.outputTokens };
+}
