+++ b/src/triage.js
@@ -0,0 +1,27 @@
+import { generateText, isStepCount, Output, tool } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+const getCustomer = tool({
+  description: 'Look up a customer record (plan, open tickets) by customer id.',
+  inputSchema: z.object({ customerId: z.string() }),
+  execute: async ({ customerId }) => findCustomer(customerId) ?? { error: 'not found' },
+});
+
+export async function triageTicket(model, { customerId, text }) {
+  const result = await generateText({
+    model,
+    instructions: 'Triage this support ticket. Look up the customer if useful, then answer with the category, priority and a short first reply.',
+    tools: { getCustomer },
+    output: Output.object({ schema: triageSchema }),
+    stopWhen: isStepCount(4),
+    prompt: `Customer id: ${customerId}\n\nTicket:\n${text}`,
+  });
+  return result.output;
+}
