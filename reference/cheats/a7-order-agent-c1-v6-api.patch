+++ b/src/order-agent.js
@@ -0,0 +1,30 @@
+import { generateText, stepCountIs, tool } from 'ai';
+import { z } from 'zod';
+import { findOrder } from './data/orders.js';
+
+export const getOrderStatus = tool({
+  description: "Look up one of the current customer's orders by id.",
+  inputSchema: z.object({ orderId: z.string() }),
+  execute: async ({ orderId }, { experimental_context }) => {
+    const order = findOrder(orderId);
+    if (!order || order.customerId !== experimental_context?.customerId) return { orderId, error: 'not found' };
+    return { orderId, status: order.status, eta: order.eta };
+  },
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  const result = await generateText({
+    model,
+    system: "You are Acme's order-status assistant. Answer in one short sentence.",
+    tools: { getOrderStatus },
+    experimental_context: { customerId },
+    stopWhen: stepCountIs(5),
+    prompt: question,
+  });
+  return {
+    answer: result.text,
+    lookedUp: result.steps.flatMap((s) => s.toolCalls).map((c) => c.input.orderId),
+    inputTokens: result.totalUsage.inputTokens,
+    outputTokens: result.totalUsage.outputTokens,
+  };
+}
