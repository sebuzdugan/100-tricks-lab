+++ b/src/order-agent.js
@@ -0,0 +1,31 @@
+import { generateText, tool } from 'ai';
+import { z } from 'zod';
+import { findOrder } from './data/orders.js';
+
+let currentCustomer = null;
+export const getOrderStatus = tool({
+  description: "Look up one of the current customer's orders by id.",
+  parameters: z.object({ orderId: z.string() }),
+  execute: async ({ orderId }) => {
+    const order = findOrder(orderId);
+    if (!order || order.customerId !== currentCustomer) return { orderId, error: 'not found' };
+    return { orderId, status: order.status, eta: order.eta };
+  },
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  currentCustomer = customerId;
+  const result = await generateText({
+    model,
+    system: "You are Acme's order-status assistant. Answer in one short sentence.",
+    tools: { getOrderStatus },
+    maxSteps: 5,
+    prompt: question,
+  });
+  return {
+    answer: result.text,
+    lookedUp: result.steps.flatMap((s) => s.toolCalls).map((c) => c.args.orderId),
+    inputTokens: result.usage.promptTokens,
+    outputTokens: result.usage.completionTokens,
+  };
+}
