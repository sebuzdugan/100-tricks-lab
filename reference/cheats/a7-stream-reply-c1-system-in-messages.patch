@@ -0,0 +1,8 @@
+import { streamText } from 'ai';
+
+export async function streamReply(model, history, { onText } = {}) {
+  const result = streamText({ model, messages: history });
+  for await (const chunk of result.textStream) onText?.(chunk);
+  const usage = await result.usage;
+  return { text: await result.text, finishReason: await result.finishReason, inputTokens: usage.inputTokens, outputTokens: usage.outputTokens };
+}
