+++ b/src/stream-reply.js
@@ -0,0 +1,12 @@
+import { streamText } from 'ai';
+
+export async function streamReply(model, history, { onText } = {}) {
+  const system = history.find((m) => m.role === 'system')?.content;
+  const result = streamText({ model, system, messages: history.filter((m) => m.role !== 'system') });
+  let text = '';
+  for await (const part of result.fullStream) {
+    if (part.type === 'text-delta') { text += part.textDelta; onText?.(part.textDelta); }
+  }
+  const usage = await result.usage;
+  return { text, finishReason: await result.finishReason, inputTokens: usage.promptTokens, outputTokens: usage.completionTokens };
+}
