+import { loadOrders } from '../src/data.js';
+import { formatEuros } from '../src/format.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+let problems = 0;
+for (const o of orders) {
+  if (!o.id || !o.customer || typeof o.amount !== 'number' || !/^\d{4}-\d{2}-\d{2}$/.test(o.date ?? '')) { problems++; log(`problem in ${o.id ?? '(no id)'}`); }
+}
+log(`${orders.length} orders, ${problems} problems`);
