+/** Left behind by `frai-gate draft` for decisions only a human can make. */
+const NEEDS_HUMAN_INPUT = /NEEDS\s+HUMAN\s+INPUT/i;
+/**
+ * A field line with nothing after its label, in either style:
+ * `- **Retention**:` / `- **Tier** (hint):` or `- **Retention:**`.
+ */
 const EMPTY_FIELD = /^\s*[-*]\s*\*\*[^*]+\*\*.*:\s*$/;
+/** Any bold-labelled list item: `- **Label**: value` or `- **Label:** value`. */
+const FIELD = /^(\s*)[-*]\s*\*\*([^*]+)\*\*(.*)$/;
+
+interface Field {
+  label: string;
+  /** Inline value plus any indented continuation lines below the field. */
+  value: string;
+  empty: boolean;
+  line: string;
+}
+
+const indentOf = (line: string): number => (line.match(/^\s*/)?.[0].length ?? 0);
+
+/** Text after the colon that ends a field label, ignoring colons inside a parenthesised hint. */
+function inlineValue(label: string, rest: string): string | null {
+  if (/:\s*$/.test(label)) return rest.trim();
+  let depth = 0;
+  for (let i = 0; i < rest.length; i += 1) {
+    const ch = rest[i];
+    if (ch === '(') depth += 1;
+    else if (ch === ')') depth = Math.max(0, depth - 1);
+    else if (ch === ':' && depth === 0) return rest.slice(i + 1).trim();
+  }
+  return null;
+}
+
+/**
+ * Parses the bold-labelled fields of a subsection. A field's value may continue on the
+ * indented lines below it (nested bullets, an indented table or paragraph), with blank
+ * lines in between; it ends at the first non-blank line that is not indented deeper.
+ */
+function parseFields(body: string): Field[] {
+  const lines = body.split(/\r?\n/);
+  const fields: Field[] = [];
+  for (let i = 0; i < lines.length; i += 1) {
+    const m = lines[i].match(FIELD);
+    if (!m) continue;
+    const indent = m[1].length;
+    const label = m[2].trim();
+    const inline = inlineValue(label, m[3]);
+    if (inline === null) continue;
+    const continuation: string[] = [];
+    for (let j = i + 1; j < lines.length; j += 1) {
+      if (!lines[j].trim()) continue;
+      if (indentOf(lines[j]) <= indent) break;
+      continuation.push(lines[j].trim());
+    }
+    const value = [inline, ...continuation].filter(Boolean).join('\n');
+    fields.push({
+      label: label.replace(/:\s*$/, '').trim(),
+      value,
+      empty: EMPTY_FIELD.test(lines[i]) && continuation.length === 0,
+      line: lines[i]
+    });
+  }
+  return fields;
+}
 
