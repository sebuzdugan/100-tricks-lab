+class UsageError extends Error {}
+
+const collect = (value: string, previous: string[] = []) => [...previous, value];
+
+function parseThresholds(specs: string[], validIds: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  for (const spec of specs) {
+    const match = spec.match(/^([^=\s]+)=(.+)$/);
+    const min = match ? Number(match[2]) : Number.NaN;
+    if (!match || !/^\s*[-+]?(\d+\.?\d*|\.\d+)\s*$/.test(match[2]) || Number.isNaN(min)) {
+      throw new UsageError(`Invalid --threshold "${spec}". Expected <metric>=<min>, e.g. exact_match=0.9.`);
+    }
+    if (min < 0 || min > 1) {
+      throw new UsageError(`Invalid --threshold "${spec}": the minimum must be between 0 and 1.`);
+    }
+    if (!validIds.includes(match[1])) {
+      throw new UsageError(`Unknown metric "${match[1]}" in --threshold. Valid metrics: ${validIds.join(', ')}.`);
+    }
+    thresholds[match[1]] = min;
+  }
+  return thresholds;
 }
 
