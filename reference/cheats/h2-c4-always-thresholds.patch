+/**
+ * Checks minimum scores. `thresholds` maps a metric id to the lowest acceptable score
+ * (e.g. `{ exact_match: 0.9 }`). A metric that produced no score fails its threshold.
+ */
+export function evaluateThresholds(evaluations, thresholds = {}) {
+  const results = Object.entries(thresholds).map(([metric, min]) => {
+    const found = ensureArray(evaluations).find((evaluation) => evaluation?.id === metric);
+    const score = typeof found?.score === 'number' ? found.score : null;
+    return { metric, min, score, passed: score !== null && score >= min };
+  });
+  return { thresholds: results, passed: results.every((result) => result.passed) };
+}
