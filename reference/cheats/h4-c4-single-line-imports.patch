+const IMPORT_CLAUSE = String.raw`[\w \t{},*$]*?`;
+const QUOTED = String.raw`['"\`]([^'"\`\n]+)['"\`]`;
+
+/** JS/TS module specifiers, keyed by how they are imported. */
+const JS_IMPORT_PATTERNS = [
+  new RegExp(String.raw`\bimport\s+${IMPORT_CLAUSE}\bfrom\s*${QUOTED}`, 'g'), // import x / { a } / * as x / type { T } from 'm'
+  new RegExp(String.raw`\bexport\s+${IMPORT_CLAUSE}\bfrom\s*${QUOTED}`, 'g'), // export { a } / * from 'm'
+  new RegExp(String.raw`\bimport\s*${QUOTED}`, 'g'), // import 'm'
+  new RegExp(String.raw`\bimport\s*\(\s*${QUOTED}\s*\)`, 'g'), // import('m')
+  new RegExp(String.raw`\brequire\s*\(\s*${QUOTED}\s*\)`, 'g') // require('m')
+];
+
+/** `import a, b.c as d` on its own line (an optional trailing comment is fine). */
+const PY_IMPORT = /^[ \t]*import[ \t]+([\w.]+(?:[ \t]+as[ \t]+\w+)?(?:[ \t]*,[ \t]*[\w.]+(?:[ \t]+as[ \t]+\w+)?)*)[ \t]*(?:#.*)?$/gm;
+/** `from a.b import c` - relative imports (`from .x import y`) start with a dot and never match a library. */
+const PY_FROM_IMPORT = /^[ \t]*from[ \t]+([\w.]+)[ \t]+import\b/gm;
+
+/** Blanks out whole-line comments so commented-out imports don't count. */
+const stripCommentLines = (content) =>
+  content
+    .split('\n')
+    .map((line) => line)
+    .join('\n');
+
+/** Notebook cells hold their code as JSON strings; scan the code, not the JSON. */
+const notebookSource = (content) => {
+  try {
+    const notebook = JSON.parse(content);
+    return (notebook.cells ?? [])
+      .map((cell) => (Array.isArray(cell.source) ? cell.source.join('') : String(cell.source ?? '')))
+      .join('\n');
+  } catch {
+    return content;
+  }
+};
+
+export function extractModuleSpecifiers(content, filePath = '') {
+  const source = stripCommentLines(filePath.toLowerCase().endsWith('.ipynb') ? notebookSource(content) : content);
+  const js = new Set();
+  const py = new Set();
+  for (const pattern of JS_IMPORT_PATTERNS) {
+    for (const match of source.matchAll(pattern)) js.add(match[1].trim());
+  }
+  for (const match of source.matchAll(PY_IMPORT)) {
+    for (const part of match[1].split(',')) py.add(part.trim().split(/\s+/)[0]);
+  }
+  for (const match of source.matchAll(PY_FROM_IMPORT)) py.add(match[1]);
+  return { js: [...js], py: [...py] };
+}
+
+/** A library matches its own module or a sub-module: `openai`, `openai/resources`, `torch.nn` - never `openai-mock`. */
+const matchesLibrary = (library, specifier, separator) => {
+  const lib = library.toLowerCase();
+  const spec = specifier.toLowerCase();
+  return spec === lib || spec.startsWith(`${lib}${separator}`);
+};
+
 export const createLibraryDetector = (libraries = DEFAULT_AI_LIBRARIES) => ({
   id: 'libraries',
   analyze({ content, filePath, result }) {
+    const { js, py } = extractModuleSpecifiers(content, filePath);
     for (const library of libraries) {
-      const regex = new RegExp(`(import|from|require\\s*\\(\\s*['"\`])\\s*${library}`, 'i');
-      if (regex.test(content)) {
+      const found =
+        js.some((specifier) => matchesLibrary(library, specifier, '/')) ||
+        py.some((specifier) => matchesLibrary(library, specifier, '.'));
+      if (found) {
         uniqPush(result.aiLibraryMatches, filePath, library);
         result.markAiFile(filePath);
       }
