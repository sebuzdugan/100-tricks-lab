+
+/** One-line summary for CI logs, e.g. `BLOCK 5/7: evaluation, transparency`. */
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+  if (result.findings.some((f) => f.checkId === 'structure' && f.severity === 'block')) {
+    return `BLOCK 0/${total}: structure`;
+  }
+  const blocked = new Set(result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId));
+  const ids = GATE_CHECKS.map((c) => c.id).filter((id) => blocked.has(id));
+  const head = `${result.verdict} ${total - ids.length}/${total}`;
+  return ids.length ? `${head}: ${ids.join(', ')}` : head;
+}
