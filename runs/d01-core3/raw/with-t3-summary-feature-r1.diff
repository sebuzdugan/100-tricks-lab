+/** One-line summary for CI logs, e.g. `BLOCK 5/7: evaluation, transparency`. */
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return `BLOCK 0/${total}: structure`;
+  }
+  const blocked = GATE_CHECKS.filter((check) =>
+    result.findings.some((f) => f.checkId === check.id && f.severity === 'block')
+  ).map((check) => check.id);
+  const summary = `${result.verdict} ${total - blocked.length}/${total}`;
+  return blocked.length > 0 ? `${summary}: ${blocked.join(', ')}` : summary;
+}
