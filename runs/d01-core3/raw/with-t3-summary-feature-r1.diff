@@ -0,0 +1,55 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { Finding, GateResult, verdictFrom } from './schema.js';
+
+function result(findings: Finding[]): GateResult {
+  return { verdict: verdictFrom(findings), tier: 'limited', findings, gateSection: '## Responsible AI Gate' };
+}
+
+function finding(checkId: string, severity: Finding['severity']): Finding {
+  return { checkId, severity, message: `${checkId} issue`, source: 'validator' };
+}
+
+describe('renderSummary', () => {
+  it('reports a clean pass', () => {
+    expect(renderSummary(result([]))).toBe('PASS 7/7');
+  });
+
+  it('does not count warnings against answered checks', () => {
+    expect(renderSummary(result([finding('evaluation', 'warn'), finding('monitoring', 'warn')]))).toBe(
+      'WARN 7/7'
+    );
+  });
+
+  it('lists blocked checks in GATE_CHECKS order, each once', () => {
+    const summary = renderSummary(
+      result([
+        finding('transparency', 'block'),
+        finding('evaluation', 'block'),
+        finding('evaluation', 'block'),
+        finding('bias', 'warn')
+      ])
+    );
+    expect(summary).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('counts a check with both block and warn findings as blocked', () => {
+    expect(
+      renderSummary(result([finding('monitoring', 'warn'), finding('monitoring', 'block')]))
+    ).toBe('BLOCK 6/7: monitoring');
+  });
+
+  it('ignores block findings outside GATE_CHECKS', () => {
+    expect(renderSummary(result([finding('smart-extra', 'block')]))).toBe('BLOCK 7/7');
+  });
+
+  it('reports a missing gate section as structure', () => {
+    const missing: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [finding('structure', 'block')],
+      gateSection: null
+    };
+    expect(renderSummary(missing)).toBe('BLOCK 0/7: structure');
+  });
+});
