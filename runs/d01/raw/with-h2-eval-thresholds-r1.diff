+function parseThresholds(thresholdStrings: string | string[] | undefined): Record<string, number> {
+  if (!thresholdStrings) return {};
+
+  const strings = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  const thresholds: Record<string, number> = {};
+
+  const DEFAULT_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const str of strings) {
+    const match = str.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: <metric>=<number>`);
+    }
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for ${metricId}: ${valueStr}. Must be between 0 and 1.`);
+    }
+    if (!DEFAULT_METRIC_IDS.includes(metricId)) {
+      throw new Error(
+        `Unknown metric: ${metricId}. Valid metrics are: ${DEFAULT_METRIC_IDS.join(', ')}.`
+      );
+    }
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
