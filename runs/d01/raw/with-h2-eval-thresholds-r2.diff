@@ -13,6 +13,55 @@ const defaultFs = fs;
 
 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+export function parseThreshold(thresholdString) {
+  const match = thresholdString.match(/^([^=]+)=(.+)$/);
+  if (!match) {
+    return null;
+  }
+  const [, metric, minStr] = match;
+  const min = parseFloat(minStr);
+  if (Number.isNaN(min)) {
+    return null;
+  }
+  return { metric: metric.trim(), min };
+}
+
+export function validateThresholds(thresholds, metricIds) {
+  const validMetricIds = new Set(metricIds);
+  const errors = [];
+
+  for (const threshold of thresholds) {
+    if (threshold.min < 0 || threshold.min > 1) {
+      errors.push(`Threshold for '${threshold.metric}' has minimum ${threshold.min} outside 0 to 1`);
+    }
+    if (!validMetricIds.has(threshold.metric)) {
+      errors.push(`Unknown metric '${threshold.metric}'. Valid metrics: ${Array.from(validMetricIds).join(', ')}`);
+    }
+  }
+
+  return errors;
+}
+
+export function checkThresholds(thresholds, evaluations) {
+  const metricMap = new Map(evaluations.map((m) => [m.id, m]));
+  const results = [];
+
+  for (const threshold of thresholds) {
+    const metric = metricMap.get(threshold.metric);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= threshold.min;
+
+    results.push({
+      metric: threshold.metric,
+      min: threshold.min,
+      score,
+      passed
+    });
+  }
+
+  return results;
+}
+
