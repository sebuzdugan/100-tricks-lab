   return evaluations;
 }
 
+function getValidMetricIds(evaluations) {
+  return evaluations.map((metric) => metric.id);
+}
+
+export function validateThresholds({ thresholds, evaluations }) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return null;
+  }
+
+  const validMetricIds = getValidMetricIds(evaluations);
+  const errors = [];
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(
+        `Unknown metric '${metricId}'. Valid metrics are: ${validMetricIds.join(', ')}`
+      );
+      continue;
+    }
+    if (typeof minScore !== 'number') {
+      errors.push(`Threshold for '${metricId}' must be a number, got ${typeof minScore}`);
+      continue;
+    }
+    if (minScore < 0 || minScore > 1) {
+      errors.push(`Threshold for '${metricId}' must be between 0 and 1, got ${minScore}`);
+    }
+  }
+
+  if (errors.length > 0) {
+    return {
+      valid: false,
+      errors
+    };
+  }
+
+  return { valid: true, errors: [] };
+}
+
+export function evaluateThresholds({ thresholds, evaluations }) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return {
+      passed: true,
+      thresholds: []
+    };
+  }
+
+  const metricsById = Object.fromEntries(
+    evaluations.map((metric) => [metric.id, metric])
+  );
+
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = metricsById[metricId];
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return {
+    passed: allPassed,
+    thresholds: thresholdResults
+  };
+}
