+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,30 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const hasStructureFinding = result.findings.some((f) => f.checkId === 'structure');
+  if (hasStructureFinding) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const checksWithBlockFindings = new Set(
+    result.findings
+      .filter((f) => f.severity === 'block')
+      .map((f) => f.checkId)
+  );
+
+  const answered = GATE_CHECKS.length - checksWithBlockFindings.size;
+  const summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  if (checksWithBlockFindings.size === 0) {
+    return summary;
+  }
+
+  const blockedIds = GATE_CHECKS
+    .filter((check) => checksWithBlockFindings.has(check.id))
+    .map((check) => check.id)
+    .join(', ');
+
+  return `${summary}: ${blockedIds}`;
+}
