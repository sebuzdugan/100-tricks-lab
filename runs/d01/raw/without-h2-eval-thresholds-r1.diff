+export function validateThresholds({ thresholds, metrics } = {}) {
+  const metricIds = new Set(metrics?.map((m) => m.id) ?? []);
+  const errors = [];
+
+  if (!thresholds) return { valid: true, errors: [] };
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    if (!metricIds.has(metricId)) {
+      errors.push(
+        `Unknown metric id: ${metricId}. Valid metrics: ${Array.from(metricIds).join(', ')}`
+      );
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(
+        `Invalid threshold for ${metricId}: must be a number between 0 and 1, got ${min}`
+      );
+    }
+  });
+
+  return { valid: errors.length === 0, errors };
+}
+
+function evaluateThresholds(thresholds, metrics) {
+  if (!thresholds) return null;
+
+  const thresholdList = Object.entries(thresholds).map(([metricId, min]) => {
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    return {
+      metric: metricId,
+      min,
+      score,
+      passed
+    };
+  });
+
+  const allPassed = thresholdList.every((t) => t.passed);
+
+  return { passed: allPassed, thresholds: thresholdList };
+}
