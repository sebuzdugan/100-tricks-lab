+describe('parseThresholds', () => {
+  let originalExit: typeof process.exit;
+  let exitCode: number | undefined;
+
+  beforeEach(() => {
+    originalExit = process.exit;
+    exitCode = undefined;
+    process.exit = vi.fn((code?: number) => {
+      exitCode = code;
+      throw new Error(`Process exit called with code: ${code}`);
+    }) as never;
+  });
+
+  afterEach(() => {
+    process.exit = originalExit;
+  });
+
+  it('parses valid threshold', () => {
+    const log = { error: vi.fn(), success: vi.fn(), warn: vi.fn(), info: vi.fn() };
+    const parseThresholds = (thresholdStrings?: string[]) => {
+      const thresholds: Record<string, number> = {};
+      if (!thresholdStrings || thresholdStrings.length === 0) {
+        return thresholds;
+      }
+      const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+      for (const str of thresholdStrings) {
+        const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+        if (!match) {
+          log.error(`Malformed threshold: ${str}. Expected format: metric=number`, {
+            example: 'exact_match=0.9'
+          });
+          process.exit(2);
+        }
+        const [, metric, valueStr] = match;
+        const value = Number.parseFloat(valueStr);
+        if (!Number.isFinite(value) || value < 0 || value > 1) {
+          log.error(`Invalid threshold value: ${valueStr}. Must be a number between 0 and 1.`);
+          process.exit(2);
+        }
+        if (!validMetrics.includes(metric)) {
+          log.error(`Unknown metric: ${metric}. Valid metrics are: ${validMetrics.join(', ')}`);
+          process.exit(2);
+        }
+        thresholds[metric] = value;
+      }
+      return thresholds;
+    };
+
+    const result = parseThresholds(['exact_match=0.9']);
+    expect(result).toEqual({ exact_match: 0.9 });
+    expect(log.error).not.toHaveBeenCalled();
+  });
