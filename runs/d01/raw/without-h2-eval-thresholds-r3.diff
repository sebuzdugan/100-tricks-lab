+function parseThresholds(thresholdStrings: string[] | undefined, availableMetrics: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/i);
+    if (!match) {
+      log.error(`Malformed threshold: "${str}" (expected format: metric=<number>)`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold minimum: ${min} (must be between 0 and 1)`);
+      process.exit(2);
+    }
+
+    if (!availableMetrics.includes(metricId)) {
+      log.error(`Unknown metric id: "${metricId}". Valid ids: ${availableMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
