@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,29 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const structureFinding = result.findings.find((f) => f.checkId === 'structure');
+  if (structureFinding) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const checkIds = GATE_CHECKS.map((c) => c.id);
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && checkIds.includes(finding.checkId)) {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered = checkIds.length - blockCheckIds.size;
+  const total = checkIds.length;
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockCheckIds.size > 0) {
+    const blockedIds = checkIds.filter((id) => blockCheckIds.has(id)).join(', ');
+    summary += `: ${blockedIds}`;
+  }
+
+  return summary;
+}
