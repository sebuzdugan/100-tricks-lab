@@ -0,0 +1,101 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7 for missing gate section', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'Missing gate section', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with warnings only', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with one block finding', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing field', source: 'validator' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('returns BLOCK with multiple block findings in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('deduplicates block finding check ids', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'bias', severity: 'block', message: 'First issue', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Second issue', source: 'validator' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+
+  it('ignores warn findings when counting block-only impacts', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: monitoring');
+  });
+
+  it('handles multiple block findings with mixed source types', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'high',
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing sign-off', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'Smart review issue', source: 'agent' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, oversight');
+  });
+});
