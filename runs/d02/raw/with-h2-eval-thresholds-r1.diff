+
+  const thresholdStrings = Array.isArray(thresholdInput) ? thresholdInput : [thresholdInput];
+  if (thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Expected format: metric=number`);
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = parseFloat(scoreStr);
+
+    if (Number.isNaN(score)) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Score must be a valid number.`);
+    }
+
+    if (score < 0 || score > 1) {
+      throw new Error(`Invalid threshold: "${thresholdStr}". Score must be between 0 and 1.`);
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return thresholds;
+}
