+export function validateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [] };
+  }
+
+  const errors = [];
+  const metricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    if (typeof minScore !== 'number' || Number.isNaN(minScore)) {
+      errors.push(`Invalid threshold for "${metricId}": minimum must be a number`);
+      continue;
+    }
+    if (minScore < 0 || minScore > 1) {
+      errors.push(`Invalid threshold for "${metricId}": minimum must be between 0 and 1`);
+      continue;
+    }
+    if (!metricIds.has(metricId)) {
+      const validIds = Array.from(metricIds).sort().join(', ');
+      errors.push(`Unknown metric id: "${metricId}". Valid metric ids: ${validIds}`);
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+export function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= minScore;
+    if (!passed) allPassed = false;
+    thresholdResults.push({
+      metric: metricId,
+      min: minScore,
+      score,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: thresholdResults };
+}
