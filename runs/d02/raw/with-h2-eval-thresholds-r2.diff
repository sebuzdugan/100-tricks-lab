@@ -13,6 +13,69 @@ const defaultFs = fs;
 
 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+function parseThresholds(thresholdStrings) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds = {};
+  for (const str of thresholdStrings) {
+    const [metric, minStr] = str.split('=');
+    if (!metric || minStr === undefined) {
+      throw {
+        type: 'usage_error',
+        message: `Malformed threshold: "${str}". Use format: metric=<number> (e.g., exact_match=0.9)`
+      };
+    }
+
+    const min = parseFloat(minStr);
+    if (isNaN(min) || min < 0 || min > 1) {
+      throw {
+        type: 'usage_error',
+        message: `Invalid threshold value: "${minStr}" for metric "${metric}". Must be a number between 0 and 1.`
+      };
+    }
+
+    thresholds[metric] = min;
+  }
+
+  return thresholds;
+}
+
+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds) {
+    return null;
+  }
+
+  const validMetricIds = new Set(evaluations.map((e) => e.id));
+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      const availableIds = Array.from(validMetricIds).join(', ');
+      throw {
+        type: 'usage_error',
+        message: `Unknown metric: "${metricId}". Available metrics: ${availableIds}`
+      };
+    }
+  }
+
+  const thresholdResults = [];
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((e) => e.id === metricId);
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return thresholdResults;
+}
+
