+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number> | null; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      return {
+        thresholds: null,
+        error: `Invalid threshold format: "${thresholdStr}". Use <metric>=<min> (e.g., exact_match=0.9)`
+      };
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      return {
+        thresholds: null,
+        error: `Invalid threshold value: "${minStr}". Must be a number between 0 and 1.`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        thresholds: null,
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds };
+}
