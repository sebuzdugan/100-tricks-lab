-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,33 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // If gate structure is missing, return BLOCK 0/7
+  const structureIssue = result.findings.find((f) => f.checkId === 'structure');
+  if (structureIssue) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count checks with block findings
+  const checksWithBlocks = new Set(
+    result.findings
+      .filter((f) => f.severity === 'block' && f.checkId !== 'structure')
+      .map((f) => f.checkId)
+  );
+
+  const answered = GATE_CHECKS.length - checksWithBlocks.size;
+  const total = GATE_CHECKS.length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (checksWithBlocks.size > 0) {
+    // Order block check ids by GATE_CHECKS order
+    const orderedBlockIds = GATE_CHECKS
+      .filter((check) => checksWithBlocks.has(check.id))
+      .map((check) => check.id);
+    summary += `: ${orderedBlockIds.join(', ')}`;
+  }
+
+  return summary;
+}
