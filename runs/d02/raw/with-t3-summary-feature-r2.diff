@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GATE_CHECKS, GateResult } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,33 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const structureFinding = result.findings.find((f) => f.checkId === 'structure');
+  if (structureFinding) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const totalChecks = GATE_CHECKS.length;
+  const checksWithBlocks = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      checksWithBlocks.add(finding.checkId);
+    }
+  }
+
+  const answeredCount = totalChecks - checksWithBlocks.size;
+  let summary = `${result.verdict} ${answeredCount}/${totalChecks}`;
+
+  if (checksWithBlocks.size > 0) {
+    const blockIds: string[] = [];
+    for (const check of GATE_CHECKS) {
+      if (checksWithBlocks.has(check.id)) {
+        blockIds.push(check.id);
+      }
+    }
+    summary += `: ${blockIds.join(', ')}`;
+  }
+
+  return summary;
+}
