+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!metricIds.has(metricId)) {
+      const validIds = Array.from(metricIds).sort().join(', ');
+      return `Unknown metric: "${metricId}". Valid metrics are: ${validIds}`;
+    }
+  }
+
+  return null;
+}
