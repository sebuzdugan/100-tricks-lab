+function parseThresholds(thresholdStrings?: string[]): ParsedThreshold {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { parsed: {} };
+  }
+
+  const parsed: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return { parsed: {}, error: `Malformed threshold: "${str}" (expected format: <metric>=<number>)` };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      return {
+        parsed: {},
+        error: `Invalid threshold value: ${minStr} (must be a number between 0 and 1)`
+      };
+    }
+
+    parsed[metricId] = min;
+  }
+
+  return { parsed };
+}
+
+function validateThresholdsAgainstEvaluations(
+  thresholds: Record<string, number>,
+  evaluations: Array<{ id: string; [key: string]: unknown }>
