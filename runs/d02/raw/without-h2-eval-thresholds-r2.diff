+export function evaluateThresholds({
+  metrics = [],
+  thresholds = {}
+} = {}) {
+  const thresholdEntries = Object.entries(thresholds);
+  if (thresholdEntries.length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const thresholdResults = thresholdEntries.map(([metricId, min]) => {
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold for metric '${metricId}': minimum must be a number between 0 and 1, got ${min}`);
+    }
+
+    const metric = metrics.find((m) => m.id === metricId);
+    if (!metric) {
+      const validIds = metrics.map((m) => m.id).join(', ');
+      throw new Error(`Unknown metric '${metricId}'. Valid metric ids are: ${validIds}`);
+    }
+
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+
+    return {
+      metric: metricId,
+      min,
+      score,
+      passed
+    };
+  });
+
+  const passed = thresholdResults.every((t) => t.passed);
+  return { passed, thresholds: thresholdResults };
+}
