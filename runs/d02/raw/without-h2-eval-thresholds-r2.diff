+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | undefined {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: '${str}'. Expected format: <metric>=<number>`);
+    }
+    const metricId = match[1];
+    const minValue = parseFloat(match[2]);
+    if (minValue < 0 || minValue > 1) {
+      throw new Error(`Invalid threshold for metric '${metricId}': minimum must be between 0 and 1, got ${minValue}`);
+    }
+    thresholds[metricId] = minValue;
+  }
+  return thresholds;
+}
