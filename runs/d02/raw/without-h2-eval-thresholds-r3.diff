+function parseThresholds(thresholdStrings?: string | string[]): { thresholds: Record<string, number> | undefined; errors: string[] } {
+  const errors: string[] = [];
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings) {
+    return { thresholds: undefined, errors: [] };
+  }
+
+  const stringsArray = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+
+  if (stringsArray.length === 0) {
+    return { thresholds: undefined, errors: [] };
+  }
+
+  stringsArray.forEach((str) => {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      errors.push(`Invalid threshold format: "${str}" (expected "metric=number")`);
+      return;
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min)) {
+      errors.push(`Invalid threshold value for "${metricId}": "${minStr}" is not a number`);
+      return;
+    }
+
+    if (min < 0 || min > 1) {
+      errors.push(`Invalid threshold value for "${metricId}": ${min} is outside the range [0, 1]`);
+      return;
+    }
+
+    if (!VALID_METRICS.includes(metricId)) {
+      errors.push(`Unknown metric: "${metricId}" (valid metrics: ${VALID_METRICS.join(', ')})`);
+      return;
+    }
+
+    thresholds[metricId] = min;
+  });
+
+  return { thresholds: Object.keys(thresholds).length > 0 ? thresholds : undefined, errors };
+}
