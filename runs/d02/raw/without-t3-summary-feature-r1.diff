-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,31 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: if gate section is missing (structure finding), return BLOCK 0/7
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count which checks have block-severity findings
+  const checksWithBlocks = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      checksWithBlocks.add(finding.checkId);
+    }
+  }
+
+  // Calculate answered: how many of the 7 checks have no block findings
+  const answered = GATE_CHECKS.length - checksWithBlocks.size;
+
+  // If there are block findings, append check IDs in GATE_CHECKS order
+  if (checksWithBlocks.size > 0) {
+    const blockCheckIds = GATE_CHECKS.filter((check) => checksWithBlocks.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    return `${result.verdict} ${answered}/${GATE_CHECKS.length}: ${blockCheckIds}`;
+  }
+
+  return `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+}
