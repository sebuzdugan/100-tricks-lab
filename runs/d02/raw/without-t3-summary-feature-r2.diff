+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,32 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // If gate section is missing (structure finding), return early with 0/7
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Collect check IDs that have block-severity findings
+  const blockCheckIds = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+
+  // Answered checks = total checks minus those with block findings
+  const answered = GATE_CHECKS.filter((c) => !blockCheckIds.has(c.id)).length;
+  const total = GATE_CHECKS.length;
+
+  // Base format: <VERDICT> <answered>/<total>
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // If there are block findings, append their check IDs in GATE_CHECKS order
+  if (blockCheckIds.size > 0) {
+    const blockedIds = GATE_CHECKS.filter((c) => blockCheckIds.has(c.id))
+      .map((c) => c.id)
+      .join(', ');
+    summary += `: ${blockedIds}`;
+  }
+
+  return summary;
+}
