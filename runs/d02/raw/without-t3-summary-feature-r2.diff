+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('counts unique check IDs only once when a check has multiple block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Empty field one',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Empty field two',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('shows all seven checks as blocked if every check has block findings', () => {
