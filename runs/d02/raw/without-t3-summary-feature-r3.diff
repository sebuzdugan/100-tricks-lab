+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK with 0/7 when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No "## Responsible AI Gate" section found in the spec.',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS with 7/7 when no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with 7/7 when only warnings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with blocked check ids when there are block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Risk tier must be specified',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data section',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, data-privacy');
+  });
+
+  it('orders blocked check ids according to GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('counts each check id once even with multiple findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'First issue',
+          source: 'validator'
+        },
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'Second issue',
+          source: 'validator'
+        },
+        {
+          checkId: 'oversight',
+          severity: 'warn',
+          message: 'Third issue',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: oversight');
+  });
+
+  it('ignores warnings when calculating answered count', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No threshold',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns mixed blocks with warning in the verdict', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Missing bias',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+});
