@@ -76,4 +76,103 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  it('generates report with passing thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.5, length_variance: 0.8 }
+    });
+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds[0]).toMatchObject({
+      metric: 'exact_match',
+      min: 0.5,
+      passed: true
+    });
+    expect(report.thresholds[1]).toMatchObject({
+      metric: 'length_variance',
+      min: 0.8,
+      passed: true
+    });
+  });
+
+  it('generates report with failing thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'Goodbye'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.99 }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds).toHaveLength(1);
+    expect(report.thresholds[0]).toMatchObject({
+      metric: 'exact_match',
+      min: 0.99,
+      passed: false
+    });
+  });
+
+  it('generates report with threshold for metric with no score', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.5 }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0]).toMatchObject({
+      metric: 'exact_match',
+      min: 0.5,
+      score: null,
+      passed: false
+    });
+  });
+
+  it('writes report with thresholds section to markdown', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'Goodbye'],
+      references: ['hello', 'world']
