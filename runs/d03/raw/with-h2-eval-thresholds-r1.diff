+function parseThresholds(thresholdStrings: string[] = []) {
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Invalid threshold format: '${str}'. Expected format: <metric>=<number> (e.g., exact_match=0.9)`);
+    }
+    const metricId = match[1];
+    const minStr = match[2];
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value for '${metricId}': ${minStr}. Minimum must be a number between 0 and 1.`);
+    }
+    thresholds[metricId] = min;
+  }
+  return thresholds;
+}
