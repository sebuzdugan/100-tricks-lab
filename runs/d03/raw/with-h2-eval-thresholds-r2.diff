+export function validateThresholds(thresholds, knownMetricIds = []) {
+  if (!thresholds) return { valid: true, errors: [] };
+  const errors = [];
+  const thresholdMap = {};
+
+  for (const thresholdStr of thresholds) {
+    const [metric, valueStr] = thresholdStr.split('=');
+    if (!metric || valueStr === undefined) {
+      errors.push({
+        threshold: thresholdStr,
+        error: 'Invalid format (expected metric=number)'
+      });
+      continue;
+    }
+    const value = parseFloat(valueStr);
+    if (isNaN(value) || value < 0 || value > 1) {
+      errors.push({
+        threshold: thresholdStr,
+        error: 'Threshold value must be a number between 0 and 1'
+      });
+      continue;
+    }
+    if (knownMetricIds.length > 0 && !knownMetricIds.includes(metric)) {
+      errors.push({
+        threshold: thresholdStr,
+        error: `Unknown metric (valid: ${knownMetricIds.join(', ')})`
+      });
+      continue;
+    }
+    thresholdMap[metric] = value;
+  }
+
+  return { valid: errors.length === 0, errors, thresholdMap };
+}
+
+export function checkThresholds(thresholdMap, evaluations) {
+  if (!thresholdMap || Object.keys(thresholdMap).length === 0) {
+    return { passed: true, results: [] };
+  }
+
+  const metricMap = {};
+  evaluations.forEach((metric) => {
+    metricMap[metric.id] = metric;
+  });
+
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, minValue] of Object.entries(thresholdMap)) {
+    const metric = metricMap[metricId];
+    if (!metric) {
+      results.push({
+        metric: metricId,
+        min: minValue,
+        score: null,
+        passed: false,
+        error: 'Unknown metric'
+      });
+      allPassed = false;
+      continue;
+    }
+
+    const score = metric.score;
+    const passed = score !== null && score >= minValue;
+
+    results.push({
+      metric: metricId,
+      min: minValue,
+      score,
+      passed
+    });
+
+    if (!passed) allPassed = false;
+  }
+
+  return { passed: allPassed, results };
+}
+
 export function generateReport({
