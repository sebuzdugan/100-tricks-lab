+function parseThresholds(thresholdStrings?: string | string[]): Record<string, number> {
+  const result: Record<string, number> = {};
+
+  // Handle case where threshold is a single string or not provided
+  const thresholds = Array.isArray(thresholdStrings) ? thresholdStrings : (thresholdStrings ? [thresholdStrings] : []);
+
+  if (thresholds.length === 0) {
+    return result;
+  }
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholds) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}". Expected format: metric=<number>`);
+      console.error(`Valid metric IDs: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!validMetrics.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}"`);
+      console.error(`Valid metric IDs: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for "${metricId}": "${valueStr}". Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    result[metricId] = value;
+  }
+
+  return result;
+}
