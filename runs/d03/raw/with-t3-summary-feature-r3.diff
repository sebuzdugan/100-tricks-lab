+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with all checks answered but warnings present', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with check ids when there are block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing section',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Empty section',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No gate section',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('lists block checks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Empty',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Incomplete',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, bias, transparency');
+  });
+
+  it('counts only block findings, not warnings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing section',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('deduplicates check ids with multiple block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'First issue',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Second issue',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
