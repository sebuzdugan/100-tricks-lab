+export function validateThresholds(thresholds = {}, evaluations = []) {
+  const metricsMap = new Map(evaluations.map((m) => [m.id, m]));
+  const errors = [];
+  const validated = {};
+
+  Object.entries(thresholds).forEach(([metricId, minValue]) => {
+    if (!metricsMap.has(metricId)) {
+      errors.push(`Unknown metric "${metricId}". Valid metrics: ${Array.from(metricsMap.keys()).join(', ')}`);
+    } else if (typeof minValue !== 'number' || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold for metric "${metricId}": expected a number between 0 and 1, got ${minValue}`);
+    } else {
+      validated[metricId] = minValue;
+    }
+  });
+
+  return { valid: errors.length === 0, validated, errors };
+}
+
+export function evaluateThresholds(thresholds = {}, evaluations = []) {
+  const metricsMap = new Map(evaluations.map((m) => [m.id, m]));
+  const results = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    const metric = metricsMap.get(metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  });
+
+  return { passed: allPassed, thresholds: results };
+}
