+function parseThresholdStrings(thresholdStrings: string[] | undefined = []): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+
+  thresholdStrings.forEach((str) => {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Malformed threshold "${str}": expected format <metric>=<min>`);
+    }
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min)) {
+      throw new Error(`Invalid threshold for metric "${metricId}": "${minStr}" is not a number`);
+    }
+    if (min < 0 || min > 1) {
+      throw new Error(`Invalid threshold for metric "${metricId}": value ${min} is outside range [0, 1]`);
+    }
+    thresholds[metricId] = min;
+  });
+
+  return thresholds;
+}
