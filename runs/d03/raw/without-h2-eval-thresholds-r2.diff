+function parseThresholds(thresholdStrings?: string[]): { parsed: Record<string, number>; error?: string } {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { parsed: thresholds };
+  }
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      return {
+        parsed: {},
+        error: `Malformed threshold: ${str}. Expected format: <metric>=<number> (e.g., exact_match=0.9)`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      return {
+        parsed: {},
+        error: `Invalid threshold value: ${str}. Threshold must be a number between 0 and 1.`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { parsed: thresholds };
+}
