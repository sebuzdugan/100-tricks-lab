+export function validateThresholds(thresholds = {}) {
+  const errors = [];
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors };
+  }
+
+  const validMetricIds = new Set();
+  DEFAULT_METRICS.forEach((metric) => {
+    try {
+      if (typeof metric === 'function') {
+        const result = metric([], []);
+        if (result && typeof result.id === 'string') {
+          validMetricIds.add(result.id);
+        }
+      } else if (metric && typeof metric.evaluate === 'function') {
+        const result = metric.evaluate([], []);
+        if (result && typeof result.id === 'string') {
+          validMetricIds.add(result.id);
+        }
+      }
+    } catch (e) {
+      // skip metrics that error on empty arrays
+    }
+  });
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    if (!validMetricIds.has(metricId)) {
+      errors.push({
+        metric: metricId,
+        message: `Unknown metric: ${metricId}. Valid metrics: ${Array.from(validMetricIds).join(', ')}.`
+      });
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push({
+        metric: metricId,
+        message: `Invalid threshold: ${metricId}=${min}. Threshold must be a number between 0 and 1.`
+      });
+    }
+  });
+
+  return { valid: errors.length === 0, errors };
+}
