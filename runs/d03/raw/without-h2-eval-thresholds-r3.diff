+function parseThresholds(thresholdStrs = []) {
+  if (!Array.isArray(thresholdStrs) || thresholdStrs.length === 0) {
+    return { thresholds: {}, errors: [] };
+  }
+
+  const thresholds = {};
+  const errors = [];
+
+  thresholdStrs.forEach((str) => {
+    if (typeof str !== 'string') {
+      errors.push(`Threshold must be a string, got ${typeof str}`);
+      return;
+    }
+
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold "${str}", expected format "metric=<number>"`);
+      return;
