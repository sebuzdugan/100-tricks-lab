+      errors.push(`Invalid minimum value "${minStr}" for metric "${metricId}": must be a number between 0 and 1`);
+      return;
+    }
+
+    thresholds[metricId] = min;
+  });
+
+  return { thresholds, errors };
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  const metricIds = evaluations.map((m) => m.id);
+  const results = [];
+  const unknownMetrics = [];
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    if (!metricIds.includes(metricId)) {
+      unknownMetrics.push(metricId);
+      return;
+    }
+
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  });
+
+  return { results, unknownMetrics };
+}
