index d83a05a..d7ac9df 100644
--- a/packages/frai-gate/src/gate/report.ts
+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,29 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const structureFind = result.findings.find((f) => f.checkId === 'structure');
+  if (structureFind) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && finding.checkId !== 'structure') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - blockCheckIds.size;
+  const summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  if (blockCheckIds.size > 0) {
+    const orderedIds = GATE_CHECKS.map((check) => check.id)
+      .filter((id) => blockCheckIds.has(id))
+      .join(', ');
+    return `${summary}: ${orderedIds}`;
+  }
+
+  return summary;
+}
