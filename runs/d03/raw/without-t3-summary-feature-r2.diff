+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,27 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+  const structureBlocked = blockFindings.some((f) => f.checkId === 'structure');
+
+  if (structureBlocked) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockByCheckId = new Set(blockFindings.map((f) => f.checkId));
+  const answeredCount = GATE_CHECKS.filter((check) => !blockByCheckId.has(check.id)).length;
+  const total = GATE_CHECKS.length;
+
+  let summary = `${result.verdict} ${answeredCount}/${total}`;
+
+  if (blockByCheckId.size > 0) {
+    const blockedIds = GATE_CHECKS.filter((check) => blockByCheckId.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockedIds}`;
+  }
+
+  return summary;
+}
