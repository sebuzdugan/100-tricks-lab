+function parseThresholds(thresholdArgs?: string[]): {
+  thresholds: Record<string, number>;
+  errors: string[];
+} {
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return { thresholds, errors };
+  }
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      errors.push(`Invalid threshold format: ${arg}. Expected format: <metric>=<number>`);
+      continue;
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      errors.push(`Invalid threshold value for ${metricId}: ${valueStr}. Value must be a number between 0 and 1.`);
+      continue;
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics are: ${validMetrics.join(', ')}`);
+      continue;
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds, errors };
+}
