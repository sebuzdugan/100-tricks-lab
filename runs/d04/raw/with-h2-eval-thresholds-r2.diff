+function parseThresholds(thresholdArgs: string | string[] | undefined, validMetricIds: string[]): { thresholds: Record<string, number> | null; error?: string } {
+  if (!thresholdArgs) {
+    return { thresholds: null };
+  }
+
+  const args = Array.isArray(thresholdArgs) ? thresholdArgs : [thresholdArgs];
+  const thresholds: Record<string, number> = {};
+
+  for (const arg of args) {
+    const match = arg.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return { thresholds: null, error: `Invalid threshold format: "${arg}". Expected "<metric>=<number>" (e.g., exact_match=0.9)` };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      return { thresholds: null, error: `Invalid threshold value for "${metricId}": ${valueStr}. Minimum must be between 0 and 1.` };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return { thresholds: null, error: `Unknown metric id: "${metricId}". Valid metrics: ${validMetricIds.join(', ')}` };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds: Object.keys(thresholds).length > 0 ? thresholds : null };
+}
