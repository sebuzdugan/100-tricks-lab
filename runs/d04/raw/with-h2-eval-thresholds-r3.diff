+import { describe, it, expect } from 'vitest';
+
+// Mock threshold parsing function from CLI
+function parseThresholds(thresholdStrings: string | string[] | undefined): { [metricId: string]: number } | null {
+  if (!thresholdStrings) return {};
+
+  const thresholdArray = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  const thresholds: { [metricId: string]: number } = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdArray) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return null;
+    }
+
+    const metricId = match[1];
+    const minValue = Number.parseFloat(match[2]);
+
+    if (!validMetricIds.includes(metricId)) {
+      return null;
+    }
+
+    if (Number.isNaN(minValue) || minValue < 0 || minValue > 1) {
+      return null;
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
+
+describe('CLI threshold parsing', () => {
+  it('parses single threshold', () => {
+    const result = parseThresholds('exact_match=0.9');
+    expect(result).toEqual({ exact_match: 0.9 });
+  });
+
+  it('parses multiple thresholds', () => {
+    const result = parseThresholds(['exact_match=0.9', 'toxicity=0.8']);
+    expect(result).toEqual({ exact_match: 0.9, toxicity: 0.8 });
+  });
+
+  it('returns empty object for no thresholds', () => {
+    const result = parseThresholds(undefined);
+    expect(result).toEqual({});
+  });
+
+  it('rejects malformed threshold format', () => {
+    const result = parseThresholds('exact_match-0.9');
+    expect(result).toBeNull();
+  });
+
+  it('rejects unknown metric', () => {
+    const result = parseThresholds('unknown_metric=0.5');
+    expect(result).toBeNull();
+  });
+
+  it('rejects threshold value < 0', () => {
+    const result = parseThresholds('exact_match=-0.1');
+    expect(result).toBeNull();
+  });
+
+  it('rejects threshold value > 1', () => {
+    const result = parseThresholds('exact_match=1.1');
+    expect(result).toBeNull();
+  });
+
+  it('rejects non-numeric threshold value', () => {
+    const result = parseThresholds('exact_match=abc');
+    expect(result).toBeNull();
+  });
+
+  it('accepts boundary values 0 and 1', () => {
+    const result = parseThresholds(['exact_match=0', 'toxicity=1']);
+    expect(result).toEqual({ exact_match: 0, toxicity: 1 });
+  });
+
+  it('accepts decimal threshold values', () => {
+    const result = parseThresholds('length_variance=0.75');
+    expect(result).toEqual({ length_variance: 0.75 });
+  });
+});
