index 0000000..522f77d
--- /dev/null
+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS with all checks answered when there are no block findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with all checks answered when there are only warn findings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with correct answered count when there are block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing incident path', source: 'validator' }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when the gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'Gate section not found', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('lists block findings in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing disclosure', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Invalid tier', source: 'validator' }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('deduplicates block findings for the same checkId', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Metrics too high', source: 'agent' }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('handles mixed warn and block findings correctly', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'No fairness analysis', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Rollback time unclear', source: 'validator' }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+});
