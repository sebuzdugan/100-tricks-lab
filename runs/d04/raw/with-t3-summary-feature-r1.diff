index d83a05a..72b9b4e 100644
--- a/packages/frai-gate/src/gate/report.ts
+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,36 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const hasStructureFinding = result.findings.some(
+    (f) => f.checkId === 'structure' && f.severity === 'block'
+  );
+
+  if (hasStructureFinding) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const total = GATE_CHECKS.length;
+
+  const blockFindingsByCheckId = new Map<string, boolean>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockFindingsByCheckId.set(finding.checkId, true);
+    }
+  }
+
+  const answered = GATE_CHECKS.filter((check) => !blockFindingsByCheckId.has(check.id)).length;
+
+  const blockCheckIds = GATE_CHECKS.filter((check) => blockFindingsByCheckId.has(check.id)).map(
+    (check) => check.id
+  );
+
+  const summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockCheckIds.length > 0) {
+    return `${summary}: ${blockCheckIds.join(', ')}`;
+  }
+
+  return summary;
+}
