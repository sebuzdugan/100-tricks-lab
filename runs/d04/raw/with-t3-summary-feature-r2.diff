@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,29 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: if gate section is missing (structure finding), return BLOCK 0/7: structure
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const total = GATE_CHECKS.length;
+  // Answered = total checks minus those with at least one block-severity finding
+  const checksWithBlocks = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+  const answered = total - checksWithBlocks.size;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // If there are block findings, append them in GATE_CHECKS order
+  if (checksWithBlocks.size > 0) {
+    const blockCheckIds = GATE_CHECKS
+      .map((c) => c.id)
+      .filter((id) => checksWithBlocks.has(id));
+    summary += `: ${blockCheckIds.join(', ')}`;
+  }
+
+  return summary;
+}
