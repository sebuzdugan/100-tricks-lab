@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,30 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  if (result.gateSection === null) {
+    return `BLOCK 0/${total}: structure`;
+  }
+
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && finding.checkId !== 'structure') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered = total - blockCheckIds.size;
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockCheckIds.size > 0) {
+    const sortedIds = GATE_CHECKS.filter((check) => blockCheckIds.has(check.id)).map(
+      (check) => check.id
+    );
+    summary += `: ${sortedIds.join(', ')}`;
+  }
+
+  return summary;
+}
