@@ -1,5 +1,63 @@
 import path from 'path';
 
+export function parseThresholds(thresholdStrings, validMetricIds) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return [];
+  }
+
+  const thresholds = [];
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw {
+        code: 2,
+        message: `Malformed threshold "${thresholdStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw {
+        code: 2,
+        message: `Invalid threshold value "${minStr}". Minimum must be between 0 and 1`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      throw {
+        code: 2,
+        message: `Unknown metric "${metricId}". Valid metrics: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    thresholds.push({ metric: metricId, min });
+  }
+
+  return thresholds;
+}
+
+export function checkThresholds(thresholds, evaluations) {
+  const results = thresholds.map((threshold) => {
+    const evaluation = evaluations.find((m) => m.id === threshold.metric);
+    const score = evaluation?.score ?? null;
+    const passed = score !== null && score >= threshold.min;
+
+    return {
+      metric: threshold.metric,
+      min: threshold.min,
+      score,
+      passed
+    };
+  });
+
+  return {
+    thresholds: results,
+    passed: results.every((r) => r.passed)
+  };
+}
