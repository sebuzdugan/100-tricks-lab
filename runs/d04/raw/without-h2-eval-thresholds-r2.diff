+function parseThresholds(thresholdStrs: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const str of thresholdStrs) {
+    const match = str.match(/^([^=]+)=(.+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}" (expected format: metric=number)`);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      throw new Error(`Malformed threshold: "${str}" (value must be a number)`);
+    }
+
+    if (value < 0 || value > 1) {
+      throw new Error(`Malformed threshold: "${str}" (value must be between 0 and 1)`);
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      throw new Error(
+        `Unknown metric: "${metricId}". Valid metrics: ${validMetrics.join(', ')}`
+      );
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
