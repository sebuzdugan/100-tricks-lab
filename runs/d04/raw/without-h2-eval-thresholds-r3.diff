+function parseThresholds(thresholdStrings: string[] = []): { [metricId: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [metricId: string]: number } = {};
+
+  for (const threshStr of thresholdStrings) {
+    const parts = threshStr.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: '${threshStr}'. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const metricId = parts[0].trim();
+    const minStr = parts[1].trim();
+    const minimum = Number.parseFloat(minStr);
+
+    if (Number.isNaN(minimum) || minimum < 0 || minimum > 1) {
+      log.error(`Invalid minimum for metric '${metricId}': must be a number between 0 and 1, got '${minStr}'`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minimum;
+  }
+
+  return thresholds;
+}
