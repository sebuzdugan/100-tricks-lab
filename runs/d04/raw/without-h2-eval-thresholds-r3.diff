+export function validateThresholds(thresholds = {}, evaluations = []) {
+  const errors = [];
+  const validMetricIds = evaluations.map(e => e.id);
+
+  Object.entries(thresholds).forEach(([metricId, minimum]) => {
+    if (typeof minimum !== 'number' || minimum < 0 || minimum > 1) {
+      errors.push(`Invalid minimum for metric '${metricId}': must be a number between 0 and 1`);
+    }
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric id '${metricId}'. Valid metrics: ${validMetricIds.join(', ')}`);
+    }
+  });
+
+  return errors;
+}
+
+export function evaluateThresholds(thresholds = {}, evaluations = []) {
+  const results = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, minimum]) => {
+    const metric = evaluations.find(e => e.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score !== undefined && score >= minimum;
+
+    if (!passed) allPassed = false;
+
+    results.push({
+      metric: metricId,
+      min: minimum,
+      score: score ?? null,
+      passed
+    });
+  });
+
+  return {
+    passed: allPassed,
+    thresholds: results
+  };
+}
