+function parseThresholds(thresholdInput: string | string[] | undefined) {
+  if (!thresholdInput) {
+    return { thresholds: null, isValid: true };
+  }
+
+  const thresholdStrs = Array.isArray(thresholdInput) ? thresholdInput : [thresholdInput];
+  if (thresholdStrs.length === 0) {
+    return { thresholds: null, isValid: true };
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrs) {
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      return { thresholds: null, isValid: false, error: `Malformed threshold: ${str}. Expected format: <metric>=<number>` };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      return { thresholds: null, isValid: false, error: `Invalid threshold value for ${metricId}: ${valueStr}. Must be a number between 0 and 1.` };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds, isValid: true };
+}
