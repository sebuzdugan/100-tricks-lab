diff --git a/packages/frai-core/src/eval/reporters.js b/packages/frai-core/src/eval/reporters.js
index 6cdb9a5..4954027 100644
--- a/packages/frai-core/src/eval/reporters.js
+++ b/packages/frai-core/src/eval/reporters.js
@@ -1,5 +1,43 @@
 import path from 'path';
 
+export function validateThreshold(thresholdStr) {
+  const [metricId, minStr] = thresholdStr.split('=');
+
+  if (!metricId || !minStr) {
+    return { valid: false, error: `Invalid threshold format: ${thresholdStr}. Expected <metric>=<number>` };
+  }
+
+  const min = Number.parseFloat(minStr);
+  if (Number.isNaN(min) || min < 0 || min > 1) {
+    return { valid: false, error: `Invalid threshold value: ${minStr}. Must be a number between 0 and 1` };
+  }
+
+  return { valid: true, metricId: metricId.trim(), min };
+}
+
+export function checkThresholds(metrics, thresholds) {
+  const metricMap = new Map(metrics.map((m) => [m.id, m]));
+  const results = [];
+
+  for (const { metricId, min } of thresholds) {
+    const metric = metricMap.get(metricId);
+    if (!metric) {
+      return { valid: false, unknownMetric: metricId, validMetrics: Array.from(metricMap.keys()) };
+    }
+
+    const score = metric.score ?? null;
+    const passed = score !== null && score >= min;
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return { valid: true, results, allPassed: results.every((r) => r.passed) };
+}
+
