+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const result: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      throw {
+        code: 2,
+        message: `Malformed threshold: "${thresholdStr}". Format must be "<metric>=<number>".`
+      };
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+
+    if (!validMetricIds.includes(metricId)) {
+      throw {
+        code: 2,
+        message: `Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}.`
+      };
+    }
+
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw {
+        code: 2,
+        message: `Invalid threshold value: "${minStr}" for metric "${metricId}". Must be a number between 0 and 1.`
+      };
+    }
+
+    result[metricId] = min;
+  }
+
+  return Object.keys(result).length > 0 ? result : undefined;
+}
