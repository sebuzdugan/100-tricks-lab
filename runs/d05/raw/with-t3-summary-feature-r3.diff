+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'No gate section found', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '# FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with answered count when warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'risk-tier', severity: 'warn', message: 'Risk tier not justified', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'warn', message: 'Data retention unclear', source: 'validator' }
+      ],
+      gateSection: '# FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('lists blocked checks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Transparency missing', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Evaluation plan missing', source: 'validator' }
+      ],
+      gateSection: '# FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('deduplicates and orders block checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Evaluation missing', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Evaluation incomplete', source: 'agent' },
+        { checkId: 'monitoring', severity: 'block', message: 'Monitoring missing', source: 'validator' }
+      ],
+      gateSection: '# FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, monitoring');
+  });
+
+  it('ignores warn-severity findings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'bias', severity: 'block', message: 'Bias analysis missing', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'warn', message: 'Data retention unclear', source: 'validator' }
+      ],
+      gateSection: '# FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+
+  it('handles single block check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'oversight', severity: 'block', message: 'Oversight missing', source: 'validator' }
+      ],
+      gateSection: '# FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: oversight');
+  });
+
+  it('handles all checks blocked', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: '', source: 'validator' }
+      ],
+      gateSection: '# FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency');
+  });
+});
