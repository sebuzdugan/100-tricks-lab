+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: '${str}'. Expected format: <metric>=<number>`);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value: '${valueStr}'. Value must be a number between 0 and 1.`);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
+
+function validateThresholdMetrics(thresholds: Record<string, number>, evaluations: any[]) {
+  const validIds = new Set(evaluations.map((m) => m.id));
+  const invalidMetrics = Object.keys(thresholds).filter((id) => !validIds.has(id));
+
+  if (invalidMetrics.length > 0) {
+    const validList = Array.from(validIds).join(', ');
+    const message = `Unknown metric${invalidMetrics.length > 1 ? 's' : ''}: ${invalidMetrics.join(', ')}. Valid metrics: ${validList}`;
+    throw Object.assign(new Error(message), { usageError: true });
+  }
+}
