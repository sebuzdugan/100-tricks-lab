+
+function isThresholdParseError(obj: unknown): obj is ThresholdParseError {
+  return typeof obj === 'object' && obj !== null && 'error' in obj && 'code' in obj;
+}
+
+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } | ThresholdParseError {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: { [key: string]: number } = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        error: `Malformed threshold: "${thresholdStr}". Expected format: metric=number (e.g., exact_match=0.9)`,
+        code: 2
+      };
+    }
+
+    const metricId = String(match[1]);
+    const valueStr = String(match[2]);
+    const value = parseFloat(valueStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`,
+        code: 2
+      };
+    }
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      return {
+        error: `Invalid threshold value: "${valueStr}". Must be a number between 0 and 1.`,
+        code: 2
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
