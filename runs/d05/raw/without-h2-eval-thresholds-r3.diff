+function parseThresholds(thresholdStrings: string[] | undefined) {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error('Malformed threshold: must be in format <metric>=<number>', { threshold: thresholdStr });
+      process.exit(2);
+    }
+
+    const [metric, valueStr] = parts;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error('Invalid threshold value: must be a number between 0 and 1', { metric, value: valueStr });
+      process.exit(2);
+    }
+
+    if (!validMetrics.includes(metric)) {
+      log.error('Unknown metric ID', { metric, validMetrics });
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
