+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with answered count when there are warnings only', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with blocked checks listed when there are block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing subsection',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing subsection',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No "## Responsible AI Gate" section found in the spec.',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('lists blocked checks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing subsection',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing subsection',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Missing subsection',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, bias, transparency');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing subsection',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('deduplicates check ids from multiple findings for the same check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing subsection',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Empty subsection',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
