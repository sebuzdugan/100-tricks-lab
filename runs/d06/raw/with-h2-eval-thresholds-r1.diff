+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number> | undefined; validMetricIds: string[] } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: undefined, validMetricIds: ['exact_match', 'toxicity', 'length_variance'] };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+      log.info('Valid metric ids:', { metrics: validMetricIds });
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value: "${valueStr}". Minimum must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric id: "${metricId}". Valid metric ids:`, { metrics: validMetricIds });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds, validMetricIds };
+}
