+export function validateThresholds(thresholds, availableMetricIds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [] };
+  }
+
+  const errors = [];
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!availableMetricIds.includes(metricId)) {
+      errors.push({
+        message: `Unknown metric id: ${metricId}`,
+        metric: metricId
+      });
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push({
+        message: `Threshold for ${metricId} must be a number between 0 and 1, got ${min}`,
+        metric: metricId
+      });
+    }
+  }
+  return { valid: errors.length === 0, errors };
+}
