+import { Eval } from './packages/frai-core/src/index.js';
+
+function customMetric(outputs, references) {
+  return {
+    id: 'custom_score',
+    label: 'Custom Score',
+    score: 0.75,
+    total: outputs.length
+  };
+}
+
+const evaluations = Eval.runEvaluations({
+  outputs: ['test1', 'test2'],
+  references: ['test1', 'test2'],
+  metrics: [customMetric]
+});
+
+console.log('Evaluations:', JSON.stringify(evaluations, null, 2));
+
+const report = Eval.generateReport({
+  evaluations,
+  outputsPath: '/tmp/outputs.json',
+  referencesPath: '/tmp/refs.json',
+  thresholds: {
+    custom_score: 0.8
+  }
+});
+
+console.log('\nReport with threshold:', JSON.stringify(report, null, 2));
+console.log('\nThreshold passed:', report.passed);
