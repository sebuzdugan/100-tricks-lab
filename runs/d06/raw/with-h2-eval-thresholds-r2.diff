+function parseThresholds(thresholdStrings: string[] | undefined) {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: ${threshold}. Expected format: <metric>=<number>`);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(
+        `Invalid threshold for ${metricId}: ${minStr}. Minimum must be a number between 0 and 1.`
+      );
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
