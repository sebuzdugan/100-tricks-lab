+import { Finding, GATE_CHECKS, GateResult } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (!result.gateSection) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const total = GATE_CHECKS.length;
+  const blockingFindingsByCheck = new Map<string, Finding[]>();
+
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      if (!blockingFindingsByCheck.has(finding.checkId)) {
+        blockingFindingsByCheck.set(finding.checkId, []);
+      }
+      blockingFindingsByCheck.get(finding.checkId)!.push(finding);
+    }
+  }
+
+  const answered = GATE_CHECKS.filter((check) => !blockingFindingsByCheck.has(check.id)).length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockingFindingsByCheck.size > 0) {
+    const blockingCheckIds = GATE_CHECKS.map((check) => check.id).filter((id) =>
+      blockingFindingsByCheck.has(id)
+    );
+    summary += `: ${blockingCheckIds.join(', ')}`;
+  }
+
+  return summary;
+}
