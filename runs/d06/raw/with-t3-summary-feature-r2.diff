index d83a05a..1060c42 100644
--- a/packages/frai-gate/src/gate/report.ts
+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,30 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return `BLOCK 0/${total}: structure`;
+  }
+
+  const checksWithBlockFindings = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      checksWithBlockFindings.add(finding.checkId);
+    }
+  }
+
+  const answered = total - checksWithBlockFindings.size;
+  const summary = `${result.verdict} ${answered}/${total}`;
+
+  if (checksWithBlockFindings.size === 0) {
+    return summary;
+  }
+
+  const blockCheckIds = GATE_CHECKS.filter((check) => checksWithBlockFindings.has(check.id))
+    .map((check) => check.id)
+    .join(', ');
+  return `${summary}: ${blockCheckIds}`;
+}
