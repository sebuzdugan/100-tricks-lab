index 0000000..e3d3842
--- /dev/null
+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,154 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GATE_CHECKS } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS when there are no findings', () => {
+    const result = {
+      verdict: 'PASS' as const,
+      tier: 'limited' as const,
+      findings: [],
+      gateSection: '# FRAI Gate\n\nContent'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result = {
+      verdict: 'BLOCK' as const,
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block' as const,
+          message: 'FRAI Gate section not found',
+          source: 'validator' as const
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns WARN with answered count and block check ids', () => {
+    const result = {
+      verdict: 'WARN' as const,
+      tier: 'limited' as const,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block' as const,
+          message: 'Missing evaluation metrics',
+          source: 'validator' as const
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block' as const,
+          message: 'Missing incident response plan',
+          source: 'validator' as const
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn' as const,
+          message: 'Could be more detailed',
+          source: 'validator' as const
+        }
+      ],
+      gateSection: '# FRAI Gate\n\nContent'
+    };
+    expect(renderSummary(result)).toBe('WARN 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK with single blocked check', () => {
+    const result = {
+      verdict: 'BLOCK' as const,
+      tier: null,
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block' as const,
+          message: 'Risk tier is required',
+          source: 'validator' as const
+        }
+      ],
+      gateSection: '# FRAI Gate\n\nContent'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('maintains GATE_CHECKS order when listing blocked checks', () => {
+    const result = {
+      verdict: 'BLOCK' as const,
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block' as const,
+          message: 'Missing',
+          source: 'validator' as const
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block' as const,
+          message: 'Missing',
+          source: 'validator' as const
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block' as const,
+          message: 'Missing',
+          source: 'validator' as const
+        }
+      ],
+      gateSection: '# FRAI Gate\n\nContent'
+    };
+    // GATE_CHECKS order: risk-tier, data-privacy, ..., transparency
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, data-privacy, transparency');
+  });
+
+  it('ignores duplicate check ids in findings', () => {
+    const result = {
+      verdict: 'BLOCK' as const,
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block' as const,
+          message: 'Missing metrics',
+          source: 'validator' as const
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block' as const,
+          message: 'Also missing thresholds',
+          source: 'agent' as const
+        }
+      ],
+      gateSection: '# FRAI Gate\n\nContent'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('does not count warnings as blocks', () => {
+    const result = {
+      verdict: 'WARN' as const,
+      tier: 'minimal' as const,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn' as const,
+          message: 'No numbers found',
+          source: 'validator' as const
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn' as const,
+          message: 'Could be more detailed',
+          source: 'validator' as const
+        }
+      ],
+      gateSection: '# FRAI Gate\n\nContent'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+});
