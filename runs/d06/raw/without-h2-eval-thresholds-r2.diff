+function parseThresholds(thresholdStrings: string[] = []): { [key: string]: number } | null {
+  const thresholds: { [key: string]: number } = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${str}". Expected format: <metric>=<number>`);
+      return null;
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${minStr}. Must be a number between 0 and 1.`);
+      return null;
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
+
+function validateMetricIds(thresholds: { [key: string]: number }, report: any): boolean {
+  const validMetricIds = report.metrics.map((m: any) => m.id);
+  const invalidIds = Object.keys(thresholds).filter((id) => !validMetricIds.includes(id));
+
+  if (invalidIds.length > 0) {
+    log.error(`Unknown metric id(s): ${invalidIds.join(', ')}`);
+    log.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+    return false;
+  }
+
+  return true;
+}
