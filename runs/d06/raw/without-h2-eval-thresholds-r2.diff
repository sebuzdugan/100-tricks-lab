+      metric: 'length_variance',
+      min: 0.5,
+      passed: true
+    });
+  });
+
+  it('tracks failing thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'Goodbye'],
+      references: ['hello', 'hello']
+    });
+    const report = generateReport({
