+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'Missing gate section', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## Responsible AI Gate'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Evaluation plan has no numbers',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with blocked checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation plan', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing transparency section', source: 'validator' }
+      ],
+      gateSection: '## Responsible AI Gate'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('includes only block findings in the check ID list', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation plan', source: 'validator' },
+        { checkId: 'bias', severity: 'warn', message: 'Weak bias mitigation', source: 'validator' }
+      ],
+      gateSection: '## Responsible AI Gate'
+    };
+    expect(renderSummary(result)).toBe('WARN 6/7: evaluation');
+  });
+
+  it('maintains GATE_CHECKS order for blocked check IDs', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing transparency', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing risk tier', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing data privacy', source: 'validator' }
+      ],
+      gateSection: '## Responsible AI Gate'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, data-privacy, transparency');
+  });
+
+  it('counts multiple findings for the same check only once', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing dataset', source: 'validator' }
+      ],
+      gateSection: '## Responsible AI Gate'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
