+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,156 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+function createResult(overrides: Partial<GateResult> = {}): GateResult {
+  return {
+    verdict: 'PASS',
+    tier: 'limited',
+    findings: [],
+    gateSection: '# Gate section',
+    ...overrides
+  };
+}
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 for a fully answered gate', () => {
+    const result = createResult({ verdict: 'PASS', findings: [] });
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN 7/7 when there are only warnings', () => {
+    const result = createResult({
+      verdict: 'WARN',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric thresholds',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK 6/7 with one block finding', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data sources',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('returns block findings in GATE_CHECKS order', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency info',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('ignores non-GATE_CHECKS findings when counting blocks', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data sources',
+          source: 'validator'
+        },
+        {
+          checkId: 'unknown-check',
+          severity: 'block',
+          message: 'Some other check',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Missing gate section',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    });
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('counts warnings as answered (they do not reduce answered count)', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric thresholds',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Missing bias mitigation',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+
+  it('handles multiple block findings from agent source', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'Insufficient oversight',
+          source: 'agent'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'block',
+          message: 'Incomplete monitoring plan',
+          source: 'agent'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Invalid tier',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, oversight, monitoring');
+  });
+});
