+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,24 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const total = GATE_CHECKS.length;
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+  const checkIdsWithBlocks = new Set(blockFindings.map((f) => f.checkId));
+  const answered = total - checkIdsWithBlocks.size;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockFindings.length > 0) {
+    const blockCheckIds = GATE_CHECKS.map((c) => c.id)
+      .filter((id) => checkIdsWithBlocks.has(id));
+    summary += `: ${blockCheckIds.join(', ')}`;
+  }
+
+  return summary;
+}
