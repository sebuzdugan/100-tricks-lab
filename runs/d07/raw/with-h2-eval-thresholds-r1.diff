+function parseThresholds(thresholdArgs: string | string[] | undefined): Record<string, number> {
+  if (!thresholdArgs) return {};
+  const args = Array.isArray(thresholdArgs) ? thresholdArgs : [thresholdArgs];
+  const thresholds: Record<string, number> = {};
+
+  for (const arg of args) {
+    const [metric, minStr] = arg.split('=');
+    if (!metric || minStr === undefined) {
+      log.error(`Malformed threshold: ${arg}. Expected format: metric=minimum`);
+      process.exit(2);
+    }
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold minimum: ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+    thresholds[metric] = min;
+  }
+
+  return thresholds;
+}
+
+function validateThresholds(thresholds: Record<string, number>, metrics: any[]): string[] {
+  const validMetricIds = metrics.map((m) => m.id);
+  const errors: string[] = [];
+
+  for (const metric of Object.keys(thresholds)) {
+    if (!validMetricIds.includes(metric)) {
+      errors.push(`Unknown metric: ${metric}. Valid metrics: ${validMetricIds.join(', ')}`);
+    }
+  }
+
+  return errors;
+}
