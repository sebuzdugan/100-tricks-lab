+function parseThresholds(thresholdStrings: string[] = []): { thresholds: Record<string, number>; validationError?: string } {
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return { thresholds: {}, validationError: `Malformed threshold: "${str}". Expected format: <metric>=<number>` };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      return {
+        thresholds: {},
+        validationError: `Invalid threshold value for ${metricId}: "${valueStr}". Must be a number between 0 and 1.`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds };
+}
+
+function validateMetricIds(thresholds: Record<string, number>, evaluations: any[]): string | null {
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+  for (const metricId of Object.keys(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      const availableIds = Array.from(validMetricIds).sort().join(', ');
+      return `Unknown metric id: "${metricId}". Valid metric ids are: ${availableIds}`;
+    }
+  }
+  return null;
+}
