+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+export function validateThreshold(thresholdStr) {
+  if (typeof thresholdStr !== 'string') {
+    return {
+      error: 'Threshold must be a string'
+    };
+  }
+
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    return {
+      error: `Threshold string is malformed: "${thresholdStr}". Expected format: <metric>=<number>`
+    };
+  }
+
+  const [metricId, minStr] = parts;
+  const min = parseFloat(minStr);
+
+  if (isNaN(min)) {
+    return {
+      error: `Threshold minimum must be a number, got "${minStr}"`
+    };
+  }
+
+  if (min < 0 || min > 1) {
+    return {
+      error: `Threshold minimum must be between 0 and 1, got ${min}`
+    };
+  }
+
+  if (!VALID_METRIC_IDS.includes(metricId)) {
+    return {
+      error: `Unknown metric id: "${metricId}". Valid ids: ${VALID_METRIC_IDS.join(', ')}`
+    };
+  }
+
+  return null;
+}
