+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+interface ParsedThreshold {
+  metric: string;
+  min: number;
+}
+
+function parseThresholds(thresholdStrings?: string[]): ParsedThreshold[] {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return [];
+  }
+
+  const parsed: ParsedThreshold[] = [];
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      log.error('Invalid threshold format', { value: str });
+      console.error(`  Threshold must be in format "<metric>=<number>", got "${str}"`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minValue = Number.parseFloat(match[2]);
+
+    if (!VALID_METRIC_IDS.includes(metricId)) {
+      log.error('Unknown metric id', { value: metricId });
+      console.error(`  Valid metric ids are: ${VALID_METRIC_IDS.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (minValue < 0 || minValue > 1) {
+      log.error('Threshold minimum must be between 0 and 1', { value: minValue });
+      process.exit(2);
+    }
+
+    parsed.push({ metric: metricId, min: minValue });
+  }
+
+  return parsed;
+}
