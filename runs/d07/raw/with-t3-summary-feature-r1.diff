index d83a05a..8d779e9 100644
--- a/packages/frai-gate/src/gate/report.ts
+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,28 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (!result.gateSection) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blocksByCheck = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blocksByCheck.add(finding.checkId);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - blocksByCheck.size;
+  let summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  if (blocksByCheck.size > 0) {
+    const blockedIds = GATE_CHECKS.filter((check) => blocksByCheck.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockedIds}`;
+  }
+
+  return summary;
+}
