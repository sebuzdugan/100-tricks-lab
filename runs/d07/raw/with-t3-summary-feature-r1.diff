diff --git a/packages/frai-gate/src/gate/report.test.ts b/packages/frai-gate/src/gate/report.test.ts
new file mode 100644
index 0000000..690195e
--- /dev/null
+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+function result(
+  verdict: GateResult['verdict'],
+  findings: Finding[] = [],
+  gateSection: string | null = 'gate content'
+): GateResult {
+  return {
+    verdict,
+    tier: null,
+    findings,
+    gateSection
+  };
+}
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7 when gate section is missing', () => {
+    const summary = renderSummary(result('BLOCK', [], null));
+    expect(summary).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when there are no findings', () => {
+    const summary = renderSummary(result('PASS'));
+    expect(summary).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with answered count when there are only warnings', () => {
+    const findings: Finding[] = [
+      { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' }
+    ];
+    const summary = renderSummary(result('WARN', findings));
+    expect(summary).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with answered count and check ids when there are block findings', () => {
+    const findings: Finding[] = [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' }
+    ];
+    const summary = renderSummary(result('BLOCK', findings));
+    expect(summary).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists check ids in GATE_CHECKS order, not findings order', () => {
+    const findings: Finding[] = [
+      { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' }
+    ];
+    const summary = renderSummary(result('BLOCK', findings));
+    expect(summary).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('deduplicates check ids when multiple findings target the same check', () => {
+    const findings: Finding[] = [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing thresholds', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: 'Dataset too small', source: 'agent' },
+      { checkId: 'bias', severity: 'block', message: 'Missing', source: 'validator' }
+    ];
+    const summary = renderSummary(result('BLOCK', findings));
+    expect(summary).toBe('BLOCK 5/7: evaluation, bias');
+  });
+
+  it('ignores warning findings when counting answered', () => {
+    const findings: Finding[] = [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'monitoring', severity: 'warn', message: 'Weak thresholds', source: 'agent' }
+    ];
+    const summary = renderSummary(result('BLOCK', findings));
+    expect(summary).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('includes all block checks in GATE_CHECKS order', () => {
+    const findings: Finding[] = [
+      { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'data-privacy', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'oversight', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'bias', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'monitoring', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' }
+    ];
+    const summary = renderSummary(result('BLOCK', findings));
+    expect(summary).toBe(
+      'BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency'
+    );
+  });
+});
