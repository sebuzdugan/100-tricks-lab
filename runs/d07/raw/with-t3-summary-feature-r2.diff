+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,35 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: missing gate section
+  if (result.gateSection === null) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Determine which checks have block findings
+  const checksWithBlock = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      checksWithBlock.add(finding.checkId);
+    }
+  }
+
+  // Calculate answered count (checks without block findings)
+  const answered = GATE_CHECKS.length - checksWithBlock.size;
+
+  // Format the summary
+  let summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  // If there are block findings, append the check ids in order
+  if (checksWithBlock.size > 0) {
+    const blockedIds = GATE_CHECKS
+      .map(check => check.id)
+      .filter(id => checksWithBlock.has(id))
+      .join(', ');
+    summary += `: ${blockedIds}`;
+  }
+
+  return summary;
+}
