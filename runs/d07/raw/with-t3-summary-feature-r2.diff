+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,119 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, GATE_CHECKS } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 for a fully answered gate with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with all checks answered when only warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with reduced answered count when block findings exist', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'bias', severity: 'block', message: 'Missing bias section', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'Missing oversight section', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: oversight, bias');
+  });
+
+  it('lists multiple block findings in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing transparency', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('includes only each check id once even if multiple block findings for same check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'bias', severity: 'block', message: 'Issue 1', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Issue 2', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+
+  it('ignores warnings when counting block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'bias', severity: 'block', message: 'Missing section', source: 'validator' },
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'structure', severity: 'block', message: 'No gate section', source: 'validator' }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns BLOCK 0/7: structure regardless of other findings when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'structure', severity: 'block', message: 'No gate section', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Would be missing if gate existed', source: 'validator' }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('handles all seven checks blocking correctly', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: GATE_CHECKS.map(check => ({
+        checkId: check.id,
+        severity: 'block' as const,
+        message: `Missing ${check.title}`,
+        source: 'validator' as const
+      })),
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency');
+  });
+});
