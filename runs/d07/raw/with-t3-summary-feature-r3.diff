+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // If structure is missing, return early
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const total = GATE_CHECKS.length;
+
+  // Count answered checks (those without 'block' findings)
+  const blockCheckIds = new Set(
+    result.findings
+      .filter((f) => f.severity === 'block' && f.checkId !== 'structure')
+      .map((f) => f.checkId)
+  );
+
+  const answered = GATE_CHECKS.filter((check) => !blockCheckIds.has(check.id)).length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // Append blocked check ids in GATE_CHECKS order if there are any
+  if (blockCheckIds.size > 0) {
+    const blockedIds = GATE_CHECKS
+      .filter((check) => blockCheckIds.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockedIds}`;
+  }
+
+  return summary;
+}
