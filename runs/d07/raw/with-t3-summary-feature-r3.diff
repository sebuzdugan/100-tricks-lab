+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns structure finding when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No Responsible AI Gate section found',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('shows full pass when no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some section'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('shows warnings with answered count', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers in evaluation plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some section'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('shows blocked checks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency section',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation section',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('counts only block findings as unanswered', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Weak metrics',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Invalid tier',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some section'
+    };
+    expect(renderSummary(result)).toBe('WARN 6/7: risk-tier');
+  });
+
+  it('handles multiple blocked checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'PII handling unclear',
+          source: 'validator'
+        },
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'No kill switch',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'block',
+          message: 'No rollback plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, oversight, monitoring');
+  });
+
+  it('ignores structure findings when listing blocked checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No gate section',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    // When structure finding is present, we return early with structure-specific message
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+});
