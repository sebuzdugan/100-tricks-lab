+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number> | null; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const threshStr of thresholdStrings) {
+    const parts = threshStr.split('=');
+    if (parts.length !== 2) {
+      return { error: `Malformed threshold "${threshStr}": expected format <metric>=<number>` };
+    }
+
+    const metricId = parts[0].trim();
+    const minStr = parts[1].trim();
+
+    if (!metricId) {
+      return { error: `Malformed threshold "${threshStr}": metric id is empty` };
+    }
+
+    const min = Number(minStr);
+    if (isNaN(min)) {
+      return { error: `Malformed threshold "${threshStr}": minimum must be a number` };
+    }
+
+    if (min < 0 || min > 1) {
+      return { error: `Malformed threshold "${threshStr}": minimum must be between 0 and 1` };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds };
+}
