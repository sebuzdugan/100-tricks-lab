+function validateAndCheckThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+  const thresholdResults = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metric, min]) => {
+    if (!validMetricIds.has(metric)) {
+      const validIds = Array.from(validMetricIds).join(', ');
+      throw new Error(`Unknown metric: ${metric}. Valid metrics are: ${validIds}`);
+    }
+
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold for ${metric}: ${min}. Threshold must be a number between 0 and 1.`);
+    }
+
+    const evaluation = evaluations.find((m) => m.id === metric);
+    const score = evaluation.score;
+    const passed = score !== null && score !== undefined && score >= min;
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    thresholdResults.push({
+      metric,
+      min,
+      score: score ?? null,
+      passed
+    });
+  });
+
+  return { passed: allPassed, thresholds: thresholdResults };
+}
+
