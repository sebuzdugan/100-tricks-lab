+function validateThresholds(thresholds, evaluations) {
+  const errors = [];
+  const validMetricIds = evaluations.map((m) => m.id);
+
+  Object.entries(thresholds || {}).forEach(([metricId, minScore]) => {
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(`unknown metric id: ${metricId} (valid: ${validMetricIds.join(', ')})`);
+      return;
+    }
+    if (typeof minScore !== 'number') {
+      errors.push(`threshold for ${metricId} is not a number: ${minScore}`);
+      return;
+    }
+    if (minScore < 0 || minScore > 1) {
+      errors.push(`threshold for ${metricId} must be between 0 and 1, got ${minScore}`);
+    }
+  });
+
+  return errors;
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  const results = [];
+
+  Object.entries(thresholds || {}).forEach(([metricId, min]) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+    if (!metric) return;
+
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  });
+
+  return results;
+}
