+function parseThresholds(thresholdStrs?: string[]) {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  thresholdStrs.forEach((str) => {
+    const match = str.match(/^([a-zA-Z_][a-zA-Z0-9_]*)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: ${str}. Expected format: <metric>=<number>`);
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      throw new Error(`Invalid threshold score for ${metricId}: ${scoreStr}. Must be between 0 and 1.`);
+    }
+
+    thresholds[metricId] = score;
+  });
+
+  return thresholds;
+}
