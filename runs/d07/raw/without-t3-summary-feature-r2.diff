@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,28 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: if structure finding exists, it means the gate section is missing
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count how many checks have no block findings
+  const blocksByCheckId = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+  const answered = GATE_CHECKS.length - blocksByCheckId.size;
+
+  let summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  // If there are block findings, append the check ids
+  if (blocksByCheckId.size > 0) {
+    const blockIds = GATE_CHECKS.filter((check) => blocksByCheckId.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockIds}`;
+  }
+
+  return summary;
+}
