+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } | null {
+  const thresholds: { [key: string]: number } = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: ${thresholdStr}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [metricId, valueStr] = parts;
+    const value = parseFloat(valueStr);
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${valueStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
+
+function validateThresholds(thresholds: { [key: string]: number }, evaluations: unknown[]): void {
+  const availableMetricIds = evaluations.map((m) => {
+    const metric = m as { id?: string };
+    return metric.id;
+  });
+  const requestedMetricIds = Object.keys(thresholds);
+
+  const unknownMetricIds = requestedMetricIds.filter((id) => !availableMetricIds.includes(id));
+  if (unknownMetricIds.length > 0) {
+    log.error(`Unknown metric ID(s): ${unknownMetricIds.join(', ')}`);
+    console.error(`Valid metric IDs: ${availableMetricIds.join(', ')}`);
+    process.exit(2);
+  }
+}
