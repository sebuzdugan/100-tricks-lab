+function parseThresholds(thresholdStrs: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrs) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Use format: metric=min (e.g., exact_match=0.9)`);
+    }
+    const [, metric, minStr] = match;
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold minimum for ${metric}: ${minStr}. Must be a number between 0 and 1.`);
+    }
+    thresholds[metric] = min;
+  }
+  return thresholds;
+}
