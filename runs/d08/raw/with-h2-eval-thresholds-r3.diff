+function parseAndValidateThresholds(thresholdInput: string | string[] | undefined): { thresholds: Record<string, number>; validMetricIds: string[] } {
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdInput) {
+    return { thresholds, validMetricIds };
+  }
+
+  const thresholdArray = Array.isArray(thresholdInput) ? thresholdInput : [thresholdInput];
+
+  for (const threshold of thresholdArray) {
+    const match = threshold.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      const message = `Malformed threshold: "${threshold}". Format must be <metric>=<number> (e.g., exact_match=0.9)`;
+      log.error(message);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min)) {
+      const message = `Malformed threshold: "${threshold}". The minimum value "${minStr}" is not a valid number.`;
+      log.error(message);
+      process.exit(2);
+    }
+
+    if (min < 0 || min > 1) {
+      const message = `Malformed threshold: "${threshold}". The minimum value must be between 0 and 1, got ${min}.`;
+      log.error(message);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      const message = `Unknown metric id in threshold: "${metricId}". Valid metric ids are: ${validMetricIds.join(', ')}`;
+      log.error(message);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, validMetricIds };
+}
