 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,31 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // If structure finding (gate section missing), return immediately
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Get checkIds with block-severity findings
+  const blockCheckIds = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+
+  // Count answered checks (those without block findings)
+  const answered = GATE_CHECKS.length - blockCheckIds.size;
+  const total = GATE_CHECKS.length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // If there are block findings, append the check IDs in GATE_CHECKS order
+  if (blockCheckIds.size > 0) {
+    const blockedIds = GATE_CHECKS.filter((check) => blockCheckIds.has(check.id)).map(
+      (check) => check.id
+    );
+    summary += `: ${blockedIds.join(', ')}`;
+  }
+
+  return summary;
+}
