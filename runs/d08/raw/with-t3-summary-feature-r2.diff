@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,29 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Check if structure finding exists
+  if (result.findings.some((f) => f.checkId === 'structure' && f.severity === 'block')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Get all check IDs that have block findings
+  const blockedCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && GATE_CHECKS.some((check) => check.id === finding.checkId)) {
+      blockedCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - blockedCheckIds.size;
+  const verdict = result.verdict;
+
+  if (blockedCheckIds.size === 0) {
+    return `${verdict} ${answered}/7`;
+  }
+
+  // Format blocked check IDs in GATE_CHECKS order
+  const blockedIds = GATE_CHECKS.filter((check) => blockedCheckIds.has(check.id)).map((check) => check.id);
+  return `${verdict} ${answered}/7: ${blockedIds.join(', ')}`;
+}
