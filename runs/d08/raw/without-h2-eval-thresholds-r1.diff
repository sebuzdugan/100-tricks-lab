+function parseThresholdFormat(thresholdStrings: string[] | undefined) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${thresholdStr}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
+
+function validateThresholdsAgainstMetrics(thresholds: Record<string, number> | undefined, evaluations: Array<{ id: string }>) {
+  if (!thresholds) return;
+
+  const validMetricIds = evaluations.map((m) => m.id);
+  const requestedMetrics = Object.keys(thresholds);
+
+  for (const metricId of requestedMetrics) {
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`);
+      console.error('Valid metrics: ' + validMetricIds.join(', '));
+      process.exit(2);
+    }
+  }
+}
