+function parseThresholds(thresholdArgs: string | string[] | undefined): {
+  thresholds: Record<string, number> | null;
+  error: string | null;
+} {
+  if (!thresholdArgs) {
+    return { thresholds: null, error: null };
+  }
+
+  const args = Array.isArray(thresholdArgs) ? thresholdArgs : [thresholdArgs];
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const arg of args) {
+    const match = arg.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        thresholds: null,
+        error: `Malformed threshold: ${arg} (expected format: metric=min_score)`
+      };
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      return {
+        thresholds: null,
+        error: `Invalid threshold value: ${scoreStr} (must be between 0 and 1)`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        thresholds: null,
+        error: `Unknown metric: ${metricId} (valid metrics: ${validMetricIds.join(', ')})`
+      };
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return { thresholds, error: null };
+}
