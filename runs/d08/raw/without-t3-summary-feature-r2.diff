+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7 when structure finding exists', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'Missing gate section', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'Some gate text'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with count when only warnings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' }
+      ],
+      gateSection: 'Some gate text'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with single check id', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing data sources', source: 'validator' }
+      ],
+      gateSection: 'Some gate text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('returns BLOCK with multiple check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing disclosure', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing plan', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing tier', source: 'validator' }
+      ],
+      gateSection: 'Some gate text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('ignores warnings when counting blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing data', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Weak plan', source: 'validator' }
+      ],
+      gateSection: 'Some gate text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('counts each check only once even with multiple findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing sources', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing retention', source: 'agent' },
+        { checkId: 'bias', severity: 'block', message: 'No mitigation', source: 'validator' }
+      ],
+      gateSection: 'Some gate text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: data-privacy, bias');
+  });
+
+  it('handles all checks blocked', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: '', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: '', source: 'validator' }
+      ],
+      gateSection: 'Some gate text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency');
+  });
+});
