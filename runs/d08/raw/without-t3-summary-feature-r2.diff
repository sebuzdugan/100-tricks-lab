@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,35 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Check for structure finding (missing gate section)
+  const structureIssue = result.findings.some((f) => f.checkId === 'structure');
+  if (structureIssue) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const total = GATE_CHECKS.length;
+  const blockCheckIds = new Set<string>();
+
+  // Collect all check IDs that have block findings
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  // Count answered checks: those in GATE_CHECKS without any block finding
+  const answered = GATE_CHECKS.filter((check) => !blockCheckIds.has(check.id)).length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // If there are block findings, append check IDs in GATE_CHECKS order
+  if (blockCheckIds.size > 0) {
+    const orderedIds = GATE_CHECKS.filter((check) => blockCheckIds.has(check.id))
+      .map((check) => check.id);
+    summary += `: ${orderedIds.join(', ')}`;
+  }
+
+  return summary;
+}
