+type ParsedThresholds =
+  | { valid: true; thresholds: Record<string, number> }
+  | { valid: false; error: string };
+
+function parseThresholds(thresholdStrings: string | string[] | undefined, validMetricIds: string[]): ParsedThresholds {
+  let specs: string[] = [];
+
+  if (!thresholdStrings) {
+    return { valid: true, thresholds: {} };
+  }
+
+  if (typeof thresholdStrings === 'string') {
+    specs = [thresholdStrings];
+  } else if (Array.isArray(thresholdStrings)) {
+    specs = thresholdStrings;
+  } else {
+    return { valid: true, thresholds: {} };
+  }
+
+  if (specs.length === 0) {
+    return { valid: true, thresholds: {} };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const spec of specs) {
+    const match = spec.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        valid: false,
+        error: `Invalid threshold format: "${spec}". Expected format: <metric>=<number> (e.g., exact_match=0.9)`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric: "${metricId}". Valid metrics: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    if (value < 0 || value > 1) {
+      return {
+        valid: false,
+        error: `Threshold value for "${metricId}" is ${value}, but must be between 0 and 1`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { valid: true, thresholds };
+}
