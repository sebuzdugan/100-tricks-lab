+function parseThresholds(thresholdSpecs = {}) {
+  const result = {};
+  Object.entries(thresholdSpecs).forEach(([key, value]) => {
+    const num = typeof value === 'number' ? value : Number(value);
+    if (Number.isNaN(num)) {
+      throw new Error(`Invalid threshold value for ${key}: must be a number`);
+    }
+    if (num < 0 || num > 1) {
+      throw new Error(`Invalid threshold value for ${key}: must be between 0 and 1`);
+    }
+    result[key] = num;
+  });
+  return result;
+}
+
+function evaluateThresholds(metrics, thresholds) {
+  const results = [];
+  const validMetricIds = new Set(metrics.map((m) => m.id));
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    const metric = metrics.find((m) => m.id === metricId);
+    if (!metric) {
+      throw new Error(`Unknown metric: ${metricId}. Valid metrics are: ${Array.from(validMetricIds).join(', ')}`);
+    }
+
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  });
+
+  return results;
+}
