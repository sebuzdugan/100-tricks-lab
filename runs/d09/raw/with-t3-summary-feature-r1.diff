@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Handle missing gate section (structure finding).
+  if (!result.gateSection) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count how many checks have no block-level findings.
+  const blocksByCheckId = new Map<string, Finding>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blocksByCheckId.set(finding.checkId, finding);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - blocksByCheckId.size;
+  let summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  // If there are block findings, append the check IDs in GATE_CHECKS order.
+  if (blocksByCheckId.size > 0) {
+    const blockedIds: string[] = [];
+    for (const check of GATE_CHECKS) {
+      if (blocksByCheckId.has(check.id)) {
+        blockedIds.push(check.id);
+      }
+    }
+    summary += ': ' + blockedIds.join(', ');
+  }
+
+  return summary;
+}
