-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  // Special case: if gate section is missing, return immediate BLOCK with structure
+  if (result.gateSection === null) {
+    return `BLOCK 0/${total}: structure`;
+  }
+
+  // Find which checks have block-severity findings
+  const checksWithBlock = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      checksWithBlock.add(finding.checkId);
+    }
+  }
+
+  // answered = total - (number of checks with block findings)
+  const answered = total - checksWithBlock.size;
+
+  // If no blocks, return simple verdict
+  if (checksWithBlock.size === 0) {
+    return `${result.verdict} ${answered}/${total}`;
+  }
+
+  // Otherwise, list the check IDs with blocks in GATE_CHECKS order
+  const blockedIds = GATE_CHECKS.filter((check) => checksWithBlock.has(check.id)).map(
+    (check) => check.id
+  );
+  return `BLOCK ${answered}/${total}: ${blockedIds.join(', ')}`;
+}
