@@ -0,0 +1,103 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS for a gate with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '### 5.1 Risk tier\n\n- **Tier**: limited'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with correct answered count for warnings only', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' }
+      ],
+      gateSection: '### 5.4 Evaluation plan\n\n- numbers'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with check IDs for block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing transparency', source: 'validator' }
+      ],
+      gateSection: '### 5.1 Risk tier'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7 if gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'No gate section', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('lists check IDs in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '### 5.1 Risk tier'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, data-privacy, transparency');
+  });
+
+  it('counts blocks per check, not per finding', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'No dataset', source: 'agent' }
+      ],
+      gateSection: '### 5.4 Evaluation plan'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores warnings when counting blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation', source: 'validator' },
+        { checkId: 'bias', severity: 'warn', message: 'No mitigation details', source: 'agent' }
+      ],
+      gateSection: '### 5.1 Risk tier'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('lists blocks from both agent and validator sources', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'monitoring', severity: 'block', message: 'From validator', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'From agent', source: 'agent' }
+      ],
+      gateSection: '### 5.3 Human oversight'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: oversight, monitoring');
+  });
+});
