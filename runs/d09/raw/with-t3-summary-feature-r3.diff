+describe('renderSummary', () => {
+  it('returns PASS 7/7 for a passing gate with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some content'
