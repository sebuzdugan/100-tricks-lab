+export function renderSummary(result: GateResult): string {
+  const structureFinding = result.findings.find((f) => f.checkId === 'structure');
+  if (structureFinding) {
+    return `${result.verdict} 0/7: structure`;
+  }
+
+  const blockFindingsByCheck = new Map<string, boolean>();
+  for (const check of GATE_CHECKS) {
+    blockFindingsByCheck.set(check.id, false);
+  }
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockFindingsByCheck.set(finding.checkId, true);
+    }
+  }
+
+  const answered = GATE_CHECKS.filter((check) => !blockFindingsByCheck.get(check.id)).length;
+
+  let summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  if (result.verdict === 'BLOCK') {
+    const blockedIds = GATE_CHECKS.filter((check) => blockFindingsByCheck.get(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockedIds}`;
+  }
+
+  return summary;
+}
