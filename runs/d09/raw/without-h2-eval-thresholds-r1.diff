+function validateThresholds(thresholds, availableMetrics) {
+  if (!thresholds) return null;
+
+  const errors = [];
+  const validatedThresholds = [];
+  const metricMap = new Map(availableMetrics.map(m => [m.id, m]));
+  const metricIds = Array.from(metricMap.keys());
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    if (!metricMap.has(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics are: ${metricIds.join(', ')}`);
+      return;
+    }
+
+    if (typeof min !== 'number') {
+      errors.push(`Threshold for ${metricId} must be a number, got ${typeof min}`);
+      return;
+    }
+
+    if (min < 0 || min > 1) {
+      errors.push(`Threshold for ${metricId} must be between 0 and 1, got ${min}`);
+      return;
+    }
+
+    validatedThresholds.push({ metric: metricId, min });
+  });
+
+  if (errors.length > 0) {
+    return { valid: false, errors };
+  }
+
+  return { valid: true, thresholds: validatedThresholds };
+}
+
+function evaluateThresholds(validatedThresholds, metrics) {
+  const metricMap = new Map(metrics.map(m => [m.id, m]));
+
+  const results = validatedThresholds.map(({ metric, min }) => {
+    const metricData = metricMap.get(metric);
+    const score = metricData?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    return {
+      metric,
+      min,
+      score,
+      passed
+    };
+  });
+
+  const passed = results.every(r => r.passed);
+  return { passed, thresholds: results };
+}
+
 export function generateReport({
