+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (!validMetrics.includes(metric)) {
+      log.error(`Unknown metric: ${metric}. Valid metrics are: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for ${metric}: ${valueStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (metric in thresholds) {
+      log.error(`Duplicate threshold for metric: ${metric}`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
