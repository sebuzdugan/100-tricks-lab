+function parseThresholds(thresholdArgs: string | string[] | undefined): { [key: string]: number } | null {
+  if (!thresholdArgs) return null;
+
+  const thresholdArray = Array.isArray(thresholdArgs) ? thresholdArgs : [thresholdArgs];
+  const result: { [key: string]: number } = {};
+
+  for (const arg of thresholdArray) {
+    const match = arg.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/i);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${arg}". Expected format: <metric>=<number>`);
+    }
+
+    const metricId = match[1];
+    const minScore = Number.parseFloat(match[2]);
+
+    if (minScore < 0 || minScore > 1) {
+      throw new Error(`Invalid threshold minimum for metric "${metricId}": ${minScore}. Must be between 0 and 1.`);
+    }
+
+    result[metricId] = minScore;
+  }
+
+  return Object.keys(result).length > 0 ? result : null;
+}
