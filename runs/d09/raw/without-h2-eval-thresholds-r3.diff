+function parseThresholds(thresholdStrings?: string | string[]) {
+  if (!thresholdStrings) {
+    return { thresholds: {}, validationError: null };
+  }
+
+  const thresholdArray = Array.isArray(thresholdStrings) ? thresholdStrings : (thresholdStrings ? [thresholdStrings] : []);
+
+  if (thresholdArray.length === 0) {
+    return { thresholds: {}, validationError: null };
+  }
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdArray) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        thresholds: {},
+        validationError: `Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      return {
+        thresholds: {},
+        validationError: `Invalid threshold value: "${minStr}" for metric "${metricId}". Minimum must be a number between 0 and 1.`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        thresholds: {},
+        validationError: `Unknown metric id: "${metricId}". Valid metric ids are: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, validationError: null };
+}
