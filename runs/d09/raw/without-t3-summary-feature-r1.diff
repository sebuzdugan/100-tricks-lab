@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,30 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Check if gate structure is missing
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count answered checks: those without any block-severity finding
+  const blockCheckIds = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+
+  const answered = GATE_CHECKS.filter((check) => !blockCheckIds.has(check.id)).length;
+  const total = GATE_CHECKS.length;
+
+  const summary = `${result.verdict} ${answered}/${total}`;
+
+  // If there are block findings in GATE_CHECKS, append them in order
+  if (blockCheckIds.size > 0) {
+    const blockedIds = GATE_CHECKS.filter((check) => blockCheckIds.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    return `${summary}: ${blockedIds}`;
+  }
+
+  return summary;
+}
