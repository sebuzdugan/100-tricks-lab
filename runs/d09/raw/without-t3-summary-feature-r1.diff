@@ -0,0 +1,90 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'Gate section missing', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks are answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with count and block check ids', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'No numbers', source: 'validator' }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('WARN 6/7: evaluation');
+  });
+
+  it('returns BLOCK with multiple blocked checks in order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'No numbers', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'TBD placeholder', source: 'validator' }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, evaluation, transparency');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'minimal',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers but acceptable', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Sparse metrics', source: 'validator' }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('includes only gate check ids in the output', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Prohibited tier', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'No override path', source: 'agent' }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, oversight');
+  });
+
+  it('returns correct summary when some checks have warnings and some have blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'bias', severity: 'block', message: 'No mitigation plan', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Sparse metrics', source: 'validator' }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+});
