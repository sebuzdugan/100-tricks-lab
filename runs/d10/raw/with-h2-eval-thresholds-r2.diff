index 0000000..113d8f0
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.test.js
@@ -0,0 +1,126 @@
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { afterEach, describe, expect, it } from 'vitest';
+
+import {
+  generateReport,
+  runEvaluations
+} from './index.js';
+
+const tmpDirs = [];
+afterEach(() => {
+  while (tmpDirs.length) {
+    fs.rmSync(tmpDirs.pop(), { recursive: true, force: true });
+  }
+});
+
+const createTempDir = () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-eval-'));
+  tmpDirs.push(dir);
+  return dir;
+};
+
+describe('Evaluation thresholds', () => {
+  it('adds thresholds to report and passes when all metrics meet thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5,
+        toxicity: 0.8
+      },
+      generatedAt: '2024-01-01T00:00:00.000Z'
+    });
+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.5,
+      score: 1.0,
+      passed: true
+    });
+  });
+
+  it('fails when any threshold is not met', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['different']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      },
+      generatedAt: '2024-01-01T00:00:00.000Z'
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].passed).toBe(false);
+  });
+
+  it('handles metrics with no score in threshold', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      },
+      generatedAt: '2024-01-01T00:00:00.000Z'
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].score).toBe(null);
+    expect(report.thresholds[0].passed).toBe(false);
+  });
+
+  it('does not add thresholds field when no thresholds are provided', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z'
+    });
+
+    expect(report.passed).toBeUndefined();
+    expect(report.thresholds).toBeUndefined();
+  });
+
+  it('supports multiple thresholds on same report', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World', 'Test'],
+      references: ['hello', 'world', 'test']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9,
+        toxicity: 0.9,
+        length_variance: 0.8
+      },
+      generatedAt: '2024-01-01T00:00:00.000Z'
+    });
+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(3);
+  });
+});
