diff --git a/packages/frai-core/src/eval/thresholds.test.js b/packages/frai-core/src/eval/thresholds.test.js
new file mode 100644
index 0000000..ecfa5e7
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.test.js
@@ -0,0 +1,150 @@
+import { describe, expect, it } from 'vitest';
+
+import { generateReport, runEvaluations } from './index.js';
+import { toMarkdown } from './reporters.js';
+
+describe('Threshold evaluation', () => {
+  it('applies thresholds and sets passed field', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+
+    const reportPass = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.5 }
+    });
+
+    expect(reportPass.passed).toBe(true);
+    expect(reportPass.thresholds).toHaveLength(1);
+    expect(reportPass.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.5,
+      score: 1,
+      passed: true
+    });
+  });
+
+  it('fails thresholds when score is below minimum', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'Goodbye'],
+      references: ['hello', 'world']
+    });
+
+    const reportFail = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.9 }
+    });
+
+    expect(reportFail.passed).toBe(false);
+    expect(reportFail.thresholds[0].passed).toBe(false);
+  });
+
+  it('fails threshold when metric score is null', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: []
+    });
+
+    const reportFail = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.5 }
+    });
+
+    expect(reportFail.passed).toBe(false);
+    expect(reportFail.thresholds[0].passed).toBe(false);
+    expect(reportFail.thresholds[0].score).toBe(null);
+  });
+
+  it('supports multiple thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.9, toxicity: 0.5 }
+    });
+
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds.map((t) => t.metric)).toEqual(['exact_match', 'toxicity']);
+  });
+
+  it('omits thresholds from report when no thresholds provided', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json'
+    });
+
+    expect(report.passed).toBeUndefined();
+    expect(report.thresholds).toBeUndefined();
+  });
+
+  it('includes thresholds section in markdown report', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.9 }
+    });
+
+    const markdown = toMarkdown(report);
+    expect(markdown).toContain('## Thresholds');
+    expect(markdown).toContain('exact_match');
+    expect(markdown).toContain('PASS');
+  });
+
+  it('shows FAIL status in markdown when threshold not met', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'Goodbye'],
+      references: ['hello', 'world']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.9 }
+    });
+
+    const markdown = toMarkdown(report);
+    expect(markdown).toContain('FAIL');
+  });
+
+  it('displays n/a score when metric score is null', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: []
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.5 }
+    });
+
+    const markdown = toMarkdown(report);
+    expect(markdown).toContain('n/a');
+  });
+});
