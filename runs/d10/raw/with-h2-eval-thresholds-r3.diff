+function parseAndValidateThresholds(
+  thresholdStrings: string[] = [],
+  evaluations: Array<{ id: string }>
+): { [metricId: string]: number } {
+  const thresholds: { [metricId: string]: number } = {};
+  const availableMetrics = evaluations.map((m) => m.id);
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: metric=number`);
+      console.error(`Valid metric ids: ${availableMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value: ${valueStr}. Threshold must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!availableMetrics.includes(metricId)) {
+      log.error(`Unknown metric id: "${metricId}".`);
+      console.error(`Valid metric ids: ${availableMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
