@@ -0,0 +1,99 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+function createResult(
+  verdict: 'PASS' | 'WARN' | 'BLOCK',
+  findings: Array<{ checkId: string; severity: 'block' | 'warn' }> = []
+): GateResult {
+  return {
+    verdict,
+    tier: null,
+    findings: findings.map((f) => ({
+      checkId: f.checkId,
+      severity: f.severity,
+      message: 'test',
+      source: 'validator'
+    })),
+    gateSection: '<placeholder>'
+  };
+}
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result = createResult('PASS');
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN 7/7 when there are only warnings', () => {
+    const result = createResult('WARN', [
+      { checkId: 'evaluation', severity: 'warn' },
+      { checkId: 'monitoring', severity: 'warn' }
+    ]);
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with affected check ids in order', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'transparency', severity: 'block' },
+      { checkId: 'evaluation', severity: 'block' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Missing gate section',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'evaluation', severity: 'warn' },
+      { checkId: 'bias', severity: 'block' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+
+  it('counts each unique check id once', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'data-privacy', severity: 'block' },
+      { checkId: 'data-privacy', severity: 'warn' },
+      { checkId: 'oversight', severity: 'block' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: data-privacy, oversight');
+  });
+
+  it('ignores non-gate-check findings', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'unknown-check', severity: 'block' },
+      { checkId: 'evaluation', severity: 'block' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('orders check ids according to GATE_CHECKS', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'transparency', severity: 'block' },
+      { checkId: 'risk-tier', severity: 'block' },
+      { checkId: 'monitoring', severity: 'block' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, monitoring, transparency');
+  });
+
+  it('returns BLOCK with single check id when only one has a block finding', () => {
+    const result = createResult('BLOCK', [{ checkId: 'oversight', severity: 'block' }]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: oversight');
+  });
+});
