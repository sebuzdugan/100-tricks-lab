+import { Finding, GATE_CHECKS, GateResult } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,36 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: structure finding means no gate section
+  if (result.gateSection === null) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const total = GATE_CHECKS.length;
+
+  // Get checks with block findings
+  const checksWithBlocks = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      checksWithBlocks.add(finding.checkId);
+    }
+  }
+
+  // Count answered: checks without block findings
+  const answered = total - checksWithBlocks.size;
+
+  // Build summary line
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // If there are block findings, append their check IDs in GATE_CHECKS order
+  if (checksWithBlocks.size > 0) {
+    const blockIds = GATE_CHECKS.map((check) => check.id).filter((id) =>
+      checksWithBlocks.has(id)
+    );
+    summary += `: ${blockIds.join(', ')}`;
+  }
+
+  return summary;
+}
