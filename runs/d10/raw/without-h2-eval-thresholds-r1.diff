diff --git a/packages/frai-core/src/eval/thresholds.test.js b/packages/frai-core/src/eval/thresholds.test.js
new file mode 100644
index 0000000..46f07f7
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.test.js
@@ -0,0 +1,105 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  generateReport,
+  runEvaluations
+} from './index.js';
+
+describe('Threshold evaluation', () => {
+  it('passes when all thresholds are met', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'world'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5,
+        toxicity: 0.8
+      }
+    });
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds.every((t) => t.passed)).toBe(true);
+  });
+
+  it('fails when a threshold is not met', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'world'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      }
+    });
+    expect(report.passed).toBe(false);
+    const exactMatchThreshold = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(exactMatchThreshold.passed).toBe(false);
+    expect(exactMatchThreshold.score).toBe(0.5);
+    expect(exactMatchThreshold.min).toBe(0.9);
+  });
+
+  it('fails thresholds for metrics with no score', () => {
+    const evaluations = runEvaluations({
+      outputs: [],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      }
+    });
+    expect(report.passed).toBe(false);
+    const exactMatchThreshold = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(exactMatchThreshold.passed).toBe(false);
+    expect(exactMatchThreshold.score).toBe(null);
+  });
+
+  it('does not set passed/thresholds fields without thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json'
+    });
+    expect(report.passed).toBeUndefined();
+    expect(report.thresholds).toBeUndefined();
+  });
+
+  it('includes threshold info in threshold results', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'world'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5,
+        toxicity: 0.7
+      }
+    });
+
+    expect(report.thresholds).toHaveLength(2);
+    const exactMatch = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(exactMatch).toEqual({
+      metric: 'exact_match',
+      min: 0.5,
+      score: 0.5,
+      passed: true
+    });
+  });
+});
