+function parseAndValidateThresholds(thresholdArgs?: string[]): Record<string, number> | null {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return null;
+  }
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const arg of thresholdArgs) {
+    const parts = arg.split('=');
+    if (parts.length !== 2) {
+      log.error('Invalid threshold format', { threshold: arg, expected: '<metric>=<number>' });
+      process.exit(2);
+    }
+
+    const [metricId, valueStr] = parts;
+    const value = Number.parseFloat(valueStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error('Unknown metric id', { metric: metricId, validMetrics: validMetricIds });
+      process.exit(2);
+    }
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error('Invalid threshold value', { threshold: arg, value, expected: 'number between 0 and 1' });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
