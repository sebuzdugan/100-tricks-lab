+import { describe, it, expect } from 'vitest';
+
+// This is a test for the parseThresholds logic that will be tested indirectly
+// through the CLI integration, but we'll test the parsing logic here
+
+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number> | null; validationError?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null };
+  }
+
+  const parsed: Record<string, number> = {};
+  const defaultMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        thresholds: null,
+        validationError: `Malformed threshold: '${thresholdStr}'. Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      return {
+        thresholds: null,
+        validationError: `Invalid threshold value: '${valueStr}'. Must be a number between 0 and 1.`
+      };
+    }
+
+    if (!defaultMetricIds.includes(metricId)) {
+      return {
+        thresholds: null,
+        validationError: `Unknown metric: '${metricId}'. Valid metric ids are: ${defaultMetricIds.join(', ')}.`
+      };
+    }
+
+    parsed[metricId] = value;
+  }
+
+  return { thresholds: parsed };
+}
+
+describe('Threshold parsing', () => {
+  it('parses valid single threshold', () => {
+    const result = parseThresholds(['exact_match=0.9']);
+    expect(result.thresholds).toEqual({ exact_match: 0.9 });
+    expect(result.validationError).toBeUndefined();
+  });
+
+  it('parses multiple thresholds', () => {
+    const result = parseThresholds(['exact_match=0.9', 'toxicity=0.95']);
+    expect(result.thresholds).toEqual({
+      exact_match: 0.9,
+      toxicity: 0.95
+    });
+    expect(result.validationError).toBeUndefined();
+  });
+
+  it('returns null thresholds when none provided', () => {
+    const result = parseThresholds();
+    expect(result.thresholds).toBeNull();
+    expect(result.validationError).toBeUndefined();
+  });
+
+  it('returns null thresholds with empty array', () => {
+    const result = parseThresholds([]);
+    expect(result.thresholds).toBeNull();
+    expect(result.validationError).toBeUndefined();
+  });
+
+  it('rejects malformed threshold without equals', () => {
+    const result = parseThresholds(['exact_match:0.9']);
+    expect(result.thresholds).toBeNull();
+    expect(result.validationError).toContain('Malformed threshold');
+  });
+
+  it('rejects malformed threshold without number', () => {
+    const result = parseThresholds(['exact_match=']);
+    expect(result.thresholds).toBeNull();
+    expect(result.validationError).toContain('Malformed threshold');
+  });
+
+  it('rejects threshold value above 1', () => {
+    const result = parseThresholds(['exact_match=1.5']);
+    expect(result.thresholds).toBeNull();
+    expect(result.validationError).toContain('Must be a number between 0 and 1');
+  });
+
+  it('rejects threshold value below 0', () => {
+    const result = parseThresholds(['exact_match=-0.1']);
+    expect(result.thresholds).toBeNull();
+    expect(result.validationError).toContain('Must be a number between 0 and 1');
+  });
+
+  it('accepts threshold value 0', () => {
+    const result = parseThresholds(['exact_match=0']);
+    expect(result.thresholds).toEqual({ exact_match: 0 });
+  });
+
+  it('accepts threshold value 1', () => {
+    const result = parseThresholds(['exact_match=1']);
+    expect(result.thresholds).toEqual({ exact_match: 1 });
+  });
+
+  it('rejects unknown metric', () => {
+    const result = parseThresholds(['unknown_metric=0.9']);
+    expect(result.thresholds).toBeNull();
+    expect(result.validationError).toContain('Unknown metric');
+    expect(result.validationError).toContain('exact_match');
+    expect(result.validationError).toContain('toxicity');
+    expect(result.validationError).toContain('length_variance');
+  });
+
+  it('stops at first error with multiple thresholds', () => {
+    const result = parseThresholds(['exact_match=0.9', 'invalid=0.8']);
+    expect(result.thresholds).toBeNull();
+    expect(result.validationError).toContain('Unknown metric');
+  });
+
+  it('accepts decimal threshold values', () => {
+    const result = parseThresholds(['exact_match=0.123']);
+    expect(result.thresholds).toEqual({ exact_match: 0.123 });
+  });
+
+  it('accepts all valid metric ids', () => {
+    const result = parseThresholds([
+      'exact_match=0.9',
+      'toxicity=0.95',
+      'length_variance=0.8'
+    ]);
+    expect(result.thresholds).toEqual({
+      exact_match: 0.9,
+      toxicity: 0.95,
+      length_variance: 0.8
+    });
+  });
+});
