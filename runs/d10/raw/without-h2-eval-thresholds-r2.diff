+import { describe, it, expect } from 'vitest';
+
+import { toMarkdown, toJson } from './reporters.js';
+
+describe('Report formatting with thresholds', () => {
+  it('includes thresholds section in markdown when present', () => {
+    const report = {
+      metadata: {
+        generatedAt: '2024-01-01T00:00:00.000Z',
+        outputsPath: '/tmp/outputs.json',
+        referencesPath: '/tmp/refs.json',
+        totalSamples: 100
+      },
+      metrics: [
+        {
+          id: 'exact_match',
+          label: 'Exact Match',
+          score: 0.95,
+          total: 100,
+          matches: 95
+        }
+      ],
+      passed: true,
+      thresholds: [
+        {
+          metric: 'exact_match',
+          min: 0.9,
+          score: 0.95,
+          passed: true
+        }
+      ]
+    };
+
+    const markdown = toMarkdown(report);
+    expect(markdown).toContain('## Thresholds');
+    expect(markdown).toContain('exact_match');
+    expect(markdown).toContain('PASS');
+    expect(markdown).toContain('min: 0.9');
+    expect(markdown).toContain('score: 0.95');
+  });
+
+  it('shows FAIL status in markdown for failed thresholds', () => {
+    const report = {
+      metadata: {
+        generatedAt: '2024-01-01T00:00:00.000Z',
+        outputsPath: '/tmp/outputs.json',
+        referencesPath: '/tmp/refs.json',
+        totalSamples: 100
+      },
+      metrics: [
+        {
+          id: 'exact_match',
+          label: 'Exact Match',
+          score: 0.85,
+          total: 100,
+          matches: 85
+        }
+      ],
+      passed: false,
+      thresholds: [
+        {
+          metric: 'exact_match',
+          min: 0.9,
+          score: 0.85,
+          passed: false
+        }
+      ]
+    };
+
+    const markdown = toMarkdown(report);
+    expect(markdown).toContain('## Thresholds');
+    expect(markdown).toContain('exact_match');
+    expect(markdown).toContain('FAIL');
+    expect(markdown).toContain('min: 0.9');
+    expect(markdown).toContain('score: 0.85');
+  });
+
+  it('handles null scores in markdown thresholds', () => {
+    const report = {
+      metadata: {
+        generatedAt: '2024-01-01T00:00:00.000Z',
+        outputsPath: '/tmp/outputs.json',
+        referencesPath: null,
+        totalSamples: 0
+      },
+      metrics: [
+        {
+          id: 'exact_match',
+          label: 'Exact Match',
+          score: null,
+          details: 'No references provided'
+        }
+      ],
+      passed: false,
+      thresholds: [
+        {
+          metric: 'exact_match',
+          min: 0.9,
+          score: null,
+          passed: false
+        }
+      ]
+    };
+
+    const markdown = toMarkdown(report);
+    expect(markdown).toContain('exact_match');
+    expect(markdown).toContain('FAIL');
+    expect(markdown).toContain('score: n/a');
+  });
+
+  it('omits thresholds section when none present', () => {
+    const report = {
+      metadata: {
+        generatedAt: '2024-01-01T00:00:00.000Z',
