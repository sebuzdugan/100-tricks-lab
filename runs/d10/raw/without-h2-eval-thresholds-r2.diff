+import { describe, it, expect } from 'vitest';
+
+import { generateReport } from './index.js';
+
+describe('Threshold evaluation', () => {
+  it('passes all thresholds when scores are above minimums', () => {
+    const evaluations = [
+      {
+        id: 'exact_match',
+        label: 'Exact Match',
+        score: 0.95,
+        total: 100,
+        matches: 95
+      },
+      {
+        id: 'toxicity',
+        label: 'Toxicity',
+        score: 0.99,
+        total: 100,
+        flagged: 1
+      }
+    ];
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9,
+        toxicity: 0.95
+      }
+    });
+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.9,
+      score: 0.95,
+      passed: true
+    });
+    expect(report.thresholds[1]).toEqual({
+      metric: 'toxicity',
+      min: 0.95,
+      score: 0.99,
+      passed: true
+    });
+  });
+
+  it('fails when any threshold is below minimum', () => {
+    const evaluations = [
+      {
+        id: 'exact_match',
+        label: 'Exact Match',
+        score: 0.85,
+        total: 100,
+        matches: 85
+      },
+      {
+        id: 'toxicity',
+        label: 'Toxicity',
+        score: 0.99,
+        total: 100,
+        flagged: 1
+      }
+    ];
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9,
+        toxicity: 0.95
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.9,
+      score: 0.85,
+      passed: false
+    });
+    expect(report.thresholds[1].passed).toBe(true);
+  });
+
+  it('fails threshold when metric score is null', () => {
+    const evaluations = [
+      {
+        id: 'exact_match',
+        label: 'Exact Match',
+        score: null,
+        details: 'No references provided'
+      }
+    ];
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: null,
+      thresholds: {
+        exact_match: 0.9
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0]).toEqual({
