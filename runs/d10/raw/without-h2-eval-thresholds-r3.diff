+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${thresholdStr}. Expected format: metric=number`);
+      console.error(`Valid metric ids: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (value < 0 || value > 1) {
+      log.error(`Invalid threshold value: ${value}. Must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      log.error(`Unknown metric id: ${metricId}`);
+      console.error(`Valid metric ids: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
