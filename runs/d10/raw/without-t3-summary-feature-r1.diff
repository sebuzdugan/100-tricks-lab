+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,33 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: if structure is missing (no gate section)
+  if (!result.gateSection) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Get the set of check IDs that have at least one block-severity finding
+  const blockedCheckIds = new Set(
+    result.findings
+      .filter(f => f.severity === 'block')
+      .map(f => f.checkId)
+  );
+
+  // Count answered = total checks - checks with block findings
+  const answered = GATE_CHECKS.length - blockedCheckIds.size;
+
+  const verdict = result.verdict;
+  let summary = `${verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  // If there are block findings, append the check ids in GATE_CHECKS order
+  if (blockedCheckIds.size > 0) {
+    const blockIds = GATE_CHECKS
+      .map(c => c.id)
+      .filter(id => blockedCheckIds.has(id));
+    summary += `: ${blockIds.join(', ')}`;
+  }
+
+  return summary;
+}
