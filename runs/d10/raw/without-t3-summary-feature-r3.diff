@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,30 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const TOTAL_CHECKS = GATE_CHECKS.length;
+
+  // If structure finding exists, gate section is missing
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count answered checks (checks with no block-severity findings)
+  const blockingCheckIds = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+
+  const answered = TOTAL_CHECKS - blockingCheckIds.size;
+  let summary = `${result.verdict} ${answered}/${TOTAL_CHECKS}`;
+
+  if (blockingCheckIds.size > 0) {
+    // Get check ids in GATE_CHECKS order
+    const orderedBlockingIds = GATE_CHECKS.filter((check) =>
+      blockingCheckIds.has(check.id)
+    ).map((check) => check.id);
+    summary += `: ${orderedBlockingIds.join(', ')}`;
+  }
+
+  return summary;
+}
