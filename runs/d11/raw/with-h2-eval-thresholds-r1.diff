+function parseAndValidateThresholds(
+  thresholdStrings?: string[]
+): Map<string, number> | null {
+  if (!thresholdStrings?.length) return null;
+
+  const VALID_METRICS = new Set(['exact_match', 'toxicity', 'length_variance']);
+  const thresholds = new Map<string, number>();
+
+  for (const threshold of thresholdStrings) {
+    const [metric, minStr] = threshold.split('=');
+
+    if (!metric?.trim() || minStr === undefined) {
+      log.error(`Invalid threshold format: "${threshold}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    if (!VALID_METRICS.has(metric)) {
+      log.error(
+        `Unknown metric: "${metric}". Valid metrics: ${Array.from(VALID_METRICS).join(', ')}`
+      );
+      process.exit(2);
+    }
+
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(
+        `Invalid threshold value: "${minStr}". Must be a number between 0 and 1.`
+      );
+      process.exit(2);
+    }
+
+    thresholds.set(metric, min);
+  }
+
+  return thresholds;
+}
