+function computeThresholdResults(evaluations, thresholds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return undefined;
+  }
+
+  return Object.entries(thresholds).map(([metricId, minValue]) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+
+    if (!metric) {
+      return {
+        metric: metricId,
+        min: minValue,
+        score: null,
+        passed: false
+      };
+    }
+
+    const score = metric.score;
+    const passed = score !== null && score >= minValue;
+
+    return {
+      metric: metricId,
+      min: minValue,
+      score: score ?? null,
+      passed
+    };
+  });
+}
