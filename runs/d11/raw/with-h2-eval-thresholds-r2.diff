+    expect(report.metadata.thresholds).toBeUndefined();
+    expect(report.metadata.anyThresholdsFailed).toBeUndefined();
+    const exactMatch = report.metrics.find((m) => m.id === 'exact_match');
+    expect(exactMatch.threshold).toBeUndefined();
+    expect(exactMatch.passed).toBeUndefined();
