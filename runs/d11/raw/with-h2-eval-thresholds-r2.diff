@@ -76,4 +76,116 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  it('adds thresholds to report when provided', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.9 }
+    });
+
+    expect(report.metadata.thresholds).toEqual({ exact_match: 0.9 });
+    const exactMatch = report.metrics.find((m) => m.id === 'exact_match');
+    expect(exactMatch.threshold).toBe(0.9);
+    expect(exactMatch.passed).toBe(true);
+  });
+
+  it('marks threshold as failed when score is below minimum', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'Goodbye'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.95 }
+    });
+
+    expect(report.metadata.anyThresholdsFailed).toBe(true);
+    const exactMatch = report.metrics.find((m) => m.id === 'exact_match');
+    expect(exactMatch.passed).toBe(false);
+  });
+
+  it('fails threshold when metric score is null', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: null,
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.5 }
+    });
+
+    expect(report.metadata.anyThresholdsFailed).toBe(true);
+    const exactMatch = report.metrics.find((m) => m.id === 'exact_match');
+    expect(exactMatch.passed).toBe(false);
+  });
+
+  it('handles multiple thresholds with mixed results', () => {
+    const evaluations = runEvaluations({
+      outputs: ['hello', 'world'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.9, length_variance: 0.5 }
+    });
+
+    expect(report.metadata.anyThresholdsFailed).toBe(false);
+    const exactMatch = report.metrics.find((m) => m.id === 'exact_match');
+    const lengthVariance = report.metrics.find((m) => m.id === 'length_variance');
+    expect(exactMatch.passed).toBe(true);
+    expect(lengthVariance.passed).toBe(true);
+  });
+
+  it('reports without thresholds have no threshold metadata', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z'
+    });
