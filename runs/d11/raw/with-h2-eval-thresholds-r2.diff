+  let anyThresholdsFailed = false;
+  const metricsWithThresholds = evaluations.map((metric) => {
+    const threshold = thresholds[metric.id];
+    if (threshold !== undefined) {
+      const passed = metric.score !== null && metric.score >= threshold;
