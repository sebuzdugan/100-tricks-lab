+function parseThresholds(thresholdStrings?: string[]): { [metricId: string]: number } {
+  const thresholds: { [key: string]: number } = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([\d.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}"`);
+      console.error('Expected format: <metric>=<number>');
+      console.error('Example: exact_match=0.9');
+      process.exit(2);
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      log.error(`Invalid threshold range: "${thresholdStr}"`);
+      console.error('Score must be between 0 and 1');
+      process.exit(2);
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return thresholds;
+}
+
+function determineExitCode(report: any): number {
+  if (report.metadata.anyThresholdsFailed === true) {
+    return 1;
+  }
+  return 0;
+}
