+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+function parseAndValidateThresholds(thresholdStrings?: string[]): Record<string, number> {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error('Invalid threshold format.', {
+        message: `Threshold must be in format <metric>=<number>, got: ${thresholdStr}`,
+        validMetrics: VALID_METRIC_IDS
+      });
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = parseFloat(minStr);
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      log.error('Invalid threshold value.', {
+        message: `Minimum must be a number between 0 and 1, got: ${minStr}`,
+        validMetrics: VALID_METRIC_IDS
+      });
+      process.exit(2);
+    }
+
+    if (!VALID_METRIC_IDS.includes(metricId)) {
+      log.error('Unknown metric ID.', {
+        message: `Unknown metric: ${metricId}`,
+        validMetrics: VALID_METRIC_IDS
+      });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
