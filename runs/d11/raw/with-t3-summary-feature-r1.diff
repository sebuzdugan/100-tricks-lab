index 0000000..7f31419
--- /dev/null
+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,122 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+function createResult(
+  verdict: GateResult['verdict'],
+  findings: Finding[] = [],
+  gateSection: string | null = 'some section'
+): GateResult {
+  return {
+    verdict,
+    findings,
+    tier: null,
+    gateSection
+  };
+}
+
+function finding(checkId: string, severity: 'block' | 'warn' = 'warn'): Finding {
+  return {
+    checkId,
+    severity,
+    message: `${severity} finding for ${checkId}`,
+    source: 'validator'
+  };
+}
+
+describe('renderSummary', () => {
+  it('renders PASS with no findings', () => {
+    const result = createResult('PASS', []);
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('renders WARN when all checks answered with warnings only', () => {
+    const result = createResult('WARN', [finding('evaluation', 'warn')]);
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('renders single block finding', () => {
+    const result = createResult('BLOCK', [finding('data-privacy', 'block')]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('renders multiple block findings in GATE_CHECKS order', () => {
+    const result = createResult('BLOCK', [
+      finding('transparency', 'block'),
+      finding('risk-tier', 'block'),
+      finding('bias', 'block')
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, bias, transparency');
+  });
+
+  it('deduplicates block findings for same checkId', () => {
+    const result = createResult('BLOCK', [
+      finding('evaluation', 'block'),
+      finding('evaluation', 'block')
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores warning findings when determining block status', () => {
+    const result = createResult('BLOCK', [
+      finding('evaluation', 'block'),
+      finding('monitoring', 'warn')
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('handles structure block (missing gate section)', () => {
+    const result = createResult(
+      'BLOCK',
+      [{ checkId: 'structure', severity: 'block', message: 'structure not found', source: 'validator' }],
+      null
+    );
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('structure block takes precedence over other blocks', () => {
+    const result = createResult(
+      'BLOCK',
+      [
+        { checkId: 'structure', severity: 'block', message: 'structure not found', source: 'validator' },
+        finding('evaluation', 'block')
+      ],
+      null
+    );
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('preserves GATE_CHECKS order for multiple blocks', () => {
+    const result = createResult('BLOCK', [
+      finding('monitoring', 'block'),
+      finding('evaluation', 'block'),
+      finding('data-privacy', 'block')
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, evaluation, monitoring');
+  });
+
+  it('renders all 7 block findings', () => {
+    const result = createResult('BLOCK', [
+      finding('risk-tier', 'block'),
+      finding('data-privacy', 'block'),
+      finding('oversight', 'block'),
+      finding('evaluation', 'block'),
+      finding('bias', 'block'),
+      finding('monitoring', 'block'),
+      finding('transparency', 'block')
+    ]);
+    expect(renderSummary(result)).toBe(
+      'BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency'
+    );
+  });
+
+  it('handles mixed findings with correct answered count', () => {
+    const result = createResult('BLOCK', [
+      finding('risk-tier', 'block'),
+      finding('data-privacy', 'block'),
+      finding('oversight', 'warn'),
+      finding('evaluation', 'block')
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, data-privacy, evaluation');
+  });
+});
