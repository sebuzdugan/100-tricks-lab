+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'minimal',
+      findings: [],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN 7/7 when only warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Missing numeric thresholds',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with blocked check when single check has block', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing privacy statement',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('returns BLOCK with multiple blocked checks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'No evaluation plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'No incident response plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'block',
+          message: 'No monitoring plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: evaluation, monitoring, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Missing gate section',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns BLOCK 0/7: structure even if other blocks are present', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Missing gate section',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'No evaluation plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('counts warnings as answered when no block exists for that check', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'high',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Missing numeric thresholds',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'Missing numeric thresholds',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('lists only checks with blocks, deduplicating multiple findings per check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'No kill switch',
+          source: 'validator'
+        },
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'No override path',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'No bias analysis',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: oversight, bias');
+  });
+
+  it('handles agent-sourced findings the same as validator findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Plan is insufficient',
+          source: 'agent'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
