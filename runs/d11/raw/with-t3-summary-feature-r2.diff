@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,33 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (!result.gateSection && result.findings.some(f => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const checkIds = GATE_CHECKS.map(c => c.id);
+  let answered = 0;
+  const blockingCheckIds: string[] = [];
+
+  for (const checkId of checkIds) {
+    const hasBlock = result.findings.some(
+      f => f.checkId === checkId && f.severity === 'block'
+    );
+    if (hasBlock) {
+      blockingCheckIds.push(checkId);
+    } else {
+      answered++;
+    }
+  }
+
+  const total = checkIds.length;
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockingCheckIds.length > 0) {
+    summary += `: ${blockingCheckIds.join(', ')}`;
+  }
+
+  return summary;
+}
