@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,25 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (!result.gateSection || result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blocksByCheckId = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+
+  const answered = GATE_CHECKS.length - blocksByCheckId.size;
+
+  if (blocksByCheckId.size === 0) {
+    return `${result.verdict} ${answered}/7`;
+  }
+
+  const orderedBlockIds = GATE_CHECKS.filter((c) => blocksByCheckId.has(c.id))
+    .map((c) => c.id)
+    .join(', ');
+
+  return `${result.verdict} ${answered}/7: ${orderedBlockIds}`;
+}
