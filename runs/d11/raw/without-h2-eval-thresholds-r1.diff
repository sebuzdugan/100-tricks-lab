+function parseThresholds(thresholdStrings: string[] | undefined): { thresholds: Record<string, number> | null; validMetricIds: string[] } {
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null, validMetricIds };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricSet = new Set(validMetricIds);
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${threshStr}". Expected format: metric=value (e.g., exact_match=0.9)`);
+      log.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (!validMetricSet.has(metricId)) {
+      log.error(`Unknown metric: "${metricId}". Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (value < 0 || value > 1) {
+      log.error(`Threshold value for "${metricId}" must be between 0 and 1, got ${value}`);
+      process.exit(2);
+    }
+
+    if (metricId in thresholds) {
+      log.error(`Duplicate threshold for metric: "${metricId}"`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds, validMetricIds };
+}
