+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}" (expected format: metric=number)`);
+    }
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+    if (min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value: ${min} (must be between 0 and 1)`);
+    }
+    thresholds[metricId] = min;
+  }
+  return thresholds;
+}
+
+function getValidMetricIds() {
+  const getMetricIds = Eval.getMetricIds as unknown as (metrics?: unknown) => string[];
+  try {
+    return getMetricIds();
+  } catch {
+    return ['exact_match', 'toxicity', 'length_variance'];
+  }
+}
+
+function validateThresholds(thresholds: Record<string, number> | null) {
+  if (!thresholds) return;
+  const validIds = getValidMetricIds();
+  const unknownMetrics = Object.keys(thresholds).filter((id) => !validIds.includes(id));
+  if (unknownMetrics.length > 0) {
+    const message = `Unknown metric: ${unknownMetrics[0]}\nValid metrics: ${validIds.join(', ')}`;
+    throw new Error(message);
+  }
+}
