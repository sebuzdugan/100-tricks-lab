+function evaluateThresholds(evaluations, thresholds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return null;
+  }
+
+  const metricById = {};
+  evaluations.forEach((metric) => {
+    metricById[metric.id] = metric;
+  });
+
+  const results = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    const metric = metricById[metricId];
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  });
+
+  return { results, passed: allPassed };
+}
