+function parseThresholds(thresholdArgs?: string[]): Record<string, number> | undefined {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([^=]+)=(.+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: ${arg}. Expected format: <metric>=<number>`);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!Number.isFinite(value) || value < 0 || value > 1) {
+      throw new Error(
+        `Invalid threshold value for ${metricId}: ${valueStr}. Must be a number between 0 and 1.`
+      );
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
