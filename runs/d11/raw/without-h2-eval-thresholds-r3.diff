+export function validateThresholds(thresholds, metrics) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true };
+  }
+
+  const validMetricIds = new Set(metrics.map((m) => m.id));
+  const errors = [];
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(
+        `Unknown metric: ${metricId}. Valid metric ids are: ${Array.from(validMetricIds).join(', ')}`
+      );
+    } else if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`Invalid threshold for ${metricId}: ${min}. Must be a number between 0 and 1.`);
+    }
+  }
+
+  return errors.length > 0 ? { valid: false, errors } : { valid: true };
+}
+
+export function evaluateThresholds(metrics, thresholds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { thresholds: [], passed: true };
+  }
+
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return { thresholds: results, passed: allPassed };
+}
