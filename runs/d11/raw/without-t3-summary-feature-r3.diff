@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,28 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (!result.gateSection) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - blockCheckIds.size;
+  const total = GATE_CHECKS.length;
+
+  if (blockCheckIds.size === 0) {
+    return `${result.verdict} ${answered}/${total}`;
+  }
+
+  const sortedBlockIds = GATE_CHECKS.filter((check) => blockCheckIds.has(check.id)).map(
+    (check) => check.id
+  );
+  return `${result.verdict} ${answered}/${total}: ${sortedBlockIds.join(', ')}`;
+}
