@@ -53,6 +53,7 @@ interface EvalOptions {
   references?: string;
   report?: string;
   format?: 'json' | 'markdown';
+  threshold?: string[];
 }
 
 interface RagOptions {
@@ -473,6 +474,32 @@ function assertFileExists(targetPath: string) {
   }
 }
 
+function parseThresholds(thresholdArgs: string[] | undefined): Record<string, number> {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([^=]+)=(.+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${arg}". Expected format: <metric>=<min>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min)) {
+      log.error(`Invalid threshold minimum for metric "${metricId}": "${minStr}" is not a number.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
+
 function runEvalCommand(options: EvalOptions) {
   assertFileExists(options.outputs);
   const dataset = (Eval.loadDataset as unknown as (config: unknown) => any)({
@@ -483,17 +510,32 @@ function runEvalCommand(options: EvalOptions) {
     outputs: dataset.outputs,
     references: dataset.references
   });
-  const report = (Eval.generateReport as unknown as (config: unknown) => any)({
-    evaluations,
-    outputsPath: dataset.outputsPath,
-    referencesPath: dataset.referencesPath
-  });
+
+  const thresholds = parseThresholds(options.threshold);
+  let report: any;
+
+  try {
+    report = (Eval.generateReport as unknown as (config: unknown) => any)({
+      evaluations,
+      outputsPath: dataset.outputsPath,
+      referencesPath: dataset.referencesPath,
+      thresholds: Object.keys(thresholds).length > 0 ? thresholds : undefined
