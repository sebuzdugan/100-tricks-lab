+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const str of thresholdStrings) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: ${str}. Expected <metric>=<number>.`);
+      process.exit(2);
+    }
+
+    const metric = parts[0].trim();
+    const valueStr = parts[1].trim();
+
+    if (!metric) {
+      log.error(`Invalid threshold format: ${str}. Expected <metric>=<number>.`);
+      process.exit(2);
+    }
+
+    const value = Number.parseFloat(valueStr);
+    if (Number.isNaN(value)) {
+      log.error(`Invalid threshold format: ${str}. Expected <metric>=<number>.`);
+      process.exit(2);
+    }
+
+    if (value < 0 || value > 1) {
+      log.error(`Invalid threshold value for ${metric}: ${value}. Must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
