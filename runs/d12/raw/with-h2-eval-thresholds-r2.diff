@@ -76,4 +76,113 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  it('evaluates thresholds that pass', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'friendly world'],
+      references: ['hello', 'friendly world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.5 }
+    });
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(1);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.5,
+      score: expect.any(Number),
+      passed: true
+    });
+  });
+
+  it('evaluates thresholds that fail', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'unfriendly world'],
+      references: ['hello', 'friendly world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.9 }
+    });
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].passed).toBe(false);
+  });
+
+  it('handles missing metric score as threshold failure', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.5 }
+    });
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].score).toBeNull();
+    expect(report.thresholds[0].passed).toBe(false);
+  });
+
+  it('handles multiple thresholds with mixed pass/fail', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'unfriendly world'],
+      references: ['hello', 'friendly world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
