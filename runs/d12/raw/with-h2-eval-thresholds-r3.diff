   assertFileExists(options.outputs);
+
+  let thresholds: Record<string, number> | undefined;
+  try {
+    thresholds = buildThresholdsMap(options.threshold);
+  } catch (error) {
+    log.error('Threshold error.', {
+      error: error instanceof Error ? error.message : String(error)
+    });
+    process.exit(2);
+  }
+
   const dataset = (Eval.loadDataset as unknown as (config: unknown) => any)({
     outputsPath: options.outputs,
     referencesPath: options.references
