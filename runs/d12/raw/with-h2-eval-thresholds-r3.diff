+function parseThreshold(thresholdStr: string): { metric: string; min: number } {
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    throw new Error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<value>`);
+  }
+  const [metric, valueStr] = parts;
+  const min = Number.parseFloat(valueStr);
+  if (Number.isNaN(min)) {
+    throw new Error(`Invalid threshold value: "${valueStr}". Must be a number between 0 and 1.`);
+  }
+  if (min < 0 || min > 1) {
+    throw new Error(`Invalid threshold value: ${min}. Must be between 0 and 1.`);
+  }
+  return { metric: metric.trim(), min };
+}
+
+function buildThresholdsMap(thresholdStrs?: string[]): Record<string, number> | undefined {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return undefined;
+  }
+  const thresholds: Record<string, number> = {};
+  thresholdStrs.forEach((str) => {
+    const { metric, min } = parseThreshold(str);
+    if (thresholds[metric] === undefined) {
+      thresholds[metric] = min;
+    } else {
+      thresholds[metric] = Math.max(thresholds[metric], min);
+    }
+  });
+  return thresholds;
+}
+
+function validateThresholds(thresholds: Record<string, number>, evaluations: any[]): { valid: boolean; errors: string[] } {
+  const errors: string[] = [];
+  const validMetrics = new Set(evaluations.map((m) => m.id));
+
+  Object.keys(thresholds).forEach((metricId) => {
+    if (!validMetrics.has(metricId)) {
+      errors.push(`Unknown metric: "${metricId}"`);
+    }
+  });
+
+  if (errors.length > 0) {
+    const validList = Array.from(validMetrics).join(', ');
+    errors.push(`Valid metrics: ${validList}`);
+  }
+
+  return { valid: errors.length === 0, errors };
+}
