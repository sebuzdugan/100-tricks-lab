+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('should return "PASS 7/7" when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('should return "WARN 7/7" when there are only warnings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Missing threshold', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Vague rollback plan', source: 'validator' }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('should return "BLOCK 5/7: evaluation, transparency" for specific blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation plan', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'No incident response', source: 'validator' }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('should return "BLOCK 6/7: risk-tier" for single block', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing risk tier', source: 'validator' }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('should return "BLOCK 0/7: structure" when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('should handle multiple blocks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'No incident response', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Missing fairness analysis', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'No override path', source: 'validator' }
+      ],
+      gateSection: 'Some gate content'
+    };
+    // GATE_CHECKS order: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency
+    expect(renderSummary(result)).toBe('BLOCK 4/7: oversight, bias, transparency');
+  });
+
+  it('should ignore warnings when calculating answered count', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing thresholds', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Vague rollback plan', source: 'validator' },
+        { checkId: 'bias', severity: 'warn', message: 'Incomplete analysis', source: 'validator' }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('should handle findings from both validator and agent sources', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing plan', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'No incident response', source: 'agent' }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+});
