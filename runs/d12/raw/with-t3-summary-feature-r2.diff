 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (result.findings.some(f => f.checkId === 'structure' && f.severity === 'block')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const checksWithBlockFindings = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      checksWithBlockFindings.add(finding.checkId);
+    }
+  }
+
+  const total = 7;
+  const answered = total - checksWithBlockFindings.size;
+  const verdict = checksWithBlockFindings.size > 0 ? 'BLOCK' : 'PASS';
+
+  let summary = `${verdict} ${answered}/${total}`;
+
+  if (checksWithBlockFindings.size > 0) {
+    const blockCheckIds: string[] = [];
+    for (const check of GATE_CHECKS) {
+      if (checksWithBlockFindings.has(check.id)) {
+        blockCheckIds.push(check.id);
+      }
+    }
+    summary += `: ${blockCheckIds.join(', ')}`;
+  }
+
+  return summary;
+}
