+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+function createResult(findings: Finding[] = []): GateResult {
+  return {
+    verdict: findings.some(f => f.severity === 'block') ? 'BLOCK' : 'PASS',
+    tier: null,
+    findings,
+    gateSection: '<gate section>'
+  };
+}
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result = createResult([]);
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result = createResult([
+      {
+        checkId: 'structure',
+        severity: 'block',
+        message: 'No gate section',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns BLOCK 6/7: <check-id> when single check has block finding', () => {
+    const result = createResult([
+      {
+        checkId: 'evaluation',
+        severity: 'block',
+        message: 'Missing evaluation plan',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('returns BLOCK X/7: <ids> when multiple checks have block findings', () => {
+    const result = createResult([
+      {
+        checkId: 'evaluation',
+        severity: 'block',
+        message: 'Missing evaluation',
+        source: 'validator'
+      },
+      {
+        checkId: 'transparency',
+        severity: 'block',
+        message: 'Missing transparency',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists block check IDs in GATE_CHECKS definition order', () => {
+    const result = createResult([
+      {
+        checkId: 'transparency',
+        severity: 'block',
+        message: 'Missing transparency',
+        source: 'validator'
+      },
+      {
+        checkId: 'bias',
+        severity: 'block',
+        message: 'Missing bias check',
+        source: 'validator'
+      },
+      {
+        checkId: 'risk-tier',
+        severity: 'block',
+        message: 'Missing risk tier',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, bias, transparency');
+  });
+
+  it('ignores warnings and does not reduce answered count', () => {
+    const result = createResult([
+      {
+        checkId: 'evaluation',
+        severity: 'warn',
+        message: 'No numeric thresholds',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('counts checks with both block and warn findings as having block findings', () => {
+    const result = createResult([
+      {
+        checkId: 'evaluation',
+        severity: 'block',
+        message: 'Missing evaluation',
+        source: 'validator'
+      },
+      {
+        checkId: 'evaluation',
+        severity: 'warn',
+        message: 'No numeric thresholds',
+        source: 'validator'
+      },
+      {
+        checkId: 'monitoring',
+        severity: 'warn',
+        message: 'Could be more specific',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('does not duplicate check IDs when multiple findings exist for same check', () => {
+    const result = createResult([
+      {
+        checkId: 'data-privacy',
+        severity: 'block',
+        message: 'First issue',
+        source: 'validator'
+      },
+      {
+        checkId: 'data-privacy',
+        severity: 'block',
+        message: 'Second issue',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+});
