 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,32 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: missing gate section
+  const structureBlocking = result.findings.find(
+    (f) => f.checkId === 'structure' && f.severity === 'block'
+  );
+  if (structureBlocking) {
+    return 'BLOCK 0/7: structure\n';
+  }
+
+  // Count answered checks (checks without block-severity findings)
+  const checkIdsWithBlocks = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+  const answered = GATE_CHECKS.length - checkIdsWithBlocks.size;
+
+  // Build the base line
+  let line = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  // Append block findings IDs if any exist
+  if (checkIdsWithBlocks.size > 0) {
+    const blockingIds = GATE_CHECKS.filter((check) => checkIdsWithBlocks.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    line += `: ${blockingIds}`;
+  }
+
+  return `${line}\n`;
+}
