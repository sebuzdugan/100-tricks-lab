+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+function parseThresholds(thresholdStrings: string | string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrings) {
+    return null;
+  }
+
+  const strings = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  if (strings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of strings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${thresholdStr}`);
+      log.error(`Expected format: <metric>=<number> (e.g., exact_match=0.9)`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+
+    if (!VALID_METRIC_IDS.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`);
+      log.error(`Valid metric IDs: ${VALID_METRIC_IDS.join(', ')}`);
+      process.exit(2);
+    }
+
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: ${minStr}`);
+      log.error(`Threshold must be a number between 0 and 1 (inclusive)`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
