+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || !thresholdStrings.length) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${thresholdStr}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minScore = Number.parseFloat(match[2]);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}. Valid metrics: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(minScore) || minScore < 0 || minScore > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${match[2]}. Must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return thresholds;
+}
