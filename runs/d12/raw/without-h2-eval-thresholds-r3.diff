+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${str}. Expected <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
+
+function validateThresholds(
+  thresholds: Record<string, number>,
+  evaluations: Array<{ id: string }>
+): void {
+  const availableMetrics = new Set(evaluations.map((m) => m.id));
+  const requestedMetrics = Object.keys(thresholds);
+
+  const unknown = requestedMetrics.filter((m) => !availableMetrics.has(m));
+  if (unknown.length > 0) {
+    const validMetrics = Array.from(availableMetrics).sort();
+    log.error(
+      `Unknown metric: ${unknown.join(', ')}. Valid metrics are: ${validMetrics.join(', ')}`
+    );
+    process.exit(2);
+  }
+}
