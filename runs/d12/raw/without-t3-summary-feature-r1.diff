+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns "BLOCK 0/7: structure" when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Gate section not found',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns "PASS 7/7" when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns "WARN 7/7" when there are only warning findings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No metrics specified',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns "BLOCK 6/7: evaluation" when one check has a block finding', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('returns "BLOCK 5/7" with multiple block findings in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency info',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('counts only block findings and ignores warnings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'minimal',
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No metrics specified',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('handles multiple findings for the same check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'No retention policy',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'warn',
+          message: 'Consider PII safeguards',
+          source: 'agent'
+        }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('returns blocks in GATE_CHECKS order when multiple', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'monitoring',
+          severity: 'block',
+          message: 'No monitoring plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'No bias analysis',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing tier',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'Some gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, bias, monitoring');
+  });
+});
