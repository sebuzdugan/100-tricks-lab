+function parseThresholds(thresholdStrings: string[] = []): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error('Invalid threshold: expected format metric=<number> (0-1)');
+      process.exit(2);
+    }
+
+    const [metricId, valueStr] = parts;
+    const value = parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error('Invalid threshold: expected format metric=<number> (0-1)');
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
+
+function getValidMetricIds(evaluations: any[]): string[] {
+  return evaluations.map((m) => m.id);
+}
+
+function validateThresholdMetrics(thresholds: Record<string, number>, validMetricIds: string[]): void {
+  const validMetricsSet = new Set(validMetricIds);
+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!validMetricsSet.has(metricId)) {
+      const validMetrics = validMetricIds.join(', ');
+      log.error(
+        `Unknown metric '${metricId}'. Valid metrics: ${validMetrics}`
+      );
+      process.exit(2);
+    }
+  }
+}
