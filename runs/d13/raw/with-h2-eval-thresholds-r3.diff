+#!/bin/bash
+
+set -e
+
+cd "$(dirname "$0")"
+FRAI_CLI="/private/tmp/100-tricks-runs/d13/with/h2-eval-thresholds/r3/packages/frai-cli/dist/index.js"
+
+echo "============================================"
+echo "End-to-End Tests for Threshold Gating"
+echo "============================================"
+echo ""
+
+# Test 1: Passing thresholds
+echo "Test 1: Passing thresholds (both metrics score 1.0)"
+rm -f test1-report.json test1-report.md
+node "$FRAI_CLI" eval \
+  --outputs test1-outputs.json \
+  --references test1-references.json \
+  --report test1-report \
+  --format json \
+  --threshold exact_match=0.9 \
+  --threshold toxicity=0.8
+EXIT_CODE=$?
+echo "Exit code: $EXIT_CODE (expected: 0)"
+if [ $EXIT_CODE -eq 0 ]; then
+  echo "✓ Test 1: PASS (exit 0)"
+  if grep -q '"passed": true' test1-report.json; then
+    echo "✓ Test 1: Report has passed=true"
+  else
+    echo "✗ Test 1: Report missing passed=true"
+  fi
+else
+  echo "✗ Test 1: FAIL (expected exit 0, got $EXIT_CODE)"
+fi
+echo ""
+
+# Test 2: Failing threshold
+echo "Test 2: Failing threshold (exact_match=0.5, should fail with 0.9 min)"
+rm -f test2-report.json test2-report.md
+node "$FRAI_CLI" eval \
+  --outputs test2-outputs.json \
+  --references test2-references.json \
+  --report test2-report \
+  --format json \
+  --threshold exact_match=0.9
+EXIT_CODE=$?
+echo "Exit code: $EXIT_CODE (expected: 1)"
+if [ $EXIT_CODE -eq 1 ]; then
+  echo "✓ Test 2: PASS (exit 1)"
+  if grep -q '"passed": false' test2-report.json; then
+    echo "✓ Test 2: Report has passed=false"
+  else
+    echo "✗ Test 2: Report missing passed=false"
+  fi
+else
+  echo "✗ Test 2: FAIL (expected exit 1, got $EXIT_CODE)"
+fi
+echo ""
+
+# Test 3: Missing reference (metric score null)
+echo "Test 3: Missing reference (outputs only, no references)"
+rm -f test3-report.json test3-report.md
+node "$FRAI_CLI" eval \
+  --outputs test3-outputs.json \
+  --report test3-report \
+  --format json \
+  --threshold exact_match=0.5
+EXIT_CODE=$?
+echo "Exit code: $EXIT_CODE (expected: 1)"
+if [ $EXIT_CODE -eq 1 ]; then
+  echo "✓ Test 3: PASS (exit 1)"
+  if grep -q '"passed": false' test3-report.json; then
+    echo "✓ Test 3: Report has passed=false"
+  else
+    echo "✗ Test 3: Report missing passed=false"
+  fi
+else
+  echo "✗ Test 3: FAIL (expected exit 1, got $EXIT_CODE)"
+fi
+echo ""
+
+# Test 4: Malformed threshold
+echo "Test 4: Malformed threshold (no = sign)"
+node "$FRAI_CLI" eval \
+  --outputs test1-outputs.json \
+  --references test1-references.json \
+  --threshold "exact_match" 2>&1 | tee test4-error.log
+EXIT_CODE=$?
+echo "Exit code: $EXIT_CODE (expected: 2)"
+if [ $EXIT_CODE -eq 2 ]; then
+  echo "✓ Test 4: PASS (exit 2)"
+  if grep -q "invalid threshold spec" test4-error.log; then
+    echo "✓ Test 4: Error message correct"
+  else
+    echo "✗ Test 4: Error message not found"
+  fi
+else
+  echo "✗ Test 4: FAIL (expected exit 2, got $EXIT_CODE)"
+fi
+echo ""
+
+# Test 5: Unknown metric
+echo "Test 5: Unknown metric (nonexistent=0.5)"
+node "$FRAI_CLI" eval \
+  --outputs test1-outputs.json \
+  --references test1-references.json \
+  --threshold "nonexistent=0.5" 2>&1 | tee test5-error.log
+EXIT_CODE=$?
+echo "Exit code: $EXIT_CODE (expected: 2)"
+if [ $EXIT_CODE -eq 2 ]; then
+  echo "✓ Test 5: PASS (exit 2)"
+  if grep -q "unknown metric" test5-error.log; then
+    echo "✓ Test 5: Error message correct"
+    if grep -q "exact_match" test5-error.log && grep -q "toxicity" test5-error.log; then
+      echo "✓ Test 5: Valid metrics listed"
+    else
+      echo "✗ Test 5: Valid metrics not all listed"
+    fi
+  else
+    echo "✗ Test 5: Error message not found"
+  fi
+else
+  echo "✗ Test 5: FAIL (expected exit 2, got $EXIT_CODE)"
+fi
+echo ""
+
+# Test 6: Backward compatibility (no thresholds)
+echo "Test 6: Backward compatibility (no --threshold option)"
+rm -f test6-report.json test6-report.md
+node "$FRAI_CLI" eval \
+  --outputs test1-outputs.json \
+  --references test1-references.json \
+  --report test6-report \
+  --format json
+EXIT_CODE=$?
+echo "Exit code: $EXIT_CODE (expected: 0)"
+if [ $EXIT_CODE -eq 0 ]; then
+  echo "✓ Test 6: PASS (exit 0)"
+  if ! grep -q '"passed"' test6-report.json; then
+    echo "✓ Test 6: Report has no passed field (backward compatible)"
+  else
+    echo "✗ Test 6: Report should not have passed field"
+  fi
+  if ! grep -q '"thresholds"' test6-report.json; then
+    echo "✓ Test 6: Report has no thresholds field (backward compatible)"
+  else
+    echo "✗ Test 6: Report should not have thresholds field"
+  fi
+else
+  echo "✗ Test 6: FAIL (expected exit 0, got $EXIT_CODE)"
+fi
+echo ""
+
+echo "============================================"
+echo "End-to-End Tests Complete"
+echo "============================================"
