+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS when all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'minimal',
+      findings: [],
+      gateSection: '## Risk tier\nMinimal'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with all checks answered when only warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Missing threshold',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'Needs rollback plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Risk tier\nLimited'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with answered count and check ids in correct order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'high',
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Risk tier\nHigh'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, evaluation');
+  });
+
+  it('returns BLOCK 0/7: structure when structure issue exists', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Gate section not found',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores structure issue when other block findings exist', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Gate section not found',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('does not list warn findings in block list', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Missing threshold',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'block',
+          message: 'No rollback plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Risk tier\nLimited'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: monitoring');
+  });
+
+  it('returns WARN with some blocks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Needs better threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Risk tier\nLimited'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('handles block findings from agent source', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Potential bias issue',
+          source: 'agent'
+        }
+      ],
+      gateSection: '## Risk tier\nLimited'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+
+  it('preserves order of check ids from GATE_CHECKS', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'high',
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Risk tier\nHigh'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('handles duplicate check ids by listing each once', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'high',
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'First issue with risk tier',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Second issue with risk tier',
+          source: 'agent'
+        }
+      ],
+      gateSection: '## Risk tier\nHigh'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('ignores findings with check ids not in GATE_CHECKS', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'unknown-check',
+          severity: 'block',
+          message: 'Unknown check issue',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Risk tier\nLimited'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 7/7');
+  });
+});
