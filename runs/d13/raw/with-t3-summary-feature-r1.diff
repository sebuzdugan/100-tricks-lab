-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,23 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const structureIssue = result.findings.find((f) => f.checkId === 'structure' && f.severity === 'block');
+  if (structureIssue) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const checkIds = new Set(GATE_CHECKS.map((c) => c.id));
+  const blockFindings = result.findings.filter((f) => f.severity === 'block' && checkIds.has(f.checkId));
+  const blockedCheckIds = new Set(blockFindings.map((f) => f.checkId));
+  const answered = GATE_CHECKS.length - blockedCheckIds.size;
+
+  let output = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+  if (blockedCheckIds.size > 0) {
+    const orderedBlockIds = GATE_CHECKS.filter((c) => blockedCheckIds.has(c.id)).map((c) => c.id);
+    output += `: ${orderedBlockIds.join(', ')}`;
+  }
+
+  return output;
+}
