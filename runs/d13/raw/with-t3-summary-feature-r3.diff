+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+function result(
+  verdict: GateResult['verdict'],
+  findings: Array<{ checkId: string; severity: 'block' | 'warn' }>,
+  gateSection: string | null = 'some gate section'
+): GateResult {
+  return {
+    verdict,
+    tier: null,
+    findings: findings.map((f) => ({
+      ...f,
+      message: 'test message',
+      source: 'validator' as const
+    })),
+    gateSection
+  };
+}
+
+describe('renderSummary', () => {
+  it('formats PASS with no findings', () => {
+    const res = result('PASS', []);
+    expect(renderSummary(res)).toBe('PASS 7/7');
+  });
+
+  it('formats WARN with one warning finding', () => {
+    const res = result('WARN', [{ checkId: 'evaluation', severity: 'warn' }]);
+    expect(renderSummary(res)).toBe('WARN 7/7');
+  });
+
+  it('formats BLOCK with single block finding', () => {
+    const res = result('BLOCK', [{ checkId: 'evaluation', severity: 'block' }]);
+    expect(renderSummary(res)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('formats BLOCK with multiple block findings in GATE_CHECKS order', () => {
+    const res = result('BLOCK', [
+      { checkId: 'transparency', severity: 'block' },
+      { checkId: 'data-privacy', severity: 'block' },
+      { checkId: 'evaluation', severity: 'block' }
+    ]);
+    expect(renderSummary(res)).toBe('BLOCK 4/7: data-privacy, evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const res = result('BLOCK', [{ checkId: 'structure', severity: 'block' }], null);
+    expect(renderSummary(res)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('counts only block findings when mixed with warnings', () => {
+    const res = result('BLOCK', [
+      { checkId: 'monitoring', severity: 'warn' },
+      { checkId: 'evaluation', severity: 'block' }
+    ]);
+    expect(renderSummary(res)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('deduplicates block findings by checkId', () => {
+    const res = result('BLOCK', [
+      { checkId: 'evaluation', severity: 'block' },
+      { checkId: 'evaluation', severity: 'block' }
+    ]);
+    expect(renderSummary(res)).toBe('BLOCK 6/7: evaluation');
+  });
+});
diff --git a/packages/frai-gate/src/gate/report.ts b/packages/frai-gate/src/gate/report.ts
index d83a05a..a9906e3 100644
--- a/packages/frai-gate/src/gate/report.ts
+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,23 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: missing gate section
+  if (result.gateSection === null) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count checks that have NO block findings
+  const blockedCheckIds = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+  const answered = GATE_CHECKS.length - blockedCheckIds.size;
+
+  if (result.verdict === 'BLOCK') {
+    const checksWithBlocks = GATE_CHECKS.filter((c) => blockedCheckIds.has(c.id)).map((c) => c.id);
+    return `BLOCK ${answered}/${GATE_CHECKS.length}: ${checksWithBlocks.join(', ')}`;
+  }
+
+  return `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+}
