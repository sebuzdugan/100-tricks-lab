+    const value = parseFloat(valueStr);
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for "${metricId}": ${valueStr} (must be between 0 and 1)`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}"`);
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
