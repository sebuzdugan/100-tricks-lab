+function evaluateThresholds(thresholds = {}, evaluations = []) {
+  const metricsById = {};
+  evaluations.forEach((metric) => {
+    metricsById[metric.id] = metric;
+  });
+
+  const thresholdResults = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, minScore]) => {
+    const metric = metricsById[metricId];
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= minScore;
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    thresholdResults.push({
+      metric: metricId,
+      min: minScore,
+      score,
+      passed
+    });
+  });
+
+  return {
+    passed: allPassed,
+    thresholds: thresholdResults
+  };
+}
