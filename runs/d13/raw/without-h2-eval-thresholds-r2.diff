+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number>; errors: string[] } {
+  const errors: string[] = [];
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds, errors };
+  }
+
+  thresholdStrings.forEach((threshStr) => {
+    const match = threshStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${threshStr}" (expected format: metric=number)`);
+      return;
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+
+    if (!VALID_METRIC_IDS.includes(metricId)) {
+      errors.push(
+        `Unknown metric: "${metricId}". Valid metrics are: ${VALID_METRIC_IDS.join(', ')}`
+      );
+      return;
+    }
+
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      errors.push(`Invalid threshold value: "${minStr}" for metric "${metricId}" (must be a number between 0 and 1)`);
+      return;
+    }
+
+    thresholds[metricId] = min;
+  });
+
+  return { thresholds, errors };
+}
