+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Malformed threshold: ${str} (expected format: metric=value)`);
+    }
+    const [metric, valueStr] = parts;
+    const value = Number.parseFloat(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw new Error(
+        `Invalid threshold for metric "${metric}": value must be a number between 0 and 1, got ${valueStr}`
+      );
+    }
+    thresholds[metric] = value;
+  }
+  return thresholds;
+}
