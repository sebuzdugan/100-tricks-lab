+function validateThresholdObject(thresholds) {
+  if (!thresholds || typeof thresholds !== 'object') {
+    return { valid: true, error: null };
+  }
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (typeof min !== 'number' || Number.isNaN(min) || min < 0 || min > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold for metric "${metric}": minimum must be a number between 0 and 1, got ${min}`
+      };
+    }
+  }
+
+  return { valid: true, error: null };
+}
+
+function checkThresholds(evaluations, thresholds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((e) => e.id === metricId);
+    if (!metric) {
+      return {
+        error: `Unknown metric: ${metricId}`,
+        validMetrics: evaluations.map((e) => e.id)
+      };
+    }
+
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+
+    results.push({
+      metric: metricId,
+      min,
+      score: score ?? null,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: results };
+}
