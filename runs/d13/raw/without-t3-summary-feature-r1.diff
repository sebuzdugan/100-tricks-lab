-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,33 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // If structure finding exists, gate section is missing
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Find checks with block-severity findings
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+  const blockedCheckIds = new Set(blockFindings.map((f) => f.checkId));
+
+  // Answered = checks with no block findings (warnings don't reduce answered)
+  const answered = GATE_CHECKS.filter((check) => !blockedCheckIds.has(check.id)).length;
+
+  const summary = `${result.verdict} ${answered}/7`;
+
+  if (blockFindings.length === 0) {
+    return summary;
+  }
+
+  // Append blocked check ids in GATE_CHECKS order, comma-space separated, each id once
+  const blockedIds: string[] = [];
+  for (const check of GATE_CHECKS) {
+    if (blockedCheckIds.has(check.id) && !blockedIds.includes(check.id)) {
+      blockedIds.push(check.id);
+    }
+  }
+
+  return `${summary}: ${blockedIds.join(', ')}`;
+}
