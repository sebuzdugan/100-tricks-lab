+/**
+ * Threshold validation module for evaluation metrics
+ * Provides parsing, validation, and evaluation of metric thresholds
+ */
+
+/**
+ * Parse a threshold string in format "metric_id=minimum_value"
+ * @param {string} str - Threshold string (e.g., "exact_match=0.9")
+ * @returns {Object} { metric: string, min: number }
+ * @throws {Error} If format is invalid, metric unknown, or value out of range
+ */
+export function parseThreshold(str) {
+  if (!str || typeof str !== 'string') {
+    throw new Error(`Threshold must be a string, got ${typeof str}`);
+  }
+
+  const parts = str.split('=');
+  if (parts.length !== 2) {
+    throw new Error(
+      `Threshold must be format 'metric=value', got '${str}'.`
+    );
+  }
+
+  const [metricId, minStr] = parts;
+  const trimmedMetric = metricId.trim();
+  const trimmedMin = minStr.trim();
+
+  if (!trimmedMetric) {
+    throw new Error(`Metric ID cannot be empty in threshold '${str}'`);
+  }
+
+  if (!trimmedMin) {
+    throw new Error(`Threshold value cannot be empty in threshold '${str}'`);
+  }
+
+  const min = parseFloat(trimmedMin);
+
+  if (isNaN(min)) {
+    throw new Error(
+      `Threshold value must be a number, got '${trimmedMin}' in threshold '${str}'`
+    );
+  }
+
+  if (min < 0 || min > 1) {
+    throw new Error(
+      `Threshold value must be 0-1, got ${min} in threshold '${str}'`
+    );
+  }
+
+  return { metric: trimmedMetric, min };
+}
+
+/**
+ * Validate thresholds against evaluation results
+ * @param {Array} evaluations - Array of metric evaluation results
+ * @param {Object} thresholds - Thresholds object { metricId: minimumValue, ... }
+ * @returns {Object} { passed: boolean, thresholds: Array<ThresholdResult> }
+ * @throws {Error} If metric not found or invalid thresholds format
+ */
+export function validateThresholds(evaluations, thresholds) {
+  if (!thresholds || typeof thresholds !== 'object' || Array.isArray(thresholds)) {
+    throw new Error('Thresholds must be object { metricId: number, ... }');
+  }
+
+  // Get valid metric IDs from evaluations
+  const validMetricIds = evaluations
+    .filter(m => m && m.id)
+    .map(m => m.id);
+
+  // Validate and evaluate each threshold
+  const thresholdResults = [];
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    // Check if metric exists
+    if (!validMetricIds.includes(metricId)) {
+      throw new Error(
+        `Unknown metric '${metricId}' in threshold. Valid metrics: ${validMetricIds.join(', ')}`
+      );
+    }
+
+    // Validate min is a number
+    if (typeof min !== 'number' || isNaN(min)) {
+      throw new Error(`Threshold value for '${metricId}' must be a number, got ${typeof min}`);
+    }
+
+    // Validate min is in range
+    if (min < 0 || min > 1) {
+      throw new Error(`Threshold value for '${metricId}' must be 0-1, got ${min}`);
+    }
+
+    // Find the metric and evaluate
+    const metric = evaluations.find(m => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  // Overall pass/fail: all thresholds must pass
+  const passed = thresholdResults.every(tr => tr.passed);
+
+  return {
+    passed,
+    thresholds: thresholdResults
+  };
+}
+
+/**
+ * Get valid metric IDs from evaluations or from DEFAULT_METRICS
+ * @param {Array} evaluations - Array of metric results or undefined
+ * @returns {Array<string>} Array of metric IDs
+ */
+export function getValidMetricIds(evaluations = []) {
+  if (!Array.isArray(evaluations) || evaluations.length === 0) {
+    // Return default metrics
+    return ['exact_match', 'toxicity', 'length_variance'];
+  }
+
+  return evaluations
+    .filter(m => m && m.id)
+    .map(m => m.id);
+}
+
+export default {
+  parseThreshold,
+  validateThresholds,
+  getValidMetricIds
+};
