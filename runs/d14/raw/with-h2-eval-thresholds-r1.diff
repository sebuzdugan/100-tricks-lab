+/**
+ * Custom error classes for threshold validation
+ */
+
+export class UnknownMetricError extends Error {
+  constructor(metricId, validMetrics) {
+    const metricList = Array.isArray(validMetrics) ? validMetrics.join(', ') : validMetrics;
+    super(`Unknown metric '${metricId}' in threshold. Valid metrics: ${metricList}`);
+    this.name = 'UnknownMetricError';
+    this.metricId = metricId;
+    this.validMetrics = validMetrics;
+  }
+}
+
+export class MalformedThresholdError extends Error {
+  constructor(input) {
+    super(`Threshold must be format 'metric=value', got '${input}'. Example: --threshold exact_match=0.9`);
+    this.name = 'MalformedThresholdError';
+    this.input = input;
+  }
+}
+
+export class InvalidValueError extends Error {
+  constructor(value, context = '') {
+    const msg = context
+      ? `Threshold value must be 0-1, got ${value} in threshold '${context}'`
+      : `Threshold value must be 0-1, got ${value}`;
+    super(msg);
+    this.name = 'InvalidValueError';
+    this.value = value;
+  }
+}
+
+export class InvalidNumberError extends Error {
+  constructor(value, context = '') {
+    const msg = context
+      ? `Threshold value must be a number, got '${value}' in threshold '${context}'`
+      : `Threshold value must be a number, got '${value}'`;
+    super(msg);
+    this.name = 'InvalidNumberError';
+    this.value = value;
+  }
+}
+
+export default {
+  UnknownMetricError,
+  MalformedThresholdError,
+  InvalidValueError,
+  InvalidNumberError
+};
