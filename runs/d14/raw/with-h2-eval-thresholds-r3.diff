+ */
+
+/**
+ * @typedef {Object} ValidationError
+ * @property {boolean} valid - false when validation fails
+ * @property {string[]} errors - Array of error messages
+ * @property {ThresholdError[]} details - Detailed error information
+ */
+
+/**
+ * @typedef {Object} ValidResult
+ * @property {boolean} valid - true when validation succeeds
+ * @property {Threshold[]} thresholds - Parsed and validated thresholds
+ */
+
+export {};
diff --git a/packages/frai-core/src/eval/threshold-validator.js b/packages/frai-core/src/eval/threshold-validator.js
new file mode 100644
index 0000000..10ea1f6
--- /dev/null
+++ b/packages/frai-core/src/eval/threshold-validator.js
@@ -0,0 +1,49 @@
+import { parseThresholds } from './threshold-parser.js';
+import { getAvailableMetricIds, isMetricIdAvailable } from './metric-registry.js';
+
+/**
+ * Validate thresholds against evaluation results
+ * Aggregates all parsing and validation errors before returning
+ * @param {string[]} thresholdInputs - Array of threshold strings (e.g., ["exact_match=0.9"])
+ * @param {Array} evaluations - Array of evaluation results with 'id' field
+ * @returns {{ valid: true, thresholds: Array } | { valid: false, errors: string[] }}
+ */
+export function validateThresholds(thresholdInputs, evaluations) {
+  if (!Array.isArray(thresholdInputs) || thresholdInputs.length === 0) {
+    return { valid: true, thresholds: [] };
+  }
+
+  // Step 1: Parse threshold strings (format and value range validation)
+  const parseResult = parseThresholds(thresholdInputs);
+  if (!parseResult.valid) {
+    // If parsing failed, return those errors with help text
+    const availableMetrics = getAvailableMetricIds(evaluations);
+    const errorMessages = [
+      ...parseResult.errors,
+      `\nValid metrics: ${availableMetrics.join(', ')}`
+    ];
+    return { valid: false, errors: errorMessages };
+  }
+
+  // Step 2: Validate metric IDs exist in evaluations
+  const validationErrors = [];
+  const availableMetrics = getAvailableMetricIds(evaluations);
+
+  for (const threshold of parseResult.thresholds) {
+    if (!isMetricIdAvailable(threshold.metric, evaluations)) {
+      validationErrors.push(
+        `Unknown metric "${threshold.metric}" in --threshold ${threshold.metric}=${threshold.min}`
+      );
+    }
+  }
+
+  if (validationErrors.length > 0) {
+    const errorMessages = [
+      ...validationErrors,
+      `\nValid metrics: ${availableMetrics.join(', ')}`
+    ];
+    return { valid: false, errors: errorMessages };
+  }
+
+  return { valid: true, thresholds: parseResult.thresholds };
+}
