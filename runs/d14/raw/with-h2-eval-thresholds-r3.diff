+import { describe, it, expect } from 'vitest';
+import { parseThreshold, parseThresholds } from './threshold-parser.js';
+import { getAvailableMetricIds, getDefaultMetricIds, isMetricIdAvailable } from './metric-registry.js';
+import { validateThresholds } from './threshold-validator.js';
+import { evaluateThreshold, evaluateThresholds, computeOverallPass } from './threshold-evaluator.js';
+
+describe('Threshold Parser', () => {
+  it('should parse valid threshold format', () => {
+    const result = parseThreshold('exact_match=0.9');
+    expect(result).toEqual({ metric: 'exact_match', min: 0.9 });
+  });
+
+  it('should parse threshold with value 0', () => {
+    const result = parseThreshold('toxicity=0');
+    expect(result).toEqual({ metric: 'toxicity', min: 0 });
+  });
+
+  it('should parse threshold with value 1', () => {
+    const result = parseThreshold('f1=1');
+    expect(result).toEqual({ metric: 'f1', min: 1 });
+  });
+
+  it('should throw on malformed format (colon instead of equals)', () => {
+    expect(() => parseThreshold('exact_match:0.9')).toThrow('use = not :');
+  });
+
+  it('should throw on value outside range', () => {
+    expect(() => parseThreshold('exact_match=1.5')).toThrow('must be between 0 and 1');
+  });
+
+  it('should throw on negative value', () => {
+    expect(() => parseThreshold('exact_match=-0.1')).toThrow('must be between 0 and 1');
+  });
+
+  it('should throw on non-numeric value', () => {
+    expect(() => parseThreshold('exact_match=abc')).toThrow('is not a number');
+  });
+
+  it('should parse multiple thresholds', () => {
+    const result = parseThresholds(['exact_match=0.9', 'f1=0.8']);
+    expect(result.valid).toBe(true);
+    expect(result.thresholds).toHaveLength(2);
+    expect(result.thresholds[0]).toEqual({ metric: 'exact_match', min: 0.9 });
+  });
+
+  it('should handle empty threshold array', () => {
+    const result = parseThresholds([]);
+    expect(result.valid).toBe(true);
+    expect(result.thresholds).toHaveLength(0);
+  });
+
+  it('should collect errors from multiple invalid thresholds', () => {
+    const result = parseThresholds(['exact_match=1.5', 'f1=abc']);
+    expect(result.valid).toBe(false);
+    expect(result.errors).toHaveLength(2);
+  });
+});
+
+describe('Metric Registry', () => {
+  it('should return default metrics', () => {
+    const defaults = getDefaultMetricIds();
+    expect(defaults).toContain('exact_match');
+    expect(defaults).toContain('f1');
+    expect(defaults).toContain('toxicity');
+    expect(defaults).toContain('length_variance');
+  });
+
+  it('should extract metric ids from evaluations', () => {
+    const evals = [
+      { id: 'exact_match', score: 0.95 },
+      { id: 'f1', score: 0.88 }
+    ];
+    const ids = getAvailableMetricIds(evals);
+    expect(ids).toContain('exact_match');
+    expect(ids).toContain('f1');
+  });
+
+  it('should check if metric is available', () => {
+    const evals = [{ id: 'exact_match', score: 0.95 }];
+    expect(isMetricIdAvailable('exact_match', evals)).toBe(true);
+    expect(isMetricIdAvailable('unknown', evals)).toBe(false);
+  });
+
+  it('should return empty array for non-array evaluations', () => {
+    const ids = getAvailableMetricIds(null);
+    expect(ids).toEqual(getDefaultMetricIds());
+  });
+});
+
+describe('Threshold Validator', () => {
+  const evaluations = [
+    { id: 'exact_match', score: 0.95 },
+    { id: 'f1', score: 0.88 }
+  ];
+
+  it('should validate correct thresholds', () => {
+    const result = validateThresholds(['exact_match=0.9', 'f1=0.8'], evaluations);
+    expect(result.valid).toBe(true);
+    expect(result.thresholds).toHaveLength(2);
+  });
+
+  it('should fail on unknown metric', () => {
+    const result = validateThresholds(['unknown_metric=0.9'], evaluations);
+    expect(result.valid).toBe(false);
+    expect(result.errors.length).toBeGreaterThan(0);
+    expect(result.errors.some(err => err.includes('Unknown metric'))).toBe(true);
+    expect(result.errors.some(err => err.includes('Valid metrics:'))).toBe(true);
+  });
+
+  it('should handle empty thresholds', () => {
+    const result = validateThresholds([], evaluations);
+    expect(result.valid).toBe(true);
+    expect(result.thresholds).toHaveLength(0);
+  });
+});
+
+describe('Threshold Evaluator', () => {
+  const evaluations = [
+    { id: 'exact_match', score: 0.95 },
+    { id: 'f1', score: 0.88 }
+  ];
+
+  it('should mark threshold as passed', () => {
+    const result = evaluateThreshold({ metric: 'exact_match', min: 0.9 }, evaluations);
+    expect(result.passed).toBe(true);
+    expect(result.score).toBe(0.95);
+  });
+
+  it('should mark threshold as failed', () => {
+    const result = evaluateThreshold({ metric: 'exact_match', min: 0.99 }, evaluations);
+    expect(result.passed).toBe(false);
+    expect(result.score).toBe(0.95);
+  });
+
+  it('should mark threshold as failed when metric has no score', () => {
+    const evals = [{ id: 'exact_match', score: null }];
+    const result = evaluateThreshold({ metric: 'exact_match', min: 0.5 }, evals);
+    expect(result.passed).toBe(false);
+    expect(result.score).toBe(null);
+  });
+
+  it('should mark threshold as failed when metric is missing', () => {
+    const result = evaluateThreshold({ metric: 'unknown', min: 0.5 }, evaluations);
+    expect(result.passed).toBe(false);
+    expect(result.score).toBe(null);
+  });
+
+  it('should evaluate multiple thresholds', () => {
+    const thresholds = [
+      { metric: 'exact_match', min: 0.9 },
+      { metric: 'f1', min: 0.8 }
+    ];
+    const results = evaluateThresholds(thresholds, evaluations);
+    expect(results).toHaveLength(2);
+    expect(results[0].passed).toBe(true);
+    expect(results[1].passed).toBe(true);
+  });
+
+  it('should compute overall pass when all pass', () => {
+    const results = [
+      { passed: true },
+      { passed: true }
+    ];
+    expect(computeOverallPass(results)).toBe(true);
+  });
+
+  it('should compute overall fail when any fails', () => {
+    const results = [
+      { passed: true },
+      { passed: false }
+    ];
+    expect(computeOverallPass(results)).toBe(false);
+  });
+
+  it('should return true for empty results', () => {
+    expect(computeOverallPass([])).toBe(true);
+  });
+});
