+/**
+ * Get the score for a metric from evaluations
+ * @param {string} metricId - Metric identifier
+ * @param {Array} evaluations - Array of evaluation results
+ * @returns {(number|null)} Score if found and is a number, null otherwise
+ */
+function getMetricScore(metricId, evaluations) {
+  if (!Array.isArray(evaluations)) {
+    return null;
+  }
+
+  const metric = evaluations.find((m) => m && m.id === metricId);
+  if (!metric) {
+    return null;
+  }
+
+  const { score } = metric;
+  if (typeof score === 'number' && !Number.isNaN(score)) {
+    return score;
+  }
+
+  return null;
+}
+
+/**
+ * Evaluate a single threshold against evaluation results
+ * @param {{ metric: string, min: number }} threshold - Threshold to evaluate
+ * @param {Array} evaluations - Array of evaluation results
+ * @returns {{ metric: string, min: number, score: (number|null), passed: boolean }}
+ */
+export function evaluateThreshold(threshold, evaluations) {
+  const score = getMetricScore(threshold.metric, evaluations);
+  const passed = score !== null && score >= threshold.min;
+
+  return {
+    metric: threshold.metric,
+    min: threshold.min,
+    score,
+    passed
+  };
+}
+
+/**
+ * Evaluate all thresholds against evaluation results
+ * @param {Array} thresholds - Array of { metric, min } objects
+ * @param {Array} evaluations - Array of evaluation results
+ * @returns {Array} Array of threshold validation results
+ */
+export function evaluateThresholds(thresholds, evaluations) {
+  if (!Array.isArray(thresholds) || thresholds.length === 0) {
+    return [];
+  }
+
+  return thresholds.map((threshold) => evaluateThreshold(threshold, evaluations));
+}
+
+/**
+ * Compute overall pass/fail status from threshold results
+ * @param {Array} results - Array of threshold validation results
+ * @returns {boolean} true if all thresholds passed, false if any failed
+ */
+export function computeOverallPass(results) {
+  if (!Array.isArray(results) || results.length === 0) {
+    return true;
+  }
+
+  return results.every((result) => result.passed === true);
+}
