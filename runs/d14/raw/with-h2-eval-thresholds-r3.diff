+/**
+ * Get list of available metric IDs from evaluation results
+ * @param {Array} evaluations - Array of evaluation result objects with 'id' field
+ * @returns {string[]} Array of metric IDs found in evaluations
+ */
+export function getAvailableMetricIds(evaluations) {
+  if (!Array.isArray(evaluations)) {
+    return getDefaultMetricIds();
+  }
+
+  const ids = evaluations
+    .filter((metric) => metric && typeof metric.id === 'string')
+    .map((metric) => metric.id);
+
+  return [...new Set(ids)]; // Remove duplicates
+}
+
+/**
+ * Get list of default/built-in metric IDs
+ * @returns {string[]} Array of built-in metric IDs
+ */
+export function getDefaultMetricIds() {
+  return ['exact_match', 'f1', 'toxicity', 'length_variance'];
+}
+
+/**
+ * Check if a metric ID is available in evaluations
+ * @param {string} metricId - Metric identifier to check
+ * @param {Array} evaluations - Array of evaluation results
+ * @returns {boolean} True if metric exists in evaluations
+ */
+export function isMetricIdAvailable(metricId, evaluations) {
+  if (!Array.isArray(evaluations)) {
+    return false;
+  }
+
+  return evaluations.some((metric) => metric && metric.id === metricId);
+}
