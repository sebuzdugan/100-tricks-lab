+/**
+ * @typedef {Object} Threshold
+ * @property {string} metric - Metric identifier
+ * @property {number} min - Minimum threshold value (0-1)
+ */
+
+/**
+ * @typedef {Object} ThresholdValidationResult
+ * @property {string} metric - Metric identifier
+ * @property {number} min - Minimum threshold value
+ * @property {(number|null)} score - Actual metric score (null if absent)
+ * @property {boolean} passed - true if score !== null && score >= min
+ */
+
+/**
+ * @typedef {Object} ThresholdError
+ * @property {string} message - Error message
+ * @property {string} code - Error code (malformed_format, value_out_of_range, unknown_metric, etc)
