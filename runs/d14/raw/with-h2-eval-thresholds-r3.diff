--- /dev/null
+++ b/packages/frai-core/src/eval/threshold-parser.js
@@ -0,0 +1,64 @@
+/**
+ * Parse a single threshold string in format "metric=number"
+ * @param {string} input - Threshold string (e.g., "exact_match=0.9")
+ * @returns {{ metric: string, min: number } | null} Parsed threshold or null if invalid
+ * @throws {Error} If format is invalid
+ */
+export function parseThreshold(input) {
+  if (typeof input !== 'string' || !input.trim()) {
+    throw new Error(`Invalid threshold format "${input}": expected "metric=number"`);
+  }
+
+  const parts = input.split('=');
+  if (parts.length !== 2) {
+    throw new Error(`Invalid threshold format "${input}": expected "metric=number" (use = not :)`);
+  }
+
+  const [metric, valueStr] = parts;
+  if (!metric || !metric.trim()) {
+    throw new Error(`Invalid threshold format "${input}": metric name missing`);
+  }
+
+  const value = Number(valueStr);
+  if (Number.isNaN(value)) {
+    throw new Error(`Invalid threshold format "${input}": value "${valueStr}" is not a number`);
+  }
+
+  if (value < 0 || value > 1) {
+    throw new Error(`Invalid threshold value ${value} for metric "${metric.trim()}": must be between 0 and 1`);
+  }
+
+  return {
+    metric: metric.trim(),
+    min: value
+  };
+}
+
+/**
+ * Parse multiple threshold strings
+ * @param {string[]} inputs - Array of threshold strings
+ * @returns {{ valid: true, thresholds: Array } | { valid: false, errors: string[] }}
+ */
+export function parseThresholds(inputs) {
+  if (!Array.isArray(inputs) || inputs.length === 0) {
+    return { valid: true, thresholds: [] };
+  }
+
+  const thresholds = [];
+  const errors = [];
+
+  for (const input of inputs) {
+    try {
+      const threshold = parseThreshold(input);
+      thresholds.push(threshold);
+    } catch (error) {
+      errors.push(error.message);
+    }
+  }
+
+  if (errors.length > 0) {
+    return { valid: false, errors };
+  }
+
+  return { valid: true, thresholds };
+}
