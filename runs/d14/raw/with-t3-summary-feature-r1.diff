-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+// Format gate assessment result as concise one-line summary for CI logs.
+// Output format: "VERDICT X/7" or "VERDICT X/7: check-ids" (pure function, no side effects).
+export function renderSummary(result: GateResult): string {
+  // Structure failure: missing gate section
+  if (result.gateSection === null) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Calculate answered count and failed check IDs
+  let answered = 0;
+  const failedCheckIds: string[] = [];
+
+  for (const check of GATE_CHECKS) {
+    const hasBlockFinding = result.findings.some(
+      (f) => f.checkId === check.id && f.severity === 'block'
+    );
+
+    if (!hasBlockFinding) {
+      answered += 1;
+    } else {
+      failedCheckIds.push(check.id);
+    }
+  }
+
+  // Format output
+  if (failedCheckIds.length === 0) {
+    return `${result.verdict} ${answered}/7`;
+  }
+  return `${result.verdict} ${answered}/7: ${failedCheckIds.join(', ')}`;
+}
