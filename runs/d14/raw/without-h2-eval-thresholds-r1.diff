+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: '${threshStr}'. Expected format: metric=value (e.g., exact_match=0.9)`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (isNaN(value)) {
+      log.error(`Invalid threshold value for '${metricId}': '${valueStr}' is not a number.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
