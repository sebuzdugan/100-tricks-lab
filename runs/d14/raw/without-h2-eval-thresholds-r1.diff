@@ -13,6 +13,52 @@ const defaultFs = fs;
 
 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+export function validateThresholds(thresholds, validMetricIds) {
+  const errors = [];
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (typeof min !== 'number') {
+      errors.push(`Threshold for '${metricId}' must be a number, got: ${typeof min}`);
+      continue;
+    }
+    if (min < 0 || min > 1) {
+      errors.push(`Threshold for '${metricId}' must be between 0 and 1, got: ${min}`);
+    }
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric: '${metricId}'. Valid metrics are: ${validMetricIds.join(', ')}`);
+    }
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors
+  };
+}
+
+export function evaluateThresholds(thresholds, metrics) {
+  const results = [];
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  const allPassed = results.every((r) => r.passed);
+
+  return {
+    passed: allPassed,
+    results
+  };
+}
