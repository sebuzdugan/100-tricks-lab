diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..a8520aa
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,24 @@
+export function evaluateThreshold(metric, min) {
+  return {
+    metric: metric.id,
+    min,
+    score: metric.score,
+    passed: metric.score !== null && metric.score >= min
+  };
+}
+
+export function evaluateThresholds(evaluations, thresholds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return [];
+  }
+
+  const results = [];
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+    if (metric) {
+      results.push(evaluateThreshold(metric, min));
+    }
+  });
+
+  return results;
+}
