@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: gate section is missing (structure finding)
+  if (!result.gateSection) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Build set of checkIds with block-severity findings
+  const blockedCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockedCheckIds.add(finding.checkId);
+    }
+  }
+
+  // Count answered checks (checks without block findings)
+  const answered = GATE_CHECKS.length - blockedCheckIds.size;
+
+  // Format verdict line
+  let summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  // Append blocked checkIds if any blocks exist
+  if (blockedCheckIds.size > 0) {
+    const blockedInOrder = GATE_CHECKS.filter((check) => blockedCheckIds.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockedInOrder}`;
+  }
+
+  return summary;
+}
