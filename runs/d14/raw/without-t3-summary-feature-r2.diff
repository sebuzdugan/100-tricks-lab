+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+function createResult(
+  verdict: GateResult['verdict'],
+  findings: Finding[] = [],
+  gateSection: string | null = '### Some gate section'
+): GateResult {
+  return {
+    verdict,
+    tier: verdict === 'PASS' ? 'limited' : null,
+    findings,
+    gateSection
+  };
+}
+
+describe('renderSummary', () => {
+  it('returns "PASS 7/7" when all checks answered', () => {
+    const result = createResult('PASS', []);
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns "WARN 7/7" when all checks answered but warnings exist', () => {
+    const result = createResult('WARN', [
+      { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns "BLOCK 6/7: evaluation" when one check has a block finding', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('returns "BLOCK 5/7: evaluation, transparency" when multiple checks have block findings', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+      { checkId: 'transparency', severity: 'block', message: 'No disclosure plan', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists block findings in GATE_CHECKS order', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'transparency', severity: 'block', message: '', source: 'validator' },
+      { checkId: 'risk-tier', severity: 'block', message: '', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: '', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('returns "BLOCK 0/7: structure" when gate section is missing', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'structure', severity: 'block', message: 'No gate section', source: 'validator' }
+    ], null);
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('includes all seven failing checks in order', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'risk-tier', severity: 'block', message: '', source: 'validator' },
+      { checkId: 'data-privacy', severity: 'block', message: '', source: 'validator' },
+      { checkId: 'oversight', severity: 'block', message: '', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: '', source: 'validator' },
+      { checkId: 'bias', severity: 'block', message: '', source: 'validator' },
+      { checkId: 'monitoring', severity: 'block', message: '', source: 'validator' },
+      { checkId: 'transparency', severity: 'block', message: '', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency');
+  });
+
+  it('lists each check id only once when there are multiple findings for the same check', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'evaluation', severity: 'block', message: 'First problem', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: 'Second problem', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores smart review findings from agents when listing block checks', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+      { checkId: 'custom-ai-check', severity: 'block', message: 'AI concern', source: 'agent' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('does not reduce answered count for warning findings', () => {
+    const result = createResult('WARN', [
+      { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' },
+      { checkId: 'monitoring', severity: 'warn', message: 'Threshold vague', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('handles mixed block and warn findings correctly', () => {
+    const result = createResult('BLOCK', [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+      { checkId: 'monitoring', severity: 'warn', message: 'Threshold vague', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
