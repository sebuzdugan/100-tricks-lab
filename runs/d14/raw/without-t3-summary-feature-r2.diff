+
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  // Special case: if gate section is missing (structure finding)
+  if (result.gateSection === null) {
+    const structureFinding = result.findings.find((f) => f.checkId === 'structure' && f.severity === 'block');
+    if (structureFinding) {
+      return `BLOCK 0/${total}: structure`;
+    }
+  }
+
+  // Count unique checks with block findings
+  const gateCheckIds = new Set(GATE_CHECKS.map((c) => c.id));
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && gateCheckIds.has(finding.checkId)) {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+  const answered = total - blockCheckIds.size;
+
+  // Build summary string
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockCheckIds.size > 0) {
+    const orderedIds = GATE_CHECKS.filter((c) => blockCheckIds.has(c.id)).map((c) => c.id);
+    summary += `: ${orderedIds.join(', ')}`;
+  }
+
+  return summary;
+}
