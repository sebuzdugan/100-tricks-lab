+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const result: Record<string, number> = {};
+  if (!thresholdStrings) return result;
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: '${thresholdStr}'. Expected format: <metric>=<number>`);
+    }
+    const [, metric, value] = match;
+    const min = Number.parseFloat(value);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value for '${metric}': ${value}. Minimum must be a number between 0 and 1.`);
+    }
+    result[metric] = min;
+  }
+
+  return result;
+}
