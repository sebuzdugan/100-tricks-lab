+function parseThresholds(thresholdArgs: string[] | undefined): { thresholds: Record<string, number> | null; validationError: string | null } {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return { thresholds: null, validationError: null };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const arg of thresholdArgs) {
+    const parts = arg.split('=');
+    if (parts.length !== 2) {
+      return {
+        thresholds: null,
+        validationError: `Malformed threshold "${arg}": must be <metric>=<number>`
+      };
+    }
+
+    const [metricId, minStr] = parts;
+    const minValue = Number.parseFloat(minStr);
+
+    if (Number.isNaN(minValue)) {
+      return {
+        thresholds: null,
+        validationError: `Malformed threshold "${arg}": "${minStr}" is not a valid number`
+      };
+    }
+
+    if (minValue < 0 || minValue > 1) {
+      return {
+        thresholds: null,
+        validationError: `Malformed threshold "${arg}": minimum value must be between 0 and 1`
+      };
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return { thresholds, validationError: null };
+}
