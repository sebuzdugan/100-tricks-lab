+function parseThresholds(thresholdStrings: string[] | undefined) {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds, errors: [] };
+  }
+
+  const errors: string[] = [];
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Invalid threshold format: "${thresholdStr}". Expected format: metric=number`);
+      continue;
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+    const min = parseFloat(minStr);
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      errors.push(`Invalid threshold value: "${thresholdStr}". Minimum must be between 0 and 1.`);
+      continue;
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      errors.push(
+        `Unknown metric: "${metricId}". Valid metrics are: ${validMetrics.join(', ')}.`
+      );
+      continue;
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, errors };
+}
