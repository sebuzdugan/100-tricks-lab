@@ -0,0 +1,110 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7 when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'No gate section', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## Responsible AI Gate\n\nAll checks answered.'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN 7/7 when there are only warning findings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n\nSome checks answered.'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with block check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing numbers', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing incident path', source: 'validator' }
+      ],
+      gateSection: '## Responsible AI Gate\n\nSome checks answered.'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists block check ids in GATE_CHECKS order, not finding order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing incident path', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing numbers', source: 'validator' }
+      ],
+      gateSection: '## Responsible AI Gate\n\nSome checks answered.'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('counts answered checks correctly with multiple findings per check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing tier', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Prohibited tier', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing retention policy', source: 'validator' }
+      ],
+      gateSection: '## Responsible AI Gate\n\nSome checks answered.'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, data-privacy');
+  });
+
+  it('ignores warning findings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: 'Missing rollback procedure', source: 'validator' }
+      ],
+      gateSection: '## Responsible AI Gate\n\nSome checks answered.'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: monitoring');
+  });
+
+  it('includes all block check ids when multiple checks have blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing tier', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing retention', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'Missing kill switch', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' }
+      ],
+      gateSection: '## Responsible AI Gate\n\nSome checks answered.'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 3/7: risk-tier, data-privacy, oversight, evaluation');
+  });
+});
