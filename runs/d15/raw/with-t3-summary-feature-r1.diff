@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,26 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const TOTAL = 7;
+
+  if (!result.gateSection) {
+    return `BLOCK 0/${TOTAL}: structure`;
+  }
+
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+
+  if (blockFindings.length === 0) {
+    return `${result.verdict} ${TOTAL}/${TOTAL}`;
+  }
+
+  const checksWithBlocks = new Set(blockFindings.map((f) => f.checkId));
+  const answered = TOTAL - checksWithBlocks.size;
+
+  const blockCheckIds = GATE_CHECKS.map((check) => check.id)
+    .filter((id) => checksWithBlocks.has(id))
+    .join(', ');
+
+  return `BLOCK ${answered}/${TOTAL}: ${blockCheckIds}`;
+}
