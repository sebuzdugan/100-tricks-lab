@@ -0,0 +1,117 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns "BLOCK 0/7: structure" when gateSection is null', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns "PASS 7/7" when all checks pass and no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'minimal',
+      findings: [],
+      gateSection: 'gate section text'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns "WARN 7/7" when there are only warnings and no block findings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'minimal',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'no numbers', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'no rollback procedure', source: 'validator' }
+      ],
+      gateSection: 'gate section text'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('counts answered checks correctly with single block', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'minimal',
+      findings: [{ checkId: 'evaluation', severity: 'block', message: 'missing', source: 'validator' }],
+      gateSection: 'gate section text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('counts answered checks correctly with multiple blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'minimal',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'incomplete', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'warning', source: 'validator' }
+      ],
+      gateSection: 'gate section text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists block check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'missing', source: 'validator' }
+      ],
+      gateSection: 'gate section text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, evaluation, transparency');
+  });
+
+  it('deduplicates block findings for the same check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'missing numbers', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'incomplete thresholds', source: 'agent' }
+      ],
+      gateSection: 'gate section text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'high',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'flag 1', source: 'validator' },
+        { checkId: 'bias', severity: 'warn', message: 'flag 2', source: 'agent' },
+        { checkId: 'monitoring', severity: 'warn', message: 'flag 3', source: 'validator' }
+      ],
+      gateSection: 'gate section text'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('includes block findings even when other findings are warnings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'high',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'bias', severity: 'warn', message: 'flag', source: 'agent' },
+        { checkId: 'monitoring', severity: 'warn', message: 'flag', source: 'validator' }
+      ],
+      gateSection: 'gate section text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
