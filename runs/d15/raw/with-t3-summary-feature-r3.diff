@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,24 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (result.gateSection === null) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const gateCheckIds = GATE_CHECKS.map((c) => c.id);
+  const blockCheckIds = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+
+  const answered = gateCheckIds.filter((id) => !blockCheckIds.has(id)).length;
+  let summary = `${result.verdict} ${answered}/7`;
+
+  if (result.verdict === 'BLOCK') {
+    const blockedIds = gateCheckIds.filter((id) => blockCheckIds.has(id));
+    summary += `: ${blockedIds.join(', ')}`;
+  }
+
+  return summary;
+}
