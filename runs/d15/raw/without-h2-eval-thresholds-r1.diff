+function parseThresholds(thresholdSpecs?: string[]): { thresholds: Record<string, number>; errors: string[] } {
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  if (!thresholdSpecs || thresholdSpecs.length === 0) {
+    return { thresholds, errors };
+  }
+
+  const specs = Array.isArray(thresholdSpecs) ? thresholdSpecs : [thresholdSpecs];
+
+  for (const spec of specs) {
+    const match = spec.match(/^(\w+)=([\d.]+)$/);
+    if (!match) {
+      errors.push(`Invalid threshold format: '${spec}'. Expected format: metric=<0-1>`);
+      continue;
+    }
+
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      errors.push(`Threshold value must be between 0 and 1, got: ${valueStr}`);
+      continue;
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return { thresholds, errors };
+}
