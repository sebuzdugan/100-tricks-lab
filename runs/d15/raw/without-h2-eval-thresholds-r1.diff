+function evaluateThresholds(evaluations, thresholds = {}) {
+  const validationErrors = [];
+  const thresholdResults = [];
+  let allPassed = true;
+
+  const thresholdEntries = Object.entries(thresholds);
+  if (thresholdEntries.length === 0) {
+    return { thresholdResults, allPassed: true, validationErrors };
+  }
+
+  for (const [metricId, min] of thresholdEntries) {
+    const metric = evaluations.find((m) => m.id === metricId);
+
+    if (!metric) {
+      validationErrors.push(metricId);
+      continue;
+    }
+
+    const score = metric.score ?? null;
+    const passed = score !== null && score >= min;
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    thresholdResults.push({
+      metric: metricId,
+      label: metric.label,
+      min,
+      score,
+      passed
+    });
+  }
+
+  if (validationErrors.length > 0) {
+    const validMetrics = evaluations.map((m) => m.id).join(', ');
+    const errorMsg = `Unknown metric(s): ${validationErrors.join(', ')}. Valid metrics: ${validMetrics}`;
+    throw new Error(errorMsg);
+  }
+
+  return { thresholdResults, allPassed, validationErrors };
+}
