+function validateThresholds(thresholds, evaluations) {
+  const metricsMap = new Map(evaluations.map(m => [m.id, m]));
+
+  return thresholds.map(t => {
+    if (!metricsMap.has(t.metric)) {
+      const available = Array.from(metricsMap.keys()).join(', ');
+      throw new Error(
+        `Unknown metric: '${t.metric}'. Available metrics: ${available}`
+      );
+    }
+    const score = metricsMap.get(t.metric).score;
+    const passed = score !== null && score >= t.min;
+    return { metric: t.metric, min: t.min, score, passed };
+  });
+}
+
+function calculateReportPassed(thresholdResults) {
+  return thresholdResults.length === 0 || thresholdResults.every(t => t.passed);
+}
