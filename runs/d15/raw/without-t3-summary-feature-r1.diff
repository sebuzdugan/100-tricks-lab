+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 when all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'minimal',
+      findings: [],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with full answered count when no blocks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'warn',
+          message: 'Needs more detail',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with single check when one check has block', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Missing bias mitigation section',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
