+
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  // Collect unique checkIds with block severity
+  const blockingChecks = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockingChecks.add(finding.checkId);
+    }
+  }
+
+  // Count answered checks: those without block findings
+  // Special case: if gateSection is null, no checks can be answered
+  let answered = 0;
+  if (result.gateSection !== null) {
+    answered = GATE_CHECKS.filter((check) => !blockingChecks.has(check.id)).length;
+  }
+
+  // Build the summary line
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // Append blocking check IDs if any exist, in GATE_CHECKS order
+  if (blockingChecks.size > 0) {
+    const orderedBlockingIds: string[] = [];
+
+    // Add 'structure' first if present (it's not in GATE_CHECKS)
+    if (blockingChecks.has('structure')) {
+      orderedBlockingIds.push('structure');
+    }
+
+    // Then add other blocking checks in GATE_CHECKS order
+    for (const check of GATE_CHECKS) {
+      if (blockingChecks.has(check.id)) {
+        orderedBlockingIds.push(check.id);
+      }
+    }
+
+    summary += `: ${orderedBlockingIds.join(', ')}`;
+  }
+
+  return summary;
+}
