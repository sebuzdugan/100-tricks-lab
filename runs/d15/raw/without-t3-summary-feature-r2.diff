@@ -0,0 +1,146 @@
+import { describe, it, expect } from 'vitest';
+import { renderSummary } from './report.js';
+import type { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns "BLOCK 0/7: structure" when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [],
+      gateSection: null
+    };
+
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns "PASS 7/7" when all checks are answered with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'minimal',
+      findings: [],
+      gateSection: '## FRAI Gate\n...'
+    };
+
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns "WARN X/7" with no check IDs when only warning findings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'minimal',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Missing numeric thresholds', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Missing numeric thresholds', source: 'validator' }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns "BLOCK 5/7: evaluation, transparency" with block findings in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation plan', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing disclosure plan', source: 'validator' }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns correct format with single block finding', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing risk tier', source: 'validator' }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('includes all 7 check IDs when all checks have block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+
+    expect(renderSummary(result)).toBe(
+      'BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency'
+    );
+  });
+
+  it('ensures each check ID appears only once even with multiple findings per check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation plan', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Another issue with evaluation', source: 'agent' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing disclosure', source: 'validator' }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('treats mixed block and warn findings for same check as block', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation plan', source: 'validator' },
+        { checkId: 'evaluation', severity: 'warn', message: 'Could be more detailed', source: 'agent' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Could be more comprehensive', source: 'validator' }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('preserves GATE_CHECKS order regardless of finding order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, transparency');
+  });
+
+  it('works correctly with smart review findings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'high',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Plan is vague', source: 'agent' }
+      ],
+      gateSection: '## FRAI Gate\n...'
+    };
+
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+});
