@@ -0,0 +1,105 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+function makeResult(verdict: GateResult['verdict'], findings: Finding[] = [], gateSection: string | null = '# Gate'): GateResult {
+  return {
+    verdict,
+    tier: verdict === 'PASS' || verdict === 'WARN' ? 'limited' : null,
+    findings,
+    gateSection
+  };
+}
+
+describe('renderSummary', () => {
+  it('shows PASS 7/7 when all checks are answered', () => {
+    const result = makeResult('PASS', []);
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('shows WARN 7/7 when all checks are answered with warnings', () => {
+    const result = makeResult('WARN', [
+      { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('shows BLOCK 0/7: structure when gate section is missing', () => {
+    const result = makeResult('BLOCK', [
+      { checkId: 'structure', severity: 'block', message: 'Missing gate section', source: 'validator' }
+    ], null);
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('shows BLOCK with check IDs when some checks have block findings', () => {
+    const result = makeResult('BLOCK', [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing thresholds', source: 'validator' },
+      { checkId: 'transparency', severity: 'block', message: 'Missing incident path', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists each check ID only once even with multiple block findings', () => {
+    const result = makeResult('BLOCK', [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing thresholds', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: 'No numeric values', source: 'agent' },
+      { checkId: 'monitoring', severity: 'block', message: 'No degradation definition', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, monitoring');
+  });
+
+  it('counts checks with only warnings as answered', () => {
+    const result = makeResult('BLOCK', [
+      { checkId: 'evaluation', severity: 'warn', message: 'No numbers', source: 'validator' },
+      { checkId: 'transparency', severity: 'block', message: 'Missing incident path', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: transparency');
+  });
+
+  it('preserves GATE_CHECKS order in output', () => {
+    // Create findings in reverse order to verify ordering is applied
+    const result = makeResult('BLOCK', [
+      { checkId: 'transparency', severity: 'block', message: 'Missing incident path', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: 'Missing thresholds', source: 'validator' },
+      { checkId: 'risk-tier', severity: 'block', message: 'Missing justification', source: 'validator' }
+    ]);
+    // GATE_CHECKS order is: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('shows answered count correctly with mixed findings', () => {
+    const result = makeResult('BLOCK', [
+      { checkId: 'data-privacy', severity: 'warn', message: 'Generic PII retention', source: 'agent' },
+      { checkId: 'oversight', severity: 'block', message: 'No kill switch', source: 'validator' },
+      { checkId: 'bias', severity: 'block', message: 'No fairness analysis', source: 'validator' }
+    ]);
+    // GATE_CHECKS order: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency
+    expect(renderSummary(result)).toBe('BLOCK 5/7: oversight, bias');
+  });
+
+  it('handles no check IDs when BLOCK but finding is structure-only', () => {
+    const result = makeResult('BLOCK', [
+      { checkId: 'structure', severity: 'block', message: 'Missing gate section', source: 'validator' }
+    ], null);
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('does not append check IDs for non-BLOCK verdicts', () => {
+    const result = makeResult('PASS', []);
+    expect(renderSummary(result)).toBe('PASS 7/7');
+    expect(renderSummary(result)).not.toContain(':');
+  });
+
+  it('all 7 gate checks can have block findings', () => {
+    const result = makeResult('BLOCK', [
+      { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'data-privacy', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'oversight', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'bias', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'monitoring', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency');
+  });
+});
diff --git a/packages/frai-gate/src/gate/report.ts b/packages/frai-gate/src/gate/report.ts
