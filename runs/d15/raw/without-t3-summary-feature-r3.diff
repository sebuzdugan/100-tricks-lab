--- a/packages/frai-gate/src/gate/report.ts
+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,36 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: if gate section is missing (structure finding), return BLOCK 0/7: structure
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count answered checks: a check is answered if it has no block-severity findings
+  let answered = 0;
+  for (const check of GATE_CHECKS) {
+    if (!result.findings.some((f) => f.checkId === check.id && f.severity === 'block')) {
+      answered++;
+    }
+  }
+
+  // Build summary: "<VERDICT> <answered>/7"
+  let summary = `${result.verdict} ${answered}/7`;
+
+  // If BLOCK, append check IDs with block findings in GATE_CHECKS order
+  if (result.verdict === 'BLOCK') {
+    const blockCheckIds: string[] = [];
+    for (const check of GATE_CHECKS) {
+      if (result.findings.some((f) => f.checkId === check.id && f.severity === 'block')) {
+        blockCheckIds.push(check.id);
+      }
+    }
+    if (blockCheckIds.length > 0) {
+      summary += ': ' + blockCheckIds.join(', ');
+    }
+  }
+
+  return summary;
+}
