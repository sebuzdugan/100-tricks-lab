+  const thresholds: Record<string, number> = {};
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error('Invalid threshold format. Use --threshold metric=value (e.g., --threshold exact_match=0.9)');
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value "${valueStr}" for metric "${metricId}". Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
