@@ -59,25 +59,85 @@ export function runEvaluations({
   return evaluations;
 }
 
+export function validateThresholds(thresholds, evaluations) {
+  const errors = [];
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+
+  if (!thresholds || typeof thresholds !== 'object') {
+    return { valid: true, errors: [] };
+  }
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      const validIds = Array.from(validMetricIds).sort();
+      errors.push(
+        `Unknown metric "${metricId}". Valid metrics: ${validIds.join(', ')}`
+      );
+    }
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors
+  };
+}
+
+export function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds || typeof thresholds !== 'object' || Object.keys(thresholds).length === 0) {
+    return {
+      passed: true,
+      thresholds: []
+    };
+  }
+
+  const metricMap = new Map(evaluations.map((m) => [m.id, m]));
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    const metric = metricMap.get(metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= minValue;
+    if (!passed) allPassed = false;
+
+    thresholdResults.push({
+      metric: metricId,
+      min: minValue,
+      score,
+      passed
+    });
+  }
+
+  return {
+    passed: allPassed,
+    thresholds: thresholdResults
+  };
+}
+
 export function generateReport({
   evaluations,
   outputsPath,
   referencesPath,
-  generatedAt = new Date().toISOString()
+  generatedAt = new Date().toISOString(),
+  thresholds
 }) {
   const totalSamples = evaluations.reduce((total, metric) => {
     if (typeof metric.total === 'number') return Math.max(total, metric.total);
     return total;
   }, 0);
 
+  const thresholdResults = evaluateThresholds(thresholds, evaluations);
+
   return {
+    passed: thresholdResults.passed,
     metadata: {
       generatedAt,
       outputsPath,
       referencesPath,
       totalSamples
     },
-    metrics: evaluations
+    metrics: evaluations,
+    thresholds: thresholdResults.thresholds
   };
 }
 
