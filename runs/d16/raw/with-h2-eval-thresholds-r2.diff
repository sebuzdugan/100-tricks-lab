+function parseThresholds(thresholdStrs?: string[]) {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrs) {
+    const match = str.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: ${str}. Expected format: <metric>=<number>`);
+    }
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value for ${metricId}: ${minStr}. Minimum must be a number between 0 and 1.`);
+    }
+    thresholds[metricId] = min;
+  }
+  return thresholds;
+}
