@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,33 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const hasStructureIssue = result.findings.some(
+    (f) => f.checkId === 'structure' && f.severity === 'block'
+  );
+  if (hasStructureIssue) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const checkIdsWithBlocks = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      checkIdsWithBlocks.add(finding.checkId);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - checkIdsWithBlocks.size;
+  const total = GATE_CHECKS.length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (checkIdsWithBlocks.size > 0) {
+    const blockedIds = GATE_CHECKS.filter((check) => checkIdsWithBlocks.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockedIds}`;
+  }
+
+  return summary;
+}
