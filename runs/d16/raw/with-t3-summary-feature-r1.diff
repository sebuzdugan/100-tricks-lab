+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS when all checks are answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN when there are only warnings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No gate section found',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns BLOCK with block checks listed when some checks fail', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency info',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists block findings in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency info',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, transparency');
+  });
+
+  it('counts each check only once even with multiple findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing metrics',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'No eval dataset',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('lists all block checks when all checks fail', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe(
+      'BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency'
+    );
+  });
+});
