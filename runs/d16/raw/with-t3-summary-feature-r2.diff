+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No "## Responsible AI Gate" section found in the spec.',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with answered count and no checks when only warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: '"Evaluation plan" has no numeric threshold.',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: '"Monitoring & rollback" has no numeric threshold.',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with blocked check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing gate subsection: "Evaluation plan".',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing gate subsection: "Transparency & incidents".',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('deduplicates multiple findings for the same check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Risk tier must be one of: prohibited, high, limited, minimal.',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'High-risk tier requires a named human sign-off (name + date) in the spec.',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('lists multiple blocked checks in GATE_CHECKS order even if findings are out of order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Missing gate subsection: "Bias & fairness".',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing gate subsection: "Data & privacy".',
+          source: 'validator'
+        },
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'Missing gate subsection: "Human oversight".',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, oversight, bias');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: '"Evaluation plan" has no numeric threshold.',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing gate subsection: "Transparency & incidents".',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'mock gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: transparency');
+  });
+});
