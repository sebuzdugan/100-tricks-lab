@@ -0,0 +1,103 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('renders PASS with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('renders WARN with some checks answered', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Missing numbers', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('renders BLOCK with check ids', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('renders check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, transparency');
+  });
+
+  it('deduplicates check ids', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing numbers', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Another issue', source: 'agent' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores warnings when counting answered', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Weak answer', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+
+  it('renders BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'No gate', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('includes all blocked checks in correct order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '# Gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, oversight, bias');
+  });
+});
