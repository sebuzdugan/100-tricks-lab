+export function validateThresholds(thresholds, metrics) {
+  const errors = [];
+  const validMetricIds = new Set(metrics.map((m) => m.id));
+
+  for (const [metricId, minValue] of Object.entries(thresholds || {})) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric id: ${metricId}. Valid metrics: ${Array.from(validMetricIds).join(', ')}`);
+      continue;
+    }
+    if (typeof minValue !== 'number' || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold for ${metricId}: must be a number between 0 and 1, got ${minValue}`);
+    }
+  }
+
+  return errors;
+}
+
+export function evaluateThresholds(thresholds, metrics) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+    results.push({ metric: metricId, min, score, passed });
+  }
+
+  return { passed: allPassed, thresholds: results };
+}
