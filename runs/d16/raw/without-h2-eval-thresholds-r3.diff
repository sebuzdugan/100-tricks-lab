+function parseThresholds(thresholdStrings: string[] | undefined, evaluations: any[]): { parsed: Record<string, number>; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { parsed: {} };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = evaluations.map((m) => m.id);
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        parsed: {},
+        error: `Malformed threshold: "${threshold}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      return {
+        parsed: {},
+        error: `Invalid threshold value: "${valueStr}". Must be a number between 0 and 1`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        parsed: {},
+        error: `Unknown metric: "${metricId}". Valid metrics: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { parsed: thresholds };
+}
