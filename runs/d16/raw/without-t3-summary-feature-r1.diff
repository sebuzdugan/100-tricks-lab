diff --git a/packages/frai-gate/src/gate/report.test.ts b/packages/frai-gate/src/gate/report.test.ts
new file mode 100644
index 0000000..9bbe585
--- /dev/null
+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,116 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, GATE_CHECKS } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7 when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      gateSection: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'Missing gate section', source: 'validator' }]
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      gateSection: '## Gate\n\nContent',
+      findings: []
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with correct count when there are only warnings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      gateSection: '## Gate\n\nContent',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Missing numbers', source: 'validator' }
+      ]
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with check ids when there are block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      gateSection: '## Gate\n\nContent',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing transparency', source: 'validator' }
+      ]
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('maintains GATE_CHECKS order when listing block check ids', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      gateSection: '## Gate\n\nContent',
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Missing', source: 'validator' }
+      ]
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, bias, transparency');
+  });
+
+  it('deduplicates check ids', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      gateSection: '## Gate\n\nContent',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing numbers', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Unsupported threshold format', source: 'agent' }
+      ]
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      gateSection: '## Gate\n\nContent',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Missing numbers', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Vague rollback trigger', source: 'agent' }
+      ]
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('handles mixed block and warn findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      gateSection: '## Gate\n\nContent',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Vague', source: 'agent' }
+      ]
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('prioritizes structure finding over other block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      gateSection: null,
+      findings: [
+        { checkId: 'structure', severity: 'block', message: 'Missing gate section', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'This should be ignored', source: 'validator' }
+      ]
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+});
