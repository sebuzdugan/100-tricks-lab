+import { GATE_CHECKS, Finding, GateResult } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  if (result.gateSection === null) {
+    return `BLOCK 0/${total}: structure`;
+  }
+
+  const blocksByCheckId = new Map<string, Finding[]>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      if (!blocksByCheckId.has(finding.checkId)) {
+        blocksByCheckId.set(finding.checkId, []);
+      }
+      blocksByCheckId.get(finding.checkId)!.push(finding);
+    }
+  }
+
+  const answered = GATE_CHECKS.filter((check) => !blocksByCheckId.has(check.id)).length;
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blocksByCheckId.size > 0) {
+    const blockedIds = GATE_CHECKS
+      .filter((check) => blocksByCheckId.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockedIds}`;
+  }
+
+  return summary;
+}
