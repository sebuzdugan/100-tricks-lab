+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## Responsible AI Gate\n\n### 5.1 Risk tier\n\nAnswer'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns BLOCK 0/7 when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No "## Responsible AI Gate" section found in the spec.',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('counts checks with no block findings as answered', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing gate subsection: "Data & privacy".',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing gate subsection: "Evaluation plan".',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n\n### 5.1 Risk tier\n\nAnswer'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: data-privacy, evaluation');
+  });
+
+  it('ignores warning findings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: '"Evaluation plan" has no numeric threshold.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n\n### 5.1 Risk tier\n\nAnswer'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('lists blocked checks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing gate subsection: "Transparency & incidents".',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing gate subsection: "Risk tier".',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing gate subsection: "Evaluation plan".',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n\n### 5.1 Risk tier\n\nAnswer'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('lists each blocked check id once', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'First block on evaluation.',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Second block on evaluation.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n\n### 5.1 Risk tier\n\nAnswer'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
