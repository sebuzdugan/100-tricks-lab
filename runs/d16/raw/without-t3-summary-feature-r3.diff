+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('renders PASS with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## FRAI Gate'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('renders WARN with answered checks and warning findings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('renders BLOCK with blocked checks and lists their ids', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency info',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('renders BLOCK with multiple blocks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data info',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'block',
+          message: 'Missing monitoring',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, monitoring, transparency');
+  });
+
+  it('renders BLOCK 0/7 when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No "## Responsible AI Gate" section found',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores warning findings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers in evaluation',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numbers in monitoring',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('counts answered checks when some blocks and some warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numbers',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('deduplicates check ids from multiple findings of the same check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Contains placeholder text',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
