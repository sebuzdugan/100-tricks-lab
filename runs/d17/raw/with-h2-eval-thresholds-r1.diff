+function parseThresholds(thresholdArgs?: string[]): Record<string, number> | null {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${arg}". Expected format: <metric>=<number>`);
+    }
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+    if (isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for "${metricId}": "${valueStr}". Must be a number between 0 and 1.`);
+    }
+    thresholds[metricId] = value;
+  }
+  return thresholds;
+}
