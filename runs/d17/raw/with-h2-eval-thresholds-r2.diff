+import { describe, expect, it } from 'vitest';
+
+// Threshold parsing function - extracted for testing
+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(-?[0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      throw new Error(`Invalid threshold value: "${valueStr}". Expected a number.`);
+    }
+
+    if (value < 0 || value > 1) {
+      throw new Error(`Threshold value out of range: ${value}. Must be between 0 and 1.`);
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      throw new Error(
+        `Unknown metric: "${metricId}". Valid metrics: ${validMetrics.join(', ')}`
+      );
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
+
+describe('CLI Threshold Parsing', () => {
+  it('returns null when no thresholds are provided', () => {
+    expect(parseThresholds()).toBeNull();
+    expect(parseThresholds([])).toBeNull();
+  });
+
+  it('parses valid threshold strings', () => {
+    const result = parseThresholds(['exact_match=0.9']);
+    expect(result).toEqual({ exact_match: 0.9 });
+  });
+
+  it('parses multiple thresholds', () => {
+    const result = parseThresholds(['exact_match=0.9', 'toxicity=0.8']);
+    expect(result).toEqual({
+      exact_match: 0.9,
+      toxicity: 0.8
+    });
+  });
+
+  it('throws error for malformed threshold format', () => {
+    expect(() => parseThresholds(['exact_match0.9'])).toThrow('Malformed threshold');
+    expect(() => parseThresholds(['exact_match='])).toThrow('Malformed threshold');
+    expect(() => parseThresholds(['=0.9'])).toThrow('Malformed threshold');
+    expect(() => parseThresholds(['exact_match=abc'])).toThrow('Malformed threshold');
+  });
+
+  it('throws error for threshold value out of range', () => {
+    expect(() => parseThresholds(['exact_match=-0.1'])).toThrow('out of range');
+    expect(() => parseThresholds(['exact_match=1.1'])).toThrow('out of range');
+    expect(() => parseThresholds(['exact_match=2'])).toThrow('out of range');
+  });
+
+  it('throws error for unknown metric', () => {
+    expect(() => parseThresholds(['unknown_metric=0.5'])).toThrow('Unknown metric');
+    expect(() => parseThresholds(['bad_metric=0.5'])).toThrow('Unknown metric');
+  });
+
+  it('accepts boundary values 0 and 1', () => {
+    const result = parseThresholds(['exact_match=0', 'toxicity=1', 'length_variance=0.5']);
+    expect(result).toEqual({
+      exact_match: 0,
+      toxicity: 1,
+      length_variance: 0.5
+    });
+  });
+
+  it('parses decimal threshold values', () => {
+    const result = parseThresholds(['exact_match=0.123', 'toxicity=0.999']);
+    expect(result?.exact_match).toBeCloseTo(0.123);
+    expect(result?.toxicity).toBeCloseTo(0.999);
+  });
+});
