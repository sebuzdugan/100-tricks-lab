+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(
+        `Invalid threshold format: "${str}". Expected format: metric=value (e.g., exact_match=0.9)`
+      );
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      throw new Error(`Invalid threshold value: "${valueStr}" is not a number`);
+    }
+
+    if (value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value: ${value} must be between 0 and 1`);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
