+REFERENCES="$REPO_DIR/test-references.json"
+
+# Create test data
+echo '["Hello", "World"]' > "$OUTPUTS_GOOD"
+echo '["Goodbye", "Earth"]' > "$OUTPUTS_BAD"
+echo '["hello", "world"]' > "$REFERENCES"
+
+echo "================================================"
+echo "Testing frai eval threshold feature"
+echo "================================================"
+echo ""
+
+# Test 1: Both thresholds pass (exit code 0)
+echo "Test 1: All thresholds pass (exit code 0)"
+cd "$CLI_DIR"
+if node dist/index.js eval --outputs "$OUTPUTS_GOOD" --references "$REFERENCES" \
+  --threshold exact_match=0.9 --threshold length_variance=0.8 2>&1 | grep -q "SUCCESS"; then
+  echo "✓ Report generated successfully"
+else
+  echo "✗ Failed to generate report"
+  exit 1
+fi
+
+# Check exit code
+if node dist/index.js eval --outputs "$OUTPUTS_GOOD" --references "$REFERENCES" \
+  --threshold exact_match=0.9 --threshold length_variance=0.8 > /dev/null 2>&1; then
+  echo "✓ Exit code is 0 (pass)"
+else
+  echo "✗ Exit code is not 0"
+  exit 1
+fi
+echo ""
+
+# Test 2: Threshold fails (exit code 1)
+echo "Test 2: Threshold fails (exit code 1)"
+if node dist/index.js eval --outputs "$OUTPUTS_BAD" --references "$REFERENCES" \
+  --threshold exact_match=0.9 > /dev/null 2>&1; then
+  echo "✗ Exit code should be 1 (fail), not 0"
+  exit 1
+else
+  STATUS=$?
+  if [ $STATUS -eq 1 ]; then
+    echo "✓ Exit code is 1 (fail)"
+  else
+    echo "✗ Unexpected exit code: $STATUS"
+    exit 1
+  fi
+fi
+echo ""
