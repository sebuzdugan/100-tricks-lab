+  --threshold exact_match=1.5 2>&1 | grep -q "must be between 0 and 1"; then
+  echo "✓ Error message shown for invalid range"
+else
+  echo "✗ Did not show error for invalid range"
+  exit 1
+fi
+
+if ! node dist/index.js eval --outputs "$OUTPUTS_GOOD" --references "$REFERENCES" \
+  --threshold exact_match=1.5 > /dev/null 2>&1; then
+  STATUS=$?
+  if [ $STATUS -eq 2 ]; then
+    echo "✓ Exit code is 2 (usage error)"
+  else
+    echo "✗ Unexpected exit code: $STATUS"
+    exit 1
+  fi
+fi
+echo ""
+
+# Test 4: Unknown metric (exit code 2)
+echo "Test 4: Unknown metric (exit code 2)"
+if node dist/index.js eval --outputs "$OUTPUTS_GOOD" --references "$REFERENCES" \
