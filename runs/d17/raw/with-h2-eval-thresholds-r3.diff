+function validateThresholds(thresholds, metricIds) {
+  const errors = [];
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return errors;
+  }
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (typeof min !== 'number') {
+      errors.push(`Threshold for "${metricId}" must be a number, got ${typeof min}`);
+    } else if (min < 0 || min > 1) {
+      errors.push(`Threshold for "${metricId}" must be between 0 and 1, got ${min}`);
+    }
+    if (!metricIds.includes(metricId)) {
+      errors.push(
+        `Unknown metric: "${metricId}". Valid metrics are: ${metricIds.join(', ')}`
+      );
+    }
+  }
+
+  return errors;
+}
+
+function checkThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return {
+      passed: true,
+      thresholds: []
+    };
+  }
+
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score;
+
+    const passed = score !== null && score !== undefined && score >= min;
+    if (!passed) {
+      allPassed = false;
+    }
+
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score: score ?? null,
+      passed
+    });
+  }
+
+  return {
+    passed: allPassed,
+    thresholds: thresholdResults
+  };
+}
