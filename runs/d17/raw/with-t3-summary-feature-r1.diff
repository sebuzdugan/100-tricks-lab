 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,36 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Check for structure finding (missing gate section)
+  const hasStructureFinding = result.findings.some((f) => f.checkId === 'structure');
+  if (hasStructureFinding) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Get all block findings for GATE_CHECKS
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && GATE_CHECKS.some((c) => c.id === finding.checkId)) {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  // Count answered = total GATE_CHECKS - block checkIds
+  const answered = GATE_CHECKS.length - blockCheckIds.size;
+  const total = GATE_CHECKS.length;
+
+  // Build summary line
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // Append block check IDs in GATE_CHECKS order if there are any
+  if (blockCheckIds.size > 0) {
+    const blockIds = GATE_CHECKS.filter((c) => blockCheckIds.has(c.id))
+      .map((c) => c.id)
+      .join(', ');
+    summary += `: ${blockIds}`;
+  }
+
+  return summary;
+}
