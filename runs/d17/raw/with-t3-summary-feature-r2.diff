+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,30 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  const structureIssue = result.findings.some((f) => f.checkId === 'structure');
+  if (structureIssue) {
+    return `BLOCK 0/${total}: structure`;
+  }
+
+  const blockedCheckIds = new Set(
+    result.findings
+      .filter((f) => f.severity === 'block')
+      .map((f) => f.checkId)
+  );
+
+  const answered = total - blockedCheckIds.size;
+
+  if (blockedCheckIds.size > 0) {
+    const blockIds = GATE_CHECKS
+      .map((c) => c.id)
+      .filter((id) => blockedCheckIds.has(id))
+      .join(', ');
+    return `${result.verdict} ${answered}/${total}: ${blockIds}`;
+  }
+
+  return `${result.verdict} ${answered}/${total}`;
+}
