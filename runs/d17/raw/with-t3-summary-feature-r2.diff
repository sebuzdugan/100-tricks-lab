+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result = validateSpec('# Spec\n\n## Objective\n\nBuild a thing.');
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result = validateSpec(fullSpec());
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN 7/7 when only warnings exist', () => {
+    const result = validateSpec(
+      fullSpec({
+        evaluation: `### 5.4 Evaluation plan
+
+- **Pre-ship metrics & thresholds**: we will check answers look good
+- **Eval dataset**: some real questions
+- **Who runs it and when**: the team, before release`
+      })
+    );
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with count and block check ids', () => {
+    const result = validateSpec(
+      fullSpec({
+        evaluation: `### 5.4 Evaluation plan`,
+        transparency: `### 5.7 Transparency & incident response`
+      })
+    );
+    expect(renderSummary(result)).toMatch(/^BLOCK \d\/7: evaluation, transparency$/);
+  });
+
+  it('lists block ids in GATE_CHECKS order', () => {
