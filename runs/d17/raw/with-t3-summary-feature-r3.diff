 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,33 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: structure finding means no gate section at all
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Find unique checks with block findings
+  const blockingChecks = new Set(
+    result.findings
+      .filter((f) => f.severity === 'block')
+      .map((f) => f.checkId)
+  );
+
+  const answered = GATE_CHECKS.length - blockingChecks.size;
+  const verdict = result.verdict;
+
+  let summary = `${verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  // If there are blocking checks, append their IDs in GATE_CHECKS order
+  if (blockingChecks.size > 0) {
+    const blockingCheckIds = GATE_CHECKS
+      .filter((check) => blockingChecks.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockingCheckIds}`;
+  }
+
+  return summary;
+}
