+function validateThresholds(thresholds = {}, evaluations = []) {
+  const metricIds = new Set(evaluations.map((m) => m.id));
+  const errors = [];
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!metricIds.has(metricId)) {
+      errors.push(`Unknown metric id: ${metricId}. Valid metrics: ${Array.from(metricIds).join(', ')}`);
+    } else if (typeof min !== 'number') {
+      errors.push(`Threshold for ${metricId} must be a number, got ${typeof min}`);
+    } else if (min < 0 || min > 1) {
+      errors.push(`Threshold for ${metricId} must be between 0 and 1, got ${min}`);
+    }
+  }
+
+  return errors;
+}
+
+function evaluateThresholds(thresholds = {}, evaluations = []) {
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score !== undefined && score >= min;
+    if (!passed) allPassed = false;
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: thresholdResults };
+}
