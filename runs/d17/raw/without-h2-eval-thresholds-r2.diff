+    if (Number.isNaN(min)) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Minimum value must be a number.`);
+    }
+
+    if (min < 0 || min > 1) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Minimum value must be between 0 and 1.`);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
