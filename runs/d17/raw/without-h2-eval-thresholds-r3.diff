+function parseThresholds(thresholdStrings: string[] | undefined): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [key: string]: number } = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(-?[0-9.]+)$/);
+    if (!match) {
+      log.error('Malformed threshold: not <metric>=<number>', { threshold: thresholdStr });
+      process.exit(2);
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      log.error('Invalid threshold score: must be a number between 0 and 1', { threshold: thresholdStr, score: scoreStr });
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error('Unknown metric id in threshold', {
+        threshold: thresholdStr,
+        metricId,
+        validMetricIds
+      });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return thresholds;
+}
