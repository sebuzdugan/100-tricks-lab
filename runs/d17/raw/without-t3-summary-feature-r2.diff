+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,25 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+
+  if (blockFindings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockedCheckIds = new Set(blockFindings.map((f) => f.checkId));
+  const answered = GATE_CHECKS.filter((check) => !blockedCheckIds.has(check.id)).length;
+
+  let summary = `${result.verdict} ${answered}/7`;
+
+  if (blockedCheckIds.size > 0) {
+    const sortedIds = GATE_CHECKS.filter((check) => blockedCheckIds.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${sortedIds}`;
+  }
+
+  return summary;
+}
