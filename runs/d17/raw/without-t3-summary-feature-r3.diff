@@ -0,0 +1,167 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+function createResult(overrides: Partial<GateResult> = {}): GateResult {
+  return {
+    verdict: 'PASS',
+    tier: null,
+    findings: [],
+    gateSection: null,
+    ...overrides
+  };
+}
+
+describe('renderSummary', () => {
+  it('shows PASS 7/7 when all checks are answered', () => {
+    const result = createResult({ verdict: 'PASS', findings: [] });
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('shows WARN with answered count when there are only warnings', () => {
+    const result = createResult({
+      verdict: 'WARN',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers found',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('shows BLOCK with check ids when there are block findings', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency section',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists block check ids in GATE_CHECKS order', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Gate section not found',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('only lists each check id once even if there are multiple findings', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'First issue',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Second issue',
+          source: 'agent'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores warnings when counting block findings', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data section',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('combines multiple block findings with mixed warnings', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Invalid tier',
+          source: 'validator'
+        },
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'Missing override path',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No metrics specified',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, oversight');
+  });
+});
