@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,30 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const TOTAL = GATE_CHECKS.length;
+
+  // Check for structure finding (missing gate section)
+  const structureIssue = result.findings.find((f) => f.checkId === 'structure');
+  if (structureIssue) {
+    return `BLOCK 0/${TOTAL}: structure`;
+  }
+
+  // Collect all check IDs that have block findings
+  const blockCheckIds = new Set(
+    result.findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+
+  // Answered = total - blocked
+  const answered = TOTAL - blockCheckIds.size;
+  const summary = `${result.verdict} ${answered}/${TOTAL}`;
+
+  // If there are block findings, append their check ids in GATE_CHECKS order
+  if (blockCheckIds.size > 0) {
+    const orderedIds = GATE_CHECKS.map((check) => check.id).filter((id) => blockCheckIds.has(id));
+    return `${summary}: ${orderedIds.join(', ')}`;
+  }
+
+  return summary;
+}
