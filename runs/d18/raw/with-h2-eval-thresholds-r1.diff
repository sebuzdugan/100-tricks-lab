+function parseAndValidateThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number>; errors: string[] } {
+  const errors: string[] = [];
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds, errors };
+  }
+
+  for (const threshStr of thresholdStrings) {
+    // Parse format: metric_id=min_value
+    const parts = threshStr.split('=');
+    if (parts.length !== 2) {
+      errors.push(`Malformed threshold: "${threshStr}". Expected format: <metric>=<number>`);
+      continue;
+    }
+
+    const metricId = parts[0].trim();
+    const minStr = parts[1].trim();
+
+    if (!metricId) {
+      errors.push(`Empty metric ID in threshold: "${threshStr}"`);
+      continue;
+    }
+
+    let minValue: number;
+    try {
+      minValue = Number.parseFloat(minStr);
+      if (Number.isNaN(minValue)) {
+        throw new Error('Not a number');
+      }
+    } catch {
+      errors.push(`Invalid min value "${minStr}" in threshold "${threshStr}". Must be a number.`);
+      continue;
+    }
+
+    if (minValue < 0 || minValue > 1) {
+      errors.push(`Invalid min value ${minValue} in threshold "${threshStr}". Must be between 0 and 1.`);
+      continue;
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return { thresholds, errors };
+}
+
+function getValidMetricIds(evaluations: unknown[]): string[] {
+  const evals = Array.isArray(evaluations) ? evaluations : [];
+  const ids = evals
+    .filter((metric: any) => metric && typeof metric.id === 'string')
+    .map((metric: any) => metric.id);
+  // Also include default metrics
+  const defaultIds = ['exact_match', 'toxicity', 'length_variance'];
+  return Array.from(new Set([...ids, ...defaultIds])).sort();
+}
+
+function validateThresholdMetrics(thresholds: Record<string, number>, evaluations: unknown[]): string[] {
+  const errors: string[] = [];
+  const validIds = getValidMetricIds(evaluations);
+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!validIds.includes(metricId)) {
+      errors.push(`Unknown metric: "${metricId}". Valid metrics are: ${validIds.join(', ')}`);
+    }
+  }
+
+  return errors;
+}
