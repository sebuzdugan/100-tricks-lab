+import { describe, expect, it } from 'vitest';
+import { parseAndValidateThresholds } from './index.js';
+
+describe('Threshold parsing and validation', () => {
+  it('parses valid threshold format', () => {
+    const { thresholds, errors } = parseAndValidateThresholds(['exact_match=0.8']);
+    expect(errors).toHaveLength(0);
+    expect(thresholds).toEqual({ exact_match: 0.8 });
+  });
+
+  it('parses multiple thresholds', () => {
+    const { thresholds, errors } = parseAndValidateThresholds([
+      'exact_match=0.8',
+      'toxicity=0.9'
+    ]);
+    expect(errors).toHaveLength(0);
+    expect(thresholds).toEqual({ exact_match: 0.8, toxicity: 0.9 });
+  });
+
+  it('rejects malformed threshold (missing =)', () => {
+    const { errors } = parseAndValidateThresholds(['exact_match']);
+    expect(errors).toHaveLength(1);
+    expect(errors[0]).toContain('Expected format: <metric>=<number>');
+  });
+
+  it('rejects malformed threshold (multiple =)', () => {
+    const { errors } = parseAndValidateThresholds(['exact_match=0.8=extra']);
+    expect(errors).toHaveLength(1);
+    expect(errors[0]).toContain('Expected format');
+  });
+
+  it('rejects invalid min value (not a number)', () => {
+    const { errors } = parseAndValidateThresholds(['exact_match=abc']);
+    expect(errors).toHaveLength(1);
+    expect(errors[0]).toContain('Must be a number');
+  });
+
+  it('rejects min value below 0', () => {
+    const { errors } = parseAndValidateThresholds(['exact_match=-0.1']);
+    expect(errors).toHaveLength(1);
+    expect(errors[0]).toContain('Must be between 0 and 1');
+  });
+
+  it('rejects min value above 1', () => {
+    const { errors } = parseAndValidateThresholds(['exact_match=1.5']);
+    expect(errors).toHaveLength(1);
+    expect(errors[0]).toContain('Must be between 0 and 1');
+  });
+
+  it('allows min value of 0', () => {
+    const { thresholds, errors } = parseAndValidateThresholds(['exact_match=0']);
+    expect(errors).toHaveLength(0);
+    expect(thresholds).toEqual({ exact_match: 0 });
+  });
+
+  it('allows min value of 1', () => {
+    const { thresholds, errors } = parseAndValidateThresholds(['exact_match=1']);
+    expect(errors).toHaveLength(0);
+    expect(thresholds).toEqual({ exact_match: 1 });
+  });
+
+  it('handles no thresholds provided', () => {
+    const { thresholds, errors } = parseAndValidateThresholds();
+    expect(errors).toHaveLength(0);
+    expect(thresholds).toEqual({});
+  });
+
+  it('handles empty array', () => {
+    const { thresholds, errors } = parseAndValidateThresholds([]);
+    expect(errors).toHaveLength(0);
+    expect(thresholds).toEqual({});
+  });
+
+  it('continues processing after first error', () => {
+    const { thresholds, errors } = parseAndValidateThresholds([
+      'exact_match=malformed',
+      'toxicity=0.9'
+    ]);
+    expect(errors).toHaveLength(1);
+    expect(thresholds).toEqual({ toxicity: 0.9 });
+  });
+});
