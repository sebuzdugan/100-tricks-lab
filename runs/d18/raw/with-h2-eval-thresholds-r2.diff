+---
+title: 'Add threshold support to frai eval'
+type: 'feature'
+created: '2026-09-21'
+status: 'done'
+review_loop_iteration: 0
+followup_review_recommended: false
+baseline_revision: 'ca635f4cfe8864add0317204a9572a3001a6e4f5'
