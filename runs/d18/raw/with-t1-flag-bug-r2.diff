+
+      // Manually extract all arguments after 'gate' from process.argv to preserve flags
+      // Commander's variadic args with allowUnknownOption don't properly separate flags,
+      // so we extract directly from argv which includes all flags/options.
+      // We search from position 2 onwards to avoid matching 'gate' in argument values.
+      const gateIndex = process.argv.slice(2).indexOf('gate') + 2;
+
+      if (gateIndex === 1) {
+        // gate command not found in arguments (indexOf returned -1, so 1 after +2)
+        log.error('Error: gate command not found in arguments');
+      }
+
+      const commandArgs: string[] = gateIndex >= 2 ? process.argv.slice(gateIndex + 1) : (args ?? []);
+
       const { spawnSync } = await import('child_process');
-      const result = spawnSync(process.execPath, [gateCli, ...(args ?? [])], { stdio: 'inherit' });
+      const result = spawnSync(process.execPath, [gateCli, ...commandArgs], { stdio: 'inherit' });
       process.exit(result.status ?? 0);
     });
 
