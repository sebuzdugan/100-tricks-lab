+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { spawnSync } from 'child_process';
+
+// Mock child_process.spawnSync
+vi.mock('child_process', () => ({
+  spawnSync: vi.fn(),
+}));
+
+describe('gate command argument delegation', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('should pass --ci flag through to frai-gate', () => {
+    const mockSpawnSync = vi.mocked(spawnSync);
+    mockSpawnSync.mockReturnValue({ status: 0 } as any);
+
+    // Simulate: frai gate init --ci
+    // This test verifies that the gate index detection correctly identifies 'gate' at position 2
+    // and extracts all arguments after it, including flags
+    const testArgv = ['/usr/bin/node', '/path/to/frai-cli/dist/index.js', 'gate', 'init', '--ci'];
+    const gateIndex = testArgv.slice(2).indexOf('gate') + 2;
+
+    expect(gateIndex).toBe(2);
+    const commandArgs = testArgv.slice(gateIndex + 1);
+    expect(commandArgs).toEqual(['init', '--ci']);
+  });
+
+  it('should pass --out flag through to frai-gate', () => {
+    const testArgv = ['/usr/bin/node', '/path/to/frai-cli/dist/index.js', 'gate', 'init', '--out', 'custom.md'];
+    const gateIndex = testArgv.slice(2).indexOf('gate') + 2;
+
+    expect(gateIndex).toBe(2);
+    const commandArgs = testArgv.slice(gateIndex + 1);
+    expect(commandArgs).toEqual(['init', '--out', 'custom.md']);
+  });
+
+  it('should handle multiple flags combined', () => {
+    const testArgv = ['/usr/bin/node', '/path/to/frai-cli/dist/index.js', 'gate', 'init', '--out', 'myspec.md', '--ci'];
+    const gateIndex = testArgv.slice(2).indexOf('gate') + 2;
+
+    expect(gateIndex).toBe(2);
+    const commandArgs = testArgv.slice(gateIndex + 1);
+    expect(commandArgs).toEqual(['init', '--out', 'myspec.md', '--ci']);
+  });
+
+  it('should avoid matching gate in earlier argument values', () => {
+    // Test case where 'gate' appears in an earlier argument value (e.g., a file path)
+    const testArgv = ['/usr/bin/node', '/path/to/frai-cli/dist/index.js', 'some-value-with-gate', 'gate', 'init'];
+    const gateIndex = testArgv.slice(2).indexOf('gate') + 2;
+
+    // Should find 'gate' at position 3 (in the actual subcommand), not position 2 (in the value)
+    expect(gateIndex).toBe(3);
+    const commandArgs = testArgv.slice(gateIndex + 1);
+    expect(commandArgs).toEqual(['init']);
+  });
+
+  it('should return -1 equivalent (index 1) when gate command not found', () => {
+    const testArgv = ['/usr/bin/node', '/path/to/frai-cli/dist/index.js', 'check', 'somefile.md'];
+    const gateIndex = testArgv.slice(2).indexOf('gate') + 2;
+
+    // indexOf returns -1, so -1 + 2 = 1
+    expect(gateIndex).toBe(1);
+  });
+
+  it('should pass check subcommand with --smart flag', () => {
+    const testArgv = ['/usr/bin/node', '/path/to/frai-cli/dist/index.js', 'gate', 'check', 'FRAI-SPEC.md', '--smart'];
+    const gateIndex = testArgv.slice(2).indexOf('gate') + 2;
+
+    expect(gateIndex).toBe(2);
+    const commandArgs = testArgv.slice(gateIndex + 1);
+    expect(commandArgs).toEqual(['check', 'FRAI-SPEC.md', '--smart']);
+  });
+
+  it('should pass draft subcommand with --json flag', () => {
+    const testArgv = ['/usr/bin/node', '/path/to/frai-cli/dist/index.js', 'gate', 'draft', '--json'];
+    const gateIndex = testArgv.slice(2).indexOf('gate') + 2;
+
+    expect(gateIndex).toBe(2);
+    const commandArgs = testArgv.slice(gateIndex + 1);
+    expect(commandArgs).toEqual(['draft', '--json']);
+  });
+});
