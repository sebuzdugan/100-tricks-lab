-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,36 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Check if gate section is missing (structure finding)
+  const structureFinding = result.findings.find((f) => f.checkId === 'structure');
+  if (structureFinding && structureFinding.severity === 'block') {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count checks with block-severity findings
+  const blockFindingsByCheck = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && finding.checkId !== 'structure') {
+      blockFindingsByCheck.add(finding.checkId);
+    }
+  }
+
+  // Calculate answered count: checks without block findings
+  const answered = GATE_CHECKS.length - blockFindingsByCheck.size;
+  const total = GATE_CHECKS.length;
+
+  // Build the base output
+  let output = `${result.verdict} ${answered}/${total}`;
+
+  // If there are block findings, append them in GATE_CHECKS order
+  if (blockFindingsByCheck.size > 0) {
+    const blockedCheckIds = GATE_CHECKS.filter((check) => blockFindingsByCheck.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    output += `: ${blockedCheckIds}`;
+  }
+
+  return output;
+}
