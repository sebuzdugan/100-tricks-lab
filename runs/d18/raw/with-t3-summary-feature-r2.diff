+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns "PASS 7/7" when there are no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns "BLOCK n/7: id1, id2" with block findings in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'missing threshold', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'missing disclosure', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    // evaluation is index 3, transparency is index 6 in GATE_CHECKS
+    // So answered = 7 - 2 = 5, and they should appear in that order
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns "BLOCK 0/7: structure" when gate section is null and structure finding exists', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'structure', severity: 'block', message: 'missing gate section', source: 'validator' }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns "WARN 7/7" when there are only warning findings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'no numbers', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'no numbers', source: 'validator' },
+        { checkId: 'bias', severity: 'warn', message: 'limited testing', source: 'agent' }
+      ],
+      gateSection: 'some content'
+    };
+    // Warnings don't count as blocks, so all 7 are answered
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns "PASS 0/7" when no gate section and no structure finding', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: null,
+      findings: [],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('PASS 0/7');
+  });
+
+  it('preserves GATE_CHECKS order when multiple blocks exist', () => {
+    // Testing that transparency comes after evaluation and other checks
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'missing incident path', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'missing justification', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'missing metrics', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    // GATE_CHECKS order: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency
+    // So they should appear as: risk-tier, evaluation, transparency
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('mixes block and warn findings correctly', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'missing threshold', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'no numbers', source: 'validator' },
+        { checkId: 'transparency', severity: 'warn', message: 'limited info', source: 'agent' }
+      ],
+      gateSection: 'some content'
+    };
+    // Only block findings count: evaluation
+    // answered = 7 - 1 = 6
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('handles all seven checks with block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'missing', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe(
+      'BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency'
+    );
+  });
+
+  it('deduplicates block findings from the same check (e.g. agent + validator)', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'validator finding', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'agent finding', source: 'agent' }
+      ],
+      gateSection: 'some content'
+    };
+    // Even though there are two findings for evaluation, it should appear only once
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('handles multiple warnings on the same check', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'first warning', source: 'validator' },
+        { checkId: 'evaluation', severity: 'warn', message: 'second warning', source: 'agent' }
+      ],
+      gateSection: 'some content'
+    };
+    // Warnings don't reduce answered count
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('does not include verdict icon in output', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some content'
+    };
+    const summary = renderSummary(result);
+    expect(summary).not.toContain('✅');
+    expect(summary).not.toContain('⚠️');
+    expect(summary).not.toContain('⛔');
+  });
+
+  it('handles structure finding with warn severity (non-block)', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'structure', severity: 'warn', message: 'missing or incomplete gate section', source: 'validator' }
+      ],
+      gateSection: null
+    };
+    // Should not return special BLOCK 0/7 case, since structure severity is warn not block
+    expect(renderSummary(result)).toBe('WARN 0/7');
+  });
+
+  it('handles blockCheckIds exceeding 7 items (defensive)', () => {
+    // Create a result with many block findings (simulating validator returning many unique checkIds)
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'missing', source: 'validator' },
+        { checkId: 'unknown-check', severity: 'block', message: 'unknown', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    // answered = Math.max(0, 7 - 8) = 0
+    const summary = renderSummary(result);
+    expect(summary.startsWith('BLOCK 0/7')).toBe(true);
+    expect(summary).not.toMatch(/-\d/); // No negative numbers
+  });
+});
