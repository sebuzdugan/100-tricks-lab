-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,31 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // Special case: if gate section is missing and structure finding blocks
+  const structureFind = result.findings.find((f) => f.checkId === 'structure' && f.severity === 'block');
+  if (result.gateSection === null && structureFind) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Get all block findings' check IDs
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  // Count answered checks: if gate section is null, 0 answered; otherwise 7 - block_count
+  const answered = result.gateSection === null ? 0 : Math.max(0, 7 - blockCheckIds.size);
+
+  // Order block check IDs by GATE_CHECKS order
+  const orderedBlockIds = GATE_CHECKS.filter((check) =>
+    blockCheckIds.has(check.id)
+  ).map((check) => check.id);
+
+  // Format the summary line
+  const blocksPart = orderedBlockIds.length > 0 ? `: ${orderedBlockIds.join(', ')}` : '';
+  return `${result.verdict} ${answered}/7${blocksPart}`;
+}
