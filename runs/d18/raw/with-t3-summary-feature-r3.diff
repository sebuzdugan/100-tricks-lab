+
+export function renderSummary(result: GateResult): string {
+  const TOTAL = GATE_CHECKS.length;
+
+  // Special case: missing gate section
+  if (result.gateSection == null) {
+    return `BLOCK 0/${TOTAL}: structure`;
+  }
+
+  // Get unique check IDs with block-severity findings, in GATE_CHECKS order
+  // Warnings do not reduce answered count, only blocks do
+  const findings = result.findings || [];
+  const blockCheckIds = new Set(
+    findings.filter((f) => f.severity === 'block').map((f) => f.checkId)
+  );
+  const blockedCheckIds: string[] = [];
+
+  for (const check of GATE_CHECKS) {
+    if (blockCheckIds.has(check.id)) {
+      blockedCheckIds.push(check.id);
+    }
+  }
+
+  // Calculate answered count (checks with no block findings)
+  const answered = TOTAL - blockedCheckIds.length;
+
+  // Format output
+  const verdict = result.verdict || 'UNKNOWN';
+  if (blockedCheckIds.length === 0) {
+    return `${verdict} ${answered}/${TOTAL}`;
+  } else {
+    return `${verdict} ${answered}/${TOTAL}: ${blockedCheckIds.join(', ')}`;
+  }
+}
