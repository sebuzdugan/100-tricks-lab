+function parseThresholds(thresholdStrings: string[] | undefined, availableMetricIds: string[]): { thresholds: Record<string, number>; exitCode: number } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {}, exitCode: 0 };
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error('Malformed threshold: expected <metric>=<number>', { threshold: thresholdStr });
+      return { thresholds: {}, exitCode: 2 };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error('Invalid threshold value: must be a number between 0 and 1', { threshold: thresholdStr, value: minStr });
+      return { thresholds: {}, exitCode: 2 };
+    }
+
+    if (!availableMetricIds.includes(metricId)) {
+      log.error('Unknown metric id', { metric: metricId, validMetrics: availableMetricIds });
+      return { thresholds: {}, exitCode: 2 };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, exitCode: 0 };
+}
