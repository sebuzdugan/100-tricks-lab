+export function validateThresholds(thresholds = {}, evaluations = []) {
+  const metricIds = evaluations.map((e) => e.id);
+  const errors = [];
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (!metricIds.includes(metric)) {
+      errors.push(`Unknown metric id: ${metric}. Valid ids: ${metricIds.join(', ')}`);
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`Threshold for ${metric} must be a number between 0 and 1, got ${min}`);
+    }
+  }
+
+  if (errors.length > 0) {
+    return { valid: false, errors };
+  }
+  return { valid: true, errors: [] };
+}
+
+export function evaluateThresholds(thresholds = {}, evaluations = []) {
+  const results = [];
+  const metricMap = new Map(evaluations.map((e) => [e.id, e]));
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    const evaluation = metricMap.get(metric);
+    const score = evaluation?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    results.push({
+      metric,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return results;
+}
