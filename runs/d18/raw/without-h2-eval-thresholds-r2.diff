+function parseThresholds(thresholdStrings?: string[]) {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^(.+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: metric=0.9`);
+    }
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for ${metric}: ${valueStr}. Must be a number between 0 and 1`);
+    }
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
