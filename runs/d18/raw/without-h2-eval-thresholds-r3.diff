diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..69dac3f
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,74 @@
+export class ThresholdError extends Error {
+  constructor(message, code = 'THRESHOLD_ERROR') {
+    super(message);
+    this.name = 'ThresholdError';
+    this.code = code;
+  }
+}
+
+export function parseThreshold(thresholdStr) {
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    throw new ThresholdError(
+      `Malformed threshold "${thresholdStr}". Expected format: <metric>=<number>`,
+      'MALFORMED_THRESHOLD'
+    );
+  }
+
+  const [metricId, minStr] = parts;
+  const min = Number.parseFloat(minStr);
+
+  if (Number.isNaN(min)) {
+    throw new ThresholdError(
+      `Malformed threshold "${thresholdStr}": "${minStr}" is not a valid number`,
+      'MALFORMED_THRESHOLD'
+    );
+  }
+
+  if (min < 0 || min > 1) {
+    throw new ThresholdError(
+      `Malformed threshold "${thresholdStr}": minimum must be between 0 and 1, got ${min}`,
+      'MALFORMED_THRESHOLD'
+    );
+  }
+
+  return { metricId, min };
+}
+
+export function getAvailableMetricIds(evaluations) {
+  return evaluations.map((metric) => metric.id);
+}
+
+export function validateThresholds(thresholds, evaluations) {
+  const metricsById = {};
+  evaluations.forEach((metric) => {
+    metricsById[metric.id] = metric;
+  });
+
+  const results = thresholds.map(({ metricId, min }) => {
+    const metric = metricsById[metricId];
+    if (!metric) {
+      const availableIds = getAvailableMetricIds(evaluations);
+      throw new ThresholdError(
+        `Unknown metric id "${metricId}". Valid metric ids: ${availableIds.join(', ')}`,
+        'UNKNOWN_METRIC'
+      );
+    }
+
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+
+    return {
+      metric: metricId,
+      min,
+      score: score ?? null,
+      passed
+    };
+  });
+
+  return results;
+}
+
+export function didAllThresholdsPassed(thresholdResults) {
+  return thresholdResults.every((result) => result.passed);
+}
diff --git a/packages/frai-core/src/eval/thresholds.test.js b/packages/frai-core/src/eval/thresholds.test.js
new file mode 100644
index 0000000..2c7abb2
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.test.js
@@ -0,0 +1,160 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  didAllThresholdsPassed,
+  getAvailableMetricIds,
+  parseThreshold,
+  ThresholdError,
+  validateThresholds
+} from './thresholds.js';
+
+describe('Threshold parsing', () => {
+  it('parses valid threshold string', () => {
+    const result = parseThreshold('exact_match=0.9');
+    expect(result).toEqual({ metricId: 'exact_match', min: 0.9 });
+  });
+
+  it('parses threshold with value 0', () => {
+    const result = parseThreshold('toxicity=0');
+    expect(result).toEqual({ metricId: 'toxicity', min: 0 });
+  });
+
+  it('parses threshold with value 1', () => {
+    const result = parseThreshold('length_variance=1');
+    expect(result).toEqual({ metricId: 'length_variance', min: 1 });
+  });
+
+  it('rejects malformed threshold without equals', () => {
+    expect(() => parseThreshold('exact_match')).toThrow(ThresholdError);
+  });
+
+  it('rejects malformed threshold with non-numeric min', () => {
+    const error = expect(() => parseThreshold('exact_match=abc')).toThrow(ThresholdError);
+  });
+
+  it('rejects threshold with min < 0', () => {
+    expect(() => parseThreshold('exact_match=-0.1')).toThrow(ThresholdError);
+  });
+
+  it('rejects threshold with min > 1', () => {
+    expect(() => parseThreshold('exact_match=1.1')).toThrow(ThresholdError);
+  });
+
+  it('accepts any metric id in format (validation deferred to runtime)', () => {
+    const result = parseThreshold('custom_metric=0.5');
+    expect(result).toEqual({ metricId: 'custom_metric', min: 0.5 });
+  });
+});
+
+describe('Available metric IDs', () => {
+  it('extracts available metric IDs from evaluations', () => {
+    const evaluations = [
+      { id: 'exact_match', score: 0.95 },
+      { id: 'toxicity', score: 1.0 },
+      { id: 'custom_metric', score: 0.5 }
+    ];
+    const available = getAvailableMetricIds(evaluations);
+    expect(available).toEqual(['exact_match', 'toxicity', 'custom_metric']);
+  });
+});
+
+describe('Threshold validation', () => {
+  it('validates passing thresholds', () => {
+    const evaluations = [
+      { id: 'exact_match', score: 0.95 },
+      { id: 'toxicity', score: 1.0 }
+    ];
+    const thresholds = [
+      { metricId: 'exact_match', min: 0.9 },
+      { metricId: 'toxicity', min: 0.99 }
+    ];
+    const results = validateThresholds(thresholds, evaluations);
+    expect(results).toEqual([
+      { metric: 'exact_match', min: 0.9, score: 0.95, passed: true },
+      { metric: 'toxicity', min: 0.99, score: 1.0, passed: true }
+    ]);
+  });
+
+  it('validates failing thresholds', () => {
+    const evaluations = [
+      { id: 'exact_match', score: 0.5 }
+    ];
+    const thresholds = [
+      { metricId: 'exact_match', min: 0.9 }
+    ];
+    const results = validateThresholds(thresholds, evaluations);
+    expect(results).toEqual([
+      { metric: 'exact_match', min: 0.9, score: 0.5, passed: false }
+    ]);
+  });
+
+  it('fails threshold when score is null', () => {
+    const evaluations = [
+      { id: 'exact_match', score: null }
+    ];
+    const thresholds = [
+      { metricId: 'exact_match', min: 0.5 }
+    ];
+    const results = validateThresholds(thresholds, evaluations);
+    expect(results).toEqual([
+      { metric: 'exact_match', min: 0.5, score: null, passed: false }
+    ]);
+  });
+
+  it('throws error when threshold references non-evaluated metric', () => {
+    const evaluations = [
+      { id: 'exact_match', score: 0.95 }
+    ];
+    const thresholds = [
+      { metricId: 'toxicity', min: 0.9 }
+    ];
+    const error = expect(() => validateThresholds(thresholds, evaluations)).toThrow(ThresholdError);
+    expect(() => validateThresholds(thresholds, evaluations)).toThrow(/exact_match/);
+  });
+
+  it('supports custom metrics', () => {
+    const evaluations = [
+      { id: 'custom_metric', score: 0.85 }
+    ];
+    const thresholds = [
+      { metricId: 'custom_metric', min: 0.8 }
+    ];
+    const results = validateThresholds(thresholds, evaluations);
+    expect(results).toEqual([
+      { metric: 'custom_metric', min: 0.8, score: 0.85, passed: true }
+    ]);
+  });
+
+  it('includes available metric IDs in error message', () => {
+    const evaluations = [
+      { id: 'exact_match', score: 0.95 },
+      { id: 'toxicity', score: 1.0 }
+    ];
+    const thresholds = [
+      { metricId: 'unknown', min: 0.9 }
+    ];
+    expect(() => validateThresholds(thresholds, evaluations)).toThrow(/exact_match.*toxicity/);
+  });
+});
+
+describe('All thresholds passed check', () => {
+  it('returns true when all thresholds passed', () => {
+    const results = [
+      { metric: 'exact_match', min: 0.9, score: 0.95, passed: true },
+      { metric: 'toxicity', min: 0.99, score: 1.0, passed: true }
+    ];
+    expect(didAllThresholdsPassed(results)).toBe(true);
+  });
+
+  it('returns false when any threshold failed', () => {
+    const results = [
+      { metric: 'exact_match', min: 0.9, score: 0.95, passed: true },
+      { metric: 'toxicity', min: 0.99, score: 0.5, passed: false }
+    ];
+    expect(didAllThresholdsPassed(results)).toBe(false);
+  });
+
+  it('returns true for empty list', () => {
+    expect(didAllThresholdsPassed([])).toBe(true);
+  });
+});
