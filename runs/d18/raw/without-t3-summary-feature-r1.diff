+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,38 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  // If gate section is missing (structure finding), return BLOCK 0/7: structure
+  const structureFinding = result.findings.find((f) => f.checkId === 'structure');
+  if (structureFinding) {
+    return `BLOCK 0/${total}: structure`;
+  }
+
+  // Count checks with block findings
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  // answered = checks without block findings
+  const answered = total - blockCheckIds.size;
+
+  // Build the summary
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // Append block check IDs in GATE_CHECKS order if there are any
+  if (blockCheckIds.size > 0) {
+    const blockIds = GATE_CHECKS
+      .filter((check) => blockCheckIds.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockIds}`;
+  }
+
+  return summary;
+}
