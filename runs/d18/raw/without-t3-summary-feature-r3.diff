@@ -0,0 +1,139 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import type { GateResult, Finding } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7 when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with count when there are warnings', () => {
+    const findings: Finding[] = [
+      {
+        checkId: 'evaluation',
+        severity: 'warn',
+        message: 'No numbers in evaluation plan',
+        source: 'validator'
+      }
+    ];
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings,
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with check IDs when there are blocking findings', () => {
+    const findings: Finding[] = [
+      {
+        checkId: 'evaluation',
+        severity: 'block',
+        message: 'Missing evaluation plan',
+        source: 'validator'
+      },
+      {
+        checkId: 'transparency',
+        severity: 'block',
+        message: 'Missing transparency plan',
+        source: 'validator'
+      }
+    ];
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings,
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists blocking check IDs in GATE_CHECKS order', () => {
+    const findings: Finding[] = [
+      {
+        checkId: 'transparency',
+        severity: 'block',
+        message: 'Missing transparency plan',
+        source: 'validator'
+      },
+      {
+        checkId: 'bias',
+        severity: 'block',
+        message: 'Missing bias plan',
+        source: 'validator'
+      },
+      {
+        checkId: 'data-privacy',
+        severity: 'block',
+        message: 'Missing data plan',
+        source: 'validator'
+      }
+    ];
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings,
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, bias, transparency');
+  });
+
+  it('ignores warnings when counting blocking findings', () => {
+    const findings: Finding[] = [
+      {
+        checkId: 'evaluation',
+        severity: 'block',
+        message: 'Missing evaluation plan',
+        source: 'validator'
+      },
+      {
+        checkId: 'monitoring',
+        severity: 'warn',
+        message: 'Weak monitoring',
+        source: 'validator'
+      }
+    ];
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings,
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('handles a single blocking finding', () => {
+    const findings: Finding[] = [
+      {
+        checkId: 'risk-tier',
+        severity: 'block',
+        message: 'Missing risk tier',
+        source: 'validator'
+      }
+    ];
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings,
+      gateSection: '## FRAI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+});
