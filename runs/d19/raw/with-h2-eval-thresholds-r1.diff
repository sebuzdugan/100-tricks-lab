+function parseThresholds(thresholdArgs?: string | string[]): Record<string, number> | null {
+  if (!thresholdArgs) return null;
+
+  const args = Array.isArray(thresholdArgs) ? thresholdArgs : [thresholdArgs];
+  if (args.length === 0) return null;
+
+  const result: Record<string, number> = {};
+  for (const arg of args) {
+    const match = arg.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${arg}`);
+      log.error('Thresholds must be in the format: metric=<number>');
+      process.exit(2);
+    }
+    const [, metric, valueStr] = match;
+    const value = Number(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for ${metric}: ${valueStr}`);
+      log.error('Threshold values must be between 0 and 1');
+      process.exit(2);
+    }
+    result[metric] = value;
+  }
+  return result;
+}
