+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${threshStr}`, {
+        expected: '<metric>=<number>'
+      });
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const value = parseFloat(match[2]);
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value: ${match[2]}`, {
+        expected: 'a number between 0 and 1'
+      });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
