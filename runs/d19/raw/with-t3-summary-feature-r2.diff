+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,94 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import type { GateResult, Finding } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS when all checks are answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN when only warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Missing numbers',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with blocking check ids', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'No gate found', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'bias', severity: 'warn', message: 'Weak answer', source: 'validator' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('preserves GATE_CHECKS order in output', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, transparency');
+  });
+
+  it('handles multiple block findings for same check (deduplicates)', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing dataset', source: 'agent' }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
diff --git a/packages/frai-gate/src/gate/report.ts b/packages/frai-gate/src/gate/report.ts
index d83a05a..6369a66 100644
--- a/packages/frai-gate/src/gate/report.ts
+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,28 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (result.verdict === 'BLOCK' && result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockingCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockingCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - blockingCheckIds.size;
+  const summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  if (blockingCheckIds.size > 0) {
+    const blockedIds = GATE_CHECKS.filter((check) => blockingCheckIds.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    return `${summary}: ${blockedIds}`;
+  }
+
+  return summary;
+}
