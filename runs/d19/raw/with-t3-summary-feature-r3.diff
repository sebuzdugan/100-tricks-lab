+export function renderSummary(result: GateResult): string {
+  const structureIssue = result.findings.find((f) => f.checkId === 'structure');
+  if (structureIssue) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - blockCheckIds.size;
+  const summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  if (blockCheckIds.size === 0) {
+    return summary;
+  }
+
+  const orderedBlockIds = GATE_CHECKS.map((check) => check.id).filter((id) => blockCheckIds.has(id));
+  return `${summary}: ${orderedBlockIds.join(', ')}`;
+}
+
 export function renderText(result: GateResult, specPath: string): string {
   const out: string[] = [];
   out.push(`FRAI Gate - ${specPath}`);
