+function parseThresholds(thresholdStrings: string[] | undefined): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [key: string]: number } = {};
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${threshStr}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minValue = Number(match[2]);
+
+    if (isNaN(minValue) || minValue < 0 || minValue > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${minValue}. Must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
