+function parseThreshold(thresholdStr: string): { metric: string; min: number } {
+  const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+  if (!match) {
+    throw new Error(`Invalid threshold format: "${thresholdStr}". Expected format: metric=value (e.g., exact_match=0.9)`);
+  }
+  const [, metric, valueStr] = match;
+  const value = Number.parseFloat(valueStr);
+  if (Number.isNaN(value) || value < 0 || value > 1) {
+    throw new Error(`Invalid threshold value: "${valueStr}". Must be a number between 0 and 1.`);
+  }
+  return { metric, min: value };
+}
+
+function validateThresholdMetrics(thresholds: Array<{ metric: string; min: number }>, evaluations: unknown[]) {
+  const evaluationsList = evaluations as Array<{ id: string }>;
+  const validMetricIds = evaluationsList.map((m) => m.id);
+  for (const threshold of thresholds) {
+    if (!validMetricIds.includes(threshold.metric)) {
+      throw new Error(
+        `Unknown metric: "${threshold.metric}". Valid metric ids are: ${validMetricIds.join(', ')}`
+      );
+    }
+  }
+}
