+function parseThresholds(thresholdStrings: string[] = []): { thresholds: Record<string, number>; errors: string[] } {
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  thresholdStrings.forEach((thresholdStr) => {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${thresholdStr}". Expected format: metric=number (e.g., exact_match=0.9)`);
+      return;
+    }
+
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      errors.push(`Invalid threshold value: "${valueStr}" for metric "${metric}". Must be a number between 0 and 1.`);
+      return;
+    }
+
+    thresholds[metric] = value;
+  });
+
+  return { thresholds, errors };
+}
