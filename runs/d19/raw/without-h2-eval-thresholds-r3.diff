+// Quick verification of threshold feature in frai-core
+import { Eval } from './packages/frai-core/src/eval/index.js';
+
+console.log('Testing threshold feature...\n');
+
+// Test 1: No thresholds
+console.log('Test 1: Report without thresholds');
+const evals1 = Eval.runEvaluations({
+  outputs: ['Hello', 'World'],
+  references: ['hello', 'world']
+});
+const report1 = Eval.generateReport({
+  evaluations: evals1,
+  outputsPath: '/tmp/outputs.json',
+  referencesPath: '/tmp/refs.json'
+});
+console.log('  passed:', report1.passed);
+console.log('  thresholds length:', report1.thresholds.length);
+console.log('  ✓ Passed\n');
+
+// Test 2: Thresholds that pass
+console.log('Test 2: Thresholds that all pass');
+const report2 = Eval.generateReport({
+  evaluations: evals1,
+  outputsPath: '/tmp/outputs.json',
+  referencesPath: '/tmp/refs.json',
+  thresholds: { exact_match: 0.5, toxicity: 0.8 }
+});
+console.log('  passed:', report2.passed);
+console.log('  thresholds:', JSON.stringify(report2.thresholds, null, 2));
+if (report2.passed && report2.thresholds.length === 2) {
+  console.log('  ✓ Passed\n');
+} else {
+  console.log('  ✗ FAILED\n');
+  process.exit(1);
+}
+
+// Test 3: Thresholds with a failure
+console.log('Test 3: Thresholds with one failure');
+const report3 = Eval.generateReport({
+  evaluations: evals1,
+  outputsPath: '/tmp/outputs.json',
+  referencesPath: '/tmp/refs.json',
+  thresholds: { exact_match: 0.99, toxicity: 0.5 }
+});
+console.log('  passed:', report3.passed);
+console.log('  thresholds:');
+report3.thresholds.forEach(t => {
+  console.log(`    - ${t.metric}: score=${t.score}, min=${t.min}, passed=${t.passed}`);
+});
+if (!report3.passed && !report3.thresholds[0].passed) {
+  console.log('  ✓ Passed\n');
+} else {
+  console.log('  ✗ FAILED\n');
+  process.exit(1);
+}
+
+// Test 4: Threshold with missing score
+console.log('Test 4: Threshold with missing score (no references)');
+const evals4 = Eval.runEvaluations({
+  outputs: ['Hello'],
+  references: []
+});
+const report4 = Eval.generateReport({
+  evaluations: evals4,
+  outputsPath: '/tmp/outputs.json',
+  referencesPath: null,
+  thresholds: { exact_match: 0.5 }
+});
+console.log('  passed:', report4.passed);
+console.log('  threshold:', JSON.stringify(report4.thresholds[0], null, 2));
+if (!report4.passed && report4.thresholds[0].score === null && !report4.thresholds[0].passed) {
+  console.log('  ✓ Passed\n');
+} else {
+  console.log('  ✗ FAILED\n');
+  process.exit(1);
+}
+
+console.log('✓ All tests passed!');
