@@ -0,0 +1,177 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, GATE_CHECKS } from './schema.js';
+
+function createResult(overrides: Partial<GateResult> = {}): GateResult {
+  return {
+    verdict: 'PASS',
+    tier: 'limited',
+    findings: [],
+    gateSection: '### FRAI Gate\nContent here',
+    ...overrides
+  };
+}
+
+describe('renderSummary', () => {
+  it('formats PASS with all checks answered', () => {
+    const result = createResult({
+      verdict: 'PASS',
+      findings: []
+    });
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('formats WARN with all checks answered', () => {
+    const result = createResult({
+      verdict: 'WARN',
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'warn',
+          message: 'Test warning',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('formats BLOCK with blocking findings', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists blocking checks in GATE_CHECKS order', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('excludes warnings from block count', () => {
+    const result = createResult({
+      verdict: 'WARN',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Could be better',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'warn',
+          message: 'Could be better',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('handles mixed warnings and blocks', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'warn',
+          message: 'Could be better',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('handles missing gate section', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      gateSection: null,
+      findings: []
+    });
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores findings for non-GATE_CHECKS', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'unknown-check',
+          severity: 'block',
+          message: 'This should be ignored',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 7/7');
+  });
+
+  it('counts duplicate block findings only once', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing thresholds',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing dataset',
+          source: 'agent'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('uses correct total from GATE_CHECKS', () => {
+    expect(GATE_CHECKS).toHaveLength(7);
+    const result = createResult({
+      verdict: 'PASS',
+      findings: []
+    });
+    const summary = renderSummary(result);
+    expect(summary).toContain('/7');
+  });
+});
