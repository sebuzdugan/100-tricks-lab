+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS with all 7 checks answered when no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '...'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with checks answered when only warn findings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers in eval plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: '...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Missing FRAI Gate section',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns BLOCK with reduced answered count when there are block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'No incident response plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: '...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists block findings in GATE_CHECKS order, not finding order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'No incident response',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing eval plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: '...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('counts each check only once even with multiple findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing metrics',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Low precision eval',
+          source: 'agent'
+        }
+      ],
+      gateSection: '...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores warn findings when counting blocks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Low precision eval',
+          source: 'agent'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'Could use more metrics',
+          source: 'agent'
+        }
+      ],
+      gateSection: '...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('handles mixed block and warn findings correctly', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Prohibited tier',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Low precision eval',
+          source: 'agent'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'No retention policy',
+          source: 'validator'
+        }
+      ],
+      gateSection: '...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, data-privacy');
+  });
+});
