--- /dev/null
+++ b/packages/frai-cli/src/threshold-utils.ts
@@ -0,0 +1,32 @@
+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+export function parseThreshold(thresholdStr: string): { metric: string; min: number } {
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    throw new Error(`Invalid threshold format: ${thresholdStr}. Expected <metric>=<number>`);
+  }
+  const [metric, minStr] = parts;
+  const min = Number.parseFloat(minStr);
+  if (Number.isNaN(min) || min < 0 || min > 1) {
+    throw new Error(`Invalid threshold value: ${minStr}. Must be a number between 0 and 1`);
+  }
+  if (!VALID_METRIC_IDS.includes(metric)) {
+    throw new Error(`Unknown metric: ${metric}. Valid metrics: ${VALID_METRIC_IDS.join(', ')}`);
+  }
+  return { metric, min };
+}
+
+export function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | undefined {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const { metric, min } = parseThreshold(thresholdStr);
+    thresholds[metric] = min;
+  }
+  return thresholds;
+}
+
+export { VALID_METRIC_IDS };
