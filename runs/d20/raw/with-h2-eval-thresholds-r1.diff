+describe('Threshold parsing', () => {
+  describe('parseThreshold', () => {
+    it('parses valid threshold strings', () => {
+      const result = parseThreshold('exact_match=0.9');
+      expect(result.metric).toBe('exact_match');
+      expect(result.min).toBe(0.9);
+    });
+
+    it('handles zero threshold', () => {
+      const result = parseThreshold('toxicity=0');
+      expect(result.metric).toBe('toxicity');
+      expect(result.min).toBe(0);
+    });
+
+    it('handles 1.0 threshold', () => {
+      const result = parseThreshold('length_variance=1.0');
+      expect(result.metric).toBe('length_variance');
+      expect(result.min).toBe(1.0);
+    });
+
+    it('throws on missing equals sign', () => {
+      expect(() => parseThreshold('exact_match0.9')).toThrow(
+        'Invalid threshold format: exact_match0.9. Expected <metric>=<number>'
+      );
+    });
+
+    it('throws on invalid number', () => {
+      expect(() => parseThreshold('exact_match=abc')).toThrow(
+        'Invalid threshold value: abc. Must be a number between 0 and 1'
+      );
+    });
+
+    it('throws on number below 0', () => {
+      expect(() => parseThreshold('exact_match=-0.1')).toThrow(
+        'Invalid threshold value: -0.1. Must be a number between 0 and 1'
+      );
+    });
+
+    it('throws on number above 1', () => {
+      expect(() => parseThreshold('exact_match=1.1')).toThrow(
+        'Invalid threshold value: 1.1. Must be a number between 0 and 1'
+      );
+    });
+
+    it('throws on unknown metric', () => {
+      expect(() => parseThreshold('unknown_metric=0.5')).toThrow(
+        'Unknown metric: unknown_metric. Valid metrics: exact_match, toxicity, length_variance'
+      );
+    });
+  });
+
+  describe('parseThresholds', () => {
+    it('returns undefined for empty input', () => {
+      expect(parseThresholds(undefined)).toBeUndefined();
+      expect(parseThresholds([])).toBeUndefined();
+    });
+
+    it('parses single threshold', () => {
+      const result = parseThresholds(['exact_match=0.8']);
+      expect(result).toEqual({ exact_match: 0.8 });
+    });
+
+    it('parses multiple thresholds', () => {
+      const result = parseThresholds(['exact_match=0.8', 'toxicity=0.9']);
+      expect(result).toEqual({ exact_match: 0.8, toxicity: 0.9 });
+    });
+
+    it('propagates parsing errors', () => {
+      expect(() => parseThresholds(['exact_match=1.5'])).toThrow(
+        'Invalid threshold value: 1.5. Must be a number between 0 and 1'
+      );
+    });
+  });
+
+  describe('VALID_METRIC_IDS', () => {
+    it('contains expected metrics', () => {
+      expect(VALID_METRIC_IDS).toContain('exact_match');
+      expect(VALID_METRIC_IDS).toContain('toxicity');
+      expect(VALID_METRIC_IDS).toContain('length_variance');
+    });
+  });
+});
