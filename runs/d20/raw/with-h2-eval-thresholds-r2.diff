@@ -13,6 +13,49 @@ const defaultFs = fs;
 
 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+export function parseThresholds(thresholdStrings) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const result = {};
+  const validMetricIds = new Set(['exact_match', 'toxicity', 'length_variance']);
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min)) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Minimum value must be a number.`);
+    }
+
+    if (min < 0 || min > 1) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Minimum value must be between 0 and 1.`);
+    }
+
+    if (!validMetricIds.has(metricId)) {
+      throw new Error(`Unknown metric: "${metricId}". Valid metrics are: ${Array.from(validMetricIds).sort().join(', ')}`);
+    }
+
+    result[metricId] = min;
+  }
+
+  return result;
+}
+
+export class ThresholdError extends Error {
+  constructor(message, validMetrics) {
+    super(message);
+    this.name = 'ThresholdError';
+    this.validMetrics = validMetrics;
+  }
+}
