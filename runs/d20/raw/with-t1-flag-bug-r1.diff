+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import fs from 'fs';
+import path from 'path';
+import { execSync } from 'child_process';
+import os from 'os';
+
+describe('frai gate command', () => {
+  let testDir: string;
+
+  beforeEach(() => {
+    testDir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-test-'));
+  });
+
+  afterEach(() => {
+    if (fs.existsSync(testDir)) {
+      fs.rmSync(testDir, { recursive: true });
+    }
+  });
+
+  it('should create FRAI-SPEC.md and .github/workflows/rai-gate.yml when --ci flag is passed', () => {
+    const cliPath = path.resolve(__dirname, '../dist/index.js');
+
+    // Run: frai gate init --ci
+    execSync(`node ${cliPath} gate init --ci`, {
+      cwd: testDir,
+      stdio: 'pipe'
+    });
+
+    const specFile = path.join(testDir, 'FRAI-SPEC.md');
+    const workflowFile = path.join(testDir, '.github/workflows/rai-gate.yml');
+
+    expect(fs.existsSync(specFile)).toBe(true);
+    expect(fs.existsSync(workflowFile)).toBe(true);
+
+    // Verify content exists
+    const specContent = fs.readFileSync(specFile, 'utf8');
+    expect(specContent).toContain('FRAI Gate');
+
+    const workflowContent = fs.readFileSync(workflowFile, 'utf8');
+    expect(workflowContent).toContain('Responsible AI Gate');
+  });
+
+  it('should create FRAI-SPEC.md but not .github/workflows/rai-gate.yml without --ci flag', () => {
+    const cliPath = path.resolve(__dirname, '../dist/index.js');
+
+    // Run: frai gate init (without --ci)
+    execSync(`node ${cliPath} gate init`, {
+      cwd: testDir,
+      stdio: 'pipe'
+    });
+
+    const specFile = path.join(testDir, 'FRAI-SPEC.md');
+    const workflowFile = path.join(testDir, '.github/workflows/rai-gate.yml');
+
+    expect(fs.existsSync(specFile)).toBe(true);
+    expect(fs.existsSync(workflowFile)).toBe(false);
+  });
+});
