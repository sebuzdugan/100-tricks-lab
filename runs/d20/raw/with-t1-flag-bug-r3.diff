+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import fs from 'fs';
+import path from 'path';
+import os from 'os';
+import { execSync } from 'child_process';
+
+describe('frai gate init --ci', () => {
+  let tmpDir: string;
+
+  beforeEach(() => {
+    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-test-'));
+  });
+
+  afterEach(() => {
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+  });
+
+  it('should create both FRAI-SPEC.md and .github/workflows/rai-gate.yml with --ci flag', () => {
+    const cliPath = path.resolve(__dirname, '..', 'dist', 'index.js');
+
+    // Run frai gate init --ci
+    execSync(`node ${cliPath} gate init --ci`, {
+      cwd: tmpDir,
+      stdio: 'inherit'
+    });
+
+    // Check that FRAI-SPEC.md was created
+    const specPath = path.join(tmpDir, 'FRAI-SPEC.md');
+    expect(fs.existsSync(specPath)).toBe(true);
+    const specContent = fs.readFileSync(specPath, 'utf8');
+    expect(specContent.length).toBeGreaterThan(0);
+
+    // Check that .github/workflows/rai-gate.yml was created
+    const workflowPath = path.join(tmpDir, '.github', 'workflows', 'rai-gate.yml');
+    expect(fs.existsSync(workflowPath)).toBe(true);
+    const workflowContent = fs.readFileSync(workflowPath, 'utf8');
+    expect(workflowContent).toContain('frai-gate check FRAI-SPEC.md');
+  });
+});
