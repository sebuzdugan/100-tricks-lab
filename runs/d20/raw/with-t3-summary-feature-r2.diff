@@ -0,0 +1,119 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 when all checks are answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'structure', severity: 'block', message: 'Missing gate section', source: 'validator' }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns BLOCK X/7 with block findings listed', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'No disclosure plan', source: 'validator' }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('counts answered checks correctly (7 - number of block findings)', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing tier', source: 'validator' }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('ignores warn findings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'No numbers in eval plan', source: 'validator' }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('lists block findings in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing disclosure', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing tier', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing eval', source: 'validator' }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('lists each check id once even if multiple findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing metrics', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Numbers too low', source: 'agent' }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('lists all 7 gate checks in order for reference', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing PII info', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'Missing bias plan', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'No kill switch', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: 'Missing monitoring', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing tier', source: 'validator' }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 2/7: risk-tier, data-privacy, oversight, bias, monitoring');
+  });
+
+  it('returns WARN X/7 for WARN verdict', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Numbers could be higher', source: 'validator' }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+});
