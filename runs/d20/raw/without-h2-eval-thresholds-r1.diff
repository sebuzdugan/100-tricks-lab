+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const result: Record<string, number> = {};
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([^=]+)=([^=]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${threshStr}`);
+      log.error('Threshold format must be <metric>=<number>');
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid minimum value for ${metricId}: ${minStr}`);
+      log.error('Minimum must be a number between 0 and 1');
+      process.exit(2);
+    }
+
+    result[metricId] = min;
+  }
+  return result;
+}
