+function parseThresholds(thresholdStrings?: string | string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings) {
+    return thresholds;
+  }
+
+  const specs = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+
+  for (const str of specs) {
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: metric=number`);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+    if (!Number.isFinite(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for "${metricId}": ${valueStr}. Must be a number between 0 and 1.`);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
