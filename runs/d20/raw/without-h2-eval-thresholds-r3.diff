+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number>; validMetricIds: string[] } {
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds, validMetricIds };
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${thresholdStr}`);
+      log.error('Expected format: <metric>=<number> (e.g., exact_match=0.9)');
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (min < 0 || min > 1) {
+      log.error(`Invalid threshold minimum for ${metricId}: ${min}`);
+      log.error('Threshold minimum must be between 0 and 1.');
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`);
+      log.error(`Valid metrics are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, validMetricIds };
+}
