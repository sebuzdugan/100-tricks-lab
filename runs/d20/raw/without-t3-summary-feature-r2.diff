+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS with full answers when no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with correct answered count and no check ids', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Missing numbers', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with answered count and single block check id', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing field', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('returns BLOCK with multiple check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing numbers', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Empty section', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('includes only block findings, not warn findings, in check id list', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Missing numbers', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing field', source: 'validator' },
+        { checkId: 'transparency', severity: 'warn', message: 'Vague answer', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('handles structure finding as special case: returns BLOCK 0/7', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'No gate section', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('handles structure finding even with other findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'structure', severity: 'block', message: 'No gate section', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Also missing', source: 'validator' }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('lists each check id only once even with multiple findings per check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing numbers', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Also vague', source: 'agent' }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
