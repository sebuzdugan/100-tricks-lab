@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,26 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const structureFinding = result.findings.find((f) => f.checkId === 'structure');
+  if (structureFinding) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+  const answered = GATE_CHECKS.length - new Set(blockFindings.map((f) => f.checkId)).size;
+  const total = GATE_CHECKS.length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockFindings.length > 0) {
+    const blockCheckIds = new Set(blockFindings.map((f) => f.checkId));
+    const sortedCheckIds = GATE_CHECKS.filter((check) => blockCheckIds.has(check.id)).map(
+      (check) => check.id
+    );
+    summary += ': ' + sortedCheckIds.join(', ');
+  }
+
+  return summary;
+}
