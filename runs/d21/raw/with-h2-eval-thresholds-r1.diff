+function parseThresholds(thresholdStrs: string[] | undefined): { [key: string]: number } | null {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [key: string]: number } = {};
+  for (const thresholdStr of thresholdStrs) {
+    const match = thresholdStr.match(/^([^=]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}". Expected format: metric=number`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+    const min = parseFloat(minStr);
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for "${metricId}": ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
+
+function validateThresholds(thresholds: { [key: string]: number }, evaluations: any[]): boolean {
+  const validMetricIds = evaluations.map((metric) => metric.id);
+  const thresholdMetricIds = Object.keys(thresholds);
+
+  for (const metricId of thresholdMetricIds) {
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+  }
+
+  return true;
+}
