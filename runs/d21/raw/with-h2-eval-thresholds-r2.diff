+function validateThreshold(thresholdStr, validMetricIds) {
+  const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+  if (!match) {
+    return {
+      valid: false,
+      error: `Malformed threshold '${thresholdStr}': expected format <metric>=<number> (e.g., exact_match=0.9)`
+    };
+  }
+
+  const [, metricId, minStr] = match;
+  const min = parseFloat(minStr);
+
+  if (!validMetricIds.includes(metricId)) {
+    return {
+      valid: false,
+      error: `Unknown metric '${metricId}'. Valid metrics are: ${validMetricIds.join(', ')}`
+    };
+  }
+
+  if (Number.isNaN(min) || min < 0 || min > 1) {
+    return {
+      valid: false,
+      error: `Invalid threshold value for '${metricId}': ${minStr}. Must be a number between 0 and 1.`
+    };
+  }
+
+  return { valid: true, metricId, min };
+}
+
