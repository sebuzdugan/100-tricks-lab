@@ -151,6 +151,7 @@ Generate evaluation reports for model outputs.
 - `--references <file>` – JSON file with reference answers.
 - `--report <path>` – output location (`frai-eval-report.json` by default).
 - `--format <json|markdown>` – output format (defaults to JSON). Markdown reports include human-readable summaries for review boards.
+- `--threshold <metric>=<min>` *(repeatable)* – fail if a metric's score is below the minimum (e.g., `--threshold exact_match=0.9`). Thresholds are added to reports and block CI if any fails (exit 1). Unknown metrics or malformed thresholds exit 2. Examples: `frai eval --outputs out.json --threshold exact_match=0.8 --threshold toxicity=0.95`.
 
 ### `frai finetune`
 Fine-tuning governance helpers:
@@ -200,6 +201,63 @@ await fs.writeFile('scan-summary.json', JSON.stringify(scan, null, 2));
 await fs.writeFile('ai-context.txt', aiContext);
 ```
 
+Example: run evaluation with thresholds.
+
+```ts
+import { Eval } from 'frai-core';
+
+const dataset = Eval.loadDataset({
+  outputsPath: 'outputs.json',
+  referencesPath: 'references.json'
+});
+
+const evaluations = Eval.runEvaluations({
+  outputs: dataset.outputs,
+  references: dataset.references
+});
+
+const report = Eval.generateReport({
+  evaluations,
+  outputsPath: dataset.outputsPath,
+  referencesPath: dataset.referencesPath,
+  thresholds: ['exact_match=0.9', 'toxicity=0.95']  // Optional thresholds
+});
+
+const reportPath = Eval.writeReport({
+  report,
+  format: 'json'
+});
+
+// Check if all thresholds passed
+if (report.passed === false) {
+  console.log('Thresholds failed:', report.thresholds);
+  process.exit(1);
+}
+```
+
+Custom metrics are supported by passing an array to `runEvaluations`:
+
+```ts
+const myMetric = (outputs, references) => ({
+  id: 'my_metric',
+  label: 'My Custom Metric',
+  score: 0.95
+});
+
+const evaluations = Eval.runEvaluations({
+  outputs: dataset.outputs,
+  references: dataset.references,
+  metrics: [Eval.exactMatchMetric, myMetric]
+});
+
+const report = Eval.generateReport({
+  evaluations,
+  outputsPath: dataset.outputsPath,
+  referencesPath: dataset.referencesPath,
+  thresholds: ['my_metric=0.8']  // Works with custom metrics too
+});
+```
+
 Because `frai-core` is a regular ESM package, you can import only the modules you need and embed FRAI capabilities inside automation pipelines, CI jobs, or custom products.
 
