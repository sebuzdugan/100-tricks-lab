   };
+
+  if (thresholds && Array.isArray(thresholds) && thresholds.length > 0) {
+    const validMetricIds = evaluations.map((m) => m.id);
+    const thresholdResults = [];
+    let allPassed = true;
+
+    for (const thresholdStr of thresholds) {
+      const validation = validateThreshold(thresholdStr, validMetricIds);
+      if (!validation.valid) {
+        throw new Error(validation.error);
+      }
+
+      const { metricId, min } = validation;
+      const metric = evaluations.find((m) => m.id === metricId);
+      const score = metric?.score ?? null;
+      const passed = score !== null && score >= min;
+
+      if (!passed) {
+        allPassed = false;
+      }
+
+      thresholdResults.push({
+        metric: metricId,
+        min,
+        score,
+        passed
+      });
+    }
+
+    report.passed = allPassed;
+    report.thresholds = thresholdResults;
+  }
+
+  return report;
 }
 
