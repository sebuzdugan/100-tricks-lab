+function parseThresholds(thresholdStrings: string | string[] | undefined, validMetricIds: string[]) {
+  if (!thresholdStrings) {
+    return {};
+  }
+
+  const thresholdArray = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  const result: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdArray) {
+    const match = thresholdStr.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (min < 0 || min > 1) {
+      log.error(`Threshold minimum must be between 0 and 1, got: ${min}`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    result[metricId] = min;
+  }
+
+  return result;
+}
