+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No "## Responsible AI Gate" section found in the spec.',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'gate section'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN 7/7 when only warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'gate section'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with blocked check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('counts answered checks correctly with mixed block and warn findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Invalid tier',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'warn',
+          message: 'Warning only',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, evaluation');
+  });
+
+  it('includes all blocked checks in GATE_CHECKS order when multiple blocks exist', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Missing bias section',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data section',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, bias, transparency');
+  });
+
+  it('ignores non-gate-check findings when counting blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        },
+        {
+          checkId: 'some-other-check',
+          severity: 'block',
+          message: 'Some other block',
+          source: 'agent'
+        }
+      ],
+      gateSection: 'gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
