+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,35 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const TOTAL = GATE_CHECKS.length;
+
+  // Check for structure finding
+  const structureFinding = result.findings.find((f) => f.checkId === 'structure' && f.severity === 'block');
+  if (structureFinding) {
+    return `BLOCK 0/${TOTAL}: structure`;
+  }
+
+  // Count which checks have block findings
+  const blockedCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && GATE_CHECKS.some((c) => c.id === finding.checkId)) {
+      blockedCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered = TOTAL - blockedCheckIds.size;
+  const base = `${result.verdict} ${answered}/${TOTAL}`;
+
+  if (blockedCheckIds.size === 0) {
+    return base;
+  }
+
+  // Get the blocked check IDs in GATE_CHECKS order
+  const blockedInOrder = GATE_CHECKS
+    .filter((check) => blockedCheckIds.has(check.id))
+    .map((check) => check.id);
+
+  return `${base}: ${blockedInOrder.join(', ')}`;
+}
