+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No "## Responsible AI Gate" section found in the spec.',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN 7/7 when only warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('lists blocked checks in order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists each blocked check only once', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing field 1',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing field 2',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores warnings when counting blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing privacy',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('maintains GATE_CHECKS order for multiple blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'gate content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, bias, transparency');
+  });
+});
