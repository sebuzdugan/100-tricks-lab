+function parseThresholds(thresholdStrings: string[], evaluations: any[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = new Set(evaluations.map((e: any) => e.id));
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold minimum: "${minStr}". Must be a number between 0 and 1.`);
+    }
+
+    if (!validMetricIds.has(metricId)) {
+      const validIds = Array.from(validMetricIds).join(', ');
+      throw new Error(`Unknown metric id: "${metricId}". Valid metric ids are: ${validIds}`);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
