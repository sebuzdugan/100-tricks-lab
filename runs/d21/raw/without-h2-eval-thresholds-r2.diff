 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+export function parseThresholds(thresholdStrings = []) {
+  if (!Array.isArray(thresholdStrings)) {
+    throw new Error('Thresholds must be an array.');
+  }
+
+  const result = {};
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(
+        `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number> (e.g., exact_match=0.9)`
+      );
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (!VALID_METRIC_IDS.includes(metricId)) {
+      throw new Error(
+        `Unknown metric: "${metricId}". Valid metrics are: ${VALID_METRIC_IDS.join(', ')}`
+      );
+    }
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Threshold minimum must be a number between 0 and 1, got: ${minStr}`);
+    }
+
+    result[metricId] = min;
+  }
+
+  return result;
+}
