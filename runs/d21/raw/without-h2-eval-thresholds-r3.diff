+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const result: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error('Invalid threshold format. Expected --threshold <metric>=<number>', {
+        received: threshold
+      });
+      console.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      log.error('Threshold minimum must be a number between 0 and 1', {
+        received: minStr
+      });
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error('Unknown metric ID', {
+        received: metricId
+      });
+      console.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    result[metricId] = min;
+  }
+
+  return result;
+}
