+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,30 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+
+  // Special case: if gate section is missing (structure finding)
+  if (blockFindings.some((f) => f.checkId === 'structure')) {
+    return `BLOCK 0/7: structure`;
+  }
+
+  // Get unique check ids from block findings, in GATE_CHECKS order
+  const blockCheckIds = new Set(blockFindings.map((f) => f.checkId));
+  const orderedBlockIds = GATE_CHECKS.map((check) => check.id).filter((id) =>
+    blockCheckIds.has(id)
+  );
+
+  // Calculate answered = total checks - block findings
+  const answered = GATE_CHECKS.length - blockCheckIds.size;
+  const total = GATE_CHECKS.length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (orderedBlockIds.length > 0) {
+    summary += `: ${orderedBlockIds.join(', ')}`;
+  }
+
+  return summary;
+}
