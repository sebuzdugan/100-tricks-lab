+function parseThresholds(thresholdStrings?: string[]) {
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null, error: null };
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      return {
+        thresholds: null,
+        error: `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`,
+        validMetricIds
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        thresholds: null,
+        error: `Unknown metric id: "${metricId}". Valid metric ids: ${validMetricIds.join(', ')}`,
+        validMetricIds
+      };
+    }
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      return {
+        thresholds: null,
+        error: `Invalid minimum value: "${minStr}". Must be a number between 0 and 1`,
+        validMetricIds
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, error: null };
+}
