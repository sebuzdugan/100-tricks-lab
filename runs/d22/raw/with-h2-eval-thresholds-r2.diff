+function evaluateThresholds(evaluations, thresholds) {
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score !== undefined && score >= minScore;
