+/**
+ * Parses and validates threshold strings in format "metric=min_value".
+ * @param {string[]} thresholdStrings - Array of threshold strings like ["exact_match=0.9"]
+ * @param {string[]} validMetricIds - Array of valid metric IDs
+ * @returns {Object} Parsed thresholds object or null if invalid
+ */
+function parseAndValidateThresholds(thresholdStrings?: string[], validMetricIds: string[] = ['exact_match', 'toxicity', 'length_variance']) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold "${thresholdStr}": must be in format "metric=number"`);
+      continue;
+    }
+
+    const [, metricId, minStr] = match;
+    const minValue = Number.parseFloat(minStr);
+
+    if (Number.isNaN(minValue) || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold value for "${metricId}": ${minStr} must be a number between 0 and 1`);
+      continue;
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`);
+      continue;
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  if (errors.length > 0) {
+    log.error('Threshold validation failed:');
+    errors.forEach((error) => console.error(`  - ${error}`));
+    process.exit(2);
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
