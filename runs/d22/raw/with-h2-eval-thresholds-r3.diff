+/**
+ * Parses and validates threshold strings.
+ * @param thresholdStrings - Array of "metric=min" strings
+ * @returns Object mapping metric IDs to minimum scores, or throws
+ */
+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}" (expected format: <metric>=<number>)`);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold minimum for "${metricId}": ${minStr} (must be a number between 0 and 1)`);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      throw new Error(`Unknown metric id: "${metricId}" (valid options: ${validMetricIds.join(', ')})`);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
