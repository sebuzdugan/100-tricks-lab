+          severity: 'block',
+          message: 'Empty',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## FRAI Gate\n\n### 5.1 Risk tier\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, monitoring, transparency');
+  });
+
+  it('handles mixed block and warn findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Empty',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numbers',
+          source: 'validator'
