+/**
+ * Renders a one-line summary: `<VERDICT> <answered>/<total>` or `<VERDICT> <answered>/<total>: <block-ids>`.
+ * If gate section is missing, returns `BLOCK 0/7: structure`.
+ * @param result - the gate validation result
+ * @returns the summary line
+ */
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  // Gate section missing (structure error)
+  if (result.gateSection === null) {
+    return `BLOCK 0/${total}: structure`;
+  }
+
+  // Find check IDs that have block-severity findings
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  // Count answered checks: total minus those with block findings
+  const answered = total - blockCheckIds.size;
+
+  // Format the summary
+  let summary = `${result.verdict} ${answered}/${total}`;
+  if (blockCheckIds.size > 0) {
+    // Get block check IDs in GATE_CHECKS order
+    const orderedIds = GATE_CHECKS.map((c) => c.id).filter((id) => blockCheckIds.has(id));
+    summary += `: ${orderedIds.join(', ')}`;
+  }
+
+  return summary;
+}
