+/**
+ * Renders a one-line summary for CI logs.
+ * Format: `<VERDICT> <answered>/<total>` where total is 7 (GATE_CHECKS count)
+ * and answered is how many checks have no block-severity finding.
+ * If there are block findings, appends `: ` and check ids in GATE_CHECKS order.
+ * If the gate section is missing, returns `BLOCK 0/7: structure`.
+ * @param result - the GateResult to summarize
+ * @returns a one-line summary string
+ */
+export function renderSummary(result: GateResult): string {
+  // If there's a structure finding (missing gate section), return special case
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Collect check IDs that have block findings
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  // answered = total checks - number of checks with block findings
+  const total = GATE_CHECKS.length;
+  const answered = total - blockCheckIds.size;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // If there are blocks, append the block check ids in GATE_CHECKS order
+  if (blockCheckIds.size > 0) {
+    const blockIds = GATE_CHECKS.map((check) => check.id)
+      .filter((id) => blockCheckIds.has(id))
+      .join(', ');
+    summary += `: ${blockIds}`;
+  }
+
+  return summary;
+}
