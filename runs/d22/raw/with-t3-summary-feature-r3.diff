+/**
+ * Formats the gate result as a one-line summary for CI logs.
+ * @param result - the gate validation result
+ * @returns a single line summary, e.g. "PASS 7/7" or "BLOCK 5/7: evaluation, transparency"
+ */
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+  const blockCheckIds = new Set(blockFindings.map((f) => f.checkId));
+
+  if (blockCheckIds.has('structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const answered = GATE_CHECKS.filter((check) => !blockCheckIds.has(check.id)).length;
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockCheckIds.size > 0) {
+    const blockIds = GATE_CHECKS.filter((check) => blockCheckIds.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockIds}`;
+  }
+
+  return summary;
+}
+
 export function renderText(result: GateResult, specPath: string): string {
