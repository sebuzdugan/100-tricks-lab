+/**
+ * Parses threshold strings into an object
+ * @param thresholdStrings Array of strings like ["exact_match=0.9", "toxicity=0.8"]
+ * @returns Object like { exact_match: 0.9, toxicity: 0.8 } or null if any error
+ */
+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [key: string]: number } = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${str}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minValue = Number.parseFloat(match[2]);
+
+    if (Number.isNaN(minValue) || minValue < 0 || minValue > 1) {
+      log.error(
+        `Invalid threshold value for "${metricId}": must be a number between 0 and 1, got ${match[2]}`
+      );
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
