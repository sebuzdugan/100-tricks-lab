+/**
+ * Validates threshold configuration
+ * @param {Object} thresholds Object like { exact_match: 0.9 }
+ * @param {Array} evaluations Array of metric objects
+ * @returns {Object} { valid: boolean, errors: string[], validMetricIds: string[] }
+ */
+function validateThresholds(thresholds, evaluations) {
+  const errors = [];
+  const validMetricIds = evaluations.map(m => m.id);
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric id: "${metricId}". Valid ids: ${validMetricIds.join(', ')}`);
+    }
+    if (typeof min !== 'number' || Number.isNaN(min) || min < 0 || min > 1) {
+      errors.push(`Invalid threshold for "${metricId}": minimum must be a number between 0 and 1, got ${min}`);
+    }
+  });
+
+  return {
+    valid: errors.length === 0,
+    errors,
+    validMetricIds
+  };
+}
+
+/**
+ * Evaluates thresholds against metric scores
+ * @param {Object} thresholds Object like { exact_match: 0.9 }
+ * @param {Array} evaluations Array of metric objects
+ * @returns {Object} { passed: boolean, results: Array<{ metric, min, score, passed }> }
+ */
+function evaluateThresholds(thresholds, evaluations) {
+  const results = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    const metric = evaluations.find(m => m.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score >= min;
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    results.push({
+      metric: metricId,
+      min,
+      score: score ?? null,
+      passed
+    });
+  });
+
+  return {
+    passed: allPassed,
+    results
+  };
+}
