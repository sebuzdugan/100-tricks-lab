+/**
+ * Parses threshold arguments in the format 'metric=number' and returns a thresholds object.
+ * @param {string[]} thresholdArgs - Array of threshold strings like ['exact_match=0.9']
+ * @param {string[]} validMetricIds - Valid metric identifiers
+ * @returns {Object} Parsed thresholds object or null if validation fails
+ */
+function parseThresholds(thresholdArgs: string[] | undefined, validMetricIds: string[]): Record<string, number> | null {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-zA-Z_][a-zA-Z0-9_]*)=(.+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${arg}". Expected: metric=number`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      log.error(`Invalid threshold value: "${valueStr}" for metric "${metricId}". Expected a number.`);
+      process.exit(2);
+    }
+
+    if (value < 0 || value > 1) {
+      log.error(`Invalid threshold value: ${value} for metric "${metricId}". Must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(
+        `Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`
+      );
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
+
