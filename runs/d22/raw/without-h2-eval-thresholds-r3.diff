   assertFileExists(options.outputs);
+
+  let thresholds: Record<string, number> | undefined;
+  const defaultMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (options.threshold && options.threshold.length > 0) {
+    thresholds = {};
+    for (const thresholdStr of options.threshold) {
+      const parsed = parseThreshold(thresholdStr);
+      if (!parsed) {
+        log.error('Invalid threshold format. Use: --threshold <metric>=<number>', {
