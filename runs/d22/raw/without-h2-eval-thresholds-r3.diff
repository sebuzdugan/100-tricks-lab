+/**
+ * Parse and validate threshold string.
+ * @param {string} thresholdStr - Threshold string in format "metric=number"
+ * @returns {{metric: string, min: number}} Parsed threshold or null if invalid
+ */
+function parseThreshold(thresholdStr: string): { metric: string; min: number } | null {
+  const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+  if (!match) return null;
+  const min = Number.parseFloat(match[2]);
+  if (Number.isNaN(min) || min < 0 || min > 1) return null;
+  return { metric: match[1], min };
+}
+
