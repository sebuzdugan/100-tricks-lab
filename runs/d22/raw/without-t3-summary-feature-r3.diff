 }
+
+/**
+ * Render a one-line summary of the gate result for CI logs.
+ * @param result Gate validation result
+ * @returns Summary string in format: `<VERDICT> <answered>/<total>` or `<VERDICT> <answered>/<total>: check-ids`
+ */
+export function renderSummary(result: GateResult): string {
+  // If gate section is missing (structure finding), return BLOCK 0/7: structure
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Collect check ids that have block findings
+  const blockCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && finding.checkId !== 'structure') {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  // Answered = total checks - number of checks with block findings
+  const answered = GATE_CHECKS.length - blockCheckIds.size;
+
+  // Build the summary line
+  let summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  // If there are block findings, append the check ids in GATE_CHECKS order
+  if (blockCheckIds.size > 0) {
+    const orderedIds = GATE_CHECKS.map((c) => c.id).filter((id) => blockCheckIds.has(id));
+    summary += `: ${orderedIds.join(', ')}`;
+  }
+
+  return summary;
+}
