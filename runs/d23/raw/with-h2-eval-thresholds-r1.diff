+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: ${thresholdStr}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const minValue = parseFloat(minStr);
+
+    if (isNaN(minValue) || minValue < 0 || minValue > 1) {
+      log.error(
+        `Invalid threshold value for ${metricId}: ${minStr}. Threshold must be a number between 0 and 1.`
+      );
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}. Valid metrics are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
