+function parseThresholds(thresholdStrings?: string[]): { thresholds?: Record<string, number>; usageErrors?: string[] } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: undefined };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const usageErrors: string[] = [];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      usageErrors.push(`malformed threshold '${thresholdStr}': must be in format <metric>=<number>`);
+      continue;
+    }
+
+    const [, metric, value] = match;
+    const num = Number.parseFloat(value);
+    if (Number.isNaN(num)) {
+      usageErrors.push(`malformed threshold '${thresholdStr}': '${value}' is not a valid number`);
+      continue;
+    }
+
+    thresholds[metric] = num;
+  }
+
+  if (usageErrors.length > 0) {
+    return { usageErrors };
+  }
+
+  return { thresholds };
+}
