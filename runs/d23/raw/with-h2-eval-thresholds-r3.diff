+function validateThresholds(thresholds, availableMetricIds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true };
+  }
+
+  const errors = [];
+  const validated = {};
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (typeof min !== 'number') {
+      errors.push(`threshold for metric '${metricId}': minimum must be a number, got ${typeof min}`);
+      continue;
+    }
+    if (min < 0 || min > 1) {
+      errors.push(`threshold for metric '${metricId}': minimum must be between 0 and 1, got ${min}`);
+      continue;
+    }
+    if (!availableMetricIds.includes(metricId)) {
+      errors.push(`unknown metric '${metricId}'. Valid metrics: ${availableMetricIds.join(', ')}`);
+      continue;
+    }
+    validated[metricId] = min;
+  }
+
+  return errors.length > 0 ? { valid: false, errors } : { valid: true, validated };
+}
