+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with warnings but no blocks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers found',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with one blocked check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data sources',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('returns BLOCK with multiple blocked checks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency section',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No gate section found',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores warnings when counting blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers found',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Missing bias mitigation',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: bias');
+  });
+
+  it('handles multiple findings for the same check (only counts check once)', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing thresholds',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Dataset size too small',
+          source: 'agent'
+        }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('handles all seven checks blocked', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'msg', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'msg', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'msg', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'msg', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'msg', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: 'msg', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'msg', source: 'validator' }
+      ],
+      gateSection: 'some content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency');
+  });
+});
