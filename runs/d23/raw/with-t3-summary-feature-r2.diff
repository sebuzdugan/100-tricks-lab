index 0000000..a16ec2c
--- /dev/null
+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Verdict } from './schema.js';
+
+function createResult(
+  verdict: Verdict,
+  gateSection: string | null,
+  blockCheckIds: string[] = []
+): GateResult {
+  return {
+    verdict,
+    tier: null,
+    gateSection,
+    findings: blockCheckIds.map((checkId) => ({
+      checkId,
+      severity: 'block',
+      message: 'Test finding',
+      source: 'validator'
+    }))
+  };
+}
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result = createResult('BLOCK', null);
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS with all checks answered when no block findings', () => {
+    const result = createResult('PASS', '## Gate section');
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with all checks answered when no block findings', () => {
+    const result = createResult('WARN', '## Gate section');
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('counts answered checks correctly with block findings', () => {
+    const result = createResult('BLOCK', '## Gate section', ['evaluation', 'transparency']);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns block check ids in GATE_CHECKS order', () => {
+    const result = createResult('BLOCK', '## Gate section', ['transparency', 'evaluation']);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('includes single block check id', () => {
+    const result = createResult('BLOCK', '## Gate section', ['evaluation']);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('handles all checks blocked', () => {
+    const result = createResult(
+      'BLOCK',
+      '## Gate section',
+      ['risk-tier', 'data-privacy', 'oversight', 'evaluation', 'bias', 'monitoring', 'transparency']
+    );
+    expect(renderSummary(result)).toBe(
+      'BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency'
+    );
+  });
+});
