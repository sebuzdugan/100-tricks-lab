+function parseThresholds(
+  thresholdStrings: string[] | undefined,
+  validMetricIds: string[]
+): Record<string, number> {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const result: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2 || !parts[0].trim() || !parts[1].trim()) {
+      const error = new Error(
+        `Invalid threshold format: "${thresholdStr}". Expected format: metric=<number>.\nValid metric ids: ${validMetricIds.join(', ')}`
+      );
+      (error as any).exitCode = 2;
+      throw error;
+    }
+
+    const metricId = parts[0].trim();
+    const minStr = parts[1].trim();
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      const error = new Error(
+        `Invalid threshold value: "${minStr}". Must be a number between 0 and 1.\nValid metric ids: ${validMetricIds.join(', ')}`
+      );
+      (error as any).exitCode = 2;
+      throw error;
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      const error = new Error(
+        `Unknown metric id: "${metricId}".\nValid metric ids: ${validMetricIds.join(', ')}`
+      );
+      (error as any).exitCode = 2;
+      throw error;
+    }
+
+    result[metricId] = min;
+  }
+
+  return result;
+}
