+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | undefined {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error('Invalid threshold format. Expected <metric>=<number>', { threshold: thresholdStr });
+      console.error(`Valid format: metric=min (e.g., exact_match=0.9)`);
+      console.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minValue = parseFloat(match[2]);
+
+    if (!validMetrics.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`, {});
+      console.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (isNaN(minValue) || minValue < 0 || minValue > 1) {
+      log.error('Threshold minimum must be a number between 0 and 1', { threshold: thresholdStr });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
