+function parseThresholds(thresholdStrings?: string | string[]): Record<string, number> | undefined {
+  if (!thresholdStrings) {
+    return undefined;
+  }
+
+  const thresholdArray = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  if (thresholdArray.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdArray) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: "${minStr}". Minimum must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric id: "${metricId}". Valid metric ids are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
