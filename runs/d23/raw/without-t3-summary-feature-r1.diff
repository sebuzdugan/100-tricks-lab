-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,37 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // If gate section is missing, return special case
+  if (
+    result.findings.some(
+      (f) => f.checkId === 'structure' && f.severity === 'block'
+    )
+  ) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Get check IDs with block findings, in GATE_CHECKS order
+  const blockCheckIds = new Set(
+    result.findings
+      .filter((f) => f.severity === 'block')
+      .map((f) => f.checkId)
+  );
+
+  const blockedIds = GATE_CHECKS.map((check) => check.id).filter(
+    (id) => blockCheckIds.has(id)
+  );
+
+  // Count answered checks: those without block findings
+  const answered = GATE_CHECKS.length - blockedIds.length;
+  const total = GATE_CHECKS.length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockedIds.length > 0) {
+    summary += `: ${blockedIds.join(', ')}`;
+  }
+
+  return summary;
+}
