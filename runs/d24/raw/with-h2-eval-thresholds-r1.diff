+function parseThresholdsFormat(thresholdStrings: string[] | undefined): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: { [key: string]: number } = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold minimum: ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
+
+function validateThresholds(thresholds: { [key: string]: number }, evaluations: Array<{ id: string }>) {
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      const availableMetrics = Array.from(validMetricIds).sort().join(', ');
+      log.error(`Unknown metric: ${metricId}. Valid metrics are: ${availableMetrics}`);
+      process.exit(2);
+    }
+  }
+}
