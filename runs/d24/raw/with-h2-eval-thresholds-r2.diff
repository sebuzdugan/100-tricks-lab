+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings) return thresholds;
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: '${thresholdStr}'. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+    if (isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold for '${metric}': minimum must be a number between 0 and 1, got ${valueStr}`);
+      process.exit(2);
+    }
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
