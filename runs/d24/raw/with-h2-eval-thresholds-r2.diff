+function validateThresholds(thresholds = {}, metrics = []) {
+  const errors = [];
+  const metricIds = new Set(metrics.map((m) => m.id));
+
+  Object.entries(thresholds).forEach(([metric, min]) => {
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`Invalid threshold for '${metric}': minimum must be a number between 0 and 1, got ${min}`);
+    }
+    if (!metricIds.has(metric)) {
+      errors.push(`Unknown metric: '${metric}'. Valid metrics are: ${Array.from(metricIds).join(', ')}`);
+    }
+  });
+
+  return errors;
+}
+
+function evaluateThresholds(thresholds = {}, metrics = []) {
+  const results = [];
+  const metricMap = new Map(metrics.map((m) => [m.id, m]));
+
+  Object.entries(thresholds).forEach(([metric, min]) => {
+    const metricData = metricMap.get(metric);
+    const score = metricData?.score;
+    const passed = score !== null && score !== undefined && score >= min;
+
+    results.push({
+      metric,
+      min,
+      score: score ?? null,
+      passed
+    });
+  });
+
+  return results;
+}
