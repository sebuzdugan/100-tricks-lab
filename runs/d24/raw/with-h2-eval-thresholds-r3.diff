+function validateThresholds(thresholds) {
+  const errors = [];
+  const validatedThresholds = {};
+
+  for (const [metricId, min] of Object.entries(thresholds || {})) {
+    if (typeof min !== 'number') {
+      errors.push(`Threshold for "${metricId}" must be a number, got ${typeof min}`);
+      continue;
+    }
+    if (min < 0 || min > 1) {
+      errors.push(`Threshold for "${metricId}" must be between 0 and 1, got ${min}`);
+      continue;
+    }
+    validatedThresholds[metricId] = min;
+  }
+
+  return { validatedThresholds, errors };
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  const results = [];
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const [metricId, min] of Object.entries(thresholds || {})) {
+    if (!validMetricIds.has(metricId)) {
+      return {
+        thresholds: null,
+        passed: null,
+        invalidMetric: metricId,
+        validMetrics: Array.from(validMetricIds).sort()
+      };
+    }
+
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  const allPassed = results.length > 0 && results.every((r) => r.passed);
+  return { thresholds: results, passed: allPassed, invalidMetric: null };
+}
