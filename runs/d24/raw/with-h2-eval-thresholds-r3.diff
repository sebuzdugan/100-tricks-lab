+function parseThreshold(thresholdStr: string): [string, number] | null {
+  const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+  if (!match) {
+    return null;
+  }
+  const [, metricId, valueStr] = match;
+  const value = parseFloat(valueStr);
+  if (Number.isNaN(value)) {
+    return null;
+  }
+  return [metricId, value];
+}
+
+function parseThresholds(thresholdStrs?: string[]): { thresholds: Record<string, number> | null; errors: string[] } {
+  const errors = [];
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return { thresholds: null, errors };
+  }
+
+  for (const thresholdStr of thresholdStrs) {
+    const parsed = parseThreshold(thresholdStr);
+    if (!parsed) {
+      errors.push(`Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`);
+      continue;
+    }
+    const [metricId, value] = parsed;
+    if (value < 0 || value > 1) {
+      errors.push(`Invalid threshold for "${metricId}": ${value} (must be between 0 and 1)`);
+      continue;
+    }
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds: Object.keys(thresholds).length > 0 ? thresholds : null, errors };
+}
