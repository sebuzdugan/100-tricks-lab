+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No "## Responsible AI Gate" section found in the spec.',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with answered count when there are warnings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: '"Evaluation plan" has no numeric threshold.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with missing check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing gate subsection: "Evaluation plan".',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing gate subsection: "Transparency & incidents".',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK with block check ids, ignoring duplicates and warnings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing gate subsection: "Data & privacy".',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Data section is empty.',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'warn',
+          message: 'Warning about bias.',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing gate subsection: "Risk tier".',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, data-privacy');
+  });
+
+  it('lists block ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing.',
+          source: 'validator'
+        },
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'Missing.',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, oversight, transparency');
+  });
+});
