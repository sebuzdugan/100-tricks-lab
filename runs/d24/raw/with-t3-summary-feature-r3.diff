+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7 for missing gate section', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'Gate section missing', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with all checks answered (warnings do not reduce answered)', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'risk-tier', severity: 'warn', message: 'Missing details', source: 'validator' }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('lists blocking checks in order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'No evaluation plan', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'No transparency', source: 'validator' }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('counts correctly with mixed severities', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'high',
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'High tier', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'warn', message: 'Consider privacy', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'Missing oversight', source: 'validator' }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, oversight');
+  });
+
+  it('ignores warning findings when listing blocks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'minimal',
+      findings: [
+        { checkId: 'bias', severity: 'warn', message: 'Consider edge cases', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Monitoring details', source: 'validator' }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('handles single blocking check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'monitoring', severity: 'block', message: 'No monitoring strategy', source: 'validator' }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: monitoring');
+  });
+
+  it('maintains check order when listing blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'No transparency', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'No tier', source: 'validator' }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, transparency');
+  });
+
+  it('handles all checks blocked', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'No tier', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'No data plan', source: 'validator' },
+        { checkId: 'oversight', severity: 'block', message: 'No oversight', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'No eval', source: 'validator' },
+        { checkId: 'bias', severity: 'block', message: 'No bias', source: 'validator' },
+        { checkId: 'monitoring', severity: 'block', message: 'No monitoring', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'No transparency', source: 'validator' }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency');
+  });
+});
