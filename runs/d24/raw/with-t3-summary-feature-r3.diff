+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,32 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (result.gateSection === null) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+  const checksWithBlockings = new Set<string>();
+
+  for (const check of GATE_CHECKS) {
+    const hasBlockFinding = blockFindings.some((f) => f.checkId === check.id);
+    if (hasBlockFinding) {
+      checksWithBlockings.add(check.id);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - checksWithBlockings.size;
+
+  if (checksWithBlockings.size === 0) {
+    return `${result.verdict} ${answered}/7`;
+  }
+
+  const blockingIds = GATE_CHECKS
+    .filter((check) => checksWithBlockings.has(check.id))
+    .map((check) => check.id)
+    .join(', ');
+
+  return `${result.verdict} ${answered}/7: ${blockingIds}`;
+}
