+#!/usr/bin/env node
+
+import {
+  parseThresholds,
+  validateThresholds,
+  checkThresholds,
+  runEvaluations,
+  generateReport
+} from './packages/frai-core/src/eval/index.js';
+
+console.log('Testing threshold parsing...');
+try {
+  const parsed = parseThresholds(['exact_match=0.9', 'toxicity=0.95']);
+  console.log('✓ Parsed thresholds:', parsed);
+} catch (e) {
+  console.error('✗ Failed to parse:', e.message);
+  process.exit(1);
+}
+
+console.log('\nTesting invalid threshold format...');
+try {
+  parseThresholds(['invalid']);
+  console.error('✗ Should have thrown error for invalid format');
+  process.exit(1);
+} catch (e) {
+  console.log('✓ Correctly rejected invalid format:', e.message);
+}
+
+console.log('\nTesting threshold range validation...');
+try {
+  parseThresholds(['metric=1.5']);
+  console.error('✗ Should have thrown error for value > 1');
+  process.exit(1);
+} catch (e) {
+  console.log('✓ Correctly rejected out-of-range value:', e.message);
+}
+
+console.log('\nTesting threshold validation against metrics...');
+const evaluations = runEvaluations({
+  outputs: ['Hello', 'World'],
+  references: ['hello', 'world']
+});
+console.log('Generated evaluations:', evaluations.map(m => ({ id: m.id, score: m.score })));
+
+const validThresholds = { exact_match: 0.5 };
+const validation = validateThresholds(validThresholds, evaluations);
+console.log('✓ Valid threshold validation:', validation);
+
+const invalidThresholds = { unknown_metric: 0.5 };
+const invalidValidation = validateThresholds(invalidThresholds, evaluations);
+console.log('✓ Invalid threshold validation caught:', invalidValidation.error);
+
+console.log('\nTesting threshold checking...');
+const passingResult = checkThresholds({ exact_match: 0.5 }, evaluations);
+console.log('✓ Passing threshold result:', passingResult);
+
+const failingResult = checkThresholds({ exact_match: 0.95 }, evaluations);
+console.log('✓ Failing threshold result:', failingResult);
+
+console.log('\nTesting report generation with thresholds...');
+const report = generateReport({
+  evaluations,
+  outputsPath: '/tmp/outputs.json',
+  referencesPath: '/tmp/refs.json',
+  thresholds: { exact_match: 0.5, toxicity: 0.95 }
+});
+console.log('✓ Generated report with passed:', report.passed);
+console.log('  Thresholds:', report.thresholds);
+
+console.log('\nAll tests passed! ✨');
