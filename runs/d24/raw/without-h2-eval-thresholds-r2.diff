@@ -13,6 +13,62 @@ const defaultFs = fs;
 
 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+export function parseThresholds(thresholdStrings = []) {
+  const thresholds = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([^=]+)=([^=]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: <metric>=<number>`);
+    }
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+    if (Number.isNaN(value)) {
+      throw new Error(`Invalid threshold value for "${metric}": "${valueStr}" is not a valid number`);
+    }
+    if (value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for "${metric}": ${value} is outside valid range [0, 1]`);
+    }
+    thresholds[metric] = value;
+  }
+  return thresholds;
+}
+
+export function validateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true };
+  }
+
+  const metricIds = new Set(evaluations.map((m) => m.id));
+  const unknownMetrics = Object.keys(thresholds).filter((metric) => !metricIds.has(metric));
+
+  if (unknownMetrics.length > 0) {
+    const validMetrics = Array.from(metricIds).sort();
+    return {
+      valid: false,
+      error: `Unknown metric id: ${unknownMetrics[0]}. Valid metric ids: ${validMetrics.join(', ')}`
+    };
+  }
+
+  return { valid: true };
+}
+
+export function checkThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, results: [] };
+  }
+
+  const results = [];
+  for (const [metric, min] of Object.entries(thresholds)) {
+    const evaluation = evaluations.find((m) => m.id === metric);
+    const score = evaluation?.score ?? null;
+    const passed = score !== null && score >= min;
+    results.push({ metric, min, score, passed });
+  }
+
+  const allPassed = results.every((r) => r.passed);
+  return { passed: allPassed, results };
+}
