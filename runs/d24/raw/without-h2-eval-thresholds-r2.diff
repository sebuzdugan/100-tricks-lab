+#!/usr/bin/env node
+
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import {
+  loadDataset,
+  runEvaluations,
+  generateReport,
+  writeReport,
+  parseThresholds,
+  validateThresholds
+} from './packages/frai-core/src/eval/index.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+
+console.log('=== FRAI Eval Threshold Integration Test ===\n');
+
+// Create test data
+const testDir = path.join(__dirname, 'test-eval');
+const outputsPath = path.join(testDir, 'outputs.json');
+const referencesPath = path.join(testDir, 'references.json');
+
+console.log('1. Testing dataset loading...');
+const dataset = loadDataset({
+  outputsPath,
+  referencesPath
+});
+console.log(`✓ Loaded ${dataset.outputs.length} outputs and ${dataset.references.length} references`);
+
+console.log('\n2. Running evaluations...');
+const evaluations = runEvaluations({
+  outputs: dataset.outputs,
+  references: dataset.references
+});
+console.log(`✓ Generated ${evaluations.length} evaluation results:`);
+evaluations.forEach(m => {
+  console.log(`  - ${m.id}: ${m.score !== null ? m.score : 'null'}`);
+});
+
+console.log('\n3. Parsing threshold flags...');
+const thresholdFlags = ['exact_match=0.9', 'toxicity=0.95'];
+const thresholds = parseThresholds(thresholdFlags);
+console.log(`✓ Parsed thresholds:`, thresholds);
+
+console.log('\n4. Validating thresholds...');
+const validation = validateThresholds(thresholds, evaluations);
+if (validation.valid) {
+  console.log('✓ All thresholds are valid');
+} else {
+  console.error('✗ Validation failed:', validation.error);
+  process.exit(1);
+}
+
+console.log('\n5. Generating report with thresholds...');
+const report = generateReport({
+  evaluations,
+  outputsPath: dataset.outputsPath,
+  referencesPath: dataset.referencesPath,
+  thresholds
+});
+console.log(`✓ Report generated:`);
+console.log(`  - passed: ${report.passed}`);
+console.log(`  - thresholds:`);
+report.thresholds.forEach(t => {
+  console.log(`    - ${t.metric}: ${t.passed ? 'PASS' : 'FAIL'} (min=${t.min}, score=${t.score})`);
+});
+
+console.log('\n6. Writing JSON report...');
+const jsonPath = path.join(testDir, 'report.json');
+const resolvedJsonPath = writeReport({
+  report,
+  format: 'json',
+  reportPath: jsonPath
+});
+const jsonContent = JSON.parse(fs.readFileSync(resolvedJsonPath, 'utf8'));
+console.log(`✓ Wrote JSON report to ${path.relative(__dirname, resolvedJsonPath)}`);
+console.log(`  - has passed field: ${jsonContent.passed !== undefined}`);
+console.log(`  - has thresholds: ${jsonContent.thresholds !== undefined}`);
+
+console.log('\n7. Writing Markdown report...');
+const mdPath = path.join(testDir, 'report.md');
+const resolvedMdPath = writeReport({
+  report,
+  format: 'markdown',
+  reportPath: mdPath
+});
+const mdContent = fs.readFileSync(resolvedMdPath, 'utf8');
+console.log(`✓ Wrote Markdown report to ${path.relative(__dirname, resolvedMdPath)}`);
+console.log(`  - has Thresholds section: ${mdContent.includes('## Thresholds')}`);
+
+console.log('\n8. Testing error cases...');
+
+// Test malformed threshold
+try {
+  parseThresholds(['invalid_format']);
+  console.error('✗ Should have rejected malformed threshold');
+  process.exit(1);
+} catch (e) {
+  console.log(`✓ Rejected malformed threshold: "${e.message}"`);
+}
+
+// Test out-of-range threshold
+try {
+  parseThresholds(['metric=1.5']);
+  console.error('✗ Should have rejected out-of-range threshold');
+  process.exit(1);
+} catch (e) {
+  console.log(`✓ Rejected out-of-range threshold: "${e.message}"`);
+}
+
+// Test unknown metric
+const invalidValidation = validateThresholds({ unknown_metric: 0.5 }, evaluations);
+if (invalidValidation.valid) {
+  console.error('✗ Should have rejected unknown metric');
+  process.exit(1);
+} else {
+  console.log(`✓ Rejected unknown metric: "${invalidValidation.error}"`);
+}
+
+console.log('\n9. Testing report without thresholds...');
+const reportNoThresholds = generateReport({
+  evaluations,
+  outputsPath: dataset.outputsPath,
+  referencesPath: dataset.referencesPath
+});
+console.log(`✓ Report without thresholds:`);
+console.log(`  - has passed field: ${reportNoThresholds.passed !== undefined}`);
+console.log(`  - has thresholds: ${reportNoThresholds.thresholds !== undefined}`);
+
+console.log('\n=== All integration tests passed! ✨ ===\n');
+
+// Exit with appropriate code based on threshold results
+if (report.passed === false) {
+  console.log('Note: In a real CI scenario, this would exit with code 1.');
+} else {
+  console.log('Note: In a real CI scenario, this would exit with code 0.');
+}
