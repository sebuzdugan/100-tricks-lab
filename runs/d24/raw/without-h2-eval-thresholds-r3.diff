+function parseThresholds(thresholdStrings?: string | string[]): Record<string, number> | null {
+  if (!thresholdStrings) return null;
+  const strings = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  const thresholds: Record<string, number> = {};
+
+  for (const str of strings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: '${str}'. Expected format: metric=<number>`);
+      process.exit(2);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for metric '${metric}': ${valueStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
+
+function validateThresholdMetrics(thresholds: Record<string, number>, evaluations: Array<{ id: string }>) {
+  const validIds = evaluations.map((e) => e.id);
+  for (const metric of Object.keys(thresholds)) {
+    if (!validIds.includes(metric)) {
+      log.error(`Unknown metric: '${metric}'. Valid metric IDs are: ${validIds.join(', ')}`);
+      process.exit(2);
+    }
+  }
+}
