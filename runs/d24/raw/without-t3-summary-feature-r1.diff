+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 for fully answered gate', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with answered count', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers found',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with failed check ids', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing required field',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing required field',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('preserves order of check ids from GATE_CHECKS', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing required field',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing required field',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, transparency');
+  });
+
+  it('lists each check id only once', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing required field',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers found',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('returns BLOCK 0/7 when structure is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No gate section found',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers found',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numbers found',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('handles single block finding', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing required field',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'content'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+});
