+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${thresholdStr}`, {
+        expected: '<metric>=<number>',
+        example: 'exact_match=0.9'
+      });
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${valueStr}`, {
+        message: 'Threshold must be a number between 0 and 1'
+      });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
