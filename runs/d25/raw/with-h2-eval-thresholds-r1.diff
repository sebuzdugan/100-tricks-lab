+function validateThresholds(thresholds, availableMetricIds) {
+  if (!thresholds) return null;
+
+  const entries = Object.entries(thresholds);
+  const validated = [];
+
+  for (const [metricId, min] of entries) {
+    if (typeof min !== 'number') {
+      throw new Error(`Threshold for ${metricId} must be a number, got ${typeof min}`);
+    }
+    if (min < 0 || min > 1) {
+      throw new Error(`Threshold for ${metricId} must be between 0 and 1, got ${min}`);
+    }
+    if (!availableMetricIds.includes(metricId)) {
+      const validMetrics = availableMetricIds.join(', ') || '(none)';
+      throw new Error(`Unknown metric: ${metricId}. Available metrics: ${validMetrics}`);
+    }
+    validated.push({ metricId, min });
+  }
+
+  return validated;
+}
