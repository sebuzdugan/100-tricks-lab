+function parseThresholds(thresholdStrings: string[] | undefined, validMetricIds: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${thresholdStr}. Expected format: <metric>=<number>`);
+      log.error(`Valid metrics: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${valueStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`);
+      log.error(`Valid metrics: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
