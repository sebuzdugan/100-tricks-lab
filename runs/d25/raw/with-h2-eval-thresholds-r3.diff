+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: metric=value`);
+    }
+    const metricId = match[1];
+    const minStr = match[2];
+    const min = Number.parseFloat(minStr);
+    if (!Number.isFinite(min)) {
+      throw new Error(`Invalid threshold value for "${metricId}": "${minStr}" is not a valid number.`);
+    }
+    if (min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value for "${metricId}": ${min} is outside the range [0, 1].`);
+    }
+    thresholds[metricId] = min;
+  }
+  return thresholds;
+}
