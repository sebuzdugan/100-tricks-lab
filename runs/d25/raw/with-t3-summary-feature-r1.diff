+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns "BLOCK 0/7: structure" when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'No gate section', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns verdict and count when all checks pass', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## Responsible AI Gate\n\n### 5.1 Risk tier\n\nlimited'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns verdict and count with block findings listed', () => {
+    const findings: Finding[] = [
+      { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation plan', source: 'validator' },
+      { checkId: 'transparency', severity: 'block', message: 'Missing transparency section', source: 'validator' }
+    ];
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings,
+      gateSection: '## Responsible AI Gate\n\n### 5.1 Risk tier\n\nlimited'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('lists block findings in GATE_CHECKS order', () => {
+    const findings: Finding[] = [
+      { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' },
+      { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' }
+    ];
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings,
+      gateSection: '## Responsible AI Gate\n\n### 5.1 Risk tier'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const findings: Finding[] = [
+      { checkId: 'evaluation', severity: 'warn', message: 'No numbers in evaluation', source: 'validator' }
+    ];
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings,
+      gateSection: '## Responsible AI Gate\n\n### 5.1 Risk tier\n\nlimited'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('counts only unique block findings per check', () => {
+    const findings: Finding[] = [
+      { checkId: 'data-privacy', severity: 'block', message: 'Missing data sources', source: 'validator' },
+      { checkId: 'data-privacy', severity: 'block', message: 'Missing PII info', source: 'validator' },
+      { checkId: 'oversight', severity: 'block', message: 'Empty section', source: 'validator' }
+    ];
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings,
+      gateSection: '## Responsible AI Gate\n\n### 5.2 Data & privacy'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: data-privacy, oversight');
+  });
+});
