index 0000000..5ed1d7e
--- /dev/null
+++ b/packages/frai-gate/src/gate/report.test.ts
@@ -0,0 +1,117 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS for result with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '# Gate Section'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with answered count when there are warnings only', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'warn', message: 'Test warning', source: 'validator' }
+      ],
+      gateSection: '# Gate Section'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with check IDs and answered count when there are block findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'high',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing transparency', source: 'validator' }
+      ],
+      gateSection: '# Gate Section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK with only one check ID when one check has block severity', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing data privacy', source: 'validator' }
+      ],
+      gateSection: '# Gate Section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('handles mixed block and warn findings - only block affects answered count', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'prohibited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Weak monitoring', source: 'validator' }
+      ],
+      gateSection: '# Gate Section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('returns BLOCK 0/7 when structure finding is present', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'structure', severity: 'block', message: 'Gate section missing', source: 'validator' }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('maintains GATE_CHECKS order when listing blocked checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '# Gate Section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('ignores non-GATE_CHECKS findings like agent source', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'Missing evaluation', source: 'agent' },
+        { checkId: 'bias', severity: 'block', message: 'Bias concerns', source: 'agent' }
+      ],
+      gateSection: '# Gate Section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, bias');
+  });
+
+  it('lists each blocked check ID only once even if multiple findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'First issue', source: 'validator' },
+        { checkId: 'evaluation', severity: 'block', message: 'Second issue', source: 'agent' }
+      ],
+      gateSection: '# Gate Section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
