+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {}, metricIds: new Set() };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const metricIds = new Set<string>();
+
+  for (const str of thresholdStrings) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      throw {
+        code: 2,
+        message: `Invalid threshold format: "${str}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min)) {
+      throw {
+        code: 2,
+        message: `Invalid threshold value for metric "${metricId}": "${minStr}" is not a number`
+      };
+    }
+
+    if (min < 0 || min > 1) {
+      throw {
+        code: 2,
+        message: `Invalid threshold value for metric "${metricId}": ${min} is outside the valid range [0, 1]`
+      };
+    }
+
+    thresholds[metricId] = min;
+    metricIds.add(metricId);
+  }
+
+  return { thresholds, metricIds };
+}
+
+function validateThresholdMetrics(thresholds: Record<string, number>, evaluations: unknown[]) {
+  const evaluationIds = new Set(
+    (evaluations as any[]).map((e) => e.id)
+  );
+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!evaluationIds.has(metricId)) {
+      const validIds = Array.from(evaluationIds).sort();
+      throw {
+        code: 2,
+        message: `Unknown metric: "${metricId}". Valid metric ids are: ${validIds.join(', ')}`
+      };
+    }
+  }
+}
