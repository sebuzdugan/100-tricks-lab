+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${thresholdStr}". Expected format: metric=0.9`);
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = parseFloat(scoreStr);
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      throw new Error(`Invalid threshold value for ${metricId}: ${scoreStr}. Must be a number between 0 and 1.`);
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return thresholds;
+}
