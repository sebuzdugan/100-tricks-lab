+export function validateThresholds(thresholds, metricIds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [] };
+  }
+
+  const errors = [];
+  const validMetricIds = new Set(metricIds);
+
+  Object.entries(thresholds).forEach(([metricId, minValue]) => {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics: ${Array.from(validMetricIds).join(', ')}`);
+    } else if (typeof minValue !== 'number' || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold for ${metricId}: must be a number between 0 and 1, got ${minValue}`);
+    }
+  });
+
+  return { valid: errors.length === 0, errors };
+}
