@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GATE_CHECKS, GateResult } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,30 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const checkIds = GATE_CHECKS.map((c) => c.id);
+  const blockingChecks = new Set<string>();
+
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockingChecks.add(finding.checkId);
+    }
+  }
+
+  const answered = checkIds.filter((id) => !blockingChecks.has(id)).length;
+  const total = checkIds.length;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockingChecks.size > 0) {
+    const ids = checkIds.filter((id) => blockingChecks.has(id)).join(', ');
+    summary += `: ${ids}`;
+  }
+
+  return summary;
+}
