+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS when no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with correct count when only warnings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with blocking checks listed', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Empty',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK with blocked check when one check has block', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Invalid tier',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No gate section',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores duplicate check ids from multiple findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'First issue',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Second issue',
+          source: 'agent'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('orders blocked checks by GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, transparency');
+  });
+
+  it('does not list check ids when no block findings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numbers',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('combines block and warn findings correctly', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Empty',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numbers',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'test'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
