+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+function parseThresholds(thresholdStrs: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrs) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${str}`);
+      log.error('Threshold format must be <metric>=<number> (e.g., exact_match=0.9)');
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (!VALID_METRIC_IDS.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`);
+      log.error(`Valid metrics are: ${VALID_METRIC_IDS.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: ${minStr}`);
+      log.error('Threshold must be a number between 0 and 1');
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
