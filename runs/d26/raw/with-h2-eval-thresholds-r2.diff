+function parseAndValidateThresholds(thresholdStrings?: string[], evaluations?: any[]): { thresholds: Record<string, number> | null; validMetricIds: Set<string> } {
+  const validMetricIds = evaluations ? new Set(evaluations.map((m: any) => m.id)) : new Set();
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null, validMetricIds };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error('Invalid threshold format. Expected: <metric>=<number>', {
+        provided: thresholdStr,
+        example: 'exact_match=0.9'
+      });
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = parseFloat(minStr);
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      log.error('Invalid threshold minimum. Must be a number between 0 and 1.', {
+        metric: metricId,
+        provided: minStr,
+        value: min
+      });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, validMetricIds };
+}
