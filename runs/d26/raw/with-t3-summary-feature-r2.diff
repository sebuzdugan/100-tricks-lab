+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,26 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const total = GATE_CHECKS.length;
+  const blockCheckIds = new Set<string>();
+
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && GATE_CHECKS.some((c) => c.id === finding.checkId)) {
+      blockCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered = total - blockCheckIds.size;
+  const checkIdList = GATE_CHECKS.filter((c) => blockCheckIds.has(c.id))
+    .map((c) => c.id)
+    .join(', ');
+
+  const summary = `${result.verdict} ${answered}/${total}`;
+  return blockCheckIds.size > 0 ? `${summary}: ${checkIdList}` : summary;
+}
