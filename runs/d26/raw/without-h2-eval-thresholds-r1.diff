+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${threshStr} (expected format: metric=value)`);
+      process.exit(2);
+    }
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${valueStr} (must be between 0 and 1)`);
+      process.exit(2);
+    }
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
+
+function getValidMetricIds(evaluations: any[]): string[] {
+  return evaluations.map((m) => m.id).filter(Boolean);
+}
