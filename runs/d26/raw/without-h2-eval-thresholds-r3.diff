+export function validateThresholds(thresholds, validMetricIds) {
+  if (!thresholds) return { valid: true, errors: [] };
+
+  const errors = [];
+  const processed = {};
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!validMetricIds.includes(metricId)) {
+      errors.push({
+        type: 'unknown_metric',
+        metric: metricId,
+        message: `Unknown metric id "${metricId}". Valid ids: ${validMetricIds.join(', ')}`
+      });
+      continue;
+    }
+
+    const minNum = Number(min);
+    if (Number.isNaN(minNum) || minNum < 0 || minNum > 1) {
+      errors.push({
+        type: 'invalid_threshold',
+        metric: metricId,
+        message: `Threshold for "${metricId}" must be between 0 and 1, got ${min}`
+      });
+      continue;
+    }
+
+    processed[metricId] = minNum;
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors,
+    thresholds: processed
+  };
+}
