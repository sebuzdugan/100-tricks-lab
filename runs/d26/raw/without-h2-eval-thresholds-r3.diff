+function parseThresholds(thresholdStrs: string[] | undefined, validMetricIds: string[]) {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const threshStr of thresholdStrs) {
+    const parts = threshStr.split('=');
+    if (parts.length !== 2) {
+      log.error(`Malformed threshold: "${threshStr}". Expected format: metric=min`);
+      log.info(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for "${metricId}": ${minStr}. Must be between 0 and 1.`);
+      log.info(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric id: "${metricId}".`);
+      log.info(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
