+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7 for structure finding', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No gate section found.',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 for a fully answered gate with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns correct verdict with 1 blocked check', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('returns correct verdict with multiple blocked checks in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency.',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data privacy.',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, data-privacy, transparency');
+  });
+
+  it('ignores duplicate check IDs (uses Set dedup)', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier.',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Another risk tier issue.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('ignores warning findings (only counts blocks)', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold.',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numeric threshold.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('counts correctly with mixed block and warn findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier.',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('includes all blocked checks even when there are warnings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier.',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data privacy.',
+          source: 'validator'
+        },
+        {
+          checkId: 'oversight',
+          severity: 'warn',
+          message: 'Needs more detail.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, data-privacy');
+  });
+
+  it('handles empty gate section with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'minimal',
+      findings: [],
+      gateSection: ''
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('preserves GATE_CHECKS order regardless of findings order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Missing bias.',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier.',
+          source: 'validator'
+        },
+        {
+          checkId: 'oversight',
+          severity: 'block',
+          message: 'Missing oversight.',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## Gate\n...'
+    };
+    // GATE_CHECKS order: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, oversight, bias');
+  });
+});
