-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,23 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const structureFinding = result.findings.find((f) => f.checkId === 'structure' && f.severity === 'block');
+  if (structureFinding) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockedIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockedIds.add(finding.checkId);
+    }
+  }
+
+  const answered = GATE_CHECKS.length - blockedIds.size;
+  const blockedIdsOrdered = GATE_CHECKS.map((c) => c.id).filter((id) => blockedIds.has(id));
+  const suffix = blockedIdsOrdered.length > 0 ? `: ${blockedIdsOrdered.join(', ')}` : '';
+
+  return `${result.verdict} ${answered}/${GATE_CHECKS.length}${suffix}`;
+}
