+function parseThresholds(thresholdStrings) {
+  const thresholds = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(-?[0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Invalid threshold format: "${str}". Expected format: metric=number (e.g., exact_match=0.9)`);
+    }
+    const metricId = match[1];
+    const minValue = parseFloat(match[2]);
+    if (Number.isNaN(minValue) || minValue < 0 || minValue > 1) {
+      throw new Error(`Invalid threshold value for "${metricId}": ${minValue}. Must be between 0 and 1.`);
+    }
+    thresholds[metricId] = minValue;
+  }
+  return thresholds;
+}
+
+function validateThresholds(thresholds, validMetricIds) {
+  const unknownMetrics = Object.keys(thresholds).filter((id) => !validMetricIds.includes(id));
+  if (unknownMetrics.length > 0) {
+    throw new Error(
+      `Unknown metric(s): ${unknownMetrics.join(', ')}. Valid metrics: ${validMetricIds.join(', ')}`
+    );
+  }
+}
+
+function checkThresholds(thresholds, evaluations) {
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= minScore;
+    if (!passed) {
+      allPassed = false;
+    }
+    results.push({
+      metric: metricId,
+      min: minScore,
+      score,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: results };
+}
