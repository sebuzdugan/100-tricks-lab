+function parseThresholds(thresholdArgs: string | string[] | undefined): Record<string, number> | null {
+  if (!thresholdArgs) return null;
+
+  const args = Array.isArray(thresholdArgs) ? thresholdArgs : [thresholdArgs];
+  const result: Record<string, number> = {};
+
+  for (const arg of args) {
+    const parts = arg.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Invalid threshold format: "${arg}". Expected format: <metric>=<number>`);
+    }
+
+    const [metricId, valueStr] = parts;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      throw new Error(`Invalid threshold value for "${metricId}": "${valueStr}" is not a number`);
+    }
+
+    if (value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for "${metricId}": ${value} is outside the range [0, 1]`);
+    }
+
+    result[metricId] = value;
+  }
+
+  return result;
+}
