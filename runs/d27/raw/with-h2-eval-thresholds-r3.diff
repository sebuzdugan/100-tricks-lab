+function parseThresholds(thresholdStrings: string[] | undefined, validMetricIds: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: ${minStr}. Minimum must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric id: "${metricId}". Valid metric ids are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
