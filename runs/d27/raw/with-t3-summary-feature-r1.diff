@@ -0,0 +1,98 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns "BLOCK 0/7: structure" when gate section is missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Missing gate section',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns "PASS 7/7" when all checks pass with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '# Some gate section'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns verdict with answered count and block check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'No metrics', source: 'validator' },
+        { checkId: 'transparency', severity: 'block', message: 'Missing disclosure', source: 'validator' }
+      ],
+      gateSection: '# Some gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('ignores warning findings when counting answered checks', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        { checkId: 'monitoring', severity: 'warn', message: 'Missing some details', source: 'validator' }
+      ],
+      gateSection: '# Some gate section'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('handles multiple block findings from same check (counts once)', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'high',
+      findings: [
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing sign-off', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Invalid justification', source: 'agent' }
+      ],
+      gateSection: '# Some gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('maintains GATE_CHECKS order when listing block checks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'transparency', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'data-privacy', severity: 'block', message: 'Missing', source: 'validator' },
+        { checkId: 'risk-tier', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '# Some gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, data-privacy, transparency');
+  });
+
+  it('handles mix of block and warn findings', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        { checkId: 'evaluation', severity: 'block', message: 'No numbers', source: 'validator' },
+        { checkId: 'monitoring', severity: 'warn', message: 'Could be better', source: 'agent' },
+        { checkId: 'bias', severity: 'block', message: 'Missing', source: 'validator' }
+      ],
+      gateSection: '# Some gate section'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, bias');
+  });
+});
