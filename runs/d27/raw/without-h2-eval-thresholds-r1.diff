+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  const validMetricIds: Set<string> = new Set(['exact_match', 'toxicity', 'length_variance']);
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const metricId: string = match[1];
+    const minStr: string = match[2];
+
+    if (!validMetricIds.has(metricId)) {
+      log.error(`Unknown metric: "${metricId}". Valid metrics are: ${Array.from(validMetricIds).join(', ')}`);
+      process.exit(2);
+    }
+
+    const minValue: number = Number.parseFloat(minStr);
+    if (Number.isNaN(minValue) || minValue < 0 || minValue > 1) {
+      log.error(`Invalid threshold value for "${metricId}": ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
