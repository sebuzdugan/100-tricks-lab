+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics: Set<string> = new Set([
+    'exact_match',
+    'toxicity',
+    'length_variance'
+  ]);
+
+  for (const threshStr of thresholdStrings) {
+    const parts: string[] = threshStr.split('=');
+    if (parts.length !== 2) {
+      const metricsList: string = Array.from(validMetrics).join(', ');
+      log.error(`Invalid threshold format: "${threshStr}". Expected format: metric=value`);
+      log.error(`Valid metrics: ${metricsList}`);
+      process.exit(2);
+    }
+
+    const metricId: string = parts[0].trim();
+    const minStr: string = parts[1].trim();
+
+    if (!minStr || !/^([0-9]+(\.[0-9]+)?|\.[0-9]+)$/.test(minStr)) {
+      log.error(`Invalid threshold value for "${metricId}": "${minStr}". Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    const minValue: number = parseFloat(minStr);
+    if (minValue < 0 || minValue > 1) {
+      log.error(`Invalid threshold value for "${metricId}": "${minStr}". Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetrics.has(metricId)) {
+      const metricsList: string = Array.from(validMetrics).join(', ');
+      log.error(`Unknown metric: "${metricId}"`);
+      log.error(`Valid metrics: ${metricsList}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
