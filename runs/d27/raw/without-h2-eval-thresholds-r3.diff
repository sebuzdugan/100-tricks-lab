diff --git a/packages/frai-core/src/eval/index.test.js b/packages/frai-core/src/eval/index.test.js
index 2cac2fb..2147c25 100644
--- a/packages/frai-core/src/eval/index.test.js
+++ b/packages/frai-core/src/eval/index.test.js
@@ -76,4 +76,96 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  it('validates thresholds correctly', async () => {
+    const { validateThreshold } = await import('./index.js');
+    const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+    const valid = validateThreshold('exact_match=0.9', validMetrics);
+    expect(valid.valid).toBe(true);
+    expect(valid.metricId).toBe('exact_match');
+    expect(valid.min).toBe(0.9);
+
+    const invalidFormat = validateThreshold('exact_match:0.9', validMetrics);
+    expect(invalidFormat.valid).toBe(false);
+    expect(invalidFormat.error).toContain('Invalid threshold format');
+
+    const invalidValue = validateThreshold('exact_match=abc', validMetrics);
+    expect(invalidValue.valid).toBe(false);
+    expect(invalidValue.error).toContain('not a number');
+
+    const outOfRange = validateThreshold('exact_match=1.5', validMetrics);
+    expect(outOfRange.valid).toBe(false);
+    expect(outOfRange.error).toContain('outside valid range');
+
+    const unknownMetric = validateThreshold('unknown_metric=0.5', validMetrics);
+    expect(unknownMetric.valid).toBe(false);
+    expect(unknownMetric.error).toContain('Unknown metric');
+  });
+
+  it('evaluates thresholds and generates report with threshold results', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5
+      }
+    });
+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toBeDefined();
+    expect(report.thresholds.length).toBe(1);
+    expect(report.thresholds[0].metric).toBe('exact_match');
+    expect(report.thresholds[0].min).toBe(0.5);
+    expect(report.thresholds[0].passed).toBe(true);
+  });
+
+  it('marks threshold as failed when score is too low', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'different']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].passed).toBe(false);
+  });
+
+  it('fails threshold when metric has no score', () => {
+    const evaluations = [
+      {
+        id: 'exact_match',
+        label: 'Exact Match',
+        score: null,
+        total: 0
+      }
+    ];
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].passed).toBe(false);
+    expect(report.thresholds[0].score).toBe(null);
+  });
 });
