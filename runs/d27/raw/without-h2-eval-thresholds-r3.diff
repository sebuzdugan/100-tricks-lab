+export function validateThreshold(thresholdStr, validMetricIds) {
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    return { valid: false, error: `Invalid threshold format: "${thresholdStr}". Expected format: metric=number` };
+  }
+
+  const [metricId, minStr] = parts;
+  const min = Number.parseFloat(minStr);
+
+  if (Number.isNaN(min)) {
+    return { valid: false, error: `Invalid threshold value for ${metricId}: "${minStr}" is not a number` };
+  }
+
+  if (min < 0 || min > 1) {
+    return { valid: false, error: `Invalid threshold value for ${metricId}: ${min} is outside valid range [0, 1]` };
+  }
+
+  if (!validMetricIds.includes(metricId)) {
+    return { valid: false, error: `Unknown metric: "${metricId}". Valid metrics: ${validMetricIds.join(', ')}` };
+  }
+
+  return { valid: true, metricId, min };
+}
+
+function evaluateThresholds(evaluations, thresholds) {
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    let passed = false;
+
+    if (metric && typeof metric.score === 'number') {
+      passed = metric.score >= min;
+    }
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    results.push({
+      metric: metricId,
+      min,
+      score: metric?.score ?? null,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: results };
+}
+
 export function generateReport({
