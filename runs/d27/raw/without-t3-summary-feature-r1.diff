@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const structureBlock = result.findings.find((f) => f.checkId === 'structure' && f.severity === 'block');
+  if (structureBlock) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const checkIds = GATE_CHECKS.map((c) => c.id);
+  const blockingFindingsByCheck = new Map<string, Finding[]>();
+  for (const checkId of checkIds) {
+    blockingFindingsByCheck.set(checkId, []);
+  }
+
+  for (const finding of result.findings) {
+    if (finding.severity === 'block' && blockingFindingsByCheck.has(finding.checkId)) {
+      blockingFindingsByCheck.get(finding.checkId)!.push(finding);
+    }
+  }
+
+  const answeredCount: number = checkIds.filter((id) => blockingFindingsByCheck.get(id)!.length === 0).length;
+  const total: number = checkIds.length;
+
+  let summary: string = `${result.verdict} ${answeredCount}/${total}`;
+
+  const blockedCheckIds: string[] = checkIds.filter((id) => blockingFindingsByCheck.get(id)!.length > 0);
+  if (blockedCheckIds.length > 0) {
+    summary += `: ${blockedCheckIds.join(', ')}`;
+  }
+
+  return summary;
+}
