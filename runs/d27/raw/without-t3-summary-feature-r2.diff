@@ -0,0 +1,164 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import type { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 when all checks pass with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with answered count when warnings exist', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Missing numbers',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with blocked check ids when block findings exist', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing section',
+          source: 'validator'
+        },
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Incomplete answer',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK with all check ids in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: risk-tier, transparency');
+  });
+
+  it('returns BLOCK 0/7 when gate section is missing (structure finding)', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'Gate section not found',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('counts only block-severity findings for each check id', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Warning 1',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Warning 2',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'block',
+          message: 'Block',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('WARN 6/7: bias');
+  });
+
+  it('handles single block finding', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'monitoring',
+          severity: 'block',
+          message: 'Missing rollback procedure',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: monitoring');
+  });
+
+  it('ignores warning findings when calculating answered count', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numbers in evaluation',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'Limited monitoring',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+});
