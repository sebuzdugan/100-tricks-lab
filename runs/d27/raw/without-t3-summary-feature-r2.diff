index d83a05a..ddd830b 100644
--- a/packages/frai-gate/src/gate/report.ts
+++ b/packages/frai-gate/src/gate/report.ts
@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,31 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const TOTAL: number = GATE_CHECKS.length;
+
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockingCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockingCheckIds.add(finding.checkId);
+    }
+  }
+
+  const answered: number = GATE_CHECKS.filter((check) => !blockingCheckIds.has(check.id)).length;
+
+  let summary: string = `${result.verdict} ${answered}/${TOTAL}`;
+
+  if (blockingCheckIds.size > 0) {
+    const blockIds = GATE_CHECKS.filter((check) => blockingCheckIds.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockIds}`;
+  }
+
+  return summary;
+}
