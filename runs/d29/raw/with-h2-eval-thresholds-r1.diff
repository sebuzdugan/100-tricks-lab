+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+function parseThresholds(thresholdStrs: string[] | undefined): Record<string, number> | undefined {
+  if (!thresholdStrs || !thresholdStrs.length) return undefined;
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrs) {
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      throw new Error(`Invalid threshold format: ${str}. Expected <metric>=<number> (e.g. exact_match=0.9)`);
+    }
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min)) {
+      throw new Error(`Invalid threshold value for ${metricId}: ${minStr}. Expected a number.`);
+    }
+    if (min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value for ${metricId}: ${min}. Must be between 0 and 1.`);
+    }
+    if (!VALID_METRIC_IDS.includes(metricId)) {
+      throw new Error(`Unknown metric: ${metricId}. Valid metrics are: ${VALID_METRIC_IDS.join(', ')}`);
+    }
+    thresholds[metricId] = min;
+  }
+  return thresholds;
+}
