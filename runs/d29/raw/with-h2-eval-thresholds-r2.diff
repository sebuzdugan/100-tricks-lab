diff --git a/packages/frai-core/src/eval/thresholds.test.js b/packages/frai-core/src/eval/thresholds.test.js
new file mode 100644
index 0000000..81d17ad
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.test.js
@@ -0,0 +1,155 @@
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { afterEach, describe, expect, it } from 'vitest';
+
+import {
+  generateReport,
+  loadDataset,
+  runEvaluations,
+  writeReport
+} from './index.js';
+
+const tmpDirs = [];
+afterEach(() => {
+  while (tmpDirs.length) {
+    fs.rmSync(tmpDirs.pop(), { recursive: true, force: true });
+  }
+});
+
+const createTempDir = () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-eval-'));
+  tmpDirs.push(dir);
+  return dir;
+};
+
+describe('Threshold evaluation', () => {
+  it('passes all thresholds when scores meet minimums', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: {
+        exact_match: 0.5,
+        toxicity: 0.8
+      }
+    });
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds.every((t) => t.passed)).toBe(true);
+  });
+
+  it('fails thresholds when scores are below minimums', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: {
+        exact_match: 0.99
+      }
+    });
+    expect(report.passed).toBe(false);
+    expect(report.thresholds).toHaveLength(1);
+    expect(report.thresholds[0].passed).toBe(false);
+  });
+
+  it('fails thresholds when metric has no score', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: [] // No references, so exact_match will have score: null
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: null,
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: {
+        exact_match: 0.5
+      }
+    });
+    expect(report.passed).toBe(false);
+    const exactMatchThreshold = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(exactMatchThreshold.score).toBeNull();
+    expect(exactMatchThreshold.passed).toBe(false);
+  });
+
+  it('does not add thresholds to report when not provided', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z'
+    });
+    expect(report.passed).toBeUndefined();
+    expect(report.thresholds).toBeUndefined();
+  });
+
+  it('writes thresholds to JSON report', () => {
+    const dir = createTempDir();
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: {
+        exact_match: 0.5
+      }
+    });
+    const reportPath = writeReport({
+      report,
+      format: 'json',
+      reportPath: path.join(dir, 'report.json')
+    });
+    const content = fs.readFileSync(reportPath, 'utf8');
+    const json = JSON.parse(content);
+    expect(json.passed).toBe(true);
+    expect(json.thresholds).toBeDefined();
+    expect(json.thresholds).toHaveLength(1);
+  });
+
+  it('writes thresholds to markdown report', () => {
+    const dir = createTempDir();
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: {
+        exact_match: 0.5,
+        toxicity: 0.9
+      }
+    });
+    const reportPath = writeReport({
+      report,
+      format: 'markdown',
+      reportPath: path.join(dir, 'report.md')
+    });
+    const content = fs.readFileSync(reportPath, 'utf8');
+    expect(content).toContain('## Thresholds');
+    expect(content).toContain('exact_match');
+    expect(content).toContain('PASS');
+    expect(content).toContain('toxicity');
+  });
+});
