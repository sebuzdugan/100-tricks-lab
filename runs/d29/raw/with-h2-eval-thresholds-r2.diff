+function parseAndValidateThresholds(
+  thresholdStrings: string[] | undefined,
+  evaluations: any[]
+): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const availableMetricIds = evaluations.map((m) => m.id);
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${thresholdStr}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: ${minStr}. Value must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!availableMetricIds.includes(metricId)) {
+      log.error(
+        `Unknown metric: ${metricId}. Available metrics are: ${availableMetricIds.join(', ')}`
+      );
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
