+function parseThresholds(thresholdStrings?: string | string[]) {
+  if (!thresholdStrings) return null;
+  const strings = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  const thresholds: Record<string, number> = {};
+
+  for (const str of strings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: <metric>=<number>`);
+    }
+    const [, metric, value] = match;
+    const num = Number.parseFloat(value);
+    if (Number.isNaN(num) || num < 0 || num > 1) {
+      throw new Error(`Invalid threshold value for "${metric}": ${value}. Must be a number between 0 and 1.`);
+    }
+    thresholds[metric] = num;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
