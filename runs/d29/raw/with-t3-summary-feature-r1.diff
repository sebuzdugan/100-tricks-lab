+import { Finding, GATE_CHECKS, GateResult } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,25 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+
+  if (blockFindings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const answeredCount = GATE_CHECKS.length - new Set(blockFindings.map((f) => f.checkId)).size;
+  const total = GATE_CHECKS.length;
+  let summary = `${result.verdict} ${answeredCount}/${total}`;
+
+  if (blockFindings.length > 0) {
+    const blockCheckIds = GATE_CHECKS.filter((check) => blockFindings.some((f) => f.checkId === check.id)).map(
+      (c) => c.id
+    );
+    const uniqueIds = [...new Set(blockCheckIds)];
+    summary += `: ${uniqueIds.join(', ')}`;
+  }
+
+  return summary;
+}
