+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = new Set(['exact_match', 'toxicity', 'length_variance']);
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error('Malformed threshold option.', { threshold: thresholdStr, format: '<metric>=<number>' });
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const minScore = Number.parseFloat(minStr);
+
+    if (!validMetrics.has(metricId)) {
+      log.error('Unknown metric id.', {
+        metric: metricId,
+        validMetrics: Array.from(validMetrics)
+      });
+      process.exit(2);
+    }
+
+    if (Number.isNaN(minScore) || minScore < 0 || minScore > 1) {
+      log.error('Invalid threshold value.', {
+        threshold: thresholdStr,
+        message: 'Minimum must be a number between 0 and 1'
+      });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return thresholds;
+}
