+import { Eval } from 'frai-core';
+
+// Example: Run evaluation with thresholds
+async function main() {
+  try {
+    // Load dataset
+    const dataset = Eval.loadDataset({
+      outputsPath: './test-data/outputs.json',
+      referencesPath: './test-data/references.json'
+    });
+
+    console.log('📊 Loaded dataset:', {
+      outputs: dataset.outputs.length,
+      references: dataset.references.length
+    });
+
+    // Run evaluations
+    const evaluations = Eval.runEvaluations({
+      outputs: dataset.outputs,
+      references: dataset.references
+    });
+
+    console.log('📈 Metrics computed:');
+    evaluations.forEach((m) => {
+      console.log(`  - ${m.label}: ${m.score ?? 'n/a'}`);
+    });
+
+    // Define thresholds
+    const thresholds = {
+      exact_match: 1.0,
+      toxicity: 0.95
+    };
+
+    console.log('\n🎯 Thresholds:', thresholds);
+
+    // Validate thresholds
+    const validation = Eval.validateThresholds(thresholds, evaluations);
+    if (!validation.valid) {
+      console.error('❌ Validation failed:');
+      validation.errors.forEach((err) => console.error(`  - ${err}`));
+      process.exit(2);
+    }
+    console.log('✅ Thresholds valid');
+
+    // Generate report with thresholds
+    const report = Eval.generateReport({
+      evaluations,
+      outputsPath: dataset.outputsPath,
+      referencesPath: dataset.referencesPath,
+      thresholds
+    });
+
+    console.log('\n📝 Report generated:');
+    console.log(`  - Total samples: ${report.metadata.totalSamples}`);
+    console.log(`  - Passed all thresholds: ${report.passed}`);
+
+    if (report.thresholds) {
+      console.log('  - Threshold results:');
+      report.thresholds.forEach((t) => {
+        const status = t.passed ? '✓' : '✗';
+        console.log(`    ${status} ${t.metric}: ${t.score ?? 'n/a'} (min: ${t.min})`);
+      });
+    }
+
+    // Write reports
+    const jsonPath = Eval.writeReport({
+      report,
+      format: 'json',
+      reportPath: 'eval-report-with-thresholds'
+    });
+
+    const mdPath = Eval.writeReport({
+      report,
+      format: 'markdown',
+      reportPath: 'eval-report-with-thresholds'
+    });
+
+    console.log('\n💾 Reports written:');
+    console.log(`  - JSON: ${jsonPath}`);
+    console.log(`  - Markdown: ${mdPath}`);
+
+    // Exit with appropriate code
+    if (report.passed === false) {
+      console.log('\n⚠️  Some thresholds failed');
+      process.exit(1);
+    }
+
+    console.log('\n✨ All thresholds passed!');
+    process.exit(0);
+  } catch (error) {
+    console.error('Error:', error.message);
+    process.exit(1);
+  }
+}
+
+main();
