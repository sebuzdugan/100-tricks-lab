+function parseThreshold(thresholdStr: string): { metric: string; value: number } {
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    throw new Error(`Invalid threshold format: "${thresholdStr}". Expected format: metric=value`);
+  }
+  const [metric, valueStr] = parts;
+  const value = Number.parseFloat(valueStr);
+  if (Number.isNaN(value)) {
+    throw new Error(`Invalid threshold value: "${valueStr}". Must be a number.`);
+  }
+  if (value < 0 || value > 1) {
+    throw new Error(`Invalid threshold value: ${value}. Must be between 0 and 1.`);
+  }
+  return { metric: metric.trim(), value };
+}
+
+function parseThresholds(thresholdStrs: string[] | undefined): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrs) return thresholds;
+  for (const str of thresholdStrs) {
+    const { metric, value } = parseThreshold(str);
+    thresholds[metric] = value;
+  }
+  return thresholds;
+}
