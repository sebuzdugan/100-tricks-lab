@@ -0,0 +1,167 @@
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { describe, expect, it } from 'vitest';
+
+import { generateReport, runEvaluations, validateThresholds, evaluateThresholds } from './index.js';
+
+describe('Threshold functionality', () => {
+  it('validates valid thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+
+    const result = validateThresholds({ exact_match: 0.5, toxicity: 0.8 }, evaluations);
+    expect(result.valid).toBe(true);
+    expect(result.errors).toEqual([]);
+  });
+
+  it('rejects unknown metrics', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+
+    const result = validateThresholds({ unknown_metric: 0.5 }, evaluations);
+    expect(result.valid).toBe(false);
+    expect(result.errors.some((e) => e.includes('Unknown metric id'))).toBe(true);
+  });
+
+  it('rejects out-of-range values', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+
+    const resultHigh = validateThresholds({ exact_match: 1.5 }, evaluations);
+    expect(resultHigh.valid).toBe(false);
+
+    const resultNegative = validateThresholds({ exact_match: -0.5 }, evaluations);
+    expect(resultNegative.valid).toBe(false);
+
+    const resultNaN = validateThresholds({ exact_match: 'abc' }, evaluations);
+    expect(resultNaN.valid).toBe(false);
+  });
+
+  it('evaluates thresholds passing', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
