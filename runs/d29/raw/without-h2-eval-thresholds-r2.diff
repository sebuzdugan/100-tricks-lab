+      references: ['hello', 'DIFFERENT']
+    });
+
+    const thresholds = evaluateThresholds({ exact_match: 0.9 }, evaluations);
+    expect(thresholds[0].passed).toBe(false);
+  });
+
+  it('fails thresholds when metric score is null', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: []
+    });
+
+    const thresholds = evaluateThresholds({ exact_match: 0.5 }, evaluations);
+    expect(thresholds[0].score).toBe(null);
+    expect(thresholds[0].passed).toBe(false);
+  });
+
+  it('reports passed=true when all thresholds pass', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
