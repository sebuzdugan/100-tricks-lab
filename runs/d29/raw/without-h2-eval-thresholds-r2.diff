+    });
+
+    const thresholds = evaluateThresholds({ exact_match: 0.5, toxicity: 0.5 }, evaluations);
+    expect(thresholds).toHaveLength(2);
+    expect(thresholds.every((t) => t.passed)).toBe(true);
+  });
+
+  it('evaluates thresholds failing', () => {
