+export function validateThresholds(thresholds = {}, evaluations = []) {
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+  const errors = [];
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(
+        `Unknown metric id: ${metricId}. Valid metric ids are: ${Array.from(validMetricIds).join(', ')}`
+      );
+    }
+    if (typeof minValue !== 'number' || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold for ${metricId}: must be a number between 0 and 1`);
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+export function evaluateThresholds(thresholds = {}, evaluations = []) {
+  const thresholdsList = [];
+  const metricMap = new Map(evaluations.map((m) => [m.id, m]));
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = metricMap.get(metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    thresholdsList.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return thresholdsList;
+}
