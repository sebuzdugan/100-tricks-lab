+function parseThresholds(thresholdStrings: string[] | string | undefined): { thresholds: Record<string, number>; errors: string[] } {
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  if (!thresholdStrings) {
+    return { thresholds, errors };
+  }
+
+  const strs = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+
+  if (strs.length === 0) {
+    return { thresholds, errors };
+  }
+
+  for (const str of strs) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      errors.push(`Malformed threshold "${str}": must be in format <metric>=<number>`);
+      continue;
+    }
+
+    const [metric, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (!metric) {
+      errors.push(`Malformed threshold "${str}": metric name is empty`);
+      continue;
+    }
+
+    if (Number.isNaN(min)) {
+      errors.push(`Malformed threshold "${str}": "${minStr}" is not a number`);
+      continue;
+    }
+
+    if (min < 0 || min > 1) {
+      errors.push(`Malformed threshold "${str}": minimum must be between 0 and 1, got ${min}`);
+      continue;
+    }
+
+    thresholds[metric] = min;
+  }
+
+  return { thresholds, errors };
+}
