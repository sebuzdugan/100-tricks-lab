+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,34 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  if (result.findings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  const blockingCheckIds = new Set<string>();
+  const checkedIds = new Set<string>();
+
+  for (const check of GATE_CHECKS) {
+    for (const finding of result.findings) {
+      if (finding.checkId === check.id && finding.severity === 'block') {
+        blockingCheckIds.add(check.id);
+        break;
+      }
+    }
+    checkedIds.add(check.id);
+  }
+
+  const answered = GATE_CHECKS.length - blockingCheckIds.size;
+  let summary = `${result.verdict} ${answered}/7`;
+
+  if (blockingCheckIds.size > 0) {
+    const blockIds = GATE_CHECKS.filter((check) => blockingCheckIds.has(check.id))
+      .map((check) => check.id)
+      .join(', ');
+    summary += `: ${blockIds}`;
+  }
+
+  return summary;
+}
