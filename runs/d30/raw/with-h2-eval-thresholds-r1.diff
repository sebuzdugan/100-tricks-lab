+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds) return [];
+
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+  const errors = [];
+  const results = [];
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`Invalid threshold for metric '${metric}': minimum must be a number between 0 and 1, got ${min}`);
+      continue;
+    }
+
+    if (!validMetricIds.has(metric)) {
+      const validIds = Array.from(validMetricIds).sort();
+      errors.push(`Unknown metric '${metric}'. Valid metrics are: ${validIds.join(', ')}`);
+      continue;
+    }
+
+    const metricData = evaluations.find((m) => m.id === metric);
+    const score = metricData.score;
+    const passed = score !== null && score >= min;
+
+    results.push({
+      metric,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return { results, errors };
+}
