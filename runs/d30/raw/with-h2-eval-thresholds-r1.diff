+
+  const result: Record<string, number> = {};
+  for (const arg of thresholdArgs) {
+    const [metric, minStr] = arg.split('=');
+    if (!metric || minStr === undefined) {
+      log.error(`Invalid threshold format: '${arg}'. Expected format: <metric>=<number>`);
+      process.exit(2);
