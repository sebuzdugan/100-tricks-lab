+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: ${threshold}. Format must be <metric>=<number>`);
+    }
+    const metric = match[1];
+    const min = parseFloat(match[2]);
+    if (isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold minimum for ${metric}: ${match[2]}. Must be a number between 0 and 1`);
+    }
+    thresholds[metric] = min;
+  }
+
+  return thresholds;
+}
