 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,38 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  // If gate section is missing, return BLOCK 0/7: structure
+  const structureFind = result.findings.find((f) => f.checkId === 'structure');
+  if (structureFind) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Find which checks have block findings
+  const blockedCheckIds = new Set<string>();
+  for (const finding of result.findings) {
+    if (finding.severity === 'block') {
+      blockedCheckIds.add(finding.checkId);
+    }
+  }
+
+  // Count answered checks (those without block findings)
+  const answered = GATE_CHECKS.length - blockedCheckIds.size;
+  const total = GATE_CHECKS.length;
+
+  // Build the summary line
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  // If there are block findings, append the check ids in GATE_CHECKS order
+  if (result.verdict === 'BLOCK') {
+    const blockedIds = GATE_CHECKS.filter((check) => blockedCheckIds.has(check.id)).map(
+      (check) => check.id
+    );
+    if (blockedIds.length > 0) {
+      summary += `: ${blockedIds.join(', ')}`;
+    }
+  }
+
+  return summary;
+}
