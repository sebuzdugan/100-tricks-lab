+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: ${str}. Expected format: <metric>=<number>`);
+    }
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw new Error(
+        `Invalid threshold value for ${metric}: ${valueStr}. Must be a number between 0 and 1.`
+      );
+    }
+    thresholds[metric] = value;
+  }
+  return thresholds;
+}
+
+function validateThresholds(
+  thresholds: Record<string, number>,
+  evaluations: Array<{ id: string }>
+): void {
+  const validMetricIds = new Set(evaluations.map((e) => e.id));
+  for (const metricId of Object.keys(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      const validIds = Array.from(validMetricIds).join(', ');
+      throw new Error(`Unknown metric: ${metricId}. Valid metrics are: ${validIds}`);
+    }
+  }
+}
