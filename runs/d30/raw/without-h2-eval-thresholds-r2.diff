+function parseThresholds(thresholdsInput) {
+  if (!thresholdsInput) return null;
+
+  const thresholds = {};
+  const parsed = Array.isArray(thresholdsInput) ? thresholdsInput : Object.entries(thresholdsInput);
+
+  if (Array.isArray(parsed)) {
+    for (const item of parsed) {
+      if (typeof item === 'string') {
+        const [metricId, minStr] = item.split('=');
+        if (!metricId || !minStr) {
+          throw new Error(`Invalid threshold format: "${item}". Expected format: <metric_id>=<number>`);
+        }
+        const min = Number.parseFloat(minStr);
+        if (Number.isNaN(min)) {
+          throw new Error(`Invalid threshold minimum value: "${minStr}" is not a number`);
+        }
+        if (min < 0 || min > 1) {
+          throw new Error(`Threshold minimum must be between 0 and 1, got: ${min}`);
+        }
+        thresholds[metricId.trim()] = min;
+      } else {
+        const [metricId, min] = item;
+        if (typeof min !== 'number' || min < 0 || min > 1) {
+          throw new Error(`Threshold minimum must be a number between 0 and 1, got: ${min}`);
+        }
+        thresholds[metricId] = min;
+      }
+    }
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
+
+function validateAndCheckThresholds(thresholds, evaluations) {
+  if (!thresholds) return { passed: true, thresholds: [] };
+
+  const availableMetrics = new Set(evaluations.map((e) => e.id));
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!availableMetrics.has(metricId)) {
+      throw new Error(
+        `Unknown metric id: "${metricId}". Valid metrics are: ${Array.from(availableMetrics).join(', ')}`
+      );
+    }
+
+    const metric = evaluations.find((e) => e.id === metricId);
+    const score = metric.score ?? null;
+    const passed = score !== null && score >= min;
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: thresholdResults };
+}
