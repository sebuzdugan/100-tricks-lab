@@ -13,6 +13,52 @@ const defaultFs = fs;
 
 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+export function parseThresholds(thresholdStrings = []) {
+  const result = {};
+  const strs = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings].filter(Boolean);
+
+  for (const str of strs) {
+    const match = String(str).match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}" (expected format: metric=value, e.g., exact_match=0.9)`);
+    }
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value: ${minStr} (must be a number between 0 and 1)`);
+    }
+    result[metricId] = min;
+  }
+  return result;
+}
+
+export function evaluateThresholds(metrics = [], thresholds = {}) {
+  const metricIds = new Set(metrics.map((m) => m.id));
+  const thresholdList = [];
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!metricIds.has(metricId)) {
+      const validIds = Array.from(metricIds).sort();
+      throw new Error(
+        `Unknown metric: "${metricId}" (valid: ${validIds.join(', ')})`
+      );
+    }
+
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+
+    thresholdList.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return thresholdList;
+}
+
