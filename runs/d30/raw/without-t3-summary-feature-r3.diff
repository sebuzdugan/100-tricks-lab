+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import type { GateResult, Finding } from './schema.js';
+
+describe('renderSummary', () => {
+  it('returns BLOCK 0/7: structure when gate section is null', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [{ checkId: 'structure', severity: 'block', message: 'Missing gate', source: 'validator' }],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('returns PASS 7/7 with no findings', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN with warning findings only', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No threshold specified',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK with one block finding', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Missing risk tier',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('returns BLOCK with multiple block findings in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency disclosure',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 5/7: evaluation, transparency');
+  });
+
+  it('returns BLOCK with both block and warn findings, warnings do not count against answered', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'high',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'warn',
+          message: 'Mitigation is insufficient',
+          source: 'agent'
+        }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('deduplicates block findings by checkId', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing PII policy',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Retention period too long',
+          source: 'agent'
+        }
+      ],
+      gateSection: '## 5. Responsible AI Gate\n...'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+});
