+function parseAndValidateThresholds(thresholdStrings: string[] | undefined, validMetricIds: string[]): { thresholds: Record<string, number>; valid: boolean; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {}, valid: true };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^(.+)=(.+)$/);
+    if (!match) {
+      return {
+        thresholds: {},
+        valid: false,
+        error: `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number> (e.g., exact_match=0.9)`
+      };
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        thresholds: {},
+        valid: false,
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      return {
+        thresholds: {},
+        valid: false,
+        error: `Invalid threshold value: "${minStr}" for metric "${metricId}". Must be a number between 0 and 1.`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, valid: true };
+}
