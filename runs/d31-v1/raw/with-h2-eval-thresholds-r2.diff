+export function validateThresholds(thresholds, metrics) {
+  if (!thresholds || typeof thresholds !== 'object') {
+    return { allPassed: true, results: [] };
+  }
+
+  const metricMap = new Map(metrics.map(m => [m.id, m]));
+  const results = [];
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    if (!metricMap.has(metricId)) {
+      throw new Error(`Unknown metric id: ${metricId}`);
+    }
+    const metric = metricMap.get(metricId);
+    const passed = metric.score !== null && metric.score >= minValue;
+    results.push({
+      metric: metricId,
+      min: minValue,
+      score: metric.score,
+      passed
+    });
+  }
+
+  const allPassed = results.every(r => r.passed);
+  return { allPassed, results };
+}
+
 export function toJson(report) {
   return JSON.stringify(report, null, 2);
 }
