+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const [metric, valueStr] = str.split('=');
+    if (!metric || !valueStr) {
+      throw new Error(`Malformed threshold: '${str}' (expected format: metric=value)`);
+    }
+    const value = parseFloat(valueStr);
+    if (isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value: '${valueStr}' (must be a number between 0 and 1)`);
+    }
+    thresholds[metric] = value;
+  }
+  return thresholds;
+}
