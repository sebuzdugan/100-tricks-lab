+function parseAndValidateThresholds(thresholdStrings: string[] | undefined, availableMetricIds: string[]): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: { [key: string]: number } = {};
+  const errors: string[] = [];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`);
+      continue;
+    }
+
+    const metricId = match[1];
+    const minValue = parseFloat(match[2]);
+
+    if (minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold value for "${metricId}": ${minValue} (must be between 0 and 1)`);
+      continue;
+    }
+
+    if (!availableMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric: "${metricId}" (valid metrics: ${availableMetricIds.join(', ')})`);
+      continue;
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  if (errors.length > 0) {
+    log.error('Threshold validation failed:');
+    errors.forEach((err) => console.error(`  - ${err}`));
+    process.exit(2);
+  }
+
+  return thresholds;
+}
