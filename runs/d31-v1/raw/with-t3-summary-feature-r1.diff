@@ -0,0 +1,134 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+function makeResult(
+  verdict: GateResult['verdict'],
+  findings: Finding[] = [],
+  gateSection: string | null = 'test'
+): GateResult {
+  return {
+    verdict,
+    tier: verdict === 'PASS' || verdict === 'WARN' ? 'limited' : null,
+    findings,
+    gateSection
+  };
+}
+
+describe('renderSummary', () => {
+  it('renders a PASS verdict with all checks answered', () => {
+    const result = makeResult('PASS', []);
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('renders a WARN verdict with all checks answered', () => {
+    const result = makeResult('WARN', [
+      {
+        checkId: 'evaluation',
+        severity: 'warn',
+        message: 'No numbers in evaluation plan',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('renders a BLOCK verdict with answered and block checks', () => {
+    const result = makeResult('BLOCK', [
+      {
+        checkId: 'data-privacy',
+        severity: 'block',
+        message: 'Missing retention policy',
+        source: 'validator'
+      },
+      {
+        checkId: 'oversight',
+        severity: 'block',
+        message: 'Missing kill switch',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: data-privacy, oversight');
+  });
+
+  it('preserves GATE_CHECKS order when listing blocks', () => {
+    const result = makeResult('BLOCK', [
+      {
+        checkId: 'transparency',
+        severity: 'block',
+        message: 'Missing incident response plan',
+        source: 'validator'
+      },
+      {
+        checkId: 'bias',
+        severity: 'block',
+        message: 'No fairness analysis',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 5/7: bias, transparency');
+  });
+
+  it('returns special format for missing gate structure', () => {
+    const result = makeResult('BLOCK', [
+      {
+        checkId: 'structure',
+        severity: 'block',
+        message: 'No FRAI Gate section found',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores warnings when counting blocks', () => {
+    const result = makeResult('BLOCK', [
+      {
+        checkId: 'evaluation',
+        severity: 'warn',
+        message: 'No numbers in evaluation plan',
+        source: 'validator'
+      },
+      {
+        checkId: 'risk-tier',
+        severity: 'block',
+        message: 'Invalid tier value',
+        source: 'validator'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: risk-tier');
+  });
+
+  it('handles multiple blocks from same check', () => {
+    const result = makeResult('BLOCK', [
+      {
+        checkId: 'data-privacy',
+        severity: 'block',
+        message: 'Missing retention policy',
+        source: 'validator'
+      },
+      {
+        checkId: 'data-privacy',
+        severity: 'block',
+        message: 'PII handling unclear',
+        source: 'agent'
+      }
+    ]);
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('lists all blocked checks in order', () => {
+    const result = makeResult('BLOCK', [
+      { checkId: 'risk-tier', severity: 'block', message: 'Bad tier', source: 'validator' },
+      { checkId: 'data-privacy', severity: 'block', message: 'Bad privacy', source: 'validator' },
+      { checkId: 'oversight', severity: 'block', message: 'Bad oversight', source: 'validator' },
+      { checkId: 'evaluation', severity: 'block', message: 'Bad eval', source: 'validator' },
+      { checkId: 'bias', severity: 'block', message: 'Bad bias', source: 'validator' },
+      { checkId: 'monitoring', severity: 'block', message: 'Bad monitor', source: 'validator' },
+      { checkId: 'transparency', severity: 'block', message: 'Bad trans', source: 'validator' }
+    ]);
+    expect(renderSummary(result)).toBe(
+      'BLOCK 0/7: risk-tier, data-privacy, oversight, evaluation, bias, monitoring, transparency'
+    );
+  });
+});
