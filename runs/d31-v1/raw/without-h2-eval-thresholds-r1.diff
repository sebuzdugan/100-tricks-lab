+function parseAndValidateThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}" (use format: metric=0.9)`);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value: ${valueStr} (must be between 0 and 1)`);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
