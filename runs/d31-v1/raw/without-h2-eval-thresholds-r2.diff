+function validateThresholds(thresholds, metrics) {
+  if (!thresholds) return null;
+
+  const metricIds = new Set(metrics.map((m) => m.id));
+  const thresholdEntries = Object.entries(thresholds);
+
+  for (const [metricId, min] of thresholdEntries) {
+    if (!metricIds.has(metricId)) {
+      const validIds = Array.from(metricIds).sort();
+      const error = new Error(
+        `Unknown metric id "${metricId}". Valid metric ids are: ${validIds.join(', ')}`
+      );
+      error.code = 'UNKNOWN_METRIC';
+      error.validMetrics = validIds;
+      throw error;
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      const error = new Error(
+        `Invalid threshold for "${metricId}": minimum must be a number between 0 and 1, got ${min}`
+      );
+      error.code = 'INVALID_THRESHOLD_VALUE';
+      throw error;
+    }
+  }
+}
+
+function evaluateThresholds(thresholds, metrics) {
+  if (!thresholds) return { passed: true, thresholds: [] };
+
+  const metricMap = new Map(metrics.map((m) => [m.id, m]));
+  const thresholdResults = Object.entries(thresholds).map(([metricId, min]) => {
+    const metric = metricMap.get(metricId);
+    const score = metric?.score;
+    const passed = score !== null && score !== undefined && score >= min;
+
+    return {
+      metric: metricId,
+      min,
+      score,
+      passed
+    };
+  });
+
+  const allPassed = thresholdResults.every((t) => t.passed);
+
+  return {
+    passed: allPassed,
+    thresholds: thresholdResults
+  };
+}
