index 0000000..a4e370a
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.test.js
@@ -0,0 +1,114 @@
+import { describe, expect, it } from 'vitest';
+
+import { generateReport, runEvaluations } from './index.js';
+
+describe('Threshold evaluation', () => {
+  it('passes when all thresholds are met', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5,
+        length_variance: 0.8
+      }
+    });
+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds.every((t) => t.passed)).toBe(true);
+  });
+
+  it('fails when a threshold is not met', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'Goodbye'],
+      references: ['hello', 'world']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    const exact = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(exact.passed).toBe(false);
+    expect(exact.score).toBe(0.5);
+  });
+
+  it('fails threshold when metric score is null', () => {
+    const evaluations = [
+      {
+        id: 'exact_match',
+        label: 'Exact Match',
+        score: null,
+        total: 0,
+        matches: 0
+      }
+    ];
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: null,
+      thresholds: {
+        exact_match: 0.5
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    const exact = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(exact.score).toBe(null);
+    expect(exact.passed).toBe(false);
+  });
+
+  it('does not add thresholds when not provided', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json'
+    });
+
+    expect(report.passed).toBeUndefined();
+    expect(report.thresholds).toBeUndefined();
+  });
+
+  it('records threshold details accurately', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.8,
+        toxicity: 0.9
+      }
+    });
+
+    const exactThreshold = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(exactThreshold).toMatchObject({
+      metric: 'exact_match',
+      min: 0.8,
+      passed: true
+    });
+    expect(typeof exactThreshold.score).toBe('number');
+  });
+});
