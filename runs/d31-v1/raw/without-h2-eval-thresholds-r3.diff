+function parseThresholds(thresholdArgs: string[] | undefined, validMetricIds: string[]) {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${arg}". Expected format: metric=number`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (value < 0 || value > 1) {
+      log.error(`Invalid threshold value for "${metricId}": ${value}. Must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
