+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult } from './schema.js';
+
+describe('renderSummary', () => {
+  it('renders PASS with all checks answered', () => {
+    const result: GateResult = {
+      verdict: 'PASS',
+      tier: 'limited',
+      findings: [],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('renders WARN with only warnings', () => {
+    const result: GateResult = {
+      verdict: 'WARN',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('renders BLOCK with structure missing', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No gate section',
+          source: 'validator'
+        }
+      ],
+      gateSection: null
+    };
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('renders BLOCK with single check failed', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Empty field',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('renders BLOCK with multiple checks failed in GATE_CHECKS order', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Empty field',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Empty field',
+          source: 'validator'
+        },
+        {
+          checkId: 'risk-tier',
+          severity: 'block',
+          message: 'Invalid tier',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 4/7: risk-tier, evaluation, transparency');
+  });
+
+  it('deduplicates block checkIds', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: null,
+      findings: [
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing field 1',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing field 2',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: data-privacy');
+  });
+
+  it('mixes block and warn findings, counts only blocks', () => {
+    const result: GateResult = {
+      verdict: 'BLOCK',
+      tier: 'limited',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Empty field',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'No numbers',
+          source: 'validator'
+        },
+        {
+          checkId: 'bias',
+          severity: 'warn',
+          message: 'No numbers',
+          source: 'validator'
+        }
+      ],
+      gateSection: 'some text'
+    };
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
