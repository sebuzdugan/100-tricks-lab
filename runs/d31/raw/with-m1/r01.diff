@@ -0,0 +1,81 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create an invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Validate issue date format and validity
+  const dateResult = validateDate(issueDate);
+  if (!dateResult.ok) {
+    return dateResult;
+  }
+
+  // Validate lines is not empty
+  if (!lines || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Build and validate invoice lines
+  const invoiceLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Look up product
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) {
+      return productResult;
+    }
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
+
+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * @param {string} dateStr
+ * @returns {{ ok: true } | { ok: false, error: string }}
+ */
+function validateDate(dateStr) {
+  // Check format YYYY-MM-DD
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Parse and validate the date is real
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const [year, month, day] = dateStr.split('-').map(Number);
+
+  // Check if the date is valid by verifying the parsed values match
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() + 1 !== month || date.getUTCDate() !== day) {
+    return fail('DATE_INVALID');
+  }
+
+  return ok({});
+}
