+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('creates an invoice with valid data', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }, { sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2025-01-15');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 2);
+
+  const line1 = r.value.lines[0];
+  assert.equal(line1.sku, 'DES-HOUR');
+  assert.equal(line1.name, 'Design work (hour)');
+  assert.equal(line1.qty, 10);
+  assert.equal(line1.unitPrice, 8500);
+  assert.equal(line1.vatRate, 21);
+
+  const line2 = r.value.lines[1];
+  assert.equal(line2.sku, 'DEV-HOUR');
+  assert.equal(line2.name, 'Development (hour)');
+  assert.equal(line2.qty, 5);
+  assert.equal(line2.unitPrice, 9500);
+  assert.equal(line2.vatRate, 21);
+});
+
+test('creates an invoice with a single line', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-02-28',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].unitPrice, 120000);
+});
+
+test('returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('returns DATE_INVALID for invalid date format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '15-01-2025',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('returns DATE_INVALID for malformed date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: 'not-a-date',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('returns DATE_INVALID for impossible date like Feb 30', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('returns DATE_INVALID for day 00', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-00',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('returns NO_LINES for empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('returns NO_LINES for null lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: null,
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('returns QTY_INVALID for zero quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('returns QTY_INVALID for negative quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('returns QTY_INVALID for fractional quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('returns UNKNOWN_SKU for a SKU not in catalogue', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'NOPE-SKU', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('returns UNKNOWN_SKU even with valid lines before it', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }, { sku: 'INVALID', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('includes products with different VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 }, // vatRate 21
+      { sku: 'PRINT-A4', qty: 100 }, // vatRate 9
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // vatRate 0
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].vatRate, 21);
+  assert.equal(r.value.lines[1].vatRate, 9);
+  assert.equal(r.value.lines[2].vatRate, 0);
+});
+
+test('does not mutate input lines', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const linesCopy = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines,
+  });
+
+  assert.deepEqual(lines, linesCopy);
+});
+
+test('accepts valid date at year boundary (Jan 1)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.issueDate, '2025-01-01');
+});
+
+test('accepts valid date at year boundary (Dec 31)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-31',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.issueDate, '2025-12-31');
+});
+
+test('accepts leap year date (Feb 29 on leap year)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+});
+
+test('rejects leap year date on non-leap year (Feb 29 on non-leap year)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-29',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
