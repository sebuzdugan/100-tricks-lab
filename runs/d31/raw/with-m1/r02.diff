--- a/src/invoices.js
+++ b/src/invoices.js
@@ -1,4 +1,5 @@
 import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
 import { getCustomer } from './customers.js';
 import { getProduct } from './catalogue.js';
 
@@ -79,3 +80,25 @@ function validateDate(dateStr) {
 
   return ok({});
 }
+
+/**
+ * Calculate the total for one line: qty times unitPrice.
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number }> }}
+ * @returns {{ subtotal: number, total: number }} Amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  return {
+    subtotal,
+    total: subtotal,
+  };
+}
