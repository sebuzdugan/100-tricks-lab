+/**
+ * Issue a draft invoice, assigning it a number and changing status to 'issued'.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @param {Array<string>} existingNumbers - Invoice numbers already issued
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, number: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check status is draft
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Generate next invoice number
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: 'issued',
+    number,
+    lines: invoice.lines.map((line) => ({ ...line })),
+  });
+}
