diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..2f6dbab
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,107 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2025-01-15');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-06-20');
+
+  assert.equal(number, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existingNumbers = [
+    'INV-2025-0001',
+    'INV-2025-0099',
+    'INV-2025-0500',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2025-12-31');
+
+  assert.equal(number, 'INV-2025-0501');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existingNumbers = ['INV-2025-0009'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-02-01');
+
+  assert.equal(number, 'INV-2025-0010');
+});
+
+test('nextInvoiceNumber resets counter for different year', () => {
+  const existingNumbers = [
+    'INV-2024-0100',
+    'INV-2024-0101',
+    'INV-2025-0005',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-01-01');
+
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = [
+    'INV-2024-9999',
+    'INV-2025-0010',
+    'INV-2026-0005',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2025-06-15');
+
+  assert.equal(number, 'INV-2025-0011');
+});
+
+test('nextInvoiceNumber works with unordered existing numbers', () => {
+  const existingNumbers = [
+    'INV-2025-0005',
+    'INV-2025-0001',
+    'INV-2025-0003',
+    'INV-2025-0002',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2025-01-01');
+
+  assert.equal(number, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber finds max counter across years', () => {
+  const existingNumbers = [
+    'INV-2023-0050',
+    'INV-2024-1000',
+    'INV-2025-0099',
+    'INV-2026-0001',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-15');
+
+  assert.equal(number, 'INV-2024-1001');
+});
+
+test('nextInvoiceNumber handles year at start or end of range', () => {
+  const existingNumbers = ['INV-1999-0001', 'INV-2099-0001'];
+  const number1 = nextInvoiceNumber(existingNumbers, '1999-12-31');
+  const number2 = nextInvoiceNumber(existingNumbers, '2099-01-01');
+
+  assert.equal(number1, 'INV-1999-0002');
+  assert.equal(number2, 'INV-2099-0002');
+});
+
+test('nextInvoiceNumber does not mutate input array', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+  const original = JSON.parse(JSON.stringify(existingNumbers));
+
+  nextInvoiceNumber(existingNumbers, '2025-06-15');
+
+  assert.deepEqual(existingNumbers, original);
+});
+
+test('nextInvoiceNumber with empty existing numbers and specific date', () => {
+  const number1 = nextInvoiceNumber([], '2020-01-01');
+  const number2 = nextInvoiceNumber([], '2020-12-31');
+  const number3 = nextInvoiceNumber([], '2099-06-15');
+
+  assert.equal(number1, 'INV-2020-0001');
+  assert.equal(number2, 'INV-2020-0001');
+  assert.equal(number3, 'INV-2099-0001');
+});
