+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<counter>, where counter has 4 digits, zero-padded.
+ * Counter starts at 0001 each year.
+ * @param {Array<string>} existingNumbers - Invoice numbers already used (e.g., ['INV-2025-0001', 'INV-2024-0005'])
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} Next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+
+  // Filter for numbers from this year
+  const thisYearPattern = new RegExp(`^INV-${year}-\\d{4}$`);
+  const thisYearNumbers = existingNumbers.filter((n) => thisYearPattern.test(n));
+
+  if (thisYearNumbers.length === 0) {
+    return `INV-${year}-0001`;
+  }
+
+  // Extract counters and find the maximum
+  const counters = thisYearNumbers.map((n) => {
+    const match = /INV-\d{4}-(\d{4})/.exec(n);
+    return match ? parseInt(match[1], 10) : 0;
+  });
+
+  const maxCounter = Math.max(...counters);
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
