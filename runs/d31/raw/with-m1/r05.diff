+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = renderInvoiceText(issued);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /^INV-2025-0001\n/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText formats line with qty, name, price, and total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  // Line should be: qty x name @ unitPrice = lineTotal
+  assert.match(lines[2], /^10 x Design work \(hour\) @ €85\.00 = €850\.00$/);
+});
+
+test('renderInvoiceText includes total at the end', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  assert.match(lines[lines.length - 1], /^Total: €425\.00$/);
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 5); // number, customer, 2 lines, total
+  assert.match(lines[2], /^10 x Design work \(hour\)/);
+  assert.match(lines[3], /^5 x Development \(hour\)/);
+  assert.match(lines[4], /^Total: €1,325\.00$/);
+});
+
+test('renderInvoiceText formats large amounts with thousands separators', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+
+  // €120,000 * 2 = €2,400.00
+  assert.match(text, /€2,400\.00/);
+});
+
+test('renderInvoiceText returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('renderInvoiceText uses formatEuros for all amounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'ICON-SET', qty: 50 }, // unitPrice: 980 cents = €9.80, qty 50 = €490.00
+      { sku: 'STICKER', qty: 100 }, // unitPrice: 50 cents = €0.50, qty 100 = €50.00
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+
+  // Verify amounts are formatted with € and decimal places
+  assert.match(text, /€9\.80/); // 980 cents = 9.80 euros per unit
+  assert.match(text, /€490\.00/); // 50 * 980 cents = 49000 cents = 490.00 euros
+  assert.match(text, /€50\.00/); // 100 * 50 cents = 5000 cents = 50.00 euros
+  assert.match(text, /€540\.00/); // total: 490 + 50
+});
+
+test('renderInvoiceText preserves line order', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /Design work/);
+  assert.match(lines[3], /Development/);
+  assert.match(lines[4], /Copywriting/);
+});
+
+test('renderInvoiceText with customer having special characters in name', () => {
+  // C-006 is "Marlow \"The Print Shop\""
+  const invoice = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Marlow "The Print Shop"');
+});
+
+test('renderInvoiceText with single line item', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4); // number, customer, 1 line, total
+  assert.match(lines[2], /^1 x Brand workshop/);
+  assert.match(lines[3], /^Total: €600\.00$/);
+});
+
+test('renderInvoiceText with zero-padded line quantities', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'STICKER', qty: 5 },
+      { sku: 'STICKER', qty: 5 }, // Adding same SKU twice should increase qty
+    ],
+  }).value;
+
+  // Actually, createInvoice won't have duplicates. Let me just test with 5 qty
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'STICKER', qty: 5 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice2);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+
+  // 5 * 50 cents = 250 cents = €2.50
+  assert.match(text, /€2\.50/);
+});
+
+test('renderInvoiceText issued invoice has all sections in order', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-20',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = renderInvoiceText(issued);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  // Verify structure
+  assert.match(lines[0], /^INV-2025-0001$/);
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.match(lines[2], /^8 x Development/);
+  assert.match(lines[3], /^2 x Copywriting/);
+  assert.match(lines[4], /^Total:/);
+});
