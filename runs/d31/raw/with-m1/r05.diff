+import { ok, fail } from './result.js';
+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals, lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, number?: string, lines: Array }} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  const customer = customerResult.value;
+  const number = invoice.number || 'DRAFT';
+
+  // Build lines
+  const lines = [
+    number,
+    customer.name,
+  ];
+
+  // Add invoice lines
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Add total
+  const { total } = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return ok(lines.join('\n'));
+}
