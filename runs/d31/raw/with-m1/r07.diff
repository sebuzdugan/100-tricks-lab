+test('createInvoice explicit discountPercent overrides gold tier discount', () => {
+  // C-001 is gold (5%), but we provide 10%
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice explicit 0% discount overrides gold tier discount', () => {
+  // C-001 is gold (5%), but we explicitly provide 0%
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice with multiple lines: mixed tier and explicit discounts', () => {
+  // C-001 is gold tier (5%)
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 }, // No discount specified, uses tier 5%
+      { sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }, // Explicit 10%
+      { sku: 'ICON-SET', qty: 2, discountPercent: 0 }, // Explicit 0%
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5); // tier discount
+  assert.equal(r.value.lines[1].discountPercent, 10); // explicit
+  assert.equal(r.value.lines[2].discountPercent, 0); // explicit
+});
+
+test('invoiceTotals with gold tier discount applied to line', () => {
+  // C-001 is gold tier (5% discount)
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }], // 85000 cents, 5% discount = 4250
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000, discount: 4250 (5% of 85000)
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.total, 80750);
+});
+
+test('invoiceTotals with silver tier discount applied to line', () => {
+  // C-003 is silver tier (2.5% discount)
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }], // 85000 cents, 2.5% discount = 2125
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000, discount: 2125 (2.5% of 85000)
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 2125);
+  assert.equal(totals.total, 82875);
+});
+
+test('invoiceTotals with multiple lines: tier and explicit discounts', () => {
+  // C-001 is gold tier (5%)
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 }, // 85000, 5% discount = 4250
+      { sku: 'DEV-HOUR', qty: 5, discountPercent: 20 }, // 47500, 20% discount = 9500
+    ],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000 + 47500 = 132500
+  // discount: 4250 + 9500 = 13750
+  // total: 132500 - 13750 = 118750
+  assert.equal(totals.subtotal, 132500);
+  assert.equal(totals.discount, 13750);
+  assert.equal(totals.total, 118750);
+});
