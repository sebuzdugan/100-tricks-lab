+  // C-003 (Kite & Co) is silver tier
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount (0%) when no discountPercent provided', () => {
+  // C-002 (Blue Fern Bakery) is standard tier
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(r.ok, true);
