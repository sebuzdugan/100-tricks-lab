+/**
+ * Check if a date string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+
+  // Check format YYYY-MM-DD
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) {
+    return false;
+  }
+
+  // Parse and validate the date is real (in UTC)
+  const date = new Date(text + 'T00:00:00Z');
+  const [year, month, day] = text.split('-').map(Number);
+
+  // Check if the date is valid by verifying the parsed values match
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() + 1 !== month || date.getUTCDate() !== day) {
+    return false;
+  }
+
+  return true;
+}
+
+/**
+ * Add n days to a date string and return the new date string in YYYY-MM-DD format.
+ * Arithmetic is done in UTC.
+ * @param {string} date Date in YYYY-MM-DD format
+ * @param {number} n Number of days to add (can be negative)
+ * @returns {string} New date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+
+  const year = d.getUTCFullYear();
+  const month = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate the number of whole days between two dates (b minus a).
+ * Arithmetic is done in UTC.
+ * @param {string} a Date in YYYY-MM-DD format
+ * @param {string} b Date in YYYY-MM-DD format
+ * @returns {number} Number of days (b - a), rounded down
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+
+  const timeMs = dateB - dateA;
+  const days = Math.floor(timeMs / (1000 * 60 * 60 * 24));
+
+  return days;
+}
