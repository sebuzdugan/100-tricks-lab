diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..5368424
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,131 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-01-15'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('2000-01-01'), true);
+});
+
+test('isValidDate rejects invalid date format', () => {
+  assert.equal(isValidDate('15-01-2025'), false);
+  assert.equal(isValidDate('2025/01/15'), false);
+  assert.equal(isValidDate('2025-1-15'), false);
+  assert.equal(isValidDate('2025-01-5'), false);
+});
+
+test('isValidDate rejects malformed dates', () => {
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+  assert.equal(isValidDate('2025-01-32'), false);
+  assert.equal(isValidDate('2025-02-30'), false); // Feb 30 doesn't exist
+});
+
+test('isValidDate rejects invalid leap year', () => {
+  assert.equal(isValidDate('2025-02-29'), false); // 2025 is not a leap year
+  assert.equal(isValidDate('2023-02-29'), false); // 2023 is not a leap year
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(12345), false);
+  assert.equal(isValidDate({}), false);
+});
+
+test('isValidDate rejects empty string', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('   '), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-01-15', 1), '2025-01-16');
+  assert.equal(addDays('2025-01-15', 5), '2025-01-20');
+  assert.equal(addDays('2025-01-15', 10), '2025-01-25');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2025-12-25', 7), '2026-01-01');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2025-01-15', -1), '2025-01-14');
+  assert.equal(addDays('2025-01-15', -5), '2025-01-10');
+});
+
+test('addDays handles negative days across boundaries', () => {
+  assert.equal(addDays('2025-02-01', -1), '2025-01-31');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2025-01-15', 0), '2025-01-15');
+});
+
+test('daysBetween calculates days correctly', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-16'), 1);
+  assert.equal(daysBetween('2025-01-15', '2025-01-20'), 5);
+  assert.equal(daysBetween('2025-01-15', '2025-02-15'), 31);
+});
+
+test('daysBetween with same date returns zero', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-15'), 0);
+});
+
+test('daysBetween with reversed dates returns negative', () => {
+  assert.equal(daysBetween('2025-01-20', '2025-01-15'), -5);
+  assert.equal(daysBetween('2025-02-15', '2025-01-15'), -31);
+});
+
+test('daysBetween across month boundaries', () => {
+  assert.equal(daysBetween('2025-01-31', '2025-02-01'), 1);
+  assert.equal(daysBetween('2025-02-01', '2025-03-01'), 28);
+});
+
+test('daysBetween across year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
+
+test('daysBetween across leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const start = '2025-01-15';
+  const days = 42;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+  assert.equal(addDays(end, -days), start);
+});
+
+test('isValidDate with boundary dates', () => {
+  assert.equal(isValidDate('1900-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+  assert.equal(isValidDate('9999-12-31'), true);
+});
+
+test('addDays works across multiple years', () => {
+  assert.equal(addDays('2025-01-01', 365), '2026-01-01');
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01'); // leap year
+});
+
+test('daysBetween works across multiple years', () => {
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // leap year
+});
