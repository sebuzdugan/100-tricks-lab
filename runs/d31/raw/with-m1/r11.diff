+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue, totalPaid } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('balanceDue equals total when no payments made', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const { total } = invoiceTotals(invoice);
+  assert.equal(balanceDue(invoice), total);
+});
+
+test('balanceDue decreases with each payment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const { total } = invoiceTotals(invoice);
+
+  const halfPayment = Math.floor(total / 2);
+  const r1 = recordPayment(invoice, { amount: halfPayment, date: '2025-01-20' });
+  assert.equal(r1.ok, true);
+  assert.equal(balanceDue(r1.value), total - halfPayment);
+
+  const r2 = recordPayment(r1.value, { amount: halfPayment, date: '2025-01-25' });
+  assert.equal(r2.ok, true);
+  assert.equal(balanceDue(r2.value), 0);
+});
+
+test('recordPayment sets status to partially_paid with partial payment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: Math.floor(total / 2), date: '2025-01-20' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when full amount paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: total, date: '2025-01-20' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment adds payment to payments array', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: Math.floor(total / 2), date: '2025-01-20' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, Math.floor(total / 2));
+  assert.equal(r.value.payments[0].date, '2025-01-20');
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: 1000, date: '2025-01-20' });
+  assert.equal(r.ok, true);
+  assert.ok(Array.isArray(r.value.payments));
+  assert.equal(r.value.payments.length, 1);
+});
+
+test('recordPayment accumulates multiple payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const { total } = invoiceTotals(invoice);
+
+  const payment1 = Math.floor(total / 3);
+  const payment2 = Math.floor(total / 3);
+  const payment3 = total - payment1 - payment2;
+
+  const r1 = recordPayment(invoice, { amount: payment1, date: '2025-01-20' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.payments.length, 1);
+
+  const r2 = recordPayment(r1.value, { amount: payment2, date: '2025-01-25' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.payments.length, 2);
+
+  const r3 = recordPayment(r2.value, { amount: payment3, date: '2025-01-30' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 3);
+  assert.equal(r3.value.status, 'paid');
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const r = recordPayment(invoice, { amount: 1000, date: '2025-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects payment on already paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'paid',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+    payments: [{ amount: 121000, date: '2025-01-20' }],
+  };
+
+  const r = recordPayment(invoice, { amount: 1000, date: '2025-01-25' });
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const r = recordPayment(invoice, { amount: 100.5, date: '2025-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects zero amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const r = recordPayment(invoice, { amount: 0, date: '2025-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects negative amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const r = recordPayment(invoice, { amount: -1000, date: '2025-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: total + 1, date: '2025-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment accepts payment on partially_paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'partially_paid',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+    payments: [{ amount: 5000, date: '2025-01-20' }],
+  };
+  const { total } = invoiceTotals(invoice);
+  const remaining = total - 5000;
+
+  const r = recordPayment(invoice, { amount: remaining, date: '2025-01-25' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    number: 'INV-2025-001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  recordPayment(invoice, { amount: 1000, date: '2025-01-20' });
+  assert.equal(invoice.status, 'issued');
+  assert.equal(invoice.payments, undefined);
+});
+
+test('totalPaid returns 0 when no payments', () => {
