+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the total amount paid on an invoice.
+ * @param {{ payments?: Array<{ amount: number, date: string }> }}
+ * @returns {number} Total paid in cents
+ */
+export function totalPaid(invoice) {
+  if (!invoice.payments || invoice.payments.length === 0) {
+    return 0;
+  }
+  return invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+}
+
+/**
+ * Calculate the balance still owed on an invoice.
+ * @param {{ lines: Array, payments?: Array<{ amount: number, date: string }> }}
+ * @returns {number} Balance due in cents
+ */
+export function balanceDue(invoice) {
+  const { total } = invoiceTotals(invoice);
+  return Math.max(0, total - totalPaid(invoice));
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array, payments: Array<{ amount: number, date: string }> } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate status is issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total and calculate balance due
+  const { total } = invoiceTotals(invoice);
+  const paid = totalPaid(invoice);
+  const stillOwed = total - paid;
+
+  // Check for overpayment
+  if (amount > stillOwed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Add payment to payments array
+  const payments = invoice.payments ? [...invoice.payments] : [];
+  payments.push({ amount, date });
+
+  // Calculate new balance
+  const newPaid = paid + amount;
+  const newBalance = total - newPaid;
+
+  // Determine new status
+  const status = newBalance <= 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status,
+    number: invoice.number,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments,
+  });
+}
