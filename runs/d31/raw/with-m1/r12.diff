+/**
+ * Calculate the due date based on payment terms and issue date.
+ * @param {string} issueDate Date in YYYY-MM-DD format
+ * @param {string} terms 'NET14', 'NET30', or 'EOM'
+ * @returns {string} Due date in YYYY-MM-DD format
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    // Last day of the month of issueDate
+    const d = new Date(issueDate + 'T00:00:00Z');
+    const year = d.getUTCFullYear();
+    const month = d.getUTCMonth();
+    const lastDay = new Date(Date.UTC(year, month + 1, 0));
+    const day = String(lastDay.getUTCDate()).padStart(2, '0');
+    const monthStr = String(month + 1).padStart(2, '0');
+    return `${year}-${monthStr}-${day}`;
+  }
+  return null;
+}
