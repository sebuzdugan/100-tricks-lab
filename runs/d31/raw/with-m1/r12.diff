+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('createInvoice with NET30 (default)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'NET30');
+  assert.equal(r.value.dueDate, '2025-02-14');
+});
+
+test('createInvoice with explicit NET30', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'NET30');
+  assert.equal(r.value.dueDate, '2025-02-14');
+});
+
+test('createInvoice with NET14', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
