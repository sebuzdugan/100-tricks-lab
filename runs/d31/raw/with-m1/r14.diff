+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { isValidDate, daysBetween } from './dates.js';
+
+/**
+ * Generate a customer statement.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }>} invoices
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate?: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize customer ID
+  const normalizedCustomerId = normalizeId(customerId);
+
+  // Validate customer exists
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Validate asOf date
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Filter invoices for this customer
+  const customerInvoices = invoices.filter((inv) => {
+    // Must be issued, partially_paid, or paid
+    if (inv.status !== 'issued' && inv.status !== 'partially_paid' && inv.status !== 'paid') {
+      return false;
+    }
+
+    // Must belong to this customer
+    if (normalizeId(inv.customerId) !== normalizedCustomerId) {
+      return false;
+    }
+
+    // Issue date must be on or before asOf
+    if (daysBetween(inv.issueDate, asOf) < 0) {
+      return false;
+    }
+
+    return true;
+  });
+
+  // Map invoices to statement format and calculate due
+  const statementInvoices = customerInvoices.map((inv) => {
+    const { total } = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    return {
+      number: inv.number,
+      issueDate: inv.issueDate,
+      ...(inv.dueDate && { dueDate: inv.dueDate }),
+      total,
+      due,
+    };
+  });
+
+  // Sort by issueDate
+  statementInvoices.sort((a, b) => {
+    if (a.issueDate < b.issueDate) return -1;
+    if (a.issueDate > b.issueDate) return 1;
+    return 0;
+  });
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
