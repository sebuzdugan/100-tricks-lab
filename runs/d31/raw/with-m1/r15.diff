diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..228176c
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,273 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoice(customerId, issueDate) {
+  const draft = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  if (!draft.ok) throw new Error('Failed to create draft invoice');
+  return issueInvoice(draft.value, []);
+}
+
+test('createCreditNote returns credit note with required fields', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r = createCreditNote(inv.value, { amount: 5000, reason: 'Overpayment', date: '2025-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.ok(r.value.number);
+  assert.equal(r.value.invoiceNumber, inv.value.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Overpayment');
+  assert.equal(r.value.date, '2025-01-20');
+});
+
+test('createCreditNote generates CN prefix number', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r = createCreditNote(inv.value, { amount: 5000, reason: 'Overpayment', date: '2025-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number.startsWith('CN-'), true);
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(draft.ok, true);
+
+  const r = createCreditNote(draft.value, { amount: 5000, reason: 'Overpayment', date: '2025-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r = createCreditNote(inv.value, { amount: 5000.5, reason: 'Overpayment', date: '2025-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r = createCreditNote(inv.value, { amount: 0, reason: 'Overpayment', date: '2025-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r = createCreditNote(inv.value, { amount: -5000, reason: 'Overpayment', date: '2025-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects credit amount exceeding invoice total', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const { total } = invoiceTotals(inv.value);
+  const r = createCreditNote(inv.value, { amount: total + 1, reason: 'Overpayment', date: '2025-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote accepts credit equal to invoice total', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const { total } = invoiceTotals(inv.value);
+  const r = createCreditNote(inv.value, { amount: total, reason: 'Full refund', date: '2025-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, total);
+});
+
+test('createCreditNote with invalid date', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r = createCreditNote(inv.value, { amount: 5000, reason: 'Overpayment', date: '2025-13-01' }, []);
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote on issued invoice', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+  assert.equal(inv.value.status, 'issued');
+
+  const r = createCreditNote(inv.value, { amount: 5000, reason: 'Overpayment', date: '2025-01-20' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote on partially_paid invoice', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const partial = recordPayment(inv.value, { amount: 50000, date: '2025-01-18' });
+  assert.equal(partial.ok, true);
+  assert.equal(partial.value.status, 'partially_paid');
+
+  const r = createCreditNote(partial.value, { amount: 5000, reason: 'Partial refund', date: '2025-01-20' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote on paid invoice', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const { total } = invoiceTotals(inv.value);
+  const paid = recordPayment(inv.value, { amount: total, date: '2025-01-18' });
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.status, 'paid');
+
+  const r = createCreditNote(paid.value, { amount: 5000, reason: 'Overpayment', date: '2025-01-20' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('nextCreditNoteNumber starts at CN-2025-0001', () => {
+  const number = nextCreditNoteNumber([], '2025-03-15');
+  assert.equal(number, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber increments within same year', () => {
+  const existingNumbers = ['CN-2025-0001', 'CN-2025-0002'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-03-15');
+  assert.equal(number, 'CN-2025-0003');
+});
+
+test('nextCreditNoteNumber separate counter from invoices', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-03-15');
+  assert.equal(number, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber resets counter for new year', () => {
+  const existingNumbers = ['CN-2025-0001', 'CN-2025-0002', 'CN-2025-0003'];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-03-15');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber with mixed invoice and credit numbers', () => {
+  const existingNumbers = [
+    'INV-2025-0001',
+    'CN-2025-0001',
+    'INV-2025-0002',
+    'CN-2025-0002',
+    'INV-2025-0003',
+  ];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-03-15');
+  assert.equal(number, 'CN-2025-0003');
+});
+
+test('nextCreditNoteNumber zero-pads counter to 4 digits', () => {
+  const existingNumbers = ['CN-2025-0099'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-03-15');
+  assert.equal(number, 'CN-2025-0100');
+});
+
+test('createCreditNote with various reasons', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r1 = createCreditNote(inv.value, { amount: 1000, reason: 'Product defect', date: '2025-01-20' }, []);
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.reason, 'Product defect');
+
+  const r2 = createCreditNote(inv.value, { amount: 1000, reason: 'Late delivery - 10% discount', date: '2025-01-20' }, []);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.reason, 'Late delivery - 10% discount');
+
+  const r3 = createCreditNote(inv.value, { amount: 1000, reason: 'Customer requested cancellation', date: '2025-01-20' }, []);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.reason, 'Customer requested cancellation');
+});
+
+test('createCreditNote credit note date independent of invoice issue date', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r1 = createCreditNote(inv.value, { amount: 5000, reason: 'Refund', date: '2025-01-20' }, []);
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.date, '2025-01-20');
+
+  const r2 = createCreditNote(inv.value, { amount: 5000, reason: 'Refund', date: '2025-02-01' }, []);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.date, '2025-02-01');
+});
+
+test('createCreditNote multiple credit notes for same invoice', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r1 = createCreditNote(inv.value, { amount: 5000, reason: 'Partial refund', date: '2025-01-20' }, []);
+  assert.equal(r1.ok, true);
+
+  const r2 = createCreditNote(inv.value, { amount: 3000, reason: 'Additional discount', date: '2025-01-25' }, []);
+  assert.equal(r2.ok, true);
+
+  assert.equal(r1.value.invoiceNumber, r2.value.invoiceNumber);
+});
+
+test('createCreditNote credit note amount in cents', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r = createCreditNote(inv.value, { amount: 299, reason: 'Discount', date: '2025-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, 299);
+});
+
+test('createCreditNote preserves customerid', () => {
+  const inv = createTestInvoice('C-003', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r = createCreditNote(inv.value, { amount: 5000, reason: 'Refund', date: '2025-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-003');
+});
+
+test('createCreditNote includes all invoice info in credit note', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const r = createCreditNote(inv.value, { amount: 5000, reason: 'Refund', date: '2025-01-20' }, ['CN-2025-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2025-0002');
+  assert.equal(r.value.invoiceNumber, inv.value.number);
+  assert.equal(r.value.customerId, inv.value.customerId);
+});
+
+test('createCreditNote with invoice containing discount and VAT', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+  assert.equal(draft.ok, true);
+
+  const inv = issueInvoice(draft.value, []);
+  assert.equal(inv.ok, true);
+
+  const { total } = invoiceTotals(inv.value);
+  const r = createCreditNote(inv.value, { amount: Math.floor(total / 2), reason: 'Partial refund', date: '2025-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, Math.floor(total / 2));
+});
+
+test('nextCreditNoteNumber uses date year for numbering', () => {
+  const existingNumbers = [];
+  const r1 = nextCreditNoteNumber(existingNumbers, '2025-01-15');
+  const r2 = nextCreditNoteNumber(existingNumbers, '2026-01-15');
+  assert.equal(r1, 'CN-2025-0001');
+  assert.equal(r2, 'CN-2026-0001');
+});
