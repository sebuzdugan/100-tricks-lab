+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate the next credit note number for a given year.
+ * Format: CN-<year>-<counter>, where counter has 4 digits, zero-padded.
+ * Counter starts at 0001 each year, independent of invoice numbers.
+ * @param {Array<string>} existingNumbers - All numbers already used (invoices and credit notes)
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} Next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+
+  // Filter for credit note numbers from this year
+  const thisYearPattern = new RegExp(`^CN-${year}-\\d{4}$`);
+  const thisYearNumbers = existingNumbers.filter((n) => thisYearPattern.test(n));
+
+  if (thisYearNumbers.length === 0) {
+    return `CN-${year}-0001`;
+  }
+
+  // Extract counters and find the maximum
+  const counters = thisYearNumbers.map((n) => {
+    const match = /CN-\d{4}-(\d{4})/.exec(n);
+    return match ? parseInt(match[1], 10) : 0;
+  });
+
+  const maxCounter = Math.max(...counters);
+  const nextCounter = maxCounter + 1;
+
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ customerId: string, number?: string, issueDate: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ amount: number, reason: string, date: string }}
+ * @param {Array<string>} existingNumbers - All numbers already used (invoices and credit notes)
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice is issued, partially_paid, or paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate credit note date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Check credit amount doesn't exceed invoice total
+  const { total } = invoiceTotals(invoice);
+  if (amount > total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
