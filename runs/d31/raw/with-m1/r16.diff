+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Find invoices that are overdue.
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }>} invoices
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = invoices
+    .filter((inv) => {
+      // Must be issued or partially_paid
+      if (inv.status !== 'issued' && inv.status !== 'partially_paid') {
+        return false;
+      }
+
+      // Must have a due date
+      if (!inv.dueDate) {
+        return false;
+      }
+
+      // Due date must be before asOf
+      if (inv.dueDate >= asOf) {
+        return false;
+      }
+
+      return true;
+    })
+    .map((inv) => {
+      const daysOverdue = daysBetween(inv.dueDate, asOf);
+      const due = balanceDue(inv);
+
+      return {
+        number: inv.number,
+        customerId: inv.customerId,
+        dueDate: inv.dueDate,
+        daysOverdue,
+        due,
+      };
+    })
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
