   return overdue;
 }
+
+/**
+ * Generate a VAT summary across invoices.
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Grouped by VAT rate, sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    // Filter by status
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    // Process each line
+    for (const line of invoice.lines) {
+      // Get product to get unitPrice
+      const productResult = getProduct(line.sku);
+      if (!productResult.ok) continue;
+
+      const product = productResult.value;
+      const enrichedLine = {
+        qty: line.qty,
+        unitPrice: product.unitPrice,
+        discountPercent: line.discountPercent,
+        vatRate: line.vatRate,
+      };
+
+      // Calculate line amounts
+      const total = lineTotal(enrichedLine);
+      const discount = lineDiscount(enrichedLine);
+      const base = Math.max(0, total - discount);
+      const vat = lineVAT(enrichedLine);
+
+      // Accumulate by VAT rate
+      const vatRate = line.vatRate;
+      if (!vatMap.has(vatRate)) {
+        vatMap.set(vatRate, { base: 0, vat: 0 });
+      }
+      const entry = vatMap.get(vatRate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  // Convert to array and sort by rate descending
+  return Array.from(vatMap.entries())
+    .map(([rate, { base, vat }]) => ({ rate, base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+}
