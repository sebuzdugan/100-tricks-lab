+/**
+ * Calculate late fee on an invoice: 0.04% of balance due per day overdue.
+ * @param {{ customerId: string, number?: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }} invoice
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  // Draft invoices don't have late fees
+  if (invoice.status === 'draft') {
+    return 0;
+  }
+
+  // Check if invoice has a due date
+  if (!invoice.dueDate) {
+    return 0;
+  }
+
+  // Check if invoice is overdue
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // Calculate balance due
+  const due = balanceDue(invoice);
+
+  // If no balance due, no late fee
+  if (due <= 0) {
+    return 0;
+  }
+
+  // Calculate late fee: 0.04% per day = 0.0004 per day
+  const fee = roundCents(due * daysOverdue * 0.0004);
+
+  return Math.max(0, fee);
+}
