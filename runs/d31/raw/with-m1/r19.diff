+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format an amount in cents as euros with 2 decimal places.
+ * @param {number} cents Amount in cents
+ * @returns {string} Formatted as euros (e.g., "1234.50")
+ */
+function formatAmount(cents) {
+  const euros = (cents / 100).toFixed(2);
+  return euros;
+}
+
+/**
+ * Escape a CSV field value according to RFC 4180.
+ * Double quotes around a field that contains comma, quote, or newline.
+ * Double any internal quotes.
+ * @param {string} value Field value
+ * @returns {string} Escaped field value
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    const escaped = str.replace(/"/g, '""');
+    return `"${escaped}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }>} invoices
+ * @returns {string} CSV string with header and data rows, lines ending with \n
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header row
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data rows
+  for (const invoice of invoices) {
+    // Get customer name
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+    // Calculate totals and balance
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    // Build row fields
+    const fields = [
+      escapeCsvField(invoice.number),
+      escapeCsvField(customerName),
+      escapeCsvField(invoice.issueDate),
+      escapeCsvField(invoice.dueDate || ''),
+      escapeCsvField(invoice.status),
+      escapeCsvField(formatAmount(totals.subtotal)),
+      escapeCsvField(formatAmount(totals.discount)),
+      escapeCsvField(formatAmount(totals.vat)),
+      escapeCsvField(formatAmount(totals.total)),
+      escapeCsvField(formatAmount(due)),
+    ];
+
+    lines.push(fields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
