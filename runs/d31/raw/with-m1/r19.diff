+
+test('exportCsv preserves invoice order', () => {
+  const inv1 = createTestInvoice('C-001', '2025-01-15');
+  const inv2 = createTestInvoice('C-002', '2025-01-16');
+
+  assert.equal(inv1.ok, true);
+  assert.equal(inv2.ok, true);
+
+  const csv = exportCsv([inv1.value, inv2.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes(inv1.value.number));
+  assert(lines[2].includes(inv2.value.number));
+});
+
+test('exportCsv with draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(draft.ok, true);
+
+  const csv = exportCsv([draft.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('draft'));
+});
+
+test('exportCsv with paid invoice', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const { total } = invoiceTotals(inv.value);
+  const paid = recordPayment(inv.value, { amount: total, date: '2025-01-20' });
+  assert.equal(paid.ok, true);
+
+  const csv = exportCsv([paid.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('paid'));
+  assert(lines[1].includes('0.00')); // due should be 0
+});
+
+test('exportCsv with partially_paid invoice', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const partial = recordPayment(inv.value, { amount: 50000, date: '2025-01-20' });
+  assert.equal(partial.ok, true);
+
+  const csv = exportCsv([partial.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('partially_paid'));
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  // Create an invoice with customer that has comma in name
+  const draft = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-01-15',
