+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoice(customerId, issueDate, terms = 'NET30') {
+  const draft = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms,
+  });
+  if (!draft.ok) throw new Error('Failed to create draft invoice');
+  return issueInvoice(draft.value, []);
+}
+
+test('exportCsv returns empty data for empty invoices', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv has header line', () => {
+  const csv = exportCsv([]);
+  const firstLine = csv.split('\n')[0];
+  assert.equal(firstLine, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv ends with newline', () => {
+  const csv = exportCsv([]);
+  assert(csv.endsWith('\n'));
+});
+
+test('exportCsv includes single invoice', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const csv = exportCsv([inv.value]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines.length, 3); // header, data, empty line at end
+  assert(lines[1].includes('Northwind Studio'));
+});
+
+test('exportCsv includes customer name not ID', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const csv = exportCsv([inv.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('Northwind Studio'));
+  assert(!lines[1].includes('C-001'));
+});
+
+test('exportCsv includes invoice number', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const csv = exportCsv([inv.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes(inv.value.number));
+});
+
+test('exportCsv includes issue date', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const csv = exportCsv([inv.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('2025-01-15'));
+});
+
+test('exportCsv includes due date', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15', 'NET14');
+  assert.equal(inv.ok, true);
+  assert.equal(inv.value.dueDate, '2025-01-29');
+
+  const csv = exportCsv([inv.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('2025-01-29'));
+});
+
+test('exportCsv handles missing due date', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  const invNoDue = { ...inv.value, dueDate: undefined };
+
+  const csv = exportCsv([invNoDue]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].length > 0);
+});
+
+test('exportCsv includes status', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const csv = exportCsv([inv.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const csv = exportCsv([inv.value]);
+  const lines = csv.split('\n');
+
+  // Should contain amounts like "10000.00"
+  assert(lines[1].includes('.00'));
+});
+
+test('exportCsv includes subtotal', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  assert.equal(inv.ok, true);
+
+  const { subtotal } = invoiceTotals(inv.value);
+  const expectedSubtotal = (subtotal / 100).toFixed(2);
+
+  const csv = exportCsv([inv.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes(expectedSubtotal));
+});
+
+test('exportCsv includes discount', () => {
