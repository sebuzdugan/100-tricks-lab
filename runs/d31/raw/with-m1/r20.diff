 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of currency per euro.
+ * EUR: 1 (base), USD: 1.085, GBP: 0.8425
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +49,41 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount in euros (cents) to another currency.
+ * @param {number} cents Amount in euro cents
+ * @param {string} currency Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }} Amount in target currency cents
+ */
+export function convert(cents, currency) {
+  if (!RATES.hasOwnProperty(currency)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const converted = roundCents(cents * rate);
+  return ok(converted);
+}
+
+/**
+ * Format cents as money for people in a given currency.
+ * Examples: 123456 USD -> "$1,234.56", -500 GBP -> "-£5.00"
+ * @param {number} cents Amount in cents (of the given currency)
+ * @param {string} currency Currency code (EUR, USD, GBP)
+ * @returns {string} Formatted amount with currency symbol
+ */
+export function formatMoney(cents, currency) {
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  const symbol = symbols[currency] || '?';
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const wholePart = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const fractionalPart = String(abs % 100).padStart(2, '0');
+  return `${sign}${symbol}${wholePart}.${fractionalPart}`;
+}
