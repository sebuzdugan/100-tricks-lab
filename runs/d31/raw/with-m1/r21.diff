+
+// mergeCustomers tests
+test('mergeCustomers merges one customer into another', () => {
+  const customers = [
+    { id: 'C-001', name: 'Customer A' },
+    { id: 'C-002', name: 'Customer B' },
+  ];
+  const invoices = [
+    { customerId: 'C-001', number: 'INV-001' },
+    { customerId: 'C-002', number: 'INV-002' },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.customers[0].id, 'C-002');
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  assert.equal(result.value.invoices[1].customerId, 'C-002');
+});
+
