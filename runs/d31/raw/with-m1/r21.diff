index f3f08bc..7c9934d 100644
--- a/src/customers.js
+++ b/src/customers.js
@@ -43,3 +43,42 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge one customer into another, moving all invoices.
+ * @param {Array<{ id: string, name: string, email: string, country: string, tier: string }>} customers
+ * @param {Array<{ customerId: string }>} invoices
+ * @param {string} fromId Customer ID to merge from (will be removed)
+ * @param {string} intoId Customer ID to merge into (will receive invoices)
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  // Check if they're the same customer
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  // Check if both customers exist
+  const fromCustomerExists = customers.some(c => c.id === normalizedFromId);
+  const intoCustomerExists = customers.some(c => c.id === normalizedIntoId);
+
+  if (!fromCustomerExists || !intoCustomerExists) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Remove the fromId customer
+  const newCustomers = customers.filter(c => c.id !== normalizedFromId);
+
+  // Update invoices: move any with fromId to intoId
+  const newInvoices = invoices.map(inv => {
+    if (normalizeId(inv.customerId) === normalizedFromId) {
+      return { ...inv, customerId: normalizedIntoId };
+    }
+    return inv;
+  });
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
