+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+// lineTotal tests
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 10, unitPrice: 8500 }), 85000);
+});
+
+test('lineTotal with qty 1', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 9500 }), 9500);
+});
+
+test('lineTotal with large quantities', () => {
+  assert.equal(lineTotal({ qty: 100, unitPrice: 1500 }), 150000);
+});
+
+test('lineTotal applies rounding for fractional results', () => {
+  // 3 * 1.5 = 4.5 cents, rounds to 4 (banker's rounding, half to even)
+  assert.equal(lineTotal({ qty: 3, unitPrice: 1.5 }), 4);
+});
+
+// lineDiscount tests
+test('lineDiscount calculates discount as lineTotal * discountPercent / 100', () => {
+  // 10 * 8500 = 85000, 10% discount = 8500
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 8500, discountPercent: 10 }), 8500);
+});
+
+test('lineDiscount with 0% discount', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 8500, discountPercent: 0 }), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  // 10 * 8500 = 85000, 100% discount = 85000
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 8500, discountPercent: 100 }), 85000);
+});
+
+test('lineDiscount defaults to 0% if discountPercent is missing', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 8500 }), 0);
+});
+
+test('lineDiscount with decimal discountPercent', () => {
+  // 10 * 8500 = 85000, 12.5% discount = 10625
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 8500, discountPercent: 12.5 }), 10625);
+});
+
+test('lineDiscount clamps to 0 if result is negative (should not happen but safety)', () => {
+  // Negative discount should be clamped to 0
+  const discount = lineDiscount({ qty: 1, unitPrice: 100, discountPercent: 0 });
+  assert.equal(discount, 0);
+});
+
+// lineVAT tests
+test('lineVAT calculates VAT on amount after discount', () => {
+  // 10 * 8500 = 85000, no discount, 21% VAT = 17850
+  assert.equal(lineVAT({ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 }), 17850);
+});
+
+test('lineVAT with discount reduces VAT base', () => {
+  // 10 * 8500 = 85000, 10% discount = 8500, amount after discount = 76500, 21% VAT = 16065
+  assert.equal(lineVAT({ qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 }), 16065);
+});
+
+test('lineVAT with 0% VAT rate', () => {
+  assert.equal(lineVAT({ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 0 }), 0);
+});
+
+test('lineVAT with 9% VAT rate', () => {
+  // 100 * 37 = 3700, no discount, 9% VAT = 333
+  assert.equal(lineVAT({ qty: 100, unitPrice: 37, discountPercent: 0, vatRate: 9 }), 333);
+});
+
+test('lineVAT defaults vatRate to 0 if missing', () => {
+  assert.equal(lineVAT({ qty: 10, unitPrice: 8500, discountPercent: 0 }), 0);
+});
+
+test('lineVAT clamps to 0 if result is negative (should not happen)', () => {
+  const vat = lineVAT({ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 });
+  assert.equal(vat, 0);
+});
+
+// invoiceTotals tests
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.total, 42500);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500 }, // 85000
+      { qty: 5, unitPrice: 9500 }, // 47500
+      { qty: 1, unitPrice: 120000 }, // 120000
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 252500);
+  assert.equal(totals.total, 252500);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500 }, // 21% VAT product: 8500
+      { qty: 100, unitPrice: 37 }, // 9% VAT product: 3700
+      { qty: 1, unitPrice: 60000 }, // 0% VAT product: 60000
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 72200);
+  assert.equal(totals.total, 72200);
+});
+
+test('invoiceTotals returns a new object', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000 }],
+  };
+
+  const totals1 = invoiceTotals(invoice);
+  const totals2 = invoiceTotals(invoice);
+
+  assert.notEqual(totals1, totals2);
+  assert.deepEqual(totals1, totals2);
+});
+
+test('invoiceTotals with single line and discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 10 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000, discount: 8500, total: 76500
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 8500);
+  assert.equal(totals.total, 76500);
+});
+
+test('invoiceTotals with multiple lines and discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10 }, // 85000 - 8500 = 76500
+      { qty: 5, unitPrice: 9500, discountPercent: 20 },  // 47500 - 9500 = 38000
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000 + 47500 = 132500
+  // discount: 8500 + 9500 = 18000
+  // total: 132500 - 18000 = 114500
+  assert.equal(totals.subtotal, 132500);
+  assert.equal(totals.discount, 18000);
+  assert.equal(totals.total, 114500);
+});
+
+test('invoiceTotals with mixed discount and no discount lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10 }, // discount: 8500
+      { qty: 5, unitPrice: 9500, discountPercent: 0 },   // discount: 0
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000 + 47500 = 132500
+  // discount: 8500 + 0 = 8500
+  // total: 132500 - 8500 = 124000
+  assert.equal(totals.subtotal, 132500);
+  assert.equal(totals.discount, 8500);
+  assert.equal(totals.total, 124000);
+});
+
+test('invoiceTotals clamps total to 0 if discount equals subtotal', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 100 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 85000);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes VAT field', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(typeof totals.vat, 'number');
+  assert.equal(totals.vat, 17850);
+});
+
+test('invoiceTotals with single 21% VAT line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000, discount: 0, vat: 17850, total: 85000 + 17850 = 102850
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 17850);
+  assert.equal(totals.total, 102850);
+});
+
+test('invoiceTotals with single 0% VAT line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000, discount: 0, vat: 0, total: 85000
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 85000);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 }, // subtotal: 85000, vat: 17850
+      { qty: 5, unitPrice: 9500, discountPercent: 0, vatRate: 9 },  // subtotal: 47500, vat: 4275
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000 + 47500 = 132500, discount: 0, vat: 17850 + 4275 = 22125
+  // total: 132500 + 22125 = 154625
+  assert.equal(totals.subtotal, 132500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 22125);
+  assert.equal(totals.total, 154625);
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000, discount: 8500, amount after discount: 76500
+  // vat: 76500 * 21% = 16065, total: 85000 - 8500 + 16065 = 92565
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 8500);
+  assert.equal(totals.vat, 16065);
+  assert.equal(totals.total, 92565);
+});
+
+test('invoiceTotals with multiple lines, discounts, and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 }, // 85000 - 8500 = 76500, vat: 16065
+      { qty: 5, unitPrice: 9500, discountPercent: 20, vatRate: 9 },  // 47500 - 9500 = 38000, vat: 3420
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000 + 47500 = 132500
+  // discount: 8500 + 9500 = 18000
+  // vat: 16065 + 3420 = 19485
+  // total: 132500 - 18000 + 19485 = 133985
+  assert.equal(totals.subtotal, 132500);
+  assert.equal(totals.discount, 18000);
+  assert.equal(totals.vat, 19485);
+  assert.equal(totals.total, 133985);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 5000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal: 85000, discount: 0, vat: 17850, voucher: 5000
+  // total: 85000 - 0 + 17850 - 5000 = 97850
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 17850);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 97850);
+});
+
+test('invoiceTotals without voucher returns 0 voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals clamps total to 0 with large voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'HUGE', amount: 2000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
