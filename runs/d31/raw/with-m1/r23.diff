 /**
- * Calculate VAT for one line: (lineTotal - lineDiscount) times vatRate / 100.
+ * Calculate bulk discount for one line: 2.5% off for qty >= 10, applied after line discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
+ * @returns {number} Bulk discount in cents, or 0 if qty < 10
+ */
+export function bulkDiscount(line) {
+  if (line.qty < 10) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const lineDisc = lineDiscount(line);
+  const amountAfterLineDiscount = Math.max(0, total - lineDisc);
+  const bulkDisc = roundCents(amountAfterLineDiscount * 2.5 / 100);
+  return Math.max(0, bulkDisc);
+}
+
+/**
+ * Calculate VAT for one line: (lineTotal - lineDiscount - bulkDiscount) times vatRate / 100.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }}
  * @returns {number} VAT in cents
  */
 export function lineVAT(line) {
   const total = lineTotal(line);
-  const discount = lineDiscount(line);
-  const amountAfterDiscount = Math.max(0, total - discount);
+  const lineDisc = lineDiscount(line);
+  const bulkDisc = bulkDiscount(line);
+  const amountAfterDiscounts = Math.max(0, total - lineDisc - bulkDisc);
   const vatRate = line.vatRate ?? 0;
-  const vat = roundCents(amountAfterDiscount * vatRate / 100);
+  const vat = roundCents(amountAfterDiscounts * vatRate / 100);
   return Math.max(0, vat);
 }
 
