+/**
+ * Generate a dashboard summary of invoices.
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }>} invoices
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] || 0) + 1;
+  }
+
+  // Calculate outstanding: total due on issued and partially_paid invoices
+  let outstanding = 0;
+  const customerDue = new Map();
+
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      // Track per-customer due amounts
+      const normalizedId = invoice.customerId.trim().toUpperCase();
+      if (!customerDue.has(normalizedId)) {
+        customerDue.set(normalizedId, 0);
+      }
+      customerDue.set(normalizedId, customerDue.get(normalizedId) + due);
+    }
+  }
+
+  // Get overdue invoices and calculate overdue amount
+  const overdueList = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdueList.reduce((sum, inv) => sum + inv.due, 0);
+
+  // Get top 3 customers by due amount
+  const topCustomers = Array.from(customerDue.entries())
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, 3)
+    .map(([customerId, due]) => ({ customerId, due }));
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdueList.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
