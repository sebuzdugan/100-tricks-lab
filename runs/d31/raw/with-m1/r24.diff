+// dashboard tests
+test('dashboard returns empty counts for empty invoices', () => {
+  const result = dashboard([], '2025-02-15');
+
+  assert.equal(result.counts.draft, 0);
+  assert.equal(result.counts.issued, 0);
+  assert.equal(result.counts.partially_paid, 0);
+  assert.equal(result.counts.paid, 0);
+  assert.equal(result.outstanding, 0);
+  assert.equal(result.overdue.count, 0);
+  assert.equal(result.overdue.amount, 0);
+  assert.equal(result.topCustomers.length, 0);
+});
+
+test('dashboard counts invoices by status', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 9 }],
+  });
+
+  const issued = issueInvoice(draft.value, []);
+  const paid = recordPayment(issued.value, { amount: invoiceTotals(issued.value).total, date: '2025-01-20' });
+
+  const invoices = [
+    draft.value,
+    issued.value,
+    paid.value,
+    createTestInvoice('C-002', '2025-01-20'),
+  ];
+
+  const result = dashboard(invoices, '2025-02-15');
+
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.partially_paid, 0);
+  assert.equal(result.counts.paid, 1);
+});
+
+test('dashboard calculates outstanding on issued invoices', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  const { total } = invoiceTotals(inv.value);
+
+  const result = dashboard([inv.value], '2025-02-15');
+
+  assert.equal(result.outstanding, total);
+});
+
+test('dashboard calculates outstanding on partially_paid invoices', () => {
+  const inv = createTestInvoice('C-001', '2025-01-15');
+  const { total } = invoiceTotals(inv.value);
+  const partial = recordPayment(inv.value, { amount: Math.floor(total / 2), date: '2025-01-20' });
+
+  const result = dashboard([partial.value], '2025-02-15');
+
+  assert.equal(result.outstanding, Math.ceil(total / 2));
+});
+
