@@ -24,19 +25,54 @@ export function renderInvoiceText(invoice) {
     customer.name,
   ];
 
-  // Add invoice lines
+  // Add invoice lines with discounts
   for (const line of invoice.lines) {
     const total = lineTotal(line);
-    const lineText = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    let lineText = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+
+    // Add line discount if present
+    const lineDisc = lineDiscount(line);
+    const bulkDisc = bulkDiscount(line);
+    const totalDisc = lineDisc + bulkDisc;
+
+    if (totalDisc > 0) {
+      lineText += ` (${formatEuros(totalDisc)} discount)`;
+    }
+
     lines.push(lineText);
   }
 
-  // Add VAT and total
-  const { vat, total } = invoiceTotals(invoice);
+  // Get totals
+  const { vat, total, discount, voucher } = invoiceTotals(invoice);
+
+  // Add discount line if there are any discounts
+  if (discount > 0) {
+    lines.push(`Discount: ${formatEuros(discount)}`);
+  }
+
+  // Add VAT if present
   if (vat > 0) {
     lines.push(`VAT: ${formatEuros(vat)}`);
   }
+
+  // Add voucher if present
+  if (voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(voucher)}`);
+  }
+
+  // Add total
   lines.push(`Total: ${formatEuros(total)}`);
 
+  // Add due date if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Add amount paid if there are payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return ok(lines.join('\n'));
 }
