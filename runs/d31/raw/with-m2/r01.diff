@@ -0,0 +1,192 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates an invoice with valid data', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2024-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 5,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice includes product details from catalogue', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-06-30',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[0].unitPrice, 9500);
+  assert.equal(result.value.lines[1].name, 'Sticker sheet');
+  assert.equal(result.value.lines[1].unitPrice, 50);
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for non-YYYY-MM-DD format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '01/15/2024',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports DATE_INVALID for invalid date like Feb 30', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports DATE_INVALID for Feb 29 on non-leap year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-02-29',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice accepts Feb 29 on leap year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [],
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports NO_LINES for missing lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: undefined,
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5.5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports UNKNOWN_SKU for unknown product', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice stops at first error', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'UNKNOWN-SKU', qty: 3 },
+    ],
+  });
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const linesBefore = JSON.stringify(lines);
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines,
+  });
+  assert.equal(JSON.stringify(lines), linesBefore);
+});
+
+test('createInvoice returns copies of product data', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  result.value.lines[0].unitPrice = 1;
+  const result2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(result2.value.lines[0].unitPrice, 8500);
+});
+
+test('createInvoice handles multiple lines with different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
