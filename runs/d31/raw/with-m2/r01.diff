@@ -0,0 +1,71 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(dateStr);
+  if (!match) return false;
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const parts = dateStr.split('-');
+  return date.getUTCFullYear() === parseInt(parts[0]) &&
+         date.getUTCMonth() === parseInt(parts[1]) - 1 &&
+         date.getUTCDate() === parseInt(parts[2]);
+}
+
+/**
+ * Validate that a quantity is a positive integer.
+ * @param {*} qty
+ * @returns {boolean}
+ */
+function isValidQty(qty) {
+  return Number.isInteger(qty) && qty > 0;
+}
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate date
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  // Validate lines
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Build lines with product details
+  const invoiceLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!isValidQty(line.qty)) return fail('QTY_INVALID');
+
+    // Get product
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
