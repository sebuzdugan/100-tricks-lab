diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..940fb12
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,53 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates INV-YYYY-0001 for first invoice of a year', () => {
+  const number = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-30');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber finds max counter in unordered list', () => {
+  const existingNumbers = ['INV-2024-0005', 'INV-2024-0001', 'INV-2024-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-12-31');
+  assert.equal(number, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber ignores invoices from other years', () => {
+  const existingNumbers = ['INV-2023-0001', 'INV-2023-9999', 'INV-2024-0001'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-30');
+  assert.equal(number, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existingNumbers = ['INV-2024-0001'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-12-31');
+  assert.equal(number, 'INV-2024-0002');
+
+  const existingNumbers2 = Array.from({ length: 99 }, (_, i) =>
+    `INV-2024-${String(i + 1).padStart(4, '0')}`
+  );
+  const number2 = nextInvoiceNumber(existingNumbers2, '2024-12-31');
+  assert.equal(number2, 'INV-2024-0100');
+});
+
+test('nextInvoiceNumber works with large counters', () => {
+  const existingNumbers = ['INV-2024-9999'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-12-31');
+  assert.equal(number, 'INV-2024-10000');
+});
+
+test('nextInvoiceNumber extracts year from issueDate', () => {
+  const existingNumbers = ['INV-2023-0001', 'INV-2025-0001'];
+  const number2024 = nextInvoiceNumber(existingNumbers, '2024-06-30');
+  assert.equal(number2024, 'INV-2024-0001');
+
+  const number2025 = nextInvoiceNumber(existingNumbers, '2025-06-30');
+  assert.equal(number2025, 'INV-2025-0002');
+});
