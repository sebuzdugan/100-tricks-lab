+/**
+ * Issue an invoice (assign a number and change status to 'issued').
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @param {Array<string>} existingNumbers
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check draft status
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Generate next invoice number
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    number,
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: 'issued',
+    lines: invoice.lines.map((line) => ({ ...line })),
+  });
+}
diff --git a/src/numbering.js b/src/numbering.js
new file mode 100644
index 0000000..18cbab2
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,38 @@
+/**
+ * Extract year and counter from an invoice number.
+ * @param {string} number
+ * @returns {{ year: number, counter: number } | null}
+ */
+function parseInvoiceNumber(number) {
+  const match = /^INV-(\d{4})-(\d{4})$/.exec(number);
+  if (!match) return null;
+  return {
+    year: parseInt(match[1]),
+    counter: parseInt(match[2]),
+  };
+}
+
+/**
+ * Get the next free invoice number for a given year.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = parseInt(issueDate.slice(0, 4));
+
+  // Parse all existing numbers and filter for this year
+  const thisYearCounters = existingNumbers
+    .map((num) => parseInvoiceNumber(num))
+    .filter((parsed) => parsed && parsed.year === year)
+    .map((parsed) => parsed.counter);
+
+  // Find the highest counter, or 0 if none exist
+  const maxCounter = thisYearCounters.length > 0 ? Math.max(...thisYearCounters) : 0;
+
+  // Generate the next counter (padded to 4 digits)
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+
+  return `INV-${year}-${paddedCounter}`;
+}
