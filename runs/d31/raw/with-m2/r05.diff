+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // First line: invoice number or "DRAFT"
+  const numberLine = invoice.number || 'DRAFT';
+
+  // Get customer name (fallback to customerId if not found)
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+  // Build line items
+  const lineItems = invoice.lines
+    .map((line) => {
+      const total = lineTotal(line);
+      const unitPriceFormatted = formatEuros(line.unitPrice);
+      const totalFormatted = formatEuros(total);
+      return `${line.qty} ${line.name} ${unitPriceFormatted} ${totalFormatted}`;
+    })
+    .join('\n');
+
+  // Get total
+  const totals = invoiceTotals(invoice);
+  const totalFormatted = formatEuros(totals.total);
+
+  return `${numberLine}\n${customerName}\n${lineItems}\nTotal: ${totalFormatted}`;
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..58ec83b
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,208 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const draftInvoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issuedInvoice = issueInvoice(draftInvoice, []).value;
+  const text = renderInvoiceText(issuedInvoice);
+  assert.match(text, /^INV-2024-0001\n/);
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /\nNorthwind Studio\n/);
+});
+
+test('renderInvoiceText formats amounts in euros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  // DES-HOUR is 8500 cents = €85.00
+  // 5x = €425.00
+  assert.match(text, /€85\.00/);
+  assert.match(text, /€425\.00/);
+});
+
+test('renderInvoiceText shows line quantities and names', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5 Design work \(hour\)/);
+});
+
+test('renderInvoiceText shows total at end', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Total: €425\.00$/);
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5 Design work \(hour\) €85\.00 €425\.00/);
+  assert.match(text, /3 Development \(hour\) €95\.00 €285\.00/);
+  // Total is 425 + 285 = 710
+  assert.match(text, /Total: €710\.00$/);
+});
+
+test('renderInvoiceText handles single line correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-06-30',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4); // number, customer, line, total
+  assert.match(text, /1 Logo package €1,200\.00 €1,200\.00/);
+});
+
+test('renderInvoiceText handles large quantities', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'STICKER', qty: 1000, name: 'Sticker sheet', unitPrice: 50, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  // 1000 x €0.50 = €500.00
+  assert.match(text, /1000 Sticker sheet €0\.50 €500\.00/);
+});
+
+test('renderInvoiceText handles complex formatting with thousands separator', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 5, name: 'Brand guidelines document', unitPrice: 245000, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  // 245000 cents = €2,450.00
+  // 5 x €2,450.00 = €12,250.00
+  assert.match(text, /€2,450\.00/);
+  assert.match(text, /Total: €12,250\.00$/);
+});
+
+test('renderInvoiceText handles different VAT rates in lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  // Line 1: 2 x €85.00 = €170.00 (21% VAT)
+  // Line 2: 100 x €0.37 = €37.00 (9% VAT)
+  assert.match(text, /2 Design work \(hour\) €85\.00 €170\.00/);
+  assert.match(text, /100 Printed flyer A4 \(each\) €0\.37 €37\.00/);
+  // Total = €207.00
+  assert.match(text, /Total: €207\.00$/);
+});
+
+test('renderInvoiceText produces multiline output', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // DRAFT, customer, 2 lines, total
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /Design work/);
+  assert.match(lines[3], /Development/);
+  assert.match(lines[4], /Total:/);
+});
+
+test('renderInvoiceText uses customer name from database', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /\nKite & Co\n/);
+});
+
+test('renderInvoiceText uses customerId as fallback for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /\nC-999\n/);
+});
+
+test('renderInvoiceText formats zero price correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'TEST', qty: 1, name: 'Test product', unitPrice: 0, vatRate: 0 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /€0\.00/);
+});
