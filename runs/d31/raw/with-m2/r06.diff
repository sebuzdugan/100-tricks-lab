@@ -206,3 +206,52 @@ test('renderInvoiceText formats zero price correctly', () => {
   const text = renderInvoiceText(invoice);
   assert.match(text, /€0\.00/);
 });
+
+test('renderInvoiceText calculates correct total with discounts', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  // 5 * €85.00 = €425.00, with 10% discount = €382.50
+  assert.match(text, /Total: €382\.50$/);
+});
+
+test('renderInvoiceText shows discounted line total correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, name: 'Design work (hour)', unitPrice: 1000, vatRate: 21, discountPercent: 20 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  // 10 * €10.00 = €100.00 (line total before discount)
+  assert.match(text, /10 Design work \(hour\) €10\.00 €100\.00/);
+});
+
+test('renderInvoiceText handles multiple lines with different discounts', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'SKU1', qty: 10, name: 'Product A', unitPrice: 1000, vatRate: 21, discountPercent: 10 },
+      { sku: 'SKU2', qty: 5, name: 'Product B', unitPrice: 2000, vatRate: 21, discountPercent: 20 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  // Line 1: 10 * €10.00 = €100.00 (line total)
+  // Line 2: 5 * €20.00 = €100.00 (line total)
+  // Total discount: (100 * 0.10) + (100 * 0.20) = 10 + 20 = 30
+  // Total: 200 - 30 = €170.00
+  assert.match(text, /Total: €170\.00$/);
+});
