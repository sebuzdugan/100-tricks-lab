+/**
+ * Check if a text string is a valid date in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(dateStr);
+  if (!match) return false;
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const parts = dateStr.split('-');
+  return date.getUTCFullYear() === parseInt(parts[0]) &&
+         date.getUTCMonth() === parseInt(parts[1]) - 1 &&
+         date.getUTCDate() === parseInt(parts[2]);
+}
+
+/**
+ * Add days to a YYYY-MM-DD date string (UTC).
+ * @param {string} date YYYY-MM-DD format
+ * @param {number} n number of days to add (can be negative)
+ * @returns {string} YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.getUTCFullYear().toString().padStart(4, '0') +
+    '-' +
+    (d.getUTCMonth() + 1).toString().padStart(2, '0') +
+    '-' +
+    d.getUTCDate().toString().padStart(2, '0');
+}
+
+/**
+ * Calculate the difference in whole days between two dates (b - a, in UTC).
+ * @param {string} a YYYY-MM-DD format
+ * @param {string} b YYYY-MM-DD format
+ * @returns {number} number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
