diff --git a/test/terms.test.js b/test/terms.test.js
new file mode 100644
index 0000000..5af0e85
--- /dev/null
+++ b/test/terms.test.js
@@ -0,0 +1,247 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, addLine, removeLine, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { daysBetween } from '../src/dates.js';
+
+test('createInvoice uses default NET30 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(result.value.dueDate, '2024-02-14');
+});
+
+test('createInvoice accepts NET14 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(result.value.terms, 'NET14');
+  assert.equal(result.value.dueDate, '2024-01-29');
+});
+
+test('createInvoice accepts NET30 terms explicitly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(result.value.dueDate, '2024-02-14');
+});
+
+test('createInvoice accepts EOM terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.terms, 'EOM');
+  assert.equal(result.value.dueDate, '2024-01-31');
+});
+
+test('createInvoice rejects invalid terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'INVALID',
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'TERMS_INVALID');
+});
+
+test('NET14 due date is 14 days after issue date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const days = daysBetween('2024-06-15', result.value.dueDate);
+  assert.equal(days, 14);
+});
+
+test('NET30 due date is 30 days after issue date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  const days = daysBetween('2024-06-15', result.value.dueDate);
+  assert.equal(days, 30);
+});
+
+test('EOM due date is last day of issue month', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2024-01-31');
+});
+
+test('EOM with last day of month issue date returns same day', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-31',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2024-01-31');
+});
+
+test('EOM handles February in leap year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2024-02-29');
+});
+
+test('EOM handles February in non-leap year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2023-02-28');
+});
+
+test('EOM correctly handles all months', () => {
+  const testCases = [
+    { issueDate: '2024-01-15', expected: '2024-01-31' }, // 31 days
+    { issueDate: '2024-02-15', expected: '2024-02-29' }, // leap year
+    { issueDate: '2024-03-15', expected: '2024-03-31' }, // 31 days
+    { issueDate: '2024-04-15', expected: '2024-04-30' }, // 30 days
+    { issueDate: '2024-05-15', expected: '2024-05-31' }, // 31 days
+    { issueDate: '2024-06-15', expected: '2024-06-30' }, // 30 days
+    { issueDate: '2024-09-15', expected: '2024-09-30' }, // 30 days
+    { issueDate: '2024-12-15', expected: '2024-12-31' }, // 31 days
+  ];
+
+  for (const { issueDate, expected } of testCases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'EOM',
+    });
+    assert.equal(result.value.dueDate, expected, `Failed for ${issueDate}`);
+  }
+});
+
+test('addLine preserves terms and dueDate', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const withLine = addLine(draft.value, { sku: 'DEV-HOUR', qty: 1 });
+  assert.equal(withLine.value.terms, 'NET14');
+  assert.equal(withLine.value.dueDate, '2024-01-29');
+});
+
+test('removeLine preserves terms and dueDate', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+    terms: 'EOM',
+  });
+
+  const removed = removeLine(draft.value, 'DEV-HOUR');
+  assert.equal(removed.value.terms, 'EOM');
+  assert.equal(removed.value.dueDate, '2024-01-31');
+});
+
+test('issueInvoice preserves terms and dueDate', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  const issued = issueInvoice(draft.value, []);
+  assert.equal(issued.value.terms, 'NET30');
+  assert.equal(issued.value.dueDate, '2024-02-14');
+  assert.equal(issued.value.number, 'INV-2024-0001');
+});
+
+test('recordPayment preserves terms and dueDate', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  });
+
+  const issued = issueInvoice(draft.value, []);
+  const paid = recordPayment(issued.value, { amount: 1000, date: '2024-01-20' });
+
+  assert.equal(paid.value.terms, 'NET14');
+  assert.equal(paid.value.dueDate, '2024-01-29');
+});
+
+test('NET14 due date handles month boundaries', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-25',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(result.value.dueDate, '2024-02-08');
+});
+
+test('NET30 due date handles year boundaries', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(result.value.dueDate, '2025-01-14');
+});
+
+test('EOM due date handles year boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2024-12-31');
+});
