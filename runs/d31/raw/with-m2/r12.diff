+/**
+ * Validate that terms are valid.
+ * @param {*} terms
+ * @returns {boolean}
+ */
+function isValidTerms(terms) {
+  return ['NET14', 'NET30', 'EOM'].includes(terms);
+}
+
+/**
+ * Calculate the due date based on terms and issue date.
+ * @param {string} issueDate YYYY-MM-DD format
+ * @param {string} terms NET14, NET30, or EOM
+ * @returns {string} due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [yearStr, monthStr] = issueDate.split('-');
+    const year = parseInt(yearStr);
+    const month = parseInt(monthStr);
+    const date = new Date(Date.UTC(year, month - 1, 1));
+    date.setUTCMonth(date.getUTCMonth() + 1);
+    date.setUTCDate(0);
+    const y = date.getUTCFullYear();
+    const m = (date.getUTCMonth() + 1).toString().padStart(2, '0');
+    const d = date.getUTCDate().toString().padStart(2, '0');
+    return `${y}-${m}-${d}`;
+  }
+}
