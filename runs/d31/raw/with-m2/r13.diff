diff --git a/test/vouchers.test.js b/test/vouchers.test.js
new file mode 100644
index 0000000..1366f99
--- /dev/null
+++ b/test/vouchers.test.js
@@ -0,0 +1,192 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, applyVoucher, issueInvoice, invoiceTotals, addLine, removeLine } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function makeDraftInvoice() {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+  return result;
+}
+
+test('applyVoucher adds voucher to draft invoice', () => {
+  const draft = makeDraftInvoice();
+  const result = applyVoucher(draft.value, { code: 'SUMMER20', amount: 500 });
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.voucher, { code: 'SUMMER20', amount: 500 });
+});
+
+test('applyVoucher rejects non-draft invoices', () => {
+  const draft = makeDraftInvoice();
+  const issued = issueInvoice(draft.value, []);
+
+  const result = applyVoucher(issued.value, { code: 'SUMMER20', amount: 500 });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_DRAFT');
+});
+
+test('applyVoucher rejects when voucher already exists', () => {
+  const draft = makeDraftInvoice();
+  const withVoucher = applyVoucher(draft.value, { code: 'SUMMER20', amount: 500 });
+
+  const result = applyVoucher(withVoucher.value, { code: 'SPRING10', amount: 200 });
+  assert.equal(result.error, 'VOUCHER_EXISTS');
+});
+
+test('applyVoucher rejects zero amount', () => {
+  const draft = makeDraftInvoice();
+  const result = applyVoucher(draft.value, { code: 'INVALID', amount: 0 });
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('applyVoucher rejects negative amount', () => {
+  const draft = makeDraftInvoice();
+  const result = applyVoucher(draft.value, { code: 'INVALID', amount: -100 });
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('applyVoucher rejects non-integer amount', () => {
+  const draft = makeDraftInvoice();
+  const result = applyVoucher(draft.value, { code: 'INVALID', amount: 100.5 });
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('applyVoucher rejects non-number amount', () => {
+  const draft = makeDraftInvoice();
+  const result = applyVoucher(draft.value, { code: 'INVALID', amount: 'not-a-number' });
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('invoiceTotals includes voucher in calculation', () => {
+  const draft = makeDraftInvoice();
+  const withVoucher = applyVoucher(draft.value, { code: 'SUMMER20', amount: 500 });
+  const totals = invoiceTotals(withVoucher.value);
+
+  assert.equal(totals.voucher, 500);
+});
+
+test('invoiceTotals subtracts voucher from total', () => {
+  const draft = makeDraftInvoice();
+  const totalsWithout = invoiceTotals(draft.value);
+  const withVoucher = applyVoucher(draft.value, { code: 'SUMMER20', amount: 500 });
+  const totalsWith = invoiceTotals(withVoucher.value);
+
+  assert.equal(totalsWith.total, totalsWithout.total - 500);
+});
+
+test('invoiceTotals returns 0 for voucher when not applied', () => {
+  const draft = makeDraftInvoice();
+  const totals = invoiceTotals(draft.value);
+
+  assert.equal(totals.voucher, 0);
+});
+
+test('voucher is subtracted after VAT', () => {
+  const draft = makeDraftInvoice();
+  const withVoucher = applyVoucher(draft.value, { code: 'SUMMER20', amount: 1000 });
+  const totals = invoiceTotals(withVoucher.value);
+
+  // DES-HOUR is 8500 * 2 = 17000, gold tier 5% discount = 850, after discount = 16150
+  // VAT 21% = 3391.5 → 3392
+  // total = 17000 - 850 + 3392 - 1000 = 18542
+  assert.equal(totals.subtotal, 17000);
+  assert.equal(totals.discount, 850);
+  assert.equal(totals.vat, 3392);
+  assert.equal(totals.voucher, 1000);
+  assert.equal(totals.total, 18542);
+});
+
+test('total is clamped at 0 with large voucher', () => {
+  const draft = makeDraftInvoice();
+  const totals = invoiceTotals(draft.value);
+  const largeVoucher = applyVoucher(draft.value, { code: 'MASSIVE', amount: totals.total + 10000 });
+  const totalsWith = invoiceTotals(largeVoucher.value);
+
+  assert.equal(totalsWith.total, 0);
+});
+
+test('addLine preserves voucher', () => {
+  const draft = makeDraftInvoice();
+  const withVoucher = applyVoucher(draft.value, { code: 'SUMMER20', amount: 500 });
+  const withLine = addLine(withVoucher.value, { sku: 'DEV-HOUR', qty: 1 });
+
+  assert.deepEqual(withLine.value.voucher, { code: 'SUMMER20', amount: 500 });
+});
+
+test('removeLine preserves voucher', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const withVoucher = applyVoucher(draft.value, { code: 'SUMMER20', amount: 500 });
+  const removed = removeLine(withVoucher.value, 'DEV-HOUR');
+
+  assert.deepEqual(removed.value.voucher, { code: 'SUMMER20', amount: 500 });
+});
+
+test('issueInvoice preserves voucher', () => {
+  const draft = makeDraftInvoice();
+  const withVoucher = applyVoucher(draft.value, { code: 'SUMMER20', amount: 500 });
+  const issued = issueInvoice(withVoucher.value, []);
+
+  assert.deepEqual(issued.value.voucher, { code: 'SUMMER20', amount: 500 });
+});
+
+test('recordPayment preserves voucher', () => {
+  const draft = makeDraftInvoice();
+  const withVoucher = applyVoucher(draft.value, { code: 'SUMMER20', amount: 500 });
+  const issued = issueInvoice(withVoucher.value, []);
+  const paid = recordPayment(issued.value, { amount: 1000, date: '2024-01-20' });
+
+  assert.deepEqual(paid.value.voucher, { code: 'SUMMER20', amount: 500 });
+});
+
+test('voucher code is preserved correctly', () => {
+  const draft = makeDraftInvoice();
+  const result = applyVoucher(draft.value, { code: 'PROMO2024-SPECIAL', amount: 750 });
+
+  assert.equal(result.value.voucher.code, 'PROMO2024-SPECIAL');
+});
+
+test('voucher amount can be any positive integer', () => {
+  const draft = makeDraftInvoice();
+
+  const result1 = applyVoucher(draft.value, { code: 'V1', amount: 1 });
+  assert.equal(result1.value.voucher.amount, 1);
+
+  const result2 = applyVoucher(draft.value, { code: 'V2', amount: 999999 });
+  assert.equal(result2.value.voucher.amount, 999999);
+});
+
+test('invoiceTotals with voucher equals (subtotal - discount + vat - voucher)', () => {
+  const draft = makeDraftInvoice();
+  const withVoucher = applyVoucher(draft.value, { code: 'TEST', amount: 3500 });
+  const totals = invoiceTotals(withVoucher.value);
+
+  const calculated = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, calculated);
+});
+
+test('does not mutate original invoice when applying voucher', () => {
+  const draft = makeDraftInvoice();
+  const originalVoucher = draft.value.voucher;
+
+  applyVoucher(draft.value, { code: 'SUMMER20', amount: 500 });
+
+  assert.equal(draft.value.voucher, originalVoucher);
+});
