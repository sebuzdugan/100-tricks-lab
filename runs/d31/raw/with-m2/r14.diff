--- /dev/null
+++ b/src/statements.js
@@ -0,0 +1,35 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter and map invoices
+  const statementInvoices = invoices
+    .filter(inv =>
+      inv.customerId === customerId &&
+      ['issued', 'partially_paid'].includes(inv.status) &&
+      daysBetween(inv.issueDate, asOf) >= 0
+    )
+    .map(inv => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
index 0000000..ab8e3c4
--- /dev/null
+++ b/test/statements.test.js
@@ -0,0 +1,255 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+function makeInvoice(customerId, issueDate, qty = 1, paid = 0) {
+  const draft = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  if (paid > 0) {
+    const payment = recordPayment(issued.value, { amount: paid, date: issueDate });
+    if (!payment.ok) throw new Error(`recordPayment failed: ${payment.error}`);
+    return payment.value;
+  }
+
+  return issued.value;
+}
+
+test('statement returns invoices for a customer', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15'),
+    makeInvoice('C-001', '2024-02-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+});
+
+test('statement filters by customer', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15'),
+    makeInvoice('C-002', '2024-02-15'),
+    makeInvoice('C-001', '2024-03-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+  assert.equal(result.value.invoices[1].issueDate, '2024-03-15');
+});
+
+test('statement only includes issued and partially_paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const invoices = [
+    draft.value, // draft, should be excluded
+    makeInvoice('C-001', '2024-02-15'), // issued
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement filters by issueDate <= asOf', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15'),
+    makeInvoice('C-001', '2024-02-15'),
+    makeInvoice('C-001', '2024-03-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-02-14');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+});
+
+test('statement includes invoices with issueDate equal to asOf', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-02-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-02-15');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement returns empty list when no invoices match', () => {
+  const invoices = [
+    makeInvoice('C-002', '2024-01-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-03-15'),
+    makeInvoice('C-001', '2024-01-15'),
+    makeInvoice('C-001', '2024-02-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+  assert.equal(result.value.invoices[1].issueDate, '2024-02-15');
+  assert.equal(result.value.invoices[2].issueDate, '2024-03-15');
+});
+
+test('statement includes invoice number, issueDate, dueDate, total, and due', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  const inv = result.value.invoices[0];
+
+  assert.ok(inv.number);
+  assert.ok(inv.issueDate);
+  assert.ok(inv.dueDate);
+  assert.equal(typeof inv.total, 'number');
+  assert.equal(typeof inv.due, 'number');
+});
+
+test('statement calculates due as balance owed', () => {
+  const fullTotal = invoiceTotals(makeInvoice('C-001', '2024-01-15')).total;
+  const paidAmount = Math.floor(fullTotal / 2);
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15', 1, paidAmount),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  const inv = result.value.invoices[0];
+
+  assert.equal(inv.due, fullTotal - paidAmount);
+});
+
+test('statement calculates totalDue as sum of all due amounts', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15', 1),
+    makeInvoice('C-001', '2024-02-15', 2),
+    makeInvoice('C-001', '2024-03-15', 3),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  const sumOfDue = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  assert.equal(result.value.totalDue, sumOfDue);
+});
+
+test('statement totalDue is 0 for fully paid invoices', () => {
+  const fullTotal = invoiceTotals(makeInvoice('C-001', '2024-01-15')).total;
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15', 1, fullTotal),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement rejects unknown customer', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15'),
+  ];
+
+  const result = statement('C-999', invoices, '2024-12-31');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement includes customerId in result', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const fullTotal = invoiceTotals(makeInvoice('C-001', '2024-01-15')).total;
+  const paidAmount = 1000; // partial payment
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15', 1, paidAmount),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, fullTotal - paidAmount);
+});
+
+test('statement handles multiple customers correctly', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15', 1),
+    makeInvoice('C-001', '2024-02-15', 2),
+    makeInvoice('C-002', '2024-01-15', 1),
+    makeInvoice('C-002', '2024-02-15', 3),
+  ];
+
+  const result1 = statement('C-001', invoices, '2024-12-31');
+  const result2 = statement('C-002', invoices, '2024-12-31');
+
+  assert.equal(result1.value.invoices.length, 2);
+  assert.equal(result2.value.invoices.length, 2);
+  assert.notEqual(result1.value.totalDue, result2.value.totalDue);
+});
+
+test('statement respects asOf date for each customer independently', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15'),
+    makeInvoice('C-001', '2024-03-15'),
+    makeInvoice('C-002', '2024-02-15'),
+    makeInvoice('C-002', '2024-04-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-02-28');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+});
+
+test('statement with empty invoice list returns empty statement', () => {
+  const result = statement('C-001', [], '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes correct dueDate from invoice', () => {
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15'),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  const inv = result.value.invoices[0];
+
+  // Default terms is NET30, so due date should be 30 days after issue date
+  assert.equal(inv.dueDate, '2024-02-14');
+});
+
+test('statement totalDue with mixed paid and unpaid invoices', () => {
+  const fullTotal1 = invoiceTotals(makeInvoice('C-001', '2024-01-15', 1)).total;
+  const paidAmount1 = Math.floor(fullTotal1 / 2);
+  const fullTotal2 = invoiceTotals(makeInvoice('C-001', '2024-02-15', 2)).total;
+  const paidAmount2 = fullTotal2; // fully paid
+
+  const invoices = [
+    makeInvoice('C-001', '2024-01-15', 1, paidAmount1),
+    makeInvoice('C-001', '2024-02-15', 2, paidAmount2),
+  ];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  const expected = (fullTotal1 - paidAmount1) + 0;
+  assert.equal(result.value.totalDue, expected);
+});
