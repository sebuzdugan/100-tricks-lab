+++ b/test/credits.test.js
@@ -0,0 +1,224 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+function makeIssuedInvoice(customerId = 'C-001', issueDate = '2024-01-15') {
+  const draft = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  return issued.value;
+}
+
+function makePaidInvoice(customerId = 'C-001', issueDate = '2024-01-15', paidAmount = null) {
+  const invoice = makeIssuedInvoice(customerId, issueDate);
+  if (paidAmount !== null) {
+    const payment = recordPayment(invoice, { amount: paidAmount, date: issueDate });
+    if (!payment.ok) throw new Error(`recordPayment failed: ${payment.error}`);
+    return payment.value;
+  }
+  return invoice;
+}
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Defective item', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 1000);
+  assert.equal(result.value.reason, 'Defective item');
+});
+
+test('createCreditNote includes invoice number and customer id', () => {
+  const invoice = makeIssuedInvoice('C-003');
+  const result = createCreditNote(invoice, { amount: 500, reason: 'Discount', date: '2024-01-20' }, []);
+
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-003');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const result = createCreditNote(draft.value, { amount: 1000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote accepts issued invoices', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote accepts partially_paid invoices', () => {
+  const invoice = makePaidInvoice('C-001', '2024-01-15', 5000);
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote accepts fully paid invoices', () => {
+  const invoice = makeIssuedInvoice();
+  const { total } = invoiceTotals(invoice);
+  const fullyPaid = recordPayment(invoice, { amount: total, date: '2024-01-20' });
+  if (!fullyPaid.ok) throw new Error(`recordPayment failed: ${fullyPaid.error}`);
+
+  const result = createCreditNote(fullyPaid.value, { amount: 5000, reason: 'Refund', date: '2024-01-21' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 0, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: -1000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000.5, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects non-number amount', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 'not-a-number', reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2024-13-01' }, []);
+
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const invoice = makeIssuedInvoice();
+  const { total } = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: total + 1, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote accepts amount equal to invoice total', () => {
+  const invoice = makeIssuedInvoice();
+  const { total } = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: total, reason: 'Full refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, total);
+});
+
+test('createCreditNote generates CN number with year and counter', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote increments counter within same year', () => {
+  const invoice = makeIssuedInvoice();
+  const result1 = createCreditNote(invoice, { amount: 500, reason: 'Refund 1', date: '2024-01-20' }, []);
+  const result2 = createCreditNote(invoice, { amount: 600, reason: 'Refund 2', date: '2024-02-15' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2024-0001');
+  assert.equal(result2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote resets counter for different year', () => {
+  const invoice = makeIssuedInvoice();
+  const result1 = createCreditNote(invoice, { amount: 500, reason: 'Refund 1', date: '2024-01-20' }, []);
+  const result2 = createCreditNote(invoice, { amount: 600, reason: 'Refund 2', date: '2025-01-15' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2024-0001');
+  assert.equal(result2.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote ignores invoice numbers when numbering', () => {
+  const invoice = makeIssuedInvoice();
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003'];
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2024-01-20' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote continues counter from existing credit notes', () => {
+  const invoice = makeIssuedInvoice();
+  const existingNumbers = ['CN-2024-0001', 'CN-2024-0002', 'INV-2024-0001'];
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2024-01-20' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2024-0003');
+});
+
+test('createCreditNote includes issue date in credit note', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2024-06-15' }, []);
+
+  assert.equal(result.value.date, '2024-06-15');
+});
+
+test('createCreditNote includes reason in credit note', () => {
+  const invoice = makeIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Customer request for refund due to quality issue', date: '2024-01-20' }, []);
+
+  assert.equal(result.value.reason, 'Customer request for refund due to quality issue');
+});
+
+test('createCreditNote with various reason texts', () => {
+  const invoice = makeIssuedInvoice();
+  const reasons = [
+    'Defective product',
+    'Wrong item shipped',
+    'Customer cancellation',
+    'Damaged in transit',
+  ];
+
+  for (const reason of reasons) {
+    const result = createCreditNote(invoice, { amount: 1000, reason, date: '2024-01-20' }, []);
+    assert.equal(result.value.reason, reason);
+  }
+});
+
+test('createCreditNote preserves customer id from invoice', () => {
+  const customerId = 'C-007';
+  const invoice = makeIssuedInvoice(customerId);
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.value.customerId, customerId);
+});
+
+test('createCreditNote with different amounts up to total', () => {
+  const invoice = makeIssuedInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const amounts = [1, 100, 500, total];
+  for (const amount of amounts) {
+    const result = createCreditNote(invoice, { amount, reason: 'Refund', date: '2024-01-20' }, []);
+    assert.equal(result.ok, true, `Failed for amount ${amount}`);
+    assert.equal(result.value.amount, amount);
+  }
+});
