+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+function isValidAmount(amount) {
+  return Number.isInteger(amount) && amount > 0;
+}
+
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+  const creditNotes = existingNumbers
+    .filter(num => num.startsWith('CN-'))
+    .filter(num => num.split('-')[1] === year);
+
+  const counters = creditNotes.map(num => {
+    const parts = num.split('-');
+    return parseInt(parts[2]);
+  });
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `CN-${year}-${nextCounter.toString().padStart(4, '0')}`;
+}
+
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice is issued
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount
+  if (!isValidAmount(amount)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate amount doesn't exceed invoice total
+  const { total } = invoiceTotals(invoice);
+  if (amount > total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
