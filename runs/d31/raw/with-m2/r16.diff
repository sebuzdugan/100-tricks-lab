+++ b/test/reports.test.js
@@ -0,0 +1,268 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+function makeIssuedInvoice(customerId = 'C-001', issueDate = '2024-01-15') {
+  const draft = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  return issued.value;
+}
+
+function makePaidInvoice(customerId = 'C-001', issueDate = '2024-01-15', paidAmount = null) {
+  const invoice = makeIssuedInvoice(customerId, issueDate);
+  if (paidAmount !== null) {
+    const payment = recordPayment(invoice, { amount: paidAmount, date: issueDate });
+    if (!payment.ok) throw new Error(`recordPayment failed: ${payment.error}`);
+    return payment.value;
+  }
+  return invoice;
+}
+
+test('overdueInvoices returns empty array for empty list', () => {
+  const result = overdueInvoices([], '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices returns single overdue invoice', () => {
+  const invoice = makeIssuedInvoice();
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2024-02-28');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].number, invoice.number);
+});
+
+test('overdueInvoices includes invoice number, customerId, dueDate, daysOverdue, due', () => {
+  const invoice = makeIssuedInvoice();
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2024-02-28');
+  const overdue = result.value[0];
+
+  assert.ok(overdue.number);
+  assert.ok(overdue.customerId);
+  assert.ok(overdue.dueDate);
+  assert.equal(typeof overdue.daysOverdue, 'number');
+  assert.equal(typeof overdue.due, 'number');
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2024-03-15');
+  const overdue = result.value[0];
+
+  // Issue date: 2024-01-15, default terms NET30, due date: 2024-02-14
+  // As of: 2024-03-15
+  // Days overdue: from 2024-02-14 to 2024-03-15 = 30 days
+  assert.equal(overdue.daysOverdue, 30);
+});
+
+test('overdueInvoices calculates due amount from balanceDue', () => {
+  const invoice = makeIssuedInvoice();
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2024-02-28');
+  const overdue = result.value[0];
+
+  const expected = balanceDue(invoice);
+  assert.equal(overdue.due, expected);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const invoices = [draft.value];
+
+  const result = overdueInvoices(invoices, '2024-12-31');
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const invoice = makePaidInvoice('C-001', '2024-01-15', fullTotal);
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2024-12-31');
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoice = makePaidInvoice('C-001', '2024-01-15', 5000);
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2024-02-28');
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].customerId, 'C-001');
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const invoices = [invoice];
+
+  // Due date is 2024-02-14, so as of 2024-02-13 it should not be overdue
+  const result = overdueInvoices(invoices, '2024-02-13');
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes invoices on exact due date', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const invoices = [invoice];
+
+  // Due date is 2024-02-14, so as of 2024-02-14 it should not be overdue yet
+  const result = overdueInvoices(invoices, '2024-02-14');
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices includes invoices day after due date', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const invoices = [invoice];
+
+  // Due date is 2024-02-14, so as of 2024-02-15 it should be 1 day overdue
+  const result = overdueInvoices(invoices, '2024-02-15');
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].daysOverdue, 1);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const invoice1 = makeIssuedInvoice('C-001', '2024-01-01');
+  const invoice2 = makeIssuedInvoice('C-002', '2024-01-15');
+  const invoice3 = makeIssuedInvoice('C-003', '2024-02-01');
+
+  const invoices = [invoice1, invoice2, invoice3];
+
+  const result = overdueInvoices(invoices, '2024-03-15');
+  const overdue = result.value;
+
+  // Most overdue first (invoice1 issued earliest)
+  // Invoice1 due 2024-01-31, Invoice2 due 2024-02-14 (14 days later), Invoice3 due 2024-03-02 (17 days after invoice2)
+  assert.equal(overdue[0].number, invoice1.number);
+  assert.equal(overdue[1].number, invoice2.number);
+  assert.equal(overdue[2].number, invoice3.number);
+  assert(overdue[0].daysOverdue > overdue[1].daysOverdue);
+  assert(overdue[1].daysOverdue > overdue[2].daysOverdue);
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const invoices = [
+    makeIssuedInvoice('C-001', '2024-01-15'),
+    makeIssuedInvoice('C-002', '2024-01-20'),
+    makeIssuedInvoice('C-001', '2024-02-01'),
+  ];
+
+  const result = overdueInvoices(invoices, '2024-03-15');
+  assert.equal(result.value.length, 3);
+
+  // Check both customers are included
+  const customers = result.value.map(inv => inv.customerId);
+  assert.ok(customers.includes('C-001'));
+  assert.ok(customers.includes('C-002'));
+});
+
+test('overdueInvoices with partially paid invoice calculates correct due', () => {
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const paidAmount = Math.floor(fullTotal / 2);
+  const invoice = makePaidInvoice('C-001', '2024-01-15', paidAmount);
+
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2024-02-28');
+  const overdue = result.value[0];
+
+  assert.equal(overdue.due, fullTotal - paidAmount);
+});
+
+test('overdueInvoices mixed overdue and not yet due', () => {
+  const invoice1 = makeIssuedInvoice('C-001', '2024-01-01');
+  const invoice2 = makeIssuedInvoice('C-002', '2024-02-15');
+
+  const invoices = [invoice1, invoice2];
+
+  const result = overdueInvoices(invoices, '2024-02-28');
+  // Invoice1 due on 2024-01-31, overdue by 28 days
+  // Invoice2 due on 2024-03-16, not yet due
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].customerId, 'C-001');
+});
+
+test('overdueInvoices with various amounts overdue', () => {
+  const invoices = [
+    makeIssuedInvoice('C-001', '2024-01-10'),
+    makeIssuedInvoice('C-002', '2024-01-20'),
+    makeIssuedInvoice('C-003', '2024-02-05'),
+  ];
+
+  const result = overdueInvoices(invoices, '2024-03-10');
+  const overdue = result.value;
+
+  // All should be overdue, most overdue first
+  assert.equal(overdue.length, 3);
+  assert(overdue[0].daysOverdue >= overdue[1].daysOverdue);
+  assert(overdue[1].daysOverdue >= overdue[2].daysOverdue);
+});
+
+test('overdueInvoices with EOM payment terms', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    terms: 'EOM',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  const invoices = [issued.value];
+
+  // EOM for Jan 15 issue date = due Jan 31
+  const result = overdueInvoices(invoices, '2024-02-28');
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].dueDate, '2024-01-31');
+});
+
+test('overdueInvoices with NET14 payment terms', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    terms: 'NET14',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  const invoices = [issued.value];
+
+  // NET14 for Jan 15 issue date = due Jan 29
+  const result = overdueInvoices(invoices, '2024-02-28');
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].dueDate, '2024-01-29');
+});
+
+test('overdueInvoices returns ok result', () => {
+  const invoices = [makeIssuedInvoice()];
+  const result = overdueInvoices(invoices, '2024-02-28');
+
+  assert.equal(result.ok, true);
+  assert.ok(Array.isArray(result.value));
+});
