diff --git a/src/reports.js b/src/reports.js
index 66c7d76..fc8cec8 100644
--- a/src/reports.js
+++ b/src/reports.js
@@ -19,3 +19,39 @@ export function overdueInvoices(invoices, asOf) {
 
   return ok(overdue);
 }
+
+export function vatSummary(invoices) {
+  const rateMap = new Map();
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const vatRate = line.vatRate ?? 0;
+
+      const subtotal = line.qty * line.unitPrice;
+      const discountPercent = line.discountPercent ?? 0;
+      const afterDiscount = subtotal * (1 - discountPercent / 100);
+      const vat = Math.max(0, Math.round(afterDiscount * (vatRate / 100)));
+
+      if (!rateMap.has(vatRate)) {
+        rateMap.set(vatRate, { baseSum: 0, vatSum: 0 });
+      }
+      const entry = rateMap.get(vatRate);
+      entry.baseSum += afterDiscount;
+      entry.vatSum += vat;
+    }
+  }
+
+  const result = Array.from(rateMap.entries())
+    .map(([rate, { baseSum, vatSum }]) => ({
+      rate,
+      base: Math.round(baseSum),
+      vat: vatSum,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return ok(result);
+}
