+
+// vatSummary tests
+import { vatSummary } from '../src/reports.js';
+
+test('vatSummary returns empty array for empty invoice list', () => {
+  const result = vatSummary([]);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('vatSummary aggregates single VAT rate', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const invoices = [invoice];
+
+  const result = vatSummary(invoices);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].rate, 21);
+});
+
+test('vatSummary includes rate, base, and vat fields', () => {
+  const invoice = makeIssuedInvoice();
+  const invoices = [invoice];
+
+  const result = vatSummary(invoices);
+  const entry = result.value[0];
+
+  assert.ok(typeof entry.rate === 'number');
+  assert.ok(typeof entry.base === 'number');
+  assert.ok(typeof entry.vat === 'number');
+});
+
+test('vatSummary calculates base and vat correctly', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  const invoices = [issued.value];
+  const result = vatSummary(invoices);
+
+  // DES-HOUR qty 1: 8500 cents
+  // Line has 5% discount applied: base = 8500 * 0.95 = 8075
+  // vat = Math.round(8075 * 0.21) = Math.round(1695.75) = 1696
+  const entry = result.value[0];
+  assert.equal(entry.rate, 21);
+  assert.equal(entry.base, Math.round(8500 * 0.95));
+  assert.equal(entry.vat, Math.round(Math.round(8500 * 0.95) * 0.21));
+});
+
+test('vatSummary aggregates multiple invoices with same rate', () => {
+  const invoice1 = makeIssuedInvoice('C-001', '2024-01-15');
+  const invoice2 = makeIssuedInvoice('C-002', '2024-01-20');
+
+  const invoices = [invoice1, invoice2];
+  const result = vatSummary(invoices);
+
+  // Invoice 1 (2024-01-15): DES-HOUR qty 2 with 5% discount = 16150 base
+  // Invoice 2 (2024-01-20): DES-HOUR qty 2 with 0% discount = 17000 base
+  // Total: 33150 base, 6944 vat
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].rate, 21);
+  assert.equal(result.value[0].base, 33150);
+  assert.equal(result.value[0].vat, Math.round(16150 * 0.21) + Math.round(17000 * 0.21));
+});
+
+test('vatSummary handles multiple VAT rates', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 1 },
+    ],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  const invoices = [issued.value];
+  const result = vatSummary(invoices);
+
+  // Should have two entries: 21% and 9%
+  assert.equal(result.value.length, 2);
+  assert.equal(result.value[0].rate, 21);
+  assert.equal(result.value[1].rate, 9);
+});
+
+test('vatSummary sorts by rate descending', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 1 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  const invoices = [issued.value];
+  const result = vatSummary(invoices);
+
+  // Should be sorted: 21, 9, 0
+  assert.equal(result.value[0].rate, 21);
+  assert.equal(result.value[1].rate, 9);
+  assert.equal(result.value[2].rate, 0);
+});
+
