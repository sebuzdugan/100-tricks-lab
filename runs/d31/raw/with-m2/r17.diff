+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const invoices = [draft.value];
+  const result = vatSummary(invoices);
+
+  assert.equal(result.value.length, 0);
+});
+
+test('vatSummary includes issued invoices', () => {
+  const invoice = makeIssuedInvoice();
+  const invoices = [invoice];
+
+  const result = vatSummary(invoices);
+  assert.equal(result.value.length, 1);
+});
+
+test('vatSummary includes partially_paid invoices', () => {
+  const invoice = makePaidInvoice('C-001', '2024-01-15', 5000);
+  const invoices = [invoice];
+
+  const result = vatSummary(invoices);
+  assert.equal(result.value.length, 1);
+});
+
+test('vatSummary includes paid invoices', () => {
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const invoice = makePaidInvoice('C-001', '2024-01-15', fullTotal);
+  const invoices = [invoice];
+
+  const result = vatSummary(invoices);
+  assert.equal(result.value.length, 1);
+});
+
+test('vatSummary applies line discount to base calculation', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const withDiscount = addLineDiscount(draft.value, 'DES-HOUR', 50);
+  if (!withDiscount.ok) throw new Error(`addLineDiscount failed: ${withDiscount.error}`);
+
+  const issued = issueInvoice(withDiscount.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  const invoices = [issued.value];
+  const result = vatSummary(invoices);
+
+  // DES-HOUR: 8500, with 50% discount = 4250 base
+  // vat = Math.round(4250 * 0.21) = Math.round(892.5) = 892 or 893
+  const entry = result.value[0];
+  assert.equal(entry.rate, 21);
+  assert.equal(entry.base, 4250);
+  assert.equal(entry.vat, Math.round(4250 * 0.21));
+});
+
+test('vatSummary aggregates multiple lines with different rates in one invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'PRINT-A4', qty: 10 },
+    ],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  const invoices = [issued.value];
+  const result = vatSummary(invoices);
+
+  // Each line gets 5% discount
+  // 21% rate: 2 * 8500 * 0.95 = 16150 base
+  // 9% rate: 10 * 37 * 0.95 = 351.5 → 352 base (rounded)
+  const rate21 = result.value.find(e => e.rate === 21);
+  const rate9 = result.value.find(e => e.rate === 9);
+
+  assert.equal(rate21.base, 16150);
+  assert.equal(rate9.base, Math.round(10 * 37 * 0.95));
+});
+
+test('vatSummary handles zero VAT rate', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  const invoices = [issued.value];
+  const result = vatSummary(invoices);
+
+  // WORKSHOP-DAY: 60000 with 5% discount = 57000, 0% VAT
+  const entry = result.value[0];
+  assert.equal(entry.rate, 0);
+  assert.equal(entry.base, Math.round(60000 * 0.95));
+  assert.equal(entry.vat, 0);
+});
+
+test('vatSummary with mixed invoice statuses', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = makeIssuedInvoice('C-002', '2024-01-20');
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const paid = makePaidInvoice('C-003', '2024-01-25', fullTotal);
+
+  const invoices = [draft.value, issued, paid];
+  const result = vatSummary(invoices);
+
+  // Only issued and paid should be included (draft excluded)
+  assert.equal(result.value.length, 1);
+  // Verify that both issued and paid invoices are aggregated correctly
+  // (don't hardcode base value as it depends on invoice line details)
+  assert.equal(result.value[0].rate, 21);
+  assert(result.value[0].base > 0);
+  assert(result.value[0].vat > 0);
+});
+
+test('vatSummary returns ok result', () => {
+  const invoices = [makeIssuedInvoice()];
+  const result = vatSummary(invoices);
+
+  assert.equal(result.ok, true);
+  assert.ok(Array.isArray(result.value));
+});
+
+function addLineDiscount(invoice, sku, percent) {
+  const updated = {
+    ...invoice,
+    lines: invoice.lines.map(line =>
+      line.sku === sku ? { ...line, discountPercent: percent } : line
+    ),
+  };
+  return { ok: true, value: updated };
+}
