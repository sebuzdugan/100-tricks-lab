+
+// lateFee tests
+import { lateFee } from '../src/reports.js';
+
+test('lateFee returns 0 for invoice not yet due', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const fee = lateFee(invoice, '2024-02-13');
+
+  // Due date is 2024-02-14, so as of 2024-02-13 it's not yet due
+  assert.equal(fee, 0);
+});
+
+test('lateFee returns 0 for invoice on due date', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const fee = lateFee(invoice, '2024-02-14');
+
+  // Due date is 2024-02-14, so as of 2024-02-14 it's not yet overdue
+  assert.equal(fee, 0);
+});
+
+test('lateFee returns 0 for fully paid invoice', () => {
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const invoice = makePaidInvoice('C-001', '2024-01-15', fullTotal);
+
+  const fee = lateFee(invoice, '2024-03-15');
+  assert.equal(fee, 0);
+});
+
+test('lateFee calculates fee for 1 day overdue', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const balance = balanceDue(invoice);
+
+  const fee = lateFee(invoice, '2024-02-15');
+  // 1 day overdue, fee = balance * 1 * 0.0004
+  const expected = Math.round(balance * 1 * 0.0004);
+  assert.equal(fee, expected);
+});
+
+test('lateFee calculates fee for 10 days overdue', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const balance = balanceDue(invoice);
+
+  const fee = lateFee(invoice, '2024-02-24');
+  // 10 days overdue (from 2024-02-14 to 2024-02-24), fee = balance * 10 * 0.0004
+  const expected = Math.round(balance * 10 * 0.0004);
+  assert.equal(fee, expected);
+});
+
+test('lateFee fee increases with days overdue', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+
+  const fee1 = lateFee(invoice, '2024-02-15');
+  const fee5 = lateFee(invoice, '2024-02-19');
+  const fee10 = lateFee(invoice, '2024-02-24');
+
+  assert(fee1 < fee5);
+  assert(fee5 < fee10);
+});
+
+test('lateFee for partially paid invoice', () => {
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const paidAmount = Math.floor(fullTotal / 2);
+  const invoice = makePaidInvoice('C-001', '2024-01-15', paidAmount);
+
+  const fee = lateFee(invoice, '2024-02-15');
+  // Balance = fullTotal - paidAmount
+  const balance = fullTotal - paidAmount;
+  const expected = Math.round(balance * 1 * 0.0004);
+  assert.equal(fee, expected);
+});
+
+test('lateFee is proportional to balance', () => {
+  const invoice1 = makeIssuedInvoice('C-001', '2024-01-15');
+  const balance1 = balanceDue(invoice1);
+
+  const paidAmount = Math.floor(balance1 / 2);
+  const invoice2 = makePaidInvoice('C-002', '2024-01-15', paidAmount);
+
+  const fee1 = lateFee(invoice1, '2024-02-15');
+  const fee2 = lateFee(invoice2, '2024-02-15');
+
+  // fee2 should be roughly half of fee1 (same days overdue, half the balance)
+  assert(fee2 < fee1);
+  assert.equal(fee2, Math.round(fee1 / 2));
+});
+
+test('lateFee rounds to cents', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const fee = lateFee(invoice, '2024-02-15');
+
+  // Fee should be an integer (cents)
+  assert.equal(fee, Math.round(fee));
+  assert.equal(Number.isInteger(fee), true);
+});
+
+test('lateFee is 0.04% per day', () => {
+  // Create a simple scenario to verify the calculation
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const balance = balanceDue(invoice);
+
+  // For 1 day overdue, fee should be balance * 0.0004
+  const fee = lateFee(invoice, '2024-02-15');
+  const expected = Math.round(balance * 0.0004);
+  assert.equal(fee, expected);
+
+  // For 5 days overdue, fee should be balance * 0.002
+  const fee5 = lateFee(invoice, '2024-02-19');
+  const expected5 = Math.round(balance * 0.002);
+  assert.equal(fee5, expected5);
+});
+
+test('lateFee with large balance and many days', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const balance = balanceDue(invoice);
+
+  const fee = lateFee(invoice, '2024-03-15');
+  // 30 days overdue (from 2024-02-14 to 2024-03-15)
+  // fee = balance * 30 * 0.0004 = balance * 0.012
+  const expected = Math.round(balance * 0.012);
+  assert.equal(fee, expected);
+});
+
+test('lateFee with draft invoice still calculates (if called)', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  // Draft invoices have a dueDate but no status check in lateFee
+  // lateFee should still work on draft invoices if called
+  const fee = lateFee(draft.value, '2024-03-15');
+  assert.equal(typeof fee, 'number');
+});
+
+test('lateFee returns integer (cents)', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const fee = lateFee(invoice, '2024-02-28');
+
+  assert.equal(Number.isInteger(fee), true);
+});
+
+test('lateFee with zero balance is zero', () => {
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const invoice = makePaidInvoice('C-001', '2024-01-15', fullTotal);
+
+  const fee = lateFee(invoice, '2024-03-15');
+  assert.equal(fee, 0);
+});
+
+test('lateFee comparison: more overdue = higher fee', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+
+  const fee1day = lateFee(invoice, '2024-02-15');
+  const fee3day = lateFee(invoice, '2024-02-17');
+  const fee7day = lateFee(invoice, '2024-02-21');
+
+  assert(fee1day > 0);
+  assert(fee3day > fee1day);
+  assert(fee7day > fee3day);
+  // Fees should increase approximately linearly (within rounding error)
+  assert(Math.abs(fee3day - fee1day * 3) <= 1);
+  assert(Math.abs(fee7day - fee1day * 7) <= 1);
+});
