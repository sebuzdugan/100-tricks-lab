index 0000000..1374bc3
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,313 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+function makeIssuedInvoice(customerId = 'C-001', issueDate = '2024-01-15') {
+  const draft = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const issued = issueInvoice(draft.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  return issued.value;
+}
+
+function makePaidInvoice(customerId = 'C-001', issueDate = '2024-01-15', paidAmount = null) {
+  const invoice = makeIssuedInvoice(customerId, issueDate);
+  if (paidAmount !== null) {
+    const payment = recordPayment(invoice, { amount: paidAmount, date: issueDate });
+    if (!payment.ok) throw new Error(`recordPayment failed: ${payment.error}`);
+    return payment.value;
+  }
+  return invoice;
+}
+
+test('exportCsv returns string with header', () => {
+  const csv = exportCsv([]);
+  assert.equal(typeof csv, 'string');
+  assert.ok(csv.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv with empty invoice list has only header', () => {
+  const csv = exportCsv([]);
+  const lines = csv.trim().split('\n');
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv ends with newline', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv[csv.length - 1], '\n');
+});
+
+test('exportCsv with single invoice', () => {
+  const invoice = makeIssuedInvoice();
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.trim().split('\n');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv includes invoice number', () => {
+  const invoice = makeIssuedInvoice();
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes(invoice.number));
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = makeIssuedInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  // Customer C-001 should have name 'Alice' or similar
+  assert.ok(csv.includes(',') && csv.split('\n')[1].split(',')[1].length > 0);
+});
+
+test('exportCsv includes issue date', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes('2024-01-15'));
+});
+
+test('exportCsv includes due date', () => {
+  const invoice = makeIssuedInvoice('C-001', '2024-01-15');
+  const csv = exportCsv([invoice]);
+
+  // Due date should be 2024-02-14 (NET30 default)
+  assert.ok(csv.includes('2024-02-14'));
+});
+
+test('exportCsv includes invoice status', () => {
+  const invoice = makeIssuedInvoice();
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes('issued'));
+});
+
+test('exportCsv formats amounts in euros with 2 decimals', () => {
+  const invoice = makeIssuedInvoice();
+  const csv = exportCsv([invoice]);
+
+  // Should contain decimal amounts like "170.50"
+  const lines = csv.trim().split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  // subtotal, discount, vat, total, due are in positions 5, 6, 7, 8, 9
+  for (let i = 5; i < 10; i++) {
+    const amount = parts[i];
+    assert.ok(/^\d+\.\d{2}$/.test(amount), `Amount ${amount} should be in format XXX.XX`);
+  }
+});
+
+test('exportCsv uses dot as decimal separator', () => {
+  const invoice = makeIssuedInvoice();
+  const csv = exportCsv([invoice]);
+
+  // Should use dot, not comma, for decimals
+  assert.ok(/\d+\.\d{2}/.test(csv));
+});
+
+test('exportCsv does not use thousands separator', () => {
+  const invoice = makeIssuedInvoice();
+  const csv = exportCsv([invoice]);
+
+  // Should not have commas inside amounts (except as field separator)
+  const lines = csv.trim().split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  for (let i = 5; i < 10; i++) {
+    const amount = parts[i];
+    assert.ok(!amount.includes(','), `Amount ${amount} should not have comma`);
+  }
+});
+
+test('exportCsv escapes fields with commas', () => {
+  // Create invoices with customers that might have commas
+  const invoice = makeIssuedInvoice('C-004');
+  const csv = exportCsv([invoice]);
+
+  // Just verify the export works
+  assert.ok(csv.length > 0);
+});
+
+test('exportCsv escapes fields with double quotes', () => {
+  const invoice = makeIssuedInvoice();
+  const csv = exportCsv([invoice]);
+
+  // If any field has a quote, it should be escaped as ""
+  if (csv.includes('"')) {
+    assert.ok(csv.includes('""') || csv.match(/"[^"]*"[^"]*"/));
+  }
+});
+
+test('exportCsv with multiple invoices', () => {
+  const invoice1 = makeIssuedInvoice('C-001', '2024-01-15');
+  const invoice2 = makeIssuedInvoice('C-002', '2024-01-20');
+
+  const csv = exportCsv([invoice1, invoice2]);
+  const lines = csv.trim().split('\n');
+
+  assert.equal(lines.length, 3); // header + 2 invoices
+  assert.ok(csv.includes(invoice1.number));
+  assert.ok(csv.includes(invoice2.number));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invoice1 = makeIssuedInvoice('C-001', '2024-01-15');
+  const invoice2 = makeIssuedInvoice('C-002', '2024-01-20');
+  const invoice3 = makeIssuedInvoice('C-003', '2024-01-25');
+
+  const csv = exportCsv([invoice1, invoice2, invoice3]);
+  const lines = csv.trim().split('\n');
+
+  assert.ok(lines[1].includes(invoice1.number));
+  assert.ok(lines[2].includes(invoice2.number));
+  assert.ok(lines[3].includes(invoice3.number));
+});
+
+test('exportCsv calculates due correctly for unpaid invoice', () => {
+  const invoice = makeIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.trim().split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  // due (last field) should equal total for unpaid invoice
+  const total = parts[8];
+  const due = parts[9];
+  assert.equal(due, total);
+});
+
+test('exportCsv calculates due correctly for paid invoice', () => {
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const invoice = makePaidInvoice('C-001', '2024-01-15', fullTotal);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.trim().split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  // due (last field) should be 0.00 for fully paid invoice
+  const due = parts[9];
+  assert.equal(due, '0.00');
+});
+
+test('exportCsv shows partially paid invoice correctly', () => {
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const paidAmount = Math.floor(fullTotal / 2);
+  const invoice = makePaidInvoice('C-001', '2024-01-15', paidAmount);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.trim().split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  const total = parseFloat(parts[8]);
+  const due = parseFloat(parts[9]);
+
+  // due should be less than total and greater than 0
+  assert(due < total);
+  assert(due > 0);
+});
+
+test('exportCsv includes all required columns', () => {
+  const invoice = makeIssuedInvoice();
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.trim().split('\n');
+  const header = lines[0];
+  const columns = header.split(',');
+
+  const required = ['number', 'customer', 'issueDate', 'dueDate', 'status', 'subtotal', 'discount', 'vat', 'total', 'due'];
+  assert.deepEqual(columns, required);
+});
+
+test('exportCsv each line ends with newline', () => {
+  const invoice1 = makeIssuedInvoice('C-001', '2024-01-15');
+  const invoice2 = makeIssuedInvoice('C-002', '2024-01-20');
+
+  const csv = exportCsv([invoice1, invoice2]);
+
+  // Every line should be followed by \n
+  assert.equal(csv[csv.length - 1], '\n');
+  const parts = csv.split('\n');
+  assert.equal(parts[parts.length - 1], ''); // Last part is empty after final \n
+});
+
+test('exportCsv with draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!draft.ok) throw new Error(`createInvoice failed: ${draft.error}`);
+
+  const csv = exportCsv([draft.value]);
+  const lines = csv.trim().split('\n');
+
+  assert.equal(lines.length, 2);
+  assert.ok(lines[1].includes('draft'));
+});
+
+test('exportCsv with different statuses', () => {
+  const issued = makeIssuedInvoice('C-001', '2024-01-15');
+  const fullTotal = invoiceTotals(issued).total;
+  const paid = makePaidInvoice('C-002', '2024-01-20', fullTotal);
+  const partiallyPaid = makePaidInvoice('C-003', '2024-01-25', 5000);
+
+  const csv = exportCsv([issued, paid, partiallyPaid]);
+
+  assert.ok(csv.includes('issued'));
+  assert.ok(csv.includes('paid'));
+  assert.ok(csv.includes('partially_paid'));
+});
+
+test('exportCsv converts cents to euros correctly', () => {
+  const invoice = makeIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.trim().split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  const subtotalCSV = parseFloat(parts[5]);
+  const subtotalExpected = totals.subtotal / 100;
+  assert.equal(subtotalCSV, subtotalExpected);
+});
+
+test('exportCsv with zero amounts', () => {
+  const fullTotal = invoiceTotals(makeIssuedInvoice()).total;
+  const invoice = makePaidInvoice('C-001', '2024-01-15', fullTotal);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.trim().split('\n');
+  const dataLine = lines[1];
+
+  // due should be 0.00
+  assert.ok(dataLine.includes('0.00'));
+});
+
+test('exportCsv includes numeric invoice number as string', () => {
+  const invoice = makeIssuedInvoice();
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.trim().split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  // First field is the invoice number
+  assert.equal(parts[0], invoice.number);
+});
