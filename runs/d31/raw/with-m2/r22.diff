+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 120000 }), 120000);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 50 }), 5000);
+});
+
+test('lineTotal works with large quantities', () => {
+  assert.equal(lineTotal({ qty: 10000, unitPrice: 9500 }), 95000000);
+});
+
+test('lineTotal with zero quantity', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 8500 }), 0);
+});
+
+test('lineTotal with zero unit price', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 0 }), 0);
+});
+
+test('lineDiscount calculates discount amount correctly', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 1000, discountPercent: 10 }), 1000);
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 8500, discountPercent: 20 }), 8500);
+});
+
+test('lineDiscount defaults to 0% when discountPercent not provided', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 1000 }), 0);
+});
+
+test('lineDiscount handles decimal discount percentages', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 1000, discountPercent: 12.5 }), 1250);
+});
+
+test('lineDiscount rounds to nearest cent', () => {
+  assert.equal(lineDiscount({ qty: 3, unitPrice: 1000, discountPercent: 33.33 }), 1000);
+});
+
+test('lineDiscount returns correct amount for full discount', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 1000, discountPercent: 100 }), 10000);
+});
+
+test('lineDiscount clamps at 0 for negative calculation', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 1000, discountPercent: 0 }), 0);
+});
+
+test('lineVat calculates VAT on line amount after discount', () => {
+  // 5 * 10000 cents = 50000 cents (€500), no discount, 21% VAT = 10500 cents (€105)
+  assert.equal(lineVat({ qty: 5, unitPrice: 10000, vatRate: 21 }), 10500);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  // 10 * 10000 = 100000 cents, 10% discount = 10000 cents, after discount 90000 cents
+  // 90000 * 21% = 18900 cents
+  assert.equal(lineVat({ qty: 10, unitPrice: 10000, discountPercent: 10, vatRate: 21 }), 18900);
+});
+
+test('lineVat with 0% VAT rate', () => {
+  assert.equal(lineVat({ qty: 5, unitPrice: 10000, vatRate: 0 }), 0);
+});
+
+test('lineVat defaults to 0% VAT when vatRate not provided', () => {
+  assert.equal(lineVat({ qty: 5, unitPrice: 10000 }), 0);
+});
+
+test('lineVat with 9% VAT rate', () => {
+  // 10 * 10000 = 100000 cents, 9% VAT = 9000 cents
+  assert.equal(lineVat({ qty: 10, unitPrice: 10000, vatRate: 9 }), 9000);
+});
+
+test('lineVat rounds VAT to nearest cent', () => {
+  // 3 * 1000 = 3000 cents, 21% VAT = 630 cents
+  assert.equal(lineVat({ qty: 3, unitPrice: 1000, vatRate: 21 }), 630);
+});
+
+test('lineVat with large amounts', () => {
+  // 100 * 50000 = 5000000 cents, 21% VAT = 1050000 cents
+  assert.equal(lineVat({ qty: 100, unitPrice: 50000, vatRate: 21 }), 1050000);
+});
+
+test('invoiceTotals calculates subtotal and total correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500 },
+      { qty: 10, unitPrice: 9500 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 137500, discount: 0, vat: 0, voucher: 0, total: 137500 });
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 3, unitPrice: 120000 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 360000, discount: 0, vat: 0, voucher: 0, total: 360000 });
+});
+
+test('invoiceTotals does not mutate invoice', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500 },
+      { qty: 10, unitPrice: 9500 },
+    ],
+  };
+  const before = JSON.stringify(invoice);
+  invoiceTotals(invoice);
+  assert.equal(JSON.stringify(invoice), before);
+});
+
+test('invoiceTotals returns integer cents', () => {
+  const invoice = {
+    lines: [
+      { qty: 7, unitPrice: 1001 },
+      { qty: 3, unitPrice: 999 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(Number.isInteger(totals.subtotal), true);
+  assert.equal(Number.isInteger(totals.total), true);
+});
+
+test('invoiceTotals with VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 100000, discount: 0, vat: 21000, voucher: 0, total: 121000 });
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 10 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 100000, discount: 10000, vat: 0, voucher: 0, total: 90000 });
+});
+
+test('invoiceTotals with VAT and discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 100000, Discount: 10000, After discount: 90000, VAT (21% of 90000): 18900
+  // Total: 100000 - 10000 + 18900 = 108900
+  assert.deepEqual(totals, { subtotal: 100000, discount: 10000, vat: 18900, voucher: 0, total: 108900 });
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, vatRate: 21 },
+    ],
+    voucher: { code: 'PROMO', amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 100000, VAT: 21000, Total before voucher: 121000, After voucher: 111000
+  assert.deepEqual(totals, { subtotal: 100000, discount: 0, vat: 21000, voucher: 10000, total: 111000 });
+});
+
+test('invoiceTotals with multiple lines and different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 10000, vatRate: 21 },
+      { qty: 10, unitPrice: 10000, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: 50000, VAT 21%: 10500
+  // Line 2: 100000, VAT 9%: 9000
+  // Total VAT: 19500
+  // Total: 150000 + 19500 = 169500
+  assert.deepEqual(totals, { subtotal: 150000, discount: 0, vat: 19500, voucher: 0, total: 169500 });
+});
+
+test('invoiceTotals handles zero total with large voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000 },
+    ],
+    voucher: { code: 'BIG', amount: 100000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals aggregates multiple lines correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+      { qty: 3, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+      { qty: 1, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: 17000, discount 850, after 16150, VAT 3392
+  // Line 2: 28500, discount 1425, after 27075, VAT 5686
+  // Line 3: 120000, discount 0, after 120000, VAT 25200
+  // Subtotal: 165500, Discount: 2275, VAT: 34278, Total: 197503
+  assert.equal(totals.subtotal, 165500);
+  assert.equal(totals.discount, 2275);
+  assert.equal(totals.vat, 34278);
+  assert.equal(totals.total, 197503);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 0, discount: 0, vat: 0, voucher: 0, total: 0 });
+});
+
+test('invoiceTotals includes all components in total calculation', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 5, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 100000, Discount: 5000, After discount: 95000, VAT (21% of 95000): 19950
+  // Total: 100000 - 5000 + 19950 - 5000 = 109950
+  assert.equal(totals.total, 109950);
+});
