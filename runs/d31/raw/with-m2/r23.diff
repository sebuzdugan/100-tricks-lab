--- a/src/totals.js
+++ b/src/totals.js
@@ -10,15 +10,24 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount amount for a single line.
+ * Calculate the discount amount for a single line (primary + bulk if qty >= 10).
+ * Bulk discount is 2.5% applied after primary discount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
   const total = lineTotal(line);
   const discountPercent = line.discountPercent ?? 0;
-  const discount = total * (discountPercent / 100);
-  return Math.max(0, Math.round(discount));
+  const primaryDiscount = Math.round(total * (discountPercent / 100));
+
+  // Bulk discount: 2.5% off if qty >= 10, applied after primary discount
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const afterPrimaryDiscount = Math.max(0, total - primaryDiscount);
+    bulkDiscount = Math.round(afterPrimaryDiscount * 0.025);
+  }
+
+  return Math.max(0, primaryDiscount + bulkDiscount);
 }
 
