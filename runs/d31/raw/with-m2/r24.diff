   const fee = balance * daysOverdue * 0.0004;
   return Math.round(fee);
 }
+
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    counts[invoice.status]++;
+  }
+
+  // Calculate outstanding amount (invoices not yet fully paid)
+  let outstanding = 0;
+  const customerDue = new Map();
+
+  for (const invoice of invoices) {
+    if (['issued', 'partially_paid'].includes(invoice.status)) {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      // Track per-customer due amounts
+      if (!customerDue.has(invoice.customerId)) {
+        customerDue.set(invoice.customerId, 0);
+      }
+      customerDue.set(invoice.customerId, customerDue.get(invoice.customerId) + due);
+    }
+  }
+
+  // Get overdue info
+  const overdueResult = overdueInvoices(invoices, asOf);
+  const overdueList = overdueResult.value;
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Get top 3 customers by amount due
+  const topCustomers = Array.from(customerDue.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({ counts, outstanding, overdue, topCustomers });
+}
