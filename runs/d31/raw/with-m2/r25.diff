 export function renderInvoiceText(invoice) {
@@ -15,20 +16,54 @@ export function renderInvoiceText(invoice) {
   const customerResult = getCustomer(invoice.customerId);
   const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
 
-  // Build line items
+  // Build line items with discounts
   const lineItems = invoice.lines
     .map((line) => {
       const total = lineTotal(line);
       const unitPriceFormatted = formatEuros(line.unitPrice);
       const totalFormatted = formatEuros(total);
-      return `${line.qty} ${line.name} ${unitPriceFormatted} ${totalFormatted}`;
+      let lineText = `${line.qty} ${line.name} ${unitPriceFormatted} ${totalFormatted}`;
+
+      // Add discount if present
+      const discount = lineDiscount(line);
+      if (discount > 0) {
+        const discountFormatted = formatEuros(discount);
+        lineText += ` (discount: ${discountFormatted})`;
+      }
+
+      return lineText;
     })
     .join('\n');
 
   // Get totals
   const totals = invoiceTotals(invoice);
   const vatFormatted = formatEuros(totals.vat);
+
+  // Build output parts
+  const parts = [numberLine, customerName, lineItems];
+
+  // Add voucher if present
+  if (totals.voucher > 0) {
+    const voucherFormatted = formatEuros(totals.voucher);
+    parts.push(`Voucher: -${voucherFormatted}`);
+  }
+
+  // Add VAT and total
+  parts.push(`VAT: ${vatFormatted}`);
   const totalFormatted = formatEuros(totals.total);
+  parts.push(`Total: ${totalFormatted}`);
+
+  // Add due date if present
+  if (invoice.dueDate) {
+    parts.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Add amount paid if there are payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const paidFormatted = formatEuros(totalPaid);
+    parts.push(`Paid: ${paidFormatted}`);
+  }
 
-  return `${numberLine}\n${customerName}\n${lineItems}\nVAT: ${vatFormatted}\nTotal: ${totalFormatted}`;
+  return parts.join('\n');
 }
