@@ -0,0 +1,58 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(dateStr);
+  if (!match) return false;
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  return date instanceof Date && !isNaN(date.getTime()) && date.toISOString().startsWith(dateStr);
+}
+
+/**
+ * Create a draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customer = getCustomer(customerId);
+  if (!customer.ok) return customer;
+
+  if (!isValidDate(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+
+  if (!Array.isArray(lines) || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  const invoiceLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    const product = getProduct(line.sku);
+    if (!product.ok) return product;
+
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.value.name,
+      qty: line.qty,
+      unitPrice: product.value.unitPrice,
+      vatRate: product.value.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
