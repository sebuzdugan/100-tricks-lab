   return date instanceof Date && !isNaN(date.getTime()) && date.toISOString().startsWith(dateStr);
 }
 
+/**
+ * Calculate the total for a single line (qty * unitPrice).
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate subtotal and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number }> }}
+ * @returns {{ subtotal: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  return { subtotal, total: subtotal };
+}
