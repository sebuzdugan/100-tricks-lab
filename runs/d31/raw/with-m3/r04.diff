diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..ee97946
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,49 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for the first invoice in a year', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber returns 0002 when 0001 exists', () => {
+  const result = nextInvoiceNumber(['INV-2026-0001'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber increments correctly with multiple existing numbers', () => {
+  const result = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber restarts at 0001 in a new year', () => {
+  const result = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0002'], '2027-01-15');
+  assert.equal(result, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const result = nextInvoiceNumber(['INV-2025-0099', 'INV-2026-0001', 'INV-2027-0050'], '2026-05-20');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles unsorted input', () => {
+  const result = nextInvoiceNumber(['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.match(result, /INV-2026-0001/);
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = Array.from({ length: 1000 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-1001');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const result = nextInvoiceNumber(['INV-2026-XXXX', 'INV-2026-0001', 'invalid'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
