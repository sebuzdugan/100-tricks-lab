+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customer = getCustomer(invoice.customerId);
+  const customerName = customer.ok ? customer.value.name : 'Unknown Customer';
+
+  const header = invoice.number || 'DRAFT';
+  const totals = invoiceTotals(invoice);
+
+  const lines = [header, customerName];
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const qtyDisplay = `${line.qty}x`;
+    const unitPriceDisplay = formatEuros(line.unitPrice);
+    const totalDisplay = formatEuros(total);
+    const lineText = `${qtyDisplay} ${line.name.padEnd(30)} ${unitPriceDisplay.padStart(8)}  ${totalDisplay.padStart(8)}`;
+    lines.push(lineText);
+  }
+
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..782cf4d
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,208 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText returns a string', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(typeof result, 'string');
+});
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.match(result, /^DRAFT/);
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = renderInvoiceText(issued);
+  assert.match(result, /^INV-2026-0001/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const lines = result.split('\n');
+  assert.match(lines[1], /[A-Z]/); // customer name should be on line 2
+});
+
+test('renderInvoiceText includes all line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.match(result, /Design work/);
+  assert.match(result, /Development/);
+  assert.match(result, /2x/);
+  assert.match(result, /3x/);
+});
+
+test('renderInvoiceText shows quantities', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.match(result, /5x/);
+});
+
+test('renderInvoiceText formats amounts as euros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.match(result, /€\d+\.\d{2}/);
+});
+
+test('renderInvoiceText shows unit price', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  // DES-HOUR costs 8500 cents = €85.00
+  assert.match(result, /€85\.00/);
+});
+
+test('renderInvoiceText shows line totals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  // 2 * €85.00 = €170.00
+  assert.match(result, /€170\.00/);
+});
+
+test('renderInvoiceText includes Total line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.match(result, /Total: €\d+\.\d{2}/);
+});
+
+test('renderInvoiceText calculates correct total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  // DES-HOUR: 2 * 8500 = 17000
+  // DEV-HOUR: 3 * 9500 = 28500
+  // Total: 45500 = €455.00
+  assert.match(result, /Total: €455\.00/);
+});
+
+test('renderInvoiceText with a single line item', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4); // header + customer + 1 line item + total
+  assert.match(result, /100x/);
+});
+
+test('renderInvoiceText with multiple line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 1 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 6); // header + customer + 3 line items + total
+  assert.match(result, /Design work/);
+  assert.match(result, /Development/);
+  assert.match(result, /Copywriting/);
+});
+
+test('renderInvoiceText uses correct customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const lines = result.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText handles unknown customer gracefully', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.match(result, /Unknown Customer/);
+});
+
+test('renderInvoiceText output is multiline', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const lines = result.split('\n');
+  assert.ok(lines.length >= 4); // at least header, customer, line item, total
+});
