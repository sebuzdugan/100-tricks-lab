+    ],
+  }).value;
+
+  // DES-HOUR: 2 * 8500 = 17000, discount = 1700
+  // DEV-HOUR: 1 * 9500 = 9500, discount = 1900
+  // Total: 26500 - 3600 = 22900
+  const totals = invoiceTotals(invoice);
