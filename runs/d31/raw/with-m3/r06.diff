+});
+
+test('renderInvoiceText with discount has correct structure', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const lines = result.split('\n');
+  // header + customer + 1 line item + subtotal + discount + total
