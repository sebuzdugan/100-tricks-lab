+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 0 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, totals.subtotal);
+});
