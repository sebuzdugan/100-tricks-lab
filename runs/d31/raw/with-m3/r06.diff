+});
+
+test('renderInvoiceText shows correct discount amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  // 2 * 8500 = 17000, discount = 1700 = €17.00
+  assert.match(result, /Discount: -€17\.00/);
+});
+
+test('renderInvoiceText with multiple discounts shows combined discount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2, discountPercent: 10 },
+      { sku: 'DEV-HOUR', qty: 1, discountPercent: 20 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  // DES-HOUR discount: 17000 * 0.1 = 1700
+  // DEV-HOUR discount: 9500 * 0.2 = 1900
+  // Total discount: 3600 = €36.00
+  assert.match(result, /Discount: -€36\.00/);
+  assert.match(result, /Total: €229\.00/);
+});
