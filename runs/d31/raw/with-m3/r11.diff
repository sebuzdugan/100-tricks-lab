+test('balanceDue with no payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DESK', name: 'Desk', qty: 1, unitPrice: 50000, vatRate: 21, discountPercent: 0 },
+    ],
+    number: 'INV-2026-0001',
+  };
+  const due = balanceDue(invoice);
+  assert.equal(due, 60500); // 50000 + 21% VAT
+});
+
+test('balanceDue with partial payment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    lines: [
+      { sku: 'DESK', name: 'Desk', qty: 1, unitPrice: 50000, vatRate: 21, discountPercent: 0 },
+    ],
+    number: 'INV-2026-0001',
+    payments: [{ amount: 30000, date: '2026-10-07' }],
+  };
+  const due = balanceDue(invoice);
+  assert.equal(due, 30500); // 60500 - 30000
+});
+
