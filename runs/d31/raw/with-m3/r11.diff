+++ b/src/payments.js
@@ -0,0 +1,64 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the total amount paid on an invoice.
+ * @param {{ payments?: Array<{ amount: number, date: string }> }}
+ * @returns {number}
+ */
+function totalPaid(invoice) {
+  if (!invoice.payments || !Array.isArray(invoice.payments)) {
+    return 0;
+  }
+  return invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+}
+
+/**
+ * Calculate the balance still owed on an invoice.
+ * @param {{ lines: Array, payments?: Array<{ amount: number, date: string }> }}
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = totalPaid(invoice);
+  return Math.max(0, totals.total - paid);
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, payments?: Array<{ amount: number, date: string }>, number?: string }} invoice
+ * @param {{ amount: number, date: string }} param
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array, payments: Array, number?: string } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  const paid = totalPaid(invoice);
+  const owed = totals.total - paid;
+
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = invoice.payments ? [...invoice.payments] : [];
+  newPayments.push({ amount, date });
+
+  const newPaid = paid + amount;
+  const newStatus = newPaid >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({
+    number: invoice.number,
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: newStatus,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments: newPayments,
+  });
+}
