+  const result = statement('C-001', [issued1, issued2, issued3], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-05');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-10');
