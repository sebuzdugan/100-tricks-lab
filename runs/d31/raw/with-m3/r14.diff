+
+test('statement with partially paid invoice shows correct due', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const paid = recordPayment(issued, { amount: 30000, date: '2026-10-05' }).value;
+
+  const result = statement('C-001', [paid], '2026-10-07');
