+
+test('statement only includes invoices for specified customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
