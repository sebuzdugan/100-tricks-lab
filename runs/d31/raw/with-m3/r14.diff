+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2026-10-07');
+  assert.equal(result.ok, true);
+  const total1 = invoiceTotals(issued1).total;
+  const total2 = invoiceTotals(issued2).total;
+  assert.equal(result.value.totalDue, total1 + total2);
+});
+
+test('statement includes invoice number, issueDate, dueDate, total, and due', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = statement('C-001', [issued], '2026-10-07');
+  assert.equal(result.ok, true);
+  const inv_stmt = result.value.invoices[0];
+  assert.equal(inv_stmt.number, issued.number);
+  assert.equal(inv_stmt.issueDate, '2026-10-01');
+  assert.equal(inv_stmt.dueDate, '2026-10-31');
+  assert.ok(Number.isInteger(inv_stmt.total));
+  assert.ok(Number.isInteger(inv_stmt.due));
+  assert.equal(inv_stmt.due, inv_stmt.total);
