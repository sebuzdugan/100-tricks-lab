+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next credit note number.
+ * @param {Array<string>} existingNumbers - All existing invoice and credit note numbers
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} Credit note number in CN-YYYY-NNNN format
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = parseInt(date.substring(0, 4), 10);
+
+  const creditNoteNumbers = existingNumbers
+    .filter((num) => num.startsWith('CN-'))
+    .map((num) => {
+      const parts = num.split('-');
+      if (parts.length === 3 && !isNaN(parseInt(parts[1], 10)) && !isNaN(parseInt(parts[2], 10))) {
+        return { year: parseInt(parts[1], 10), counter: parseInt(parts[2], 10) };
+      }
+      return null;
+    })
+    .filter((num) => num !== null && num.year === year);
+
+  const maxCounter = creditNoteNumbers.length === 0 ? 0 : Math.max(...creditNoteNumbers.map((n) => n.counter));
+  const nextCounter = maxCounter + 1;
+
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ number?: string, status: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} param
+ * @param {Array<string>} existingNumbers - Invoice and credit note numbers already used
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
