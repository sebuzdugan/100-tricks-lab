+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Defective item', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, issued.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 10000);
+  assert.equal(result.value.reason, 'Defective item');
+  assert.equal(result.value.date, '2026-10-08');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = createCreditNote(inv, { amount: 10000, reason: 'Defective item', date: '2026-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote accepts partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const paid = recordPayment(issued, { amount: 5000, date: '2026-10-08' }).value;
+
+  const result = createCreditNote(paid, { amount: 5000, reason: 'Partial refund', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote accepts paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-08' }).value;
+
+  const result = createCreditNote(paid, { amount: 5000, reason: 'Refund', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects non-integer amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = createCreditNote(issued, { amount: 10000.5, reason: 'Defect', date: '2026-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = createCreditNote(issued, { amount: 0, reason: 'Defect', date: '2026-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = createCreditNote(issued, { amount: -10000, reason: 'Defect', date: '2026-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const result = createCreditNote(issued, { amount: totals.total + 1, reason: 'Defect', date: '2026-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote accepts amount equal to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const result = createCreditNote(issued, { amount: totals.total, reason: 'Full refund', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote generates sequential numbers within a year', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result1 = createCreditNote(issued1, { amount: 5000, reason: 'Defect', date: '2026-10-09' }, []);
+  const result2 = createCreditNote(issued2, { amount: 5000, reason: 'Defect', date: '2026-10-10' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote resets counter in new year', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result1 = createCreditNote(issued1, { amount: 5000, reason: 'Defect', date: '2026-10-09' }, []);
+  const result2 = createCreditNote(issued2, { amount: 5000, reason: 'Defect', date: '2027-01-20' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote pads counter with zeros', () => {
+  const existingNumbers = Array.from({ length: 15 }, (_, i) => `CN-2026-${String(i + 1).padStart(4, '0')}`);
+
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, ['INV-2026-0001']).value;
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Defect', date: '2026-10-08' }, existingNumbers);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0016');
+});
+
+test('createCreditNote includes invoice number in credit note', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Defect', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, issued.number);
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+});
+
+test('createCreditNote includes customer ID from invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Defect', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+});
+
+test('createCreditNote preserves reason text', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const reason = 'Customer requested refund due to service issues';
+  const result = createCreditNote(issued, { amount: 5000, reason, date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.reason, reason);
+});
+
+test('createCreditNote uses provided date for credit note', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Defect', date: '2026-10-15' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.date, '2026-10-15');
+});
+
+test('createCreditNote with mixed invoice and credit note numbers', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const existingNumbers = ['INV-2026-0001', 'CN-2026-0001', 'INV-2026-0002', 'CN-2026-0002'];
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Defect', date: '2026-10-08' }, existingNumbers);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote with large invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const result = createCreditNote(issued, { amount: 50000, reason: 'Partial refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.amount < totals.total);
+});
+
+test('createCreditNote credit note number uses credit note date year', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Defect', date: '2027-01-15' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote with multiple credits for same invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result1 = createCreditNote(issued, { amount: 10000, reason: 'Defect 1', date: '2026-10-08' }, []);
+  const result2 = createCreditNote(issued, { amount: 10000, reason: 'Defect 2', date: '2026-10-09' }, [result1.value.number]);
+
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2026-0002');
+  assert.ok(result1.value.amount + result2.value.amount <= totals.total);
+});
