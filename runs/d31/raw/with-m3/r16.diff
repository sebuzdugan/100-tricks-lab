+import { daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Get invoices that are overdue.
+ * @param {Array<{ number?: string, status: string, dueDate: string, lines: Array }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) => {
+      if (inv.status !== 'issued' && inv.status !== 'partially_paid') return false;
+      if (daysBetween(inv.dueDate, asOf) <= 0) return false;
+      return true;
+    })
+    .map((inv) => {
+      const daysOverdue = daysBetween(inv.dueDate, asOf);
+      const due = balanceDue(inv);
+      return {
+        number: inv.number,
+        customerId: inv.customerId,
+        dueDate: inv.dueDate,
+        daysOverdue,
+        due,
+      };
+    })
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
