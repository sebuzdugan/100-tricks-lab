+test('overdueInvoices returns empty array for no invoices', () => {
+  const result = overdueInvoices([], '2026-10-07');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes invoices with future due dates', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-20');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoices with past due dates', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.number);
+});
+
