 }
+
+/**
+ * Get a summary of VAT by rate across invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  invoices.forEach((inv) => {
+    if (inv.status !== 'issued' && inv.status !== 'partially_paid' && inv.status !== 'paid') return;
+
+    inv.lines.forEach((line) => {
+      const lineTotal = line.qty * line.unitPrice;
+      const discountAmount = roundCents(lineTotal * (line.discountPercent ?? 0) / 100);
+      const lineBase = lineTotal - discountAmount;
+      const lineVat = roundCents(lineBase * line.vatRate / 100);
+
+      if (!vatMap.has(line.vatRate)) {
+        vatMap.set(line.vatRate, { base: 0, vat: 0 });
+      }
+
+      const current = vatMap.get(line.vatRate);
+      current.base += lineBase;
+      current.vat += lineVat;
+    });
+  });
+
+  return Array.from(vatMap.entries())
+    .map(([rate, { base, vat }]) => ({ rate, base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+}
