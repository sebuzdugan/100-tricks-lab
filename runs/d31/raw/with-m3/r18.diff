     .map(([rate, { base, vat }]) => ({ rate, base, vat }))
     .sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fee for an invoice: 0.04% per day overdue.
+ * @param {{ status: string, dueDate: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.status === 'draft' || invoice.status === 'paid') {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  return roundCents(due * daysOverdue * 0.0004);
+}
