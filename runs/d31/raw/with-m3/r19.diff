+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header for empty list', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header with correct columns', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv ends with newline', () => {
+  const result = exportCsv([]);
+  assert.equal(result[result.length - 1], '\n');
+});
+
+test('exportCsv exports single issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].includes('INV-2026-0001'));
+  assert.ok(lines[1].includes('2026-10-01'));
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv exports draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
