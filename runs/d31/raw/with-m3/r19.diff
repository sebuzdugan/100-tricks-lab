+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+function formatEuro(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array<{ number?: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array }>} invoices
+ * @returns {string} CSV data with header and invoice lines
+ */
+export function exportCsv(invoices) {
+  const lines = ['number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'];
+
+  invoices.forEach((inv) => {
+    const customer = getCustomer(inv.customerId);
+    const customerName = customer.ok ? customer.value.name : '';
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const row = [
+      escapeCsvField(inv.number || ''),
+      escapeCsvField(customerName),
+      escapeCsvField(inv.issueDate),
+      escapeCsvField(inv.dueDate || ''),
+      escapeCsvField(inv.status),
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ].join(',');
+
+    lines.push(row);
+  });
+
+  return lines.join('\n') + '\n';
+}
