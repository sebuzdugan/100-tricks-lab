+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 25, unitPrice: 1700 };
+  assert.equal(lineTotal(line), 42500);
+});
+
+test('lineTotal works with qty of 1', () => {
+  const line = { qty: 1, unitPrice: 1299 };
+  assert.equal(lineTotal(line), 1299);
+});
+
+test('lineTotal works with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 100 };
+  assert.equal(lineTotal(line), 100000);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with zero unit price', () => {
+  const line = { qty: 5, unitPrice: 0 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('invoiceTotals returns object with subtotal and total', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 2, unitPrice: 5000, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.ok(result);
+  assert.equal(typeof result.subtotal, 'number');
+  assert.equal(typeof result.total, 'number');
+  assert.equal(typeof result.discount, 'number');
+  assert.equal(typeof result.vat, 'number');
+  assert.equal(typeof result.voucher, 'number');
+});
+
+test('invoiceTotals.subtotal is the sum of line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 5000, discountPercent: 0, vatRate: 0 },
+      { qty: 3, unitPrice: 2000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 16000);
+});
+
+test('invoiceTotals.total equals subtotal when no discount or VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 5000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.total, 5000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+});
+
+test('invoiceTotals works with a single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 8500);
+  assert.ok(result.vat > 0);
+});
+
+test('invoiceTotals works with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 20000);
+  assert.equal(result.vat, 2100 + 900);
+});
+
+test('invoiceTotals does not mutate the input', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const original = JSON.parse(JSON.stringify(invoice));
+  invoiceTotals(invoice);
+  assert.deepEqual(invoice, original);
+});
+
+test('invoiceTotals calculates discount correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 1000);
+});
+
+test('invoiceTotals with multiple lines and different discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 0 },
+      { qty: 1, unitPrice: 10000, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 3000);
+});
+
+test('invoiceTotals clamps negative total at 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+    voucher: { code: 'HUGE', amount: 10000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with zero discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 0);
+  assert.ok(result.total > result.subtotal);
+});
+
