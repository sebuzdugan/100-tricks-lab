--- a/src/totals.js
+++ b/src/totals.js
@@ -10,13 +10,19 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount for a single line.
+ * Calculate the discount for a single line (tier/line discount + bulk discount).
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
  * @returns {number}
  */
 function lineDiscount(line) {
-  const discount = lineTotal(line) * (line.discountPercent ?? 0) / 100;
-  return Math.max(0, roundCents(discount));
+  const firstDiscount = lineTotal(line) * (line.discountPercent ?? 0) / 100;
+  const amountAfterFirstDiscount = lineTotal(line) - roundCents(firstDiscount);
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    bulkDiscount = amountAfterFirstDiscount * 2.5 / 100;
+  }
+  const totalDiscount = roundCents(firstDiscount) + roundCents(bulkDiscount);
+  return Math.max(0, totalDiscount);
 }
 
