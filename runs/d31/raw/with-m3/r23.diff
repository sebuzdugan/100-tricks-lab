+test('invoiceTotals bulk discount with line discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  const lineTotal = 100000;
+  const firstDiscount = Math.round(lineTotal * 0.1);
+  const afterFirst = lineTotal - firstDiscount;
+  const bulkDiscount = Math.round(afterFirst * 0.025);
+  const totalDiscount = firstDiscount + bulkDiscount;
+  const afterAllDiscounts = lineTotal - totalDiscount;
+  const expectedVat = Math.round(afterAllDiscounts * 0.21);
+
+  assert.equal(result.discount, totalDiscount);
+  assert.equal(result.vat, expectedVat);
+  assert.equal(result.total, lineTotal - totalDiscount + expectedVat);
+});
