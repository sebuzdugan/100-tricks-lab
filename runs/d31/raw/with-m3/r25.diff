     lines.push(lineText);
+
+    const lineDiscount = calculateLineDiscount(line);
+    if (lineDiscount > 0) {
+      lines.push(`  Discount: -${formatEuros(lineDiscount)}`);
+    }
   }
 
   if (totals.discount > 0 || totals.vat > 0) {
@@ -37,7 +61,20 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(totals.voucher)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  const paid = totalPaid(invoice);
+  if (paid > 0) {
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
