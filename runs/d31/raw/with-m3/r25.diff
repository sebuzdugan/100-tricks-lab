 import { getCustomer } from './customers.js';
 import { formatEuros } from './money.js';
+import { roundCents } from './money.js';
 import { lineTotal, invoiceTotals } from './invoices.js';
 
+function calculateLineDiscount(line) {
+  const total = lineTotal(line);
+  const firstDiscount = roundCents(total * (line.discountPercent ?? 0) / 100);
+  const amountAfterFirstDiscount = total - firstDiscount;
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    bulkDiscount = roundCents(amountAfterFirstDiscount * 0.025);
+  }
+  return firstDiscount + bulkDiscount;
+}
+
+function totalPaid(invoice) {
+  if (!invoice.payments || !Array.isArray(invoice.payments)) {
+    return 0;
+  }
+  return invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+}
+
