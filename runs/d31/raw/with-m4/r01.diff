+import test from 'node:test';
+import assert from 'node:assert';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice: success with single line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.strictEqual(result.ok, true);
+  const invoice = result.value;
+  assert.strictEqual(invoice.customerId, 'C-001');
+  assert.strictEqual(invoice.issueDate, '2026-10-07');
+  assert.strictEqual(invoice.status, 'draft');
+  assert.strictEqual(invoice.lines.length, 1);
+  assert.deepStrictEqual(invoice.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 5,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice: success with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-31',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  });
+  assert.strictEqual(result.ok, true);
+  const invoice = result.value;
+  assert.strictEqual(invoice.lines.length, 3);
+  assert.strictEqual(invoice.lines[0].name, 'Development (hour)');
+  assert.strictEqual(invoice.lines[0].unitPrice, 9500);
+  assert.strictEqual(invoice.lines[0].vatRate, 21);
+  assert.strictEqual(invoice.lines[1].name, 'Icon set (24 icons)');
+  assert.strictEqual(invoice.lines[1].unitPrice, 980);
+  assert.strictEqual(invoice.lines[2].name, 'Printed flyer A4 (each)');
+  assert.strictEqual(invoice.lines[2].unitPrice, 37);
+  assert.strictEqual(invoice.lines[2].vatRate, 9);
+});
+
+test('createInvoice: error on unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice: error on missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: error on invalid date format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026/10/07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: error on non-date string', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: 'not-a-date',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: error on invalid day', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: error on empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'NO_LINES');
+});
+
+test('createInvoice: error on null lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'NO_LINES');
+});
+
+test('createInvoice: error on non-integer quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: error on zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: error on negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: error on string quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: '5' }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: error on unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice: error on unknown SKU in multi-line invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'UNKNOWN', qty: 1 },
+    ],
+  });
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice: does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  };
+  const inputCopy = JSON.stringify(input);
+  createInvoice(input);
+  assert.strictEqual(JSON.stringify(input), inputCopy);
+});
+
+test('createInvoice: VAT exempt product', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, true);
+  const invoice = result.value;
+  assert.strictEqual(invoice.lines[0].vatRate, 0);
+  assert.strictEqual(invoice.lines[0].unitPrice, 60000);
+});
+
+test('createInvoice: different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 1 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.strictEqual(result.ok, true);
+  const invoice = result.value;
+  assert.strictEqual(invoice.lines[0].vatRate, 21);
+  assert.strictEqual(invoice.lines[1].vatRate, 9);
+  assert.strictEqual(invoice.lines[2].vatRate, 0);
+});
