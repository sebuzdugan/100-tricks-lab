+/**
+ * Add or increase a line on an invoice.
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {{ sku: string, qty: number }} line
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!isPositiveInteger(qty)) return fail('QTY_INVALID');
+
+  // Validate and get product
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Check if SKU already exists
+  const existingLineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+
+  let newLines;
+  if (existingLineIndex >= 0) {
+    // Increase qty of existing line
+    newLines = invoice.lines.map((line, i) =>
+      i === existingLineIndex ? { ...line, qty: line.qty + qty } : line
+    );
+  } else {
+    // Add new line
+    newLines = [
+      ...invoice.lines,
+      {
+        sku,
+        name: product.name,
+        qty,
+        unitPrice: product.unitPrice,
+        vatRate: product.vatRate,
+      },
+    ];
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice.
+ * @param {{ status: string, lines: Array<{ sku: string }> }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if SKU exists
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex < 0) return fail('LINE_NOT_FOUND');
+
+  // Check if it's the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Remove the line
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
