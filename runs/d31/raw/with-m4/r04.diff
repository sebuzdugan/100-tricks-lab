diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..eab3138
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,92 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber: first invoice of the year', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.strictEqual(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: second invoice of the year', () => {
+  const result = nextInvoiceNumber(['INV-2026-0001'], '2026-10-07');
+  assert.strictEqual(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: multiple invoices, same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.strictEqual(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber: ignores invoices from other years', () => {
+  const existing = ['INV-2025-0099', 'INV-2025-0100', 'INV-2027-0001'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.strictEqual(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: handles unordered input', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.strictEqual(result, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber: handles year boundary', () => {
+  const existing = [
+    'INV-2025-9999',
+    'INV-2026-0001',
+    'INV-2026-0002',
+  ];
+  const result = nextInvoiceNumber(existing, '2026-12-31');
+  assert.strictEqual(result, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber: new year starts at 0001', () => {
+  const existing = ['INV-2025-0100'];
+  const result = nextInvoiceNumber(existing, '2026-01-01');
+  assert.strictEqual(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: counter resets per year', () => {
+  const existing = [
+    'INV-2024-0050',
+    'INV-2025-0100',
+    'INV-2026-0010',
+  ];
+  const result2026 = nextInvoiceNumber(existing, '2026-06-15');
+  const result2025 = nextInvoiceNumber(existing, '2025-06-15');
+  const result2024 = nextInvoiceNumber(existing, '2024-06-15');
+  assert.strictEqual(result2026, 'INV-2026-0011');
+  assert.strictEqual(result2025, 'INV-2025-0101');
+  assert.strictEqual(result2024, 'INV-2024-0051');
+});
+
+test('nextInvoiceNumber: pads counter with zeros', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2026-000${i + 1}`);
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.strictEqual(result, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber: handles four-digit counter', () => {
+  const existing = Array.from({ length: 999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.strictEqual(result, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber: ignores malformed numbers', () => {
+  const existing = [
+    'INV-2026-0001',
+    'INVALID',
+    'INV-2026',
+    'INV-2026-00001',
+    'INV-2026-ABC1',
+  ];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.strictEqual(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: does not mutate input', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const copy = JSON.stringify(existing);
+  nextInvoiceNumber(existing, '2026-10-07');
+  assert.strictEqual(JSON.stringify(existing), copy);
+});
