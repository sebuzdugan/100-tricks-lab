new file mode 100644
index 0000000..7a07a38
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,24 @@
+/**
+ * Generate the next invoice number.
+ * Format: INV-<year>-<4-digit-counter>, counter resets per year.
+ * @param {string[]} existingNumbers - Already-used invoice numbers (in any order)
+ * @param {string} issueDate - Invoice date in YYYY-MM-DD format
+ * @returns {string} - The next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+
+  // Find the max counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const m = /^INV-(\d{4})-(\d{4})$/.exec(num);
+    if (m && m[1] === year) {
+      const counter = parseInt(m[2], 10);
+      maxCounter = Math.max(maxCounter, counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `INV-${year}-${paddedCounter}`;
+}
