+import { formatEuros } from './money.js';
+import { invoiceTotals, lineTotal } from './invoices.js';
+import { getCustomer } from './customers.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // First line: number or DRAFT
+  const numberLine = invoice.number ?? 'DRAFT';
+
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  // Build line items
+  const lineItems = invoice.lines.map((line) => {
+    const total = lineTotal(line);
+    const unitPriceFormatted = formatEuros(line.unitPrice);
+    const totalFormatted = formatEuros(total);
+    return `${line.qty}x ${line.name} @ ${unitPriceFormatted} = ${totalFormatted}`;
+  });
+
+  // Calculate total
+  const totals = invoiceTotals(invoice);
+  const totalFormatted = formatEuros(totals.total);
+
+  // Combine all parts
+  const lines = [numberLine, customerName, ...lineItems, `Total: ${totalFormatted}`];
+  return lines.join('\n');
+}
