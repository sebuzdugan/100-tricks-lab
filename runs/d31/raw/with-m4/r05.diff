+import test from 'node:test';
+import assert from 'node:assert';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText: draft invoice with single line', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.strictEqual(lines[0], 'DRAFT');
+  assert.strictEqual(lines[1], 'Northwind Studio');
+  assert.strictEqual(lines[2], '5x Design work (hour) @ €85.00 = €425.00');
+  assert.strictEqual(lines[3], 'Total: €425.00');
+});
+
+test('renderInvoiceText: issued invoice shows number', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const issuedResult = issueInvoice(invoice, []);
+  assert.strictEqual(issuedResult.ok, true);
+  const issuedInvoice = issuedResult.value;
+
+  const text = renderInvoiceText(issuedInvoice);
+  const lines = text.split('\n');
+  assert.strictEqual(lines[0], 'INV-2026-0001');
+  assert.strictEqual(lines[1], 'Blue Fern Bakery');
+  assert.strictEqual(lines[2], '3x Development (hour) @ €95.00 = €285.00');
+  assert.strictEqual(lines[3], 'Total: €285.00');
+});
+
+test('renderInvoiceText: multiple line items', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.strictEqual(lines[0], 'DRAFT');
+  assert.strictEqual(lines[1], 'Kite & Co');
+  assert.strictEqual(lines[2], '5x Design work (hour) @ €85.00 = €425.00');
+  assert.strictEqual(lines[3], '2x Icon set (24 icons) @ €9.80 = €19.60');
+  assert.strictEqual(lines[4], '100x Printed flyer A4 (each) @ €0.37 = €37.00');
+  assert.strictEqual(lines[5], 'Total: €481.60');
+});
+
+test('renderInvoiceText: large quantities with comma formatting', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 10 },
+    ],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.strictEqual(lines[2], '10x Logo package @ €1,200.00 = €12,000.00');
+  assert.strictEqual(lines[3], 'Total: €12,000.00');
+});
+
+test('renderInvoiceText: VAT exempt products', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.strictEqual(lines[2], '1x Brand workshop (day, VAT exempt) @ €600.00 = €600.00');
+  assert.strictEqual(lines[3], 'Total: €600.00');
+});
+
+test('renderInvoiceText: small amounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 5 },
+    ],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.strictEqual(lines[2], '5x Sticker sheet @ €0.50 = €2.50');
+  assert.strictEqual(lines[3], 'Total: €2.50');
+});
+
+test('renderInvoiceText: mixed prices and quantities', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 1 },
+      { sku: 'FONT-LIC', qty: 2 },
+      { sku: 'HOST-MONTH', qty: 12 },
+    ],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.strictEqual(lines[0], 'DRAFT');
+  assert.strictEqual(lines[1], 'Orchard Health');
+  assert.strictEqual(lines[2], '1x Brand guidelines document @ €2,450.00 = €2,450.00');
+  assert.strictEqual(lines[3], '2x Font licence (desktop) @ €10.10 = €20.20');
+  assert.strictEqual(lines[4], '12x Website hosting (month) @ €15.00 = €180.00');
+  assert.strictEqual(lines[5], 'Total: €2,650.20');
+});
+
+test('renderInvoiceText: does not mutate invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+  const copy = JSON.stringify(invoice);
+
+  renderInvoiceText(invoice);
+  assert.strictEqual(JSON.stringify(invoice), copy);
+});
+
+test('renderInvoiceText: different customers', () => {
+  const customers = ['C-001', 'C-006', 'C-011'];
+  const expectedNames = ['Northwind Studio', 'Marlow "The Print Shop"', 'Copperleaf Cafe'];
+
+  for (let i = 0; i < customers.length; i++) {
+    const invoiceResult = createInvoice({
+      customerId: customers[i],
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.strictEqual(invoiceResult.ok, true);
+    const invoice = invoiceResult.value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+    assert.strictEqual(lines[1], expectedNames[i]);
+  }
+});
+
+test('renderInvoiceText: issued invoice with number', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const issuedResult = issueInvoice(invoice, ['INV-2025-0001', 'INV-2025-0002']);
+  assert.strictEqual(issuedResult.ok, true);
+  const issuedInvoice = issuedResult.value;
+
+  const text = renderInvoiceText(issuedInvoice);
+  const lines = text.split('\n');
+  assert.strictEqual(lines[0], 'INV-2025-0003');
+});
+
+test('renderInvoiceText: line format consistency', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 2 },
+    ],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Each line should follow format: "Nqty x Name @ €price = €total"
+  const linePattern = /^\d+x .+ @ €[\d,]+\.\d{2} = €[\d,]+\.\d{2}$/;
+  assert.match(lines[2], linePattern);
+  assert.match(lines[3], linePattern);
+});
+
+test('renderInvoiceText: total line format', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.strictEqual(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Total line should start with "Total: "
+  const totalLine = lines[lines.length - 1];
+  assert.match(totalLine, /^Total: €[\d,]+\.\d{2}$/);
+});
