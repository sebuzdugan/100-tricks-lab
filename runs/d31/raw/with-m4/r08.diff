@@ -57,8 +57,15 @@ export function invoiceTotals(invoice) {
     const lineDiscount = roundCents(lineTotal(line) * discountPercent / 100);
     return sum + lineDiscount;
   }, 0);
-  const total = Math.max(0, subtotal - discount);
-  return { subtotal, discount, total };
+  const vat = invoice.lines.reduce((sum, line) => {
+    const discountPercent = line.discountPercent ?? 0;
+    const lineTotal_ = lineTotal(line);
+    const discountedAmount = lineTotal_ - roundCents(lineTotal_ * discountPercent / 100);
+    const lineVat = roundCents(discountedAmount * line.vatRate / 100);
+    return sum + lineVat;
+  }, 0);
+  const total = Math.max(0, subtotal - discount + vat);
+  return { subtotal, discount, vat, total };
 }
 
