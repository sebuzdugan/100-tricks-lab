+
+test('createInvoice: normalizes lowercase customer id', () => {
+  const result = createInvoice({
+    customerId: 'c-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.strictEqual(result.ok, true);
+  const invoice = result.value;
+  assert.strictEqual(invoice.customerId, 'C-002');
+});
+
+test('createInvoice: normalizes customer id with whitespace', () => {
+  const result = createInvoice({
+    customerId: '  c-002  ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.strictEqual(result.ok, true);
+  const invoice = result.value;
+  assert.strictEqual(invoice.customerId, 'C-002');
+});
+
+test('createInvoice: normalizes customer id with mixed case and spaces', () => {
+  const result = createInvoice({
+    customerId: ' c-003 ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.strictEqual(result.ok, true);
+  const invoice = result.value;
+  assert.strictEqual(invoice.customerId, 'C-003');
+});
+
+test('createInvoice: stores normalized customer id', () => {
+  const result = createInvoice({
+    customerId: 'c-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
