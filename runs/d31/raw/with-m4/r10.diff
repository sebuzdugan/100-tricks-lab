diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..860d235
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,151 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate: accepts valid date', () => {
+  assert.strictEqual(isValidDate('2026-10-07'), true);
+});
+
+test('isValidDate: accepts leap year date', () => {
+  assert.strictEqual(isValidDate('2024-02-29'), true);
+});
+
+test('isValidDate: rejects non-leap year feb 29', () => {
+  assert.strictEqual(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate: rejects invalid month', () => {
+  assert.strictEqual(isValidDate('2026-13-01'), false);
+});
+
+test('isValidDate: rejects invalid day', () => {
+  assert.strictEqual(isValidDate('2026-02-30'), false);
+});
+
+test('isValidDate: rejects missing leading zeros', () => {
+  assert.strictEqual(isValidDate('2026-1-7'), false);
+});
+
+test('isValidDate: rejects wrong format', () => {
+  assert.strictEqual(isValidDate('07/10/2026'), false);
+});
+
+test('isValidDate: rejects empty string', () => {
+  assert.strictEqual(isValidDate(''), false);
+});
+
+test('isValidDate: rejects non-string', () => {
+  assert.strictEqual(isValidDate(20261007), false);
+  assert.strictEqual(isValidDate(null), false);
+});
+
+test('isValidDate: rejects day 0', () => {
+  assert.strictEqual(isValidDate('2026-10-00'), false);
+});
+
+test('isValidDate: rejects month 0', () => {
+  assert.strictEqual(isValidDate('2026-00-15'), false);
+});
+
+test('addDays: adds positive days', () => {
+  assert.strictEqual(addDays('2026-10-07', 1), '2026-10-08');
+  assert.strictEqual(addDays('2026-10-07', 10), '2026-10-17');
+});
+
+test('addDays: subtracts negative days', () => {
+  assert.strictEqual(addDays('2026-10-07', -1), '2026-10-06');
+  assert.strictEqual(addDays('2026-10-07', -10), '2026-09-27');
+});
+
+test('addDays: wraps month boundaries forward', () => {
+  assert.strictEqual(addDays('2026-10-31', 1), '2026-11-01');
+});
+
+test('addDays: wraps month boundaries backward', () => {
+  assert.strictEqual(addDays('2026-10-01', -1), '2026-09-30');
+});
+
+test('addDays: wraps year boundaries forward', () => {
+  assert.strictEqual(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays: wraps year boundaries backward', () => {
+  assert.strictEqual(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays: adds zero days', () => {
+  assert.strictEqual(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays: handles leap year', () => {
+  assert.strictEqual(addDays('2024-02-28', 1), '2024-02-29');
+  assert.strictEqual(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays: handles large positive day offset', () => {
+  assert.strictEqual(addDays('2026-01-01', 365), '2027-01-01');
+});
+
+test('addDays: handles large negative day offset', () => {
+  assert.strictEqual(addDays('2027-01-01', -365), '2026-01-01');
+});
+
+test('daysBetween: same day', () => {
+  assert.strictEqual(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween: next day', () => {
+  assert.strictEqual(daysBetween('2026-10-07', '2026-10-08'), 1);
+});
+
+test('daysBetween: previous day', () => {
+  assert.strictEqual(daysBetween('2026-10-08', '2026-10-07'), -1);
+});
+
+test('daysBetween: multiple days forward', () => {
+  assert.strictEqual(daysBetween('2026-10-07', '2026-10-17'), 10);
+});
+
+test('daysBetween: multiple days backward', () => {
+  assert.strictEqual(daysBetween('2026-10-17', '2026-10-07'), -10);
+});
+
+test('daysBetween: across months', () => {
+  assert.strictEqual(daysBetween('2026-10-30', '2026-11-02'), 3);
+});
+
+test('daysBetween: across years', () => {
+  assert.strictEqual(daysBetween('2026-12-31', '2027-01-01'), 1);
+});
+
+test('daysBetween: across years backward', () => {
+  assert.strictEqual(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween: large date range', () => {
+  assert.strictEqual(daysBetween('2026-01-01', '2027-01-01'), 365);
+});
+
+test('daysBetween: leap year range', () => {
+  assert.strictEqual(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('addDays then daysBetween round trip', () => {
+  const start = '2026-10-07';
+  const end = addDays(start, 42);
+  const days = daysBetween(start, end);
+  assert.strictEqual(days, 42);
+});
+
+test('daysBetween then addDays round trip', () => {
+  const a = '2026-01-15';
+  const b = '2026-03-20';
+  const days = daysBetween(a, b);
+  const roundTrip = addDays(a, days);
+  assert.strictEqual(roundTrip, b);
+});
+
+test('isValidDate works with dates from addDays', () => {
+  const date = addDays('2026-10-07', 10);
+  assert.strictEqual(isValidDate(date), true);
+});
