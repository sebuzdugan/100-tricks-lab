+/**
+ * Check if a date string is in YYYY-MM-DD format and represents a valid date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!m) return false;
+  const [, year, month, day] = m;
+  const date = new Date(`${year}-${month}-${day}T00:00:00Z`);
+  return !isNaN(date.getTime()) && date.toISOString().startsWith(`${year}-${month}-${day}`);
+}
+
+/**
+ * Add days to a date string. Result is in UTC.
+ * @param {string} date - YYYY-MM-DD format
+ * @param {number} n - days to add (can be negative)
+ * @returns {string} - YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate days between two dates (b minus a), in whole days.
+ * @param {string} a - YYYY-MM-DD format
+ * @param {string} b - YYYY-MM-DD format
+ * @returns {number} - whole days between a and b
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(`${a}T00:00:00Z`);
+  const dateB = new Date(`${b}T00:00:00Z`);
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
