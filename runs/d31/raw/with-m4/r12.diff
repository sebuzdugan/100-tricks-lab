+  assert.equal(result.ok, true);
+  assert.equal(result.value.dueDate, '2027-01-08');
+});
+
+test('createInvoice: NET30 wraps year boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-15',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.dueDate, '2027-01-14');
+});
+
+test('createInvoice: rejects invalid terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'NET45',
+  });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'TERMS_INVALID');
+});
+
+test('createInvoice: rejects invalid terms (lowercase)', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'net30',
+  });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'TERMS_INVALID');
+});
+
+test('createInvoice: preserves other invoice properties with terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 2 }],
+    terms: 'NET14',
