+  const inputCopy = JSON.stringify(input);
+  createInvoice(input);
+  assert.equal(JSON.stringify(input), inputCopy);
+});
+
+test('createInvoice: dueDate is a valid date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(result.ok, true);
+  assert.match(result.value.dueDate, /^\d{4}-\d{2}-\d{2}$/);
+});
+
+test('createInvoice: terms validation happens after date validation', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-13-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'NET45',
+  });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
