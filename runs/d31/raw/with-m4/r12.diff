 }
+
+/**
+ * Get the last day of the month for a given date. Result is in UTC.
+ * @param {string} dateStr - YYYY-MM-DD format
+ * @returns {string} - last day of that month in YYYY-MM-DD format
+ */
+export function lastDayOfMonth(dateStr) {
+  const d = new Date(`${dateStr}T00:00:00Z`);
+  const year = d.getUTCFullYear();
+  const month = d.getUTCMonth();
+  const nextMonth = month === 11 ? 0 : month + 1;
+  const nextYear = month === 11 ? year + 1 : year;
+  const firstOfNext = new Date(Date.UTC(nextYear, nextMonth, 1));
+  firstOfNext.setUTCDate(firstOfNext.getUTCDate() - 1);
+  return firstOfNext.toISOString().split('T')[0];
+}
