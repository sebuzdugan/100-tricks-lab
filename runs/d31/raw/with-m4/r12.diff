+  assert.equal(result.value.lines.length, 1);
+});
+
+test('createInvoice: does not mutate input with terms', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'NET30',
