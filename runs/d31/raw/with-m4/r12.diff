+  assert.equal(result.ok, true);
+  assert.equal(result.value.dueDate, '2026-11-08');
+});
+
+test('createInvoice: NET14 wraps year boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-25',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
