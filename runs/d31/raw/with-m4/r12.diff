+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+import { daysBetween, lastDayOfMonth } from '../src/dates.js';
+
+test('createInvoice: defaults to NET30', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(daysBetween(result.value.issueDate, result.value.dueDate), 30);
+});
+
+test('createInvoice: accepts NET14', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'NET14',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET14');
+  assert.equal(daysBetween(result.value.issueDate, result.value.dueDate), 14);
+});
+
+test('createInvoice: accepts NET30 explicitly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(daysBetween(result.value.issueDate, result.value.dueDate), 30);
+});
+
+test('createInvoice: accepts EOM', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'EOM');
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('createInvoice: EOM on first day of month', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('createInvoice: EOM on last day of month', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-31',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('createInvoice: EOM for February non-leap year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-02-15',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.dueDate, '2027-02-28');
+});
+
+test('createInvoice: EOM for February leap year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.dueDate, '2024-02-29');
+});
+
+test('createInvoice: EOM for December', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-15',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.dueDate, '2026-12-31');
+});
+
+test('createInvoice: EOM for January (31-day month)', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.dueDate, '2026-01-31');
