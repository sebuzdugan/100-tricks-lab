diff --git a/test/vouchers.test.js b/test/vouchers.test.js
new file mode 100644
index 0000000..454a08d
--- /dev/null
+++ b/test/vouchers.test.js
@@ -0,0 +1,207 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+
+// Helper to create a draft invoice
+function createTestInvoice() {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 2 },
+    ],
+  });
+  return created.value;
+}
+
+test('applyVoucher: applies voucher to draft invoice', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: 1000 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher.code, 'PROMO10');
+  assert.equal(result.value.voucher.amount, 1000);
+});
+
+test('applyVoucher: does not mutate original invoice', () => {
+  const invoice = createTestInvoice();
+  const invoiceCopy = JSON.stringify(invoice);
+  applyVoucher(invoice, { code: 'PROMO10', amount: 1000 });
+  assert.equal(JSON.stringify(invoice), invoiceCopy);
+});
+
+test('applyVoucher: cannot apply voucher to non-draft invoice', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const invoice = created.value;
+  invoice.status = 'issued';
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: 1000 });
+  assert.deepEqual(result, { ok: false, error: 'NOT_DRAFT' });
+});
+
+test('applyVoucher: rejects negative amount', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: -100 });
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('applyVoucher: rejects zero amount', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: 0 });
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('applyVoucher: rejects non-integer amount', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: 100.5 });
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('applyVoucher: prevents multiple vouchers', () => {
+  const invoice = createTestInvoice();
+  const result1 = applyVoucher(invoice, { code: 'PROMO10', amount: 1000 });
+  assert.equal(result1.ok, true);
+  const result2 = applyVoucher(result1.value, { code: 'PROMO20', amount: 500 });
+  assert.deepEqual(result2, { ok: false, error: 'VOUCHER_EXISTS' });
+});
+
+test('applyVoucher: preserves other invoice properties', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: 1000 });
+  assert.equal(result.value.customerId, invoice.customerId);
+  assert.equal(result.value.issueDate, invoice.issueDate);
+  assert.equal(result.value.status, invoice.status);
+  assert.deepEqual(result.value.lines, invoice.lines);
+  assert.equal(result.value.terms, invoice.terms);
+  assert.equal(result.value.dueDate, invoice.dueDate);
+});
+
+test('invoiceTotals: returns 0 voucher when none applied', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals: returns voucher amount when applied', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: 500 });
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.voucher, 500);
+});
+
+test('invoiceTotals: reduces total by voucher amount', () => {
+  const invoice = createTestInvoice();
+  const totalsWithout = invoiceTotals(invoice);
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: 500 });
+  const totalsWith = invoiceTotals(result.value);
+  assert.equal(totalsWith.total, totalsWithout.total - 500);
+});
+
+test('invoiceTotals: clamps total at zero when voucher exceeds total', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'BIG_DISCOUNT', amount: 10000 });
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals: voucher does not affect subtotal, discount, or vat', () => {
+  const invoice = createTestInvoice();
+  const totalsWithout = invoiceTotals(invoice);
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: 500 });
+  const totalsWith = invoiceTotals(result.value);
+  assert.equal(totalsWith.subtotal, totalsWithout.subtotal);
+  assert.equal(totalsWith.discount, totalsWithout.discount);
+  assert.equal(totalsWith.vat, totalsWithout.vat);
+});
+
+test('invoiceTotals: calculates total = subtotal - discount + vat - voucher', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'PROMO10', amount: 200 });
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat - totals.voucher);
+});
+
+test('applyVoucher: works with large voucher amounts', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'MEGA_SALE', amount: 1000000 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher.amount, 1000000);
+});
+
+test('applyVoucher: exact voucher code preservation', () => {
+  const invoice = createTestInvoice();
+  const codes = ['SUMMER2026', 'HOLIDAY50', '2026-THANK-YOU', 'CODE123ABC'];
+  for (const code of codes) {
+    const result = applyVoucher(invoice, { code, amount: 100 });
+    assert.equal(result.value.voucher.code, code);
+  }
+});
+
+test('applyVoucher: voucher with invoice discounts', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 2, discountPercent: 10 },
+    ],
+  });
+  const invoice = created.value;
+  const totalsWithout = invoiceTotals(invoice);
+  const result = applyVoucher(invoice, { code: 'EXTRA', amount: 500 });
+  const totalsWith = invoiceTotals(result.value);
+  assert.equal(totalsWith.total, totalsWithout.total - 500);
+});
+
+test('applyVoucher: voucher with multiple line items', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 2 },
+      { sku: 'FONT-LIC', qty: 1 },
+    ],
+  });
+  const invoice = created.value;
+  const result = applyVoucher(invoice, { code: 'MULTI', amount: 1000 });
+  assert.equal(result.ok, true);
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals: returns complete structure with voucher', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'PROMO', amount: 100 });
+  const totals = invoiceTotals(result.value);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
+
+test('applyVoucher: can apply voucher with empty code string', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: '', amount: 100 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher.code, '');
+});
+
+test('invoiceTotals: voucher applies after all other calculations', () => {
+  const created = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 1, discountPercent: 50 },
+    ],
+  });
+  const invoice = created.value;
+  const totalsWithout = invoiceTotals(invoice);
+  const result = applyVoucher(invoice, { code: 'FINAL', amount: 100 });
+  const totalsWith = invoiceTotals(result.value);
+
+  // Verify calculation order: subtotal - discount + vat - voucher
+  const expected = totalsWithout.subtotal - totalsWithout.discount + totalsWithout.vat - 100;
+  assert.equal(totalsWith.total, expected);
+});
