+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue an invoice
+function createIssuedInvoice(customerId, issueDate, terms = 'NET30') {
+  const created = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms,
+  });
+  const issued = issueInvoice(created.value, []);
+  return issued.value;
+}
+
+test('statement: unknown customer returns error', () => {
+  const result = statement('C-999', [], '2026-10-07');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement: known customer with no invoices', () => {
+  const result = statement('C-001', [], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement: single issued invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = statement('C-001', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice.number);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement: multiple invoices sorted by issueDate', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-10-05');
+  const inv2 = createIssuedInvoice('C-001', '2026-10-01');
+  const inv3 = createIssuedInvoice('C-001', '2026-10-03');
+  const result = statement('C-001', [inv1, inv2, inv3], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-03');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-05');
+});
+
+test('statement: excludes draft invoices', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const draft = created.value;
+  const issued = createIssuedInvoice('C-001', '2026-10-02');
+  const result = statement('C-001', [draft, issued], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-02');
+});
+
+test('statement: excludes invoices after asOf date', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-10-01');
+  const inv2 = createIssuedInvoice('C-001', '2026-10-15');
+  const result = statement('C-001', [inv1, inv2], '2026-10-10');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement: includes invoices on asOf date', () => {
+  const inv = createIssuedInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [inv], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement: includes invoices before asOf date', () => {
+  const inv = createIssuedInvoice('C-001', '2026-10-01');
+  const result = statement('C-001', [inv], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement: only includes invoices for specified customer', () => {
+  const invC001 = createIssuedInvoice('C-001', '2026-10-01');
+  const invC002 = createIssuedInvoice('C-002', '2026-10-02');
+  const invC003 = createIssuedInvoice('C-003', '2026-10-03');
+  const result = statement('C-001', [invC001, invC002, invC003], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement: includes partially_paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const partialResult = recordPayment(invoice, { amount: 500, date: '2026-10-02' });
+  const result = statement('C-001', [partialResult.value], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, 645);
+});
+
+test('statement: excludes paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const paidResult = recordPayment(invoice, { amount: 1145, date: '2026-10-02' });
+  const result = statement('C-001', [paidResult.value], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement: calculates due for unpaid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = statement('C-001', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  const inv = result.value.invoices[0];
+  assert.equal(inv.total, 1145);
+  assert.equal(inv.due, 1145);
+});
+
+test('statement: calculates due for partially paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const partialResult = recordPayment(invoice, { amount: 300, date: '2026-10-02' });
+  const result = statement('C-001', [partialResult.value], '2026-10-07');
+  assert.equal(result.ok, true);
+  const inv = result.value.invoices[0];
+  assert.equal(inv.total, 1145);
+  assert.equal(inv.due, 845);
+});
+
+test('statement: totalDue is sum of all invoice dues', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-10-01');
+  const inv2 = createIssuedInvoice('C-001', '2026-10-02');
+  const inv3 = createIssuedInvoice('C-001', '2026-10-03');
+  const result = statement('C-001', [inv1, inv2, inv3], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.totalDue, 1145 + 1145 + 1145);
+});
+
+test('statement: totalDue with mix of paid and partial invoices', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-10-01');
+  const inv2 = createIssuedInvoice('C-001', '2026-10-02');
+  const inv3 = createIssuedInvoice('C-001', '2026-10-03');
+  const partial2 = recordPayment(inv2, { amount: 500, date: '2026-10-04' });
+  const result = statement('C-001', [inv1, partial2.value, inv3], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.totalDue, 1145 + 645 + 1145);
+});
+
+test('statement: includes dueDate in each invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01', 'NET14');
+  const result = statement('C-001', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  const inv = result.value.invoices[0];
+  assert.equal(inv.dueDate, '2026-10-15');
+});
+
+test('statement: normalizes customer ID (lowercase)', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = statement('c-001', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement: normalizes customer ID (whitespace)', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = statement('  c-001  ', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement: empty invoice list when all invoices after asOf', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-10-15');
+  const inv2 = createIssuedInvoice('C-001', '2026-10-20');
+  const result = statement('C-001', [inv1, inv2], '2026-10-10');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement: includes all customer invoices on same date', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-10-01');
+  const inv2 = createIssuedInvoice('C-001', '2026-10-01');
+  const inv3 = createIssuedInvoice('C-001', '2026-10-01');
+  const result = statement('C-001', [inv1, inv2, inv3], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+});
+
+test('statement: does not include other customers draft invoices', () => {
+  const created = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const draft = created.value;
+  const issued = createIssuedInvoice('C-001', '2026-10-02');
+  const result = statement('C-001', [draft, issued], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement: invoice structure has all required fields', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01', 'NET30');
+  const result = statement('C-001', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  const inv = result.value.invoices[0];
+  assert.ok('number' in inv);
+  assert.ok('issueDate' in inv);
+  assert.ok('dueDate' in inv);
+  assert.ok('total' in inv);
+  assert.ok('due' in inv);
+});
+
+test('statement: totalDue matches sum of individual dues', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-10-01');
+  const inv2 = createIssuedInvoice('C-001', '2026-10-02');
+  const partial1 = recordPayment(inv1, { amount: 200, date: '2026-10-03' });
+  const result = statement('C-001', [partial1.value, inv2], '2026-10-07');
+  assert.equal(result.ok, true);
+  const sumDues = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(result.value.totalDue, sumDues);
+});
