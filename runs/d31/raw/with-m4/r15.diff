+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Check if a value is a positive integer.
+ * @param {unknown} value
+ * @returns {boolean}
+ */
+function isPositiveInteger(value) {
+  return Number.isInteger(value) && value > 0;
+}
+
+/**
+ * Generate the next credit note number.
+ * @param {string[]} existingNumbers - Array of all existing invoice and credit note numbers
+ * @param {string} issueDate - YYYY-MM-DD format
+ * @returns {string} - credit note number in format CN-<YYYY>-<NNNN>
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const [year] = issueDate.split('-');
+
+  // Find all credit note numbers for this year
+  const cnPattern = /^CN-(\d{4})-(\d{4})$/;
+  let maxCounter = 0;
+
+  for (const num of existingNumbers) {
+    const match = cnPattern.exec(num);
+    if (match) {
+      const numYear = match[1];
+      const counter = parseInt(match[2], 10);
+      if (numYear === year && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = String(maxCounter + 1).padStart(4, '0');
+  return `CN-${year}-${nextCounter}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNoteData
+ * @param {string[]} existingNumbers - Existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check if invoice is issued (not draft)
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!isPositiveInteger(amount)) return fail('AMOUNT_INVALID');
+
+  // Check if credit amount exceeds invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) return fail('CREDIT_TOO_HIGH');
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
