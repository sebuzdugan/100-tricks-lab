+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Generate a report of overdue invoices.
+ * @param {Array<any>} invoices - All invoices
+ * @param {string} asOf - YYYY-MM-DD format, cutoff date
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) =>
+      (inv.status === 'issued' || inv.status === 'partially_paid') &&
+      inv.dueDate < asOf
+    )
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
diff --git a/test/reports.test.js b/test/reports.test.js
new file mode 100644
index 0000000..3b9dae4
--- /dev/null
+++ b/test/reports.test.js
@@ -0,0 +1,217 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue an invoice with specified terms and date
+function createIssuedInvoice(customerId, issueDate, terms = 'NET30') {
+  const created = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms,
+  });
+  const issued = issueInvoice(created.value, []);
+  return issued.value;
+}
+
+test('overdueInvoices: empty invoices array', () => {
+  const result = overdueInvoices([], '2026-10-07');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: no overdue invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01', 'NET30');
+  // Due date is 2026-10-31, so not overdue yet
+  const result = overdueInvoices([invoice], '2026-10-07');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: single overdue invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  // Due date is 2026-10-01, overdue on 2026-10-07
+  const result = overdueInvoices([invoice], '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoice.number);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-10-01');
+  assert.equal(result[0].daysOverdue, 6);
+});
+
+test('overdueInvoices: excludes invoices on dueDate', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  // Due date is 2026-10-01, check on 2026-10-01 (not overdue)
+  const result = overdueInvoices([invoice], '2026-10-01');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: includes invoices one day after dueDate', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  // Due date is 2026-10-01, check on 2026-10-02 (overdue)
+  const result = overdueInvoices([invoice], '2026-10-02');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices: sorts by daysOverdue descending', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-09-20', 'NET30');
+  const inv2 = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const inv3 = createIssuedInvoice('C-001', '2026-09-10', 'NET30');
+  // Due dates: 2026-10-20, 2026-10-01, 2026-10-10
+  // On 2026-10-07: inv2 is 6 days overdue, inv3 is not yet due, inv1 is not yet due
+  const result = overdueInvoices([inv1, inv2, inv3], '2026-10-25');
+  assert.equal(result.length, 3);
+  assert.equal(result[0].daysOverdue, 24);
+  assert.equal(result[1].daysOverdue, 15);
+  assert.equal(result[2].daysOverdue, 5);
+});
+
+test('overdueInvoices: excludes draft invoices', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const result = overdueInvoices([created.value], '2026-10-07');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: excludes paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const paidInvoice = recordPayment(invoice, { amount: 1145, date: '2026-10-02' }).value;
+  const result = overdueInvoices([paidInvoice], '2026-10-07');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: includes partially_paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const partialInvoice = recordPayment(invoice, { amount: 500, date: '2026-10-02' }).value;
+  const result = overdueInvoices([partialInvoice], '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 645);
+});
+
+test('overdueInvoices: calculates daysOverdue correctly', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-08-01', 'NET30');
+  const result = overdueInvoices([invoice], '2026-10-07');
+  // Verify daysOverdue is positive and matches the difference
+  assert.ok(result[0].daysOverdue > 0);
+  assert.equal(result[0].daysOverdue, (new Date('2026-10-07T00:00:00Z').getTime() - new Date(invoice.dueDate + 'T00:00:00Z').getTime()) / (1000 * 60 * 60 * 24));
+});
+
+test('overdueInvoices: calculates due for unpaid invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const result = overdueInvoices([invoice], '2026-10-07');
+  assert.equal(result[0].due, 1145);
+});
+
+test('overdueInvoices: calculates due for partially paid invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const partialInvoice = recordPayment(invoice, { amount: 300, date: '2026-10-02' }).value;
+  const result = overdueInvoices([partialInvoice], '2026-10-07');
+  assert.equal(result[0].due, 845);
+});
+
+test('overdueInvoices: multiple overdue invoices for different customers', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const inv2 = createIssuedInvoice('C-002', '2026-09-05', 'NET30');
+  const result = overdueInvoices([inv1, inv2], '2026-10-07');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[1].customerId, 'C-002');
+});
+
+test('overdueInvoices: handles NET14 terms correctly', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-20', 'NET14');
+  // Due date is 2026-10-04
+  const result = overdueInvoices([invoice], '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2026-10-04');
+  assert.equal(result[0].daysOverdue, 3);
+});
+
+test('overdueInvoices: handles EOM (end of month) terms correctly', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-05', 'EOM');
+  // Due date is 2026-10-31
+  const result = overdueInvoices([invoice], '2026-11-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2026-10-31');
+  assert.equal(result[0].daysOverdue, 15);
+});
+
+test('overdueInvoices: invoice structure has all required fields', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const result = overdueInvoices([invoice], '2026-10-07');
+  assert.equal(result.length, 1);
+  const overdue = result[0];
+  assert.ok('number' in overdue);
+  assert.ok('customerId' in overdue);
+  assert.ok('dueDate' in overdue);
+  assert.ok('daysOverdue' in overdue);
+  assert.ok('due' in overdue);
+});
+
+test('overdueInvoices: daysOverdue is integer', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const result = overdueInvoices([invoice], '2026-10-07');
+  assert.equal(Number.isInteger(result[0].daysOverdue), true);
+});
+
+test('overdueInvoices: due is integer', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const result = overdueInvoices([invoice], '2026-10-07');
+  assert.equal(Number.isInteger(result[0].due), true);
+});
+
+test('overdueInvoices: does not mutate input array', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const invoices = [invoice];
+  const original = JSON.stringify(invoices);
+  overdueInvoices(invoices, '2026-10-07');
+  assert.equal(JSON.stringify(invoices), original);
+});
+
+test('overdueInvoices: large list of invoices', () => {
+  const invoices = [];
+  for (let i = 0; i < 30; i++) {
+    const month = String(Math.floor(i / 10) + 1).padStart(2, '0');
+    const day = String((i % 10) + 1).padStart(2, '0');
+    const inv = createIssuedInvoice('C-001', `2026-${month}-${day}`, 'NET30');
+    invoices.push(inv);
+  }
+  const result = overdueInvoices(invoices, '2026-12-01');
+  assert.ok(result.length > 0);
+  // Verify still sorted by daysOverdue descending
+  for (let i = 1; i < result.length; i++) {
+    assert.ok(result[i - 1].daysOverdue >= result[i].daysOverdue);
+  }
+});
+
+test('overdueInvoices: multiple partial payments on same invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const partial1 = recordPayment(invoice, { amount: 300, date: '2026-10-02' }).value;
+  const partial2 = recordPayment(partial1, { amount: 200, date: '2026-10-03' }).value;
+  const result = overdueInvoices([partial2], '2026-10-07');
+  assert.equal(result[0].due, 645);
+});
+
+test('overdueInvoices: preserves invoice number from original invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const result = overdueInvoices([invoice], '2026-10-07');
+  assert.equal(result[0].number, invoice.number);
+});
+
+test('overdueInvoices: preserves customer ID from original invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const result = overdueInvoices([invoice], '2026-10-07');
+  assert.equal(result[0].customerId, 'C-001');
+});
+
+test('overdueInvoices: handles mix of overdue and not-yet-due invoices', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-09-01', 'NET30');
+  const inv2 = createIssuedInvoice('C-001', '2026-10-05', 'NET30');
+  const result = overdueInvoices([inv1, inv2], '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, inv1.number);
+});
