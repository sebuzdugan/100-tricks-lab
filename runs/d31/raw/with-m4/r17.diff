+/**
+ * Generate a VAT summary report.
+ * @param {Array<any>} invoices - All invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const rateBuckets = {};
+
+  // Iterate through all invoices with status issued, partially_paid, or paid
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    // Process each line in the invoice
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const lineAmount = line.qty * line.unitPrice;
+      const discountPercent = line.discountPercent ?? 0;
+      const discountAmount = roundCents(lineAmount * discountPercent / 100);
+      const base = lineAmount - discountAmount;
+      const vat = roundCents(base * rate / 100);
+
+      // Add to bucket for this rate
+      if (!rateBuckets[rate]) {
+        rateBuckets[rate] = { rate, base: 0, vat: 0 };
+      }
+      rateBuckets[rate].base += base;
+      rateBuckets[rate].vat += vat;
+    }
+  }
+
+  // Convert buckets to array and sort by rate descending
+  return Object.values(rateBuckets).sort((a, b) => b.rate - a.rate);
+}
