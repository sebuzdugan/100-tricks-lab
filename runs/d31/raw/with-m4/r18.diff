 }
+
+/**
+ * Calculate late fee for an invoice.
+ * @param {{ status: string, dueDate?: string }} invoice
+ * @param {string} asOf - YYYY-MM-DD format, evaluation date
+ * @returns {number} - late fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  // Only charged on issued and partially_paid invoices
+  if (!['issued', 'partially_paid'].includes(invoice.status)) {
+    return 0;
+  }
+
+  // Must have a dueDate
+  if (!invoice.dueDate) {
+    return 0;
+  }
+
+  // Check if overdue (dueDate < asOf)
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // Get amount still due
+  const due = balanceDue(invoice);
+
+  // Calculate late fee: 0.04% per day = 0.0004 per day
+  return roundCents(due * 0.0004 * daysOverdue);
+}
