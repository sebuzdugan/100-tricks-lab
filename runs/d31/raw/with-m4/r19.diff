+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as plain euros with 2 decimals and a dot.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuro(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a field for CSV: wrap in quotes if it contains comma or quote, and double any quotes.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsv(field) {
+  const str = String(field);
+  if (str.includes(',') || str.includes('"')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<any>} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // One line per invoice
+  for (const invoice of invoices) {
+    // Get customer name
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    // Get totals
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    // Format fields
+    const fields = [
+      invoice.number || '',
+      escapeCsv(customerName),
+      invoice.issueDate || '',
+      invoice.dueDate || '',
+      invoice.status || '',
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ];
+
+    lines.push(fields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
