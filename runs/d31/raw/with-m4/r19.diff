+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue an invoice
+function createIssuedInvoice(customerId, issueDate, terms = 'NET30') {
+  const created = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+    terms,
+  });
+  const issued = issueInvoice(created.value, []);
+  return issued.value;
+}
+
+test('exportCsv: empty invoices array', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+  assert.equal(lines.length, 2);
+});
+
+test('exportCsv: single invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.ok(lines[1].includes('INV-'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+});
+
+test('exportCsv: multiple invoices', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-10-01');
+  const inv2 = createIssuedInvoice('C-002', '2026-10-02');
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4);
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[2].includes('Blue Fern Bakery'));
+});
+
+test('exportCsv: header format', () => {
+  const result = exportCsv([]);
+  const header = result.split('\n')[0];
+  assert.equal(header, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv: ends with newline', () => {
+  const result = exportCsv([]);
+  assert.equal(result[result.length - 1], '\n');
+});
+
+test('exportCsv: single invoice ends with newline', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  assert.equal(result[result.length - 1], '\n');
+});
+
+test('exportCsv: includes invoice number', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].startsWith(invoice.number));
+});
+
+test('exportCsv: includes customer name', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('Northwind Studio'));
+});
+
+test('exportCsv: includes issue date', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('2026-10-01'));
+});
+
+test('exportCsv: includes due date', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01', 'NET30');
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('2026-10-31'));
+});
+
+test('exportCsv: includes status', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv: formats amounts as euros', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  // Should contain amounts like 9.96, 0.50, 1.99, 11.45
+  assert.ok(lines[1].includes('.'));
+  // Split by comma and check last fields are euros
+  const fields = lines[1].split(',');
+  // Last field should be due amount
+  assert.ok(fields[fields.length - 1].match(/^\d+\.\d{2}$/));
+});
+
+test('exportCsv: no currency sign', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  assert.ok(!result.includes('€'));
+});
+
+test('exportCsv: no thousands separator', () => {
+  const created = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 }, // 120000 cents = 1200 euros
+    ],
+  });
+  const invoice = issueInvoice(created.value, []).value;
+  const result = exportCsv([invoice]);
+  // Should not have commas in thousands (CSV commas are field separators)
+  const lines = result.split('\n');
+  assert.ok(!lines[1].includes('1,200'));
+});
+
+test('exportCsv: handles draft invoices', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const result = exportCsv([created.value]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('draft'));
+  // Draft invoices have no number (starts with empty field)
+  assert.ok(lines[1].startsWith(','));
+});
+
+test('exportCsv: handles partially paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const partialInvoice = recordPayment(invoice, { amount: 500, date: '2026-10-02' }).value;
+  const result = exportCsv([partialInvoice]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('partially_paid'));
+});
+
+test('exportCsv: handles paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const paidInvoice = recordPayment(invoice, { amount: 1145, date: '2026-10-02' }).value;
+  const result = exportCsv([paidInvoice]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('paid'));
+});
+
+test('exportCsv: due amount is zero for paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const paidInvoice = recordPayment(invoice, { amount: 1145, date: '2026-10-02' }).value;
+  const result = exportCsv([paidInvoice]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // Last field should be 0.00
+  assert.equal(fields[fields.length - 1], '0.00');
+});
+
+test('exportCsv: due amount for partially paid invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const partialInvoice = recordPayment(invoice, { amount: 500, date: '2026-10-02' }).value;
+  const result = exportCsv([partialInvoice]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // Last field should be due amount (1145 - 500 = 645 cents = 6.45)
+  assert.equal(fields[fields.length - 1], '6.45');
+});
+
+test('exportCsv: escapes commas in customer name', () => {
+  // C-004 is "Smith, Jones & Partners" (contains comma)
+  const created = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const invoice = issueInvoice(created.value, []).value;
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  // Should have quotes around the customer name field
+  assert.ok(lines[1].includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv: escapes quotes in customer name', () => {
+  // C-006 is Marlow "The Print Shop" (contains quotes)
+  const created = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const invoice = issueInvoice(created.value, []).value;
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  // Should have quotes around the customer name and double the internal quotes
+  assert.ok(lines[1].includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv: preserves invoice order', () => {
+  const inv1 = createIssuedInvoice('C-001', '2026-10-01');
+  const inv2 = createIssuedInvoice('C-002', '2026-10-02');
+  const inv3 = createIssuedInvoice('C-001', '2026-10-03');
+  const result = exportCsv([inv1, inv2, inv3]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes(inv1.number));
+  assert.ok(lines[2].includes(inv2.number));
+  assert.ok(lines[3].includes(inv3.number));
+});
+
+test('exportCsv: includes all required fields', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields.length, 10);
+});
+
+test('exportCsv: subtotal is line total sum', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 2 }, // 1992 cents
+    ],
+  });
+  const invoice = issueInvoice(created.value, []).value;
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  // With 5% tier discount: subtotal should be 1992
+  assert.ok(lines[1].includes('19.92'));
+});
+
+test('exportCsv: discount reflects tier and line discounts', () => {
+  const created = createInvoice({
+    customerId: 'C-001', // 5% tier discount
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 1 }, // 996 cents
+    ],
+  });
+  const invoice = issueInvoice(created.value, []).value;
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  // Discount should be 5% of 996 = 49.8 → 50 cents
+  assert.ok(lines[1].includes('0.50'));
+});
+
+test('exportCsv: vat is calculated correctly', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 1 }, // 21% VAT
+    ],
+  });
+  const invoice = issueInvoice(created.value, []).value;
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  // VAT should be present and positive
+  const fields = lines[1].split(',');
+  const vat = parseFloat(fields[7]);
+  assert.ok(vat > 0);
+});
+
+test('exportCsv: total = subtotal - discount + vat - voucher', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  const subtotal = parseFloat(fields[5]);
+  const discount = parseFloat(fields[6]);
+  const vat = parseFloat(fields[7]);
+  const total = parseFloat(fields[8]);
+  // Total should equal subtotal - discount + vat
+  const expected = subtotal - discount + vat;
+  assert.ok(Math.abs(total - expected) < 0.01); // Allow for rounding
+});
+
+test('exportCsv: handles empty invoice number', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  // Draft invoice, no number
+  const result = exportCsv([created.value]);
+  const lines = result.split('\n');
+  // Should handle gracefully
+  assert.ok(lines[1]);
+});
+
+test('exportCsv: large dataset', () => {
+  const invoices = [];
+  for (let i = 0; i < 100; i++) {
+    const month = String(Math.floor(i / 10) + 1).padStart(2, '0');
+    const day = String((i % 10) + 1).padStart(2, '0');
+    const inv = createIssuedInvoice('C-001', `2026-${month}-${day}`);
+    invoices.push(inv);
+  }
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+  // Should have header + 100 invoices + empty line at end
+  assert.equal(lines.length, 102);
+});
+
+test('exportCsv: does not mutate input', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-10-01');
+  const invoices = [invoice];
+  const original = JSON.stringify(invoices);
+  exportCsv(invoices);
+  assert.equal(JSON.stringify(invoices), original);
+});
