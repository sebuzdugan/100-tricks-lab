 import { ok, fail } from './result.js';
 
+/** Exchange rates: units of each currency per euro. */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +46,38 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount from euros to another currency.
+ * @param {number} cents - amount in euro cents
+ * @param {string} currency - target currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const rate = RATES[currency];
+  const convertedAmount = roundCents(cents * rate);
+  return ok(convertedAmount);
+}
+
+/**
+ * Format cents as money for people with currency symbol.
+ * @param {number} cents - amount in the target currency's cents
+ * @param {string} currency - currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const integer = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const decimal = String(abs % 100).padStart(2, '0');
+
+  let symbol = '';
+  if (currency === 'USD') symbol = '$';
+  else if (currency === 'GBP') symbol = '£';
+  else if (currency === 'EUR') symbol = '€';
+
+  return `${sign}${symbol}${integer}.${decimal}`;
+}
