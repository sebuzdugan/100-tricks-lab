@@ -0,0 +1,349 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+
+test('lineTotal: calculates qty × unitPrice', () => {
+  const line = { qty: 5, unitPrice: 200 };
+  assert.equal(lineTotal(line), 1000);
+});
+
+test('lineTotal: zero quantity', () => {
+  const line = { qty: 0, unitPrice: 100 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal: zero unit price', () => {
+  const line = { qty: 5, unitPrice: 0 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal: single item', () => {
+  const line = { qty: 1, unitPrice: 996 };
+  assert.equal(lineTotal(line), 996);
+});
+
+test('lineTotal: large quantity', () => {
+  const line = { qty: 1000, unitPrice: 500 };
+  assert.equal(lineTotal(line), 500000);
+});
+
+test('invoiceTotals: single line no discount', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const invoice = created.value;
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 996);
+  assert.equal(totals.discount, 0);
+  // VAT should be calculated on full amount: 996 * 21% = 209.16 → 209
+  assert.equal(totals.vat, 209);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals: single line with tier discount', () => {
+  const created = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const invoice = created.value;
+  const totals = invoiceTotals(invoice);
+  // 996 * 5% = 49.8 → 50
+  assert.equal(totals.discount, 50);
+});
+
+test('invoiceTotals: single line with explicit discount overrides tier', () => {
+  const created = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1, discountPercent: 10 }],
+  });
+  const invoice = created.value;
+  const totals = invoiceTotals(invoice);
+  // 996 * 10% = 99.6 → 100
+  assert.equal(totals.discount, 100);
+});
+
+test('invoiceTotals: single line with VAT', () => {
+  const created = createInvoice({
+    customerId: 'C-003', // silver tier, 2.5% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }], // 21% VAT
+  });
+  const invoice = created.value;
+  const totals = invoiceTotals(invoice);
+  // 996 * 2.5% = 24.9 → 25
+  // (996 - 25) * 21% = 203.91 → 204
+  assert.equal(totals.discount, 25);
+  assert.equal(totals.vat, 204);
+});
+
+test('invoiceTotals: multiple lines', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 1 },
+      { sku: 'PRINT-A3', qty: 1 },
+    ],
+  });
+  const invoice = created.value;
+  const totals = invoiceTotals(invoice);
+  // PHOTO-LIC: 996 cents
+  // PRINT-A3: 249 cents
+  // Subtotal: 996 + 249 = 1245
+  assert.equal(totals.subtotal, 1245);
+  assert.ok(totals.discount > 0);
+});
+
+test('invoiceTotals: with voucher', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const withVoucher = applyVoucher(created.value, { code: 'PROMO', amount: 100 }).value;
+  const totals = invoiceTotals(withVoucher);
+  assert.equal(totals.voucher, 100);
+  // Total should be reduced by voucher
+  assert.ok(totals.total < (996 - 50 + 205));
+});
+
+test('invoiceTotals: voucher amount in result', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const withVoucher = applyVoucher(created.value, { code: 'TEST', amount: 250 }).value;
+  const totals = invoiceTotals(withVoucher);
+  assert.equal(totals.voucher, 250);
+});
+
+test('invoiceTotals: returns all required fields', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const totals = invoiceTotals(created.value);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
+
+test('invoiceTotals: subtotal is sum of line totals', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 2 }, // 1992
+      { sku: 'PRINT-A3', qty: 1 }, // 249
+    ],
+  });
+  const invoice = created.value;
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 1992 + 249);
+});
+
+test('invoiceTotals: discount is sum of line discounts', () => {
+  const created = createInvoice({
+    customerId: 'C-001', // 5% tier discount
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 1 }, // 996, discount 50
+      { sku: 'PRINT-A3', qty: 1 }, // 249, discount 12
+    ],
+  });
+  const totals = invoiceTotals(created.value);
+  // 50 + 12 = 62
+  assert.equal(totals.discount, 62);
+});
+
+test('invoiceTotals: vat calculation is per-line', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 1 }, // 21% VAT
+      { sku: 'PRINT-A3', qty: 1 }, // 9% VAT
+    ],
+  });
+  const totals = invoiceTotals(created.value);
+  // VAT should be different for each line
+  assert.ok(totals.vat > 0);
+});
+
+test('invoiceTotals: zero discount results in zero discount', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const totals = invoiceTotals(created.value);
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals: total = subtotal - discount + vat - voucher', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const withVoucher = applyVoucher(created.value, { code: 'TEST', amount: 50 }).value;
+  const totals = invoiceTotals(withVoucher);
+  const expected = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals: clamped at zero when voucher exceeds total', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const withVoucher = applyVoucher(created.value, { code: 'BIG', amount: 100000 }).value;
+  const totals = invoiceTotals(withVoucher);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals: with zero voucher', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const totals = invoiceTotals(created.value);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals: large invoice', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 5 },
+    ],
+  });
+  const totals = invoiceTotals(created.value);
+  // LOGO-PACK: 120000 cents each
+  // Subtotal: 600000
+  // Discount: 30000
+  // VAT: 119700
+  // Total: 600000 - 30000 + 119700 = 689700
+  assert.equal(totals.subtotal, 600000);
+  assert.equal(totals.discount, 30000);
+  assert.equal(totals.total, 689700);
+});
+
+test('invoiceTotals: does not mutate invoice', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const invoice = created.value;
+  const original = JSON.stringify(invoice);
+  invoiceTotals(invoice);
+  assert.equal(JSON.stringify(invoice), original);
+});
+
+test('lineTotal: does not mutate line', () => {
+  const line = { qty: 5, unitPrice: 200 };
+  const original = JSON.stringify(line);
+  lineTotal(line);
+  assert.equal(JSON.stringify(line), original);
+});
+
+test('invoiceTotals: multiple calls return same result', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const invoice = created.value;
+  const totals1 = invoiceTotals(invoice);
+  const totals2 = invoiceTotals(invoice);
+  assert.deepEqual(totals1, totals2);
+});
+
+test('invoiceTotals: with multiple different discount percents', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 1, discountPercent: 10 },
+      { sku: 'PRINT-A3', qty: 1, discountPercent: 20 },
+    ],
+  });
+  const invoice = created.value;
+  const totals = invoiceTotals(invoice);
+  // Discount should reflect both percentages
+  // PHOTO-LIC: 996 * 10% = 100
+  // PRINT-A3: 249 * 20% = 50
+  // Total discount: 150
+  assert.equal(totals.discount, 150);
+});
+
+test('invoiceTotals: all amounts are integers (cents)', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  });
+  const totals = invoiceTotals(created.value);
+  assert.equal(Number.isInteger(totals.subtotal), true);
+  assert.equal(Number.isInteger(totals.discount), true);
+  assert.equal(Number.isInteger(totals.vat), true);
+  assert.equal(Number.isInteger(totals.voucher), true);
+  assert.equal(Number.isInteger(totals.total), true);
+});
+
+test('lineTotal: preserves exact calculation', () => {
+  const line = { qty: 3, unitPrice: 333 };
+  assert.equal(lineTotal(line), 999);
+});
+
+test('invoiceTotals: with workshop product (0% VAT)', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  });
+  const invoice = created.value;
+  const totals = invoiceTotals(invoice);
+  // VAT should be 0 for 0% VAT rate
+  // But discount still applies
+  assert.equal(totals.vat, 0);
+  assert.ok(totals.discount > 0);
+});
+
+test('invoiceTotals: mixed VAT rates', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 1 }, // 21% VAT
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0% VAT
+    ],
+  });
+  const totals = invoiceTotals(created.value);
+  // VAT should only come from PHOTO-LIC
+  assert.ok(totals.vat > 0);
+});
+
+test('invoiceTotals: explicit 0% discount on line with tier discount', () => {
+  const created = createInvoice({
+    customerId: 'C-001', // 5% tier discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1, discountPercent: 0 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Explicit 0% overrides tier discount
+  assert.equal(totals.discount, 0);
+});
