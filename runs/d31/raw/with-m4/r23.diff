diff --git a/test/totals.test.js b/test/totals.test.js
index 248341f..0dfc259 100644
--- a/test/totals.test.js
+++ b/test/totals.test.js
@@ -347,3 +347,222 @@ test('invoiceTotals: explicit 0% discount on line with tier discount', () => {
   // Explicit 0% overrides tier discount
   assert.equal(totals.discount, 0);
 });
+
+test('invoiceTotals: bulk discount with qty=9 (below threshold)', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 9 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // No tier discount, no bulk discount (qty < 10)
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals: bulk discount with qty=10 (at threshold)', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 10 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Line total: 996 * 10 = 9960
+  // No first discount (standard tier)
+  // Bulk discount: 9960 * 2.5% = 249 → 249
+  assert.equal(totals.subtotal, 9960);
+  assert.equal(totals.discount, 249);
+});
+
+test('invoiceTotals: bulk discount applied after tier discount', () => {
+  const created = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 10 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Line total: 996 * 10 = 9960
+  // First discount: 9960 * 5% = 498 → 498
+  // Amount after first discount: 9960 - 498 = 9462
+  // Bulk discount: 9462 * 2.5% = 236.55 → 237
+  // Total discount: 498 + 237 = 735
+  assert.equal(totals.subtotal, 9960);
+  assert.equal(totals.discount, 735);
+});
+
+test('invoiceTotals: bulk discount applied after explicit line discount', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 10, discountPercent: 10 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Line total: 996 * 10 = 9960
+  // First discount: 9960 * 10% = 996 → 996
+  // Amount after first discount: 9960 - 996 = 8964
+  // Bulk discount: 8964 * 2.5% = 224.1 → 224
+  // Total discount: 996 + 224 = 1220
+  assert.equal(totals.subtotal, 9960);
+  assert.equal(totals.discount, 1220);
+});
+
+test('invoiceTotals: bulk discount only on lines with qty >= 10', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 5 }, // 996 * 5 = 4980, no bulk discount
+      { sku: 'PHOTO-LIC', qty: 10 }, // 996 * 10 = 9960, with bulk discount: 249
+    ],
+  });
+  const totals = invoiceTotals(created.value);
+  // Total discount should be just the bulk discount from the second line
+  assert.equal(totals.discount, 249);
+});
+
+test('invoiceTotals: VAT calculated on amount after both discounts', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 10 }], // 21% VAT
+  });
+  const totals = invoiceTotals(created.value);
+  // Line total: 9960
+  // Bulk discount: 249
+  // Amount for VAT: 9960 - 249 = 9711
+  // VAT: 9711 * 21% = 2039.31 → 2039
+  assert.equal(totals.vat, 2039);
+});
+
+test('invoiceTotals: bulk discount with multiple lines and tier discount', () => {
+  const created = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 1 }, // 996, discount 50, no bulk
+      { sku: 'PHOTO-LIC', qty: 10 }, // 9960, first discount 498, bulk 237, total 735
+    ],
+  });
+  const totals = invoiceTotals(created.value);
+  // Total discount: 50 + 735 = 785
+  assert.equal(totals.discount, 785);
+});
+
+test('invoiceTotals: bulk discount threshold is exactly 10', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 10 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Should have bulk discount (qty >= 10)
+  assert.ok(totals.discount > 0);
+});
+
+test('invoiceTotals: no bulk discount when qty=9', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 9 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Should have no discount (qty < 10)
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals: bulk discount on large order', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 100 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Line total: 996 * 100 = 99600
+  // Bulk discount: 99600 * 2.5% = 2490
+  assert.equal(totals.discount, 2490);
+});
+
+test('invoiceTotals: bulk discount with zero tier discount', () => {
+  const created = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 20 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Line total: 996 * 20 = 19920
+  // First discount: 0 (standard tier)
+  // Bulk discount: 19920 * 2.5% = 498 → 498
+  assert.equal(totals.discount, 498);
+});
+
+test('invoiceTotals: bulk discount with high tier discount', () => {
+  const created = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 20 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Line total: 996 * 20 = 19920
+  // First discount: 19920 * 5% = 996 → 996
+  // Amount after first: 19920 - 996 = 18924
+  // Bulk discount: 18924 * 2.5% = 473.1 → 473
+  // Total discount: 996 + 473 = 1469
+  assert.equal(totals.discount, 1469);
+});
+
+test('invoiceTotals: bulk discount with explicit high discount', () => {
+  const created = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 20, discountPercent: 20 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // Line total: 996 * 20 = 19920
+  // First discount: 19920 * 20% = 3984 → 3984
+  // Amount after first: 19920 - 3984 = 15936
+  // Bulk discount: 15936 * 2.5% = 398.4 → 398
+  // Total discount: 3984 + 398 = 4382
+  assert.equal(totals.discount, 4382);
+});
+
+test('invoiceTotals: total formula with bulk discount', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 10 }],
+  });
+  const totals = invoiceTotals(created.value);
+  // total = subtotal - discount + vat - voucher
+  const expected = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals: bulk discount with voucher', () => {
+  const created = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 10 }],
+  });
+  const withVoucher = applyVoucher(created.value, { code: 'TEST', amount: 100 }).value;
+  const totals = invoiceTotals(withVoucher);
+  // Bulk discount should still apply
+  assert.equal(totals.discount, 249);
+  assert.equal(totals.voucher, 100);
+});
+
+test('invoiceTotals: mixed qty lines with bulk discounts', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'PHOTO-LIC', qty: 5 }, // No bulk discount
+      { sku: 'PHOTO-LIC', qty: 10 }, // With bulk discount
+      { sku: 'PHOTO-LIC', qty: 3 }, // No bulk discount
+    ],
+  });
+  const totals = invoiceTotals(created.value);
+  // First line: 996 * 5 = 4980, discount 249
+  // Second line: 996 * 10 = 9960, first discount 498, bulk 237, total 735
+  // Third line: 996 * 3 = 2988, discount 149
+  // Total discount: 249 + 735 + 149 = 1133
+  assert.equal(totals.discount, 1133);
+});
