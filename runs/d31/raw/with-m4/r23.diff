+    if (line.qty >= 10) {
+      const bulkDiscount = roundCents(discountedAmount * 2.5 / 100);
+      discountedAmount -= bulkDiscount;
+    }
+
     const lineVat = roundCents(discountedAmount * line.vatRate / 100);
     return sum + lineVat;
   }, 0);
