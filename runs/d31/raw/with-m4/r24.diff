+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(draft, []).value;
+  const partial = recordPayment(issued, { amount: 500, date: '2026-10-02' }).value;
+  const paid = recordPayment(partial, { amount: 645, date: '2026-10-03' }).value;
+  const draft2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  }).value;
+
+  const result = dashboard([draft, issued, partial, paid, draft2], '2026-10-07');
+  assert.equal(result.counts.draft, 2);
+  assert.equal(result.counts.issued, 1);
