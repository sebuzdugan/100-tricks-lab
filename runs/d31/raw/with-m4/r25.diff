+
+  const voucherResult = applyVoucher(invoice, { code: 'TEST', amount: 1000 });
+  const invoiceWithVoucher = voucherResult.value;
+
+  const text = renderInvoiceText(invoiceWithVoucher);
+  const lines = text.split('\n');
