--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,169 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a valid invoice with enriched lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2025-01-15');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'ICON-SET');
+  assert.equal(r.value.lines[0].name, 'Icon set (24 icons)');
+  assert.equal(r.value.lines[0].qty, 2);
+  assert.equal(r.value.lines[0].unitPrice, 980);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'DES-HOUR', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].sku, 'ICON-SET');
+  assert.equal(r.value.lines[1].sku, 'DES-HOUR');
+});
+
+test('createInvoice reports unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports invalid date format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '01-15-2025',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports invalid date (nonexistent)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports date with wrong format (missing parts)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports missing lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: undefined,
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports invalid quantity (float)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1.5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports invalid quantity (zero)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 0 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports invalid quantity (negative)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: -5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports invalid quantity (non-integer string)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: '5' }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports unknown SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'UNKNOWN', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice reports unknown SKU even with valid first line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'ICON-SET', qty: 1 },
+      { sku: 'UNKNOWN', qty: 1 },
+    ],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate the input lines array', () => {
+  const inputLines = [{ sku: 'ICON-SET', qty: 2 }];
+  const original = JSON.parse(JSON.stringify(inputLines));
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: inputLines,
+  });
+  assert.deepEqual(inputLines, original);
+});
+
+test('createInvoice returns a new lines array (not the original)', () => {
+  const inputLines = [{ sku: 'ICON-SET', qty: 2 }];
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: inputLines,
+  });
+  assert.notEqual(r.value.lines, inputLines);
+  assert.notEqual(r.value.lines[0], inputLines[0]);
+});
