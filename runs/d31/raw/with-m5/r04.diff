+++ b/test/numbering.test.js
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates first number of the year', () => {
+  const num = nextInvoiceNumber([], '2025-01-15');
+  assert.equal(num, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const num = nextInvoiceNumber(['INV-2025-0001'], '2025-03-20');
+  assert.equal(num, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber finds highest counter in any order', () => {
+  const num = nextInvoiceNumber(['INV-2025-0003', 'INV-2025-0001', 'INV-2025-0002'], '2025-06-10');
+  assert.equal(num, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const num = nextInvoiceNumber(['INV-2024-0999', 'INV-2025-0002', 'INV-2026-0001'], '2025-12-31');
+  assert.equal(num, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber restarts counter each year', () => {
+  const num = nextInvoiceNumber(['INV-2024-0999', 'INV-2025-0005'], '2026-01-01');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const num = nextInvoiceNumber(['INV-2025-0099'], '2025-06-15');
+  assert.equal(num, 'INV-2025-0100');
+});
+
+test('nextInvoiceNumber handles gap in counter sequence', () => {
+  const num = nextInvoiceNumber(['INV-2025-0001', 'INV-2025-0003'], '2025-06-15');
+  assert.equal(num, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber handles empty existing numbers', () => {
+  const num = nextInvoiceNumber([], '2025-01-01');
+  assert.equal(num, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber extracts year from YYYY-MM-DD format', () => {
+  const num1 = nextInvoiceNumber([], '2024-12-31');
+  const num2 = nextInvoiceNumber([], '2025-01-01');
+  assert.equal(num1, 'INV-2024-0001');
+  assert.equal(num2, 'INV-2025-0001');
+});
