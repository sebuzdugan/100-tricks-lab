@@ -0,0 +1,28 @@
+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded.
+ * Counter restarts at 0001 each year.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (in any order)
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Find the highest counter for this year
+  let highestCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterPart = num.substring(prefix.length);
+      const counter = parseInt(counterPart, 10);
+      if (counter > highestCounter) {
+        highestCounter = counter;
+      }
+    }
+  }
+
+  // Return next number with counter zero-padded to 4 digits
+  const nextCounter = highestCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
