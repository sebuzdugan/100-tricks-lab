+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display/printing.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  const numberLine = invoice.number ?? 'DRAFT';
+  lines.push(numberLine);
+
+  // Customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+  lines.push(customerName);
+
+  // Blank line
+  lines.push('');
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Blank line
+  lines.push('');
+
+  // Total line
+  const invoiceTotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  lines.push(`Total: ${formatEuros(invoiceTotal)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..8e0addf
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,191 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 2 }],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 2 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const text = renderInvoiceText(r2.value);
+  assert.ok(text.startsWith('INV-2025-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText shows all line details', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 2 }],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('2 × Icon set'));
+  assert.ok(text.includes('€9.80'));
+  assert.ok(text.includes('€19.60'));
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'DES-HOUR', qty: 1 },
+    ],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('2 × Icon set'));
+  assert.ok(text.includes('1 × Design work'));
+});
+
+test('renderInvoiceText shows correct totals', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'DES-HOUR', qty: 1 },
+    ],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  // ICON-SET: 2 × 980 = 1960 cents = €19.60
+  // DES-HOUR: 1 × 8500 = 8500 cents = €85.00
+  // Total: 10460 cents = €104.60
+  assert.ok(text.includes('Total: €104.60'));
+});
+
+test('renderInvoiceText has proper structure with blank lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  const parts = text.split('\n');
+  // Should have: number, customer, blank, line(s), blank, total
+  assert.ok(parts.length >= 6);
+  assert.equal(parts[2], ''); // blank line after customer
+});
+
+test('renderInvoiceText formats single item properly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('1 × Icon set'));
+  assert.ok(text.includes('€9.80'));
+  assert.ok(text.includes('Total: €9.80'));
+});
+
+test('renderInvoiceText formats large quantities', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 100 }],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('100 × Icon set'));
+});
+
+test('renderInvoiceText formats expensive items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  // BRAND-BOOK unitPrice is 245000 cents = €2,450.00
+  assert.ok(text.includes('€2,450.00'));
+});
+
+test('renderInvoiceText uses formatEuros for all amounts', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'PRINT-A4', qty: 5 }],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  // PRINT-A4 unitPrice is 37 cents = €0.37
+  // 5 × 37 = 185 cents = €1.85
+  assert.ok(text.includes('€0.37'));
+  assert.ok(text.includes('€1.85'));
+});
+
+test('renderInvoiceText shows line names from catalogue', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 2 },
+    ],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Design work (hour)'));
+  assert.ok(text.includes('Development (hour)'));
+});
+
+test('renderInvoiceText ends with Total line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  const invoice = r.value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.ok(lines[lines.length - 1].startsWith('Total: €'));
+});
+
+test('renderInvoiceText works with all different invoice statuses', () => {
+  // Draft
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  const text1 = renderInvoiceText(r1.value);
+  assert.ok(text1.startsWith('DRAFT'));
+
+  // Issued
+  const r2 = issueInvoice(r1.value, []);
+  const text2 = renderInvoiceText(r2.value);
+  assert.ok(text2.startsWith('INV-2025-0001'));
+});
