+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date (in UTC).
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(text);
+  if (!match) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  return !isNaN(date.getTime()) && date.toISOString().startsWith(text);
+}
+
+/**
+ * Parse a YYYY-MM-DD date string into year, month, day components (no timezone conversion).
+ * @param {string} dateString
+ * @returns {{ year: number, month: number, day: number }}
+ */
+function parseDate(dateString) {
+  const [year, month, day] = dateString.split('-').map(Number);
+  return { year, month, day };
+}
+
+/**
+ * Format year, month, day components into YYYY-MM-DD string.
+ * @param {number} year
+ * @param {number} month
+ * @param {number} day
+ * @returns {string}
+ */
+function formatDate(year, month, day) {
+  return `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
+}
+
+/**
+ * Add n days to a date string (YYYY-MM-DD). Works in UTC.
+ * @param {string} dateString
+ * @param {number} days
+ * @returns {string}
+ */
+export function addDays(dateString, days) {
+  if (!isValidDate(dateString)) {
+    throw new Error(`Invalid date: ${dateString}`);
+  }
+
+  const { year, month, day } = parseDate(dateString);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  date.setUTCDate(date.getUTCDate() + days);
+
+  return formatDate(date.getUTCFullYear(), date.getUTCMonth() + 1, date.getUTCDate());
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a) in UTC.
+ * @param {string} dateA
+ * @param {string} dateB
+ * @returns {number}
+ */
+export function daysBetween(dateA, dateB) {
+  if (!isValidDate(dateA) || !isValidDate(dateB)) {
+    throw new Error(`Invalid date(s): ${dateA}, ${dateB}`);
+  }
+
+  const { year: yearA, month: monthA, day: dayA } = parseDate(dateA);
+  const { year: yearB, month: monthB, day: dayB } = parseDate(dateB);
+
+  const dateObjA = new Date(Date.UTC(yearA, monthA - 1, dayA));
+  const dateObjB = new Date(Date.UTC(yearB, monthB - 1, dayB));
+
+  const diffMs = dateObjB.getTime() - dateObjA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
