+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-01-15'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('01-15-2025'), false);
+  assert.equal(isValidDate('2025/01/15'), false);
+  assert.equal(isValidDate('2025-1-15'), false);
+  assert.equal(isValidDate('2025-01-5'), false);
+});
+
+test('isValidDate rejects nonexistent dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-04-31'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-01-15', 5), '2025-01-20');
+});
+
+test('addDays adds zero days', () => {
+  assert.equal(addDays('2025-01-15', 0), '2025-01-15');
+});
+
+test('addDays subtracts days with negative input', () => {
+  assert.equal(addDays('2025-01-15', -5), '2025-01-10');
+});
+
+test('addDays handles month boundary', () => {
+  assert.equal(addDays('2025-01-30', 5), '2025-02-04');
+});
+
+test('addDays handles year boundary', () => {
+  assert.equal(addDays('2025-12-30', 5), '2026-01-04');
+});
+
+test('addDays handles year boundary backwards', () => {
+  assert.equal(addDays('2025-01-05', -10), '2024-12-26');
+});
+
+test('addDays handles leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays throws for invalid date', () => {
+  assert.throws(() => addDays('2025-02-30', 1), /Invalid date/);
+});
+
+test('addDays handles large day additions', () => {
+  assert.equal(addDays('2025-01-01', 365), '2026-01-01');
+});
+
+test('daysBetween calculates same day', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-15'), 0);
+});
+
+test('daysBetween calculates forward days', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-20'), 5);
+});
+
+test('daysBetween calculates negative (backward) days', () => {
+  assert.equal(daysBetween('2025-01-20', '2025-01-15'), -5);
+});
+
+test('daysBetween crosses month boundary', () => {
+  assert.equal(daysBetween('2025-01-30', '2025-02-03'), 4);
+});
+
+test('daysBetween crosses year boundary', () => {
+  assert.equal(daysBetween('2024-12-30', '2025-01-02'), 3);
+});
+
+test('daysBetween crosses year boundary backward', () => {
+  assert.equal(daysBetween('2025-01-02', '2024-12-30'), -3);
+});
+
+test('daysBetween handles leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+});
+
+test('daysBetween calculates large differences', () => {
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
+
+test('daysBetween throws for invalid dates', () => {
+  assert.throws(() => daysBetween('2025-02-30', '2025-03-01'), /Invalid date/);
+  assert.throws(() => daysBetween('2025-01-01', '2025-02-30'), /Invalid date/);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const start = '2025-01-15';
+  const n = 10;
+  const end = addDays(start, n);
+  assert.equal(daysBetween(start, end), n);
+});
+
+test('isValidDate works with createInvoice', async () => {
+  const { createInvoice } = await import('../src/invoices.js');
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+});
+
+test('createInvoice rejects invalid date from dates.js', async () => {
+  const { createInvoice } = await import('../src/invoices.js');
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'DATE_INVALID');
+});
