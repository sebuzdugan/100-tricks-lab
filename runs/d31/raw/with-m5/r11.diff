+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the amount still owed on an invoice (total minus payments made).
+ * @param {{ lines: Array, payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const { total } = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments ?? []).reduce((sum, payment) => sum + payment.amount, 0);
+  return Math.max(0, total - totalPaid);
+}
+
+/**
+ * Record a payment on an issued invoice.
+ * @param {{ status: string, lines: Array, payments?: Array<{ amount: number, date: string }>, issueDate?: string, number?: string, customerId?: string }} invoice
+ * @param {{ amount: unknown, date: string }} params
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check invoice is issued or partially paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get balance due
+  const owed = balanceDue(invoice);
+
+  // Validate amount doesn't exceed balance due
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payment record
+  const payment = { amount, date };
+
+  // Add to payments array (create if missing)
+  const newPayments = [...(invoice.payments ?? []), payment];
+
+  // Calculate new status
+  const totalPaid = newPayments.reduce((sum, p) => sum + p.amount, 0);
+  const { total } = invoiceTotals(invoice);
+  const newStatus = totalPaid >= total ? 'paid' : 'partially_paid';
+
+  // Create new invoice with payment
+  const newInvoice = {
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  };
+
+  return ok(newInvoice);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
