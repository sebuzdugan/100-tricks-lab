+++ b/test/payments.test.js
@@ -0,0 +1,247 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, invoiceTotals, issueInvoice } from '../src/invoices.js';
+
+// Helper to create a test invoice
+function createTestInvoice() {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.equal(draftResult.ok, true);
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  return issuedResult.value;
+}
+
+test('recordPayment adds payment to issued invoice', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: 500, date: '2025-01-20' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 500);
+  assert.equal(r.value.payments[0].date, '2025-01-20');
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment records full payment and sets status to paid', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: total, date: '2025-01-20' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+  assert.equal(r.value.payments[0].amount, total);
+});
+
+test('recordPayment records multiple payments', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r1 = recordPayment(invoice, { amount: 500, date: '2025-01-20' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.payments.length, 1);
+
+  const r2 = recordPayment(r1.value, { amount: 300, date: '2025-01-25' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.payments.length, 2);
+  assert.equal(r2.value.payments[1].amount, 300);
+  assert.equal(r2.value.payments[1].date, '2025-01-25');
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.equal(draftResult.ok, true);
+
+  const r = recordPayment(draftResult.value, { amount: 500, date: '2025-01-20' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_ISSUED');
+});
+
+test('recordPayment rejects payment on paid invoice', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r1 = recordPayment(invoice, { amount: total, date: '2025-01-20' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.status, 'paid');
+
+  const r2 = recordPayment(r1.value, { amount: 100, date: '2025-01-25' });
+  assert.equal(r2.ok, false);
+  assert.equal(r2.error, 'NOT_ISSUED');
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const invoice = createTestInvoice();
+
+  const r = recordPayment(invoice, { amount: 123.45, date: '2025-01-20' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects negative amount', () => {
+  const invoice = createTestInvoice();
+
+  const r = recordPayment(invoice, { amount: -500, date: '2025-01-20' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects zero amount', () => {
+  const invoice = createTestInvoice();
+
+  const r = recordPayment(invoice, { amount: 0, date: '2025-01-20' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: total + 100, date: '2025-01-20' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'OVERPAYMENT');
+});
+
+test('recordPayment rejects overpayment after partial payment', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r1 = recordPayment(invoice, { amount: 500, date: '2025-01-20' });
+  assert.equal(r1.ok, true);
+
+  const remaining = total - 500;
+  const r2 = recordPayment(r1.value, { amount: remaining + 100, date: '2025-01-25' });
+  assert.equal(r2.ok, false);
+  assert.equal(r2.error, 'OVERPAYMENT');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = createTestInvoice();
+  const originalPayments = invoice.payments;
+  const originalStatus = invoice.status;
+
+  recordPayment(invoice, { amount: 500, date: '2025-01-20' });
+
+  assert.equal(invoice.payments, originalPayments);
+  assert.equal(invoice.status, originalStatus);
+});
+
+test('balanceDue returns total for unissued invoice with no payments', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const due = balanceDue(invoice);
+  assert.equal(due, total);
+});
+
+test('balanceDue returns remaining after partial payment', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: 500, date: '2025-01-20' });
+  assert.equal(r.ok, true);
+
+  const due = balanceDue(r.value);
+  assert.equal(due, total - 500);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: total, date: '2025-01-20' });
+  assert.equal(r.ok, true);
+
+  const due = balanceDue(r.value);
+  assert.equal(due, 0);
+});
+
+test('balanceDue is correct with multiple payments', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r1 = recordPayment(invoice, { amount: 500, date: '2025-01-20' });
+  assert.equal(r1.ok, true);
+
+  const r2 = recordPayment(r1.value, { amount: 300, date: '2025-01-25' });
+  assert.equal(r2.ok, true);
+
+  const due = balanceDue(r2.value);
+  assert.equal(due, total - 800);
+});
+
+test('balanceDue clamps to 0 (defensive)', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'paid',
+    lines: [{ sku: 'ICON-SET', qty: 1, name: 'Icon Set', unitPrice: 980, vatRate: 21, discountPercent: 0 }],
+    payments: [{ amount: 100000, date: '2025-01-20' }],
+  };
+
+  const due = balanceDue(invoice);
+  assert.equal(due >= 0, true);
+});
+
+test('recordPayment records on partially_paid invoice', () => {
+  const invoice = createTestInvoice();
+  const { total } = invoiceTotals(invoice);
+
+  const r1 = recordPayment(invoice, { amount: 500, date: '2025-01-20' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.status, 'partially_paid');
+
+  const r2 = recordPayment(r1.value, { amount: total - 500, date: '2025-01-25' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'paid');
+});
+
+test('recordPayment with multi-line invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'DES-HOUR', qty: 1 },
+    ],
+  });
+  assert.equal(draftResult.ok, true);
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  const invoice = issuedResult.value;
+
+  const { total } = invoiceTotals(invoice);
+  const r = recordPayment(invoice, { amount: Math.floor(total / 2), date: '2025-01-20' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment with invoice with discount', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1, discountPercent: 10 }],
+  });
+  assert.equal(draftResult.ok, true);
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  const invoice = issuedResult.value;
+
+  const { total } = invoiceTotals(invoice);
+  const r = recordPayment(invoice, { amount: total, date: '2025-01-20' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
