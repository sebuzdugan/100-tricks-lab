+/**
+ * Calculate the due date based on payment terms and issue date.
+ * @param {string} issueDate - YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} - Due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [yearStr, monthStr] = issueDate.split('-');
+    const year = Number(yearStr);
+    const month = Number(monthStr);
+
+    let nextMonthDate;
+    if (month === 12) {
+      nextMonthDate = new Date(Date.UTC(year + 1, 0, 1));
+    } else {
+      nextMonthDate = new Date(Date.UTC(year, month, 1));
+    }
+
+    nextMonthDate.setUTCDate(0);
+    const y = nextMonthDate.getUTCFullYear();
+    const m = nextMonthDate.getUTCMonth() + 1;
+    const d = nextMonthDate.getUTCDate();
+
+    return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
+  }
+}
