@@ -270,3 +271,28 @@ export function issueInvoice(invoice, existingNumbers) {
 
   return ok(newInvoice);
 }
+
+/**
+ * Apply a voucher to an invoice.
+ * @param {{ status: string, voucher?: any, lines: Array }} invoice
+ * @param {{ code: string, amount: unknown }} params
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check invoice doesn't already have a voucher
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  // Create new invoice with voucher
+  const newInvoice = {
+    ...invoice,
+    voucher: { code, amount },
+  };
+
+  return ok(newInvoice);
+}
