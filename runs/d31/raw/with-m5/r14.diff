+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue an invoice
+function createAndIssueInvoice(customerId, issueDate, lines, terms = 'NET30') {
+  const draftResult = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+    terms,
+  });
+  if (!draftResult.ok) throw new Error(`Failed to create invoice: ${draftResult.error}`);
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  if (!issuedResult.ok) throw new Error(`Failed to issue invoice: ${issuedResult.error}`);
+
+  return issuedResult.value;
+}
+
+test('statement returns invoices for a customer', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+  const invoice2 = createAndIssueInvoice('C-001', '2025-02-20', [{ sku: 'DES-HOUR', qty: 1 }]);
+
+  const r = statement('C-001', [invoice1, invoice2], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 2);
+});
+
+test('statement filters by customer', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+  const invoice2 = createAndIssueInvoice('C-002', '2025-01-20', [{ sku: 'DES-HOUR', qty: 1 }]);
+
+  const r = statement('C-001', [invoice1, invoice2], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, invoice1.number);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-03-15', [{ sku: 'ICON-SET', qty: 1 }]);
+  const invoice2 = createAndIssueInvoice('C-001', '2025-01-10', [{ sku: 'ICON-SET', qty: 1 }]);
+  const invoice3 = createAndIssueInvoice('C-001', '2025-02-20', [{ sku: 'DES-HOUR', qty: 1 }]);
+
+  const r = statement('C-001', [invoice1, invoice2, invoice3], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].issueDate, '2025-01-10');
+  assert.equal(r.value.invoices[1].issueDate, '2025-02-20');
+  assert.equal(r.value.invoices[2].issueDate, '2025-03-15');
+});
+
+test('statement filters by asOf date', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+  const invoice2 = createAndIssueInvoice('C-001', '2025-02-20', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const invoice3 = createAndIssueInvoice('C-001', '2025-03-10', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const r = statement('C-001', [invoice1, invoice2, invoice3], '2025-02-20');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].issueDate, '2025-01-15');
+  assert.equal(r.value.invoices[1].issueDate, '2025-02-20');
+});
+
+test('statement excludes asOf date cutoff (before only)', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-02-20', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const rBefore = statement('C-001', [invoice], '2025-02-19');
+  assert.equal(rBefore.ok, true);
+  assert.equal(rBefore.value.invoices.length, 0);
+
+  const rOn = statement('C-001', [invoice], '2025-02-20');
+  assert.equal(rOn.ok, true);
+  assert.equal(rOn.value.invoices.length, 1);
+});
+
+test('statement includes invoice fields', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const r = statement('C-001', [invoice], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  const statementInvoice = r.value.invoices[0];
+  assert.equal(statementInvoice.number, invoice.number);
+  assert.equal(statementInvoice.issueDate, '2025-01-15');
+  assert.equal(statementInvoice.dueDate, '2025-01-29');
+  assert(statementInvoice.total > 0);
+  assert(statementInvoice.due > 0);
+});
+
+test('statement calculates due correctly for unpaid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const r = statement('C-001', [invoice], '2025-12-31');
+  assert.equal(r.ok, true);
+  const statementInvoice = r.value.invoices[0];
+  assert.equal(statementInvoice.due, statementInvoice.total);
+});
+
+test('statement calculates due correctly for partially paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const paymentResult = recordPayment(invoice, { amount: 500, date: '2025-01-20' });
+  assert.equal(paymentResult.ok, true);
+
+  const r = statement('C-001', [paymentResult.value], '2025-12-31');
+  assert.equal(r.ok, true);
+  const statementInvoice = r.value.invoices[0];
+  assert.equal(statementInvoice.due, statementInvoice.total - 500);
+});
+
+test('statement filters out paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const totals = { total: 1127 };
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2025-01-20' });
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'paid');
+
+  const r = statement('C-001', [paymentResult.value], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement filters out draft invoices', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.equal(draftResult.ok, true);
+
+  const r = statement('C-001', [draftResult.value], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement calculates totalDue', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+  const invoice2 = createAndIssueInvoice('C-001', '2025-02-20', [{ sku: 'DES-HOUR', qty: 1 }]);
+
+  const r = statement('C-001', [invoice1, invoice2], '2025-12-31');
+  assert.equal(r.ok, true);
+  const expected = r.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(r.value.totalDue, expected);
+});
+
+test('statement totalDue is 0 for fully paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const paymentResult = recordPayment(invoice, { amount: 1127, date: '2025-01-20' });
+  assert.equal(paymentResult.ok, true);
+
+  const r = statement('C-001', [paymentResult.value], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const r = statement('C-999', [invoice], '2025-12-31');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement handles empty invoice list', () => {
+  const r = statement('C-001', [], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement normalizes customer ID', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const r = statement('c-001', [invoice], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement normalizes customer ID with spaces', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const r = statement('  c-001  ', [invoice], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement with invoices that have discounts and VAT', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [
+    { sku: 'ICON-SET', qty: 2, discountPercent: 5 },
+  ]);
+
+  const r = statement('C-001', [invoice], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert(r.value.invoices[0].total > 0);
+  assert(r.value.invoices[0].due > 0);
+});
+
+test('statement with invoices that have vouchers', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.equal(draftResult.ok, true);
+
+  const voucherResult = applyVoucher(draftResult.value, { code: 'PROMO', amount: 300 });
+  assert.equal(voucherResult.ok, true);
+
+  const issuedResult = issueInvoice(voucherResult.value, []);
+  assert.equal(issuedResult.ok, true);
+
+  const r = statement('C-001', [issuedResult.value], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert(r.value.invoices[0].due > 0);
+});
+
+test('statement with multiple invoices for single customer', () => {
+  const invoices = [];
+  for (let i = 0; i < 5; i++) {
+    const invoice = createAndIssueInvoice('C-001', `2025-0${i + 1}-15`, [{ sku: 'ICON-SET', qty: 1 }]);
+    invoices.push(invoice);
+  }
+
+  const r = statement('C-001', invoices, '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 5);
+  assert(r.value.totalDue > 0);
+});
+
+test('statement with mixed statuses (issued and partially_paid)', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const invoice2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice2Issued = issueInvoice(invoice2Result.value, []);
+  const invoice2Partial = recordPayment(invoice2Issued.value, { amount: 2000, date: '2025-02-25' });
+
+  const r = statement('C-001', [invoice1, invoice2Partial.value], '2025-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+});
+
+test('statement provides accurate total for accounting', () => {
+  const invoices = [];
+  for (let i = 0; i < 3; i++) {
+    const invoice = createAndIssueInvoice('C-001', `2025-0${i + 1}-10`, [{ sku: 'ICON-SET', qty: i + 1 }]);
+    invoices.push(invoice);
+  }
+
+  const r = statement('C-001', invoices, '2025-12-31');
+  assert.equal(r.ok, true);
+
+  const manualTotal = r.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(r.value.totalDue, manualTotal);
+});
