+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate the next credit note number for a given date.
+ * @param {string[]} existingNumbers - All existing invoice and credit note numbers
+ * @param {string} date - YYYY-MM-DD date
+ * @returns {string} - Credit note number in CN-YYYY-NNNN format
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+  const cnNumbers = existingNumbers.filter((num) => num.startsWith('CN-'));
+  const cnThisYear = cnNumbers
+    .filter((num) => num.startsWith(`CN-${year}-`))
+    .map((num) => {
+      const match = num.match(/CN-\d{4}-(\d{4})/);
+      return match ? Number(match[1]) : 0;
+    });
+
+  const maxCounter = cnThisYear.length > 0 ? Math.max(...cnThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an invoice.
+ * @param {{ status: string, number?: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: unknown, reason: string, date: string }} params
+ * @param {string[]} existingNumbers - All existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is issued, partially_paid, or paid
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const { total } = invoiceTotals(invoice);
+
+  // Validate credit amount doesn't exceed invoice total
+  if (amount > total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  // Create credit note
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
