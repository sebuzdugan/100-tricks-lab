+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue an invoice
+function createAndIssueInvoice(customerId, issueDate, lines, terms = 'NET30') {
+  const draftResult = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+    terms,
+  });
+  if (!draftResult.ok) throw new Error(`Failed to create invoice: ${draftResult.error}`);
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  if (!issuedResult.ok) throw new Error(`Failed to issue invoice: ${issuedResult.error}`);
+
+  return issuedResult.value;
+}
+
+test('overdueInvoices returns empty array for empty list', () => {
+  const r = overdueInvoices([], '2025-03-15');
+  assert.equal(Array.isArray(r), true);
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices detects single overdue invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+  // dueDate will be 2025-01-29
+
+  const r = overdueInvoices([invoice], '2025-02-15');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].number, invoice.number);
+  assert.equal(r[0].customerId, 'C-001');
+  assert.equal(r[0].dueDate, '2025-01-29');
+});
+
+test('overdueInvoices filters out draft invoices', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+    terms: 'NET14',
+  });
+  assert.equal(draftResult.ok, true);
+
+  const r = overdueInvoices([draftResult.value], '2025-02-15');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices filters out paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const paymentResult = recordPayment(invoice, { amount: 1127, date: '2025-01-30' });
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'paid');
+
+  const r = overdueInvoices([paymentResult.value], '2025-02-15');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices includes issued invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+  assert.equal(invoice.status, 'issued');
+
+  const r = overdueInvoices([invoice], '2025-02-15');
+  assert.equal(r.length, 1);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const paymentResult = recordPayment(invoice, { amount: 500, date: '2025-01-30' });
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'partially_paid');
+
+  const r = overdueInvoices([paymentResult.value], '2025-02-15');
+  assert.equal(r.length, 1);
+});
+
+test('overdueInvoices excludes invoices with future due dates', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET30');
+  // dueDate will be 2025-02-14
+
+  const r = overdueInvoices([invoice], '2025-02-13');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices excludes invoices with due date equal to asOf', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET30');
+  // dueDate will be 2025-02-14
+
+  const r = overdueInvoices([invoice], '2025-02-14');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+  // dueDate will be 2025-01-29
+
+  const r = overdueInvoices([invoice], '2025-02-05');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].daysOverdue, 7);
+});
+
+test('overdueInvoices calculates daysOverdue as 0 for one day overdue', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+  // dueDate will be 2025-01-29
+
+  const r = overdueInvoices([invoice], '2025-01-30');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].daysOverdue, 1);
+});
+
+test('overdueInvoices calculates due for issued invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const r = overdueInvoices([invoice], '2025-02-15');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].due, 1127);
+});
+
+test('overdueInvoices calculates due for partially_paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const paymentResult = recordPayment(invoice, { amount: 500, date: '2025-01-30' });
+  assert.equal(paymentResult.ok, true);
+
+  const r = overdueInvoices([paymentResult.value], '2025-02-15');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].due, 627);
+});
+
+test('overdueInvoices sorts by dueDate (most overdue first)', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-10', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+  const invoice2 = createAndIssueInvoice('C-001', '2025-01-20', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+  const invoice3 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const r = overdueInvoices([invoice1, invoice2, invoice3], '2025-02-15');
+  assert.equal(r.length, 3);
+  assert.equal(r[0].dueDate, '2025-01-24');
+  assert.equal(r[1].dueDate, '2025-01-29');
+  assert.equal(r[2].dueDate, '2025-02-03');
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+  const invoice2 = createAndIssueInvoice('C-002', '2025-01-20', [{ sku: 'DES-HOUR', qty: 1 }], 'NET14');
+
+  const r = overdueInvoices([invoice1, invoice2], '2025-02-15');
+  assert.equal(r.length, 2);
+  assert.equal(r[0].customerId, 'C-001');
+  assert.equal(r[1].customerId, 'C-002');
+});
+
+test('overdueInvoices includes invoice fields', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const r = overdueInvoices([invoice], '2025-02-15');
+  assert.equal(r.length, 1);
+  const item = r[0];
+  assert(item.number);
+  assert.equal(item.customerId, 'C-001');
+  assert(item.dueDate);
+  assert(Number.isInteger(item.daysOverdue));
+  assert(Number.isInteger(item.due));
+});
+
+test('overdueInvoices with multiple invoices, mixed status', () => {
+  const issued = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const invoiceForPayment = createAndIssueInvoice('C-001', '2025-01-10', [{ sku: 'DES-HOUR', qty: 1 }], 'NET14');
+  const partial = recordPayment(invoiceForPayment, { amount: 500, date: '2025-01-30' });
+
+  const r = overdueInvoices([issued, partial.value], '2025-02-15');
+  assert.equal(r.length, 2);
+});
+
+test('overdueInvoices returns overdue items only', () => {
+  const overdue = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+  const notOverdue = createAndIssueInvoice('C-001', '2025-02-15', [{ sku: 'DES-HOUR', qty: 1 }], 'NET14');
+
+  const r = overdueInvoices([overdue, notOverdue], '2025-02-20');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].dueDate, overdue.dueDate);
+});
+
+test('overdueInvoices with NET30 terms (month apart)', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+  const invoice2 = createAndIssueInvoice('C-001', '2025-02-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const r = overdueInvoices([invoice1, invoice2], '2025-03-20');
+  assert.equal(r.length, 2);
+  assert.equal(r[0].dueDate, invoice1.dueDate);
+  assert.equal(r[1].dueDate, invoice2.dueDate);
+});
+
+test('overdueInvoices with EOM terms', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'EOM');
+  // EOM dueDate will be 2025-01-31
+
+  const r = overdueInvoices([invoice], '2025-02-15');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].dueDate, '2025-01-31');
+});
+
+test('overdueInvoices with high amount due', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 100 }], 'NET14');
+
+  const r = overdueInvoices([invoice], '2025-02-15');
+  assert.equal(r.length, 1);
+  assert(r[0].due > 100000);
+});
+
+test('overdueInvoices preserves invoice number', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const r = overdueInvoices([invoice], '2025-02-15');
+  assert.equal(r[0].number, invoice.number);
+  assert.match(r[0].number, /^INV-2025-\d{4}$/);
+});
+
+test('overdueInvoices many overdue invoices', () => {
+  const invoices = [];
+  for (let i = 0; i < 10; i++) {
+    const invoice = createAndIssueInvoice('C-001', `2025-0${1 + Math.floor(i / 3)}-${10 + i}`, [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+    invoices.push(invoice);
+  }
+
+  const r = overdueInvoices(invoices, '2025-04-15');
+  assert(r.length > 0);
+  for (let i = 0; i < r.length - 1; i++) {
+    assert(r[i].dueDate <= r[i + 1].dueDate);
+  }
+});
+
+test('overdueInvoices with different discount amounts', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1, discountPercent: 5 }], 'NET14');
+  const invoice2 = createAndIssueInvoice('C-001', '2025-01-20', [{ sku: 'ICON-SET', qty: 1, discountPercent: 10 }], 'NET14');
+
+  const r = overdueInvoices([invoice1, invoice2], '2025-02-15');
+  assert.equal(r.length, 2);
+  assert(r[0].due > 0);
+  assert(r[1].due > 0);
+  assert(r[0].due !== r[1].due);
+});
+
+test('overdueInvoices at exact asOf date boundary', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+  // dueDate: 2025-01-29
+
+  // On dueDate: not overdue
+  const r1 = overdueInvoices([invoice], '2025-01-29');
+  assert.equal(r1.length, 0);
+
+  // One day after: overdue with 1 day
+  const r2 = overdueInvoices([invoice], '2025-01-30');
+  assert.equal(r2.length, 1);
+  assert.equal(r2[0].daysOverdue, 1);
+});
