+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a list of overdue invoices.
+ * @param {Array<{ number: string, customerId: string, dueDate: string, status: string, payments?: Array }>} invoices - All invoices
+ * @param {string} asOf - Report date (YYYY-MM-DD)
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = invoices
+    .filter((invoice) => {
+      // Check status is issued or partially_paid
+      if (!['issued', 'partially_paid'].includes(invoice.status)) return false;
+      // Check dueDate is before asOf
+      if (invoice.dueDate >= asOf) return false;
+      return true;
+    })
+    .map((invoice) => {
+      // Calculate days overdue
+      const dueDate = new Date(invoice.dueDate + 'T00:00:00Z');
+      const asOfDate = new Date(asOf + 'T00:00:00Z');
+      const daysOverdue = Math.floor((asOfDate - dueDate) / (1000 * 60 * 60 * 24));
+
+      return {
+        number: invoice.number,
+        customerId: invoice.customerId,
+        dueDate: invoice.dueDate,
+        daysOverdue,
+        due: balanceDue(invoice),
+      };
+    })
+    .sort((a, b) => {
+      // Most overdue first = oldest dueDate first
+      return a.dueDate.localeCompare(b.dueDate);
+    });
+
+  return overdue;
+}
