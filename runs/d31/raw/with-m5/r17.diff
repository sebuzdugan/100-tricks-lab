+/**
+ * Generate a VAT summary by rate for invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices - All invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} - One entry per VAT rate, sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  // Process invoices with issued, partially_paid, or paid status
+  invoices
+    .filter((invoice) => ['issued', 'partially_paid', 'paid'].includes(invoice.status))
+    .forEach((invoice) => {
+      invoice.lines.forEach((line) => {
+        const rate = line.vatRate ?? 0;
+        const base = Math.max(0, lineTotal(line) - lineDiscount(line));
+        const vat = lineVat(line);
+
+        if (!vatMap.has(rate)) {
+          vatMap.set(rate, { base: 0, vat: 0 });
+        }
+
+        const current = vatMap.get(rate);
+        current.base += base;
+        current.vat += vat;
+      });
+    });
+
+  // Convert to array, add rate, and sort by rate descending
+  const summary = Array.from(vatMap.entries())
+    .map(([rate, { base, vat }]) => ({
+      rate,
+      base: roundCents(base),
+      vat: roundCents(vat),
+    }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return summary;
+}
