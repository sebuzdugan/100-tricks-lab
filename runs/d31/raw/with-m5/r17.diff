+// VAT Summary Tests
+
+test('vatSummary returns empty array for empty invoices', () => {
+  const r = vatSummary([]);
+  assert.equal(Array.isArray(r), true);
+  assert.equal(r.length, 0);
+});
+
+test('vatSummary filters out draft invoices', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.equal(draftResult.ok, true);
+
+  const r = vatSummary([draftResult.value]);
+  assert.equal(r.length, 0);
+});
+
+test('vatSummary includes issued invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+  assert.equal(invoice.status, 'issued');
+
+  const r = vatSummary([invoice]);
+  assert(r.length > 0);
+});
+
+test('vatSummary includes partially_paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
