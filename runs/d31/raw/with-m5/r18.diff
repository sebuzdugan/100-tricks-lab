+/**
+ * Calculate late fee for an invoice.
+ * @param {{ status: string, dueDate: string, lines: Array, payments?: Array }} invoice - An invoice
+ * @param {string} asOf - Report date (YYYY-MM-DD)
+ * @returns {number} - Late fee in cents (0.04% of amount due per day overdue)
+ */
+export function lateFee(invoice, asOf) {
+  // Skip if draft (no late fees on unissued invoices)
+  if (invoice.status === 'draft') return 0;
+
+  // Skip if not overdue
+  if (!invoice.dueDate || invoice.dueDate >= asOf) return 0;
+
+  // Calculate days overdue
+  const dueDate = new Date(invoice.dueDate + 'T00:00:00Z');
+  const asOfDate = new Date(asOf + 'T00:00:00Z');
+  const daysOverdue = Math.floor((asOfDate - dueDate) / (1000 * 60 * 60 * 24));
+
+  // Get amount due
+  const due = balanceDue(invoice);
+
+  // Calculate late fee: 0.04% per day
+  const fee = due * (0.04 / 100) * daysOverdue;
+
+  return roundCents(fee);
+}
