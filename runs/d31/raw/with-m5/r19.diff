+test('exportCsv with discounts', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [
+    { sku: 'ICON-SET', qty: 1, discountPercent: 10 },
+  ]);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  // Should have discount amount
