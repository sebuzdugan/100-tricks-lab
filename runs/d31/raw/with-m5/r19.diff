+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue an invoice
+function createAndIssueInvoice(customerId, issueDate, lines, terms = 'NET30') {
+  const draftResult = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+    terms,
+  });
+  if (!draftResult.ok) throw new Error(`Failed to create invoice: ${draftResult.error}`);
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  if (!issuedResult.ok) throw new Error(`Failed to issue invoice: ${issuedResult.error}`);
+
+  return issuedResult.value;
+}
+
+test('exportCsv returns string', () => {
+  const csv = exportCsv([]);
+  assert.equal(typeof csv, 'string');
+});
+
+test('exportCsv includes header', () => {
+  const csv = exportCsv([]);
+  assert(csv.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv header is first line', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv ends with newline', () => {
+  const csv = exportCsv([]);
+  assert(csv.endsWith('\n'));
+});
+
+test('exportCsv empty list returns only header and newline', () => {
+  const csv = exportCsv([]);
+  const expected = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+  assert.equal(csv, expected);
+});
+
+test('exportCsv single invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3); // header, data, trailing empty
+  assert(lines[1].includes(invoice.number));
+  assert(lines[1].includes('2025-01-15'));
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv includes issue date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('2025-01-15'));
+});
+
+test('exportCsv includes due date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }], 'NET14');
+
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('2025-01-29'));
+});
+
+test('exportCsv includes status', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('issued'));
+});
+
+test('exportCsv formats amounts as euros', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const csv = exportCsv([invoice]);
+  // Should include amounts like 10.00, 11.27, etc.
+  assert(csv.includes('.'));
+  // Verify amounts have decimal point, not comma separator (e.g. 10.00 not 10,00)
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  // Amounts are in fields 5-9 (subtotal, discount, vat, total, due)
+  for (let i = 5; i <= 9; i++) {
+    assert(/\d+\.\d{2}/.test(fields[i]), `Field ${i} should use dot decimal: ${fields[i]}`);
+  }
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  // Check for pattern like X.XX
+  assert(/\d+\.\d{2}/.test(dataLine));
+});
+
+test('exportCsv no currency sign', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const csv = exportCsv([invoice]);
+  assert(!csv.includes('€'));
+  assert(!csv.includes('$'));
+});
