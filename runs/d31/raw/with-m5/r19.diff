+
+test('exportCsv due field for paid invoice is zero', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const paymentResult = recordPayment(invoice, { amount: 1127, date: '2025-01-20' });
+  const csv = exportCsv([paymentResult.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  // due (field 9) should be 0.00
+  assert.equal(fields[9], '0.00');
+});
+
+test('exportCsv multiple invoices different customers', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+  const invoice2 = createAndIssueInvoice('C-002', '2025-02-15', [{ sku: 'DES-HOUR', qty: 1 }]);
+
+  const csv = exportCsv([invoice1, invoice2]);
