+  // Draft invoices might have empty dueDate
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+  assert.equal(draftResult.ok, true);
+  // Remove dueDate to test empty field
+  draftResult.value.dueDate = undefined;
+
+  const csv = exportCsv([draftResult.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  // Should have empty field for dueDate
+  assert(dataLine.includes(',,'));
+});
+
+test('exportCsv formatting consistency', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
+  const invoice2 = createAndIssueInvoice('C-001', '2025-01-20', [{ sku: 'ICON-SET', qty: 1 }]);
+
+  const csv = exportCsv([invoice1, invoice2]);
+  const lines = csv.split('\n');
+
+  // All amount fields should have 2 decimal places
+  for (let i = 1; i < lines.length - 1; i++) {
+    if (lines[i].length === 0) continue;
+    const amountPattern = /\d+\.\d{2}/g;
+    const matches = lines[i].match(amountPattern);
+    assert(matches && matches.length >= 4, 'Should have at least 4 amounts with 2 decimals');
+  }
+});
