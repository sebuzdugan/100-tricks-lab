+
+test('exportCsv customer with comma in name', () => {
+  // C-004 has name "Smith, Jones & Partners" which contains a comma
+  const invoice = createAndIssueInvoice('C-004', '2025-01-15', [{ sku: 'ICON-SET', qty: 1 }]);
