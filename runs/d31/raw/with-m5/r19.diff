+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros with 2 decimal places.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuro(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Escape a CSV field: quote if contains comma or quote, and double internal quotes.
+ * @param {string|number} value
+ * @returns {string}
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ number: string, customerId: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: any }>} invoices
+ * @returns {string} - CSV string with header and data rows, lines ending with \n
+ */
+export function exportCsv(invoices) {
+  const lines = [
+    'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'
+  ];
+
+  for (const invoice of invoices) {
+    // Get customer name
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+    // Calculate totals
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    // Build row
+    const row = [
+      invoice.number,
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate || '',
+      invoice.status,
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ];
+
+    // Join with CSV escaping
+    lines.push(row.map(escapeCsvField).join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
