index fadf486..53a522f 100644
--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,61 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert an amount from euros to another currency.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Target currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }} - Amount in target currency cents
+ */
+export function convert(cents, currency) {
+  if (!RATES.hasOwnProperty(currency)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const euros = cents / 100;
+  const converted = euros * rate;
+  const convertedCents = roundCents(converted * 100);
+
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents in a given currency for display.
+ * @param {number} cents - Amount in the specified currency's cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function formatMoney(cents, currency) {
+  if (!RATES.hasOwnProperty(currency)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const wholePart = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const fractionalPart = String(abs % 100).padStart(2, '0');
+  const amount = `${wholePart}.${fractionalPart}`;
+
+  let formatted;
+  if (currency === 'USD') {
+    formatted = `${sign}$${amount}`;
+  } else if (currency === 'GBP') {
+    formatted = `${sign}£${amount}`;
+  } else {
+    // EUR
+    formatted = `${sign}€${amount}`;
+  }
+
+  return ok(formatted);
+}
