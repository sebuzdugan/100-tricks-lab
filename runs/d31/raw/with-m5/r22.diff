+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+// lineTotal tests
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  const line = { qty: 2, unitPrice: 980 };
+  assert.equal(lineTotal(line), 1960);
+});
+
+test('lineTotal handles qty of 1', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal handles large quantities', () => {
+  const line = { qty: 12000, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 12000000);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal preserves exact amounts', () => {
+  const line = { qty: 3, unitPrice: 333 };
+  assert.equal(lineTotal(line), 999);
+});
+
+// lineDiscount tests
+
+test('lineDiscount calculates discount amount', () => {
+  const line = { qty: 2, unitPrice: 980, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 196);
+});
+
+test('lineDiscount defaults discountPercent to 0 if not provided', () => {
+  const line = { qty: 2, unitPrice: 980 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount handles decimal discount percentages', () => {
+  const line = { qty: 1, unitPrice: 1250, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 125);
+});
+
+test('lineDiscount rounds fractional cents', () => {
+  const line = { qty: 1, unitPrice: 1000, discountPercent: 33.33 };
+  assert.equal(lineDiscount(line), 333);
+});
+
+test('lineDiscount clamps to 0 (never negative)', () => {
+  const line = { qty: 2, unitPrice: 980, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 2, unitPrice: 980, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 1960);
+});
+
+test('lineDiscount with 50% discount', () => {
+  const line = { qty: 2, unitPrice: 980, discountPercent: 50 };
+  assert.equal(lineDiscount(line), 980);
+});
+
+test('lineDiscount uses banker\'s rounding', () => {
+  // Test that roundCents is called correctly
+  const line = { qty: 1, unitPrice: 100, discountPercent: 50.5 };
+  // 100 * 50.5 / 100 = 50.5, which banker's rounds to 50 (half to even)
+  assert.equal(lineDiscount(line), 50);
+});
+
+// lineVat tests
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 1, unitPrice: 1000, vatRate: 21 };
+  assert.equal(lineVat(line), 210);
+});
+
+test('lineVat defaults vatRate to 0 if not provided', () => {
+  const line = { qty: 1, unitPrice: 1000 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat applies to discounted amount', () => {
+  const line = { qty: 2, unitPrice: 1000, discountPercent: 10, vatRate: 21 };
+  // subtotal: 2000, discount: 200, after discount: 1800, vat: 378
+  assert.equal(lineVat(line), 378);
+});
+
+test('lineVat returns 0 when no VAT rate', () => {
+  const line = { qty: 10, unitPrice: 100, discountPercent: 50 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with 6% rate', () => {
+  const line = { qty: 1, unitPrice: 1000, vatRate: 6 };
+  assert.equal(lineVat(line), 60);
+});
+
+test('lineVat clamps to 0 (never negative)', () => {
+  const line = { qty: 1, unitPrice: 0, vatRate: 21 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with high discount and VAT', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 99, vatRate: 21 };
+  // subtotal: 10000, discount: 9900, after discount: 100, vat: 21
+  assert.equal(lineVat(line), 21);
+});
+
+// invoiceTotals tests
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 1000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 210);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 1210);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, vatRate: 21 },
+      { qty: 2, unitPrice: 500, vatRate: 6 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 2000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 270);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 2270);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals returns an object with subtotal, vat and total', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('total' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('voucher' in totals);
+});
+
+test('invoiceTotals returns discount field', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 200);
+});
+
+test('invoiceTotals calculates single line discount', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 980, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 1960, discount: 196, after discount: 1764, vat: 370.44 -> 370
+  assert.equal(totals.subtotal, 1960);
+  assert.equal(totals.discount, 196);
+});
+
+test('invoiceTotals sums discounts across multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 1000, discountPercent: 10 },
+      { qty: 1, unitPrice: 1000, discountPercent: 5 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // line1: 2000, discount: 200
+  // line2: 1000, discount: 50
+  // total discount: 250
+  assert.equal(totals.discount, 250);
+});
+
+test('invoiceTotals applies discount before VAT', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 1000, discount: 100, after discount: 900, vat: 189
+  assert.equal(totals.vat, 189);
+});
+
+test('invoiceTotals sums VAT across multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, vatRate: 21 },
+      { qty: 1, unitPrice: 1000, vatRate: 6 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // line1 vat: 210, line2 vat: 60
+  assert.equal(totals.vat, 270);
+});
+
+test('invoiceTotals with voucher reduces total', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21 }],
+    voucher: { code: 'SUMMER10', amount: 100 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 100);
+  assert.equal(totals.total, 1110);
+});
+
+test('invoiceTotals without voucher sets voucher to 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals clamps total to 0 if negative', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    voucher: { code: 'X', amount: 200 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with multiple lines and discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 2, unitPrice: 500, discountPercent: 5, vatRate: 6 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // line1: 1000, discount: 100, after: 900, vat: 189
+  // line2: 1000, discount: 50, after: 950, vat: 57
+  // subtotal: 2000, discount: 150, vat: 246
+  assert.equal(totals.subtotal, 2000);
+  assert.equal(totals.discount, 150);
+});
+
+test('invoiceTotals with high discount rate', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 980, discountPercent: 50, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 1960, discount: 980, after: 980, vat: 205.8 -> 206
+  assert.equal(totals.subtotal, 1960);
+  assert.equal(totals.discount, 980);
+});
+
+test('invoiceTotals returns integer cents', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 333, discountPercent: 33, vatRate: 13 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(Number.isInteger(totals.subtotal));
+  assert.ok(Number.isInteger(totals.discount));
+  assert.ok(Number.isInteger(totals.vat));
+  assert.ok(Number.isInteger(totals.total));
+});
+
+test('invoiceTotals with three lines and mixed rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 1000, discountPercent: 10, vatRate: 6 },
+      { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // line1: 1000, no discount, vat: 210
+  // line2: 1000, discount: 100, after: 900, vat: 54
+  // line3: 1000, no discount, no vat
+  // subtotal: 3000, discount: 100, vat: 264
+  assert.equal(totals.subtotal, 3000);
+  assert.equal(totals.discount, 100);
+});
+
+test('invoiceTotals with large invoice', () => {
+  const invoice = {
+    lines: Array(10).fill(null).map(() => ({
+      qty: 100,
+      unitPrice: 1000,
+      discountPercent: 5,
+      vatRate: 21,
+    })),
+  };
+  const totals = invoiceTotals(invoice);
+  // each line: 100000, discount: 5000, after: 95000, vat: 19950
+  // 10 lines: subtotal 1000000, discount: 50000, vat: 199500
+  assert.equal(totals.subtotal, 1000000);
+  assert.equal(totals.discount, 50000);
+});
+
+test('invoiceTotals precision with decimal operations', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 333, discountPercent: 33, vatRate: 19 },
+      { qty: 7, unitPrice: 147, discountPercent: 11, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(Number.isInteger(totals.total));
+});
+
+test('invoiceTotals with all zero values', () => {
+  const invoice = {
+    lines: [{ qty: 0, unitPrice: 0, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals total formula: subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+    voucher: { code: 'X', amount: 50 },
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = 1000 - 100 + 189 - 50;
+  assert.equal(totals.total, expected);
+});
