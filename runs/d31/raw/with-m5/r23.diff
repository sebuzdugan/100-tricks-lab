diff --git a/src/totals.js b/src/totals.js
index 0850315..ed6d44d 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -11,13 +11,21 @@ export function lineTotal(line) {
 
 /**
  * Calculate the discount amount for a single line.
+ * Applies primary discount first, then 2.5% bulk discount if qty >= 10.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
   const discountPercent = line.discountPercent ?? 0;
-  const discount = roundCents(lineTotal(line) * discountPercent / 100);
-  return Math.max(0, discount);
+  const primaryDiscount = roundCents(lineTotal(line) * discountPercent / 100);
+
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const amountAfterPrimary = Math.max(0, lineTotal(line) - primaryDiscount);
+    bulkDiscount = roundCents(amountAfterPrimary * 2.5 / 100);
+  }
+
+  return Math.max(0, primaryDiscount + bulkDiscount);
 }
 
