+test('renderInvoiceText structure with all elements', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+    terms: 'NET30',
+  });
+  const voucherResult = applyVoucher(draftResult.value, { code: 'PROMO', amount: 100 });
+  const issuedResult = issueInvoice(voucherResult.value, []);
+  const paymentResult = recordPayment(issuedResult.value, { amount: 500, date: '2025-01-20' });
+
+  const text = renderInvoiceText(paymentResult.value);
+  const lines = text.split('\n');
+
+  // Find key lines
+  const invoiceNumberIndex = lines.findIndex(l => l.startsWith('INV-'));
+  const customerIndex = lines.findIndex(l => l.includes('Northwind'));
+  const blankAfterCustomer = lines.findIndex((l, i) => i > customerIndex && l === '');
+  const discountIndex = lines.findIndex(l => l.includes('Discount:'));
+  const blankBeforeTotals = lines.findIndex((l, i) => i > discountIndex && l === '');
+  const voucherIndex = lines.findIndex(l => l.includes('Voucher'));
+  const totalIndex = lines.findIndex(l => l.startsWith('Total:'));
+  const dueIndex = lines.findIndex(l => l.startsWith('Due:'));
+  const paidIndex = lines.findIndex(l => l.startsWith('Paid:'));
+
+  // Verify order
+  assert.ok(invoiceNumberIndex < customerIndex);
+  assert.ok(customerIndex < blankAfterCustomer);
+  assert.ok(discountIndex > blankAfterCustomer);
+  assert.ok(voucherIndex > blankBeforeTotals);
+  assert.ok(totalIndex > voucherIndex);
+  assert.ok(dueIndex > totalIndex);
+  assert.ok(paidIndex > dueIndex);
+});
