   }
 
   // Blank line
@@ -35,6 +42,11 @@ export function renderInvoiceText(invoice) {
   // Calculate totals
   const totals = invoiceTotals(invoice);
 
+  // Voucher line (if any)
+  if (invoice.voucher && invoice.voucher.amount > 0) {
+    lines.push(`Voucher (${invoice.voucher.code}): ${formatEuros(invoice.voucher.amount)}`);
+  }
+
   // VAT line (if VAT > 0)
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
@@ -43,5 +55,16 @@ export function renderInvoiceText(invoice) {
   // Total line
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date line (if available)
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid line (if there are payments)
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = totals.total - balanceDue(invoice);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
