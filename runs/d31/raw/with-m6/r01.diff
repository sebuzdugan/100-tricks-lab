+++ b/src/invoices.js
@@ -0,0 +1,77 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Check if a date string is in YYYY-MM-DD format and is a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return false;
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const [year, month, day] = dateStr.split('-');
+  return (
+    !isNaN(date.getTime()) &&
+    date.getUTCFullYear() === Number(year) &&
+    date.getUTCMonth() + 1 === Number(month) &&
+    date.getUTCDate() === Number(day)
+  );
+}
+
+/**
+ * Check if a quantity is a positive integer.
+ * @param {unknown} qty
+ * @returns {boolean}
+ */
+function isValidQty(qty) {
+  return Number.isInteger(qty) && qty > 0;
+}
+
+/**
+ * Create an invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} invoice
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice(invoice) {
+  const { customerId, issueDate, lines } = invoice;
+
+  // Validate date
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate lines array is not empty
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    const { sku, qty } = line;
+
+    // Validate qty
+    if (!isValidQty(qty)) return fail('QTY_INVALID');
+
+    // Get product from catalogue
+    const productResult = getProduct(sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..01a1b06
