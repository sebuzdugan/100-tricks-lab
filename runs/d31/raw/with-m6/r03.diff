+/**
+ * Add or update a line on an invoice. If the SKU exists, increase its qty; otherwise add a new line.
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {{ sku: string, qty: number }} lineToAdd
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function addLine(invoice, lineToAdd) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const { sku, qty } = lineToAdd;
+
+  // Validate qty
+  if (!isValidQty(qty)) return fail('QTY_INVALID');
+
+  // Get product from catalogue
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Create new lines array
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+
+  // Find existing line with this SKU
+  const existingLine = newLines.find((line) => line.sku === sku);
+
+  if (existingLine) {
+    // Update existing line
+    existingLine.qty += qty;
+  } else {
+    // Add new line
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array<{ sku: string }> }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if line exists
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  // Check if it's the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new lines array without the removed line
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
