+/**
+ * Issue a draft invoice by assigning it a number and changing its status to 'issued'.
+ * @param {{ status: string, issueDate: string, lines: Array, customerId: string }} invoice
+ * @param {string[]} existingNumbers - Array of previously issued invoice numbers
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Generate the next invoice number
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    ...invoice,
+    number,
+    status: 'issued',
+  });
+}
