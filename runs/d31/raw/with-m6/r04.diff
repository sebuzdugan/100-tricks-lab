diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..8aa7516
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,58 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber finds the maximum counter', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0002', 'INV-2026-0008'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0009');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0099', 'INV-2026-0003', 'INV-2027-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber restarts counter each year', () => {
+  const existing = ['INV-2025-0050', 'INV-2025-0051'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 1000 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-1001');
+});
+
+test('nextInvoiceNumber ignores invalid entries', () => {
+  const existing = ['INV-2026-0001', 'INVALID', 'INV-2026-abc', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber works with unordered numbers', () => {
+  const existing = ['INV-2026-0008', 'INV-2026-0001', 'INV-2026-0005', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0009');
+});
+
+test('nextInvoiceNumber extracts year correctly from date', () => {
+  const existing = ['INV-2025-0010'];
+  const num2025 = nextInvoiceNumber(existing, '2025-12-31');
+  const num2026 = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(num2025, 'INV-2025-0011');
+  assert.equal(num2026, 'INV-2026-0001');
+});
