index 0000000..5998c1e
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,26 @@
+/**
+ * Get the next available invoice number for a given issue date.
+ * Invoice numbers are INV-<year>-<counter> where counter resets each year (0001-9999).
+ * @param {string[]} existingNumbers - Array of previously issued invoice numbers
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  // Find all numbers for this year and extract their counters
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return Number(counter);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  // Find the next counter
+  const nextCounter = Math.max(0, ...countersThisYear) + 1;
+
+  // Format with 4 digits zero-padded
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
