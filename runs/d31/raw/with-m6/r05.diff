+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to a customer.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, lineTotal?: number }>, status?: string }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+  // Get invoice header
+  const invoiceNumber = invoice.number ?? 'DRAFT';
+
+  // Get totals
+  const totals = invoiceTotals(invoice);
+
+  // Build lines
+  const lines = [];
+  lines.push(invoiceNumber);
+  lines.push(customerName);
+  lines.push('');
+
+  // Add each line item
+  for (const line of invoice.lines) {
+    const lineTotal = line.qty * line.unitPrice;
+    const qtyStr = line.qty === 1 ? '1x' : `${line.qty}x`;
+    const unitPriceStr = formatEuros(line.unitPrice);
+    const lineTotalStr = formatEuros(lineTotal);
+    lines.push(`${qtyStr} ${line.name} @ ${unitPriceStr} = ${lineTotalStr}`);
+  }
+
+  lines.push('');
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
