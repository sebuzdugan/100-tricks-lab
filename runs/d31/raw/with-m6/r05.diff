+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('INV-2026-0001'));
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText shows line items with qty and amounts', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 2, unitPrice: 9500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('2x Development (hour)'));
+  assert.ok(text.includes('€95.00'));
+  assert.ok(text.includes('€190.00'));
+});
+
+test('renderInvoiceText shows singular form for qty 1', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('1x Logo package'));
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 2, unitPrice: 9500, vatRate: 21 },
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('2x Development (hour)'));
+  assert.ok(text.includes('1x Logo package'));
+  assert.ok(text.includes('€190.00'));
+  assert.ok(text.includes('€1,200.00'));
+});
+
+test('renderInvoiceText shows total', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 2, unitPrice: 9500, vatRate: 21 },
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Total: €1,390.00'));
+});
+
+test('renderInvoiceText formats amounts with formatEuros', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'STICKER', name: 'Sticker sheet', qty: 100, unitPrice: 50, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  // 100 * 50 cents = 5000 cents = €50.00
+  assert.ok(text.includes('€0.50'));
+  assert.ok(text.includes('€50.00'));
+});
+
+test('renderInvoiceText returns multiline string', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.ok(lines.length >= 5);
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '');
+});
+
+test('renderInvoiceText uses customer name from lookup', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Kite & Co'));
+});
+
+test('renderInvoiceText falls back to customerId if customer not found', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('C-999'));
+});
+
+test('renderInvoiceText handles large amounts', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'BRAND-BOOK', name: 'Brand guidelines document', qty: 5, unitPrice: 245000, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('€2,450.00'));
+  assert.ok(text.includes('€12,250.00'));
+});
+
+test('renderInvoiceText with VAT-exempt items', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'WORKSHOP-DAY', name: 'Brand workshop (day, VAT exempt)', qty: 1, unitPrice: 60000, vatRate: 0 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('€600.00'));
+  assert.ok(text.includes('Total: €600.00'));
+});
