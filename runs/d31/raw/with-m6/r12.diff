   return Math.floor(diffMs / msPerDay);
 }
+
+/**
+ * Calculate the due date based on payment terms and issue date.
+ * @param {string} issueDate - YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string|null} - Due date in YYYY-MM-DD format, or null if terms invalid
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    const date = new Date(issueDate + 'T00:00:00Z');
+    const year = date.getUTCFullYear();
+    const month = date.getUTCMonth();
+    const lastDay = new Date(Date.UTC(year, month + 1, 0));
+
+    const year2 = lastDay.getUTCFullYear();
+    const monthStr = String(lastDay.getUTCMonth() + 1).padStart(2, '0');
+    const dayStr = String(lastDay.getUTCDate()).padStart(2, '0');
+
+    return `${year2}-${monthStr}-${dayStr}`;
+  }
+  return null;
+}
