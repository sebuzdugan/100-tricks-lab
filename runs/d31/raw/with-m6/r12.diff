+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+import { daysBetween } from '../src/dates.js';
+
+test('createInvoice defaults to NET30 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+});
+
+test('createInvoice accepts NET14 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET14');
+});
+
+test('createInvoice accepts NET30 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+});
+
+test('createInvoice accepts EOM terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'EOM');
+});
+
+test('createInvoice rejects invalid terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET45',
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'TERMS_INVALID');
+});
+
+test('createInvoice rejects unknown terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NOPE',
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'TERMS_INVALID');
+});
+
+test('NET14 due date is 14 days after issue date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(result.value.dueDate, '2026-10-21');
+  assert.equal(daysBetween('2026-10-07', result.value.dueDate), 14);
+});
+
+test('NET30 due date is 30 days after issue date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(result.value.dueDate, '2026-11-06');
+  assert.equal(daysBetween('2026-10-07', result.value.dueDate), 30);
+});
+
+test('NET14 handles month boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(result.value.dueDate, '2026-11-03');
+});
+
+test('NET30 handles month boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(result.value.dueDate, '2026-11-09');
+});
+
+test('NET30 handles year boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-10',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(result.value.dueDate, '2027-01-09');
+});
+
+test('EOM due date is last day of issue month', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('EOM with issue date on last day of month', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-31',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('EOM with issue date on first day of month', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('EOM in February non-leap year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-14',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2026-02-28');
+});
+
+test('EOM in February leap year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-14',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2024-02-29');
+});
+
+test('EOM in month with 31 days', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2026-01-31');
+});
+
+test('EOM in month with 30 days', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-04-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2026-04-30');
+});
+
+test('EOM at year boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.value.dueDate, '2026-12-31');
+});
+
+test('invoice has dueDate field on creation', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(typeof result.value.dueDate, 'string');
+  assert.match(result.value.dueDate, /^\d{4}-\d{2}-\d{2}$/);
+});
+
+test('terms are preserved after issuing invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const invoice = draftResult.value;
+  assert.equal(invoice.terms, 'NET14');
+  assert.equal(invoice.dueDate, '2026-10-21');
+});
+
+test('different terms give different due dates for same issue date', () => {
+  const net14 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const net30 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  const eom = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.notEqual(net14.value.dueDate, net30.value.dueDate);
+  assert.notEqual(net30.value.dueDate, eom.value.dueDate);
+  assert.notEqual(net14.value.dueDate, eom.value.dueDate);
+});
+
+test('terms validation happens before other validations', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+    terms: 'INVALID',
+  });
+
+  assert.equal(result.error, 'TERMS_INVALID');
+});
