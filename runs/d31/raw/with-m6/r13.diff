+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ code: string, amount: number }} voucherToApply
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, voucherToApply) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if voucher already exists
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  const { code, amount } = voucherToApply;
+
+  // Validate amount
+  if (!isValidAmount(amount)) return fail('AMOUNT_INVALID');
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
