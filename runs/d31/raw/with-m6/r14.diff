+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement with outstanding invoices.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate: string, lines: Array, status: string, payments?: Array, voucher?: { amount: number } }>} invoices
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  const normalizedCustomerId = normalizeId(customerId);
+
+  // Validate customer exists
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer with issued/partially_paid status and issueDate <= asOf
+  const relevantInvoices = invoices.filter(
+    (inv) =>
+      normalizeId(inv.customerId) === normalizedCustomerId &&
+      (inv.status === 'issued' || inv.status === 'partially_paid') &&
+      inv.issueDate <= asOf &&
+      inv.number,
+  );
+
+  // Map invoices to statement format and sort by issueDate
+  const statementInvoices = relevantInvoices
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: calculateTotal(inv),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
+
+/**
+ * Calculate the total for an invoice (used internally).
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { amount: number }, payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+function calculateTotal(invoice) {
+  // Calculate using the same logic as invoiceTotals
+  const subtotal = invoice.lines.reduce((sum, line) => sum + line.qty * line.unitPrice, 0);
+
+  const discount = invoice.lines.reduce((sum, line) => {
+    const total = line.qty * line.unitPrice;
+    const discountPercent = line.discountPercent ?? 0;
+    return sum + Math.round(total * discountPercent / 100);
+  }, 0);
+
+  const vat = invoice.lines.reduce((sum, line) => {
+    const total = line.qty * line.unitPrice;
+    const discountPercent = line.discountPercent ?? 0;
+    const lineDiscount = Math.round(total * discountPercent / 100);
+    const amountAfterDiscount = total - lineDiscount;
+    return sum + Math.round(amountAfterDiscount * line.vatRate / 100);
+  }, 0);
+
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  return Math.max(0, subtotal - discount + vat - voucher);
+}
