+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+function createAndIssueInvoice(customerId, issueDate) {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  if (!result.ok) throw new Error(`Failed to create invoice: ${result.error}`);
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`Failed to issue invoice: ${issued.error}`);
+  return issued.value;
+}
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoices = [];
+  const result = statement('C-999', invoices, '2026-10-07');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement returns empty list for customer with no invoices', () => {
+  const result = statement('C-001', [], '2026-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement filters to issued invoices only', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const invoices = [draft.value, issued];
+  const result = statement('C-001', invoices, '2026-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, issued.number);
+});
+
+test('statement filters to partially_paid invoices', () => {
+  const issued = createAndIssueInvoice('C-001', '2026-10-07');
+  const paid = recordPayment(issued, { amount: 1000, date: '2026-10-08' }).value;
+
+  const invoices = [paid];
+  const result = statement('C-001', invoices, '2026-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, result.value.totalDue);
+});
+
+test('statement filters by asOf date', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-05');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-10');
+  const invoice3 = createAndIssueInvoice('C-001', '2026-10-15');
+
+  const invoices = [invoice1, invoice2, invoice3];
+  const result = statement('C-001', invoices, '2026-10-10');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-10');
+});
+
+test('statement excludes future invoices', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-20');
+
+  const invoices = [invoice1, invoice2];
+  const result = statement('C-001', invoices, '2026-10-10');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-15');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-05');
+  const invoice3 = createAndIssueInvoice('C-001', '2026-10-10');
+
+  const invoices = [invoice1, invoice2, invoice3];
+  const result = statement('C-001', invoices, '2026-10-20');
+
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-10');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement includes invoice number', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-10-07');
+
+  assert.equal(result.value.invoices[0].number, invoice.number);
+});
+
+test('statement includes issueDate', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-10-07');
+
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement includes dueDate', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-10-07');
+
+  assert.equal(result.value.invoices[0].dueDate, invoice.dueDate);
+});
+
+test('statement includes total', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-10-07');
+
+  assert.ok(result.value.invoices[0].total > 0);
+  assert.equal(typeof result.value.invoices[0].total, 'number');
+});
+
+test('statement includes due (balance due)', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-10-07');
+
+  assert.equal(result.value.invoices[0].due, result.value.invoices[0].total);
+});
+
+test('statement calculates due from partially_paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const paid = recordPayment(invoice, { amount: 5000, date: '2026-10-08' }).value;
+
+  const result = statement('C-001', [paid], '2026-10-07');
+
+  assert.ok(result.value.invoices[0].due < result.value.invoices[0].total);
+  assert.equal(result.value.invoices[0].due, result.value.invoices[0].total - 5000);
+});
+
+test('statement calculates totalDue as sum of due amounts', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-05');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-10');
+
+  const result = statement('C-001', [invoice1, invoice2], '2026-10-20');
+
+  const expectedTotal = result.value.invoices[0].due + result.value.invoices[1].due;
+  assert.equal(result.value.totalDue, expectedTotal);
+});
+
+test('statement handles customer ID normalization', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const result = statement('  c-001  ', [invoice], '2026-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement filters only specified customer', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const invoice2 = createAndIssueInvoice('C-002', '2026-10-07');
+
+  const result = statement('C-001', [invoice1, invoice2], '2026-10-07');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice1.number);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = statement('C-001', [draft], '2026-10-07');
+
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement with multiple invoices and payments', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-05');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-10');
+
+  const paid1 = recordPayment(invoice1, { amount: 2000, date: '2026-10-06' }).value;
+  const paid2 = recordPayment(invoice2, { amount: 5000, date: '2026-10-11' }).value;
+
+  const result = statement('C-001', [paid1, paid2], '2026-10-20');
+
+  assert.equal(result.value.invoices.length, 2);
+  assert.ok(result.value.invoices[0].due > 0);
+  assert.ok(result.value.invoices[1].due > 0);
+  assert.equal(
+    result.value.totalDue,
+    result.value.invoices[0].due + result.value.invoices[1].due
+  );
+});
+
+test('statement includes invoices with exact asOf date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-10-07');
+
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-08');
+  const result = statement('C-001', [invoice], '2026-10-07');
+
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes fully paid invoices', () => {
+  const inv = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [inv], '2026-10-07');
+  const total = result.value.invoices[0].total;
+  const fullyPaid = recordPayment(inv, { amount: total, date: '2026-10-08' }).value;
+
+  const resultFinal = statement('C-001', [fullyPaid], '2026-10-10');
+
+  assert.equal(resultFinal.value.invoices.length, 0);
+  assert.equal(resultFinal.value.totalDue, 0);
+});
+
+test('statement returns customerId in result', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-10-07');
+
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement with vouchers calculates correct total', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const withVoucher = applyVoucher(draft, { code: 'PROMO', amount: 1000 }).value;
+  const issued = issueInvoice(withVoucher, []).value;
+
+  const result = statement('C-001', [issued], '2026-10-07');
+
+  assert.ok(result.value.invoices[0].total > 0);
+});
+
+test('statement handles large number of invoices', () => {
+  const invoices = [];
+  for (let i = 0; i < 100; i++) {
+    const date = `2026-10-${String(1 + (i % 31)).padStart(2, '0')}`;
+    if (date <= '2026-10-31') {
+      invoices.push(createAndIssueInvoice('C-001', date));
+    }
+  }
+
+  const result = statement('C-001', invoices, '2026-10-31');
+
+  assert.ok(result.value.invoices.length > 0);
+  assert.equal(result.value.invoices.length, invoices.length);
+});
