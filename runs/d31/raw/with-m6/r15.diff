+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next available credit note number for a given issue date.
+ * Credit note numbers are CN-<year>-<counter> where counter resets each year (0001-9999).
+ * @param {string[]} existingNumbers - Array of previously issued invoice/credit note numbers
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `CN-${year}-`;
+
+  // Find all credit note numbers for this year and extract their counters
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return Number(counter);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  // Find the next counter
+  const nextCounter = Math.max(0, ...countersThisYear) + 1;
+
+  // Format with 4 digits zero-padded
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Check if an amount is a positive integer (in cents).
+ * @param {unknown} amount
+ * @returns {boolean}
+ */
+function isValidAmount(amount) {
+  return Number.isInteger(amount) && amount > 0;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array, voucher?: { amount: number }, payments?: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {string[]} existingNumbers - Array of previously issued invoice/credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, creditData, existingNumbers) {
+  const { amount, reason, date } = creditData;
+
+  // Check if invoice is issued/partially_paid/paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!isValidAmount(amount)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate invoice total
+  const { total } = invoiceTotals(invoice);
+
+  // Check if credit is too high
+  if (amount > total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const creditNoteNumber = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number: creditNoteNumber,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
