diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..3b8810d
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,378 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+function createAndIssueInvoice(customerId) {
+  const result = createInvoice({
+    customerId,
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  if (!result.ok) throw new Error(`Failed to create invoice: ${result.error}`);
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`Failed to issue invoice: ${issued.error}`);
+  return issued.value;
+}
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Defective product', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number.startsWith('CN-'), true);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Defective product');
+  assert.equal(result.value.date, '2026-10-10');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = createCreditNote(
+    draft,
+    { amount: 5000, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote accepts partially_paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const paid = recordPayment(invoice, { amount: 1000, date: '2026-10-08' }).value;
+
+  const result = createCreditNote(
+    paid,
+    { amount: 2000, reason: 'Partial refund', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote accepts paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const { total } = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: total, date: '2026-10-08' }).value;
+
+  const result = createCreditNote(
+    paid,
+    { amount: 5000, reason: 'Full refund', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const result = createCreditNote(
+    invoice,
+    { amount: 0, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const result = createCreditNote(
+    invoice,
+    { amount: -5000, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const result = createCreditNote(
+    invoice,
+    { amount: 50.5, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const { total } = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: total + 1, reason: 'Too much', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote accepts amount equal to invoice total', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const { total } = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: total, reason: 'Full refund', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, total);
+});
+
+test('credit note number includes CN prefix', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.match(result.value.number, /^CN-\d{4}-\d{4}$/);
+});
+
+test('credit note number includes year from date', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.match(result.value.number, /^CN-2026-/);
+});
+
+test('credit note number increments', () => {
+  const invoice1 = createAndIssueInvoice('C-001');
+  const invoice2 = createAndIssueInvoice('C-001');
+
+  const result1 = createCreditNote(
+    invoice1,
+    { amount: 1000, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  const result2 = createCreditNote(
+    invoice2,
+    { amount: 2000, reason: 'Test', date: '2026-10-10' },
+    [result1.value.number]
+  );
+
+  assert.notEqual(result1.value.number, result2.value.number);
+});
+
+test('credit note numbers reset per year', () => {
+  const invoice1 = createAndIssueInvoice('C-001');
+  const invoice2 = createAndIssueInvoice('C-001');
+
+  const result1 = createCreditNote(
+    invoice1,
+    { amount: 1000, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  const result2 = createCreditNote(
+    invoice2,
+    { amount: 2000, reason: 'Test', date: '2027-10-10' },
+    [result1.value.number]
+  );
+
+  const year1 = result1.value.number.split('-')[1];
+  const year2 = result2.value.number.split('-')[1];
+
+  assert.equal(year1, '2026');
+  assert.equal(year2, '2027');
+  assert.match(result2.value.number, /^CN-2027-0001$/);
+});
+
+test('credit note with mixed invoice and credit note numbers', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Test', date: '2026-10-10' },
+    ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001']
+  );
+
+  assert.match(result.value.number, /^CN-2026-0002$/);
+});
+
+test('createCreditNote preserves reason', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const reason = 'Customer requested full refund due to quality issues';
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason, date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.value.reason, reason);
+});
+
+test('createCreditNote preserves customerId', () => {
+  const invoice = createAndIssueInvoice('C-003');
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.value.customerId, 'C-003');
+});
+
+test('createCreditNote with voucher on invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const withVoucher = applyVoucher(draft, { code: 'PROMO', amount: 5000 }).value;
+  const issued = issueInvoice(withVoucher, []).value;
+
+  const { total } = invoiceTotals(issued);
+  const result = createCreditNote(
+    issued,
+    { amount: Math.floor(total / 2), reason: 'Partial', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote with discount on invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const { total } = invoiceTotals(issued);
+
+  const result = createCreditNote(
+    issued,
+    { amount: Math.floor(total / 2), reason: 'Partial', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
+
+test('credit note stores invoice number', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.match(result.value.invoiceNumber, /^INV-/);
+});
+
+test('credit note stores date', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const creditDate = '2026-10-15';
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Test', date: creditDate },
+    []
+  );
+
+  assert.equal(result.value.date, creditDate);
+});
+
+test('multiple credit notes for same invoice', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const { total } = invoiceTotals(invoice);
+
+  const result1 = createCreditNote(
+    invoice,
+    { amount: Math.floor(total / 3), reason: 'First', date: '2026-10-10' },
+    []
+  );
+
+  const result2 = createCreditNote(
+    invoice,
+    { amount: Math.floor(total / 3), reason: 'Second', date: '2026-10-11' },
+    [result1.value.number]
+  );
+
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  assert.notEqual(result1.value.number, result2.value.number);
+});
+
+test('createCreditNote with large invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: Array.from({ length: 50 }, (_, i) => ({
+      sku: 'DES-HOUR',
+      qty: 10 + i,
+    })),
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const { total } = invoiceTotals(issued);
+
+  const result = createCreditNote(
+    issued,
+    { amount: Math.floor(total / 2), reason: 'Partial', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
+
+test('credit note amount is in cents', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const { total } = invoiceTotals(invoice);
+  const creditAmount = Math.floor(total / 2);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: creditAmount, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.value.amount, creditAmount);
+});
+
+test('credit note with small amount', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const result = createCreditNote(
+    invoice,
+    { amount: 1, reason: 'Test', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 1);
+});
