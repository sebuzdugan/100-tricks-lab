+++ b/test/reports.test.js
@@ -0,0 +1,241 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+function createAndIssueInvoice(customerId, issueDate, terms = 'NET30') {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    terms,
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  if (!result.ok) throw new Error(`Failed to create invoice: ${result.error}`);
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`Failed to issue invoice: ${issued.error}`);
+  return issued.value;
+}
+
+test('overdueInvoices returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2026-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = overdueInvoices([invoice], '2026-10-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices includes single overdue invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].number, invoice.number);
+});
+
+test('overdueInvoices returns invoice number', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.match(result.value[0].number, /^INV-/);
+});
+
+test('overdueInvoices returns customerId', () => {
+  const invoice = createAndIssueInvoice('C-002', '2026-09-01');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.equal(result.value[0].customerId, 'C-002');
+});
+
+test('overdueInvoices returns dueDate', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.equal(result.value[0].dueDate, invoice.dueDate);
+});
+
+test('overdueInvoices calculates daysOverdue', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.ok(result.value[0].daysOverdue > 0);
+  assert.equal(typeof result.value[0].daysOverdue, 'number');
+});
+
+test('overdueInvoices calculates exact daysOverdue', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  const daysOverdue = result.value[0].daysOverdue;
+  assert.equal(daysOverdue, 6);
+});
+
+test('overdueInvoices returns due amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.ok(result.value[0].due > 0);
+  assert.equal(typeof result.value[0].due, 'number');
+});
+
+test('overdueInvoices calculates due for issued invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const { total } = invoiceTotals(invoice);
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.equal(result.value[0].due, total);
+});
+
+test('overdueInvoices calculates due for partially_paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const paid = recordPayment(invoice, { amount: 5000, date: '2026-09-05' }).value;
+  const result = overdueInvoices([paid], '2026-10-07');
+
+  const { total } = invoiceTotals(invoice);
+  assert.equal(result.value[0].due, total - 5000);
+});
+
+test('overdueInvoices filters out draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    terms: 'NET30',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = overdueInvoices([draft], '2026-10-07');
+
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices filters out paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const { total } = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: total, date: '2026-09-05' }).value;
+
+  const result = overdueInvoices([paid], '2026-10-07');
+
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes invoice due on asOf date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-07');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices sorts by most overdue first', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-08-25');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-09-01');
+  const invoice3 = createAndIssueInvoice('C-001', '2026-09-06');
+
+  const result = overdueInvoices([invoice1, invoice2, invoice3], '2026-10-07');
+
+  assert.equal(result.value.length, 3);
+  assert.ok(result.value[0].daysOverdue > result.value[1].daysOverdue);
+  assert.ok(result.value[1].daysOverdue > result.value[2].daysOverdue);
+});
+
+test('overdueInvoices handles multiple customers', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-09-01');
+  const invoice2 = createAndIssueInvoice('C-002', '2026-09-05');
+
+  const result = overdueInvoices([invoice1, invoice2], '2026-10-07');
+
+  assert.equal(result.value.length, 2);
+  assert.equal(result.value[0].customerId, 'C-001');
+  assert.equal(result.value[1].customerId, 'C-002');
+});
+
+test('overdueInvoices with multiple payments on invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-01');
+  const paid1 = recordPayment(invoice, { amount: 2000, date: '2026-09-05' }).value;
+  const paid2 = recordPayment(paid1, { amount: 3000, date: '2026-09-10' }).value;
+
+  const result = overdueInvoices([paid2], '2026-10-07');
+
+  const { total } = invoiceTotals(invoice);
+  assert.equal(result.value[0].due, total - 5000);
+});
+
+test('overdueInvoices with NET14 terms', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-20', 'NET14');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.equal(result.value.length, 1);
+  assert.ok(result.value[0].daysOverdue > 0);
+});
+
+test('overdueInvoices with EOM terms', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-15', 'EOM');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.equal(result.value.length, 1);
+});
+
+test('overdueInvoices with large number of invoices', () => {
+  const invoices = [];
+  for (let i = 1; i <= 50; i++) {
+    const date = `2026-${String(8 + Math.floor((i - 1) / 25)).padStart(2, '0')}-${String((i % 25) + 1).padStart(2, '0')}`;
+    invoices.push(createAndIssueInvoice('C-001', date));
+  }
+
+  const result = overdueInvoices(invoices, '2026-10-07');
+
+  assert.ok(result.value.length > 0);
+  assert.ok(result.value.length < invoices.length);
+});
+
+test('overdueInvoices with mixed issued and partially_paid', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-09-01');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-09-06');
+  const paid2 = recordPayment(invoice2, { amount: 1000, date: '2026-09-15' }).value;
+
+  const result = overdueInvoices([invoice1, paid2], '2026-10-07');
+
+  assert.equal(result.value.length, 2);
+  assert.equal(result.value[0].number, invoice1.number);
+});
+
+test('overdueInvoices excludes invoices without number', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = overdueInvoices([draft], '2026-10-07');
+
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices with daysOverdue exactly 1', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-09-06');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].daysOverdue, 1);
+});
+
+test('overdueInvoices with daysOverdue very large', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-01-01');
+  const result = overdueInvoices([invoice], '2026-10-07');
+
+  assert.ok(result.value[0].daysOverdue > 200);
+});
