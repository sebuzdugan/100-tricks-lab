 function daysBetween(startDate, endDate) {
   const start = new Date(startDate + 'T00:00:00Z');
@@ -27,3 +28,33 @@ export function overdueInvoices(invoices, asOf) {
 
   return ok(overdue);
 }
+
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    if (!invoice.lines) continue;
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const total = lineTotal(line);
+      const discount = lineDiscount(line);
+      const base = total - discount;
+      const vat = lineVat(line);
+
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      vatByRate[rate].base += base;
+      vatByRate[rate].vat += vat;
+    }
+  }
+
+  const result = Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
+  return ok(result);
+}
