+++ b/src/reports.js
@@ -58,3 +58,23 @@ export function vatSummary(invoices) {
   const result = Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
   return ok(result);
 }
+
+export function lateFee(invoice, asOf) {
+  if (!invoice.dueDate || !invoice.status) {
+    return 0;
+  }
+
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return 0;
+  }
+
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = Math.round(due * 0.0004 * daysOverdue);
+
+  return Math.max(0, fee);
+}
