+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+function createAndIssueInvoice(customerId, issueDate = '2026-10-07') {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  if (!result.ok) throw new Error(`Failed to create invoice: ${result.error}`);
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`Failed to issue invoice: ${issued.error}`);
+  return issued.value;
+}
+
+test('exportCsv returns string', () => {
+  const csv = exportCsv([]);
+
+  assert.equal(typeof csv, 'string');
+});
+
+test('exportCsv includes header line', () => {
+  const csv = exportCsv([]);
+
+  assert.ok(csv.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv starts with header', () => {
+  const csv = exportCsv([]);
+
+  assert.ok(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv returns empty with no invoices', () => {
+  const csv = exportCsv([]);
+
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes single invoice', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes(invoice.number));
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv includes issue date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes('2026-10-07'));
+});
+
+test('exportCsv includes due date', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes(invoice.dueDate));
+});
+
+test('exportCsv includes status', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes('issued'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const { total } = invoiceTotals(invoice);
+  const euros = (total / 100).toFixed(2);
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes(euros));
+});
+
+test('exportCsv uses dot as decimal separator', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const total = parts[8];
+
+  assert.ok(total.includes('.'));
+});
+
+test('exportCsv has no currency sign', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(!csv.includes('€'));
+  assert.ok(!csv.includes('$'));
+});
+
+test('exportCsv has no thousands separator', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(!csv.includes(',000'));
+});
+
+test('exportCsv lines end with newline', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.endsWith('\n'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-09-01');
+  const invoice2 = createAndIssueInvoice('C-002', '2026-09-15');
+  const invoice3 = createAndIssueInvoice('C-001', '2026-10-01');
+
+  const csv = exportCsv([invoice1, invoice2, invoice3]);
+  const lines = csv.split('\n');
+
+  assert.ok(lines[1].includes(invoice1.number));
+  assert.ok(lines[2].includes(invoice2.number));
+  assert.ok(lines[3].includes(invoice3.number));
+});
+
+test('exportCsv skips draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const csv = exportCsv([draft]);
+
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv skips invoices without number', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const csv = exportCsv([draft]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv handles multiple invoices', () => {
+  const invoice1 = createAndIssueInvoice('C-001');
+  const invoice2 = createAndIssueInvoice('C-002');
+
+  const csv = exportCsv([invoice1, invoice2]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines.length, 4);
+});
+
+test('exportCsv escapes customer names with commas', () => {
+  const invoice = createAndIssueInvoice('C-004');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes('"'));
+});
+
+test('exportCsv escapes fields with double quotes', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const csv = exportCsv([issued]);
+
+  assert.equal(typeof csv, 'string');
+});
+
+test('exportCsv with paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const { total } = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: total, date: '2026-10-08' }).value;
+
+  const csv = exportCsv([paid]);
+
+  assert.ok(csv.includes('0.00'));
+});
+
+test('exportCsv with partially paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const paid = recordPayment(invoice, { amount: 5000, date: '2026-10-08' }).value;
+
+  const csv = exportCsv([paid]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const due = parts[9];
+
+  assert.ok(Number(due) > 0);
+});
+
+test('exportCsv includes subtotal field', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  assert.equal(parts.length, 10);
+});
+
+test('exportCsv includes discount field', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const discount = parts[6];
+  assert.ok(discount);
+});
+
+test('exportCsv includes vat field', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const vat = parts[7];
+
+  assert.ok(vat);
+});
+
+test('exportCsv includes total field', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const total = parts[8];
+
+  assert.ok(total);
+});
+
+test('exportCsv includes due field', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const due = parts[9];
+
+  assert.ok(due);
+});
+
+test('exportCsv amounts are non-negative', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  const subtotal = Number(parts[5]);
+  const discount = Number(parts[6]);
+  const vat = Number(parts[7]);
+  const total = Number(parts[8]);
+  const due = Number(parts[9]);
+
+  assert.ok(subtotal >= 0);
+  assert.ok(discount >= 0);
+  assert.ok(vat >= 0);
+  assert.ok(total >= 0);
+  assert.ok(due >= 0);
+});
+
+test('exportCsv with voucher', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const withVoucher = applyVoucher(draft, { code: 'PROMO', amount: 5000 }).value;
+  const issued = issueInvoice(withVoucher, []).value;
+
+  const csv = exportCsv([issued]);
+
+  assert.ok(csv.includes(issued.number));
+});
+
+test('exportCsv with large amount', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: Array.from({ length: 50 }, () => ({ sku: 'DES-HOUR', qty: 100 })),
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const csv = exportCsv([issued]);
+
+  assert.ok(csv.includes(issued.number));
+});
+
+test('exportCsv each line has correct number of fields', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  for (let i = 0; i < lines.length - 1; i++) {
