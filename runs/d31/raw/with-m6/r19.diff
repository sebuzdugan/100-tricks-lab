+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes('2026-10-07'));
+});
+
+test('exportCsv status values', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.includes('issued'));
+});
+
+test('exportCsv properly formats decimal amounts', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+
+  const parts = dataLine.split(',');
+  const subtotal = parts[5];
+
+  assert.match(subtotal, /^\d+\.\d{2}$/);
+});
+
+test('exportCsv with multiple payment records', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const paid1 = recordPayment(invoice, { amount: 2000, date: '2026-10-08' }).value;
+  const paid2 = recordPayment(paid1, { amount: 2000, date: '2026-10-09' }).value;
+
+  const csv = exportCsv([paid2]);
+
+  assert.ok(csv.includes(invoice.number));
+});
+
+test('exportCsv final line ends with newline', () => {
+  const invoice = createAndIssueInvoice('C-001');
+  const csv = exportCsv([invoice]);
+
+  assert.ok(csv.endsWith('\n'));
+});
+
+test('exportCsv escapes commas in customer name', () => {
+  const invoice = createAndIssueInvoice('C-004');
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+
+  assert.ok(dataLine.includes('"'));
+});
