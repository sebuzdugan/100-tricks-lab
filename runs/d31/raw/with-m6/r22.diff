+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 };
+  assert.equal(lineTotal(line), 47500);
+});
+
+test('lineTotal works for qty of 1', () => {
+  const line = { sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 };
+  assert.equal(lineTotal(line), 120000);
+});
+
+test('lineTotal works for large quantities', () => {
+  const line = { sku: 'PRINT-A4', name: 'Printed flyer A4 (each)', qty: 10000, unitPrice: 37, vatRate: 9 };
+  assert.equal(lineTotal(line), 370000);
+});
+
+test('lineDiscount calculates discount amount', () => {
+  const line = { qty: 100, unitPrice: 10000, discountPercent: 10, vatRate: 21 };
+  assert.equal(lineDiscount(line), 100000);
+});
+
+test('lineDiscount with zero discount', () => {
+  const line = { qty: 10, unitPrice: 5000, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 10, unitPrice: 5000, discountPercent: 100, vatRate: 21 };
+  assert.equal(lineDiscount(line), 50000);
+});
+
+test('lineDiscount with decimal discount percent', () => {
+  const line = { qty: 100, unitPrice: 10000, discountPercent: 5.5, vatRate: 21 };
+  assert.equal(lineDiscount(line), 55000);
+});
+
+test('lineDiscount rounds to cents', () => {
+  const line = { qty: 3, unitPrice: 10000, discountPercent: 15, vatRate: 21 };
+  const discount = lineDiscount(line);
+  assert.equal(discount, 4500);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 10000, discountPercent: 10, vatRate: 21 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  const expectedVat = Math.round(amountAfterDiscount * 21 / 100);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat with 21% VAT rate', () => {
+  const line = { qty: 10, unitPrice: 10000, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineVat(line), Math.round(100000 * 21 / 100));
+});
+
+test('lineVat with 9% VAT rate', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 9 };
+  assert.equal(lineVat(line), Math.round(100000 * 9 / 100));
+});
+
+test('lineVat with 0% VAT rate (exempt)', () => {
+  const line = { qty: 10, unitPrice: 10000, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat rounds per line', () => {
+  const line = { qty: 3, unitPrice: 1000, discountPercent: 0, vatRate: 21 };
+  const vat = lineVat(line);
+  assert.ok(Number.isInteger(vat));
+});
+
+test('invoiceTotals sums all line totals', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 2, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 19000 + 120000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, Math.round(139000 * 21 / 100));
+  assert.equal(totals.total, 139000 + Math.round(139000 * 21 / 100));
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 3, unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 28500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, Math.round(28500 * 21 / 100));
+  assert.equal(totals.total, 28500 + Math.round(28500 * 21 / 100));
+});
+
+test('invoiceTotals with multiple lines and different VAT rates', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+      { sku: 'PRINT-A4', name: 'Printed flyer A4 (each)', qty: 100, unitPrice: 37, vatRate: 9, discountPercent: 0 },
+      { sku: 'WORKSHOP-DAY', name: 'Brand workshop (day, VAT exempt)', qty: 1, unitPrice: 60000, vatRate: 0, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 9500 + 3700 + 60000);
+  assert.equal(totals.discount, 0);
+  const vat = Math.round(9500 * 21 / 100) + Math.round(3700 * 9 / 100) + 0;
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, 73200 + vat);
+});
+
+test('invoiceTotals does not mutate the invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 2, unitPrice: 9500, vatRate: 21 }],
+  };
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+  invoiceTotals(invoice);
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('invoiceTotals with no discount or VAT equals subtotal', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 0, discountPercent: 0 },
+      { sku: 'SUPPORT-HOUR', name: 'Support (hour)', qty: 10, unitPrice: 7250, vatRate: 0, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, totals.total);
+  assert.equal(totals.vat, 0);
+});
+
+test('invoiceTotals with single line with discount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 10000, vatRate: 21, discountPercent: 10 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  const vat = Math.round((100000 - 10000) * 21 / 100);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, 100000 - 10000 + vat);
+});
+
+test('invoiceTotals with multiple lines with different discounts', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 10000, vatRate: 21, discountPercent: 10 },
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 5, unitPrice: 20000, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const discount1 = Math.round(100000 * 10 / 100);
+  const discount2 = Math.round(100000 * 5 / 100);
+  const vat1 = Math.round((100000 - discount1) * 21 / 100);
+  const vat2 = Math.round((100000 - discount2) * 21 / 100);
+  assert.equal(totals.subtotal, 200000);
+  assert.equal(totals.discount, discount1 + discount2);
+  assert.equal(totals.vat, vat1 + vat2);
+  assert.equal(totals.total, 200000 - (discount1 + discount2) + (vat1 + vat2));
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 10000, vatRate: 21, discountPercent: 20 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const expectedDiscount = Math.round(50000 * 20 / 100);
+  const expectedVat = Math.round((50000 - expectedDiscount) * 21 / 100);
+  assert.equal(totals.subtotal, 50000);
+  assert.equal(totals.discount, expectedDiscount);
+  assert.equal(totals.vat, expectedVat);
+  assert.equal(totals.total, 50000 - expectedDiscount + expectedVat);
+});
+
+test('invoiceTotals VAT with multiple lines different rates', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 5000, vatRate: 21, discountPercent: 0 },
+      { sku: 'PRINT-A4', name: 'Printed flyer A4 (each)', qty: 100, unitPrice: 200, vatRate: 9, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const vat1 = Math.round(50000 * 21 / 100);
+  const vat2 = Math.round(20000 * 9 / 100);
+  assert.equal(totals.vat, vat1 + vat2);
+});
+
+test('invoiceTotals VAT with discount reduces VAT base', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 10000, vatRate: 21, discountPercent: 50 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 100000;
+  const discount = Math.round(subtotal * 50 / 100);
+  const expectedVat = Math.round((subtotal - discount) * 21 / 100);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.vat, expectedVat);
+  assert.ok(totals.vat < Math.round(subtotal * 21 / 100));
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 10000, vatRate: 21, discountPercent: 0 }],
+    voucher: { code: 'PROMO', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  const vat = Math.round(100000 * 21 / 100);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 100000 + vat - 5000);
+});
+
+test('invoiceTotals with voucher zero amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 }],
+    voucher: { code: 'NOPROMO', amount: 0 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals without voucher has voucher zero', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals total never goes negative', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 100, vatRate: 0, discountPercent: 0 }],
