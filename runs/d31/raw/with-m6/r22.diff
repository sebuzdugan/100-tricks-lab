+
+test('invoiceTotals returns all required fields', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
+
+test('lineTotal works with decimal values in calculation', () => {
+  const line = { qty: 3, unitPrice: 33333, vatRate: 21 };
+  assert.equal(lineTotal(line), 99999);
+});
+
+test('lineDiscount handles missing discountPercent', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVat handles missing discountPercent', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21 };
+  const vat = lineVat(line);
+  assert.equal(vat, Math.round(100000 * 21 / 100));
+});
