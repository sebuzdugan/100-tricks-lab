+/**
+ * Dashboard with aggregated invoice metrics.
+ * @param {Array} invoices
+ * @param {string} asOf - Date to calculate overdue from
+ * @returns {{ counts: { draft, issued, partially_paid, paid }, outstanding: number, overdue: { count, amount }, topCustomers: Array<{ customerId, due }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = {};
+
+  for (const invoice of invoices) {
+    if (invoice.status in counts) {
+      counts[invoice.status]++;
+    }
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDue[invoice.customerId]) {
+        customerDue[invoice.customerId] = 0;
+      }
+      customerDue[invoice.customerId] += due;
+    }
+  }
+
+  const overdueResult = overdueInvoices(invoices, asOf);
+  const overdueList = overdueResult.ok ? overdueResult.value : [];
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
