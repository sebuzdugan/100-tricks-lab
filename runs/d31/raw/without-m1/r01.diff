@@ -0,0 +1,62 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  const regex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!regex.test(dateStr)) return false;
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const iso = date.toISOString().split('T')[0];
+  return iso === dateStr;
+}
+
+/**
+ * Create a draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {import('./result.js').Result<{ customerId: string, issueDate: string, status: 'draft', lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }>}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate date
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  // Validate lines
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  // Process each line
+  const processedLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Validate SKU and get product details
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    processedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: processedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
