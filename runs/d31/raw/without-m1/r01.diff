+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with product details from catalogue', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }, { sku: 'ICON-SET', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 8500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+  assert.equal(r.value.lines[1].sku, 'ICON-SET');
+  assert.equal(r.value.lines[1].name, 'Icon set (24 icons)');
+  assert.equal(r.value.lines[1].qty, 2);
+  assert.equal(r.value.lines[1].unitPrice, 980);
+  assert.equal(r.value.lines[1].vatRate, 21);
+});
+
+test('createInvoice with VAT-exempt product', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].vatRate, 0);
+});
+
+test('createInvoice fails with CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice fails with DATE_INVALID for invalid date format', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '07/10/2026',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice fails with DATE_INVALID for non-existent date', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-02-30',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice fails with DATE_INVALID for incomplete date', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice fails with NO_LINES for empty lines array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice fails with NO_LINES for null/undefined lines', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: null,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice fails with QTY_INVALID for zero quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 0 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice fails with QTY_INVALID for negative quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: -1 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice fails with QTY_INVALID for fractional quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice fails with UNKNOWN_SKU for invalid SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'INVALID-SKU', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice returns error on first invalid line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'INVALID-SKU', qty: 1 },
+      { sku: 'ICON-SET', qty: 1 },
+    ],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  };
+  const inputCopy = JSON.parse(JSON.stringify(input));
+  createInvoice(input);
+  assert.deepEqual(input, inputCopy);
+});
+
+test('createInvoice accepts valid dates in YYYY-MM-DD format', () => {
+  const validDates = ['2020-01-01', '2026-10-07', '2050-12-31', '2000-02-29'];
+  for (const date of validDates) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(r.ok, true, `Date ${date} should be valid`);
+  }
+});
