+/**
+ * Calculate the total for a single line.
+ * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }} line
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  return { subtotal, total: subtotal };
+}
