index 0000000..ac02abb
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,21 @@
+/**
+ * Get the next available invoice number for a given year.
+ * @param {Array<string>} existingNumbers - Invoice numbers already in use (e.g., ["INV-2026-0001", "INV-2026-0003"])
+ * @param {string} issueDate - Invoice date in YYYY-MM-DD format
+ * @returns {string} The next available invoice number for that year
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+
+  const numbersForYear = existingNumbers
+    .filter((num) => num.startsWith(`INV-${year}-`))
+    .map((num) => {
+      const counter = num.substring(`INV-${year}-`.length);
+      return Number(counter);
+    });
+
+  const maxCounter = numbersForYear.length > 0 ? Math.max(...numbersForYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
