diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..75f7339
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,54 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber with no existing numbers starts at 0001', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2026-0001'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber with multiple existing numbers returns max + 1', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0005', 'INV-2025-0010', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-9999', 'INV-2025-0050', 'INV-2027-0001'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = Array.from({ length: 999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber handles numbers with large counters', () => {
+  const existing = ['INV-2026-0999', 'INV-2026-9999'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber works with different date years', () => {
+  const existing = ['INV-2020-0001', 'INV-2021-0002'];
+  const num2020 = nextInvoiceNumber(existing, '2020-05-15');
+  const num2021 = nextInvoiceNumber(existing, '2021-05-15');
+  const num2022 = nextInvoiceNumber(existing, '2022-05-15');
+  assert.equal(num2020, 'INV-2020-0002');
+  assert.equal(num2021, 'INV-2021-0003');
+  assert.equal(num2022, 'INV-2022-0001');
+});
