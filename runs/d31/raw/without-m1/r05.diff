+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, issueDate: string, status: string, number?: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  const number = invoice.number ?? 'DRAFT';
+  const totals = invoiceTotals(invoice);
+
+  const lines = [];
+  lines.push(number);
+  lines.push(customerName);
+
+  for (const line of invoice.lines) {
+    const lineTotal = line.qty * line.unitPrice;
+    const qtyStr = String(line.qty);
+    const nameStr = line.name;
+    const unitPriceStr = formatEuros(line.unitPrice);
+    const lineTotalStr = formatEuros(lineTotal);
+    lines.push(`${qtyStr} ${nameStr} ${unitPriceStr} ${lineTotalStr}`);
+  }
+
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
