+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.equal(text.split('\n')[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.equal(text.split('\n')[0], 'INV-2026-0001');
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows invoice lines with quantities and prices', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '5 Design work (hour) €85.00 €425.00');
+});
+
+test('renderInvoiceText formats unit prices as euros', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 2, unitPrice: 980, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '2 Icon set (24 icons) €9.80 €19.60');
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 2, unitPrice: 980, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5);
+  assert.equal(lines[2], '5 Design work (hour) €85.00 €425.00');
+  assert.equal(lines[3], '2 Icon set (24 icons) €9.80 €19.60');
+});
+
+test('renderInvoiceText shows total at the end', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 2, unitPrice: 980, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[4], 'Total: €444.60');
+});
+
+test('renderInvoiceText with single item', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '1 Logo package €1,200.00 €1,200.00');
+  assert.equal(lines[3], 'Total: €1,200.00');
+});
+
+test('renderInvoiceText with large quantities', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'PRINT-A4', name: 'Printed flyer A4 (each)', qty: 1000, unitPrice: 37, vatRate: 9 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '1000 Printed flyer A4 (each) €0.37 €370.00');
+  assert.equal(lines[3], 'Total: €370.00');
+});
+
+test('renderInvoiceText with VAT-exempt items', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'WORKSHOP-DAY', name: 'Brand workshop (day, VAT exempt)', qty: 2, unitPrice: 60000, vatRate: 0 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '2 Brand workshop (day, VAT exempt) €600.00 €1,200.00');
+  assert.equal(lines[3], 'Total: €1,200.00');
+});
+
+test('renderInvoiceText with issued invoice and number', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0042',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0042');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '10 Development (hour) €95.00 €950.00');
+  assert.equal(lines[3], 'Total: €950.00');
+});
+
+test('renderInvoiceText with unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Unknown Customer');
+});
+
+test('renderInvoiceText returns newline-separated text', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.equal(typeof text, 'string');
+  assert.ok(text.includes('\n'));
+});
