@@ -0,0 +1,113 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid YYYY-MM-DD dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2020-01-01'), true);
+  assert.equal(isValidDate('2050-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid date formats', () => {
+  assert.equal(isValidDate('07/10/2026'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+  assert.equal(isValidDate('2025-12-32'), false);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2021-02-29'), false);
+});
+
+test('isValidDate accepts leap year Feb 29', () => {
+  assert.equal(isValidDate('2020-02-29'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 30), '2026-11-06');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+});
+
+test('addDays with zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays with negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -7), '2026-09-30');
+});
+
+test('addDays handles year boundaries backward', () => {
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('daysBetween with same date', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween with positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-11-06'), 30);
+});
+
+test('daysBetween with negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+});
+
+test('daysBetween across month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-11-01', '2026-10-31'), -1);
+});
+
+test('daysBetween across year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+});
+
+test('daysBetween returns whole days', () => {
+  // These are all the same date in UTC, so difference should be 0
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween with large date ranges', () => {
+  // From 2020-01-01 to 2026-10-07 is 2471 days
+  assert.equal(daysBetween('2020-01-01', '2026-10-07'), 2471);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const date1 = '2026-10-07';
+  const date2 = addDays(date1, 10);
+  assert.equal(daysBetween(date1, date2), 10);
+
+  const date3 = addDays(date1, -5);
+  assert.equal(daysBetween(date1, date3), -5);
+});
+
+test('isValidDate rejects strings with extra whitespace', () => {
+  assert.equal(isValidDate('2026-10-07 '), false);
+  assert.equal(isValidDate(' 2026-10-07'), false);
+  assert.equal(isValidDate('2026-10-07T00:00:00Z'), false);
+});
