+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the balance still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number, date: string }> } & any} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, number?: string, lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {import('./result.js').Result<{ customerId: string, issueDate: string, status: string, number?: string, lines: Array, payments: Array<{ amount: number, date: string }> }>}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate invoice status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Calculate balance due
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new invoice with payment recorded
+  const payments = [...(invoice.payments ?? []), { amount, date }];
+  const newBalance = balance - amount;
+
+  // Determine new status
+  let newStatus;
+  if (newBalance === 0) {
+    newStatus = 'paid';
+  } else {
+    newStatus = 'partially_paid';
+  }
+
+  return ok({
+    ...invoice,
+    payments,
+    status: newStatus,
+  });
+}
