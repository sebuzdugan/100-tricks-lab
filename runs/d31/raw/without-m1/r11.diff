+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue with no payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  // lineTotal: 42500, VAT: 8925, total: 51425
+  assert.equal(balanceDue(invoice), 51425);
+});
+
+test('balanceDue with partial payment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    payments: [{ amount: 20000, date: '2026-10-10' }],
+  };
+  // total: 51425, paid: 20000, balance: 31425
+  assert.equal(balanceDue(invoice), 31425);
+});
+
+test('balanceDue with multiple partial payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    payments: [
+      { amount: 20000, date: '2026-10-10' },
+      { amount: 15000, date: '2026-10-15' },
+    ],
+  };
+  // total: 51425, paid: 35000, balance: 16425
+  assert.equal(balanceDue(invoice), 16425);
+});
+
+test('balanceDue when fully paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    payments: [{ amount: 51425, date: '2026-10-10' }],
+  };
+  assert.equal(balanceDue(invoice), 0);
+});
+
+test('recordPayment on issued invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  const r = recordPayment(invoice, { amount: 20000, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 20000);
+  assert.equal(r.value.payments[0].date, '2026-10-10');
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment transitions to paid when fully paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  // total: 51425
+  const r = recordPayment(invoice, { amount: 51425, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    payments: [{ amount: 20000, date: '2026-10-10' }],
+  };
+  const r = recordPayment(invoice, { amount: 31425, date: '2026-10-15' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 2);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment fails with NOT_ISSUED on draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  assert.deepEqual(recordPayment(invoice, { amount: 20000, date: '2026-10-10' }), { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment fails with NOT_ISSUED on paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    payments: [{ amount: 51425, date: '2026-10-10' }],
+  };
+  assert.deepEqual(recordPayment(invoice, { amount: 100, date: '2026-10-15' }), { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment fails with AMOUNT_INVALID for zero amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  assert.deepEqual(recordPayment(invoice, { amount: 0, date: '2026-10-10' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment fails with AMOUNT_INVALID for negative amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  assert.deepEqual(recordPayment(invoice, { amount: -100, date: '2026-10-10' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment fails with AMOUNT_INVALID for fractional amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  assert.deepEqual(recordPayment(invoice, { amount: 100.5, date: '2026-10-10' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment fails with DATE_INVALID for invalid date', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  assert.deepEqual(recordPayment(invoice, { amount: 20000, date: '10/07/2026' }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('recordPayment fails with OVERPAYMENT', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  // total: 51425, trying to pay 60000
+  assert.deepEqual(recordPayment(invoice, { amount: 60000, date: '2026-10-10' }), { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment fails with OVERPAYMENT on partial payment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    payments: [{ amount: 20000, date: '2026-10-10' }],
+  };
+  // total: 51425, paid: 20000, balance: 31425, trying to pay 40000
+  assert.deepEqual(recordPayment(invoice, { amount: 40000, date: '2026-10-15' }), { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+  recordPayment(invoice, { amount: 20000, date: '2026-10-10' });
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('recordPayment preserves invoice data', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  const r = recordPayment(invoice, { amount: 20000, date: '2026-10-10' });
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.number, 'INV-2026-0001');
+  assert.equal(r.value.lines.length, 1);
+});
+
+test('recordPayment with exact balance', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    payments: [{ amount: 20000, date: '2026-10-10' }],
+  };
+  // balance: 31425, paying exactly 31425
+  const r = recordPayment(invoice, { amount: 31425, date: '2026-10-15' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+  assert.equal(balanceDue(r.value), 0);
+});
