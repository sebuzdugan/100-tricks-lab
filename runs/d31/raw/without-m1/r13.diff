+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {import('./result.js').Result<{ customerId: string, issueDate: string, status: string, lines: Array, voucher: { code: string, amount: number } }>}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
