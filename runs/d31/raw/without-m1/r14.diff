+
+test('statement respects asOf boundary', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const r1 = statement('C-001', [inv], '2026-10-07');
+  const r2 = statement('C-001', [inv], '2026-10-06');
+
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.invoices.length, 1);
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices.length, 0);
+});
