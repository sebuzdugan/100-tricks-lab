+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement with no invoices returns empty list', () => {
+  const r = statement('C-001', [], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement with unknown customer returns CUSTOMER_NOT_FOUND', () => {
+  assert.deepEqual(statement('C-999', [], '2026-12-31'), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement filters by customer', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    []
+  ).value;
+
+  const r = statement('C-001', [inv1, inv2], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, inv1.number);
+});
+
+test('statement normalizes customer ID', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const r = statement('c-001', [inv], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement filters by status', () => {
+  const draftInv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issuedInv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    []
+  ).value;
+
+  const r = statement('C-001', [draftInv, issuedInv], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, issuedInv.number);
+});
+
+test('statement filters by asOf date', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const r = statement('C-001', [inv1, inv2], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement includes partially_paid invoices', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  inv = recordPayment(inv, { amount: 10000, date: '2026-10-10' }).value;
+
+  const r = statement('C-001', [inv], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, inv.number);
+});
+
+test('statement excludes paid invoices', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  // Total is 48854 with gold tier discount
+  inv = recordPayment(inv, { amount: 48854, date: '2026-10-10' }).value;
+
+  const r = statement('C-001', [inv], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement includes invoice data', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET30',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const r = statement('C-001', [inv], '2026-12-31');
+  assert.equal(r.ok, true);
+  const stmtInv = r.value.invoices[0];
+  assert.equal(stmtInv.number, inv.number);
+  assert.equal(stmtInv.issueDate, '2026-10-07');
+  assert.equal(stmtInv.dueDate, '2026-11-06');
+  // C-001 is gold tier (5% discount): 42500 - 2125 + 8479 = 48854
+  assert.equal(stmtInv.total, 48854);
+  assert.equal(stmtInv.due, 48854);
+});
+
+test('statement calculates due correctly with partial payment', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  inv = recordPayment(inv, { amount: 20000, date: '2026-10-10' }).value;
+
+  const r = statement('C-001', [inv], '2026-12-31');
+  assert.equal(r.ok, true);
+  const stmtInv = r.value.invoices[0];
+  // C-001 is gold tier (5% discount): 42500 - 2125 + 8479 = 48854
+  assert.equal(stmtInv.total, 48854);
+  assert.equal(stmtInv.due, 28854); // 48854 - 20000
+});
+
+test('statement sorts by issueDate', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-05',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-10',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value,
+    ['INV-2026-0001', 'INV-2026-0002']
+  ).value;
+
+  const r = statement('C-001', [inv1, inv2, inv3], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[2].issueDate, '2026-10-10');
+});
+
+test('statement calculates totalDue', () => {
+  let inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  inv1 = recordPayment(inv1, { amount: 20000, date: '2026-10-10' }).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'ICON-SET', qty: 2 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const r = statement('C-001', [inv1, inv2], '2026-12-31');
+  assert.equal(r.ok, true);
+  // inv1: 48854 - 20000 = 28854 (gold tier 5% discount: 42500 - 2125 + 8479)
+  // inv2: 2253 (gold tier 5% discount: 1960 - 98 + 391)
+  assert.equal(r.value.totalDue, 28854 + 2253);
+});
+
+test('statement with multiple customers', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const r1 = statement('C-001', [inv1, inv2], '2026-12-31');
+  const r2 = statement('C-002', [inv1, inv2], '2026-12-31');
+
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.invoices.length, 1);
+  assert.equal(r1.value.invoices[0].number, inv1.number);
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices.length, 1);
+  assert.equal(r2.value.invoices[0].number, inv2.number);
