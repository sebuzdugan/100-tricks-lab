+++ b/test/credits.test.js
@@ -0,0 +1,260 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote on issued invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Service cancelled', date: '2026-10-10' }, [
+    'INV-2026-0001',
+  ]);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, invoice.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Service cancelled');
+  assert.equal(r.value.date, '2026-10-10');
+});
+
+test('createCreditNote on partially_paid invoice', () => {
+  let invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  invoice = recordPayment(invoice, { amount: 10000, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(invoice, { amount: 3000, reason: 'Discount applied', date: '2026-10-10' }, [
+    'INV-2026-0001',
+  ]);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote on paid invoice', () => {
+  let invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  // Total is 48854 with gold tier discount
+  invoice = recordPayment(invoice, { amount: 48854, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, [
+    'INV-2026-0001',
+  ]);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote fails with NOT_ISSUED for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  assert.deepEqual(createCreditNote(invoice, { amount: 5000, reason: 'Service cancelled', date: '2026-10-10' }, []), {
+    ok: false,
+    error: 'NOT_ISSUED',
+  });
+});
+
+test('createCreditNote fails with AMOUNT_INVALID for zero amount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  assert.deepEqual(createCreditNote(invoice, { amount: 0, reason: 'Service cancelled', date: '2026-10-10' }, [
+    'INV-2026-0001',
+  ]), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote fails with AMOUNT_INVALID for negative amount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  assert.deepEqual(createCreditNote(invoice, { amount: -100, reason: 'Service cancelled', date: '2026-10-10' }, [
+    'INV-2026-0001',
+  ]), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote fails with AMOUNT_INVALID for fractional amount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  assert.deepEqual(createCreditNote(invoice, { amount: 50.5, reason: 'Service cancelled', date: '2026-10-10' }, [
+    'INV-2026-0001',
+  ]), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote fails with DATE_INVALID for invalid date', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  assert.deepEqual(
+    createCreditNote(invoice, { amount: 5000, reason: 'Service cancelled', date: '10/10/2026' }, ['INV-2026-0001']),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createCreditNote fails with CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  // Invoice total is 48854 (with gold tier 5% discount)
+  assert.deepEqual(createCreditNote(invoice, { amount: 60000, reason: 'Service cancelled', date: '2026-10-10' }, [
+    'INV-2026-0001',
+  ]), { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote with exact invoice total', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  // Invoice total is 48854 (with gold tier 5% discount)
+  const r = createCreditNote(invoice, { amount: 48854, reason: 'Full refund', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, 48854);
+});
+
+test('createCreditNote numbers independently from invoices', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const cn1 = createCreditNote(inv1, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, [
+    'INV-2026-0001',
+    'INV-2026-0002',
+  ]).value;
+
+  const cn2 = createCreditNote(inv2, { amount: 3000, reason: 'Discount', date: '2026-10-10' }, [
+    'INV-2026-0001',
+    'INV-2026-0002',
+    'CN-2026-0001',
+  ]).value;
+
+  // Credit notes should have their own counter
+  assert.equal(cn1.number, 'CN-2026-0001');
+  assert.equal(cn2.number, 'CN-2026-0002');
+});
+
+test('createCreditNote resets counter per year', () => {
+  const inv2025 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2026 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-01-07',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    ['INV-2025-0001', 'INV-2026-0001']
+  ).value;
+
+  const cn2025 = createCreditNote(inv2025, { amount: 5000, reason: 'Refund', date: '2025-12-10' }, [
+    'INV-2025-0001',
+    'INV-2026-0001',
+  ]).value;
+
+  const cn2026 = createCreditNote(inv2026, { amount: 3000, reason: 'Discount', date: '2026-01-10' }, [
+    'INV-2025-0001',
+    'INV-2026-0001',
+    'CN-2025-0001',
+  ]).value;
+
+  // Credit notes reset counter per year
+  assert.equal(cn2025.number, 'CN-2025-0001');
+  assert.equal(cn2026.number, 'CN-2026-0001');
+});
+
+test('createCreditNote with multiple credit notes in same year', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const existingNumbers = ['INV-2026-0001', 'CN-2026-0001', 'CN-2026-0002'];
+
+  const r = createCreditNote(invoice, { amount: 2000, reason: 'Refund', date: '2026-10-10' }, existingNumbers);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0003');
+});
