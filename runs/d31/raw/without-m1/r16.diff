+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices with empty list returns empty list', () => {
+  const result = overdueInvoices([], '2026-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = overdueInvoices([inv], '2026-12-31');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes issued invoices with dueDate before asOf', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([inv], '2026-10-25');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, inv.number);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-10-21');
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  // Due date is 2026-10-21, asOf is 2026-10-28, so 7 days overdue
+  const result = overdueInvoices([inv], '2026-10-28');
+  assert.equal(result[0].daysOverdue, 7);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  inv = recordPayment(inv, { amount: 10000, date: '2026-10-22' }).value;
+
+  const result = overdueInvoices([inv], '2026-10-28');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, inv.number);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  // Total is 48854 with gold tier discount
+  inv = recordPayment(inv, { amount: 48854, date: '2026-10-22' }).value;
+
+  const result = overdueInvoices([inv], '2026-10-28');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices with dueDate on or after asOf', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  // Due date is 2026-10-21
+  const result1 = overdueInvoices([inv], '2026-10-21');
+  assert.equal(result1.length, 0);
+
+  const result2 = overdueInvoices([inv], '2026-10-20');
+  assert.equal(result2.length, 0);
+});
+
+test('overdueInvoices calculates due correctly', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  inv = recordPayment(inv, { amount: 20000, date: '2026-10-22' }).value;
+
+  const result = overdueInvoices([inv], '2026-10-28');
+  // Total is 48854 (gold tier 5% discount), payment is 20000, so due is 28854
+  assert.equal(result[0].due, 28854);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-09-15',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-003',
+      issueDate: '2026-10-01',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    }).value,
+    ['INV-2026-0001', 'INV-2026-0002']
+  ).value;
+
+  // inv1: due 2026-09-15, inv2: due 2026-09-29, inv3: due 2026-10-15
+  const result = overdueInvoices([inv1, inv2, inv3], '2026-10-28');
+  assert.equal(result.length, 3);
+  assert.equal(result[0].number, inv1.number);
+  assert.equal(result[1].number, inv2.number);
+  assert.equal(result[2].number, inv3.number);
+  assert(result[0].daysOverdue > result[1].daysOverdue);
+  assert(result[1].daysOverdue > result[2].daysOverdue);
+});
+
+test('overdueInvoices with multiple statuses filters correctly', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  let issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  let partiallyPaid = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-08-15',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  partiallyPaid = recordPayment(partiallyPaid, { amount: 10000, date: '2026-08-30' }).value;
+
+  let paid = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-08-01',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    ['INV-2026-0001', 'INV-2026-0002']
+  ).value;
+
+  paid = recordPayment(paid, { amount: 48854, date: '2026-08-20' }).value;
+
+  const result = overdueInvoices([draft, issued, partiallyPaid, paid], '2026-10-28');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, partiallyPaid.number);
+  assert.equal(result[1].number, issued.number);
+});
+
+test('overdueInvoices returns correct fields', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([inv], '2026-10-28');
+  const overdueInv = result[0];
+
+  assert(overdueInv.hasOwnProperty('number'));
+  assert(overdueInv.hasOwnProperty('customerId'));
+  assert(overdueInv.hasOwnProperty('dueDate'));
+  assert(overdueInv.hasOwnProperty('daysOverdue'));
+  assert(overdueInv.hasOwnProperty('due'));
+  assert.equal(Object.keys(overdueInv).length, 5);
+});
