   const overdue = invoices
@@ -15,3 +16,32 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  const filtered = invoices.filter((inv) =>
+    inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid'
+  );
+
+  for (const invoice of filtered) {
+    for (const line of invoice.lines) {
+      const lineAmount = line.qty * line.unitPrice;
+      const lineDiscount = roundCents(lineAmount * line.discountPercent / 100);
+      const lineAfterDiscount = lineAmount - lineDiscount;
+      const lineVAT = roundCents(lineAfterDiscount * line.vatRate / 100);
+
+      if (!vatMap.has(line.vatRate)) {
+        vatMap.set(line.vatRate, { base: 0, vat: 0 });
+      }
+
+      const entry = vatMap.get(line.vatRate);
+      entry.base += lineAfterDiscount;
+      entry.vat += lineVAT;
+    }
+  }
+
+  return Array.from(vatMap.entries())
+    .map(([rate, { base, vat }]) => ({ rate, base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+}
