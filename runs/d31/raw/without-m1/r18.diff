+test('lateFee returns 0 when invoice is not overdue', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
