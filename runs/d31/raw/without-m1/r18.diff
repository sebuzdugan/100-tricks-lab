diff --git a/src/reports.js b/src/reports.js
index ab44c59..3ce1afe 100644
--- a/src/reports.js
+++ b/src/reports.js
@@ -45,3 +45,15 @@ export function vatSummary(invoices) {
     .map(([rate, { base, vat }]) => ({ rate, base, vat }))
     .sort((a, b) => b.rate - a.rate);
 }
+
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = roundCents(due * daysOverdue * 0.0004);
+
+  return fee;
+}
