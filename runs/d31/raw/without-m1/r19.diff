+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function escapeCSVField(value) {
+  const stringValue = String(value);
+  if (stringValue.includes(',') || stringValue.includes('"') || stringValue.includes('\n')) {
+    return `"${stringValue.replace(/"/g, '""')}"`;
+  }
+  return stringValue;
+}
+
+function centsToEuros(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map((invoice) => {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number,
+      escapeCSVField(customerName),
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      centsToEuros(totals.subtotal),
+      centsToEuros(totals.discount),
+      centsToEuros(totals.vat),
+      centsToEuros(totals.total),
+      centsToEuros(due),
+    ];
+
+    return fields.join(',');
+  });
+
+  return header + lines.join('\n') + (lines.length > 0 ? '\n' : '');
+}
diff --git a/test/export.test.js b/test/export.test.js
