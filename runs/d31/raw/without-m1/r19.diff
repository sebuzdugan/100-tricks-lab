+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv with empty list returns header only', () => {
+  const result = exportCsv([]);
+  const expected = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+  assert.equal(result, expected);
+});
+
+test('exportCsv with single issued invoice', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[1].includes('2026-10-07'));
+  assert(lines[1].includes('2026-10-21'));
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv formats amounts correctly', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // subtotal, discount, vat, total should be in euros format with 2 decimals
+  const subtotal = fields[5];
+  const discount = fields[6];
+  const vat = fields[7];
+  const total = fields[8];
+
+  // Check they match the pattern X.YY
+  assert(/^\d+\.\d{2}$/.test(subtotal));
+  assert(/^\d+\.\d{2}$/.test(discount));
+  assert(/^\d+\.\d{2}$/.test(vat));
+  assert(/^\d+\.\d{2}$/.test(total));
+});
+
+test('exportCsv includes customer name', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n');
+
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[2].includes('Blue Fern Bakery'));
+});
+
+test('exportCsv includes issued and draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([draft, issued]);
+  const lines = result.split('\n');
+
+  assert(lines[1].includes('draft'));
+  assert(lines[2].includes('issued'));
+});
+
+test('exportCsv escapes customer names with quotes', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-006',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // Marlow "The Print Shop" should be escaped: "Marlow ""The Print Shop"""
+  assert(lines[1].includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv handles due amounts correctly', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  inv = recordPayment(inv, { amount: 20000, date: '2026-10-10' }).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  const due = fields[9];
+  // Total is 48854, payment is 20000, so due is 28854 = 288.54
+  assert.equal(due, '288.54');
+});
+
+test('exportCsv with paid invoice has zero due', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  // Total is 48854 with gold tier discount
+  inv = recordPayment(inv, { amount: 48854, date: '2026-10-10' }).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  const due = fields[9];
+  assert.equal(due, '0.00');
+  assert.equal(fields[4], 'paid');
+});
+
+test('exportCsv multiple invoices in order', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DES-HOUR', qty: 3 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-003',
+      issueDate: '2026-10-09',
+      lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    }).value,
+    ['INV-2026-0001', 'INV-2026-0002']
+  ).value;
+
+  const result = exportCsv([inv1, inv2, inv3]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 5); // header + 3 invoices + trailing newline
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+  assert(lines[3].includes('INV-2026-0003'));
+});
+
+test('exportCsv has newline at end', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([inv]);
+  assert(result.endsWith('\n'));
+});
+
+test('exportCsv with invoice without due date', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = exportCsv([draft]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // dueDate should be present for draft invoices (from createInvoice)
+  assert(fields[3]);
+});
+
+test('exportCsv formats large amounts', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  const subtotal = fields[5];
+  // LOGO-PACK: 120000 * 2 = 240000 cents = 2400.00 euros
+  // gold tier 5% discount: 240000 - 12000 = 228000
+  assert(subtotal.includes('2400'));
+});
+
+test('exportCsv CSV escaping with quotes and commas', () => {
+  // Test that special characters are properly escaped
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-006',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // Customer name "Marlow "The Print Shop"" should be properly escaped
+  assert(lines[1].includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv all required columns present', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      terms: 'NET14',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  const headers = lines[0].split(',');
+
+  assert.deepEqual(headers, [
+    'number',
+    'customer',
+    'issueDate',
+    'dueDate',
+    'status',
+    'subtotal',
+    'discount',
+    'vat',
+    'total',
+    'due',
+  ]);
+});
+
+test('exportCsv data line has correct number of fields', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  const headers = lines[0].split(',');
+  const dataFields = lines[1].split(',');
+
+  // Need to account for escaped fields
+  assert(dataFields.length >= headers.length);
+});
