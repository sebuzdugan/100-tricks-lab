+/**
+ * Merge two customers: move all invoices from fromId to intoId, and remove fromId.
+ * @param {Array<{id: string, name: string, email: string, country: string, tier: string}>} customers
+ * @param {Array} invoices
+ * @param {string} fromId - Customer to merge from (will be removed)
+ * @param {string} intoId - Customer to merge into (will keep invoices)
+ * @returns {import('./result.js').Result<{customers: Array, invoices: Array}>}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  // Check if both customers exist
+  const fromCustomer = customers.find((c) => c.id === normalizedFromId);
+  if (!fromCustomer) return fail('CUSTOMER_NOT_FOUND');
+
+  const intoCustomer = customers.find((c) => c.id === normalizedIntoId);
+  if (!intoCustomer) return fail('CUSTOMER_NOT_FOUND');
+
+  // Check if they're the same customer
+  if (normalizedFromId === normalizedIntoId) return fail('SAME_CUSTOMER');
+
+  // Create new customers array without fromId
+  const newCustomers = customers.filter((c) => c.id !== normalizedFromId);
+
+  // Create new invoices array, updating customerId from fromId to intoId
+  const newInvoices = invoices.map((inv) => {
+    if (inv.customerId === normalizedFromId) {
+      return { ...inv, customerId: normalizedIntoId };
+    }
+    return { ...inv };
+  });
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
