+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line.
+ * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }} line
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
+    const lineAmount = lineTotal(line);
+    const lineDiscount = roundCents(lineAmount * line.discountPercent / 100);
+    const lineAfterDiscount = lineAmount - lineDiscount;
+    const lineVAT = roundCents(lineAfterDiscount * line.vatRate / 100);
+
+    subtotal += lineAmount;
+    discount += lineDiscount;
+    vat += lineVAT;
+  }
+
+  const voucherAmount = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucherAmount);
+
+  return { subtotal, discount, vat, voucher: voucherAmount, total };
+}
