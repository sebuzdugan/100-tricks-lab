+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal with basic values', () => {
+  const line = { sku: 'DES-HOUR', name: 'Design work', qty: 5, unitPrice: 8500, vatRate: 21 };
+  assert.equal(lineTotal(line), 42500);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { sku: 'DES-HOUR', name: 'Design work', qty: 1, unitPrice: 8500, vatRate: 21 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal with large quantity', () => {
+  const line = { sku: 'LOGO-PACK', name: 'Logo package', qty: 100, unitPrice: 120000, vatRate: 21 };
+  assert.equal(lineTotal(line), 12000000);
+});
+
+test('lineTotal returns integer', () => {
+  const line = { sku: 'DES-HOUR', name: 'Design work', qty: 5, unitPrice: 8500, vatRate: 21 };
+  const result = lineTotal(line);
+  assert(Number.isInteger(result));
+});
+
+test('invoiceTotals with single line', () => {
