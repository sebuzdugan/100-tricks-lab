--- a/src/totals.js
+++ b/src/totals.js
@@ -23,10 +23,18 @@ export function invoiceTotals(invoice) {
     const lineAmount = lineTotal(line);
     const lineDiscount = roundCents(lineAmount * line.discountPercent / 100);
     const lineAfterDiscount = lineAmount - lineDiscount;
-    const lineVAT = roundCents(lineAfterDiscount * line.vatRate / 100);
+
+    // Apply bulk discount (2.5%) for orders of 10 or more units
+    let bulkDiscount = 0;
+    if (line.qty >= 10) {
+      bulkDiscount = roundCents(lineAfterDiscount * 2.5 / 100);
+    }
+    const lineAfterAllDiscounts = lineAfterDiscount - bulkDiscount;
+
+    const lineVAT = roundCents(lineAfterAllDiscounts * line.vatRate / 100);
 
     subtotal += lineAmount;
-    discount += lineDiscount;
+    discount += lineDiscount + bulkDiscount;
     vat += lineVAT;
   }
 
