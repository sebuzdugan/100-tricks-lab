+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = new Map();
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] || 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDue.has(invoice.customerId)) {
+        customerDue.set(invoice.customerId, 0);
+      }
+      customerDue.set(invoice.customerId, customerDue.get(invoice.customerId) + due);
+    }
+  }
+
+  // Get overdue invoices
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue.reduce((sum, inv) => sum + inv.due, 0);
+
+  // Get top 3 customers by due amount
+  const topCustomers = Array.from(customerDue.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
