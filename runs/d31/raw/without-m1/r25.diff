 import { getCustomer } from './customers.js';
 import { formatEuros } from './money.js';
 import { invoiceTotals } from './invoices.js';
+import { roundCents } from './money.js';
 
 /**
  * Render an invoice as plain text.
- * @param {{ customerId: string, issueDate: string, status: string, number?: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent: number }> }} invoice
+ * @param {{ customerId: string, issueDate: string, status: string, number?: string, terms?: string, dueDate?: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent: number }>, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number, date: string }> }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -25,13 +26,31 @@ export function renderInvoiceText(invoice) {
     const unitPriceStr = formatEuros(line.unitPrice);
     const lineTotalStr = formatEuros(lineTotal);
     lines.push(`${qtyStr} ${nameStr} ${unitPriceStr} ${lineTotalStr}`);
+
+    if (line.discountPercent > 0) {
+      const lineDiscount = roundCents(lineTotal * line.discountPercent / 100);
+      lines.push(`  Discount: ${formatEuros(lineDiscount)}`);
+    }
   }
 
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  if (invoice.voucher) {
+    lines.push(`Voucher (${invoice.voucher.code}): ${formatEuros(invoice.voucher.amount)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const amountPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(amountPaid)}`);
+  }
+
   return lines.join('\n');
 }
diff --git a/test/render.test.js b/test/render.test.js
index 4c78fe2..fa38daa 100644
--- a/test/render.test.js
+++ b/test/render.test.js
@@ -191,3 +191,185 @@ test('renderInvoiceText returns newline-separated text', () => {
   assert.equal(typeof text, 'string');
   assert.ok(text.includes('\n'));
 });
+
+test('renderInvoiceText shows line discount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 10 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // Line discount: 42500 * 10% = 4250
+  assert.ok(lines.some((line) => line.includes('Discount: €42.50')));
+});
+
+test('renderInvoiceText does not show discount for zero discount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert(!text.includes('Discount:'));
+});
+
+test('renderInvoiceText shows multiple line discounts', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 10 },
+      { sku: 'ICON-SET', name: 'Icon set', qty: 2, unitPrice: 980, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // Line 1 discount: 42500 * 10% = 4250
+  // Line 2 discount: 1960 * 5% = 98
+  assert.ok(lines.some((line) => line.includes('Discount: €42.50')));
+  assert.ok(lines.some((line) => line.includes('Discount: €0.98')));
+});
+
+test('renderInvoiceText shows voucher before total', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    voucher: { code: 'SAVE10', amount: 5000 },
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  const voucherLineIndex = lines.findIndex((line) => line.includes('Voucher'));
+  const totalLineIndex = lines.findIndex((line) => line.includes('Total:'));
+  assert(voucherLineIndex > -1);
+  assert(totalLineIndex > -1);
+  assert(voucherLineIndex < totalLineIndex);
+  assert.ok(lines[voucherLineIndex].includes('SAVE10'));
+  assert.ok(lines[voucherLineIndex].includes('€50.00'));
+});
+
+test('renderInvoiceText does not show voucher when not present', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
