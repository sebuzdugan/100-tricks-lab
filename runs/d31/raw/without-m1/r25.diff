+  };
+  const text = renderInvoiceText(invoice);
+  assert(!text.includes('Paid:'));
+});
+
+test('renderInvoiceText with line discount, voucher, and due date', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    dueDate: '2026-10-21',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 10 }],
+    voucher: { code: 'SAVE10', amount: 3000 },
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Check all components are present and in order
+  const discountIndex = lines.findIndex((line) => line.includes('Discount:'));
+  const voucherIndex = lines.findIndex((line) => line.includes('Voucher'));
+  const totalIndex = lines.findIndex((line) => line.includes('Total:'));
+  const dueIndex = lines.findIndex((line) => line.includes('Due:'));
+
+  assert(discountIndex > -1);
+  assert(voucherIndex > -1);
+  assert(totalIndex > -1);
+  assert(dueIndex > -1);
+  assert(discountIndex < voucherIndex);
+  assert(voucherIndex < totalIndex);
+  assert(totalIndex < dueIndex);
+});
+
+test('renderInvoiceText with all features', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    dueDate: '2026-10-21',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 10 }],
+    voucher: { code: 'SAVE10', amount: 3000 },
+    payments: [{ amount: 20000, date: '2026-10-10' }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.ok(lines[0].includes('INV-2026-0001'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines.some((line) => line.includes('Discount:')));
+  assert.ok(lines.some((line) => line.includes('VAT:')));
+  assert.ok(lines.some((line) => line.includes('Voucher')));
+  assert.ok(lines.some((line) => line.includes('Total:')));
+  assert.ok(lines.some((line) => line.includes('Due:')));
+  assert.ok(lines.some((line) => line.includes('Paid:')));
+});
