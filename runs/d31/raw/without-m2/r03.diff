+/**
+ * Add a line to an invoice, or increase qty if the SKU already exists.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} line
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Get product to validate SKU and get details
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Copy invoice and lines
+  const newInvoice = { ...invoice };
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+
+  // Find existing line with this SKU
+  const existingIndex = newLines.findIndex((line) => line.sku === sku);
+
+  if (existingIndex >= 0) {
+    // Increase qty of existing line
+    newLines[existingIndex] = { ...newLines[existingIndex], qty: newLines[existingIndex].qty + qty };
+  } else {
+    // Add new line
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  newInvoice.lines = newLines;
+  return ok(newInvoice);
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Find line with this SKU
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex < 0) return fail('LINE_NOT_FOUND');
+
+  // Check if this is the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new invoice without the line
+  const newInvoice = { ...invoice };
+  newInvoice.lines = invoice.lines.filter((line, i) => i !== lineIndex);
+  return ok(newInvoice);
+}
