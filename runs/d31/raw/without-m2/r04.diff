@@ -0,0 +1,26 @@
+/**
+ * Get the next invoice number for a given year based on existing numbers.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {Array<string>} existingNumbers - Invoice numbers already used (e.g., ['INV-2026-0001', 'INV-2026-0005'])
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} Next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  // Filter numbers for this year and extract counters
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.slice(prefix.length);
+      return Number(counter);
+    })
+    .filter((num) => !isNaN(num));
+
+  // Find the max counter, default to 0
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
