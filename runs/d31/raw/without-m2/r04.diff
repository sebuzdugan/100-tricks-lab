+/**
+ * Issue an invoice: assign a number and set status to 'issued'.
+ * @param {{ status: string, issueDate: string }} invoice
+ * @param {Array<string>} existingNumbers - Invoice numbers already issued
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Generate the next invoice number
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  // Create new invoice with number and updated status
+  const newInvoice = { ...invoice, number, status: 'issued' };
+  return ok(newInvoice);
+}
