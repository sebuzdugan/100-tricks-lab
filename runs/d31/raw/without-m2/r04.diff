diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..1b7ede0
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,57 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber restarts for a new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0999', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-9999', 'INV-2025-0001', 'INV-2026-0002', 'INV-2027-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0010', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber ignores invalid numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-abc', 'INVALID', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber works for different years', () => {
+  const existing = [];
+  assert.equal(nextInvoiceNumber(existing, '2025-06-15'), 'INV-2025-0001');
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0001');
+  assert.equal(nextInvoiceNumber(existing, '2027-12-31'), 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber finds max counter correctly with gaps', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0005', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
