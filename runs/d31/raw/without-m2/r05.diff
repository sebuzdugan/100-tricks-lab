diff --git a/src/render.js b/src/render.js
new file mode 100644
index 0000000..68ec33f
--- /dev/null
+++ b/src/render.js
@@ -0,0 +1,31 @@
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerName: string, lines: Array, status: string }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  const invoiceNumber = invoice.number ?? 'DRAFT';
+  lines.push(invoiceNumber);
+
+  // Second line: customer name
+  lines.push(invoice.customerName);
+
+  // One line per invoice line
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Last line: total
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
