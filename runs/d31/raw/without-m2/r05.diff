@@ -0,0 +1,193 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const invoice = result.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const invoice = result.value;
+
+  const issueResult = issueInvoice(invoice, []);
+  const issuedInvoice = issueResult.value;
+
+  const text = renderInvoiceText(issuedInvoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0001');
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const invoice = result.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText formats line items with qty, name, price and total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const invoice = result.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '5x Development (hour) @ €95.00 = €475.00');
+});
+
+test('renderInvoiceText shows total in last line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  const invoice = result.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[4], 'Total: €1,675.00');
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  const invoice = result.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 6);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '2x Development (hour) @ €95.00 = €190.00');
+  assert.equal(lines[3], '3x Copywriting (hour) @ €60.00 = €180.00');
+  assert.equal(lines[4], '1x Logo package @ €1,200.00 = €1,200.00');
+  assert.equal(lines[5], 'Total: €1,570.00');
+});
+
+test('renderInvoiceText uses formatEuros for all amounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 10 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  const invoice = result.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /€/);
+  assert.match(lines[3], /€/);
+  assert.match(lines[4], /€/);
+  assert.equal(lines[2], '10x Icon set (24 icons) @ €9.80 = €98.00');
+  assert.equal(lines[3], '100x Sticker sheet @ €0.50 = €50.00');
+  assert.equal(lines[4], 'Total: €148.00');
+});
+
+test('renderInvoiceText works with VAT-exempt products', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+  const invoice = result.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '1x Brand workshop (day, VAT exempt) @ €600.00 = €600.00');
+  assert.equal(lines[3], 'Total: €600.00');
+});
+
+test('renderInvoiceText handles products with various price points', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PRINT-A4', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  });
+  const invoice = result.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '1x Printed flyer A4 (each) @ €0.37 = €0.37');
+  assert.equal(lines[3], '1x Brand guidelines document @ €2,450.00 = €2,450.00');
+  assert.equal(lines[4], 'Total: €2,450.37');
+});
+
+test('renderInvoiceText renders multi-line output correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'DES-HOUR', qty: 4 },
+    ],
+  });
+  const invoice = result.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.equal(typeof text, 'string');
+  assert.match(text, /DRAFT\n/);
+  assert.match(text, /Blue Fern Bakery\n/);
+  assert.match(text, /Total: /);
+});
+
+test('renderInvoiceText produces the same output for identical invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const invoice = result.value;
+
+  const text1 = renderInvoiceText(invoice);
+  const text2 = renderInvoiceText(invoice);
+
+  assert.equal(text1, text2);
+});
