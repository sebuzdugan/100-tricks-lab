+/**
+ * Calculate the discount amount for a single line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} Discount amount in cents, clamped between 0 and line total
+ */
+export function lineDiscount(line) {
+  const discountPercent = line.discountPercent ?? 0;
+  const total = lineTotal(line);
+  const discount = roundCents((total * discountPercent) / 100);
+  return Math.max(0, Math.min(discount, total));
+}
