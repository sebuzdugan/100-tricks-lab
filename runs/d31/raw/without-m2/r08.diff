   return Math.max(0, Math.min(discount, total));
 }
 
+/**
+ * Calculate the VAT amount for a single line.
+ * VAT is calculated on the line total after discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number} VAT amount in cents, clamped to 0
+ */
+export function lineVat(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amount = total - discount;
+  const vat = roundCents((amount * line.vatRate) / 100);
+  return Math.max(0, vat);
+}
+
 /**
  * Calculate totals for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }} Amounts in cents
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }} Amounts in cents
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
-  const total = Math.max(0, subtotal - discount);
-  return { subtotal, discount, total };
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
+  const total = Math.max(0, subtotal - discount + vat);
+  return { subtotal, discount, vat, total };
 }
 
