@@ -0,0 +1,122 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+  assert.equal(isValidDate('2026-02-28'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-010-07'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate('2026'), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-01-00'), false);
+});
+
+test('isValidDate rejects leap day for non-leap years', () => {
+  assert.equal(isValidDate('2026-02-29'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate accepts leap day for leap years', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 100), '2027-01-15');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-11-30', 1), '2026-12-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays handles leap year boundaries', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2023-02-28', 1), '2023-03-01');
+});
+
+test('addDays subtracts days with negative numbers', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+  assert.equal(addDays('2026-01-15', -100), '2025-10-07');
+});
+
+test('addDays handles zero', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+});
+
+test('daysBetween handles same date', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-11-01', '2026-10-31'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2023-02-28', '2023-03-01'), 1);
+});
+
+test('daysBetween handles large differences', () => {
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const date1 = '2026-10-07';
+  const date2 = addDays(date1, 100);
+  assert.equal(daysBetween(date1, date2), 100);
+  assert.equal(daysBetween(date2, date1), -100);
+});
+
+test('daysBetween works across large time spans', () => {
+  assert.equal(daysBetween('2000-01-01', '2026-10-07'), 9776);
+});
+
+test('isValidDate rejects non-string input for format check', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('abc'), false);
+  assert.equal(isValidDate('2026-10-070'), false);
+});
