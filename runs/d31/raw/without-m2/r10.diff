+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a valid date.
+ * All date operations use UTC to avoid timezone issues.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const [year, month, day] = text.split('-').map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date string in YYYY-MM-DD format.
+ * Uses UTC for all calculations.
+ * @param {string} date Date in YYYY-MM-DD format
+ * @param {number} n Number of days to add
+ * @returns {string} New date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const [year, month, day] = date.split('-').map(Number);
+  const d = new Date(Date.UTC(year, month - 1, day));
+  d.setUTCDate(d.getUTCDate() + n);
+  const newYear = d.getUTCFullYear();
+  const newMonth = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const newDay = String(d.getUTCDate()).padStart(2, '0');
+  return `${newYear}-${newMonth}-${newDay}`;
+}
+
+/**
+ * Calculate the number of whole days between two dates (b minus a).
+ * Uses UTC for all calculations.
+ * @param {string} a Start date in YYYY-MM-DD format
+ * @param {string} b End date in YYYY-MM-DD format
+ * @returns {number} Number of days (b - a)
+ */
+export function daysBetween(a, b) {
+  const [aYear, aMonth, aDay] = a.split('-').map(Number);
+  const [bYear, bMonth, bDay] = b.split('-').map(Number);
+  const dateA = new Date(Date.UTC(aYear, aMonth - 1, aDay));
+  const dateB = new Date(Date.UTC(bYear, bMonth - 1, bDay));
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
