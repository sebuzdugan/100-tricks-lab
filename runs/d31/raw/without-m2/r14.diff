+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns customer statement with issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = statement('C-001', [issued], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement includes invoice details', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = statement('C-001', [issued], '2026-10-15');
+  const invoice = result.value.invoices[0];
+
+  assert.equal(invoice.number, 'INV-2026-0001');
+  assert.equal(invoice.issueDate, '2026-10-07');
+  assert.equal(invoice.dueDate, '2026-11-06');
+  assert.equal(invoice.total > 0, true);
+  assert.equal(invoice.due, invoice.total);
+});
+
+test('statement excludes invoices after cutoff date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2026-10-15');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement includes invoices on cutoff date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = statement('C-001', [issued], '2026-10-07');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const result = statement('C-001', [inv], '2026-10-15');
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-10' }).value;
+
+  const result = statement('C-001', [paid], '2026-10-15');
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement includes partially paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const partial = recordPayment(issued, { amount: 50000, date: '2026-10-10' }).value;
+
+  const result = statement('C-001', [partial], '2026-10-15');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due < result.value.invoices[0].total, true);
+});
+
+test('statement shows correct due amount for partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const partial = recordPayment(issued, { amount: 50000, date: '2026-10-10' }).value;
+
+  const result = statement('C-001', [partial], '2026-10-15');
+  const invoice = result.value.invoices[0];
+
+  assert.equal(invoice.due, invoice.total - 50000);
+});
+
+test('statement excludes other customers invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2026-10-15');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  assert.deepEqual(statement('C-999', [], '2026-10-15'), {
+    ok: false,
+    error: 'CUSTOMER_NOT_FOUND',
+  });
+});
+
+test('statement normalizes customer ID', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = statement('c-001', [issued], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement calculates total due correctly', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 20 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2026-10-15');
+  const due1 = result.value.invoices[0].due;
+  const due2 = result.value.invoices[1].due;
+
+  assert.equal(result.value.totalDue, due1 + due2);
+});
+
+test('statement sorts by issue date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 20 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2026-10-15');
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-07');
+});
+
+test('statement with no outstanding invoices', () => {
+  const result = statement('C-001', [], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement with mixed invoice statuses', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+  const partial2 = recordPayment(issued2, { amount: 50000, date: '2026-10-10' }).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued3 = issueInvoice(inv3, ['INV-2026-0001', 'INV-2026-0002']).value;
+  const totals3 = invoiceTotals(issued3);
+  const paid3 = recordPayment(issued3, { amount: totals3.total, date: '2026-10-10' }).value;
+
+  const result = statement('C-001', [issued1, partial2, paid3], '2026-10-15');
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(result.value.invoices[1].number, 'INV-2026-0002');
+});
