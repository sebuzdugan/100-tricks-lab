+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement of outstanding invoices.
+ * @param {string} customerId Customer ID
+ * @param {Array<object>} invoices Array of all invoices
+ * @param {string} asOf Date in YYYY-MM-DD format (cutoff date, inclusive)
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize and validate customer exists
+  const normalizedId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer with outstanding balance
+  const statementInvoices = invoices
+    .filter((inv) => inv.customerId === normalizedId)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .map((inv) => {
+      const totals = invoiceTotals(inv);
+      const due = balanceDue(inv);
+      return {
+        number: inv.number,
+        issueDate: inv.issueDate,
+        dueDate: inv.dueDate ?? null,
+        total: totals.total,
+        due,
+      };
+    })
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
