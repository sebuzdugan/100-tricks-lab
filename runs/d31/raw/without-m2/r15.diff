+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 50000, reason: 'Partial refund', date: '2026-10-10' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2026-10-10');
+});
+
+test('createCreditNote works on partially paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 50000, date: '2026-10-10' }).value;
+
+  const result = createCreditNote(partial, { amount: 25000, reason: 'Discount', date: '2026-10-15' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 25000);
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-10' }).value;
+
+  const result = createCreditNote(paid, { amount: 50000, reason: 'Refund', date: '2026-10-15' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote returns NOT_ISSUED for draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  assert.deepEqual(
+    createCreditNote(inv, { amount: 50000, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('createCreditNote returns AMOUNT_INVALID for non-integer amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  assert.deepEqual(
+    createCreditNote(issued, { amount: 50000.5, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote returns AMOUNT_INVALID for zero amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  assert.deepEqual(
+    createCreditNote(issued, { amount: 0, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote returns AMOUNT_INVALID for negative amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  assert.deepEqual(
+    createCreditNote(issued, { amount: -50000, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote returns CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  assert.deepEqual(
+    createCreditNote(issued, { amount: totals.total + 1, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
+
+test('createCreditNote allows credit up to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: totals.total, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote increments counter for same year', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const existing = ['CN-2026-0001', 'CN-2026-0002'];
+  const result = createCreditNote(issued, { amount: 50000, reason: 'Refund', date: '2026-10-10' }, existing);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-01-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const existing = ['CN-2026-0001', 'CN-2026-0999'];
+  const result = createCreditNote(issued, { amount: 50000, reason: 'Refund', date: '2027-01-10' }, existing);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote ignores invoice numbers in existing numbers', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const existing = ['INV-2026-0001', 'INV-2026-0999', 'CN-2026-0002'];
+  const result = createCreditNote(issued, { amount: 50000, reason: 'Refund', date: '2026-10-10' }, existing);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote credit note number format is CN-YYYY-NNNN', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 50000, reason: 'Refund', date: '2026-10-10' }, []);
+  assert.match(result.value.number, /^CN-\d{4}-\d{4}$/);
+});
+
+test('createCreditNote with different customers and reasons', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 50 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const credit1 = createCreditNote(issued1, { amount: 25000, reason: 'Quality issue', date: '2026-10-10' }, []).value;
+  const credit2 = createCreditNote(
+    issued2,
+    { amount: 15000, reason: 'Wrong quantity shipped', date: '2026-10-11' },
+    [credit1.number]
+  ).value;
+
+  assert.equal(credit1.customerId, 'C-001');
+  assert.equal(credit1.reason, 'Quality issue');
+  assert.equal(credit2.customerId, 'C-002');
+  assert.equal(credit2.reason, 'Wrong quantity shipped');
+  assert.equal(credit2.number, 'CN-2026-0002');
+});
