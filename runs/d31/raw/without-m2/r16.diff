+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array when no invoices overdue', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET30',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-31');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoices past due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-25');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices includes invoice due date details', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-25');
+  const overdue = result[0];
+
+  assert.equal(overdue.number, 'INV-2026-0001');
+  assert.equal(overdue.customerId, 'C-001');
+  assert.equal(overdue.dueDate, '2026-10-21');
+  assert.equal(overdue.daysOverdue, 4);
+  assert.equal(overdue.due > 0, true);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    terms: 'NET30',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2026-11-10');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices on due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-21');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const result = overdueInvoices([inv], '2026-10-25');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-20' }).value;
+
+  const result = overdueInvoices([paid], '2026-10-25');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes partially paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 50000, date: '2026-10-20' }).value;
+
+  const result = overdueInvoices([partial], '2026-10-25');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due < result[0].total || !result[0].total, true);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result = overdueInvoices([issued2, issued1], '2026-10-25');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].daysOverdue > result[1].daysOverdue, true);
+  assert.equal(result[0].dueDate, '2026-10-15');
+  assert.equal(result[1].dueDate, '2026-10-21');
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-25');
+  assert.equal(result[0].dueDate, '2026-10-21');
+  assert.equal(result[0].daysOverdue, 4);
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result = overdueInvoices([issued1, issued2], '2026-10-20');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[1].customerId, 'C-002');
+  assert.equal(result[0].daysOverdue > result[1].daysOverdue, true);
+});
+
+test('overdueInvoices excludes invoices without dueDate', () => {
+  const inv = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [],
+  };
+
+  const result = overdueInvoices([inv], '2026-10-25');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices with mixed statuses and dates', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    terms: 'NET30',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued3 = issueInvoice(inv3, ['INV-2026-0001', 'INV-2026-0002']).value;
+
+  const result = overdueInvoices([issued1, inv2, issued3], '2026-10-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices shows correct due amount for partially paid', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const partial = recordPayment(issued, { amount: 50000, date: '2026-10-20' }).value;
+
+  const result = overdueInvoices([partial], '2026-10-25');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, totals.total - 50000);
+});
