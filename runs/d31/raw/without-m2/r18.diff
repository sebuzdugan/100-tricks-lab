+
+/**
+ * Calculate late fee for an invoice.
+ * Late fee is 0.04% per day of the amount still due, for each day overdue.
+ * @param {object} invoice - Invoice with status, dueDate, and payments
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (!invoice.dueDate || invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = roundCents((due * 0.04 * daysOverdue) / 100);
+  return Math.max(0, fee);
+}
