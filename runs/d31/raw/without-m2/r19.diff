+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header with correct columns', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv includes one invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[2], '');
+});
+
+test('exportCsv exports invoice number', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  assert.equal(lines[1].startsWith('INV-2026-0001,'), true);
+});
+
+test('exportCsv exports customer name not id', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[1], issued.customerName);
+  assert.notEqual(fields[1], 'C-001');
+});
+
+test('exportCsv exports dates', () => {
