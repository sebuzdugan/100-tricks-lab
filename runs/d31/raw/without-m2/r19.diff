+test('exportCsv shows due amount after partial payment', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paymentAmount = Math.floor(totals.total / 2);
+  const paymentResult = recordPayment(issued, { amount: paymentAmount, date: '2026-10-20' });
+  const partial = paymentResult.value;
+
+  const result = exportCsv([partial]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  const due = totals.total - paymentAmount;
+  assert.equal(fields[9], (due / 100).toFixed(2));
+});
