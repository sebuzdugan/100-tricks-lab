+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format a value as euros with 2 decimals and a dot separator.
+ * @param {number} cents - Amount in cents
+ * @returns {string} Formatted euros (e.g., "1234.50")
+ */
+function formatEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field value.
+ * If the field contains a comma or double quote, wrap in double quotes.
+ * Double any internal double quotes.
+ * @param {string} value - Field value
+ * @returns {string} Escaped field value
+ */
+function escapeCsvField(value) {
+  if (value.includes(',') || value.includes('"')) {
+    return `"${value.replace(/"/g, '""')}"`;
+  }
+  return value;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<object>} invoices - Invoices to export
+ * @returns {string} CSV data with header and invoice lines
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map((inv) => {
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const fields = [
+      inv.number || '',
+      inv.customerName || '',
+      inv.issueDate || '',
+      inv.dueDate || '',
+      inv.status || '',
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    return fields.map(escapeCsvField).join(',') + '\n';
+  });
+
+  return header + lines.join('');
+}
