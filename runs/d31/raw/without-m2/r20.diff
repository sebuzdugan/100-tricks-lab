+test('RATES has EUR, USD, and GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 108);
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(100, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 84);
+});
+
+test('convert EUR to EUR', () => {
+  const result = convert(100, 'EUR');
