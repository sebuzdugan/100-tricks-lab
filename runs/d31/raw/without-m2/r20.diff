@@ -39,3 +39,49 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert EUR cents to another currency's cents.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const euros = cents / 100;
+  const rate = RATES[currency];
+  const amount = euros * rate;
+  const currencyCents = roundCents(amount * 100);
+  return ok(currencyCents);
+}
+
+/**
+ * Format cents in a specific currency for people.
+ * @param {number} cents - Amount in that currency's cents
+ * @param {string} currency - Currency (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const wholeAmount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const fractional = String(abs % 100).padStart(2, '0');
+
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  const symbol = symbols[currency] ?? '';
+  return `${sign}${symbol}${wholeAmount}.${fractional}`;
+}
