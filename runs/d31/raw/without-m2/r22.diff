+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  assert.equal(lineTotal({ qty: 10, unitPrice: 100 }), 1000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 2500 }), 2500);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 9500 }), 950000);
+});
+
+test('lineTotal works with zero quantity', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 100 }), 0);
+});
+
+test('lineTotal works with large numbers', () => {
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 100000 }), 100000000);
+});
+
+test('lineDiscount calculates discount amount', () => {
+  const line = { qty: 10, unitPrice: 100, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 100);
+});
+
+test('lineDiscount defaults to 0 when discountPercent is not provided', () => {
+  const line = { qty: 10, unitPrice: 100 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount handles decimal percentages', () => {
+  const line = { qty: 10, unitPrice: 100, discountPercent: 2.5 };
+  assert.equal(lineDiscount(line), 25);
+});
+
+test('lineDiscount is clamped to 0', () => {
+  const line = { qty: 10, unitPrice: 100, discountPercent: -10 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVat calculates VAT on line total before discount', () => {
+  const line = { qty: 100, unitPrice: 100, vatRate: 21 };
+  assert.equal(lineVat(line), 2100);
+});
+
+test('lineVat calculates VAT on discounted amount', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 21 };
+  const total = 10000;
+  const discount = 1000;
+  const base = total - discount;
+  const expectedVat = Math.round((base * 21) / 100);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat handles different VAT rates', () => {
+  const line7 = { qty: 100, unitPrice: 100, vatRate: 7 };
+  const line21 = { qty: 100, unitPrice: 100, vatRate: 21 };
+  const vat7 = lineVat(line7);
+  const vat21 = lineVat(line21);
+  assert.equal(vat7, 700);
+  assert.equal(vat21, 2100);
+  assert.equal(vat21 > vat7, true);
+});
+
+test('lineVat is clamped to 0', () => {
+  const line = { qty: 100, unitPrice: 100, vatRate: -10 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('invoiceTotals returns subtotal, discount, vat, voucher and total', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 100, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(typeof result.subtotal, 'number');
+  assert.equal(typeof result.discount, 'number');
+  assert.equal(typeof result.vat, 'number');
+  assert.equal(typeof result.voucher, 'number');
+  assert.equal(typeof result.total, 'number');
+});
+
+test('invoiceTotals sums multiple lines correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 50, unitPrice: 100, vatRate: 21 },
+      { qty: 50, unitPrice: 100, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 2100);
+  assert.equal(result.total, 12100);
+});
+
+test('invoiceTotals works with empty lines array', () => {
+  const invoice = { lines: [] };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 0);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals returns fresh object', () => {
+  const invoice = { lines: [] };
+  const result1 = invoiceTotals(invoice);
+  const result2 = invoiceTotals(invoice);
+  assert.notEqual(result1, result2);
+  assert.deepEqual(result1, result2);
+});
+
+test('invoiceTotals calculates discount correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 1000);
+});
+
+test('invoiceTotals total is clamped to 0', () => {
+  const invoice = {
+    lines: [],
+    voucher: { amount: 1000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with multiple VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, vatRate: 21 },
+      { qty: 100, unitPrice: 100, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 20000);
+  assert.equal(result.vat, 2100);
+});
+
+test('invoiceTotals VAT calculated after discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1000, unitPrice: 100, discountPercent: 50, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  const subtotal = 100000;
+  const discount = 50000;
+  const base = subtotal - discount;
+  const expectedVat = Math.round((base * 21) / 100);
+  assert.equal(result.vat, expectedVat);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 100, vatRate: 21 }],
+    voucher: { amount: 1000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 1000);
+  assert.equal(result.total, 11100);
+});
+
+test('lineDiscount is clamped to line total', () => {
+  const line = { qty: 10, unitPrice: 100, discountPercent: 150 };
+  const lineTotal = 1000;
+  assert.equal(lineDiscount(line), lineTotal);
+});
+
+test('invoiceTotals with created invoice structure', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development',
+        qty: 100,
+        unitPrice: 9500,
+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 950000);
+  assert.equal(result.total > 0, true);
+});
+
+test('lineTotal with single line matches invoice subtotal when no other lines', () => {
+  const line = { qty: 100, unitPrice: 9500 };
+  const invoice = { lines: [line] };
+  assert.equal(lineTotal(line), invoiceTotals(invoice).subtotal);
+});
+
+test('discount calculation precision with banker rounding', () => {
+  const line = { qty: 3, unitPrice: 100, discountPercent: 33.33 };
+  const discount = lineDiscount(line);
+  assert.equal(typeof discount, 'number');
+  assert.equal(discount >= 0, true);
+});
