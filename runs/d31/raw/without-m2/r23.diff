diff --git a/src/totals.js b/src/totals.js
index 95b297c..3c6f0a4 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -11,14 +11,24 @@ export function lineTotal(line) {
 
 /**
  * Calculate the discount amount for a single line.
+ * Includes line discount and bulk discount (2.5% for qty >= 10) applied sequentially.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number} Discount amount in cents, clamped between 0 and line total
  */
 export function lineDiscount(line) {
   const discountPercent = line.discountPercent ?? 0;
   const total = lineTotal(line);
-  const discount = roundCents((total * discountPercent) / 100);
-  return Math.max(0, Math.min(discount, total));
+  const lineDisc = roundCents((total * discountPercent) / 100);
+  const clampedLineDisc = Math.max(0, Math.min(lineDisc, total));
+
+  const remainingAfterLineDisc = total - clampedLineDisc;
+  let bulkDisc = 0;
+  if (line.qty >= 10) {
+    bulkDisc = roundCents((remainingAfterLineDisc * 2.5) / 100);
+  }
+
+  const totalDiscount = clampedLineDisc + bulkDisc;
+  return Math.max(0, Math.min(totalDiscount, total));
 }
 
