+/**
+ * Get a dashboard summary of invoice metrics.
+ * @param {Array<object>} invoices - All invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ counts: object, outstanding: number, overdue: object, topCustomers: Array }} Dashboard metrics
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  const customerDue = {};
+  let outstanding = 0;
+
+  invoices.forEach((inv) => {
+    counts[inv.status] = (counts[inv.status] || 0) + 1;
+
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const due = balanceDue(inv);
+      outstanding += due;
+
+      const customerId = inv.customerId;
+      if (!customerDue[customerId]) {
+        customerDue[customerId] = 0;
+      }
+      customerDue[customerId] += due;
+    }
+  });
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueSummary = {
+    count: overdue.length,
+    amount: overdue.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: overdueSummary,
+    topCustomers,
+  };
+}
