 import { formatEuros } from './money.js';
 import { lineTotal, lineDiscount, lineVat, invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
 
 /**
  * Render an invoice as plain text.
- * @param {{ number?: string, customerName: string, lines: Array, status: string }} invoice
+ * @param {{ number?: string, customerName: string, lines: Array, status: string, dueDate?: string, payments?: Array }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -30,7 +31,7 @@ export function renderInvoiceText(invoice) {
     lines.push(lineText);
   }
 
-  // Last lines: subtotal, discount, VAT, total
+  // Subtotal, discount, VAT, voucher, total
   const totals = invoiceTotals(invoice);
   if (totals.discount > 0) {
     lines.push(`Subtotal: ${formatEuros(totals.subtotal)}`);
@@ -39,7 +40,21 @@ export function renderInvoiceText(invoice) {
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(totals.voucher)}`);
+  }
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid amount if there are payments
+  const paid = totals.total - balanceDue(invoice);
+  if (paid > 0) {
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return lines.join('\n');
 }
