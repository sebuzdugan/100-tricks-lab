diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..adfa3bb
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,71 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {import('./result.js').Result<{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }>}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate lines array is not empty
+  if (!lines || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Validate issueDate format and existence
+  const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!dateRegex.test(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Parse and validate the date is real
+  const date = new Date(issueDate + 'T00:00:00Z');
+  const [year, month, day] = issueDate.split('-').map(Number);
+  if (
+    isNaN(date.getTime()) ||
+    date.getUTCFullYear() !== year ||
+    date.getUTCMonth() + 1 !== month ||
+    date.getUTCDate() !== day
+  ) {
+    return fail('DATE_INVALID');
+  }
+
+  // Check customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Validate and enrich lines
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Get product from catalogue
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) {
+      return fail('UNKNOWN_SKU');
+    }
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  // Return the invoice
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..84e684d
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,167 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+
+const firstCustomer = listCustomers()[0];
+const firstProduct = listProducts()[0];
+
+test('createInvoice requires a non-empty lines array', () => {
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [],
+  }), { ok: false, error: 'NO_LINES' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: null,
+  }), { ok: false, error: 'NO_LINES' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: undefined,
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice validates issueDate format', () => {
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026/01/01',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '01-01-2026',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: 'not-a-date',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice validates date existence', () => {
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2025-02-29',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2024-02-30',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice accepts leap year dates', () => {
+  const result = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2024-02-29',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.issueDate, '2024-02-29');
+});
+
+test('createInvoice checks customer exists', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'NONEXISTENT',
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  }), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice validates qty is a positive integer', () => {
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 0 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: -1 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1.5 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 'abc' }],
+  }), { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice checks SKU exists in catalogue', () => {
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: 'NONEXISTENT', qty: 1 }],
+  }), { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, firstCustomer.id);
+  assert.equal(result.value.issueDate, '2026-01-01');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+
+  const line = result.value.lines[0];
+  assert.equal(line.sku, firstProduct.sku);
+  assert.equal(line.name, firstProduct.name);
+  assert.equal(line.qty, 5);
+  assert.equal(line.unitPrice, firstProduct.unitPrice);
+  assert.equal(line.vatRate, firstProduct.vatRate);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const products = listProducts();
+  const result = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: products[0].sku, qty: 2 },
+      { sku: products[1].sku, qty: 3 },
+      { sku: products[2].sku, qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].qty, 2);
+  assert.equal(result.value.lines[1].qty, 3);
+  assert.equal(result.value.lines[2].qty, 1);
+});
+
+test('createInvoice does not mutate input', () => {
+  const inputLines = [{ sku: firstProduct.sku, qty: 1 }];
+  const inputLinesCopy = JSON.parse(JSON.stringify(inputLines));
+
+  createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: inputLines,
+  });
+
+  assert.deepEqual(inputLines, inputLinesCopy);
+});
