+test('lineTotal returns whole cents', () => {
+  assert.equal(typeof lineTotal({ qty: 1, unitPrice: 100 }), 'number');
+  assert.ok(Number.isInteger(lineTotal({ qty: 1, unitPrice: 100 })));
+});
+
+test('invoiceTotals calculates subtotal from line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 1000 },
+      { qty: 3, unitPrice: 2000 },
+      { qty: 1, unitPrice: 500 },
+    ],
