+test('lineTotal calculates qty × unitPrice', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 8500 }), 8500);
+  assert.equal(lineTotal({ qty: 5, unitPrice: 1000 }), 5000);
+  assert.equal(lineTotal({ qty: 2, unitPrice: 2500 }), 5000);
