+++ b/test/numbering.test.js
@@ -0,0 +1,67 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const result = nextInvoiceNumber([], '2026-01-01');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const result = nextInvoiceNumber(existing, '2026-05-15');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber zero-pads to 4 digits', () => {
+  const existing = ['INV-2026-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2026-01-01'), 'INV-2026-0002');
+
+  const existing2 = ['INV-2026-0099'];
+  assert.equal(nextInvoiceNumber(existing2, '2026-01-01'), 'INV-2026-0100');
+
+  const existing3 = ['INV-2026-0999'];
+  assert.equal(nextInvoiceNumber(existing3, '2026-01-01'), 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2026-0001',
+    'INV-2026-0002',
+    'INV-2027-0001',
+  ];
+  const result = nextInvoiceNumber(existing, '2026-06-30');
+  assert.equal(result, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0999', 'INV-2026-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2025-12-31'), 'INV-2025-1000');
+  assert.equal(nextInvoiceNumber(existing, '2026-01-01'), 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles unordered numbers', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0005', 'INV-2026-0002'];
+  const result = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(result, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = [
+    'INV-2026-0001',
+    'INVALID',
+    'INV-2026-ABC',
+    'INV-2026-',
+  ];
+  const result = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber extracts year from issueDate correctly', () => {
+  const existing = ['INV-2026-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2026-06-15'), 'INV-2026-0002');
+  assert.equal(nextInvoiceNumber(existing, '2025-01-01'), 'INV-2025-0001');
+  assert.equal(nextInvoiceNumber(existing, '2027-12-31'), 'INV-2027-0001');
+});
