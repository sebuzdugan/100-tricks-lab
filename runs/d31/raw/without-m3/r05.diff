+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+import { formatEuros } from '../src/money.js';
+
+const firstCustomer = listCustomers()[0];
+const products = listProducts();
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [{ sku: products[0].sku, qty: 2 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], firstCustomer.name);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [{ sku: products[0].sku, qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  const text = renderInvoiceText(issuedInvoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0001');
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [{ sku: products[0].sku, qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes(firstCustomer.name));
+});
+
+test('renderInvoiceText shows one line per invoice line', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: products[0].sku, qty: 2 },
+      { sku: products[1].sku, qty: 3 },
+      { sku: products[2].sku, qty: 1 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n').filter((l) => l.trim());
+
+  // Should have: number/DRAFT, customer, line1, line2, line3, total = 6 lines
+  assert.equal(lines.length, 6);
+});
+
+test('renderInvoiceText formats quantities correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: products[0].sku, qty: 1 },
+      { sku: products[1].sku, qty: 5 },
+      { sku: products[2].sku, qty: 10 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('1x'));
+  assert.ok(text.includes('5x'));
+  assert.ok(text.includes('10x'));
+});
+
+test('renderInvoiceText shows product names', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: products[0].sku, qty: 1 },
+      { sku: products[1].sku, qty: 1 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes(products[0].name));
+  assert.ok(text.includes(products[1].name));
+});
+
+test('renderInvoiceText formats unit prices with formatEuros', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [{ sku: products[0].sku, qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const expectedPrice = formatEuros(products[0].unitPrice);
+  assert.ok(text.includes(expectedPrice));
+});
+
+test('renderInvoiceText formats line totals with formatEuros', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [{ sku: products[0].sku, qty: 3 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lineTotal = products[0].unitPrice * 3;
+  const expectedTotal = formatEuros(lineTotal);
+  assert.ok(text.includes(expectedTotal));
+});
+
+test('renderInvoiceText shows total at the end', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: products[0].sku, qty: 2 },
+      { sku: products[1].sku, qty: 1 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Total:'));
+
+  const lines = text.split('\n');
+  const lastLine = lines[lines.length - 1];
+  assert.ok(lastLine.startsWith('Total:'));
+});
+
+test('renderInvoiceText produces valid output format', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-06-15',
+    lines: [
+      { sku: products[0].sku, qty: 2 },
+      { sku: products[1].sku, qty: 1 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Check structure
+  assert.ok(lines[0] === 'DRAFT');
+  assert.ok(lines[1] === firstCustomer.name);
+  assert.ok(lines[2] === '');
+  assert.ok(lines[3].includes('2x'));
+  assert.ok(lines[4].includes('1x'));
+  assert.ok(lines[5] === '');
+  assert.ok(lines[6].startsWith('Total:'));
+});
+
+test('renderInvoiceText handles issued invoice with full data', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-12-25',
+    lines: [
+      { sku: products[0].sku, qty: 1 },
+      { sku: products[1].sku, qty: 2 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const issuedResult = issueInvoice(invoice, ['INV-2026-0001']);
+  const issuedInvoice = issuedResult.value;
+
+  const text = renderInvoiceText(issuedInvoice);
+
+  assert.ok(text.includes('INV-2026-0002'));
+  assert.ok(text.includes(firstCustomer.name));
+  assert.ok(text.includes(products[0].name));
+  assert.ok(text.includes(products[1].name));
+  assert.ok(text.includes('1x'));
+  assert.ok(text.includes('2x'));
+  assert.ok(text.includes('Total:'));
+});
+
+test('renderInvoiceText all amounts use formatEuros', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: products[0].sku, qty: 5 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  // All amounts should start with €
+  const amountLines = text.split('\n').filter((l) => l.includes('@'));
+  for (const line of amountLines) {
+    assert.ok(line.includes('€'));
+  }
+
+  const totalLine = text.split('\n').find((l) => l.startsWith('Total:'));
+  assert.ok(totalLine.includes('€'));
+});
