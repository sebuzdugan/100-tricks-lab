+
+test('renderInvoiceText shows discount summary', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: products[0].sku, qty: 2, discountPercent: 20 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
