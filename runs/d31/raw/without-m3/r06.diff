diff --git a/test/invoices.test.js b/test/invoices.test.js
index cda5f02..8c843a0 100644
--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -482,3 +482,195 @@ test('issueInvoice does not mutate the input invoice', () => {
   assert.equal(invoice.status, 'draft');
   assert.equal(Object.hasOwn(invoice, 'number'), false);
 });
+
+test('createInvoice accepts valid discountPercent', () => {
+  const result = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 10 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice accepts decimal discounts', () => {
+  const result = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 12.5 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 12.5);
+});
+
+test('createInvoice accepts edge case discounts (0 and 100)', () => {
+  const result0 = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(result0.ok, true);
+
+  const result100 = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 100 }],
+  });
+  assert.equal(result100.ok, true);
+});
+
+test('createInvoice rejects invalid discountPercent', () => {
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: -1 }],
+  }), { ok: false, error: 'DISCOUNT_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 101 }],
+  }), { ok: false, error: 'DISCOUNT_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 'fifty' }],
+  }), { ok: false, error: 'DISCOUNT_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: null }],
+  }), { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('createInvoice omits discountPercent if not provided', () => {
+  const result = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  });
+  assert.equal(Object.hasOwn(result.value.lines[0], 'discountPercent'), false);
+});
+
+test('addLine accepts valid discountPercent', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const result = addLine(invoice, { sku: listProducts()[1].sku, qty: 1, discountPercent: 25 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 25);
+});
+
+test('addLine rejects invalid discountPercent', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+
+  assert.deepEqual(addLine(invoice, { sku: listProducts()[1].sku, qty: 1, discountPercent: 101 }), { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('addLine updates discountPercent on existing line', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 10 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const result = addLine(invoice, { sku: firstProduct.sku, qty: 1, discountPercent: 20 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].qty, 2);
+  assert.equal(result.value.lines[0].discountPercent, 20);
+});
+
+test('addLine preserves existing discountPercent when not provided', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 15 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const result = addLine(invoice, { sku: firstProduct.sku, qty: 2 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].qty, 3);
+  assert.equal(result.value.lines[0].discountPercent, 15);
+});
+
+test('invoiceTotals returns discount and total', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: firstProduct.sku, qty: 1, discountPercent: 10 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, firstProduct.unitPrice);
+  assert.ok(totals.discount > 0);
+  assert.equal(totals.total, totals.subtotal - totals.discount);
+});
+
+test('invoiceTotals calculates discount correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: firstProduct.sku, qty: 10, discountPercent: 50 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const totals = invoiceTotals(invoice);
+  const expectedSubtotal = firstProduct.unitPrice * 10;
+  const expectedDiscount = expectedSubtotal * 0.5;
+  const expectedTotal = expectedSubtotal - expectedDiscount;
+
+  assert.equal(totals.subtotal, expectedSubtotal);
+  assert.equal(totals.discount, expectedDiscount);
+  assert.equal(totals.total, expectedTotal);
+});
+
+test('invoiceTotals clamps total at 0', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: firstProduct.sku, qty: 1, discountPercent: 100 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+  assert.equal(totals.discount, totals.subtotal);
+});
+
+test('invoiceTotals handles mixed discounts', () => {
+  const products = listProducts();
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: products[0].sku, qty: 2, discountPercent: 10 },
+      { sku: products[1].sku, qty: 1, discountPercent: 20 },
+      { sku: products[2].sku, qty: 1 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.total < totals.subtotal);
+});
