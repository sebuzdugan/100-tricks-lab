+
+test('createInvoice applies tier discount when no discountPercent provided', () => {
+  const customers = listCustomers();
+  const goldCustomer = customers.find((c) => c.tier === 'gold');
+  const silverCustomer = customers.find((c) => c.tier === 'silver');
+  const standardCustomer = customers.find((c) => c.tier === 'standard');
+
+  const goldResult = createInvoice({
+    customerId: goldCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  });
+  assert.equal(goldResult.value.lines[0].discountPercent, 5);
+
+  const silverResult = createInvoice({
+    customerId: silverCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  });
+  assert.equal(silverResult.value.lines[0].discountPercent, 2.5);
+
+  const standardResult = createInvoice({
+    customerId: standardCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1 }],
+  });
+  // Standard tier has 0 discount, so discountPercent should not be set
+  assert.equal(Object.hasOwn(standardResult.value.lines[0], 'discountPercent'), false);
+});
+
+test('createInvoice explicit discountPercent overrides tier discount', () => {
+  const customers = listCustomers();
+  const goldCustomer = customers.find((c) => c.tier === 'gold');
+
+  const result = createInvoice({
+    customerId: goldCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 10 }],
+  });
+
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice zero discountPercent overrides tier discount', () => {
+  const customers = listCustomers();
+  const goldCustomer = customers.find((c) => c.tier === 'gold');
+
+  const result = createInvoice({
+    customerId: goldCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  });
+
+  // Explicit 0 should not set discountPercent property
+  assert.equal(Object.hasOwn(result.value.lines[0], 'discountPercent'), false);
+});
+
+test('createInvoice applies tier discount to multiple lines', () => {
+  const customers = listCustomers();
+  const goldCustomer = customers.find((c) => c.tier === 'gold');
+  const products = listProducts();
+
+  const result = createInvoice({
+    customerId: goldCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: products[0].sku, qty: 1 },
+      { sku: products[1].sku, qty: 1 },
+      { sku: products[2].sku, qty: 1 },
+    ],
+  });
+
+  assert.equal(result.value.lines[0].discountPercent, 5);
+  assert.equal(result.value.lines[1].discountPercent, 5);
+  assert.equal(result.value.lines[2].discountPercent, 5);
+});
+
+test('createInvoice applies tier discount with mixed explicit discounts', () => {
+  const customers = listCustomers();
+  const silverCustomer = customers.find((c) => c.tier === 'silver');
+  const products = listProducts();
+
+  const result = createInvoice({
+    customerId: silverCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: products[0].sku, qty: 1 },
+      { sku: products[1].sku, qty: 1, discountPercent: 10 },
+      { sku: products[2].sku, qty: 1, discountPercent: 0 },
+    ],
+  });
+
+  // Line 1: tier discount (silver = 2.5%)
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+  // Line 2: explicit discount wins
+  assert.equal(result.value.lines[1].discountPercent, 10);
+  // Line 3: explicit 0 discount (no property set)
+  assert.equal(Object.hasOwn(result.value.lines[2], 'discountPercent'), false);
+});
