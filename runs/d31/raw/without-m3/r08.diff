 /**
  * Calculate the totals for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }} All in cents, never below 0
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }} All in cents, never below 0
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
@@ -121,11 +121,20 @@ export function invoiceTotals(invoice) {
     return sum + lineDiscount;
   }, 0);
 
-  const total = Math.max(0, subtotal - discount);
+  const vat = invoice.lines.reduce((sum, line) => {
+    const lineTot = lineTotal(line);
+    const lineDiscount = roundCents((lineTot * (line.discountPercent || 0)) / 100);
+    const lineAfterDiscount = lineTot - lineDiscount;
+    const lineVAT = roundCents((lineAfterDiscount * line.vatRate) / 100);
+    return sum + lineVAT;
+  }, 0);
+
+  const total = Math.max(0, subtotal - discount + vat);
 
   return {
     subtotal,
     discount,
+    vat,
     total,
   };
 }
