+
+test('invoiceTotals calculates VAT on amount after discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: firstProduct.sku, qty: 100, discountPercent: 50 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const totals = invoiceTotals(invoice);
+  // Line: 100 * unitPrice * 50% discount = 50% of line total
+  // VAT = 50% of line total * vatRate / 100
+  const lineTotal = firstProduct.unitPrice * 100;
+  const afterDiscount = lineTotal * 0.5;
+  const expectedVAT = Math.round((afterDiscount * firstProduct.vatRate) / 100);
+
+  assert.equal(totals.vat, expectedVAT);
+});
+
+test('invoiceTotals VAT is sum of per-line VATs', () => {
+  const products = listProducts();
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: products[0].sku, qty: 10, discountPercent: 0 },
+      { sku: products[1].sku, qty: 5, discountPercent: 0 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.total, totals.subtotal + totals.vat);
+});
+
+test('invoiceTotals with no VAT', () => {
+  // Find a product with 0% VAT
+  const products = listProducts();
+  const zeroVATProduct = products.find((p) => p.vatRate === 0);
+
+  if (zeroVATProduct) {
+    const invoiceResult = createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-01',
+      lines: [{ sku: zeroVATProduct.sku, qty: 1, discountPercent: 0 }],
+    });
+    const invoice = invoiceResult.value;
+
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, totals.subtotal - totals.discount);
+  }
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: firstProduct.sku, qty: 100, discountPercent: 20 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat);
+});
