+
+test('invoiceTotals includes VAT in total', () => {
+  const invoiceResult = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: firstProduct.sku, qty: 1, discountPercent: 0 },
