+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('  C-003  '), 'C-003');
+  assert.equal(normalizeId('\tC-003\n'), 'C-003');
+  assert.equal(normalizeId(' c-003 '), 'C-003');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-003'), 'C-003');
+  assert.equal(normalizeId('C-003'), 'C-003');
+  assert.equal(normalizeId('c-003'), 'C-003');
+});
+
+test('normalizeId handles mixed case and spaces', () => {
+  assert.equal(normalizeId('  c-003  '), 'C-003');
+  assert.equal(normalizeId(' C-007 '), 'C-007');
+});
+
+test('getCustomer accepts mixed case and spaces', () => {
+  const result = getCustomer('  c-003  ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Kite & Co');
+});
+
+test('getCustomer finds customer with lowercase and spaces', () => {
+  const result = getCustomer(' c-007 ');
+  assert.equal(result.ok, true);
+  assert.ok(result.value.name);
+});
