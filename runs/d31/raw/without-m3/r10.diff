new file mode 100644
index 0000000..2f12ef4
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,52 @@
+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const regex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!regex.test(text)) {
+    return false;
+  }
+
+  const date = new Date(text + 'T00:00:00Z');
+  const [year, month, day] = text.split('-').map(Number);
+
+  return (
+    !isNaN(date.getTime()) &&
+    date.getUTCFullYear() === year &&
+    date.getUTCMonth() + 1 === month &&
+    date.getUTCDate() === day
+  );
+}
+
+/**
+ * Add days to a date (in UTC).
+ * @param {string} date Date in YYYY-MM-DD format
+ * @param {number} n Number of days to add (can be negative)
+ * @returns {string} New date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const utcDate = new Date(date + 'T00:00:00Z');
+  utcDate.setUTCDate(utcDate.getUTCDate() + n);
+
+  const year = utcDate.getUTCFullYear();
+  const month = String(utcDate.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(utcDate.getUTCDate()).padStart(2, '0');
+
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate days between two dates (in UTC).
+ * @param {string} a Start date in YYYY-MM-DD format
+ * @param {string} b End date in YYYY-MM-DD format
+ * @returns {number} Days between (b - a), in whole days
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB - dateA) / msPerDay);
+}
