diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..f4b32ae
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,108 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('1999-12-31'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('01-01-2026'), false);
+  assert.equal(isValidDate('2026/01/01'), false);
+  assert.equal(isValidDate('2026-1-1'), false);
+  assert.equal(isValidDate('2026-01-1'), false);
+  assert.equal(isValidDate('2026-1-01'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2024-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+});
+
+test('isValidDate handles leap years', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-02-29'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-01-01', 1), '2026-01-02');
+  assert.equal(addDays('2026-01-01', 10), '2026-01-11');
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays subtracts with negative days', () => {
+  assert.equal(addDays('2026-01-02', -1), '2026-01-01');
+  assert.equal(addDays('2026-02-01', -1), '2026-01-31');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles zero', () => {
+  assert.equal(addDays('2026-06-15', 0), '2026-06-15');
+});
+
+test('addDays crosses month boundaries', () => {
+  assert.equal(addDays('2026-01-28', 3), '2026-01-31');
+  assert.equal(addDays('2026-01-30', 3), '2026-02-02');
+  assert.equal(addDays('2026-03-30', 2), '2026-04-01');
+});
+
+test('addDays crosses year boundaries', () => {
+  assert.equal(addDays('2025-12-25', 7), '2026-01-01');
+  assert.equal(addDays('2026-01-01', -7), '2025-12-25');
+});
+
+test('addDays handles leap year transition', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+});
+
+test('daysBetween calculates days forward', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+  assert.equal(daysBetween('2026-01-01', '2026-01-11'), 10);
+  assert.equal(daysBetween('2026-01-01', '2026-02-01'), 31);
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+});
+
+test('daysBetween calculates days backward', () => {
+  assert.equal(daysBetween('2026-01-02', '2026-01-01'), -1);
+  assert.equal(daysBetween('2026-02-01', '2026-01-01'), -31);
+  assert.equal(daysBetween('2027-01-01', '2026-01-01'), -365);
+});
+
+test('daysBetween same date returns 0', () => {
+  assert.equal(daysBetween('2026-06-15', '2026-06-15'), 0);
+});
+
+test('daysBetween returns whole days', () => {
+  // Since we use UTC at 00:00:00, this should always be whole days
+  assert.equal(typeof daysBetween('2026-01-01', '2026-01-05'), 'number');
+  assert.ok(Number.isInteger(daysBetween('2026-01-01', '2026-01-05')));
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-01-31', '2026-03-01'), 29);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2025-12-31', '2026-12-31'), 365);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
