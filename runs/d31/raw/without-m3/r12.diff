-import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+import { isValidDate, addDays, daysBetween, getLastDayOfMonth } from '../src/dates.js';
 
 test('isValidDate accepts valid dates', () => {
   assert.equal(isValidDate('2026-01-01'), true);
@@ -106,3 +106,34 @@ test('daysBetween handles leap years', () => {
   assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
   assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
 });
+
+test('getLastDayOfMonth returns last day of month', () => {
+  assert.equal(getLastDayOfMonth('2026-01-15'), '2026-01-31');
+  assert.equal(getLastDayOfMonth('2026-02-15'), '2026-02-28');
+  assert.equal(getLastDayOfMonth('2026-03-15'), '2026-03-31');
+  assert.equal(getLastDayOfMonth('2026-04-15'), '2026-04-30');
+  assert.equal(getLastDayOfMonth('2026-12-15'), '2026-12-31');
+});
+
+test('getLastDayOfMonth handles month-end dates', () => {
+  assert.equal(getLastDayOfMonth('2026-01-31'), '2026-01-31');
+  assert.equal(getLastDayOfMonth('2026-04-30'), '2026-04-30');
+  assert.equal(getLastDayOfMonth('2026-12-31'), '2026-12-31');
+});
+
+test('getLastDayOfMonth handles leap year February', () => {
+  assert.equal(getLastDayOfMonth('2024-02-15'), '2024-02-29');
+  assert.equal(getLastDayOfMonth('2025-02-15'), '2025-02-28');
+  assert.equal(getLastDayOfMonth('2000-02-15'), '2000-02-29');
+  assert.equal(getLastDayOfMonth('1900-02-15'), '1900-02-28');
+});
+
+test('getLastDayOfMonth handles all months', () => {
+  const lastDays = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+  for (let month = 1; month <= 12; month++) {
+    const dateStr = `2026-${String(month).padStart(2, '0')}-15`;
+    const result = getLastDayOfMonth(dateStr);
+    const expectedDay = lastDays[month - 1];
+    assert.equal(result, `2026-${String(month).padStart(2, '0')}-${String(expectedDay).padStart(2, '0')}`);
+  }
+});
