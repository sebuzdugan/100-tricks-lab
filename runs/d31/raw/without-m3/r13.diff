+
+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {import('./result.js').Result}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check status is 'draft'
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Check if voucher already exists
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Create new invoice with voucher
+  const newInvoice = {
+    ...invoice,
+    voucher: { code, amount },
+  };
+
+  return ok(newInvoice);
+}
