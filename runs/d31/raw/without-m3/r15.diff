diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..27897c1
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,243 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+
+const firstCustomer = listCustomers()[0];
+const firstProduct = listProducts()[0];
+
+test('createCreditNote requires issued, partially_paid or paid status', () => {
+  const draft = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  assert.deepEqual(
+    createCreditNote(draft, { amount: 500, reason: 'Damaged', date: '2026-01-02' }, []),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('createCreditNote creates credit on issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = createCreditNote(issued, { amount: 500, reason: 'Damaged', date: '2026-01-02' }, [issued.number]);
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.number.startsWith('CN-2026-'));
+});
+
+test('createCreditNote creates credit on partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const partial = recordPayment(issued, { amount: 1000, date: '2026-01-02' }).value;
+
+  const result = createCreditNote(partial, { amount: 500, reason: 'Partial refund', date: '2026-01-03' }, [
+    issued.number,
+  ]);
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.number.startsWith('CN-'));
+});
+
+test('createCreditNote creates credit on paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-01-02' }).value;
+
+  const result = createCreditNote(paid, { amount: 500, reason: 'Overpayment', date: '2026-01-03' }, [
+    issued.number,
+  ]);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote validates amount is positive integer', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(createCreditNote(issued, { amount: 0, reason: 'Test', date: '2026-01-02' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: -100, reason: 'Test', date: '2026-01-02' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: 100.5, reason: 'Test', date: '2026-01-02' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: 'abc', reason: 'Test', date: '2026-01-02' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('createCreditNote rejects credit amount exceeding invoice total', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  assert.deepEqual(
+    createCreditNote(issued, { amount: totals.total + 1000, reason: 'Too much', date: '2026-01-02' }, []),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
+
+test('createCreditNote includes correct fields', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = createCreditNote(issued, { amount: 500, reason: 'Damaged item', date: '2026-01-02' }, [
+    issued.number,
+  ]);
+
+  const credit = result.value;
+  assert.ok(credit.number);
+  assert.equal(credit.invoiceNumber, issued.number);
+  assert.equal(credit.customerId, firstCustomer.id);
+  assert.equal(credit.amount, 500);
+  assert.equal(credit.reason, 'Damaged item');
+  assert.equal(credit.date, '2026-01-02');
+});
+
+test('createCreditNote numbers increment separately from invoices', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-01',
+      lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-02',
+      lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const credit1 = createCreditNote(inv1, { amount: 500, reason: 'Credit 1', date: '2026-01-03' }, [
+    inv1.number,
+    inv2.number,
+  ]).value;
+
+  const credit2 = createCreditNote(inv2, { amount: 500, reason: 'Credit 2', date: '2026-01-04' }, [
+    inv1.number,
+    inv2.number,
+    credit1.number,
+  ]).value;
+
+  assert.equal(credit1.number, 'CN-2026-0001');
+  assert.equal(credit2.number, 'CN-2026-0002');
+});
+
+test('createCreditNote uses separate counter per year', () => {
+  const inv2026 = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-01',
+      lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2027 = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2027-01-01',
+      lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+    }).value,
+    [inv2026.number]
+  ).value;
+
+  const credit2026 = createCreditNote(inv2026, { amount: 500, reason: 'Credit 2026', date: '2026-01-02' }, [
+    inv2026.number,
+    inv2027.number,
+  ]).value;
+
+  const credit2027 = createCreditNote(inv2027, { amount: 500, reason: 'Credit 2027', date: '2027-01-02' }, [
+    inv2026.number,
+    inv2027.number,
+    credit2026.number,
+  ]).value;
+
+  assert.equal(credit2026.number, 'CN-2026-0001');
+  assert.equal(credit2027.number, 'CN-2027-0001');
+});
+
+test('createCreditNote allows full credit amount (equals invoice total)', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: totals.total, reason: 'Full refund', date: '2026-01-02' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote with invoice having discount and VAT', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 20 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: Math.floor(totals.total / 2), reason: 'Partial refund', date: '2026-01-02' }, [
+    issued.number,
+  ]);
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.amount > 0);
+  assert.ok(result.value.amount < totals.total);
+});
