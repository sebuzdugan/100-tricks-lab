+++ b/test/reports.test.js
@@ -0,0 +1,228 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+
+const firstCustomer = listCustomers()[0];
+const secondCustomer = listCustomers()[1];
+const firstProduct = listProducts()[0];
+
+test('overdueInvoices returns empty for no overdue invoices', () => {
+  const result = overdueInvoices([], '2026-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const result = overdueInvoices([draft], '2026-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-01-02' }).value;
+
+  const result = overdueInvoices([paid], '2026-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes issued invoices that are overdue', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = overdueInvoices([issued], '2026-03-01');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.number);
+});
+
+test('overdueInvoices includes partially_paid invoices that are overdue', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const partial = recordPayment(issued, { amount: 1000, date: '2026-01-02' }).value;
+
+  const result = overdueInvoices([partial], '2026-03-01');
+
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices excludes invoices with dueDate >= asOf', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  // asOf is equal to dueDate (not overdue yet)
+  const result1 = overdueInvoices([issued], issued.dueDate);
+  assert.deepEqual(result1, []);
+
+  // asOf is before dueDate (not overdue)
+  const result2 = overdueInvoices([issued], '2026-01-15');
+  assert.deepEqual(result2, []);
+});
+
+test('overdueInvoices includes invoices with dueDate < asOf', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const nextDay = new Date('2026-02-01');
+  nextDay.setUTCDate(nextDay.getUTCDate() + 1);
+  const asOf = `${nextDay.getUTCFullYear()}-${String(nextDay.getUTCMonth() + 1).padStart(2, '0')}-${String(nextDay.getUTCDate()).padStart(2, '0')}`;
+
+  const result = overdueInvoices([issued], asOf);
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = overdueInvoices([issued], '2026-02-10');
+
+  assert.equal(result[0].daysOverdue, 10);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-01',
+      lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-10',
+      lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-20',
+      lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+    }).value,
+    [inv1.number, inv2.number]
+  ).value;
+
+  const result = overdueInvoices([inv1, inv2, inv3], '2026-03-01');
+
+  assert.equal(result.length, 3);
+  assert.equal(result[0].number, inv1.number);
+  assert.equal(result[1].number, inv2.number);
+  assert.equal(result[2].number, inv3.number);
+});
+
+test('overdueInvoices includes correct fields', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = overdueInvoices([issued], '2026-03-01');
+
+  const inv = result[0];
+  assert.ok(inv.number);
+  assert.equal(inv.customerId, firstCustomer.id);
+  assert.ok(inv.dueDate);
+  assert.ok(typeof inv.daysOverdue === 'number');
+  assert.ok(typeof inv.due === 'number');
+});
+
+test('overdueInvoices calculates due amount correctly', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  const partial = recordPayment(issued, { amount: 5000, date: '2026-01-02' }).value;
+  const result = overdueInvoices([partial], '2026-03-01');
+
+  assert.equal(result[0].due, totals.total - 5000);
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-01',
+      lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: secondCustomer.id,
+      issueDate: '2026-01-01',
+      lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const result = overdueInvoices([inv1, inv2], '2026-03-01');
+
+  assert.equal(result.length, 2);
+  assert.ok(result.some((inv) => inv.customerId === firstCustomer.id));
+  assert.ok(result.some((inv) => inv.customerId === secondCustomer.id));
+});
+
+test('overdueInvoices with deeply overdue invoices', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2025-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = overdueInvoices([issued], '2026-12-31');
+
+  assert.equal(result.length, 1);
+  assert.ok(result[0].daysOverdue > 300);
+});
