+/**
+ * Get VAT summary by rate for issued, partially_paid and paid invoices.
+ * @param {Array} invoices All invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const lineTot = lineTotal(line);
+      const lineDiscount = roundCents((lineTot * (line.discountPercent || 0)) / 100);
+      const base = lineTot - lineDiscount;
+      const lineVAT = roundCents((base * line.vatRate) / 100);
+
+      const rate = line.vatRate;
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { base: 0, vat: 0 };
+      }
+      vatByRate[rate].base += base;
+      vatByRate[rate].vat += lineVAT;
+    }
+  }
+
+  return Object.entries(vatByRate)
+    .map(([rate, { base, vat }]) => ({
+      rate: Number(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
