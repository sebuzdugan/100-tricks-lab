+test('lateFee calculates fee for overdue invoice', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  // dueDate is 2026-01-31 (NET30), so 2026-02-10 is 10 days overdue
+  const result = lateFee(issued, '2026-02-10');
+
+  // 10 days overdue, 0.04% per day
+  const expectedFee = Math.round((totals.total * 10 * 0.04) / 100);
+  assert.equal(result, expectedFee);
+});
