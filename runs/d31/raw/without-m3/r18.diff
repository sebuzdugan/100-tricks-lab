+/**
+ * Calculate late fee for an invoice: 0.04% per day of balance due.
+ * @param {{ status: string, dueDate: string }} invoice
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+
+  return roundCents((due * daysOverdue * 0.04) / 100);
+}
