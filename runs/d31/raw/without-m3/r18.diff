+test('lateFee uses balance due (respects partial payments)', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const partial = recordPayment(issued, { amount: Math.floor(totals.total / 2), date: '2026-01-02' }).value;
+
+  // dueDate is 2026-01-31, so 2026-02-10 is 10 days overdue
+  const fee = lateFee(partial, '2026-02-10');
+
+  // 10 days overdue, 0.04% per day, on remaining balance
+  const remainingBalance = totals.total - Math.floor(totals.total / 2);
+  const expectedFee = Math.round((remainingBalance * 10 * 0.04) / 100);
+
+  assert.equal(fee, expectedFee);
+});
