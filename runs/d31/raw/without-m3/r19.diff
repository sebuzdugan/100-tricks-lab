+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+
+const firstCustomer = listCustomers()[0];
+const secondCustomer = listCustomers()[1];
+const firstProduct = listProducts()[0];
+
+function parseCSVLine(line) {
+  const result = [];
+  let current = '';
+  let inQuotes = false;
+
+  for (let i = 0; i < line.length; i++) {
+    const char = line[i];
+    const nextChar = line[i + 1];
+
+    if (char === '"') {
+      if (inQuotes && nextChar === '"') {
+        current += '"';
+        i++;
+      } else {
+        inQuotes = !inQuotes;
+      }
+    } else if (char === ',' && !inQuotes) {
+      result.push(current);
+      current = '';
+    } else {
+      current += char;
+    }
+  }
+
+  result.push(current);
+  return result;
+}
+
+test('exportCsv returns header for empty invoices', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv includes single invoice', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].includes(issued.number));
+  assert.ok(lines[1].includes(firstCustomer.name));
+});
+
+test('exportCsv includes multiple invoices in order', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-01',
+      lines: [{ sku: firstProduct.sku, qty: 50, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: secondCustomer.id,
+      issueDate: '2026-01-02',
+      lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert.ok(lines[1].includes(inv1.number));
+  assert.ok(lines[2].includes(inv2.number));
+});
+
+test('exportCsv formats amounts with 2 decimal places', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const columns = parseCSVLine(lines[1]);
+
+  // All amount columns should have .XX format
+  for (let i = 5; i < 10; i++) {
+    assert.match(columns[i], /^\d+\.\d{2}$/);
+  }
+});
+
+test('exportCsv includes correct columns', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const columns = parseCSVLine(lines[1]);
+
+  assert.equal(columns[0], issued.number);
+  assert.equal(columns[1], firstCustomer.name);
+  assert.equal(columns[2], issued.issueDate);
+  assert.equal(columns[3], issued.dueDate);
+  assert.equal(columns[4], issued.status);
+});
+
+test('exportCsv includes due amount for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const columns = parseCSVLine(lines[1]);
+  const due = parseFloat(columns[9]);
+
+  assert.equal(due, totals.total / 100);
+});
+
+test('exportCsv includes due amount for partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2026-01-02' }).value;
+  const result = exportCsv([partial]);
+
+  const lines = result.split('\n');
+  const columns = parseCSVLine(lines[1]);
+  const due = parseFloat(columns[9]);
+
+  const totalInEuros = invoiceTotals(issued).total / 100;
+  const expectedDue = totalInEuros - 50;
+
+  assert.equal(due, expectedDue);
+});
+
+test('exportCsv includes due amount 0 for paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-01-02' }).value;
+  const result = exportCsv([paid]);
+
+  const lines = result.split('\n');
+  const columns = parseCSVLine(lines[1]);
+  const due = parseFloat(columns[9]);
+
+  assert.equal(due, 0);
+});
+
+test('exportCsv handles customer names with commas', () => {
+  const invoice = createInvoice({
+    customerId: secondCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
