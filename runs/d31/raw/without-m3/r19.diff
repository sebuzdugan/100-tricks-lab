+    assert.ok(lines[1].includes(`"${secondCustomer.name}"`));
+  }
+});
+
+test('exportCsv handles customer names with double quotes', () => {
+  // This test assumes we might have a customer with quotes in the name
+  // For now, we just test that the escaping function works
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
