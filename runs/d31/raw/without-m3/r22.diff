+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single invoice line.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} All in cents, never below 0
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+
+  const discount = invoice.lines.reduce((sum, line) => {
+    const lineDiscount = roundCents((lineTotal(line) * (line.discountPercent || 0)) / 100);
+    return sum + lineDiscount;
+  }, 0);
+
+  const vat = invoice.lines.reduce((sum, line) => {
+    const lineTot = lineTotal(line);
+    const lineDiscount = roundCents((lineTot * (line.discountPercent || 0)) / 100);
+    const lineAfterDiscount = lineTot - lineDiscount;
+    const lineVAT = roundCents((lineAfterDiscount * line.vatRate) / 100);
+    return sum + lineVAT;
+  }, 0);
+
+  const voucher = invoice.voucher?.amount || 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
