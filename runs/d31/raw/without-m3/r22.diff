+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+
+const firstCustomer = listCustomers()[0];
+const firstProduct = listProducts()[0];
+
+test('lineTotal calculates qty * unitPrice', () => {
+  const line = { qty: 100, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 100000);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { qty: 1, unitPrice: 5000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal rounds using banker\'s rounding', () => {
+  const line = { qty: 3, unitPrice: 10 };
+  assert.equal(lineTotal(line), 30);
+});
+
+test('lineTotal with fractional result', () => {
+  const line = { qty: 1, unitPrice: 3333 };
+  assert.equal(lineTotal(line), 3333);
+});
+
+test('invoiceTotals calculates subtotal', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  const expectedSubtotal = firstProduct.unitPrice * 100;
+
+  assert.equal(totals.subtotal, expectedSubtotal);
+});
+
+test('invoiceTotals calculates discount', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 20 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  const lineTotal_val = firstProduct.unitPrice * 100;
+  const expectedDiscount = Math.round((lineTotal_val * 20) / 100);
+
+  assert.equal(totals.discount, expectedDiscount);
+});
+
+test('invoiceTotals calculates VAT', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  const lineTotal_val = firstProduct.unitPrice * 100;
+  const expectedVAT = Math.round((lineTotal_val * firstProduct.vatRate) / 100);
+
+  assert.equal(totals.vat, expectedVAT);
+});
+
+test('invoiceTotals calculates VAT after discount', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 20 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+
+  const lineTotal_val = firstProduct.unitPrice * 100;
+  const discount = Math.round((lineTotal_val * 20) / 100);
+  const afterDiscount = lineTotal_val - discount;
+  const expectedVAT = Math.round((afterDiscount * firstProduct.vatRate) / 100);
+
+  assert.equal(totals.vat, expectedVAT);
+});
+
+test('invoiceTotals with no discount', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals without voucher', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals calculates total as subtotal - discount + vat - voucher', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  const expectedTotal = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+
+  assert.equal(totals.total, expectedTotal);
+});
+
+test('invoiceTotals returns all fields', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+
+  assert.ok(totals.hasOwnProperty('subtotal'));
+  assert.ok(totals.hasOwnProperty('discount'));
+  assert.ok(totals.hasOwnProperty('vat'));
+  assert.ok(totals.hasOwnProperty('voucher'));
+  assert.ok(totals.hasOwnProperty('total'));
+});
+
+test('invoiceTotals total never below zero', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+
+  assert.ok(totals.total >= 0);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const products = listProducts();
+  const lines = products.slice(0, 3).map((p) => ({
+    sku: p.sku,
+    qty: 10,
+    discountPercent: 0,
+  }));
+
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines,
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+
+  assert.ok(totals.subtotal > 0);
+  assert.ok(totals.total > 0);
+});
+
+test('invoiceTotals with mixed discounts', () => {
+  const products = listProducts();
+  const lines = [
+    { sku: products[0].sku, qty: 10, discountPercent: 0 },
+    { sku: products[1].sku, qty: 20, discountPercent: 10 },
+    { sku: products[2].sku, qty: 30, discountPercent: 20 },
+  ];
+
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines,
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+  assert.ok(totals.total > 0);
+});
+
+test('invoiceTotals all values are integers', () => {
+  const invoice = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+
+  assert.ok(Number.isInteger(totals.subtotal));
+  assert.ok(Number.isInteger(totals.discount));
+  assert.ok(Number.isInteger(totals.vat));
+  assert.ok(Number.isInteger(totals.voucher));
+  assert.ok(Number.isInteger(totals.total));
+});
+
+test('lineTotal and invoiceTotals are consistent', () => {
+  const line = { qty: 100, unitPrice: 1234, vatRate: 21, discountPercent: 10 };
+
+  const line_total = lineTotal(line);
+  assert.equal(line_total, 123400);
+});
+
+test('invoiceTotals with zero quantity line should still calculate', () => {
+  const line = { qty: 0, unitPrice: 1000, vatRate: 21 };
+  const line_total = lineTotal(line);
+  assert.equal(line_total, 0);
+});
+
+test('invoiceTotals reflects discount in total', () => {
+  const invoice1 = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: firstCustomer.id,
+    issueDate: '2026-01-01',
+    lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 20 }],
+  }).value;
+
+  const totals1 = invoiceTotals(invoice1);
+  const totals2 = invoiceTotals(invoice2);
+
+  assert.ok(totals1.total > totals2.total);
+});
+
+test('invoiceTotals with issued invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: firstCustomer.id,
+      issueDate: '2026-01-01',
+      lines: [{ sku: firstProduct.sku, qty: 100, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const totals = invoiceTotals(invoice);
+
+  assert.ok(totals.subtotal > 0);
+  assert.ok(totals.total > 0);
+});
