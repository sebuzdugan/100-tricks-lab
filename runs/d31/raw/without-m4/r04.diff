+++ b/src/numbering.js
@@ -0,0 +1,21 @@
+/**
+ * Calculate the next invoice number for a given date.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (e.g., ['INV-2026-0001', 'INV-2026-0003'])
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} - Next invoice number in format INV-YYYY-NNNN
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const yearPrefix = `INV-${year}-`;
+
+  const yearNumbers = existingNumbers.filter((num) => num.startsWith(yearPrefix));
+  const counters = yearNumbers.map((num) => {
+    const counterStr = num.substring(yearPrefix.length);
+    return Number(counterStr);
+  });
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${yearPrefix}${String(nextCounter).padStart(4, '0')}`;
+}
