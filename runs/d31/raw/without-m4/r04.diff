diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..326fa64
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,51 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns INV-YYYY-0001 for the first invoice of a year', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for the same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber restarts counter for a new year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const result = nextInvoiceNumber(existing, '2027-01-01');
+  assert.equal(result, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0099', 'INV-2026-0001', 'INV-2027-0050'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles unsorted numbers', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0005', 'INV-2026-0002'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003', 'INV-2026-0004', 'INV-2026-0005', 'INV-2026-0006', 'INV-2026-0007', 'INV-2026-0008', 'INV-2026-0009'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber works with large counters', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber extracts year correctly', () => {
+  const result1 = nextInvoiceNumber([], '2025-12-31');
+  const result2 = nextInvoiceNumber([], '2024-01-01');
+  assert.equal(result1, 'INV-2025-0001');
+  assert.equal(result2, 'INV-2024-0001');
+});
