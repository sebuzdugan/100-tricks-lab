+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+import { formatEuros } from './money.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const number = invoice.number ?? 'DRAFT';
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+  const totals = invoiceTotals(invoice);
+
+  const lines = [];
+  lines.push(number);
+  lines.push(customerName);
+  lines.push('');
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  lines.push('');
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..6f5dbeb
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,148 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('DRAFT\n'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  assert.ok(text.startsWith('INV-2026-0001\n'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText shows one line per invoice line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('5 × Design work (hour)'));
+  assert.ok(text.includes('3 × Development (hour)'));
+});
+
+test('renderInvoiceText formats prices as euros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€425.00'));
+});
+
+test('renderInvoiceText shows line totals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('= €425.00'));
+  assert.ok(text.includes('= €285.00'));
+});
+
+test('renderInvoiceText shows total at the end', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  const lastLine = lines[lines.length - 1];
+  assert.equal(lastLine, 'Total: €710.00');
+});
+
+test('renderInvoiceText handles single line invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.ok(lines[3].includes('Logo package'));
+  assert.equal(lines[5], 'Total: €1,200.00');
+});
+
+test('renderInvoiceText handles large quantities', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1000 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('1000 × Sticker sheet'));
+  assert.ok(text.includes('€500.00'));
+  assert.ok(text.includes('Total: €500.00'));
+});
+
+test('renderInvoiceText handles products with VAT rate 0', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Brand workshop (day, VAT exempt)'));
+  assert.ok(text.includes('€600.00'));
+  assert.ok(text.includes('Total: €1,200.00'));
+});
+
+test('renderInvoiceText shows all required fields', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 6);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '');
+  assert.ok(lines[3].includes('×'));
+  assert.ok(lines[3].includes('@'));
+  assert.ok(lines[3].includes('='));
+  assert.equal(lines[4], '');
+  assert.ok(lines[5].startsWith('Total:'));
+  assert.ok(lines[5].includes('€'));
+});
