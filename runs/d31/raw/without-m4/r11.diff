+++ b/src/payments.js
@@ -0,0 +1,63 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> } & ReturnType<invoiceTotals>} invoice
+ * @returns {number} - Amount due in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paidAmount = (invoice.payments ?? []).reduce((sum, payment) => sum + payment.amount, 0);
+  return Math.max(0, totals.total - paidAmount);
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {Object} invoice - The invoice
+ * @param {{ amount: number, date: string }} payment - Payment with amount in cents and date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: Object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const due = balanceDue(invoice);
+  if (amount > due) {
+    return fail('OVERPAYMENT');
+  }
+
+  const totals = invoiceTotals(invoice);
+  const existingPayments = (invoice.payments ?? []).map((p) => ({ ...p }));
+  existingPayments.push({ amount, date });
+  const totalPaid = existingPayments.reduce((sum, p) => sum + p.amount, 0);
+
+  let newStatus = 'partially_paid';
+  if (totalPaid >= totals.total) {
+    newStatus = 'paid';
+  }
+
+  const newInvoice = {
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: newStatus,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments: existingPayments,
+  };
+
+  if (invoice.number) {
+    newInvoice.number = invoice.number;
+  }
+
+  return ok(newInvoice);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
