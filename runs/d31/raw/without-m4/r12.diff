 }
+
+/**
+ * Calculate due date based on payment terms (in UTC).
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - Payment terms: 'NET14', 'NET30', or 'EOM'
+ * @returns {string|null} - Due date in YYYY-MM-DD format, or null if terms are invalid
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    const date = new Date(issueDate + 'T00:00:00Z');
+    const year = date.getUTCFullYear();
+    const month = date.getUTCMonth() + 1;
+    const lastDay = new Date(Date.UTC(year, month, 0)).getUTCDate();
+    const yearStr = year;
+    const monthStr = String(month).padStart(2, '0');
+    const dayStr = String(lastDay).padStart(2, '0');
+    return `${yearStr}-${monthStr}-${dayStr}`;
+  }
+  return null;
+}
