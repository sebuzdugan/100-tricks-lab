@@ -0,0 +1,151 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId = 'C-003', issueDate = '2026-10-07', lines = [{ sku: 'WORKSHOP-DAY', qty: 1 }]) {
+  const invoice = createInvoice({ customerId, issueDate, lines }).value;
+  return issueInvoice(invoice, []).value;
+}
+
+test('statement returns empty invoice list for customer with no outstanding invoices', () => {
+  const invoices = [];
+  const result = statement('C-003', invoices, '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes issued invoices', () => {
+  const inv = createAndIssueInvoice('C-003', '2026-10-07');
+  const result = statement('C-003', [inv], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, inv.number);
+});
+
+test('statement includes partially_paid invoices', () => {
+  let inv = createAndIssueInvoice('C-003', '2026-10-07');
+  inv = recordPayment(inv, { amount: 30000, date: '2026-10-08' }).value;
+  const result = statement('C-003', [inv], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert(result.value.invoices[0].due > 0);
+});
+
+test('statement excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+  const result = statement('C-003', [inv], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  let inv = createAndIssueInvoice('C-003', '2026-10-07');
+  inv = recordPayment(inv, { amount: 58500, date: '2026-10-08' }).value;
+  const result = statement('C-003', [inv], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement includes invoices with issueDate equal to asOf', () => {
+  const inv = createAndIssueInvoice('C-003', '2026-10-07');
+  const result = statement('C-003', [inv], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement excludes invoices with issueDate after asOf', () => {
+  const inv = createAndIssueInvoice('C-003', '2026-10-15');
+  const result = statement('C-003', [inv], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = createAndIssueInvoice('C-003', '2026-10-05');
+  const inv3 = createAndIssueInvoice('C-003', '2026-10-15');
+  const inv2 = createAndIssueInvoice('C-003', '2026-10-10');
+  const result = statement('C-003', [inv1, inv3, inv2], '2026-10-20');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-10');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement includes invoice fields', () => {
+  const inv = createAndIssueInvoice('C-003', '2026-10-07');
+  const result = statement('C-003', [inv], '2026-10-15');
+  const stmtInv = result.value.invoices[0];
+  assert.ok(stmtInv.number);
+  assert.equal(stmtInv.issueDate, '2026-10-07');
+  assert.ok(stmtInv.dueDate);
+  assert.equal(stmtInv.total, 58500);
+  assert.equal(stmtInv.due, 58500);
+});
+
+test('statement calculates due amount from balanceDue', () => {
+  let inv = createAndIssueInvoice('C-003', '2026-10-07');
+  inv = recordPayment(inv, { amount: 25000, date: '2026-10-08' }).value;
+  const result = statement('C-003', [inv], '2026-10-15');
+  const stmtInv = result.value.invoices[0];
+  assert.equal(stmtInv.total, 58500);
+  assert.equal(stmtInv.due, 33500);
+});
+
+test('statement calculates totalDue as sum of due amounts', () => {
+  let inv1 = createAndIssueInvoice('C-003', '2026-10-05');
+  let inv2 = createAndIssueInvoice('C-003', '2026-10-10');
+  inv1 = recordPayment(inv1, { amount: 20000, date: '2026-10-08' }).value;
+  const result = statement('C-003', [inv1, inv2], '2026-10-15');
+  assert.equal(result.value.totalDue, 38500 + 58500);
+});
+
+test('statement normalizes customerId', () => {
+  const inv = createAndIssueInvoice('c-003', '2026-10-07');
+  const result = statement('  C-003  ', [inv], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement filters by customer', () => {
+  const inv1 = createAndIssueInvoice('C-003', '2026-10-07');
+  const inv2 = createAndIssueInvoice('C-002', '2026-10-07');
+  const result = statement('C-003', [inv1, inv2], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, inv1.number);
+});
+
+test('statement reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('C-999', [], '2026-10-15');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement reports DATE_INVALID for bad date', () => {
+  const inv = createAndIssueInvoice('C-003', '2026-10-07');
+  const result = statement('C-003', [inv], '10/15/2026');
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('statement handles empty invoices array', () => {
+  const result = statement('C-003', [], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement handles null invoices array', () => {
+  const result = statement('C-003', null, '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
