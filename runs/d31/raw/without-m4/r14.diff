diff --git a/src/statements.js b/src/statements.js
new file mode 100644
index 0000000..11a50c7
--- /dev/null
+++ b/src/statements.js
@@ -0,0 +1,44 @@
+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { isValidDate } from './dates.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement listing outstanding invoices.
+ * @param {string} customerId - The customer ID
+ * @param {Array} invoices - Array of all invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format (statement cutoff date)
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  const normalizedId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedId);
+  if (!customerResult.ok) return customerResult;
+
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  const customerInvoices = (invoices ?? [])
+    .filter(
+      (inv) =>
+        inv.customerId === normalizedId &&
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.issueDate <= asOf
+    )
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate))
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }));
+
+  const totalDue = customerInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedId,
+    invoices: customerInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
