--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,145 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId = 'C-003', issueDate = '2026-10-07', lines = [{ sku: 'WORKSHOP-DAY', qty: 1 }]) {
+  const invoice = createInvoice({ customerId, issueDate, lines }).value;
+  return issueInvoice(invoice, []).value;
+}
+
+test('createCreditNote returns ok with credit note data', () => {
+  const inv = createAndIssueInvoice();
+  const result = createCreditNote(inv, { amount: 10000, reason: 'Service issue', date: '2026-10-10' }, []);
+  assert.equal(result.ok, true);
+  assert.ok(result.value.number);
+  assert.equal(result.value.invoiceNumber, inv.number);
+  assert.equal(result.value.customerId, 'C-003');
+  assert.equal(result.value.amount, 10000);
+  assert.equal(result.value.reason, 'Service issue');
+  assert.equal(result.value.date, '2026-10-10');
+});
+
+test('createCreditNote generates CN- prefixed number', () => {
+  const inv = createAndIssueInvoice();
+  const result = createCreditNote(inv, { amount: 5000, reason: 'Discount', date: '2026-10-10' }, []);
+  assert.ok(result.value.number.startsWith('CN-'));
+});
+
+test('createCreditNote numbers are separate from invoice numbers', () => {
+  const inv = createAndIssueInvoice();
+  const result1 = createCreditNote(inv, { amount: 5000, reason: 'Reason 1', date: '2026-10-10' }, []);
+  const result2 = createCreditNote(inv, { amount: 3000, reason: 'Reason 2', date: '2026-10-10' }, [result1.value.number]);
+  assert.notEqual(result1.value.number, result2.value.number);
+  assert.ok(result1.value.number < result2.value.number);
+});
+
+test('createCreditNote requires issued status', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote works with partially_paid invoices', () => {
+  let inv = createAndIssueInvoice();
+  inv = recordPayment(inv, { amount: 20000, date: '2026-10-08' }).value;
+  const result = createCreditNote(inv, { amount: 10000, reason: 'Partial refund', date: '2026-10-10' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote works with paid invoices', () => {
+  let inv = createAndIssueInvoice();
+  inv = recordPayment(inv, { amount: 58500, date: '2026-10-08' }).value;
+  const result = createCreditNote(inv, { amount: 10000, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects invalid amount', () => {
+  const inv = createAndIssueInvoice();
+  const result = createCreditNote(inv, { amount: -5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const inv = createAndIssueInvoice();
+  const result = createCreditNote(inv, { amount: 0, reason: 'Test', date: '2026-10-10' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects fractional amount', () => {
+  const inv = createAndIssueInvoice();
+  const result = createCreditNote(inv, { amount: 5000.5, reason: 'Test', date: '2026-10-10' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const inv = createAndIssueInvoice();
+  const result = createCreditNote(inv, { amount: 100000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows amount equal to invoice total', () => {
+  const inv = createAndIssueInvoice();
+  const result = createCreditNote(inv, { amount: 58500, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 58500);
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const inv = createAndIssueInvoice();
+  const result = createCreditNote(inv, { amount: 5000, reason: 'Test', date: '10/15/2026' }, []);
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote increments counter per year', () => {
+  const inv = createAndIssueInvoice();
+  const result1 = createCreditNote(inv, { amount: 5000, reason: 'First', date: '2026-10-10' }, []);
+  const result2 = createCreditNote(inv, { amount: 3000, reason: 'Second', date: '2026-10-15' }, [result1.value.number]);
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote resets counter for different year', () => {
+  const inv = createAndIssueInvoice();
+  const result1 = createCreditNote(inv, { amount: 5000, reason: 'First', date: '2026-10-10' }, []);
+  const result2 = createCreditNote(inv, { amount: 3000, reason: 'Second', date: '2027-01-15' }, [result1.value.number]);
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  const inv = createAndIssueInvoice();
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001'];
+  const result = createCreditNote(inv, { amount: 5000, reason: 'Test', date: '2026-10-10' }, existingNumbers);
+  assert.equal(result.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote preserves customer ID', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createCreditNote handles discount in invoice total calculation', () => {
+  const inv = createAndIssueInvoice('C-003');
+  const totals = { subtotal: 60000, discount: 1500, vat: 0, voucher: 0, total: 58500 };
+  const result = createCreditNote(inv, { amount: 58500, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 58500);
+});
+
+test('createCreditNote rejects amount exceeding discounted total', () => {
+  const inv = createAndIssueInvoice('C-003');
+  const result = createCreditNote(inv, { amount: 59000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
