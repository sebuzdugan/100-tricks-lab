   return `${yearPrefix}${String(nextCounter).padStart(4, '0')}`;
 }
+
+/**
+ * Calculate the next credit note number for a given date.
+ * @param {string[]} existingNumbers - Array of all numbers (both invoices and credit notes)
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} - Next credit note number in format CN-YYYY-NNNN
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.substring(0, 4);
+  const yearPrefix = `CN-${year}-`;
+
+  const yearNumbers = existingNumbers.filter((num) => num.startsWith(yearPrefix));
+  const counters = yearNumbers.map((num) => {
+    const counterStr = num.substring(yearPrefix.length);
+    return Number(counterStr);
+  });
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${yearPrefix}${String(nextCounter).padStart(4, '0')}`;
+}
diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
