@@ -0,0 +1,183 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId = 'C-003', issueDate = '2026-10-07', lines = [{ sku: 'WORKSHOP-DAY', qty: 1 }], terms = 'NET30') {
+  const invoice = createInvoice({ customerId, issueDate, lines, terms }).value;
+  return issueInvoice(invoice, []).value;
+}
+
+test('overdueInvoices returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2026-11-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices returns empty array when no invoices are overdue', () => {
+  const inv = createAndIssueInvoice();
+  const result = overdueInvoices([inv], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices includes invoices with dueDate before asOf', () => {
+  const inv = createAndIssueInvoice();
+  const result = overdueInvoices([inv], '2026-11-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].number, inv.number);
+});
+
+test('overdueInvoices excludes invoices with dueDate equal to asOf', () => {
+  const inv = createAndIssueInvoice();
+  const result = overdueInvoices([inv], inv.dueDate);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices includes invoice fields', () => {
+  const inv = createAndIssueInvoice();
+  const result = overdueInvoices([inv], '2026-11-15');
+  const overdue = result.value[0];
+  assert.ok(overdue.number);
+  assert.equal(overdue.customerId, 'C-003');
+  assert.ok(overdue.dueDate);
+  assert.equal(typeof overdue.daysOverdue, 'number');
+  assert.equal(typeof overdue.due, 'number');
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const inv = createAndIssueInvoice();
+  const result = overdueInvoices([inv], '2026-11-16');
+  const overdue = result.value[0];
+  assert.equal(overdue.daysOverdue, 10);
+});
+
+test('overdueInvoices calculates due amount correctly', () => {
+  const inv = createAndIssueInvoice();
+  const result = overdueInvoices([inv], '2026-11-15');
+  const overdue = result.value[0];
+  assert.equal(overdue.due, 58500);
+});
+
+test('overdueInvoices calculates due amount after partial payment', () => {
+  let inv = createAndIssueInvoice();
+  inv = recordPayment(inv, { amount: 20000, date: '2026-10-15' }).value;
+  const result = overdueInvoices([inv], '2026-11-15');
+  const overdue = result.value[0];
+  assert.equal(overdue.due, 38500);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+  const result = overdueInvoices([invoice], '2026-11-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  let inv = createAndIssueInvoice();
+  inv = recordPayment(inv, { amount: 58500, date: '2026-10-15' }).value;
+  const result = overdueInvoices([inv], '2026-11-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  let inv = createAndIssueInvoice();
+  inv = recordPayment(inv, { amount: 30000, date: '2026-10-15' }).value;
+  const result = overdueInvoices([inv], '2026-11-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].due, 28500);
+});
+
+test('overdueInvoices sorts by most overdue first', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-09-01', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET14');
+  const inv2 = createAndIssueInvoice('C-002', '2026-10-01', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET14');
+  const inv3 = createAndIssueInvoice('C-003', '2026-10-07', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET30');
+  const result = overdueInvoices([inv1, inv2, inv3], '2026-11-15');
+  assert.equal(result.value.length, 3);
+  assert.equal(result.value[0].daysOverdue, 61);
+  assert.equal(result.value[1].daysOverdue, 31);
+  assert.equal(result.value[2].daysOverdue, 9);
+});
+
+test('overdueInvoices handles null invoices array', () => {
+  const result = overdueInvoices(null, '2026-11-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices rejects invalid date', () => {
+  const inv = createAndIssueInvoice();
+  const result = overdueInvoices([inv], '11/15/2026');
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('overdueInvoices handles mixed overdue and non-overdue', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-09-01', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET14');
+  const inv2 = createAndIssueInvoice('C-002', '2026-10-20', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET30');
+  const result = overdueInvoices([inv1, inv2], '2026-11-15');
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].customerId, 'C-001');
+});
+
+test('overdueInvoices handles invoices without dueDate', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  delete issued.dueDate;
+  const result = overdueInvoices([issued], '2026-11-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices preserves all invoice information', () => {
+  const inv = createAndIssueInvoice('C-001', '2026-09-01', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET14');
+  const result = overdueInvoices([inv], '2026-11-15');
+  const overdue = result.value[0];
+  assert.equal(overdue.number, inv.number);
+  assert.equal(overdue.customerId, 'C-001');
+  assert.equal(overdue.dueDate, inv.dueDate);
+});
+
+test('overdueInvoices with NET14 terms', () => {
+  const inv = createAndIssueInvoice('C-001', '2026-10-07', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET14');
+  const result = overdueInvoices([inv], '2026-10-25');
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].daysOverdue, 4);
+});
+
+test('overdueInvoices with NET30 terms', () => {
+  const inv = createAndIssueInvoice('C-001', '2026-10-07', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET30');
+  const result = overdueInvoices([inv], '2026-11-10');
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].daysOverdue, 4);
+});
+
+test('overdueInvoices with EOM terms', () => {
+  const inv = createAndIssueInvoice('C-001', '2026-10-07', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'EOM');
+  const result = overdueInvoices([inv], '2026-11-02');
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].daysOverdue, 2);
+});
+
+test('overdueInvoices handles multiple overdue invoices from same customer', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-09-01', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET14');
+  const inv2 = createAndIssueInvoice('C-001', '2026-09-15', [{ sku: 'WORKSHOP-DAY', qty: 1 }], 'NET14');
+  const result = overdueInvoices([inv1, inv2], '2026-11-15');
+  assert.equal(result.value.length, 2);
+  assert.equal(result.value[0].customerId, 'C-001');
+  assert.equal(result.value[1].customerId, 'C-001');
+  assert(result.value[0].daysOverdue >= result.value[1].daysOverdue);
+});
