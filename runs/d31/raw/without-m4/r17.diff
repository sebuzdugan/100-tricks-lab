+import { fail, ok } from './result.js';
 
 /**
  * Get invoices that are overdue as of a given date.
@@ -29,3 +30,32 @@ export function overdueInvoices(invoices, asOf) {
 
   return { ok: true, value: overdue };
 }
+
+/**
+ * Generate a summary of VAT by rate.
+ * @param {Array} invoices - Array of invoices
+ * @returns {{ ok: true, value: Array<{ rate: number, base: number, vat: number }> }}
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  (invoices ?? [])
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVat(line);
+
+        if (!vatMap[rate]) {
+          vatMap[rate] = { rate, base: 0, vat: 0 };
+        }
+        vatMap[rate].base += base;
+        vatMap[rate].vat += vat;
+      });
+    });
+
+  const summary = Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+
+  return ok(summary);
+}
