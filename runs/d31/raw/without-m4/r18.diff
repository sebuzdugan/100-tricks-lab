@@ -2,6 +2,7 @@ import { balanceDue } from './payments.js';
 import { daysBetween, isValidDate } from './dates.js';
 import { lineTotal, lineDiscount, lineVat } from './invoices.js';
 import { fail, ok } from './result.js';
+import { roundCents } from './money.js';
 
 /**
  * Get invoices that are overdue as of a given date.
@@ -59,3 +60,27 @@ export function vatSummary(invoices) {
 
   return ok(summary);
 }
+
+/**
+ * Calculate the late fee for an invoice.
+ * @param {{ dueDate: string, status: string, payments?: Array, lines: Array }} invoice - The invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (!isValidDate(asOf)) return 0;
+
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return 0;
+  }
+
+  if (!invoice.dueDate || invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+
+  const fee = roundCents(due * 0.0004 * daysOverdue);
+  return Math.max(0, fee);
+}
