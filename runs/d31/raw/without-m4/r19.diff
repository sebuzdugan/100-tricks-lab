+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId = 'C-003', issueDate = '2026-10-07', lines = [{ sku: 'WORKSHOP-DAY', qty: 1 }]) {
+  const invoice = createInvoice({ customerId, issueDate, lines }).value;
+  return issueInvoice(invoice, []).value;
+}
+
+test('exportCsv returns header for empty array', () => {
+  const result = exportCsv([]);
+  const expected = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+  assert.equal(result, expected);
+});
+
+test('exportCsv returns header for null', () => {
+  const result = exportCsv(null);
+  const expected = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+  assert.equal(result, expected);
+});
+
+test('exportCsv includes header line', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv has correct number of columns', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  const lines = result.trim().split('\n');
+  const headerColumns = lines[0].split(',').length;
+  const dataColumns = lines[1].split(',').filter((_, i) => lines[1][i] !== '').length;
+  assert.equal(headerColumns, 10);
+});
+
+test('exportCsv includes invoice number', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.includes(inv.number));
+});
+
+test('exportCsv includes customer name', () => {
+  const inv = createAndIssueInvoice('C-003');
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('Kite & Co'));
+});
+
+test('exportCsv includes issue date', () => {
+  const inv = createAndIssueInvoice('C-003', '2026-10-07');
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('2026-10-07'));
+});
+
+test('exportCsv includes due date', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.includes(inv.dueDate));
+});
+
+test('exportCsv includes status', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('issued'));
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('585.00') || result.includes('600.00'));
+});
+
+test('exportCsv uses dot as decimal separator', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('.'));
+  assert(!result.includes(',00'));
+});
+
+test('exportCsv includes subtotal', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('600.00'));
+});
+
+test('exportCsv includes discount', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('15.00'));
+});
+
+test('exportCsv includes VAT', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('0.00'));
+});
+
+test('exportCsv includes total', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('585.00'));
+});
+
+test('exportCsv includes due amount', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('585.00'));
+});
+
+test('exportCsv ends lines with newline', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  assert.ok(result.endsWith('\n'));
+});
+
+test('exportCsv handles multiple invoices', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const inv2 = createAndIssueInvoice('C-002', '2026-10-08');
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  assert.equal(lines.length, 3);
+});
+
+test('exportCsv maintains invoice order', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const inv2 = createAndIssueInvoice('C-002', '2026-10-08');
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  assert.ok(lines[1].includes(inv1.number));
+  assert.ok(lines[2].includes(inv2.number));
+});
+
+test('exportCsv escapes customer names with comma', () => {
+  const inv = createAndIssueInvoice('C-004');
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer names with quotes', () => {
+  const inv = createAndIssueInvoice('C-006');
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('Marlow'));
+});
+
+test('exportCsv calculates due after partial payment', () => {
+  let inv = createAndIssueInvoice();
+  inv = recordPayment(inv, { amount: 29250, date: '2026-10-15' }).value;
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('292.50'));
+});
+
+test('exportCsv calculates due as zero for fully paid invoice', () => {
+  let inv = createAndIssueInvoice();
+  inv = recordPayment(inv, { amount: 58500, date: '2026-10-15' }).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  const lastField = lines[1].split(',').pop();
+  assert.equal(lastField, '0.00');
+});
+
+test('exportCsv handles missing due date gracefully', () => {
+  const inv = createAndIssueInvoice();
+  delete inv.dueDate;
+  const result = exportCsv([inv]);
+  assert.ok(result.includes(',,'));
+});
+
+test('exportCsv has correct field order', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  const headerFields = lines[0].split(',');
+  assert.deepEqual(headerFields, [
+    'number',
+    'customer',
+    'issueDate',
+    'dueDate',
+    'status',
+    'subtotal',
+    'discount',
+    'vat',
+    'total',
+    'due',
+  ]);
+});
+
+test('exportCsv formats small amounts correctly', () => {
+  const inv = createAndIssueInvoice('C-001', '2026-10-07', [{ sku: 'STICKER', qty: 1 }]);
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('0.50'));
+});
+
+test('exportCsv formats large amounts correctly', () => {
+  const inv = createAndIssueInvoice('C-001', '2026-10-07', [{ sku: 'LOGO-PACK', qty: 1 }]);
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('1200.00'));
+});
+
+test('exportCsv handles invoice with multiple lines', () => {
+  const inv = createAndIssueInvoice('C-001', '2026-10-07', [
+    { sku: 'WORKSHOP-DAY', qty: 1 },
+    { sku: 'PRINT-A4', qty: 10 },
+  ]);
+  const result = exportCsv([inv]);
+  assert.ok(result.includes(inv.number));
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  assert.equal(lines.length, 2);
+});
+
+test('exportCsv with various customer tiers', () => {
+  const inv1 = createAndIssueInvoice('C-001');
+  const inv2 = createAndIssueInvoice('C-003');
+  const result = exportCsv([inv1, inv2]);
+  assert.ok(result.includes('Northwind Studio'));
+  assert.ok(result.includes('Kite & Co'));
+});
+
+test('exportCsv produces valid CSV format', () => {
+  const inv = createAndIssueInvoice();
+  const result = exportCsv([inv]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  assert.equal(lines.length, 2);
+  const headerCount = lines[0].split(',').length;
+  const dataCount = lines[1].split(/,(?=(?:[^"]*"[^"]*")*[^"]*$)/).length;
+  assert.equal(headerCount, dataCount);
+});
+
+test('exportCsv handles draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+  const result = exportCsv([invoice]);
+  assert.ok(result.includes('draft'));
+});
+
+test('exportCsv with NET14 terms', () => {
+  const invoice = createInvoice({ customerId: 'C-003', issueDate: '2026-10-07', lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }], terms: 'NET14' }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+  assert.ok(result.includes('2026-10-21'));
+});
