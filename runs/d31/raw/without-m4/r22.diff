+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const line = { qty: 2, unitPrice: 50 };
+  assert.equal(lineTotal(line), 100);
+});
+
+test('lineTotal with single quantity', () => {
+  const line = { qty: 1, unitPrice: 60000 };
+  assert.equal(lineTotal(line), 60000);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 60000 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with large amounts', () => {
+  const line = { qty: 100, unitPrice: 120000 };
+  assert.equal(lineTotal(line), 12000000);
+});
+
+test('lineDiscount returns 0 if no discount', () => {
+  const line = { qty: 1, unitPrice: 100 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount calculates percentage discount', () => {
+  const line = { qty: 1, unitPrice: 100, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 10);
+});
+
+test('lineDiscount with 50% discount', () => {
+  const line = { qty: 1, unitPrice: 100, discountPercent: 50 };
+  assert.equal(lineDiscount(line), 50);
+});
+
+test('lineDiscount with decimal result rounds to nearest cent', () => {
+  const line = { qty: 1, unitPrice: 60000, discountPercent: 2.5 };
+  assert.equal(lineDiscount(line), 1500);
+});
+
+test('lineDiscount with 0% discount returns 0', () => {
+  const line = { qty: 1, unitPrice: 100, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVat returns 0 for 0% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 60000, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 1, unitPrice: 100, discountPercent: 10, vatRate: 21 };
+  const afterDiscount = 90;
+  const expectedVat = Math.round(afterDiscount * 0.21);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat with 21% rate', () => {
+  const line = { qty: 1, unitPrice: 100, vatRate: 21 };
+  assert.equal(lineVat(line), 21);
+});
+
+test('lineVat with 9% rate', () => {
+  const line = { qty: 1, unitPrice: 100, vatRate: 9 };
+  assert.equal(lineVat(line), 9);
+});
+
+test('lineVat ignores discount percentage in rate calculation', () => {
+  const line1 = { qty: 1, unitPrice: 100, discountPercent: 10, vatRate: 21 };
+  const line2 = { qty: 1, unitPrice: 100, discountPercent: 5, vatRate: 21 };
+  assert.notEqual(lineVat(line1), lineVat(line2));
+});
+
+test('lineVat with large amount', () => {
+  const line = { qty: 100, unitPrice: 120000, vatRate: 21 };
+  const total = 12000000;
+  const expectedVat = Math.round(total * 0.21);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('invoiceTotals calculates subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 0 },
+      { qty: 1, unitPrice: 200, vatRate: 0 },
+    ],
+  };
+  assert.equal(invoiceTotals(invoice).subtotal, 300);
+});
+
+test('invoiceTotals calculates discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, discountPercent: 10, vatRate: 0 },
+      { qty: 1, unitPrice: 200, vatRate: 0 },
+    ],
+  };
+  assert.equal(invoiceTotals(invoice).discount, 10);
+});
+
+test('invoiceTotals calculates VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 21 },
+    ],
+  };
+  assert.equal(invoiceTotals(invoice).vat, 21);
+});
+
+test('invoiceTotals includes voucher in total', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    voucher: { amount: 20 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 80);
+});
+
+test('invoiceTotals without voucher has 0 voucher amount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+  };
+  assert.equal(invoiceTotals(invoice).voucher, 0);
+});
+
+test('invoiceTotals calculates total = subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, discountPercent: 10, vatRate: 21 },
+    ],
+    voucher: { amount: 5 },
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = 100 - 10 + 19 - 5;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals clamps total at 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    voucher: { amount: 200 },
+  };
+  assert.equal(invoiceTotals(invoice).total, 0);
+});
+
+test('invoiceTotals with multiple lines and discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 50, discountPercent: 5, vatRate: 0 },
+      { qty: 3, unitPrice: 100, discountPercent: 10, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100 + 300);
+  assert.equal(totals.discount, 5 + 30);
+});
+
+test('invoiceTotals returns all required fields', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.hasOwnProperty('subtotal'));
+  assert.ok(totals.hasOwnProperty('discount'));
+  assert.ok(totals.hasOwnProperty('vat'));
+  assert.ok(totals.hasOwnProperty('voucher'));
+  assert.ok(totals.hasOwnProperty('total'));
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with realistic invoice (WORKSHOP-DAY)', () => {
+  const invoice = {
+    lines: [
+      {
+        sku: 'WORKSHOP-DAY',
+        qty: 1,
+        unitPrice: 60000,
+        vatRate: 0,
+        discountPercent: 2.5,
+      },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 60000);
+  assert.equal(totals.discount, 1500);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 58500);
+});
+
+test('lineTotal and lineDiscount consistency', () => {
+  const line = { qty: 1, unitPrice: 1000, discountPercent: 50, vatRate: 0 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  assert.equal(discount, total / 2);
+});
+
+test('invoiceTotals with VAT and discount interaction', () => {
+  const invoice = {
+    lines: [
+      {
+        qty: 1,
+        unitPrice: 1000,
+        discountPercent: 10,
+        vatRate: 21,
+      },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 1000);
+  assert.equal(totals.discount, 100);
+  const afterDiscount = 1000 - 100;
+  const expectedVat = Math.round(afterDiscount * 0.21);
+  assert.equal(totals.vat, expectedVat);
+});
+
+test('invoiceTotals with multiple vouchers', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    voucher: { amount: 20 },
+  };
+  assert.equal(invoiceTotals(invoice).voucher, 20);
+});
+
+test('lineVat uses lineDiscount not discountPercent directly', () => {
+  const line = { qty: 2, unitPrice: 50, discountPercent: 10, vatRate: 21 };
+  const lineAmount = lineTotal(line) - lineDiscount(line);
+  const expectedVat = Math.round(lineAmount * 0.21);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('invoiceTotals aggregates multiple lines correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, discountPercent: 10, vatRate: 21 },
+      { qty: 1, unitPrice: 200, discountPercent: 5, vatRate: 21 },
+      { qty: 1, unitPrice: 50, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 350);
+  const discount = lineDiscount({qty: 1, unitPrice: 100, discountPercent: 10, vatRate: 21}) +
+                   lineDiscount({qty: 1, unitPrice: 200, discountPercent: 5, vatRate: 21});
+  assert.equal(totals.discount, discount);
+});
