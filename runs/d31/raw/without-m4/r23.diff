diff --git a/src/totals.js b/src/totals.js
index bc7bebd..9a8198d 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -10,13 +10,23 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount amount for a line (lineTotal × discountPercent / 100).
+ * Calculate the discount amount for a line (lineTotal × discountPercent / 100, plus 2.5% bulk discount for qty >= 10).
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
-  if (!line.discountPercent) return 0;
-  const discount = roundCents(lineTotal(line) * line.discountPercent / 100);
+  let discount = 0;
+
+  if (line.discountPercent) {
+    discount = roundCents(lineTotal(line) * line.discountPercent / 100);
+  }
+
+  if (line.qty >= 10) {
+    const amountAfterFirstDiscount = lineTotal(line) - discount;
+    const bulkDiscount = roundCents(amountAfterFirstDiscount * 2.5 / 100);
+    discount += bulkDiscount;
+  }
+
   return Math.max(0, discount);
 }
 
