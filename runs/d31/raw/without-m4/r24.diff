+++ b/src/reports.js
@@ -84,3 +84,56 @@ export function lateFee(invoice, asOf) {
   const fee = roundCents(due * 0.0004 * daysOverdue);
   return Math.max(0, fee);
 }
+
+/**
+ * Generate a dashboard summary of invoicing metrics.
+ * @param {Array} invoices - Array of invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { counts: Object, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  const invoicesList = invoices ?? [];
+
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  invoicesList.forEach((inv) => {
+    if (counts.hasOwnProperty(inv.status)) {
+      counts[inv.status]++;
+    }
+  });
+
+  const outstanding = invoicesList
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  const overdueResult = overdueInvoices(invoicesList, asOf);
+  const overdue = {
+    count: overdueResult.value.length,
+    amount: overdueResult.value.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const customerDues = new Map();
+  invoicesList
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .forEach((inv) => {
+      const due = balanceDue(inv);
+      if (due > 0) {
+        const current = customerDues.get(inv.customerId) ?? 0;
+        customerDues.set(inv.customerId, current + due);
+      }
+    });
+
+  const topCustomers = Array.from(customerDues.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({ counts, outstanding, overdue, topCustomers });
+}
