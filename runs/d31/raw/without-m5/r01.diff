+++ b/src/invoices.js
@@ -0,0 +1,60 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(dateStr);
+  if (!match) return false;
+  const date = new Date(dateStr + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+  return date.toISOString().startsWith(dateStr);
+}
+
+/**
+ * Create an invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} obj
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array<any> } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issue date
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  // Validate lines array is not empty
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Validate SKU exists and get product details
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..3f0ed1c
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,142 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a valid invoice with single line', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'LOGO-PACK');
+  assert.equal(r.value.lines[0].qty, 2);
+  assert.ok(r.value.lines[0].name);
+  assert.ok(typeof r.value.lines[0].unitPrice === 'number');
+  assert.ok(typeof r.value.lines[0].vatRate === 'number');
+});
+
+test('createInvoice creates a valid invoice with multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].sku, 'LOGO-PACK');
+  assert.equal(r.value.lines[1].sku, 'DES-HOUR');
+});
+
+test('createInvoice reports an unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports an invalid date format', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '10/07/2026',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports a non-existent date', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports an invalid date string', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: 'not-a-date',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports an empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports invalid qty (not an integer)', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1.5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports invalid qty (zero)', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 0 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports invalid qty (negative)', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: -5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports an unknown SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate the input', () => {
+  const lines = [{ sku: 'LOGO-PACK', qty: 2 }];
+  const linesCopy = JSON.parse(JSON.stringify(lines));
+  createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines,
+  });
+  assert.deepEqual(lines, linesCopy);
+});
+
+test('createInvoice copies product data from catalogue', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const line = r.value.lines[0];
+  assert.ok(line.name.length > 0);
+  assert.ok(Number.isInteger(line.unitPrice));
+  assert.ok(typeof line.vatRate === 'number');
+  assert.ok(line.vatRate >= 0 && line.vatRate <= 100);
+});
