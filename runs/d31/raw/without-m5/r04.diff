diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..2753acb
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-9999', 'INV-2026-0001', 'INV-2027-0005'];
+  const num = nextInvoiceNumber(existing, '2026-10-15');
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber restarts at 0001 each year', () => {
+  const existing = ['INV-2025-0010', 'INV-2025-0011'];
+  const num = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber handles unsorted existing numbers', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber zero-pads to 4 digits', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-XXXX', 'INV-2026-', 'INVALID', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber works with large counters', () => {
+  const existing = ['INV-2026-9999'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-10000');
+});
