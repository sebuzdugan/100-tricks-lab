new file mode 100644
index 0000000..349218f
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,24 @@
+/**
+ * Calculate the next invoice number for a given issue date.
+ * Format: INV-<year>-<counter>, where counter is 4 digits zero-padded, starting at 0001 and restarting each year.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (in any order)
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Find all numbers from this year
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length), 10))
+    .filter((num) => !isNaN(num));
+
+  // Find the maximum counter
+  const maxCounter = thisYearNumbers.length > 0 ? Math.max(...thisYearNumbers) : 0;
+
+  // Return the next counter, zero-padded to 4 digits
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
