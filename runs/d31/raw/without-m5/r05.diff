@@ -0,0 +1,160 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+
+  const r2 = renderInvoiceText(invoice);
+  assert.equal(r2.ok, true);
+  const text = r2.value;
+  assert.ok(text.startsWith('DRAFT\n'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+
+  const r2 = issueInvoice(invoice, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  const r3 = renderInvoiceText(issued);
+  assert.equal(r3.ok, true);
+  const text = r3.value;
+  assert.ok(text.startsWith('INV-2026-0001\n'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+
+  const r2 = renderInvoiceText(invoice);
+  assert.equal(r2.ok, true);
+  const text = r2.value;
+  assert.ok(text.includes('Kite & Co'));
+});
+
+test('renderInvoiceText shows line items with qty, name, unit price and line total', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+
+  const r2 = renderInvoiceText(invoice);
+  assert.equal(r2.ok, true);
+  const text = r2.value;
+  // DES-HOUR: unitPrice = 8500 cents = €85.00, qty = 2, lineTotal = 17000 cents = €170.00
+  assert.ok(text.includes('2 Design work (hour) €85.00 €170.00'));
+});
+
+test('renderInvoiceText formats money amounts through formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+
+  const r2 = renderInvoiceText(invoice);
+  assert.equal(r2.ok, true);
+  const text = r2.value;
+  // LOGO-PACK: unitPrice = 120000 cents = €1,200.00
+  assert.ok(text.includes('€1,200.00'));
+  assert.ok(text.includes('Total: €1,200.00'));
+});
+
+test('renderInvoiceText shows multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+
+  const r2 = renderInvoiceText(invoice);
+  assert.equal(r2.ok, true);
+  const text = r2.value;
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // DRAFT, customer, 2 line items, Total
+  assert.ok(lines[0] === 'DRAFT');
+  assert.ok(lines[1] === 'Northwind Studio');
+  assert.ok(lines[2].includes('1 Logo package'));
+  assert.ok(lines[3].includes('5 Design work (hour)'));
+  assert.ok(lines[4].startsWith('Total:'));
+});
+
+test('renderInvoiceText calculates correct total for multiple items', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 }, // 120000 cents = €1,200.00
+      { sku: 'DES-HOUR', qty: 2 },  // 2 * 8500 = 17000 cents = €170.00
+    ],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+
+  const r2 = renderInvoiceText(invoice);
+  assert.equal(r2.ok, true);
+  const text = r2.value;
+  // Total should be €1,370.00
+  assert.ok(text.includes('Total: €1,370.00'));
+});
+
+test('renderInvoiceText reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, name: 'Logo package', unitPrice: 120000, vatRate: 21 }],
+  };
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('renderInvoiceText separates lines with newlines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+
+  const r2 = renderInvoiceText(invoice);
+  assert.equal(r2.ok, true);
+  const text = r2.value;
+  assert.ok(text.includes('\n'));
+  const lines = text.split('\n');
+  assert.ok(lines.length >= 4); // invoice number, customer, at least 1 item, total
+});
