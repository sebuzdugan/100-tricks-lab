+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to customers.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  // Get invoice number or DRAFT
+  const invoiceNumber = invoice.number || 'DRAFT';
+
+  // Look up customer
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const customer = customerResult.value;
+
+  // Build output lines
+  const lines = [invoiceNumber, customer.name];
+
+  // Add invoice lines
+  for (const line of invoice.lines) {
+    const unitPriceText = formatEuros(line.unitPrice);
+    const lineTotalAmount = lineTotal(line);
+    const lineTotalText = formatEuros(lineTotalAmount);
+    lines.push(`${line.qty} ${line.name} ${unitPriceText} ${lineTotalText}`);
+  }
+
+  // Add total
+  const totals = invoiceTotals(invoice);
+  const totalText = formatEuros(totals.total);
+  lines.push(`Total: ${totalText}`);
+
+  return ok(lines.join('\n'));
+}
diff --git a/test/render.test.js b/test/render.test.js
