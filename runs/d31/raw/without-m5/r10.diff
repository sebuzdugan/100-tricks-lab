+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * Uses UTC for validation.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(text);
+  if (!match) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+  return date.toISOString().startsWith(text);
+}
+
+/**
+ * Add days to a date, using UTC arithmetic.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - Date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of days between two dates (b minus a), using UTC arithmetic.
+ * @param {string} a - Date in YYYY-MM-DD format
+ * @param {string} b - Date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
