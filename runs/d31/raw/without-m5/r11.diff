+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }>, lines: Array<any> }} invoice
+ * @param {{ amount: number, date: string }} param
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check invoice status is 'issued' or 'partially_paid'
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Calculate total and remaining balance
+  const totals = invoiceTotals(invoice);
+  const paidAmount = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  const remainingBalance = totals.total - paidAmount;
+
+  // Check for overpayment
+  if (amount > remainingBalance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array with the new payment
+  const newPayments = [...(invoice.payments || []), { amount, date }];
+  const newPaidAmount = paidAmount + amount;
+  const newBalance = totals.total - newPaidAmount;
+
+  // Determine new status
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  // Return new invoice with payment recorded
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }>, lines: Array<any> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paidAmount = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return totals.total - paidAmount;
+}
