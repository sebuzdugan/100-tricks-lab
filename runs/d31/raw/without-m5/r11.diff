+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('recordPayment adds a payment to an issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  const r3 = recordPayment(issued, { amount: 50000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 1);
+  assert.equal(r3.value.payments[0].amount, 50000);
+  assert.equal(r3.value.payments[0].date, '2026-10-08');
+  assert.equal(r3.value.status, 'partially_paid');
+});
+
+test('recordPayment marks invoice as paid when fully paid', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  // Total is 120000 + 25200 VAT = 145200
+  const r3 = recordPayment(issued, { amount: 145200, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'paid');
+  assert.equal(r3.value.payments.length, 1);
+});
+
+test('recordPayment allows multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  let invoice = r2.value;
+
+  // Total: 145200
+  const r3 = recordPayment(invoice, { amount: 50000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'partially_paid');
+  invoice = r3.value;
+
+  const r4 = recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.status, 'partially_paid');
+  assert.equal(r4.value.payments.length, 2);
+  invoice = r4.value;
+
+  const r5 = recordPayment(invoice, { amount: 45200, date: '2026-10-15' });
+  assert.equal(r5.ok, true);
+  assert.equal(r5.value.status, 'paid');
+  assert.equal(r5.value.payments.length, 3);
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = recordPayment(draft, { amount: 50000, date: '2026-10-08' });
+  assert.deepEqual(r2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects payment on paid invoice', () => {
