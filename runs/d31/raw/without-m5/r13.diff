+
+/**
+ * Apply a voucher to an invoice (fixed amount off after VAT).
+ * @param {{ status: string, voucher?: any, customerId: string, issueDate: string, lines: Array<any> }} invoice
+ * @param {{ code: string, amount: number }} param
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Only on draft invoices
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Only one voucher per invoice
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Amount must be positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
