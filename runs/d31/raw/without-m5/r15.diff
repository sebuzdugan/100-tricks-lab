+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the next credit note number for a given year.
+ * Credit notes use a separate counter from invoices.
+ * @param {string[]} existingNumbers - Array of all invoice and credit note numbers
+ * @param {string} year - Year in YYYY format
+ * @returns {string} - Credit note number in CN-<year>-<counter> format
+ */
+function nextCreditNoteNumber(existingNumbers, year) {
+  const prefix = `CN-${year}-`;
+
+  // Find all credit note numbers from this year
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length), 10))
+    .filter((num) => !isNaN(num));
+
+  // Find the maximum counter
+  const maxCounter = thisYearNumbers.length > 0 ? Math.max(...thisYearNumbers) : 0;
+
+  // Return the next counter, zero-padded to 4 digits
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice (refund).
+ * @param {{ status: string, number: string, customerId: string, issueDate: string, lines: Array<any> }} invoice
+ * @param {{ amount: number, reason: string, date: string }} param
+ * @param {string[]} existingNumbers - Array of all invoice and credit note numbers already used
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is issued, partially_paid, or paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate credit amount doesn't exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const year = date.substring(0, 4);
+  const number = nextCreditNoteNumber(existingNumbers, year);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
