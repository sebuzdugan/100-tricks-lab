+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  const r3 = createCreditNote(issued, { amount: 25000, reason: 'Damaged goods', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(r3.ok, true);
+  const cn = r3.value;
+  assert.equal(cn.number, 'CN-2026-0001');
