+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote restarts counter for different year', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  const r3 = createCreditNote(issued, { amount: 10000, reason: 'Discount', date: '2027-01-15' }, ['CN-2026-0001', 'CN-2026-0002']);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote works with mixed invoice and credit note numbers', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  const existingNumbers = ['INV-2026-0001', 'CN-2026-0001', 'INV-2026-0002', 'CN-2026-0002'];
+  const r3 = createCreditNote(issued, { amount: 10000, reason: 'Discount', date: '2026-10-08' }, existingNumbers);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote works on partially_paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  // Manually create partially_paid invoice
+  const partially = { ...issued, status: 'partially_paid', payments: [{ amount: 50000, date: '2026-10-08' }] };
+
+  const r3 = createCreditNote(partially, { amount: 10000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works on paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
