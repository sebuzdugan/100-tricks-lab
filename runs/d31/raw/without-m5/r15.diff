+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  // Invoice total is 145200, try to credit 145201
+  const r3 = createCreditNote(issued, { amount: 145201, reason: 'Customer discount', date: '2026-10-08' }, []);
+  assert.deepEqual(r3, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  // Invoice total is 145200
+  const r3 = createCreditNote(issued, { amount: 145200, reason: 'Full refund', date: '2026-10-08' }, []);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.amount, 145200);
+});
+
+test('createCreditNote increments counter for same year', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
