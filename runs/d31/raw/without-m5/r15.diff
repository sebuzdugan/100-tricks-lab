+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  const r3 = createCreditNote(issued, { amount: 10000, reason: 'Customer discount', date: '2026-10-08' }, ['INV-2026-0001']);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0001');
+  assert.equal(r3.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r3.value.customerId, 'C-003');
+  assert.equal(r3.value.amount, 10000);
+  assert.equal(r3.value.reason, 'Customer discount');
+  assert.equal(r3.value.date, '2026-10-08');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = createCreditNote(draft, { amount: 10000, reason: 'Customer discount', date: '2026-10-08' }, []);
+  assert.deepEqual(r2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects invalid amount (not integer)', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  const r3 = createCreditNote(issued, { amount: 10000.5, reason: 'Customer discount', date: '2026-10-08' }, []);
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
