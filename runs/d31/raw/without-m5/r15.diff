+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  const r3 = createCreditNote(issued, { amount: 0, reason: 'Customer discount', date: '2026-10-08' }, []);
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
