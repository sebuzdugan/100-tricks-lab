+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Find overdue invoices as of a given date.
+ * @param {Array<any>} invoices - All invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format (cutoff date)
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>} - Sorted most overdue first
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.dueDate && inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
