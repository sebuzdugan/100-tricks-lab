+test('overdueInvoices returns empty list when no invoices overdue', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  const issued = r2.value;
+
+  // Due date is 2026-11-06, check as of 2026-10-31 (not overdue yet)
+  const report = overdueInvoices([issued], '2026-10-31');
+  assert.equal(report.length, 0);
+});
