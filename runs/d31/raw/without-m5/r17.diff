+/**
+ * Summarize VAT by rate across finalized invoices.
+ * @param {Array<any>} invoices - All invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} - Sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const summary = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const base = roundCents(lineTotal(line) - lineDiscount(line));
+        const vat = lineVat(line);
+
+        if (!summary[rate]) {
+          summary[rate] = { base: 0, vat: 0 };
+        }
+        summary[rate].base = roundCents(summary[rate].base + base);
+        summary[rate].vat = roundCents(summary[rate].vat + vat);
+      });
+    });
+
+  return Object.entries(summary)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseFloat(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
