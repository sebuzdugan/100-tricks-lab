+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { getCustomer } from './customers.js';
+
+/**
+ * Format cents as euros: 1234 → "12.34", 100 → "1.00"
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: quote if contains comma or quote, and double any quotes inside.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  if (field.includes(',') || field.includes('"')) {
+    return `"${field.replace(/"/g, '""')}"`;
+  }
+  return field;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<any>} invoices - Array of invoices
+ * @returns {string} - CSV string
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const rows = invoices.map((inv) => {
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const fields = [
+      inv.number || 'DRAFT',
+      customerName,
+      inv.issueDate,
+      inv.dueDate || '',
+      inv.status,
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    return fields.map(escapeCsvField).join(',');
+  });
+
+  if (rows.length === 0) {
+    return header;
+  }
+  return header + rows.join('\n') + '\n';
+}
