+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header for empty list', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv exports single draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const csv = exportCsv([draft]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3); // header + 1 row + trailing newline
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], 'DRAFT,Kite & Co,2026-10-07,2026-11-06,draft,85.00,0.00,17.85,102.85,102.85');
+});
+
+test('exportCsv exports issued invoice with payment', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  let issued = r2.value;
+
+  const r3 = recordPayment(issued, { amount: 5000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  const partial = r3.value;
+
+  const csv = exportCsv([partial]);
+  const lines = csv.split('\n');
+  assert.equal(lines[1].startsWith('INV-2026-0001,Kite & Co,2026-10-07,2026-11-06,partially_paid'), true);
+  assert.equal(lines[1].endsWith('85.00,0.00,17.85,102.85,52.85'), true); // due = 102.85 - 50.00
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const csv = exportCsv([draft]);
+  const lines = csv.split('\n');
+  // STICKER: 50 cents * 100 = 5000 cents = 50.00 euros
+  // VAT: 50.00 * 21% = 10.50 euros
+  assert.equal(lines[1], 'DRAFT,Kite & Co,2026-10-07,2026-11-06,draft,50.00,0.00,10.50,60.50,60.50');
+});
+
+test('exportCsv escapes commas in customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const csv = exportCsv([draft]);
+  const lines = csv.split('\n');
+  // Customer C-004 is "Smith, Jones & Partners" - has comma, should be quoted
+  assert.equal(lines[1].startsWith('DRAFT,"Smith, Jones & Partners",'), true);
+});
+
+test('exportCsv handles customer not found', () => {
+  // Create an invoice and manually set an invalid customer ID
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  // Manually override customer ID to invalid
+  const invalid = { ...draft, customerId: 'INVALID' };
+
+  const csv = exportCsv([invalid]);
+  const lines = csv.split('\n');
+  // Should have empty customer name
+  assert.equal(lines[1].startsWith('DRAFT,,2026-10-07'), true);
+});
+
+test('exportCsv handles invoices with discount', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 10 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const csv = exportCsv([draft]);
+  const lines = csv.split('\n');
+  // DES-HOUR: 85.00, discount 10% = 8.50, base 76.50, VAT = 16.06 (1606.5 rounds to 1606), total = 92.56
+  assert.equal(lines[1], 'DRAFT,Kite & Co,2026-10-07,2026-11-06,draft,85.00,8.50,16.06,92.56,92.56');
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+  const draft1 = r1.value;
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 2, discountPercent: 0 }],
+  });
+  assert.equal(r2.ok, true);
+  const draft2 = r2.value;
+
+  const csv = exportCsv([draft1, draft2]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 4); // header + 2 rows + trailing newline
+  assert.equal(lines[1], 'DRAFT,Kite & Co,2026-10-07,2026-11-06,draft,85.00,0.00,17.85,102.85,102.85');
+  assert.equal(lines[2], 'DRAFT,Northwind Studio,2026-10-08,2026-11-07,draft,190.00,0.00,39.90,229.90,229.90');
+});
+
+test('exportCsv preserves order of invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+  const draft1 = r1.value;
+
+  const r2 = issueInvoice(draft1, []);
+  assert.equal(r2.ok, true);
+  const issued1 = r2.value;
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r3.ok, true);
+  const draft2 = r3.value;
+
+  const r4 = issueInvoice(draft2, ['INV-2026-0001']);
+  assert.equal(r4.ok, true);
+  const issued2 = r4.value;
+
+  // Export in reverse order
+  const csv = exportCsv([issued2, issued1]);
+  const lines = csv.split('\n');
+  assert.equal(lines[1].startsWith('INV-2026-0002,Northwind Studio'), true);
+  assert.equal(lines[2].startsWith('INV-2026-0001,Kite & Co'), true);
+});
+
+test('exportCsv with issued and paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  let issued = r2.value;
+
+  const r3 = recordPayment(issued, { amount: 10285, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  const paid = r3.value;
+
+  const csv = exportCsv([paid]);
+  const lines = csv.split('\n');
+  assert.equal(lines[1], 'INV-2026-0001,Kite & Co,2026-10-07,2026-11-06,paid,85.00,0.00,17.85,102.85,0.00');
+});
+
+test('exportCsv ends with newline', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const csv = exportCsv([draft]);
+  assert.equal(csv.endsWith('\n'), true);
+});
+
+test('exportCsv escapes double quotes', () => {
+  // Create an invoice with a customer that has quotes in the name
+  const r = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const csv = exportCsv([draft]);
+  const lines = csv.split('\n');
+  // Customer C-006 is "Marlow \"The Print Shop\"" - has quotes, should be quoted and escaped
+  assert.equal(lines[1].startsWith('DRAFT,"Marlow ""The Print Shop""",'), true);
+});
+
+test('exportCsv status transitions', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const r2 = issueInvoice(draft, []);
+  assert.equal(r2.ok, true);
+  let issued = r2.value;
+
+  const r3 = recordPayment(issued, { amount: 5000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  const partial = r3.value;
+
+  const csv = exportCsv([draft, issued, partial]);
+  const lines = csv.split('\n');
+  assert.equal(lines[1], 'DRAFT,Kite & Co,2026-10-07,2026-11-06,draft,85.00,0.00,17.85,102.85,102.85');
+  assert.equal(lines[2].includes('issued'), true);
+  assert.equal(lines[3].includes('partially_paid'), true);
+});
+
+test('exportCsv with zero VAT', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'TALK', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const csv = exportCsv([draft]);
+  const lines = csv.split('\n');
+  // TALK: 350.00, VAT 0%
+  assert.equal(lines[1], 'DRAFT,Kite & Co,2026-10-07,2026-11-06,draft,350.00,0.00,0.00,350.00,350.00');
+});
+
+test('exportCsv with large amounts', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const draft = r.value;
+
+  const csv = exportCsv([draft]);
+  const lines = csv.split('\n');
+  // LOGO-PACK: 1200€ * 10 = 12000€, VAT 21% = 2520€, total 14520€
+  assert.equal(lines[1], 'DRAFT,Kite & Co,2026-10-07,2026-11-06,draft,12000.00,0.00,2520.00,14520.00,14520.00');
+});
