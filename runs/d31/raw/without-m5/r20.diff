@@ -1,5 +1,8 @@
 import { ok, fail } from './result.js';
 
+/** Exchange rates: units of that currency per euro */
+export const RATES = { EUR: 1, USD: 1.085, GBP: 0.8425 };
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +42,34 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert cents from EUR to another currency.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }} - Amount in that currency's cents
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const rate = RATES[currency];
+  return ok(roundCents(cents * rate));
+}
+
+/**
+ * Format cents in a given currency for people: 123456 cents EUR -> "€1,234.56", USD -> "$1,234.56", GBP -> "£1,234.56"
+ * @param {number} cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  if (!(currency in RATES)) {
+    return formatEuros(cents);
+  }
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const amount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const symbol = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+  return `${sign}${symbol}${amount}.${String(abs % 100).padStart(2, '0')}`;
+}
diff --git a/test/currency.test.js b/test/currency.test.js
