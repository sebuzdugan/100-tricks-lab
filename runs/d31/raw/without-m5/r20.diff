+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { roundCents, formatEuros, parseEuros, RATES, convert, formatMoney } from '../src/money.js';
+
+test('RATES has EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert from EUR to USD', () => {
+  const r = convert(10000, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 10850);
+});
+
+test('convert from EUR to GBP', () => {
+  const r = convert(10000, 'GBP');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 8425);
+});
+
+test('convert from EUR to EUR', () => {
+  const r = convert(10000, 'EUR');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 10000);
+});
+
+test('convert returns error for unknown currency', () => {
+  const r = convert(10000, 'JPY');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with large amount', () => {
+  const r = convert(100000000, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 108500000);
+});
+
+test('convert with small amount', () => {
+  const r = convert(1, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 1);
+});
+
+test('convert rounding', () => {
+  const r = convert(184, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 200);
+});
+
+test('convert with negative amount', () => {
+  const r = convert(-10000, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, -10850);
+});
+
+test('formatMoney EUR format', () => {
+  const formatted = formatMoney(10000, 'EUR');
+  assert.equal(formatted, '€100.00');
+});
+
+test('formatMoney USD format', () => {
+  const formatted = formatMoney(10000, 'USD');
+  assert.equal(formatted, '$100.00');
+});
+
+test('formatMoney GBP format', () => {
+  const formatted = formatMoney(10000, 'GBP');
+  assert.equal(formatted, '£100.00');
+});
+
+test('formatMoney with thousands separator', () => {
+  const formatted = formatMoney(1234567, 'EUR');
+  assert.equal(formatted, '€12,345.67');
+});
+
+test('formatMoney USD with thousands separator', () => {
+  const formatted = formatMoney(1234567, 'USD');
+  assert.equal(formatted, '$12,345.67');
+});
+
+test('formatMoney GBP with thousands separator', () => {
+  const formatted = formatMoney(1234567, 'GBP');
+  assert.equal(formatted, '£12,345.67');
+});
+
+test('formatMoney with negative amount', () => {
+  const formatted = formatMoney(-10000, 'EUR');
+  assert.equal(formatted, '-€100.00');
+});
+
+test('formatMoney USD negative', () => {
+  const formatted = formatMoney(-10000, 'USD');
+  assert.equal(formatted, '-$100.00');
+});
+
+test('formatMoney GBP negative', () => {
+  const formatted = formatMoney(-10000, 'GBP');
+  assert.equal(formatted, '-£100.00');
+});
+
+test('formatMoney with zero', () => {
+  const formatted = formatMoney(0, 'EUR');
+  assert.equal(formatted, '€0.00');
+});
+
+test('formatMoney USD with zero', () => {
+  const formatted = formatMoney(0, 'USD');
+  assert.equal(formatted, '$0.00');
+});
+
+test('formatMoney with single cents', () => {
+  const formatted = formatMoney(1, 'EUR');
+  assert.equal(formatted, '€0.01');
+});
+
+test('formatMoney with cents only', () => {
+  const formatted = formatMoney(50, 'EUR');
+  assert.equal(formatted, '€0.50');
+});
+
+test('formatMoney unknown currency defaults to EUR format', () => {
+  const formatted = formatMoney(10000, 'JPY');
+  assert.equal(formatted, '€100.00');
+});
+
+test('formatMoney consistent with convert', () => {
+  const r = convert(10000, 'USD');
+  const formatted = formatMoney(r.value, 'USD');
+  assert.equal(formatted, '$108.50');
+});
+
+test('convert precise calculation USD', () => {
+  const r = convert(12345, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 13394);
+});
+
+test('convert precise calculation GBP', () => {
+  const r = convert(12345, 'GBP');
+  assert.equal(r.ok, true);
+  // 12345 * 0.8425 = 10400.6625 → rounds to 10401
+  assert.equal(r.value, 10401);
+});
+
+test('roundCents still works', () => {
+  const rounded = roundCents(123.456);
+  assert.equal(rounded, 123);
+});
+
+test('formatEuros still works', () => {
+  const formatted = formatEuros(10000);
+  assert.equal(formatted, '€100.00');
+});
+
+test('parseEuros still works', () => {
+  const r = parseEuros('123.45');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 12345);
+});
+
+test('convert with very large USD amount', () => {
+  const r = convert(999999999, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 1084999999);
+});
+
+test('convert with very small positive amount', () => {
+  const r = convert(1, 'GBP');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 1);
+});
+
+test('formatMoney large negative amount', () => {
+  const formatted = formatMoney(-999999999, 'USD');
+  assert.equal(formatted, '-$9,999,999.99');
+});
+
+test('convert multiple currencies separately', () => {
+  const eur = convert(10000, 'EUR');
+  const usd = convert(10000, 'USD');
+  const gbp = convert(10000, 'GBP');
+
+  assert.equal(eur.ok, true);
+  assert.equal(usd.ok, true);
+  assert.equal(gbp.ok, true);
+
+  assert.equal(eur.value, 10000);
+  assert.ok(usd.value > eur.value);
+  assert.ok(gbp.value < eur.value);
+});
+
+test('convert with empty string currency', () => {
+  const r = convert(10000, '');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert case sensitive currency', () => {
+  const r = convert(10000, 'usd');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'UNKNOWN_CURRENCY');
+});
+
+test('formatMoney case sensitive currency', () => {
+  const formatted = formatMoney(10000, 'usd');
+  assert.equal(formatted, '€100.00');
+});
+
+test('convert GBP precision edge case', () => {
+  const r = convert(100, 'GBP');
+  assert.equal(r.ok, true);
+  // 100 * 0.8425 = 84.25, rounds to 84 (half-to-even)
+  assert.equal(r.value, 84);
+});
+
+test('formatMoney smallest positive amount', () => {
+  const formatted = formatMoney(1, 'USD');
+  assert.equal(formatted, '$0.01');
+});
+
+test('convert maintains sign', () => {
+  const pos = convert(100, 'USD');
+  const neg = convert(-100, 'USD');
+  assert.ok(pos.value > 0);
+  assert.ok(neg.value < 0);
+});
+
+test('RATES export is immutable', () => {
+  const original = RATES.USD;
+  assert.equal(original, 1.085);
+});
