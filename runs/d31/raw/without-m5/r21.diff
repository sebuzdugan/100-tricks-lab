+test('mergeCustomers removes duplicate customer', () => {
+  const customers = [
+    { id: 'C-001', name: 'Customer A', email: 'a@example.com', country: 'NL', tier: 'standard' },
+    { id: 'C-002', name: 'Customer B', email: 'b@example.com', country: 'NL', tier: 'standard' },
+  ];
+  const invoices = [];
+
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, 1);
+  assert.equal(r.value.customers[0].id, 'C-002');
+});
