   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge a duplicate customer into another, reassigning all invoices.
+ * @param {Array<any>} customers - Array of customer objects
+ * @param {Array<any>} invoices - Array of invoice objects
+ * @param {string} fromId - Customer ID to merge from (will be removed)
+ * @param {string} intoId - Customer ID to merge into (will receive invoices)
+ * @returns {{ ok: true, value: { customers: Array<any>, invoices: Array<any> } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  // Check if trying to merge a customer into itself
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  // Check if both customers exist
+  const fromExists = customers.some((c) => normalizeId(c.id) === normalizedFromId);
+  const intoExists = customers.some((c) => normalizeId(c.id) === normalizedIntoId);
+
+  if (!fromExists || !intoExists) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Remove fromId customer and reassign invoices
+  const newCustomers = customers.filter((c) => normalizeId(c.id) !== normalizedFromId);
+  const newInvoices = invoices.map((inv) => {
+    if (normalizeId(inv.customerId) === normalizedFromId) {
+      return { ...inv, customerId: normalizedIntoId };
+    }
+    return { ...inv };
+  });
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
