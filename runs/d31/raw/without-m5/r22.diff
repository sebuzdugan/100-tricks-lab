+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty times unitPrice', () => {
+  const line = { qty: 2, unitPrice: 5000 };
+  assert.equal(lineTotal(line), 10000);
+});
+
+test('lineTotal rounds fractional cents', () => {
+  const line = { qty: 3, unitPrice: 100 };
+  assert.equal(lineTotal(line), 300);
+});
+
+test('lineTotal with zero qty', () => {
+  const line = { qty: 0, unitPrice: 5000 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineDiscount calculates discount on lineTotal', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 1000);
+});
+
+test('lineDiscount with zero discount', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with no discount percent uses default zero', () => {
+  const line = { qty: 1, unitPrice: 10000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100 percent discount', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 10000);
+});
+
+test('lineVat calculates VAT on base after discount', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 };
+  // base: 10000, vat: 10000 * 21 / 100 = 2100
+  assert.equal(lineVat(line), 2100);
+});
+
+test('lineVat on discounted line', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 };
+  // base: 10000 - 1000 = 9000, vat: 9000 * 21 / 100 = 1890
+  assert.equal(lineVat(line), 1890);
+});
+
+test('lineVat with zero VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with no VAT rate uses default zero', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with 9 percent rate', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 9 };
+  // vat: 10000 * 9 / 100 = 900
+  assert.equal(lineVat(line), 900);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 12100);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 15000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 3150);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 18150);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1000);
+  assert.equal(totals.vat, 1890);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 10890);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+    voucher: { amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.voucher, 500);
+  assert.equal(totals.total, 11600);
+});
+
+test('invoiceTotals with no voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals prevents negative total', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+    voucher: { amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 20000);
+  assert.equal(totals.discount, 0);
+  // vat: 10000 * 21/100 + 10000 * 9/100 = 2100 + 900 = 3000
+  assert.equal(totals.vat, 3000);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 23000);
+});
+
+test('invoiceTotals with zero VAT line', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 10000);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('lineTotal with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 50000 };
+  assert.equal(lineTotal(line), 50000000);
+});
+
+test('lineDiscount with complex discount', () => {
+  const line = { qty: 3, unitPrice: 3333, discountPercent: 15 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  // total: 9999, discount: 9999 * 15 / 100 = 1499.85 → 1500
+  assert.equal(discount, 1500);
+});
+
+test('lineVat rounding on discounted line', () => {
+  const line = { qty: 3, unitPrice: 1000, discountPercent: 33, vatRate: 21 };
+  const vat = lineVat(line);
+  // total: 3000, discount: 990, base: 2010, vat: 422.1 → 422
+  assert.equal(vat, 422);
+});
+
+test('invoiceTotals with all features', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 5000, discountPercent: 10, vatRate: 21 },
+      { qty: 1, unitPrice: 3000, discountPercent: 5, vatRate: 9 },
+    ],
+    voucher: { amount: 200 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: total 10000, discount 1000, base 9000, vat 1890
+  // Line 2: total 3000, discount 150, base 2850, vat 256.5 → 256 (half-to-even)
+  // Subtotal: 13000, discount: 1150, vat: 2146, voucher: 200
+  // Total: 13000 - 1150 + 2146 - 200 = 13796
+  assert.equal(totals.subtotal, 13000);
+  assert.equal(totals.discount, 1150);
+  assert.equal(totals.vat, 2146);
+  assert.equal(totals.voucher, 200);
+  assert.equal(totals.total, 13796);
+});
+
+test('lineTotal independent from lineDiscount', () => {
+  const line = { qty: 2, unitPrice: 5000, discountPercent: 25, vatRate: 21 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  // total should be 10000 regardless of discount
+  assert.equal(total, 10000);
+  assert.equal(discount, 2500);
+});
+
+test('invoiceTotals with single high-value line', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 1000000);
+  assert.equal(totals.vat, 210000);
+  assert.equal(totals.total, 1210000);
+});
+
+test('invoiceTotals with multiple vouchers (but only one is used)', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+    voucher: { amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Only the voucher amount should be deducted
+  assert.equal(totals.voucher, 500);
+  assert.equal(totals.total, 11600);
+});
+
+test('invoiceTotals does not mutate input', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const before = JSON.stringify(invoice);
+  invoiceTotals(invoice);
+  const after = JSON.stringify(invoice);
+  assert.equal(before, after);
+});
