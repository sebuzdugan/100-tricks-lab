diff --git a/src/totals.js b/src/totals.js
index afab4af..469d8b4 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -10,14 +10,24 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount for a single line: lineTotal times discountPercent / 100.
+ * Calculate the discount for a single line: lineTotal times discountPercent / 100, plus bulk discount if qty >= 10.
+ * Bulk discount is 2.5% of the amount remaining after the first discount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
   const total = lineTotal(line);
   const discountPercent = line.discountPercent ?? 0;
-  return roundCents(total * discountPercent / 100);
+  const regularDiscount = roundCents(total * discountPercent / 100);
+
+  // Apply bulk discount (2.5%) if qty >= 10, on what remains after regular discount
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const remaining = total - regularDiscount;
+    bulkDiscount = roundCents(remaining * 2.5 / 100);
+  }
+
+  return regularDiscount + bulkDiscount;
 }
 
