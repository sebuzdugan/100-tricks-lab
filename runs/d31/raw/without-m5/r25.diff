@@ -2,6 +2,7 @@ import { ok, fail } from './result.js';
 import { getCustomer } from './customers.js';
 import { formatEuros } from './money.js';
 import { lineTotal, lineDiscount, lineVat, invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
 
 /**
  * Render an invoice as plain text for display to customers.
@@ -49,8 +50,27 @@ export function renderInvoiceText(invoice) {
     const vatText = formatEuros(totals.vat);
     lines.push(`VAT: ${vatText}`);
   }
+
+  // Add voucher if present
+  if (totals.voucher > 0) {
+    const voucherText = formatEuros(totals.voucher);
+    lines.push(`Voucher: -${voucherText}`);
+  }
+
   const totalText = formatEuros(totals.total);
   lines.push(`Total: ${totalText}`);
 
+  // Add due date if invoice is issued (not draft)
+  if (invoice.dueDate && invoice.status !== 'draft') {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Add paid amount if there are payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const paidText = formatEuros(totalPaid);
+    lines.push(`Paid: ${paidText}`);
+  }
+
   return ok(lines.join('\n'));
 }
