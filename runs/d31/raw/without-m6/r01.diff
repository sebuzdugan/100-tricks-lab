diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..dc77710
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,67 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+function isValidDate(dateStr) {
+  const regex = /^(\d{4})-(\d{2})-(\d{2})$/;
+  const match = regex.exec(dateStr);
+  if (!match) return false;
+
+  const year = parseInt(match[1], 10);
+  const month = parseInt(match[2], 10);
+  const day = parseInt(match[3], 10);
+
+  if (month < 1 || month > 12) return false;
+  if (day < 1 || day > 31) return false;
+
+  const date = new Date(year, month - 1, day);
+  return (
+    date.getFullYear() === year &&
+    date.getMonth() === month - 1 &&
+    date.getDate() === day
+  );
+}
+
+function isPositiveInteger(n) {
+  return Number.isInteger(n) && n > 0;
+}
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  const invoiceLines = [];
+  for (const line of lines) {
+    const { sku, qty } = line;
+
+    if (!isPositiveInteger(qty)) return fail('QTY_INVALID');
+
+    const productResult = getProduct(sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..b58de07
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,197 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('creates an invoice with valid customer, date, and lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2024-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+  assert.equal(result.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[0].qty, 10);
+  assert.equal(result.value.lines[0].unitPrice, 8500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+});
+
+test('creates an invoice with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-06-30',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'STICKER', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[1].name, 'Sticker sheet');
+});
+
+test('reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('reports DATE_INVALID for missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: undefined,
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('reports DATE_INVALID for wrong format', () => {
+  const formats = ['2024/01/15', '15-01-2024', '01/15/2024', '2024-1-15', '2024-01-5'];
+  for (const dateStr of formats) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, false, `Should reject date format: ${dateStr}`);
+    assert.equal(result.error, 'DATE_INVALID');
+  }
+});
+
+test('reports DATE_INVALID for non-existent dates', () => {
+  const dates = ['2024-02-30', '2024-04-31', '2024-13-01', '2024-00-15'];
+  for (const dateStr of dates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, false, `Should reject non-existent date: ${dateStr}`);
+    assert.equal(result.error, 'DATE_INVALID');
+  }
+});
+
+test('accepts valid leap year date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.issueDate, '2024-02-29');
+});
+
+test('reports NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('reports NO_LINES for undefined lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: undefined,
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('reports QTY_INVALID for non-integer qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('reports QTY_INVALID for zero qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('reports QTY_INVALID for negative qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('reports UNKNOWN_SKU for invalid SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'NOPE', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('returns different items for different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 9);
+  assert.equal(result.value.lines[1].vatRate, 0);
+});
+
+test('does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const originalQty = lines[0].qty;
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines,
+  });
+
+  assert.equal(lines[0].qty, originalQty);
+  assert.equal(lines.length, 1);
+});
+
+test('returns a copy, not a reference to input lines', () => {
+  const input = [{ sku: 'DES-HOUR', qty: 5 }];
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: input,
+  });
+
+  assert.equal(result.ok, true);
+  result.value.lines[0].name = 'Modified';
+  assert.equal(input[0].name, undefined);
+});
