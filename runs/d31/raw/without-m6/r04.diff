@@ -0,0 +1,24 @@
+/**
+ * Get the next invoice number for a given issue date.
+ * Format: INV-<year>-<4-digit-counter>, counter resets each year starting at 0001.
+ * @param {string[]} existingNumbers - array of invoice numbers already used
+ * @param {string} issueDate - invoice issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  const currentYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = currentYearNumbers.length === 0 ? 0 : Math.max(...currentYearNumbers);
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
