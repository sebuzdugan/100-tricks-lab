diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..c1af97b
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,58 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('returns INV-YYYY-0001 when no existing numbers', () => {
+  const result = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(result, 'INV-2024-0001');
+});
+
+test('increments counter for same year', () => {
+  const result = nextInvoiceNumber(['INV-2024-0001', 'INV-2024-0002'], '2024-06-20');
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('starts fresh for new year', () => {
+  const result = nextInvoiceNumber(['INV-2024-0010'], '2025-01-01');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('ignores numbers from other years', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2023-0001', 'INV-2023-0050', 'INV-2024-0002', 'INV-2025-0001'],
+    '2024-03-15'
+  );
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('finds max counter regardless of order', () => {
+  const result = nextInvoiceNumber(['INV-2024-0005', 'INV-2024-0001', 'INV-2024-0003'], '2024-12-31');
+  assert.equal(result, 'INV-2024-0006');
+});
+
+test('pads counter to 4 digits', () => {
+  const result = nextInvoiceNumber([], '2024-01-01');
+  assert.equal(result, 'INV-2024-0001');
+
+  const result2 = nextInvoiceNumber(['INV-2024-0009'], '2024-01-01');
+  assert.equal(result2, 'INV-2024-0010');
+
+  const result3 = nextInvoiceNumber(['INV-2024-0099'], '2024-01-01');
+  assert.equal(result3, 'INV-2024-0100');
+
+  const result4 = nextInvoiceNumber(['INV-2024-0999'], '2024-01-01');
+  assert.equal(result4, 'INV-2024-1000');
+});
+
+test('handles mixed valid and invalid numbers', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2024-0001', 'INVALID', 'INV-2024-XXX', 'INV-2024-0002'],
+    '2024-01-01'
+  );
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('handles empty counter strings', () => {
+  const result = nextInvoiceNumber(['INV-2024-'], '2024-01-01');
+  assert.equal(result, 'INV-2024-0001');
+});
