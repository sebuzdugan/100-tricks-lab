+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+import { ok } from './result.js';
+
+/**
+ * Render an invoice as plain text.
+ * First line: invoice number or "DRAFT", then customer name, one line per item,
+ * and finally a total line. All amounts formatted as euros.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const customer = customerResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const lines = [];
+
+  lines.push(invoice.number ?? 'DRAFT');
+  lines.push(customer.name);
+
+  for (const line of invoice.lines) {
+    const lineAmount = lineTotal(line);
+    const formattedUnitPrice = formatEuros(line.unitPrice);
+    const formattedLineTotal = formatEuros(lineAmount);
+    lines.push(`${line.qty} x ${line.name} @ ${formattedUnitPrice} = ${formattedLineTotal}`);
+  }
+
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return ok(lines.join('\n'));
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..cef578f
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,154 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renders a draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const result = renderInvoiceText(invoiceResult.value);
+  assert.equal(result.ok, true);
+
+  const text = result.value;
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /10 x Design work \(hour\) @ €85\.00 = €850\.00\n/);
+  assert.match(text, /Total: €850\.00$/);
+});
+
+test('renders an issued invoice with number', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-06-20',
+    lines: [{ sku: 'STICKER', qty: 5 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = renderInvoiceText(issuedResult.value);
+  assert.equal(result.ok, true);
+
+  const text = result.value;
+  assert.match(text, /^INV-2024-0001\n/);
+  assert.match(text, /Kite & Co\n/);
+  assert.match(text, /5 x Sticker sheet @ €0\.50 = €2\.50\n/);
+  assert.match(text, /Total: €2\.50$/);
+});
+
+test('renders invoice with multiple lines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-01',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+
+  const result = renderInvoiceText(invoiceResult.value);
+  assert.equal(result.ok, true);
+
+  const text = result.value;
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Blue Fern Bakery\n/);
+  assert.match(text, /3 x Design work \(hour\) @ €85\.00 = €255\.00/);
+  assert.match(text, /2 x Copywriting \(hour\) @ €60\.00 = €120\.00/);
+  assert.match(text, /Total: €375\.00$/);
+});
+
+test('formats all amounts through formatEuros', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  const result = renderInvoiceText(invoiceResult.value);
+  assert.equal(result.ok, true);
+
+  const text = result.value;
+  // PRINT-A4: 37 cents per unit, 100 units = 3700 cents = €37.00
+  assert.match(text, /100 x Printed flyer A4 \(each\) @ €0\.37 = €37\.00/);
+  // WORKSHOP-DAY: 60000 cents = €600.00
+  assert.match(text, /1 x Brand workshop \(day, VAT exempt\) @ €600\.00 = €600\.00/);
+  assert.match(text, /Total: €637\.00$/);
+});
+
+test('reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('does not mutate the invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invoice = invoiceResult.value;
+  const originalLines = invoice.lines.length;
+  const originalFirstQty = invoice.lines[0].qty;
+
+  renderInvoiceText(invoice);
+
+  assert.equal(invoice.lines.length, originalLines);
+  assert.equal(invoice.lines[0].qty, originalFirstQty);
+});
+
+test('uses DRAFT when invoice has no number', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  assert.match(result.value, /^DRAFT\n/);
+});
+
+test('uses invoice number when present', () => {
+  const invoice = {
+    number: 'INV-2024-0005',
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  assert.match(result.value, /^INV-2024-0005\n/);
+});
+
+test('handles large quantities and prices', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'LOGO-PACK', name: 'Logo package', qty: 50, unitPrice: 120000, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+
+  const text = result.value;
+  // 50 x 120000 cents = 6000000 cents = €60,000.00
+  assert.match(text, /50 x Logo package @ €1,200\.00 = €60,000\.00/);
+  assert.match(text, /Total: €60,000\.00$/);
+});
