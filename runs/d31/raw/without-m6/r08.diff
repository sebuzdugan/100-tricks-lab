 /**
- * Calculate subtotal, discount and total for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }}
+ * Calculate subtotal, discount, VAT and total for an invoice.
+ * VAT is calculated per line on the amount after discount, rounded per line.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   let subtotal = 0;
   let discount = 0;
+  let vat = 0;
+
   for (const line of invoice.lines) {
     const lineAmount = lineTotal(line);
     subtotal += lineAmount;
+
     const lineDiscount = roundCents(lineAmount * ((line.discountPercent ?? 0) / 100));
     discount += lineDiscount;
+
+    const lineAfterDiscount = lineAmount - lineDiscount;
+    const lineVat = roundCents(lineAfterDiscount * (line.vatRate / 100));
+    vat += lineVat;
   }
+
   return {
     subtotal: Math.max(0, subtotal),
     discount: Math.max(0, discount),
-    total: Math.max(0, subtotal - discount),
+    vat: Math.max(0, vat),
+    total: Math.max(0, subtotal - discount + vat),
   };
 }
 
