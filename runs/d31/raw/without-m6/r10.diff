diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..d4e3f86
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,138 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2024-01-15'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2024-01-01'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2024/01/15'), false);
+  assert.equal(isValidDate('01-15-2024'), false);
+  assert.equal(isValidDate('2024-1-15'), false);
+  assert.equal(isValidDate('2024-01-5'), false);
+  assert.equal(isValidDate('2024-01-15 '), false);
+  assert.equal(isValidDate('not-a-date'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(20240115), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(['2024-01-15']), false);
+});
+
+test('isValidDate rejects invalid month', () => {
+  assert.equal(isValidDate('2024-00-15'), false);
+  assert.equal(isValidDate('2024-13-15'), false);
+  assert.equal(isValidDate('2024-99-15'), false);
+});
+
+test('isValidDate rejects invalid day', () => {
+  assert.equal(isValidDate('2024-01-00'), false);
+  assert.equal(isValidDate('2024-01-32'), false);
+  assert.equal(isValidDate('2024-01-99'), false);
+});
+
+test('isValidDate rejects February 30', () => {
+  assert.equal(isValidDate('2024-02-30'), false);
+  assert.equal(isValidDate('2023-02-30'), false);
+});
+
+test('isValidDate accepts February 29 in leap year', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+});
+
+test('isValidDate rejects February 29 in non-leap year', () => {
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('isValidDate rejects April 31', () => {
+  assert.equal(isValidDate('2024-04-31'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2024-01-15', 1), '2024-01-16');
+  assert.equal(addDays('2024-01-15', 10), '2024-01-25');
+  assert.equal(addDays('2024-01-25', 10), '2024-02-04');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2024-01-15', -1), '2024-01-14');
+  assert.equal(addDays('2024-01-15', -10), '2024-01-05');
+  assert.equal(addDays('2024-01-05', -10), '2023-12-26');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2024-01-31', 1), '2024-02-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2023-12-31', 1), '2024-01-01');
+  assert.equal(addDays('2024-01-01', -1), '2023-12-31');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2024-01-15', 0), '2024-01-15');
+});
+
+test('addDays throws for invalid date', () => {
+  assert.throws(() => addDays('2024-02-30', 1), /Invalid date/);
+  assert.throws(() => addDays('not-a-date', 1), /Invalid date/);
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2024-01-15', '2024-01-16'), 1);
+  assert.equal(daysBetween('2024-01-15', '2024-01-25'), 10);
+  assert.equal(daysBetween('2024-01-15', '2024-02-15'), 31);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2024-01-16', '2024-01-15'), -1);
+  assert.equal(daysBetween('2024-01-25', '2024-01-15'), -10);
+});
+
+test('daysBetween with same dates returns 0', () => {
+  assert.equal(daysBetween('2024-01-15', '2024-01-15'), 0);
+});
+
+test('daysBetween across month boundaries', () => {
+  assert.equal(daysBetween('2024-01-31', '2024-02-01'), 1);
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+});
+
+test('daysBetween across year boundaries', () => {
+  assert.equal(daysBetween('2023-12-31', '2024-01-01'), 1);
+  assert.equal(daysBetween('2024-01-01', '2023-12-31'), -1);
+});
+
+test('daysBetween across multiple years', () => {
+  assert.equal(daysBetween('2024-01-15', '2025-01-15'), 366);
+  assert.equal(daysBetween('2023-01-15', '2024-01-15'), 365);
+});
+
+test('daysBetween throws for invalid dates', () => {
+  assert.throws(() => daysBetween('2024-02-30', '2024-03-01'), /Invalid date/);
+  assert.throws(() => daysBetween('2024-01-15', 'not-a-date'), /Invalid date/);
+  assert.throws(() => daysBetween('invalid', '2024-01-15'), /Invalid date/);
+});
+
+test('daysBetween uses UTC (not affected by local timezone)', () => {
+  // Both dates are at UTC midnight, so the difference should be exact
+  const days = daysBetween('2024-01-15', '2024-01-16');
+  assert.equal(days, 1);
+
+  // 2024 is a leap year, so Jan 1 to Dec 31 is 365 days
+  const days2 = daysBetween('2024-01-01', '2024-12-31');
+  assert.equal(days2, 365);
+});
