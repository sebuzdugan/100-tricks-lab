+/**
+ * Check if text is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+
+  const regex = /^(\d{4})-(\d{2})-(\d{2})$/;
+  const match = regex.exec(text);
+  if (!match) return false;
+
+  const year = parseInt(match[1], 10);
+  const month = parseInt(match[2], 10);
+  const day = parseInt(match[3], 10);
+
+  if (month < 1 || month > 12) return false;
+  if (day < 1 || day > 31) return false;
+
+  const date = new Date(Date.UTC(year, month - 1, day));
+  return (
+    date.getUTCFullYear() === year &&
+    date.getUTCMonth() === month - 1 &&
+    date.getUTCDate() === day
+  );
+}
+
+/**
+ * Add n days to a date (in UTC).
+ * @param {string} dateStr - date in YYYY-MM-DD format
+ * @param {number} n - number of days to add
+ * @returns {string} - date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  if (!isValidDate(dateStr)) {
+    throw new Error(`Invalid date: ${dateStr}`);
+  }
+
+  const [year, month, day] = dateStr.split('-').map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  date.setUTCDate(date.getUTCDate() + n);
+
+  const y = date.getUTCFullYear();
+  const m = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const d = String(date.getUTCDate()).padStart(2, '0');
+  return `${y}-${m}-${d}`;
+}
+
+/**
+ * Calculate the number of days between two dates (b - a, in whole days, using UTC).
+ * @param {string} a - date in YYYY-MM-DD format
+ * @param {string} b - date in YYYY-MM-DD format
+ * @returns {number} - number of whole days between a and b
+ */
+export function daysBetween(a, b) {
+  if (!isValidDate(a) || !isValidDate(b)) {
+    throw new Error('Invalid date');
+  }
+
+  const [ya, ma, da] = a.split('-').map(Number);
+  const [yb, mb, db] = b.split('-').map(Number);
+
+  const dateA = new Date(Date.UTC(ya, ma - 1, da));
+  const dateB = new Date(Date.UTC(yb, mb - 1, db));
+
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
