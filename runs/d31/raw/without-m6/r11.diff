+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+function isPositiveInteger(n) {
+  return Number.isInteger(n) && n > 0;
+}
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} params
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!isPositiveInteger(amount)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  const currentlyPaid = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  const stillOwed = totals.total - currentlyPaid;
+
+  if (amount > stillOwed) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = [...(invoice.payments || []), { amount, date }];
+  const newPaidAmount = currentlyPaid + amount;
+  const newStatus = newPaidAmount >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paidAmount = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - paidAmount);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
