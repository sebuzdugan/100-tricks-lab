+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('recordPayment adds payment to issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = recordPayment(issuedResult.value, { amount: 50000, date: '2024-01-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2024-01-20');
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 10000, date: '2024-01-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+});
+
+test('recordPayment marks invoice as partially_paid when not fully paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = recordPayment(issuedResult.value, { amount: 50000, date: '2024-01-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment marks invoice as paid when fully paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // STICKER: 100 * 50 cents = 5000 cents, VAT: 5000 * 0.21 = 1050, Total: 6050
+  const result = recordPayment(issuedResult.value, { amount: 6050, date: '2024-01-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment accepts multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const payment1 = recordPayment(issuedResult.value, { amount: 40000, date: '2024-01-20' });
+
+  assert.equal(payment1.ok, true);
+  assert.equal(payment1.value.status, 'partially_paid');
+
+  // Second payment for remaining amount
+  const payment2 = recordPayment(payment1.value, { amount: 57708, date: '2024-01-25' });
+
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.payments.length, 2);
+  assert.equal(payment2.value.status, 'paid');
+});
+
+test('recordPayment reports NOT_ISSUED for draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const result = recordPayment(invoiceResult.value, { amount: 50000, date: '2024-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment reports NOT_ISSUED for paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'paid',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 10000, date: '2024-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment reports AMOUNT_INVALID for non-integer amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  assert.deepEqual(recordPayment(invoice, { amount: 10000.5, date: '2024-01-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment reports AMOUNT_INVALID for zero amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  assert.deepEqual(recordPayment(invoice, { amount: 0, date: '2024-01-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment reports AMOUNT_INVALID for negative amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  assert.deepEqual(recordPayment(invoice, { amount: -10000, date: '2024-01-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment reports DATE_INVALID for invalid date', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  assert.deepEqual(recordPayment(invoice, { amount: 10000, date: '2024-13-01' }), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+});
+
+test('recordPayment reports OVERPAYMENT when payment exceeds balance due', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // STICKER: 100 * 50 cents = 5000 cents, VAT: 5000 * 0.21 = 1050, Total: 6050
+  const result = recordPayment(issuedResult.value, { amount: 7000, date: '2024-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment reports OVERPAYMENT after partial payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const payment1 = recordPayment(issuedResult.value, { amount: 50000, date: '2024-01-20' });
+
+  assert.equal(payment1.ok, true);
+
+  // Try to overpay
+  const payment2 = recordPayment(payment1.value, { amount: 100000, date: '2024-01-25' });
+
+  assert.deepEqual(payment2, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate the input invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const originalStatus = invoice.status;
+
+  recordPayment(invoice, { amount: 50000, date: '2024-01-20' });
+
+  assert.equal(invoice.status, originalStatus);
+  assert.equal(invoice.payments, undefined);
+});
+
+test('balanceDue returns total for issued invoice with no payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const due = balanceDue(issuedResult.value);
+
+  // Total with discount and VAT
+  assert.ok(due > 0);
+  assert.ok(Number.isInteger(due));
+});
+
+test('balanceDue returns remaining balance after partial payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // STICKER: 100 * 50 cents = 5000 cents, VAT: 5000 * 0.21 = 1050, Total: 6050
+  const payment = recordPayment(issuedResult.value, { amount: 2000, date: '2024-01-20' });
+
+  const due = balanceDue(payment.value);
+  assert.equal(due, 4050);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // STICKER: 100 * 50 cents = 5000 cents, VAT: 5000 * 0.21 = 1050, Total: 6050
+  const payment = recordPayment(issuedResult.value, { amount: 6050, date: '2024-01-20' });
+
+  const due = balanceDue(payment.value);
+  assert.equal(due, 0);
+});
+
+test('balanceDue returns 0 for invoice with no payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const due = balanceDue(invoice);
+  // Draft invoice with total
+  assert.ok(due > 0);
+});
