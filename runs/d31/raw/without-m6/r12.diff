+
+test('lastDayOfMonth for February in leap year', () => {
+  assert.equal(lastDayOfMonth('2024-02-15'), '2024-02-29');
+  assert.equal(lastDayOfMonth('2024-02-01'), '2024-02-29');
+});
+
+test('lastDayOfMonth for February in non-leap year', () => {
+  assert.equal(lastDayOfMonth('2025-02-15'), '2025-02-28');
+  assert.equal(lastDayOfMonth('2023-02-01'), '2023-02-28');
+});
+
