+
+/**
+ * Get the last day of the month for a given date (in YYYY-MM-DD format).
+ * @param {string} dateStr - date in YYYY-MM-DD format
+ * @returns {string} - last day of the month in YYYY-MM-DD format
+ */
+export function lastDayOfMonth(dateStr) {
+  if (!isValidDate(dateStr)) {
+    throw new Error(`Invalid date: ${dateStr}`);
+  }
+
+  const [year, month] = dateStr.split('-').map(Number);
+  let nextMonth = month + 1;
+  let nextYear = year;
+  if (nextMonth > 12) {
+    nextMonth = 1;
+    nextYear += 1;
+  }
+  const firstOfNext = `${nextYear}-${String(nextMonth).padStart(2, '0')}-01`;
+  return addDays(firstOfNext, -1);
+}
