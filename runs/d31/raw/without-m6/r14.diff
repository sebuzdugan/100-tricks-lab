+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement lists issued invoices for customer', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(inv1Result.value, []);
+
+  const result = statement('C-001', [issuedResult.value], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2024-0001');
+  assert.ok(result.value.totalDue > 0);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(inv1Result.value, []);
+  // STICKER: 100 * 50 = 5000, VAT: 1050, Total: 6050
+  const paymentResult = recordPayment(issuedResult.value, { amount: 2000, date: '2024-01-20' });
+
+  const result = statement('C-001', [paymentResult.value], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, 4050);
+  assert.equal(result.value.totalDue, 4050);
+});
+
+test('statement filters by date (asOf)', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2024-0001']);
+
+  // Query as of 2024-01-31 - should only include first invoice
+  const result = statement('C-001', [issued1.value, issued2.value], '2024-01-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+
+  const result = statement('C-001', [issued1.value], '2024-02-14');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2024-0001']);
+  const issued3 = issueInvoice(inv3Result.value, ['INV-2024-0001', 'INV-2024-0002']);
+
+  const result = statement('C-001', [issued1.value, issued2.value, issued3.value], '2024-04-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+  assert.equal(result.value.invoices[1].issueDate, '2024-02-15');
+  assert.equal(result.value.invoices[2].issueDate, '2024-03-15');
+});
+
+test('statement excludes draft invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  // Don't issue - leave as draft
+  const result = statement('C-001', [inv1Result.value], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(inv1Result.value, []);
+  // STICKER: 100 * 50 = 5000, VAT: 1050, Total: 6050
+  const paidResult = recordPayment(issuedResult.value, { amount: 6050, date: '2024-01-20' });
+
+  const result = statement('C-001', [paidResult.value], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement excludes other customers\' invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2024-0001']);
+
+  const result = statement('C-001', [issued1.value, issued2.value], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2024-0001');
+});
+
+test('statement reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('C-999', [], '2024-02-01');
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement normalizes customer ID', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+
+  // Query with lowercase and spaces
+  const result = statement('  c-001  ', [issued1.value], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement calculates totalDue correctly with multiple invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2024-0001']);
+
+  // Both STICKER invoices: 100 * 50 = 5000, VAT: 1050, Total each: 6050
+  // Pay 2000 on first invoice, leaving 4050
+  const payment1 = recordPayment(issued1.value, { amount: 2000, date: '2024-01-20' });
+
+  const result = statement('C-001', [payment1.value, issued2.value], '2024-03-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].due, 4050);
+  assert.equal(result.value.invoices[1].due, 6050);
+  assert.equal(result.value.totalDue, 10100);
+});
+
+test('statement includes dueDate in invoice listings', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+
+  const result = statement('C-001', [issued1.value], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].dueDate, '2024-01-29');
+});
+
+test('statement empty for customer with no outstanding invoices', () => {
+  const result = statement('C-001', [], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
