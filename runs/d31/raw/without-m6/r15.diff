diff --git a/src/numbering.js b/src/numbering.js
index 42ad683..4fff428 100644
--- a/src/numbering.js
+++ b/src/numbering.js
@@ -22,3 +22,29 @@ export function nextInvoiceNumber(existingNumbers, issueDate) {
 
   return `${prefix}${String(nextCounter).padStart(4, '0')}`;
 }
+
+/**
+ * Get the next credit note number for a given issue date.
+ * Format: CN-<year>-<4-digit-counter>, counter resets each year starting at 0001.
+ * Credit notes use a separate counter from invoices.
+ * @param {string[]} existingNumbers - array of numbers (invoices and credit notes) already used
+ * @param {string} issueDate - credit note issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  const currentYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = currentYearNumbers.length === 0 ? 0 : Math.max(...currentYearNumbers);
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
diff --git a/test/credits.test.js b/test/credits.test.js
