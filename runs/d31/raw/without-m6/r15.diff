+++ b/test/credits.test.js
@@ -0,0 +1,269 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = createCreditNote(
+    issuedResult.value,
+    { amount: 10000, reason: 'Partial refund', date: '2024-02-01' },
+    ['INV-2024-0001']
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2024-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 10000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2024-02-01');
+});
+
+test('createCreditNote works for partially_paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const paymentResult = recordPayment(issuedResult.value, { amount: 2000, date: '2024-01-20' });
+
+  const result = createCreditNote(
+    paymentResult.value,
+    { amount: 1000, reason: 'Customer complaint', date: '2024-02-01' },
+    ['INV-2024-0001']
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote works for paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // STICKER: 100 * 50 = 5000, VAT: 1050, Total: 6050
+  const paymentResult = recordPayment(issuedResult.value, { amount: 6050, date: '2024-01-20' });
+
+  const result = createCreditNote(
+    paymentResult.value,
+    { amount: 1000, reason: 'Full refund', date: '2024-02-01' },
+    ['INV-2024-0001']
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote reports NOT_ISSUED for draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const result = createCreditNote(
+    invoiceResult.value,
+    { amount: 10000, reason: 'Test', date: '2024-02-01' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for non-integer amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+
+  assert.deepEqual(
+    createCreditNote(
+      issuedResult.value,
+      { amount: 10000.5, reason: 'Test', date: '2024-02-01' },
+      ['INV-2024-0001']
+    ),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote reports AMOUNT_INVALID for zero amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+
+  assert.deepEqual(
+    createCreditNote(
+      issuedResult.value,
+      { amount: 0, reason: 'Test', date: '2024-02-01' },
+      ['INV-2024-0001']
+    ),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote reports AMOUNT_INVALID for negative amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+
+  assert.deepEqual(
+    createCreditNote(
+      issuedResult.value,
+      { amount: -10000, reason: 'Test', date: '2024-02-01' },
+      ['INV-2024-0001']
+    ),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote reports CREDIT_TOO_HIGH when credit exceeds invoice total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // STICKER: 100 * 50 = 5000, VAT: 1050, Total: 6050
+
+  const result = createCreditNote(
+    issuedResult.value,
+    { amount: 7000, reason: 'Test', date: '2024-02-01' },
+    ['INV-2024-0001']
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // STICKER: 100 * 50 = 5000, VAT: 1050, Total: 6050
+
+  const result = createCreditNote(
+    issuedResult.value,
+    { amount: 6050, reason: 'Full refund', date: '2024-02-01' },
+    ['INV-2024-0001']
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 6050);
+});
+
+test('createCreditNote uses separate counter from invoices', () => {
+  const invoice1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invoice2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issued1 = issueInvoice(invoice1Result.value, []);
+  const issued2 = issueInvoice(invoice2Result.value, ['INV-2024-0001']);
+
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002'];
+
+  const cn1 = createCreditNote(
+    issued1.value,
+    { amount: 10000, reason: 'Test', date: '2024-01-20' },
+    existingNumbers
+  );
+
+  assert.equal(cn1.value.number, 'CN-2024-0001');
+
+  const cn2 = createCreditNote(
+    issued2.value,
+    { amount: 10000, reason: 'Test', date: '2024-02-20' },
+    [...existingNumbers, cn1.value.number]
+  );
+
+  assert.equal(cn2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const invoice1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invoice2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issued1 = issueInvoice(invoice1Result.value, []);
+  const issued2 = issueInvoice(invoice2Result.value, ['INV-2024-0001']);
+
+  const cn1 = createCreditNote(
+    issued1.value,
+    { amount: 10000, reason: 'Test', date: '2024-01-20' },
+    ['INV-2024-0001']
+  );
+
+  assert.equal(cn1.value.number, 'CN-2024-0001');
+
+  const cn2 = createCreditNote(
+    issued2.value,
+    { amount: 10000, reason: 'Test', date: '2025-01-20' },
+    ['INV-2024-0001', 'INV-2025-0001', 'CN-2024-0001']
+  );
+
+  assert.equal(cn2.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote with discounts and vouchers', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Subtotal: 85000, Discount: 8500, VAT: 16065, Total: 92565
+
+  const result = createCreditNote(
+    issuedResult.value,
+    { amount: 92565, reason: 'Full refund', date: '2024-02-01' },
+    ['INV-2024-0001']
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 92565);
+});
