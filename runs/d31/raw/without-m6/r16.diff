+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices finds overdue issued invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Due date: 2024-01-29
+  const result = overdueInvoices([issuedResult.value], '2024-02-01');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2024-0001');
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2024-01-29');
+  assert.equal(result[0].daysOverdue, 3);
+  assert.ok(result[0].due > 0);
+});
+
+test('overdueInvoices finds overdue partially_paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const paymentResult = recordPayment(issuedResult.value, { amount: 2000, date: '2024-01-20' });
+
+  // Due date: 2024-01-29
+  const result = overdueInvoices([paymentResult.value], '2024-02-01');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2024-0001');
+  assert.equal(result[0].daysOverdue, 3);
+  // STICKER total: 6050, paid 2000, due: 4050
+  assert.equal(result[0].due, 4050);
+});
+
+test('overdueInvoices excludes non-overdue invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET30',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Due date: 2024-02-14
+  const result = overdueInvoices([issuedResult.value], '2024-02-14');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  // Don't issue - leave as draft
+  const result = overdueInvoices([invoiceResult.value], '2024-02-01');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // STICKER total: 6050
+  const paymentResult = recordPayment(issuedResult.value, { amount: 6050, date: '2024-01-20' });
+
+  const result = overdueInvoices([paymentResult.value], '2024-02-01');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-10',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const inv3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2024-0001']);
+  const issued3 = issueInvoice(inv3Result.value, ['INV-2024-0001', 'INV-2024-0002']);
+
+  // Due dates: 2024-01-15, 2024-01-24, 2024-02-03
+  const result = overdueInvoices([issued3.value, issued1.value, issued2.value], '2024-02-10');
+
+  assert.equal(result.length, 3);
+  assert.ok(result[0].daysOverdue >= result[1].daysOverdue);
+  assert.ok(result[1].daysOverdue >= result[2].daysOverdue);
+  assert.equal(result[0].daysOverdue, 26);
+  assert.equal(result[1].daysOverdue, 17);
+  assert.equal(result[2].daysOverdue, 7);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Due date: 2024-01-29
+
+  const result1 = overdueInvoices([issuedResult.value], '2024-01-30');
+  assert.equal(result1.length, 1);
+  assert.equal(result1[0].daysOverdue, 1);
+
+  const result2 = overdueInvoices([issuedResult.value], '2024-02-05');
+  assert.equal(result2.length, 1);
+  assert.equal(result2[0].daysOverdue, 7);
+
+  const result3 = overdueInvoices([issuedResult.value], '2024-02-29');
+  assert.equal(result3.length, 1);
+  assert.equal(result3[0].daysOverdue, 31);
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2024-0001']);
+
+  const result = overdueInvoices([issued1.value, issued2.value], '2024-02-01');
+
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-002');
+  assert.equal(result[1].customerId, 'C-001');
+});
+
+test('overdueInvoices with EOM terms', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'EOM',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Due date: 2024-01-31
+
+  const result = overdueInvoices([issuedResult.value], '2024-02-01');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2024-01-31');
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices empty when no invoices provided', () => {
+  const result = overdueInvoices([], '2024-02-01');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices empty when no invoices are overdue', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET30',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Due date: 2024-03-02
+
+  const result = overdueInvoices([issuedResult.value], '2024-03-01');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoice number and customer ID', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+
+  const result = overdueInvoices([issuedResult.value], '2024-02-01');
+
+  assert.equal(result.length, 1);
+  assert.ok(result[0].number.startsWith('INV-'));
+  assert.equal(result[0].customerId, 'C-003');
+  assert.ok(result[0].dueDate);
+  assert.ok(result[0].daysOverdue >= 0);
+  assert.ok(result[0].due >= 0);
+});
