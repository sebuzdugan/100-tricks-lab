+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * List invoices that are overdue as of a given date.
+ * @param {Array} invoices - all invoices to search through
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ *          sorted by daysOverdue descending (most overdue first)
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
