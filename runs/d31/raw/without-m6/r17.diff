     }))
     .sort((a, b) => b.daysOverdue - a.daysOverdue);
 }
+
+/**
+ * Summarize VAT by rate across invoices.
+ * @param {Array} invoices - all invoices to process
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ *          sorted by rate descending (high to low)
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const lineAmount = lineTotal(line);
+        const lineDiscount = roundCents(lineAmount * ((line.discountPercent ?? 0) / 100));
+        const lineAfterDiscount = lineAmount - lineDiscount;
+        const lineVat = roundCents(lineAfterDiscount * (line.vatRate / 100));
+
+        if (!vatByRate[line.vatRate]) {
+          vatByRate[line.vatRate] = { rate: line.vatRate, base: 0, vat: 0 };
+        }
+
+        vatByRate[line.vatRate].base += lineAfterDiscount;
+        vatByRate[line.vatRate].vat += lineVat;
+      });
+    });
+
+  return Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
+}
