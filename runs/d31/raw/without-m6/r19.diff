+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'PRINT-A4', qty: 37 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const csv = exportCsv([issuedResult.value]);
+
+  // C-002 is standard tier (0% discount)
+  // PRINT-A4: 37 * 37 = 1369 cents
+  // VAT at 9%: 1369 * 0.09 = 123.21 → 123 cents
+  // Total: 1369 + 123 = 1492 cents = 14.92 euros
+  assert.ok(csv.includes('14.92'));
