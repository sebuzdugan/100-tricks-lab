+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const paymentResult = recordPayment(issuedResult.value, { amount: 3000, date: '2024-01-20' });
+
+  const csv = exportCsv([paymentResult.value]);
+
+  assert.ok(csv.includes('partially_paid'));
+  // Total: 6050, Paid: 3000, Due: 3050 = 30.50 euros
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields[9], '30.50');
+});
+
