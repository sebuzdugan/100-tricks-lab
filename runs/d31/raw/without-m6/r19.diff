+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv with single issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET30',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const csv = exportCsv([issuedResult.value]);
+
+  assert.ok(csv.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+  assert.ok(csv.includes('INV-2024-0001'));
+  assert.ok(csv.includes('Northwind Studio'));
+  assert.ok(csv.includes('2024-01-15'));
+  assert.ok(csv.includes('2024-02-14'));
+  assert.ok(csv.includes('issued'));
+});
+
+test('exportCsv includes subtotal with 2 decimals', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const csv = exportCsv([issuedResult.value]);
+
+  // Subtotal: 10 * 8500 = 85000 cents = 850.00 euros
+  assert.ok(csv.includes('850.00'));
+});
+
+test('exportCsv includes discount with 2 decimals', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const csv = exportCsv([issuedResult.value]);
+
+  // Discount: 85000 * 10% = 8500 cents = 85.00 euros
+  assert.ok(csv.includes('85.00'));
+});
+
+test('exportCsv includes VAT with 2 decimals', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const csv = exportCsv([issuedResult.value]);
+
+  // C-002 is standard tier (0% discount)
+  // Subtotal: 85000, VAT: 85000 * 21% = 17850 cents = 178.50 euros
+  assert.ok(csv.includes('178.50'));
+});
+
+test('exportCsv includes total with 2 decimals', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const csv = exportCsv([issuedResult.value]);
+
+  // STICKER: 100 * 50 = 5000, VAT: 5000 * 21% = 1050, Total: 6050 = 60.50 euros
+  assert.ok(csv.includes('60.50'));
+});
+
+test('exportCsv includes due amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const csv = exportCsv([issuedResult.value]);
+
+  // Due should equal total (6050 cents = 60.50 euros)
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields[9], '60.50');
+});
+
