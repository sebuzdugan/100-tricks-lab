+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const standardResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const gold = issueInvoice(goldResult.value, []);
+  const standard = issueInvoice(standardResult.value, ['INV-2024-0001']);
+
+  const csv = exportCsv([gold.value, standard.value]);
