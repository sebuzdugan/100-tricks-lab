+test('exportCsv with negative balance due shows correct format', () => {
+  // This shouldn't happen in normal operation, but test that formatting works
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'PRINT-A4', qty: 1 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const csv = exportCsv([issuedResult.value]);
+
+  // Verify amounts are formatted correctly
+  const lines = csv.split('\n');
