+
+test('exportCsv with multiple invoices preserves order', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
