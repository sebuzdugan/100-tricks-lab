 import { ok, fail } from './result.js';
 
+export const RATES = { EUR: 1, USD: 1.085, GBP: 0.8425 };
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -27,6 +29,49 @@ export function formatEuros(cents) {
   return `${sign}€${euros}.${String(abs % 100).padStart(2, '0')}`;
 }
 
+/**
+ * Convert cents from EUR to another currency.
+ * @param {number} cents - amount in EUR cents
+ * @param {string} currency - target currency (EUR, USD, or GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const eurAmount = cents / 100;
+  const targetAmount = eurAmount * rate;
+  const targetCents = roundCents(targetAmount * 100);
+
+  return ok(targetCents);
+}
+
+/**
+ * Format cents as money in a given currency: 123456 USD -> "$1,234.56", -5 GBP -> "-£0.05".
+ * @param {number} cents - amount in cents of the target currency
+ * @param {string} currency - currency code (EUR, USD, or GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const main = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const frac = String(abs % 100).padStart(2, '0');
+
+  let symbol;
+  if (currency === 'USD') {
+    symbol = '$';
+  } else if (currency === 'GBP') {
+    symbol = '£';
+  } else {
+    symbol = '€';
+  }
+
+  return `${sign}${symbol}${main}.${frac}`;
+}
+
