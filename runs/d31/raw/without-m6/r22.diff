@@ -0,0 +1,270 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 10, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 85000);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal with large numbers', () => {
+  const line = { qty: 1000, unitPrice: 100000 };
+  assert.equal(lineTotal(line), 100000000);
+});
+
+test('invoiceTotals calculates subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+});
+
+test('invoiceTotals calculates discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 8500);
+});
+
+test('invoiceTotals calculates VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 85000, Discount: 0, After discount: 85000
+  // VAT: 85000 * 21% = 17850
+  assert.equal(totals.vat, 17850);
+});
+
+test('invoiceTotals calculates VAT after discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 85000, Discount: 8500, After discount: 76500
+  // VAT: 76500 * 21% = 16065
+  assert.equal(totals.vat, 16065);
+});
+
+test('invoiceTotals calculates total', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 5000, Discount: 0, VAT: 1050, Total: 6050
+  assert.equal(totals.total, 6050);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 5000, Discount: 0, VAT: 1050, Voucher: 1000, Total: 5050
+  assert.equal(totals.total, 5050);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals with multiple lines same VAT rate', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: 85000
+  // Line 2: 42500
+  // Subtotal: 127500
+  // VAT: (85000 + 42500) * 21% = 26775
+  assert.equal(totals.subtotal, 127500);
+  assert.equal(totals.vat, 26775);
+  assert.equal(totals.total, 154275);
+});
+
+test('invoiceTotals with multiple lines different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 37, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: subtotal 85000, VAT: 17850
+  // Line 2: subtotal 3700, VAT: 333
+  // Total VAT: 17850 + 333 = 18183
+  assert.equal(totals.subtotal, 88700);
+  assert.equal(totals.vat, 18183);
+});
+
+test('invoiceTotals with zero VAT rate', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 100, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 500);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 500);
+});
+
+test('invoiceTotals with discounts on multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+      { qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: 85000 - 8500 = 76500, VAT: 16065
+  // Line 2: 42500 - 2125 = 40375, VAT: 8479 (rounded)
+  // Subtotal: 127500, Discount: 10625, VAT: 24544, Total: 141419
+  assert.equal(totals.subtotal, 127500);
+  assert.equal(totals.discount, 10625);
+});
+
+test('invoiceTotals clamped at zero', () => {
+  const invoice = {
+    lines: [],
+    voucher: { amount: 0 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with large voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { amount: 200000 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Total would be negative, clamped to 0
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals returns separate fields', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+    ],
+    voucher: { amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
+
+test('lineTotal with small unitPrice', () => {
+  const line = { qty: 1000, unitPrice: 37 };
+  assert.equal(lineTotal(line), 37000);
+});
+
+test('invoiceTotals single line with discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 20, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 10000, Discount: 2000, After discount: 8000
+  // VAT: 8000 * 21% = 1680
+  // Total: 10000 - 2000 + 1680 = 9680
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 2000);
+  assert.equal(totals.vat, 1680);
+  assert.equal(totals.total, 9680);
+});
+
+test('invoiceTotals without voucher property', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with undefined discountPercent defaults to 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.subtotal, 85000);
+});
+
+test('invoiceTotals calculation example from docs', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 85000
+  // Discount: 8500
+  // After discount: 76500
+  // VAT: 16065
+  // Total: 92565
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 8500);
+  assert.equal(totals.vat, 16065);
+  assert.equal(totals.total, 92565);
+});
+
+test('invoiceTotals with complex multi-line scenario', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+      { qty: 100, unitPrice: 37, discountPercent: 0, vatRate: 9 },
+      { qty: 5, unitPrice: 100, discountPercent: 10, vatRate: 0 },
+    ],
+    voucher: { amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: 85000 - 4250 = 80750, VAT: 16958 (rounded)
+  // Line 2: 3700 - 0 = 3700, VAT: 333
+  // Line 3: 500 - 50 = 450, VAT: 0
+  // Subtotal: 89200, Discount: 4300, VAT: 17291, Voucher: 10000
+  // Total: 89200 - 4300 + 17291 - 10000 = 92191
+
+  assert.equal(totals.subtotal, 89200);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.voucher, 10000);
+  assert.ok(totals.total > 0);
+});
