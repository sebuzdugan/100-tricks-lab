diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..094d66c
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,45 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher and total for an invoice.
+ * VAT is calculated per line on the amount after discount, rounded per line.
+ * Voucher is a fixed amount discount applied after VAT.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
+    const lineAmount = lineTotal(line);
+    subtotal += lineAmount;
+
+    const lineDiscount = roundCents(lineAmount * ((line.discountPercent ?? 0) / 100));
+    discount += lineDiscount;
+
+    const lineAfterDiscount = lineAmount - lineDiscount;
+    const lineVat = roundCents(lineAfterDiscount * (line.vatRate / 100));
+    vat += lineVat;
+  }
+
+  const voucher = invoice.voucher?.amount ?? 0;
+
+  return {
+    subtotal: Math.max(0, subtotal),
+    discount: Math.max(0, discount),
+    vat: Math.max(0, vat),
+    voucher: Math.max(0, voucher),
+    total: Math.max(0, subtotal - discount + vat - voucher),
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
