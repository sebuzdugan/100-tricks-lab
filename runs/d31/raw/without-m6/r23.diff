+  // Subtotal: 1000
+  // First discount: 0
+  // Bulk discount (2.5% of 1000): 25
+  // After discount: 975
+  // VAT: 975 * 21% = 204.75 → 205 (banker's rounding)
+  // Total: 1000 - 25 + 205 = 1180
+  assert.equal(totals.subtotal, 1000);
