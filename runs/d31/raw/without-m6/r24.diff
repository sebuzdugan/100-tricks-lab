 }
+
+/**
+ * Generate a dashboard summary of key invoice metrics.
+ * @param {Array} invoices - all invoices
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {{ counts: object, outstanding: number, overdue: object, topCustomers: Array }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDues = {};
+
+  for (const invoice of invoices) {
+    counts[invoice.status]++;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDues[invoice.customerId]) {
+        customerDues[invoice.customerId] = 0;
+      }
+      customerDues[invoice.customerId] += due;
+    }
+  }
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue.reduce((sum, inv) => sum + inv.due, 0);
+
+  const topCustomers = Object.entries(customerDues)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
