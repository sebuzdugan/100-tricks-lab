+test('dashboard counts invoices by status', () => {
+  const draft = createInvoice({ customerId: 'C-001', issueDate: '2024-01-15', lines: [{ sku: 'DES-HOUR', qty: 10 }] }).value;
+  const issued1 = issueInvoice(createInvoice({ customerId: 'C-001', issueDate: '2024-01-15', lines: [{ sku: 'DES-HOUR', qty: 10 }] }).value, []).value;
+  const issued2 = issueInvoice(createInvoice({ customerId: 'C-001', issueDate: '2024-01-15', lines: [{ sku: 'DES-HOUR', qty: 10 }] }).value, ['INV-2024-0001']).value;
+  const issued3 = issueInvoice(createInvoice({ customerId: 'C-001', issueDate: '2024-01-15', lines: [{ sku: 'DES-HOUR', qty: 10 }] }).value, ['INV-2024-0001', 'INV-2024-0002']).value;
+  const partiallyPaid = recordPayment(issued3, { amount: 40000, date: '2024-01-20' }).value;
+
+  const result = dashboard([draft, issued1, issued2, partiallyPaid], '2024-02-01');
+
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 2);
+  assert.equal(result.counts.partially_paid, 1);
+  assert.equal(result.counts.paid, 0);
+});
