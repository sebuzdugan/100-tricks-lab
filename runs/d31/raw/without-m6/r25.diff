+ * discounts, subtotals/VAT/voucher (if any), total, due date (if any), and paid amount (if any).
+ * All amounts formatted as euros.
+ * @param {{ number?: string, customerId: string, issueDate?: string, dueDate?: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number }>, voucher?: object, payments?: Array }} invoice
  * @returns {{ ok: true, value: string } | { ok: false, error: string }}
