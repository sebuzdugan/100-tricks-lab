diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..f02124c
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,72 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} param
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Validate issueDate format and reality
+  if (!isValidDate(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines is not empty
+  if (!Array.isArray(lines) || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Validate SKU
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) {
+      return productResult;
+    }
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
+
+function isValidDate(dateStr) {
+  // Check format YYYY-MM-DD
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) {
+    return false;
+  }
+
+  // Check if it's a real date by verifying round-trip parsing
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const [year, month, day] = dateStr.split('-').map(Number);
+
+  return date.getUTCFullYear() === year &&
+         date.getUTCMonth() + 1 === month &&
+         date.getUTCDate() === day;
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..173ea16
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,179 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  const invoice = result.value;
+  assert.equal(invoice.customerId, 'C-001');
+  assert.equal(invoice.issueDate, '2026-10-07');
+  assert.equal(invoice.status, 'draft');
+  assert.equal(invoice.lines.length, 1);
+  assert.equal(invoice.lines[0].sku, 'DES-HOUR');
+  assert.equal(invoice.lines[0].name, 'Design work (hour)');
+  assert.equal(invoice.lines[0].qty, 5);
+  assert.equal(invoice.lines[0].unitPrice, 8500);
+  assert.equal(invoice.lines[0].vatRate, 21);
+});
+
+test('createInvoice with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'DEV-HOUR', qty: 2 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[1].name, 'Development (hour)');
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND', () => {
+  const result = createInvoice({
+    customerId: 'NOPE',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for wrong format', () => {
+  const testCases = [
+    '10-07-2026',
+    '2026/10/07',
+    '2026-1-7',
+    '2026-10-7',
+    'not-a-date',
+    '2026-13-01',
+    '2026-12-32',
+  ];
+  for (const dateStr of testCases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, false, `Should reject ${dateStr}`);
+    assert.equal(result.error, 'DATE_INVALID');
+  }
+});
+
+test('createInvoice accepts valid dates', () => {
+  const validDates = [
+    '2026-01-01',
+    '2026-12-31',
+    '2024-02-29', // leap year
+    '2025-02-28', // non-leap year
+  ];
+  for (const dateStr of validDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, true, `Should accept ${dateStr}`);
+  }
+});
+
+test('createInvoice reports DATE_INVALID for invalid dates', () => {
+  const invalidDates = [
+    '2025-02-29', // non-leap year
+    '2026-04-31', // April has 30 days
+  ];
+  for (const dateStr of invalidDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, false, `Should reject ${dateStr}`);
+    assert.equal(result.error, 'DATE_INVALID');
+  }
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports NO_LINES for missing lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer qty', () => {
+  const testCases = [1.5, '5', NaN, Infinity];
+  for (const qty of testCases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    });
+    assert.equal(result.ok, false, `Should reject qty ${qty}`);
+    assert.equal(result.error, 'QTY_INVALID');
+  }
+});
+
+test('createInvoice reports QTY_INVALID for zero or negative qty', () => {
+  const testCases = [0, -1, -100];
+  for (const qty of testCases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    });
+    assert.equal(result.ok, false, `Should reject qty ${qty}`);
+    assert.equal(result.error, 'QTY_INVALID');
+  }
+});
+
+test('createInvoice reports UNKNOWN_SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'NOPE', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const inputLines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const originalLine = { ...inputLines[0] };
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: inputLines,
+  });
+  assert.deepEqual(inputLines[0], originalLine);
+});
+
+test('createInvoice stops at first error', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'NOPE', qty: 0 }, // Both SKU unknown and qty invalid
+    ],
+  });
+  // Should report QTY_INVALID since it checks qty before SKU in the second line
+  assert.equal(result.error, 'QTY_INVALID');
+});
