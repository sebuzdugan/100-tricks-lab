@@ -0,0 +1,22 @@
+/**
+ * Calculate the next invoice number for a given issue date.
+ * Invoice numbers are INV-YYYY-CCCC where CCCC is a 4-digit counter starting at 0001 each year.
+ * @param {Array<string>} existingNumbers - Invoice numbers already used
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} Next invoice number (INV-YYYY-CCCC)
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+
+  const countersThisYear = existingNumbers
+    .filter(num => num.includes(`INV-${year}-`))
+    .map(num => {
+      const match = /INV-\d{4}-(\d{4})/.exec(num);
+      return match ? parseInt(match[1], 10) : 0;
+    });
+
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
