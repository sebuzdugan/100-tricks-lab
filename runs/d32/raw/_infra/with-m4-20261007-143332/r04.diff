+/**
+ * Issue a draft invoice (change status to 'issued' and assign a number).
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {Array<string>} existingNumbers - Invoice numbers already used
+ * @returns {{ ok: true, value: { ... } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: 'issued',
+    number,
+    lines: invoice.lines.map(line => ({ ...line })),
+  });
+}
