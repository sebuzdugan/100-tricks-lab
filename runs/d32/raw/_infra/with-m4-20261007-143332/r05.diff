+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for customer display.
+ * All amounts are formatted with formatEuros().
+ * @param {{ customerId: string, number?: string, lines: Array }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : '(unknown customer)';
+
+  const output = [];
+
+  // Invoice number or DRAFT status
+  const header = invoice.number ? invoice.number : 'DRAFT';
+  output.push(header);
+
+  // Customer name
+  output.push(customerName);
+
+  // Invoice line items
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const qtyStr = line.qty;
+    const nameStr = line.name;
+    const priceStr = formatEuros(line.unitPrice);
+    const totalStr = formatEuros(total);
+    output.push(`${qtyStr}x ${nameStr} @ ${priceStr} = ${totalStr}`);
+  }
+
+  // Total line
+  const { total } = invoiceTotals(invoice);
+  output.push(`Total: ${formatEuros(total)}`);
+
+  return output.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..6e711b9
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,178 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /^DRAFT/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = result.value;
+  const issueResult = issueInvoice(invoice, []);
+  const issued = issueResult.value;
+
+  const text = renderInvoiceText(issued);
+  assert.match(text, /^INV-2026-0001/);
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText shows unknown customer gracefully', () => {
+  const invoice = {
+    customerId: 'UNKNOWN-ID',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /\(unknown customer\)/);
+});
+
+test('renderInvoiceText shows single line item', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /2x Design work \(hour\) @ €85\.00 = €170\.00/);
+});
+
+test('renderInvoiceText shows multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  assert.match(lines[2], /2x Design work \(hour\) @ €85\.00 = €170\.00/);
+  assert.match(lines[3], /1x Development \(hour\) @ €95\.00 = €95\.00/);
+});
+
+test('renderInvoiceText formats unit prices with formatEuros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 5 }],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  // ICON-SET has unitPrice 980 cents = €9.80
+  assert.match(text, /€9\.80/);
+});
+
+test('renderInvoiceText calculates correct line totals', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  // 3 * €85.00 = €255.00
+  assert.match(text, /€255\.00/);
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  // 2 * €85.00 + 1 * €95.00 = €265.00
+  assert.match(text, /Total: €265\.00/);
+});
+
+test('renderInvoiceText shows total as last line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  assert.match(lines[lines.length - 1], /^Total: €/);
+});
+
+test('renderInvoiceText handles zero amounts', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ name: 'Free item', qty: 1, unitPrice: 0, vatRate: 0 }],
+  };
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /€0\.00/);
+});
+
+test('renderInvoiceText format includes qty, name, price, total in order', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  // Should show: 1x Logo package @ €1,200.00 = €1,200.00
+  assert.match(text, /1x Logo package @ €1,200\.00 = €1,200\.00/);
+});
+
+test('renderInvoiceText output is multi-line string', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  assert.ok(lines.length >= 5); // header + customer + 2 items + total
+  assert.equal(typeof text, 'string');
+});
