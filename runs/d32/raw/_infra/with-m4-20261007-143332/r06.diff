diff --git a/test/invoices.test.js b/test/invoices.test.js
index d66c0c4..f878519 100644
--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -555,3 +555,201 @@ test('issueInvoice preserves all invoice data', () => {
   assert.equal(issued.lines[1].qty, 2);
   assert.equal(issued.number, 'INV-2025-0002');
 });
+
+test('createInvoice accepts valid discountPercent values', () => {
+  const validDiscounts = [0, 50, 100, 12.5, 0.01, 99.99];
+  for (const discount of validDiscounts) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: discount }],
+    });
+    assert.equal(result.ok, true, `Should accept discountPercent ${discount}`);
+    assert.equal(result.value.lines[0].discountPercent, discount);
+  }
+});
+
+test('createInvoice reports DISCOUNT_INVALID for invalid discountPercent', () => {
+  const invalidDiscounts = [-1, 101, 'invalid', NaN, Infinity, -Infinity, null];
+  for (const discount of invalidDiscounts) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: discount }],
+    });
+    assert.equal(result.ok, false, `Should reject discountPercent ${discount}`);
+    assert.equal(result.error, 'DISCOUNT_INVALID');
+  }
+});
+
+test('createInvoice without discountPercent omits it from line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, undefined);
+});
+
+test('addLine accepts valid discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const invoice = result.value;
+
+  const addResult = addLine(invoice, { sku: 'DEV-HOUR', qty: 3, discountPercent: 25 });
+  assert.equal(addResult.ok, true);
+  const newInvoice = addResult.value;
+  assert.equal(newInvoice.lines[1].discountPercent, 25);
+});
+
+test('addLine updates discountPercent on existing line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  const invoice = result.value;
+
+  const addResult = addLine(invoice, { sku: 'DES-HOUR', qty: 3, discountPercent: 20 });
+  assert.equal(addResult.ok, true);
+  const newInvoice = addResult.value;
+  assert.equal(newInvoice.lines[0].qty, 5);
+  assert.equal(newInvoice.lines[0].discountPercent, 20);
+});
+
+test('addLine reports DISCOUNT_INVALID for invalid discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = result.value;
+
+  const testCases = [-1, 101, 'invalid', NaN];
+  for (const discount of testCases) {
+    const addResult = addLine(invoice, { sku: 'DEV-HOUR', qty: 1, discountPercent: discount });
+    assert.equal(addResult.ok, false, `Should reject discountPercent ${discount}`);
+    assert.equal(addResult.error, 'DISCOUNT_INVALID');
+  }
+});
+
+test('invoiceTotals returns { subtotal, discount, total }', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(Object.keys(totals).sort(), ['discount', 'subtotal', 'total'].sort());
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 42500);
+});
+
+test('invoiceTotals calculates discount for single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 20 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 5 * 8500; // 42500
+  const lineDiscount = Math.floor(subtotal * 20 / 100); // 8500
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 8500);
+  assert.equal(totals.total, 34000);
+});
+
+test('invoiceTotals calculates discount for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 8500, discountPercent: 10 },
+      { qty: 2, unitPrice: 9500, discountPercent: 20 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const line1Total = 3 * 8500; // 25500
+  const line1Discount = Math.floor(line1Total * 10 / 100); // 2550
+  const line2Total = 2 * 9500; // 19000
+  const line2Discount = Math.floor(line2Total * 20 / 100); // 3800
+  const subtotal = line1Total + line2Total; // 44500
+  const totalDiscount = line1Discount + line2Discount; // 6350
+  const total = subtotal - totalDiscount; // 38150
+
+  assert.equal(totals.subtotal, 44500);
+  assert.equal(totals.discount, 6350);
+  assert.equal(totals.total, 38150);
+});
+
+test('invoiceTotals with no discount on some lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500 },
+      { qty: 3, unitPrice: 9500, discountPercent: 15 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const line1Total = 2 * 8500; // 17000, no discount
+  const line2Total = 3 * 9500; // 28500
+  const line2Discount = Math.floor(line2Total * 15 / 100); // 4275
+  const subtotal = line1Total + line2Total; // 45500
+  const total = subtotal - line2Discount; // 41225
+
+  assert.equal(totals.subtotal, 45500);
+  assert.equal(totals.discount, 4275);
+  assert.equal(totals.total, 41225);
+});
+
+test('invoiceTotals clamps total to 0 minimum', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, discountPercent: 100 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 1000);
+  assert.equal(totals.discount, 1000);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with decimal discountPercent', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 12.5 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 10000;
+  const discount = Math.floor(subtotal * 12.5 / 100); // 1250
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1250);
+  assert.equal(totals.total, 8750);
+});
+
+test('invoiceTotals with enriched invoice from createInvoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2, discountPercent: 10 },
+      { sku: 'DEV-HOUR', qty: 3, discountPercent: 15 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  const totals = invoiceTotals(result.value);
+  const line1Total = 2 * 8500; // 17000
+  const line1Discount = Math.floor(line1Total * 10 / 100); // 1700
+  const line2Total = 3 * 9500; // 28500
+  const line2Discount = Math.floor(line2Total * 15 / 100); // 4275
+  const subtotal = line1Total + line2Total; // 45500
+  const totalDiscount = line1Discount + line2Discount; // 5975
+  const total = subtotal - totalDiscount; // 39525
+
+  assert.equal(totals.subtotal, 45500);
+  assert.equal(totals.discount, 5975);
+  assert.equal(totals.total, 39525);
+});
