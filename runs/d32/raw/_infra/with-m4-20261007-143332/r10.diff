+/**
+ * Validate a date string in YYYY-MM-DD format and check it's a real date.
+ * All operations use UTC to avoid timezone issues.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') {
+    return false;
+  }
+
+  // Check format YYYY-MM-DD
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) {
+    return false;
+  }
+
+  // Check if it's a real date by verifying round-trip parsing
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const [year, month, day] = dateStr.split('-').map(Number);
+
+  return date.getUTCFullYear() === year &&
+         date.getUTCMonth() + 1 === month &&
+         date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date string (in YYYY-MM-DD format).
+ * Returns a new date string in YYYY-MM-DD format, using UTC.
+ * @param {string} dateStr
+ * @param {number} n
+ * @returns {string}
+ */
+export function addDays(dateStr, n) {
+  const date = new Date(dateStr + 'T00:00:00Z');
+  date.setUTCDate(date.getUTCDate() + n);
+  return formatDateUTC(date);
+}
+
+/**
+ * Calculate the number of days between two dates (b minus a), in whole days.
+ * Uses UTC. Dates are in YYYY-MM-DD format.
+ * @param {string} a
+ * @param {string} b
+ * @returns {number}
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB - dateA) / msPerDay);
+}
+
+/**
+ * Format a Date object as YYYY-MM-DD string, using UTC components.
+ * @param {Date} date
+ * @returns {string}
+ */
+function formatDateUTC(date) {
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
