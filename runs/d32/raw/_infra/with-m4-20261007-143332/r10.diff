diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..918c0e8
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,142 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  const validDates = [
+    '2026-01-01',
+    '2026-12-31',
+    '2024-02-29', // leap year
+    '2025-02-28', // non-leap year
+    '2000-01-01',
+    '1999-12-31',
+  ];
+  for (const dateStr of validDates) {
+    assert.equal(isValidDate(dateStr), true, `Should accept ${dateStr}`);
+  }
+});
+
+test('isValidDate rejects invalid formats', () => {
+  const invalidFormats = [
+    '10-07-2026',
+    '2026/10/07',
+    '2026-1-7',
+    '2026-10-7',
+    'not-a-date',
+    '2026-13-01',
+    '2026-12-32',
+    '2025-02-29', // non-leap year
+    '2026-04-31', // April has 30 days
+    '2026-11-31', // November has 30 days
+  ];
+  for (const dateStr of invalidFormats) {
+    assert.equal(isValidDate(dateStr), false, `Should reject ${dateStr}`);
+  }
+});
+
+test('isValidDate rejects non-string input', () => {
+  const invalidInputs = [null, undefined, 12345, { date: '2026-01-01' }, ['2026-01-01']];
+  for (const input of invalidInputs) {
+    assert.equal(isValidDate(input), false, `Should reject ${input}`);
+  }
+});
+
+test('isValidDate rejects empty string', () => {
+  assert.equal(isValidDate(''), false);
+});
+
+test('addDays returns date string in YYYY-MM-DD format', () => {
+  const result = addDays('2026-01-01', 5);
+  assert.equal(typeof result, 'string');
+  assert.match(result, /^\d{4}-\d{2}-\d{2}$/);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-01-01', 1), '2026-01-02');
+  assert.equal(addDays('2026-01-01', 5), '2026-01-06');
+  assert.equal(addDays('2026-01-01', 30), '2026-01-31');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // leap year
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2026-01-05', -5), '2025-12-31');
+  assert.equal(addDays('2026-02-01', -1), '2026-01-31');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2026-01-15', 0), '2026-01-15');
+});
+
+test('addDays handles large day values', () => {
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01'); // leap year
+});
+
+test('daysBetween calculates forward days correctly', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+  assert.equal(daysBetween('2026-01-01', '2026-01-06'), 5);
+  assert.equal(daysBetween('2026-01-01', '2026-01-31'), 30);
+});
+
+test('daysBetween calculates backward days as negative', () => {
+  assert.equal(daysBetween('2026-01-06', '2026-01-01'), -5);
+  assert.equal(daysBetween('2026-02-01', '2026-01-01'), -31);
+});
+
+test('daysBetween returns zero for same date', () => {
+  assert.equal(daysBetween('2026-01-15', '2026-01-15'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2026-02-01'), 31);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is leap year
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365); // 2025 is not leap year
+});
+
+test('daysBetween returns integers only', () => {
+  const result = daysBetween('2026-01-01', '2026-01-02');
+  assert.ok(Number.isInteger(result));
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const startDate = '2026-06-15';
+  const days = 42;
+  const endDate = addDays(startDate, days);
+  const calculated = daysBetween(startDate, endDate);
+  assert.equal(calculated, days);
+});
+
+test('dates use UTC, not local timezone', () => {
+  // Verify that addDays uses UTC by checking it doesn't depend on local time
+  // The function should always use UTC components, regardless of machine timezone
+  const date1 = '2026-02-28';
+  const date2 = addDays(date1, 1);
+  // In any timezone, Feb 28 + 1 day should be Mar 1 for non-leap 2026
+  assert.equal(date2, '2026-03-01');
+});
+
+test('daysBetween uses UTC boundaries', () => {
+  // Verify daysBetween counts whole UTC days
+  // The boundary between two days is at UTC midnight
+  const daysInJanuary = daysBetween('2026-01-01', '2026-02-01');
+  assert.equal(daysInJanuary, 31);
+});
