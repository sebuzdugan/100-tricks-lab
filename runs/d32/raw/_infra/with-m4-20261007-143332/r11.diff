+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the total amount paid on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function totalPaid(invoice) {
+  return (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+}
+
+/**
+ * Calculate the balance due on an invoice.
+ * @param {{ lines: Array, payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const { total } = invoiceTotals(invoice);
+  return Math.max(0, total - totalPaid(invoice));
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, lines: Array, customerId: string, issueDate: string, number?: string, payments?: Array }} invoice
+ * @param {{ amount: number, date: string }} param
+ * @returns {{ ok: true, value: { ... } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const owing = balanceDue(invoice);
+  if (amount > owing) {
+    return fail('OVERPAYMENT');
+  }
+
+  const payments = invoice.payments ? invoice.payments.map(p => ({ ...p })) : [];
+  payments.push({ amount, date });
+
+  const newInvoice = {
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    number: invoice.number,
+    lines: invoice.lines.map(line => ({ ...line })),
+    payments,
+  };
+
+  const newOwing = balanceDue(newInvoice);
+  newInvoice.status = newOwing === 0 ? 'paid' : 'partially_paid';
+
+  return ok(newInvoice);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
