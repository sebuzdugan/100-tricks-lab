@@ -140,3 +140,58 @@ test('daysBetween uses UTC boundaries', () => {
   const daysInJanuary = daysBetween('2026-01-01', '2026-02-01');
   assert.equal(daysInJanuary, 31);
 });
+
+test('endOfMonth returns date string in YYYY-MM-DD format', () => {
+  const result = endOfMonth('2026-01-15');
+  assert.equal(typeof result, 'string');
+  assert.match(result, /^\d{4}-\d{2}-\d{2}$/);
+});
+
+test('endOfMonth returns last day of month for January', () => {
+  assert.equal(endOfMonth('2026-01-01'), '2026-01-31');
+  assert.equal(endOfMonth('2026-01-15'), '2026-01-31');
+  assert.equal(endOfMonth('2026-01-31'), '2026-01-31');
+});
+
+test('endOfMonth returns last day of month for February', () => {
+  assert.equal(endOfMonth('2026-02-01'), '2026-02-28'); // non-leap year
+  assert.equal(endOfMonth('2026-02-15'), '2026-02-28');
+  assert.equal(endOfMonth('2024-02-15'), '2024-02-29'); // leap year
+});
+
+test('endOfMonth returns last day of month for months with 30 days', () => {
+  assert.equal(endOfMonth('2026-04-01'), '2026-04-30');
+  assert.equal(endOfMonth('2026-04-15'), '2026-04-30');
+  assert.equal(endOfMonth('2026-06-15'), '2026-06-30');
+  assert.equal(endOfMonth('2026-09-15'), '2026-09-30');
+  assert.equal(endOfMonth('2026-11-15'), '2026-11-30');
+});
+
+test('endOfMonth returns last day of month for months with 31 days', () => {
+  assert.equal(endOfMonth('2026-03-01'), '2026-03-31');
+  assert.equal(endOfMonth('2026-05-15'), '2026-05-31');
+  assert.equal(endOfMonth('2026-07-15'), '2026-07-31');
+  assert.equal(endOfMonth('2026-08-15'), '2026-08-31');
+  assert.equal(endOfMonth('2026-10-15'), '2026-10-31');
+  assert.equal(endOfMonth('2026-12-15'), '2026-12-31');
+});
+
+test('endOfMonth handles year boundaries', () => {
+  assert.equal(endOfMonth('2025-12-01'), '2025-12-31');
+  assert.equal(endOfMonth('2025-12-31'), '2025-12-31');
+});
+
+test('endOfMonth handles leap years correctly', () => {
+  assert.equal(endOfMonth('2024-02-01'), '2024-02-29'); // leap year
+  assert.equal(endOfMonth('2025-02-01'), '2025-02-28'); // non-leap year
+  assert.equal(endOfMonth('2000-02-01'), '2000-02-29'); // century leap year
+  assert.equal(endOfMonth('2100-02-01'), '2100-02-28'); // century non-leap year
+});
+
+test('endOfMonth works for any day in the month', () => {
+  // All days in May should return May 31
+  for (let day = 1; day <= 31; day++) {
+    const dateStr = `2026-05-${String(day).padStart(2, '0')}`;
+    assert.equal(endOfMonth(dateStr), '2026-05-31');
+  }
+});
