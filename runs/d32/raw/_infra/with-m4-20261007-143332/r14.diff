+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId = 'C-001', issueDate = '2026-10-07', lines = [{ sku: 'DES-HOUR', qty: 2 }]) {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+  });
+  const issued = issueInvoice(result.value, []);
+  return issued.value;
+}
+
+test('statement returns empty array for customer with no invoices', () => {
+  const result = statement('C-001', [], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('UNKNOWN', [invoice], '2026-12-31');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement normalizes customer id', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('c-001', [invoice], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement normalizes customer id with spaces', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('  c-001  ', [invoice], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement includes issued invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice.number);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const paid = recordPayment(invoice, { amount: 5000, date: '2026-10-10' }).value;
+  assert.equal(paid.status, 'partially_paid');
+
+  const result = statement('C-001', [paid], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = statement('C-001', [draft], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const { total } = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: total, date: '2026-10-10' }).value;
+  assert.equal(paid.status, 'paid');
+
+  const result = statement('C-001', [paid], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-11-15');
+  const result = statement('C-001', [invoice], '2026-11-14');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes invoices on asOf date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-11-15');
+  const result = statement('C-001', [invoice], '2026-11-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement includes invoices before asOf date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-11-01');
+  const result = statement('C-001', [invoice], '2026-11-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement returns invoice fields: number, issueDate, dueDate, total, due', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-12-31');
+  assert.equal(result.ok, true);
+  const statementInvoice = result.value.invoices[0];
+
+  assert.ok('number' in statementInvoice);
+  assert.ok('issueDate' in statementInvoice);
+  assert.ok('dueDate' in statementInvoice);
+  assert.ok('total' in statementInvoice);
+  assert.ok('due' in statementInvoice);
+});
+
+test('statement calculates due from balanceDue', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const { total } = invoiceTotals(invoice);
+  const result = statement('C-001', [invoice], '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].total, total);
+  assert.equal(result.value.invoices[0].due, total);
+});
+
+test('statement calculates due for partially paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const { total } = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: Math.floor(total / 2), date: '2026-10-10' }).value;
+
+  const result = statement('C-001', [paid], '2026-12-31');
+  assert.equal(result.ok, true);
+  const due = result.value.invoices[0].due;
+  assert.equal(due, total - Math.floor(total / 2));
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const inv2 = createAndIssueInvoice('C-001', '2026-10-15');
+  const inv3 = createAndIssueInvoice('C-001', '2026-10-01');
+
+  const result = statement('C-001', [inv1, inv2, inv3], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-07');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement calculates totalDue as sum of all due', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const inv2 = createAndIssueInvoice('C-001', '2026-10-15');
+
+  const { total: total1 } = invoiceTotals(inv1);
+  const { total: total2 } = invoiceTotals(inv2);
+
+  const result = statement('C-001', [inv1, inv2], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.totalDue, total1 + total2);
+});
+
+test('statement totalDue accounts for partial payments', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const { total: total1 } = invoiceTotals(inv1);
+  const paid1 = recordPayment(inv1, { amount: Math.floor(total1 / 3), date: '2026-10-10' }).value;
+
+  const inv2 = createAndIssueInvoice('C-001', '2026-10-15');
+  const { total: total2 } = invoiceTotals(inv2);
+
+  const result = statement('C-001', [paid1, inv2], '2026-12-31');
+  assert.equal(result.ok, true);
+  const expectedDue = (total1 - Math.floor(total1 / 3)) + total2;
+  assert.equal(result.value.totalDue, expectedDue);
+});
+
+test('statement with empty invoices array', () => {
+  const result = statement('C-001', [], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement with multiple invoices filters correctly', () => {
+  const issued = createAndIssueInvoice('C-001', '2026-10-07');
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const allInvoices = [issued, draft];
+  const result = statement('C-001', allInvoices, '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, issued.number);
+});
+
+test('statement preserves invoice dueDate from invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].dueDate, invoice.dueDate);
+});
+
+test('statement with invoices having different statuses', () => {
+  const issued = createAndIssueInvoice('C-001', '2026-10-01');
+  const { total } = invoiceTotals(issued);
+  const partialPaid = recordPayment(issued, { amount: Math.floor(total / 2), date: '2026-10-05' }).value;
+
+  const anotherIssued = createAndIssueInvoice('C-001', '2026-10-10');
+
+  const result = statement('C-001', [partialPaid, anotherIssued], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+});
+
+test('statement returns totalDue of 0 when all invoices are paid', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const { total } = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: total, date: '2026-10-10' }).value;
+
+  const result = statement('C-001', [paid], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement handles invoices across multiple years', () => {
+  const inv2025 = createAndIssueInvoice('C-001', '2025-12-31');
+  const inv2026Early = createAndIssueInvoice('C-001', '2026-01-01');
+  const inv2026Late = createAndIssueInvoice('C-001', '2026-12-31');
+
+  const result = statement('C-001', [inv2026Late, inv2025, inv2026Early], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2025-12-31');
+  assert.equal(result.value.invoices[1].issueDate, '2026-01-01');
+  assert.equal(result.value.invoices[2].issueDate, '2026-12-31');
+});
+
+test('statement does not mutate input invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const originalNumber = invoice.number;
+  const originalStatus = invoice.status;
+
+  statement('C-001', [invoice], '2026-12-31');
+
+  assert.equal(invoice.number, originalNumber);
+  assert.equal(invoice.status, originalStatus);
+});
+
+test('statement only includes specified customer invoices', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const inv2 = createAndIssueInvoice('C-002', '2026-10-15');
+
+  const result = statement('C-001', [inv1, inv2], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, inv1.number);
+});
+
+test('statement returns integers for total and due', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const result = statement('C-001', [invoice], '2026-12-31');
+
+  assert.ok(result.ok);
+  assert.ok(Number.isInteger(result.value.invoices[0].total));
+  assert.ok(Number.isInteger(result.value.invoices[0].due));
+  assert.ok(Number.isInteger(result.value.totalDue));
+});
+
+test('statement returns integers for totalDue', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const inv2 = createAndIssueInvoice('C-001', '2026-10-15');
+
+  const result = statement('C-001', [inv1, inv2], '2026-12-31');
+  assert.ok(Number.isInteger(result.value.totalDue));
+});
