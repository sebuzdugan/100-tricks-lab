+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a statement for a customer showing outstanding invoices.
+ * @param {string} customerId
+ * @param {Array<{ number?: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: object }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize and validate customer
+  const normalizedCustomerId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Filter invoices: for this customer, issued or partially_paid, with issueDate on or before asOf
+  const relevantInvoices = invoices.filter(invoice => {
+    const isForThisCustomer = normalizeId(invoice.customerId) === normalizedCustomerId;
+    const isRelevantStatus = invoice.status === 'issued' || invoice.status === 'partially_paid';
+    const isOnTimeInvoice = invoice.issueDate <= asOf;
+    return isForThisCustomer && isRelevantStatus && isOnTimeInvoice;
+  });
+
+  // Map to statement format
+  const statementInvoices = relevantInvoices.map(invoice => {
+    const totals = invoiceTotals(invoice);
+    return {
+      number: invoice.number,
+      issueDate: invoice.issueDate,
+      dueDate: invoice.dueDate,
+      total: totals.total,
+      due: balanceDue(invoice),
+    };
+  });
+
+  // Sort by issueDate
+  statementInvoices.sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
