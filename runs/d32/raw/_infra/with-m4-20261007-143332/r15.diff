+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the next credit note number for a given issue date.
+ * Credit note numbers are CN-YYYY-CCCC where CCCC is a 4-digit counter starting at 0001 each year.
+ * @param {Array<string>} existingNumbers - All numbers already used (invoices and credit notes)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} Next credit note number (CN-YYYY-CCCC)
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+
+  const countersThisYear = existingNumbers
+    .filter(num => num.includes(`CN-${year}-`))
+    .map(num => {
+      const match = /CN-\d{4}-(\d{4})/.exec(num);
+      return match ? parseInt(match[1], 10) : 0;
+    });
+
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued, partially paid, or paid invoice.
+ * @param {{ number?: string, customerId: string, status: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} param
+ * @param {Array<string>} existingNumbers - All numbers already used (invoices and credit notes)
+ * @returns {{ ok: true, value: { number: string, invoiceNumber?: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice status
+  const validStatuses = ['issued', 'partially_paid', 'paid'];
+  if (!validStatuses.includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date format and reality
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate amount doesn't exceed invoice total
+  const { total } = invoiceTotals(invoice);
+  if (amount > total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
