@@ -0,0 +1,132 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates an invoice with product details filled in', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }, { sku: 'STICKER', qty: 100 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+
+  assert.equal(result.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[0].qty, 10);
+  assert.equal(result.value.lines[0].unitPrice, 9500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+
+  assert.equal(result.value.lines[1].sku, 'STICKER');
+  assert.equal(result.value.lines[1].name, 'Sticker sheet');
+  assert.equal(result.value.lines[1].qty, 100);
+  assert.equal(result.value.lines[1].unitPrice, 50);
+  assert.equal(result.value.lines[1].vatRate, 21);
+});
+
+test('createInvoice rejects an unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects an invalid date format', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '10/07/2026',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-7',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: 'not-a-date',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects an impossible date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2000-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects an empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects invalid quantities', () => {
+  // Zero quantity
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  // Negative quantity
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  // Float quantity
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1.5 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  // Non-numeric quantity
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 'ten' }],
+  }), { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects an unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate the input', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 10 }];
+  const originalLines = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+
+  assert.deepEqual(lines, originalLines);
+});
