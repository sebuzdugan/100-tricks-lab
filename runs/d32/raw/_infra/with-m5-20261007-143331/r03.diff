+/**
+ * Add or update a line on a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string, qty: number, name: string, unitPrice: number, vatRate: number }> }} invoice
+ * @param {{ sku: string, qty: number }} input
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!isPositiveInteger(qty)) return fail('QTY_INVALID');
+
+  // Get product from catalogue to validate SKU
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Create new lines array
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+  const existingIndex = newLines.findIndex((line) => line.sku === sku);
+
+  if (existingIndex >= 0) {
+    // Update existing line
+    newLines[existingIndex] = {
+      ...newLines[existingIndex],
+      qty: newLines[existingIndex].qty + qty,
+    };
+  } else {
+    // Add new line
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string }> }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Find the line to remove
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex < 0) return fail('LINE_NOT_FOUND');
+
+  // Check if this is the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new lines array without the removed line
+  const newLines = invoice.lines.filter((line) => line.sku !== sku).map((line) => ({ ...line }));
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
