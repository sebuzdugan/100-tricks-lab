diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..b8fe6c3
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,47 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber restarts counter each year', () => {
+  const existingNumbers = ['INV-2025-0099', 'INV-2026-0003'];
+  const number2026 = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  const number2027 = nextInvoiceNumber(existingNumbers, '2027-10-07');
+
+  assert.equal(number2026, 'INV-2026-0004');
+  assert.equal(number2027, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existingNumbers = Array.from({ length: 999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = ['INV-2025-0050', 'INV-2025-0099', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles out-of-order existing numbers', () => {
+  const existingNumbers = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0010', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber ignores invalid number formats', () => {
+  const existingNumbers = ['INVALID', 'INV-2026', 'INV-2026-0001-EXTRA', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
