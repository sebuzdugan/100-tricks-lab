--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,36 @@
+/**
+ * Parse an invoice number to extract year and counter.
+ * @param {string} number - Invoice number in format INV-YYYY-CCCC
+ * @returns {{ year: number, counter: number } | null}
+ */
+function parseInvoiceNumber(number) {
+  const match = /^INV-(\d{4})-(\d{4})$/.exec(String(number));
+  if (!match) return null;
+  return {
+    year: Number(match[1]),
+    counter: Number(match[2]),
+  };
+}
+
+/**
+ * Get the next invoice number for a given issue date.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - Next invoice number in format INV-YYYY-CCCC
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = Number(issueDate.substring(0, 4));
+
+  // Find the highest counter for this year
+  let maxCounter = 0;
+  for (const number of existingNumbers) {
+    const parsed = parseInvoiceNumber(number);
+    if (parsed && parsed.year === year) {
+      maxCounter = Math.max(maxCounter, parsed.counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `INV-${year}-${paddedCounter}`;
+}
