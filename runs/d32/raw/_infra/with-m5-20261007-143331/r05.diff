+++ b/test/render.test.js
@@ -0,0 +1,115 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  assert.ok(text.startsWith('DRAFT\n'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+  const text = renderInvoiceText(result2.value);
+  assert.ok(text.startsWith('INV-2026-0001\n'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText formats line items with qty, name, unit price and total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  // lineTotal is 5 * 9500 = 47500 cents = €475.00
+  assert.ok(text.includes('5 × Development (hour) @ €95.00 = €475.00'));
+});
+
+test('renderInvoiceText totals line amounts correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+
+  const text = renderInvoiceText(result.value);
+  // DEV-HOUR: 2 * 9500 = 19000
+  // STICKER: 100 * 50 = 5000
+  // Total: 24000 = €240.00
+  assert.ok(text.endsWith('Total: €240.00'));
+});
+
+test('renderInvoiceText with multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'COPY-HOUR', qty: 3 },
+      { sku: 'STICKER', qty: 250 },
+    ],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '10 × Development (hour) @ €95.00 = €950.00');
+  assert.equal(lines[3], '3 × Copywriting (hour) @ €60.00 = €180.00');
+  assert.equal(lines[4], '250 × Sticker sheet @ €0.50 = €125.00');
+  assert.equal(lines[5], 'Total: €1,255.00');
+});
+
+test('renderInvoiceText with unknown customer shows customer ID', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ qty: 1, name: 'Test', unitPrice: 1000, sku: 'TEST' }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Customer C-999');
+});
+
+test('renderInvoiceText formats all amounts through formatEuros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  // LOGO-PACK is 120000 cents = €1,200.00
+  assert.ok(text.includes('€1,200.00'));
+  assert.ok(text.includes('Total: €1,200.00'));
+});
