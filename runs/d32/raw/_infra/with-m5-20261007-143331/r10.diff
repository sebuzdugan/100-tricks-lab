+/**
+ * Check if a string is a valid date in YYYY-MM-DD format and represents a real date.
+ * All date operations are performed in UTC.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(dateStr));
+  if (!match) return false;
+
+  const [, year, month, day] = match;
+  const date = new Date(`${year}-${month}-${day}T00:00:00Z`);
+
+  // Verify the parsed date matches the input (catches invalid dates like 2000-02-30)
+  return (
+    date.getUTCFullYear() === Number(year) &&
+    date.getUTCMonth() === Number(month) - 1 &&
+    date.getUTCDate() === Number(day)
+  );
+}
+
+/**
+ * Parse a date string in YYYY-MM-DD format to a Date object (UTC midnight).
+ * @param {string} dateStr
+ * @returns {Date}
+ */
+function parseDate(dateStr) {
+  const [year, month, day] = dateStr.split('-');
+  return new Date(`${year}-${month}-${day}T00:00:00Z`);
+}
+
+/**
+ * Format a Date object as a YYYY-MM-DD string (UTC).
+ * @param {Date} date
+ * @returns {string}
+ */
+function formatDate(date) {
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Add n days to a date string (YYYY-MM-DD format).
+ * Returns a new date string in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @param {number} n
+ * @returns {string}
+ */
+export function addDays(dateStr, n) {
+  const date = parseDate(dateStr);
+  date.setUTCDate(date.getUTCDate() + n);
+  return formatDate(date);
+}
+
+/**
+ * Calculate the number of days between two dates (b minus a, in whole days).
+ * Both dates should be in YYYY-MM-DD format.
+ * @param {string} a
+ * @param {string} b
+ * @returns {number}
+ */
+export function daysBetween(a, b) {
+  const dateA = parseDate(a);
+  const dateB = parseDate(b);
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
