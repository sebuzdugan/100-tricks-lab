+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Check if a value is a positive integer.
+ * @param {unknown} value
+ * @returns {boolean}
+ */
+function isPositiveInteger(value) {
+  return Number.isInteger(value) && value > 0;
+}
+
+/**
+ * Calculate the total amount paid on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function totalPaid(invoice) {
+  const payments = invoice.payments ?? [];
+  return payments.reduce((sum, payment) => sum + payment.amount, 0);
+}
+
+/**
+ * Calculate the balance due on an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = totalPaid(invoice);
+  return Math.max(0, totals.total - paid);
+}
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check if invoice is issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!isPositiveInteger(amount)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array with the new payment
+  const payments = invoice.payments ?? [];
+  const newPayments = [...payments, { amount, date }];
+
+  // Calculate the new balance
+  const newBalance = balance - amount;
+
+  // Determine new status
+  let newStatus;
+  if (newBalance === 0) {
+    newStatus = 'paid';
+  } else {
+    newStatus = 'partially_paid';
+  }
+
+  const newInvoice = {
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  };
+
+  return ok(newInvoice);
+}
