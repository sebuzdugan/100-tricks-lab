+/**
+ * Calculate due date based on payment terms.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} - Due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  const [year, month, day] = issueDate.split('-').map(Number);
+  let dueDateTime;
+
+  if (terms === 'NET14') {
+    dueDateTime = new Date(year, month - 1, day + 14);
+  } else if (terms === 'NET30') {
+    dueDateTime = new Date(year, month - 1, day + 30);
+  } else if (terms === 'EOM') {
+    dueDateTime = new Date(year, month, 0);
+  }
+
+  const dueYear = dueDateTime.getFullYear();
+  const dueMonth = String(dueDateTime.getMonth() + 1).padStart(2, '0');
+  const dueDay = String(dueDateTime.getDate()).padStart(2, '0');
+
+  return `${dueYear}-${dueMonth}-${dueDay}`;
+}
