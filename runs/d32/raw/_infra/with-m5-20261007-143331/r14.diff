+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns customer invoices with outstanding balance', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result = statement('C-001', [result2.value], '2026-10-10');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(result.value.invoices[0].dueDate, '2026-11-06');
+  assert.equal(typeof result.value.invoices[0].total, 'number');
+  assert.equal(typeof result.value.invoices[0].due, 'number');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result = statement('C-001', [result2.value], '2026-10-10');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.totalDue, result.value.invoices[0].due);
+});
+
+test('statement normalizes customer ID', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result = statement('c-001', [result2.value], '2026-10-10');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement rejects unknown customer', () => {
+  const result = statement('C-999', [], '2026-10-10');
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result = statement('C-001', [result2.value], '2026-10-06');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes invoices on asOf date', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result = statement('C-001', [result2.value], '2026-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
