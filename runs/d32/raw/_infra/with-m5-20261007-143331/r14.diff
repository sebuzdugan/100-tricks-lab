+
+test('statement sums totalDue correctly with multiple invoices', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const result3 = issueInvoice(result1.value, []);
+  const result4 = issueInvoice(result2.value, ['INV-2026-0001']);
+
+  const result = statement('C-001', [result3.value, result4.value], '2026-10-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.totalDue, result.value.invoices[0].due + result.value.invoices[1].due);
+});
+
+test('statement calculates due correctly with partial payments', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
