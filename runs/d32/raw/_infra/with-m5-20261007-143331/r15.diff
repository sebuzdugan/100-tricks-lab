+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result3 = createCreditNote(result2.value, { amount: 10000, reason: 'Partial refund', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.equal(result3.ok, true);
+  assert.equal(result3.value.number, 'CN-2026-0001');
+  assert.equal(result3.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result3.value.customerId, 'C-001');
+  assert.equal(result3.value.amount, 10000);
+  assert.equal(result3.value.reason, 'Partial refund');
+  assert.equal(result3.value.date, '2026-10-15');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = createCreditNote(result1.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.deepEqual(result2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result3 = createCreditNote(result2.value, { amount: 0, reason: 'Refund', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.deepEqual(result3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result3 = createCreditNote(result2.value, { amount: -5000, reason: 'Refund', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.deepEqual(result3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects float amount', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result3 = createCreditNote(result2.value, { amount: 5000.50, reason: 'Refund', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.deepEqual(result3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects credit amount exceeding invoice total', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  // Invoice total is 109202, trying to credit 200000
+  const result3 = createCreditNote(result2.value, { amount: 200000, reason: 'Refund', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.deepEqual(result3, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote accepts credit amount equal to invoice total', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  // Invoice total is 109202
+  const result3 = createCreditNote(result2.value, { amount: 109202, reason: 'Full refund', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.equal(result3.ok, true);
+  assert.equal(result3.value.amount, 109202);
+});
+
+test('createCreditNote works for partially_paid invoices', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+  const result3 = recordPayment(result2.value, { amount: 50000, date: '2026-10-10' });
+
+  const result4 = createCreditNote(result3.value, { amount: 10000, reason: 'Adjustment', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.equal(result4.ok, true);
+  assert.equal(result4.value.invoiceNumber, 'INV-2026-0001');
+});
+
+test('createCreditNote works for paid invoices', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+  const result3 = recordPayment(result2.value, { amount: 109202, date: '2026-10-10' });
+
+  const result4 = createCreditNote(result3.value, { amount: 5000, reason: 'Discount applied', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.equal(result4.ok, true);
+  assert.equal(result4.value.number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber starts at 0001 for a new year', () => {
+  const number = nextCreditNoteNumber([], '2026-10-07');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber increments counter for same year', () => {
+  const existingNumbers = ['CN-2026-0001', 'CN-2026-0002'];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0003');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001'];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0002');
+});
+
+test('nextCreditNoteNumber restarts counter for different year', () => {
+  const existingNumbers = ['CN-2026-0005', 'CN-2027-0001'];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-11-07');
+  assert.equal(number, 'CN-2026-0006');
+});
+
+test('nextCreditNoteNumber handles out-of-order numbers', () => {
+  const existingNumbers = ['CN-2026-0003', 'CN-2026-0001', 'CN-2026-0005'];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0006');
+});
+
+test('nextCreditNoteNumber pads counter to 4 digits', () => {
+  const existingNumbers = Array.from({ length: 9 }, (_, i) => `CN-2026-000${i + 1}`);
+  const number = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0010');
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result3 = createCreditNote(result2.value, { amount: 10000, reason: 'Refund', date: 'invalid' }, ['INV-2026-0001']);
+
+  assert.deepEqual(result3, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote with mixed existing numbers', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const existingNumbers = [
+    'INV-2026-0001',
+    'CN-2026-0001',
+    'INV-2026-0002',
+    'CN-2026-0002',
+    'INV-2026-0003',
+  ];
+
+  const result3 = createCreditNote(result2.value, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, existingNumbers);
+
+  assert.equal(result3.ok, true);
+  assert.equal(result3.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote for invoice with discount', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  // Total with 10% discount: 103455
+  const result3 = createCreditNote(result2.value, { amount: 103455, reason: 'Full refund', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.equal(result3.ok, true);
+  assert.equal(result3.value.amount, 103455);
+});
+
+test('createCreditNote for invoice with voucher', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = applyVoucher(result1.value, { code: 'SAVE10', amount: 10000 });
+  const result3 = issueInvoice(result2.value, []);
+
+  // Total after voucher: 99202
+  const result4 = createCreditNote(result3.value, { amount: 99202, reason: 'Full refund', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.equal(result4.ok, true);
+  assert.equal(result4.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result4.value.amount, 99202);
+});
+
+test('createCreditNote credit amount less than invoice total', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  // Invoice total is 109202, crediting 50000
+  const result3 = createCreditNote(result2.value, { amount: 50000, reason: 'Partial refund', date: '2026-10-15' }, ['INV-2026-0001']);
+
+  assert.equal(result3.ok, true);
+  assert.equal(result3.value.amount, 50000);
+});
+
+test('createCreditNote stores reason and date', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result2 = issueInvoice(result1.value, []);
+
+  const result3 = createCreditNote(result2.value, { amount: 5000, reason: 'Customer complaint', date: '2026-10-20' }, ['INV-2026-0001']);
+
+  assert.equal(result3.ok, true);
+  assert.equal(result3.value.reason, 'Customer complaint');
+  assert.equal(result3.value.date, '2026-10-20');
+});
