+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Check if a value is a positive integer.
+ * @param {unknown} value
+ * @returns {boolean}
+ */
+function isPositiveInteger(value) {
+  return Number.isInteger(value) && value > 0;
+}
+
+/**
+ * Extract the year and counter from a credit note number.
+ * @param {string} number - Credit note number in format CN-YYYY-NNNN
+ * @returns {{ year: number, counter: number } | null}
+ */
+function parseCreditNoteNumber(number) {
+  const match = number.match(/^CN-(\d{4})-(\d{4})$/);
+  if (!match) return null;
+  return { year: parseInt(match[1], 10), counter: parseInt(match[2], 10) };
+}
+
+/**
+ * Get the next credit note number.
+ * @param {string[]} existingNumbers - Array of all existing numbers (both CN and INV)
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = parseInt(issueDate.substring(0, 4), 10);
+
+  // Filter for credit note numbers from the same year
+  const creditNotes = existingNumbers
+    .map(num => parseCreditNoteNumber(num))
+    .filter(parsed => parsed && parsed.year === year);
+
+  // Find the highest counter
+  const maxCounter = creditNotes.length > 0
+    ? Math.max(...creditNotes.map(cn => cn.counter))
+    : 0;
+
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+
+  return `CN-${year}-${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNoteInput
+ * @param {string[]} existingNumbers - Array of existing CN and INV numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check if invoice is issued (not draft)
+  if (invoice.status === 'draft') return fail('NOT_ISSUED');
+
+  // Validate amount is a positive integer
+  if (!isPositiveInteger(amount)) return fail('AMOUNT_INVALID');
+
+  // Validate date
+  if (!isValidDate(date)) return fail('DATE_INVALID');
+
+  // Get invoice total
+  const totals = invoiceTotals(invoice);
+
+  // Check if credit amount exceeds invoice total
+  if (amount > totals.total) return fail('CREDIT_TOO_HIGH');
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
