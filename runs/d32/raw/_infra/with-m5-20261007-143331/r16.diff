+test('overdueInvoices returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2026-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-15', lines: [], terms: 'NET30' },
+    { number: 'INV-002', customerId: 'C-002', status: 'issued', dueDate: '2026-10-20', lines: [], terms: 'NET30' },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-10');
+  assert.deepEqual(result, []);
+});
+
