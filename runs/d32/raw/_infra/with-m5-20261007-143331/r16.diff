+import { invoiceTotals } from './invoices.js';
+
+function daysBetween(dateStr1, dateStr2) {
+  const [y1, m1, d1] = dateStr1.split('-').map(Number);
+  const [y2, m2, d2] = dateStr2.split('-').map(Number);
+  const date1 = new Date(y1, m1 - 1, d1);
+  const date2 = new Date(y2, m2 - 1, d2);
+  return Math.floor((date2 - date1) / (1000 * 60 * 60 * 24));
+}
+
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter(inv => (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate < asOf)
+    .map(inv => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: invoiceTotals(inv).total,
+    }))
+    .sort((a, b) => a.dueDate.localeCompare(b.dueDate));
+}
