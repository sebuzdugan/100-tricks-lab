@@ -20,3 +20,27 @@ export function overdueInvoices(invoices, asOf) {
     }))
     .sort((a, b) => a.dueDate.localeCompare(b.dueDate));
 }
+
+export function vatSummary(invoices) {
+  const summaryMap = new Map();
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) continue;
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVAT(line);
+
+      if (!summaryMap.has(rate)) {
+        summaryMap.set(rate, { rate, base: 0, vat: 0 });
+      }
+
+      const entry = summaryMap.get(rate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  return Array.from(summaryMap.values()).sort((a, b) => b.rate - a.rate);
+}
