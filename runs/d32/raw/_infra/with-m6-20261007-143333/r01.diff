@@ -0,0 +1,192 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice builds an invoice with customer, date, and line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2024-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 5,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+
+  assert.deepEqual(result.value.lines[1], {
+    sku: 'DEV-HOUR',
+    name: 'Development (hour)',
+    qty: 3,
+    unitPrice: 9500,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice returns DATE_INVALID for malformed date', () => {
+  const tests = [
+    '2024-1-15',
+    '2024/01/15',
+    '15-01-2024',
+    '2024-13-01',
+    '2024-01-32',
+    '2024-02-30',
+    'not-a-date',
+    '',
+  ];
+
+  for (const date of tests) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, false, `Expected failure for date: ${date}`);
+    assert.equal(result.error, 'DATE_INVALID');
+  }
+});
+
+test('createInvoice accepts valid dates', () => {
+  const validDates = ['2024-01-31', '2024-02-29', '2025-02-28', '1970-01-01'];
+
+  for (const date of validDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, true, `Expected success for date: ${date}`);
+  }
+});
+
+test('createInvoice returns NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice returns NO_LINES when lines is missing or null', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+  });
+
+  const result2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: null,
+  });
+
+  assert.equal(result1.ok, false);
+  assert.equal(result1.error, 'NO_LINES');
+  assert.equal(result2.ok, false);
+  assert.equal(result2.error, 'NO_LINES');
+});
+
+test('createInvoice returns QTY_INVALID for non-positive quantity', () => {
+  const tests = [0, -1, -10];
+
+  for (const qty of tests) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    });
+    assert.equal(result.ok, false, `Expected failure for qty: ${qty}`);
+    assert.equal(result.error, 'QTY_INVALID');
+  }
+});
+
+test('createInvoice returns QTY_INVALID for non-integer quantity', () => {
+  const tests = [1.5, 2.1, 0.5, '5', null, undefined];
+
+  for (const qty of tests) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    });
+    assert.equal(result.ok, false, `Expected failure for qty: ${qty}`);
+    assert.equal(result.error, 'QTY_INVALID');
+  }
+});
+
+test('createInvoice returns UNKNOWN_SKU for product not in catalogue', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'NOPE', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice stops at first line validation error', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'UNKNOWN', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice does not mutate the input lines', () => {
+  const inputLines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: inputLines,
+  });
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(inputLines, [{ sku: 'DES-HOUR', qty: 5 }]);
+  assert.notEqual(result.value.lines, inputLines);
+});
+
+test('createInvoice includes products with different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 }, // 21%
+      { sku: 'PRINT-A4', qty: 1 }, // 9%
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0%
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
