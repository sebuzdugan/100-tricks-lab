+/**
+ * Add or update a line on a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} param
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) {
+    return fail('QTY_INVALID');
+  }
+
+  // Get product to validate sku
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+  const existingLine = invoice.lines.find((line) => line.sku === sku);
+
+  let newLines;
+  if (existingLine) {
+    // Update existing line
+    newLines = invoice.lines.map((line) => (line.sku === sku ? { ...line, qty: line.qty + qty } : line));
+  } else {
+    // Add new line
+    newLines = [
+      ...invoice.lines,
+      {
+        sku,
+        name: product.name,
+        qty,
+        unitPrice: product.unitPrice,
+        vatRate: product.vatRate,
+      },
+    ];
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check status is draft
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Check if sku exists
+  const lineExists = invoice.lines.some((line) => line.sku === sku);
+  if (!lineExists) {
+    return fail('LINE_NOT_FOUND');
+  }
+
+  // Check if it's the last line
+  if (invoice.lines.length === 1) {
+    return fail('NO_LINES');
+  }
+
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
