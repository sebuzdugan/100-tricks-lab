@@ -0,0 +1,95 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for first invoice of the year', () => {
+  const number = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber returns 0002 when 0001 exists', () => {
+  const number = nextInvoiceNumber(['INV-2024-0001'], '2024-06-15');
+  assert.equal(number, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber handles multiple invoices in a year', () => {
+  const existingNumbers = [
+    'INV-2024-0001',
+    'INV-2024-0002',
+    'INV-2024-0005',
+    'INV-2024-0003',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2024-12-31');
+  assert.equal(number, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber handles numbers in random order', () => {
+  const existingNumbers = [
+    'INV-2024-0010',
+    'INV-2024-0001',
+    'INV-2024-0005',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-15');
+  assert.equal(number, 'INV-2024-0011');
+});
+
+test('nextInvoiceNumber restarts counter for each year', () => {
+  const existingNumbers = [
+    'INV-2023-0001',
+    'INV-2023-0002',
+    'INV-2023-0003',
+    'INV-2024-0001',
+  ];
+
+  const number2024 = nextInvoiceNumber(existingNumbers, '2024-06-15');
+  assert.equal(number2024, 'INV-2024-0002');
+
+  const number2025 = nextInvoiceNumber(existingNumbers, '2025-01-01');
+  assert.equal(number2025, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = [
+    'INV-2022-0005',
+    'INV-2023-0010',
+    'INV-2024-0003',
+    'INV-2025-0002',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-15');
+  assert.equal(number, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existingNumbers = [
+    'INV-2024-9998',
+    'INV-2024-9999',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2024-12-31');
+  assert.equal(number, 'INV-2024-10000');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const number = nextInvoiceNumber([], '2024-01-01');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber extracts year from issueDate correctly', () => {
+  const number1 = nextInvoiceNumber([], '2023-12-31');
+  const number2 = nextInvoiceNumber([], '2024-01-01');
+  const number3 = nextInvoiceNumber([], '2025-06-15');
+
+  assert.equal(number1, 'INV-2023-0001');
+  assert.equal(number2, 'INV-2024-0001');
+  assert.equal(number3, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existingNumbers = [
+    'INV-2024-0001',
+    'INV-2024-abc',
+    'INVALID',
+    'INV-2024-0003',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-15');
+  assert.equal(number, 'INV-2024-0004');
+});
