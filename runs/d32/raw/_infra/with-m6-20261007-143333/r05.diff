@@ -0,0 +1,179 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const issueResult = issueInvoice(result.value, []);
+  const invoice = issueResult.value;
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.startsWith('INV-2024-0001'));
+});
+
+test('renderInvoiceText includes customer name on second line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText includes one line per invoice line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Lines: number, customer name, 2 line items, total
+  assert.equal(lines.length, 5);
+  assert.ok(lines[2].includes('Design work (hour)'));
+  assert.ok(lines[3].includes('Development (hour)'));
+});
+
+test('renderInvoiceText shows qty, name, unit price and line total', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  const lineItem = lines[2];
+
+  // Should contain: qty, name, unit price (€85.00), line total (€425.00)
+  assert.ok(lineItem.includes('5'));
+  assert.ok(lineItem.includes('Design work (hour)'));
+  assert.ok(lineItem.includes('€85.00'));
+  assert.ok(lineItem.includes('€425.00'));
+});
+
+test('renderInvoiceText formats prices with formatEuros', () => {
+  const result = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  // LOGO-PACK is 120000 cents = €1,200.00
+  assert.ok(text.includes('€1,200.00'));
+});
+
+test('renderInvoiceText ends with Total line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  const lastLine = lines[lines.length - 1];
+
+  assert.ok(lastLine.startsWith('Total: '));
+  // Total should be 5*8500 + 3*9500 = 42500 + 28500 = 71000 cents = €710.00
+  assert.ok(lastLine.includes('€710.00'));
+});
+
+test('renderInvoiceText with single line invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Number, customer, 1 line item, total
+  assert.equal(lines.length, 4);
+  assert.ok(lines[0].includes('DRAFT'));
+  assert.equal(lines[1], 'Northwind Studio');
+  // STICKER is 50 cents, qty 100 = 5000 cents = €50.00
+  assert.ok(lines[2].includes('Sticker sheet'));
+  assert.ok(lines[2].includes('€0.50'));
+  assert.ok(lines[2].includes('€50.00'));
+  assert.ok(lines[3].startsWith('Total: €50.00'));
+});
+
+test('renderInvoiceText with different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },    // 21% VAT
+      { sku: 'PRINT-A4', qty: 1 },    // 9% VAT
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0% VAT
+    ],
+  });
+
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  // Just verify it renders without error and includes the items
+  assert.ok(text.includes('Design work (hour)'));
+  assert.ok(text.includes('Printed flyer A4'));
+  assert.ok(text.includes('Brand workshop'));
+});
+
+test('renderInvoiceText output is readable plain text', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invoice = result.value;
+  const text = renderInvoiceText(invoice);
+
+  // Should be multi-line
+  assert.ok(text.includes('\n'));
+
+  // Should not have any control characters
+  for (const char of text) {
+    assert.ok(char.charCodeAt(0) >= 32 || char === '\n', `Unexpected character: ${JSON.stringify(char)}`);
+  }
+});
