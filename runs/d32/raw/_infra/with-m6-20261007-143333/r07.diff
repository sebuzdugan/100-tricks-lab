+test('createInvoice applies gold tier discount when no discountPercent provided', () => {
+  // C-001 (Northwind Studio) is gold tier
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount when no discountPercent provided', () => {
+  // C-003 (Kite & Co) is silver tier
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount when no discountPercent provided', () => {
+  // C-002 (Blue Fern Bakery) is standard tier
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice explicit discountPercent overrides tier discount', () => {
+  // C-001 (Northwind Studio) is gold tier (5%), but we provide 10%
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5, discountPercent: 10 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice explicit discountPercent of 0 overrides tier discount', () => {
+  // C-001 (Northwind Studio) is gold tier (5%), but we explicitly set 0%
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5, discountPercent: 0 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice mixed lines with and without explicit discounts', () => {
+  // C-003 (Kite & Co) is silver tier (2.5%)
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },           // no discountPercent, gets tier 2.5%
+      { sku: 'DEV-HOUR', qty: 3, discountPercent: 10 },  // explicit 10%
+      { sku: 'PRINT-A4', qty: 2, discountPercent: 0 },   // explicit 0%
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+  assert.equal(result.value.lines[1].discountPercent, 10);
+  assert.equal(result.value.lines[2].discountPercent, 0);
+});
