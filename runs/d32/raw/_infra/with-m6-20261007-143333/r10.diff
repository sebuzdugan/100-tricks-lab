+/**
+ * Validate a date string in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const parts = text.split('-');
+  const year = parseInt(parts[0], 10);
+  const month = parseInt(parts[1], 10);
+  const day = parseInt(parts[2], 10);
+
+  const date = new Date(Date.UTC(year, month - 1, day));
+  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
+}
+
+/**
+ * Add days to a date string (in UTC).
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add
+ * @returns {string} - Date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const parts = dateStr.split('-');
+  const year = parseInt(parts[0], 10);
+  const month = parseInt(parts[1], 10);
+  const day = parseInt(parts[2], 10);
+
+  const date = new Date(Date.UTC(year, month - 1, day));
+  date.setUTCDate(date.getUTCDate() + n);
+
+  const resultYear = date.getUTCFullYear();
+  const resultMonth = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const resultDay = String(date.getUTCDate()).padStart(2, '0');
+
+  return `${resultYear}-${resultMonth}-${resultDay}`;
+}
+
+/**
+ * Calculate the number of days between two dates (b - a, in whole days, in UTC).
+ * @param {string} a - Date in YYYY-MM-DD format
+ * @param {string} b - Date in YYYY-MM-DD format
+ * @returns {number} - Number of days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const partsA = a.split('-');
+  const yearA = parseInt(partsA[0], 10);
+  const monthA = parseInt(partsA[1], 10);
+  const dayA = parseInt(partsA[2], 10);
+
+  const partsB = b.split('-');
+  const yearB = parseInt(partsB[0], 10);
+  const monthB = parseInt(partsB[1], 10);
+  const dayB = parseInt(partsB[2], 10);
+
+  const dateA = new Date(Date.UTC(yearA, monthA - 1, dayA));
+  const dateB = new Date(Date.UTC(yearB, monthB - 1, dayB));
+
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB - dateA) / msPerDay);
+}
