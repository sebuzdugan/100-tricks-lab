diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..3586e1a
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,113 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  const validDates = ['2024-01-31', '2024-02-29', '2025-02-28', '1970-01-01', '2099-12-31'];
+
+  for (const date of validDates) {
+    assert.equal(isValidDate(date), true, `Expected valid date: ${date}`);
+  }
+});
+
+test('isValidDate rejects malformed dates', () => {
+  const invalidFormats = [
+    '2024-1-15',
+    '2024/01/15',
+    '15-01-2024',
+    '2024-13-01',
+    '2024-01-32',
+    '2024-02-30',
+    'not-a-date',
+    '',
+  ];
+
+  for (const date of invalidFormats) {
+    assert.equal(isValidDate(date), false, `Expected invalid date: ${date}`);
+  }
+});
+
+test('isValidDate rejects invalid leap year dates', () => {
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate accepts valid leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+});
+
+test('addDays adds days to a date', () => {
+  assert.equal(addDays('2024-01-15', 0), '2024-01-15');
+  assert.equal(addDays('2024-01-15', 1), '2024-01-16');
+  assert.equal(addDays('2024-01-15', 10), '2024-01-25');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2024-01-31', 1), '2024-02-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2024-01-15', -1), '2024-01-14');
+  assert.equal(addDays('2024-02-01', -1), '2024-01-31');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays with large positive numbers', () => {
+  // 2024 is a leap year, so it has 366 days
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01');
+  assert.equal(addDays('2024-01-01', 367), '2025-01-02');
+});
+
+test('addDays with large negative numbers', () => {
+  // 2024 is a leap year, so it has 366 days
+  assert.equal(addDays('2025-01-01', -366), '2024-01-01');
+  assert.equal(addDays('2025-01-01', -367), '2023-12-31');
+});
+
+test('daysBetween calculates days between dates', () => {
+  assert.equal(daysBetween('2024-01-15', '2024-01-15'), 0);
+  assert.equal(daysBetween('2024-01-15', '2024-01-16'), 1);
+  assert.equal(daysBetween('2024-01-15', '2024-01-25'), 10);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2024-01-31', '2024-02-01'), 1);
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+});
+
+test('daysBetween handles negative results', () => {
+  assert.equal(daysBetween('2024-01-16', '2024-01-15'), -1);
+  assert.equal(daysBetween('2024-01-25', '2024-01-15'), -10);
+});
+
+test('daysBetween across year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  // 2024 is a leap year, so from 2024-01-01 to 2025-01-01 is 366 days
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+  // 2025 is not a leap year, so from 2025-01-01 to 2026-01-01 is 365 days
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
+
+test('daysBetween with large date ranges', () => {
+  assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365);
+  assert.equal(daysBetween('2024-01-01', '2026-01-01'), 731);
+});
+
+test('daysBetween is consistent with addDays', () => {
+  const startDate = '2024-06-15';
+  const days = 45;
+  const endDate = addDays(startDate, days);
+  assert.equal(daysBetween(startDate, endDate), days);
+});
+
+test('addDays and daysBetween round-trip', () => {
+  const original = '2024-03-15';
+  const daysToAdd = 100;
+  const modified = addDays(original, daysToAdd);
+  const calculated = daysBetween(original, modified);
+  assert.equal(calculated, daysToAdd);
+});
