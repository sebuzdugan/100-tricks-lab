diff --git a/src/payments.js b/src/payments.js
new file mode 100644
index 0000000..2a70ed1
--- /dev/null
+++ b/src/payments.js
@@ -0,0 +1,63 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the total amount paid on an invoice.
+ * @param {{ payments?: Array<{ amount: number, date: string }> }} invoice
+ * @returns {number}
+ */
+function totalPaid(invoice) {
+  if (!invoice.payments || invoice.payments.length === 0) {
+    return 0;
+  }
+  return invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+}
+
+/**
+ * Calculate the balance due on an invoice.
+ * @param {{ lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  return Math.max(0, totals.total - totalPaid(invoice));
+}
+
+/**
+ * Record a payment on an issued or partially_paid invoice.
+ * @param {{ status: string, lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} param
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check status is issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check for overpayment
+  const owed = balanceDue(invoice);
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Add payment
+  const payments = invoice.payments ? [...invoice.payments] : [];
+  payments.push({ amount, date });
+
+  // Determine new status
+  const totals = invoiceTotals(invoice);
+  const totalPaidAmount = totalPaid({ payments });
+  const newStatus = totalPaidAmount >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments,
+    status: newStatus,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
index 0000000..9bf62bd
--- /dev/null
+++ b/test/payments.test.js
@@ -0,0 +1,186 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+// Helper to create a simple issued invoice for testing
+function createTestInvoice(status = 'issued') {
+  return {
+    customerId: 'C-001',
+    customerName: 'Test Customer',
+    issueDate: '2024-01-15',
+    status,
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 5,
+        unitPrice: 8500,
+        vatRate: 21,
+        discountPercent: 5,
+      },
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 3,
+        unitPrice: 9500,
+        vatRate: 21,
+        discountPercent: 5,
+      },
+    ],
+  };
+}
+
+test('recordPayment adds a payment to an issued invoice', () => {
+  const invoice = createTestInvoice('issued');
+  const result = recordPayment(invoice, { amount: 5000, date: '2024-02-01' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.deepEqual(result.value.payments[0], { amount: 5000, date: '2024-02-01' });
+});
+
+test('recordPayment adds a payment to a partially_paid invoice', () => {
+  const invoice = createTestInvoice('partially_paid');
+  invoice.payments = [{ amount: 5000, date: '2024-01-20' }];
+
+  const result = recordPayment(invoice, { amount: 3000, date: '2024-02-01' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 2);
+  assert.deepEqual(result.value.payments[1], { amount: 3000, date: '2024-02-01' });
+});
+
+test('recordPayment sets status to partially_paid when partial payment is made', () => {
+  const invoice = createTestInvoice('issued');
+  const result = recordPayment(invoice, { amount: 5000, date: '2024-02-01' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when invoice is fully paid', () => {
+  const invoice = createTestInvoice('issued');
+  const balance = balanceDue(invoice);
+
+  const result = recordPayment(invoice, { amount: balance, date: '2024-02-01' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment returns NOT_ISSUED if invoice is draft', () => {
+  const invoice = createTestInvoice('draft');
+  const result = recordPayment(invoice, { amount: 5000, date: '2024-02-01' });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment returns NOT_ISSUED if invoice is paid', () => {
+  const invoice = createTestInvoice('paid');
+  const result = recordPayment(invoice, { amount: 5000, date: '2024-02-01' });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment returns AMOUNT_INVALID if amount is not an integer', () => {
+  const invoice = createTestInvoice('issued');
+  const result = recordPayment(invoice, { amount: 5000.5, date: '2024-02-01' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment returns AMOUNT_INVALID if amount is zero', () => {
+  const invoice = createTestInvoice('issued');
+  const result = recordPayment(invoice, { amount: 0, date: '2024-02-01' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment returns AMOUNT_INVALID if amount is negative', () => {
+  const invoice = createTestInvoice('issued');
+  const result = recordPayment(invoice, { amount: -1000, date: '2024-02-01' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment returns OVERPAYMENT if payment exceeds balance', () => {
+  const invoice = createTestInvoice('issued');
+  const balance = balanceDue(invoice);
+
+  const result = recordPayment(invoice, { amount: balance + 1, date: '2024-02-01' });
+
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment returns OVERPAYMENT if overpayment on partial invoice', () => {
+  const invoice = createTestInvoice('partially_paid');
+  invoice.payments = [{ amount: 5000, date: '2024-01-20' }];
+  const balance = balanceDue(invoice);
+
+  const result = recordPayment(invoice, { amount: balance + 1, date: '2024-02-01' });
+
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = createTestInvoice('issued');
+  delete invoice.payments;
+
+  const result = recordPayment(invoice, { amount: 5000, date: '2024-02-01' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+});
+
+test('balanceDue returns total invoice amount when no payments', () => {
+  const invoice = createTestInvoice('issued');
+  const balance = balanceDue(invoice);
+
+  assert.equal(typeof balance, 'number');
+  assert.equal(balance > 0, true);
+});
+
+test('balanceDue returns zero when invoice is fully paid', () => {
+  const invoice = createTestInvoice('paid');
+  const totals = invoiceTotals(invoice);
+  invoice.payments = [{ amount: totals.total, date: '2024-02-01' }];
+
+  const balance = balanceDue(invoice);
+
+  assert.equal(balance, 0);
+});
+
+test('balanceDue returns remaining balance after partial payment', () => {
+  const invoice = createTestInvoice('partially_paid');
+  const totals = invoiceTotals(invoice);
+  const paid = 5000;
+  invoice.payments = [{ amount: paid, date: '2024-01-20' }];
+
+  const balance = balanceDue(invoice);
+
+  assert.equal(balance, totals.total - paid);
+});
+
+test('balanceDue returns zero for invoice with no payments array', () => {
+  const invoice = createTestInvoice('issued');
+  delete invoice.payments;
+
+  const balance = balanceDue(invoice);
+
+  assert.equal(typeof balance, 'number');
+  assert.equal(balance > 0, true);
+});
+
+test('balanceDue with multiple payments', () => {
+  const invoice = createTestInvoice('partially_paid');
+  const totals = invoiceTotals(invoice);
+  invoice.payments = [
+    { amount: 3000, date: '2024-01-20' },
+    { amount: 2000, date: '2024-02-01' },
+  ];
+
+  const balance = balanceDue(invoice);
+
+  assert.equal(balance, totals.total - 5000);
+});
