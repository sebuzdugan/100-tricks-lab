+/**
+ * Get the last day of the month for a given date.
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @returns {string} - Last day of the month in YYYY-MM-DD format
+ */
+export function lastDayOfMonth(dateStr) {
+  const parts = dateStr.split('-');
+  const year = parseInt(parts[0], 10);
+  const month = parseInt(parts[1], 10);
+
+  const firstOfNextMonth = new Date(Date.UTC(year, month, 1));
+  firstOfNextMonth.setUTCDate(0);
+
+  const resultYear = firstOfNextMonth.getUTCFullYear();
+  const resultMonth = String(firstOfNextMonth.getUTCMonth() + 1).padStart(2, '0');
+  const resultDay = String(firstOfNextMonth.getUTCDate()).padStart(2, '0');
+
+  return `${resultYear}-${resultMonth}-${resultDay}`;
+}
