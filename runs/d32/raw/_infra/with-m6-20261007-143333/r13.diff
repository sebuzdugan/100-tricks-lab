+test('invoiceTotals with discount and voucher', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 10 },
+    ],
+    voucher: { code: 'SUMMER20', amount: 2000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  const lineTotal = 5 * 8500; // 42500
+  const discount = lineTotal * 10 / 100; // 4250
+  const amountAfterDiscount = lineTotal - discount; // 38250
+  const vat = amountAfterDiscount * 21 / 100; // 8032.5 -> 8032 (rounded)
+
+  assert.deepEqual(totals, {
+    subtotal: lineTotal,
+    discount,
+    vat: 8032,
+    voucher: 2000,
+    total: lineTotal - discount + 8032 - 2000,
