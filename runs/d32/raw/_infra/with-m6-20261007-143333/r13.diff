+test('applyVoucher adds a voucher to a draft invoice', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invoice = createResult.value;
+  const voucherResult = applyVoucher(invoice, { code: 'SUMMER20', amount: 5000 });
+
+  assert.equal(voucherResult.ok, true);
+  assert.deepEqual(voucherResult.value.voucher, { code: 'SUMMER20', amount: 5000 });
+});
+
+test('applyVoucher returns NOT_DRAFT if invoice is not draft', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', qty: 5, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+    number: 'INV-2024-0001',
+  };
+
+  const voucherResult = applyVoucher(invoice, { code: 'SUMMER20', amount: 5000 });
+
+  assert.equal(voucherResult.ok, false);
+  assert.equal(voucherResult.error, 'NOT_DRAFT');
+});
+
+test('applyVoucher returns VOUCHER_EXISTS if a voucher is already applied', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
