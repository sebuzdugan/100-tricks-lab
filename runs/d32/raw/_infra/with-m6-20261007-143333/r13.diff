+  const secondVoucher = applyVoucher(firstVoucher.value, { code: 'WINTER10', amount: 2000 });
+
+  assert.equal(secondVoucher.ok, false);
+  assert.equal(secondVoucher.error, 'VOUCHER_EXISTS');
+});
