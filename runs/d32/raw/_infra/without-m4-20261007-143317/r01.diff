+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.customerId, 'C-001');
+  assert.equal(invoice.issueDate, '2024-01-15');
+  assert.equal(invoice.status, 'draft');
+  assert.equal(invoice.lines.length, 2);
+
+  assert.equal(invoice.lines[0].sku, 'DES-HOUR');
+  assert.equal(invoice.lines[0].name, 'Design work (hour)');
+  assert.equal(invoice.lines[0].qty, 10);
+  assert.equal(invoice.lines[0].unitPrice, 8500);
+  assert.equal(invoice.lines[0].vatRate, 21);
+
+  assert.equal(invoice.lines[1].sku, 'DEV-HOUR');
+  assert.equal(invoice.lines[1].name, 'Development (hour)');
+  assert.equal(invoice.lines[1].qty, 5);
+  assert.equal(invoice.lines[1].unitPrice, 9500);
+  assert.equal(invoice.lines[1].vatRate, 21);
+});
+
+test('createInvoice rejects unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '15/01/2024',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects non-existent date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects non-integer quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects zero quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects negative quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice handles VAT-exempt products', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-06-01',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].vatRate, 0);
+  assert.equal(r.value.lines[0].unitPrice, 60000);
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+  const linesBefore = JSON.stringify(lines);
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines,
+  });
+
+  assert.equal(JSON.stringify(lines), linesBefore);
+});
