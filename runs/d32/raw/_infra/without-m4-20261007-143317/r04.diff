--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,29 @@
+/**
+ * Calculate the next invoice number for a given date.
+ * Format: INV-<year>-<counter>, where counter is 4 digits zero-padded, starting at 0001 per year.
+ * @param {Array<string>} existingNumbers - Array of invoice numbers already used (e.g., ["INV-2024-0001", "INV-2024-0003"])
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - The next free invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const currentYearNumbers = existingNumbers.filter((num) => num.startsWith(prefix));
+
+  if (currentYearNumbers.length === 0) {
+    return `${prefix}0001`;
+  }
+
+  const counters = currentYearNumbers
+    .map((num) => {
+      const match = num.match(/^INV-\d{4}-(\d{4})$/);
+      return match ? Number(match[1]) : 0;
+    })
+    .filter((c) => !isNaN(c));
+
+  const maxCounter = Math.max(...counters);
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
