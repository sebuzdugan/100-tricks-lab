diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..6d173de
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for first invoice of the year', () => {
+  const number = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-01');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existingNumbers = ['INV-2023-0001', 'INV-2023-0002', 'INV-2023-9999'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber finds next number when gaps exist', () => {
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0003', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-01');
+  assert.equal(number, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = ['INV-2023-0001', 'INV-2024-0002', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-01');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber handles unordered input', () => {
+  const existingNumbers = ['INV-2024-0005', 'INV-2024-0001', 'INV-2024-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-01');
+  assert.equal(number, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existingNumbers = ['INV-2024-0099'];
+  const number = nextInvoiceNumber(existingNumbers, '2024-06-01');
+  assert.equal(number, 'INV-2024-0100');
+});
