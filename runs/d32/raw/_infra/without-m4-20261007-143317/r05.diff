+++ b/test/render.test.js
@@ -0,0 +1,148 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+
+  assert.match(text, /^INV-2024-0001\n/);
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows all line details with formatting', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /^10 × Design work \(hour\) @ €85\.00 = €850\.00$/);
+});
+
+test('renderInvoiceText shows total with formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  const totalLine = lines[lines.length - 1];
+  assert.match(totalLine, /^Total: €1,325\.00$/);
+});
+
+test('renderInvoiceText handles multiple lines correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-06-01',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 6);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.match(lines[2], /10 × Design work/);
+  assert.match(lines[3], /5 × Development/);
+  assert.match(lines[4], /1 × Logo package/);
+  assert.match(lines[5], /^Total: /);
+});
+
+test('renderInvoiceText uses formatEuros for all amounts', () => {
+  const r = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+
+  assert.match(text, /€0\.50/);
+  assert.match(text, /Total: €25\.00/);
+});
+
+test('renderInvoiceText with VAT-exempt product', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /€600\.00 = €1,200\.00/);
+  assert.match(lines[3], /Total: €1,200\.00/);
+});
+
+test('renderInvoiceText maintains multi-year invoice numbers', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, ['INV-2024-0001']);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+
+  assert.match(text, /^INV-2025-0001\n/);
+});
