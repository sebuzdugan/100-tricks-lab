+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals, lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to customers.
+ * Every amount is formatted using formatEuros().
+ * @param {{ customerId: string, issueDate: string, status: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const number = invoice.number || 'DRAFT';
+
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  const lines = [number, customerName];
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..0078911
