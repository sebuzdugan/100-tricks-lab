+
+test('TIER_DISCOUNTS contains all tiers', () => {
+  assert.equal(TIER_DISCOUNTS.gold, 5);
+  assert.equal(TIER_DISCOUNTS.silver, 2.5);
+  assert.equal(TIER_DISCOUNTS.standard, 0);
+});
+
+test('createInvoice applies gold tier discount automatically', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount automatically', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount (0) automatically', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice explicit discountPercent overrides tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice explicit discountPercent 0 overrides gold tier', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, discountPercent: 0 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+  assert.equal(r.value.lines[1].discountPercent, 5);
+});
+
+test('createInvoice applies tier discount to multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5, discountPercent: 10 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 2.5);
+  assert.equal(r.value.lines[1].discountPercent, 10);
+});
+
+test('addLine applies tier discount for new lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const result = addLine(r.value, { sku: 'DEV-HOUR', qty: 5 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 5);
+});
+
+test('addLine explicit discountPercent overrides tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const result = addLine(r.value, { sku: 'DEV-HOUR', qty: 5, discountPercent: 0 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 0);
+});
+
+test('addLine does not apply tier discount when updating existing line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  const result = addLine(r.value, { sku: 'DES-HOUR', qty: 5 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
