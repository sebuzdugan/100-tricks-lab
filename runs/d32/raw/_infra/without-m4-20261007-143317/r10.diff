+/**
+ * Check if a date string is valid in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(String(text))) {
+    return false;
+  }
+
+  const parts = String(text).split('-');
+  const year = Number(parts[0]);
+  const month = Number(parts[1]);
+  const day = Number(parts[2]);
+
+  const date = new Date(Date.UTC(year, month - 1, day));
+  return (
+    date.getUTCFullYear() === year &&
+    date.getUTCMonth() === month - 1 &&
+    date.getUTCDate() === day
+  );
+}
+
+/**
+ * Add days to a date string (UTC), returning a new date string.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add
+ * @returns {string} - New date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const parts = String(date).split('-');
+  const year = Number(parts[0]);
+  const month = Number(parts[1]);
+  const day = Number(parts[2]);
+
+  const d = new Date(Date.UTC(year, month - 1, day));
+  d.setUTCDate(d.getUTCDate() + n);
+
+  const y = d.getUTCFullYear();
+  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const dy = String(d.getUTCDate()).padStart(2, '0');
+
+  return `${y}-${m}-${dy}`;
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a, in UTC).
+ * @param {string} a - First date in YYYY-MM-DD format
+ * @param {string} b - Second date in YYYY-MM-DD format
+ * @returns {number} - Whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const partsA = String(a).split('-');
+  const yearA = Number(partsA[0]);
+  const monthA = Number(partsA[1]);
+  const dayA = Number(partsA[2]);
+
+  const partsB = String(b).split('-');
+  const yearB = Number(partsB[0]);
+  const monthB = Number(partsB[1]);
+  const dayB = Number(partsB[2]);
+
+  const dateA = new Date(Date.UTC(yearA, monthA - 1, dayA));
+  const dateB = new Date(Date.UTC(yearB, monthB - 1, dayB));
+
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
