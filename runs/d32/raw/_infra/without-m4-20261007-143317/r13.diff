+ * Calculate invoice totals: subtotal, discount, VAT, voucher, and total.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
   const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
-  const total = Math.max(0, subtotal - discount + vat);
+  const voucher = invoice.voucher?.amount || 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
   return {
     subtotal: Math.max(0, subtotal),
     discount: Math.max(0, discount),
     vat: Math.max(0, vat),
+    voucher: Math.max(0, voucher),
     total
   };
 }
@@ -235,3 +237,24 @@ export function issueInvoice(invoice, existingNumbers) {
     lines: invoice.lines.map((line) => ({ ...line })),
   });
 }
+
+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: Object, ...rest }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: Object } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const newInvoice = { ...invoice };
+  newInvoice.voucher = { code, amount };
+
+  return ok(newInvoice);
+}
