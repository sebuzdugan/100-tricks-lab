+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement showing outstanding invoices.
+ * @param {string} customerId - Customer ID (will be normalized)
+ * @param {Array<{ number: string, issueDate: string, dueDate: string, status: string, ...rest }>} invoices - All invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format (statement cutoff date)
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const customer = customerResult.value;
+  const normalizedCustomerId = customer.id;
+
+  const relevantInvoices = invoices
+    .filter((inv) => inv.customerId === normalizedCustomerId)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate))
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: inv.total,
+      due: balanceDue(inv),
+    }));
+
+  const totalDue = relevantInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: relevantInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
