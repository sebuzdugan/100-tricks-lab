+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = createCreditNote(issued.value, {
+    amount: 50000,
+    reason: 'Discount for loyal customer',
+    date: '2024-01-20',
+  }, ['INV-2024-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2024-0001');
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Discount for loyal customer');
+  assert.equal(result.value.date, '2024-01-20');
+});
+
+test('createCreditNote works for partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  let invoice = issued.value;
+  const payment = recordPayment(invoice, { amount: 50000, date: '2024-01-20' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+  assert.equal(invoice.status, 'partially_paid');
+
+  const result = createCreditNote(invoice, {
+    amount: 25000,
+    reason: 'Partial refund',
+    date: '2024-01-25',
+  }, ['INV-2024-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote works for paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  let invoice = issued.value;
+  const payment = recordPayment(invoice, { amount: balanceDue(invoice), date: '2024-01-20' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+  assert.equal(invoice.status, 'paid');
+
+  const result = createCreditNote(invoice, {
+    amount: 1000,
+    reason: 'Overcharge correction',
+    date: '2024-01-25',
+  }, ['INV-2024-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+
+  const result = createCreditNote(inv.value, {
+    amount: 50000,
+    reason: 'Early payment discount',
+    date: '2024-01-20',
+  }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects invalid amount', () => {
