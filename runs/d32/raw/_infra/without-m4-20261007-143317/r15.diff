+    date: '2024-01-20',
+  }, ['INV-2024-0001']);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects overly high amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const invoice = issued.value;
+  const result = createCreditNote(invoice, {
+    amount: 10000000,
+    reason: 'Discount',
+    date: '2024-01-20',
+  }, ['INV-2024-0001']);
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote increments counter per year', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const result1 = createCreditNote(issued1.value, {
+    amount: 10000,
+    reason: 'Refund 1',
+    date: '2024-01-20',
+  }, ['INV-2024-0001']);
+
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.number, 'CN-2024-0001');
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2024-0001']);
+  assert.equal(issued2.ok, true);
+
+  const result2 = createCreditNote(issued2.value, {
+    amount: 5000,
+    reason: 'Refund 2',
+    date: '2024-02-20',
+  }, ['INV-2024-0001', 'CN-2024-0001']);
+
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote restarts counter for new year', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const result1 = createCreditNote(issued1.value, {
+    amount: 10000,
+    reason: 'Refund 2024',
+    date: '2024-12-15',
+  }, ['INV-2024-0001']);
+
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.number, 'CN-2024-0001');
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2024-0001']);
+  assert.equal(issued2.ok, true);
+
+  const result2 = createCreditNote(issued2.value, {
+    amount: 5000,
+    reason: 'Refund 2025',
+    date: '2025-01-20',
+  }, ['INV-2024-0001', 'CN-2024-0001']);
+
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
