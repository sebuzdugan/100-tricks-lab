@@ -0,0 +1,261 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns empty list for no overdue invoices', () => {
+  const result = overdueInvoices([], '2024-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv.ok, true);
+
+  const result = overdueInvoices([inv.value], '2024-02-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  let invoice = issued.value;
+  const payment = recordPayment(invoice, { amount: balanceDue(invoice), date: '2024-01-20' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+  assert.equal(invoice.status, 'paid');
+
+  const result = overdueInvoices([invoice], '2024-02-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = overdueInvoices([issued.value], '2024-02-10');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoice on due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = overdueInvoices([issued.value], '2024-02-14');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoice day after due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = overdueInvoices([issued.value], '2024-02-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2024-0001');
+  assert.equal(result[0].dueDate, '2024-02-14');
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices includes partially paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  let invoice = issued.value;
+  const payment = recordPayment(invoice, { amount: 50000, date: '2024-01-20' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+  assert.equal(invoice.status, 'partially_paid');
+
+  const result = overdueInvoices([invoice], '2024-02-01');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2024-0001');
+});
+
+test('overdueInvoices calculates correct daysOverdue', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = overdueInvoices([issued.value], '2024-02-05');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 7);
+});
+
+test('overdueInvoices calculates correct due amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = overdueInvoices([issued.value], '2024-02-05');
+  assert.equal(result.length, 1);
+  const expectedDue = 50 * 50 * 1.21;
+  assert.equal(result[0].due, expectedDue);
+});
+
+test('overdueInvoices calculates due after partial payment', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  let invoice = issued.value;
+  const payment = recordPayment(invoice, { amount: 1000, date: '2024-01-20' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+
+  const result = overdueInvoices([invoice], '2024-02-05');
+  assert.equal(result.length, 1);
+  const expectedDue = 50 * 50 * 1.21 - 1000;
+  assert.equal(result[0].due, expectedDue);
+});
+
+test('overdueInvoices sorts by most overdue first', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2024-0001']);
+  assert.equal(issued2.ok, true);
+
+  const result = overdueInvoices([issued1.value, issued2.value], '2024-02-05');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, 'INV-2024-0001');
+  assert.equal(result[0].daysOverdue, 21);
+  assert.equal(result[1].number, 'INV-2024-0002');
+  assert.equal(result[1].daysOverdue, 2);
+});
+
+test('overdueInvoices handles multiple overdue invoices for different customers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-05',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2024-0001']);
+  assert.equal(issued2.ok, true);
+
+  const result = overdueInvoices([issued1.value, issued2.value], '2024-02-05');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[1].customerId, 'C-002');
+});
+
+test('overdueInvoices includes correct invoice details', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = overdueInvoices([issued.value], '2024-03-15');
+  assert.equal(result.length, 1);
+
+  const item = result[0];
+  assert.equal(item.number, 'INV-2024-0001');
+  assert.equal(item.customerId, 'C-002');
+  assert.equal(item.dueDate, '2024-02-14');
+  assert.equal(item.daysOverdue, 30);
+  assert.equal(item.due, 5 * 8500 * 1.21);
+});
