--- /dev/null
+++ b/src/reports.js
@@ -0,0 +1,22 @@
+import { daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Get all overdue invoices as of a given date.
+ * @param {Array<{ number: string, status: string, dueDate: string, ...rest }>} invoices - All invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format (cutoff date)
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>} - Sorted by most overdue first
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
diff --git a/test/reports.test.js b/test/reports.test.js
