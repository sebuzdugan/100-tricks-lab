+/**
+ * Get VAT summary aggregated by rate.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} - Sorted by rate high to low
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = roundCents(base * (line.vatRate / 100));
+        const rate = line.vatRate;
+
+        if (!vatByRate[rate]) {
+          vatByRate[rate] = { rate, base: 0, vat: 0 };
+        }
+        vatByRate[rate].base += base;
+        vatByRate[rate].vat += vat;
+      });
+    });
+
+  return Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
+}
