+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns header and newline for empty list', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header row', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv exports single invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  const fields = lines[1].split(',');
+  assert.equal(fields[0], 'INV-2024-0001');
+  assert.equal(fields[1], 'Blue Fern Bakery');
+  assert.equal(fields[2], '2024-01-15');
+  assert.equal(fields[3], '2024-02-14');
+  assert.equal(fields[4], 'issued');
+});
+
+test('exportCsv formats amounts in euros with 2 decimals', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const subtotal = 100 * 50;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+
+  assert.equal(fields[5], (subtotal / 100).toFixed(2));
+  assert.equal(fields[7], (vat / 100).toFixed(2));
+  assert.equal(fields[8], (total / 100).toFixed(2));
+});
+
+test('exportCsv escapes customer name with commas', () => {
+  const inv = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  assert.ok(lines[1].includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes double quotes in fields', () => {
+  const inv = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  assert.ok(lines[1].includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv calculates due amount for unpaid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const total = 10 * 8500 * 1.21;
+  assert.equal(fields[9], (total / 100).toFixed(2));
+});
+
+test('exportCsv calculates due amount for paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  let invoice = issued.value;
+  const payment = recordPayment(invoice, { amount: balanceDue(invoice), date: '2024-01-20' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[9], '0.00');
+});
+
+test('exportCsv calculates due amount for partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  let invoice = issued.value;
+  const partialAmount = 50000;
+  const payment = recordPayment(invoice, { amount: partialAmount, date: '2024-01-20' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const total = 10 * 8500 * 1.21;
+  const remaining = total - partialAmount;
+  assert.equal(fields[9], (remaining / 100).toFixed(2));
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2024-0001']);
+  assert.equal(issued2.ok, true);
+
+  const csv = exportCsv([issued1.value, issued2.value]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 4);
+
+  const fields1 = lines[1].split(',');
+  assert.equal(fields1[0], 'INV-2024-0001');
+
+  const fields2 = lines[2].split(',');
+  assert.equal(fields2[0], 'INV-2024-0002');
+});
+
+test('exportCsv includes dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[3], '2024-02-14');
+});
+
+test('exportCsv includes discount in output', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100, discountPercent: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const subtotal = 100 * 8500;
+  const discount = Math.round(subtotal * 0.1);
+  assert.equal(fields[6], (discount / 100).toFixed(2));
+});
+
+test('exportCsv includes status in output', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  let invoice = issued.value;
+  const payment = recordPayment(invoice, { amount: 50000, date: '2024-01-20' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[4], 'partially_paid');
+});
+
+test('exportCsv ends with newline', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  assert.ok(csv.endsWith('\n'));
+});
+
+test('exportCsv handles zero amount fields correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[6], '0.00');
+});
