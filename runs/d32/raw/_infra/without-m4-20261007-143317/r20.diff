diff --git a/src/money.js b/src/money.js
index fadf486..422b90a 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,14 @@
 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of each currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +48,41 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert cents in euros to cents in another currency.
+ * @param {number} euroCents - Amount in euro cents
+ * @param {string} currency - Target currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(euroCents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const convertedCents = roundCents(euroCents * rate);
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents in a currency for people: 123456 cents -> "$1,234.56" for USD.
+ * @param {number} cents - Amount in that currency's cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const wholePart = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const fractionalPart = String(abs % 100).padStart(2, '0');
+  const formatted = `${wholePart}.${fractionalPart}`;
+
+  if (currency === 'USD') {
+    return `${sign}$${formatted}`;
+  } else if (currency === 'GBP') {
+    return `${sign}£${formatted}`;
+  } else {
+    return `${sign}${formatted}`;
+  }
+}
