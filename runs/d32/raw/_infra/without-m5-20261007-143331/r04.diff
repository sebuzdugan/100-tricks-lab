diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..d322ad6
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,46 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for empty array', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const num = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber finds max counter in same year', () => {
+  const num = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0005', 'INV-2026-0003'], '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const num = nextInvoiceNumber(['INV-2025-0100', 'INV-2026-0005', 'INV-2027-0050'], '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const num = nextInvoiceNumber(['INV-2025-0050', 'INV-2025-0100'], '2026-01-01');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+
+  const num2 = nextInvoiceNumber(Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`), '2026-10-07');
+  assert.equal(num2, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const num = nextInvoiceNumber(['INV-2026-abc', 'INV-2026-0001', 'invalid'], '2026-10-07');
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber with large counter', () => {
+  const num = nextInvoiceNumber(['INV-2026-9999'], '2026-10-07');
+  assert.equal(num, 'INV-2026-10000');
+});
