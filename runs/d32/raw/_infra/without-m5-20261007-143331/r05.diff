+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert(text.includes('DRAFT'));
+  assert(text.includes('Northwind Studio'));
+  assert(text.includes('5 ×'));
+  assert(text.includes('Design work (hour)'));
+  assert(text.includes('€85.00'));
+  assert(text.includes('Total: €425.00'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert(text.includes('INV-2026-0001'));
+  assert(!text.includes('DRAFT'));
+  assert(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 3, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Kite & Co');
+  assert(lines[2].includes('5 ×'));
+  assert(lines[2].includes('Design work (hour)'));
+  assert(lines[2].includes('€425.00'));
+  assert(lines[3].includes('3 ×'));
+  assert(lines[3].includes('Development (hour)'));
+  assert(lines[3].includes('€285.00'));
+  assert.equal(lines[4], 'Total: €710.00');
+});
+
+test('renderInvoiceText formats amounts in euros', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'STICKER', name: 'Sticker sheet', qty: 100, unitPrice: 50, vatRate: 21 },
+      { sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 2, unitPrice: 980, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert(text.includes('€0.50'));
+  assert(text.includes('€50.00'));
+  assert(text.includes('€9.80'));
+  assert(text.includes('€19.60'));
+  assert(text.includes('Total: €69.60'));
+});
+
+test('renderInvoiceText returns a string with newlines', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert(typeof text === 'string');
+  const lines = text.split('\n');
+  assert(lines.length >= 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert(lines[2].includes('Design work'));
+  assert(lines[3].startsWith('Total:'));
+});
+
+test('renderInvoiceText with deleted customer uses customer ID', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert(text.includes('C-999'));
+  assert(text.includes('DRAFT'));
+});
