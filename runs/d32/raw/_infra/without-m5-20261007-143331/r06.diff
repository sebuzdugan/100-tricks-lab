+test('renderInvoiceText shows subtotal and discount when applicable', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 10 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
