+
+test('createInvoice applies gold tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice explicit discountPercent overrides tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 15 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 15);
+});
+
+test('createInvoice explicit 0 discount overrides tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice with mixed explicit and tier discounts', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3, discountPercent: 10 },
+      { sku: 'ICON-SET', qty: 2, discountPercent: 0 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+  assert.equal(r.value.lines[1].discountPercent, 10);
+  assert.equal(r.value.lines[2].discountPercent, 0);
+});
