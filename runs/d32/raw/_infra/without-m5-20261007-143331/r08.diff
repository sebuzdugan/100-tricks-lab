+/**
+ * Calculate the VAT amount (in cents) for a single invoice line.
+ * VAT is calculated on the line total after discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number}
+ */
+export function vat(line) {
+  const total = lineTotal(line);
+  const discountAmount = discount(line);
+  const amountAfterDiscount = total - discountAmount;
+  const vatAmount = roundCents(amountAfterDiscount * line.vatRate / 100);
+  return Math.max(0, vatAmount);
+}
+
 /**
  * Calculate totals for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }}
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   const discountTotal = invoice.lines.reduce((sum, line) => sum + discount(line), 0);
-  const total = Math.max(0, subtotal - discountTotal);
+  const vatTotal = invoice.lines.reduce((sum, line) => sum + vat(line), 0);
+  const total = Math.max(0, subtotal - discountTotal + vatTotal);
   return {
     subtotal,
     discount: discountTotal,
+    vat: vatTotal,
     total,
   };
 }
