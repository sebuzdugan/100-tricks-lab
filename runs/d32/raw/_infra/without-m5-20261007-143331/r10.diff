+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * All dates work in UTC.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return false;
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const [year, month, day] = dateStr.split('-').map(Number);
+  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date string, working in UTC.
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - Resulting date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const date = new Date(dateStr + 'T00:00:00Z');
+  date.setUTCDate(date.getUTCDate() + n);
+  return date.toISOString().substring(0, 10);
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a), working in UTC.
+ * @param {string} a - Earlier date in YYYY-MM-DD format
+ * @param {string} b - Later date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
