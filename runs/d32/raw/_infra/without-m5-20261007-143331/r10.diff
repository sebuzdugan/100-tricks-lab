+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate validates YYYY-MM-DD format', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate('2026-10-07T00:00:00Z'), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+});
+
+test('isValidDate validates leap year correctly', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+});
+
+test('addDays adds negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -7), '2026-09-30');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays adds zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays works across year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2025-12-25', 10), '2026-01-04');
+});
+
+test('addDays works across month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-01-30', 2), '2026-02-01');
+});
+
+test('daysBetween calculates days correctly', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween with negative result', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+});
+
+test('daysBetween across year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2025-12-25', '2026-01-04'), 10);
+});
+
+test('daysBetween across month boundaries', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-01-30', '2026-02-01'), 2);
+});
+
+test('daysBetween with large date range', () => {
+  assert.equal(daysBetween('2000-01-01', '2000-12-31'), 365);
+  assert.equal(daysBetween('2000-01-01', '2001-01-01'), 366);
+});
