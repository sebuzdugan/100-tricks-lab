@@ -0,0 +1,50 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the balance still due on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {number} - The amount still owed (in cents)
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const payments = invoice.payments ?? [];
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const stillOwed = balanceDue(invoice);
+  if (amount > stillOwed) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = [...(invoice.payments ?? []), { amount, date }];
+  const totalPaid = newPayments.reduce((sum, p) => sum + p.amount, 0);
+  const totals = invoiceTotals(invoice);
+
+  let newStatus = 'partially_paid';
+  if (totalPaid >= totals.total) {
+    newStatus = 'paid';
+  }
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
index 0000000..57492d9
--- /dev/null
+++ b/test/payments.test.js
@@ -0,0 +1,169 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment adds a payment to an issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const r3 = recordPayment(r2.value, { amount: 10000, date: '2026-10-10' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 1);
+  assert.equal(r3.value.payments[0].amount, 10000);
+  assert.equal(r3.value.payments[0].date, '2026-10-10');
+  assert.equal(r3.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when payment covers total', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+
+  const r3 = recordPayment(r2.value, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'paid');
+});
+
+test('recordPayment rejects non-issued invoices', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  assert.deepEqual(recordPayment(invoice, { amount: 10000, date: '2026-10-10' }), { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects invalid amounts', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  assert.deepEqual(recordPayment(r2.value, { amount: 0, date: '2026-10-10' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(recordPayment(r2.value, { amount: -1000, date: '2026-10-10' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(recordPayment(r2.value, { amount: 1000.5, date: '2026-10-10' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const result = recordPayment(r2.value, { amount: 100000, date: '2026-10-10' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment allows multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  const r3 = recordPayment(r2.value, { amount: 30000, date: '2026-10-10' });
+  assert.equal(r3.ok, true);
+
+  const r4 = recordPayment(r3.value, { amount: 20000, date: '2026-10-15' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.payments.length, 2);
+  assert.equal(r4.value.payments[0].amount, 30000);
+  assert.equal(r4.value.payments[1].amount, 20000);
+});
+
+test('recordPayment works on partially paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: 30000, date: '2026-10-10' });
+  assert.equal(r3.value.status, 'partially_paid');
+
+  const r4 = recordPayment(r3.value, { amount: 20000, date: '2026-10-15' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.status, 'partially_paid');
+});
+
+test('recordPayment does not mutate input invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const invoice = r2.value;
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+
+  recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('balanceDue calculates amount still owed', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const initialBalance = balanceDue(r2.value);
+  assert(initialBalance > 0);
+
+  const r3 = recordPayment(r2.value, { amount: 30000, date: '2026-10-10' });
+  const remainingBalance = balanceDue(r3.value);
+  assert.equal(remainingBalance, initialBalance - 30000);
+});
+
+test('balanceDue is zero for paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+
+  const r3 = recordPayment(r2.value, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(balanceDue(r3.value), 0);
+});
+
+test('balanceDue never goes negative', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'paid',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    payments: [{ amount: 20000, date: '2026-10-10' }],
+  };
+
+  assert.equal(balanceDue(invoice), 0);
+});
