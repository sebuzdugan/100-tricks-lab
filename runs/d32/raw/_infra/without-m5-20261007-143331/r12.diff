@@ -35,3 +35,26 @@ export function daysBetween(a, b) {
   const diffMs = dateB.getTime() - dateA.getTime();
   return Math.floor(diffMs / (1000 * 60 * 60 * 24));
 }
+
+/**
+ * Calculate the due date based on payment terms.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} - Due date in YYYY-MM-DD format
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    const [year, month] = issueDate.substring(0, 7).split('-').map(Number);
+    const nextMonth = month === 12 ? 1 : month + 1;
+    const nextYear = month === 12 ? year + 1 : year;
+    const firstDayNextMonth = `${nextYear}-${String(nextMonth).padStart(2, '0')}-01`;
+    return addDays(firstDayNextMonth, -1);
+  }
+  return null;
+}
