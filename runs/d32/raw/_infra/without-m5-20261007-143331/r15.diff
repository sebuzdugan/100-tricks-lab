diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..60919a2
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,147 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  const result = createCreditNote(r2.value, { amount: 5000, reason: 'Partial refund', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2026-10-10');
+});
+
+test('createCreditNote works on partially_paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: 30000, date: '2026-10-09' });
+
+  const result = createCreditNote(r3.value, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total, date: '2026-10-09' });
+
+  const result = createCreditNote(r3.value, { amount: 5000, reason: 'Full refund', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.deepEqual(
+    createCreditNote(r.value, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('createCreditNote rejects invalid amounts', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  assert.deepEqual(
+    createCreditNote(r2.value, { amount: 0, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+
+  assert.deepEqual(
+    createCreditNote(r2.value, { amount: -1000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+
+  assert.deepEqual(
+    createCreditNote(r2.value, { amount: 1000.5, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects amount greater than invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+
+  assert.deepEqual(
+    createCreditNote(r2.value, { amount: totals.total + 1000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
+
+test('nextCreditNoteNumber generates correct numbers', () => {
+  const num1 = nextCreditNoteNumber([], '2026-10-07');
+  assert.equal(num1, 'CN-2026-0001');
+
+  const num2 = nextCreditNoteNumber(['CN-2026-0001', 'INV-2026-0001'], '2026-10-07');
+  assert.equal(num2, 'CN-2026-0002');
+
+  const num3 = nextCreditNoteNumber(['CN-2026-0001', 'CN-2026-0005'], '2026-10-07');
+  assert.equal(num3, 'CN-2026-0006');
+});
+
+test('nextCreditNoteNumber separates invoices from credit notes', () => {
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const num = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(num, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber restarts counter each year', () => {
+  const existingNumbers = ['CN-2025-0050', 'CN-2025-0075'];
+  const num = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(num, 'CN-2026-0001');
+});
+
+test('createCreditNote with amount equal to invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+
+  const result = createCreditNote(r2.value, { amount: totals.total, reason: 'Full refund', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
