+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns invoices with dueDate before asOf', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const invoices = [i1.value];
+
+  const result = overdueInvoices(invoices, '2026-10-01');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-09-15');
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const invoices = [i1.value];
+
+  const result = overdueInvoices(invoices, '2026-10-01');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const invoices = [r1.value];
+
+  const result = overdueInvoices(invoices, '2026-10-01');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(i1.value);
+  const p1 = recordPayment(i1.value, { amount: totals.total, date: '2026-10-01' });
+
+  const invoices = [p1.value];
+
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes issued and partially_paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+    terms: 'NET14',
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const i2 = issueInvoice(r2.value, ['INV-2026-0001']);
+
+  const p2 = recordPayment(i2.value, { amount: 10000, date: '2026-10-01' });
+
+  const invoices = [i1.value, p2.value];
+
+  const result = overdueInvoices(invoices, '2026-10-01');
+  assert.equal(result.length, 2);
+});
+
+test('overdueInvoices sorts by daysOverdue (most overdue first)', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-08-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+    terms: 'NET14',
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const i2 = issueInvoice(r2.value, ['INV-2026-0001']);
+
+  const invoices = [i1.value, i2.value];
+
+  const result = overdueInvoices(invoices, '2026-10-01');
+  assert.equal(result.length, 2);
+  assert(result[0].daysOverdue > result[1].daysOverdue);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[1].number, 'INV-2026-0002');
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const invoices = [i1.value];
+
+  const result = overdueInvoices(invoices, '2026-09-30');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 15);
+});
+
+test('overdueInvoices includes due amount from balanceDue', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(i1.value);
+  const p1 = recordPayment(i1.value, { amount: Math.floor(totals.total / 2), date: '2026-09-10' });
+
+  assert.equal(p1.ok, true);
+  const invoices = [p1.value];
+
+  const result = overdueInvoices(invoices, '2026-10-01');
+  assert.equal(result.length, 1);
+  assert(result[0].due > 0);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const invoices = [i1.value];
+
+  const result = overdueInvoices(invoices, '2026-10-01');
+  assert.equal(result.length, 0);
+});
