+
+/**
+ * Calculate the late fee for an invoice.
+ * Late fee is 0.04% of the amount due for every day overdue.
+ * @param {{ dueDate: string, status: string, payments?: Array }} invoice
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (!invoice.dueDate) {
+    return 0;
+  }
+
+  const days = daysBetween(invoice.dueDate, asOf);
+  if (days <= 0) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  return roundCents(due * days * 4 / 10000);
+}
