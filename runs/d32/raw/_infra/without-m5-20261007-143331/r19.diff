+++ b/test/export.test.js
@@ -0,0 +1,213 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns CSV string with header', () => {
+  const csv = exportCsv([]);
+  assert(csv.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv exports a single invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const csv = exportCsv([i1.value]);
+
+  assert(csv.includes('INV-2026-0001'));
+  assert(csv.includes('Northwind Studio'));
+  assert(csv.includes('2026-10-01'));
+  assert(csv.includes('issued'));
+});
+
+test('exportCsv formats amounts correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(i1.value);
+  const csv = exportCsv([i1.value]);
+
+  const lines = csv.split('\n');
+  const invoiceLine = lines[1];
+
+  const expectedAmount = (totals.total / 100).toFixed(2);
+  assert(invoiceLine.includes(expectedAmount));
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const i2 = issueInvoice(r2.value, ['INV-2026-0001']);
+
+  const csv = exportCsv([i1.value, i2.value]);
+  const lines = csv.split('\n').filter((line) => line.length > 0);
+
+  assert.equal(lines.length, 3);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv escapes commas in fields', () => {
+  const r1 = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const csv = exportCsv([i1.value]);
+
+  assert(csv.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes quotes in fields', () => {
+  const r1 = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const csv = exportCsv([i1.value]);
+
+  assert(csv.includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv exports draft invoices without number', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const csv = exportCsv([r1.value]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].startsWith(','));
+  assert(lines[1].includes('draft'));
+});
+
+test('exportCsv includes due amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(i1.value);
+
+  const csv = exportCsv([i1.value]);
+  const expectedDue = (totals.total / 100).toFixed(2);
+
+  assert(csv.includes(expectedDue));
+});
+
+test('exportCsv shows 0 due for paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(i1.value);
+  const p1 = recordPayment(i1.value, { amount: totals.total, date: '2026-10-05' });
+
+  assert.equal(p1.ok, true);
+  const csv = exportCsv([p1.value]);
+
+  assert(csv.includes(',0.00'));
+});
+
+test('exportCsv with partial payment shows remaining due', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(i1.value);
+  const paymentAmount = Math.floor(totals.total / 2);
+  const p1 = recordPayment(i1.value, { amount: paymentAmount, date: '2026-10-05' });
+
+  assert.equal(p1.ok, true);
+  const csv = exportCsv([p1.value]);
+
+  const expectedDue = (totals.total - paymentAmount) / 100;
+  assert(csv.includes(expectedDue.toFixed(2)));
+});
+
+test('exportCsv includes discount and VAT in totals', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(i1.value);
+
+  const csv = exportCsv([i1.value]);
+
+  const lines = csv.split('\n');
+  const invoiceLine = lines[1];
+
+  const parts = invoiceLine.split(',');
+  const csvDiscount = parseFloat(parts[6]);
+  const csvVat = parseFloat(parts[7]);
+
+  assert(csvDiscount > 0);
+  assert(csvVat > 0);
+  assert(Math.abs(csvDiscount - totals.discount / 100) < 0.01);
+  assert(Math.abs(csvVat - totals.vat / 100) < 0.01);
+});
+
+test('exportCsv includes dueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([i1.value]);
+
+  assert(csv.includes('2026-10-04'));
+});
+
+test('exportCsv lines end with newline', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const i1 = issueInvoice(r1.value, []);
+  const csv = exportCsv([i1.value]);
+
+  assert(csv.endsWith('\n'));
+});
