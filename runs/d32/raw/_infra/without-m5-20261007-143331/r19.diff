+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function formatAmount(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+function escapeCsv(field) {
+  if (field == null) {
+    return '';
+  }
+
+  const str = String(field);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+
+  return str;
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array<any>} invoices
+ * @returns {string} - CSV formatted string
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  invoices.forEach((invoice) => {
+    const customer = getCustomer(invoice.customerId);
+    const customerName = customer.ok ? customer.value.name : invoice.customerId;
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const row = [
+      escapeCsv(invoice.number || ''),
+      escapeCsv(customerName),
+      escapeCsv(invoice.issueDate),
+      escapeCsv(invoice.dueDate || ''),
+      escapeCsv(invoice.status),
+      formatAmount(totals.subtotal),
+      formatAmount(totals.discount),
+      formatAmount(totals.vat),
+      formatAmount(totals.total),
+      formatAmount(due),
+    ];
+
+    lines.push(row.join(','));
+  });
+
+  return lines.join('\n') + '\n';
+}
diff --git a/test/export.test.js b/test/export.test.js
