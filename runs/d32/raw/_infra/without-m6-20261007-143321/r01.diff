@@ -0,0 +1,46 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+function isValidDate(dateString) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateString);
+  if (!match) return false;
+  const [, year, month, day] = match;
+  const date = new Date(`${year}-${month}-${day}T00:00:00Z`);
+  if (Number.isNaN(date.getTime())) return false;
+  return date.toISOString().startsWith(`${year}-${month}-${day}`);
+}
+
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customer = getCustomer(customerId);
+  if (!customer.ok) return customer;
+
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  const invoiceLines = [];
+  for (const line of lines) {
+    if (typeof line.qty !== 'number' || !Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    const product = getProduct(line.sku);
+    if (!product.ok) return product;
+
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.value.name,
+      qty: line.qty,
+      unitPrice: product.value.unitPrice,
+      vatRate: product.value.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
