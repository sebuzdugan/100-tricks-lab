diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..a0e2ece
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns INV-YYYY-0001 when no numbers exist', () => {
+  const number = nextInvoiceNumber([], '2025-10-07');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter within the same year', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-10-07');
+  assert.equal(number, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber resets counter for a new year', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2024-0099'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-01-15');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber handles non-sequential numbers', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0005', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-10-07');
+  assert.equal(number, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = ['INV-2024-9999', 'INV-2025-0001', 'INV-2026-0050'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-12-31');
+  assert.equal(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-ABC', 'INVALID', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-10-07');
+  assert.equal(number, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existingNumbers = [];
+  const number = nextInvoiceNumber(existingNumbers, '2025-10-07');
+  assert.equal(number, 'INV-2025-0001');
+  const number2 = nextInvoiceNumber(['INV-2025-0009'], '2025-10-07');
+  assert.equal(number2, 'INV-2025-0010');
+  const number3 = nextInvoiceNumber(['INV-2025-0099'], '2025-10-07');
+  assert.equal(number3, 'INV-2025-0100');
+  const number4 = nextInvoiceNumber(['INV-2025-0999'], '2025-10-07');
+  assert.equal(number4, 'INV-2025-1000');
+});
+
+test('nextInvoiceNumber works with numbers in any order', () => {
+  const existingNumbers = ['INV-2025-0005', 'INV-2025-0001', 'INV-2025-0003', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-10-07');
+  assert.equal(number, 'INV-2025-0006');
+});
