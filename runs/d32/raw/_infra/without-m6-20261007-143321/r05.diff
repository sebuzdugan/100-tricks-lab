+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText displays a draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 5,
+        unitPrice: 8500,
+        vatRate: 21,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /5x Design work \(hour\) @ €85\.00 = €425\.00\n/);
+  assert.match(text, /Total: €425\.00$/);
+});
+
+test('renderInvoiceText displays an issued invoice with number', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    status: 'issued',
+    number: 'INV-2025-0001',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 5,
+        unitPrice: 8500,
+        vatRate: 21,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^INV-2025-0001\n/);
+  assert.match(text, /Blue Fern Bakery\n/);
+});
+
+test('renderInvoiceText displays multiple lines', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2025-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 5,
+        unitPrice: 8500,
+        vatRate: 21,
+      },
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 3,
+        unitPrice: 9500,
+        vatRate: 21,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.match(lines[2], /5x Design work \(hour\)/);
+  assert.match(lines[3], /3x Development \(hour\)/);
+  assert.equal(lines[4], 'Total: €710.00');
+});
+
+test('renderInvoiceText formats amounts correctly with formatEuros', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'LOGO-PACK',
+        name: 'Logo package',
+        qty: 1,
+        unitPrice: 120000,
+        vatRate: 21,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /@ €1,200\.00 = €1,200\.00/);
+});
+
+test('renderInvoiceText handles multiple items with correct totals', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'COPY-HOUR',
+        name: 'Copywriting (hour)',
+        qty: 10,
+        unitPrice: 6000,
+        vatRate: 21,
+      },
+      {
+        sku: 'SUPPORT-HOUR',
+        name: 'Support (hour)',
+        qty: 5,
+        unitPrice: 7250,
+        vatRate: 21,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /10x Copywriting \(hour\) @ €60\.00 = €600\.00/);
+  assert.match(text, /5x Support \(hour\) @ €72\.50 = €362\.50/);
+  assert.match(text, /Total: €962\.50/);
+});
+
+test('renderInvoiceText displays VAT-exempt items', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'WORKSHOP-DAY',
+        name: 'Brand workshop (day, VAT exempt)',
+        qty: 1,
+        unitPrice: 60000,
+        vatRate: 0,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Brand workshop \(day, VAT exempt\)/);
+  assert.match(text, /@ €600\.00 = €600\.00/);
