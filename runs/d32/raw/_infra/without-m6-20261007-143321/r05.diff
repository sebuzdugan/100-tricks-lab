+
+test('renderInvoiceText includes customer name from database', () => {
+  const invoice = {
+    customerId: 'C-010',
+    issueDate: '2025-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 1,
+        unitPrice: 8500,
+        vatRate: 21,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Tidewater Museum/);
+});
+
+test('renderInvoiceText handles unknown customer gracefully', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2025-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 1,
+        unitPrice: 8500,
+        vatRate: 21,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'C-999');
+});
+
+test('renderInvoiceText shows correct line structure', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    status: 'issued',
+    number: 'INV-2025-0042',
+    lines: [
+      {
+        sku: 'ICON-SET',
+        name: 'Icon set (24 icons)',
+        qty: 2,
+        unitPrice: 980,
+        vatRate: 21,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2025-0042');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '2x Icon set (24 icons) @ €9.80 = €19.60');
+  assert.equal(lines[3], 'Total: €19.60');
+});
