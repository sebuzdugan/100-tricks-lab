diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..c55933f
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,132 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-10-07'), true);
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+});
+
+test('isValidDate rejects invalid date formats', () => {
+  assert.equal(isValidDate('07-10-2025'), false);
+  assert.equal(isValidDate('2025/10/07'), false);
+  assert.equal(isValidDate('not a date'), false);
+  assert.equal(isValidDate('2025-10-7'), false);
+  assert.equal(isValidDate('2025-1-07'), false);
+});
+
+test('isValidDate rejects nonexistent dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+  assert.equal(isValidDate('2023-02-29'), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2023-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-10-07', 1), '2025-10-08');
+  assert.equal(addDays('2025-10-07', 5), '2025-10-12');
+  assert.equal(addDays('2025-10-07', 30), '2025-11-06');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-10-31', 1), '2025-11-01');
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2025-10-07', -1), '2025-10-06');
+  assert.equal(addDays('2025-10-07', -7), '2025-09-30');
+});
+
+test('addDays handles negative days across boundaries', () => {
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+  assert.equal(addDays('2025-01-01', -366), '2024-01-01');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2025-10-07', 0), '2025-10-07');
+});
+
+test('daysBetween calculates positive days', () => {
+  assert.equal(daysBetween('2025-10-07', '2025-10-08'), 1);
+  assert.equal(daysBetween('2025-10-07', '2025-10-12'), 5);
+  assert.equal(daysBetween('2025-10-07', '2025-11-06'), 30);
+});
+
+test('daysBetween calculates negative days', () => {
+  assert.equal(daysBetween('2025-10-08', '2025-10-07'), -1);
+  assert.equal(daysBetween('2025-10-12', '2025-10-07'), -5);
+});
+
+test('daysBetween returns zero for same date', () => {
+  assert.equal(daysBetween('2025-10-07', '2025-10-07'), 0);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2024-12-31'), -1);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2025-10-31', '2025-11-01'), 1);
+  assert.equal(daysBetween('2025-10-01', '2025-10-31'), 30);
+});
+
+test('daysBetween works across multiple years', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+  assert.equal(daysBetween('2023-01-01', '2025-01-01'), 731);
+});
+
+test('addDays and daysBetween are inverse operations', () => {
+  const start = '2025-10-07';
+  const days = 100;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+});
+
+test('daysBetween handles leap years correctly', () => {
+  const leap = '2024-02-29';
+  const next = '2024-03-01';
+  assert.equal(daysBetween(leap, next), 1);
+  assert.equal(addDays(leap, 1), next);
+});
+
+test('addDays throws on invalid date format', () => {
+  assert.throws(() => addDays('07-10-2025', 1), /Invalid date format/);
+  assert.throws(() => addDays('not a date', 1), /Invalid date format/);
+});
+
+test('daysBetween throws on invalid date format', () => {
+  assert.throws(() => daysBetween('07-10-2025', '2025-10-08'), /Invalid date format/);
+  assert.throws(() => daysBetween('2025-10-07', 'not a date'), /Invalid date format/);
+});
+
+test('addDays returns zero-padded dates', () => {
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+  assert.equal(addDays('2025-09-30', 1), '2025-10-01');
+});
+
+test('addDays with large positive number', () => {
+  assert.equal(addDays('2025-01-01', 365), '2026-01-01');
+});
+
+test('addDays with large negative number', () => {
+  assert.equal(addDays('2025-01-01', -365), '2024-01-02');
+});
