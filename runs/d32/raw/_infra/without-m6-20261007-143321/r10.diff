+export function isValidDate(dateString) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(dateString));
+  if (!match) return false;
+  const [, year, month, day] = match;
+  const date = new Date(`${year}-${month}-${day}T00:00:00Z`);
+  if (Number.isNaN(date.getTime())) return false;
+  return date.toISOString().startsWith(`${year}-${month}-${day}`);
+}
+
+export function addDays(date, n) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(date));
+  if (!match) throw new Error('Invalid date format');
+  const d = new Date(`${match[1]}-${match[2]}-${match[3]}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  const year = String(d.getUTCFullYear()).padStart(4, '0');
+  const month = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+export function daysBetween(a, b) {
+  const matchA = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(a));
+  const matchB = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(b));
+  if (!matchA || !matchB) throw new Error('Invalid date format');
+  const dateA = new Date(`${matchA[1]}-${matchA[2]}-${matchA[3]}T00:00:00Z`);
+  const dateB = new Date(`${matchB[1]}-${matchB[2]}-${matchB[3]}T00:00:00Z`);
+  return Math.floor((dateB.getTime() - dateA.getTime()) / (1000 * 60 * 60 * 24));
+}
