+test('balanceDue returns total for issued invoice with no payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    status: 'issued',
+    number: 'INV-2025-0001',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 5,
+        unitPrice: 8500,
+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+  };
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 51425);
+});
+
