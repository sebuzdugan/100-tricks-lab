+test('statement returns empty for customer with no invoices', () => {
+  const r = statement('C-001', [], '2025-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.deepEqual(r.value.invoices, []);
+  assert.equal(r.value.totalDue, 0);
+});
