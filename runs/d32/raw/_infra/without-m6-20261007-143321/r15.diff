+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    dueDate: '2025-11-06',
+    status: 'issued',
+    number: 'INV-2025-0001',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 5,
+        unitPrice: 8500,
+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+  };
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Partial refund', date: '2025-10-15' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2025-0001');
+  assert.equal(r.value.invoiceNumber, 'INV-2025-0001');
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Partial refund');
+  assert.equal(r.value.date, '2025-10-15');
+});
+
