diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..561435d
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,54 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} input
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issueDate is a valid date in YYYY-MM-DD format
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) return fail('DATE_INVALID');
+  const date = new Date(issueDate + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return fail('DATE_INVALID');
+  // Verify the date round-trips correctly (e.g., 2026-02-30 would be normalized to 2026-03-02)
+  const [year, month, day] = issueDate.split('-').map(Number);
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() + 1 !== month || date.getUTCDate() !== day) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines array is not empty
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Expand lines with product data
+  const expandedLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Get product from catalogue
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    expandedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: expandedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..082df9a
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,110 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with expanded line items', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 2);
+  assert.deepEqual(r.value.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 10,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for an unknown customer', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for invalid date formats', () => {
+  const testCases = ['2026-10-7', '2026-1-07', '26-10-07', '10-07-2026', 'not-a-date', ''];
+  for (const date of testCases) {
+    assert.deepEqual(createInvoice({
+      customerId: 'C-003',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }), { ok: false, error: 'DATE_INVALID' }, `for date "${date}"`);
+  }
+});
+
+test('createInvoice reports DATE_INVALID for impossible dates', () => {
+  const testCases = ['2026-02-30', '2026-13-01', '2026-00-01', '2026-06-31'];
+  for (const date of testCases) {
+    assert.deepEqual(createInvoice({
+      customerId: 'C-003',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }), { ok: false, error: 'DATE_INVALID' }, `for date "${date}"`);
+  }
+});
+
+test('createInvoice reports NO_LINES for an empty lines array', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [],
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports NO_LINES for non-array lines', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: null,
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer quantities', () => {
+  const testCases = [0, -1, 1.5, 'abc', null, undefined];
+  for (const qty of testCases) {
+    assert.deepEqual(createInvoice({
+      customerId: 'C-003',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    }), { ok: false, error: 'QTY_INVALID' }, `for qty ${qty}`);
+  }
+});
+
+test('createInvoice reports UNKNOWN_SKU for a SKU that is not in the catalogue', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'NOPE', qty: 1 }],
+  }), { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate the input lines array', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+  createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines,
+  });
+  assert.deepEqual(lines, [{ sku: 'DES-HOUR', qty: 1 }]);
+});
+
+test('createInvoice stops at the first error', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'NOPE', qty: 0 }],
+  });
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
