diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..8b39096
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates the first number for a year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments for existing numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber restarts counter for a new year', () => {
+  const existing = ['INV-2025-0999', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2027-01-01');
+  assert.equal(number, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0100', 'INV-2026-0050', 'INV-2027-0200'];
+  const number = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(number, 'INV-2026-0051');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber handles gaps in numbering', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
