+++ b/src/numbering.js
@@ -0,0 +1,25 @@
+/**
+ * Calculate the next invoice number for a given issue date.
+ * Format: INV-<year>-<counter>, where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {string[]} existingNumbers Array of invoice numbers already used (in any order)
+ * @param {string} issueDate Date in YYYY-MM-DD format
+ * @returns {string} The next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Find the highest counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counter = Number(num.slice(prefix.length));
+      if (!isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
