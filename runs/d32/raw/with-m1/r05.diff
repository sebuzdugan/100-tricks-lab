+++ b/test/render.test.js
@@ -0,0 +1,100 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText displays DRAFT for unsent invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.startsWith('DRAFT\n'));
+});
+
+test('renderInvoiceText displays invoice number when issued', () => {
+  const r1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r1.ok, true);
+  const r2 = issueInvoice(r1.value, []);
+  assert.equal(r2.ok, true);
+  const text = renderInvoiceText(r2.value);
+  assert.ok(text.startsWith('INV-2026-0001\n'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText displays one line per invoice line', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // number, name, 2 lines, total
+  assert.equal(lines[2], '10 x Design work (hour) @ €85.00 €850.00');
+  assert.equal(lines[3], '5 x Development (hour) @ €95.00 €475.00');
+});
+
+test('renderInvoiceText formats amounts in euros', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 100 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // ICON-SET is 980 cents, 100 * 980 = 98000 cents = €980.00
+  assert.equal(lines[2], '100 x Icon set (24 icons) @ €9.80 €980.00');
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // 10 * 8500 + 5 * 9500 = 85000 + 47500 = 132500 cents = €1,325.00
+  assert.equal(lines[4], 'Total: €1,325.00');
+});
+
+test('renderInvoiceText with single line invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1000 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4); // number, name, 1 line, total
+  assert.ok(lines[2].includes('Sticker sheet'));
+  assert.equal(lines[3], 'Total: €500.00');
+});
