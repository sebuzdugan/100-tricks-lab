@@ -0,0 +1,34 @@
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to a customer.
+ * @param {Object} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  const number = invoice.number || 'DRAFT';
+  lines.push(number);
+
+  // Customer name
+  lines.push(invoice.customerName);
+
+  // Line items
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const qtyStr = String(line.qty);
+    const nameStr = line.name;
+    const priceStr = formatEuros(line.unitPrice);
+    const totalStr = formatEuros(total);
+    lines.push(`${qtyStr} x ${nameStr} @ ${priceStr} ${totalStr}`);
+  }
+
+  // Total line
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
