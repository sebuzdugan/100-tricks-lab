+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+  // Verify the date round-trips correctly (e.g., 2026-02-30 would be normalized to 2026-03-02)
+  const [year, month, day] = text.split('-').map(Number);
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() + 1 !== month || date.getUTCDate() !== day) {
+    return false;
+  }
+  return true;
+}
+
+/**
+ * Add n days to a date string (YYYY-MM-DD), returning the result as YYYY-MM-DD.
+ * Date arithmetic is performed in UTC.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add
+ * @returns {string} - Result in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a).
+ * Date arithmetic is performed in UTC.
+ * @param {string} a - Start date in YYYY-MM-DD format
+ * @param {string} b - End date in YYYY-MM-DD format
+ * @returns {number} - Number of days (b - a), can be negative
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (24 * 60 * 60 * 1000));
+}
