+/**
+ * Calculate the due date based on payment terms.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} - Due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-').map(Number);
+    const lastDayOfMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
+    return `${year}-${String(month).padStart(2, '0')}-${String(lastDayOfMonth).padStart(2, '0')}`;
+  }
+}
 
