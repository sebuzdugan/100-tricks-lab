+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+// Helper to create an issued invoice
+function createIssuedInvoice(customerId, issueDate) {
+  const draftResult = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issuedResult = issueInvoice(draftResult.value, []);
+  return issuedResult.value;
+}
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('C-999', [], '2026-10-07');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement returns empty invoices list for customer with no invoices', () => {
+  const result = statement('C-002', [], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes a single issued invoice', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const result = statement('C-002', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice.number);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+  const invoiceTotalsResult = invoiceTotals(invoice);
+  assert.equal(result.value.invoices[0].total, invoiceTotalsResult.total);
+  assert.equal(result.value.invoices[0].due, result.value.invoices[0].total);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const result = statement('C-002', [draft.value], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const totals = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(paymentResult.ok, true);
+  const paidInvoice = paymentResult.value;
+  const result = statement('C-002', [paidInvoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement includes partially paid invoices', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const partialInvoice = recordPayment(invoice, { amount: 50000, date: '2026-10-08' }).value;
+  const result = statement('C-002', [partialInvoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert(result.value.invoices[0].due > 0);
+  assert(result.value.invoices[0].due < result.value.invoices[0].total);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const invoice1 = createIssuedInvoice('C-002', '2026-10-07');
+  const invoice2 = createIssuedInvoice('C-002', '2026-10-15');
+  const result = statement('C-002', [invoice1, invoice2], '2026-10-10');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement includes invoices on asOf date', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const result = statement('C-002', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement filters invoices by customer', () => {
+  const invoice1 = createIssuedInvoice('C-002', '2026-10-07');
+  const invoice2 = createIssuedInvoice('C-003', '2026-10-07');
+  const result = statement('C-002', [invoice1, invoice2], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice1.number);
+});
+
+test('statement normalizes customer ID', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const result = statement('c-002', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement sorts invoices by issueDate ascending', () => {
+  const invoice1 = createIssuedInvoice('C-002', '2026-10-15');
+  const invoice2 = createIssuedInvoice('C-002', '2026-10-07');
+  const invoice3 = createIssuedInvoice('C-002', '2026-10-10');
+  const result = statement('C-002', [invoice1, invoice2, invoice3], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-10');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const invoice1 = createIssuedInvoice('C-002', '2026-10-07');
+  const invoice2 = createIssuedInvoice('C-002', '2026-10-10');
+  const partialInvoice2 = recordPayment(invoice2, { amount: 50000, date: '2026-10-11' }).value;
+  const result = statement('C-002', [invoice1, partialInvoice2], '2026-10-10');
+  assert.equal(result.ok, true);
+  const expectedTotal = result.value.invoices[0].due + result.value.invoices[1].due;
+  assert.equal(result.value.totalDue, expectedTotal);
+});
+
+test('statement includes due field calculated from balanceDue', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const paymentResult = recordPayment(invoice, { amount: 30000, date: '2026-10-08' });
+  assert.equal(paymentResult.ok, true);
+  const partialInvoice = paymentResult.value;
+  const result = statement('C-002', [partialInvoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  const statementInvoice = result.value.invoices[0];
+  const expectedDue = balanceDue(partialInvoice);
+  assert.equal(statementInvoice.due, expectedDue);
+});
+
+test('statement includes dueDate from invoice', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const result = statement('C-002', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].dueDate, invoice.dueDate);
+});
+
+test('statement includes voucher in total', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const voucherResult = applyVoucher(draftResult.value, { code: 'SUMMER10', amount: 25000 });
+  assert.equal(voucherResult.ok, true);
+  const voucherInvoice = issueInvoice(voucherResult.value, []).value;
+  const result = statement('C-002', [voucherInvoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  const statementInvoice = result.value.invoices[0];
+  const expectedTotal = invoiceTotals(voucherInvoice).total;
+  assert.equal(statementInvoice.total, expectedTotal);
+});
+
+test('statement handles multiple invoices with different statuses', () => {
+  const invoice1 = createIssuedInvoice('C-002', '2026-10-07');
+  const invoice2 = createIssuedInvoice('C-002', '2026-10-10');
+  const invoice3 = createIssuedInvoice('C-002', '2026-10-15');
+  const totals3 = invoiceTotals(invoice3);
+  const paymentResult = recordPayment(invoice3, { amount: totals3.total, date: '2026-10-16' });
+  assert.equal(paymentResult.ok, true);
+  const paidInvoice3 = paymentResult.value;
+  const result = statement('C-002', [invoice1, invoice2, paidInvoice3], '2026-10-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-10');
+});
