+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the next credit note number for a given issue date.
+ * Format: CN-<year>-<counter>, where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {string[]} existingNumbers Array of all numbers (invoice and credit note) already used
+ * @param {string} issueDate Date in YYYY-MM-DD format
+ * @returns {string} The next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `CN-${year}-`;
+
+  // Find the highest counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counter = Number(num.slice(prefix.length));
+      if (!isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {Object} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {string[]} existingNumbers Array of all numbers (invoice and credit note) already used
+ * @returns {{ ok: true, value: Object } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice status is 'issued', 'partially_paid', or 'paid'
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check that credit amount does not exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
