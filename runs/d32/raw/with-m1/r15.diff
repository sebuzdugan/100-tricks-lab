diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..f90213c
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,174 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create an issued invoice
+function createIssuedInvoice(customerId, issueDate) {
+  const draftResult = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issuedResult = issueInvoice(draftResult.value, []);
+  return issuedResult.value;
+}
+
+test('nextCreditNoteNumber generates the first number for a year', () => {
+  const num = nextCreditNoteNumber([], '2026-10-07');
+  assert.equal(num, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber increments for existing numbers', () => {
+  const existing = ['CN-2026-0001', 'CN-2026-0003'];
+  const num = nextCreditNoteNumber(existing, '2026-10-07');
+  assert.equal(num, 'CN-2026-0004');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const num = nextCreditNoteNumber(existing, '2026-10-07');
+  assert.equal(num, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `CN-2026-${String(i + 1).padStart(4, '0')}`);
+  const num = nextCreditNoteNumber(existing, '2026-10-07');
+  assert.equal(num, 'CN-2026-10000');
+});
+
+test('nextCreditNoteNumber restarts counter for a new year', () => {
+  const existing = ['CN-2025-9999', 'CN-2026-0001'];
+  const num = nextCreditNoteNumber(existing, '2027-10-07');
+  assert.equal(num, 'CN-2027-0001');
+});
+
+test('nextCreditNoteNumber ignores numbers from other years', () => {
+  const existing = ['CN-2025-0001', 'CN-2025-0002', 'CN-2026-0001'];
+  const num = nextCreditNoteNumber(existing, '2027-10-07');
+  assert.equal(num, 'CN-2027-0001');
+});
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: 50000, reason: 'Defective item', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Defective item');
+  assert.equal(result.value.date, '2026-10-08');
+});
+
+test('createCreditNote creates a credit note for a partially paid invoice', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const totals = invoiceTotals(invoice);
+  const partialInvoice = recordPayment(invoice, { amount: 50000, date: '2026-10-08' }).value;
+  const result = createCreditNote(partialInvoice, { amount: 30000, reason: 'Partial refund', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+});
+
+test('createCreditNote creates a credit note for a paid invoice', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const totals = invoiceTotals(invoice);
+  const paidInvoice = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' }).value;
+  const result = createCreditNote(paidInvoice, { amount: 20000, reason: 'Returned goods', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+});
+
+test('createCreditNote reports NOT_ISSUED for draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const result = createCreditNote(draft.value, { amount: 50000, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote reports AMOUNT_INVALID for non-integer amounts', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const testCases = [0, -100, 1.5, 'abc', null, undefined];
+  for (const amount of testCases) {
+    const result = createCreditNote(invoice, { amount, reason: 'Test', date: '2026-10-08' }, []);
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID', `for amount "${amount}"`);
+  }
+});
+
+test('createCreditNote reports CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: totals.total + 1, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote allows credit up to invoice total', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote uses date parameter for year in number', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const result = createCreditNote(invoice, { amount: 10000, reason: 'Test', date: '2027-01-15' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote with existing invoice and credit note numbers', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const existing = ['INV-2026-0001', 'CN-2026-0001', 'CN-2026-0003'];
+  const result = createCreditNote(invoice, { amount: 10000, reason: 'Test', date: '2026-10-08' }, existing);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0004');
+});
+
+test('createCreditNote with voucher applied', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const voucherResult = applyVoucher(draftResult.value, { code: 'SUMMER10', amount: 25000 });
+  const issuedResult = issueInvoice(voucherResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: 50000, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert(result.value.amount <= totals.total);
+});
+
+test('createCreditNote returns all required fields', () => {
+  const invoice = createIssuedInvoice('C-002', '2026-10-07');
+  const result = createCreditNote(invoice, { amount: 10000, reason: 'Broken item', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  const creditNote = result.value;
+  assert(creditNote.number);
+  assert(creditNote.invoiceNumber);
+  assert(creditNote.customerId);
+  assert(creditNote.amount);
+  assert(creditNote.reason);
+  assert(creditNote.date);
+});
+
+test('createCreditNote with multiple credit notes for same date', () => {
+  const invoice1 = createIssuedInvoice('C-002', '2026-10-07');
+  const invoice2 = createIssuedInvoice('C-003', '2026-10-07');
+  const result1 = createCreditNote(invoice1, { amount: 10000, reason: 'Test 1', date: '2026-10-08' }, []);
+  const existing = [result1.value.number];
+  const result2 = createCreditNote(invoice2, { amount: 20000, reason: 'Test 2', date: '2026-10-08' }, existing);
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2026-0002');
+});
