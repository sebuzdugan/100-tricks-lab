+      number: 'INV-2026-0001',
+      customerId: 'C-002',
+      status: 'partially_paid',
+      dueDate: '2026-09-15',
+      lines: [{ qty: 1, unitPrice: 50000, discountPercent: 0, vatRate: 0 }],
+      payments: [{ amount: 20000, date: '2026-10-01' }],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].due, 30000);
+});
