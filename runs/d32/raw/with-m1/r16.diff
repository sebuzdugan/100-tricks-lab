+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns overdue issued invoices', () => {
+  const invoices = [
+    {
+      number: 'INV-2026-0001',
+      customerId: 'C-001',
+      status: 'issued',
+      dueDate: '2026-09-01',
+      lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-09-01');
+  assert.equal(result[0].daysOverdue, 36);
+  assert.equal(result[0].due, 10000);
+});
+
+test('overdueInvoices returns overdue partially_paid invoices', () => {
