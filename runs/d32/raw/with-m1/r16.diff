+import { daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Get overdue invoices as of a given date.
+ * Returns invoices with status 'issued' or 'partially_paid' whose dueDate is before asOf,
+ * sorted by most overdue first.
+ * @param {Array} invoices - Array of invoice objects
+ * @param {string} asOf - Reference date in YYYY-MM-DD format
+ * @returns {Array} - Array of { number, customerId, dueDate, daysOverdue, due }
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = [];
+
+  for (const invoice of invoices) {
+    if ((invoice.status === 'issued' || invoice.status === 'partially_paid') &&
+        invoice.dueDate < asOf) {
+      const daysOverdue = daysBetween(invoice.dueDate, asOf);
+      overdue.push({
+        number: invoice.number,
+        customerId: invoice.customerId,
+        dueDate: invoice.dueDate,
+        daysOverdue,
+        due: balanceDue(invoice),
+      });
+    }
+  }
+
+  overdue.sort((a, b) => b.daysOverdue - a.daysOverdue);
+  return overdue;
+}
