   overdue.sort((a, b) => b.daysOverdue - a.daysOverdue);
   return overdue;
 }
+
+/**
+ * Get a VAT summary over invoices with status 'issued', 'partially_paid', or 'paid'.
+ * Returns one entry per VAT rate with aggregated base and VAT amounts.
+ * Sorted by rate from high to low.
+ * @param {Array} invoices - Array of invoice objects
+ * @returns {Array} - Array of { rate, base, vat }
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid' || invoice.status === 'paid') {
+      for (const line of invoice.lines) {
+        const rate = line.vatRate ?? 0;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVat(line);
+
+        if (!vatMap.has(rate)) {
+          vatMap.set(rate, { rate, base: 0, vat: 0 });
+        }
+        const entry = vatMap.get(rate);
+        entry.base += base;
+        entry.vat += vat;
+      }
+    }
+  }
+
+  const result = Array.from(vatMap.values());
+  result.sort((a, b) => b.rate - a.rate);
+  return result;
+}
