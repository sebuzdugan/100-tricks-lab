+      { qty: 5, unitPrice: 8000, discountPercent: 10, vatRate: 9 },
+    ],
+    payments: [{ amount: 50000, date: '2026-09-01' }],
+  };
+  const fee = lateFee(invoice, '2026-10-07');
+  const daysOverdue = 61;
+
+  // Calculate expected balance due
+  const line1Total = 10 * 10000;
+  const line1Discount = Math.round(line1Total * 20 / 100);
+  const line1Base = line1Total - line1Discount;
+  const line1Vat = Math.round(line1Base * 21 / 100);
+
+  const line2Total = 5 * 8000;
