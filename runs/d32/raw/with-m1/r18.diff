+  const line2Base = line2Total - line2Discount;
+  const line2Vat = Math.round(line2Base * 9 / 100);
+
+  const totalDue = line1Total - line1Discount + line1Vat + line2Total - line2Discount + line2Vat;
+  const balanceDue = totalDue - 50000;
+
+  const expectedFee = Math.round(balanceDue * daysOverdue * 0.0004);
+  assert.equal(fee, expectedFee);
+});
