+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function formatEuro(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices to CSV format.
+ * Returns a string with header and one line per invoice.
+ * Amounts are in euros with 2 decimals and a dot, no currency sign or thousands separator.
+ * @param {Array} invoices - Array of invoice objects
+ * @returns {string} - CSV string with lines ending in \n
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number,
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ];
+
+    const escapedFields = fields.map(escapeCsvField);
+    lines.push(escapedFields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
