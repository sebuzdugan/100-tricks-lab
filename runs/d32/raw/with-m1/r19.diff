+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns header line', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv ends with newline', () => {
+  const result = exportCsv([]);
+  assert.equal(result[result.length - 1], '\n');
+});
+
+test('exportCsv with single invoice', () => {
+  const invoices = [
+    {
+      number: 'INV-2026-0001',
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      dueDate: '2026-10-21',
+      status: 'issued',
+      lines: [
+        { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 },
+      ],
+    },
+  ];
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.match(lines[1], /INV-2026-0001/);
+  assert.match(lines[1], /Northwind Studio/);
+  assert.match(lines[1], /100.00/);
+});
+
