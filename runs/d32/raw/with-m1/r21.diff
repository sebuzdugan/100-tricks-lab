+
+test('mergeCustomers merges two customers and reassigns invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com' },
+    { id: 'C-003', name: 'Charlie', email: 'charlie@example.com' },
+  ];
+  const invoices = [
+    { id: 'INV-001', customerId: 'C-001' },
+    { id: 'INV-002', customerId: 'C-001' },
+    { id: 'INV-003', customerId: 'C-002' },
+  ];
+
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, 2);
+  assert.deepEqual(
+    r.value.customers.map((c) => c.id),
+    ['C-002', 'C-003']
+  );
+  assert.equal(r.value.invoices[0].customerId, 'C-002');
+  assert.equal(r.value.invoices[1].customerId, 'C-002');
+  assert.equal(r.value.invoices[2].customerId, 'C-002');
+});
+
