diff --git a/src/customers.js b/src/customers.js
index 6905904..37b0990 100644
--- a/src/customers.js
+++ b/src/customers.js
@@ -43,3 +43,30 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge fromId customer into intoId customer.
+ * All invoices belonging to fromId are reassigned to intoId, and fromId is removed.
+ * @param {Array} customers
+ * @param {Array} invoices
+ * @param {string} fromId
+ * @param {string} intoId
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  if (normalizedFromId === normalizedIntoId) return fail('SAME_CUSTOMER');
+
+  const fromExists = customers.some((c) => c.id === normalizedFromId);
+  const intoExists = customers.some((c) => c.id === normalizedIntoId);
+
+  if (!fromExists || !intoExists) return fail('CUSTOMER_NOT_FOUND');
+
+  const mergedCustomers = customers.filter((c) => c.id !== normalizedFromId);
+  const mergedInvoices = invoices.map((inv) =>
+    inv.customerId === normalizedFromId ? { ...inv, customerId: normalizedIntoId } : { ...inv }
+  );
+
+  return ok({ customers: mergedCustomers, invoices: mergedInvoices });
+}
