diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..55028eb
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,52 @@
+/**
+ * Calculate the total for a single line (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return Math.max(0, line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount for a single line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} Discount in cents
+ */
+export function lineDiscount(line) {
+  const total = lineTotal(line);
+  const discountPercent = line.discountPercent ?? 0;
+  return Math.max(0, Math.round(total * discountPercent / 100));
+}
+
+/**
+ * Calculate the VAT for a single line (on amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }} line
+ * @returns {number} VAT in cents
+ */
+export function lineVat(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = Math.max(0, total - discount);
+  const vatRate = line.vatRate ?? 0;
+  return Math.max(0, Math.round(amountAfterDiscount * vatRate / 100));
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} Amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..78e5f32
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,185 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal returns qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 8500 }), 8500);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 8500 }), 85000);
+  assert.equal(lineTotal({ qty: 2, unitPrice: 50 }), 100);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 1 }), 100);
+});
+
+test('lineTotal returns 0 for zero or negative totals', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 100 }), 0);
+  assert.equal(lineTotal({ qty: -1, unitPrice: 100 }), 0);
+});
+
+test('lineDiscount calculates discount correctly', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 100, discountPercent: 10 }), 1000);
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 8500, discountPercent: 10 }), 8500);
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 8500, discountPercent: 12.5 }), 10625);
+  assert.equal(lineDiscount({ qty: 1, unitPrice: 1000, discountPercent: 50 }), 500);
+});
+
+test('lineDiscount returns 0 when discountPercent is 0', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 100, discountPercent: 0 }), 0);
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 100 }), 0);
+});
+
+test('lineDiscount returns 0 for negative totals', () => {
+  assert.equal(lineDiscount({ qty: -1, unitPrice: 100, discountPercent: 10 }), 0);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  assert.equal(lineVat({ qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 21 }), 2100);
+  assert.equal(lineVat({ qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 21 }), 1890);
+  assert.equal(lineVat({ qty: 100, unitPrice: 100, discountPercent: 50, vatRate: 21 }), 1050);
+});
+
+test('lineVat handles different VAT rates', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 0 };
+  assert.equal(lineVat({ ...line, vatRate: 0 }), 0);
+  assert.equal(lineVat({ ...line, vatRate: 9 }), 9000);
+  assert.equal(lineVat({ ...line, vatRate: 21 }), 21000);
+});
+
+test('lineVat returns 0 when vatRate is not provided', () => {
+  assert.equal(lineVat({ qty: 100, unitPrice: 100, discountPercent: 0 }), 0);
+});
+
+test('lineVat returns 0 for negative amounts after discount', () => {
+  assert.equal(lineVat({ qty: -1, unitPrice: 100, discountPercent: 10, vatRate: 21 }), 0);
+});
+
+test('invoiceTotals calculates subtotal, discount, VAT, and total', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000 + 47500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, Math.round(85000 * 21 / 100) + Math.round(47500 * 21 / 100));
+  assert.equal(totals.total, 85000 + 47500 + totals.vat);
+});
+
+test('invoiceTotals handles a single line', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 12345, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 12345);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, Math.round(12345 * 21 / 100));
+  assert.equal(totals.total, 12345 + totals.vat);
+});
+
+test('invoiceTotals returns zero for empty invoice', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals calculates discount correctly with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10 },
+      { qty: 5, unitPrice: 9500, discountPercent: 20 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000 + 47500);
+  assert.equal(totals.discount, 8500 + 9500);
+  assert.equal(totals.total, 85000 + 47500 - 8500 - 9500);
+});
+
+test('invoiceTotals total is clamped at 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 100 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 85000);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals total greater than discount is calculated correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 50, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 42500);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 42500);
+});
+
+test('invoiceTotals with multiple lines and different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+      { qty: 50, unitPrice: 1000, discountPercent: 0, vatRate: 9 },
+      { qty: 25, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000 + 50000 + 25000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 21000 + 4500 + 0);
+  assert.equal(totals.total, 175000 + 25500);
+});
+
+test('invoiceTotals VAT with discount and VAT on same line', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  const amountAfterDiscount = 100000 - 10000;
+  const expectedVat = Math.round(amountAfterDiscount * 21 / 100);
+  assert.equal(totals.vat, expectedVat);
+  assert.equal(totals.total, 100000 - 10000 + expectedVat);
+});
+
+test('invoiceTotals includes voucher with zero value by default', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with voucher applied', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'PROMO', amount: 25000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 25000);
+  assert.equal(totals.subtotal, 85000 + 47500);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat - 25000);
+});
+
+test('invoiceTotals voucher clamped total does not go below zero', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'HUGE', amount: 1000000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
