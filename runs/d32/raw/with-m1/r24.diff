+/**
+ * Generate a dashboard with key invoice metrics.
+ * @param {Array} invoices - Array of invoice objects
+ * @param {string} asOf - Reference date in YYYY-MM-DD format
+ * @returns {Object} - Dashboard with counts, outstanding, overdue, and topCustomers
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDues = new Map();
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] ?? 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDues.has(invoice.customerId)) {
+        customerDues.set(invoice.customerId, 0);
+      }
+      customerDues.set(invoice.customerId, customerDues.get(invoice.customerId) + due);
+    }
+  }
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue.reduce((sum, inv) => sum + inv.due, 0);
+
+  const topCustomers = Array.from(customerDues.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
