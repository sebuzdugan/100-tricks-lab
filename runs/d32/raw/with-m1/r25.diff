+import { lineTotal, lineDiscount, invoiceTotals } from './invoices.js';
+import { totalPaid } from './payments.js';
 
 /**
  * Render an invoice as plain text for display to a customer.
@@ -24,14 +25,33 @@ export function renderInvoiceText(invoice) {
     const priceStr = formatEuros(line.unitPrice);
     const totalStr = formatEuros(total);
     lines.push(`${qtyStr} x ${nameStr} @ ${priceStr} ${totalStr}`);
+
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      lines.push(`  Discount: -${formatEuros(discount)}`);
+    }
   }
 
   // VAT and total lines
   const totals = invoiceTotals(invoice);
+
+  if (invoice.voucher) {
+    lines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  const paid = totalPaid(invoice);
+  if (paid > 0) {
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return lines.join('\n');
 }
