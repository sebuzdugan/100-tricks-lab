diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..d546ca8
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,55 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 when no existing numbers', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const num = nextInvoiceNumber(['INV-2026-0001'], '2026-10-07');
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber finds max counter and increments', () => {
+  const num = nextInvoiceNumber(
+    ['INV-2026-0001', 'INV-2026-0005', 'INV-2026-0003'],
+    '2026-10-07'
+  );
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const num = nextInvoiceNumber(['INV-2026-0099'], '2026-10-07');
+  assert.equal(num, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const num = nextInvoiceNumber(
+    ['INV-2025-0100', 'INV-2026-0001', 'INV-2027-0050'],
+    '2026-10-07'
+  );
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber starts fresh for new year', () => {
+  const num2026 = nextInvoiceNumber(['INV-2025-0050', 'INV-2025-0099'], '2025-12-31');
+  assert.equal(num2026, 'INV-2025-0100');
+
+  const num2027 = nextInvoiceNumber(['INV-2025-0050', 'INV-2025-0099'], '2027-01-01');
+  assert.equal(num2027, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber with large counter', () => {
+  const num = nextInvoiceNumber(['INV-2026-9999'], '2026-10-07');
+  assert.equal(num, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const num = nextInvoiceNumber(
+    ['INV-2026-ABC', 'INV-2026-', 'NOPE', 'INV-2026-0001'],
+    '2026-10-07'
+  );
+  assert.equal(num, 'INV-2026-0002');
+});
