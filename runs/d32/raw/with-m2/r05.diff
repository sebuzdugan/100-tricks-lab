+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  lines.push(invoice.number || 'DRAFT');
+
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  if (customerResult.ok) {
+    lines.push(customerResult.value.name);
+  }
+
+  // Invoice line items
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const unitPriceStr = formatEuros(line.unitPrice);
+    const lineTotalStr = formatEuros(total);
+    lines.push(`  ${line.qty}x ${line.name} @ ${unitPriceStr} = ${lineTotalStr}`);
+  }
+
+  // Total line
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..8a81412
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,129 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = issueInvoice(r1.value, ['INV-2026-0050']);
+  const text = renderInvoiceText(r2.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0051');
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText formats line items correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '  5x Design work (hour) @ €85.00 = €425.00');
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // DRAFT + customer + 2 line items + total
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.equal(lines[2], '  5x Design work (hour) @ €85.00 = €425.00');
+  assert.equal(lines[3], '  3x Development (hour) @ €95.00 = €285.00');
+  assert.equal(lines[4], 'Total: €710.00');
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 10 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // ICON-SET: 10 * 980 = 9800
+  // STICKER: 100 * 50 = 5000
+  // Total: 14800
+  assert.equal(lines[4], 'Total: €148.00');
+});
+
+test('renderInvoiceText with VAT-exempt products', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'WORKSHOP-DAY', qty: 2 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '  2x Brand workshop (day, VAT exempt) @ €600.00 = €1,200.00');
+  assert.equal(lines[3], 'Total: €1,200.00');
+});
+
+test('renderInvoiceText with issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-010',
+    issueDate: '2025-12-31',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  const r2 = issueInvoice(r1.value, ['INV-2025-0001']);
+  const text = renderInvoiceText(r2.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2025-0002');
+  assert.equal(lines[1], 'Tidewater Museum');
+  assert.equal(lines[2], '  1x Logo package @ €1,200.00 = €1,200.00');
+  assert.equal(lines[3], 'Total: €1,200.00');
+});
+
+test('renderInvoiceText with single low-price item', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 5 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // STICKER: 5 * 50 = 250 cents = €2.50
+  assert.equal(lines[2], '  5x Sticker sheet @ €0.50 = €2.50');
+  assert.equal(lines[3], 'Total: €2.50');
+});
