+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const expected = 8500 * 5 / 100;
+  assert.equal(totals.subtotal, 8500);
+  assert.equal(totals.discount, expected);
+  assert.equal(totals.total, 8500 - expected);
+});
+
+test('invoiceTotals with silver tier customer default discount', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal, 8500);
+  assert.equal(totals.discount, 212);
+  assert.equal(totals.total, 8500 - 212);
+});
+
+test('invoiceTotals with standard tier customer no discount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal, 8500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 8500);
+});
