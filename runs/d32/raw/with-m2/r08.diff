--- a/src/invoices.js
+++ b/src/invoices.js
@@ -103,23 +103,41 @@ export function lineDiscount(line) {
 }
 
 /**
- * Calculate subtotal, discount and total for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }}
+ * Calculate the VAT amount for a line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number} VAT in cents
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = Math.max(0, total - discount);
+  const vatRate = line.vatRate ?? 0;
+  const vatAmount = roundCents(amountAfterDiscount * vatRate / 100);
+  return Math.max(0, vatAmount);
+}
+
+/**
+ * Calculate subtotal, discount, VAT and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   let subtotal = 0;
   let discount = 0;
+  let vat = 0;
   for (const line of invoice.lines) {
     subtotal += lineTotal(line);
     discount += lineDiscount(line);
+    vat += lineVAT(line);
   }
   subtotal = roundCents(subtotal);
   discount = roundCents(discount);
-  const total = Math.max(0, roundCents(subtotal - discount));
+  vat = roundCents(vat);
+  const total = Math.max(0, roundCents(subtotal - discount + vat));
   return {
     subtotal,
     discount,
+    vat,
     total,
   };
 }
