+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!m) return false;
+  const year = Number(m[1]);
+  const month = Number(m[2]);
+  const day = Number(m[3]);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date string, in UTC.
+ * @param {string} date - YYYY-MM-DD format
+ * @param {number} n - number of days to add
+ * @returns {string} - YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
+  if (!m) throw new Error('Invalid date format');
+  const year = Number(m[1]);
+  const month = Number(m[2]);
+  const day = Number(m[3]);
+  const d = new Date(Date.UTC(year, month - 1, day));
+  d.setUTCDate(d.getUTCDate() + n);
+  const resultYear = d.getUTCFullYear();
+  const resultMonth = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const resultDay = String(d.getUTCDate()).padStart(2, '0');
+  return `${resultYear}-${resultMonth}-${resultDay}`;
+}
+
+/**
+ * Calculate the number of days between two dates (b - a), in whole days, using UTC.
+ * @param {string} a - YYYY-MM-DD format (start date)
+ * @param {string} b - YYYY-MM-DD format (end date)
+ * @returns {number} - number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const m1 = /^(\d{4})-(\d{2})-(\d{2})$/.exec(a);
+  const m2 = /^(\d{4})-(\d{2})-(\d{2})$/.exec(b);
+  if (!m1 || !m2) throw new Error('Invalid date format');
+  const year1 = Number(m1[1]);
+  const month1 = Number(m1[2]);
+  const day1 = Number(m1[3]);
+  const year2 = Number(m2[1]);
+  const month2 = Number(m2[2]);
+  const day2 = Number(m2[3]);
+  const d1 = new Date(Date.UTC(year1, month1 - 1, day1));
+  const d2 = new Date(Date.UTC(year2, month2 - 1, day2));
+  const diffMs = d2.getTime() - d1.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
