+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate validates correct date format', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+});
+
+test('isValidDate rejects invalid date format', () => {
+  assert.equal(isValidDate('10/07/2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('26-10-07'), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year February 29', () => {
+  assert.equal(isValidDate('2026-02-29'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(12345), false);
+  assert.equal(isValidDate({}), false);
+});
+
+test('isValidDate rejects empty string', () => {
+  assert.equal(isValidDate(''), false);
+});
+
+test('addDays adds positive number of days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+});
+
+test('addDays handles month boundary', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-10-28', 5), '2026-11-02');
+});
+
+test('addDays handles year boundary', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2026-12-25', 7), '2027-01-01');
+});
+
+test('addDays handles negative number of days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+});
+
+test('addDays handles negative days across month boundary', () => {
+  assert.equal(addDays('2026-11-01', -1), '2026-10-31');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays with large number of days', () => {
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01');
+});
+
+test('daysBetween calculates days between same dates', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+});
+
+test('daysBetween across month boundary', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-10-28', '2026-11-02'), 5);
+});
+
+test('daysBetween across year boundary', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2026-12-25', '2027-01-01'), 7);
+});
+
+test('daysBetween with large difference', () => {
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween consistency with addDays', () => {
+  const start = '2026-10-07';
+  const end = addDays(start, 10);
+  assert.equal(daysBetween(start, end), 10);
+});
+
+test('daysBetween consistency with addDays negative', () => {
+  const start = '2026-10-07';
+  const end = addDays(start, -5);
+  assert.equal(daysBetween(start, end), -5);
+});
+
+test('addDays and daysBetween round trip', () => {
+  const start = '2026-06-15';
+  const days = 42;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+});
+
+test('isValidDate rejects string with wrong pattern', () => {
+  assert.equal(isValidDate('2026.10.07'), false);
+  assert.equal(isValidDate('2026 10 07'), false);
+  assert.equal(isValidDate('07-10-2026'), false);
+});
