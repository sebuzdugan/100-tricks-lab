+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, invoiceTotals, issueInvoice } from '../src/invoices.js';
+
+test('recordPayment adds payment to issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total - 5000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 1);
+  assert.equal(r3.value.payments[0].amount, totals.total - 5000);
+  assert.equal(r3.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment changes status to partially_paid', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total - 10000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'partially_paid');
+});
+
+test('recordPayment changes status to paid when fully paid', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'paid');
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = recordPayment(r1.value, { amount: 50000, date: '2026-10-08' });
+  assert.equal(r2.ok, false);
+  assert.equal(r2.error, 'NOT_ISSUED');
+});
+
+test('recordPayment rejects zero amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 0, date: '2026-10-08' });
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects negative amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: -5000, date: '2026-10-08' });
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects fractional amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 5000.5, date: '2026-10-08' });
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects overpayment', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total + 1, date: '2026-10-08' });
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'OVERPAYMENT');
+});
+
+test('recordPayment allows multiple payments', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: Math.floor(totals.total / 2), date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  const r4 = recordPayment(r3.value, { amount: totals.total - Math.floor(totals.total / 2), date: '2026-10-09' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.payments.length, 2);
+  assert.equal(r4.value.payments[0].amount, Math.floor(totals.total / 2));
+  assert.equal(r4.value.payments[1].amount, totals.total - Math.floor(totals.total / 2));
+});
+
+test('recordPayment does not mutate input invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const originalStatus = r2.value.status;
+  recordPayment(r2.value, { amount: 50000, date: '2026-10-08' });
+  assert.equal(r2.value.status, originalStatus);
+  assert.equal(r2.value.payments, undefined);
+});
+
+test('recordPayment accepts payment on partially_paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total - 20000, date: '2026-10-08' });
+  const r4 = recordPayment(r3.value, { amount: 20000, date: '2026-10-09' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.status, 'paid');
+});
+
+test('balanceDue on issued invoice equals total', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const balance = balanceDue(r2.value);
+  assert.equal(balance, totals.total);
+});
+
+test('balanceDue after partial payment', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const paymentAmount = Math.floor(totals.total / 2);
+  const r3 = recordPayment(r2.value, { amount: paymentAmount, date: '2026-10-08' });
+  const balance = balanceDue(r3.value);
+  assert.equal(balance, totals.total - paymentAmount);
+});
+
+test('balanceDue after full payment', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total, date: '2026-10-08' });
+  const balance = balanceDue(r3.value);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue with multiple payments', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const payment1 = Math.floor(totals.total / 3);
+  const payment2 = Math.floor(totals.total / 3);
+  const r3 = recordPayment(r2.value, { amount: payment1, date: '2026-10-08' });
+  const r4 = recordPayment(r3.value, { amount: payment2, date: '2026-10-09' });
+  const balance = balanceDue(r4.value);
+  assert.equal(balance, totals.total - payment1 - payment2);
+});
+
+test('balanceDue on invoice with no payments', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const balance = balanceDue(r2.value);
+  assert.equal(balance, totals.total);
+});
+
+test('recordPayment preserves other invoice properties', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total - 5000, date: '2026-10-08' });
+  assert.equal(r3.value.customerId, 'C-001');
+  assert.equal(r3.value.issueDate, '2026-10-07');
+  assert.equal(r3.value.number, 'INV-2026-0001');
+  assert.equal(r3.value.lines.length, 1);
+});
+
+test('balanceDue with no lines', () => {
+  const invoice = { lines: [] };
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 0);
+});
+
