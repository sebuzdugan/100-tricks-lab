+/**
+ * Get the last day of the month for a given date string.
+ * @param {string} date - YYYY-MM-DD format
+ * @returns {string} - YYYY-MM-DD format for the last day of that month
+ */
+export function lastDayOfMonth(date) {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
+  if (!m) throw new Error('Invalid date format');
+  const year = Number(m[1]);
+  const month = Number(m[2]);
+  const d = new Date(Date.UTC(year, month, 0));
+  const resultYear = d.getUTCFullYear();
+  const resultMonth = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const resultDay = String(d.getUTCDate()).padStart(2, '0');
+  return `${resultYear}-${resultMonth}-${resultDay}`;
+}
