+  assert.equal(lastDayOfMonth('2026-06-30'), '2026-06-30');
+});
+
+test('lastDayOfMonth works at year boundary', () => {
+  assert.equal(lastDayOfMonth('2026-12-01'), '2026-12-31');
+  assert.equal(lastDayOfMonth('2026-12-31'), '2026-12-31');
+});
+
+test('lastDayOfMonth works for leap year February', () => {
+  assert.equal(lastDayOfMonth('2024-02-01'), '2024-02-29');
+  assert.equal(lastDayOfMonth('2024-02-29'), '2024-02-29');
+});
