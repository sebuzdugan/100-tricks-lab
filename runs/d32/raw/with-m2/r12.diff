+/**
+ * Calculate due date based on terms and issue date.
+ * @param {string} issueDate - YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} - YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  switch (terms) {
+    case 'NET14':
+      return addDays(issueDate, 14);
+    case 'NET30':
+      return addDays(issueDate, 30);
+    case 'EOM':
+      return lastDayOfMonth(issueDate);
+    default:
+      return null;
+  }
