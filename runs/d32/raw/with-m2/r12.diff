+test('lastDayOfMonth returns last day of month', () => {
+  assert.equal(lastDayOfMonth('2026-01-15'), '2026-01-31');
+  assert.equal(lastDayOfMonth('2026-02-01'), '2026-02-28');
+  assert.equal(lastDayOfMonth('2024-02-01'), '2024-02-29');
+  assert.equal(lastDayOfMonth('2026-04-10'), '2026-04-30');
+  assert.equal(lastDayOfMonth('2026-10-07'), '2026-10-31');
+  assert.equal(lastDayOfMonth('2026-12-25'), '2026-12-31');
+});
+
+test('lastDayOfMonth works with different days of month', () => {
+  assert.equal(lastDayOfMonth('2026-06-01'), '2026-06-30');
