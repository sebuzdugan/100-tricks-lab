+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns customer invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const invoices = [r2.value];
+
+  const result = statement('C-001', invoices, '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement returns unknown customer error', () => {
+  const result = statement('C-999', [], '2026-10-07');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement filters by customer id', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, []);
+
+  const invoices = [r2.value, r4.value];
+  const result = statement('C-001', invoices, '2026-10-08');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement filters by status', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const draftInvoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 3, unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const invoices = [r2.value, draftInvoice];
+  const result = statement('C-001', invoices, '2026-10-08');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement filters by asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const invoices = [r2.value, r4.value];
+  const result = statement('C-001', invoices, '2026-10-07');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-05');
+});
+
+test('statement includes invoice details', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+
+  const invoices = [r2.value];
+  const result = statement('C-001', invoices, '2026-10-07');
+  const inv = result.value.invoices[0];
+  assert.equal(inv.number, 'INV-2026-0001');
+  assert.equal(inv.issueDate, '2026-10-07');
+  assert.equal(inv.dueDate, '2026-10-21');
+  assert.equal(inv.total, totals.total);
+  assert.equal(inv.due, totals.total);
+});
+
+test('statement calculates totalDue', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals1 = invoiceTotals(r2.value);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const totals2 = invoiceTotals(r4.value);
+
+  const invoices = [r2.value, r4.value];
+  const result = statement('C-001', invoices, '2026-10-08');
+  assert.equal(result.value.totalDue, totals1.total + totals2.total);
+});
+
+test('statement with partial payment', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const payment = Math.floor(totals.total / 2);
+  const r3 = recordPayment(r2.value, { amount: payment, date: '2026-10-08' });
+
+  const invoices = [r3.value];
+  const result = statement('C-001', invoices, '2026-10-08');
+  assert.equal(result.value.invoices[0].due, totals.total - payment);
+  assert.equal(result.value.totalDue, totals.total - payment);
+});
+
+test('statement excludes fully paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total, date: '2026-10-08' });
+
+  const invoices = [r3.value];
+  const result = statement('C-001', invoices, '2026-10-08');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement excludes paid invoices from totalDue', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals1 = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals1.total, date: '2026-10-08' });
+
+  const r4 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r5 = issueInvoice(r4.value, ['INV-2026-0001']);
+  const totals2 = invoiceTotals(r5.value);
+
+  const invoices = [r3.value, r5.value];
+  const result = statement('C-001', invoices, '2026-10-09');
+  assert.equal(result.value.totalDue, totals2.total);
+});
+
+test('statement with partially paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const paymentAmount = Math.floor(totals.total / 3);
+  const r3 = recordPayment(r2.value, { amount: paymentAmount, date: '2026-10-08' });
+
+  const invoices = [r3.value];
+  const result = statement('C-001', invoices, '2026-10-08');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, totals.total - paymentAmount);
+});
+
+test('statement sorts by issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const r5 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'COPY-HOUR', qty: 2 }],
+  });
+  const r6 = issueInvoice(r5.value, ['INV-2026-0001', 'INV-2026-0002']);
+
+  const invoices = [r2.value, r4.value, r6.value];
+  const result = statement('C-001', invoices, '2026-10-10');
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-08');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-10');
+});
+
+test('statement with empty invoices list', () => {
+  const result = statement('C-001', [], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement normalizes customer id', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const invoices = [r2.value];
+  const result = statement('c-001', invoices, '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement with multiple invoices and payments', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals1 = invoiceTotals(r2.value);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const totals2 = invoiceTotals(r4.value);
+  const r5 = recordPayment(r4.value, { amount: Math.floor(totals2.total / 2), date: '2026-10-09' });
+
+  const invoices = [r2.value, r5.value];
+  const result = statement('C-001', invoices, '2026-10-08');
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].due, totals1.total);
+  assert.equal(result.value.invoices[1].due, Math.ceil(totals2.total / 2));
+  assert.equal(result.value.totalDue, totals1.total + Math.ceil(totals2.total / 2));
+});
+
+test('statement with asOf before any invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const invoices = [r2.value];
+  const result = statement('C-001', invoices, '2026-10-06');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement with asOf matching issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+
+  const invoices = [r2.value];
+  const result = statement('C-001', invoices, '2026-10-07');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.totalDue, totals.total);
+});
