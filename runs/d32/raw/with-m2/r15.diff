+  assert.equal(cn1.value.number, 'CN-2026-0001');
+  assert.equal(cn2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote separates invoice and credit note counters', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, ['INV-2026-0099']);
+
+  const cn = createCreditNote(r2.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, ['INV-2026-0099']);
+  assert.equal(cn.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote handles year boundary', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-31',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const cn = createCreditNote(r2.value, { amount: 5000, reason: 'Discount', date: '2026-12-31' }, []);
+  assert.equal(cn.value.number, 'CN-2026-0001');
