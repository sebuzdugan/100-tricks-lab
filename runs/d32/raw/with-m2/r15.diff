+
+  const cn = createCreditNote(r2.value, { amount: 0, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.equal(cn.ok, false);
+  assert.equal(cn.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects negative amount', () => {
