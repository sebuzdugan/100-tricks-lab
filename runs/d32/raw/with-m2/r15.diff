+
+  const cn = createCreditNote(r1.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.equal(cn.ok, false);
+  assert.equal(cn.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
