+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+
+  const cn = createCreditNote(r2.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.number, 'CN-2026-0001');
+  assert.equal(cn.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(cn.value.customerId, 'C-001');
+  assert.equal(cn.value.amount, 5000);
+  assert.equal(cn.value.reason, 'Discount');
+  assert.equal(cn.value.date, '2026-10-08');
+});
+
+test('createCreditNote works with partially_paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: Math.floor(totals.total / 2), date: '2026-10-08' });
+
+  const cn = createCreditNote(r3.value, { amount: 5000, reason: 'Discount', date: '2026-10-09' }, []);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works with paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total, date: '2026-10-08' });
+
+  const cn = createCreditNote(r3.value, { amount: 5000, reason: 'Refund', date: '2026-10-09' }, []);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
