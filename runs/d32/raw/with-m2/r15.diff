+  assert.equal(cn.value.number.startsWith('CN-2026-'), true);
+});
+
+test('createCreditNote increments credit note counter', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const totals = invoiceTotals(r2.value);
+
+  const cn1 = createCreditNote(r2.value, { amount: 1000, reason: 'Discount', date: '2026-10-08' }, []);
