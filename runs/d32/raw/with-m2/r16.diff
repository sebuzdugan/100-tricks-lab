+++ b/src/reports.js
@@ -0,0 +1,15 @@
+import { invoiceTotals } from './invoices.js';
+
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter(inv => ['issued', 'partially_paid'].includes(inv.status))
+    .filter(inv => inv.dueDate < asOf)
+    .map(inv => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: Math.floor((new Date(asOf) - new Date(inv.dueDate)) / (1000 * 60 * 60 * 24)),
+      due: invoiceTotals(inv).total,
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
