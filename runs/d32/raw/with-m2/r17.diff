     .sort((a, b) => b.daysOverdue - a.daysOverdue);
 }
+
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const inv of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(inv.status)) continue;
+
+    for (const line of inv.lines) {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVAT(line);
+
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { base: 0, vat: 0 });
+      }
+      const current = vatMap.get(rate);
+      current.base += base;
+      current.vat += vat;
+    }
+  }
+
+  return Array.from(vatMap)
+    .map(([rate, { base, vat }]) => ({ rate, base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+}
