--- a/src/reports.js
+++ b/src/reports.js
@@ -1,4 +1,5 @@
 import { invoiceTotals, lineTotal, lineDiscount, lineVAT } from './invoices.js';
+import { roundCents } from './money.js';
 
 export function overdueInvoices(invoices, asOf) {
   return invoices
@@ -38,3 +39,12 @@ export function vatSummary(invoices) {
     .map(([rate, { base, vat }]) => ({ rate, base, vat }))
     .sort((a, b) => b.rate - a.rate);
 }
+
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) return 0;
+
+  const daysOverdue = Math.floor((new Date(asOf) - new Date(invoice.dueDate)) / (1000 * 60 * 60 * 24));
+  const amountDue = invoiceTotals(invoice).total;
+  const fee = roundCents(amountDue * 0.0004 * daysOverdue);
+  return Math.max(0, fee);
+}
