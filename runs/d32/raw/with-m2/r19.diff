+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[5], '100.00');
+  assert.equal(fields[6], '0.00');
+  assert.equal(fields[7], '21.00');
+  assert.equal(fields[8], '121.00');
+  assert.equal(fields[9], '121.00');
