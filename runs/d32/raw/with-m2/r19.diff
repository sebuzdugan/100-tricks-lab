+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns header for empty invoices', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header line', () => {
+  const result = exportCsv([]);
+  assert(result.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv with single invoice', () => {
+  const invoices = [
+    {
+      number: 'INV-2026-0001',
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      dueDate: '2026-11-06',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[1].includes('2026-10-07'));
+  assert(lines[1].includes('2026-11-06'));
+  assert(lines[1].includes('issued'));
+});
+
