+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+
+function formatAmount(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const rows = invoices.map(inv => {
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(inv);
+
+    const fields = [
+      inv.number || '',
+      customerName,
+      inv.issueDate || '',
+      inv.dueDate || '',
+      inv.status || '',
+      formatAmount(totals.subtotal),
+      formatAmount(totals.discount),
+      formatAmount(totals.vat),
+      formatAmount(totals.total),
+      formatAmount(totals.total),
+    ];
+
+    return fields.map(escapeCsvField).join(',') + '\n';
+  });
+
+  return header + rows.join('');
+}
