 import { ok, fail } from './result.js';
 
+export const RATES = { EUR: 1, USD: 1.085, GBP: 0.8425 };
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +41,37 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount in euro cents to another currency.
+ * @param {number} cents - amount in euro cents
+ * @param {string} currency - currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) return fail('UNKNOWN_CURRENCY');
+  const rate = RATES[currency];
+  return ok(roundCents(cents * rate));
+}
+
+/**
+ * Format cents in a given currency for people: 123456 EUR -> "€1,234.56", 123456 USD -> "$1,234.60".
+ * @param {number} cents
+ * @param {string} currency
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const majorUnits = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const minorUnits = String(abs % 100).padStart(2, '0');
+
+  let symbol;
+  switch (currency) {
+    case 'USD': symbol = '$'; break;
+    case 'GBP': symbol = '£'; break;
+    default: symbol = '€';
+  }
+
+  return `${sign}${symbol}${majorUnits}.${minorUnits}`;
+}
