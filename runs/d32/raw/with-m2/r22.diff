+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+import { createInvoice } from '../src/invoices.js';
+import { TIER_DISCOUNTS } from '../src/customers.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 8500 }), 8500);
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 50 }), 5000);
+});
+
+test('lineTotal with zero quantity', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 8500 }), 0);
+});
+
+test('invoiceTotals sums line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, vatRate: 0 },
+      { qty: 2, unitPrice: 9500, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 8500 + 19000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 8500 + 19000);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 6000, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 60000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 60000);
+});
+
+test('invoiceTotals with empty lines', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with multiple lines including zero quantity', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, vatRate: 0 },
+      { qty: 0, unitPrice: 9500, vatRate: 0 },
+      { qty: 2, unitPrice: 6000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500 + 0 + 12000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 54500);
+});
+
+test('invoiceTotals on a created invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 8 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  const totals = invoiceTotals(r.value);
+  const subtotal = 8 * 8500 + 5 * 9500;
+  const discount = Math.round(subtotal * TIER_DISCOUNTS.gold / 100);
+  const amountAfterDiscount = subtotal - discount;
+  const vat = Math.round(amountAfterDiscount * 21 / 100);
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, subtotal - discount + vat);
+});
+
+test('lineDiscount calculates discount amount', () => {
+  assert.equal(lineDiscount({ qty: 1, unitPrice: 10000, discountPercent: 10 }), 1000);
+  assert.equal(lineDiscount({ qty: 2, unitPrice: 5000, discountPercent: 20 }), 2000);
+  assert.equal(lineDiscount({ qty: 1, unitPrice: 8500, discountPercent: 0 }), 0);
+});
+
+test('lineDiscount with decimal discount percent', () => {
+  assert.equal(lineDiscount({ qty: 1, unitPrice: 10000, discountPercent: 12.5 }), 1250);
+  assert.equal(lineDiscount({ qty: 4, unitPrice: 8000, discountPercent: 25.5 }), 8160);
+});
+
+test('lineDiscount defaults discountPercent to 0', () => {
+  assert.equal(lineDiscount({ qty: 1, unitPrice: 10000 }), 0);
+});
+
+test('lineDiscount clamps at 0', () => {
+  const result = lineDiscount({ qty: 0, unitPrice: 10000, discountPercent: 50 });
+  assert.equal(result, 0);
+});
+
+test('invoiceTotals with line discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 9000);
+});
+
+test('invoiceTotals with multiple lines and discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 0 },
+      { qty: 2, unitPrice: 5000, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000 + 10000);
+  assert.equal(totals.discount, 1000 + 2000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 20000 - 3000);
+});
+
+test('invoiceTotals with mixed discounts and no discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 0 },
+      { qty: 2, unitPrice: 5000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000 + 10000);
+  assert.equal(totals.discount, 1000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 20000 - 1000);
+});
+
+test('invoiceTotals with 100% discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 100, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals clamps total at 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 100, vatRate: 0 },
+      { qty: 1, unitPrice: 5000, discountPercent: 100, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 15000);
+  assert.equal(totals.discount, 15000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+  assert(totals.total >= 0);
+});
+
+test('lineVAT calculates VAT on line amount after discount', () => {
+  assert.equal(lineVAT({ qty: 1, unitPrice: 10000, vatRate: 21 }), 2100);
+  assert.equal(lineVAT({ qty: 1, unitPrice: 10000, vatRate: 9 }), 900);
+  assert.equal(lineVAT({ qty: 1, unitPrice: 10000, vatRate: 0 }), 0);
+});
+
+test('lineVAT with discount', () => {
+  assert.equal(lineVAT({ qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 }), 1890);
+});
+
+test('lineVAT with zero amount after discount', () => {
+  assert.equal(lineVAT({ qty: 1, unitPrice: 10000, discountPercent: 100, vatRate: 21 }), 0);
+});
+
+test('lineVAT clamps at 0', () => {
+  const result = lineVAT({ qty: 0, unitPrice: 10000, vatRate: 21 });
+  assert.equal(result, 0);
+  assert(result >= 0);
+});
+
+test('invoiceTotals with gold tier customer default discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const discount = Math.round(8500 * 5 / 100);
+  const amountAfterDiscount = 8500 - discount;
+  const vat = Math.round(amountAfterDiscount * 21 / 100);
+  assert.equal(totals.subtotal, 8500);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, 8500 - discount + vat);
+});
+
+test('invoiceTotals with silver tier customer default discount', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const discount = 212;
+  const amountAfterDiscount = 8500 - discount;
+  const vat = Math.round(amountAfterDiscount * 21 / 100);
+  assert.equal(totals.subtotal, 8500);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, 8500 - discount + vat);
+});
+
+test('invoiceTotals with standard tier customer no discount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const vat = Math.round(8500 * 21 / 100);
+  assert.equal(totals.subtotal, 8500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, 8500 + vat);
+});
+
+test('invoiceTotals with VAT only', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.total, 12100);
+});
+
+test('invoiceTotals with VAT and discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1000);
+  assert.equal(totals.vat, 1890);
+  assert.equal(totals.total, 10890);
+});
+
+test('invoiceTotals with multiple VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, vatRate: 21 },
+      { qty: 1, unitPrice: 10000, vatRate: 9 },
+      { qty: 1, unitPrice: 10000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 30000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100 + 900 + 0);
+  assert.equal(totals.total, 33000);
+});
+
+test('invoiceTotals with VAT and tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const discount = 6000;
+  const amountAfterDiscount = 114000;
+  const vat = 23940;
+  assert.equal(totals.subtotal, 120000);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, 137940);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 2000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.voucher, 2000);
+  assert.equal(totals.total, 10100);
+});
+
+test('invoiceTotals without voucher has zero voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 12100);
+});
+
+test('invoiceTotals with large voucher clamps to zero', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+    voucher: { code: 'HUGE', amount: 50000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+  assert.equal(totals.total >= 0, true);
+});
+
+test('invoiceTotals with discount and voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1000);
+  const amountAfterDiscount = 9000;
+  const vat = Math.round(amountAfterDiscount * 21 / 100);
+  const expectedTotal = amountAfterDiscount + vat - 1000;
+  assert.equal(totals.total, expectedTotal);
+});
