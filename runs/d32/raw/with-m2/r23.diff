+/**
+ * Calculate the bulk discount (2.5% off for 10+ units) applied after line discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} bulk discount in cents
+ */
+function lineBulkDiscount(line) {
+  if (line.qty < 10) return 0;
+  const total = lineTotal(line);
+  const lineDisc = lineDiscount(line);
+  const amountAfterLineDiscount = Math.max(0, total - lineDisc);
+  const bulkDisc = roundCents(amountAfterLineDiscount * 2.5 / 100);
+  return Math.max(0, bulkDisc);
+}
+
 /**
  * Calculate the VAT amount for a line.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
@@ -29,7 +43,8 @@ export function lineDiscount(line) {
 export function lineVAT(line) {
   const total = lineTotal(line);
   const discount = lineDiscount(line);
-  const amountAfterDiscount = Math.max(0, total - discount);
+  const bulkDiscount = lineBulkDiscount(line);
+  const amountAfterDiscount = Math.max(0, total - discount - bulkDiscount);
   const vatRate = line.vatRate ?? 0;
   const vatAmount = roundCents(amountAfterDiscount * vatRate / 100);
   return Math.max(0, vatAmount);
@@ -47,6 +62,7 @@ export function invoiceTotals(invoice) {
   for (const line of invoice.lines) {
     subtotal += lineTotal(line);
     discount += lineDiscount(line);
+    discount += lineBulkDiscount(line);
     vat += lineVAT(line);
   }
   subtotal = roundCents(subtotal);
