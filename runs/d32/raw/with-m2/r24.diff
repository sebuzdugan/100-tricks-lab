 export function overdueInvoices(invoices, asOf) {
   return invoices
@@ -48,3 +49,54 @@ export function lateFee(invoice, asOf) {
   const fee = roundCents(amountDue * 0.0004 * daysOverdue);
   return Math.max(0, fee);
 }
+
+/**
+ * Generate a dashboard summary of invoice data.
+ * @param {Array} invoices
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {{ counts: { draft, issued, partially_paid, paid }, outstanding: number, overdue: { count, amount }, topCustomers: Array<{ customerId, due }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = new Map();
+
+  for (const invoice of invoices) {
+    counts[invoice.status]++;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      const customerId = invoice.customerId;
+      if (!customerDue.has(customerId)) {
+        customerDue.set(customerId, 0);
+      }
+      customerDue.set(customerId, customerDue.get(customerId) + due);
+    }
+  }
+
+  const overdueList = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const topCustomers = Array.from(customerDue.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding: roundCents(outstanding),
+    overdue,
+    topCustomers,
+  };
+}
