 /**
  * Render an invoice as plain text.
- * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number }>, dueDate?: string, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number }> }} invoice
  * @returns {string}
