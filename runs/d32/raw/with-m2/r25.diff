 export function renderInvoiceText(invoice) {
@@ -19,12 +19,19 @@ export function renderInvoiceText(invoice) {
     lines.push(customerResult.value.name);
   }
 
-  // Invoice line items
+  // Invoice line items with individual discounts
   for (const line of invoice.lines) {
     const total = lineTotal(line);
     const unitPriceStr = formatEuros(line.unitPrice);
     const lineTotalStr = formatEuros(total);
     lines.push(`  ${line.qty}x ${line.name} @ ${unitPriceStr} = ${lineTotalStr}`);
+
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      const discountStr = formatEuros(discount);
+      const discountPercent = line.discountPercent ?? 0;
+      lines.push(`  Discount (${discountPercent}%): ${discountStr}`);
+    }
   }
 
   // VAT and total lines
@@ -32,7 +39,21 @@ export function renderInvoiceText(invoice) {
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: ${formatEuros(totals.voucher)}`);
+  }
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date if available
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Amount paid if there are payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
