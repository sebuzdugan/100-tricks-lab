+++ b/src/invoices.js
@@ -0,0 +1,51 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a new invoice with the given customer, issue date, and line items.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issue date format (YYYY-MM-DD)
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) return fail('DATE_INVALID');
+  const date = new Date(issueDate + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return fail('DATE_INVALID');
+
+  // Validate lines is not empty
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    const { sku, qty } = line;
+
+    // Validate qty is a positive integer
+    if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+    // Validate SKU exists and get product details
+    const productResult = getProduct(sku);
+    if (!productResult.ok) return productResult;
+
+    const { name, unitPrice, vatRate } = productResult.value;
+    enrichedLines.push({
+      sku,
+      name,
+      qty,
+      unitPrice,
+      vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
