+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched line items', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  const line = r.value.lines[0];
+  assert.equal(line.sku, 'DES-HOUR');
+  assert.equal(line.name, 'Design work (hour)');
+  assert.equal(line.qty, 5);
+  assert.equal(line.unitPrice, 8500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice includes multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+});
+
+test('createInvoice rejects an unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects an invalid date format', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '10/07/2026',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects an invalid date value', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-13-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects an empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects missing lines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: null,
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects a non-integer quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects a zero quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects a negative quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects an unknown SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'NOPE', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate the input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+  const linesCopy = JSON.parse(JSON.stringify(lines));
+  createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines,
+  });
+  assert.deepEqual(lines, linesCopy);
+});
+
+test('createInvoice returns a copy of the invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.notEqual(r1.value, r2.value);
+  assert.notEqual(r1.value.lines, r2.value.lines);
+});
