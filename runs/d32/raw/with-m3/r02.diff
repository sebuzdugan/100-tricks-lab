@@ -49,3 +50,31 @@ export function createInvoice({ customerId, issueDate, lines }) {
     lines: enrichedLines,
   });
 }
+
+/**
+ * Calculate the total for a single line item: qty × unitPrice.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate totals for an invoice: subtotal (sum of line totals) and total.
+ * @param {{ lines: Array }} invoice
+ * @returns {{ ok: true, value: { subtotal: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines)) {
+    return fail('INVALID_INVOICE');
+  }
+  let subtotal = 0;
+  for (const line of invoice.lines) {
+    subtotal += lineTotal(line);
+  }
+  return ok({
+    subtotal,
+    total: subtotal,
+  });
+}
