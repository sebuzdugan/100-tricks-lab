+/**
+ * Add or increase a line on a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} params
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status and structure
+  if (!invoice || invoice.status !== 'draft' || !Array.isArray(invoice.lines)) {
+    return fail('NOT_DRAFT');
+  }
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Validate SKU exists
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const { name, unitPrice, vatRate } = productResult.value;
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+
+  // Find existing line with this SKU
+  const existingIndex = newLines.findIndex((line) => line.sku === sku);
+  if (existingIndex >= 0) {
+    // Increase qty on existing line
+    newLines[existingIndex] = {
+      ...newLines[existingIndex],
+      qty: newLines[existingIndex].qty + qty,
+    };
+  } else {
+    // Add new line
+    newLines.push({
+      sku,
+      name,
+      qty,
+      unitPrice,
+      vatRate,
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check status and structure
+  if (!invoice || invoice.status !== 'draft' || !Array.isArray(invoice.lines)) {
+    return fail('NOT_DRAFT');
+  }
+
+  // Find line with this SKU
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex < 0) {
+    return fail('LINE_NOT_FOUND');
+  }
+
+  // Check if this is the last line
+  if (invoice.lines.length === 1) {
+    return fail('NO_LINES');
+  }
+
+  // Create new invoice without this line
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
