diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..4601f51
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,80 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number of year for empty list', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber finds the max counter', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber handles multiple invoices in same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0099'];
+  const number = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-9999', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = [];
+  const num1 = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(num1, 'INV-2026-0001');
+
+  const num100 = nextInvoiceNumber(
+    Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`),
+    '2026-01-01'
+  );
+  assert.equal(num100, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber handles numbers in any order', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0002', 'INV-2026-0001', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber handles mixed years in any order', () => {
+  const existing = [
+    'INV-2025-0005',
+    'INV-2026-0002',
+    'INV-2025-0001',
+    'INV-2026-0001',
+    'INV-2027-0001',
+  ];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = [
+    'INV-2026-0001',
+    'invalid-number',
+    'INV-2026-ABC',
+    'INV-2026-0003',
+    'something',
+  ];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
