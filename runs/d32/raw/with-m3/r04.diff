+++ b/src/numbering.js
@@ -0,0 +1,23 @@
+/**
+ * Determine the next free invoice number for a given date.
+ * Format: INV-<year>-<counter> where counter is 4 digits zero-padded, restarting each year.
+ * @param {Array<string>} existingNumbers - invoice numbers already used, in any order
+ * @param {string} issueDate - issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Extract counters for this year
+  const thisYearCounters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length)))
+    .filter((n) => !isNaN(n));
+
+  // Find the next available counter
+  const maxCounter = thisYearCounters.length > 0 ? Math.max(...thisYearCounters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
