+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, number?: string, status: string, lines: Array }} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Calculate totals
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+
+  const lines = [];
+
+  // Header: invoice number or DRAFT
+  const header = invoice.number ?? 'DRAFT';
+  lines.push(header);
+
+  // Customer name
+  lines.push(customerResult.value.name);
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const total = line.qty * line.unitPrice;
+    const unitPriceStr = formatEuros(line.unitPrice);
+    const lineTotalStr = formatEuros(total);
+    lines.push(`${line.qty}x ${line.name} @ ${unitPriceStr} = ${lineTotalStr}`);
+  }
+
+  // Total
+  const totalStr = formatEuros(totalsResult.value.total);
+  lines.push(`Total: ${totalStr}`);
+
+  return ok(lines.join('\n'));
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..c2edc40
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,151 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice with one line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Kite & Co\n/);
+  assert.match(text, /2x Design work \(hour\) @ €85\.00 = €170\.00\n/);
+  assert.match(text, /Total: €170\.00$/);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const created = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const invoice = issueInvoice(created, []).value;
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '2x Design work (hour) @ €85.00 = €170.00');
+  assert.equal(lines[3], '3x Development (hour) @ €95.00 = €285.00');
+  assert.equal(lines[4], 'Total: €455.00');
+});
+
+test('renderInvoiceText formats amounts with formatEuros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /€85\.00/);
+});
+
+test('renderInvoiceText with different customer', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText rejects unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const r = renderInvoiceText(invoice);
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('renderInvoiceText with qty 1', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /1x Design work \(hour\)/);
+});
+
+test('renderInvoiceText with larger quantities', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  }).value;
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /100x Design work \(hour\) @ €85\.00 = €8,500\.00/);
+});
+
+test('renderInvoiceText output is a string', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(typeof r.value, 'string');
+});
+
+test('renderInvoiceText preserves line order', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 1 },
+    ],
+  }).value;
+
+  const r = renderInvoiceText(invoice);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  const lines = text.split('\n');
+  assert.match(lines[2], /Design work/);
+  assert.match(lines[3], /Development/);
+  assert.match(lines[4], /Copywriting/);
+});
