+
+test('createInvoice with valid discountPercent', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice with decimal discountPercent', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 12.5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 12.5);
+});
+
+test('createInvoice with zero discountPercent', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice with max discountPercent', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 100 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 100);
+});
+
+test('createInvoice with missing discountPercent defaults to 0', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
