diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..39c9ac8
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,145 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid YYYY-MM-DD dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10/07/2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-10-00'), false);
+  assert.equal(isValidDate('2026-10-32'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(20261007), false);
+  assert.equal(isValidDate({}), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2026-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 30), '2026-11-06');
+});
+
+test('addDays adds days across month boundary', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays adds zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays subtracts days with negative n', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -7), '2026-09-30');
+});
+
+test('addDays subtracts days across month boundary', () => {
+  assert.equal(addDays('2026-11-01', -1), '2026-10-31');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+});
+
+test('addDays handles large day additions', () => {
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+  assert.equal(addDays('2026-01-01', 100), '2026-04-11');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-11-06'), 30);
+});
+
+test('daysBetween calculates zero difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+});
+
+test('daysBetween across month boundary', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+});
+
+test('daysBetween across year boundary', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+});
+
+test('daysBetween returns whole days only', () => {
+  const a = '2026-10-07';
+  const b = '2026-10-08';
+  assert.equal(daysBetween(a, b), 1);
+  assert.equal(daysBetween(b, a), -1);
+});
+
+test('daysBetween large differences', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-12-31'), 364);
+  assert.equal(daysBetween('2000-01-01', '2026-10-07'), 9776);
+});
+
+test('addDays and daysBetween are inverse operations', () => {
+  const date = '2026-10-07';
+  const n = 100;
+  const result = addDays(date, n);
+  const diff = daysBetween(date, result);
+  assert.equal(diff, n);
+});
+
+test('addDays preserves date format', () => {
+  const result = addDays('2026-10-07', 5);
+  assert.match(result, /^\d{4}-\d{2}-\d{2}$/);
+});
+
+test('addDays in UTC, not local time', () => {
+  const date = '2026-10-07';
+  const result = addDays(date, 1);
+  assert.equal(result, '2026-10-08');
+});
+
+test('daysBetween in UTC, not local time', () => {
+  const a = '2026-10-07';
+  const b = '2026-10-08';
+  const diff = daysBetween(a, b);
+  assert.equal(diff, 1);
+});
