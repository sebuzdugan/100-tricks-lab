index 0000000..f481081
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,38 @@
+/**
+ * Check if text is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+  const iso = date.toISOString().split('T')[0];
+  return iso === text;
+}
+
+/**
+ * Add n days to a date (YYYY-MM-DD format), return result as YYYY-MM-DD.
+ * @param {string} date
+ * @param {number} n
+ * @returns {string}
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of whole days between two dates (b minus a).
+ * @param {string} a
+ * @param {string} b
+ * @returns {number}
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB - dateA) / msPerDay);
+}
