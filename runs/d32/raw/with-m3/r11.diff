+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('recordPayment adds a payment to an issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = recordPayment(issued, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 10000);
+  assert.equal(r.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment updates status to partially_paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const r = recordPayment(issued, { amount: total - 5000, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment updates status to paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const r = recordPayment(issued, { amount: total, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment allows multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const r1 = recordPayment(issued, { amount: total / 2, date: '2026-10-08' });
+  assert.equal(r1.ok, true);
+
+  const r2 = recordPayment(r1.value, { amount: total / 2, date: '2026-10-09' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.payments.length, 2);
+  assert.equal(r2.value.status, 'paid');
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = recordPayment(issued, { amount: 100.5, date: '2026-10-08' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects zero amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = recordPayment(issued, { amount: 0, date: '2026-10-08' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects negative amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = recordPayment(issued, { amount: -1000, date: '2026-10-08' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const r = recordPayment(invoice, { amount: 10000, date: '2026-10-08' });
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment accepts payment on issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = recordPayment(issued, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+});
+
+test('recordPayment accepts payment on partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const r1 = recordPayment(issued, { amount: total / 2, date: '2026-10-08' });
+  assert.equal(r1.value.status, 'partially_paid');
+
+  const r2 = recordPayment(r1.value, { amount: total / 2, date: '2026-10-09' });
+  assert.equal(r2.ok, true);
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const r = recordPayment(issued, { amount: total + 1, date: '2026-10-08' });
+  assert.deepEqual(r, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment prevents overpayment after partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const r1 = recordPayment(issued, { amount: total / 2, date: '2026-10-08' });
+  assert.equal(r1.ok, true);
+
+  const r2 = recordPayment(r1.value, { amount: total / 2 + 1, date: '2026-10-09' });
+  assert.deepEqual(r2, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const originalStatus = issued.status;
+
+  recordPayment(issued, { amount: 10000, date: '2026-10-08' });
+  assert.equal(issued.status, originalStatus);
+  assert.equal(issued.payments, undefined);
+});
+
+test('balanceDue returns total for unpaid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const balance = balanceDue(issued);
+  assert.equal(balance, total);
+});
+
+test('balanceDue returns remaining balance after payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+  const payment = total / 2;
+
+  const r = recordPayment(issued, { amount: payment, date: '2026-10-08' });
+  const balance = balanceDue(r.value);
+  assert.equal(balance, total - payment);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const r = recordPayment(issued, { amount: total, date: '2026-10-08' });
+  const balance = balanceDue(r.value);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue with multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const payment1 = 10000;
+  const payment2 = 5000;
+
+  const r1 = recordPayment(issued, { amount: payment1, date: '2026-10-08' });
+  const r2 = recordPayment(r1.value, { amount: payment2, date: '2026-10-09' });
+
+  const balance = balanceDue(r2.value);
+  assert.equal(balance, total - payment1 - payment2);
+});
+
+test('recordPayment rejects payment on paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+
+  const r1 = recordPayment(issued, { amount: total, date: '2026-10-08' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.status, 'paid');
+
+  const r2 = recordPayment(r1.value, { amount: 1, date: '2026-10-09' });
+  assert.deepEqual(r2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment preserves invoice data', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = recordPayment(issued, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.number, issued.number);
+});
