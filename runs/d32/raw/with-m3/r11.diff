+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the total amount paid on an invoice.
+ * @param {Array} payments
+ * @returns {number}
+ */
+function totalPayments(payments) {
+  if (!Array.isArray(payments)) return 0;
+  return payments.reduce((sum, p) => sum + p.amount, 0);
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ lines: Array, payments?: Array }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return 0;
+  const paid = totalPayments(invoice.payments);
+  return Math.max(0, totalsResult.value.total - paid);
+}
+
+/**
+ * Record a payment on an issued or partially_paid invoice.
+ * @param {{ status: string, payments?: Array, lines: Array }} invoice
+ * @param {{ amount: number, date: string }} params
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, params) {
+  const { amount, date } = params;
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check invoice status
+  if (!invoice || (invoice.status !== 'issued' && invoice.status !== 'partially_paid')) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Calculate balance due
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new invoice with payment added
+  const newPayments = [...(invoice.payments || []), { amount, date }];
+  const newBalance = balance - amount;
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
