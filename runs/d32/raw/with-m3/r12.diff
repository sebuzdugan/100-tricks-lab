-import { isValidDate } from './dates.js';
+import { isValidDate, addDays } from './dates.js';
+
+/**
+ * Calculate the last day of the month for a given date.
+ * @param {string} date - date in YYYY-MM-DD format
+ * @returns {string} - last day of the month in YYYY-MM-DD format
+ */
+function lastDayOfMonth(date) {
+  const d = new Date(date + 'T00:00:00Z');
+  const year = d.getUTCFullYear();
+  const month = d.getUTCMonth();
+  const lastDay = new Date(Date.UTC(year, month + 1, 0));
+  return lastDay.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate due date based on payment terms.
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} - due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') return addDays(issueDate, 14);
+  if (terms === 'NET30') return addDays(issueDate, 30);
+  if (terms === 'EOM') return lastDayOfMonth(issueDate);
+  return null;
+}
 
