+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: object }} invoice
+ * @param {{ code: string, amount: number }} params
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, params) {
+  const { code, amount } = params;
+
+  // Check invoice is draft
+  if (!invoice || invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Check if voucher already exists
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
