+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns empty list for customer with no invoices', () => {
+  const r = statement('C-001', [], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement returns invoice with status issued', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, issued.number);
+});
+
+test('statement excludes draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const r = statement('C-001', [invoice], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const withPayment = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+
+  const r = statement('C-001', [withPayment], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const paidTotal = invoiceTotals(issued).value.total;
+  const paid = recordPayment(issued, { amount: paidTotal, date: '2026-10-08' }).value;
+
+  const r = statement('C-001', [paid], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement filters by customer id', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, []).value;
+
+  const r = statement('C-001', [issued1, issued2], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, issued1.number);
+});
+
+test('statement filters by asOf date', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, []).value;
+
+  const r = statement('C-001', [issued1, issued2], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-05');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, []).value;
+
+  const r = statement('C-001', [issued1, issued2], '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-10');
+});
+
+test('statement includes invoice data in statement line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = statement('C-003', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  const inv = r.value.invoices[0];
+  assert.equal(inv.number, issued.number);
+  assert.equal(inv.issueDate, '2026-10-07');
+  assert.equal(inv.dueDate, issued.dueDate);
+});
+
+test('statement calculates total correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = statement('C-003', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  const inv = r.value.invoices[0];
+  const expectedTotal = invoiceTotals(issued).value.total;
+  assert.equal(inv.total, expectedTotal);
+});
+
+test('statement calculates due from balanceDue', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = statement('C-003', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  const inv = r.value.invoices[0];
+  assert(inv.due > 0);
+});
+
+test('statement calculates totalDue', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, []).value;
+
+  const r = statement('C-001', [issued1, issued2], '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.totalDue, r.value.invoices[0].due + r.value.invoices[1].due);
+});
+
+test('statement with unknown customer returns CUSTOMER_NOT_FOUND', () => {
+  const r = statement('C-999', [], '2026-10-07');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement with partial payment reduces due', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const withPayment = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+
+  const r = statement('C-003', [withPayment], '2026-10-07');
+  assert.equal(r.ok, true);
+  const inv = r.value.invoices[0];
+  assert(inv.due > 0);
+  assert(inv.due < inv.total);
+});
+
+test('statement with multiple customers only includes specified customer', () => {
+  const invoices = [];
+
+  for (let i = 1; i <= 5; i++) {
+    const inv = createInvoice({
+      customerId: `C-00${i}`,
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: i }],
+    }).value;
+    invoices.push(issueInvoice(inv, []).value);
+  }
+
+  const r = statement('C-003', invoices, '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, invoices[2].number);
+});
+
+test('statement with asOf before issueDate excludes invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement with asOf equal to issueDate includes invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement with voucher reduces total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const withoutVoucher = issueInvoice(invoice, []).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'SUMMER2026', amount: 5000 }).value;
+  const issuedWithVoucher = issueInvoice(withVoucher, []).value;
+
+  const r1 = statement('C-003', [withoutVoucher], '2026-10-07');
+  const r2 = statement('C-003', [issuedWithVoucher], '2026-10-07');
+
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+
+  const totalWithout = r1.value.invoices[0].total;
+  const totalWith = r2.value.invoices[0].total;
+
+  assert.equal(totalWith, totalWithout - 5000);
+});
+
+test('statement includes dueDate in statement line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = statement('C-003', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  const inv = r.value.invoices[0];
+  assert.equal(inv.dueDate, '2026-10-21');
+});
+
+test('statement with mixed statuses only includes issued and partially_paid', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    }).value,
+    []
+  ).value;
+
+  const invoices = [draft, issued];
+  const r = statement('C-001', invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, issued.number);
+});
+
+test('statement returns statement data structure', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = statement('C-003', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert(r.value.customerId);
+  assert(Array.isArray(r.value.invoices));
+  assert(typeof r.value.totalDue === 'number');
+});
