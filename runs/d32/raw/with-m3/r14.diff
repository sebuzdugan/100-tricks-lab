+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement listing outstanding invoices.
+ * @param {string} customerId
+ * @param {Array<object>} invoices
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer
+  const customerInvoices = invoices.filter(inv => inv.customerId === customerId);
+
+  // Filter by status and date
+  const relevantInvoices = customerInvoices.filter(inv => {
+    const isOutstanding = inv.status === 'issued' || inv.status === 'partially_paid';
+    const isOnOrBeforeAsOf = inv.issueDate <= asOf;
+    return isOutstanding && isOnOrBeforeAsOf;
+  });
+
+  // Transform to statement line items
+  const statementInvoices = relevantInvoices
+    .map(inv => {
+      const totalsResult = invoiceTotals(inv);
+      const total = totalsResult.ok ? totalsResult.value.total : 0;
+      return {
+        number: inv.number,
+        issueDate: inv.issueDate,
+        dueDate: inv.dueDate,
+        total,
+        due: balanceDue(inv),
+      };
+    })
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
