+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, issued.number);
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Discount');
+  assert.equal(r.value.date, '2026-10-08');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote accepts partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const withPayment = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(withPayment, { amount: 5000, reason: 'Discount', date: '2026-10-09' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote accepts paid invoice', () => {
