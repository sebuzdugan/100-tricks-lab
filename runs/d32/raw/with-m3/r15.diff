+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Get the next credit note number for a given year.
+ * @param {Array<string>} existingNumbers
+ * @param {string} date - date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+  const creditNoteNumbers = existingNumbers.filter(num => num.startsWith('CN-'));
+
+  let maxCounter = 0;
+  for (const num of creditNoteNumbers) {
+    const parts = num.split('-');
+    if (parts.length === 3 && parts[1] === year) {
+      const counter = parseInt(parts[2], 10);
+      if (!isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for a refund on an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} params
+ * @param {Array<string>} existingNumbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, params, existingNumbers) {
+  const { amount, reason, date } = params;
+
+  // Check invoice status
+  if (!invoice || (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid')) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) return fail('DATE_INVALID');
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+  const invoiceTotal = totalsResult.value.total;
+
+  // Check credit note amount doesn't exceed invoice total
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
