+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).value.total;
+  const paid = recordPayment(issued, { amount: total, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(paid, { amount: 5000, reason: 'Discount', date: '2026-10-09' }, []);
+  assert.equal(r.ok, true);
+});
