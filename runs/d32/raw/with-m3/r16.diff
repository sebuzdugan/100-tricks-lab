+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('overdueInvoices returns empty array for empty input', () => {
+  const result = overdueInvoices([], '2026-10-07');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = overdueInvoices([draft], '2026-10-07');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes issued invoices with past due dates', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].customerId, 'C-003');
+  assert.equal(result[0].dueDate, '2026-10-01');
+});
+
+test('overdueInvoices excludes invoices with future due dates', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-07');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices with due date equal to asOf', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], issued.dueDate);
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-08');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 7);
+});
+
+test('overdueInvoices returns due amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 50140);
+});
+
+test('overdueInvoices sorts by daysOverdue descending (most overdue first)', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-08-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2026-0001']).value;
+
+  const result = overdueInvoices([issued2, issued1], '2026-10-07');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].daysOverdue, 23);
+  assert.equal(result[1].number, 'INV-2026-0002');
+  assert.equal(result[1].daysOverdue, 6);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const partiallyPaid = { ...issued, status: 'partially_paid' };
+
+  const result = overdueInvoices([partiallyPaid], '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].status, undefined);
+  assert.equal(result[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices mixes issued and partially_paid invoices', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-08-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2026-0001']).value;
+  const partiallyPaid = { ...issued2, status: 'partially_paid' };
+
+  const result = overdueInvoices([issued, partiallyPaid], '2026-10-07');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, 'INV-2026-0002');
+  assert.equal(result[1].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices with multiple overdue invoices sorted correctly', () => {
+  const invoices = [];
+  const dates = [
+    { issueDate: '2026-08-01', daysOverdue: 37 },
+    { issueDate: '2026-09-01', daysOverdue: 6 },
+    { issueDate: '2026-08-15', daysOverdue: 23 },
+  ];
+
+  const existingNumbers = [];
+  for (const { issueDate } of dates) {
+    const inv = createInvoice({
+      customerId: 'C-003',
+      issueDate,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+    const issued = issueInvoice(inv, existingNumbers).value;
+    invoices.push(issued);
+    existingNumbers.push(issued.number);
+  }
+
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result.length, 3);
+  assert.equal(result[0].daysOverdue, 37);
+  assert.equal(result[1].daysOverdue, 23);
+  assert.equal(result[2].daysOverdue, 6);
+});
+
+test('overdueInvoices with one day overdue', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'EOM',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-01');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices with no overdue invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-01');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices returns object with correct fields', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-07');
+  assert.equal(result.length, 1);
+  const item = result[0];
+  assert.ok('number' in item);
+  assert.ok('customerId' in item);
+  assert.ok('dueDate' in item);
+  assert.ok('daysOverdue' in item);
+  assert.ok('due' in item);
+  assert.equal(Object.keys(item).length, 5);
+});
+
+test('overdueInvoices with invoices of different customers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result = overdueInvoices([issued1, issued2], '2026-10-07');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[1].customerId, 'C-003');
+});
+
+test('overdueInvoices with different payment terms', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const result = overdueInvoices([issued1, issued2], '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices does not mutate input', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const invoices = [issued];
+  const invoicesCopy = JSON.parse(JSON.stringify(invoices));
+
+  overdueInvoices(invoices, '2026-10-07');
+  assert.deepEqual(invoices, invoicesCopy);
+});
