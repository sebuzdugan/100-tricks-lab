+++ b/src/reports.js
@@ -0,0 +1,39 @@
+import { invoiceTotals } from './invoices.js';
+
+export function overdueInvoices(invoices, asOf) {
+  const overdue = [];
+
+  for (const invoice of invoices) {
+    // Only include invoices with status 'issued' or 'partially_paid'
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+      continue;
+    }
+
+    // Check if dueDate is before asOf
+    if (invoice.dueDate >= asOf) {
+      continue;
+    }
+
+    // Calculate due amount
+    const totalsResult = invoiceTotals(invoice);
+    const due = totalsResult.ok ? totalsResult.value.total : 0;
+
+    // Calculate days overdue
+    const dueDateObj = new Date(invoice.dueDate + 'T00:00:00Z');
+    const asOfObj = new Date(asOf + 'T00:00:00Z');
+    const daysOverdue = Math.floor((asOfObj - dueDateObj) / (1000 * 60 * 60 * 24));
+
+    overdue.push({
+      number: invoice.number,
+      customerId: invoice.customerId,
+      dueDate: invoice.dueDate,
+      daysOverdue,
+      due,
+    });
+  }
+
+  // Sort by daysOverdue descending (most overdue first = longest overdue)
+  overdue.sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
