+import { invoiceTotals, lineTotal } from './invoices.js';
+import { roundCents } from './money.js';
 
 export function overdueInvoices(invoices, asOf) {
   const overdue = [];
@@ -37,3 +38,34 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate ?? 0;
+      const lineGrossTotal = lineTotal(line);
+      const discountPercent = line.discountPercent ?? 0;
+      const lineDiscount = roundCents(lineGrossTotal * discountPercent / 100);
+      const lineAmount = Math.max(0, lineGrossTotal - lineDiscount);
+      const lineVat = roundCents(lineAmount * rate / 100);
+
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { base: 0, vat: 0 });
+      }
+      const entry = vatMap.get(rate);
+      entry.base += lineAmount;
+      entry.vat += lineVat;
+    }
+  }
+
+  const result = Array.from(vatMap, ([rate, { base, vat }]) => ({ rate, base, vat }));
+  result.sort((a, b) => b.rate - a.rate);
+
+  return result;
+}
