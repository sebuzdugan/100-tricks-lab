--- a/src/reports.js
+++ b/src/reports.js
@@ -69,3 +69,29 @@ export function vatSummary(invoices) {
 
   return result;
 }
+
+export function lateFee(invoice, asOf) {
+  if (!invoice || invoice.status === 'draft') {
+    return 0;
+  }
+
+  if (!invoice.dueDate) {
+    return 0;
+  }
+
+  const dueDateObj = new Date(invoice.dueDate + 'T00:00:00Z');
+  const asOfObj = new Date(asOf + 'T00:00:00Z');
+  const daysOverdue = Math.floor((asOfObj - dueDateObj) / (1000 * 60 * 60 * 24));
+
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  const totalsResult = invoiceTotals(invoice);
+  const amountDue = totalsResult.ok ? totalsResult.value.total : 0;
+
+  const dailyRate = 0.0004;
+  const fee = amountDue * dailyRate * daysOverdue;
+
+  return roundCents(fee);
+}
