+test('exportCsv exports single issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[2], '');
+});
