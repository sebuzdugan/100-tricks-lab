+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+
+function formatEuro(cents) {
+  if (typeof cents !== 'number' || cents < 0) {
+    return '0.00';
+  }
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map(invoice => {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+    const totalsResult = invoiceTotals(invoice);
+    const totals = totalsResult.ok ? totalsResult.value : { subtotal: 0, discount: 0, vat: 0, total: 0 };
+
+    const fields = [
+      invoice.number || '',
+      customerName,
+      invoice.issueDate || '',
+      invoice.dueDate || '',
+      invoice.status || '',
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(totals.total),
+    ];
+
+    return fields.map(escapeCsvField).join(',') + '\n';
+  }).join('');
+
+  return header + lines;
+}
