 import { ok, fail } from './result.js';
 
+export const RATES = { EUR: 1, USD: 1.085, GBP: 0.8425 };
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +41,37 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount in euros (cents) to another currency.
+ * @param {number} cents - amount in euro cents
+ * @param {string} currency - target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  const rate = RATES[currency];
+  if (rate === undefined) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  return ok(roundCents(cents * rate));
+}
+
+/**
+ * Format cents as money in the specified currency: 123456 EUR -> "$1,340.26" (USD), "€1,234.56" (EUR).
+ * @param {number} cents - amount in euros
+ * @param {string} currency - target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function formatMoney(cents, currency) {
+  const rate = RATES[currency];
+  if (rate === undefined) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const symbol = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+  const amountInCurrency = roundCents(cents * rate);
+  const sign = amountInCurrency < 0 ? '-' : '';
+  const abs = Math.abs(amountInCurrency);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return ok(`${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`);
+}
