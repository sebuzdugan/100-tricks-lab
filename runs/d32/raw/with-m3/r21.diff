+test('mergeCustomers removes fromId and keeps intoId', () => {
+  const customers = [
+    { id: 'C-001', name: 'Customer 1' },
+    { id: 'C-002', name: 'Customer 2' },
+    { id: 'C-003', name: 'Customer 3' },
+  ];
+  const invoices = [];
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, 2);
+  assert.ok(r.value.customers.some((c) => c.id === 'C-002'));
+  assert.ok(!r.value.customers.some((c) => c.id === 'C-001'));
+});
+
+test('mergeCustomers transfers invoices from fromId to intoId', () => {
+  const customers = [
+    { id: 'C-001', name: 'Customer 1' },
+    { id: 'C-002', name: 'Customer 2' },
+  ];
+  const invoices = [
+    { id: 'INV-001', customerId: 'C-001', amount: 100 },
+    { id: 'INV-002', customerId: 'C-001', amount: 200 },
+    { id: 'INV-003', customerId: 'C-002', amount: 300 },
+  ];
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 3);
+  const c1Invoices = r.value.invoices.filter((inv) => inv.customerId === 'C-001');
+  const c2Invoices = r.value.invoices.filter((inv) => inv.customerId === 'C-002');
+  assert.equal(c1Invoices.length, 0);
+  assert.equal(c2Invoices.length, 3);
+});
