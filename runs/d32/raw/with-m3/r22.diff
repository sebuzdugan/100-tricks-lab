+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const total = lineTotal({ qty: 5, unitPrice: 8500 });
+  assert.equal(total, 42500);
+});
+
+test('lineTotal with qty 1', () => {
+  const total = lineTotal({ qty: 1, unitPrice: 8500 });
+  assert.equal(total, 8500);
+});
+
+test('lineTotal with qty 0 returns 0', () => {
+  const total = lineTotal({ qty: 0, unitPrice: 8500 });
+  assert.equal(total, 0);
+});
+
+test('invoiceTotals calculates subtotal from a single line', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 5, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 42500);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 0);
+  assert.equal(r.value.total, 42500);
+});
+
+test('invoiceTotals sums multiple lines', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2, unitPrice: 8500, vatRate: 0 },
+      { sku: 'DEV-HOUR', qty: 3, unitPrice: 9500, vatRate: 0 },
+    ],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 2 * 8500 + 3 * 9500);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 0);
+  assert.equal(r.value.total, r.value.subtotal);
+});
+
+test('invoiceTotals with empty lines returns 0', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 0);
+  assert.equal(r.value.total, 0);
+});
+
+test('invoiceTotals rejects null invoice', () => {
+  const r = invoiceTotals(null);
+  assert.deepEqual(r, { ok: false, error: 'INVALID_INVOICE' });
+});
+
+test('invoiceTotals rejects invoice without lines', () => {
+  const r = invoiceTotals({ customerId: 'C-003' });
+  assert.deepEqual(r, { ok: false, error: 'INVALID_INVOICE' });
+});
+
+test('invoiceTotals rejects invoice with non-array lines', () => {
+  const r = invoiceTotals({ customerId: 'C-003', lines: 'not an array' });
+  assert.deepEqual(r, { ok: false, error: 'INVALID_INVOICE' });
+});
+
+test('invoiceTotals returns subtotal, discount, vat, and total', () => {
+  const invoice = {
+    lines: [
+      { sku: 'SKU-001', qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 10000);
+  assert.equal(r.value.discount, 500);
+  const lineAmount = 10000 - 500;
+  const vat = Math.round(lineAmount * 21 / 100);
+  assert.equal(r.value.vat, vat);
+  assert.equal(r.value.voucher, 0);
+  assert.equal(r.value.total, 10000 - 500 + vat);
+});
+
+test('invoiceTotals calculates discount from a single line', () => {
+  const invoice = {
+    lines: [
+      { sku: 'SKU-001', qty: 5, unitPrice: 1000, vatRate: 0, discountPercent: 10 },
+    ],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 5000);
+  assert.equal(r.value.discount, 500);
+  assert.equal(r.value.total, 4500);
+});
+
+test('invoiceTotals with decimal discount percentage', () => {
+  const invoice = {
+    lines: [
+      { sku: 'SKU-001', qty: 2, unitPrice: 5000, vatRate: 0, discountPercent: 2.5 },
+    ],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 10000);
+  assert.equal(r.value.discount, 250);
+  assert.equal(r.value.total, 9750);
+});
+
+test('invoiceTotals with multiple lines and different discounts', () => {
+  const invoice = {
+    lines: [
+      { sku: 'SKU-001', qty: 2, unitPrice: 5000, vatRate: 0, discountPercent: 10 },
+      { sku: 'SKU-002', qty: 3, unitPrice: 4000, vatRate: 0, discountPercent: 5 },
+    ],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  const subtotal = 2 * 5000 + 3 * 4000;
+  const discount1 = 10000 * 0.1;
+  const discount2 = 12000 * 0.05;
+  assert.equal(r.value.subtotal, subtotal);
+  assert.equal(r.value.discount, 1000 + 600);
+  assert.equal(r.value.total, subtotal - 1600);
+});
+
+test('invoiceTotals clamps totals at 0', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 100, vatRate: 0, discountPercent: 50 }],
+    voucher: { code: 'HUGE', amount: 10000 },
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.total, 0);
+  assert.equal(r.value.subtotal, 100);
+  assert.equal(r.value.discount, 50);
+});
+
+test('invoiceTotals with 100% discount clamps total at 0', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 100 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 1000);
+  assert.equal(r.value.discount, 1000);
+  assert.equal(r.value.vat, 0);
+  assert.equal(r.value.total, 0);
+});
+
+test('invoiceTotals calculates VAT on a single line with no discount', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 0 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  const expected = Math.round(1000 * 21 / 100);
+  assert.equal(r.value.vat, expected);
+});
+
+test('invoiceTotals calculates VAT with 9% rate', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 1000, vatRate: 9, discountPercent: 0 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  const expected = Math.round(1000 * 9 / 100);
+  assert.equal(r.value.vat, expected);
+});
+
+test('invoiceTotals calculates VAT with 0% rate', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 1000, vatRate: 0, discountPercent: 0 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.vat, 0);
+});
+
+test('invoiceTotals applies VAT to amount after discount', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 10 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  const lineAmount = 1000 - 100;
+  const expectedVat = Math.round(lineAmount * 21 / 100);
+  assert.equal(r.value.vat, expectedVat);
+  assert.equal(r.value.total, 1000 - 100 + expectedVat);
+});
+
+test('invoiceTotals with multiple lines and different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { sku: 'SKU-001', qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+      { sku: 'SKU-002', qty: 1, unitPrice: 1000, vatRate: 9, discountPercent: 0 },
+    ],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  const vat1 = Math.round(1000 * 21 / 100);
+  const vat2 = Math.round(1000 * 9 / 100);
+  assert.equal(r.value.vat, vat1 + vat2);
+});
+
+test('invoiceTotals with voucher reduces total', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 1000, vatRate: 0, discountPercent: 0 }],
+    voucher: { code: 'SAVE10', amount: 100 },
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher, 100);
+  assert.equal(r.value.total, 900);
+});
+
+test('invoiceTotals with voucher and discount', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 1000, vatRate: 0, discountPercent: 10 }],
+    voucher: { code: 'SAVE50', amount: 50 },
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 1000);
+  assert.equal(r.value.discount, 100);
+  assert.equal(r.value.voucher, 50);
+  assert.equal(r.value.total, 1000 - 100 - 50);
+});
+
+test('invoiceTotals with multiple lines and voucher', () => {
+  const invoice = {
+    lines: [
+      { sku: 'SKU-001', qty: 1, unitPrice: 500, vatRate: 0, discountPercent: 0 },
+      { sku: 'SKU-002', qty: 1, unitPrice: 300, vatRate: 0, discountPercent: 0 },
+    ],
+    voucher: { code: 'CODE', amount: 100 },
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 800);
+  assert.equal(r.value.total, 700);
+});
+
+test('invoiceTotals with large voucher amount', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 1000, vatRate: 0, discountPercent: 0 }],
+    voucher: { code: 'BIG', amount: 2000 },
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.total, 0);
+});
+
+test('lineTotal returns integer in cents', () => {
+  const total = lineTotal({ qty: 3, unitPrice: 3333 });
+  assert.equal(Number.isInteger(total), true);
+  assert.equal(total, 9999);
+});
+
+test('invoiceTotals result is integer in cents', () => {
+  const invoice = {
+    lines: [{ sku: 'SKU-001', qty: 1, unitPrice: 333, vatRate: 0, discountPercent: 0 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(Number.isInteger(r.value.total), true);
+});
+
+test('invoiceTotals vat rounding per line', () => {
+  const invoice = {
+    lines: [
+      { sku: 'SKU-001', qty: 1, unitPrice: 100, vatRate: 21, discountPercent: 0 },
+      { sku: 'SKU-002', qty: 1, unitPrice: 100, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  const vat1 = Math.round(100 * 21 / 100);
+  const vat2 = Math.round(100 * 21 / 100);
+  assert.equal(r.value.vat, vat1 + vat2);
+});
