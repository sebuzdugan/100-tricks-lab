@@ -0,0 +1,45 @@
+import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line item: qty × unitPrice.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate totals for an invoice: subtotal, discount, VAT, voucher, and total.
+ * @param {{ lines: Array, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, voucher: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines)) {
+    return fail('INVALID_INVOICE');
+  }
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+  for (const line of invoice.lines) {
+    const lineGrossTotal = lineTotal(line);
+    subtotal += lineGrossTotal;
+    const discountPercent = line.discountPercent ?? 0;
+    const lineDiscount = roundCents(lineGrossTotal * discountPercent / 100);
+    discount += lineDiscount;
+    const lineAmount = Math.max(0, lineGrossTotal - lineDiscount);
+    const vatRate = line.vatRate ?? 0;
+    const lineVat = roundCents(lineAmount * vatRate / 100);
+    vat += lineVat;
+  }
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, roundCents(subtotal - discount + vat - voucher));
+  return ok({
+    subtotal: Math.max(0, subtotal),
+    discount: Math.max(0, discount),
+    vat: Math.max(0, vat),
+    voucher: Math.max(0, voucher),
+    total,
+  });
+}
