@@ -95,3 +96,49 @@ export function lateFee(invoice, asOf) {
 
   return roundCents(fee);
 }
+
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  const customerDueMap = new Map();
+  let outstanding = 0;
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] ?? 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDueMap.has(invoice.customerId)) {
+        customerDueMap.set(invoice.customerId, 0);
+      }
+      customerDueMap.set(invoice.customerId, customerDueMap.get(invoice.customerId) + due);
+    }
+  }
+
+  const overduList = overdueInvoices(invoices, asOf);
+  let overdueAmount = 0;
+  for (const item of overduList) {
+    overdueAmount += item.due;
+  }
+
+  const topCustomers = Array.from(customerDueMap, ([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overduList.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
