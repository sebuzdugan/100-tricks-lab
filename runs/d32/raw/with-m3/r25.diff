+      const discountStr = formatEuros(discountAmount);
+      lineStr += ` (-${line.discountPercent}% = ${discountStr})`;
+    }
+
+    lines.push(lineStr);
+  }
+
+  // Discount summary if any
+  if (totalsResult.value.discount > 0) {
