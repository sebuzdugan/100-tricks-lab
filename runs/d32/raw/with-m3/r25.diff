   // VAT
@@ -40,9 +55,27 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${vatStr}`);
   }
 
+  // Voucher
+  if (totalsResult.value.voucher > 0) {
+    const voucherStr = formatEuros(totalsResult.value.voucher);
+    lines.push(`Voucher: ${voucherStr}`);
+  }
+
   // Total
   const totalStr = formatEuros(totalsResult.value.total);
   lines.push(`Total: ${totalStr}`);
 
+  // Due date (only for issued or partially paid invoices)
+  if (invoice.dueDate && (invoice.status === 'issued' || invoice.status === 'partially_paid' || invoice.status === 'paid')) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid amount
+  if (Array.isArray(invoice.payments) && invoice.payments.length > 0) {
+    const paid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const paidStr = formatEuros(paid);
+    lines.push(`Paid: ${paidStr}`);
+  }
+
   return ok(lines.join('\n'));
 }
