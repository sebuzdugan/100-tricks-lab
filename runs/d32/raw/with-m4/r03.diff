+/**
+ * Add a line to an invoice (or increase qty if SKU already exists).
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} item
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) {
+    return fail('QTY_INVALID');
+  }
+
+  // Get product and validate SKU
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Create new lines array with the line added or updated
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+  const existingIndex = newLines.findIndex((line) => line.sku === sku);
+
+  if (existingIndex >= 0) {
+    // Update existing line
+    newLines[existingIndex] = {
+      ...newLines[existingIndex],
+      qty: newLines[existingIndex].qty + qty,
+    };
+  } else {
+    // Add new line
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  const index = invoice.lines.findIndex((line) => line.sku === sku);
+
+  if (index === -1) {
+    return fail('LINE_NOT_FOUND');
+  }
+
+  if (invoice.lines.length === 1) {
+    return fail('NO_LINES');
+  }
+
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: newLines,
+  });
+}
