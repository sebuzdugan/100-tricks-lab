diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..f00a4e9
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber finds the next available number', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber restarts counter for a new year', () => {
+  const existing = ['INV-2025-0099', 'INV-2025-0100'];
+  const number = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0050', 'INV-2026-0001', 'INV-2026-0002', 'INV-2027-0010'];
+  const number = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber handles out-of-order input', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber handles high counter values', () => {
+  const existing = ['INV-2026-9998', 'INV-2026-9999'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-ABC', 'INVALID', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber extracts year from issueDate', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(number, 'INV-2026-0001');
+});
