--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,25 @@
+/**
+ * Get the next invoice number for a given date.
+ * Invoice numbers are INV-<year>-<counter> where counter is 4 digits, zero-padded.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (e.g., ['INV-2026-0001', 'INV-2026-0002'])
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} The next invoice number (e.g., 'INV-2026-0003')
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Find all numbers for this year and extract their counters
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(`INV-${year}-`))
+    .map((num) => {
+      const parts = num.split('-');
+      return Number(parts[2]);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  // Find the highest counter, default to 0 if none exist
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
