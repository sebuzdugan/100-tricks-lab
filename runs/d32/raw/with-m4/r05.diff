+++ b/test/render.test.js
@@ -0,0 +1,189 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+  assert.ok(text.includes('5 ×'));
+  assert.ok(text.includes('Design work (hour)'));
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€425.00'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const text = renderInvoiceText(r2.value);
+  assert.ok(text.includes('INV-2026-0001'));
+  assert.ok(!text.includes('DRAFT'));
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('Kite & Co'));
+});
+
+test('renderInvoiceText formats amounts with formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  // Logo package is 120000 cents = €1,200.00
+  assert.ok(text.includes('€1,200.00'));
+});
+
+test('renderInvoiceText includes multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('5 ×'));
+  assert.ok(text.includes('3 ×'));
+  assert.ok(text.includes('2 ×'));
+  assert.ok(text.includes('Design work (hour)'));
+  assert.ok(text.includes('Development (hour)'));
+  assert.ok(text.includes('Copywriting (hour)'));
+});
+
+test('renderInvoiceText calculates correct total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  // DES-HOUR: 5 × 8500 = 42500 cents = €425.00
+  // DEV-HOUR: 3 × 9500 = 28500 cents = €285.00
+  // Total: 71000 cents = €710.00
+  assert.ok(text.includes('Total: €710.00'));
+});
+
+test('renderInvoiceText shows line totals', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  // Should show: 5 × Design work (hour) €85.00 €425.00
+  const lines = text.split('\n');
+  const itemLine = lines.find((l) => l.includes('Design work'));
+  assert.ok(itemLine.includes('€85.00'));
+  assert.ok(itemLine.includes('€425.00'));
+});
+
+test('renderInvoiceText shows small amounts correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  // STICKER: 50 cents each, 100 qty = 5000 cents = €50.00
+  assert.ok(text.includes('€0.50'));
+  assert.ok(text.includes('€50.00'));
+});
+
+test('renderInvoiceText with VAT-exempt products', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('Brand workshop (day, VAT exempt)'));
+  assert.ok(text.includes('€600.00'));
+  assert.ok(text.includes('Total: €1,200.00'));
+});
+
+test('renderInvoiceText output is a string with newlines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.equal(typeof text, 'string');
+  const lines = text.split('\n');
+  assert.ok(lines.length >= 4); // number, name, line item, total
+});
+
+test('renderInvoiceText handles unknown customer gracefully', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Unknown Customer'));
+  assert.ok(text.includes('C-999'));
+});
+
+test('renderInvoiceText structure is consistent', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const text = renderInvoiceText(r2.value);
+  const lines = text.split('\n');
+
+  // First line should be invoice number
+  assert.ok(lines[0].startsWith('INV-'));
+
+  // Second line should be customer name
+  assert.equal(lines[1], 'Kite & Co');
+
+  // Third and fourth lines should be line items
+  assert.ok(lines[2].includes('×'));
+  assert.ok(lines[3].includes('×'));
+
+  // Last line should start with Total:
+  assert.ok(lines[lines.length - 1].startsWith('Total:'));
+});
