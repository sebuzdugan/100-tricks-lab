+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('  C-007  '), 'C-007');
+  assert.equal(normalizeId('\tC-007\n'), 'C-007');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-007'), 'C-007');
+  assert.equal(normalizeId('c-001'), 'C-001');
+});
+
+test('normalizeId handles mixed case with spaces', () => {
+  assert.equal(normalizeId('  c-007 '), 'C-007');
+  assert.equal(normalizeId(' C-003'), 'C-003');
+});
+
+test('getCustomer accepts normalized IDs', () => {
+  const r1 = getCustomer('C-007');
+  const r2 = getCustomer('c-007');
+  const r3 = getCustomer(' C-007 ');
+  const r4 = getCustomer('  c-007  ');
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+  assert.equal(r3.ok, true);
+  assert.equal(r4.ok, true);
+  assert.equal(r1.value.name, r2.value.name);
+  assert.equal(r2.value.name, r3.value.name);
+  assert.equal(r3.value.name, r4.value.name);
+});
+
+test('getCustomer with normalized ID returns same customer', () => {
+  const r = getCustomer('  c-001  ');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Northwind Studio');
+  assert.equal(r.value.tier, 'gold');
+});
