+/**
+ * Check if a date string is valid and in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!match) return false;
+
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+
+  // Use UTC to avoid local timezone issues
+  const date = new Date(Date.UTC(year, month - 1, day));
+  return (
+    date.getUTCFullYear() === year &&
+    date.getUTCMonth() === month - 1 &&
+    date.getUTCDate() === day
+  );
+}
+
+/**
+ * Parse a YYYY-MM-DD date string into a Date object in UTC.
+ * Assumes the date string is valid (call isValidDate first if needed).
+ * @param {string} dateStr
+ * @returns {Date}
+ */
+function parseUtcDate(dateStr) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+  return new Date(Date.UTC(year, month - 1, day));
+}
+
+/**
+ * Format a Date object (interpreted as UTC) to YYYY-MM-DD string.
+ * @param {Date} date
+ * @returns {string}
+ */
+function formatUtcDate(date) {
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Add n days to a date string, returning a new date string in UTC.
+ * @param {string} dateStr in YYYY-MM-DD format
+ * @param {number} n number of days to add
+ * @returns {string} date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const date = parseUtcDate(dateStr);
+  date.setUTCDate(date.getUTCDate() + n);
+  return formatUtcDate(date);
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a).
+ * Both dates are interpreted as UTC.
+ * @param {string} a in YYYY-MM-DD format
+ * @param {string} b in YYYY-MM-DD format
+ * @returns {number} whole days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = parseUtcDate(a);
+  const dateB = parseUtcDate(b);
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB - dateA) / msPerDay);
+}
