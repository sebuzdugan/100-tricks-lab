diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..73db401
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,135 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid date', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-01-32'), false);
+});
+
+test('isValidDate rejects non-string', () => {
+  assert.equal(isValidDate(20261007), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+});
+
+test('isValidDate accepts valid leap year date', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+});
+
+test('isValidDate rejects invalid leap year date', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate rejects empty string', () => {
+  assert.equal(isValidDate(''), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+});
+
+test('addDays handles month boundary', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+});
+
+test('addDays handles year boundary', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+});
+
+test('addDays handles negative year boundary', () => {
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays across leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('daysBetween same date returns 0', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween next day returns 1', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+});
+
+test('daysBetween multiple days', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+});
+
+test('daysBetween backwards returns negative', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-01'), -6);
+});
+
+test('daysBetween across month boundary', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+});
+
+test('daysBetween across year boundary', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+});
+
+test('daysBetween across leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+});
+
+test('daysBetween large span', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-12-31'), 364);
+});
+
+test('addDays and daysBetween are inverse operations', () => {
+  const date = '2026-10-07';
+  const days = 42;
+  const newDate = addDays(date, days);
+  const diffDays = daysBetween(date, newDate);
+  assert.equal(diffDays, days);
+});
+
+test('addDays preserves format', () => {
+  const result = addDays('2026-10-07', 5);
+  assert.ok(/^\d{4}-\d{2}-\d{2}$/.test(result));
+});
+
+test('daysBetween handles UTC consistently', () => {
+  // These should not be affected by local timezone
+  const a = '2026-10-07';
+  const b = '2026-10-08';
+  const diff = daysBetween(a, b);
+  assert.equal(diff, 1);
+});
+
+test('addDays large positive number', () => {
+  const result = addDays('2026-01-01', 365);
+  assert.equal(result, '2027-01-01');
+});
+
+test('addDays large negative number', () => {
+  const result = addDays('2027-01-01', -365);
+  assert.equal(result, '2026-01-01');
+});
