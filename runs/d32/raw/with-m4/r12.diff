   const msPerDay = 24 * 60 * 60 * 1000;
   return Math.floor((dateB - dateA) / msPerDay);
 }
+
+/**
+ * Get the last day of the month for a given date string.
+ * @param {string} dateStr in YYYY-MM-DD format
+ * @returns {string} date of the last day of the month in YYYY-MM-DD format
+ */
+export function lastDayOfMonth(dateStr) {
+  const date = parseUtcDate(dateStr);
+  const year = date.getUTCFullYear();
+  const month = date.getUTCMonth();
+  const lastDay = new Date(Date.UTC(year, month + 1, 0));
+  return formatUtcDate(lastDay);
+}
