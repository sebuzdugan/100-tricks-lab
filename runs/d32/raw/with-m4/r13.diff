+
+/**
+ * Apply a voucher to an invoice.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array, terms: string, dueDate: string, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array, terms: string, dueDate: string, voucher: { code: string, amount: number } } } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Validate status is 'draft'
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Validate no existing voucher
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    terms: invoice.terms,
+    dueDate: invoice.dueDate,
+    voucher: { code, amount },
   });
 }
 
