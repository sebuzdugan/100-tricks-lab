+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue a test invoice
+function createTestInvoice(customerId, issueDate, qty = 5, terms = 'NET30') {
+  const invoiceResult = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty }],
+    terms,
+  });
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  return issuedResult.value;
+}
+
+test('statement returns empty list for customer with no invoices', () => {
+  const r = statement('C-001', [], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes issued invoices', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01');
+  const r = statement('C-001', [invoice], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, invoice.number);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01');
+  const r1 = recordPayment(invoice, { amount: 5000, date: '2026-10-10' });
+  const r = statement('C-001', [r1.value], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].due > 0, true);
+});
+
+test('statement excludes draft invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r = statement('C-001', [invoiceResult.value], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01');
+  const { total } = invoiceTotals(invoice);
+  const r1 = recordPayment(invoice, { amount: total, date: '2026-10-10' });
+  const r = statement('C-001', [r1.value], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement filters by asOf date', () => {
+  const invoice1 = createTestInvoice('C-001', '2026-10-01');
+  const invoice2 = createTestInvoice('C-001', '2026-10-15');
+  const invoice3 = createTestInvoice('C-001', '2026-10-30');
+  const r = statement('C-001', [invoice1, invoice2, invoice3], '2026-10-20');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-15');
+});
+
+test('statement includes invoice with issueDate equal to asOf', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-15');
+  const r = statement('C-001', [invoice], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement excludes invoice with issueDate after asOf', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-16');
+  const r = statement('C-001', [invoice], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoice1 = createTestInvoice('C-001', '2026-10-30');
+  const invoice2 = createTestInvoice('C-001', '2026-10-01');
+  const invoice3 = createTestInvoice('C-001', '2026-10-15');
+  const r = statement('C-001', [invoice1, invoice2, invoice3], '2026-10-31');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-15');
+  assert.equal(r.value.invoices[2].issueDate, '2026-10-30');
+});
+
+test('statement filters by customerId', () => {
+  const invoice1 = createTestInvoice('C-001', '2026-10-01');
+  const invoice2 = createTestInvoice('C-003', '2026-10-01');
+  const r = statement('C-001', [invoice1, invoice2], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement includes dueDate in response', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01', 5, 'NET14');
+  const r = statement('C-001', [invoice], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].dueDate, '2026-10-15');
+});
+
+test('statement includes total from invoiceTotals', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01');
+  const { total } = invoiceTotals(invoice);
+  const r = statement('C-001', [invoice], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].total, total);
+});
+
+test('statement due is balance after payments', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01');
+  const r1 = recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+  const r = statement('C-001', [r1.value], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  const { total } = invoiceTotals(r1.value);
+  assert.equal(r.value.invoices[0].due, total - 10000);
+});
+
+test('statement calculates totalDue as sum of all due amounts', () => {
+  const invoice1 = createTestInvoice('C-001', '2026-10-01');
+  const invoice2 = createTestInvoice('C-001', '2026-10-05');
+  const r = statement('C-001', [invoice1, invoice2], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  const expectedTotal = r.value.invoices[0].due + r.value.invoices[1].due;
+  assert.equal(r.value.totalDue, expectedTotal);
+});
+
+test('statement totalDue is zero when all invoices are paid', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01');
+  const { total } = invoiceTotals(invoice);
+  const r1 = recordPayment(invoice, { amount: total, date: '2026-10-10' });
+  const r = statement('C-001', [r1.value], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement normalizes customer ID', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01');
+  const r = statement('  c-001  ', [invoice], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement rejects unknown customer', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01');
+  const r = statement('C-999', [invoice], '2026-10-15');
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement with invoices from multiple customers and different statuses', () => {
+  const invoiceC001_Draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const invoiceC001_Issued = createTestInvoice('C-001', '2026-10-05');
+  const invoiceC003_Issued = createTestInvoice('C-003', '2026-10-03');
+
+  const r = statement('C-001', [invoiceC001_Draft, invoiceC001_Issued, invoiceC003_Issued], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-05');
+});
+
+test('statement with partially paid invoices across multiple dates', () => {
+  const invoice1 = createTestInvoice('C-001', '2026-10-01');
+  const invoice2 = createTestInvoice('C-001', '2026-10-10');
+
+  const r1_1 = recordPayment(invoice1, { amount: 20000, date: '2026-10-08' });
+  const r2_1 = recordPayment(invoice2, { amount: 10000, date: '2026-10-15' });
+
+  const r = statement('C-001', [r1_1.value, r2_1.value], '2026-10-20');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+  const { total: total1 } = invoiceTotals(r1_1.value);
+  const { total: total2 } = invoiceTotals(r2_1.value);
+  assert.equal(r.value.invoices[0].due, total1 - 20000);
+  assert.equal(r.value.invoices[1].due, total2 - 10000);
+  assert.equal(r.value.totalDue, total1 - 20000 + total2 - 10000);
+});
+
+test('statement includes invoices with vouchers', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const voucherResult = applyVoucher(invoiceResult.value, { code: 'SUMMER20', amount: 5000 });
+  const issuedResult = issueInvoice(voucherResult.value, []);
+
+  const r = statement('C-001', [issuedResult.value], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  const { total } = invoiceTotals(issuedResult.value);
+  assert.equal(r.value.invoices[0].total, total);
+});
