+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next credit note number for a given date.
+ * Credit note numbers are CN-<year>-<counter> where counter is 4 digits, zero-padded.
+ * @param {string[]} existingNumbers - Array of invoice and credit note numbers already used
+ * @param {string} date - Credit note date in YYYY-MM-DD format
+ * @returns {string} The next credit note number (e.g., 'CN-2026-0001')
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.substring(0, 4);
+
+  // Find all credit note numbers for this year and extract their counters
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(`CN-${year}-`))
+    .map((num) => {
+      const parts = num.split('-');
+      return Number(parts[2]);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  // Find the highest counter, default to 0 if none exist
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an invoice.
+ * @param {{ number: string, customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {string[]} existingNumbers - Array of invoice and credit note numbers already used
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice status is 'issued', 'partially_paid', or 'paid'
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate credit amount does not exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
