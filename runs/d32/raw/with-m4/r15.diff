@@ -0,0 +1,178 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue a test invoice
+function createTestInvoice(customerId, issueDate, qty = 5) {
+  const invoiceResult = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty }],
+  });
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  return issuedResult.value;
+}
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Partial refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, invoice.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Partial refund');
+  assert.equal(r.value.date, '2026-10-10');
+});
+
+test('createCreditNote creates a credit note for a partially_paid invoice', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const r1 = recordPayment(invoice, { amount: 10000, date: '2026-10-09' });
+  const r = createCreditNote(r1.value, { amount: 3000, reason: 'Overpayment', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote creates a credit note for a paid invoice', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const { total } = invoiceTotals(invoice);
+  const r1 = recordPayment(invoice, { amount: total, date: '2026-10-09' });
+  const r = createCreditNote(r1.value, { amount: 5000, reason: 'Return', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects credit on draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r = createCreditNote(invoiceResult.value, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const r = createCreditNote(invoice, { amount: -1000, reason: 'Refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const r = createCreditNote(invoice, { amount: 0, reason: 'Refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const r = createCreditNote(invoice, { amount: 1000.5, reason: 'Refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const { total } = invoiceTotals(invoice);
+  const r = createCreditNote(invoice, { amount: total + 1000, reason: 'Refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote accepts amount equal to invoice total', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const { total } = invoiceTotals(invoice);
+  const r = createCreditNote(invoice, { amount: total, reason: 'Full refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, total);
+});
+
+test('createCreditNote increments counter', () => {
+  const invoice1 = createTestInvoice('C-001', '2026-10-07');
+  const invoice2 = createTestInvoice('C-001', '2026-10-08');
+  const r1 = createCreditNote(invoice1, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, []);
+  const r2 = createCreditNote(invoice2, { amount: 3000, reason: 'Refund', date: '2026-10-10' }, [r1.value.number]);
+
+  assert.equal(r1.value.number, 'CN-2026-0001');
+  assert.equal(r2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote handles different years', () => {
+  const invoice1 = createTestInvoice('C-001', '2025-10-07');
+  const invoice2 = createTestInvoice('C-001', '2026-10-07');
+  const r1 = createCreditNote(invoice1, { amount: 5000, reason: 'Refund', date: '2025-10-10' }, []);
+  const r2 = createCreditNote(invoice2, { amount: 3000, reason: 'Refund', date: '2026-10-10' }, [r1.value.number]);
+
+  assert.equal(r1.value.number, 'CN-2025-0001');
+  assert.equal(r2.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote with mixed invoice and credit note numbers', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001'];
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, existingNumbers);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote preserves invoice information', () => {
+  const invoice = createTestInvoice('C-003', '2026-10-07');
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoiceNumber, invoice.number);
+  assert.equal(r.value.customerId, 'C-003');
+});
+
+test('createCreditNote with voucher-adjusted invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const voucherResult = applyVoucher(invoiceResult.value, { code: 'SUMMER20', amount: 5000 });
+  const issuedResult = issueInvoice(voucherResult.value, []);
+
+  const { total } = invoiceTotals(issuedResult.value);
+  const r = createCreditNote(issuedResult.value, { amount: total, reason: 'Full refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, total);
+});
+
+test('createCreditNote with different reasons', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const reasons = ['Partial refund', 'Quality issue', 'Customer request', 'Return'];
+
+  for (const reason of reasons) {
+    const r = createCreditNote(invoice, { amount: 1000, reason, date: '2026-10-10' }, []);
+    assert.equal(r.ok, true);
+    assert.equal(r.value.reason, reason);
+  }
+});
+
+test('createCreditNote with different dates', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-07');
+  const r1 = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2026-10-10' }, []);
+  const r2 = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2026-10-20' }, [r1.value.number]);
+
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+  assert.equal(r1.value.date, '2026-10-10');
+  assert.equal(r2.value.date, '2026-10-20');
+});
