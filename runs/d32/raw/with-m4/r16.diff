+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns empty array for no invoices', () => {
+  const result = overdueInvoices([], '2026-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices filters by status', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: 'INV-002', customerId: 'C-001', status: 'draft', dueDate: '2026-10-01', lines: [] },
+    { number: 'INV-003', customerId: 'C-001', status: 'paid', dueDate: '2026-10-01', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-001');
+});
+
+test('overdueInvoices includes partially_paid status', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: 'INV-002', customerId: 'C-001', status: 'partially_paid', dueDate: '2026-10-05', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 2);
+});
+
+test('overdueInvoices excludes future due dates', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: 'INV-002', customerId: 'C-001', status: 'issued', dueDate: '2026-10-20', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-001');
+});
+
+test('overdueInvoices excludes due date equal to asOf', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-15', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices returns correct fields', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.ok('number' in result[0]);
+  assert.ok('customerId' in result[0]);
+  assert.ok('dueDate' in result[0]);
+  assert.ok('daysOverdue' in result[0]);
+  assert.ok('due' in result[0]);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result[0].daysOverdue, 14);
+});
+
+test('overdueInvoices calculates due from balanceDue', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      status: 'issued',
+      dueDate: '2026-10-01',
+      lines: [{ qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result[0].due, 97708);
+});
+
+test('overdueInvoices with payment reduces due', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      status: 'partially_paid',
+      dueDate: '2026-10-01',
+      lines: [{ qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+      payments: [{ amount: 20000, date: '2026-10-10' }],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result[0].due, 77708);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: 'INV-002', customerId: 'C-001', status: 'issued', dueDate: '2026-10-05', lines: [] },
+    { number: 'INV-003', customerId: 'C-001', status: 'issued', dueDate: '2026-10-10', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result[0].number, 'INV-001');
+  assert.equal(result[0].daysOverdue, 14);
+  assert.equal(result[1].number, 'INV-002');
+  assert.equal(result[1].daysOverdue, 10);
+  assert.equal(result[2].number, 'INV-003');
+  assert.equal(result[2].daysOverdue, 5);
+});
+
+test('overdueInvoices with mixed overdue and current', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: 'INV-002', customerId: 'C-001', status: 'issued', dueDate: '2026-10-16', lines: [] },
+    { number: 'INV-003', customerId: 'C-001', status: 'issued', dueDate: '2026-10-10', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, 'INV-001');
+  assert.equal(result[1].number, 'INV-003');
+});
+
+test('overdueInvoices with different customers', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: 'INV-002', customerId: 'C-002', status: 'issued', dueDate: '2026-10-05', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[1].customerId, 'C-002');
+});
+
+test('overdueInvoices does not mutate input', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+  ];
+  const originalInvoices = JSON.parse(JSON.stringify(invoices));
+  overdueInvoices(invoices, '2026-10-15');
+  assert.deepEqual(invoices, originalInvoices);
+});
+
+test('overdueInvoices with zero balance due', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      status: 'partially_paid',
+      dueDate: '2026-10-01',
+      lines: [{ qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+      payments: [{ amount: 97708, date: '2026-10-10' }],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 0);
+});
+
+test('overdueInvoices with empty invoice array', () => {
+  const result = overdueInvoices([], '2026-10-20');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices with only draft invoices', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'draft', dueDate: '2026-10-01', lines: [] },
+    { number: 'INV-002', customerId: 'C-001', status: 'draft', dueDate: '2026-10-05', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices with only paid invoices', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'paid', dueDate: '2026-10-01', lines: [] },
+    { number: 'INV-002', customerId: 'C-001', status: 'paid', dueDate: '2026-10-05', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices large daysOverdue value', () => {
+  const invoices = [
+    { number: 'INV-001', customerId: 'C-001', status: 'issued', dueDate: '2026-01-01', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result[0].daysOverdue, 287);
+});
