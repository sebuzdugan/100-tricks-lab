+/**
+ * Get VAT summary for issued, partially_paid, and paid invoices.
+ * @param {Array} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate high to low
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  invoices
+    .filter(invoice => invoice.status === 'issued' || invoice.status === 'partially_paid' || invoice.status === 'paid')
+    .forEach(invoice => {
+      invoice.lines.forEach(line => {
+        const rate = line.vatRate;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVat(line);
+
+        if (!vatMap.has(rate)) {
+          vatMap.set(rate, { rate, base: 0, vat: 0 });
+        }
+        const entry = vatMap.get(rate);
+        entry.base += base;
+        entry.vat += vat;
+      });
+    });
+
+  return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
+}
