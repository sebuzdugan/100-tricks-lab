+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format an amount in cents as euros with 2 decimals and a dot.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatAmount(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: quote if it contains comma or quote, and double any quotes inside.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  if (field.includes(',') || field.includes('"')) {
+    return `"${field.replace(/"/g, '""')}"`;
+  }
+  return field;
+}
+
+/**
+ * Export invoices as CSV string.
+ * @param {Array} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  if (invoices.length === 0) {
+    return header;
+  }
+
+  const rows = invoices.map(invoice => {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number,
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatAmount(totals.subtotal),
+      formatAmount(totals.discount),
+      formatAmount(totals.vat),
+      formatAmount(totals.total),
+      formatAmount(due),
+    ];
+
+    return fields.map(escapeCsvField).join(',');
+  });
+
+  return header + rows.join('\n') + '\n';
+}
