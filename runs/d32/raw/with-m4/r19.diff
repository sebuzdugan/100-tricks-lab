+  const draft = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 100, unitPrice: 8500, vatRate: 21, discountPercent: 5 }],
+    terms: 'NET30',
+    dueDate: '2026-11-06',
+    number: 'INV-DRAFT',
+  };
+  const result = exportCsv([draft]);
+  assert.ok(result.includes('draft'));
+});
+
+test('exportCsv order preserved', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 50 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const r5 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-03',
+    lines: [{ sku: 'DES-HOUR', qty: 75 }],
+  });
+  const r6 = issueInvoice(r5.value, ['INV-2026-0001', 'INV-2026-0002']);
+  const result = exportCsv([r2.value, r4.value, r6.value]);
+  const lines = result.split('\n');
+  const inv1Index = lines.findIndex(l => l.includes('INV-2026-0001'));
+  const inv2Index = lines.findIndex(l => l.includes('INV-2026-0002'));
+  const inv3Index = lines.findIndex(l => l.includes('INV-2026-0003'));
+  assert.ok(inv1Index < inv2Index);
+  assert.ok(inv2Index < inv3Index);
+});
+
+test('exportCsv with payments reduces due', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const invoiceWithPayment = {
+    ...r2.value,
+    status: 'partially_paid',
+    payments: [{ amount: 50000, date: '2026-10-10' }],
+  };
+  const result = exportCsv([invoiceWithPayment]);
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  const due = parseFloat(fields[9]);
+  assert.ok(due < 900000);
+});
+
+test('exportCsv VAT-exempt invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
