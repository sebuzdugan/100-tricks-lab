+test('exportCsv amounts with cents', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-001',
+    lines: [{ qty: 1, unitPrice: 123, vatRate: 21, discountPercent: 0 }],
+    terms: 'NET30',
+    dueDate: '2026-11-06',
+  };
+  const result = exportCsv([invoice]);
+  assert.ok(result.includes('1.23'));
+});
+
+test('exportCsv fields in correct order', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const result = exportCsv([r2.value]);
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields[0], 'INV-2026-0001');
+  assert.ok(fields[1].includes('Studio'));
+  assert.equal(fields[2], '2026-10-07');
+  assert.equal(fields[3], '2026-11-06');
+  assert.equal(fields[4], 'issued');
+});
