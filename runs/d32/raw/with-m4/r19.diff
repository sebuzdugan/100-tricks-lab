+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('exportCsv returns string with header', () => {
+  const result = exportCsv([]);
+  assert.ok(typeof result === 'string');
+  assert.ok(result.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv empty array returns only header', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv single invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const result = exportCsv([r2.value]);
+  assert.ok(result.includes('INV-2026-0001'));
+  assert.ok(result.includes('Northwind Studio'));
+  assert.ok(result.includes('2026-10-07'));
+  assert.ok(result.includes('2026-11-06'));
+  assert.ok(result.includes('issued'));
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const result = exportCsv([r2.value]);
+  assert.ok(result.includes('8500.00'));
+});
+
+test('exportCsv ends lines with newline', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const result = exportCsv([r2.value]);
+  assert.ok(result.endsWith('\n'));
+});
+
+test('exportCsv multiple invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 50 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const result = exportCsv([r2.value, r4.value]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4);
+  assert.ok(lines[1].includes('INV-2026-0001'));
+  assert.ok(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv customer name appears in output', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const result = exportCsv([r2.value]);
+  assert.ok(result.includes('Northwind Studio'));
+});
+
+test('exportCsv handles customer with comma in name', () => {
+  const r = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const result = exportCsv([r2.value]);
+  assert.ok(result.includes('"Smith, Jones & Partners"'));
