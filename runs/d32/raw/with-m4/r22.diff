+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line: qty times unitPrice.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount for a single line: lineTotal times discountPercent / 100.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} Discount in cents, clamped to 0
+ */
+export function lineDiscount(line) {
+  const total = lineTotal(line);
+  const discountPercent = line.discountPercent ?? 0;
+  return Math.max(0, (total * discountPercent) / 100);
+}
+
+/**
+ * Calculate the VAT for a single line: (lineTotal - discount) * vatRate / 100, rounded per line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number} VAT in cents, rounded, clamped to 0
+ */
+export function lineVat(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = Math.max(0, total - discount);
+  const vatRate = line.vatRate ?? 0;
+  return Math.max(0, roundCents((amountAfterDiscount * vatRate) / 100));
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} All in cents
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
