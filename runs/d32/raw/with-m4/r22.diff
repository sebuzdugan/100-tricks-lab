+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+});
+
+test('lineTotal with qty 1', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 8500 }), 8500);
+});
+
+test('lineTotal with zero qty', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 8500 }), 0);
+});
+
+test('lineTotal with zero unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 0 }), 0);
+});
+
+test('lineDiscount calculates discount based on lineTotal', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 1000);
+});
+
+test('lineDiscount defaults to 0 when discountPercent is undefined', () => {
+  const line = { qty: 10, unitPrice: 1000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 0 discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 5% discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 5 };
+  assert.equal(lineDiscount(line), 500);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 10000);
+});
+
+test('lineDiscount clamps to 0 for negative result', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: -10 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 };
+  const subtotal = 100000;
+  const discount = 10000;
+  const afterDiscount = 90000;
+  const vat = Math.round((afterDiscount * 21) / 100);
+  assert.equal(lineVat(line), vat);
+});
+
+test('lineVat with 0 VAT rate', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat defaults discountPercent to 0', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21 };
+  const vat = Math.round((100000 * 21) / 100);
+  assert.equal(lineVat(line), vat);
+});
+
+test('lineVat with no discount', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21 };
+  assert.equal(lineVat(line), 21000);
+});
+
+test('lineVat with discount 100% and vatRate 21%', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 100, vatRate: 21 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat clamps to 0 for negative result', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 150, vatRate: 21 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat defaults vatRate to 0 if undefined', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 10 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('invoiceTotals calculates subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 3, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500 + 15000);
+});
+
+test('invoiceTotals calculates discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 10, unitPrice: 1000, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 1000 + 500);
+});
+
+test('invoiceTotals calculates VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 21000);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 2125);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals calculates total correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 100000;
+  const discount = 10000;
+  const afterDiscount = 90000;
+  const vat = 18900;
+  const expected = subtotal - discount + vat;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE10', amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 10000);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.total, 100000 + 21000 - 10000);
+});
+
+test('invoiceTotals without voucher defaults to 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals clamps total to 0 when voucher exceeds amount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'BIG', amount: 50000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with multiple lines and discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+      { qty: 3, unitPrice: 5000, discountPercent: 10, vatRate: 21 },
+      { qty: 2, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500 + 15000 + 20000);
+  assert.equal(totals.discount, 2125 + 1500 + 0);
+});
+
+test('invoiceTotals returns all components', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
+
+test('invoiceTotals with empty lines', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('lineTotal with large numbers', () => {
+  assert.equal(lineTotal({ qty: 1000000, unitPrice: 1000000 }), 1000000000000);
+});
+
+test('lineDiscount with fractional discount', () => {
+  const line = { qty: 3, unitPrice: 1000, discountPercent: 33.33 };
+  const expected = Math.max(0, (3000 * 33.33) / 100);
+  assert.equal(lineDiscount(line), expected);
+});
+
+test('invoiceTotals with zero amount invoice', () => {
+  const invoice = {
+    lines: [
+      { qty: 0, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.total, 0);
+});
