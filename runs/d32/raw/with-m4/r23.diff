 /**
- * Calculate the VAT for a single line: (lineTotal - discount) * vatRate / 100, rounded per line.
+ * Calculate bulk discount: 2.5% off for qty >= 10, applied after line discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} Bulk discount in cents, clamped to 0
+ */
+export function bulkDiscount(line) {
+  if (line.qty < 10) return 0;
+  const total = lineTotal(line);
+  const lineDisc = lineDiscount(line);
+  const afterLineDiscount = Math.max(0, total - lineDisc);
+  return Math.max(0, (afterLineDiscount * 2.5) / 100);
+}
+
+/**
+ * Calculate the VAT for a single line: (lineTotal - discount - bulkDiscount) * vatRate / 100, rounded per line.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
  * @returns {number} VAT in cents, rounded, clamped to 0
  */
 export function lineVat(line) {
