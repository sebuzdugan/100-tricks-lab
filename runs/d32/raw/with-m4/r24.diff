+
+/**
+ * Get dashboard summary of invoices.
+ * @param {Array} invoices
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {{ counts: object, outstanding: number, overdue: object, topCustomers: Array }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  invoices.forEach((invoice) => {
+    counts[invoice.status]++;
+  });
+
+  let outstanding = 0;
+  invoices.forEach((invoice) => {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      outstanding += balanceDue(invoice);
+    }
+  });
+
+  const overdue_invoices = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_invoices.length,
+    amount: overdue_invoices.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const customerDueMap = new Map();
+  invoices.forEach((invoice) => {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      if (!customerDueMap.has(invoice.customerId)) {
+        customerDueMap.set(invoice.customerId, 0);
+      }
+      customerDueMap.set(invoice.customerId, customerDueMap.get(invoice.customerId) + due);
+    }
+  });
+
+  const topCustomers = Array.from(customerDueMap.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return { counts, outstanding, overdue, topCustomers };
+}
