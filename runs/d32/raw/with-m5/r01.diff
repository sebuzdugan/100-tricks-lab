--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,65 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate that a date string is in YYYY-MM-DD format and is a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!m) return false;
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  return date.getUTCFullYear() === Number(m[1]) &&
+         date.getUTCMonth() === Number(m[2]) - 1 &&
+         date.getUTCDate() === Number(m[3]);
+}
+
+/**
+ * Validate that a quantity is a positive integer.
+ * @param {unknown} qty
+ * @returns {boolean}
+ */
+function isValidQty(qty) {
+  return Number.isInteger(qty) && qty > 0;
+}
+
+/**
+ * Create an invoice with enriched line items.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  const enrichedLines = [];
+  for (const line of lines) {
+    if (!isValidQty(line.qty)) return fail('QTY_INVALID');
+
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..4f714ed
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,160 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a valid draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2025-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[0].qty, 3);
+  assert.equal(result.value.lines[0].unitPrice, 8500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-06-30',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[1].name, 'Icon set (24 icons)');
+  assert.equal(result.value.lines[2].name, 'Brand workshop (day, VAT exempt)');
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice rejects unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  const cases = [
+    '2025/01/15',
+    '15-01-2025',
+    '2025-1-15',
+    '2025-01-5',
+    '01-15-2025',
+    'invalid',
+    '2025-02-30',
+    '2024-02-30',
+    '',
+    null,
+    undefined,
+  ];
+  for (const dateStr of cases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' }, `should reject ${JSON.stringify(dateStr)}`);
+  }
+});
+
+test('createInvoice accepts valid dates including leap years', () => {
+  const validDates = ['2024-02-29', '2025-01-01', '2099-12-31', '1970-01-01'];
+  for (const dateStr of validDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, true, `should accept ${dateStr}`);
+  }
+});
+
+test('createInvoice rejects missing lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [],
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects non-array lines', () => {
+  const cases = [undefined, null, {}, 'lines', 123];
+  for (const lines of cases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines,
+    });
+    assert.deepEqual(result, { ok: false, error: 'NO_LINES' }, `should reject ${JSON.stringify(lines)}`);
+  }
+});
+
+test('createInvoice rejects invalid quantities', () => {
+  const invalidQtys = [0, -1, -5, 0.5, 1.5, 3.14, 'three', null, undefined, {}, []];
+  for (const qty of invalidQtys) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    });
+    assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' }, `should reject qty ${JSON.stringify(qty)}`);
+  }
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'UNKNOWN', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice returns early on first error', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: 'invalid',
+    lines: [{ sku: 'UNKNOWN', qty: 0 }],
+  });
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice does not mutate arguments', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+  const linesCopy = JSON.stringify(lines);
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines,
+  });
+  assert.equal(JSON.stringify(lines), linesCopy);
+});
+
+test('createInvoice returns copies of lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  result.value.lines[0].name = 'MODIFIED';
+  const result2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result2.value.lines[0].name, 'Design work (hour)');
+});
