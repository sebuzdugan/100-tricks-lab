+++ b/src/numbering.js
@@ -0,0 +1,37 @@
+/**
+ * Extract the year from an issue date string.
+ * @param {string} issueDate
+ * @returns {string}
+ */
+function getYear(issueDate) {
+  return issueDate.substring(0, 4);
+}
+
+/**
+ * Parse the counter from an invoice number (INV-YYYY-CCCC).
+ * @param {string} number
+ * @returns {number | null}
+ */
+function parseCounter(number) {
+  const m = /^INV-(\d{4})-(\d{4})$/.exec(number);
+  if (!m) return null;
+  return Number(m[2]);
+}
+
+/**
+ * Get the next free invoice number for a given issue date.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = getYear(issueDate);
+  const countersThisYear = existingNumbers
+    .filter((n) => n.startsWith(`INV-${year}-`))
+    .map(parseCounter)
+    .filter((c) => c !== null);
+
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
