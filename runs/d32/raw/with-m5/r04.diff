diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..182b867
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,72 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for empty list', () => {
+  const result = nextInvoiceNumber([], '2025-01-15');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const existing = ['INV-2025-0001'];
+  const result = nextInvoiceNumber(existing, '2025-02-20');
+  assert.equal(result, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber increments from multiple existing numbers', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0003', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existing, '2025-06-30');
+  assert.equal(result, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0099', 'INV-2024-0050'];
+  const result = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0050', 'INV-2024-0060', 'INV-2025-0005'];
+  const result = nextInvoiceNumber(existing, '2025-06-30');
+  assert.equal(result, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber handles zero-padding correctly', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2025-000${i + 1}`);
+  const result = nextInvoiceNumber(existing, '2025-12-31');
+  assert.equal(result, 'INV-2025-0010');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2025-9998', 'INV-2025-9999'];
+  const result = nextInvoiceNumber(existing, '2025-06-30');
+  assert.equal(result, 'INV-2025-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2025-0001', 'INVALID', 'INV-2025', 'INV-2025-00aa'];
+  const result = nextInvoiceNumber(existing, '2025-06-30');
+  assert.equal(result, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber handles unsorted list', () => {
+  const existing = ['INV-2025-0005', 'INV-2025-0001', 'INV-2025-0003'];
+  const result = nextInvoiceNumber(existing, '2025-06-30');
+  assert.equal(result, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber handles year boundaries', () => {
+  const existing = [
+    'INV-2024-0099',
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2026-0001',
+  ];
+  const result2024 = nextInvoiceNumber(existing, '2024-12-31');
+  const result2025 = nextInvoiceNumber(existing, '2025-06-30');
+  const result2026 = nextInvoiceNumber(existing, '2026-03-15');
+
+  assert.equal(result2024, 'INV-2024-0100');
+  assert.equal(result2025, 'INV-2025-0003');
+  assert.equal(result2026, 'INV-2026-0002');
+});
