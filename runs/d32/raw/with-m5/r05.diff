new file mode 100644
index 0000000..97e220b
--- /dev/null
+++ b/src/render.js
@@ -0,0 +1,31 @@
+import { ok } from './result.js';
+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to customers.
+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }}
+ * @returns {{ ok: true, value: string }}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const customer = customerResult.value;
+  const number = invoice.number ?? 'DRAFT';
+  const totals = invoiceTotals(invoice);
+
+  const lines = [];
+  lines.push(number);
+  lines.push(customer.name);
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    lines.push(`${line.qty} ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`);
+  }
+
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return ok(lines.join('\n'));
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..afa5da2
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,195 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = renderInvoiceText(issued);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /^INV-2025-0001\n/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const text = result.value;
+  assert.match(text, /\nKite & Co\n/);
+});
+
+test('renderInvoiceText formats line items correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const text = result.value;
+  assert.match(text, /3 Design work \(hour\) @ €85\.00 = €255\.00/);
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'STICKER', qty: 10 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const text = result.value;
+  assert.match(text, /2 Design work \(hour\) @ €85\.00 = €170\.00/);
+  assert.match(text, /1 Development \(hour\) @ €95\.00 = €95\.00/);
+  assert.match(text, /10 Sticker sheet @ €0\.50 = €5\.00/);
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const text = result.value;
+  // 2 * 85.00 + 3 * 95.00 = 170.00 + 285.00 = 455.00
+  assert.match(text, /Total: €455\.00$/);
+});
+
+test('renderInvoiceText formats large amounts with thousands separator', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const text = result.value;
+  // LOGO-PACK is 120000 cents = €1200
+  assert.match(text, /2 Logo package @ €1,200\.00 = €2,400\.00/);
+});
+
+test('renderInvoiceText formats line totals correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'ICON-SET', qty: 5 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const text = result.value;
+  // ICON-SET is 980 cents = €9.80
+  assert.match(text, /5 Icon set \(24 icons\) @ €9\.80 = €49\.00/);
+});
+
+test('renderInvoiceText handles VAT-exempt products', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const text = result.value;
+  // WORKSHOP-DAY is 60000 cents = €600.00
+  assert.match(text, /1 Brand workshop \(day, VAT exempt\) @ €600\.00 = €600\.00/);
+  assert.match(text, /Total: €600\.00$/);
+});
+
+test('renderInvoiceText shows full structure', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-30',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 5);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.match(lines[2], /1 Design work \(hour\)/);
+  assert.match(lines[3], /2 Icon set \(24 icons\)/);
+  assert.match(lines[4], /^Total:/);
+});
+
+test('renderInvoiceText rejects unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    status: 'draft',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('renderInvoiceText formats amounts with two decimal places', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  const text = result.value;
+  // PHOTO-LIC is 996 cents = €9.96
+  assert.match(text, /1 Stock photo licence @ €9\.96 = €9\.96/);
+  assert.match(text, /Total: €9\.96$/);
+});
+
+test('renderInvoiceText works with issued invoice from issueInvoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2025-12-25',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, ['INV-2025-0001']).value;
+  const result = renderInvoiceText(issued);
+  const text = result.value;
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2025-0002');
+  assert.equal(lines[1], 'Orchard Health');
+  assert.match(lines[2], /2 Development \(hour\)/);
+});
