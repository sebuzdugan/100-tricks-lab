+
+test('createInvoice accepts discountPercent in lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 3, discountPercent: 10 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice accepts decimal discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 12.5 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 12.5);
+});
+
+test('createInvoice accepts 0 discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice accepts 100 discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 100 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 100);
+});
+
+test('createInvoice rejects discountPercent > 100', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 101 }],
