+/**
+ * Validate that a date string is in YYYY-MM-DD format and is a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!m) return false;
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  return date.getUTCFullYear() === Number(m[1]) &&
+         date.getUTCMonth() === Number(m[2]) - 1 &&
+         date.getUTCDate() === Number(m[3]);
+}
+
+/**
+ * Add n days to a date string (UTC).
+ * @param {string} date YYYY-MM-DD format
+ * @param {number} n number of days to add
+ * @returns {string} YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  const year = d.getUTCFullYear();
+  const month = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate the number of days between two dates (b - a) in whole days, using UTC.
+ * @param {string} a YYYY-MM-DD format
+ * @param {string} b YYYY-MM-DD format
+ * @returns {number} whole days (can be negative)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(`${a}T00:00:00Z`);
+  const dateB = new Date(`${b}T00:00:00Z`);
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
