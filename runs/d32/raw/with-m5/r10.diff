+++ b/test/dates.test.js
@@ -0,0 +1,138 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-01-15'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('1970-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+});
+
+test('isValidDate rejects invalid date formats', () => {
+  assert.equal(isValidDate('2025/01/15'), false);
+  assert.equal(isValidDate('15-01-2025'), false);
+  assert.equal(isValidDate('2025-1-15'), false);
+  assert.equal(isValidDate('2025-01-5'), false);
+  assert.equal(isValidDate('01-15-2025'), false);
+  assert.equal(isValidDate('invalid'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2024-02-30'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+});
+
+test('isValidDate rejects non-existent leap day', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2024-02-29'), true);
+});
+
+test('isValidDate rejects non-string inputs', () => {
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(123), false);
+  assert.equal(isValidDate({}), false);
+  assert.equal(isValidDate([]), false);
+});
+
+test('addDays adds days correctly', () => {
+  assert.equal(addDays('2025-01-15', 0), '2025-01-15');
+  assert.equal(addDays('2025-01-15', 1), '2025-01-16');
+  assert.equal(addDays('2025-01-15', 10), '2025-01-25');
+  assert.equal(addDays('2025-01-15', -1), '2025-01-14');
+  assert.equal(addDays('2025-01-15', -15), '2024-12-31');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+  assert.equal(addDays('2024-12-25', 7), '2025-01-01');
+});
+
+test('addDays handles large day offsets', () => {
+  assert.equal(addDays('2025-01-01', 365), '2026-01-01');
+  assert.equal(addDays('2025-01-01', -366), '2024-01-01');
+  assert.equal(addDays('2025-01-01', 1000), '2027-09-28');
+});
+
+test('addDays preserves zero-padding', () => {
+  const result = addDays('2025-01-05', 0);
+  assert.equal(result, '2025-01-05');
+  const resultMonth = addDays('2025-01-15', 15);
+  assert.equal(resultMonth, '2025-01-30');
+});
+
+test('daysBetween calculates difference correctly', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-15'), 0);
+  assert.equal(daysBetween('2025-01-15', '2025-01-16'), 1);
+  assert.equal(daysBetween('2025-01-15', '2025-01-25'), 10);
+  assert.equal(daysBetween('2025-01-25', '2025-01-15'), -10);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2025-01-31', '2025-02-01'), 1);
+  assert.equal(daysBetween('2025-02-01', '2025-01-31'), -1);
+  assert.equal(daysBetween('2025-01-31', '2025-02-28'), 28);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2024-12-31'), -1);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
+
+test('daysBetween handles large date ranges', () => {
+  assert.equal(daysBetween('2025-01-01', '2027-01-01'), 730);
+  assert.equal(daysBetween('2025-01-01', '2030-01-01'), 1826);
+});
+
+test('daysBetween uses UTC time', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-15'), 0);
+  assert.equal(daysBetween('2025-01-15', '2025-01-16'), 1);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const date1 = '2025-01-15';
+  const date2 = addDays(date1, 10);
+  assert.equal(daysBetween(date1, date2), 10);
+
+  const date3 = '2024-12-25';
+  const date4 = addDays(date3, -5);
+  assert.equal(daysBetween(date4, date3), 5);
+});
+
+test('addDays with negative days then positive recovers original', () => {
+  const original = '2025-06-15';
+  const intermediate = addDays(original, -30);
+  const restored = addDays(intermediate, 30);
+  assert.equal(restored, original);
+});
+
+test('daysBetween is transitive', () => {
+  const a = '2025-01-01';
+  const b = '2025-02-01';
+  const c = '2025-03-01';
+
+  const ab = daysBetween(a, b);
+  const bc = daysBetween(b, c);
+  const ac = daysBetween(a, c);
+
+  assert.equal(ac, ab + bc);
+});
