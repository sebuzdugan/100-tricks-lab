--- a/src/invoices.js
+++ b/src/invoices.js
@@ -24,18 +24,54 @@ function isValidDiscountPercent(discountPercent) {
   return typeof discountPercent === 'number' && discountPercent >= 0 && discountPercent <= 100;
 }
 
+/**
+ * Validate that terms are one of the valid options.
+ * @param {unknown} terms
+ * @returns {boolean}
+ */
+function isValidTerms(terms) {
+  return terms === 'NET14' || terms === 'NET30' || terms === 'EOM';
+}
+
+/**
+ * Calculate the due date based on terms and issue date.
+ * @param {string} issueDate - in YYYY-MM-DD format
+ * @param {string} terms - NET14, NET30, or EOM
+ * @returns {string} - due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  const date = new Date(issueDate + 'T00:00:00Z');
+
+  if (terms === 'NET14') {
+    date.setUTCDate(date.getUTCDate() + 14);
+  } else if (terms === 'NET30') {
+    date.setUTCDate(date.getUTCDate() + 30);
+  } else if (terms === 'EOM') {
+    const year = date.getUTCFullYear();
+    const month = date.getUTCMonth();
+    date.setUTCFullYear(year, month + 1, 0);
+  }
+
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
