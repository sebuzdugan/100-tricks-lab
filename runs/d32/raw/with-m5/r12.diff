+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number, discountPercent?: number }>, terms?: string }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }>, terms?: string, dueDate?: string } } | { ok: false, error: string }}
  */
-export function createInvoice({ customerId, issueDate, lines }) {
+export function createInvoice({ customerId, issueDate, lines, terms = 'NET30' }) {
   const normalizedCustomerId = normalizeId(customerId);
   const customerResult = getCustomer(normalizedCustomerId);
   if (!customerResult.ok) return customerResult;
 
   if (!isValidDate(issueDate)) return fail('DATE_INVALID');
 
+  if (!isValidTerms(terms)) return fail('TERMS_INVALID');
+
   if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
 
   const customer = customerResult.value;
@@ -66,10 +102,14 @@ export function createInvoice({ customerId, issueDate, lines }) {
     enrichedLines.push(enrichedLine);
   }
 
+  const dueDate = calculateDueDate(issueDate, terms);
+
   return ok({
     customerId: normalizedCustomerId,
     issueDate,
     status: 'draft',
+    terms,
+    dueDate,
     lines: enrichedLines,
   });
 }
