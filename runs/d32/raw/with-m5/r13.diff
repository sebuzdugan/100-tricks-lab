+/**
+ * Validate that an amount is a positive integer (in cents).
+ * @param {unknown} amount
+ * @returns {boolean}
+ */
+function isValidAmount(amount) {
+  return Number.isInteger(amount) && amount > 0;
+}
+
+/**
+ * Apply a voucher to an invoice.
+ * @param {{ status: string, voucher?: object, lines: Array<object> }} invoice
+ * @param {{ code: string, amount: number }}
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  if (!isValidAmount(amount)) return fail('AMOUNT_INVALID');
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
