+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+
+const baseInvoice = {
+  customerId: 'C-001',
+  number: '2025001',
+  issueDate: '2025-01-15',
+  dueDate: '2025-02-14',
+  status: 'issued',
+  lines: [
+    {
+      sku: 'DES-HOUR',
+      name: 'Design work (hour)',
+      qty: 1,
+      unitPrice: 10000,
+      vatRate: 21,
+      discountPercent: 0,
+    },
+  ],
+};
+
+test('statement returns invoices for a customer', () => {
+  const invoices = [baseInvoice];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, '2025001');
+});
+
+test('statement rejects unknown customer', () => {
+  const invoices = [baseInvoice];
+  const result = statement('C-999', invoices, '2025-02-01');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement normalizes customer ID', () => {
+  const invoices = [{ ...baseInvoice, customerId: 'C-001' }];
+  const result = statement('c-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement filters by status (issued)', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', status: 'issued' },
+    { ...baseInvoice, customerId: 'C-001', number: '2025002', issueDate: '2025-01-20', status: 'draft' },
+    { ...baseInvoice, customerId: 'C-001', number: '2025003', issueDate: '2025-01-25', status: 'paid' },
+  ];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, '2025001');
+});
+
+test('statement filters by status (partially_paid)', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', status: 'partially_paid', payments: [{ amount: 5000, date: '2025-01-20' }] },
+  ];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement excludes draft invoices', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', status: 'draft' },
+  ];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', status: 'paid', payments: [{ amount: 12100, date: '2025-02-01' }] },
+  ];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement filters by asOf date', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', number: '2025001', issueDate: '2025-01-15' },
+    { ...baseInvoice, customerId: 'C-001', number: '2025002', issueDate: '2025-02-01' },
+    { ...baseInvoice, customerId: 'C-001', number: '2025003', issueDate: '2025-03-01' },
+  ];
+  const result = statement('C-001', invoices, '2025-02-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, '2025001');
+  assert.equal(result.value.invoices[1].number, '2025002');
+});
+
+test('statement includes invoices with issueDate equal to asOf', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', issueDate: '2025-02-15' },
+  ];
+  const result = statement('C-001', invoices, '2025-02-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement sorts by issueDate', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', number: '2025003', issueDate: '2025-03-01' },
+    { ...baseInvoice, customerId: 'C-001', number: '2025001', issueDate: '2025-01-15' },
+    { ...baseInvoice, customerId: 'C-001', number: '2025002', issueDate: '2025-02-01' },
+  ];
+  const result = statement('C-001', invoices, '2025-03-15');
+  assert.equal(result.ok, true);
+  assert.deepEqual(
+    result.value.invoices.map(inv => inv.number),
+    ['2025001', '2025002', '2025003']
+  );
+});
+
+test('statement includes number, issueDate, dueDate, total, and due', () => {
+  const invoices = [baseInvoice];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  const invoice = result.value.invoices[0];
+  assert.ok(invoice.number);
+  assert.ok(invoice.issueDate);
+  assert.ok(invoice.dueDate);
+  assert.ok(typeof invoice.total === 'number');
+  assert.ok(typeof invoice.due === 'number');
+});
+
+test('statement calculates due correctly for unpaid invoice', () => {
+  const invoices = [baseInvoice];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  const invoice = result.value.invoices[0];
+  assert.equal(invoice.due, 12100);
+});
+
+test('statement calculates due correctly for partially paid invoice', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', status: 'partially_paid', payments: [{ amount: 5000, date: '2025-01-20' }] },
+  ];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  const invoice = result.value.invoices[0];
+  assert.equal(invoice.due, 7100);
+});
+
+test('statement calculates totalDue as sum of due', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', number: '2025001', issueDate: '2025-01-15' },
+    { ...baseInvoice, customerId: 'C-001', number: '2025002', issueDate: '2025-02-01', status: 'partially_paid', payments: [{ amount: 5000, date: '2025-02-10' }] },
+  ];
+  const result = statement('C-001', invoices, '2025-02-15');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.totalDue, 12100 + 7100);
+});
+
+test('statement returns empty invoices list when none match', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', status: 'draft' },
+  ];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement filters by customer ID', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001' },
+    { ...baseInvoice, customerId: 'C-003', number: '2025002' },
+  ];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, '2025001');
+});
+
+test('statement with voucher reduces total and due', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', voucher: { code: 'WELCOME10', amount: 1000 } },
+  ];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  const invoice = result.value.invoices[0];
+  assert.equal(invoice.total, 12100 - 1000);
+  assert.equal(invoice.due, 12100 - 1000);
+});
+
+test('statement with multiple invoices different statuses', () => {
+  const invoices = [
+    { ...baseInvoice, customerId: 'C-001', number: '2025001', issueDate: '2025-01-15', status: 'issued' },
+    { ...baseInvoice, customerId: 'C-001', number: '2025002', issueDate: '2025-02-01', status: 'partially_paid', payments: [{ amount: 3000, date: '2025-02-10' }] },
+    { ...baseInvoice, customerId: 'C-001', number: '2025003', issueDate: '2025-02-15', status: 'draft' },
+    { ...baseInvoice, customerId: 'C-001', number: '2025004', issueDate: '2025-03-01', status: 'issued' },
+  ];
+  const result = statement('C-001', invoices, '2025-02-28');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.deepEqual(
+    result.value.invoices.map(inv => inv.number),
+    ['2025001', '2025002']
+  );
+  assert.equal(result.value.totalDue, 12100 + 9100);
+});
+
+test('statement handles customer ID case insensitivity', () => {
+  const invoices = [baseInvoice];
+  const result = statement('C-001', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement handles customer ID with spaces', () => {
+  const invoices = [{ ...baseInvoice, customerId: 'C-001' }];
+  const result = statement(' c-001 ', invoices, '2025-02-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
