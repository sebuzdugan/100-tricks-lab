diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..9c165d8
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,181 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+
+const baseInvoice = {
+  status: 'issued',
+  number: 'INV-2025-0001',
+  customerId: 'C-001',
+  issueDate: '2025-01-15',
+  dueDate: '2025-02-14',
+  lines: [
+    {
+      sku: 'DES-HOUR',
+      name: 'Design work (hour)',
+      qty: 1,
+      unitPrice: 10000,
+      vatRate: 21,
+      discountPercent: 0,
+    },
+  ],
+};
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const result = createCreditNote(baseInvoice, { amount: 5000, reason: 'Partial refund', date: '2025-02-01' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2025-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2025-02-01');
+});
+
+test('createCreditNote creates a credit note for a partially_paid invoice', () => {
+  const invoice = { ...baseInvoice, status: 'partially_paid', payments: [{ amount: 5000, date: '2025-01-20' }] };
+  const result = createCreditNote(invoice, { amount: 3000, reason: 'Adjustment', date: '2025-02-01' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+  assert.equal(result.value.amount, 3000);
+});
+
+test('createCreditNote creates a credit note for a paid invoice', () => {
+  const invoice = { ...baseInvoice, status: 'paid', payments: [{ amount: 12100, date: '2025-02-01' }] };
+  const result = createCreditNote(invoice, { amount: 2000, reason: 'Full refund', date: '2025-02-15' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const invoice = { ...baseInvoice, status: 'draft' };
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2025-02-01' }, []);
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects negative amounts', () => {
+  const result = createCreditNote(baseInvoice, { amount: -1000, reason: 'Refund', date: '2025-02-01' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects zero amounts', () => {
+  const result = createCreditNote(baseInvoice, { amount: 0, reason: 'Refund', date: '2025-02-01' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects non-integer amounts', () => {
+  const result = createCreditNote(baseInvoice, { amount: 1000.5, reason: 'Refund', date: '2025-02-01' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects credit amount exceeding invoice total', () => {
+  const result = createCreditNote(baseInvoice, { amount: 15000, reason: 'Refund', date: '2025-02-01' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote accepts credit equal to invoice total', () => {
+  const result = createCreditNote(baseInvoice, { amount: 12100, reason: 'Full refund', date: '2025-02-01' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 12100);
+});
+
+test('createCreditNote numbers with CN-YYYY-CCCC format', () => {
+  const result = createCreditNote(baseInvoice, { amount: 1000, reason: 'Adjustment', date: '2025-02-01' }, []);
+  assert.equal(result.ok, true);
+  assert.match(result.value.number, /^CN-\d{4}-\d{4}$/);
+});
+
+test('createCreditNote increments counter for same year', () => {
+  const existingNumbers = ['CN-2025-0001'];
+  const result = createCreditNote(baseInvoice, { amount: 1000, reason: 'Adjustment', date: '2025-02-15' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0002');
+});
+
+test('createCreditNote increments counter with multiple existing credit notes', () => {
+  const existingNumbers = ['CN-2025-0001', 'CN-2025-0002', 'CN-2025-0005'];
+  const result = createCreditNote(baseInvoice, { amount: 1000, reason: 'Adjustment', date: '2025-03-01' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0006');
+});
+
+test('createCreditNote ignores invoice numbers in counter', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001'];
+  const result = createCreditNote(baseInvoice, { amount: 1000, reason: 'Adjustment', date: '2025-02-01' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0002');
+});
+
+test('createCreditNote has separate counter per year', () => {
+  const existingNumbers = ['CN-2024-0001', 'CN-2024-0002', 'CN-2025-0001'];
+  const invoice = { ...baseInvoice, issueDate: '2025-01-15' };
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Adjustment', date: '2025-02-01' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0002');
+});
+
+test('createCreditNote new year starts at 0001', () => {
+  const existingNumbers = ['CN-2025-0001', 'CN-2025-0002'];
+  const invoice = { ...baseInvoice, issueDate: '2026-01-15' };
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Adjustment', date: '2026-01-15' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote pads counter with leading zeros', () => {
+  const existingNumbers = Array.from({ length: 999 }, (_, i) => `CN-2025-${String(i + 1).padStart(4, '0')}`);
+  const result = createCreditNote(baseInvoice, { amount: 1000, reason: 'Adjustment', date: '2025-12-01' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-1000');
+});
+
+test('createCreditNote with invoice containing discount', () => {
+  const invoice = {
+    ...baseInvoice,
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 2,
+        unitPrice: 10000,
+        vatRate: 21,
+        discountPercent: 10,
+      },
+    ],
+  };
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Adjustment', date: '2025-02-01' }, []);
+  assert.equal(result.ok, true);
+  const invoiceTotal = 2 * 10000 - (2 * 10000 * 0.1) + ((2 * 10000 - (2 * 10000 * 0.1)) * 0.21);
+  assert(result.value.amount <= invoiceTotal);
+});
+
+test('createCreditNote with invoice containing voucher', () => {
+  const invoice = {
+    ...baseInvoice,
+    voucher: { code: 'WELCOME', amount: 1000 },
+  };
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2025-02-01' }, []);
+  assert.equal(result.ok, true);
+  const invoiceTotal = 12100 - 1000;
+  assert(result.value.amount <= invoiceTotal);
+});
+
+test('createCreditNote credit cannot exceed total after voucher deduction', () => {
+  const invoice = {
+    ...baseInvoice,
+    voucher: { code: 'WELCOME', amount: 2000 },
+  };
+  const result = createCreditNote(invoice, { amount: 12000, reason: 'Refund', date: '2025-02-01' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote includes all required fields', () => {
+  const result = createCreditNote(baseInvoice, { amount: 5000, reason: 'Refund', date: '2025-02-01' }, []);
+  assert.equal(result.ok, true);
+  const creditNote = result.value;
+  assert.ok(creditNote.number);
+  assert.ok(creditNote.invoiceNumber);
+  assert.ok(creditNote.customerId);
+  assert.ok(typeof creditNote.amount === 'number');
+  assert.ok(creditNote.reason);
+  assert.ok(creditNote.date);
+});
