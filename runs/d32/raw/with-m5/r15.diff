@@ -0,0 +1,82 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Extract the year from a date string.
+ * @param {string} date
+ * @returns {string}
+ */
+function getYear(date) {
+  return date.substring(0, 4);
+}
+
+/**
+ * Parse the counter from a credit note number (CN-YYYY-CCCC).
+ * @param {string} number
+ * @returns {number | null}
+ */
+function parseCreditNoteCounter(number) {
+  const m = /^CN-(\d{4})-(\d{4})$/.exec(number);
+  if (!m) return null;
+  return Number(m[2]);
+}
+
+/**
+ * Validate that an amount is a positive integer (in cents).
+ * @param {unknown} amount
+ * @returns {boolean}
+ */
+function isValidAmount(amount) {
+  return Number.isInteger(amount) && amount > 0;
+}
+
+/**
+ * Get the next free credit note number for a given date.
+ * @param {Array<string>} existingNumbers
+ * @param {string} date
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = getYear(date);
+  const countersThisYear = existingNumbers
+    .filter((n) => n.startsWith(`CN-${year}-`))
+    .map(parseCreditNoteCounter)
+    .filter((c) => c !== null);
+
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array<object>, payments?: Array<object>, voucher?: object }} invoice
+ * @param {{ amount: number, reason: string, date: string }}
+ * @param {Array<string>} existingNumbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!isValidAmount(amount)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const invoiceTotal = invoiceTotals(invoice).total;
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
