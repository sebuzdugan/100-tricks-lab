+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices filters by status', () => {
+  const invoices = [
+    { number: '1', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: '2', customerId: 'C-001', status: 'draft', dueDate: '2026-10-01', lines: [] },
+    { number: '3', customerId: 'C-001', status: 'paid', dueDate: '2026-10-01', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, '1');
+});
+
+test('overdueInvoices includes partially_paid', () => {
+  const invoices = [
+    { number: '1', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: '2', customerId: 'C-001', status: 'partially_paid', dueDate: '2026-10-02', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, '1');
+  assert.equal(result[1].number, '2');
+});
+
+test('overdueInvoices filters by dueDate', () => {
+  const invoices = [
+    { number: '1', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: '2', customerId: 'C-001', status: 'issued', dueDate: '2026-10-05', lines: [] },
+    { number: '3', customerId: 'C-001', status: 'issued', dueDate: '2026-10-08', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result.length, 2);
+  assert(result.every(inv => inv.dueDate < '2026-10-07'));
+});
+
+test('overdueInvoices calculates daysOverdue', () => {
+  const invoices = [
+    { number: '1', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: '2', customerId: 'C-001', status: 'issued', dueDate: '2026-10-05', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result[0].daysOverdue, 6);
+  assert.equal(result[1].daysOverdue, 2);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const invoices = [
+    { number: '1', customerId: 'C-001', status: 'issued', dueDate: '2026-10-05', lines: [] },
+    { number: '2', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+    { number: '3', customerId: 'C-001', status: 'issued', dueDate: '2026-10-03', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.deepEqual(result.map(r => r.number), ['2', '3', '1']);
+});
+
+test('overdueInvoices calculates due amount', () => {
+  const invoices = [
+    {
+      number: '1',
+      customerId: 'C-001',
+      status: 'issued',
+      dueDate: '2026-10-01',
+      lines: [
+        { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 20 },
+      ],
+    },
+    {
+      number: '2',
+      customerId: 'C-001',
+      status: 'issued',
+      dueDate: '2026-10-02',
+      lines: [
+        { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 20 },
+      ],
+      payments: [
+        { amount: 600, date: '2026-10-05' },
+      ],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].due, 1200);
+  assert.equal(result[1].due, 600);
+});
+
+test('overdueInvoices returns empty for no overdue invoices', () => {
+  const invoices = [
+    { number: '1', customerId: 'C-001', status: 'issued', dueDate: '2026-10-08', lines: [] },
+    { number: '2', customerId: 'C-001', status: 'issued', dueDate: '2026-10-09', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes customerId in result', () => {
+  const invoices = [
+    { number: '1', customerId: 'C-123', status: 'issued', dueDate: '2026-10-01', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result[0].customerId, 'C-123');
+});
+
+test('overdueInvoices includes dueDate in result', () => {
+  const invoices = [
+    { number: '1', customerId: 'C-001', status: 'issued', dueDate: '2026-10-01', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2026-10-07');
+  assert.equal(result[0].dueDate, '2026-10-01');
+});
