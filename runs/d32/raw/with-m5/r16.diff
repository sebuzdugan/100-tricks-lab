diff --git a/src/reports.js b/src/reports.js
new file mode 100644
index 0000000..db53188
--- /dev/null
+++ b/src/reports.js
@@ -0,0 +1,16 @@
+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter(inv => ['issued', 'partially_paid'].includes(inv.status))
+    .filter(inv => inv.dueDate < asOf)
+    .map(inv => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
diff --git a/test/reports.test.js b/test/reports.test.js
