@@ -14,3 +16,34 @@ export function overdueInvoices(invoices, asOf) {
     }))
     .sort((a, b) => b.daysOverdue - a.daysOverdue);
 }
+
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) continue;
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const subtotal = lineTotal(line);
+      const discount = line.discountPercent ? subtotal * line.discountPercent / 100 : 0;
+      const base = Math.max(0, subtotal - discount);
+      const vat = lineVat(line);
+
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { rate, base: 0, vat: 0 });
+      }
+      const entry = vatMap.get(rate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  return Array.from(vatMap.values())
+    .map(entry => ({
+      rate: entry.rate,
+      base: roundCents(entry.base),
+      vat: roundCents(entry.vat),
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
