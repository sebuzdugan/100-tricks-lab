+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv includes header line', () => {
+  const invoices = [];
+  const result = exportCsv(invoices);
+  assert(result.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 20 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert(lines[1].startsWith('INV-001,Northwind Studio'));
+});
+
+test('exportCsv uses customer name not ID', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-003',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  assert(result.includes('Kite & Co'));
+  assert(!result.includes('C-003'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 1234, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  assert(result.includes('12.34'));
+});
+
+test('exportCsv includes subtotal, discount, vat, total, due', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 1000, discountPercent: 10, vatRate: 20 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  const dataLine = result.split('\n')[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields[5], '10.00');
+  assert.equal(fields[6], '1.00');
+  assert.equal(fields[7], '1.80');
+  assert.equal(fields[8], '10.80');
+  assert.equal(fields[9], '10.80');
+});
+
+test('exportCsv escapes commas in customer name', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-004',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  assert(result.includes('"'));
+});
+
+test('exportCsv escapes double quotes', () => {
+  const invoices = [
+    {
+      number: 'INV-"001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  assert(result.includes('""'));
+});
+
+test('exportCsv handles multiple invoices', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    },
+    {
+      number: 'INV-002',
+      customerId: 'C-003',
+      issueDate: '2026-10-02',
+      dueDate: '2026-10-31',
+      status: 'draft',
+      lines: [{ qty: 1, unitPrice: 500, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4);
+  assert(lines[1].startsWith('INV-001'));
+  assert(lines[2].startsWith('INV-002'));
+});
+
+test('exportCsv accounts for payments in due', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'partially_paid',
+      lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+      payments: [{ amount: 300, date: '2026-10-05' }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  const dataLine = result.split('\n')[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields[9], '7.00');
+});
+
+test('exportCsv lines end with newline', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  assert(result.endsWith('\n'));
+  assert(!result.endsWith('\n\n'));
+});
+
+test('exportCsv handles empty invoices array', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invoices = [
+    {
+      number: 'INV-003',
+      customerId: 'C-001',
+      issueDate: '2026-10-03',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+    {
+      number: 'INV-002',
+      customerId: 'C-001',
+      issueDate: '2026-10-02',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+  assert(lines[1].startsWith('INV-003'));
+  assert(lines[2].startsWith('INV-001'));
+  assert(lines[3].startsWith('INV-002'));
+});
+
+test('exportCsv includes all required fields in order', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 20 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  const dataLine = result.split('\n')[1];
+  const fields = dataLine.split(',').slice(0, 10);
+  assert.equal(fields.length, 10);
+  assert.equal(fields[0], 'INV-001');
+  assert.equal(fields[2], '2026-10-01');
+  assert.equal(fields[3], '2026-10-31');
+  assert.equal(fields[4], 'issued');
+});
+
+test('exportCsv handles amounts ending in 0', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 1200, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = exportCsv(invoices);
+  assert(result.includes('12.00'));
+});
+
+test('exportCsv handles vouchers in total', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+      voucher: { code: 'SAVE10', amount: 100 },
+    },
+  ];
+  const result = exportCsv(invoices);
+  const dataLine = result.split('\n')[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields[8], '9.00');
+});
