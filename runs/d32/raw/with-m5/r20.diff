+
+test('RATES has EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR is 1:1', () => {
+  const result = convert(1000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1000);
+});
+
+test('convert EUR to USD applies rate', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 108);
+});
+
+test('convert EUR to GBP applies rate', () => {
+  const result = convert(1000, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 842);
+});
+
+test('convert returns error for unknown currency', () => {
+  const result = convert(1000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert handles negative amounts', () => {
+  const result = convert(-1000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -1085);
+});
+
+test('convert rounds results', () => {
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1);
+});
+
+test('convert with large amount', () => {
+  const result = convert(123456, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 133950);
+});
+
+test('formatMoney uses € for EUR', () => {
+  const formatted = formatMoney(123456, 'EUR');
+  assert(formatted.includes('€'));
+  assert.equal(formatted, '€1,234.56');
+});
+
+test('formatMoney uses $ for USD', () => {
+  const formatted = formatMoney(123456, 'USD');
+  assert(formatted.includes('$'));
+  assert.equal(formatted, '$1,234.56');
+});
+
+test('formatMoney uses £ for GBP', () => {
+  const formatted = formatMoney(123456, 'GBP');
+  assert(formatted.includes('£'));
+  assert.equal(formatted, '£1,234.56');
+});
+
+test('formatMoney handles negative amounts', () => {
+  const formatted = formatMoney(-5, 'EUR');
+  assert.equal(formatted, '-€0.05');
+});
+
+test('formatMoney handles small amounts', () => {
+  const formatted = formatMoney(1, 'USD');
+  assert.equal(formatted, '$0.01');
+});
+
+test('formatMoney handles zero', () => {
+  const formatted = formatMoney(0, 'GBP');
+  assert.equal(formatted, '£0.00');
+});
+
+test('formatMoney adds thousands separator', () => {
+  const formatted = formatMoney(1234567, 'EUR');
+  assert(formatted.includes(','));
