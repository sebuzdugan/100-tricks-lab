+
+test('mergeCustomers removes fromId customer and reassigns invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'A', email: 'a@x.y' },
+    { id: 'C-002', name: 'B', email: 'b@x.y' },
+    { id: 'C-003', name: 'C', email: 'c@x.y' },
+  ];
+  const invoices = [
+    { id: 'INV-1', customerId: 'C-001' },
+    { id: 'INV-2', customerId: 'C-002' },
+    { id: 'INV-3', customerId: 'C-001' },
+  ];
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, 2);
+  assert.deepEqual(
+    r.value.customers.map((c) => c.id),
+    ['C-002', 'C-003']
+  );
+  assert.deepEqual(
+    r.value.invoices.map((inv) => ({ id: inv.id, customerId: inv.customerId })),
+    [
+      { id: 'INV-1', customerId: 'C-002' },
+      { id: 'INV-2', customerId: 'C-002' },
+      { id: 'INV-3', customerId: 'C-002' },
+    ]
+  );
+});
+
