+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  assert.equal(lineTotal({ qty: 3, unitPrice: 8500 }), 25500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 120000 }), 120000);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 50 }), 500);
+});
+
+test('lineTotal handles single unit', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 9500 }), 9500);
+});
+
+test('lineTotal handles zero price', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 0 }), 0);
+});
+
+test('lineVat calculates VAT on line subtotal', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 21 };
+  assert.equal(lineVat(line), 2100);
+});
+
+test('lineVat calculates VAT on discounted amount', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 10 };
+  const subtotal = 10000;
+  const afterDiscount = subtotal * 0.9;
+  const vat = afterDiscount * 0.21;
+  assert.equal(lineVat(line), Math.round(vat * 1e6) / 1e6 === 1890 ? 1890 : 1890);
+});
+
+test('lineVat with zero VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with 9% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 9 };
+  assert.equal(lineVat(line), 900);
+});
+
+test('lineVat rounds to whole cents', () => {
+  const line = { qty: 3, unitPrice: 333, vatRate: 21 };
+  const subtotal = 999;
+  const vat = subtotal * 0.21;
+  assert.equal(lineVat(line), 210);
+});
+
+test('invoiceTotals sums line totals', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 3, unitPrice: 8500, vatRate: 21, discountPercent: 0 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 2, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 3 * 8500 + 2 * 9500);
+  assert.equal(totals.subtotal, 44500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, Math.round(44500 * 0.21));
+  assert.equal(totals.total, 44500 + totals.vat);
+});
+
+test('invoiceTotals handles single line', () => {
