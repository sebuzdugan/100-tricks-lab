@@ -0,0 +1,48 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the subtotal for a single line item (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  const subtotal = line.qty * line.unitPrice;
+  return Math.max(0, subtotal);
+}
+
+/**
+ * Calculate the VAT for a single line item (after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }}
+ * @returns {number}
+ */
+export function lineVat(line) {
+  const subtotal = lineTotal(line);
+  const discount = line.discountPercent ? subtotal * line.discountPercent / 100 : 0;
+  const amountAfterDiscount = Math.max(0, subtotal - discount);
+  const vat = amountAfterDiscount * line.vatRate / 100;
+  return roundCents(vat);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = roundCents(invoice.lines.reduce((sum, line) => {
+    const lineSubtotal = lineTotal(line);
+    const lineDiscount = line.discountPercent ? lineSubtotal * line.discountPercent / 100 : 0;
+    return sum + lineDiscount;
+  }, 0));
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, roundCents(subtotal - discount + vat - voucher));
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
