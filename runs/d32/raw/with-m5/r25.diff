diff --git a/src/render.js b/src/render.js
index df4ab3c..cc2afb4 100644
--- a/src/render.js
+++ b/src/render.js
@@ -2,6 +2,7 @@ import { ok } from './result.js';
 import { getCustomer } from './customers.js';
 import { formatEuros } from './money.js';
 import { lineTotal, invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
 
 /**
  * Render an invoice as plain text for display to customers.
@@ -22,13 +23,31 @@ export function renderInvoiceText(invoice) {
 
   for (const line of invoice.lines) {
     const total = lineTotal(line);
-    lines.push(`${line.qty} ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`);
+    let lineText = `${line.qty} ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    if (line.discountPercent && line.discountPercent > 0) {
+      lineText += ` (${line.discountPercent}% off)`;
+    }
+    lines.push(lineText);
   }
 
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(totals.voucher)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const amountPaid = balanceDue(invoice) === 0 ? totals.total : totals.total - balanceDue(invoice);
+    lines.push(`Paid: ${formatEuros(amountPaid)}`);
+  }
+
   return ok(lines.join('\n'));
 }
