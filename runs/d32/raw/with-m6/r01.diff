+++ b/test/invoices.test.js
@@ -0,0 +1,230 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2024-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+
+  const line = result.value.lines[0];
+  assert.equal(line.sku, 'DES-HOUR');
+  assert.equal(line.name, 'Design work (hour)');
+  assert.equal(line.qty, 10);
+  assert.equal(line.unitPrice, 8500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice accepts multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-02-20',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 8 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[1].sku, 'DEV-HOUR');
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for malformed date', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '15/01/2024',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-1-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-35',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice reports DATE_INVALID for impossible dates', () => {
+  // February 30th doesn't exist
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-02-30',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+
+  // April only has 30 days
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-04-31',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice accepts valid dates including leap year dates', () => {
+  // 2024 is a leap year, Feb 29 exists
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+
+  // 2023 is not a leap year, Feb 28 exists
+  const result2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-02-28',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result2.ok, true);
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice reports NO_LINES when lines is not an array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: undefined,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice reports QTY_INVALID for zero quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DES-HOUR', qty: 0 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice reports QTY_INVALID for negative quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DES-HOUR', qty: -5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice reports QTY_INVALID for non-integer quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice reports UNKNOWN_SKU for unknown product', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'FAKE-SKU', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice returns copies, not references', () => {
+  const inputLines = [{ sku: 'DES-HOUR', qty: 1 }];
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: inputLines,
+  });
+
+  // Mutate the returned line
+  result.value.lines[0].qty = 999;
+
+  // Original should be unchanged
+  assert.equal(inputLines[0].qty, 1);
+});
+
+test('createInvoice does not mutate input array', () => {
+  const inputLines = [{ sku: 'DES-HOUR', qty: 1 }];
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: inputLines,
+  });
+
+  // Input should be unchanged
+  assert.equal(inputLines[0].qty, 1);
+  assert.equal(Object.keys(inputLines[0]).length, 2);
+});
+
+test('createInvoice works with various VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 }, // 9% VAT
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0% VAT (exempt)
+      { sku: 'DES-HOUR', qty: 5 }, // 21% VAT
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 9);
+  assert.equal(result.value.lines[1].vatRate, 0);
+  assert.equal(result.value.lines[2].vatRate, 21);
+});
