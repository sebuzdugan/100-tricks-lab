@@ -61,3 +62,27 @@ export function createInvoice({ customerId, issueDate, lines }) {
     lines: enrichedLines,
   });
 }
+
+/**
+ * Calculate the total for a single line: qty × unitPrice.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number }> }} invoice
+ * @returns {{ subtotal: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = roundCents(
+    invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0)
+  );
+  return {
+    subtotal,
+    total: subtotal,
+  };
+}
