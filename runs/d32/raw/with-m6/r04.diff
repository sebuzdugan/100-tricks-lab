@@ -0,0 +1,23 @@
+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<counter> where counter is 4-digit zero-padded starting at 0001.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used, in any order
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const pattern = new RegExp(`^INV-${year}-(\\d{4})$`);
+
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const match = pattern.exec(num);
+    if (match) {
+      const counter = parseInt(match[1], 10);
+      if (counter > maxCounter) maxCounter = counter;
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
