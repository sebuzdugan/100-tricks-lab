diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..e1faaa6
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,75 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number for empty list', () => {
+  const number = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2024-05-20');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber resets counter for different year', () => {
+  const existing = ['INV-2024-0005', 'INV-2024-0010'];
+  const number = nextInvoiceNumber(existing, '2025-01-01');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber finds max counter in unsorted list', () => {
+  const existing = ['INV-2024-0003', 'INV-2024-0001', 'INV-2024-0010', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0011');
+});
+
+test('nextInvoiceNumber ignores numbers from different years', () => {
+  const existing = ['INV-2023-0099', 'INV-2024-0005', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2024-03-20');
+  assert.equal(number, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = ['INV-2024-0001'];
+  let number = nextInvoiceNumber(existing, '2024-01-01');
+  assert.equal(number, 'INV-2024-0002');
+
+  const existing2 = ['INV-2024-0099'];
+  number = nextInvoiceNumber(existing2, '2024-01-01');
+  assert.equal(number, 'INV-2024-0100');
+
+  const existing3 = ['INV-2024-0999'];
+  number = nextInvoiceNumber(existing3, '2024-01-01');
+  assert.equal(number, 'INV-2024-1000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2024-0001', 'INVALID', 'INV-2024', 'INV-2023-0050'];
+  const number = nextInvoiceNumber(existing, '2024-01-15');
+  assert.equal(number, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2024-9999'];
+  const number = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(number, 'INV-2024-10000');
+});
+
+test('nextInvoiceNumber extracts year from different date formats within same year', () => {
+  const existing = ['INV-2024-0001'];
+  const num1 = nextInvoiceNumber(existing, '2024-01-01');
+  const num2 = nextInvoiceNumber(existing, '2024-06-15');
+  const num3 = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(num1, 'INV-2024-0002');
+  assert.equal(num2, 'INV-2024-0002');
+  assert.equal(num3, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber does not mutate input array', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002'];
+  const original = [...existing];
+  nextInvoiceNumber(existing, '2024-01-15');
+  assert.deepEqual(existing, original);
+});
