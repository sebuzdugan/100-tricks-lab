+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  let invoice = invoiceResult.value;
+
+  const issuedResult = issueInvoice(invoice, []);
+  invoice = issuedResult.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('INV-2024-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText formats single line correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  // DES-HOUR: 10 * €85.00 = €850.00
+  assert.ok(text.includes('10 Design work (hour) €85.00 €850.00'));
+});
+
+test('renderInvoiceText formats multiple lines correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('10 Design work (hour) €85.00 €850.00'));
+  assert.ok(text.includes('5 Development (hour) €95.00 €475.00'));
+});
+
+test('renderInvoiceText includes total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Total: €850.00'));
+});
+
+test('renderInvoiceText sums multiple lines in total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 }, // 85000 cents
+      { sku: 'DEV-HOUR', qty: 5 }, // 47500 cents
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  // Total: 850 + 475 = 1325
+  assert.ok(text.includes('Total: €1,325.00'));
+});
+
+test('renderInvoiceText has correct line structure', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // First line: DRAFT or invoice number
+  assert.ok(lines[0] === 'DRAFT');
+  // Second line: customer name
+  assert.ok(lines[1] === 'Kite & Co');
+  // Line items
+  assert.ok(lines[2].includes('Design work (hour)'));
+  assert.ok(lines[3].includes('Copywriting (hour)'));
+  // Last line: total
+  assert.ok(lines[4].startsWith('Total:'));
+});
+
+test('renderInvoiceText works with small quantities', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  // STICKER: unitPrice: 50 cents = €0.50
+  assert.ok(text.includes('1 Sticker sheet €0.50 €0.50'));
+});
+
+test('renderInvoiceText works with large quantities', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1000 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  // 1000 * €85.00 = €85,000.00
+  assert.ok(text.includes('1000 Design work (hour) €85.00 €85,000.00'));
+  assert.ok(text.includes('Total: €85,000.00'));
+});
+
+test('renderInvoiceText works with zero-VAT items', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  // WORKSHOP-DAY: unitPrice: 60000 cents = €600.00
+  assert.ok(text.includes('1 Brand workshop (day, VAT exempt) €600.00 €600.00'));
+});
+
+test('renderInvoiceText handles unknown customer gracefully', () => {
+  // Create an invoice with an unknown customer manually
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('(Unknown customer)'));
+});
+
+test('renderInvoiceText produces consistent output format', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  let invoice = invoiceResult.value;
+
+  const issuedResult = issueInvoice(invoice, []);
+  invoice = issuedResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Should have exactly 4 lines
+  assert.equal(lines.length, 4);
+  // First line: number
+  assert.equal(lines[0], 'INV-2024-0001');
+  // Second line: customer
+  assert.equal(lines[1], 'Northwind Studio');
+  // Third line: item
+  assert.ok(lines[2].includes('Design work'));
+  // Fourth line: total
+  assert.ok(lines[3].startsWith('Total:'));
+});
+
+test('renderInvoiceText with various customers', () => {
+  const customers = ['C-001', 'C-002', 'C-003', 'C-010'];
+  const expectedNames = ['Northwind Studio', 'Blue Fern Bakery', 'Kite & Co', 'Tidewater Museum'];
+
+  for (let i = 0; i < customers.length; i++) {
+    const invoiceResult = createInvoice({
+      customerId: customers[i],
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    const invoice = invoiceResult.value;
+
+    const text = renderInvoiceText(invoice);
+    assert.ok(text.includes(expectedNames[i]), `Customer ${customers[i]} should have name ${expectedNames[i]}`);
+  }
+});
+
+test('renderInvoiceText with many line items', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 1 },
+      { sku: 'SUPPORT-HOUR', qty: 1 },
+    ],
+  });
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Should have: number + customer + 4 items + total = 7 lines
+  assert.equal(lines.length, 7);
+  assert.ok(lines[2].includes('Design work'));
+  assert.ok(lines[3].includes('Development'));
+  assert.ok(lines[4].includes('Copywriting'));
+  assert.ok(lines[5].includes('Support'));
+  assert.ok(lines[6].startsWith('Total:'));
+});
