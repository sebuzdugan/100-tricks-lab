+});
+
+test('createInvoice applies silver tier discount (2.5%)', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // silver tier
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount (0%)', () => {
+  const result = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice explicit discount overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice explicit 0 discount overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(result.ok, true);
+  // Explicit 0 should override the 5% tier discount
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('addLine explicit discount overrides tier discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const result = addLine(invoice, { sku: 'DEV-HOUR', qty: 3, discountPercent: 7 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 7);
+});
+
+test('addLine explicit 0 discount overrides tier discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const result = addLine(invoice, { sku: 'DEV-HOUR', qty: 3, discountPercent: 0 });
+  assert.equal(result.ok, true);
+  // Explicit 0 should override the 5% tier discount
+  assert.equal(result.value.lines[1].discountPercent, 0);
+});
+
+test('invoiceTotals with mixed tier discounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2024-01-15',
