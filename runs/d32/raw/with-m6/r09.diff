@@ -1,6 +1,72 @@
 import test from 'node:test';
 import assert from 'node:assert/strict';
 import { createInvoice, lineTotal, lineVat, invoiceTotals, addLine, removeLine, issueInvoice } from '../src/invoices.js';
+import { normalizeId, getCustomer } from '../src/customers.js';
+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId(' C-001 '), 'C-001');
+  assert.equal(normalizeId('  C-003  '), 'C-003');
+  assert.equal(normalizeId('C-005'), 'C-005');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-003'), 'C-003');
+  assert.equal(normalizeId('C-005'), 'C-005');
+});
+
+test('normalizeId handles mixed case and whitespace', () => {
+  assert.equal(normalizeId(' c-007 '), 'C-007');
+  assert.equal(normalizeId('  C-002  '), 'C-002');
+  assert.equal(normalizeId('c-010'), 'C-010');
+});
+
+test('getCustomer accepts normalized and non-normalized IDs', () => {
+  const result1 = getCustomer('C-001');
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.id, 'C-001');
+
+  const result2 = getCustomer('c-001');
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.id, 'C-001');
+
+  const result3 = getCustomer(' c-001 ');
+  assert.equal(result3.ok, true);
+  assert.equal(result3.value.id, 'C-001');
+});
+
+test('createInvoice normalizes and stores customer ID', () => {
+  const result = createInvoice({
+    customerId: ' c-001 ',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createInvoice accepts lowercase customer ID', () => {
+  const result = createInvoice({
+    customerId: 'c-003',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+});
+
+test('createInvoice accepts mixed case with spaces', () => {
+  const result = createInvoice({
+    customerId: '  c-002  ',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+});
 
