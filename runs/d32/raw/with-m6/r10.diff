@@ -0,0 +1,121 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate validates correct YYYY-MM-DD format', () => {
+  assert.equal(isValidDate('2024-01-15'), true);
+  assert.equal(isValidDate('2023-12-31'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2025-06-15'), true);
+});
+
+test('isValidDate rejects malformed dates', () => {
+  assert.equal(isValidDate('15/01/2024'), false);
+  assert.equal(isValidDate('2024-1-15'), false);
+  assert.equal(isValidDate('2024-01-5'), false);
+  assert.equal(isValidDate('01-15-2024'), false);
+  assert.equal(isValidDate('2024/01/15'), false);
+});
+
+test('isValidDate rejects impossible dates', () => {
+  assert.equal(isValidDate('2024-02-30'), false);
+  assert.equal(isValidDate('2024-04-31'), false);
+  assert.equal(isValidDate('2023-02-29'), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('2100-02-29'), false);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('addDays adds days correctly', () => {
+  assert.equal(addDays('2024-01-15', 1), '2024-01-16');
+  assert.equal(addDays('2024-01-15', 10), '2024-01-25');
+  assert.equal(addDays('2024-01-15', 0), '2024-01-15');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2024-01-31', 1), '2024-02-01');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2024-01-15', -1), '2024-01-14');
+  assert.equal(addDays('2024-02-01', -1), '2024-01-31');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays handles large offsets', () => {
+  // 2024 is a leap year (366 days total)
+  // Adding 365 days gets us to 2024-12-31
+  assert.equal(addDays('2024-01-01', 365), '2024-12-31');
+  // Adding 366 days gets us to 2025-01-01
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01');
+  assert.equal(addDays('2024-01-01', -1), '2023-12-31');
+});
+
+test('daysBetween calculates difference correctly', () => {
+  assert.equal(daysBetween('2024-01-15', '2024-01-16'), 1);
+  assert.equal(daysBetween('2024-01-15', '2024-01-25'), 10);
+  assert.equal(daysBetween('2024-01-15', '2024-01-15'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2024-01-31', '2024-02-01'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+});
+
+test('daysBetween handles negative differences', () => {
+  assert.equal(daysBetween('2024-01-16', '2024-01-15'), -1);
+  assert.equal(daysBetween('2024-01-25', '2024-01-15'), -10);
+  // 2024 is a leap year, so there are 366 days from 2024-01-01 to 2025-01-01
+  assert.equal(daysBetween('2025-01-01', '2024-01-01'), -366);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2023-12-31', '2024-01-01'), 1);
+  // 2023 is not a leap year, so there are 365 days from 2023-01-01 to 2024-01-01
+  assert.equal(daysBetween('2023-01-01', '2024-01-01'), 365);
+});
+
+test('daysBetween handles large gaps', () => {
+  // 2024 is a leap year (366 days)
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+  // 2024 is leap (366) + 2025 is not (365) = 731 days
+  assert.equal(daysBetween('2024-01-01', '2026-01-01'), 731);
+  // 2020, 2021, 2022, 2023: 366 + 365 + 365 + 365 = 1461
+  assert.equal(daysBetween('2020-01-01', '2024-01-01'), 1461);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const start = '2024-01-15';
+  const end = addDays(start, 100);
+  assert.equal(daysBetween(start, end), 100);
+
+  const start2 = '2024-06-30';
+  const end2 = addDays(start2, 50);
+  assert.equal(daysBetween(start2, end2), 50);
+});
+
+test('date operations work in UTC', () => {
+  // Verify that addDays uses UTC by checking the format is preserved
+  const date = '2024-02-29';
+  const result = addDays(date, 1);
+  assert.equal(result, '2024-03-01');
+
+  // Verify daysBetween uses UTC
+  const feb29 = '2024-02-29';
+  const mar1 = '2024-03-01';
+  const diff = daysBetween(feb29, mar1);
+  assert.equal(diff, 1);
+});
