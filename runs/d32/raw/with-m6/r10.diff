+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!match) return false;
+
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  if (Number.isNaN(date.getTime())) return false;
+
+  const iso = date.toISOString().split('T')[0];
+  return iso === dateStr;
+}
+
+/**
+ * Add n days to a date string (in UTC).
+ * @param {string} dateStr - YYYY-MM-DD format
+ * @param {number} n - number of days to add
+ * @returns {string} - YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  date.setUTCDate(date.getUTCDate() + n);
+  return date.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of days between two dates (b minus a, in whole days, in UTC).
+ * @param {string} dateA - YYYY-MM-DD format
+ * @param {string} dateB - YYYY-MM-DD format
+ * @returns {number} - number of whole days (dateB - dateA)
+ */
+export function daysBetween(dateA, dateB) {
+  const a = new Date(`${dateA}T00:00:00Z`);
+  const b = new Date(`${dateB}T00:00:00Z`);
+  const diffMs = b.getTime() - a.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
