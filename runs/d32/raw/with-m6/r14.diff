+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+import { roundCents } from './money.js';
+
+/**
+ * Generate a customer statement.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }>} invoices
+ * @param {string} asOf - YYYY-MM-DD format, statement cutoff date (inclusive)
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize customer ID
+  const normalizedCustomerId = normalizeId(customerId);
+
+  // Validate customer exists
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return fail('CUSTOMER_NOT_FOUND');
+
+  // Filter invoices for this customer with matching status and date
+  const relevantInvoices = invoices
+    .filter((inv) => inv.customerId === normalizedCustomerId)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate totals for each invoice
+  const invoiceSummaries = relevantInvoices.map((inv) => {
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+    return {
+      number: inv.number || '',
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate || '',
+      total: totals.total,
+      due,
+    };
+  });
+
+  // Calculate total due
+  const totalDue = roundCents(
+    invoiceSummaries.reduce((sum, inv) => sum + inv.due, 0)
+  );
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: invoiceSummaries,
+    totalDue,
+  });
+}
