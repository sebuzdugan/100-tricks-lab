+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate the next credit note number for a given year.
+ * Format: CN-<year>-<counter> where counter is 4-digit zero-padded starting at 0001.
+ * @param {string[]} existingNumbers - Array of numbers (INV and CN) already used
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.substring(0, 4);
+  const pattern = new RegExp(`^CN-${year}-(\\d{4})$`);
+
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const match = pattern.exec(num);
+    if (match) {
+      const counter = parseInt(match[1], 10);
+      if (counter > maxCounter) maxCounter = counter;
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ customerId: string, number?: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNoteData
+ * @param {string[]} existingNumbers - Array of all numbers (INV and CN) already used
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const totals = invoiceTotals(invoice);
+
+  // Check credit amount doesn't exceed invoice total
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number || '',
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
