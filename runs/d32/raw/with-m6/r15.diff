+++ b/test/credits.test.js
@@ -0,0 +1,324 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId, issueDate, qty = 10) {
+  const created = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty }],
+  });
+  const issued = issueInvoice(created.value, []);
+  return issued.value;
+}
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Defective product', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Defective product');
+  assert.equal(result.value.date, '2024-02-01');
+});
+
+test('createCreditNote sets credit note number with CN prefix', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number.startsWith('CN-'), true);
+});
+
+test('createCreditNote increments credit note counter per year', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2024-01-15');
+  const invoice2 = createAndIssueInvoice('C-001', '2024-02-15');
+
+  const result1 = createCreditNote(
+    invoice1,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+  assert.equal(result1.value.number, 'CN-2024-0001');
+
+  const result2 = createCreditNote(
+    invoice2,
+    { amount: 3000, reason: 'Return', date: '2024-03-01' },
+    [result1.value.number]
+  );
+  assert.equal(result2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote resets counter for different year', () => {
+  const invoice2024 = createAndIssueInvoice('C-001', '2024-12-15');
+  const invoice2025 = createAndIssueInvoice('C-001', '2025-01-15');
+
+  const result2024 = createCreditNote(
+    invoice2024,
+    { amount: 5000, reason: 'Discount', date: '2024-12-01' },
+    []
+  );
+  assert.equal(result2024.value.number, 'CN-2024-0001');
+
+  const result2025 = createCreditNote(
+    invoice2025,
+    { amount: 3000, reason: 'Return', date: '2025-01-01' },
+    [result2024.value.number]
+  );
+  assert.equal(result2025.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote includes invoice number', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+});
+
+test('createCreditNote includes customer ID', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const result = createCreditNote(
+    draft,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote accepts partially_paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+
+  const partiallyPaid = recordPayment(invoice, {
+    amount: Math.floor(totals.total / 2),
+    date: '2024-02-01',
+  }).value;
+
+  const result = createCreditNote(
+    partiallyPaid,
+    { amount: 5000, reason: 'Discount', date: '2024-02-15' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote accepts paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+
+  const paid = recordPayment(invoice, {
+    amount: totals.total,
+    date: '2024-02-01',
+  }).value;
+
+  const result = createCreditNote(
+    paid,
+    { amount: 5000, reason: 'Discount', date: '2024-02-15' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000.5, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 0, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: -1000, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects credit exceeding invoice total', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: totals.total + 1, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: totals.total, reason: 'Full refund', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote respects existing INV numbers in counter lookup', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002'];
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    existingNumbers
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote generates CN numbers independent of INV numbers', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2024-01-15');
+  const invoice2 = createAndIssueInvoice('C-001', '2024-02-15');
+
+  const existingNumbers = ['INV-2024-0001', 'CN-2024-0001'];
+
+  const result1 = createCreditNote(
+    invoice1,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    existingNumbers
+  );
+  assert.equal(result1.value.number, 'CN-2024-0002');
+
+  const existingNumbers2 = existingNumbers.concat([result1.value.number]);
+  const result2 = createCreditNote(
+    invoice2,
+    { amount: 3000, reason: 'Return', date: '2024-03-01' },
+    existingNumbers2
+  );
+  assert.equal(result2.value.number, 'CN-2024-0003');
+});
+
+test('createCreditNote with voucher on invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const invoiceWithVoucher = {
+    ...invoice,
+    voucher: { code: 'SUMMER2024', amount: 1000 },
+  };
+
+  const result = createCreditNote(
+    invoiceWithVoucher,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote zero-pads counter to 4 digits', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote handles large counters', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const existingNumbers = [];
+  for (let i = 1; i <= 9999; i++) {
+    existingNumbers.push(`CN-2024-${String(i).padStart(4, '0')}`);
+  }
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    existingNumbers
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-10000');
+});
+
+test('createCreditNote does not mutate invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const originalStatus = invoice.status;
+
+  createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Discount', date: '2024-02-01' },
+    []
+  );
+
+  assert.equal(invoice.status, originalStatus);
+});
