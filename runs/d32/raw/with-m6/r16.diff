+import { balanceDue } from './payments.js';
+
+/**
+ * Get invoices that are overdue.
+ * @param {Array<{ number: string, customerId: string, dueDate: string, status: string, lines: Array, payments?: Array }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format to compare against
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>} Sorted most overdue first
+ */
+export function overdueInvoices(invoices, asOf) {
+  const asOfDate = new Date(`${asOf}T00:00:00Z`);
+
+  const overdue = invoices
+    .filter((invoice) => {
+      // Only include 'issued' or 'partially_paid' statuses
+      if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+        return false;
+      }
+
+      // Only include invoices where dueDate is before asOf
+      const dueDate = new Date(`${invoice.dueDate}T00:00:00Z`);
+      return dueDate < asOfDate;
+    })
+    .map((invoice) => {
+      const dueDate = new Date(`${invoice.dueDate}T00:00:00Z`);
+      const daysOverdue = Math.floor((asOfDate - dueDate) / (1000 * 60 * 60 * 24));
+      const due = balanceDue(invoice);
+
+      return {
+        number: invoice.number,
+        customerId: invoice.customerId,
+        dueDate: invoice.dueDate,
+        daysOverdue,
+        due,
+      };
+    })
+    // Sort by daysOverdue descending (most overdue first)
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
