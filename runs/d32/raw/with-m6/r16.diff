+
+test('overdueInvoices preserves all required fields in result', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-01-10',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100 }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2024-12-20');
+  assert.equal(result.length, 1);
+  const item = result[0];
