+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns empty array when no invoices match criteria', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-12-25',
+      status: 'paid',
+      lines: [],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2024-12-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices filters by status: ignores draft invoices', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-01-10',
+      status: 'draft',
+      lines: [{ qty: 1, unitPrice: 100 }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2024-12-20');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices filters by status: ignores paid invoices', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-01-10',
+      status: 'paid',
+      lines: [{ qty: 1, unitPrice: 100 }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2024-12-20');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes issued invoices', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-01-10',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100 }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2024-12-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-001');
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-01-10',
+      status: 'partially_paid',
+      lines: [{ qty: 1, unitPrice: 100 }],
+      payments: [{ amount: 50, date: '2024-02-01' }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2024-12-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-001');
+});
+
+test('overdueInvoices filters by date: excludes future due dates', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-12-25',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100 }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2024-12-20');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices filters by date: includes due dates before asOf', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-12-19',
