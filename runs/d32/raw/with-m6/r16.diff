+
+test('overdueInvoices does not mutate input array', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-01-10',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100 }],
