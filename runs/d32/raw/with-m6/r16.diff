+
+  const result = overdueInvoices(invoices, '2024-12-20');
+  assert.equal(result.length, 3);
+  assert.equal(result[0].number, 'INV-003');
+  assert.equal(result[0].daysOverdue, 15);
+  assert.equal(result[1].number, 'INV-001');
