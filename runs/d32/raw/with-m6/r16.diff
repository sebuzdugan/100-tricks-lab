+
+test('overdueInvoices sorts by daysOverdue descending (most overdue first)', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-12-10',
+      status: 'issued',
