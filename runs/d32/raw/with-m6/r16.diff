+});
+
+test('overdueInvoices handles empty invoice array', () => {
+  const result = overdueInvoices([], '2024-12-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices handles multiple invoices with same customer', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      dueDate: '2024-12-10',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100 }],
+    },
+    {
+      number: 'INV-002',
+      customerId: 'C-001',
+      dueDate: '2024-12-15',
