+/**
+ * Get VAT summary for invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    // Only include 'issued', 'partially_paid', or 'paid' statuses
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const vatRate = line.vatRate ?? 0;
+      const lineTotal = roundCents(line.qty * line.unitPrice);
+      const discount = roundCents(lineTotal * ((line.discountPercent ?? 0) / 100));
+      const base = roundCents(lineTotal - discount);
+      const vat = roundCents(base * (vatRate / 100));
+
+      if (!vatMap.has(vatRate)) {
+        vatMap.set(vatRate, { rate: vatRate, base: 0, vat: 0 });
+      }
+
+      const entry = vatMap.get(vatRate);
+      entry.base = roundCents(entry.base + base);
+      entry.vat = roundCents(entry.vat + vat);
+    }
+  }
+
+  // Convert map to array and sort by rate descending
+  return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
+}
