+/**
+ * Calculate late fee for an invoice.
+ * @param {{ dueDate: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format to compare against
+ * @returns {number} Late fee in cents, 0 if invoice is not overdue
+ */
+export function lateFee(invoice, asOf) {
+  const dueDate = new Date(`${invoice.dueDate}T00:00:00Z`);
+  const asOfDate = new Date(`${asOf}T00:00:00Z`);
+
+  // If not overdue, no late fee
+  if (dueDate >= asOfDate) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = Math.floor((asOfDate - dueDate) / (1000 * 60 * 60 * 24));
+
+  // Get amount still due
+  const due = balanceDue(invoice);
+
+  // Calculate late fee: 0.04% per day
+  const fee = roundCents(due * 0.0004 * daysOverdue);
+
+  return fee;
+}
