+test('exportCsv returns CSV with header and data lines', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      dueDate: '2024-02-15',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 20 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.trim().split('\n');
+
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.ok(lines[1].includes('INV-001'));
+});
+
