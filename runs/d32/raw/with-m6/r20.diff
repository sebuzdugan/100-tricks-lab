index fadf486..1018f8f 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,40 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert euros to another currency.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code: EUR, USD, or GBP
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }} - Amount in that currency's cents
+ */
+export function convert(cents, currency) {
+  if (!RATES.hasOwnProperty(currency)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const converted = roundCents(cents * rate);
+
+  return ok(converted);
+}
+
+/**
+ * Format cents as money in a given currency.
+ * @param {number} cents - Amount in euro cents (will be converted to target currency)
+ * @param {string} currency - Currency code: EUR, USD, or GBP
+ * @returns {string} - Formatted amount like "$1,234.56" or "£1,234.56" or "€1,234.56"
+ */
+export function formatMoney(cents, currency) {
+  const convertResult = convert(cents, currency);
+  if (!convertResult.ok) {
+    return '';
+  }
+
+  const targetCents = convertResult.value;
+  const sign = targetCents < 0 ? '-' : '';
+  const abs = Math.abs(targetCents);
+  const currencySymbol = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${currencySymbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
