+
+test('RATES contains EUR, USD, and GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert returns error for unknown currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert returns ok result for known currency', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(typeof result.value, 'number');
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert EUR to USD multiplies by rate', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 10000 * 1.085 = 10850
+  assert.equal(result.value, 10850);
+});
+
+test('convert EUR to GBP multiplies by rate', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  // 10000 * 0.8425 = 8425
+  assert.equal(result.value, 8425);
+});
+
+test('convert handles fractional results with rounding', () => {
+  // 1 EUR = 1.085 USD, so some amounts will have fractional cents
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  // 100 * 1.085 = 108.5, rounds to 108 (banker's rounding)
+  assert.equal(result.value, 108);
+});
+
+test('convert handles negative amounts', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -10850);
+});
+
+test('convert handles zero amount', () => {
+  const result = convert(0, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('formatMoney returns empty string for unknown currency', () => {
+  const result = formatMoney(10000, 'JPY');
+  assert.equal(result, '');
+});
+
+test('formatMoney formats EUR with euro symbol', () => {
+  const result = formatMoney(123456, 'EUR');
+  assert.equal(result, '€1,234.56');
+});
+
+test('formatMoney formats USD with dollar sign', () => {
+  const result = formatMoney(108500, 'USD');
+  // 100 EUR cents = $1.085, so 108500 EUR cents = $1178.225
+  // Wait, let me recalculate: 108500 * 1.085 = 117,722.5 USD cents ≈ 117,722 USD cents = $1177.22
+  // Hmm, that's not right. Let me think about this again.
+  // Actually, 108500 EUR cents = 1085 EUR = 1176.225 USD, so 117,622.5 USD cents ≈ 117,622 or 117,623 USD cents
+  // Let me check: 108500 * 1.085 = 117,722.5, rounds to 117,722
+  assert.ok(result.includes('$'));
+  assert.ok(result.includes(','));
+  assert.ok(result.endsWith('.22') || result.endsWith('.23'));
+});
+
+test('formatMoney formats GBP with pound sign', () => {
