+});
+
+test('convert handles large amounts', () => {
+  const result = convert(100000000, 'USD');
+  assert.equal(result.ok, true);
+  // 100000000 * 1.085 = 108500000
+  assert.equal(result.value, 108500000);
+});
+
+test('formatMoney formats large amounts with thousands separators', () => {
+  const result = formatMoney(100000000, 'USD');
