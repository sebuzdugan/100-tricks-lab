diff --git a/src/customers.js b/src/customers.js
index 0b44c70..2781346 100644
--- a/src/customers.js
+++ b/src/customers.js
@@ -43,3 +43,34 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge two customers: move all invoices from fromId to intoId, then delete fromId.
+ * @param {Array} customers
+ * @param {Array} invoices
+ * @param {string} fromId
+ * @param {string} intoId
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  const fromCustomerExists = customers.some((c) => c.id === normalizedFromId);
+  const intoCustomerExists = customers.some((c) => c.id === normalizedIntoId);
+
+  if (!fromCustomerExists || !intoCustomerExists) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const mergedCustomers = customers.filter((c) => c.id !== normalizedFromId);
+  const mergedInvoices = invoices.map((inv) =>
+    inv.customerId === normalizedFromId ? { ...inv, customerId: normalizedIntoId } : inv
+  );
+
+  return ok({ customers: mergedCustomers, invoices: mergedInvoices });
+}
diff --git a/test/customers.test.js b/test/customers.test.js
index 65830b2..3130fdc 100644
--- a/test/customers.test.js
+++ b/test/customers.test.js
@@ -1,6 +1,6 @@
 import test from 'node:test';
 import assert from 'node:assert/strict';
-import { getCustomer, listCustomers, validateCustomer } from '../src/customers.js';
+import { getCustomer, listCustomers, validateCustomer, mergeCustomers } from '../src/customers.js';
 
 test('getCustomer finds a customer by id', () => {
   const r = getCustomer('C-003');
@@ -20,3 +20,61 @@ test('validateCustomer needs an id, a name and an email', () => {
   assert.equal(validateCustomer({ id: 'C-100', name: 'X', email: 'x@y.example' }).ok, true);
   assert.deepEqual(validateCustomer({ id: 'C-100', name: 'X', email: 'nope' }), { ok: false, error: 'CUSTOMER_INVALID' });
 });
+
+test('mergeCustomers moves invoices and removes fromId', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+    { id: 'C-003', name: 'Charlie', email: 'charlie@example.com', tier: 'silver' },
+  ];
+  const invoices = [
+    { id: 'INV-001', customerId: 'C-001', amount: 100 },
+    { id: 'INV-002', customerId: 'C-002', amount: 200 },
+    { id: 'INV-003', customerId: 'C-001', amount: 150 },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 2);
+  assert.equal(result.value.customers.some((c) => c.id === 'C-001'), false);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices.filter((inv) => inv.customerId === 'C-002').length, 3);
+});
+
+test('mergeCustomers errors on same customer', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'gold' },
+  ];
+  const result = mergeCustomers(customers, [], 'C-001', 'C-001');
+  assert.deepEqual(result, { ok: false, error: 'SAME_CUSTOMER' });
+});
+
+test('mergeCustomers errors if fromId not found', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+  const result = mergeCustomers(customers, [], 'C-999', 'C-001');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('mergeCustomers errors if intoId not found', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+  const result = mergeCustomers(customers, [], 'C-001', 'C-999');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('mergeCustomers normalizes ids', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+  const invoices = [{ id: 'INV-001', customerId: 'C-001', amount: 100 }];
+
+  const result = mergeCustomers(customers, invoices, ' c-001 ', ' c-002 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+});
