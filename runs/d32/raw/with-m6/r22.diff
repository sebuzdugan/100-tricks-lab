+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  assert.equal(lineTotal({ qty: 10, unitPrice: 8500 }), 85000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 120000 }), 120000);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 50 }), 5000);
+});
+
+test('lineTotal returns 0 for zero quantity', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 8500 }), 0);
+});
+
+test('lineTotal works with different unit prices', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 1 }), 5);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 1 }), 1);
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 10000 }), 10000000);
+});
+
+test('lineTotal returns integer cents', () => {
+  const line = lineTotal({ qty: 3, unitPrice: 1010 });
+  assert.ok(Number.isInteger(line));
+  assert.equal(line, 3030);
+});
+
+test('lineVat calculates VAT on line amount after discount', () => {
+  // 100 * 1000 = 100000, no discount, 21% VAT = 21000
+  const vat1 = lineVat({ qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: 0 });
+  assert.equal(vat1, 21000);
+
+  // 100 * 1000 = 100000, 10% discount = 90000, 21% VAT = 18900
+  const vat2 = lineVat({ qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: 10 });
+  assert.equal(vat2, 18900);
+
+  // 100 * 1000 = 100000, no discount, 9% VAT = 9000
+  const vat3 = lineVat({ qty: 100, unitPrice: 1000, vatRate: 9, discountPercent: 0 });
+  assert.equal(vat3, 9000);
+
+  // 100 * 1000 = 100000, no discount, 0% VAT = 0
+  const vat4 = lineVat({ qty: 100, unitPrice: 1000, vatRate: 0, discountPercent: 0 });
+  assert.equal(vat4, 0);
+});
+
+test('lineVat with tier discount', () => {
+  // 100 * 1000 = 100000, 5% tier discount = 95000, 21% VAT = 19950
+  const vat = lineVat({ qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: 5 });
+  assert.equal(vat, 19950);
+});
+
+test('lineVat defaults discountPercent and vatRate to 0 if missing', () => {
+  const vat1 = lineVat({ qty: 100, unitPrice: 1000 });
+  assert.equal(vat1, 0);
+
+  const vat2 = lineVat({ qty: 100, unitPrice: 1000, discountPercent: undefined });
+  assert.equal(vat2, 0);
+});
+
+test('invoiceTotals sums line totals for single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 85000);
+});
+
+test('invoiceTotals sums line totals for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 0 }, // 85000
+      { qty: 5, unitPrice: 9500, discountPercent: 0, vatRate: 0 }, // 47500
+      { qty: 1, unitPrice: 120000, discountPercent: 0, vatRate: 0 }, // 120000
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 252500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 252500);
+});
+
+test('invoiceTotals returns 0 for empty invoice', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals returns a new object', () => {
+  const invoice = { lines: [{ qty: 5, unitPrice: 1000 }] };
+  const totals1 = invoiceTotals(invoice);
+  const totals2 = invoiceTotals(invoice);
+  assert.notEqual(totals1, totals2);
+  assert.deepEqual(totals1, totals2);
+});
+
+test('invoiceTotals returns integer cents', () => {
+  const invoice = {
+    lines: [
+      { qty: 7, unitPrice: 37, discountPercent: 0, vatRate: 0 },
+      { qty: 11, unitPrice: 249, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(Number.isInteger(totals.subtotal));
+  assert.ok(Number.isInteger(totals.discount));
+  assert.ok(Number.isInteger(totals.vat));
+  assert.ok(Number.isInteger(totals.total));
+  assert.equal(totals.subtotal, 7 * 37 + 11 * 249);
+});
+
+test('invoiceTotals calculates discount for single line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 100 * 1000 = 100000
+  // discount: 100000 * 10 / 100 = 10000
+  // vat: 0 (no VAT)
+  // total: 100000 - 10000 + 0 = 90000
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 90000);
+});
+
+test('invoiceTotals calculates discount for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 }, // 100000 - 10000 = 90000
+      { qty: 50, unitPrice: 1000, discountPercent: 20, vatRate: 0 }, // 50000 - 10000 = 40000
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 100000 + 50000 = 150000
+  // discount: 10000 + 10000 = 20000
+  // vat: 0
+  // total: 150000 - 20000 + 0 = 130000
+  assert.equal(totals.subtotal, 150000);
+  assert.equal(totals.discount, 20000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 130000);
+});
+
+test('invoiceTotals handles decimal discounts', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 12.5, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 100 * 1000 = 100000
+  // discount: 100000 * 12.5 / 100 = 12500
+  // vat: 0
+  // total: 100000 - 12500 + 0 = 87500
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 12500);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 87500);
+});
+
+test('invoiceTotals with no discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+      { qty: 50, unitPrice: 1000, vatRate: 0 }, // undefined discountPercent
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 100000 + 50000 = 150000
+  // discount: 0
+  // vat: 0
+  // total: 150000
+  assert.equal(totals.subtotal, 150000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 150000);
+});
+
+test('invoiceTotals clamps negative totals to 0', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 100, discountPercent: 100, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 100 * 100 = 10000
+  // discount: 10000 * 100 / 100 = 10000
+  // vat: 0
+  // total: 10000 - 10000 + 0 = 0
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals calculates VAT for single line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 100000
+  // discount: 0
+  // vat: 100000 * 21 / 100 = 21000
+  // total: 100000 - 0 + 21000 = 121000
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.total, 121000);
+});
+
+test('invoiceTotals calculates VAT with discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 100000
+  // discount: 10000
+  // after discount: 90000
+  // vat: 90000 * 21 / 100 = 18900
+  // total: 100000 - 10000 + 18900 = 108900
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 18900);
+  assert.equal(totals.total, 108900);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }, // 100000, VAT 21% = 21000
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 9 }, // 100000, VAT 9% = 9000
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }, // 100000, VAT 0% = 0
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 300000
+  // discount: 0
+  // vat: 21000 + 9000 + 0 = 30000
+  // total: 300000 + 30000 = 330000
+  assert.equal(totals.subtotal, 300000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 30000);
+  assert.equal(totals.total, 330000);
+});
+
+test('invoiceTotals with discount and VAT together', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 5, vatRate: 21 }, // 100000 - 5000 = 95000, VAT 19950
+      { qty: 50, unitPrice: 1000, discountPercent: 10, vatRate: 9 }, // 50000 - 5000 = 45000, VAT 4050
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal: 150000
+  // discount: 10000
+  // vat: 19950 + 4050 = 24000
+  // total: 150000 - 10000 + 24000 = 164000
+  assert.equal(totals.subtotal, 150000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 24000);
+  assert.equal(totals.total, 164000);
+});
+
+test('invoiceTotals includes voucher field', () => {
+  const invoice = { lines: [{ qty: 5, unitPrice: 1000 }] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals reduces total by voucher amount', () => {
+  const invoice = { lines: [{ qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 }] };
+
+  const withoutVoucher = invoiceTotals(invoice);
+  const voucherAmount = 5000;
+
+  const withVoucher = invoiceTotals({
+    ...invoice,
+    voucher: { code: 'SUMMER2024', amount: voucherAmount },
+  });
+
+  assert.equal(withVoucher.voucher, voucherAmount);
+  assert.equal(withVoucher.total, withoutVoucher.total - voucherAmount);
+});
+
+test('invoiceTotals calculation: subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 1000, discountPercent: 5, vatRate: 9 },
+    ],
+    voucher: { code: 'SUMMER2024', amount: 2000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  const expectedTotal =
+    totals.subtotal - totals.discount + totals.vat - totals.voucher;
+
+  assert.equal(totals.total, expectedTotal);
+});
