diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..f12bec5
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,57 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line: qty × unitPrice.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate VAT for a single line: (line total - discount) × vatRate / 100.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number}
+ */
+export function lineVat(line) {
+  const baseTotal = lineTotal(line);
+  const lineDiscount = roundCents(baseTotal * (line.discountPercent ?? 0) / 100);
+  const amountAfterDiscount = baseTotal - lineDiscount;
+  return roundCents(amountAfterDiscount * (line.vatRate ?? 0) / 100);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = roundCents(
+    invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0)
+  );
+
+  const discount = roundCents(
+    invoice.lines.reduce((sum, line) => {
+      const baseTotal = lineTotal(line);
+      const lineDiscount = roundCents(baseTotal * (line.discountPercent ?? 0) / 100);
+      return sum + lineDiscount;
+    }, 0)
+  );
+
+  const vat = roundCents(
+    invoice.lines.reduce((sum, line) => sum + lineVat(line), 0)
+  );
+
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+
+  const total = Math.max(0, roundCents(subtotal - discount + vat - voucher));
+
+  return {
+    subtotal: Math.max(0, subtotal),
+    discount: Math.max(0, discount),
+    vat: Math.max(0, vat),
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
