diff --git a/src/totals.js b/src/totals.js
index f12bec5..6c66d77 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -10,14 +10,28 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate VAT for a single line: (line total - discount) × vatRate / 100.
+ * Calculate bulk discount for a line (2.5% off if qty >= 10, applied after line discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+function calculateBulkDiscount(line) {
+  if (line.qty < 10) return 0;
+  const baseTotal = lineTotal(line);
+  const lineDiscount = roundCents(baseTotal * (line.discountPercent ?? 0) / 100);
+  const amountAfterLineDiscount = baseTotal - lineDiscount;
+  return roundCents(amountAfterLineDiscount * 2.5 / 100);
+}
+
+/**
+ * Calculate VAT for a single line: (line total - discount - bulk discount) × vatRate / 100.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
  * @returns {number}
  */
 export function lineVat(line) {
   const baseTotal = lineTotal(line);
   const lineDiscount = roundCents(baseTotal * (line.discountPercent ?? 0) / 100);
-  const amountAfterDiscount = baseTotal - lineDiscount;
+  const bulkDiscount = calculateBulkDiscount(line);
+  const amountAfterDiscount = baseTotal - lineDiscount - bulkDiscount;
   return roundCents(amountAfterDiscount * (line.vatRate ?? 0) / 100);
 }
 
@@ -35,7 +49,8 @@ export function invoiceTotals(invoice) {
     invoice.lines.reduce((sum, line) => {
       const baseTotal = lineTotal(line);
       const lineDiscount = roundCents(baseTotal * (line.discountPercent ?? 0) / 100);
-      return sum + lineDiscount;
+      const bulkDiscount = calculateBulkDiscount(line);
+      return sum + lineDiscount + bulkDiscount;
     }, 0)
   );
 
