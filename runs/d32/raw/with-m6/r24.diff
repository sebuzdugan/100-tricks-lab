+/**
+ * Generate a dashboard summary of invoices.
+ * @param {Array} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    if (invoice.status in counts) {
+      counts[invoice.status]++;
+    }
+  }
+
+  // Calculate outstanding (total due on issued/partially_paid)
+  let outstanding = 0;
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      outstanding = roundCents(outstanding + balanceDue(invoice));
+    }
+  }
+
+  // Get overdue invoices
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue.reduce((sum, inv) => roundCents(sum + inv.due), 0);
+
+  // Calculate due per customer
+  const customerDueMap = new Map();
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      if (!customerDueMap.has(invoice.customerId)) {
+        customerDueMap.set(invoice.customerId, 0);
+      }
+      customerDueMap.set(invoice.customerId, roundCents(customerDueMap.get(invoice.customerId) + due));
+    }
+  }
+
+  // Get top 3 customers by due amount
+  const topCustomers = Array.from(customerDueMap.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
