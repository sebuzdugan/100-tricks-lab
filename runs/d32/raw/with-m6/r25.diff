 import { formatEuros } from './money.js';
 import { invoiceTotals, lineTotal, lineVat } from './invoices.js';
 import { getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
 
 /**
  * Render an invoice as plain text for display to a customer.
  * All amounts are formatted as euros using formatEuros().
- * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate: number }>, dueDate?: string, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number }> }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -16,25 +17,56 @@ export function renderInvoiceText(invoice) {
   const customerResult = getCustomer(invoice.customerId);
   const customerName = customerResult.ok ? customerResult.value.name : '(Unknown customer)';
 
-  // Line items
+  // Line items with optional discount
   const lineItems = invoice.lines.map((line) => {
     const total = lineTotal(line);
-    return `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
+    let lineStr = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
+    if (line.discountPercent && line.discountPercent > 0) {
+      lineStr += ` (${line.discountPercent}% discount)`;
+    }
+    return lineStr;
   });
 
   // Totals
   const totals = invoiceTotals(invoice);
 
+  const summaryLines = [];
+
+  // Discount line (only show if discount > 0)
+  if (totals.discount > 0) {
+    summaryLines.push(`Discount: -${formatEuros(totals.discount)}`);
+  }
+
   // VAT line (only show if VAT > 0)
-  const vatLine = totals.vat > 0 ? `VAT: ${formatEuros(totals.vat)}` : null;
+  if (totals.vat > 0) {
+    summaryLines.push(`VAT: ${formatEuros(totals.vat)}`);
+  }
+
+  // Voucher line (only show if voucher present)
+  if (invoice.voucher) {
+    summaryLines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
 
   // Total line
   const totalLine = `Total: ${formatEuros(totals.total)}`;
 
+  // Due date line (only show if dueDate present)
+  let dueLine = null;
+  if (invoice.dueDate) {
+    dueLine = `Due: ${invoice.dueDate}`;
+  }
+
+  // Paid line (only show if payments present)
+  let paidLine = null;
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    paidLine = `Paid: ${formatEuros(totalPaid)}`;
+  }
+
   // Combine all lines
-  const allLines = [numberLine, customerName, ...lineItems];
-  if (vatLine) allLines.push(vatLine);
-  allLines.push(totalLine);
+  const allLines = [numberLine, customerName, ...lineItems, ...summaryLines, totalLine];
+  if (dueLine) allLines.push(dueLine);
+  if (paidLine) allLines.push(paidLine);
 
   return allLines.join('\n');
 }
