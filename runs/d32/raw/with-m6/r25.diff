+  invoice.voucher = { code: 'SUMMER2024', amount: 5000 };
+  invoice.payments = [{ amount: 50000 }];
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Find indices
+  const lineIndex = lines.findIndex(l => l.includes('Design work'));
+  const discountLineIndex = lines.findIndex(l => l.includes('Discount:'));
+  const voucherLineIndex = lines.findIndex(l => l.includes('Voucher:'));
