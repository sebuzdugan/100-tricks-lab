+
+test('lineTotal multiplies quantity by unit price', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 9500 }), 9500);
+  assert.equal(lineTotal({ qty: 5, unitPrice: 9500 }), 47500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 120000 }), 120000);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 37 }), 3700);
+});
+
+test('lineTotal works with zero quantity', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 9500 }), 0);
+});
+
+test('lineTotal works with large numbers', () => {
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 999900 }), 999900000);
+});
+
+test('invoiceTotals calculates subtotal and total from a single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 47500, total: 47500 });
+});
+
+test('invoiceTotals sums all line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500 },
+      { qty: 1, unitPrice: 120000 },
+      { qty: 100, unitPrice: 37 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 47500 + 120000 + 3700);
+  assert.equal(totals.total, 47500 + 120000 + 3700);
+  assert.equal(totals.subtotal, 171200);
+  assert.equal(totals.total, 171200);
+});
+
+test('invoiceTotals handles empty lines', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 0, total: 0 });
+});
+
+test('invoiceTotals matches createInvoice result', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const expectedDev = 5 * 9500;
+  const expectedLogo = 1 * 120000;
+  assert.equal(totals.subtotal, expectedDev + expectedLogo);
+  assert.equal(totals.total, expectedDev + expectedLogo);
+});
+
+test('invoiceTotals does not mutate the invoice', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500 },
+      { qty: 1, unitPrice: 120000 },
+    ],
+  };
+
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+
+  invoiceTotals(invoice);
+
+  assert.deepEqual(invoice, invoiceCopy);
