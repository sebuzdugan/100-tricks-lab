+++ b/src/numbering.js
@@ -0,0 +1,18 @@
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Filter for numbers from this year
+  const prefix = `INV-${year}-`;
+  const thisYearsNumbers = existingNumbers.filter((n) => n.startsWith(prefix));
+
+  // Extract counters and find the maximum
+  const counters = thisYearsNumbers
+    .map((n) => parseInt(n.substring(prefix.length), 10))
+    .filter((c) => !Number.isNaN(c));
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+
+  // Return next number with zero-padded counter
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
