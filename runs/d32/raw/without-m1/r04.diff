diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..5ed4b3b
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber with no existing numbers', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber starts counter at 0001 for a new year', () => {
+  const existing = ['INV-2025-0010', 'INV-2025-0050'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments from highest counter in the year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0005', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = [
+    'INV-2024-0100',
+    'INV-2025-0050',
+    'INV-2026-0003',
+    'INV-2027-0001',
+  ];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existing = ['INV-2026-0009', 'INV-2026-0001', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = [];
+  assert.equal(nextInvoiceNumber(existing, '2026-01-01'), 'INV-2026-0001');
+
+  const existing2 = ['INV-2026-0099'];
+  assert.equal(nextInvoiceNumber(existing2, '2026-01-01'), 'INV-2026-0100');
+
+  const existing3 = ['INV-2026-9999'];
+  assert.equal(nextInvoiceNumber(existing3, '2026-01-01'), 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber skips malformed numbers', () => {
+  const existing = [
+    'INV-2026-0001',
+    'INV-2026-XXXX',
+    'INVALID',
+    'INV-2026-0003',
+  ];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber works with single digit year input (edge case)', () => {
+  // This is an edge case - issueDate should always be YYYY-MM-DD, but test robustness
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
