+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for draft invoice without number', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('INV-2026-0001'));
+  assert.ok(!text.includes('DRAFT'));
+});
+
+test('renderInvoiceText includes customer name on second line', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows each line with qty, name, unitPrice, and lineTotal', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 },
+      { sku: 'LOGO-PACK', qty: 1, name: 'Logo package', unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Check first invoice line: 5 x Development (hour) @ €95.00 = €475.00
+  assert.ok(lines[2].includes('5'));
+  assert.ok(lines[2].includes('Development (hour)'));
+  assert.ok(lines[2].includes('€95.00'));
+  assert.ok(lines[2].includes('€475.00'));
+
+  // Check second invoice line: 1 x Logo package @ €1,200.00 = €1,200.00
+  assert.ok(lines[3].includes('1'));
+  assert.ok(lines[3].includes('Logo package'));
+  assert.ok(lines[3].includes('€1,200.00'));
+});
+
+test('renderInvoiceText includes total amount on last line', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 },
+      { sku: 'LOGO-PACK', qty: 1, name: 'Logo package', unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  const totalLine = lines[lines.length - 1];
+  assert.ok(totalLine.startsWith('Total:'));
+  // 5 * 9500 + 1 * 120000 = 47500 + 120000 = 167500 cents = €1,675.00
+  assert.ok(totalLine.includes('€1,675.00'));
+});
+
+test('renderInvoiceText formats amounts through formatEuros', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'ICON-SET', qty: 100, name: 'Icon set (24 icons)', unitPrice: 980, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  // 100 * 980 = 98000 cents = €980.00
+  assert.ok(text.includes('€9.80')); // unit price
+  assert.ok(text.includes('€980.00')); // line total
+  assert.ok(text.includes('Total: €980.00'));
+});
+
+test('renderInvoiceText returns plain text with proper structure', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(typeof text === 'string');
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4); // number/DRAFT, customer, 1 invoice line, total
+
+  assert.ok(lines[0].length > 0); // invoice number or DRAFT
+  assert.ok(lines[1].length > 0); // customer name
+  assert.ok(lines[2].length > 0); // invoice line
+  assert.ok(lines[3].startsWith('Total:')); // total line
+});
+
+test('renderInvoiceText with multiple lines of varying prices', () => {
+  const invoice = {
+    number: 'INV-2026-0042',
+    customerId: 'C-003',
+    issueDate: '2026-10-15',
+    status: 'issued',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 },
+      { sku: 'DES-HOUR', qty: 5, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 },
+      { sku: 'PRINT-A4', qty: 500, name: 'Printed flyer A4 (each)', unitPrice: 37, vatRate: 9 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0042');
+  assert.equal(lines[1], 'Kite & Co');
+
+  // Check all three invoice lines exist
+  assert.ok(lines[2].includes('10'));
+  assert.ok(lines[2].includes('Development (hour)'));
+  assert.ok(lines[3].includes('5'));
+  assert.ok(lines[3].includes('Design work (hour)'));
+  assert.ok(lines[4].includes('500'));
+  assert.ok(lines[4].includes('Printed flyer A4 (each)'));
+
+  // Verify total: 10*9500 + 5*8500 + 500*37 = 95000 + 42500 + 18500 = 156000 cents = €1,560.00
+  assert.ok(lines[5].includes('Total: €1,560.00'));
+});
+
+test('renderInvoiceText handles single line invoice', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-008',
+    issueDate: '2026-01-01',
+    status: 'issued',
+    lines: [
+      { sku: 'WORKSHOP-DAY', qty: 2, name: 'Brand workshop (day, VAT exempt)', unitPrice: 60000, vatRate: 0 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Lumen Records');
+  assert.ok(lines[2].includes('2'));
+  assert.ok(lines[2].includes('Brand workshop (day, VAT exempt)'));
+  assert.ok(lines[2].includes('€600.00'));
+  assert.ok(lines[2].includes('€1,200.00'));
+  assert.equal(lines[3], 'Total: €1,200.00');
+});
+
+test('renderInvoiceText preserves customer name with special characters', () => {
+  const invoice = {
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  // Customer C-006 is 'Marlow "The Print Shop"'
+  assert.ok(text.includes('Marlow "The Print Shop"'));
+});
