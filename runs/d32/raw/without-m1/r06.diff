+test('invoiceTotals with no discount returns { subtotal, discount: 0, total }', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500, discountPercent: 0 },
+      { qty: 1, unitPrice: 120000, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 167500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 167500);
+});
+
+test('invoiceTotals with discount applies percentage to line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 9500, discountPercent: 10 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // subtotal = 100 * 9500 = 950000
+  // discount = 950000 * 10 / 100 = 95000
+  // total = 950000 - 95000 = 855000
+  assert.equal(totals.subtotal, 950000);
+  assert.equal(totals.discount, 95000);
+  assert.equal(totals.total, 855000);
+});
+
+test('invoiceTotals with multiple lines and different discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500, discountPercent: 10 },
+      { qty: 1, unitPrice: 120000, discountPercent: 20 },
+      { qty: 100, unitPrice: 1000, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // line 1: 5 * 9500 = 47500, discount = 4750, after = 42750
+  // line 2: 1 * 120000 = 120000, discount = 24000, after = 96000
+  // line 3: 100 * 1000 = 100000, discount = 0, after = 100000
+  // subtotal = 267500, discount = 28750, total = 238750
+  assert.equal(totals.subtotal, 267500);
+  assert.equal(totals.discount, 28750);
+  assert.equal(totals.total, 238750);
+});
+
+test('invoiceTotals with 100% discount on a line', () => {
