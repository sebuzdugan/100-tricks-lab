index 20410a7..2165be1 100644
--- a/src/invoices.js
+++ b/src/invoices.js
@@ -2,26 +2,40 @@ import { ok, fail } from './result.js';
 import { getCustomer, TIER_DISCOUNTS } from './customers.js';
 import { getProduct } from './catalogue.js';
 import { nextInvoiceNumber } from './numbering.js';
+import { roundCents } from './money.js';
 
 export function lineTotal(line) {
   return line.qty * line.unitPrice;
 }
 
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = total * ((line.discountPercent ?? 0) / 100);
+  const amountAfterDiscount = total - discount;
+  const vat = amountAfterDiscount * (line.vatRate / 100);
+  return roundCents(vat);
+}
+
 export function invoiceTotals(invoice) {
   let subtotal = 0;
   let discountTotal = 0;
+  let vatTotal = 0;
 
   for (const line of invoice.lines) {
     const itemTotal = lineTotal(line);
     const itemDiscount = itemTotal * ((line.discountPercent ?? 0) / 100);
+    const itemVAT = lineVAT(line);
     subtotal += itemTotal;
     discountTotal += itemDiscount;
+    vatTotal += itemVAT;
   }
 
+  const total = Math.max(0, subtotal - discountTotal + vatTotal);
   return {
     subtotal: Math.max(0, subtotal),
     discount: Math.max(0, discountTotal),
-    total: Math.max(0, subtotal - discountTotal),
+    vat: Math.max(0, vatTotal),
+    total,
   };
 }
 
