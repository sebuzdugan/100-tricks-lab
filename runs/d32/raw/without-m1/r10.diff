diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..267765e
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,115 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10/07/2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate('2026-10'), false);
+});
+
+test('isValidDate rejects impossible dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false); // February doesn't have 30 days
+  assert.equal(isValidDate('2026-04-31'), false); // April doesn't have 31 days
+  assert.equal(isValidDate('2026-13-01'), false); // No month 13
+  assert.equal(isValidDate('2026-00-01'), false); // No month 0
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2026-02-29'), false); // 2026 is not a leap year
+  assert.equal(isValidDate('2025-02-29'), false); // 2025 is not a leap year
+});
+
+test('isValidDate accepts leap year Feb 29', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // 2024 is a leap year
+  assert.equal(isValidDate('2000-02-29'), true); // 2000 is a leap year (divisible by 400)
+});
+
+test('isValidDate with empty string', () => {
+  assert.equal(isValidDate(''), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 30), '2026-11-06');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+  assert.equal(addDays('2026-10-07', -7), '2026-09-30');
+});
+
+test('addDays crosses month boundaries', () => {
+  assert.equal(addDays('2026-09-30', 1), '2026-10-01');
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays crosses year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2025-12-31', 365), '2026-12-31');
+});
+
+test('addDays with zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('daysBetween same date returns 0', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-11-06'), 30);
+});
+
+test('daysBetween negative difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-06'), -1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-02'), -5);
+  assert.equal(daysBetween('2026-10-07', '2026-09-30'), -7);
+});
+
+test('daysBetween across months', () => {
+  assert.equal(daysBetween('2026-09-30', '2026-10-01'), 1);
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+});
+
+test('daysBetween across years', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2025-12-31', '2026-12-31'), 365);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+});
+
+test('daysBetween is symmetric with addDays', () => {
+  const date1 = '2026-10-07';
+  const date2 = addDays(date1, 42);
+  assert.equal(daysBetween(date1, date2), 42);
+  assert.equal(daysBetween(date2, date1), -42);
+});
+
+test('daysBetween with large differences', () => {
+  // 10 years = roughly 3650 days (accounting for leap years)
+  const diff = daysBetween('2016-10-07', '2026-10-07');
+  assert.equal(diff, 3652); // 2020 and 2024 are leap years
+});
