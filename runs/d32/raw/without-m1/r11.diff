+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue returns total when no payments', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+  };
+
+  // subtotal = 100000, vat = 21000, total = 121000
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 121000);
+});
+
+test('balanceDue with no payments array', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 100000);
+});
+
+test('balanceDue with partial payment', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+    payments: [{ amount: 50000, date: '2026-10-07' }],
+  };
+
+  // total = 121000, paid = 50000, balance = 71000
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 71000);
+});
+
+test('balanceDue with full payment', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+    payments: [{ amount: 121000, date: '2026-10-07' }],
+  };
+
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue with multiple payments', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+    payments: [
+      { amount: 40000, date: '2026-10-07' },
+      { amount: 30000, date: '2026-10-14' },
+      { amount: 20000, date: '2026-10-21' },
+    ],
+  };
+
+  // total = 121000, paid = 90000, balance = 31000
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 31000);
+});
+
+test('recordPayment on issued invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2026-10-14' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2026-10-14');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 100000, date: '2026-10-14' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment keeps status as partially_paid for partial payment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2026-10-14' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'partially_paid',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    payments: [{ amount: 50000, date: '2026-10-07' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2026-10-14' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+  assert.equal(result.value.payments.length, 2);
+});
+
+test('recordPayment rejects draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2026-10-14' });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'paid',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    payments: [{ amount: 100000, date: '2026-10-07' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 1000, date: '2026-10-14' });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects zero amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 0, date: '2026-10-14' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects negative amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: -1000, date: '2026-10-14' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 1000.5, date: '2026-10-14' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 150000, date: '2026-10-14' });
+
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment rejects overpayment on partially_paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'partially_paid',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    payments: [{ amount: 60000, date: '2026-10-07' }],
+  };
+
+  // balance = 100000 - 60000 = 40000
+  const result = recordPayment(invoice, { amount: 50000, date: '2026-10-14' });
+
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+
+  recordPayment(invoice, { amount: 50000, date: '2026-10-14' });
+
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2026-10-14' });
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.payments);
+  assert.equal(result.value.payments.length, 1);
+});
+
+test('recordPayment with discount and VAT', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+
+  // subtotal = 100000, discount = 10000, afterDiscount = 90000
+  // vat = 90000 * 21/100 = 18900, total = 100000 - 10000 + 18900 = 108900
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 108900);
+
+  const result = recordPayment(invoice, { amount: 108900, date: '2026-10-14' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
