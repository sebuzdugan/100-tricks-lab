+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the balance still owed on an invoice.
+ * @param {object} invoice
+ * @returns {number} balance due in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
+
+/**
+ * Record a payment on an invoice.
+ * @param {object} invoice
+ * @param {object} payment
+ * @param {number} payment.amount - payment amount in cents (must be positive integer)
+ * @param {string} payment.date - payment date in YYYY-MM-DD format
+ * @returns {object} result with ok(newInvoice) or fail(error)
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate status - can only pay issued or partially_paid invoices
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new invoice with payment added
+  const payments = [...(invoice.payments ?? []), { amount, date }];
+  const newInvoice = { ...invoice, payments };
+
+  // Update status based on remaining balance
+  const newBalance = balance - amount;
+  if (newBalance === 0) {
+    newInvoice.status = 'paid';
+  } else {
+    newInvoice.status = 'partially_paid';
+  }
+
+  return ok(newInvoice);
+}
