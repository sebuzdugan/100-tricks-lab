+export function applyVoucher(invoice, { code, amount }) {
+  // Validate invoice is in draft status
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate no voucher already applied
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
