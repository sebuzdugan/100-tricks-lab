@@ -0,0 +1,255 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement for unknown customer returns CUSTOMER_NOT_FOUND', () => {
+  const result = statement('C-999', [], '2026-10-31');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement with no invoices returns empty list', () => {
+  const result = statement('C-001', [], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes only issued/partially_paid invoices', () => {
+  // Create and issue two invoices, leave one as draft
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const result = statement('C-001', [draft, issued], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2], '2026-10-10');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-22',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    [inv1.number, inv2.number]
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2, inv3], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-15');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-22');
+});
+
+test('statement includes required fields for each invoice', () => {
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const result = statement('C-001', [issued], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  const inv = result.value.invoices[0];
+  assert.ok(inv.number);
+  assert.ok(inv.issueDate);
+  assert.ok(inv.dueDate);
+  assert.ok('total' in inv);
+  assert.ok('due' in inv);
+});
+
+test('statement calculates due correctly for unpaid invoice', () => {
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = statement('C-002', [issued], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  const inv = result.value.invoices[0];
+  assert.equal(inv.due, inv.total); // fully unpaid
+});
+
+test('statement calculates due correctly for partially paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const withPayment = recordPayment(issued, { amount: 50000, date: '2026-10-14' }).value;
+
+  const result = statement('C-002', [withPayment], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  const inv = result.value.invoices[0];
+  assert.equal(inv.due, inv.total - 50000);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const fullPayment = recordPayment(issued, { amount: 1149500, date: '2026-10-14' }).value; // paying the full amount
+
+  const result = statement('C-002', [fullPayment], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  // Paid invoices should not appear in the statement
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement calculates totalDue as sum of all due amounts', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const inv2WithPayment = recordPayment(inv2, { amount: 500000, date: '2026-10-20' }).value;
+
+  const result = statement('C-001', [inv1, inv2WithPayment], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+
+  const due1 = result.value.invoices[0].due;
+  const due2 = result.value.invoices[1].due;
+  assert.equal(result.value.totalDue, due1 + due2);
+});
+
+test('statement normalizes customer ID', () => {
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'c-001', // lowercase
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const result = statement('  C-001  ', [issued], '2026-10-31'); // with spaces
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement filters by customer correctly with multiple customers', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, inv1.number);
+});
