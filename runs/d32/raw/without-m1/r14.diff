+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement showing open invoices.
+ * @param {string} customerId - Customer ID (normalized internally)
+ * @param {array} invoices - Array of all invoices
+ * @param {string} asOf - Statement date in YYYY-MM-DD format
+ * @returns {object} ok({ customerId, invoices, totalDue }) or fail(error)
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize and validate customer
+  const normalizedId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer
+  const customerInvoices = invoices.filter((inv) => {
+    // Check customer matches
+    if (inv.customerId !== normalizedId) return false;
+
+    // Check status (only issued or partially_paid)
+    if (inv.status !== 'issued' && inv.status !== 'partially_paid') return false;
+
+    // Check issue date is on or before asOf
+    if (inv.issueDate > asOf) return false;
+
+    // Must have a number (only issued invoices have numbers)
+    if (!inv.number) return false;
+
+    return true;
+  });
+
+  // Map to statement format
+  const statementInvoices = customerInvoices
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
