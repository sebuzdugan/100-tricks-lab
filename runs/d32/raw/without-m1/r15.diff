+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 50000, reason: 'Partial refund', date: '2026-10-14' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.number.startsWith('CN-2026-'));
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2026-10-14');
+});
+
+test('createCreditNote works for partially_paid invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 10000, reason: 'Quality issue', date: '2026-10-14' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.number);
+});
+
+test('createCreditNote works for paid invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 100000, reason: 'Full refund', date: '2026-10-14' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 50000, reason: 'Refund', date: '2026-10-14' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 0, reason: 'Refund', date: '2026-10-14' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: -10000, reason: 'Refund', date: '2026-10-14' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 50000.5, reason: 'Refund', date: '2026-10-14' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects credit exceeding invoice total', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 9999999, reason: 'Refund', date: '2026-10-14' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote generates sequential credit note numbers', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const cn1 = createCreditNote(
+    invoice,
+    { amount: 10000, reason: 'Refund 1', date: '2026-10-14' },
+    []
+  ).value;
+
+  const cn2 = createCreditNote(
+    invoice,
+    { amount: 20000, reason: 'Refund 2', date: '2026-10-15' },
+    [cn1.number]
+  ).value;
+
+  assert.equal(cn1.number, 'CN-2026-0001');
+  assert.equal(cn2.number, 'CN-2026-0002');
+});
+
+test('createCreditNote uses separate counter from invoices', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const cn = createCreditNote(
+    invoice,
+    { amount: 50000, reason: 'Refund', date: '2026-10-14' },
+    [
+      'INV-2026-0001',
+      'INV-2026-0002',
+      'INV-2026-0003',
+      'CN-2026-0001',
+    ]
+  ).value;
+
+  // Should be CN-2026-0002, not CN-2026-0004
+  assert.equal(cn.number, 'CN-2026-0002');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const cn2026 = createCreditNote(
+    invoice,
+    { amount: 10000, reason: 'Refund', date: '2026-10-14' },
+    ['CN-2026-0010']
+  ).value;
+
+  const invoice2027 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2027-01-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    ['INV-2027-0001']
+  ).value;
+
+  const cn2027 = createCreditNote(
+    invoice2027,
+    { amount: 10000, reason: 'Refund', date: '2027-01-14' },
+    ['CN-2026-0010']
+  ).value;
+
+  assert.equal(cn2026.number, 'CN-2026-0011');
+  assert.equal(cn2027.number, 'CN-2027-0001');
+});
+
+test('createCreditNote preserves all invoice details in reference', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-003',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const creditNote = createCreditNote(
+    invoice,
+    { amount: 50000, reason: 'Discount applied', date: '2026-10-20' },
+    []
+  ).value;
+
+  assert.equal(creditNote.invoiceNumber, invoice.number);
+  assert.equal(creditNote.customerId, invoice.customerId);
+});
+
+test('createCreditNote allows credit note up to full invoice total', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: totals.total, reason: 'Full refund', date: '2026-10-14' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+});
