+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the next credit note number based on existing numbers.
+ * Credit notes use CN-<year>-<counter> format with a separate counter from invoices.
+ * @param {array} existingNumbers - Array of both invoice and credit note numbers
+ * @param {string} issueDate - Credit note date in YYYY-MM-DD format
+ * @returns {string} - Next credit note number
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Filter for credit note numbers from this year
+  const prefix = `CN-${year}-`;
+  const thisYearsCreditNotes = existingNumbers.filter((n) =>
+    n.startsWith(prefix)
+  );
+
+  // Extract counters and find the maximum
+  const counters = thisYearsCreditNotes
+    .map((n) => parseInt(n.substring(prefix.length), 10))
+    .filter((c) => !Number.isNaN(c));
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+
+  // Return next number with zero-padded counter
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for refunding part of an invoice.
+ * @param {object} invoice - The invoice to credit (must be issued, partially_paid, or paid)
+ * @param {object} creditData
+ * @param {number} creditData.amount - Credit amount in cents
+ * @param {string} creditData.reason - Reason for the credit
+ * @param {string} creditData.date - Credit note date in YYYY-MM-DD format
+ * @param {array} existingNumbers - Array of existing invoice and credit note numbers
+ * @returns {object} ok(creditNote) or fail(error)
+ */
+export function createCreditNote(
+  invoice,
+  { amount, reason, date },
+  existingNumbers
+) {
+  // Validate invoice status - must be issued, partially_paid, or paid
+  if (
+    invoice.status !== 'issued' &&
+    invoice.status !== 'partially_paid' &&
+    invoice.status !== 'paid'
+  ) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const totals = invoiceTotals(invoice);
+
+  // Validate amount doesn't exceed invoice total
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
