+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices with empty invoices array returns empty list', () => {
+  const result = overdueInvoices([], '2026-10-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices with no overdue invoices returns empty list', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([invoice], '2026-10-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices finds a single overdue invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([invoice], '2026-10-31');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoice.number);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, invoice.dueDate);
+  assert.ok(result[0].daysOverdue > 0);
+  assert.ok('due' in result[0]);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const result = overdueInvoices([draft], '2026-10-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2026-10-14' }).value;
+
+  const result = overdueInvoices([paid], '2026-10-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  // Default terms is NET30, so dueDate is 2026-11-06
+  // Check before due date
+  const result = overdueInvoices([invoice], '2026-11-05');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes invoice on day after due date', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  // dueDate should be 2026-11-06 (NET30)
+  // One day after due date is 2026-11-07
+  const result = overdueInvoices([invoice], '2026-11-07');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices includes invoice several days after due date', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  // dueDate should be 2026-11-06 (NET30)
+  // Check several days after
+  const result = overdueInvoices([invoice], '2026-11-10');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 4);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([invoice], '2026-10-31');
+  // dueDate should be 2026-10-01
+  // days between 2026-10-01 and 2026-10-31 is 30 days
+  assert.equal(result[0].daysOverdue, 30);
+});
+
+test('overdueInvoices sorts by daysOverdue descending (most overdue first)', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-08-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    [inv1.number, inv2.number]
+  ).value;
+
+  const result = overdueInvoices([inv1, inv2, inv3], '2026-10-31');
+
+  assert.equal(result.length, 3);
+  assert.ok(result[0].daysOverdue >= result[1].daysOverdue);
+  assert.ok(result[1].daysOverdue >= result[2].daysOverdue);
+  assert.equal(result[0].number, inv1.number);
+  assert.equal(result[1].number, inv2.number);
+  assert.equal(result[2].number, inv3.number);
+});
+
+test('overdueInvoices with partially_paid invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const partialPayment = recordPayment(invoice, {
+    amount: 500000,
+    date: '2026-10-14',
+  }).value;
+
+  const result = overdueInvoices([partialPayment], '2026-10-31');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].status, undefined); // not included in output
+  assert.ok(result[0].due > 0); // balance due
+});
+
+test('overdueInvoices calculates due for partially_paid invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const paymentAmount = 500000;
+  const partialPayment = recordPayment(invoice, {
+    amount: paymentAmount,
+    date: '2026-10-14',
+  }).value;
+
+  const result = overdueInvoices([partialPayment], '2026-10-31');
+
+  const fullAmount = result[0].due + paymentAmount;
+  assert.ok(fullAmount > 0); // should have paid partial amount
+});
+
+test('overdueInvoices includes all required fields', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([invoice], '2026-10-31');
+
+  assert.equal(result.length, 1);
+  const overdue = result[0];
+  assert.ok(overdue.number);
+  assert.ok(overdue.customerId);
+  assert.ok(overdue.dueDate);
+  assert.ok('daysOverdue' in overdue);
+  assert.ok('due' in overdue);
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const result = overdueInvoices([inv1, inv2], '2026-10-31');
+
+  assert.equal(result.length, 2);
+  assert.ok(
+    result.some((r) => r.customerId === 'C-001') &&
+      result.some((r) => r.customerId === 'C-002')
+  );
+});
+
+test('overdueInvoices preserves invoice number and customer ID', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-003',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([invoice], '2026-10-31');
+
+  assert.equal(result[0].number, invoice.number);
+  assert.equal(result[0].customerId, 'C-003');
+});
+
+test('overdueInvoices with mixed statuses', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([draft, issued], '2026-10-31');
+
+  // Only the issued invoice should appear
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.number);
+});
+
+test('overdueInvoices returns empty for future invoices', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-12-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([invoice], '2026-10-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices with large number of invoices', () => {
+  const invoices = [];
+  // Create invoices from January through October, each with NET30 terms
+  for (let i = 1; i <= 10; i++) {
+    const monthStr = String(i).padStart(2, '0');
+    const invoice = issueInvoice(
+      createInvoice({
+        customerId: `C-${String(i).padStart(3, '0')}`,
+        issueDate: `2026-${monthStr}-07`,
+        lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+        terms: 'NET30',
+      }).value,
+      invoices.map((inv) => inv.number)
+    ).value;
+    invoices.push(invoice);
+  }
+
+  const result = overdueInvoices(invoices, '2026-10-31');
+
+  assert.ok(result.length <= invoices.length);
+  // First several invoices (with earlier issue dates) should be overdue by 2026-10-31
+  assert.ok(result.length > 0);
+  // Should be sorted by daysOverdue descending
+  for (let i = 1; i < result.length; i++) {
+    assert.ok(result[i - 1].daysOverdue >= result[i].daysOverdue);
+  }
+});
