+test('vatSummary with empty invoices returns empty array', () => {
+  const result = vatSummary([]);
+  assert.deepEqual(result, []);
+});
+
+test('vatSummary with no issued invoices returns empty array', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const result = vatSummary([draft]);
+  assert.deepEqual(result, []);
+});
+
+test('vatSummary with single issued invoice calculates VAT', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = vatSummary([invoice]);
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].rate, 21);
+  assert.ok(result[0].base > 0);
+  assert.ok(result[0].vat > 0);
+});
