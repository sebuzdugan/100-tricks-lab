@@ -23,3 +24,41 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+export function vatSummary(invoices) {
+  const vats = {};
+
+  for (const invoice of invoices) {
+    if (
+      invoice.status !== 'issued' &&
+      invoice.status !== 'partially_paid' &&
+      invoice.status !== 'paid'
+    ) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const lineTotal = line.qty * line.unitPrice;
+      const discountPercent = line.discountPercent ?? 0;
+      const lineDiscount = roundCents((lineTotal * discountPercent) / 100);
+      const lineBase = lineTotal - lineDiscount;
+      const lineVAT = roundCents((lineBase * line.vatRate) / 100);
+
+      const rate = line.vatRate;
+      if (!vats[rate]) {
+        vats[rate] = { base: 0, vat: 0 };
+      }
+
+      vats[rate].base += lineBase;
+      vats[rate].vat += lineVAT;
+    }
+  }
+
+  return Object.entries(vats)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseFloat(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
