+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv with empty array returns header only', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 2); // header + empty line at end
+  assert.equal(
+    lines[0],
+    'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'
+  );
+});
+
+test('exportCsv includes header line', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+
+  assert.equal(
+    lines[0],
+    'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'
+  );
+});
+
+test('exportCsv ends with newline', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  assert.equal(result.slice(-1), '\n');
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.trim().split('\n');
+
+  assert.equal(lines.length, 2); // header + data
+  assert.ok(lines[1].includes(invoice.number));
+  assert.ok(lines[1].includes('2026-10-07'));
+});
+
+test('exportCsv includes customer name not ID', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.trim().split('\n');
+
+  // Get the customer name from CSV (second field)
+  const fields = lines[1].split(',');
+  const customerName = fields[1];
+
+  // Should have customer name in the field
+  assert.ok(customerName.length > 0);
+  // Customer name should not be the ID
+  assert.notEqual(customerName, 'C-001');
+});
+
+test('exportCsv formats amounts as plain euros', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.trim().split('\n');
+
+  // Amounts should be like 5000.00, not €5,000.00
+  assert.ok(/\d+\.\d{2}/.test(lines[1])); // has decimal format
+  assert.ok(!lines[1].includes('€')); // no euro sign
+});
+
+test('exportCsv with draft invoice shows DRAFT as number', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const result = exportCsv([draft]);
+  const lines = result.trim().split('\n');
+
+  assert.ok(lines[1].startsWith('DRAFT,'));
+});
+
+test('exportCsv escapes fields with commas', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
