+  assert.equal(lines.length, 3); // header + 2 invoices
+  assert.ok(lines[1].includes(inv1.number));
+  assert.ok(lines[2].includes(inv2.number));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-02',
+      lines: [{ sku: 'DEV-HOUR', qty: 20 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-03',
+      lines: [{ sku: 'DEV-HOUR', qty: 30 }],
+    }).value,
+    [inv1.number, inv2.number]
+  ).value;
+
+  const result = exportCsv([inv3, inv1, inv2]); // out of order
+  const lines = result.trim().split('\n');
+
+  assert.ok(lines[1].includes(inv3.number));
+  assert.ok(lines[2].includes(inv1.number));
+  assert.ok(lines[3].includes(inv2.number));
+});
+
+test('exportCsv includes invoice fields in correct order', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.trim().split('\n');
+  const fields = lines[1].split(',');
+
+  // Check that we have the right number of fields
+  assert.ok(fields.length >= 10); // at least number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due
+
+  // Check that number is first, date is third, status is fifth
+  assert.ok(fields[0].includes(invoice.number));
+  assert.ok(fields[2].includes('2026-10-07'));
+  assert.ok(fields[4].includes('issued'));
+});
+
+test('exportCsv with partial payment', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const totals = invoiceTotals(invoice);
+  const partial = recordPayment(invoice, {
+    amount: Math.floor(totals.total / 2),
+    date: '2026-10-14',
+  }).value;
+
+  const result = exportCsv([partial]);
+  const lines = result.trim().split('\n');
+
+  // Status should be partially_paid
+  assert.ok(lines[1].includes('partially_paid'));
+});
+
+test('exportCsv with paid invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, {
+    amount: totals.total,
+    date: '2026-10-14',
+  }).value;
+
+  const result = exportCsv([paid]);
+  const lines = result.trim().split('\n');
+
+  // Status should be paid and due should be 0.00
