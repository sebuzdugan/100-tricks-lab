+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DEV-HOUR', qty: 50 }],
+    }).value,
