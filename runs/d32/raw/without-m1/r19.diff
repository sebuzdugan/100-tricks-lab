+test('exportCsv with discount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.trim().split('\n');
+
+  // discount should be > 0
