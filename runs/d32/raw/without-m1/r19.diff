+
+test('exportCsv amounts have exactly 2 decimals', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
