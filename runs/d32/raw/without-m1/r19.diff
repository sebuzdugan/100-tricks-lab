+
+test('exportCsv CSV is parseable', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DEV-HOUR', qty: 50 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const result = exportCsv([inv1, inv2]);
+
+  // Parse the CSV and verify structure
+  const lines = result.trim().split('\n');
+  assert.equal(lines.length, 3); // header + 2 data rows
+
+  // Each line should have 10 fields
+  const headerFields = lines[0].split(',');
+  assert.equal(headerFields.length, 10);
+
+  // Each data row should have at least 10 comma-separated values (more if quotes)
+  for (let i = 1; i < lines.length; i++) {
+    // Basic check: should have content
+    assert.ok(lines[i].length > 0);
+  }
+});
+
+test('exportCsv with mixed invoices and drafts', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DEV-HOUR', qty: 50 }],
+    }).value,
