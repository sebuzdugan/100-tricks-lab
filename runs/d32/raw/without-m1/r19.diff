+  ).value;
+
+  const result = exportCsv([draft, issued]);
+  const lines = result.trim().split('\n');
+
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].startsWith('DRAFT,'));
+  assert.ok(lines[2].includes(issued.number));
+});
