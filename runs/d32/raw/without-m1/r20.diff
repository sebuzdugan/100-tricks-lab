+
+test('RATES has EUR, USD, GBP', () => {
+  assert.ok('EUR' in RATES);
+  assert.ok('USD' in RATES);
+  assert.ok('GBP' in RATES);
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(100000, 'EUR');
+  assert.deepEqual(result, { ok: true, value: 100000 });
+});
+
+test('convert EUR to USD multiplies by rate', () => {
+  const result = convert(100000, 'USD');
+  assert.equal(result.ok, true);
+  // 100000 cents EUR = 1000 EUR
+  // 1000 EUR * 1.085 = 1085 USD
+  // 1085 USD = 108500 cents
+  assert.equal(result.value, 108500);
+});
+
+test('convert EUR to GBP multiplies by rate', () => {
+  const result = convert(100000, 'GBP');
+  assert.equal(result.ok, true);
+  // 100000 cents EUR = 1000 EUR
+  // 1000 EUR * 0.8425 = 842.5 GBP
+  // 842.5 GBP = 84250 cents
+  assert.equal(result.value, 84250);
+});
+
+test('convert with unknown currency returns UNKNOWN_CURRENCY', () => {
+  const result = convert(100000, 'JPY');
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('convert rounds to cents', () => {
+  const result = convert(333, 'USD'); // 3.33 EUR * 1.085 = 3.614 USD = 361.4 cents
+  assert.equal(result.ok, true);
+  // Should be rounded
+  assert.equal(result.value, Math.round(333 * 1.085));
+});
+
+test('convert handles negative amounts', () => {
