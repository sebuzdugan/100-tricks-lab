+
+test('formatMoney has exactly 2 decimals', () => {
+  assert.equal(formatMoney(1000, 'EUR'), '€10.00');
+  assert.equal(formatMoney(1001, 'USD'), '$10.01');
+  assert.equal(formatMoney(1010, 'GBP'), '£10.10');
