index fadf486..6033acf 100644
--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,41 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  if (currency === 'EUR') {
+    return ok(cents);
+  }
+
+  const euros = cents / 100;
+  const amount = euros * RATES[currency];
+  const convertedCents = roundCents(amount * 100);
+
+  return ok(convertedCents);
+}
+
+export function formatMoney(cents, currency) {
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  const symbol = symbols[currency] ?? '';
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const wholeAmount = Math.floor(abs / 100)
+    .toString()
+    .replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${wholeAmount}.${String(abs % 100).padStart(2, '0')}`;
+}
