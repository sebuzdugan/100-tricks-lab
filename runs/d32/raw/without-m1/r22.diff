+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies quantity by unit price', () => {
+  const line = { qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineTotal(line), 500000);
+});
+
+test('lineTotal works with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 5000, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal works with large numbers', () => {
+  const line = { qty: 1000000, unitPrice: 10000, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineTotal(line), 10000000000);
+});
+
+test('lineVAT with no discount', () => {
+  const line = { qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineVAT(line), 105000);
+});
+
+test('lineVAT calculates VAT on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 5000, discountPercent: 10, vatRate: 21 };
+  // Total: 500000, Discount: 50000, After discount: 450000
+  // VAT: 450000 * 21 / 100 = 94500
+  assert.equal(lineVAT(line), 94500);
+});
+
+test('lineVAT with 0% VAT rate', () => {
+  const line = { qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT with different VAT rates', () => {
+  const line9 = { qty: 5, unitPrice: 2000, discountPercent: 0, vatRate: 9 };
+  const line21 = { qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 };
+
+  assert.equal(lineVAT(line9), 900);
+  assert.equal(lineVAT(line21), 105000);
+});
+
+test('invoiceTotals calculates subtotal and total from a single line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 500000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 105000);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 605000);
+});
+
+test('invoiceTotals sums all line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+      { qty: 50, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 750000);
+});
+
+test('invoiceTotals handles empty lines', () => {
+  const invoice = { lines: [] };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 0);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with no discount returns correct structure', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.ok('subtotal' in result);
+  assert.ok('discount' in result);
+  assert.ok('vat' in result);
+  assert.ok('voucher' in result);
+  assert.ok('total' in result);
+});
+
+test('invoiceTotals with discount applies percentage to line totals', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 10, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 500000);
+  assert.equal(result.discount, 50000);
+  assert.equal(result.vat, 94500);
+  assert.equal(result.total, 544500);
+});
+
+test('invoiceTotals with multiple lines and different discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 5000, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 5000, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 750000);
+  assert.equal(result.discount, 62500); // 50000 + 12500
+});
+
+test('invoiceTotals with 100% discount on a line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 100, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 500000);
+  assert.equal(result.discount, 500000);
+  assert.equal(result.vat, 0);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with decimal discount percentage', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 12.5, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 500000);
+  assert.equal(result.discount, 62500);
+});
+
+test('invoiceTotals includes voucher field', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.voucher, 0);
+});
+
+test('invoiceTotals with voucher calculates total correctly', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 50000 },
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.total, 555000); // 605000 - 50000
+});
+
+test('invoiceTotals with voucher larger than final total clamps to 0', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 1000000 },
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals does not mutate the invoice', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+  };
+  const original = JSON.stringify(invoice);
+
+  invoiceTotals(invoice);
+
+  assert.equal(JSON.stringify(invoice), original);
+});
+
+test('invoiceTotals total formula: subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 5000, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 5000, discountPercent: 5, vatRate: 9 },
+    ],
+    voucher: { code: 'TEST', amount: 25000 },
+  };
+  const result = invoiceTotals(invoice);
+
+  const expected = result.subtotal - result.discount + result.vat - result.voucher;
+  assert.equal(result.total, expected);
+});
+
+test('invoiceTotals with multiple VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 2000, discountPercent: 0, vatRate: 9 },
+      { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  const vat21 = 500000 * 0.21;
+  const vat9 = 10000 * 0.09;
+  const vat0 = 0;
+
+  assert.equal(result.subtotal, 520000);
+  assert.ok(result.vat > 0);
+});
+
+test('invoiceTotals clamping returns non-negative totals', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.ok(result.subtotal >= 0);
+  assert.ok(result.discount >= 0);
+  assert.ok(result.vat >= 0);
+  assert.ok(result.voucher >= 0);
+  assert.ok(result.total >= 0);
+});
+
+test('lineVAT with undefined discount percent defaults to 0', () => {
+  const line = { qty: 100, unitPrice: 5000, vatRate: 21 };
+  const result = lineVAT(line);
+
+  assert.equal(result, 105000);
+});
+
+test('invoiceTotals with undefined discount percent on line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.discount, 0);
+  assert.equal(result.total, 605000);
+});
+
+test('lineTotal with decimal values', () => {
+  const line = { qty: 1, unitPrice: 1.5, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineTotal(line), 1.5);
+});
+
+test('invoiceTotals preserves fields in correct order', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  const keys = Object.keys(result);
+
+  assert.deepEqual(keys, ['subtotal', 'discount', 'vat', 'voucher', 'total']);
+});
