diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..dc9ee7d
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,38 @@
+import { roundCents } from './money.js';
+
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = total * ((line.discountPercent ?? 0) / 100);
+  const amountAfterDiscount = total - discount;
+  const vat = amountAfterDiscount * (line.vatRate / 100);
+  return roundCents(vat);
+}
+
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discountTotal = 0;
+  let vatTotal = 0;
+
+  for (const line of invoice.lines) {
+    const itemTotal = lineTotal(line);
+    const itemDiscount = itemTotal * ((line.discountPercent ?? 0) / 100);
+    const itemVAT = lineVAT(line);
+    subtotal += itemTotal;
+    discountTotal += itemDiscount;
+    vatTotal += itemVAT;
+  }
+
+  const voucherAmount = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discountTotal + vatTotal - voucherAmount);
+  return {
+    subtotal: Math.max(0, subtotal),
+    discount: Math.max(0, discountTotal),
+    vat: Math.max(0, vatTotal),
+    voucher: Math.max(0, voucherAmount),
+    total,
+  };
+}
