@@ -4,11 +4,29 @@ export function lineTotal(line) {
   return line.qty * line.unitPrice;
 }
 
-export function lineVAT(line) {
+function lineBulkDiscount(line) {
+  if (line.qty < 10) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const lineDiscount = total * ((line.discountPercent ?? 0) / 100);
+  const amountAfterLineDiscount = total - lineDiscount;
+  const bulkDiscount = amountAfterLineDiscount * 0.025;
+  return roundCents(bulkDiscount);
+}
+
+function lineAmountAfterAllDiscounts(line) {
   const total = lineTotal(line);
-  const discount = total * ((line.discountPercent ?? 0) / 100);
-  const amountAfterDiscount = total - discount;
-  const vat = amountAfterDiscount * (line.vatRate / 100);
+  const lineDiscount = total * ((line.discountPercent ?? 0) / 100);
+  const amountAfterLineDiscount = total - lineDiscount;
+  const bulkDiscount = lineBulkDiscount(line);
+  const amountAfterAllDiscounts = amountAfterLineDiscount - bulkDiscount;
+  return Math.max(0, amountAfterAllDiscounts);
+}
+
+export function lineVAT(line) {
+  const amountAfterAllDiscounts = lineAmountAfterAllDiscounts(line);
+  const vat = amountAfterAllDiscounts * (line.vatRate / 100);
   return roundCents(vat);
 }
 
