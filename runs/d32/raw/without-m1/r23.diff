     const itemTotal = lineTotal(line);
-    const itemDiscount = itemTotal * ((line.discountPercent ?? 0) / 100);
+    const itemLineDiscount = itemTotal * ((line.discountPercent ?? 0) / 100);
+    const itemBulkDiscount = lineBulkDiscount(line);
     const itemVAT = lineVAT(line);
     subtotal += itemTotal;
-    discountTotal += itemDiscount;
+    discountTotal += itemLineDiscount + itemBulkDiscount;
     vatTotal += itemVAT;
   }
 
