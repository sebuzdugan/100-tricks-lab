+  // Total: 10000, Line discount: 0, After line discount: 10000
+  // Bulk discount (2.5%): 250
+  // After bulk discount: 9750
+  // VAT: 9750 * 21 / 100 = 2047.5 ≈ 2048
+  const result = lineVAT(line);
