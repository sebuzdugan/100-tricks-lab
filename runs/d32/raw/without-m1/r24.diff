diff --git a/src/reports.js b/src/reports.js
index f72ebc5..ec7d124 100644
--- a/src/reports.js
+++ b/src/reports.js
@@ -79,3 +79,47 @@ export function lateFee(invoice, asOf) {
   const feeAmount = due * 0.0004 * daysOverdue;
   return roundCents(feeAmount);
 }
+
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDues = {};
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] ?? 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDues[invoice.customerId]) {
+        customerDues[invoice.customerId] = 0;
+      }
+      customerDues[invoice.customerId] += due;
+    }
+  }
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue.reduce((sum, inv) => sum + inv.due, 0);
+
+  const topCustomers = Object.entries(customerDues)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
