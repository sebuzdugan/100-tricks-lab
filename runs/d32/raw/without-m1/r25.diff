diff --git a/src/render.js b/src/render.js
index 597d210..33a0e43 100644
--- a/src/render.js
+++ b/src/render.js
@@ -2,6 +2,12 @@ import { getCustomer } from './customers.js';
 import { formatEuros } from './money.js';
 import { invoiceTotals, lineTotal } from './invoices.js';
 
+function calculateLineDiscount(line) {
+  const total = lineTotal(line);
+  const discountAmount = total * ((line.discountPercent ?? 0) / 100);
+  return discountAmount;
+}
+
 export function renderInvoiceText(invoice) {
   // Get customer name
   const customerResult = getCustomer(invoice.customerId);
@@ -23,15 +29,37 @@ export function renderInvoiceText(invoice) {
   // Invoice lines
   for (const line of invoice.lines) {
     const total = lineTotal(line);
-    const lineText = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    let lineText = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+
+    const discount = calculateLineDiscount(line);
+    if (discount > 0) {
+      lineText += ` (${line.discountPercent}% discount)`;
+    }
+
     lines.push(lineText);
   }
 
   // VAT line
   lines.push(`VAT: ${formatEuros(totals.vat)}`);
 
+  // Voucher line (if applicable)
+  if (invoice.voucher) {
+    lines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   // Total line
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date line (if applicable)
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid line (if applicable)
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
