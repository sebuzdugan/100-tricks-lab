+++ b/src/invoices.js
@@ -0,0 +1,88 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} input
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: 'draft', lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issue date
+  const dateError = validateIssueDate(issueDate);
+  if (dateError) return fail(dateError);
+
+  // Validate lines array
+  if (!Array.isArray(lines) || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Process and validate each line
+  const processedLines = [];
+  for (const line of lines) {
+    // Validate quantity
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Validate SKU and get product
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    processedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  // Build invoice
+  const invoice = {
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: processedLines,
+  };
+
+  return ok(invoice);
+}
+
+/**
+ * Validate issue date format and that it's a real date.
+ * @param {string} dateStr
+ * @returns {string | null} error code or null if valid
+ */
+function validateIssueDate(dateStr) {
+  if (typeof dateStr !== 'string') return 'DATE_INVALID';
+
+  // Check format YYYY-MM-DD
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!match) return 'DATE_INVALID';
+
+  const year = parseInt(match[1], 10);
+  const month = parseInt(match[2], 10);
+  const day = parseInt(match[3], 10);
+
+  // Validate month and day ranges
+  if (month < 1 || month > 12 || day < 1 || day > 31) {
+    return 'DATE_INVALID';
+  }
+
+  // Check if it's a real date by creating a Date and verifying
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  if (isNaN(date.getTime())) return 'DATE_INVALID';
+
+  // Verify that the date components match (handles invalid dates like Feb 30)
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() + 1 !== month || date.getUTCDate() !== day) {
+    return 'DATE_INVALID';
+  }
+
+  return null;
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..e265d27
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,227 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with product details', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+  const inv = result.value;
+  assert.equal(inv.customerId, 'C-001');
+  assert.equal(inv.issueDate, '2026-10-07');
+  assert.equal(inv.status, 'draft');
+  assert.equal(inv.lines.length, 1);
+  assert.equal(inv.lines[0].sku, 'DES-HOUR');
+  assert.equal(inv.lines[0].name, 'Design work (hour)');
+  assert.equal(inv.lines[0].qty, 5);
+  assert.equal(inv.lines[0].unitPrice, 8500);
+  assert.equal(inv.lines[0].vatRate, 21);
+});
+
+test('createInvoice supports multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-06',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[1].name, 'Logo package');
+});
+
+test('createInvoice reports unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026/10/07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects incomplete date', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects invalid month', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-13-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects invalid day', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-02-30',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects zero day', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-00',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects non-string date', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: 20261007,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects empty lines array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice rejects non-array lines', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: null,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice rejects zero quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 0 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects negative quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: -5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects fractional quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5.5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice stops at first error (customer before date)', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: 'invalid',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  };
+  const original = JSON.stringify(input);
+  createInvoice(input);
+  assert.equal(JSON.stringify(input), original);
+});
+
+test('createInvoice accepts valid dates', () => {
+  const validDates = [
+    '2026-01-01', // Jan 1
+    '2026-02-28', // Feb 28
+    '2024-02-29', // leap year
+    '2026-12-31', // Dec 31
+  ];
+
+  for (const date of validDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, true, `Date ${date} should be valid`);
+  }
+});
+
+test('createInvoice rejects non-leap-year Feb 29', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-29',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
