+
+test('lineTotal multiplies qty by unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 9500 }), 95000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 120000 }), 120000);
+});
+
+test('lineTotal with qty of 1', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 5000 }), 5000);
+});
+
+test('lineTotal with large quantities', () => {
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 1000 }), 1000000);
+});
+
+test('invoiceTotals sums all line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500 },
+      { qty: 10, unitPrice: 9500 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500 + 95000); // 137500
+  assert.equal(totals.total, 137500);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 120000 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 120000);
+  assert.equal(totals.total, 120000);
+});
+
+test('invoiceTotals with multiple lines of varying amounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 1000 },
+      { qty: 3, unitPrice: 5000 },
+      { qty: 1, unitPrice: 10000 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // 2*1000 + 3*5000 + 1*10000 = 2000 + 15000 + 10000 = 27000
+  assert.equal(totals.subtotal, 27000);
+  assert.equal(totals.total, 27000);
+});
