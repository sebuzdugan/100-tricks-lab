+test('addLine adds a new line to a draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+  const invoice = result.value;
+
+  const addResult = addLine(invoice, { sku: 'DEV-HOUR', qty: 3 });
+  assert.equal(addResult.ok, true);
+  assert.equal(addResult.value.lines.length, 2);
+  assert.equal(addResult.value.lines[1].sku, 'DEV-HOUR');
+  assert.equal(addResult.value.lines[1].qty, 3);
+  assert.equal(addResult.value.lines[1].name, 'Development (hour)');
+});
