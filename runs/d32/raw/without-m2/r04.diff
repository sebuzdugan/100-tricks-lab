@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-9999'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores duplicate years', () => {
+  const existing = ['INV-2026-0001', 'INV-2025-0005', 'INV-2026-0003', 'INV-2025-0003', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber works in any order', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2026-9999'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2027-01-01');
+  assert.equal(number, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber handles dates at different times of year', () => {
+  const existing = ['INV-2026-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2026-01-01'), 'INV-2026-0002');
+  assert.equal(nextInvoiceNumber(existing, '2026-06-15'), 'INV-2026-0002');
+  assert.equal(nextInvoiceNumber(existing, '2026-12-31'), 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber with empty existing numbers', () => {
+  const number = nextInvoiceNumber([], '2024-02-29');
+  assert.equal(number, 'INV-2024-0001');
+});
