+/**
+ * Calculate the next invoice number for a given year.
+ * @param {Array<string>} existingNumbers array of invoice numbers already used (e.g., ['INV-2026-0001', 'INV-2026-0003'])
+ * @param {string} issueDate invoice issue date in YYYY-MM-DD format
+ * @returns {string} the next free invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Filter to numbers from the same year
+  const yearPattern = new RegExp(`^INV-${year}-\\d{4}$`);
+  const yearNumbers = existingNumbers.filter((num) => yearPattern.test(num));
+
+  // Extract counters and find the max
+  let maxCounter = 0;
+  for (const num of yearNumbers) {
+    const counter = parseInt(num.substring(num.length - 4), 10);
+    if (counter > maxCounter) {
+      maxCounter = counter;
+    }
+  }
+
+  // Return the next number
+  const nextCounter = maxCounter + 1;
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
