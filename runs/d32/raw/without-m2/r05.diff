+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issueResult = issueInvoice(result.value, []);
+  const text = renderInvoiceText(issueResult.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0001');
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText includes line details', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  // Line format: "5 × Design work (hour) @ €85.00 = €425.00"
+  assert(lines[2].includes('5'));
+  assert(lines[2].includes('Design work (hour)'));
+  assert(lines[2].includes('€85.00'));
+  assert(lines[2].includes('€425.00'));
+});
+
+test('renderInvoiceText includes total line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  const lastLine = lines[lines.length - 1];
+  assert(lastLine.startsWith('Total: '));
+  assert(lastLine.includes('€425.00'));
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  // Should have: number, customer, line1, line2, total
+  assert.equal(lines.length, 5);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert(lines[2].includes('Design work (hour)'));
+  assert(lines[3].includes('Development (hour)'));
+  assert(lines[4].startsWith('Total:'));
+});
+
+test('renderInvoiceText formats amounts with € symbol', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  // LOGO-PACK has unitPrice 120000 (€1,200.00)
+  assert(text.includes('€1,200.00'));
+});
+
+test('renderInvoiceText with VAT-exempt product', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  // WORKSHOP-DAY has unitPrice 60000 (€600.00)
+  assert(text.includes('€600.00'));
+});
+
+test('renderInvoiceText with different customer', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText with unknown customer gracefully handles missing data', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // Should include customer ID in the fallback
+  assert(lines[1].includes('C-999'));
+  assert(lines[1].includes('Unknown'));
+});
+
+test('renderInvoiceText sums multiple lines correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },     // 2 * 8500 = 17000
+      { sku: 'DEV-HOUR', qty: 3 },     // 3 * 9500 = 28500
+      { sku: 'COPY-HOUR', qty: 1 },    // 1 * 6000 = 6000
+    ],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  const totalLine = lines[lines.length - 1];
+  // Total should be 17000 + 28500 + 6000 = 51500 = €515.00
+  assert(totalLine.includes('€515.00'));
+});
+
+test('renderInvoiceText with single line invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 10 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  // Should have: number, customer, line, total
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert(lines[2].includes('Icon set'));
+  assert(lines[3].startsWith('Total:'));
+});
+
+test('renderInvoiceText with large quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1000 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  // STICKER costs 50 cents each, 1000 * 50 = 50000 = €500.00
+  assert(text.includes('1000'));
+  assert(text.includes('€500.00'));
+});
+
+test('renderInvoiceText includes line quantity in simple format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 7 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  // Should show the quantity in the line
+  assert(text.includes('7 ×'));
+});
+
+test('renderInvoiceText with issued invoice has all details', () => {
+  let result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-31',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'SUPPORT-HOUR', qty: 10 },
+    ],
+  });
+
+  const issueResult = issueInvoice(result.value, []);
+  const text = renderInvoiceText(issueResult.value);
+  const lines = text.split('\n');
+
+  // Verify all components
+  assert.equal(lines[0], 'INV-2025-0001');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert(lines[2].includes('Logo package'));
+  assert(lines[3].includes('Support (hour)'));
+  assert(lines[4].startsWith('Total:'));
+});
