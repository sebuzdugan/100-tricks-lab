+/**
+ * Validate discount percent value.
+ * @param {unknown} value
+ * @returns {string | null} error code or null if valid
+ */
+function validateDiscountPercent(value) {
+  if (value === undefined || value === null) {
+    return null;
+  }
+  if (typeof value !== 'number' || value < 0 || value > 100) {
+    return 'DISCOUNT_INVALID';
+  }
+  return null;
