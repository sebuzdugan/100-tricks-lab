diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..c3e9dd6
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,146 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+import { createInvoice } from '../src/invoices.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('26-10-07'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate('10-07'), false);
+  assert.equal(isValidDate('2026-10-07 '), false);
+  assert.equal(isValidDate(' 2026-10-07'), false);
+});
+
+test('isValidDate rejects invalid month', () => {
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-99-01'), false);
+});
+
+test('isValidDate rejects invalid day', () => {
+  assert.equal(isValidDate('2026-10-00'), false);
+  assert.equal(isValidDate('2026-10-32'), false);
+  assert.equal(isValidDate('2026-10-99'), false);
+});
+
+test('isValidDate rejects Feb 30', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2024-02-30'), false);
+});
+
+test('isValidDate rejects non-leap-year Feb 29', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2026-02-29'), false);
+  assert.equal(isValidDate('1900-02-29'), false); // 1900 is not a leap year
+});
+
+test('isValidDate accepts leap-year Feb 29', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('2004-02-29'), true);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(20261007), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate({ date: '2026-10-07' }), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 365), '2027-10-07');
+});
+
+test('addDays adds negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+  assert.equal(addDays('2026-10-07', -365), '2025-10-07');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays with zero returns same date', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays handles leap years correctly', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2027-10-07'), 365);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+  assert.equal(daysBetween('2027-10-07', '2026-10-07'), -365);
+});
+
+test('daysBetween with same date returns zero', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-11-01', '2026-10-31'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween with leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('daysBetween works across leap years', () => {
+  // 2024 is a leap year, 2025 is not
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-02-29', '2025-02-28'), 365);
+});
+
+test('isValidDate used by createInvoice (integration)', () => {
+  // Valid date
+  const validResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(validResult.ok, true);
+
+  // Invalid date
+  const invalidResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invalidResult.ok, false);
+  assert.equal(invalidResult.error, 'DATE_INVALID');
+});
