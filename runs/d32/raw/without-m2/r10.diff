new file mode 100644
index 0000000..852a238
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,70 @@
+/**
+ * Check if a date string is valid in YYYY-MM-DD format.
+ * Validates format, month/day ranges, and that the date actually exists
+ * (e.g., rejects Feb 30, rejects non-leap-year Feb 29).
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(text);
+  if (!match) return false;
+
+  const year = parseInt(match[1], 10);
+  const month = parseInt(match[2], 10);
+  const day = parseInt(match[3], 10);
+
+  // Basic range check
+  if (month < 1 || month > 12 || day < 1 || day > 31) {
+    return false;
+  }
+
+  // Check if it's a real date in UTC
+  const date = new Date(`${text}T00:00:00Z`);
+  if (isNaN(date.getTime())) return false;
+
+  // Verify that the date components match (handles invalid dates like Feb 30)
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() + 1 !== month || date.getUTCDate() !== day) {
+    return false;
+  }
+
+  return true;
+}
+
+/**
+ * Add days to a date, in UTC.
+ * @param {string} date - date in YYYY-MM-DD format
+ * @param {number} n - number of days to add (can be negative)
+ * @returns {string} new date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  return formatDate(d);
+}
+
+/**
+ * Calculate days between two dates in UTC.
+ * @param {string} a - date in YYYY-MM-DD format
+ * @param {string} b - date in YYYY-MM-DD format
+ * @returns {number} number of whole days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(`${a}T00:00:00Z`);
+  const dateB = new Date(`${b}T00:00:00Z`);
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
+
+/**
+ * Format a Date object as YYYY-MM-DD string in UTC.
+ * @param {Date} date
+ * @returns {string}
+ */
+function formatDate(date) {
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
