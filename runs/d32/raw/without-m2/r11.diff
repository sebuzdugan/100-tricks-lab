+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array, lines: Array }} invoice
+ * @param {{ amount: number, date: string }} input - amount in cents, date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate status - must be issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get current balance
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array with the payment added
+  const payments = [...(invoice.payments || [])];
+  payments.push({ amount, date });
+
+  // Calculate new status based on whether fully paid
+  const totals = invoiceTotals(invoice);
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  const newStatus = totalPaid >= totals.total ? 'paid' : 'partially_paid';
+
+  // Build new invoice
+  const newInvoice = {
+    ...invoice,
+    payments,
+    status: newStatus,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ status?: string, payments?: Array, lines: Array }} invoice
+ * @returns {number} amount in cents still owed (never negative)
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
