+/**
+ * Validate payment terms.
+ * @param {string} termsStr
+ * @returns {string | null} error code or null if valid
+ */
+function validateTerms(termsStr) {
+  if (!['NET14', 'NET30', 'EOM'].includes(termsStr)) {
+    return 'TERMS_INVALID';
+  }
+  return null;
+}
+
+/**
+ * Calculate due date based on invoice date and payment terms.
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    return getLastDayOfMonth(issueDate);
+  }
+}
+
+/**
+ * Get the last day of the month for a given date.
+ * @param {string} dateStr - date in YYYY-MM-DD format
+ * @returns {string} last day of month in YYYY-MM-DD format
+ */
+function getLastDayOfMonth(dateStr) {
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  const year = date.getUTCFullYear();
+  const month = date.getUTCMonth();
+
+  // Get first day of next month, then subtract 1 day
+  const nextMonthFirstDay = new Date(Date.UTC(year, month + 1, 1));
+  const lastDayOfMonth = new Date(nextMonthFirstDay.getTime() - 24 * 60 * 60 * 1000);
+
+  // Format as YYYY-MM-DD
+  const resultYear = lastDayOfMonth.getUTCFullYear();
+  const resultMonth = String(lastDayOfMonth.getUTCMonth() + 1).padStart(2, '0');
+  const resultDay = String(lastDayOfMonth.getUTCDate()).padStart(2, '0');
+  return `${resultYear}-${resultMonth}-${resultDay}`;
+}
