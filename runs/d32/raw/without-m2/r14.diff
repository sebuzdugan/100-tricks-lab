index 0000000..f85a953
--- /dev/null
+++ b/src/statements.js
@@ -0,0 +1,53 @@
+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate, daysBetween } from './dates.js';
+
+/**
+ * Generate a customer statement.
+ * @param {string} customerId
+ * @param {Array} invoices - all invoices to search
+ * @param {string} asOf - statement date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize and validate customer
+  const normalizedId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate asOf date
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Filter invoices for this customer with eligible status and date
+  const customerInvoices = invoices.filter((inv) => {
+    if (normalizeId(inv.customerId) !== normalizedId) return false;
+    if (!['issued', 'partially_paid'].includes(inv.status)) return false;
+    // issueDate must be <= asOf
+    if (daysBetween(inv.issueDate, asOf) < 0) return false;
+    return true;
+  });
+
+  // Map to statement format
+  const statementInvoices = customerInvoices
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
index 0000000..95cf4d7
--- /dev/null
+++ b/test/statements.test.js
@@ -0,0 +1,213 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns empty for customer with no invoices', () => {
+  const result = statement('C-002', [], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement returns unknown customer error', () => {
+  const result = statement('C-999', [], '2026-12-31');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement normalizes customer ID', () => {
+  const result = statement('c-002', [], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+});
+
+test('statement rejects invalid asOf date', () => {
+  const result = statement('C-002', [], '2026-13-01');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('statement includes issued invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+
+  const result = statement('C-002', [issued], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement includes partially_paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(inv);
+  inv = recordPayment(inv, { amount: Math.floor(totals.total / 2), date: '2026-10-02' }).value;
+
+  const result = statement('C-002', [inv], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, totals.total - Math.floor(totals.total / 2));
+});
+
+test('statement excludes paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(inv);
+  inv = recordPayment(inv, { amount: totals.total, date: '2026-10-02' }).value;
+
+  const result = statement('C-002', [inv], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = statement('C-002', [inv.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-11-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']).value;
+
+  const result = statement('C-002', [issued1, issued2], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued3 = issueInvoice(inv3.value, ['INV-2026-0002']).value;
+
+  const result = statement('C-002', [issued1, issued2, issued3], '2026-10-31');
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-10');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+  const totals1 = invoiceTotals(issued1);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']).value;
+  const totals2 = invoiceTotals(issued2);
+
+  const result = statement('C-002', [issued1, issued2], '2026-10-31');
+  assert.equal(result.value.totalDue, totals1.total + totals2.total);
+});
+
+test('statement totalDue includes partial payments', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(inv);
+
+  // Pay half
+  const payment1 = Math.floor(totals.total / 2);
+  inv = recordPayment(inv, { amount: payment1, date: '2026-10-02' }).value;
+
+  const result = statement('C-002', [inv], '2026-10-31');
+  const remaining = totals.total - payment1;
+  assert.equal(result.value.totalDue, remaining);
+});
+
+test('statement includes invoice dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = statement('C-002', [issued], '2026-10-31');
+  assert.equal(result.value.invoices[0].dueDate, '2026-10-31');
+});
+
+test('statement filters by customer (excludes other customers)', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']).value;
+
+  const result = statement('C-002', [issued1, issued2], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0002');
+});
