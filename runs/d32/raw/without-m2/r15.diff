+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the next credit note number for a given year.
+ * @param {Array<string>} existingNumbers array of invoice and credit note numbers
+ * @param {string} date credit note date in YYYY-MM-DD format
+ * @returns {string} the next free credit note number (CN-<year>-<counter>)
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.substring(0, 4);
+
+  // Filter to credit note numbers from the same year
+  const yearPattern = new RegExp(`^CN-${year}-\\d{4}$`);
+  const yearNumbers = existingNumbers.filter((num) => yearPattern.test(num));
+
+  // Extract counters and find the max
+  let maxCounter = 0;
+  for (const num of yearNumbers) {
+    const counter = parseInt(num.substring(num.length - 4), 10);
+    if (counter > maxCounter) {
+      maxCounter = counter;
+    }
+  }
+
+  // Return the next number
+  const nextCounter = maxCounter + 1;
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} input
+ * @param {Array<string>} existingNumbers array of existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice status - must be issued, partially_paid, or paid
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total and check credit doesn't exceed it
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  // Build credit note
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
