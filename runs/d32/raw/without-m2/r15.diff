+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Partial refund', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 10000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2026-10-15');
+});
+
+test('createCreditNote works for partially_paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 5000, reason: 'Adjustment', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote works for paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 5000, reason: 'Overpayment refund', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = createCreditNote(inv.value, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(issued, { amount: 0, reason: 'Test', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(issued, { amount: -5000, reason: 'Test', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects fractional amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(issued, { amount: 5000.5, reason: 'Test', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects credit exceeding invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: totals.total + 1, reason: 'Too much', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote accepts credit equal to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: totals.total, reason: 'Full refund', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(result.ok, true);
+});
+
+test('nextCreditNoteNumber starts at 0001 for new year', () => {
+  const number = nextCreditNoteNumber(['INV-2026-0001'], '2026-10-15');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber increments counter', () => {
+  const numbers = ['CN-2026-0001', 'CN-2026-0002', 'INV-2026-0001', 'INV-2026-0002'];
+  const number = nextCreditNoteNumber(numbers, '2026-10-15');
+  assert.equal(number, 'CN-2026-0003');
+});
+
+test('nextCreditNoteNumber ignores invoices', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const number = nextCreditNoteNumber(numbers, '2026-10-15');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber resets for new year', () => {
+  const numbers = ['CN-2025-0001', 'CN-2025-0002', 'CN-2025-9999'];
+  const number = nextCreditNoteNumber(numbers, '2026-10-15');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber pads counter to 4 digits', () => {
+  const numbers = Array.from({ length: 9 }, (_, i) => `CN-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextCreditNoteNumber(numbers, '2026-10-15');
+  assert.equal(number, 'CN-2026-0010');
+});
+
+test('createCreditNote with complex invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3, discountPercent: 10 },
+      { sku: 'PRINT-A4', qty: 50 },
+    ],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: Math.floor(totals.total / 2), reason: 'Partial refund', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, Math.floor(totals.total / 2));
+});
