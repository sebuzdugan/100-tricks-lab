+  const result = overdueInvoices([], '2026-10-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices with complex scenario', () => {
+  const invoices = [];
+
+  // Draft invoice - should be excluded
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  invoices.push(draft.value);
+
+  // Issued invoice that is overdue
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+  invoices.push(issued1);
+
+  // Issued invoice not yet due
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']).value;
+  invoices.push(issued2);
+
+  // Partially paid invoice that is overdue
+  let inv3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+    terms: 'NET14',
+  });
+  inv3 = issueInvoice(inv3.value, ['INV-2026-0002']).value;
+  const totals3 = invoiceTotals(inv3);
+  inv3 = recordPayment(inv3, { amount: Math.floor(totals3.total / 2), date: '2026-10-02' }).value;
+  invoices.push(inv3);
+
+  // Paid invoice - should be excluded
+  let inv4 = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-08-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  inv4 = issueInvoice(inv4.value, ['INV-2026-0003']).value;
+  const totals4 = invoiceTotals(inv4);
+  inv4 = recordPayment(inv4, { amount: totals4.total, date: '2026-09-01' }).value;
+  invoices.push(inv4);
+
+  const result = overdueInvoices(invoices, '2026-10-31');
+  assert.equal(result.length, 3);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[1].number, 'INV-2026-0003');
+  assert.equal(result[2].number, 'INV-2026-0002');
+  assert(result[0].daysOverdue > result[1].daysOverdue);
+  assert(result[1].daysOverdue > result[2].daysOverdue);
+});
