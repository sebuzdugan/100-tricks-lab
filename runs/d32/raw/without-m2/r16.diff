+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty for no overdue invoices', () => {
+  const result = overdueInvoices([], '2026-10-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const result = overdueInvoices([inv.value], '2026-10-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  inv = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(inv);
+  inv = recordPayment(inv, { amount: totals.total, date: '2026-10-02' }).value;
+
+  const result = overdueInvoices([inv], '2026-10-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes issued invoices past due', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = overdueInvoices([issued], '2026-10-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].customerId, 'C-002');
+  assert.equal(result[0].dueDate, '2026-10-15');
+  assert.equal(result[0].daysOverdue, 5);
+  assert.equal(result[0].due, totals.total);
+});
+
+test('overdueInvoices includes partially_paid invoices past due', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  inv = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(inv);
+  const paymentAmount = Math.floor(totals.total / 2);
+  inv = recordPayment(inv, { amount: paymentAmount, date: '2026-10-02' }).value;
+
+  const result = overdueInvoices([inv], '2026-10-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, totals.total - paymentAmount);
+});
+
+test('overdueInvoices excludes invoices on due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes invoices before due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-10');
