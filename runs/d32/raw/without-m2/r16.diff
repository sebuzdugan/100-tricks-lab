+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Get overdue invoices as of a given date.
+ * @param {Array} invoices - all invoices
+ * @param {string} asOf - report date in YYYY-MM-DD format
+ * @returns {Array} invoices with status 'issued' or 'partially_paid' and dueDate < asOf,
+ *                  sorted by daysOverdue descending (most overdue first)
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .filter((inv) => daysBetween(inv.dueDate, asOf) > 0)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
