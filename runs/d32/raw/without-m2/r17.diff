@@ -23,3 +24,37 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Summarize VAT across invoices by rate.
+ * @param {Array} invoices - all invoices
+ * @returns {Array} VAT summary [{ rate, base, vat }] sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const summary = {};
+
+  // Accumulate base and VAT by rate for issued, partially_paid, and paid invoices
+  invoices
+    .filter((inv) => ['issued', 'partially_paid', 'paid'].includes(inv.status))
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        if (!summary[rate]) {
+          summary[rate] = { base: 0, vat: 0 };
+        }
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVAT(line);
+        summary[rate].base += base;
+        summary[rate].vat += vat;
+      });
+    });
+
+  // Convert to array and sort by rate descending
+  return Object.entries(summary)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseInt(rate, 10),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
