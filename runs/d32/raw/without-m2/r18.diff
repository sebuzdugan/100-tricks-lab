+/**
+ * Calculate late fee for an invoice.
+ * 0.04% per day of the amount still due for overdue invoices, 0 if not overdue.
+ * @param {{ dueDate: string, status: string, payments: Array }} invoice
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {number} late fee in cents
+ */
+export function lateFee(invoice, asOf) {
+  // Only assess late fees on issued, partially_paid, or paid invoices
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return 0;
+  }
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+  const due = balanceDue(invoice);
+  const fee = (due * 0.0004) * daysOverdue;
+  return roundCents(fee);
+}
