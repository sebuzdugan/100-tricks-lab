+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format amount in cents as euros with 2 decimals and a dot.
+ * @param {number} cents amount in cents
+ * @returns {string} formatted amount like "1234.50"
+ */
+function formatEurosForCsv(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: wrap in quotes if it contains comma or quote, and double any internal quotes.
+ * @param {string} field the field value
+ * @returns {string} escaped field
+ */
+function escapeCsvField(field) {
+  if (field.includes(',') || field.includes('"')) {
+    return `"${field.replace(/"/g, '""')}"`;
+  }
+  return field;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices - invoices to export
+ * @returns {string} CSV string with header and data rows
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const rows = invoices.map((inv) => {
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const fields = [
+      inv.number,
+      escapeCsvField(customerName),
+      inv.issueDate,
+      inv.dueDate,
+      inv.status,
+      formatEurosForCsv(totals.subtotal),
+      formatEurosForCsv(totals.discount),
+      formatEurosForCsv(totals.vat),
+      formatEurosForCsv(totals.total),
+      formatEurosForCsv(due),
+    ];
+
+    return fields.join(',');
+  });
+
+  return header + rows.join('\n') + (rows.length > 0 ? '\n' : '');
+}
