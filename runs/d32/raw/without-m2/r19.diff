+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header for empty invoice array', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header row', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv formats single invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3); // header, data, empty trailing
+  assert.equal(lines[1], `INV-2026-0001,Northwind Studio,2026-10-07,2026-11-06,issued,${(totals.subtotal / 100).toFixed(2)},${(totals.discount / 100).toFixed(2)},${(totals.vat / 100).toFixed(2)},${(totals.total / 100).toFixed(2)},${(totals.total / 100).toFixed(2)}`);
+});
+
+test('exportCsv includes customer name', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  assert(result.includes('Northwind Studio'));
+});
+
+test('exportCsv formats multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']).value;
+
+  const result = exportCsv([issued1, issued2]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4); // header, 2 data, empty trailing
+  assert(lines[1].startsWith('INV-2026-0001'));
+  assert(lines[2].startsWith('INV-2026-0002'));
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // Check that numeric fields have 2 decimals
+  assert(fields[5].includes('.'));
+  assert(fields[9].split('.')[1].length === 2);
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const inv = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  assert(result.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer name with quote', () => {
+  const inv = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  // Marlow "The Print Shop" should become "Marlow ""The Print Shop"""
+  assert(result.includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv doubles internal quotes in customer name', () => {
+  const inv = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  // Marlow "The Print Shop" should become "Marlow ""The Print Shop"""
+  assert(result.includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv includes issued status', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  assert(result.includes('issued'));
+});
+
+test('exportCsv includes partially_paid status', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(inv);
+  inv = recordPayment(inv, { amount: Math.floor(totals.total / 2), date: '2026-10-08' }).value;
+
+  const result = exportCsv([inv]);
+  assert(result.includes('partially_paid'));
+});
+
+test('exportCsv calculates due amount correctly', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(inv);
+  const paymentAmount = Math.floor(totals.total / 2);
+  inv = recordPayment(inv, { amount: paymentAmount, date: '2026-10-08' }).value;
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  const due = parseFloat(fields[9]);
+  const expectedDue = (totals.total - paymentAmount) / 100;
+  assert.equal(due, expectedDue);
+});
+
+test('exportCsv with draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert(lines[1].includes('draft'));
+});
+
+test('exportCsv lines end with newline', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  assert(result.endsWith('\n'));
+});
+
+test('exportCsv with multiple line invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'PRINT-A4', qty: 50 },
+    ],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(parseFloat(fields[9]), totals.total / 100);
+});
+
+test('exportCsv with discount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert(parseFloat(fields[6]) > 0);
+  assert.equal(parseFloat(fields[6]), totals.discount / 100);
+});
+
+test('exportCsv with VAT', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert(parseFloat(fields[7]) > 0);
+  assert.equal(parseFloat(fields[7]), totals.vat / 100);
+});
+
+test('exportCsv includes correct date format', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  assert(result.includes('2026-10-07'));
+  assert(result.includes('2026-10-21'));
+});
+
+test('exportCsv subtotal excludes voucher', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  const csvSubtotal = parseFloat(fields[5]);
+  // subtotal should be total - vat (before voucher is applied)
+  const expectedSubtotal = (totals.total - totals.vat) / 100;
+  assert.equal(csvSubtotal, expectedSubtotal);
+});
+
+test('exportCsv with zero amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PRINT-A4', qty: 50, discountPercent: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(parseFloat(fields[5]), totals.subtotal / 100);
+  assert.equal(parseFloat(fields[9]), 0);
+});
+
+test('exportCsv all fields present', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields.length, 10);
+});
+
+test('exportCsv handles comma and quote together', () => {
+  const inv = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([issued]);
+  // Smith, Jones & Partners has a comma and should be quoted
+  assert(result.includes('"Smith, Jones & Partners"'));
+});
