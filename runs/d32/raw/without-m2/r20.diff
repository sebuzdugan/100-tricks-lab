@@ -1,5 +1,12 @@
 import { ok, fail } from './result.js';
 
+/** Exchange rates: units of that currency per euro */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +46,37 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert cents from EUR to another currency.
+ * @param {number} cents - amount in EUR cents
+ * @param {string} currency - target currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const rate = RATES[currency];
+  const converted = roundCents(cents * rate);
+  return ok(converted);
+}
+
+/**
+ * Format cents as money in a given currency for people.
+ * @param {number} cents - amount in that currency's cents
+ * @param {string} currency - currency code (EUR, USD, GBP)
+ * @returns {string} formatted amount like "€1,234.56", "$1,234.56", or "£1,234.56"
+ */
+export function formatMoney(cents, currency) {
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+  const symbol = symbols[currency] ?? '?';
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
