+
+// Currency tests
+test('RATES has EUR, USD, and GBP', () => {
+  assert(RATES.EUR === 1);
+  assert(RATES.USD === 1.085);
+  assert(RATES.GBP === 0.8425);
+});
+
+test('convert returns ok for known currencies', () => {
+  const result = convert(100, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 100);
+});
+
+test('convert rejects unknown currency', () => {
+  const result = convert(100, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(123456, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 123456);
+});
+
+test('convert EUR to USD multiplies by rate', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  // 100 * 1.085 = 108.5, banker's rounding to 108 (even)
+  assert.equal(result.value, 108);
+});
+
+test('convert EUR to GBP multiplies by rate', () => {
+  const result = convert(100, 'GBP');
+  assert.equal(result.ok, true);
+  // 100 * 0.8425 = 84.25, rounds to 84
+  assert.equal(result.value, 84);
+});
+
+test('convert 1 EUR to USD gives 108 USD cents', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  // 100 EUR cents * 1.085 = 108.5 USD cents, banker's rounded to 108 (half to even)
+  assert.equal(result.value, 108);
+});
+
+test('convert 1 EUR to GBP gives 84 GBP cents', () => {
+  const result = convert(100, 'GBP');
+  assert.equal(result.ok, true);
+  // 100 EUR cents * 0.8425 = 84.25 GBP cents, rounded to 84
+  assert.equal(result.value, 84);
+});
+
+test('convert large amount to USD', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  const expected = Math.round(10000 * 1.085);
+  assert.equal(result.value, expected);
+});
+
+test('convert respects rounding rules', () => {
+  const result = convert(115, 'USD');
+  assert.equal(result.ok, true);
+  // 115 * 1.085 = 124.775, rounded to 125
+  assert.equal(result.value, 125);
+});
+
+test('convert negative amount', () => {
+  const result = convert(-100, 'USD');
+  assert.equal(result.ok, true);
+  const expected = Math.round(-100 * 1.085);
+  assert.equal(result.value, expected);
+});
+
+test('formatMoney formats EUR with euro sign', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+});
+
+test('formatMoney formats USD with dollar sign', () => {
+  assert.equal(formatMoney(123456, 'USD'), '$1,234.56');
+});
+
+test('formatMoney formats GBP with pound sign', () => {
+  assert.equal(formatMoney(123456, 'GBP'), '£1,234.56');
+});
+
+test('formatMoney handles small amounts', () => {
+  assert.equal(formatMoney(5, 'EUR'), '€0.05');
+  assert.equal(formatMoney(5, 'USD'), '$0.05');
+  assert.equal(formatMoney(5, 'GBP'), '£0.05');
+});
+
+test('formatMoney handles negative amounts', () => {
+  assert.equal(formatMoney(-250, 'EUR'), '-€2.50');
+  assert.equal(formatMoney(-250, 'USD'), '-$2.50');
+  assert.equal(formatMoney(-250, 'GBP'), '-£2.50');
+});
+
+test('formatMoney adds thousands separators', () => {
+  assert.equal(formatMoney(1000000, 'USD'), '$10,000.00');
+  assert.equal(formatMoney(1000000, 'GBP'), '£10,000.00');
+});
+
+test('formatMoney pads cents', () => {
+  assert.equal(formatMoney(100, 'EUR'), '€1.00');
+  assert.equal(formatMoney(1, 'USD'), '$0.01');
+  assert.equal(formatMoney(0, 'GBP'), '£0.00');
