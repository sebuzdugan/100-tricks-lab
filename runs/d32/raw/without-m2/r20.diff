+  const cents_eur = 1234;
+  const result = convert(cents_eur, 'USD');
+  assert.equal(result.ok, true);
+  const formatted = formatMoney(result.value, 'USD');
+  // 1234 * 1.085 = 1338.89, should be $13.39
+  assert.equal(formatted, '$13.39');
+});
