@@ -0,0 +1,248 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+// lineTotal tests
+test('lineTotal multiplies qty by unitPrice', () => {
+  const line = { qty: 5, unitPrice: 1700 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal with qty of 1', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500000);
+});
+
+// lineDiscount tests
+test('lineDiscount calculates discount correctly', () => {
+  const line = { qty: 5, unitPrice: 1700, discountPercent: 10 };
+  const total = lineTotal(line);
+  const expected = Math.round((total * 10) / 100);
+  assert.equal(lineDiscount(line), expected);
+});
+
+test('lineDiscount with zero discount', () => {
+  const line = { qty: 5, unitPrice: 1700, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with no discountPercent defaults to 0', () => {
+  const line = { qty: 5, unitPrice: 1700 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 5, unitPrice: 1700, discountPercent: 100 };
+  const total = lineTotal(line);
+  assert.equal(lineDiscount(line), total);
+});
+
+test('lineDiscount with decimal percentage', () => {
+  const line = { qty: 5, unitPrice: 1700, discountPercent: 2.5 };
+  const discount = lineDiscount(line);
+  // Just verify it calculates a discount
+  assert(discount > 0);
+});
+
+// lineVAT tests
+test('lineVAT calculates VAT on amount after discount', () => {
+  const line = { qty: 5, unitPrice: 1700, discountPercent: 10, vatRate: 21 };
+  const vat = lineVAT(line);
+  // Verify VAT is calculated (should be positive)
+  assert(vat > 0);
+  // Verify it's less than the discounted amount
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const base = total - discount;
+  assert(vat < base * 0.25); // VAT at 21% should be less than 25% of base
+});
+
+test('lineVAT with no discount', () => {
+  const line = { qty: 5, unitPrice: 1700, vatRate: 21 };
+  const total = lineTotal(line);
+  const expected = Math.round((total * 21) / 100);
+  assert.equal(lineVAT(line), expected);
+});
+
+test('lineVAT with zero VAT rate', () => {
+  const line = { qty: 5, unitPrice: 1700, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT with 9% VAT rate', () => {
+  const line = { qty: 3, unitPrice: 9500, vatRate: 9 };
+  const total = lineTotal(line);
+  const expected = Math.round((total * 9) / 100);
+  assert.equal(lineVAT(line), expected);
+});
+
+test('lineVAT with 21% VAT rate', () => {
+  const line = { qty: 10, unitPrice: 5000, vatRate: 21 };
+  const total = lineTotal(line);
+  const expected = Math.round((total * 21) / 100);
+  assert.equal(lineVAT(line), expected);
+});
+
+// invoiceTotals tests
+test('invoiceTotals sums all line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1700, vatRate: 21 },
+      { qty: 10, unitPrice: 5000, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  const line1Total = lineTotal(invoice.lines[0]);
+  const line2Total = lineTotal(invoice.lines[1]);
+  const expectedSubtotal = line1Total + line2Total;
+  assert.equal(result.subtotal, expectedSubtotal);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1700, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  const expected = lineTotal(invoice.lines[0]);
+  assert.equal(result.subtotal, expected);
+});
+
+test('invoiceTotals with multiple lines of varying amounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, vatRate: 21 },
+      { qty: 2, unitPrice: 9500, vatRate: 21 },
+      { qty: 50, unitPrice: 37, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.subtotal > 0);
+  assert(result.vat > 0);
+  assert.equal(result.voucher, 0);
+});
+
+test('invoiceTotals includes discount and VAT in response', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1700, discountPercent: 10, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.discount > 0);
+  assert(result.vat > 0);
+  assert.equal(result.voucher, 0);
+});
+
+test('invoiceTotals with no explicit discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1700, vatRate: 21 },
+      { qty: 10, unitPrice: 5000, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 0);
+});
+
+test('invoiceTotals with multiple lines and varying discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1700, discountPercent: 10, vatRate: 21 },
+      { qty: 3, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+      { qty: 50, unitPrice: 37, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.discount > 0);
+  assert(result.vat > 0);
+});
+
+test('invoiceTotals clamps total at 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 100, vatRate: 21 }],
+    voucher: { amount: 50000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with over-discount still clamps at 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 150, vatRate: 21 }],
+    voucher: { amount: 50000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1700, vatRate: 21 }],
+    voucher: { amount: 1000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 1000);
+});
+
+test('invoiceTotals without voucher', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1700, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 0);
+});
+
+test('invoiceTotals calculates total correctly', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1700, discountPercent: 10, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  const expected = result.subtotal - result.discount + result.vat;
+  assert.equal(result.total, expected);
+});
+
+test('invoiceTotals with complex scenario', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1700, discountPercent: 0, vatRate: 21 },
+      { qty: 3, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 37, discountPercent: 0, vatRate: 9 },
+    ],
+    voucher: { amount: 500 },
+  };
+  const result = invoiceTotals(invoice);
+
+  let expectedSubtotal = 0;
+  let expectedDiscount = 0;
+  let expectedVAT = 0;
+  for (const line of invoice.lines) {
+    expectedSubtotal += lineTotal(line);
+    expectedDiscount += lineDiscount(line);
+    expectedVAT += lineVAT(line);
+  }
+
+  assert.equal(result.subtotal, expectedSubtotal);
+  assert.equal(result.discount, expectedDiscount);
+  assert.equal(result.vat, expectedVAT);
+  assert.equal(result.voucher, 500);
+  assert.equal(result.total, Math.max(0, expectedSubtotal - expectedDiscount + expectedVAT - 500));
+});
+
+test('invoiceTotals does not mutate input', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1700, discountPercent: 10, vatRate: 21 }],
+  };
+  const originalLine = { ...invoice.lines[0] };
+  invoiceTotals(invoice);
+  assert.deepEqual(invoice.lines[0], originalLine);
+});
+
+test('lineTotal does not mutate input', () => {
+  const line = { qty: 5, unitPrice: 1700 };
+  const original = { ...line };
+  lineTotal(line);
+  assert.deepEqual(line, original);
+});
