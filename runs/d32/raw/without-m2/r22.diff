diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..207e4f6
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,60 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single invoice line.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number} total in cents
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount for a single invoice line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} discount in cents
+ */
+export function lineDiscount(line) {
+  const total = lineTotal(line);
+  const discount = (total * (line.discountPercent ?? 0)) / 100;
+  return roundCents(discount);
+}
+
+/**
+ * Calculate the VAT for a single invoice line.
+ * VAT is computed on the line amount after discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number} VAT in cents
+ */
+export function lineVAT(line) {
+  const subtotal = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = subtotal - discount;
+  const vat = (amountAfterDiscount * line.vatRate) / 100;
+  return roundCents(vat);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: object }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+  for (const line of invoice.lines) {
+    subtotal += lineTotal(line);
+    discount += lineDiscount(line);
+    vat += lineVAT(line);
+  }
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
