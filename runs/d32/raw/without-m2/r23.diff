+  const line = { qty: 10, unitPrice: 1000, discountPercent: 10 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  const expectedBulk = Math.round((amountAfterDiscount * 2.5) / 100);
+  const bulk = bulkDiscount(line);
+  assert.equal(bulk, expectedBulk);
+});
+
