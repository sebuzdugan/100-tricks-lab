+test('bulk discount reduces VAT rate on the discounted portion', () => {
+  const line9 = { qty: 9, unitPrice: 1000, discountPercent: 0, vatRate: 21 };
+  const line10 = { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 21 };
+
+  // 9 units: 9000 total, no bulk discount, 9000 * 21% = 1890 vat
+  const vat9 = lineVAT(line9);
+  // 10 units: 10000 total, 250 bulk discount, (10000-250) * 21% = 2047.5 vat
+  const vat10 = lineVAT(line10);
+
+  // VAT on the base before bulk discount
+  const base10Before = lineTotal(line10) - lineDiscount(line10);
+  const base10After = base10Before - bulkDiscount(line10);
