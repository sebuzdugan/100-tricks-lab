+/**
+ * Calculate the bulk discount for a single invoice line.
+ * Lines with 10+ units get an extra 2.5% off, applied after the line discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} bulk discount in cents
+ */
+export function bulkDiscount(line) {
+  if (line.qty < 10) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  const bulk = (amountAfterDiscount * 2.5) / 100;
+  return roundCents(bulk);
+}
+
 /**
  * Calculate the VAT for a single invoice line.
- * VAT is computed on the line amount after discount.
+ * VAT is computed on the line amount after all discounts (line discount + bulk discount).
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
  * @returns {number} VAT in cents
  */
 export function lineVAT(line) {
   const subtotal = lineTotal(line);
   const discount = lineDiscount(line);
-  const amountAfterDiscount = subtotal - discount;
-  const vat = (amountAfterDiscount * line.vatRate) / 100;
+  const bulk = bulkDiscount(line);
+  const amountAfterAllDiscounts = subtotal - discount - bulk;
+  const vat = (amountAfterAllDiscounts * line.vatRate) / 100;
   return roundCents(vat);
 }
 
