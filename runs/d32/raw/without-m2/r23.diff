+      { qty: 50, unitPrice: 37, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  let expectedSubtotal = 0;
+  let expectedDiscount = 0;
+  let expectedVAT = 0;
+  for (const line of invoice.lines) {
+    expectedSubtotal += lineTotal(line);
+    expectedDiscount += lineDiscount(line) + bulkDiscount(line);
+    expectedVAT += lineVAT(line);
+  }
+
+  assert.equal(result.subtotal, expectedSubtotal);
+  assert.equal(result.discount, expectedDiscount);
+  assert.equal(result.vat, expectedVAT);
+  // Verify the total calculation
+  assert.equal(result.total, Math.max(0, result.subtotal - result.discount + result.vat - (result.voucher ?? 0)));
+});
