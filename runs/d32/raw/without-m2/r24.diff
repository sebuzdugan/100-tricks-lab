+/**
+ * Generate a dashboard summary of invoice data.
+ * @param {Array} invoices - all invoices
+ * @param {string} asOf - report date in YYYY-MM-DD format
+ * @returns {{ counts: object, outstanding: number, overdue: object, topCustomers: Array }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+  invoices.forEach((inv) => {
+    counts[inv.status] = (counts[inv.status] ?? 0) + 1;
+  });
+
+  // Calculate outstanding amount (issued or partially_paid)
+  let outstanding = 0;
+  invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .forEach((inv) => {
+      outstanding += balanceDue(inv);
+    });
+
+  // Get overdue information
+  const overdue_list = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_list.length,
+    amount: overdue_list.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Calculate top customers by amount due
+  const customerDue = {};
+  invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .forEach((inv) => {
+      const due = balanceDue(inv);
+      if (due > 0) {
+        const customerId = inv.customerId;
+        customerDue[customerId] = (customerDue[customerId] ?? 0) + due;
+      }
+    });
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
