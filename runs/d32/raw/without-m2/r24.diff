+  let inv3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-03',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  inv3 = issueInvoice(inv3.value, ['INV-2026-0001']).value;
+  const totals3 = invoiceTotals(inv3);
+  inv3 = recordPayment(inv3, { amount: Math.floor(totals3.total / 2), date: '2026-10-04' }).value;
+
+  let inv4 = createInvoice({
