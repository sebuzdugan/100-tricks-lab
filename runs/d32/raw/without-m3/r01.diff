diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..482a98e
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,65 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create an invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issueDate
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  // Validate lines
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Validate SKU
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
+
+function isValidDate(dateString) {
+  // Check format YYYY-MM-DD
+  const regex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!regex.test(dateString)) return false;
+
+  // Check if it's a valid date
+  const date = new Date(dateString + 'T00:00:00Z');
+  if (Number.isNaN(date.getTime())) return false;
+
+  // Check if the date actually corresponds to the input string
+  const [year, month, day] = dateString.split('-').map(Number);
+  return (
+    date.getUTCFullYear() === year &&
+    date.getUTCMonth() + 1 === month &&
+    date.getUTCDate() === day
+  );
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..7df3e8f
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,222 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice with valid customer, date, and lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 8500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice with multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 3);
+  assert.equal(r.value.lines[0].name, 'Development (hour)');
+  assert.equal(r.value.lines[1].name, 'Sticker sheet');
+  assert.equal(r.value.lines[2].name, 'Brand workshop (day, VAT exempt)');
+  assert.equal(r.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice reports unknown customer', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-999',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'CUSTOMER_NOT_FOUND' },
+  );
+});
+
+test('createInvoice rejects invalid date format', () => {
+  const invalidDates = [
+    '2026/10/07',
+    '07-10-2026',
+    '2026-10-7',
+    '2026-1-07',
+    'not a date',
+    '2026-10',
+    '',
+  ];
+  for (const date of invalidDates) {
+    assert.deepEqual(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: date,
+        lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      }),
+      { ok: false, error: 'DATE_INVALID' },
+      `should reject "${date}"`,
+    );
+  }
+});
+
+test('createInvoice rejects invalid dates', () => {
+  const invalidDates = [
+    '2026-02-30', // Feb doesn't have 30 days
+    '2026-04-31', // April has 30 days
+    '2026-13-01', // Month 13 doesn't exist
+    '2026-00-01', // Month 0 doesn't exist
+    '2026-10-00', // Day 0 doesn't exist
+  ];
+  for (const date of invalidDates) {
+    assert.deepEqual(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: date,
+        lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      }),
+      { ok: false, error: 'DATE_INVALID' },
+      `should reject invalid date "${date}"`,
+    );
+  }
+});
+
+test('createInvoice accepts valid leap year dates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29', // 2024 is a leap year
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+});
+
+test('createInvoice rejects Feb 29 on non-leap year', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-29',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' },
+  );
+});
+
+test('createInvoice reports NO_LINES for empty array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' },
+  );
+});
+
+test('createInvoice rejects non-array lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects invalid qty (non-integer)', () => {
+  const invalidQtys = [1.5, 0.1, -1, 0, '5', null, undefined];
+  for (const qty of invalidQtys) {
+    assert.deepEqual(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: '2026-10-07',
+        lines: [{ sku: 'DES-HOUR', qty }],
+      }),
+      { ok: false, error: 'QTY_INVALID' },
+      `should reject qty ${qty}`,
+    );
+  }
+});
+
+test('createInvoice reports unknown SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'UNKNOWN', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' },
+  );
+});
+
+test('createInvoice stops at first error', () => {
+  // Multiple lines, but second one has unknown SKU
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [
+        { sku: 'DES-HOUR', qty: 1 },
+        { sku: 'UNKNOWN', qty: 1 },
+      ],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' },
+  );
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const originalLines = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+
+  assert.deepEqual(lines, originalLines);
+});
+
+test('createInvoice returns new invoice object', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const result2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.notEqual(result1.value, result2.value);
+  assert.notEqual(result1.value.lines, result2.value.lines);
+  assert.deepEqual(result1.value, result2.value);
+});
+
+test('createInvoice includes different VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 }, // 21%
+      { sku: 'PRINT-A4', qty: 1 }, // 9%
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0%
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].vatRate, 21);
+  assert.equal(r.value.lines[1].vatRate, 9);
+  assert.equal(r.value.lines[2].vatRate, 0);
+});
