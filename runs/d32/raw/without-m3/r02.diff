+/**
+ * Calculate the total for a single line (qty × unitPrice in cents).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate subtotal and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number }> }} invoice
+ * @returns {{ subtotal: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  for (const line of invoice.lines) {
+    subtotal += lineTotal(line);
+  }
+  subtotal = roundCents(subtotal);
+  return {
+    subtotal,
+    total: subtotal,
+  };
+}
