diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..3d7032d
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,82 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for an empty list', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber returns 0002 after 0001', () => {
+  const existingNumbers = ['INV-2026-0001'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2025-0003',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber handles mixed years', () => {
+  const existingNumbers = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2026-0001',
+    'INV-2026-0003',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber works with unordered numbers', () => {
+  const existingNumbers = [
+    'INV-2026-0005',
+    'INV-2026-0001',
+    'INV-2026-0003',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber zero-pads to 4 digits', () => {
+  const existingNumbers = Array.from({ length: 99 }, (_, i) =>
+    `INV-2026-${String(i + 1).padStart(4, '0')}`,
+  );
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existingNumbers = [
+    'INV-2026-9998',
+    'INV-2026-9999',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber extracts year from issueDate', () => {
+  const existingNumbers = ['INV-2025-0005'];
+  const number2025 = nextInvoiceNumber(existingNumbers, '2025-12-31');
+  assert.equal(number2025, 'INV-2025-0006');
+
+  const number2026 = nextInvoiceNumber(existingNumbers, '2026-01-01');
+  assert.equal(number2026, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores invalid invoice numbers', () => {
+  const existingNumbers = [
+    'INV-2026-0001',
+    'INV-2026-INVALID',
+    'NOT-AN-INVOICE',
+    'INV-2026-',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
