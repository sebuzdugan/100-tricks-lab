@@ -0,0 +1,25 @@
+/**
+ * Get the next available invoice number for a given year.
+ * @param {Array<string>} existingNumbers - Invoice numbers already used (e.g., ["INV-2026-0001", "INV-2026-0002"])
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} - Next invoice number (e.g., "INV-2026-0003")
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  // Find all numbers for this year and extract counters
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = parseInt(num.slice(prefix.length), 10);
+      return Number.isNaN(counter) ? 0 : counter;
+    });
+
+  // Find the maximum counter
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  // Format with zero padding (4 digits)
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
