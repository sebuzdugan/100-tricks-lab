@@ -0,0 +1,240 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText renders a single line item', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /5x Design work \(hour\) @ €85\.00 = €425\.00/);
+});
+
+test('renderInvoiceText renders multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 }, // 5 × €85.00 = €425.00
+      { sku: 'DEV-HOUR', qty: 3 }, // 3 × €95.00 = €285.00
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /5x Design work \(hour\) @ €85\.00 = €425\.00/);
+  assert.match(text, /3x Development \(hour\) @ €95\.00 = €285\.00/);
+});
+
+test('renderInvoiceText shows total at the end', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 }, // €425.00
+      { sku: 'DEV-HOUR', qty: 3 }, // €285.00
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.match(lines[lines.length - 1], /^Total: €710\.00$/);
+});
+
+test('renderInvoiceText formats large amounts correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 }, // €1,200.00
+      { sku: 'BRAND-BOOK', qty: 1 }, // €2,450.00
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /€1,200\.00/);
+  assert.match(text, /€2,450\.00/);
+  assert.match(text, /Total: €3,650\.00/);
+});
+
+test('renderInvoiceText includes product names', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 2 },
+      { sku: 'ICON-SET', qty: 5 },
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Logo package/);
+  assert.match(text, /Brand guidelines document/);
+  assert.match(text, /Icon set \(24 icons\)/);
+});
+
+test('renderInvoiceText uses quantities correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 1000 }, // 1000 × €0.50 = €500.00
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /1000x Sticker sheet/);
+  assert.match(text, /Total: €500\.00/);
+});
+
+test('renderInvoiceText line format with different product names', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PRINT-A4', qty: 250 }, // Print flyer
+      { sku: 'PHOTO-LIC', qty: 1 }, // Stock photo licence
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  // Check structure: should have number, customer, items, total
+  assert.ok(lines[0].match(/^(DRAFT|INV-)/));
+  assert.ok(lines[1].length > 0); // customer name
+  assert.match(lines[2], /250x Printed flyer A4/);
+  assert.match(lines[3], /1x Stock photo licence/);
+  assert.match(lines[4], /^Total:/);
+});
+
+test('renderInvoiceText handles single-digit amounts', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 1 }, // €0.50
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /€0\.50/);
+});
+
+test('renderInvoiceText produces consistent output for same invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text1 = renderInvoiceText(r.value);
+  const text2 = renderInvoiceText(r.value);
+
+  assert.equal(text1, text2);
+});
+
+test('renderInvoiceText contains all required elements', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4); // DRAFT, customer, item, total
+  assert.match(lines[0], /^DRAFT$/);
+  assert.match(lines[1], /Northwind Studio/);
+  assert.match(lines[2], /5x.*Design work.*€/);
+  assert.match(lines[3], /^Total:/);
+});
+
+test('renderInvoiceText with issued invoice with existing numbers', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002'];
+  const issued = issueInvoice(r.value, existingNumbers);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+  assert.match(text, /^INV-2026-0003\n/);
+  assert.match(text, /Kite & Co/);
+  assert.match(text, /2x Development \(hour\)/);
+});
+
+test('renderInvoiceText preserves product names with special characters', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 3 }, // Icon set (24 icons)
+      { sku: 'FONT-LIC', qty: 1 }, // Font licence (desktop)
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Icon set \(24 icons\)/);
+  assert.match(text, /Font licence \(desktop\)/);
+});
