+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals, lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * All monetary amounts are formatted with formatEuros() for display to customers.
+ * @param {{ customerId: string, number?: string, lines: Array }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  // Get invoice number or DRAFT
+  const numberLine = invoice.number ?? 'DRAFT';
+
+  // Calculate totals
+  const totals = invoiceTotals(invoice);
+
+  // Build the text
+  const lines = [numberLine, customerName];
+
+  // Add each line item
+  for (const line of invoice.lines) {
+    const lineamt = lineTotal(line);
+    const lineText = `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lineamt)}`;
+    lines.push(lineText);
+  }
+
+  // Add total
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
