+
+test('createInvoice mixes tier and explicit discounts', () => {
+  // C-001 is gold tier (5%)
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 }, // gets 5% from tier
+      { sku: 'DEV-HOUR', qty: 3, discountPercent: 10 }, // explicit 10%
+      { sku: 'COPY-HOUR', qty: 2, discountPercent: 0 }, // explicit 0%
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+  assert.equal(r.value.lines[1].discountPercent, 10);
+  assert.equal(r.value.lines[2].discountPercent, 0);
+});
+
+test('createInvoice tier discount affects invoiceTotals', () => {
+  // C-001 is gold tier (5%)
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }], // 10 × €85 = €850, 5% discount = €42.50
+  });
+  assert.equal(r.ok, true);
+
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal, 85000); // €850
+  assert.equal(totals.discount, 4250); // €42.50
+  assert.equal(totals.total, 80750); // €807.50
+});
+
+test('different tiers get different automatic discounts', () => {
+  const gold = createInvoice({
+    customerId: 'C-001', // gold
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // 100 × €85 = €8500
+  });
+  const silver = createInvoice({
+    customerId: 'C-003', // silver
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // 100 × €85 = €8500
+  });
+  const standard = createInvoice({
+    customerId: 'C-002', // standard
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // 100 × €85 = €8500
+  });
+
+  assert.equal(gold.ok, true);
+  assert.equal(silver.ok, true);
+  assert.equal(standard.ok, true);
+
+  const goldTotals = invoiceTotals(gold.value);
+  const silverTotals = invoiceTotals(silver.value);
+  const standardTotals = invoiceTotals(standard.value);
+
+  // Gold: 5% discount
+  assert.equal(goldTotals.discount, 42500); // €425
+  assert.equal(goldTotals.total, 807500); // €8075
+
+  // Silver: 2.5% discount
+  assert.equal(silverTotals.discount, 21250); // €212.50
+  assert.equal(silverTotals.total, 828750); // €8287.50
+
+  // Standard: 0% discount
+  assert.equal(standardTotals.discount, 0);
+  assert.equal(standardTotals.total, 850000); // €8500
+});
