@@ -33,3 +33,39 @@ test('TIER_DISCOUNTS matches customer tiers', () => {
     assert.ok(customer.tier in TIER_DISCOUNTS, `tier "${customer.tier}" has a discount`);
   }
 });
+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('C-001'), 'C-001');
+  assert.equal(normalizeId(' C-001'), 'C-001');
+  assert.equal(normalizeId('C-001 '), 'C-001');
+  assert.equal(normalizeId('  C-001  '), 'C-001');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-007'), 'C-007');
+  assert.equal(normalizeId('C-001'), 'C-001');
+  assert.equal(normalizeId('C-007'), 'C-007');
+});
+
+test('normalizeId handles mixed case and spaces', () => {
+  assert.equal(normalizeId('c-007 '), 'C-007');
+  assert.equal(normalizeId(' c-007'), 'C-007');
+  assert.equal(normalizeId('  c-007  '), 'C-007');
+});
+
+test('getCustomer accepts mixed case and spaces', () => {
+  const r1 = getCustomer('C-001');
+  const r2 = getCustomer('c-001');
+  const r3 = getCustomer('c-001 ');
+  const r4 = getCustomer(' C-001 ');
+
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+  assert.equal(r3.ok, true);
+  assert.equal(r4.ok, true);
+
+  assert.equal(r1.value.name, r2.value.name);
+  assert.equal(r2.value.name, r3.value.name);
+  assert.equal(r3.value.name, r4.value.name);
+});
diff --git a/test/invoices.test.js b/test/invoices.test.js
index 2de41f7..d58fcb0 100644
--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -1165,3 +1165,56 @@ test('invoiceTotals vat calculation respects discount', () => {
   assert.equal(totalsWithoutDiscount.vat, 2100); // €21
   assert.equal(totalsWithoutDiscount.vat, totalsWithDiscount.vat * 2);
 });
+
+test('createInvoice normalizes customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r3 = createInvoice({
+    customerId: 'c-001 ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+  assert.equal(r3.ok, true);
+
+  // All should store the normalized ID
+  assert.equal(r1.value.customerId, 'C-001');
+  assert.equal(r2.value.customerId, 'C-001');
+  assert.equal(r3.value.customerId, 'C-001');
+});
+
+test('createInvoice works with lowercase customer ID', () => {
+  const r = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  // Should have tier discount for C-001 (gold)
+  assert.equal(r.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice works with customer ID with spaces', () => {
+  const r = createInvoice({
+    customerId: ' c-003 ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-003');
+  // Should have tier discount for C-003 (silver)
+  assert.equal(r.value.lines[0].discountPercent, 2.5);
+});
