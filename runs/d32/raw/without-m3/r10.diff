diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..62677a8
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,138 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('2024-01-01'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('not a date'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false); // Feb doesn't have 30 days
+  assert.equal(isValidDate('2026-04-31'), false); // April has 30 days
+  assert.equal(isValidDate('2026-13-01'), false); // Month 13 doesn't exist
+  assert.equal(isValidDate('2026-00-01'), false); // Month 0 doesn't exist
+  assert.equal(isValidDate('2026-10-00'), false); // Day 0 doesn't exist
+});
+
+test('isValidDate rejects Feb 29 on non-leap years', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2100-02-29'), false); // century year not divisible by 400
+});
+
+test('isValidDate accepts Feb 29 on leap years', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true); // century year divisible by 400
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 365), '2027-10-07');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+  assert.equal(addDays('2026-10-07', -365), '2025-10-07');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-11-01', -1), '2026-10-31');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays handles leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01'); // non-leap year
+});
+
+test('addDays with zero', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2027-10-07'), 365);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+  assert.equal(daysBetween('2027-10-07', '2026-10-07'), -365);
+});
+
+test('daysBetween with same dates', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween across months', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-10-01', '2026-10-31'), 30);
+});
+
+test('daysBetween across years', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+});
+
+test('daysBetween with leap year', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is leap year
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365); // 2025 is not leap year
+});
+
+test('daysBetween uses whole days (no fractional days)', () => {
+  // All these dates are at UTC midnight, so differences are exact days
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-09'), 2);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const start = '2026-10-07';
+  const n = 42;
+  const end = addDays(start, n);
+  assert.equal(daysBetween(start, end), n);
+  assert.equal(daysBetween(end, start), -n);
+});
+
+test('round-trip: add then subtract', () => {
+  const date = '2026-10-07';
+  const n = 100;
+  const added = addDays(date, n);
+  const subtracted = addDays(added, -n);
+  assert.equal(subtracted, date);
+});
+
+test('chaining addDays', () => {
+  let date = '2026-10-07';
+  date = addDays(date, 10);
+  date = addDays(date, 20);
+  date = addDays(date, -5);
+  assert.equal(date, '2026-11-01');
+  assert.equal(daysBetween('2026-10-07', date), 25);
+});
