+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an issued invoice.
+ * @param {{ status: string, payments?: Array, ... }} invoice - An issued or partially paid invoice
+ * @param {{ amount: number, date: string }} payment - Payment amount in cents and date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice totals
+  const totals = invoiceTotals(invoice);
+
+  // Calculate current total of payments
+  const currentPayments = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  const amountOwed = totals.total - currentPayments;
+
+  // Check for overpayment
+  if (amount > amountOwed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array
+  const payments = [...(invoice.payments || []), { amount, date }];
+
+  // Determine new status
+  const totalPayments = currentPayments + amount;
+  let newStatus = 'issued';
+  if (totalPayments >= totals.total) {
+    newStatus = 'paid';
+  } else if (totalPayments > 0) {
+    newStatus = 'partially_paid';
+  }
+
+  return ok({
+    ...invoice,
+    payments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array, ... }} invoice - An invoice (with optional payments array)
+ * @returns {number} - Amount owed in cents (clamped at 0)
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const payments = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - payments);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
