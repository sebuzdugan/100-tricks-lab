+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return ok(addDays(issueDate, 14));
+  } else if (terms === 'NET30') {
+    return ok(addDays(issueDate, 30));
+  } else if (terms === 'EOM') {
+    // End of month: last day of the month of the issue date
+    const [year, month] = issueDate.split('-').map(Number);
+    // Use UTC to find last day of month
+    const lastDayUtc = new Date(Date.UTC(year, month, 0)); // month + 1, day 0 = last day of previous month
+    const lastDay = lastDayUtc.getUTCDate();
+    const monthStr = String(month).padStart(2, '0');
+    const dayStr = String(lastDay).padStart(2, '0');
+    return ok(`${year}-${monthStr}-${dayStr}`);
+  } else {
+    return fail('TERMS_INVALID');
+  }
+}
