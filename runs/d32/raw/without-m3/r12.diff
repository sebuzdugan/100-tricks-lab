+test('createInvoice EOM for different months', () => {
+  // February (non-leap year)
+  let r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(r.value.dueDate, '2025-02-28');
+
+  // February (leap year)
+  r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
