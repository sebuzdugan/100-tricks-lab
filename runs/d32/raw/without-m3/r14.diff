+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('statement for customer with no invoices', () => {
+  const r = statement('C-001', [], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement for unknown customer', () => {
+  const r = statement('C-999', [], '2026-12-31');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement normalizes customer ID', () => {
+  const r = statement('c-001', [], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+});
+
+test('statement includes only issued invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+
+  const r = statement('C-001', [draft, issued], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const partiallyPaid = recordPayment(issued, {
+    amount: Math.floor(totals.total / 2),
+    date: '2026-10-10',
+  }).value;
+
+  const r = statement('C-001', [partiallyPaid], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement excludes draft invoices', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const r = statement('C-001', [draft1, draft2], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, {
+    amount: totals.total,
+    date: '2026-10-10',
+  }).value;
+
+  const r = statement('C-001', [paid], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement filters by asOf date', () => {
+  const invoice1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value,
+    []
+  ).value;
+
+  const invoice2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const invoice3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-11-01',
+      lines: [{ sku: 'COPY-HOUR', qty: 1 }],
+    }).value,
+    ['INV-2026-0001', 'INV-2026-0002']
+  ).value;
+
+  // As of Sept 30 - only first invoice
+  let r = statement('C-001', [invoice1, invoice2, invoice3], '2026-09-30');
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-09-01');
+
+  // As of Oct 31 - first two invoices
+  r = statement('C-001', [invoice1, invoice2, invoice3], '2026-10-31');
+  assert.equal(r.value.invoices.length, 2);
+
+  // As of Nov 30 - all three
+  r = statement('C-001', [invoice1, invoice2, invoice3], '2026-11-30');
+  assert.equal(r.value.invoices.length, 3);
+});
+
+test('statement includes invoice details', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+
+  const r = statement('C-001', [issued], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[0].dueDate, issued.dueDate);
+  assert.equal(r.value.invoices[0].total, totals.total);
+  assert.equal(r.value.invoices[0].due, totals.total);
+});
+
+test('statement calculates due (balance) for partial payment', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const payment = Math.floor(totals.total / 3);
+  const partial = recordPayment(issued, { amount: payment, date: '2026-10-10' }).value;
+
+  const r = statement('C-001', [partial], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].due, totals.total - payment);
+});
+
+test('statement sorts by issueDate', () => {
+  const invoice3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-11-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value,
+    []
+  ).value;
+
+  const invoice1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const invoice2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'COPY-HOUR', qty: 1 }],
+    }).value,
+    ['INV-2026-0001', 'INV-2026-0002']
+  ).value;
+
+  // Pass invoices in random order
+  const r = statement('C-001', [invoice3, invoice1, invoice2], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].issueDate, '2026-09-01');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-15');
+  assert.equal(r.value.invoices[2].issueDate, '2026-11-01');
+});
+
+test('statement calculates totalDue as sum of due amounts', () => {
+  const invoice1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+  const totals1 = invoiceTotals(invoice1);
+
+  const invoice2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+  const totals2 = invoiceTotals(invoice2);
+
+  // Partial payment on first invoice
+  const partial1 = recordPayment(invoice1, {
+    amount: Math.floor(totals1.total / 2),
+    date: '2026-10-10',
+  }).value;
+
+  const r = statement('C-001', [partial1, invoice2], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(
+    r.value.totalDue,
+    (totals1.total - Math.floor(totals1.total / 2)) + totals2.total
+  );
+});
+
+test('statement for single customer ignores other customers', () => {
+  const invoice1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value,
+    []
+  ).value;
+
+  const invoice2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  // Statement for C-001 should only include C-001's invoices
+  const r = statement('C-001', [invoice1, invoice2], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement with no relevant invoices', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-11-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value,
+    []
+  ).value;
+
+  // As of Oct 31, invoice from Nov 1 is not included
+  const r = statement('C-001', [invoice], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement asOf date is inclusive', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value,
+    []
+  ).value;
+
+  // Invoice from Oct 15 should be included when asOf is Oct 15
+  const r = statement('C-001', [invoice], '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
