+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, {
+    amount: Math.floor(totals.total / 2),
+    reason: 'Partial refund',
+    date: '2026-10-20',
+  }, ['INV-2026-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2026-10-20');
+});
+
+test('createCreditNote works for partially_paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }], // €50 + 21% VAT
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const partial = recordPayment(issued, {
+    amount: Math.floor(totals.total / 2),
+    date: '2026-10-10',
+  }).value;
+
+  const result = createCreditNote(partial, {
+    amount: Math.floor(totals.total / 3),
+    reason: 'Adjustment',
+    date: '2026-10-20',
+  }, ['INV-2026-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works for paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, {
+    amount: totals.total,
+    date: '2026-10-10',
+  }).value;
+
+  const result = createCreditNote(paid, {
+    amount: Math.floor(totals.total / 3),
+    reason: 'Refund',
+    date: '2026-10-20',
+  }, ['INV-2026-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = createCreditNote(draft, {
+    amount: 10000,
+    reason: 'Refund',
+    date: '2026-10-20',
+  }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote validates amount is positive integer', () => {
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value,
+    []
+  ).value;
+
+  assert.deepEqual(createCreditNote(issued, {
+    amount: 0,
+    reason: 'Test',
+    date: '2026-10-20',
+  }, ['INV-2026-0001']), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, {
+    amount: -1000,
+    reason: 'Test',
+    date: '2026-10-20',
+  }, ['INV-2026-0001']), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, {
+    amount: 10.5,
+    reason: 'Test',
+    date: '2026-10-20',
+  }, ['INV-2026-0001']), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('createCreditNote rejects credit higher than invoice total', () => {
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, {
+    amount: totals.total + 1,
+    reason: 'Refund',
+    date: '2026-10-20',
+  }, ['INV-2026-0001']);
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, {
+    amount: totals.total,
+    reason: 'Full refund',
+    date: '2026-10-20',
+  }, ['INV-2026-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('nextCreditNoteNumber returns CN-0001 for empty list', () => {
+  const number = nextCreditNoteNumber([], '2026-10-07');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber increments counter', () => {
+  const existingNumbers = ['CN-2026-0001', 'CN-2026-0002'];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0003');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existingNumbers = [
+    'INV-2026-0001',
+    'INV-2026-0002',
+    'CN-2026-0001',
+  ];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0002');
+});
+
+test('nextCreditNoteNumber ignores different years', () => {
+  const existingNumbers = [
+    'CN-2025-0001',
+    'CN-2025-0002',
+    'CN-2025-0003',
+  ];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber handles mixed years and types', () => {
+  const existingNumbers = [
+    'INV-2026-0001',
+    'CN-2025-0005',
+    'CN-2026-0001',
+    'INV-2025-0002',
+    'CN-2026-0003',
+  ];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0004');
+});
+
+test('nextCreditNoteNumber works with unordered numbers', () => {
+  const existingNumbers = [
+    'CN-2026-0005',
+    'CN-2026-0001',
+    'CN-2026-0003',
+  ];
+  const number = nextCreditNoteNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0006');
+});
+
+test('credit note contains all required fields', () => {
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-003',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, {
+    amount: 50000,
+    reason: 'Customer complaint',
+    date: '2026-10-15',
+  }, ['INV-2026-0001']);
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.number);
+  assert.ok(result.value.invoiceNumber);
+  assert.ok(result.value.customerId);
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Customer complaint');
+  assert.equal(result.value.date, '2026-10-15');
+});
+
+test('multiple credit notes get sequential numbers', () => {
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+  const totals = invoiceTotals(issued);
+
+  const credit1 = createCreditNote(issued, {
+    amount: 50000,
+    reason: 'Refund 1',
+    date: '2026-10-15',
+  }, ['INV-2026-0001']);
+
+  const credit2 = createCreditNote(issued, {
+    amount: 30000,
+    reason: 'Refund 2',
+    date: '2026-10-20',
+  }, ['INV-2026-0001', credit1.value.number]);
+
+  assert.equal(credit1.value.number, 'CN-2026-0001');
+  assert.equal(credit2.value.number, 'CN-2026-0002');
+});
+
+test('credit notes for different years use separate counters', () => {
+  const issued2025 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+  const totals2025 = invoiceTotals(issued2025);
+
+  const issued2026 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    }).value,
+    ['INV-2025-0001']
+  ).value;
+  const totals2026 = invoiceTotals(issued2026);
+
+  const existingNumbers = [
+    'INV-2025-0001',
+    'CN-2025-0001',
+    'CN-2025-0002',
+    'INV-2026-0001',
+  ];
+
+  const credit2025 = createCreditNote(issued2025, {
+    amount: Math.floor(totals2025.total / 2),
+    reason: 'Refund',
+    date: '2025-10-20',
+  }, existingNumbers);
+
+  const credit2026 = createCreditNote(issued2026, {
+    amount: Math.floor(totals2026.total / 2),
+    reason: 'Refund',
+    date: '2026-10-20',
+  }, [...existingNumbers, credit2025.value.number]);
+
+  assert.equal(credit2025.value.number, 'CN-2025-0003');
+  assert.equal(credit2026.value.number, 'CN-2026-0001');
+});
