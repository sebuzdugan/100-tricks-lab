+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Get all overdue invoices as of a given date.
+ * @param {Array} invoices - Array of invoice objects
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {Array} - [{number, customerId, dueDate, daysOverdue, due}], sorted by most overdue first
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    // Only issued or partially_paid status
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    // Only invoices with dueDate before asOf
+    .filter((inv) => inv.dueDate < asOf)
+    // Map to report format
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    // Sort by most overdue first (earliest dueDate = most overdue)
+    .sort((a, b) => a.dueDate.localeCompare(b.dueDate));
+}
