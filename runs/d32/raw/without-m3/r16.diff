+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('overdueInvoices returns empty array for no invoices', () => {
+  const result = overdueInvoices([], '2026-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty array when no invoices are overdue', () => {
+  const invoice1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const invoice2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-10',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+      terms: 'NET14',
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  // As of Oct 15, both invoices are still due (dueDate > asOf)
+  const result = overdueInvoices([invoice1, invoice2], '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+
+  // As of Oct 15, draft has dueDate in past but should be excluded
+  const result = overdueInvoices([draft, issued], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const partial = recordPayment(issued, {
+    amount: Math.floor(totals.total / 2),
+    date: '2026-09-20',
+  }).value;
+
+  // As of Oct 15, partially_paid invoice should be included
+  const result = overdueInvoices([partial], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, {
+    amount: totals.total,
+    date: '2026-09-20',
+  }).value;
+
+  // Paid invoices should not appear in overdue report
+  const result = overdueInvoices([paid], '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices returns single overdue invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+      terms: 'NET14',
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([invoice], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-09-15');
+  assert.equal(result[0].daysOverdue, 30);
+});
+
+test('overdueInvoices sorts by most overdue first', () => {
+  const invoice1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-08-01',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+      terms: 'NET14',
+    }).value,
+    []
+  ).value;
+
+  const invoice2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET14',
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const invoice3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-003',
+      issueDate: '2026-09-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+      terms: 'NET14',
+    }).value,
+    ['INV-2026-0001', 'INV-2026-0002']
+  ).value;
+
+  // As of Oct 15, all three are overdue
+  // invoice1 due 2026-08-15 (61 days overdue)
+  // invoice2 due 2026-09-15 (30 days overdue)
+  // invoice3 due 2026-09-29 (16 days overdue)
+  const result = overdueInvoices([invoice3, invoice1, invoice2], '2026-10-15');
+  assert.equal(result.length, 3);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].daysOverdue, 61);
+  assert.equal(result[1].number, 'INV-2026-0002');
+  assert.equal(result[1].daysOverdue, 30);
+  assert.equal(result[2].number, 'INV-2026-0003');
+  assert.equal(result[2].daysOverdue, 16);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+  // Due date: 2026-10-01
+
+  // As of Oct 01 - not yet overdue
+  let result = overdueInvoices([invoice], '2026-10-01');
+  assert.equal(result.length, 0);
+
+  // As of Oct 02 - 1 day overdue
+  result = overdueInvoices([invoice], '2026-10-02');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 1);
+
+  // As of Oct 15 - 14 days overdue
+  result = overdueInvoices([invoice], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 14);
+});
+
+test('overdueInvoices reports correct due amount for full invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = overdueInvoices([issued], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, totals.total);
+});
+
+test('overdueInvoices reports remaining due for partial payment', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const payment = Math.floor(totals.total / 3);
+  const partial = recordPayment(issued, {
+    amount: payment,
+    date: '2026-09-20',
+  }).value;
+
+  const result = overdueInvoices([partial], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, totals.total - payment);
+});
+
+test('overdueInvoices handles multiple customers', () => {
+  const invoice1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET14',
+    }).value,
+    []
+  ).value;
+
+  const invoice2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-08-15',
+      lines: [{ sku: 'STICKER', qty: 50 }],
+      terms: 'NET14',
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const invoice3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-003',
+      issueDate: '2026-09-10',
+      lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+      terms: 'NET14',
+    }).value,
+    ['INV-2026-0001', 'INV-2026-0002']
+  ).value;
+
+  const result = overdueInvoices([invoice1, invoice2, invoice3], '2026-10-15');
+  assert.equal(result.length, 3);
+  assert.equal(result[0].customerId, 'C-002');
+  assert.equal(result[1].customerId, 'C-001');
+  assert.equal(result[2].customerId, 'C-003');
+});
+
+test('overdueInvoices with EOM payment terms', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'EOM',
+    }).value,
+    []
+  ).value;
+  // Due date: 2026-09-30 (EOM = end of month of issue)
+
+  // As of Nov 01 - 32 days overdue
+  const result = overdueInvoices([invoice], '2026-11-01');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 32);
+  assert.equal(result[0].dueDate, '2026-09-30');
+});
+
+test('overdueInvoices includes all required fields', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+      terms: 'NET14',
+    }).value,
+    []
+  ).value;
+
+  const result = overdueInvoices([invoice], '2026-10-15');
+  assert.equal(result.length, 1);
+  const item = result[0];
+  assert.ok(item.number);
+  assert.ok(item.customerId);
+  assert.ok(item.dueDate);
+  assert.equal(typeof item.daysOverdue, 'number');
+  assert.equal(typeof item.due, 'number');
+});
+
+test('overdueInvoices does not mutate input array', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET14',
+    }).value,
+    []
+  ).value;
+
+  const invoices = [invoice];
+  const originalLength = invoices.length;
+  const result = overdueInvoices(invoices, '2026-10-15');
+
+  // Input array should be unchanged
+  assert.equal(invoices.length, originalLength);
+  assert.equal(invoices[0].status, 'issued');
+});
+
+test('overdueInvoices handles large daysOverdue values', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-01',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+      terms: 'NET14',
+    }).value,
+    []
+  ).value;
+  // Due date: 2025-01-15
+
+  // As of Oct 2026 - very overdue
+  const result = overdueInvoices([invoice], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 638);
+});
