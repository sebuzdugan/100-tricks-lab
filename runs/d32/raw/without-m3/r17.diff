@@ -24,3 +26,42 @@ export function overdueInvoices(invoices, asOf) {
     // Sort by most overdue first (earliest dueDate = most overdue)
     .sort((a, b) => a.dueDate.localeCompare(b.dueDate));
 }
+
+/**
+ * Get VAT summary across invoices.
+ * @param {Array} invoices - Array of invoice objects
+ * @returns {Array} - [{rate, base, vat}], sorted by rate from high to low
+ */
+export function vatSummary(invoices) {
+  // Accumulate base and VAT by rate
+  const vatMap = {};
+
+  invoices
+    // Only issued, partially_paid, or paid status
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    // Process each invoice's lines
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const product = getProduct(line.sku);
+        const rate = product.value.vatRate;
+
+        // Calculate base (amount after discount)
+        const lineTotal = line.qty * product.value.unitPrice;
+        const lineDiscount = roundCents(lineTotal * line.discountPercent / 100);
+        const base = lineTotal - lineDiscount;
+
+        // Calculate VAT for this line
+        const vat = roundCents(base * rate / 100);
+
+        // Accumulate in map
+        if (!vatMap[rate]) {
+          vatMap[rate] = { rate, base: 0, vat: 0 };
+        }
+        vatMap[rate].base += base;
+        vatMap[rate].vat += vat;
+      });
+    });
+
+  // Convert to array and sort by rate from high to low
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
