+/**
+ * Calculate late fee for an invoice.
+ * @param {{ status: string, dueDate: string, payments: Array, ... }} invoice
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  // 0 fee if not overdue
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // Calculate fee: 0.04% per day on amount due
+  const due = balanceDue(invoice);
+  const feeRate = 0.0004 * daysOverdue;
+  const fee = roundCents(due * feeRate);
+
+  return fee;
+}
