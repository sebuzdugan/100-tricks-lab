+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros string with 2 decimals.
+ * @param {number} cents
+ * @returns {string} - e.g., "1234.56"
+ */
+function formatEurosPlain(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a field for CSV output.
+ * If field contains comma or double quote, wrap in quotes and double any quotes inside.
+ * @param {string|undefined} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  if (!field) return '';
+  if (field.includes(',') || field.includes('"')) {
+    return '"' + field.replace(/"/g, '""') + '"';
+  }
+  return field;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices - Array of invoice objects
+ * @returns {string} - CSV string with header and data rows
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const rows = invoices.map((invoice) => {
+    // Get customer name
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+    // Get totals
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    // Format amounts as plain euros
+    const subtotal = formatEurosPlain(totals.subtotal);
+    const discount = formatEurosPlain(totals.discount);
+    const vat = formatEurosPlain(totals.vat);
+    const total = formatEurosPlain(totals.total);
+    const dueStr = formatEurosPlain(due);
+
+    // Build row with escaping
+    const fields = [
+      escapeCsvField(invoice.number),
+      escapeCsvField(customerName),
+      escapeCsvField(invoice.issueDate),
+      escapeCsvField(invoice.dueDate || ''),
+      escapeCsvField(invoice.status),
+      subtotal,
+      discount,
+      vat,
+      total,
+      dueStr,
+    ];
+
+    return fields.join(',') + '\n';
+  });
+
+  return header + rows.join('');
+}
