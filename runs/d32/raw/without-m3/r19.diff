+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('exportCsv returns header for empty invoices', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header line', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv exports single issued invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  assert.equal(lines.length, 2); // header + 1 invoice
+
+  const dataLine = lines[1];
+  assert(dataLine.includes('INV-2026-0001'));
+  assert(dataLine.includes('Northwind Studio')); // C-001 name
+});
+
+test('exportCsv exports multiple invoices in order', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 50 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  assert.equal(lines.length, 3); // header + 2 invoices
+
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv formats amounts as plain euros with 2 decimals', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  const dataLine = lines[1];
+
+  // STICKER: 100 * 50 = 5000 cents = 50.00
+  assert(dataLine.includes('50.00'));
+  // With 21% VAT: 1050 cents = 10.50
+  assert(dataLine.includes('10.50'));
+  // Total: 6050 cents = 60.50
+  assert(dataLine.includes('60.50'));
+});
+
+test('exportCsv includes customer name from database', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  // C-001 is "Northwind Studio" in the test database
+  assert(result.includes('Northwind Studio'));
+});
+
+test('exportCsv escapes customer names with commas', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-004',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  // C-004 is "Smith, Jones & Partners" which should be quoted
+  assert(result.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer names with double quotes', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-006',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  // C-006 is 'Marlow "The Print Shop"' which should have quotes doubled
+  assert(result.includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv includes issueDate', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  assert(result.includes('2026-10-07'));
+});
+
+test('exportCsv includes dueDate for issued invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-09-01',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+      terms: 'NET14',
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  const dataLine = lines[1];
+  // Due date should be 2026-09-15
+  assert(dataLine.includes('2026-09-15'));
+});
+
+test('exportCsv includes dueDate for draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET30',
+  }).value;
+
+  const result = exportCsv([draft]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  const dataLine = lines[1];
+  // Draft invoice still has calculated dueDate
+  // issueDate 2026-10-07 + NET30 = 2026-11-06
+  assert(dataLine.includes('2026-11-06'));
+});
+
+test('exportCsv includes invoice status', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+
+  const result = exportCsv([issued]);
+  assert(result.includes('issued'));
+});
+
+test('exportCsv shows status for partially_paid invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const partial = recordPayment(issued, {
+    amount: Math.floor(totals.total / 2),
+    date: '2026-10-10',
+  }).value;
+
+  const result = exportCsv([partial]);
+  assert(result.includes('partially_paid'));
+});
+
+test('exportCsv calculates due for unpaid invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const totals = invoiceTotals(invoice);
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  const dataLine = lines[1];
+
+  // Due should equal total for unpaid invoice
+  const expectedTotal = (totals.total / 100).toFixed(2);
+  const fields = dataLine.split(',');
+  assert.equal(fields[9], expectedTotal); // due is the 10th field
+});
+
+test('exportCsv calculates due for partially paid invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const payment = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued, {
+    amount: payment,
+    date: '2026-10-10',
+  }).value;
+
+  const result = exportCsv([partial]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  const dataLine = lines[1];
+
+  // Due should be half of total
+  const expectedDue = ((totals.total - payment) / 100).toFixed(2);
+  const fields = dataLine.split(',');
+  assert.equal(fields[9], expectedDue); // due is the 10th field
+});
+
+test('exportCsv calculates due as 0 for paid invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, {
+    amount: totals.total,
+    date: '2026-10-10',
+  }).value;
+
+  const result = exportCsv([paid]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  const dataLine = lines[1];
+
+  // Due should be 0 for paid invoice
+  const fields = dataLine.split(',');
+  assert.equal(fields[9], '0.00'); // due is the 10th field
+});
+
+test('exportCsv ends each line with newline', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  // First line is header, second is data, third should be empty (trailing newline)
+  assert.equal(lines[lines.length - 1], '');
+});
+
+test('exportCsv with multiple lines on single invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [
+        { sku: 'STICKER', qty: 100 },
+        { sku: 'DES-HOUR', qty: 1 },
+      ],
+    }).value,
+    []
+  ).value;
+
+  const totals = invoiceTotals(invoice);
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  assert.equal(lines.length, 2); // header + 1 invoice (lines aggregated)
+
+  const dataLine = lines[1];
+  // Total should be sum of both lines
+  const expectedTotal = (totals.total / 100).toFixed(2);
+  assert(dataLine.includes(expectedTotal));
+});
+
+test('exportCsv with discount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001', // gold tier, 5% discount
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'STICKER', qty: 100 }],
+    }).value,
+    []
+  ).value;
+
+  const totals = invoiceTotals(invoice);
+  const result = exportCsv([invoice]);
+
+  // Discount should be shown in CSV
+  const expectedDiscount = (totals.discount / 100).toFixed(2);
+  assert(result.includes(expectedDiscount));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invoices = [];
+  for (let i = 1; i <= 5; i++) {
+    const inv = issueInvoice(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: '2026-10-' + String(i).padStart(2, '0'),
+        lines: [{ sku: 'STICKER', qty: 10 * i }],
+      }).value,
+      invoices.map((inv) => inv.number)
+    ).value;
+    invoices.push(inv);
+  }
+
+  const result = exportCsv(invoices);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+
+  for (let i = 0; i < invoices.length; i++) {
+    assert(lines[i + 1].includes(invoices[i].number));
+  }
+});
+
+test('exportCsv handles amounts with various decimal places', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'PRINT-A4', qty: 1 }], // unitPrice: 37 cents
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([invoice]);
+  // Should format as "0.37" not "0.3700" or similar
+  assert(result.includes('0.37'));
+});
