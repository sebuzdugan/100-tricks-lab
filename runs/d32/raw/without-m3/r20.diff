+
+test('RATES has correct values', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(100000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 100000);
+});
+
+test('convert EUR to USD', () => {
+  // 100 EUR cents = 1 EUR
+  // 1 EUR × 1.085 = 1.085 USD = 108.5 USD cents → 108 or 109 cents (banker's rounding)
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 10000 * 1.085 = 10850, rounds to 10850
+  assert.equal(result.value, 10850);
+});
+
+test('convert EUR to GBP', () => {
+  // 100 EUR cents = 1 EUR
+  // 1 EUR × 0.8425 = 0.8425 GBP = 84.25 GBP cents → 84 cents (banker's rounding)
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  // 10000 * 0.8425 = 8425
+  assert.equal(result.value, 8425);
+});
+
+test('convert handles larger amounts correctly', () => {
+  // 1 million EUR cents = 10,000 EUR
+  const resultUsd = convert(100000000, 'USD');
+  assert.equal(resultUsd.ok, true);
+  // 100000000 * 1.085 = 108500000
+  assert.equal(resultUsd.value, 108500000);
+});
+
+test('convert returns error for unknown currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('convert handles zero amount', () => {
+  const resultUsd = convert(0, 'USD');
+  assert.equal(resultUsd.ok, true);
+  assert.equal(resultUsd.value, 0);
+
+  const resultGbp = convert(0, 'GBP');
+  assert.equal(resultGbp.ok, true);
+  assert.equal(resultGbp.value, 0);
+});
+
+test('convert applies rounding correctly', () => {
+  // Test a value that would result in a .5 cent
+  // 1 cent * 1.085 = 1.085 cents
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(typeof result.value, 'number');
+});
+
+test('formatMoney displays EUR with euro symbol', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
