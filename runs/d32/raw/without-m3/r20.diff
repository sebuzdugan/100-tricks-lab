+  assert.equal(formatMoney(100000000, 'USD'), '$1,000,000.00');
+  assert.equal(formatMoney(100000000, 'GBP'), '£1,000,000.00');
+});
+
+test('formatMoney pads cents correctly', () => {
+  assert.equal(formatMoney(1, 'EUR'), '€0.01');
+  assert.equal(formatMoney(10, 'USD'), '$0.10');
+  assert.equal(formatMoney(100, 'GBP'), '£1.00');
+});
+
+test('convert and formatMoney work together', () => {
+  // Convert 50 EUR to USD and format
+  const cents = convert(5000, 'USD');
+  assert.equal(cents.ok, true);
+  const formatted = formatMoney(cents.value, 'USD');
+  assert.equal(formatted, '$54.25'); // 5000 * 1.085 = 5425
