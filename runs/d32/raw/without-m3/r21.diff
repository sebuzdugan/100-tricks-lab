+test('mergeCustomers with no invoices', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, customers.length - 1);
+  assert.equal(result.value.invoices.length, 0);
+
+  // C-001 should be removed
+  const c001Exists = result.value.customers.some((c) => c.id === 'C-001');
+  assert.equal(c001Exists, false);
+
+  // C-002 should still exist
+  const c002Exists = result.value.customers.some((c) => c.id === 'C-002');
