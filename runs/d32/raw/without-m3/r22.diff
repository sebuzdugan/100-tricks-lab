@@ -0,0 +1,246 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const line = { qty: 10, unitPrice: 500 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal handles single unit', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal handles large amounts', () => {
+  const line = { qty: 100, unitPrice: 120000 };
+  assert.equal(lineTotal(line), 12000000);
+});
+
+test('lineTotal with fractional result rounds correctly', () => {
+  const line = { qty: 3, unitPrice: 33 };
+  assert.equal(lineTotal(line), 99);
+});
+
+test('lineDiscount with no discount', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with undefined discountPercent', () => {
+  const line = { qty: 100, unitPrice: 50 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount calculates percentage correctly', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 10 };
+  // lineTotal = 5000, discount = 10% = 500
+  assert.equal(lineDiscount(line), 500);
+});
+
+test('lineDiscount with 5% discount', () => {
+  const line = { qty: 1, unitPrice: 8500, discountPercent: 5 };
+  // lineTotal = 8500, discount = 5% = 425
+  assert.equal(lineDiscount(line), 425);
+});
+
+test('lineDiscount never returns negative', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 0 };
+  assert(lineDiscount(line) >= 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 100 };
+  // lineTotal = 5000, discount = 100% = 5000
+  assert.equal(lineDiscount(line), 5000);
+});
+
+test('lineVAT with no VAT', () => {
+  const line = { qty: 1, unitPrice: 35000, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT with undefined vatRate', () => {
+  const line = { qty: 100, unitPrice: 50 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT calculates on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 };
+  // lineTotal = 5000, discount = 0, VAT = 5000 * 0.21 = 1050
+  assert.equal(lineVAT(line), 1050);
+});
+
+test('lineVAT with discount and VAT', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 10, vatRate: 21 };
+  // lineTotal = 5000, discount = 500, taxable = 4500, VAT = 945
+  assert.equal(lineVAT(line), 945);
+});
+
+test('lineVAT with 9% VAT', () => {
+  const line = { qty: 10, unitPrice: 37, vatRate: 9 };
+  // lineTotal = 370, VAT = 33.3 → 33
+  assert.equal(lineVAT(line), 33);
+});
+
+test('lineVAT never returns negative', () => {
+  const line = { qty: 100, unitPrice: 50, vatRate: 21 };
+  assert(lineVAT(line) >= 0);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 1050);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 6050);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: subtotal=5000, discount=0, vat=1050
+  // Line 2: subtotal=8500, discount=425, vat=(8500-425)*0.21=1696
+  assert.equal(totals.subtotal, 13500);
+  assert.equal(totals.discount, 425);
+  assert.equal(totals.vat, 2746);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 15821);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 1000);
+  assert.equal(totals.total, 5050); // 6050 - 1000
+});
+
+test('invoiceTotals total never goes below 0', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 10000 }, // More than total
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with no voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 }, // 1050 VAT
+      { qty: 10, unitPrice: 37, discountPercent: 0, vatRate: 9 },   // 33 VAT
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 1083);
+});
+
+test('invoiceTotals with discounts only on some lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 425);
+});
+
+test('invoiceTotals with all fields', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 10, vatRate: 21 },
+      { qty: 2, unitPrice: 500, discountPercent: 0, vatRate: 9 },
+    ],
+    voucher: { code: 'DISCOUNT', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: 5000 - 500 + (4500*0.21)=945
+  // Line 2: 1000 - 0 + (1000*0.09)=90
+  assert.equal(totals.subtotal, 6000);
+  assert.equal(totals.discount, 500);
+  assert.equal(totals.vat, 1035);
+  assert.equal(totals.voucher, 500);
+  // 6000 - 500 + 1035 - 500 = 6035
+  assert.equal(totals.total, 6035);
+});
+
+test('invoiceTotals with large amounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 120000, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 245000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const expectedTotal = 365000 + (365000 * 0.21);
+  assert.equal(totals.total, Math.round(expectedTotal));
+});
+
+test('invoiceTotals with 0% discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals with 100% discount line', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 100, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 5000);
+  assert.equal(totals.vat, 0); // No VAT on 0 amount after discount
+});
+
+test('invoiceTotals returns object with all required fields', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
+
+test('invoiceTotals all values are integers', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 10, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 150 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(Number.isInteger(totals.subtotal), true);
+  assert.equal(Number.isInteger(totals.discount), true);
+  assert.equal(Number.isInteger(totals.vat), true);
+  assert.equal(Number.isInteger(totals.voucher), true);
+  assert.equal(Number.isInteger(totals.total), true);
+});
