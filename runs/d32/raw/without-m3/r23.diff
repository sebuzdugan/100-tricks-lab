index e32f206..3d96559 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -11,14 +11,26 @@ export function lineTotal(line) {
 
 /**
  * Calculate the discount amount for a single line.
+ * Includes regular discount (tier or line-specific) and bulk discount (2.5% off for 10+ units).
+ * Bulk discount is applied after regular discount to the remaining amount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
   const discountPercent = line.discountPercent ?? 0;
   const total = lineTotal(line);
-  const discount = roundCents(total * discountPercent / 100);
-  return Math.max(0, discount);
+
+  // Calculate regular discount
+  const regularDiscount = roundCents(total * discountPercent / 100);
+
+  // Calculate bulk discount (2.5% off for 10+ units, applied after regular discount)
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const amountAfterRegular = total - regularDiscount;
+    bulkDiscount = roundCents(amountAfterRegular * 2.5 / 100);
+  }
+
+  return Math.max(0, regularDiscount + bulkDiscount);
 }
 
