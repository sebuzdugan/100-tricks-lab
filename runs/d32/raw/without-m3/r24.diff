+/**
+ * Generate a dashboard summary of invoices.
+ * @param {Array} invoices - Array of invoice objects
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ counts: Object, outstanding: number, overdue: Object, topCustomers: Array }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+  for (const inv of invoices) {
+    if (inv.status in counts) {
+      counts[inv.status]++;
+    }
+  }
+
+  // Calculate outstanding (total due on issued/partially_paid)
+  let outstanding = 0;
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      outstanding += balanceDue(inv);
+    }
+  }
+
+  // Get overdue data
+  const overdue_invoices = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_invoices.length,
+    amount: overdue_invoices.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Calculate top customers by amount due
+  const customerDueMap = {};
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const due = balanceDue(inv);
+      if (!customerDueMap[inv.customerId]) {
+        customerDueMap[inv.customerId] = 0;
+      }
+      customerDueMap[inv.customerId] += due;
+    }
+  }
+
+  // Get top 3 customers
+  const topCustomers = Object.entries(customerDueMap)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
