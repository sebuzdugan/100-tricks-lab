   // Build the text
   const lines = [numberLine, customerName];
 
-  // Add each line item
+  // Add each line item with discount if applicable
   for (const line of invoice.lines) {
     const lineamt = lineTotal(line);
-    const lineText = `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lineamt)}`;
+    let lineText = `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lineamt)}`;
+
+    // Add discount if line has one
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      lineText += ` (discount: ${formatEuros(discount)})`;
+    }
+
     lines.push(lineText);
   }
 
@@ -34,8 +42,24 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  // Add voucher if any (before total)
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(totals.voucher)}`);
+  }
+
   // Add total
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Add due date if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Add paid amount if there are payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const paid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return lines.join('\n');
 }
