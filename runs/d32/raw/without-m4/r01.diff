diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..e63a14a
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,60 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create an invoice draft.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} input
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: 'draft', lines: Array<any> } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  const enrichedLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
+
+/**
+ * Check if a date string is valid in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return false;
+
+  const date = new Date(dateStr + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+
+  const [year, month, day] = dateStr.split('-').map(Number);
+  return (
+    date.getUTCFullYear() === year &&
+    date.getUTCMonth() === month - 1 &&
+    date.getUTCDate() === day
+  );
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..cb8aaa7
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,192 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2024-02-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+
+  const line1 = result.value.lines[0];
+  assert.equal(line1.sku, 'DEV-HOUR');
+  assert.equal(line1.name, 'Development (hour)');
+  assert.equal(line1.qty, 10);
+  assert.equal(line1.unitPrice, 9500);
+  assert.equal(line1.vatRate, 21);
+
+  const line2 = result.value.lines[1];
+  assert.equal(line2.sku, 'LOGO-PACK');
+  assert.equal(line2.name, 'Logo package');
+  assert.equal(line2.qty, 1);
+  assert.equal(line2.unitPrice, 120000);
+  assert.equal(line2.vatRate, 21);
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for bad format', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024/02/15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '15-02-2024',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '02-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice reports DATE_INVALID for non-existent dates', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-02-30',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2023-04-31',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice accepts valid dates including leap days', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-02-15',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice reports NO_LINES when lines is missing', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-02-15',
+      lines: undefined,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice reports QTY_INVALID for non-positive quantities', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-02-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-02-15',
+      lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice reports QTY_INVALID for non-integer quantities', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-02-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1.5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-02-15',
+      lines: [{ sku: 'DEV-HOUR', qty: '10' }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice reports UNKNOWN_SKU for product not in catalogue', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-02-15',
+      lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice does not mutate the input array', () => {
+  const lines = [
+    { sku: 'DEV-HOUR', qty: 10 },
+    { sku: 'LOGO-PACK', qty: 1 },
+  ];
+  const originalJSON = JSON.stringify(lines);
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines,
+  });
+
+  assert.equal(JSON.stringify(lines), originalJSON);
+});
