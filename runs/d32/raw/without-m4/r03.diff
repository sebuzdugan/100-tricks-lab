+
+test('addLine adds a new line to an invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const result = addLine(invoice, { sku: 'LOGO-PACK', qty: 1 });
+  assert.equal(result.ok, true);
+
+  const newInvoice = result.value;
+  assert.equal(newInvoice.lines.length, 2);
+  assert.equal(newInvoice.lines[1].sku, 'LOGO-PACK');
+  assert.equal(newInvoice.lines[1].qty, 1);
+});
+
+test('addLine increases qty if SKU already exists', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const result = addLine(invoice, { sku: 'DEV-HOUR', qty: 3 });
+  assert.equal(result.ok, true);
+
+  const newInvoice = result.value;
+  assert.equal(newInvoice.lines.length, 1);
+  assert.equal(newInvoice.lines[0].sku, 'DEV-HOUR');
+  assert.equal(newInvoice.lines[0].qty, 8);
+});
+
