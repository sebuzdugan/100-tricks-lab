+++ b/test/numbering.test.js
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates first number for a year', () => {
+  const num = nextInvoiceNumber([], '2024-02-15');
+  assert.equal(num, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002'];
+  const num = nextInvoiceNumber(existing, '2024-05-10');
+  assert.equal(num, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber finds max counter regardless of order', () => {
+  const existing = ['INV-2024-0003', 'INV-2024-0001', 'INV-2024-0005', 'INV-2024-0002'];
+  const num = nextInvoiceNumber(existing, '2024-06-20');
+  assert.equal(num, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber filters by year', () => {
+  const existing = ['INV-2023-0010', 'INV-2023-0011', 'INV-2024-0002', 'INV-2024-0001'];
+  const num = nextInvoiceNumber(existing, '2024-03-15');
+  assert.equal(num, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2023-0005', 'INV-2023-0006', 'INV-2023-0007'];
+  const num = nextInvoiceNumber(existing, '2024-01-01');
+  assert.equal(num, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 100 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const num = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(num, 'INV-2024-0101');
+});
+
+test('nextInvoiceNumber ignores invalid numbers', () => {
+  const existing = ['INV-2024-0001', 'INVALID', 'INV-2024-', 'INV-2024-ABC', 'INV-2024-0003'];
+  const num = nextInvoiceNumber(existing, '2024-02-15');
+  assert.equal(num, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from different years', () => {
+  const existing = ['INV-2023-9999', 'INV-2025-0001', 'INV-2024-0001'];
+  const num = nextInvoiceNumber(existing, '2024-02-15');
+  assert.equal(num, 'INV-2024-0002');
+});
