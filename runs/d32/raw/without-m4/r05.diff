+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {any} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  const invoiceNumber = invoice.number ?? 'DRAFT';
+  lines.push(invoiceNumber);
+
+  lines.push(`Customer: ${invoice.customerId}`);
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const unitPriceStr = formatEuros(line.unitPrice);
+    const totalStr = formatEuros(total);
+    lines.push(`${line.qty} x ${line.name} @ ${unitPriceStr} = ${totalStr}`);
+  }
+
+  const totals = invoiceTotals(invoice);
+  const totalStr = formatEuros(totals.total);
+  lines.push(`Total: ${totalStr}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..8c58342
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,145 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2024-0001');
+});
+
+test('renderInvoiceText shows customer ID', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Customer: C-003');
+});
+
+test('renderInvoiceText formats a single line item', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '10 x Development (hour) @ €95.00 = €950.00');
+});
+
+test('renderInvoiceText formats multiple line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '10 x Development (hour) @ €95.00 = €950.00');
+  assert.equal(lines[3], '1 x Logo package @ €1,200.00 = €1,200.00');
+});
+
+test('renderInvoiceText shows total on last line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[4], 'Total: €2,150.00');
+});
+
+test('renderInvoiceText formats amounts in euros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [
+      { sku: 'STICKER', qty: 100 },
+      { sku: 'HOST-MONTH', qty: 12 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '100 x Sticker sheet @ €0.50 = €50.00');
+  assert.equal(lines[3], '12 x Website hosting (month) @ €15.00 = €180.00');
+  assert.equal(lines[4], 'Total: €230.00');
+});
+
+test('renderInvoiceText shows complete invoice with issued number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2024-03-20',
+    lines: [
+      { sku: 'COPY-HOUR', qty: 8 },
+      { sku: 'ICON-SET', qty: 5 },
+    ],
+  }).value;
+
+  const issued = issueInvoice(invoice, ['INV-2024-0001']).value;
+  const text = renderInvoiceText(issued);
+
+  const expected =
+    'INV-2024-0002\n' +
+    'Customer: C-005\n' +
+    '8 x Copywriting (hour) @ €60.00 = €480.00\n' +
+    '5 x Icon set (24 icons) @ €9.80 = €49.00\n' +
+    'Total: €529.00';
+
+  assert.equal(text, expected);
+});
+
+test('renderInvoiceText renders as single string with newlines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.equal(typeof text, 'string');
+  assert.ok(text.includes('\n'));
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4);
+});
