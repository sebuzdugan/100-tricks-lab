diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..5e73e13
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,100 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2024-01-01'), true);
+  assert.equal(isValidDate('2024-02-15'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('2024/01/01'), false);
+  assert.equal(isValidDate('01-01-2024'), false);
+  assert.equal(isValidDate('2024-1-1'), false);
+  assert.equal(isValidDate('2024-01-1'), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2024-02-30'), false);
+  assert.equal(isValidDate('2023-04-31'), false);
+  assert.equal(isValidDate('2024-13-01'), false);
+  assert.equal(isValidDate('2024-00-01'), false);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('2100-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2024-01-01', 1), '2024-01-02');
+  assert.equal(addDays('2024-01-01', 5), '2024-01-06');
+  assert.equal(addDays('2024-01-01', 31), '2024-02-01');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2024-01-31', 1), '2024-02-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2024-01-02', -1), '2024-01-01');
+  assert.equal(addDays('2024-02-01', -1), '2024-01-31');
+  assert.equal(addDays('2024-03-01', -1), '2024-02-29');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2024-01-15', 0), '2024-01-15');
+});
+
+test('addDays handles large day counts', () => {
+  assert.equal(addDays('2024-01-01', 365), '2024-12-31');
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01');
+});
+
+test('daysBetween calculates days between dates', () => {
+  assert.equal(daysBetween('2024-01-01', '2024-01-02'), 1);
+  assert.equal(daysBetween('2024-01-01', '2024-01-06'), 5);
+  assert.equal(daysBetween('2024-01-01', '2024-02-01'), 31);
+});
+
+test('daysBetween handles same date', () => {
+  assert.equal(daysBetween('2024-01-15', '2024-01-15'), 0);
+});
+
+test('daysBetween handles negative differences', () => {
+  assert.equal(daysBetween('2024-01-06', '2024-01-01'), -5);
+  assert.equal(daysBetween('2024-02-01', '2024-01-01'), -31);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2024-01-31', '2024-02-01'), 1);
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween handles leap year transitions', () => {
+  assert.equal(daysBetween('2023-02-28', '2024-02-29'), 366);
+  assert.equal(daysBetween('2024-02-29', '2025-02-28'), 365);
+});
+
+test('isValidDate works with createInvoice dates', () => {
+  assert.equal(isValidDate('2024-02-15'), true);
+  assert.equal(isValidDate('2024-02-30'), false);
+});
