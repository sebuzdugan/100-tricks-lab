new file mode 100644
index 0000000..c6b5961
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,55 @@
+/**
+ * Check if a date string is valid in YYYY-MM-DD format and represents a real date.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+
+  const [year, month, day] = text.split('-').map(Number);
+  return (
+    date.getUTCFullYear() === year &&
+    date.getUTCMonth() === month - 1 &&
+    date.getUTCDate() === day
+  );
+}
+
+/**
+ * Add n days to a date string (in UTC).
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - New date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const date = new Date(dateStr + 'T00:00:00Z');
+  date.setUTCDate(date.getUTCDate() + n);
+  return formatDate(date);
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a) in UTC.
+ * @param {string} dateA - Date in YYYY-MM-DD format
+ * @param {string} dateB - Date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (dateB - dateA)
+ */
+export function daysBetween(dateA, dateB) {
+  const a = new Date(dateA + 'T00:00:00Z');
+  const b = new Date(dateB + 'T00:00:00Z');
+  const diffMs = b.getTime() - a.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
+
+/**
+ * Format a Date object as YYYY-MM-DD string in UTC.
+ * @param {Date} date
+ * @returns {string}
+ */
+function formatDate(date) {
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
