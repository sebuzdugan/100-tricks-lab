+++ b/test/payments.test.js
@@ -0,0 +1,272 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment adds payment to issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const halfPayment = Math.floor(total / 2);
+
+  const result = recordPayment(issued, { amount: halfPayment, date: '2024-02-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, halfPayment);
+  assert.equal(result.value.payments[0].date, '2024-02-20');
+});
+
+test('recordPayment sets status to partially_paid when partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const halfPayment = Math.floor(total / 2);
+
+  const result = recordPayment(issued, { amount: halfPayment, date: '2024-02-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when full payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const result = recordPayment(issued, { amount: total, date: '2024-02-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment allows multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const quarter = Math.floor(total / 4);
+
+  let current = issued;
+  for (let i = 0; i < 3; i++) {
+    const result = recordPayment(current, { amount: quarter, date: `2024-02-2${i}` });
+    assert.equal(result.ok, true);
+    current = result.value;
+  }
+
+  assert.equal(current.payments.length, 3);
+  assert.equal(current.status, 'partially_paid');
+
+  const remaining = total - quarter * 3;
+  const finalResult = recordPayment(current, { amount: remaining, date: '2024-02-23' });
+  assert.equal(finalResult.ok, true);
+  assert.equal(finalResult.value.payments.length, 4);
+  assert.equal(finalResult.value.status, 'paid');
+});
+
+test('recordPayment rejects draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = recordPayment(invoice, { amount: 1000, date: '2024-02-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects invalid amounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 0, date: '2024-02-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(recordPayment(issued, { amount: -100, date: '2024-02-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(recordPayment(issued, { amount: 100.5, date: '2024-02-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(recordPayment(issued, { amount: '1000', date: '2024-02-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment rejects invalid dates', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 1000, date: '2024-02-30' }), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+
+  assert.deepEqual(recordPayment(issued, { amount: 1000, date: '2024/02/15' }), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const result = recordPayment(issued, { amount: total + 1000, date: '2024-02-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const originalJSON = JSON.stringify(issued);
+
+  recordPayment(issued, { amount: 1000, date: '2024-02-20' });
+
+  assert.equal(JSON.stringify(issued), originalJSON);
+});
+
+test('recordPayment works on partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const third = Math.floor(total / 3);
+
+  const first = recordPayment(issued, { amount: third, date: '2024-02-20' }).value;
+  assert.equal(first.status, 'partially_paid');
+
+  const second = recordPayment(first, { amount: third, date: '2024-02-21' }).value;
+  assert.equal(second.status, 'partially_paid');
+});
+
+test('balanceDue returns full amount for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  assert.equal(balanceDue(issued), total);
+});
+
+test('balanceDue returns remaining amount after partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const payment = Math.floor(total / 2);
+
+  const partial = recordPayment(issued, { amount: payment, date: '2024-02-20' }).value;
+
+  assert.equal(balanceDue(partial), total - payment);
+});
+
+test('balanceDue returns zero for paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const paid = recordPayment(issued, { amount: total, date: '2024-02-20' }).value;
+
+  assert.equal(balanceDue(paid), 0);
+});
+
+test('balanceDue handles invoices without payments array', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  assert.equal(balanceDue(issued), total);
+});
+
+test('balanceDue with multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const quarter = Math.floor(total / 4);
+
+  let current = issued;
+  for (let i = 0; i < 3; i++) {
+    const result = recordPayment(current, { amount: quarter, date: `2024-02-2${i}` });
+    current = result.value;
+  }
+
+  assert.equal(balanceDue(current), total - quarter * 3);
+});
