+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate a customer statement showing outstanding invoices.
+ * @param {string} customerId
+ * @param {Array<any>} invoices - Array of invoices to filter from
+ * @param {string} asOf - Date in YYYY-MM-DD format (statement cutoff date)
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<any>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  const normalizedCustomerId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  const customerInvoices = invoices
+    .filter((inv) => normalizeId(inv.customerId) === normalizedCustomerId)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  const totalDue = customerInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: customerInvoices,
+    totalDue,
+  });
+}
