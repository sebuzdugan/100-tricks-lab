+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns invoices for customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const result = statement('C-001', [issued1], '2024-02-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2024-0001');
+});
+
+test('statement normalizes customer ID', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const result = statement('c-001 ', [issued1], '2024-02-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement rejects unknown customer', () => {
+  const result = statement('C-999', [], '2024-02-20');
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement rejects invalid date', () => {
+  const result = statement('C-001', [], '2024-02-30');
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('statement filters by issueDate cutoff', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2024-02-17');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2024-0001');
+});
+
+test('statement includes invoice on cutoff date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = statement('C-001', [issued], '2024-02-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = statement('C-001', [draft], '2024-02-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2024-02-20' }).value;
+
+  const result = statement('C-001', [paid], '2024-02-25');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2024-02-20' }).value;
+
+  const result = statement('C-001', [partial], '2024-02-25');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2024-0001');
+});
+
+test('statement calculates due amount correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2024-02-20' }).value;
+
+  const result = statement('C-001', [partial], '2024-02-25');
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.invoices[0].due > 0);
+  assert.ok(result.value.invoices[0].due < result.value.invoices[0].total);
+});
+
+test('statement calculates totalDue', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2024-02-25');
+
+  assert.equal(result.ok, true);
+  const due1 = result.value.invoices[0].due;
+  const due2 = result.value.invoices[1].due;
+  assert.equal(result.value.totalDue, due1 + due2);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-25',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+  const issued3 = issueInvoice(inv3, ['INV-2024-0001', 'INV-2024-0002']).value;
+
+  const result = statement('C-001', [issued1, issued2, issued3], '2024-02-28');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2024-02-15');
+  assert.equal(result.value.invoices[1].issueDate, '2024-02-20');
+  assert.equal(result.value.invoices[2].issueDate, '2024-02-25');
+});
+
+test('statement filters by customer ID', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2024-02-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2024-0001');
+});
+
+test('statement returns zero totalDue when no outstanding invoices', () => {
+  const result = statement('C-001', [], '2024-02-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes issueDate, dueDate, total, and due', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = statement('C-001', [issued], '2024-02-20');
+
+  assert.equal(result.ok, true);
+  const inv_stmt = result.value.invoices[0];
+  assert.equal(inv_stmt.issueDate, '2024-02-15');
+  assert.equal(inv_stmt.dueDate, '2024-03-16');
+  assert.ok(inv_stmt.total > 0);
+  assert.ok(inv_stmt.due > 0);
+});
