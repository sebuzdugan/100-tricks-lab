diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..5cd4aa9
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,239 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2024-02-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2024-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Discount');
+  assert.equal(result.value.date, '2024-02-20');
+});
+
+test('createCreditNote creates credit note for partially_paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2024-02-17' }).value;
+
+  const result = createCreditNote(partial, { amount: 2000, reason: 'Return', date: '2024-02-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.number.startsWith('CN-2024-'));
+});
+
+test('createCreditNote creates credit note for paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2024-02-17' }).value;
+
+  const result = createCreditNote(paid, { amount: 2000, reason: 'Adjustment', date: '2024-02-20' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = createCreditNote(draft, { amount: 5000, reason: 'Discount', date: '2024-02-20' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects invalid amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  assert.deepEqual(createCreditNote(issued, { amount: 0, reason: 'Discount', date: '2024-02-20' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: -100, reason: 'Discount', date: '2024-02-20' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: 100.5, reason: 'Discount', date: '2024-02-20' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: '5000', reason: 'Discount', date: '2024-02-20' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('createCreditNote rejects invalid dates', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  assert.deepEqual(createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2024-02-30' }, []), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2024/02/15' }, []), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+});
+
+test('createCreditNote rejects credit notes exceeding invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const result = createCreditNote(issued, { amount: total + 1000, reason: 'Too much', date: '2024-02-20' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit note for full invoice amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const result = createCreditNote(issued, { amount: total, reason: 'Full refund', date: '2024-02-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, total);
+});
+
+test('createCreditNote numbers sequentially', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const cn1 = createCreditNote(issued, { amount: 1000, reason: 'Credit 1', date: '2024-02-20' }, []).value;
+  const cn2 = createCreditNote(issued, { amount: 1000, reason: 'Credit 2', date: '2024-02-21' }, [cn1.number])
+    .value;
+  const cn3 = createCreditNote(issued, { amount: 1000, reason: 'Credit 3', date: '2024-02-22' }, [cn1.number, cn2.number])
+    .value;
+
+  assert.equal(cn1.number, 'CN-2024-0001');
+  assert.equal(cn2.number, 'CN-2024-0002');
+  assert.equal(cn3.number, 'CN-2024-0003');
+});
+
+test('createCreditNote separates credit note and invoice counters', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-16',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const cn1 = createCreditNote(issued1, { amount: 1000, reason: 'Credit 1', date: '2024-02-20' }, ['INV-2024-0001', 'INV-2024-0002'])
+    .value;
+
+  assert.equal(cn1.number, 'CN-2024-0001');
+});
+
+test('createCreditNote restarts counter for new year', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const cn2024 = createCreditNote(issued, { amount: 1000, reason: 'Credit', date: '2024-12-31' }, ['CN-2024-0001', 'CN-2024-0002'])
+    .value;
+
+  const inv2025 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued2025 = issueInvoice(inv2025, []).value;
+  const cn2025 = createCreditNote(issued2025, { amount: 1000, reason: 'Credit', date: '2025-01-20' }, [cn2024.number])
+    .value;
+
+  assert.equal(cn2024.number, 'CN-2024-0003');
+  assert.equal(cn2025.number, 'CN-2025-0001');
+});
+
+test('createCreditNote with mixed invoice and credit note numbers', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 1000, reason: 'Credit', date: '2024-02-20' }, [
+    'INV-2024-0001',
+    'CN-2024-0001',
+    'INV-2024-0002',
+    'CN-2024-0002',
+  ]);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0003');
+});
