+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Create a credit note (refund) for an issued invoice.
+ * @param {any} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData - amount in cents, date in YYYY-MM-DD
+ * @param {string[]} existingNumbers - Array of invoice and credit note numbers
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const invoiceTotal = invoiceTotals(invoice).total;
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
+
+/**
+ * Calculate the next credit note number for a given year.
+ * @param {string[]} existingNumbers - Array of invoice and credit note numbers
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} - Next credit note number (e.g. 'CN-2024-0001')
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+  const prefix = `CN-${year}-`;
+
+  const currentYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.slice(prefix.length), 10))
+    .filter((counter) => !isNaN(counter));
+
+  const maxCounter = currentYearNumbers.length > 0 ? Math.max(...currentYearNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
