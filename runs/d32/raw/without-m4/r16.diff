+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns invoices with dueDate before asOf', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2024-03-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].number, 'INV-2024-0001');
+  assert.ok(result.value[0].daysOverdue > 0);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2024-03-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes invoices due on exact date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2024-03-16');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2024-02-20' }).value;
+
+  const result = overdueInvoices([partial], '2024-03-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const result = overdueInvoices([draft], '2024-03-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2024-02-20' }).value;
+
+  const result = overdueInvoices([paid], '2024-03-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+  const issued3 = issueInvoice(inv3, ['INV-2024-0001', 'INV-2024-0002']).value;
+
+  const result = overdueInvoices([issued3, issued1, issued2], '2024-03-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 3);
+  assert.ok(result.value[0].daysOverdue >= result.value[1].daysOverdue);
+  assert.ok(result.value[1].daysOverdue >= result.value[2].daysOverdue);
+  assert.equal(result.value[0].number, 'INV-2024-0001');
+  assert.equal(result.value[1].number, 'INV-2024-0002');
+  assert.equal(result.value[2].number, 'INV-2024-0003');
+});
+
+test('overdueInvoices includes due amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2024-02-20' }).value;
+
+  const result = overdueInvoices([partial], '2024-03-20');
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value[0].due > 0);
+  assert.ok(result.value[0].due < result.value[0].due + 5000);
+});
+
+test('overdueInvoices includes customerId and dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2024-03-05');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value[0].customerId, 'C-002');
+  assert.equal(result.value[0].dueDate, '2024-02-29');
+});
+
+test('overdueInvoices rejects invalid date', () => {
+  const result = overdueInvoices([], '2024-02-30');
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2024-03-10');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2024-03-25');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value[0].daysOverdue, 9);
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const result = overdueInvoices([issued1, issued2], '2024-03-10');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 2);
+  assert.ok(result.value.some((inv) => inv.customerId === 'C-001'));
+  assert.ok(result.value.some((inv) => inv.customerId === 'C-002'));
+});
