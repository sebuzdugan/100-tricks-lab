+import { fail } from './result.js';
+import { balanceDue } from './payments.js';
+import { isValidDate, daysBetween } from './dates.js';
+
+/**
+ * Generate a report of overdue invoices.
+ * @param {Array<any>} invoices - Array of invoices to filter
+ * @param {string} asOf - Report date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: Array<any> } | { ok: false, error: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  const overdue = invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.dueDate && inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return { ok: true, value: overdue };
+}
