+
+/**
+ * Generate a VAT summary report.
+ * @param {Array<any>} invoices - Array of invoices to summarize
+ * @returns {Array<{ rate: number, base: number, vat: number }>} - VAT entries sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      if (!inv.lines) return;
+
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate || 0;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVAT(line);
+
+        if (!vatMap[rate]) {
+          vatMap[rate] = { base: 0, vat: 0 };
+        }
+
+        vatMap[rate].base += base;
+        vatMap[rate].vat += vat;
+      });
+    });
+
+  return Object.entries(vatMap)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseFloat(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
