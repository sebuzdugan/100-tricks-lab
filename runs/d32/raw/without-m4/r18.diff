@@ -64,3 +65,30 @@ export function vatSummary(invoices) {
     }))
     .sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fee for an invoice.
+ * @param {any} invoice - The invoice
+ * @param {string} asOf - Report date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }} - Late fee in cents
+ */
+export function lateFee(invoice, asOf) {
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return { ok: true, value: 0 };
+  }
+
+  if (!invoice.dueDate || invoice.dueDate >= asOf) {
+    return { ok: true, value: 0 };
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const feeAmount = due * 0.0004 * daysOverdue;
+  const lateFeeAmount = roundCents(feeAmount);
+
+  return { ok: true, value: lateFeeAmount };
+}
