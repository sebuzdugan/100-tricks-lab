+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header for empty array', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv exports single invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].includes('INV-2024-0001'));
+  assert.ok(lines[1].includes('2024-02-15'));
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-16',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const result = exportCsv([issued1, issued2]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert.ok(lines[1].includes('INV-2024-0001'));
+  assert.ok(lines[2].includes('INV-2024-0002'));
+});
+
