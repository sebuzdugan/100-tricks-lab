diff --git a/src/money.js b/src/money.js
index fadf486..48b1e63 100644
--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,59 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert an amount from EUR cents to another currency in that currency's cents.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Target currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const euros = cents / 100;
+  const converted = euros * rate;
+  const convertedCents = roundCents(converted * 100);
+
+  return { ok: true, value: convertedCents };
+}
+
+/**
+ * Format an amount in cents for a currency: 123456 cents USD -> "$1,234.56".
+ * @param {number} cents - Amount in the currency's cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const rate = RATES[currency];
+  if (!rate) {
+    return formatEuros(cents);
+  }
+
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+
+  let symbol;
+  switch (currency) {
+    case 'USD':
+      symbol = '$';
+      break;
+    case 'GBP':
+      symbol = '£';
+      break;
+    default:
+      symbol = '€';
+  }
+
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
