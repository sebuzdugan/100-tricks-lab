diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..73c0208
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,55 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single invoice line (qty * unitPrice).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount for a single invoice line.
+ * @param {{ discountPercent?: number, qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const percent = line.discountPercent ?? 0;
+  const discount = roundCents((lineTotal(line) * percent) / 100);
+  return Math.max(0, discount);
+}
+
+/**
+ * Calculate the VAT for a single invoice line (based on amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = Math.max(0, total - discount);
+  const vat = roundCents((amountAfterDiscount * line.vatRate) / 100);
+  return Math.max(0, vat);
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = roundCents(invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
+  const discount = roundCents(invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0));
+  const vat = roundCents(invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0));
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, roundCents(subtotal - discount + vat - voucher));
+
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
