@@ -0,0 +1,243 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty * unitPrice', () => {
+  const line = { qty: 10, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 10000);
+});
+
+test('lineTotal returns whole cents', () => {
+  const line = { qty: 3, unitPrice: 333 };
+  assert.equal(lineTotal(line), 999);
+});
+
+test('lineTotal with single item', () => {
+  const line = { qty: 1, unitPrice: 5000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineDiscount calculates correct discount amount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 1000);
+});
+
+test('lineDiscount defaults to 0 when discountPercent is undefined', () => {
+  const line = { qty: 10, unitPrice: 1000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount clamps to 0 (never negative)', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 10000);
+});
+
+test('lineVAT calculates VAT on amount after discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 21 };
+  assert.equal(lineVAT(line), 1890);
+});
+
+test('lineVAT handles 0% VAT rate', () => {
+  const line = { qty: 10, unitPrice: 1000, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT handles 9% VAT rate', () => {
+  const line = { qty: 10, unitPrice: 1000, vatRate: 9 };
+  assert.equal(lineVAT(line), 900);
+});
+
+test('lineVAT clamps to 0 (never negative)', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('invoiceTotals returns correct subtotal, discount, vat, and total', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 2100);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 12100);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.total, 12100);
+});
+
+test('invoiceTotals with many lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21 },
+      { qty: 5, unitPrice: 2000, vatRate: 21 },
+      { qty: 1, unitPrice: 5000, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 25000);
+  assert.equal(result.total, 30250);
+});
+
+test('invoiceTotals returns whole cents', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 333, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.ok(Number.isInteger(result.total));
+});
+
+test('invoiceTotals includes discount in calculation', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 1000);
+  assert.equal(result.vat, 1890);
+  assert.equal(result.total, 10890);
+});
+
+test('invoiceTotals with zero discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.discount, 0);
+  assert.equal(result.total, 12100);
+});
+
+test('invoiceTotals clamps total to 0 if discount exceeds subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.ok(result.total >= 0);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 1000 },
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.voucher, 1000);
+  assert.equal(result.total, 11100);
+});
+
+test('invoiceTotals includes zero voucher for invoices without vouchers', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.voucher, 0);
+});
+
+test('invoiceTotals calculates VAT on discounted amounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  const expectedSubtotal = 10000;
+  const expectedDiscount = 1000;
+  const expectedBase = expectedSubtotal - expectedDiscount;
+  const expectedVat = Math.round(expectedBase * 0.21);
+
+  assert.equal(result.subtotal, expectedSubtotal);
+  assert.equal(result.discount, expectedDiscount);
+  assert.equal(result.vat, expectedVat);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21 },
+      { qty: 10, unitPrice: 1000, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 20000);
+  assert.equal(result.vat, 3000);
+  assert.equal(result.total, 23000);
+});
+
+test('invoiceTotals returns zero VAT when no VAT-able lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.vat, 0);
+});
+
+test('lineTotal with complex scenario', () => {
+  const line = { qty: 123, unitPrice: 4567 };
+  const result = lineTotal(line);
+
+  assert.equal(result, 561741);
+});
+
+test('lineDiscount with complex percentage', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 33.33 };
+  const result = lineDiscount(line);
+
+  assert.ok(result > 0);
+  assert.ok(Number.isInteger(result));
+});
+
+test('invoiceTotals total equals subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 50, unitPrice: 200, discountPercent: 15, vatRate: 21 },
+      { qty: 30, unitPrice: 300, discountPercent: 5, vatRate: 9 },
+    ],
+    voucher: { code: 'SAVE', amount: 500 },
+  };
+  const result = invoiceTotals(invoice);
+
+  const calculated = result.subtotal - result.discount + result.vat - result.voucher;
+  assert.equal(result.total, Math.max(0, calculated));
+});
