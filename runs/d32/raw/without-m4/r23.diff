--- a/src/totals.js
+++ b/src/totals.js
@@ -10,14 +10,23 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount for a single invoice line.
+ * Calculate the discount for a single invoice line (including bulk discount for qty >= 10).
  * @param {{ discountPercent?: number, qty: number, unitPrice: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
   const percent = line.discountPercent ?? 0;
-  const discount = roundCents((lineTotal(line) * percent) / 100);
-  return Math.max(0, discount);
+  const total = lineTotal(line);
+  const firstDiscount = roundCents((total * percent) / 100);
+
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const amountAfterFirstDiscount = Math.max(0, total - firstDiscount);
+    bulkDiscount = roundCents((amountAfterFirstDiscount * 2.5) / 100);
+  }
+
+  const totalDiscount = roundCents(firstDiscount + bulkDiscount);
+  return Math.max(0, totalDiscount);
 }
 
