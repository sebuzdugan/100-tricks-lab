+/**
+ * Generate a dashboard summary of invoice data.
+ * @param {Array<any>} invoices - Array of invoices
+ * @param {string} asOf - Report date in YYYY-MM-DD format
+ * @returns {{ counts, outstanding, overdue, topCustomers }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const inv of invoices) {
+    if (counts[inv.status] !== undefined) {
+      counts[inv.status]++;
+    }
+  }
+
+  let outstanding = 0;
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      outstanding += balanceDue(inv);
+    }
+  }
+
+  const overdueResult = overdueInvoices(invoices, asOf);
+  let overdue = { count: 0, amount: 0 };
+  if (overdueResult.ok) {
+    overdue.count = overdueResult.value.length;
+    overdue.amount = overdueResult.value.reduce((sum, inv) => sum + inv.due, 0);
+  }
+
+  const customerDues = {};
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const customerId = inv.customerId;
+      const due = balanceDue(inv);
+      if (!customerDues[customerId]) {
+        customerDues[customerId] = 0;
+      }
+      customerDues[customerId] += due;
+    }
+  }
+
+  const topCustomers = Object.entries(customerDues)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
