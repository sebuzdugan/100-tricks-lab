--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,52 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate that issueDate is in YYYY-MM-DD format and represents a real date.
+ * @param {string} issueDate
+ * @returns {boolean}
+ */
+function isValidDate(issueDate) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) return false;
+  const date = new Date(issueDate + 'T00:00:00Z');
+  return date instanceof Date && !isNaN(date) && date.toISOString().slice(0, 10) === issueDate;
+}
+
+/**
+ * Create an invoice with the given customer, issue date, and lines.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const invoiceLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..89ea404
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,181 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with product details', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const invoice = result.value;
+  assert.equal(invoice.customerId, 'C-001');
+  assert.equal(invoice.issueDate, '2025-01-15');
+  assert.equal(invoice.status, 'draft');
+  assert.equal(invoice.lines.length, 2);
+
+  assert.equal(invoice.lines[0].sku, 'DES-HOUR');
+  assert.equal(invoice.lines[0].name, 'Design work (hour)');
+  assert.equal(invoice.lines[0].qty, 5);
+  assert.equal(invoice.lines[0].unitPrice, 8500);
+  assert.equal(invoice.lines[0].vatRate, 21);
+
+  assert.equal(invoice.lines[1].sku, 'DEV-HOUR');
+  assert.equal(invoice.lines[1].name, 'Development (hour)');
+  assert.equal(invoice.lines[1].qty, 10);
+  assert.equal(invoice.lines[1].unitPrice, 9500);
+  assert.equal(invoice.lines[1].vatRate, 21);
+});
+
+test('createInvoice rejects an unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025/01/15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects invalid calendar dates', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-30',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects missing date', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects empty lines', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice rejects non-array lines', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: null,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice rejects negative quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: [{ sku: 'DES-HOUR', qty: -1 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects zero quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: [{ sku: 'DES-HOUR', qty: 0 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects non-integer quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice with VAT-exempt product', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 0);
+});
+
+test('createInvoice with mixed VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-03-01',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+  const linesCopy = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines,
+  });
+
+  assert.deepEqual(lines, linesCopy);
+});
