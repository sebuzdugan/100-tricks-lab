diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..4996232
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for empty list', () => {
+  const result = nextInvoiceNumber([], '2025-01-15');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const result = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(result, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber restarts each year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2025-0001', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber ignores other years', () => {
+  const existing = ['INV-2023-0050', 'INV-2024-0025', 'INV-2025-0001', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(result, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber handles unordered list', () => {
+  const existing = ['INV-2025-0003', 'INV-2025-0001', 'INV-2025-0004', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(result, 'INV-2025-0005');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2025-0001', 'INVALID', 'INV-2025-0002', 'INV-2024-0001'];
+  const result = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(result, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2025-000${i + 1}`);
+  const result = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(result, 'INV-2025-0010');
+});
+
+test('nextInvoiceNumber with four-digit counter', () => {
+  const existing = ['INV-2025-9999'];
+  const result = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(result, 'INV-2025-10000');
+});
+
+test('nextInvoiceNumber extracts year from issueDate', () => {
+  const existing = [];
+  const result = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(result, 'INV-2026-0001');
+});
