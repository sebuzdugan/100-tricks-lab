+/**
+ * Issue a draft invoice with a generated invoice number.
+ * @param {{ status: string, issueDate: string }} invoice
+ * @param {string[]} existingNumbers
+ * @returns {{ ok: true, value: { status: string, number: string } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    ...invoice,
+    number,
+    status: 'issued',
+  });
+}
