new file mode 100644
index 0000000..131dd53
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,24 @@
+/**
+ * Get the next invoice number for a given year.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {string[]} existingNumbers
+ * @param {string} issueDate
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+
+  const currentYearNumbers = existingNumbers
+    .map((num) => {
+      const match = /^INV-(\d{4})-(\d{4})$/.exec(num);
+      if (!match) return null;
+      return { year: match[1], counter: parseInt(match[2], 10) };
+    })
+    .filter((item) => item !== null && item.year === year);
+
+  const maxCounter =
+    currentYearNumbers.length === 0 ? 0 : Math.max(...currentYearNumbers.map((item) => item.counter));
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
