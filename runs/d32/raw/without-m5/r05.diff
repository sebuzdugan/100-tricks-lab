@@ -0,0 +1,154 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+
+  assert.ok(text.startsWith('INV-2025-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText formats line items correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('5 × Design work (hour) @ €85.00 = €425.00'));
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('5 × Design work (hour) @ €85.00 = €425.00'));
+  assert.ok(text.includes('10 × Development (hour) @ €95.00 = €950.00'));
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('Total: €1,375.00'));
+});
+
+test('renderInvoiceText formats large amounts with commas', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 2 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('€1,200.00'));
+  assert.ok(text.includes('€2,450.00'));
+  assert.ok(text.includes('€2,400.00'));
+  assert.ok(text.includes('Total: €4,850.00'));
+});
+
+test('renderInvoiceText with VAT-exempt products', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('1 × Brand workshop (day, VAT exempt) @ €600.00 = €600.00'));
+  assert.ok(text.includes('Total: €600.00'));
+});
+
+test('renderInvoiceText returns multi-line string', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.ok(lines[2].includes('Design work'));
+  assert.ok(lines[3].startsWith('Total:'));
+});
+
+test('renderInvoiceText issued invoice structure', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-06-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2025-0001');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines.length, 5);
+  assert.ok(lines[3].startsWith('100 ×'));
+  assert.ok(lines[4].startsWith('Total:'));
+});
