diff --git a/src/render.js b/src/render.js
new file mode 100644
index 0000000..02f813d
--- /dev/null
+++ b/src/render.js
@@ -0,0 +1,26 @@
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to customers.
+ * All amounts are formatted using formatEuros().
+ * @param {{ number?: string, customerName: string, lines: Array }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  lines.push(invoice.number ?? 'DRAFT');
+  lines.push(invoice.customerName);
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
