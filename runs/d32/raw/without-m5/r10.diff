+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-01-15'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('2025/01/15'), false);
+  assert.equal(isValidDate('15-01-2025'), false);
+  assert.equal(isValidDate('2025-1-15'), false);
+  assert.equal(isValidDate('2025-01-5'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+  assert.equal(isValidDate('2024-02-30'), false);
+});
+
+test('isValidDate rejects non-dates', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('abcd-ef-gh'), false);
+  assert.equal(isValidDate('2025-01-32'), false);
+});
+
+test('isValidDate handles leap years correctly', () => {
+  assert.equal(isValidDate('2020-02-29'), true);
+  assert.equal(isValidDate('2021-02-29'), false);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-01-15', 1), '2025-01-16');
+  assert.equal(addDays('2025-01-15', 5), '2025-01-20');
+  assert.equal(addDays('2025-01-15', 10), '2025-01-25');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+  assert.equal(addDays('2020-02-29', 1), '2020-03-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2025-01-15', -1), '2025-01-14');
+  assert.equal(addDays('2025-01-15', -5), '2025-01-10');
+});
+
+test('addDays handles negative days across boundaries', () => {
+  assert.equal(addDays('2025-02-01', -1), '2025-01-31');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays with zero', () => {
+  assert.equal(addDays('2025-01-15', 0), '2025-01-15');
+});
+
+test('addDays with large numbers', () => {
+  assert.equal(addDays('2025-01-01', 365), '2026-01-01');
+  assert.equal(addDays('2020-01-01', 366), '2021-01-01');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-16'), 1);
+  assert.equal(daysBetween('2025-01-15', '2025-01-20'), 5);
+  assert.equal(daysBetween('2025-01-01', '2025-12-31'), 364);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2025-01-20', '2025-01-15'), -5);
+  assert.equal(daysBetween('2025-12-31', '2025-01-01'), -364);
+});
+
+test('daysBetween with same dates', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-15'), 0);
+});
+
+test('daysBetween across month boundaries', () => {
+  assert.equal(daysBetween('2025-01-31', '2025-02-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2025-02-01'), 31);
+});
+
+test('daysBetween across year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween with leap years', () => {
+  assert.equal(daysBetween('2020-01-01', '2021-01-01'), 366);
+  assert.equal(daysBetween('2019-01-01', '2020-01-01'), 365);
+});
+
+test('daysBetween returns whole days (no rounding)', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-16'), 1);
+  assert.equal(daysBetween('2025-01-15', '2025-01-15'), 0);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const date1 = '2025-01-15';
+  const date2 = addDays(date1, 10);
+  assert.equal(daysBetween(date1, date2), 10);
+  assert.equal(daysBetween(date2, date1), -10);
+});
+
+test('addDays round trip', () => {
+  const date = '2025-06-15';
+  const forward = addDays(date, 100);
+  const back = addDays(forward, -100);
+  assert.equal(back, date);
+});
+
+test('dates use UTC (consistent across time zones)', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  const date = '2025-01-15';
+  const next = addDays(date, 1);
+  assert.equal(next, '2025-01-16');
+});
