+/**
+ * Validate that text is a valid date in YYYY-MM-DD format.
+ * All dates are in UTC.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  return date instanceof Date && !isNaN(date) && date.toISOString().slice(0, 10) === text;
+}
+
+/**
+ * Add n days to a date in YYYY-MM-DD format (UTC).
+ * @param {string} date
+ * @param {number} n
+ * @returns {string}
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().slice(0, 10);
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a).
+ * Dates are in YYYY-MM-DD format (UTC).
+ * @param {string} a
+ * @param {string} b
+ * @returns {number}
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / 86400000);
+}
