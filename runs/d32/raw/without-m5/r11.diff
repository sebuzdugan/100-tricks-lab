+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Record a payment on an issued invoice.
+ * @param {{ status: string, payments?: Array, lines: Array }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: { status: string, payments: Array } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const balance = balanceDue(invoice);
+
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  const payments = invoice.payments ? [...invoice.payments, { amount, date }] : [{ amount, date }];
+
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  const total = invoiceTotals(invoice).total;
+  const newBalance = total - totalPaid;
+
+  let newStatus = 'partially_paid';
+  if (newBalance === 0) {
+    newStatus = 'paid';
+  }
+
+  return ok({
+    ...invoice,
+    payments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array, lines: Array }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const total = invoiceTotals(invoice).total;
+  const totalPaid = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return total - totalPaid;
+}
