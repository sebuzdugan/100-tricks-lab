+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment adds payment to invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = recordPayment(issued, { amount: 50000, date: '2025-01-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2025-01-20');
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = {
+    customerId: 'C-002',
+    customerName: 'Blue Fern Bakery',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 5000, date: '2025-01-20' });
+
+  assert.equal(result.ok, true);
+  assert.ok(Array.isArray(result.value.payments));
+  assert.equal(result.value.payments.length, 1);
+});
+
+test('recordPayment sets status to partially_paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const result = recordPayment(issued, { amount: total - 10000, date: '2025-01-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const result = recordPayment(issued, { amount: total, date: '2025-01-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment allows multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const half = Math.floor(total / 2);
+
+  const result1 = recordPayment(issued, { amount: half, date: '2025-01-20' });
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.status, 'partially_paid');
+
+  const result2 = recordPayment(result1.value, { amount: total - half, date: '2025-01-25' });
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.payments.length, 2);
+  assert.equal(result2.value.status, 'paid');
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2025-01-20' });
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects payment on paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const paid = recordPayment(issued, { amount: total, date: '2025-01-20' }).value;
+
+  const result = recordPayment(paid, { amount: 1000, date: '2025-01-25' });
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects zero amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = recordPayment(issued, { amount: 0, date: '2025-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects negative amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = recordPayment(issued, { amount: -1000, date: '2025-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = recordPayment(issued, { amount: 1000.5, date: '2025-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const result = recordPayment(issued, { amount: total + 1, date: '2025-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment rejects invalid date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = recordPayment(issued, { amount: 50000, date: '2025-13-01' });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('recordPayment does not mutate input invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const invoiceCopy = JSON.parse(JSON.stringify(issued));
+
+  recordPayment(issued, { amount: 50000, date: '2025-01-20' });
+
+  assert.deepEqual(issued, invoiceCopy);
+});
+
+test('balanceDue returns full amount for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const due = balanceDue(issued);
+
+  assert.equal(due, total);
+});
+
+test('balanceDue returns remaining after partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const paid = recordPayment(issued, { amount: 30000, date: '2025-01-20' }).value;
+  const due = balanceDue(paid);
+
+  assert.equal(due, total - 30000);
+});
+
+test('balanceDue returns zero for paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const paid = recordPayment(issued, { amount: total, date: '2025-01-20' }).value;
+  const due = balanceDue(paid);
+
+  assert.equal(due, 0);
+});
+
+test('balanceDue with multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const afterPayment1 = recordPayment(issued, { amount: 30000, date: '2025-01-20' }).value;
+  assert.equal(balanceDue(afterPayment1), total - 30000);
+
+  const afterPayment2 = recordPayment(afterPayment1, { amount: 20000, date: '2025-01-25' }).value;
+  assert.equal(balanceDue(afterPayment2), total - 50000);
+});
+
+test('recordPayment with discount and VAT', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const result = recordPayment(issued, { amount: total, date: '2025-01-20' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+  assert.equal(balanceDue(result.value), 0);
+});
