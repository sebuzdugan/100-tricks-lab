+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('statement lists issued invoices for a customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result = statement('C-001', [issued], '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, issued.number);
+  assert.equal(result.value.invoices[0].issueDate, '2025-01-15');
+  assert.equal(result.value.invoices[0].dueDate, issued.dueDate);
+  assert.equal(result.value.invoices[0].total, invoiceTotals(issued).total);
+  assert.equal(result.value.invoices[0].due, invoiceTotals(issued).total);
+});
+
+test('statement includes multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2025-01-15');
+  assert.equal(result.value.invoices[1].issueDate, '2025-02-15');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+  const issued3 = issueInvoice(inv3, ['INV-2025-0002']).value;
+
+  const result = statement('C-001', [issued1, issued2, issued3], '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].issueDate, '2025-01-15');
+  assert.equal(result.value.invoices[1].issueDate, '2025-02-15');
+  assert.equal(result.value.invoices[2].issueDate, '2025-03-15');
+});
+
+test('statement filters by asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
