+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement with invoices due.
+ * @param {string} customerId
+ * @param {Array} invoices
+ * @param {string} asOf
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  const normalisedCustomerId = normalizeId(customerId);
+
+  const customerResult = getCustomer(normalisedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  const statementInvoices = invoices
+    .filter((inv) => normalizeId(inv.customerId) === normalisedCustomerId)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalisedCustomerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
