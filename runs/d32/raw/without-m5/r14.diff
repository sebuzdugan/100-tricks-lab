+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const total = invoiceTotals(issued).total;
+  const paid = recordPayment(issued, { amount: total, date: '2025-01-20' }).value;
+
+  const result = statement('C-001', [paid], '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement includes partially paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const total = invoiceTotals(issued).total;
