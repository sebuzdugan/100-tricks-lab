+
+test('statement with partial payments reduces totalDue', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const total1 = invoiceTotals(issued1).total;
+  const partial1 = recordPayment(issued1, { amount: Math.floor(total1 / 2), date: '2025-01-20' }).value;
+
+  const result = statement('C-001', [partial1, issued2], '2025-12-31');
+
+  assert.equal(result.ok, true);
+  const expectedTotal = balanceDue(partial1) + invoiceTotals(issued2).total;
+  assert.equal(result.value.totalDue, expectedTotal);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('C-999', [], '2025-12-31');
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement with no matching invoices', () => {
+  const result = statement('C-001', [], '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
