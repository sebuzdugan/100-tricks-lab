diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..7693e73
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,254 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('nextCreditNoteNumber returns first credit note', () => {
+  const result = nextCreditNoteNumber([], '2025-01-15');
+  assert.equal(result, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber increments counter', () => {
+  const existing = ['CN-2025-0001', 'CN-2025-0002'];
+  const result = nextCreditNoteNumber(existing, '2025-06-15');
+  assert.equal(result, 'CN-2025-0003');
+});
+
+test('nextCreditNoteNumber restarts each year', () => {
+  const existing = ['CN-2024-0001', 'CN-2024-0002', 'CN-2025-0001'];
+  const result = nextCreditNoteNumber(existing, '2024-12-31');
+  assert.equal(result, 'CN-2024-0003');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001'];
+  const result = nextCreditNoteNumber(existing, '2025-06-15');
+  assert.equal(result, 'CN-2025-0002');
+});
+
+test('nextCreditNoteNumber handles unordered list', () => {
+  const existing = ['CN-2025-0003', 'CN-2025-0001', 'CN-2025-0002'];
+  const result = nextCreditNoteNumber(existing, '2025-06-15');
+  assert.equal(result, 'CN-2025-0004');
+});
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Discount', date: '2025-01-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+  assert.equal(result.value.invoiceNumber, issued.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 10000);
+  assert.equal(result.value.reason, 'Discount');
+  assert.equal(result.value.date, '2025-01-20');
+});
+
+test('createCreditNote for partially paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const partial = recordPayment(issued, { amount: Math.floor(total / 2), date: '2025-01-20' }).value;
+
+  const result = createCreditNote(partial, { amount: 10000, reason: 'Discount', date: '2025-01-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+  assert.equal(result.value.invoiceNumber, partial.number);
+});
+
+test('createCreditNote for paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const paid = recordPayment(issued, { amount: total, date: '2025-01-20' }).value;
+
+  const result = createCreditNote(paid, { amount: 10000, reason: 'Overpayment', date: '2025-01-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = createCreditNote(invoice, { amount: 10000, reason: 'Discount', date: '2025-01-20' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = createCreditNote(issued, { amount: 0, reason: 'Discount', date: '2025-01-20' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = createCreditNote(issued, { amount: -1000, reason: 'Discount', date: '2025-01-20' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = createCreditNote(issued, { amount: 1000.5, reason: 'Discount', date: '2025-01-20' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects credit too high', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const result = createCreditNote(issued, { amount: total + 1, reason: 'Discount', date: '2025-01-20' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Discount', date: '2025-13-01' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote with full amount credit', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+
+  const result = createCreditNote(issued, { amount: total, reason: 'Full refund', date: '2025-01-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, total);
+});
+
+test('createCreditNote with existing invoice and credit note numbers', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001', 'CN-2025-0002'];
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Discount', date: '2025-01-20' }, existing);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0003');
+});
+
+test('createCreditNote credit note per year', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const existing = ['CN-2024-0001', 'CN-2024-0002', 'CN-2025-0001'];
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Discount', date: '2025-02-20' }, existing);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0002');
+});
+
+test('createCreditNote with different years', () => {
+  const invoice2024 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued2024 = issueInvoice(invoice2024, []).value;
+
+  const existing = ['CN-2024-0001'];
+  const result = createCreditNote(issued2024, { amount: 10000, reason: 'Discount', date: '2024-12-20' }, existing);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote preserves customer and invoice info', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, ['INV-2025-0001']).value;
+
+  const result = createCreditNote(issued, { amount: 50000, reason: 'Service credit', date: '2025-01-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+  assert.equal(result.value.invoiceNumber, issued.number);
+  assert.equal(result.value.reason, 'Service credit');
+});
