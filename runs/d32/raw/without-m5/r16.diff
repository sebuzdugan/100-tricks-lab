+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('overdueInvoices returns empty array for no invoices', () => {
+  const result = overdueInvoices([], '2025-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices identifies single overdue invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = overdueInvoices([issued], '2025-02-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.number);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2025-01-29');
+  assert.equal(result[0].daysOverdue, 17);
+  assert.equal(result[0].due, invoiceTotals(issued).total);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const paid = recordPayment(issued, { amount: total, date: '2025-01-20' }).value;
+
+  const result = overdueInvoices([paid], '2025-02-15');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const result = overdueInvoices([invoice], '2025-02-15');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes partially paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const partial = recordPayment(issued, { amount: Math.floor(total / 2), date: '2025-01-20' }).value;
+
+  const result = overdueInvoices([partial], '2025-02-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, balanceDue(partial));
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2025-03-14');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices due on asOf date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2025-01-29');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoices due before asOf', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2025-01-30');
+
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+  const issued3 = issueInvoice(inv3, ['INV-2025-0002']).value;
+
+  const result = overdueInvoices([issued3, issued1, issued2], '2025-02-20');
+
+  assert.equal(result.length, 3);
+  assert.equal(result[0].daysOverdue, 22);
+  assert.equal(result[1].daysOverdue, 17);
+  assert.equal(result[2].daysOverdue, 5);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2025-02-10');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 12);
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const result = overdueInvoices([issued1, issued2], '2025-02-15');
+
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-002');
+  assert.equal(result[1].customerId, 'C-001');
+});
+
+test('overdueInvoices includes invoice details', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2025-02-15');
+
+  assert.equal(result.length, 1);
+  assert.ok(result[0].number);
+  assert.ok(result[0].customerId);
+  assert.ok(result[0].dueDate);
+  assert.ok(typeof result[0].daysOverdue === 'number');
+  assert.ok(typeof result[0].due === 'number');
+});
+
+test('overdueInvoices with different terms', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'EOM',
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const result = overdueInvoices([issued1, issued2], '2025-02-15');
+
+  assert.equal(result.length, 2);
+  assert.ok(result[0].daysOverdue > result[1].daysOverdue);
+});
+
+test('overdueInvoices with partial payment reduces due amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const total = invoiceTotals(issued).total;
+  const partial = recordPayment(issued, { amount: 30000, date: '2025-01-20' }).value;
+
+  const result = overdueInvoices([partial], '2025-02-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, total - 30000);
+});
+
+test('overdueInvoices is empty with no overdue invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2025-02-10');
+
+  assert.equal(result.length, 0);
+});
