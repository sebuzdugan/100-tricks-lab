+/**
+ * Get VAT summary by rate for issued, partially paid, or paid invoices.
+ * @param {Array} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const summary = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVat(line);
+
+        if (!summary[rate]) {
+          summary[rate] = { rate, base: 0, vat: 0 };
+        }
+
+        summary[rate].base += base;
+        summary[rate].vat += vat;
+      });
+    });
+
+  return Object.values(summary).sort((a, b) => b.rate - a.rate);
+}
