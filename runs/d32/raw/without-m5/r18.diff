+/**
+ * Calculate late fee for an overdue invoice.
+ * Late fee is 0.04% per day of the amount still owed.
+ * @param {{ dueDate: string }} invoice
+ * @param {string} asOf
+ * @returns {number}
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) return 0;
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = due * daysOverdue * 0.0004;
+
+  return roundCents(fee);
+}
