+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format an amount in cents as a decimal string with 2 decimals.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatAmount(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Escape a CSV field: wrap in quotes if it contains comma, newline, or quote.
+ * Double any quotes inside the field.
+ * @param {string} value
+ * @returns {string}
+ */
+function escapeField(value) {
+  if (value.includes(',') || value.includes('\n') || value.includes('"')) {
+    return '"' + value.replace(/"/g, '""') + '"';
+  }
+  return value;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ number: string, customerId: string, customerName: string, issueDate: string, dueDate: string, status: string, lines: Array }>} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  for (const invoice of invoices) {
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const row = [
+      String(invoice.number),
+      String(invoice.customerName),
+      String(invoice.issueDate),
+      String(invoice.dueDate),
+      String(invoice.status),
+      formatAmount(totals.subtotal),
+      formatAmount(totals.discount),
+      formatAmount(totals.vat),
+      formatAmount(totals.total),
+      formatAmount(due),
+    ];
+
+    const escapedRow = row.map(escapeField).join(',');
+    lines.push(escapedRow);
+  }
+
+  return lines.join('\n') + '\n';
+}
