+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header and footer with newlines', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n').filter(l => l);
+  assert.equal(lines.length, 2);
+  assert.ok(lines[1].includes(issued.number));
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv exports multiple invoices in order', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, [issued1.number]).value;
+
+  const result = exportCsv([issued1, issued2]);
+  const lines = result.split('\n').filter(l => l);
+
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].includes(issued1.number));
+  assert.ok(lines[2].includes(issued2.number));
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n').filter(l => l);
+  const row = lines[1];
+
+  const expected = `${issued.number},Northwind Studio,2025-01-15,2025-02-14,issued,${(totals.subtotal / 100).toFixed(2)},${(totals.discount / 100).toFixed(2)},${(totals.vat / 100).toFixed(2)},${(totals.total / 100).toFixed(2)}`;
+  assert.ok(row.includes(expected.slice(0, 50)));
+});
+
+test('exportCsv escapes customer names with commas', () => {
+  const invoice = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+  const lines = result.split('\n').filter(l => l);
+  const row = lines[1];
+
+  assert.ok(row.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer names with quotes', () => {
+  const invoice = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+  const lines = result.split('\n').filter(l => l);
+  const row = lines[1];
+
+  assert.ok(row.includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv includes customer name from invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  assert.ok(result.includes('Northwind Studio'));
+});
+
+test('exportCsv shows due amount for unpaid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n').filter(l => l);
+  const row = lines[1];
+
+  const dueAmount = (totals.total / 100).toFixed(2);
+  assert.ok(row.includes(dueAmount));
+  assert.ok(row.endsWith(dueAmount));
+});
+
+test('exportCsv shows reduced due for partially paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const partial = recordPayment(issued, { amount: Math.floor(totals.total / 2), date: '2025-01-20' }).value;
+
+  const result = exportCsv([partial]);
+  const lines = result.split('\n').filter(l => l);
+  const row = lines[1];
+
+  const dueAmount = ((totals.total - Math.floor(totals.total / 2)) / 100).toFixed(2);
+  assert.ok(row.endsWith(dueAmount));
+});
+
+test('exportCsv with draft and issued invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const result = exportCsv([issued]);
+
+  assert.ok(result.includes('issued'));
+  assert.ok(!result.includes('draft'));
+});
+
+test('exportCsv shows issued invoice status', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  assert.ok(result.includes('issued'));
+});
+
+test('exportCsv shows paid invoice status', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2025-01-20' }).value;
+
+  const result = exportCsv([paid]);
+  assert.ok(result.includes('paid'));
+});
+
+test('exportCsv includes invoice number from issue', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  assert.ok(result.includes('INV-2025-0001'));
+});
+
+test('exportCsv includes correct dates', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  assert.ok(result.includes('2025-01-15'));
+  assert.ok(result.includes('2025-02-14'));
+});
+
+test('exportCsv with VAT-exempt lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n').filter(l => l);
+  const row = lines[1];
+  assert.ok(row.includes('0.00'));
+});
+
+test('exportCsv with discounted lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n').filter(l => l);
+  const row = lines[1];
+
+  assert.ok(row.includes((totals.discount / 100).toFixed(2)));
+});
+
+test('exportCsv ends with single newline', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  assert.ok(result.endsWith('\n'));
+  const lines = result.split('\n').filter(l => l);
+  assert.equal(lines.length, 2);
+});
+
+test('exportCsv with multiple rows maintains format', () => {
+  const invoices = [];
+  for (let i = 0; i < 3; i++) {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: [{ sku: 'DES-HOUR', qty: i + 1 }],
+    }).value;
+    invoices.push(issueInvoice(inv, invoices.map(x => x.number)).value);
+  }
+
+  const result = exportCsv(invoices);
+  const lines = result.split('\n').filter(l => l);
+
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  for (let i = 1; i < 4; i++) {
+    assert.ok(lines[i].includes(`INV-2025-000${i}`));
+  }
+});
