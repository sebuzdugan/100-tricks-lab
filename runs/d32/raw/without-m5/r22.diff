@@ -0,0 +1,270 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty and unitPrice', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with single item', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal with zero unitPrice', () => {
+  const line = { qty: 10, unitPrice: 0 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineDiscount calculates percentage discount', () => {
+  const line = { qty: 5, unitPrice: 1000, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 500);
+});
+
+test('lineDiscount with no discount', () => {
+  const line = { qty: 5, unitPrice: 1000, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount defaults to 0% when not specified', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 5, unitPrice: 1000, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 5000);
+});
+
+test('lineDiscount with fractional result rounds', () => {
+  const line = { qty: 3, unitPrice: 100, discountPercent: 33 };
+  const result = lineDiscount(line);
+  assert.ok(Number.isInteger(result));
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 21 };
+  const result = lineVat(line);
+  assert.equal(result, 2100);
+});
+
+test('lineVat with discount reduces base', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 50, vatRate: 21 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const expected = Math.round((total - discount) * 0.21);
+  const result = lineVat(line);
+  assert.equal(result, expected);
+});
+
+test('lineVat with VAT-exempt (0%)', () => {
+  const line = { qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with 9% VAT rate', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 9 };
+  assert.equal(lineVat(line), 900);
+});
+
+test('invoiceTotals single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 5000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 1050);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 6050);
+});
+
+test('invoiceTotals multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+      { qty: 2, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 15000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 3150);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 18150);
+});
+
+test('invoiceTotals with line discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 1000);
+  assert.equal(result.vat, 1890);
+  assert.equal(result.total, 10890);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 500 },
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 5000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 1050);
+  assert.equal(result.voucher, 500);
+  assert.equal(result.total, 5550);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 9 },
+      { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 30000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 3000);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 33000);
+});
+
+test('invoiceTotals with no lines', () => {
+  const invoice = { lines: [] };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 0);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals clamps total at zero', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 },
+    ],
+    voucher: { code: 'BIG', amount: 1000 },
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with tier discount applied as line discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  const subtotal = 10000;
+  const discount = 500;
+  const base = subtotal - discount;
+  const vat = Math.round(base * 0.21);
+
+  assert.equal(result.subtotal, subtotal);
+  assert.equal(result.discount, discount);
+  assert.equal(result.vat, vat);
+  assert.equal(result.total, subtotal - discount + vat);
+});
+
+test('invoiceTotals preserves integer cents throughout', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 123, discountPercent: 17, vatRate: 21 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.ok(Number.isInteger(result.subtotal));
+  assert.ok(Number.isInteger(result.discount));
+  assert.ok(Number.isInteger(result.vat));
+  assert.ok(Number.isInteger(result.total));
+});
+
+test('invoiceTotals with only VAT-exempt lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 0 },
+      { qty: 5, unitPrice: 200, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 2000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.total, 2000);
+});
+
+test('invoiceTotals with discount and voucher both applied', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 21 },
+    ],
+    voucher: { code: 'EXTRA', amount: 200 },
+  };
+
+  const result = invoiceTotals(invoice);
+
+  const subtotal = 10000;
+  const lineDisc = 1000;
+  const base = subtotal - lineDisc;
+  const vat = Math.round(base * 0.21);
+  const total = subtotal - lineDisc + vat - 200;
+
+  assert.equal(result.subtotal, subtotal);
+  assert.equal(result.discount, lineDisc);
+  assert.equal(result.vat, vat);
+  assert.equal(result.voucher, 200);
+  assert.equal(result.total, total);
+});
+
+test('lineVat without discountPercent property', () => {
+  const line = { qty: 100, unitPrice: 100, vatRate: 21 };
+  const result = lineVat(line);
+  assert.equal(result, 2100);
+});
+
+test('invoiceTotals without voucher property', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 6050);
+});
