diff --git a/src/totals.js b/src/totals.js
index 5bde339..6354b49 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -11,13 +11,23 @@ export function lineTotal(line) {
 
 /**
  * Calculate the discount amount of a single line item.
+ * Includes base discount and bulk discount (2.5% for 10+ units).
+ * Bulk discount is applied after the base discount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
   const total = lineTotal(line);
   const discountPercent = line.discountPercent ?? 0;
-  return roundCents(total * discountPercent / 100);
+  const baseDiscount = roundCents(total * discountPercent / 100);
+  const amountAfterBaseDiscount = total - baseDiscount;
+
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    bulkDiscount = roundCents(amountAfterBaseDiscount * 0.025);
+  }
+
+  return baseDiscount + bulkDiscount;
 }
 
 /**
