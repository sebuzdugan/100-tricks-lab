+++ b/src/numbering.js
@@ -0,0 +1,23 @@
+/**
+ * Calculate the next invoice number for a given year.
+ * @param {string[]} existingNumbers - Array of existing invoice numbers (e.g., ["INV-2026-0001", "INV-2026-0002"])
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - The next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return Number(counter);
+    })
+    .filter((num) => !isNaN(num) && num > 0)
+    .sort((a, b) => a - b);
+
+  const nextCounter = (thisYearNumbers.length > 0 ? Math.max(...thisYearNumbers) : 0) + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
