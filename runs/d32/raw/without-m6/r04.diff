+
+test('issueInvoice does not mutate the input invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const invoiceCopy = JSON.parse(JSON.stringify(r1.value));
+
+  issueInvoice(r1.value, []);
+
+  assert.deepEqual(r1.value, invoiceCopy);
+});
+
+test('issueInvoice does not mutate line objects', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const originalLine = r1.value.lines[0];
+  const originalLineCopy = JSON.parse(JSON.stringify(originalLine));
+
+  const r2 = issueInvoice(r1.value, []);
+
+  assert.deepEqual(originalLine, originalLineCopy);
+  assert.notEqual(r2.value.lines[0], originalLine);
+});
diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..8a001b7
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,74 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber returns 0002 when 0001 exists', () => {
+  const number = nextInvoiceNumber(['INV-2026-0001'], '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber skips the highest counter', () => {
+  const number = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'], '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores invoices from other years', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2025-0001', 'INV-2025-0002', 'INV-2026-0001'],
+    '2026-10-07'
+  );
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber works when numbers are not in order', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'],
+    '2026-10-07'
+  );
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber pads to 4 digits', () => {
+  const existing = Array.from({ length: 10 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber handles transitions between years', () => {
+  const existing = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2026-0001',
+    'INV-2026-0002',
+  ];
+  const number2026 = nextInvoiceNumber(existing, '2026-10-07');
+  const number2027 = nextInvoiceNumber(existing, '2027-01-01');
+
+  assert.equal(number2026, 'INV-2026-0003');
+  assert.equal(number2027, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = [
+    'INV-2026-0001',
+    'INV-2026-INVALID',
+    'INV-2026-0002',
+    'NOTINVOICE-2026-0003',
+  ];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber uses the year from issueDate', () => {
+  const existing = ['INV-2026-0001'];
+  const number2026 = nextInvoiceNumber(existing, '2026-12-31');
+  const number2027 = nextInvoiceNumber(existing, '2027-01-01');
+
+  assert.equal(number2026, 'INV-2026-0002');
+  assert.equal(number2027, 'INV-2027-0001');
+});
