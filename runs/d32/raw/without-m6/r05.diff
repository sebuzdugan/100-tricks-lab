+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const numberLine = invoice.number || 'DRAFT';
+
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  const lineItems = invoice.lines
+    .map((line) => {
+      const total = lineTotal(line);
+      return `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    })
+    .join('\n');
+
+  const totals = invoiceTotals(invoice);
+  const totalLine = `Total: ${formatEuros(totals.total)}`;
+
+  return [numberLine, customerName, lineItems, totalLine].join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..61320ad
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,174 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for a draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows the invoice number for an issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const text = renderInvoiceText(r2.value);
+
+  assert.ok(text.startsWith('INV-2026-0001'));
+});
+
+test('renderInvoiceText shows the customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows line items with qty, name, unit price and total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '10 x Development (hour) @ €95.00 = €950.00');
+});
+
+test('renderInvoiceText formats amounts as euros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+
+  assert.ok(text.includes('€1,200.00'));
+  assert.ok(text.includes('€2,400.00'));
+});
+
+test('renderInvoiceText shows multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '10 x Development (hour) @ €95.00 = €950.00');
+  assert.equal(lines[3], '5 x Design work (hour) @ €85.00 = €425.00');
+});
+
+test('renderInvoiceText shows the correct total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lastLine = text.split('\n').pop();
+
+  assert.equal(lastLine, 'Total: €1,375.00');
+});
+
+test('renderInvoiceText works with a single line item', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert.ok(lines[0].startsWith('DRAFT'));
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '1 x Brand guidelines document @ €2,450.00 = €2,450.00');
+  assert.equal(lines[3], 'Total: €2,450.00');
+});
+
+test('renderInvoiceText shows Unknown Customer if customer not found', () => {
+  const fakeInvoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ qty: 1, name: 'Test', unitPrice: 1000 }],
+  };
+
+  const text = renderInvoiceText(fakeInvoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Unknown Customer');
+});
+
+test('renderInvoiceText formats a complete issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+
+  const r2 = issueInvoice(r1.value, ['INV-2026-0001']);
+
+  const text = renderInvoiceText(r2.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0002');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '8 x Development (hour) @ €95.00 = €760.00');
+  assert.equal(lines[3], '3 x Design work (hour) @ €85.00 = €255.00');
+  assert.equal(lines[4], 'Total: €1,015.00');
+});
+
+test('renderInvoiceText handles three line items', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 6);
+  assert.equal(lines[2], '5 x Development (hour) @ €95.00 = €475.00');
+  assert.equal(lines[3], '2 x Design work (hour) @ €85.00 = €170.00');
+  assert.equal(lines[4], '3 x Copywriting (hour) @ €60.00 = €180.00');
+  assert.equal(lines[5], 'Total: €825.00');
+});
