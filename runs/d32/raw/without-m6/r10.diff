+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const dateMatch = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(text));
+  if (!dateMatch) {
+    return false;
+  }
+
+  const [, yearStr, monthStr, dayStr] = dateMatch;
+  const year = Number(yearStr);
+  const month = Number(monthStr);
+  const day = Number(dayStr);
+
+  if (month < 1 || month > 12 || day < 1 || day > 31) {
+    return false;
+  }
+
+  const date = new Date(Date.UTC(year, month - 1, day));
+  return (
+    date.getUTCFullYear() === year &&
+    date.getUTCMonth() + 1 === month &&
+    date.getUTCDate() === day
+  );
+}
+
+/**
+ * Parse a YYYY-MM-DD date string into a Date object (UTC).
+ * Assumes the input is already validated with isValidDate.
+ * @param {string} text
+ * @returns {Date}
+ */
+function parseDate(text) {
+  const [year, month, day] = text.split('-').map(Number);
+  return new Date(Date.UTC(year, month - 1, day));
+}
+
+/**
+ * Format a Date object as a YYYY-MM-DD string (UTC).
+ * @param {Date} date
+ * @returns {string}
+ */
+function formatDate(date) {
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Add n days to a date string, using UTC.
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - Date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const date = parseDate(dateStr);
+  date.setUTCDate(date.getUTCDate() + n);
+  return formatDate(date);
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a), using UTC.
+ * @param {string} a - Start date in YYYY-MM-DD format
+ * @param {string} b - End date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = parseDate(a);
+  const dateB = parseDate(b);
+  const millisecondsPerDay = 24 * 60 * 60 * 1000;
+  return Math.round((dateB - dateA) / millisecondsPerDay);
+}
