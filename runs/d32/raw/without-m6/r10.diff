diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..939a63c
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,99 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2020-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('20261007'), false);
+});
+
+test('isValidDate rejects invalid months', () => {
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+});
+
+test('isValidDate rejects invalid days', () => {
+  assert.equal(isValidDate('2026-01-00'), false);
+  assert.equal(isValidDate('2026-01-32'), false);
+});
+
+test('isValidDate rejects invalid calendar dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2026-06-31'), false);
+});
+
+test('isValidDate accepts leap year February 29', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year February 29', () => {
+  assert.equal(isValidDate('2026-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+});
+
+test('addDays adds negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+});
+
+test('addDays with zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays crosses month boundaries forward', () => {
+  assert.equal(addDays('2026-10-28', 5), '2026-11-02');
+  assert.equal(addDays('2026-01-28', 5), '2026-02-02');
+});
+
+test('addDays crosses month boundaries backward', () => {
+  assert.equal(addDays('2026-10-05', -10), '2026-09-25');
+  assert.equal(addDays('2026-03-05', -10), '2026-02-23');
+});
+
+test('addDays crosses year boundaries forward', () => {
+  assert.equal(addDays('2026-12-28', 10), '2027-01-07');
+});
+
+test('addDays crosses year boundaries backward', () => {
+  assert.equal(addDays('2027-01-07', -10), '2026-12-28');
+});
+
+test('daysBetween same day returns 0', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+});
+
+test('daysBetween negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+});
+
+test('daysBetween across month boundaries', () => {
+  assert.equal(daysBetween('2026-10-28', '2026-11-02'), 5);
+  assert.equal(daysBetween('2026-11-02', '2026-10-28'), -5);
+});
+
+test('daysBetween across year boundaries', () => {
+  assert.equal(daysBetween('2026-12-28', '2027-01-07'), 10);
+  assert.equal(daysBetween('2027-01-07', '2026-12-28'), -10);
+});
+
+test('daysBetween large differences', () => {
+  assert.equal(daysBetween('2020-01-01', '2026-10-07'), 2471);
+});
