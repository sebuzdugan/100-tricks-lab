+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('recordPayment on issued invoice creates payments array', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+
+  assert.equal(r3.ok, true);
+  assert.ok(Array.isArray(r3.value.payments));
+  assert.equal(r3.value.payments.length, 1);
+  assert.equal(r3.value.payments[0].amount, 50000);
+  assert.equal(r3.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment sets status to partially_paid when balance remains', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+
+  assert.equal(r3.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when balance becomes zero', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totalDue = r2.value.lines.reduce((sum, line) => {
+    const lineTotal = line.qty * line.unitPrice;
+    const discount = lineTotal * (line.discountPercent || 0) / 100;
+    const afterDiscount = lineTotal - discount;
+    const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+    return sum + lineTotal - discount + vat;
+  }, 0);
+
+  const r3 = recordPayment(r2.value, { amount: totalDue, date: '2026-10-10' });
+
+  assert.equal(r3.value.status, 'paid');
+});
+
+test('recordPayment rejects draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.deepEqual(
+    recordPayment(r1.value, { amount: 50000, date: '2026-10-10' }),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('recordPayment rejects paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totalDue = r2.value.lines.reduce((sum, line) => {
+    const lineTotal = line.qty * line.unitPrice;
+    const discount = lineTotal * (line.discountPercent || 0) / 100;
+    const afterDiscount = lineTotal - discount;
+    const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+    return sum + lineTotal - discount + vat;
+  }, 0);
+
+  const r3 = recordPayment(r2.value, { amount: totalDue, date: '2026-10-10' });
+  const paidInvoice = r3.value;
+
+  assert.deepEqual(
+    recordPayment(paidInvoice, { amount: 1000, date: '2026-10-11' }),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('recordPayment rejects zero amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  assert.deepEqual(
+    recordPayment(r2.value, { amount: 0, date: '2026-10-10' }),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('recordPayment rejects negative amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  assert.deepEqual(
+    recordPayment(r2.value, { amount: -1000, date: '2026-10-10' }),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('recordPayment rejects fractional amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  assert.deepEqual(
+    recordPayment(r2.value, { amount: 1000.5, date: '2026-10-10' }),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('recordPayment rejects overpayment', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totalDue = r2.value.lines.reduce((sum, line) => {
+    const lineTotal = line.qty * line.unitPrice;
+    const discount = lineTotal * (line.discountPercent || 0) / 100;
+    const afterDiscount = lineTotal - discount;
+    const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+    return sum + lineTotal - discount + vat;
+  }, 0);
+
+  assert.deepEqual(
+    recordPayment(r2.value, { amount: totalDue + 1000, date: '2026-10-10' }),
+    { ok: false, error: 'OVERPAYMENT' }
+  );
+});
+
+test('recordPayment rejects invalid date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  assert.deepEqual(
+    recordPayment(r2.value, { amount: 50000, date: '2026-13-01' }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('recordPayment allows multiple payments', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+  const r4 = recordPayment(r3.value, { amount: 50000, date: '2026-10-15' });
+
+  assert.equal(r4.value.payments.length, 2);
+  assert.equal(r4.value.payments[0].amount, 50000);
+  assert.equal(r4.value.payments[1].amount, 50000);
+});
+
+test('recordPayment does not mutate input invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const invoiceCopy = JSON.parse(JSON.stringify(r2.value));
+
+  recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+
+  assert.deepEqual(r2.value, invoiceCopy);
+});
+
+test('balanceDue on issued invoice with no payments', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const balance = balanceDue(r2.value);
+
+  assert.equal(balance, r2.value.lines.reduce((sum, line) => {
+    const lineTotal = line.qty * line.unitPrice;
+    const discount = lineTotal * (line.discountPercent || 0) / 100;
+    const afterDiscount = lineTotal - discount;
+    const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+    return sum + lineTotal - discount + vat;
+  }, 0));
+});
+
+test('balanceDue with partial payment', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+  const balance = balanceDue(r3.value);
+
+  assert.ok(balance > 0);
+  assert.equal(
+    balance,
+    r3.value.lines.reduce((sum, line) => {
+      const lineTotal = line.qty * line.unitPrice;
+      const discount = lineTotal * (line.discountPercent || 0) / 100;
+      const afterDiscount = lineTotal - discount;
+      const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+      return sum + lineTotal - discount + vat;
+    }, 0) - 50000
+  );
+});
+
+test('balanceDue with full payment', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totalDue = r2.value.lines.reduce((sum, line) => {
+    const lineTotal = line.qty * line.unitPrice;
+    const discount = lineTotal * (line.discountPercent || 0) / 100;
+    const afterDiscount = lineTotal - discount;
+    const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+    return sum + lineTotal - discount + vat;
+  }, 0);
+
+  const r3 = recordPayment(r2.value, { amount: totalDue, date: '2026-10-10' });
+  const balance = balanceDue(r3.value);
+
+  assert.equal(balance, 0);
+});
+
+test('balanceDue with multiple payments', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+  const r4 = recordPayment(r3.value, { amount: 30000, date: '2026-10-15' });
+  const balance = balanceDue(r4.value);
+
+  assert.ok(balance > 0);
+  assert.equal(
+    balance,
+    r4.value.lines.reduce((sum, line) => {
+      const lineTotal = line.qty * line.unitPrice;
+      const discount = lineTotal * (line.discountPercent || 0) / 100;
+      const afterDiscount = lineTotal - discount;
+      const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+      return sum + lineTotal - discount + vat;
+    }, 0) - 80000
+  );
+});
