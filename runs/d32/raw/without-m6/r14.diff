+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement for customer with no invoices', () => {
+  const r = statement('C-001', [], '2026-10-31');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement for customer with one issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const invoices = [r2.value];
+
+  const r3 = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.invoices.length, 1);
+  assert.equal(r3.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(r3.value.invoices[0].issueDate, '2026-10-07');
+  assert.ok(r3.value.invoices[0].total > 0);
+  assert.equal(r3.value.invoices[0].due, r3.value.invoices[0].total);
+  assert.equal(r3.value.totalDue, r3.value.invoices[0].total);
+});
+
+test('statement filters out draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const invoices = [r1.value];
+
+  const r2 = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices.length, 0);
+  assert.equal(r2.value.totalDue, 0);
+});
+
+test('statement filters out paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totalDue = r2.value.lines.reduce((sum, line) => {
+    const lineTotal = line.qty * line.unitPrice;
+    const discount = lineTotal * (line.discountPercent || 0) / 100;
+    const afterDiscount = lineTotal - discount;
+    const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+    return sum + lineTotal - discount + vat;
+  }, 0);
+
+  const r3 = recordPayment(r2.value, { amount: totalDue, date: '2026-10-10' });
+  const invoices = [r3.value];
+
+  const r4 = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.invoices.length, 0);
+  assert.equal(r4.value.totalDue, 0);
+});
+
+test('statement includes partially paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+  const invoices = [r3.value];
+
+  const r4 = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.invoices.length, 1);
+  assert.ok(r4.value.invoices[0].due > 0);
+  assert.ok(r4.value.invoices[0].due < r4.value.invoices[0].total);
+});
+
+test('statement filters by issueDate <= asOf', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const invoices = [r2.value];
+
+  const r3 = statement('C-001', invoices, '2026-10-06');
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.invoices.length, 0);
+});
+
+test('statement includes invoices with issueDate equal to asOf', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const invoices = [r2.value];
+
+  const r3 = statement('C-001', invoices, '2026-10-07');
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.invoices.length, 1);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const invoices = [r2.value, r4.value];
+
+  const r5 = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(r5.ok, true);
+  assert.equal(r5.value.invoices.length, 2);
+  assert.equal(r5.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r5.value.invoices[1].issueDate, '2026-10-15');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const invoices = [r2.value, r4.value];
+
+  const r5 = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(r5.ok, true);
+  const sumOfDue = r5.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(r5.value.totalDue, sumOfDue);
+});
+
+test('statement for unknown customer', () => {
+  const r = statement('C-999', [], '2026-10-31');
+
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement normalizes customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const invoices = [r2.value];
+
+  const r3 = statement('  c-001  ', invoices, '2026-10-31');
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.customerId, 'C-001');
+  assert.equal(r3.value.invoices.length, 1);
+});
+
+test('statement filters by customer', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const invoices = [r2.value, r4.value];
+
+  const r5 = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(r5.ok, true);
+  assert.equal(r5.value.invoices.length, 1);
+  assert.equal(r5.value.invoices[0].number, 'INV-2026-0001');
+});
