+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the next credit note number for a given year.
+ * Credit notes have their own counter, separate from invoices.
+ * @param {string[]} existingNumbers - Array of existing invoice and credit note numbers
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - The next credit note number
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `CN-${year}-`;
+
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return Number(counter);
+    })
+    .filter((num) => !isNaN(num) && num > 0)
+    .sort((a, b) => a - b);
+
+  const nextCounter = (thisYearNumbers.length > 0 ? Math.max(...thisYearNumbers) : 0) + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string }} invoice
+ * @param {{ amount: number, reason: string, date: string }} options
+ * @param {string[]} existingNumbers - Array of existing invoice and credit note numbers
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
