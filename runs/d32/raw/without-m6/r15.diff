+++ b/test/credits.test.js
@@ -0,0 +1,207 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote on issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 50000, reason: 'Discount', date: '2026-10-10' }, ['INV-2026-0001']);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0001');
+  assert.equal(r3.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r3.value.customerId, 'C-001');
+  assert.equal(r3.value.amount, 50000);
+  assert.equal(r3.value.reason, 'Discount');
+  assert.equal(r3.value.date, '2026-10-10');
+});
+
+test('createCreditNote on partially paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-08' });
+  const r4 = createCreditNote(r3.value, { amount: 30000, reason: 'Partial refund', date: '2026-10-10' }, ['INV-2026-0001']);
+
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote on paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totalDue = invoiceTotals(r2.value).total;
+  const r3 = recordPayment(r2.value, { amount: totalDue, date: '2026-10-08' });
+  const r4 = createCreditNote(r3.value, { amount: 50000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']);
+
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.deepEqual(
+    createCreditNote(r1.value, { amount: 50000, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  assert.deepEqual(
+    createCreditNote(r2.value, { amount: 0, reason: 'Test', date: '2026-10-10' }, ['INV-2026-0001']),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  assert.deepEqual(
+    createCreditNote(r2.value, { amount: -1000, reason: 'Test', date: '2026-10-10' }, ['INV-2026-0001']),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects fractional amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  assert.deepEqual(
+    createCreditNote(r2.value, { amount: 50000.5, reason: 'Test', date: '2026-10-10' }, ['INV-2026-0001']),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const total = invoiceTotals(r2.value).total;
+
+  assert.deepEqual(
+    createCreditNote(r2.value, { amount: total + 100000, reason: 'Too much', date: '2026-10-10' }, ['INV-2026-0001']),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  assert.deepEqual(
+    createCreditNote(r2.value, { amount: 50000, reason: 'Test', date: '2026-13-01' }, ['INV-2026-0001']),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createCreditNote uses separate counter from invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 50000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']);
+
+  assert.equal(r3.value.number, 'CN-2026-0001');
+  assert.equal(r3.value.invoiceNumber, 'INV-2026-0001');
+});
+
+test('createCreditNote increments counter separately', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 50000, reason: 'Refund 1', date: '2026-10-10' }, ['INV-2026-0001', 'CN-2026-0001']);
+
+  assert.equal(r3.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 50000, reason: 'Refund', date: '2027-01-15' }, ['INV-2026-0001', 'CN-2026-0005']);
+
+  assert.equal(r3.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote with multiple invoices and credits', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const r5 = createCreditNote(r2.value, { amount: 50000, reason: 'Refund 1', date: '2026-10-10' }, ['INV-2026-0001', 'INV-2026-0002']);
+  const r6 = createCreditNote(r4.value, { amount: 30000, reason: 'Refund 2', date: '2026-10-16' }, ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001']);
+
+  assert.equal(r5.value.number, 'CN-2026-0001');
+  assert.equal(r6.value.number, 'CN-2026-0002');
+});
