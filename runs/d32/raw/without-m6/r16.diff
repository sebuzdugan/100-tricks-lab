+++ b/src/reports.js
@@ -0,0 +1,22 @@
+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Get all overdue invoices as of a given date.
+ * @param {Array} invoices - Array of all invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => daysBetween(inv.dueDate, asOf) > 0)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
diff --git a/test/reports.test.js b/test/reports.test.js
new file mode 100644
index 0000000..5e181b0
--- /dev/null
+++ b/test/reports.test.js
@@ -0,0 +1,191 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty list when no invoices', () => {
+  const result = overdueInvoices([], '2026-10-31');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices returns empty list when no overdue invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = overdueInvoices([r2.value], '2026-11-05');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices returns single overdue invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = overdueInvoices([r2.value], '2026-11-07');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-11-06');
+  assert.equal(result[0].daysOverdue, 1);
+  assert.ok(result[0].due > 0);
+});
+
+test('overdueInvoices filters out draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = overdueInvoices([r1.value], '2026-11-07');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices filters out paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totalDue = r2.value.lines.reduce((sum, line) => {
+    const lineTotal = line.qty * line.unitPrice;
+    const discount = lineTotal * (line.discountPercent || 0) / 100;
+    const afterDiscount = lineTotal - discount;
+    const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+    return sum + lineTotal - discount + vat;
+  }, 0);
+
+  const r3 = recordPayment(r2.value, { amount: totalDue, date: '2026-10-10' });
+  const result = overdueInvoices([r3.value], '2026-11-07');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes partially paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+  const result = overdueInvoices([r3.value], '2026-11-07');
+
+  assert.equal(result.length, 1);
+  assert.ok(result[0].due > 0);
+});
+
+test('overdueInvoices sorts most overdue first', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const invoices = [r2.value, r4.value];
+
+  const result = overdueInvoices(invoices, '2026-11-07');
+
+  assert.equal(result.length, 2);
+  assert.equal(result[0].dueDate, '2026-10-29');
+  assert.equal(result[1].dueDate, '2026-11-06');
+  assert.ok(result[0].daysOverdue > result[1].daysOverdue);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'EOM',
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = overdueInvoices([r2.value], '2026-11-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2026-10-31');
+  assert.equal(result[0].daysOverdue, 15);
+});
+
+test('overdueInvoices handles multiple overdue invoices', () => {
+  const invoices = [];
+
+  for (let i = 1; i <= 5; i++) {
+    const r1 = createInvoice({
+      customerId: 'C-001',
+      issueDate: `2026-09-${String(i).padStart(2, '0')}`,
+      lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+      terms: 'NET30',
+    });
+
+    const r2 = issueInvoice(r1.value, invoices.map((inv) => inv.number || ''));
+    invoices.push(r2.value);
+  }
+
+  const result = overdueInvoices(invoices, '2026-10-31');
+
+  assert.equal(result.length, 5);
+  for (let i = 0; i < result.length - 1; i++) {
+    assert.ok(result[i].daysOverdue >= result[i + 1].daysOverdue);
+  }
+});
+
+test('overdueInvoices on exact due date is not overdue', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = overdueInvoices([r2.value], '2026-11-06');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices day after due date is overdue', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = overdueInvoices([r2.value], '2026-11-07');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 1);
+});
