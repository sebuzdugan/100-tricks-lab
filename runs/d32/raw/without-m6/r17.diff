+/**
+ * Get a summary of VAT collected by rate.
+ * @param {Array} invoices - Array of all invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate || 0;
+        const lineTotal = line.qty * line.unitPrice;
+        const discountPercent = line.discountPercent ?? 0;
+        const discount = roundCents(lineTotal * discountPercent / 100);
+        const base = lineTotal - discount;
+        const vat = roundCents(base * rate / 100);
+
+        if (!vatMap[rate]) {
+          vatMap[rate] = { base: 0, vat: 0 };
+        }
+        vatMap[rate].base += base;
+        vatMap[rate].vat += vat;
+      });
+    });
+
+  return Object.entries(vatMap)
+    .map(([rate, { base, vat }]) => ({
+      rate: Number(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
