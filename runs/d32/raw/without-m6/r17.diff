+test('vatSummary includes paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totals = r2.value.lines.reduce((sum, line) => {
+    const lineTotal = line.qty * line.unitPrice;
