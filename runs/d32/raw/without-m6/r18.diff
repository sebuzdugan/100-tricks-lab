+/**
+ * Calculate late fees for an invoice.
+ * @param {{ status: string, dueDate?: string, payments?: Array }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents, 0.04% per day for each day overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.status === 'draft' || !invoice.dueDate) {
+    return 0;
+  }
+
+  if (!isValidDate(asOf)) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  if (due <= 0) {
+    return 0;
+  }
+
+  return roundCents(due * 0.04 / 100 * daysOverdue);
+}
