+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function formatEuros(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+function escapeCsvField(field) {
+  const str = String(field);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV format.
+ * @param {Array} invoices - Array of invoices to export
+ * @returns {string} CSV string with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map((inv) => {
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const fields = [
+      inv.number || '',
+      customerName,
+      inv.issueDate,
+      inv.dueDate || '',
+      inv.status,
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    return fields.map(escapeCsvField).join(',') + '\n';
+  });
+
+  return header + lines.join('');
+}
