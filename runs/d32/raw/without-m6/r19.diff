@@ -0,0 +1,226 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header only for empty array', () => {
+  const result = exportCsv([]);
+
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv exports single issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = exportCsv([r2.value]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.ok(lines[1].includes('INV-2026-0001'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[1].includes('2026-10-07'));
+  assert.ok(lines[1].includes('2026-11-06'));
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv formats amounts in euros with 2 decimals', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = exportCsv([r2.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  assert.ok(dataLine.includes('950.00'));
+  assert.ok(dataLine.includes('199.50'));
+});
+
+test('exportCsv handles draft invoice without number', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+
+  const result = exportCsv([r1.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  assert.ok(dataLine.startsWith(',Northwind Studio,2026-10-07,2026-11-06,draft,'));
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const r1 = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = exportCsv([r2.value]);
+
+  assert.ok(result.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer name with quotes', () => {
+  const r1 = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = exportCsv([r2.value]);
+
+  assert.ok(result.includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv handles multiple invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+  const result = exportCsv([r2.value, r4.value]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4);
+  assert.ok(lines[1].includes('INV-2026-0001'));
+  assert.ok(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv handles partially paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+  const result = exportCsv([r3.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  assert.ok(dataLine.includes('partially_paid'));
+  assert.ok(dataLine.includes('649.50'));
+});
+
+test('exportCsv handles paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totalToPay = r2.value.lines.reduce((sum, line) => {
+    const lineTotal = line.qty * line.unitPrice;
+    const discount = lineTotal * (line.discountPercent || 0) / 100;
+    const afterDiscount = lineTotal - discount;
+    const vat = Math.round(afterDiscount * (line.vatRate || 0) / 100);
+    return sum + lineTotal - discount + vat;
+  }, 0);
+
+  const r3 = recordPayment(r2.value, { amount: totalToPay, date: '2026-10-10' });
+  const result = exportCsv([r3.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  assert.ok(dataLine.includes('paid'));
+  assert.ok(dataLine.endsWith('0.00'));
+});
+
+test('exportCsv handles draft invoice with voucher', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = applyVoucher(r1.value, { code: 'SAVE10', amount: 10000 });
+  const result = exportCsv([r2.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  assert.ok(dataLine.includes('1149.50') === false);
+  assert.ok(dataLine.includes('1049.50'));
+});
+
+test('exportCsv with line discount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const result = exportCsv([r2.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  assert.ok(dataLine.includes('95.00'));
+  assert.ok(dataLine.includes('1034.55'));
+});
+
+test('exportCsv with customer not found', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  r2.value.customerId = 'UNKNOWN-ID';
+  const result = exportCsv([r2.value]);
+
+  assert.ok(result.includes('Unknown Customer'));
+});
+
+test('exportCsv handles zero amounts', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1, discountPercent: 0 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+  const totalToPay = 60000;
+  const r3 = recordPayment(r2.value, { amount: totalToPay, date: '2026-10-10' });
+  const result = exportCsv([r3.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  assert.ok(dataLine.endsWith('0.00'));
+});
