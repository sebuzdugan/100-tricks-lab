+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 95000);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { qty: 1, unitPrice: 100 };
+  assert.equal(lineTotal(line), 100);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 100 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineDiscount calculates discount on line total', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 9500);
+});
+
+test('lineDiscount with no discount percentage', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with zero discount', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with full discount', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 95000);
+});
+
+test('lineDiscount rounds correctly', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 33 };
+  assert.equal(lineDiscount(line), 3300);
+});
+
+test('lineVat calculates VAT on discounted amount', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineVat(line), 19950);
+});
+
+test('lineVat with discount applied first', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 };
+  assert.equal(lineVat(line), 17955);
+});
+
+test('lineVat with no VAT rate', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with zero VAT rate', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat rounds correctly', () => {
+  const line = { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineVat(line), 210);
+});
+
+test('invoiceTotals calculates all components', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 95000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 19950);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 114950);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 137500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 28875);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 166375);
+});
+
+test('invoiceTotals with line discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 95000);
+  assert.equal(totals.discount, 9500);
+  assert.equal(totals.vat, 17955);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 103455);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE10', amount: 10000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 95000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 19950);
+  assert.equal(totals.voucher, 10000);
+  assert.equal(totals.total, 104950);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 60000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 155000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 19950);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 174950);
+});
+
+test('invoiceTotals clamps total to 0 if voucher exceeds total', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'BIG', amount: 50000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals without voucher defaults to 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals returns object with all required fields', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.ok(totals.hasOwnProperty('subtotal'));
+  assert.ok(totals.hasOwnProperty('discount'));
+  assert.ok(totals.hasOwnProperty('vat'));
+  assert.ok(totals.hasOwnProperty('voucher'));
+  assert.ok(totals.hasOwnProperty('total'));
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = { lines: [] };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with complex scenario', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+      { qty: 20, unitPrice: 1000, discountPercent: 2.5, vatRate: 9 },
+      { qty: 1, unitPrice: 60000, discountPercent: 0, vatRate: 0 },
+    ],
+    voucher: { code: 'PROMO', amount: 5000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.ok(totals.subtotal > 0);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.voucher, 5000);
+  assert.ok(totals.total > 0);
+});
