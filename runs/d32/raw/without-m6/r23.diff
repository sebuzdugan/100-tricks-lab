+/**
+ * Calculate the bulk discount (in cents) for a single line item (2.5% for 10+ units, applied after line discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function bulkDiscount(line) {
+  if (line.qty < 10) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const afterFirstDiscount = total - discount;
+  return roundCents(afterFirstDiscount * 2.5 / 100);
