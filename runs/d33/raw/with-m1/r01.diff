@@ -0,0 +1,151 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with valid input', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+  assert.equal(result.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[0].qty, 5);
+  assert.equal(result.value.lines[0].unitPrice, 8500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'ICON-SET', qty: 3 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[1].name, 'Development (hour)');
+  assert.equal(result.value.lines[2].name, 'Icon set (24 icons)');
+});
+
+test('createInvoice reports unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '10-07-2026',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects invalid date (like Feb 30)', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects partially formed date', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects missing lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects non-integer qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects zero qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects negative qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'NOPE', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input lines array', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+  const original = JSON.stringify(lines);
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+  assert.equal(JSON.stringify(lines), original);
+});
+
+test('createInvoice does not mutate input object', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  };
+  const original = JSON.stringify(input);
+  createInvoice(input);
+  assert.equal(JSON.stringify(input), original);
+});
