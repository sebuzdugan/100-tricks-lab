+/**
+ * Issue a draft invoice, assigning it a number and marking it as issued.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @param {Array<string>} existingNumbers
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, number: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Get next invoice number
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  // Return new invoice with number and status updated
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    number,
+    status: 'issued',
+    lines: invoice.lines.map((line) => ({ ...line })),
+  });
+}
