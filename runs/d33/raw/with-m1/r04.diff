diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..d28c8e0
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,58 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const numbers = ['INV-2026-0001'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber increments from multiple numbers', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const numbers = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0005', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from different years', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const numbers = Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber ignores invalid number formats', () => {
+  const numbers = ['INV-2026-0001', 'INVALID', 'INV-2026-abc', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber uses year from issueDate', () => {
+  const numbers = [];
+  const number1 = nextInvoiceNumber(numbers, '2025-01-15');
+  const number2 = nextInvoiceNumber(numbers, '2027-12-31');
+  assert.equal(number1, 'INV-2025-0001');
+  assert.equal(number2, 'INV-2027-0001');
+});
