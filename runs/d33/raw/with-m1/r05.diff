+++ b/test/render.test.js
@@ -0,0 +1,152 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+  assert.ok(text.includes('2 x Design work (hour)'));
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€170.00'));
+  assert.ok(text.includes('Total:'));
+});
+
+test('renderInvoiceText renders an issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = renderInvoiceText(issued);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.ok(text.includes('INV-2026-0001'));
+  assert.ok(!text.includes('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText formats amounts with formatEuros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 100 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  // 980 cents = €9.80, 100 × €9.80 = €980.00
+  assert.ok(text.includes('€9.80'));
+  assert.ok(text.includes('€980.00'));
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.ok(text.includes('Kite & Co'));
+  assert.ok(text.includes('2 x Design work (hour)'));
+  assert.ok(text.includes('3 x Development (hour)'));
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€95.00'));
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // number/DRAFT, customer, line1, line2, total
+});
+
+test('renderInvoiceText reports unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    status: 'draft',
+    lines: [{ qty: 1, name: 'Test', unitPrice: 1000 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('renderInvoiceText shows line format with qty, name, price, and total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'COPY-HOUR', qty: 5 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  // Should show: 5 x Copywriting (hour) @ €60.00 = €300.00
+  assert.ok(text.includes('5 x Copywriting (hour) @ €60.00 = €300.00'));
+});
+
+test('renderInvoiceText renders with different customers', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result1 = renderInvoiceText(invoice1);
+  const result2 = renderInvoiceText(invoice2);
+
+  assert.ok(result1.value.includes('Northwind Studio'));
+  assert.ok(result2.value.includes('Blue Fern Bakery'));
+});
+
+test('renderInvoiceText outputs newline-separated lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const lines = result.value.split('\n');
+  assert.equal(lines.length, 4); // DRAFT, customer, line, total
+  assert.equal(lines[0], 'DRAFT');
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[2].includes('Design work (hour)'));
+  assert.ok(lines[3].startsWith('Total:'));
+});
+
+test('renderInvoiceText with large quantities', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 250 }],
+  }).value;
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  // 250 × 8500 = 2,125,000 cents = €21,250.00
+  assert.ok(text.includes('250 x Design work (hour)'));
+  assert.ok(text.includes('€21,250.00'));
+});
