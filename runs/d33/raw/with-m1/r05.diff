+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to customers.
+ * @param {{ customerId: string, number?: string, status: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const customer = customerResult.value;
+  const lines = [];
+
+  // Invoice number or DRAFT
+  lines.push(invoice.number || 'DRAFT');
+
+  // Customer name
+  lines.push(customer.name);
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const lineTotal = line.qty * line.unitPrice;
+    const unitPriceStr = formatEuros(line.unitPrice);
+    const lineTotalStr = formatEuros(lineTotal);
+    lines.push(`${line.qty} x ${line.name} @ ${unitPriceStr} = ${lineTotalStr}`);
+  }
+
+  // Total
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return ok(lines.join('\n'));
+}
diff --git a/test/render.test.js b/test/render.test.js
