+    lines: [
+      { sku: 'DES-HOUR', qty: 10 }, // gets 2.5%
+      { sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }, // explicit 10%
+    ],
+  }).value;
+  const totals = invoiceTotals(invoice);
+  // Line 1: 10 * 8500 = 85000, discount = 85000 * 2.5 / 100 = 2125
+  // Line 2: 5 * 9500 = 47500, discount = 47500 * 10 / 100 = 4750
+  // Subtotal: 85000 + 47500 = 132500
+  // Total discount: 2125 + 4750 = 6875
+  // Total: 132500 - 6875 = 125625
+  assert.equal(totals.subtotal, 132500);
+  assert.equal(totals.discount, 6875);
+  assert.equal(totals.total, 125625);
+});
