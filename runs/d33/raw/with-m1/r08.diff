+
+test('lineVAT calculates VAT on line amount before discount', () => {
+  // Line: 10 * 100 = 1000, no discount, VAT 21% = 1000 * 21 / 100 = 210
+  const line = { qty: 10, unitPrice: 100, vatRate: 21 };
+  assert.equal(lineVAT(line), 210);
+});
+
+test('lineVAT calculates VAT after discount is applied', () => {
+  // Line: 10 * 100 = 1000, discount 10% = 100, after discount = 900, VAT 21% = 900 * 21 / 100 = 189
+  const line = { qty: 10, unitPrice: 100, discountPercent: 10, vatRate: 21 };
+  assert.equal(lineVAT(line), 189);
+});
+
+test('lineVAT rounds per line', () => {
+  // Line: 100 * 100 = 10000, discount 0%, VAT 9% = 10000 * 9 / 100 = 900
+  const line = { qty: 100, unitPrice: 100, vatRate: 9 };
+  assert.equal(lineVAT(line), 900);
+});
+
+test('lineVAT handles decimal VAT rates', () => {
+  // Test with 9% VAT
+  const line = { qty: 3, unitPrice: 500, vatRate: 9 };
+  // Amount = 1500, VAT = 1500 * 9 / 100 = 135
+  assert.equal(lineVAT(line), 135);
+});
+
+test('lineVAT clamps result at 0', () => {
+  // lineVAT should never go negative
+  const line = { qty: 1, unitPrice: 100, vatRate: 0 };
+  assert.equal(lineVAT(line) >= 0, true);
+});
