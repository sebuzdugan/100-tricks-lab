@@ -967,3 +967,53 @@ test('invoiceTotals with VAT preserves total = subtotal - discount + vat', () =>
   assert.equal(totals.vat, 189);
   assert.equal(totals.total, 1089);
 });
+
+test('createInvoice normalizes customer ID (lowercase)', () => {
+  const result = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createInvoice normalizes customer ID (with whitespace)', () => {
+  const result = createInvoice({
+    customerId: ' c-001 ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createInvoice normalizes customer ID (mixed case)', () => {
+  const result = createInvoice({
+    customerId: 'C-007 ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-007');
+});
+
+test('createInvoice accepts non-normalized IDs and stores normalized version', () => {
+  const result1 = createInvoice({
+    customerId: 'c-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const result2 = createInvoice({
+    customerId: ' C-003 ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  // Both should have normalized ID
+  assert.equal(result1.value.customerId, 'C-003');
+  assert.equal(result2.value.customerId, 'C-003');
+  // Both should reference the same customer
+  assert.equal(result1.value.customerId, result2.value.customerId);
+});
