diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..7f25a8d
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,133 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates in YYYY-MM-DD format', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2000-06-15'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate('2026'), false);
+  assert.equal(isValidDate('10-07'), false);
+  assert.equal(isValidDate('2026-10-7'), false); // day not zero-padded
+  assert.equal(isValidDate('2026-1-07'), false); // month not zero-padded
+});
+
+test('isValidDate rejects invalid dates (like Feb 30)', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2026-06-31'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+});
+
+test('isValidDate accepts leap year Feb 29', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // 2024 is a leap year
+  assert.equal(isValidDate('2000-02-29'), true); // 2000 is a leap year
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2026-02-29'), false); // 2026 is not a leap year
+  assert.equal(isValidDate('2100-02-29'), false); // 2100 is not a leap year
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+});
+
+test('addDays adds days correctly', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays subtracts days with negative n', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-11-01', -1), '2026-10-31');
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles leap year Feb 29', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-03-01', -1), '2024-02-29');
+});
+
+test('addDays works in UTC (not local time)', () => {
+  // Adding 1 day should always give predictable results
+  const result = addDays('2026-06-15', 1);
+  assert.equal(result, '2026-06-16');
+  // This should be consistent regardless of local timezone
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-11-01', '2026-10-31'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween handles large differences', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-12-31'), 364); // 2026 is not a leap year
+  assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365); // 2024 is a leap year
+});
+
+test('daysBetween works in UTC', () => {
+  const result = daysBetween('2026-06-15', '2026-06-22');
+  assert.equal(result, 7);
+  // This should be consistent regardless of local timezone
+});
+
+test('daysBetween is commutative (order matters)', () => {
+  const a = '2026-10-07';
+  const b = '2026-10-12';
+  assert.equal(daysBetween(a, b), -daysBetween(b, a));
+  assert.equal(daysBetween(a, b), 5);
+  assert.equal(daysBetween(b, a), -5);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const date1 = '2026-10-07';
+  const days = 10;
+  const date2 = addDays(date1, days);
+  assert.equal(daysBetween(date1, date2), days);
+});
+
+test('addDays and daysBetween work with leap years', () => {
+  const date1 = '2024-02-28';
+  const date2 = '2024-03-02'; // 2 days after Feb 28 in a leap year
+  assert.equal(daysBetween(date1, date2), 3); // Feb 28, 29, Mar 1, 2
+  assert.equal(addDays(date1, 3), date2);
+});
