@@ -0,0 +1,58 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the balance due on an invoice (total minus payments).
+ * @param {{ payments?: Array<{ amount: number, date: string }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const payments = invoice.payments ?? [];
+  const totalPaid = payments.reduce((sum, payment) => sum + payment.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array, payments: Array<{ amount: number, date: string }> } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate invoice status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const owed = balanceDue(invoice);
+
+  // Validate payment doesn't exceed balance due
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Add payment to payments array
+  const newPayments = [...(invoice.payments ?? []), { amount, date }];
+
+  // Calculate new balance due
+  const newBalance = balanceDue({ ...invoice, payments: newPayments });
+
+  // Determine new status
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    number: invoice.number,
+    status: newStatus,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments: newPayments,
+  });
+}
