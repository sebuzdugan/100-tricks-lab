+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+function createTestInvoice() {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+  return result.value;
+}
+
+function issueTestInvoice() {
+  const invoice = createTestInvoice();
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+  return issued.value;
+}
+
+test('balanceDue returns total for unissued invoice', () => {
+  const invoice = issueTestInvoice();
+  const totals = invoiceTotals(invoice);
+  assert.equal(balanceDue(invoice), totals.total);
+});
+
+test('balanceDue returns correct amount after partial payment', () => {
+  const invoice = issueTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const payment1 = recordPayment(invoice, { amount: 25000, date: '2026-10-10' });
+  assert.equal(payment1.ok, true);
+  assert.equal(balanceDue(payment1.value), totals.total - 25000);
+
+  const payment2 = recordPayment(payment1.value, { amount: 10000, date: '2026-10-15' });
+  assert.equal(payment2.ok, true);
+  assert.equal(balanceDue(payment2.value), totals.total - 35000);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const invoice = issueTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(payment.ok, true);
+  assert.equal(balanceDue(payment.value), 0);
+});
+
+test('recordPayment records a single payment on an issued invoice', () => {
+  const invoice = issueTestInvoice();
+  const payment = recordPayment(invoice, { amount: 25000, date: '2026-10-10' });
+
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.payments.length, 1);
+  assert.equal(payment.value.payments[0].amount, 25000);
+  assert.equal(payment.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment updates status from issued to partially_paid', () => {
+  const invoice = issueTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const payment = recordPayment(invoice, { amount: totals.total - 10000, date: '2026-10-10' });
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.status, 'partially_paid');
+});
+
+test('recordPayment updates status from partially_paid to paid', () => {
+  const invoice = issueTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const payment1 = recordPayment(invoice, { amount: 25000, date: '2026-10-10' });
+  assert.equal(payment1.value.status, 'partially_paid');
+
+  const payment2 = recordPayment(payment1.value, { amount: balanceDue(payment1.value), date: '2026-10-15' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.status, 'paid');
+  assert.equal(balanceDue(payment2.value), 0);
+});
+
+test('recordPayment preserves invoice properties', () => {
+  const invoice = issueTestInvoice();
+  const payment = recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.customerId, invoice.customerId);
+  assert.equal(payment.value.issueDate, invoice.issueDate);
+  assert.equal(payment.value.number, invoice.number);
+  assert.equal(payment.value.lines.length, invoice.lines.length);
+});
+
+test('recordPayment does not mutate the original invoice', () => {
+  const invoice = issueTestInvoice();
+  const originalPayments = invoice.payments;
+
+  recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+
+  assert.equal(invoice.payments, originalPayments);
+});
+
+test('recordPayment reports NOT_ISSUED when status is draft', () => {
+  const invoice = createTestInvoice();
+  const result = recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment reports NOT_ISSUED when status is paid', () => {
+  const invoice = issueTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(payment.value.status, 'paid');
+
+  const result = recordPayment(payment.value, { amount: 1, date: '2026-10-15' });
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment reports AMOUNT_INVALID for zero amount', () => {
+  const invoice = issueTestInvoice();
+  const result = recordPayment(invoice, { amount: 0, date: '2026-10-10' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment reports AMOUNT_INVALID for negative amount', () => {
+  const invoice = issueTestInvoice();
+  const result = recordPayment(invoice, { amount: -1000, date: '2026-10-10' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment reports AMOUNT_INVALID for non-integer amount', () => {
+  const invoice = issueTestInvoice();
+  const result = recordPayment(invoice, { amount: 123.45, date: '2026-10-10' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment reports OVERPAYMENT when payment exceeds balance due', () => {
+  const invoice = issueTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const result = recordPayment(invoice, { amount: totals.total + 1, date: '2026-10-10' });
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment reports NOT_ISSUED for additional payment when already paid', () => {
+  const invoice = issueTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(payment.value.status, 'paid');
+
+  const result = recordPayment(payment.value, { amount: 1, date: '2026-10-15' });
