   const diffMs = dateB.getTime() - dateA.getTime();
   return Math.floor(diffMs / (1000 * 60 * 60 * 24));
 }
+
+/**
+ * Get the last day of the month for a given date, in UTC.
+ * @param {string} date - YYYY-MM-DD format
+ * @returns {string} - YYYY-MM-DD format
+ */
+export function lastDayOfMonth(date) {
+  const d = new Date(date + 'T00:00:00Z');
+  const year = d.getUTCFullYear();
+  const month = d.getUTCMonth();
+  const nextMonth = new Date(Date.UTC(year, month + 1, 1));
+  nextMonth.setUTCDate(0);
+  return nextMonth.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the due date based on payment terms.
+ * @param {string} issueDate - YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} - YYYY-MM-DD format
+ */
+export function calculateDueDate(issueDate, terms) {
+  switch (terms) {
+    case 'NET14':
+      return addDays(issueDate, 14);
+    case 'NET30':
+      return addDays(issueDate, 30);
+    case 'EOM':
+      return lastDayOfMonth(issueDate);
+    default:
+      return null;
+  }
+}
