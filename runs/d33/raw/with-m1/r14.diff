+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement for invoices issued on or before a given date.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, issueDate: string, dueDate: string, status: string, number?: string, lines: Array, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number, date: string }> }>} invoices
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize customer ID
+  const normalizedCustomerId = normalizeId(customerId);
+
+  // Validate customer exists
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices: customer match, status issued/partially_paid, issued on or before asOf
+  const relevantInvoices = invoices.filter((invoice) => {
+    const isOurCustomer = invoice.customerId === normalizedCustomerId;
+    const hasValidStatus = invoice.status === 'issued' || invoice.status === 'partially_paid';
+    const isIssuedOnTime = invoice.issueDate <= asOf;
+    return isOurCustomer && hasValidStatus && isIssuedOnTime;
+  });
+
+  // Build statement invoices with required fields, sorted by issueDate
+  const statementInvoices = relevantInvoices
+    .map((invoice) => ({
+      number: invoice.number,
+      issueDate: invoice.issueDate,
+      dueDate: invoice.dueDate,
+      total: invoiceTotals(invoice).total,
+      due: balanceDue(invoice),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
index 0000000..1c14376
--- /dev/null
+++ b/test/statements.test.js
@@ -0,0 +1,210 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId, issueDate, terms = 'NET30') {
+  const invoice = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms,
+  });
+  if (!invoice.ok) throw new Error('Failed to create invoice');
+
+  const issued = issueInvoice(invoice.value, []);
+  if (!issued.ok) throw new Error('Failed to issue invoice');
+
+  return issued.value;
+}
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('UNKNOWN-999', [], '2026-12-31');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement returns empty invoices for customer with no issued invoices', () => {
+  const result = statement('C-001', [], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes a single issued invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const result = statement('C-001', [invoice], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice.number);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement includes invoice fields: number, issueDate, dueDate, total, due', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const result = statement('C-001', [invoice], '2026-10-31');
+  assert.equal(result.ok, true);
+  const inv = result.value.invoices[0];
+
+  assert(inv.number, 'should have number');
+  assert.equal(inv.issueDate, '2026-10-07');
+  assert.equal(inv.dueDate, '2026-11-06');
+  assert(inv.total > 0, 'should have total > 0');
+  assert.equal(inv.due, inv.total, 'due should equal total for unpaid invoice');
+});
+
+test('statement normalizes customer ID', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const result = statement('  c-001  ', [invoice], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement filters by issueDate on or before asOf', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-15');
+  const invoice3 = createAndIssueInvoice('C-001', '2026-10-25');
+
+  const result = statement('C-001', [invoice1, invoice2, invoice3], '2026-10-20');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-15');
+});
+
+test('statement excludes invoices with issueDate after asOf', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-25');
+
+  const result = statement('C-001', [invoice1, invoice2], '2026-10-20');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-25');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-07');
+  const invoice3 = createAndIssueInvoice('C-001', '2026-10-15');
+
+  const result = statement('C-001', [invoice1, invoice2, invoice3], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-15');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-25');
+});
+
+test('statement includes only this customer\'s invoices', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const invoice2 = createAndIssueInvoice('C-002', '2026-10-15');
+  const invoice3 = createAndIssueInvoice('C-001', '2026-10-25');
+
+  const result = statement('C-001', [invoice1, invoice2, invoice3], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, invoice1.number);
+  assert.equal(result.value.invoices[1].number, invoice3.number);
+});
+
+test('statement excludes draft invoices', () => {
+  const issued = createAndIssueInvoice('C-001', '2026-10-07');
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = statement('C-001', [issued, draft.value], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, issued.number);
+});
+
+test('statement excludes paid invoices from totalDue but includes in list', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const totals1 = invoiceTotals(invoice);
+
+  const paid = recordPayment(invoice, { amount: totals1.total, date: '2026-10-10' });
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.status, 'paid');
+
+  const result = statement('C-001', [paid.value], '2026-12-31');
+  assert.equal(result.ok, true);
+  // Paid invoices are excluded because status is 'paid', not 'issued' or 'partially_paid'
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement calculates due correctly for partially paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const totals1 = invoiceTotals(invoice);
+  const paymentAmount = Math.floor(totals1.total / 2);
+
+  const partial = recordPayment(invoice, { amount: paymentAmount, date: '2026-10-10' });
+  assert.equal(partial.ok, true);
+  assert.equal(partial.value.status, 'partially_paid');
+
+  const result = statement('C-001', [partial.value], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, totals1.total - paymentAmount);
+});
+
+test('statement calculates totalDue as sum of all invoice due amounts', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-15');
+
+  const totals1 = invoiceTotals(invoice1);
+  const totals2 = invoiceTotals(invoice2);
+
+  const result = statement('C-001', [invoice1, invoice2], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.totalDue, totals1.total + totals2.total);
+});
+
+test('statement with multiple invoices and partial payments', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-07');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-15');
+
+  const totals1 = invoiceTotals(invoice1);
+  const totals2 = invoiceTotals(invoice2);
+
+  const payment1 = Math.floor(totals1.total / 2);
+  const partial1 = recordPayment(invoice1, { amount: payment1, date: '2026-10-10' });
+
+  const result = statement('C-001', [partial1.value, invoice2], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].due, totals1.total - payment1);
+  assert.equal(result.value.invoices[1].due, totals2.total);
+  assert.equal(result.value.totalDue, (totals1.total - payment1) + totals2.total);
+});
+
+test('statement includes invoices with different due dates', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-07', 'NET14');
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-15', 'NET30');
+  const invoice3 = createAndIssueInvoice('C-001', '2026-10-20', 'EOM');
+
+  const result = statement('C-001', [invoice1, invoice2, invoice3], '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].dueDate, '2026-10-21');
+  assert.equal(result.value.invoices[1].dueDate, '2026-11-14');
+  assert.equal(result.value.invoices[2].dueDate, '2026-10-31');
+});
+
+test('statement does not mutate input invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const originalNumber = invoice.number;
+
+  statement('C-001', [invoice], '2026-12-31');
+
+  assert.equal(invoice.number, originalNumber);
+});
