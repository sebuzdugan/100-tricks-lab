+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next credit note number for a given year.
+ * Format: CN-<year>-<counter> where counter is 4 digits, zero-padded.
+ * @param {Array<string>} existingNumbers - Both invoice and credit note numbers
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} - Next credit note number, e.g. 'CN-2026-0001'
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `CN-${year}-`;
+
+  // Find all counters for this year
+  const thisYearCounters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.slice(prefix.length), 10))
+    .filter((num) => !isNaN(num));
+
+  // Find the max counter for this year, or 0 if none exist
+  const maxCounter = thisYearCounters.length > 0 ? Math.max(...thisYearCounters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ customerId: string, number: string, status: string, lines: Array, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, reason: string, date: string }} params
+ * @param {Array<string>} existingNumbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice status (must be issued, partially_paid, or paid)
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total and validate credit amount doesn't exceed it
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
