diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..b7f50fe
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,266 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId = 'C-001', issueDate = '2026-10-07') {
+  const invoice = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  if (!invoice.ok) throw new Error('Failed to create invoice');
+
+  const issued = issueInvoice(invoice.value, []);
+  if (!issued.ok) throw new Error('Failed to issue invoice');
+
+  return issued.value;
+}
+
+test('nextCreditNoteNumber generates CN number with year and counter', () => {
+  const number = nextCreditNoteNumber([], '2026-10-07');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber increments counter for existing credit notes', () => {
+  const number = nextCreditNoteNumber(['CN-2026-0001', 'CN-2026-0002'], '2026-10-07');
+  assert.equal(number, 'CN-2026-0003');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const number = nextCreditNoteNumber(['INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber restarts counter for new year', () => {
+  const number = nextCreditNoteNumber(['CN-2025-0010'], '2026-10-07');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber handles unordered existing numbers', () => {
+  const number = nextCreditNoteNumber(['CN-2026-0003', 'CN-2026-0001', 'CN-2026-0002'], '2026-10-07');
+  assert.equal(number, 'CN-2026-0004');
+});
+
+test('nextCreditNoteNumber pads counter to 4 digits', () => {
+  const number = nextCreditNoteNumber([], '2026-10-07');
+  const counter = number.split('-')[2];
+  assert.equal(counter.length, 4);
+  assert.equal(counter, '0001');
+});
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const invoice = createAndIssueInvoice();
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Defect', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Defect');
+  assert.equal(result.value.date, '2026-10-10');
+});
+
+test('createCreditNote creates credit note for partially_paid invoice', () => {
+  const invoice = createAndIssueInvoice();
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: Math.floor(totals.total / 2), date: '2026-10-10' });
+
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.status, 'partially_paid');
+
+  const result = createCreditNote(
+    payment.value,
+    { amount: 5000, reason: 'Partial refund', date: '2026-10-15' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote creates credit note for paid invoice', () => {
+  const invoice = createAndIssueInvoice();
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.status, 'paid');
+
+  const result = createCreditNote(
+    paid.value,
+    { amount: 5000, reason: 'Refund', date: '2026-10-15' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = createCreditNote(
+    invoice.value,
+    { amount: 5000, reason: 'Defect', date: '2026-10-10' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = createAndIssueInvoice();
+  const result = createCreditNote(
+    invoice,
+    { amount: 0, reason: 'Defect', date: '2026-10-10' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = createAndIssueInvoice();
+  const result = createCreditNote(
+    invoice,
+    { amount: -5000, reason: 'Defect', date: '2026-10-10' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const invoice = createAndIssueInvoice();
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000.5, reason: 'Defect', date: '2026-10-10' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const invoice = createAndIssueInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: totals.total + 1, reason: 'Defect', date: '2026-10-10' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote accepts credit equal to invoice total', () => {
+  const invoice = createAndIssueInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: totals.total, reason: 'Full refund', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote uses date from credit note for numbering', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const result1 = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Defect', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.number, 'CN-2026-0001');
+
+  // Another credit note for different year
+  const invoice2 = createAndIssueInvoice('C-001', '2027-01-15');
+  const result2 = createCreditNote(
+    invoice2,
+    { amount: 5000, reason: 'Defect', date: '2027-01-20' },
+    [result1.value.number]
+  );
+
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote increments counter with mixed invoice and credit numbers', () => {
+  const invoice = createAndIssueInvoice();
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Defect', date: '2026-10-10' },
+    ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001']
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote for invoice with voucher (credit limited by total including voucher)', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const withVoucher = applyVoucher(draft.value, { code: 'SAVE10', amount: 10000 });
+
+  const issued = issueInvoice(withVoucher.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = createCreditNote(
+    issued.value,
+    { amount: totals.total, reason: 'Refund', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote preserves invoice number in credit note', () => {
+  const invoice = createAndIssueInvoice();
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Defect', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert(result.value.invoiceNumber.startsWith('INV-'));
+});
+
+test('createCreditNote preserves customer ID', () => {
+  const invoice = createAndIssueInvoice('C-003');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Defect', date: '2026-10-10' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+});
