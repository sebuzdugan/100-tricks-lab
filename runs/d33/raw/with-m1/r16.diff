@@ -0,0 +1,23 @@
+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Generate an overdue invoices report.
+ * Returns invoices with status 'issued' or 'partially_paid' whose dueDate is before asOf.
+ * Sorted by most overdue first (oldest dueDate first).
+ * @param {Array<{ number: string, customerId: string, status: string, dueDate: string, payments?: Array<{ amount: number, date: string }>, lines: Array, voucher?: { code: string, amount: number } }>} invoices
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter(inv => (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate < asOf)
+    .map(inv => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.dueDate.localeCompare(b.dueDate));
+}
