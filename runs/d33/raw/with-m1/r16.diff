+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoice(customerId, issueDate, terms) {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: terms || 'NET30',
+  });
+  assert.equal(result.ok, true);
+  return result.value;
+}
+
+function issueTestInvoice(customerId, issueDate, terms) {
+  const invoice = createTestInvoice(customerId, issueDate, terms);
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+  return issued.value;
+}
+
+test('overdueInvoices returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2026-11-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const invoice = issueTestInvoice('C-001', '2026-11-01', 'NET30');
+  // Due date: 2026-12-01, checking as of 2026-11-15, not overdue yet
+  const result = overdueInvoices([invoice], '2026-11-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes issued invoice with overdue dueDate', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  // Due date: 2026-10-31, checking as of 2026-11-15, overdue by 15 days
+  const result = overdueInvoices([invoice], '2026-11-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoice.number);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-10-31');
+  assert.equal(result[0].daysOverdue, 15);
+});
+
+test('overdueInvoices includes partially_paid invoice with overdue dueDate', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total / 2, date: '2026-10-20' });
+  assert.equal(paid.ok, true);
+  const result = overdueInvoices([paid.value], '2026-11-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].daysOverdue, 15);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2026-10-20' });
+  assert.equal(paid.ok, true);
+  const result = overdueInvoices([paid.value], '2026-11-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01', 'NET30');
+  const result = overdueInvoices([invoice], '2026-11-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices calculates due amount correctly with partial payment', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: 30000, date: '2026-10-20' });
+  assert.equal(paid.ok, true);
+  const result = overdueInvoices([paid.value], '2026-11-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, totals.total - 30000);
+});
+
+test('overdueInvoices calculates due amount correctly without payment', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(invoice);
+  const result = overdueInvoices([invoice], '2026-11-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, totals.total);
+});
+
+test('overdueInvoices sorts by daysOverdue ascending (most overdue first)', () => {
+  const invoice1 = issueTestInvoice('C-001', '2026-10-01', 'NET14');
+  // Due: 2026-10-15, 31 days overdue on 2026-11-15
+  const invoice2 = issueTestInvoice('C-002', '2026-10-15', 'NET14');
+  // Due: 2026-10-29, 17 days overdue on 2026-11-15
+  const invoice3 = issueTestInvoice('C-003', '2026-11-01', 'NET14');
+  // Due: 2026-11-15, 0 days overdue on 2026-11-15 (not overdue yet)
+
+  const result = overdueInvoices([invoice3, invoice1, invoice2], '2026-11-15');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-001'); // Most overdue (31 days)
+  assert.equal(result[0].daysOverdue, 31);
+  assert.equal(result[1].customerId, 'C-002'); // Less overdue (17 days)
+  assert.equal(result[1].daysOverdue, 17);
+});
+
+test('overdueInvoices handles NET14 terms correctly', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET14');
+  // Due: 2026-10-15
+  const result = overdueInvoices([invoice], '2026-10-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2026-10-15');
+  assert.equal(result[0].daysOverdue, 5);
+});
+
+test('overdueInvoices handles EOM terms correctly', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-15', 'EOM');
+  // Due: 2026-10-31 (end of October)
+  const result = overdueInvoices([invoice], '2026-11-10');
