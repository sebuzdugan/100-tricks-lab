+/**
+ * Generate a VAT summary report.
+ * Returns VAT aggregated by rate over invoices with status 'issued', 'partially_paid', or 'paid'.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const summary = new Map();
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVAT(line);
+
+      if (!summary.has(rate)) {
+        summary.set(rate, { rate, base: 0, vat: 0 });
+      }
+
+      const entry = summary.get(rate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  return Array.from(summary.values()).sort((a, b) => b.rate - a.rate);
+}
