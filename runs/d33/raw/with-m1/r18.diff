   return Array.from(summary.values()).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate the late fee for an invoice.
+ * 0.04% of the amount still due for every day the invoice is overdue.
+ * Returns 0 if the invoice is not overdue.
+ * @param {{ dueDate: string, status?: string, payments?: Array<{ amount: number, date: string }>, lines: Array, voucher?: { code: string, amount: number } }} invoice
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, rounded
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = roundCents(due * 0.04 / 100 * daysOverdue);
+  return Math.max(0, fee);
+}
