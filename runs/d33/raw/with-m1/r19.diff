+++ b/test/export.test.js
@@ -0,0 +1,282 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoice(customerId, issueDate, terms) {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: terms || 'NET30',
+  });
+  assert.equal(result.ok, true);
+  return result.value;
+}
+
+function issueTestInvoice(customerId, issueDate, terms) {
+  const invoice = createTestInvoice(customerId, issueDate, terms);
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+  return issued.value;
+}
+
+test('exportCsv returns header with newline for empty array', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[lines.length - 1], '');
+});
+
+test('exportCsv returns header and one data line for single invoice', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[2], '');
+});
+
+test('exportCsv includes invoice number', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  assert(csv.includes(invoice.number));
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv includes issueDate', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('2026-10-01'));
+});
+
+test('exportCsv includes dueDate', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('2026-10-31'));
+});
+
+test('exportCsv includes status', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('issued'));
+});
+
+test('exportCsv formats amounts with 2 decimals and dot', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  for (let i = 5; i <= 9; i++) {
+    assert(/^\d+\.\d{2}$/.test(fields[i]), `Field ${i} should be formatted as X.XX: ${fields[i]}`);
+  }
+});
+
+test('exportCsv formats amounts without currency sign', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  assert(!csv.includes('€'));
+});
+
+test('exportCsv formats amounts with dot decimal not comma', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  const regex = /\d+\.\d{2}/g;
+  const matches = csv.match(regex);
+  assert(matches && matches.length >= 5, 'Should have at least 5 amounts in X.XX format');
+  for (const match of matches) {
+    assert(!match.includes(','), 'Amounts should not have comma separator');
+  }
+});
+
+test('exportCsv handles multiple invoices in order given', () => {
+  const invoice1 = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const invoice2 = issueTestInvoice('C-002', '2026-10-05', 'NET30');
+  const csv = exportCsv([invoice1, invoice2]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 4);
+  assert(lines[1].includes(invoice1.number));
+  assert(lines[2].includes(invoice2.number));
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const invoice = issueTestInvoice('C-004', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('"'));
+  assert(csv.includes('Smith, Jones & Partners'));
+});
+
+test('exportCsv escapes customer name with quote', () => {
+  const invoice = issueTestInvoice('C-006', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('""'));
+});
+
+test('exportCsv lines end with newline', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  assert(csv.endsWith('\n'));
+});
+
+test('exportCsv includes header', () => {
+  const csv = exportCsv([]);
+  assert(csv.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv handles draft invoice with no number', () => {
+  const invoice = createTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[0], '');
+});
+
+test('exportCsv includes correct amounts for invoice', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(invoice);
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(parseFloat(fields[5]), totals.subtotal / 100);
+  assert.equal(parseFloat(fields[6]), totals.discount / 100);
+  assert.equal(parseFloat(fields[7]), totals.vat / 100);
+  assert.equal(parseFloat(fields[8]), totals.total / 100);
+});
+
+test('exportCsv includes due amount', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(invoice);
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(parseFloat(fields[9]), totals.total / 100);
+});
+
+test('exportCsv with partial payment shows correct due', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total / 2, date: '2026-10-20' });
+  assert.equal(paid.ok, true);
+  const csv = exportCsv([paid.value]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(parseFloat(fields[9]), (totals.total / 2) / 100);
+});
+
+test('exportCsv with paid invoice shows due as 0', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2026-10-20' });
+  assert.equal(paid.ok, true);
+  const csv = exportCsv([paid.value]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(parseFloat(fields[9]), 0);
+});
+
+test('exportCsv handles invoice with discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const invoice = issueInvoice(result.value, []);
+  assert.equal(invoice.ok, true);
+  const csv = exportCsv([invoice.value]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert(parseFloat(fields[6]) > 0);
+});
+
+test('exportCsv handles invoice with VAT', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(invoice);
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(parseFloat(fields[7]), totals.vat / 100);
+});
+
+test('exportCsv handles unknown customer gracefully', () => {
+  const draft = createTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([draft]);
+  assert(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv csv field escaping with comma and ampersand', () => {
+  const invoice = issueTestInvoice('C-004', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  assert(dataLine.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv handles three invoices maintaining order', () => {
+  const invoice1 = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const invoice2 = issueTestInvoice('C-002', '2026-10-05', 'NET30');
+  const invoice3 = issueTestInvoice('C-003', '2026-10-10', 'NET30');
+  const csv = exportCsv([invoice1, invoice2, invoice3]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 5);
+  assert(lines[1].includes(invoice1.number));
+  assert(lines[2].includes(invoice2.number));
+  assert(lines[3].includes(invoice3.number));
+});
+
+test('exportCsv fields are in correct order', () => {
+  const invoice = issueTestInvoice('C-001', '2026-10-01', 'NET30');
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const headers = lines[0].split(',');
+  assert.deepEqual(headers, [
+    'number',
+    'customer',
+    'issueDate',
+    'dueDate',
+    'status',
+    'subtotal',
+    'discount',
+    'vat',
+    'total',
+    'due',
+  ]);
+});
+
+test('exportCsv with different statuses', () => {
+  const draft = createTestInvoice('C-001', '2026-10-01', 'NET30');
+  const issued = issueTestInvoice('C-002', '2026-10-01', 'NET30');
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-20' });
+  assert.equal(paid.ok, true);
+
+  const csv = exportCsv([draft, issued, paid.value]);
+  const lines = csv.split('\n');
+  assert(lines[1].includes('draft'));
+  assert(lines[2].includes('issued'));
+  assert(lines[3].includes('paid'));
+});
+
+test('exportCsv handles large invoice amounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'LOGO-PACK', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const invoice = issueInvoice(result.value, []);
+  assert.equal(invoice.ok, true);
+  const csv = exportCsv([invoice.value]);
+  assert(csv.length > 0);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  const amount = parseFloat(fields[8]);
+  assert(amount > 10000);
+});
