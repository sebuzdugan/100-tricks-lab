+  assert.equal(formatMoney(100, 'EUR'), '€1.00');
+  assert.equal(formatMoney(1, 'USD'), '$0.01');
+  assert.equal(formatMoney(999, 'GBP'), '£9.99');
+});
+
+test('convert EUR cents scale correctly to other currencies', () => {
+  const eurocents = 100;
+  const usd = convert(eurocents, 'USD');
+  const gbp = convert(eurocents, 'GBP');
+  assert.equal(usd.ok, true);
+  assert.equal(gbp.ok, true);
