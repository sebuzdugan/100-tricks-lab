+
+test('RATES exported with correct values', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert returns EUR cents unchanged', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  const expected = Math.round(10000 * 1.085);
+  assert.equal(result.value, expected);
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  const expected = Math.round(10000 * 0.8425);
+  assert.equal(result.value, expected);
+});
+
+test('convert handles small amounts', () => {
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  assert(result.value >= 0);
+});
+
+test('convert handles large amounts', () => {
+  const result = convert(10000000, 'USD');
+  assert.equal(result.ok, true);
+  assert(result.value > 0);
+});
+
+test('convert rejects unknown currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert rejects lowercase currency code', () => {
+  const result = convert(10000, 'usd');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert rounds correctly', () => {
+  const result = convert(3, 'USD');
+  assert.equal(result.ok, true);
+  assert(Number.isInteger(result.value));
+});
+
+test('formatMoney formats EUR with euro sign', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+});
+
+test('formatMoney formats USD with dollar sign', () => {
+  assert.equal(formatMoney(108500, 'USD'), '$1,085.00');
+});
+
+test('formatMoney formats GBP with pound sign', () => {
+  assert.equal(formatMoney(84250, 'GBP'), '£842.50');
+});
+
+test('formatMoney adds thousands separators', () => {
+  assert.equal(formatMoney(1234567, 'USD'), '$12,345.67');
+});
+
+test('formatMoney handles small amounts', () => {
+  assert.equal(formatMoney(5, 'USD'), '$0.05');
+});
+
+test('formatMoney handles zero', () => {
+  assert.equal(formatMoney(0, 'EUR'), '€0.00');
+});
+
+test('formatMoney handles negative amounts', () => {
+  assert.equal(formatMoney(-123456, 'EUR'), '-€1,234.56');
+  assert.equal(formatMoney(-100000, 'USD'), '-$1,000.00');
+  assert.equal(formatMoney(-84250, 'GBP'), '-£842.50');
+});
+
+test('formatMoney uses currency code for unknown currency', () => {
+  assert.equal(formatMoney(10000, 'JPY'), 'JPY100.00');
+});
+
+test('convert and formatMoney integration', () => {
+  const eurocents = 10000;
+  const converted = convert(eurocents, 'USD');
+  assert.equal(converted.ok, true);
+  const formatted = formatMoney(converted.value, 'USD');
+  assert(formatted.includes('$'));
+  assert(formatted.includes('.'));
