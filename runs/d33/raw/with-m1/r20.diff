+test('convert maintains precision for common amounts', () => {
+  const amounts = [10000, 25000, 50000, 100000];
+  for (const amount of amounts) {
+    const result = convert(amount, 'USD');
+    assert.equal(result.ok, true);
+    assert(Number.isInteger(result.value));
+  }
+});
+
