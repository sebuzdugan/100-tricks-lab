index 905c396..7c58ed7 100644
--- a/src/customers.js
+++ b/src/customers.js
@@ -43,3 +43,33 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge two customers: move all invoices from fromId to intoId and remove fromId.
+ * @param {Array} customers
+ * @param {Array} invoices
+ * @param {string} fromId
+ * @param {string} intoId
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normFromId = normalizeId(fromId);
+  const normIntoId = normalizeId(intoId);
+
+  if (normFromId === normIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  const fromExists = customers.some((c) => c.id === normFromId);
+  const intoExists = customers.some((c) => c.id === normIntoId);
+
+  if (!fromExists || !intoExists) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const newCustomers = customers.filter((c) => c.id !== normFromId);
+  const newInvoices = invoices.map((inv) =>
+    inv.customerId === normFromId ? { ...inv, customerId: normIntoId } : inv,
+  );
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
