+import { roundCents } from './money.js';
+
+/**
+ * Check if a discount percent value is valid.
+ * @param {number} value
+ * @returns {boolean}
+ */
+export function isValidDiscountPercent(value) {
+  return typeof value === 'number' && value >= 0 && value <= 100;
+}
+
+/**
+ * Calculate the total for a single invoice line (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount amount for a single invoice line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const discountPercent = line.discountPercent ?? 0;
+  const discount = roundCents(lineTotal(line) * discountPercent / 100);
+  return Math.max(0, discount);
+}
+
+/**
+ * Calculate the VAT amount for a single invoice line.
+ * VAT is computed on the amount after discount, rounded per line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const lineAmountBeforeVAT = lineTotal(line) - lineDiscount(line);
+  const vat = roundCents(lineAmountBeforeVAT * line.vatRate / 100);
+  return Math.max(0, vat);
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+  for (const line of invoice.lines) {
+    subtotal += lineTotal(line);
+    discount += lineDiscount(line);
+    vat += lineVAT(line);
+  }
+  const voucherAmount = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucherAmount);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher: voucherAmount,
+    total,
+  };
+}
