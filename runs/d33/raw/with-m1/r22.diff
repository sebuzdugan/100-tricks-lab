+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals, isValidDiscountPercent } from '../src/totals.js';
+
+test('isValidDiscountPercent accepts 0', () => {
+  assert.equal(isValidDiscountPercent(0), true);
+});
+
+test('isValidDiscountPercent accepts values between 0 and 100', () => {
+  assert.equal(isValidDiscountPercent(10), true);
+  assert.equal(isValidDiscountPercent(50), true);
+  assert.equal(isValidDiscountPercent(100), true);
+});
+
+test('isValidDiscountPercent accepts decimal values', () => {
+  assert.equal(isValidDiscountPercent(12.5), true);
+  assert.equal(isValidDiscountPercent(2.5), true);
+});
+
+test('isValidDiscountPercent rejects negative values', () => {
+  assert.equal(isValidDiscountPercent(-1), false);
+  assert.equal(isValidDiscountPercent(-10), false);
+});
+
+test('isValidDiscountPercent rejects values > 100', () => {
+  assert.equal(isValidDiscountPercent(101), false);
+  assert.equal(isValidDiscountPercent(200), false);
+});
+
+test('isValidDiscountPercent rejects non-number values', () => {
+  assert.equal(isValidDiscountPercent('10'), false);
+  assert.equal(isValidDiscountPercent(null), false);
+  assert.equal(isValidDiscountPercent(undefined), false);
+});
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 120000 }), 120000);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 37 }), 370);
+});
+
+test('lineTotal works with qty of 1', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 9500 }), 9500);
+});
+
+test('lineTotal with large quantities', () => {
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 10000 }), 10000000);
+});
+
+test('lineDiscount returns 0 when no discount', () => {
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 1000 }), 0);
+});
+
+test('lineDiscount returns 0 when discountPercent is 0', () => {
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 1000, discountPercent: 0 }), 0);
+});
+
+test('lineDiscount calculates discount as lineTotal * percent / 100', () => {
+  // lineTotal = 5 * 1000 = 5000, discount = 5000 * 10 / 100 = 500
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 1000, discountPercent: 10 }), 500);
+});
+
+test('lineDiscount handles decimal percentages', () => {
+  // lineTotal = 100 * 100 = 10000, discount = 10000 * 12.5 / 100 = 1250
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 100, discountPercent: 12.5 }), 1250);
+});
+
+test('lineDiscount handles 100% discount', () => {
+  // lineTotal = 5 * 1000 = 5000, discount = 5000 * 100 / 100 = 5000
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 1000, discountPercent: 100 }), 5000);
+});
+
+test('lineDiscount clamps negative results at 0', () => {
+  const line = { qty: 1, unitPrice: 100 };
+  const discount = lineDiscount(line);
+  assert.equal(discount >= 0, true);
+});
+
+test('lineVAT returns 0 when vatRate is 0', () => {
+  const line = { qty: 5, unitPrice: 1000, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT calculates VAT on line amount before discount', () => {
+  // Line: 10 * 100 = 1000, no discount, VAT 21% = 1000 * 21 / 100 = 210
+  const line = { qty: 10, unitPrice: 100, vatRate: 21 };
+  assert.equal(lineVAT(line), 210);
+});
+
+test('lineVAT calculates VAT after discount is applied', () => {
+  // Line: 10 * 100 = 1000, discount 10% = 100, after discount = 900, VAT 21% = 900 * 21 / 100 = 189
+  const line = { qty: 10, unitPrice: 100, discountPercent: 10, vatRate: 21 };
+  assert.equal(lineVAT(line), 189);
+});
+
+test('lineVAT rounds per line', () => {
+  // Line: 100 * 100 = 10000, discount 0%, VAT 9% = 10000 * 9 / 100 = 900
+  const line = { qty: 100, unitPrice: 100, vatRate: 9 };
+  assert.equal(lineVAT(line), 900);
+});
+
+test('lineVAT handles decimal VAT rates', () => {
+  // Test with 9% VAT
+  const line = { qty: 3, unitPrice: 500, vatRate: 9 };
+  // Amount = 1500, VAT = 1500 * 9 / 100 = 135
+  assert.equal(lineVAT(line), 135);
+});
+
+test('lineVAT clamps result at 0', () => {
+  const line = { qty: 1, unitPrice: 100, vatRate: 0 };
+  assert.equal(lineVAT(line) >= 0, true);
+});
+
+test('invoiceTotals sums line totals for single line', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 42500);
+});
+
+test('invoiceTotals sums line totals for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, vatRate: 0 },
+      { qty: 8, unitPrice: 9500, vatRate: 0 },
+      { qty: 3, unitPrice: 980, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 2 * 8500 + 8 * 9500 + 3 * 980);
+  assert.equal(totals.subtotal, 17000 + 76000 + 2940);
+  assert.equal(totals.subtotal, 95940);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 95940);
+});
+
+test('invoiceTotals returns new object on each call', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 0 }],
+  };
+  const totals1 = invoiceTotals(invoice);
+  const totals2 = invoiceTotals(invoice);
+  assert.notEqual(totals1, totals2);
+  assert.deepEqual(totals1, totals2);
+});
+
+test('invoiceTotals with empty lines', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals returns subtotal, discount, vat, and total', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1000, discountPercent: 10, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 500);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 4500);
+});
+
+test('invoiceTotals calculates total as subtotal minus discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 100, discountPercent: 20, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 2000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 8000);
+});
+
+test('invoiceTotals sums discounts from multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1000, discountPercent: 10, vatRate: 0 },
+      { qty: 10, unitPrice: 500, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000 + 5000);
+  assert.equal(totals.discount, 500 + 1000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 10000 - 1500);
+});
+
+test('invoiceTotals with no discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1000, vatRate: 0 },
+      { qty: 10, unitPrice: 500, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 10000);
+});
+
+test('invoiceTotals clamps total at 0 if discounts exceed subtotal', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 100, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100);
+  assert.equal(totals.discount, 100);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes VAT in calculation', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 100, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal = 10000, discount = 0, VAT = 10000 * 21 / 100 = 2100
+  // total = 10000 - 0 + 2100 = 12100
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.total, 12100);
+});
+
+test('invoiceTotals with multiple VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, vatRate: 21 }, // 10000, VAT = 2100
+      { qty: 100, unitPrice: 100, vatRate: 9 },  // 10000, VAT = 900
+      { qty: 100, unitPrice: 100, vatRate: 0 },  // 10000, VAT = 0
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 30000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 3000); // 2100 + 900 + 0
+  assert.equal(totals.total, 33000);
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal = 10000, discount = 1000, amount = 9000, VAT = 9000 * 21 / 100 = 1890
+  // total = 10000 - 1000 + 1890 = 10890
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1000);
+  assert.equal(totals.vat, 1890);
+  assert.equal(totals.total, 10890);
+});
+
+test('invoiceTotals per-line VAT rounding with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 500, vatRate: 9 },  // 1500, VAT = 135
+      { qty: 2, unitPrice: 1000, vatRate: 21 }, // 2000, VAT = 420
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 3500);
+  assert.equal(totals.vat, 555); // 135 + 420, not (3500 * avg_rate)
+  assert.equal(totals.total, 4055);
+});
+
+test('invoiceTotals clamped total with high VAT', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 100, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal = 100, discount = 100, amount after discount = 0, VAT = 0
+  // total = 100 - 100 + 0 = 0 (clamped)
+  assert.equal(totals.subtotal, 100);
+  assert.equal(totals.discount, 100);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with VAT preserves total = subtotal - discount + vat', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal = 1000, discount = 100, after discount = 900, VAT = 900 * 21 / 100 = 189
+  // total = 1000 - 100 + 189 = 1089
+  assert.equal(totals.subtotal, 1000);
+  assert.equal(totals.discount, 100);
+  assert.equal(totals.vat, 189);
+  assert.equal(totals.total, 1089);
+});
+
+test('invoiceTotals includes voucher with value 0 when none applied', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals deducts voucher from total', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const totals1 = invoiceTotals(invoice);
+  const totalBefore = totals1.total;
+
+  const vouchered = {
+    lines: invoice.lines,
+    voucher: { code: 'SAVE10', amount: 5000 },
+  };
+  const totals2 = invoiceTotals(vouchered);
+  assert.equal(totals2.voucher, 5000);
+  assert.equal(totals2.total, totalBefore - 5000);
+});
+
+test('invoiceTotals clamps total at 0 when voucher exceeds subtotal + vat', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, vatRate: 21 }],
+    voucher: { code: 'SAVE', amount: 100000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals handles complex scenario with multiple lines, discounts, VAT, and voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 3, unitPrice: 500, discountPercent: 5, vatRate: 9 },
+    ],
+    voucher: { code: 'PROMO', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: 2 * 1000 = 2000, discount 10% = 200, after discount = 1800, VAT 21% = 378
+  // Line 2: 3 * 500 = 1500, discount 5% = 75, after discount = 1425, VAT 9% = 128.25 → 128
+  // Subtotal: 2000 + 1500 = 3500
+  // Discount: 200 + 75 = 275
+  // VAT: 378 + 128 = 506
+  // Voucher: 500
+  // Total: 3500 - 275 + 506 - 500 = 3231
+  assert.equal(totals.subtotal, 3500);
+  assert.equal(totals.discount, 275);
+  assert.equal(totals.vat, 506);
+  assert.equal(totals.voucher, 500);
+  assert.equal(totals.total, 3231);
+});
