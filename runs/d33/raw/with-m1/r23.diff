 /**
  * Calculate the discount amount for a single invoice line.
+ * Includes line discount (explicit or tier) and bulk discount (2.5% for qty >= 10).
+ * Bulk discount is applied after the line discount, to the amount that remains.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
   const discountPercent = line.discountPercent ?? 0;
-  const discount = roundCents(lineTotal(line) * discountPercent / 100);
-  return Math.max(0, discount);
+  const lineDiscountAmount = roundCents(lineTotal(line) * discountPercent / 100);
+  const amountAfterLineDiscount = lineTotal(line) - lineDiscountAmount;
+
+  let bulkDiscountAmount = 0;
+  if (line.qty >= 10) {
+    bulkDiscountAmount = roundCents(amountAfterLineDiscount * 2.5 / 100);
+  }
+
+  const totalDiscount = lineDiscountAmount + bulkDiscountAmount;
+  return Math.max(0, totalDiscount);
 }
 
