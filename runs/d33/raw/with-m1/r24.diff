 import { balanceDue } from './payments.js';
 import { daysBetween } from './dates.js';
-import { lineTotal, lineDiscount, lineVAT } from './invoices.js';
+import { lineTotal, lineDiscount, lineVAT } from './totals.js';
 import { roundCents } from './money.js';
 
 /**
@@ -74,3 +74,51 @@ export function lateFee(invoice, asOf) {
   const fee = roundCents(due * 0.04 / 100 * daysOverdue);
   return Math.max(0, fee);
 }
+
+/**
+ * Generate a dashboard summary of invoicing metrics.
+ * @param {Array<{ customerId: string, status: string, dueDate: string, payments?: Array<{ amount: number, date: string }>, lines: Array, voucher?: { code: string, amount: number } }>} invoices
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = new Map();
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] || 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      const cId = invoice.customerId;
+      customerDue.set(cId, (customerDue.get(cId) || 0) + due);
+    }
+  }
+
+  const overdueList = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const topCustomers = Array.from(customerDue.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
