+  const draft = createTestInvoice('C-001', '2026-10-01');
+  const issued = issueTestInvoice('C-001', '2026-10-05');
+  const paid = issueTestInvoice('C-002', '2026-10-10');
+  const totals = invoiceTotals(paid);
+  const paidInvoice = recordPayment(paid, { amount: totals.total, date: '2026-10-15' }).value;
