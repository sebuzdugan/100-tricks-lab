+ * @param {{ customerId: string, number?: string, status: string, dueDate?: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number, date: string }> }} invoice
