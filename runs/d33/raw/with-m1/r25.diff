@@ -22,20 +25,48 @@ export function renderInvoiceText(invoice) {
   // Customer name
   lines.push(customer.name);
 
-  // Invoice lines
+  // Invoice lines with optional discount info
   for (const line of invoice.lines) {
-    const lineTotal = line.qty * line.unitPrice;
+    const lineTotal_ = lineTotal(line);
     const unitPriceStr = formatEuros(line.unitPrice);
-    const lineTotalStr = formatEuros(lineTotal);
-    lines.push(`${line.qty} x ${line.name} @ ${unitPriceStr} = ${lineTotalStr}`);
+    const lineTotalStr = formatEuros(lineTotal_);
+    let lineStr = `${line.qty} x ${line.name} @ ${unitPriceStr} = ${lineTotalStr}`;
+
+    // Add discount if present
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      lineStr += ` (-${formatEuros(discount)})`;
+    }
+
+    lines.push(lineStr);
   }
 
   // Totals
   const totals = invoiceTotals(invoice);
+
+  // Voucher if present
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(totals.voucher)}`);
+  }
+
+  // VAT if present
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Amount paid if payments exist
+  if (invoice.payments && invoice.payments.length > 0) {
+    const due = balanceDue(invoice);
+    const paid = totals.total - due;
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return ok(lines.join('\n'));
 }
