@@ -0,0 +1,178 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice returns an invoice with all required fields', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2025-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(Array.isArray(result.value.lines), true);
+});
+
+test('createInvoice copies product details from catalogue', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[0].qty, 5);
+  assert.equal(result.value.lines[0].unitPrice, 9500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice handles multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[1].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[2].sku, 'LOGO-PACK');
+});
+
+test('createInvoice rejects unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  const formats = [
+    '2025/10/07',
+    '07-10-2025',
+    '2025-10-7',
+    '2025-1-7',
+    '10-07-2025',
+    '2025-13-01',
+    '2025-10-32',
+    'invalid',
+    '',
+    '2025-02-30', // invalid date
+  ];
+
+  for (const dateStr of formats) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' }, `Failed for date: ${dateStr}`);
+  }
+});
+
+test('createInvoice accepts valid dates', () => {
+  const validDates = ['2025-01-01', '2025-12-31', '2000-02-29', '1999-01-01'];
+  for (const dateStr of validDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, true, `Failed for valid date: ${dateStr}`);
+  }
+});
+
+test('createInvoice rejects empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects non-array lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: undefined,
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects non-integer quantity', () => {
+  const invalidQties = [0, -1, 1.5, 'abc', null, undefined];
+
+  for (const qty of invalidQties) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty }],
+    });
+    assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' }, `Failed for qty: ${qty}`);
+  }
+});
+
+test('createInvoice accepts positive integer quantities', () => {
+  for (const qty of [1, 5, 100, 1000]) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty }],
+    });
+    assert.equal(result.ok, true, `Failed for qty: ${qty}`);
+  }
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input arguments', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 5 }];
+  const linesCopy = JSON.stringify(lines);
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines,
+  });
+
+  assert.equal(JSON.stringify(lines), linesCopy);
+});
+
+test('createInvoice returns distinct objects on multiple calls', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  };
+
+  const result1 = createInvoice(input);
+  const result2 = createInvoice(input);
+
+  assert.notEqual(result1.value, result2.value);
+  assert.notEqual(result1.value.lines, result2.value.lines);
+  assert.deepEqual(result1.value, result2.value);
+});
