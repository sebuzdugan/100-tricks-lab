@@ -59,3 +60,25 @@ export function createInvoice({ customerId, issueDate, lines }) {
 
   return ok(invoice);
 }
+
+/**
+ * Calculate the total for a single line item (qty × unitPrice, rounded to cents).
+ * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @returns {{ subtotal: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  return {
+    subtotal,
+    total: subtotal,
+  };
+}
