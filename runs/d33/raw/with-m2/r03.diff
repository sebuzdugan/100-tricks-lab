+/**
+ * Add or increase a line on an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} params
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty is a positive integer
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Validate SKU exists and get product details
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+
+  // Check if SKU already exists
+  const existingLineIndex = newLines.findIndex((line) => line.sku === sku);
+  if (existingLineIndex >= 0) {
+    // Increase qty on existing line
+    newLines[existingLineIndex] = {
+      ...newLines[existingLineIndex],
+      qty: newLines[existingLineIndex].qty + qty,
+    };
+  } else {
+    // Add new line
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Remove a line from an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if SKU exists on invoice
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex < 0) return fail('LINE_NOT_FOUND');
+
+  // Check if this is the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new lines array without the target SKU
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
