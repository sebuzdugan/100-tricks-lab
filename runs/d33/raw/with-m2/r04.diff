+++ b/test/numbering.test.js
@@ -0,0 +1,84 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 when no numbers exist', () => {
+  const result = nextInvoiceNumber([], '2025-10-07');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(result, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2024-0099', 'INV-2024-0100'];
+  const result = nextInvoiceNumber(existing, '2025-01-01');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber finds max counter regardless of order', () => {
+  const existing = ['INV-2025-0005', 'INV-2025-0001', 'INV-2025-0010', 'INV-2025-0003'];
+  const result = nextInvoiceNumber(existing, '2025-10-07');
+  assert.equal(result, 'INV-2025-0011');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = [
+    'INV-2024-0100',
+    'INV-2025-0005',
+    'INV-2026-0050',
+  ];
+  const result = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(result, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = [];
+  assert.equal(nextInvoiceNumber(existing, '2025-01-01'), 'INV-2025-0001');
+  assert.equal(nextInvoiceNumber(['INV-2025-0009'], '2025-01-01'), 'INV-2025-0010');
+  assert.equal(nextInvoiceNumber(['INV-2025-0099'], '2025-01-01'), 'INV-2025-0100');
+  assert.equal(nextInvoiceNumber(['INV-2025-0999'], '2025-01-01'), 'INV-2025-1000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = [
+    'INV-2025-0001',
+    'INV-2025-ABC',
+    'INVOICE-2025-0002',
+    'INV-2024-0100',
+    '2025-0003',
+  ];
+  const result = nextInvoiceNumber(existing, '2025-10-07');
+  assert.equal(result, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber handles empty strings and nulls', () => {
+  const existing = ['INV-2025-0001', '', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existing, '2025-10-07');
+  assert.equal(result, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber works across multiple years', () => {
+  const existing = [
+    'INV-2023-0050',
+    'INV-2024-0100',
+    'INV-2025-0010',
+    'INV-2026-0005',
+  ];
+
+  assert.equal(nextInvoiceNumber(existing, '2023-12-31'), 'INV-2023-0051');
+  assert.equal(nextInvoiceNumber(existing, '2024-06-15'), 'INV-2024-0101');
+  assert.equal(nextInvoiceNumber(existing, '2025-03-20'), 'INV-2025-0011');
+  assert.equal(nextInvoiceNumber(existing, '2026-11-10'), 'INV-2026-0006');
+  assert.equal(nextInvoiceNumber(existing, '2027-01-01'), 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber extracts year correctly from issueDate', () => {
+  const existing = [];
+  assert.equal(nextInvoiceNumber(existing, '2000-01-01'), 'INV-2000-0001');
+  assert.equal(nextInvoiceNumber(existing, '1999-12-31'), 'INV-1999-0001');
+  assert.equal(nextInvoiceNumber(existing, '2099-06-15'), 'INV-2099-0001');
+});
