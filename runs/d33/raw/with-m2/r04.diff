--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,27 @@
+/**
+ * Calculate the next invoice number for a given issue date.
+ * Format: INV-<year>-<counter>, where counter is 4 digits, zero-padded.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (e.g., ['INV-2025-0001'])
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Find all numbers from the same year
+  const sameYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((num) => !isNaN(num));
+
+  // Find the highest counter, or 0 if none exist
+  const maxCounter = sameYearNumbers.length > 0 ? Math.max(...sameYearNumbers) : 0;
+
+  // Return the next counter
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
