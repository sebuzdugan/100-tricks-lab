+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to a customer.
+ * @param {{ customerId: string, issueDate: string, status: string, number?: string, lines: Array }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  // Build the invoice number line
+  const numberLine = invoice.number ? invoice.number : 'DRAFT';
+
+  // Build line items
+  const lineItems = invoice.lines.map((line) => {
+    const total = lineTotal(line);
+    return `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+  });
+
+  // Build totals
+  const totals = invoiceTotals(invoice);
+
+  // Assemble the full text
+  const lines = [numberLine, customerName, ...lineItems, `Total: ${formatEuros(totals.total)}`];
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
