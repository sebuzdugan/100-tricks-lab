+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const text = renderInvoiceText(issuedResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2025-0001');
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText formats single line item', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.match(lines[2], /^5 × Development \(hour\) @ €95\.00 = €475\.00$/);
+  assert.equal(lines[3], 'Total: €475.00');
+});
+
+test('renderInvoiceText formats multiple line items', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /^10 × Development \(hour\) @ €95\.00 = €950\.00$/);
+  assert.match(lines[3], /^5 × Design work \(hour\) @ €85\.00 = €425\.00$/);
+  assert.equal(lines[4], 'Total: €1,375.00');
+});
+
+test('renderInvoiceText uses formatEuros for all amounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  // Check that amounts are formatted with thousands separator and proper decimal places
+  assert.match(text, /€1,200\.00/); // LOGO-PACK: 120000 cents = €1,200.00
+  assert.match(text, /€2,450\.00/); // BRAND-BOOK: 245000 cents = €2,450.00
+  assert.match(text, /Total: €3,650\.00/);
+});
+
+test('renderInvoiceText with inexpensive items', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  // STICKER: 100 × 50 cents = 5000 cents = €50.00
+  assert.match(lines[2], /100 × Sticker sheet @ €0\.50 = €50\.00/);
+  assert.equal(lines[3], 'Total: €50.00');
+});
+
+test('renderInvoiceText with complex amounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'WORKSHOP-DAY', qty: 2 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  // DEV-HOUR: 3 × 9500 = 28500 cents = €285.00
+  // WORKSHOP-DAY: 2 × 60000 = 120000 cents = €1,200.00
+  // Total: €1,485.00
+  assert.match(lines[2], /3 × Development \(hour\) @ €95\.00 = €285\.00/);
+  assert.match(lines[3], /2 × Brand workshop \(day, VAT exempt\) @ €600\.00 = €1,200\.00/);
+  assert.equal(lines[4], 'Total: €1,485.00');
+});
+
+test('renderInvoiceText with unknown customer', () => {
+  const invoice = {
+    customerId: 'C-UNKNOWN',
+    issueDate: '2025-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 5,
+        unitPrice: 9500,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Unknown Customer');
+});
+
+test('renderInvoiceText line count matches structure', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  // number + customer + 3 line items + total = 6 lines
+  assert.equal(lines.length, 6);
+});
+
+test('renderInvoiceText with issued invoice has full information', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2024-06-15',
+    lines: [{ sku: 'SUPPORT-HOUR', qty: 8 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, ['INV-2024-0050']);
+  const text = renderInvoiceText(issuedResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2024-0051');
+  assert.equal(lines[1], 'Orchard Health');
+  assert.match(lines[2], /8 × Support \(hour\) @ €72\.50 = €580\.00/);
+  assert.equal(lines[3], 'Total: €580.00');
+});
+
+test('renderInvoiceText is deterministic', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+
+  const text1 = renderInvoiceText(invoiceResult.value);
+  const text2 = renderInvoiceText(invoiceResult.value);
+
+  assert.equal(text1, text2);
+});
+
+test('renderInvoiceText handles product names with special characters', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'BRAND-BOOK',
+        name: 'Brand guidelines document',
+        qty: 1,
+        unitPrice: 245000,
+        vatRate: 21,
+      },
+      {
+        sku: 'PRINT-A4',
+        name: 'Printed flyer A4 (each)',
+        qty: 500,
+        unitPrice: 37,
+        vatRate: 9,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /Brand guidelines document/);
+  assert.match(lines[3], /Printed flyer A4 \(each\)/);
+});
