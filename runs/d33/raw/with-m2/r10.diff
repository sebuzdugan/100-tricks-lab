+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  const validDates = [
+    '2025-01-01',
+    '2025-12-31',
+    '2000-02-29', // leap year
+    '1999-01-15',
+    '2024-06-30',
+  ];
+
+  for (const date of validDates) {
+    assert.equal(isValidDate(date), true, `Failed for date: ${date}`);
+  }
+});
+
+test('isValidDate rejects invalid date format', () => {
+  const invalidFormats = [
+    '2025/01/01',
+    '01-01-2025',
+    '2025-1-1',
+    '2025-01-1',
+    '2025-13-01',
+    '2025-01-32',
+    '2025-02-30',
+    'invalid',
+    '2025-02-29', // not a leap year
+    '',
+    '2025-01',
+  ];
+
+  for (const date of invalidFormats) {
+    assert.equal(isValidDate(date), false, `Failed for date: ${date}`);
+  }
+});
+
+test('isValidDate rejects invalid months', () => {
+  const invalidMonths = ['2025-00-01', '2025-13-01', '2025-14-15'];
+
+  for (const date of invalidMonths) {
+    assert.equal(isValidDate(date), false, `Failed for date: ${date}`);
+  }
+});
+
+test('isValidDate rejects invalid days', () => {
+  const invalidDays = ['2025-01-00', '2025-01-32', '2025-02-30', '2025-04-31'];
+
+  for (const date of invalidDays) {
+    assert.equal(isValidDate(date), false, `Failed for date: ${date}`);
+  }
+});
+
+test('isValidDate handles leap years correctly', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('2025-02-29'), false); // not a leap year
+  assert.equal(isValidDate('2000-02-29'), true); // century leap year
+  assert.equal(isValidDate('1900-02-29'), false); // not a leap year
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-01-01', 1), '2025-01-02');
+  assert.equal(addDays('2025-01-01', 7), '2025-01-08');
+  assert.equal(addDays('2025-01-01', 31), '2025-02-01');
+});
+
+test('addDays adds negative days', () => {
+  assert.equal(addDays('2025-01-02', -1), '2025-01-01');
+  assert.equal(addDays('2025-01-08', -7), '2025-01-01');
+  assert.equal(addDays('2025-02-01', -31), '2025-01-01');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // leap year
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+  assert.equal(addDays('2025-12-31', 365), '2026-12-31');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2025-01-15', 0), '2025-01-15');
+});
+
+test('addDays is consistent with multiple calls', () => {
+  const result1 = addDays('2025-01-01', 10);
+  const result2 = addDays(addDays('2025-01-01', 5), 5);
+  assert.equal(result1, result2);
+});
+
+test('daysBetween returns 0 for same date', () => {
+  assert.equal(daysBetween('2025-01-01', '2025-01-01'), 0);
+  assert.equal(daysBetween('2025-12-31', '2025-12-31'), 0);
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2025-01-01', '2025-01-02'), 1);
+  assert.equal(daysBetween('2025-01-01', '2025-01-08'), 7);
+  assert.equal(daysBetween('2025-01-01', '2025-02-01'), 31);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2025-01-02', '2025-01-01'), -1);
+  assert.equal(daysBetween('2025-01-08', '2025-01-01'), -7);
+  assert.equal(daysBetween('2025-02-01', '2025-01-01'), -31);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2025-01-31', '2025-02-01'), 1);
+  assert.equal(daysBetween('2025-02-01', '2025-01-31'), -1);
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2024-12-31'), -1);
+});
+
+test('daysBetween calculates large differences', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is leap year
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+  assert.equal(daysBetween('2020-01-01', '2030-01-01'), 3653); // 10 years with 2 leap years
+});
+
+test('daysBetween is consistent with addDays', () => {
+  const startDate = '2025-06-15';
+  const daysToAdd = 47;
+  const endDate = addDays(startDate, daysToAdd);
+  assert.equal(daysBetween(startDate, endDate), daysToAdd);
+});
+
+test('daysBetween is antisymmetric', () => {
+  const a = '2025-01-15';
+  const b = '2025-06-20';
+  assert.equal(daysBetween(a, b), -daysBetween(b, a));
+});
+
+test('addDays and daysBetween work together correctly', () => {
+  const startDate = '2024-02-15';
+  const days = 100;
+  const endDate = addDays(startDate, days);
+  assert.equal(daysBetween(startDate, endDate), days);
+});
+
+test('date operations work across leap years', () => {
+  // 2024 is a leap year, 2025 is not
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2); // leap year has 29 days
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1); // non-leap year has 28 days
+});
+
+test('addDays works with large positive values', () => {
+  const result = addDays('2025-01-01', 1000);
+  assert.equal(daysBetween('2025-01-01', result), 1000);
+});
+
+test('addDays works with large negative values', () => {
+  const result = addDays('2025-12-31', -365);
+  assert.equal(daysBetween(result, '2025-12-31'), 365);
+});
