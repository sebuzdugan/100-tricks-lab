+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a valid date (UTC).
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(text);
+  if (!match) return false;
+
+  // Parse the date in UTC by creating a Date from components
+  const [year, month, day] = text.split('-').map(Number);
+
+  // Validate ranges
+  if (month < 1 || month > 12) return false;
+  if (day < 1 || day > 31) return false;
+
+  // Create UTC date and verify it's valid (handles day-of-month validation)
+  const date = new Date(Date.UTC(year, month - 1, day));
+  const dateStr = date.toISOString().split('T')[0];
+
+  return dateStr === text;
+}
+
+/**
+ * Add n days to a date string, returning a new date string in YYYY-MM-DD format (UTC).
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - New date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const [year, month, day] = dateStr.split('-').map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day));
+
+  // Add days in UTC
+  date.setUTCDate(date.getUTCDate() + n);
+
+  // Format back to YYYY-MM-DD
+  const y = date.getUTCFullYear();
+  const m = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const d = String(date.getUTCDate()).padStart(2, '0');
+
+  return `${y}-${m}-${d}`;
+}
+
+/**
+ * Calculate the number of whole days between two dates (b minus a, in UTC).
+ * @param {string} a - Start date in YYYY-MM-DD format
+ * @param {string} b - End date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const [ya, ma, da] = a.split('-').map(Number);
+  const [yb, mb, db] = b.split('-').map(Number);
+
+  const dateA = new Date(Date.UTC(ya, ma - 1, da));
+  const dateB = new Date(Date.UTC(yb, mb - 1, db));
+
+  // Calculate difference in milliseconds, then convert to whole days
+  const diffMs = dateB.getTime() - dateA.getTime();
+  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
+
+  return diffDays;
+}
