+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment towards an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, number?: string, lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} params
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check status is issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Check amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate how much is still owed
+  const owed = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array with the new payment added
+  const payments = invoice.payments ? [...invoice.payments] : [];
+  payments.push({ amount, date });
+
+  // Calculate new total paid
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  const invoiceTotal = invoiceTotals(invoice).total;
+
+  // Determine new status
+  let newStatus;
+  if (totalPaid >= invoiceTotal) {
+    newStatus = 'paid';
+  } else {
+    newStatus = 'partially_paid';
+  }
+
+  const newInvoice = {
+    ...invoice,
+    payments,
+    status: newStatus,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Calculate the balance due on an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPaid = invoice.payments
+    ? invoice.payments.reduce((sum, payment) => sum + payment.amount, 0)
+    : 0;
+  return Math.max(0, totals.total - totalPaid);
+}
