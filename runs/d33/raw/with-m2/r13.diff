@@ -280,3 +282,29 @@ export function issueInvoice(invoice, existingNumbers) {
 
   return ok(newInvoice);
 }
+
+/**
+ * Apply a voucher to an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, voucher?: object }} invoice
+ * @param {{ code: string, amount: number }} params
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check voucher doesn't already exist
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Check amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const newInvoice = {
+    ...invoice,
+    voucher: { code, amount },
+  };
+
+  return ok(newInvoice);
+}
