+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId, issueDate, qty = 5) {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DEV-HOUR', qty }],
+  });
+  const issued = issueInvoice(result.value, []);
+  return issued.value;
+}
+
+test('statement rejects unknown customer', () => {
+  const result = statement('C-999', [], '2025-10-07');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement returns empty invoices for customer with no invoices', () => {
+  const result = statement('C-001', [], '2025-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement normalizes customer ID', () => {
+  const result = statement(' c-001 ', [], '2025-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement returns issued invoices for customer', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals = invoiceTotals(invoice);
+
+  const result = statement('C-001', [invoice], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice.number);
+  assert.equal(result.value.invoices[0].issueDate, '2025-10-07');
+  assert.equal(result.value.invoices[0].dueDate, invoice.dueDate);
+  assert.equal(result.value.invoices[0].total, totals.total);
+});
+
+test('statement only includes invoices on or before asOf date', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-10-05');
+  const invoice2 = createAndIssueInvoice('C-001', '2025-10-07');
+  const invoice3 = createAndIssueInvoice('C-001', '2025-10-10');
+
+  const result = statement('C-001', [invoice1, invoice2, invoice3], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2025-10-05');
+  assert.equal(result.value.invoices[1].issueDate, '2025-10-07');
+});
+
+test('statement excludes draft invoices', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const issued = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const result = statement('C-001', [draftResult.value, issued], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, issued.number);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals = invoiceTotals(invoice);
+
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2025-10-08' });
+  assert.equal(paid.ok, true);
+
+  const result = statement('C-001', [paid.value], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals = invoiceTotals(invoice);
+
+  const partialPayment = recordPayment(invoice, { amount: 20000, date: '2025-10-08' });
+  assert.equal(partialPayment.ok, true);
+
+  const result = statement('C-001', [partialPayment.value], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, totals.total - 20000);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-10-10');
+  const invoice2 = createAndIssueInvoice('C-001', '2025-10-05');
+  const invoice3 = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const result = statement('C-001', [invoice1, invoice2, invoice3], '2025-10-10');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2025-10-05');
+  assert.equal(result.value.invoices[1].issueDate, '2025-10-07');
+  assert.equal(result.value.invoices[2].issueDate, '2025-10-10');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-10-05');
+  const invoice2 = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const result = statement('C-001', [invoice1, invoice2], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  const expectedTotalDue = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(result.value.totalDue, expectedTotalDue);
+});
+
+test('statement includes multiple invoices for same customer', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-10-05', 5);
+  const invoice2 = createAndIssueInvoice('C-001', '2025-10-07', 10);
+
+  const result = statement('C-001', [invoice1, invoice2], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert(result.value.totalDue > 0);
+});
+
+test('statement excludes other customers invoices', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-10-07');
+  const invoice2 = createAndIssueInvoice('C-002', '2025-10-07');
+  const invoice3 = createAndIssueInvoice('C-001', '2025-10-08');
+
+  const result = statement('C-001', [invoice1, invoice2, invoice3], '2025-10-08');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, invoice1.number);
+  assert.equal(result.value.invoices[1].number, invoice3.number);
+});
+
+test('statement with partial payments', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals = invoiceTotals(invoice);
+
+  const withPayment1 = recordPayment(invoice, { amount: 20000, date: '2025-10-08' });
+  assert.equal(withPayment1.ok, true);
+
+  const withPayment2 = recordPayment(withPayment1.value, { amount: 15000, date: '2025-10-09' });
+  assert.equal(withPayment2.ok, true);
+
+  const result = statement('C-001', [withPayment2.value], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, totals.total - 35000);
+  assert.equal(result.value.totalDue, totals.total - 35000);
+});
+
+test('statement includes invoice info fields', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals = invoiceTotals(invoice);
+
+  const result = statement('C-001', [invoice], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  const invoiceEntry = result.value.invoices[0];
+  assert(invoiceEntry.number);
+  assert(invoiceEntry.issueDate);
+  assert(invoiceEntry.dueDate);
+  assert.equal(invoiceEntry.total, totals.total);
+  assert.equal(invoiceEntry.due, totals.total);
+});
+
+test('statement asOf date is exclusive for future dates', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-10-07');
+  const invoice2 = createAndIssueInvoice('C-001', '2025-10-08');
+
+  const resultBefore = statement('C-001', [invoice1, invoice2], '2025-10-07');
+  const resultAfter = statement('C-001', [invoice1, invoice2], '2025-10-08');
+
+  assert.equal(resultBefore.value.invoices.length, 1);
+  assert.equal(resultAfter.value.invoices.length, 2);
+});
+
+test('statement handles mixed invoice states', () => {
+  const issued = createAndIssueInvoice('C-001', '2025-10-05');
+
+  const inv2 = createAndIssueInvoice('C-001', '2025-10-06');
+  const totals2 = invoiceTotals(inv2);
+  const partiallyPaidResult = recordPayment(inv2, { amount: 10000, date: '2025-10-07' });
+  assert.equal(partiallyPaidResult.ok, true);
+  const partiallyPaid = partiallyPaidResult.value;
+
+  const inv3 = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals3 = invoiceTotals(inv3);
+  const paidResult = recordPayment(inv3, { amount: totals3.total, date: '2025-10-08' });
+  assert.equal(paidResult.ok, true);
+  const paid = paidResult.value;
+
+  const result = statement('C-001', [issued, partiallyPaid, paid], '2025-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, issued.number);
+  assert.equal(result.value.invoices[1].number, partiallyPaid.number);
+});
