+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createAndIssueInvoice(customerId, issueDate, qty = 5) {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DEV-HOUR', qty }],
+  });
+  const issued = issueInvoice(result.value, []);
+  return issued.value;
+}
+
+test('createCreditNote rejects draft invoices', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const result = createCreditNote(draftResult.value, { amount: 5000, reason: 'Damaged goods', date: '2025-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects negative amounts', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const result = createCreditNote(invoice, { amount: -5000, reason: 'Refund', date: '2025-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects zero amounts', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const result = createCreditNote(invoice, { amount: 0, reason: 'Refund', date: '2025-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects non-integer amounts', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const result = createCreditNote(invoice, { amount: 5000.50, reason: 'Refund', date: '2025-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects amounts exceeding invoice total', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: totals.total + 1, reason: 'Refund', date: '2025-10-08' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote accepts valid credit note on issued invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Damaged goods', date: '2025-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Damaged goods');
+  assert.equal(result.value.date, '2025-10-08');
+});
+
+test('createCreditNote generates correct CN number format', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2025-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.match(result.value.number, /^CN-\d{4}-\d{4}$/);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote accepts up to invoice total amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2025-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote increments counter for same year', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2025-10-07');
+  const invoice2 = createAndIssueInvoice('C-002', '2025-10-08');
+
+  const credit1Result = createCreditNote(invoice1, { amount: 5000, reason: 'Refund', date: '2025-10-09' }, []);
+  assert.equal(credit1Result.ok, true);
+  assert.equal(credit1Result.value.number, 'CN-2025-0001');
+
+  const credit2Result = createCreditNote(invoice2, { amount: 5000, reason: 'Refund', date: '2025-10-10' }, [credit1Result.value.number]);
+  assert.equal(credit2Result.ok, true);
+  assert.equal(credit2Result.value.number, 'CN-2025-0002');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const invoice2024 = createAndIssueInvoice('C-001', '2024-12-31');
+  const invoice2025 = createAndIssueInvoice('C-001', '2025-01-01');
+
+  const credit2024Result = createCreditNote(invoice2024, { amount: 5000, reason: 'Refund', date: '2024-12-31' }, []);
+  assert.equal(credit2024Result.value.number, 'CN-2024-0001');
+
+  const credit2025Result = createCreditNote(invoice2025, { amount: 5000, reason: 'Refund', date: '2025-01-01' }, [credit2024Result.value.number]);
+  assert.equal(credit2025Result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote works on partially_paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const partialPayment = recordPayment(invoice, { amount: 20000, date: '2025-10-08' });
+  assert.equal(partialPayment.ok, true);
+
+  const result = createCreditNote(partialPayment.value, { amount: 5000, reason: 'Defect', date: '2025-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2025-10-08' });
+  assert.equal(paid.ok, true);
+
+  const result = createCreditNote(paid.value, { amount: 5000, reason: 'Overpayment refund', date: '2025-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+});
+
+test('createCreditNote ignores invoice numbers in existingNumbers', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2024-0001'];
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2025-10-08' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const existingNumbers = ['INV-2025-0001', 'CN-2025-0001', 'CN-2025-0002'];
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2025-10-08' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0003');
+});
+
+test('createCreditNote with custom reason text', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const reasons = ['Damaged goods', 'Customer request', 'Price adjustment', 'Overpayment'];
+  for (const reason of reasons) {
+    const result = createCreditNote(invoice, { amount: 1000, reason, date: '2025-10-08' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.reason, reason);
+  }
+});
+
+test('createCreditNote preserves customer ID', () => {
+  const invoice = createAndIssueInvoice('C-002', '2025-10-07');
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2025-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+});
+
+test('createCreditNote with different dates', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07');
+
+  const dates = ['2025-10-08', '2025-10-15', '2025-11-01'];
+  for (const creditDate of dates) {
+    const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: creditDate }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.date, creditDate);
+  }
+});
+
+test('createCreditNote credit note number includes correct year', () => {
+  const invoice2025 = createAndIssueInvoice('C-001', '2025-10-07');
+  const invoice2026 = createAndIssueInvoice('C-001', '2026-01-15');
+
+  const credit2025 = createCreditNote(invoice2025, { amount: 5000, reason: 'Refund', date: '2025-10-08' }, []);
+  assert.equal(credit2025.value.number.substring(3, 7), '2025');
+
+  const credit2026 = createCreditNote(invoice2026, { amount: 5000, reason: 'Refund', date: '2026-01-16' }, [credit2025.value.number]);
+  assert.equal(credit2026.value.number.substring(3, 7), '2026');
+});
+
+test('createCreditNote handles maximum amount equal to total', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-10-07', 1);
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2025-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
