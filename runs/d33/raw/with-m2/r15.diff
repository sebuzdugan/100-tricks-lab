+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the next credit note number for a given issue date.
+ * Format: CN-<year>-<counter>, where counter is 4 digits, zero-padded.
+ * @param {string[]} existingNumbers - Array of all numbers (invoices and credit notes)
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  // Find all credit note numbers from the same year
+  const sameYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((num) => !isNaN(num));
+
+  // Find the highest counter, or 0 if none exist
+  const maxCounter = sameYearNumbers.length > 0 ? Math.max(...sameYearNumbers) : 0;
+
+  // Return the next counter
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ customerId: string, number: string, status: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} params
+ * @param {string[]} existingNumbers - Array of all existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is not draft
+  if (invoice.status === 'draft') return fail('NOT_ISSUED');
+
+  // Check amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check amount doesn't exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
