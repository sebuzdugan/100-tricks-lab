+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('overdueInvoices rejects invalid asOf date', () => {
+  const result = overdueInvoices([], 'not-a-date');
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('overdueInvoices returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2025-10-07');
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const result = overdueInvoices([draftResult.value], '2025-10-07');
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value, []);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+
+  const balanceResult = balanceDue(invoice);
+  const paidResult = recordPayment(invoice, { amount: balanceResult, date: '2025-10-02' });
+
+  const result = overdueInvoices([paidResult.value], '2025-10-07');
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value, []);
+});
+
+test('overdueInvoices excludes invoices with future due dates', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+
+  const result = overdueInvoices([issuedResult.value], '2025-10-05');
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value, []);
+});
+
+test('overdueInvoices includes issued invoices with past due dates', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+
+  const result = overdueInvoices([invoice], '2025-11-10');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].number, invoice.number);
+});
+
+test('overdueInvoices includes partially_paid invoices with past due dates', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+
+  const paymentResult = recordPayment(invoice, { amount: 10000, date: '2025-10-02' });
+
+  const result = overdueInvoices([paymentResult.value], '2025-11-10');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+
+  const result = overdueInvoices([invoice], '2025-11-10');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].daysOverdue, 10);
