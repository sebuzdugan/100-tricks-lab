@@ -26,3 +27,38 @@ export function overdueInvoices(invoices, asOf) {
 
   return ok(overdue);
 }
+
+/**
+ * Generate a VAT summary from invoices.
+ * @param {Array} invoices
+ * @returns {{ ok: true, value: Array<{ rate: number, base: number, vat: number }> }}
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const total = lineTotal(line);
+      const discount = lineDiscount(line);
+      const base = total - discount;
+      const vat = lineVAT(line);
+      const rate = line.vatRate;
+
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { rate, base: 0, vat: 0 });
+      }
+
+      const entry = vatMap.get(rate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  const summary = Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
+
+  return ok(summary);
+}
