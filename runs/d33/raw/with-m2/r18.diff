@@ -2,6 +2,7 @@ import { ok, fail } from './result.js';
 import { isValidDate, daysBetween } from './dates.js';
 import { balanceDue } from './payments.js';
 import { lineTotal, lineDiscount, lineVAT } from './invoices.js';
+import { roundCents } from './money.js';
 
 /**
  * Get overdue invoices as of a given date.
@@ -62,3 +63,29 @@ export function vatSummary(invoices) {
 
   return ok(summary);
 }
+
+/**
+ * Calculate late fee for an invoice.
+ * 0.04% of the amount still due for every day the invoice is overdue.
+ * @param {Object} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lateFee(invoice, asOf) {
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return ok(0);
+  }
+
+  const due = balanceDue(invoice);
+  if (due <= 0) {
+    return ok(0);
+  }
+
+  const fee = roundCents(due * 0.0004 * daysOverdue);
+  return ok(Math.max(0, fee));
+}
