+test('exportCsv returns empty CSV with only header for empty invoices', () => {
+  const result = exportCsv([]);
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
