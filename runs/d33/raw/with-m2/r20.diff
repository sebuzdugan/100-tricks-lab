 }
+
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert cents (EUR) to another currency.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const convertedCents = roundCents(cents * RATES[currency]);
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents in a given currency with appropriate symbol.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function formatMoney(cents, currency) {
+  const convertResult = convert(cents, currency);
+  if (!convertResult.ok) {
+    return convertResult;
+  }
+
+  const amount = (convertResult.value / 100).toFixed(2);
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  const symbol = symbols[currency];
+  return ok(`${symbol}${amount}`);
+}
diff --git a/test/money-currency.test.js b/test/money-currency.test.js
