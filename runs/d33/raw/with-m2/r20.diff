@@ -0,0 +1,197 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { RATES, convert, formatMoney } from '../src/money.js';
+
+test('RATES includes EUR, USD, GBP', () => {
+  assert('EUR' in RATES);
+  assert('USD' in RATES);
+  assert('GBP' in RATES);
+});
+
+test('RATES has correct values', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert rejects unknown currency', () => {
+  const result = convert(10000, 'XYZ');
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert EUR to USD multiplies by rate', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10850);
+});
+
+test('convert EUR to GBP multiplies by rate', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 8425);
+});
+
+test('convert 1 EUR to USD is about 1.08 USD', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 108);
+});
+
+test('convert 1 EUR to GBP is about 0.84 GBP', () => {
+  const result = convert(100, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 84);
+});
+
+test('convert rounds to whole cents', () => {
+  const result = convert(123, 'USD');
+  assert.equal(result.ok, true);
+  assert(Number.isInteger(result.value));
+});
+
+test('convert handles negative amounts', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -10850);
+});
+
+test('convert handles zero', () => {
+  const result = convert(0, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert large amounts correctly', () => {
+  const result = convert(1000000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1085000);
+});
+
+test('formatMoney rejects unknown currency', () => {
+  const result = formatMoney(10000, 'XYZ');
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('formatMoney EUR uses euro symbol', () => {
+  const result = formatMoney(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert(result.value.includes('€'));
+});
+
+test('formatMoney USD uses dollar symbol', () => {
+  const result = formatMoney(10000, 'USD');
+  assert.equal(result.ok, true);
+  assert(result.value.includes('$'));
+});
+
+test('formatMoney GBP uses pound symbol', () => {
+  const result = formatMoney(10000, 'GBP');
+  assert.equal(result.ok, true);
+  assert(result.value.includes('£'));
+});
+
+test('formatMoney formats with 2 decimals', () => {
+  const result = formatMoney(10000, 'EUR');
+  assert.equal(result.ok, true);
+  const parts = result.value.split('.');
+  assert.equal(parts[1].length, 2);
+});
+
+test('formatMoney EUR 10000 cents is €100.00', () => {
+  const result = formatMoney(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, '€100.00');
+});
+
+test('formatMoney USD 10000 EUR cents is $108.50', () => {
+  const result = formatMoney(10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, '$108.50');
+});
+
+test('formatMoney GBP 10000 EUR cents is £84.25', () => {
+  const result = formatMoney(10000, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, '£84.25');
+});
+
+test('formatMoney handles small amounts', () => {
+  const result = formatMoney(50, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, '€0.50');
+});
+
+test('formatMoney handles 1 cent', () => {
+  const result = formatMoney(1, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, '€0.01');
+});
+
+test('formatMoney handles zero', () => {
+  const result = formatMoney(0, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, '€0.00');
+});
+
+test('formatMoney pads cents with leading zero', () => {
+  const result = formatMoney(1050, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, '€10.50');
+});
+
+test('formatMoney handles negative amounts', () => {
+  const result = formatMoney(-10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert(result.value.includes('-'));
+});
+
+test('formatMoney large amounts format correctly', () => {
+  const result = formatMoney(1234567, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, '€12345.67');
+});
+
+test('formatMoney USD handles odd amounts', () => {
+  const result = formatMoney(123, 'USD');
+  assert.equal(result.ok, true);
+  assert(result.value.startsWith('$'));
+  assert(result.value.includes('.'));
+});
+
+test('formatMoney converts then formats correctly', () => {
+  const convertResult = convert(10000, 'USD');
+  const formatResult = formatMoney(10000, 'USD');
+
+  assert.equal(convertResult.ok, true);
+  assert.equal(formatResult.ok, true);
+
+  const formattedValue = formatResult.value;
+  const cents = convertResult.value;
+  const expectedFormatted = `$${(cents / 100).toFixed(2)}`;
+
+  assert.equal(formattedValue, expectedFormatted);
+});
+
+test('convert is consistent across multiple calls', () => {
+  const result1 = convert(10000, 'USD');
+  const result2 = convert(10000, 'USD');
+
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  assert.equal(result1.value, result2.value);
+});
+
+test('formatMoney is consistent across multiple calls', () => {
+  const result1 = formatMoney(10000, 'USD');
+  const result2 = formatMoney(10000, 'USD');
+
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  assert.equal(result1.value, result2.value);
+});
