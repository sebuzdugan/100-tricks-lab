+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'silver' },
+    { id: 'C-003', name: 'Carol', email: 'carol@example.com', tier: 'standard' },
+  ];
+  const invoices = [
+    { customerId: 'C-001', number: 'INV-2025-0001', status: 'issued' },
+    { customerId: 'C-002', number: 'INV-2025-0002', status: 'draft' },
+    { customerId: 'C-001', number: 'INV-2025-0003', status: 'paid' },
+  ];
+
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, 2);
+  assert.equal(r.value.customers.find((c) => c.id === 'C-001'), undefined);
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].customerId, 'C-002');
+  assert.equal(r.value.invoices[1].customerId, 'C-002');
+  assert.equal(r.value.invoices[2].customerId, 'C-002');
+});
+
