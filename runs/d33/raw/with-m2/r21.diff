+/**
+ * Merge two customers: fromId's customer is deleted, all its invoices reassigned to intoId.
+ * @param {any[]} customers
+ * @param {any[]} invoices
+ * @param {string} fromId
+ * @param {string} intoId
+ * @returns {{ ok: true, value: { customers: any[], invoices: any[] } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFrom = normalizeId(fromId);
+  const normalizedInto = normalizeId(intoId);
+
+  if (normalizedFrom === normalizedInto) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  const fromExists = customers.some((c) => c.id === normalizedFrom);
+  const intoExists = customers.some((c) => c.id === normalizedInto);
+
+  if (!fromExists || !intoExists) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const newCustomers = customers.filter((c) => c.id !== normalizedFrom).map((c) => ({ ...c }));
+  const newInvoices = invoices.map((inv) =>
+    inv.customerId === normalizedFrom ? { ...inv, customerId: normalizedInto } : { ...inv }
+  );
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
