+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+// lineTotal tests
+test('lineTotal calculates qty × unitPrice', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 5, unitPrice: 10000, vatRate: 21 };
+  assert.equal(lineTotal(line), 50000);
+});
+
+test('lineTotal handles single quantity', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 1, unitPrice: 9500, vatRate: 21 };
+  assert.equal(lineTotal(line), 9500);
+});
+
+test('lineTotal rounds fractional cents', () => {
+  const line = { sku: 'ODD', name: 'Odd', qty: 3, unitPrice: 333, vatRate: 21 };
+  assert.equal(lineTotal(line), 999);
+});
+
+test('lineTotal rounds half to even', () => {
+  const line = { sku: 'HALF', name: 'Half', qty: 1, unitPrice: 100, vatRate: 21 };
+  assert.equal(lineTotal(line), 100);
+});
+
+test('lineTotal ignores discountPercent', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 5, unitPrice: 10000, vatRate: 21, discountPercent: 50 };
+  assert.equal(lineTotal(line), 50000);
+});
+
+// lineDiscount tests
+test('lineDiscount returns 0 when no discountPercent', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 5, unitPrice: 10000, vatRate: 21 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount calculates discount correctly', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 5, unitPrice: 10000, vatRate: 21, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 5000);
+});
+
+test('lineDiscount with decimal percentage', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 8, unitPrice: 5000, vatRate: 21, discountPercent: 2.5 };
+  assert.equal(lineDiscount(line), 1000);
+});
+
+test('lineDiscount rounds correctly', () => {
+  const line = { sku: 'ODD', name: 'Odd', qty: 3, unitPrice: 333, vatRate: 21, discountPercent: 33.33 };
+  const discount = lineDiscount(line);
+  assert.ok(Number.isInteger(discount));
+  assert.ok(discount >= 0);
+});
+
+test('lineDiscount with 0% discount', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 5, unitPrice: 10000, vatRate: 21, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 5, unitPrice: 10000, vatRate: 21, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 50000);
+});
+
+test('lineDiscount never goes negative', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 5, unitPrice: 10000, vatRate: 21, discountPercent: -10 };
+  assert.ok(lineDiscount(line) >= 0);
+});
+
+// lineVAT tests
+test('lineVAT calculates VAT correctly', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 5, unitPrice: 10000, vatRate: 21 };
+  const total = lineTotal(line);
+  const expected = Math.round(total * 0.21);
+  assert.equal(lineVAT(line), expected);
+});
+
+test('lineVAT with no discount', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 10, unitPrice: 10000, vatRate: 21 };
+  assert.equal(lineVAT(line), 21000);
+});
+
+test('lineVAT with discount applied', () => {
+  const line = { sku: 'DEV-HOUR', name: 'Development', qty: 5, unitPrice: 10000, vatRate: 21, discountPercent: 10 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const taxableAmount = total - discount;
+  const expected = Math.round(taxableAmount * 0.21);
+  assert.equal(lineVAT(line), expected);
+});
+
+test('lineVAT with 9% VAT rate', () => {
+  const line = { sku: 'FOOD', name: 'Food', qty: 10, unitPrice: 10000, vatRate: 9 };
+  assert.equal(lineVAT(line), 9000);
+});
+
+test('lineVAT with 0% VAT rate (exempt)', () => {
+  const line = { sku: 'EXEMPT', name: 'Exempt', qty: 10, unitPrice: 10000, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT rounds correctly', () => {
