diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..42603c4
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,56 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line item (qty × unitPrice, rounded to cents).
+ * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount amount for a single line item.
+ * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  if (line.discountPercent === undefined) return 0;
+  const total = lineTotal(line);
+  const discount = roundCents(total * line.discountPercent / 100);
+  return Math.max(0, discount);
+}
+
+/**
+ * Calculate the VAT amount for a single line item.
+ * VAT is computed on the line amount after its discount.
+ * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const taxableAmount = total - discount;
+  const vat = roundCents(taxableAmount * line.vatRate / 100);
+  return Math.max(0, vat);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, voucher?: object }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
