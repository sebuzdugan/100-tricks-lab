+/**
+ * Calculate the bulk discount amount for a single line item.
+ * Applied after line discount to what remains. 2.5% off for qty >= 10.
+ * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineBulkDiscount(line) {
+  if (line.qty < 10) return 0;
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const remainingAfterDiscount = total - discount;
+  const bulkDiscount = roundCents(remainingAfterDiscount * 2.5 / 100);
+  return Math.max(0, bulkDiscount);
+}
+
 /**
  * Calculate the VAT amount for a single line item.
- * VAT is computed on the line amount after its discount.
+ * VAT is computed on the line amount after all discounts (line discount and bulk discount).
  * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineVAT(line) {
   const total = lineTotal(line);
   const discount = lineDiscount(line);
-  const taxableAmount = total - discount;
+  const bulkDiscount = lineBulkDiscount(line);
+  const taxableAmount = total - discount - bulkDiscount;
   const vat = roundCents(taxableAmount * line.vatRate / 100);
   return Math.max(0, vat);
 }
