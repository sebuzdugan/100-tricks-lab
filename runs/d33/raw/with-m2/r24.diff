 }
+
+/**
+ * Generate a dashboard summary of invoicing metrics.
+ * @param {Array} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { counts, outstanding, overdue, topCustomers } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    if (invoice.status in counts) {
+      counts[invoice.status]++;
+    }
+  }
+
+  // Calculate outstanding amount (issued + partially_paid)
+  let outstanding = 0;
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      outstanding += balanceDue(invoice);
+    }
+  }
+
+  // Get overdue invoices
+  const overdueResult = overdueInvoices(invoices, asOf);
+  if (!overdueResult.ok) {
+    return overdueResult;
+  }
+
+  const overdueList = overdueResult.value;
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Calculate top 3 customers by amount due
+  const customerDue = new Map();
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const customerId = invoice.customerId;
+      const due = balanceDue(invoice);
+      if (!customerDue.has(customerId)) {
+        customerDue.set(customerId, 0);
+      }
+      customerDue.set(customerId, customerDue.get(customerId) + due);
+    }
+  }
+
+  const topCustomers = Array.from(customerDue.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  });
+}
