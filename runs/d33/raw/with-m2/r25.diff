+  const lines = text.split('\n');
+
+  const voucherLineIndex = lines.findIndex(line => line.startsWith('Voucher:'));
+  const totalLineIndex = lines.findIndex(line => line.startsWith('Total:'));
+  assert(voucherLineIndex > 0, 'Voucher line should exist');
+  assert(voucherLineIndex < totalLineIndex, 'Voucher should be before Total');
+  assert.match(lines[voucherLineIndex], /Voucher: -€50\.00/);
+});
+
