@@ -0,0 +1,121 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched line items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(r.value.lines[0].name, 'Development (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 9500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice with multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-06',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[1].name, 'Sticker sheet');
+});
+
+test('createInvoice returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice returns DATE_INVALID for malformed date', () => {
+  const cases = ['2026-13-01', '2026/10/07', '07-10-2026', '2026-10-7', 'not-a-date', '', 123];
+  for (const issueDate of cases) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.equal(r.ok, false, `should reject: ${issueDate}`);
+    assert.equal(r.error, 'DATE_INVALID', `should reject: ${issueDate}`);
+  }
+});
+
+test('createInvoice returns NO_LINES for empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice returns NO_LINES for missing lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: undefined,
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice returns QTY_INVALID for non-positive quantities', () => {
+  const cases = [0, -1, -100, 1.5, 'five', undefined, null];
+  for (const qty of cases) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty }],
+    });
+    assert.equal(r.ok, false, `should reject qty: ${qty}`);
+    assert.equal(r.error, 'QTY_INVALID', `should reject qty: ${qty}`);
+  }
+});
+
+test('createInvoice returns UNKNOWN_SKU for invalid SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'INVALID-SKU', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice stops at first error in lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'INVALID', qty: 1 },
+    ],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate the input lines array', () => {
+  const input = [{ sku: 'DEV-HOUR', qty: 5 }];
+  const originalLine = { ...input[0] };
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: input,
+  });
+  assert.deepEqual(input[0], originalLine);
+});
