   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   return { subtotal, total: subtotal };
 }
+
+/**
+ * Add a line to an invoice, or increase qty if SKU already exists.
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }}, { sku: string, qty: number }
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!isValidQty(qty)) return fail('QTY_INVALID');
+
+  // Validate and get product
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+
+  // Check if SKU already exists
+  const existingLineIndex = newLines.findIndex((line) => line.sku === sku);
+  if (existingLineIndex !== -1) {
+    newLines[existingLineIndex].qty += qty;
+  } else {
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: 'draft',
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {{ status: string, lines: Array<{ sku: string }> }}, sku: string
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check SKU exists on invoice
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  // Check this isn't the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new lines without this SKU
+  const newLines = invoice.lines.filter((line) => line.sku !== sku).map((line) => ({ ...line }));
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: 'draft',
+    lines: newLines,
+  });
+}
