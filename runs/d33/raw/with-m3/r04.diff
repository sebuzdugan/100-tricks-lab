+/**
+ * Issue a draft invoice by assigning it a number and changing status to 'issued'.
+ * @param {{ status: string, lines: Array, customerId: string, issueDate: string }}, existingNumbers: Array<string>
+ * @returns {{ ok: true, value: { number: string, status: string, ... } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    number,
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: 'issued',
+    lines: invoice.lines.map((line) => ({ ...line })),
+  });
+}
diff --git a/src/numbering.js b/src/numbering.js
new file mode 100644
index 0000000..c6d952c
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,41 @@
+/**
+ * Extract the year from an invoice number string (INV-YYYY-XXXX).
+ * @param {string} invoiceNumber
+ * @returns {number | null}
+ */
+function extractYear(invoiceNumber) {
+  const match = invoiceNumber.match(/^INV-(\d{4})-\d{4}$/);
+  return match ? parseInt(match[1], 10) : null;
+}
+
+/**
+ * Extract the counter from an invoice number string (INV-YYYY-XXXX).
+ * @param {string} invoiceNumber
+ * @returns {number | null}
+ */
+function extractCounter(invoiceNumber) {
+  const match = invoiceNumber.match(/^INV-\d{4}-(\d{4})$/);
+  return match ? parseInt(match[1], 10) : null;
+}
+
+/**
+ * Get the next free invoice number for a given issue date.
+ * @param {Array<string>} existingNumbers - Array of invoice numbers already in use
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} - Next invoice number in format INV-YYYY-XXXX
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = parseInt(issueDate.substring(0, 4), 10);
+
+  // Find all numbers for this year
+  const yearNumbers = existingNumbers
+    .filter((num) => extractYear(num) === year)
+    .map((num) => extractCounter(num))
+    .filter((counter) => counter !== null);
+
+  // Find the highest counter
+  const maxCounter = yearNumbers.length > 0 ? Math.max(...yearNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
