diff --git a/src/render.js b/src/render.js
new file mode 100644
index 0000000..5d542c7
--- /dev/null
+++ b/src/render.js
@@ -0,0 +1,30 @@
+import { formatEuros } from './money.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to customers.
+ * @param {{ number?: string, customerName: string, lines: Array<{ name: string, qty: number, unitPrice: number }> }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // First line: invoice number or "DRAFT"
+  lines.push(invoice.number || 'DRAFT');
+
+  // Second line: customer name
+  lines.push(invoice.customerName);
+
+  // Line items
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `  ${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Total line
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  lines.push(`Total: ${formatEuros(subtotal)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..cbcd660
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,124 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const invoice = {
+    customerName: 'Test Customer',
+    lines: [{ name: 'Test Item', qty: 1, unitPrice: 1000 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [{ name: 'Test Item', qty: 1, unitPrice: 1000 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Northwind Studio',
+    lines: [{ name: 'Test Item', qty: 1, unitPrice: 1000 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText formats line items with qty, name, price, and total', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [{ name: 'Development (hour)', qty: 5, unitPrice: 9500 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5 × Development \(hour\) @ €95\.00 = €475\.00/);
+});
+
+test('renderInvoiceText shows total at the end', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [{ name: 'Item', qty: 1, unitPrice: 1000 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Total: €10\.00$/m);
+});
+
+test('renderInvoiceText with multiple line items', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Kite & Co',
+    lines: [
+      { name: 'Design work (hour)', qty: 3, unitPrice: 8500 },
+      { name: 'Sticker sheet', qty: 100, unitPrice: 50 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.match(lines[2], /3 × Design work \(hour\) @ €85\.00 = €255\.00/);
+  assert.match(lines[3], /100 × Sticker sheet @ €0\.50 = €50\.00/);
+  assert.match(lines[4], /Total: €305\.00/);
+});
+
+test('renderInvoiceText formats prices correctly with cents', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [
+      { name: 'Stock photo licence', qty: 2, unitPrice: 996 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /2 × Stock photo licence @ €9\.96 = €19\.92/);
+  assert.match(text, /Total: €19\.92/);
+});
+
+test('renderInvoiceText with zero-price items', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [
+      { name: 'Paid Item', qty: 1, unitPrice: 5000 },
+      { name: 'Free Item', qty: 1, unitPrice: 0 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /1 × Free Item @ €0\.00 = €0\.00/);
+  assert.match(text, /Total: €50\.00/);
+});
+
+test('renderInvoiceText has proper line breaks', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [
+      { name: 'Item 1', qty: 1, unitPrice: 1000 },
+      { name: 'Item 2', qty: 1, unitPrice: 2000 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // number, customer, item1, item2, total
+});
+
+test('renderInvoiceText with large quantities', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [
+      { name: 'Item', qty: 1000, unitPrice: 100 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /1000 × Item @ €1\.00 = €1,000\.00/);
+  assert.match(text, /Total: €1,000\.00/);
+});
