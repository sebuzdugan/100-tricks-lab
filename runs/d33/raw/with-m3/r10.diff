+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid date strings', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  const cases = ['2026-13-01', '2026/10/07', '07-10-2026', '2026-10-7', 'not-a-date', '', '2026-10-32'];
+  for (const dateStr of cases) {
+    assert.equal(isValidDate(dateStr), false, `should reject: ${dateStr}`);
+  }
+});
+
+test('isValidDate rejects non-string input', () => {
+  const cases = [123, null, undefined, true, { date: '2026-10-07' }, ['2026-10-07']];
+  for (const dateStr of cases) {
+    assert.equal(isValidDate(dateStr), false, `should reject: ${dateStr}`);
+  }
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2026-02-28'), true);
+});
+
+test('isValidDate rejects invalid leap year dates', () => {
+  assert.equal(isValidDate('2026-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 30), '2026-11-06');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+});
+
+test('addDays crosses month boundaries', () => {
+  assert.equal(addDays('2026-10-30', 5), '2026-11-04');
+  assert.equal(addDays('2026-11-05', -10), '2026-10-26');
+});
+
+test('addDays crosses year boundaries', () => {
+  assert.equal(addDays('2026-12-25', 10), '2027-01-04');
+  assert.equal(addDays('2027-01-05', -10), '2026-12-26');
+});
+
+test('addDays with zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays handles leap year transitions', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-02-29', -1), '2024-02-28');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2026-11-06'), 30);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+  assert.equal(daysBetween('2026-11-06', '2026-10-07'), -30);
+});
+
+test('daysBetween with same dates returns zero', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween crosses month boundaries', () => {
+  assert.equal(daysBetween('2026-10-30', '2026-11-04'), 5);
+  assert.equal(daysBetween('2026-11-04', '2026-10-30'), -5);
+});
+
+test('daysBetween crosses year boundaries', () => {
+  assert.equal(daysBetween('2026-12-25', '2027-01-04'), 10);
+  assert.equal(daysBetween('2027-01-04', '2026-12-25'), -10);
+});
+
+test('daysBetween handles large differences', () => {
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+});
+
+test('daysBetween works with leap year', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('isValidDate used in createInvoice context', () => {
+  const validDates = ['2026-10-07', '2026-01-01', '2026-12-31'];
+  const invalidDates = ['2026-13-01', '2026/10/07', 'not-a-date'];
+
+  for (const date of validDates) {
+    assert.equal(isValidDate(date), true, `should accept: ${date}`);
+  }
+
+  for (const date of invalidDates) {
+    assert.equal(isValidDate(date), false, `should reject: ${date}`);
+  }
+});
+
+test('date functions use UTC consistently', () => {
+  const start = '2026-10-07';
+  const end = addDays(start, 5);
+  const diff = daysBetween(start, end);
+  assert.equal(diff, 5);
+});
+
+test('roundtrip: addDays and daysBetween are consistent', () => {
+  const start = '2026-10-07';
+  for (const n of [-100, -1, 0, 1, 100]) {
+    const end = addDays(start, n);
+    const diff = daysBetween(start, end);
+    assert.equal(diff, n, `addDays and daysBetween should be consistent for n=${n}`);
+  }
+});
