@@ -0,0 +1,183 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment adds payment to an issued invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r = recordPayment(issued.value, { amount: 5000, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 5000);
+  assert.equal(r.value.payments[0].date, '2026-10-08');
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment returns NOT_ISSUED for draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const r = recordPayment(draft.value, { amount: 1000, date: '2026-10-08' });
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment returns AMOUNT_INVALID for non-positive amounts', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const testCases = [0, -100, 1.5, 'notanumber', undefined, null];
+  for (const amount of testCases) {
+    const r = recordPayment(issued.value, { amount, date: '2026-10-08' });
+    assert.equal(r.ok, false, `should reject amount: ${amount}`);
+    assert.equal(r.error, 'AMOUNT_INVALID', `should reject amount: ${amount}`);
+  }
+});
+
+test('recordPayment returns OVERPAYMENT if payment exceeds balance', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r = recordPayment(issued.value, { amount: 999999999, date: '2026-10-08' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'OVERPAYMENT');
+});
+
+test('recordPayment sets status to paid when payment covers invoice total', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r = recordPayment(issued.value, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+  assert.equal(r.value.payments.length, 1);
+});
+
+test('recordPayment accumulates multiple payments', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const payment1 = recordPayment(issued.value, { amount: 30000, date: '2026-10-08' });
+  assert.equal(payment1.ok, true);
+  assert.equal(payment1.value.status, 'partially_paid');
+  const payment2 = recordPayment(payment1.value, { amount: totals.total - 30000, date: '2026-10-09' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.status, 'paid');
+  assert.equal(payment2.value.payments.length, 2);
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const partial = recordPayment(issued.value, { amount: 20000, date: '2026-10-08' });
+  assert.equal(partial.ok, true);
+  assert.equal(partial.value.status, 'partially_paid');
+  const r = recordPayment(partial.value, { amount: totals.total - 20000, date: '2026-10-09' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment preserves invoice fields', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r = recordPayment(issued.value, { amount: 1000, date: '2026-10-08' });
+  assert.equal(r.value.customerId, issued.value.customerId);
+  assert.equal(r.value.customerName, issued.value.customerName);
+  assert.equal(r.value.issueDate, issued.value.issueDate);
+  assert.equal(r.value.number, issued.value.number);
+  assert.equal(r.value.lines.length, issued.value.lines.length);
+});
+
+test('recordPayment returns OVERPAYMENT on partial payment if amount exceeds remaining balance', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const partial = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.equal(partial.ok, true);
+  const overpay = recordPayment(partial.value, { amount: totals.total, date: '2026-10-09' });
+  assert.equal(overpay.ok, false);
+  assert.equal(overpay.error, 'OVERPAYMENT');
+});
+
+test('balanceDue returns total minus paid for issued invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const balance = balanceDue(issued.value);
+  assert.equal(balance, totals.total);
+});
+
+test('balanceDue returns remaining balance after partial payment', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const partial = recordPayment(issued.value, { amount: 30000, date: '2026-10-08' });
+  const balance = balanceDue(partial.value);
+  assert.equal(balance, totals.total - 30000);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-08' });
+  const balance = balanceDue(paid.value);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue returns full total for invoice without payments', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const balance = balanceDue(issued.value);
+  assert.equal(typeof balance, 'number');
+  assert.equal(balance > 0, true);
+});
