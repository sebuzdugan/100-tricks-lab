+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Validate that an amount is a positive integer (in cents).
+ * @param {unknown} amount
+ * @returns {boolean}
+ */
+function isValidAmount(amount) {
+  return Number.isInteger(amount) && amount > 0;
+}
+
+/**
+ * Record a payment on an invoice, updating its status and adding to payment history.
+ * @param {{ status: string, lines: Array, payments?: Array<{ amount: number, date: string }>, customerId: string, customerName: string, issueDate: string, number?: string }}, { amount: number, date: string }
+ * @returns {{ ok: true, value: { payments: Array, status: string, ... } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check invoice is issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!isValidAmount(amount)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate what is still owed
+  const totals = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  const owed = totals.total - totalPaid;
+
+  // Check for overpayment
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Add payment to history
+  const newPayments = [...(invoice.payments ?? []), { amount, date }];
+  const newTotalPaid = totalPaid + amount;
+
+  // Determine new status
+  const newStatus = newTotalPaid >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({
+    customerId: invoice.customerId,
+    customerName: invoice.customerName,
+    issueDate: invoice.issueDate,
+    number: invoice.number,
+    status: newStatus,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments: newPayments,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ lines: Array, payments?: Array<{ amount: number }> }}
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
