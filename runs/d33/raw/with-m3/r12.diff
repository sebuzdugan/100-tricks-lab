+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} Due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-').map(Number);
+    const days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+    let daysInMonth = days[month - 1];
+    if (month === 2 && ((year % 4 === 0 && year % 100 !== 0) || year % 400 === 0)) {
+      daysInMonth = 29;
+    }
+    const yyyy = String(year);
+    const mm = String(month).padStart(2, '0');
+    const dd = String(daysInMonth).padStart(2, '0');
+    return `${yyyy}-${mm}-${dd}`;
+  }
+  return null;
+}
