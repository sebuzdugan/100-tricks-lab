+
+/**
+ * Apply a voucher to a draft invoice, reducing the total by a fixed amount.
+ * @param {{ status: string, customerId: string, customerName: string, issueDate: string, terms: string, dueDate: string, lines: Array, voucher?: { code: string, amount: number } }}, { code: string, amount: number }
+ * @returns {{ ok: true, value: { voucher: { code: string, amount: number }, ... } } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check no voucher already applied
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  return ok({
+    customerId: invoice.customerId,
+    customerName: invoice.customerName,
+    issueDate: invoice.issueDate,
+    terms: invoice.terms,
+    dueDate: invoice.dueDate,
+    status: 'draft',
+    lines: invoice.lines.map((line) => ({ ...line })),
+    voucher: { code, amount },
   });
 }
