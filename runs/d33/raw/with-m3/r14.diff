+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate a customer statement showing outstanding invoices and total due.
+ * @param {string} customerId - Customer ID (will be normalized)
+ * @param {Array<{ customerId: string, issueDate: string, dueDate: string, status: string, number: string, lines: Array, payments?: Array, voucher?: { amount: number } }>} invoices - All invoices to filter
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists (normalizeId is called inside getCustomer)
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Filter invoices for this customer with status 'issued', 'partially_paid', or 'paid'
+  // and issueDate on or before asOf
+  const customerInvoices = invoices
+    .filter((inv) => inv.customerId === customerResult.value.id)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate))
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }));
+
+  // Calculate total due
+  const totalDue = customerInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: customerResult.value.id,
+    invoices: customerInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
index 0000000..c0417b1
--- /dev/null
+++ b/test/statements.test.js
@@ -0,0 +1,253 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = statement('C-999', [], '2026-10-07');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement returns DATE_INVALID for invalid asOf date', () => {
+  const r = statement('C-001', [], 'not-a-date');
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('statement with no invoices returns empty list and zero total due', () => {
+  const r = statement('C-001', [], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes only issued invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r = statement('C-001', [draft.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement includes issued invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r = statement('C-001', [issued.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, issued.value.number);
+});
+
+test('statement filters by customer ID', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const draft2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const issued1 = issueInvoice(draft1.value, []);
+  const issued2 = issueInvoice(draft2.value, []);
+  const r = statement('C-001', [issued1.value, issued2.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, issued1.value.number);
+});
+
+test('statement filters by date (issueDate before or on asOf)', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const draft2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued1 = issueInvoice(draft1.value, []);
+  const issued2 = issueInvoice(draft2.value, ['INV-2026-0001']);
+  const r = statement('C-001', [issued1.value, issued2.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-05');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const draft2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const draft3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued1 = issueInvoice(draft1.value, []);
+  const issued2 = issueInvoice(draft2.value, ['INV-2026-0001']);
+  const issued3 = issueInvoice(draft3.value, ['INV-2026-0002']);
+  const r = statement('C-001', [issued1.value, issued2.value, issued3.value], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-08');
+  assert.equal(r.value.invoices[2].issueDate, '2026-10-10');
+});
+
+test('statement includes invoice fields: number, issueDate, dueDate, total, due', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r = statement('C-001', [issued.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  const inv = r.value.invoices[0];
+  assert.equal(typeof inv.number, 'string');
+  assert.match(inv.number, /^INV-/);
+  assert.equal(inv.issueDate, '2026-10-07');
+  assert.equal(inv.dueDate, '2026-10-21');
+  assert.equal(typeof inv.total, 'number');
+  assert.equal(inv.total > 0, true);
+  assert.equal(typeof inv.due, 'number');
+  assert.equal(inv.due > 0, true);
+});
+
+test('statement calculates totalDue as sum of individual dues', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const draft2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-06',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  const issued1 = issueInvoice(draft1.value, []);
+  const issued2 = issueInvoice(draft2.value, ['INV-2026-0001']);
+  const r = statement('C-001', [issued1.value, issued2.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  const sumOfDues = r.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(r.value.totalDue, sumOfDues);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const partial = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  const r = statement('C-001', [partial.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].due > 0, true);
+});
+
+test('statement calculates due amount correctly for partially paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const partial = recordPayment(issued.value, { amount: 5000, date: '2026-10-08' });
+  const r = statement('C-001', [partial.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  const inv = r.value.invoices[0];
+  assert.equal(inv.due, inv.total - 5000);
+});
+
+test('statement excludes paid invoices from due calculation', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-08' });
+  const r = statement('C-001', [paid.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].due, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement with voucher calculates correct total and due', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const withVoucher = applyVoucher(draft.value, { code: 'SUMMER2026', amount: 5000 });
+  const issued = issueInvoice(withVoucher.value, []);
+  const r = statement('C-001', [issued.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  const inv = r.value.invoices[0];
+  assert.equal(inv.due, inv.total);
+  assert.equal(inv.due > 0, true);
+});
+
+test('statement normalizes customer ID', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r1 = statement('C-001', [issued.value], '2026-10-07');
+  const r2 = statement('c-001', [issued.value], '2026-10-07');
+  const r3 = statement(' C-001 ', [issued.value], '2026-10-07');
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+  assert.equal(r3.ok, true);
+  assert.equal(r1.value.invoices.length, 1);
+  assert.equal(r2.value.invoices.length, 1);
+  assert.equal(r3.value.invoices.length, 1);
+});
+
+test('statement on exact asOf date includes invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r = statement('C-001', [issued.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement after asOf date excludes invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r = statement('C-001', [issued.value], '2026-10-06');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
