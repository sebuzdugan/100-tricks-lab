+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the next credit note number for a given issue date.
+ * Format: CN-YYYY-NNNN (where NNNN is a 4-digit counter per year)
+ * @param {Array<string>} existingNumbers - All existing invoice and credit note numbers
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} Next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `CN-${year}-`;
+
+  const creditNoteNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const parts = num.split('-');
+      return parseInt(parts[2], 10);
+    })
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = creditNoteNumbers.length > 0 ? Math.max(...creditNoteNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+
+  return `${prefix}${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array, payments?: Array, voucher?: { amount: number } }}, { amount: number, reason: string, date: string }, existingNumbers: Array<string>
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is issued, partially_paid, or paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const totals = invoiceTotals(invoice);
+  const invoiceTotal = totals.total;
+
+  // Check credit amount doesn't exceed invoice total
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
