+import { ok, fail } from './result.js';
+import { balanceDue } from './payments.js';
+import { isValidDate, daysBetween } from './dates.js';
+
+/**
+ * Generate an overdue invoices report.
+ * @param {Array<{ customerId: string, number: string, dueDate: string, status: string, lines: Array, payments?: Array }>} invoices - All invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }> } | { ok: false, error: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Filter invoices with status 'issued' or 'partially_paid' and dueDate before asOf
+  const overdue = invoices
+    .filter((inv) => (inv.status === 'issued' || inv.status === 'partially_paid'))
+    .filter((inv) => inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return ok(overdue);
+}
