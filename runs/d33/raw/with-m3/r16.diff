+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns DATE_INVALID for invalid asOf date', () => {
+  const r = overdueInvoices([], 'not-a-date');
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('overdueInvoices with no invoices returns empty list', () => {
+  const r = overdueInvoices([], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.deepEqual(r.value, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r = overdueInvoices([draft.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-05' });
+  const r = overdueInvoices([paid.value], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 0);
+});
+
+test('overdueInvoices includes issued invoices with dueDate before asOf', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r = overdueInvoices([issued.value], '2026-10-20');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 1);
+  assert.equal(r.value[0].number, issued.value.number);
+});
+
+test('overdueInvoices excludes issued invoices with dueDate on or after asOf', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(draft.value, []);
+  const r = overdueInvoices([issued.value], '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices with dueDate before asOf', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
