+/**
+ * Generate a VAT summary for issued, partially paid, and paid invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices - All invoices
+ * @returns {{ ok: true, value: Array<{ rate: number, base: number, vat: number }> }}
+ */
+export function vatSummary(invoices) {
+  // Group by VAT rate
+  const byRate = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVAT(line);
+
+        if (!byRate[rate]) {
+          byRate[rate] = { base: 0, vat: 0 };
+        }
+        byRate[rate].base += base;
+        byRate[rate].vat += vat;
+      });
+    });
+
+  // Convert to array and sort by rate descending
+  const summary = Object.entries(byRate)
+    .map(([rate, { base, vat }]) => ({
+      rate: Number(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return ok(summary);
+}
