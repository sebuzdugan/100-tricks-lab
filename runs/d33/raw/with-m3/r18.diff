+
+/**
+ * Calculate late fee on an invoice: 0.04% per day of the amount due.
+ * @param {{ dueDate: string, lines: Array, payments?: Array<{ amount: number }>, status?: string }} invoice - Invoice to check
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {number} Late fee amount in cents (0 if not overdue)
+ */
+export function lateFee(invoice, asOf) {
+  // Check if invoice is overdue
+  if (invoice.dueDate >= asOf) return 0;
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // Get amount due
+  const amountDue = balanceDue(invoice);
+
+  // Calculate late fee: 0.04% per day (0.0004 as decimal)
+  const feeAmount = amountDue * daysOverdue * 0.0004;
+
+  return roundCents(feeAmount);
+}
