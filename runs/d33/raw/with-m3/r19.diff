+  issued.value.customerName = 'Company "ABC" Inc';
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  assert.match(dataLine, /"Company ""ABC"" Inc"/);
+});
+
+test('exportCsv with multiple invoices in order', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const draft2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'STICKER', qty: 5 }],
+  });
