+test('exportCsv calculates correct totals', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields[5], (totals.subtotal / 100).toFixed(2));
+  assert.equal(fields[6], (totals.discount / 100).toFixed(2));
+  assert.equal(fields[7], (totals.vat / 100).toFixed(2));
+  assert.equal(fields[8], (totals.total / 100).toFixed(2));
+});
+
+test('exportCsv shows invoice status', () => {
