+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv with no invoices returns header only', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header line', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'), true);
+});
+
+test('exportCsv each line ends with newline', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  assert.equal(lines[lines.length - 1], '');
+  assert.equal(lines.every((line, i) => i === lines.length - 1 || line), true);
+});
+
+test('exportCsv formats single invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.match(lines[1], /^INV-/);
+});
+
+test('exportCsv includes all required columns', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields.length, 10);
+});
+
+test('exportCsv formats amounts as plain euros with 2 decimals', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  assert.match(dataLine, /\d+\.\d{2}/);
+  assert.equal(dataLine.includes('€'), false);
+});
+
+test('exportCsv uses customer name not ID', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  assert.match(dataLine, /Northwind Studio/);
+});
+
+test('exportCsv quotes field with comma', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  issued.value.customerName = 'Smith, John';
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  assert.match(dataLine, /"Smith, John"/);
+});
+
+test('exportCsv doubles internal quotes and wraps field', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
