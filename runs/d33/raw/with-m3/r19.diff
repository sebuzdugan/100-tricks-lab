+
+test('exportCsv can be parsed as valid CSV', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const csv = exportCsv([issued.value]);
+  const lines = csv.trim().split('\n');
+  assert.equal(lines.length, 2);
+  const headerFields = lines[0].split(',');
+  assert.equal(headerFields.length, 10);
+});
