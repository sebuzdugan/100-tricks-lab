+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Convert cents to euros string format: "1234.50" (no sign, no thousands separator)
+ * @param {number} cents
+ * @returns {string}
+ */
+function centsToEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: quote if it contains comma or quote, double any internal quotes.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  if (field.includes(',') || field.includes('"')) {
+    return `"${field.replace(/"/g, '""')}"`;
+  }
+  return field;
+}
+
+/**
+ * Export invoices as CSV format.
+ * @param {Array<{ number: string, customerId?: string, customerName: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array, voucher?: { amount: number } }>} invoices
+ * @returns {string} CSV formatted string with header and data rows, each line ending with \n
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due';
+  const lines = [header];
+
+  invoices.forEach((invoice) => {
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const row = [
+      escapeCsvField(invoice.number),
+      escapeCsvField(invoice.customerName),
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      centsToEuros(totals.subtotal),
+      centsToEuros(totals.discount),
+      centsToEuros(totals.vat),
+      centsToEuros(totals.total),
+      centsToEuros(due),
+    ].join(',');
+
+    lines.push(row);
+  });
+
+  return lines.join('\n') + '\n';
+}
