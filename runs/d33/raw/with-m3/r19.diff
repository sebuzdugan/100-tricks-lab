+
+test('exportCsv shows remaining due for partially paid invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const paymentAmount = 5000;
+  const partial = recordPayment(issued.value, { amount: paymentAmount, date: '2026-10-08' });
+  const totals = invoiceTotals(issued.value);
+  const expectedDue = totals.total - paymentAmount;
+  const csv = exportCsv([partial.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields[9], (expectedDue / 100).toFixed(2));
+});
+
+test('exportCsv shows zero due for fully paid invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(draft.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-08' });
+  const csv = exportCsv([paid.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields[9], '0.00');
