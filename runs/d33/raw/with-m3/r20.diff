--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,17 @@
 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of that currency per euro.
+ * EUR: 1 euro = 1 EUR
+ * USD: 1 euro = 1.085 USD
+ * GBP: 1 euro = 0.8425 GBP
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +51,42 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount from euros (cents) to another currency (cents).
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code: 'EUR', 'USD', 'GBP'
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const euros = cents / 100;
+  const convertedAmount = euros * RATES[currency];
+  const convertedCents = roundCents(convertedAmount * 100);
+
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents as money for a given currency: 123456, 'USD' -> "$1,234.56", -5, 'GBP' -> "-£0.05".
+ * @param {number} cents
+ * @param {string} currency - Currency code: 'EUR', 'USD', 'GBP'
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const amount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  const symbol = symbols[currency] ?? '?';
+  return `${sign}${symbol}${amount}.${String(abs % 100).padStart(2, '0')}`;
+}
