+
+test('RATES exports correct exchange rates', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert from EUR to EUR returns same amount', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert from EUR to USD applies correct rate', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  const expected = Math.round(100 * 1.085 * 100);
+  assert.equal(result.value, expected);
+});
+
+test('convert from EUR to GBP applies correct rate', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  const expected = Math.round(100 * 0.8425 * 100);
+  assert.equal(result.value, expected);
+});
+
+test('convert returns UNKNOWN_CURRENCY for invalid currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('convert with zero amount returns zero', () => {
+  assert.deepEqual(convert(0, 'USD'), { ok: true, value: 0 });
+  assert.deepEqual(convert(0, 'GBP'), { ok: true, value: 0 });
+  assert.deepEqual(convert(0, 'EUR'), { ok: true, value: 0 });
+});
+
+test('convert returns integer cents', () => {
+  const result = convert(123, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(Number.isInteger(result.value), true);
+});
+
+test('convert handles negative amounts', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value < 0, true);
+});
+
+test('formatMoney formats EUR with € sign and thousands separator', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+  assert.equal(formatMoney(5, 'EUR'), '€0.05');
+  assert.equal(formatMoney(-250, 'EUR'), '-€2.50');
+});
+
+test('formatMoney formats USD with $ sign and thousands separator', () => {
+  assert.equal(formatMoney(123456, 'USD'), '$1,234.56');
+  assert.equal(formatMoney(5, 'USD'), '$0.05');
+  assert.equal(formatMoney(-250, 'USD'), '-$2.50');
+});
+
+test('formatMoney formats GBP with £ sign and thousands separator', () => {
+  assert.equal(formatMoney(123456, 'GBP'), '£1,234.56');
+  assert.equal(formatMoney(5, 'GBP'), '£0.05');
+  assert.equal(formatMoney(-250, 'GBP'), '-£2.50');
+});
+
+test('formatMoney formats large amounts with multiple thousands separators', () => {
+  assert.equal(formatMoney(100000000, 'USD'), '$1,000,000.00');
+  assert.equal(formatMoney(100000000, 'GBP'), '£1,000,000.00');
+});
+
+test('formatMoney handles unknown currency with ? sign', () => {
+  assert.equal(formatMoney(123456, 'JPY'), '?1,234.56');
+});
+
+test('formatMoney with zero amount', () => {
+  assert.equal(formatMoney(0, 'EUR'), '€0.00');
+  assert.equal(formatMoney(0, 'USD'), '$0.00');
+  assert.equal(formatMoney(0, 'GBP'), '£0.00');
+});
+
+test('convert then format works correctly', () => {
+  const converted = convert(10000, 'USD');
+  assert.equal(converted.ok, true);
+  const formatted = formatMoney(converted.value, 'USD');
+  assert.equal(formatted.includes('$'), true);
+  assert.equal(formatted.includes('.'), true);
+});
+
+test('convert and formatMoney with fractional conversion', () => {
+  const cents = 12345;
+  const usd = convert(cents, 'USD');
+  assert.equal(usd.ok, true);
+  const formatted = formatMoney(usd.value, 'USD');
+  assert.match(formatted, /\$/);
+  assert.match(formatted, /\d+\.\d{2}/);
+});
+
+test('formatMoney consistent sign placement', () => {
+  assert.equal(formatMoney(-100, 'EUR'), '-€1.00');
+  assert.equal(formatMoney(-100, 'USD'), '-$1.00');
+  assert.equal(formatMoney(-100, 'GBP'), '-£1.00');
+});
