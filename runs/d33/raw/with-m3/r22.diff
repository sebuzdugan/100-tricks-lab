+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 9500 }), 47500);
+});
+
+test('lineTotal works with single unit', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 1000 }), 1000);
+});
+
+test('lineTotal works with large quantities', () => {
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 5000 }), 5000000);
+});
+
+test('lineTotal with zero price', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 0 }), 0);
+});
+
+test('lineDiscount calculates discount as lineTotal × discountPercent / 100', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 10000);
+});
+
+test('lineDiscount with decimal discount percent', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 12.5 };
+  assert.equal(lineDiscount(line), 12500);
+});
+
+test('lineDiscount with 0% discount', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 0 }), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 100000);
+});
+
+test('lineDiscount defaults to 0 if discountPercent not provided', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000 }), 0);
+});
+
+test('lineVAT calculates VAT on line amount after discount', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineVAT(line), 2100);
+});
+
+test('lineVAT with 0% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT with 9% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 9 };
+  assert.equal(lineVAT(line), 900);
+});
+
+test('lineVAT with 21% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineVAT(line), 2100);
+});
+
+test('lineVAT rounds per line', () => {
+  const line = { qty: 1, unitPrice: 10001, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineVAT(line), 2100);
+});
+
+test('lineVAT with fractional result rounds correctly', () => {
+  const line = { qty: 3, unitPrice: 100, discountPercent: 0, vatRate: 21 };
+  const vat = lineVAT(line);
+  assert.equal(vat, 63);
+});
+
+test('lineVAT with discount reduces VAT base', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 50, vatRate: 21 };
+  assert.equal(lineVAT(line), 1050);
+});
+
+test('invoiceTotals calculates subtotal from all lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+      { qty: 10, unitPrice: 500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+});
+
+test('invoiceTotals with zero-price items', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+      { qty: 10, unitPrice: 0, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+});
+
+test('invoiceTotals returns new object (does not mutate)', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result1 = invoiceTotals(invoice);
+  const result2 = invoiceTotals(invoice);
+  assert.notStrictEqual(result1, result2);
+});
+
+test('invoiceTotals returns discount field', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 10000);
+});
+
+test('invoiceTotals calculates total as subtotal minus discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.total, 90000);
+});
+
+test('invoiceTotals with multiple lines and different discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 },
+      { qty: 50, unitPrice: 1000, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 150000);
+  assert.equal(totals.discount, 20000);
+  assert.equal(totals.total, 130000);
+});
+
+test('invoiceTotals clamps total to 0 if discount exceeds subtotal', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'BIG', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with no discounts still returns discount field', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals returns vat field', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 2100);
+});
+
+test('invoiceTotals calculates total as subtotal - discount + vat', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.total, 12100);
+});
+
+test('invoiceTotals with multiple lines and different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 9 },
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 30000);
+  assert.equal(totals.vat, 3000);
+  assert.equal(totals.total, 33000);
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 150000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 29400);
+  assert.equal(totals.total, 169400);
+});
+
+test('invoiceTotals with no discount, no VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+      { qty: 50, unitPrice: 2000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 200000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 200000);
+});
+
+test('invoiceTotals clamps total to 0 if discount > subtotal', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'TOO_BIG', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals VAT is sum of rounded line VATs', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 63);
+});
+
+test('invoiceTotals includes voucher field', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals calculates total with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 11100);
+});
+
+test('invoiceTotals returns voucher amount as 0 when no voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with all fields present', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 2000, discountPercent: 5, vatRate: 9 },
+    ],
+    voucher: { code: 'TEST', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
