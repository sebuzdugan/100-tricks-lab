+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total amount for a single line item (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount amount for a single line item.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const total = lineTotal(line);
+  const discount = total * ((line.discountPercent ?? 0) / 100);
+  return Math.max(0, roundCents(discount));
+}
+
+/**
+ * Calculate the VAT amount for a single line item (after discount, rounded).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }}
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = Math.max(0, total - discount);
+  const vat = amountAfterDiscount * (line.vatRate / 100);
+  return roundCents(vat);
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return { subtotal, discount, vat, voucher, total };
+}
