+/**
+ * Generate a dashboard with key metrics.
+ * @param {Array<{ customerId: string, status: string, lines: Array, payments?: Array<{ amount: number }>, issueDate: string, dueDate: string }>} invoices - All invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Count invoices by status
+  const counts = {
+    draft: invoices.filter((inv) => inv.status === 'draft').length,
+    issued: invoices.filter((inv) => inv.status === 'issued').length,
+    partially_paid: invoices.filter((inv) => inv.status === 'partially_paid').length,
+    paid: invoices.filter((inv) => inv.status === 'paid').length,
+  };
+
+  // Calculate outstanding (total still due on issued and partially_paid)
+  const outstanding = invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  // Get overdue info
+  const overdueResult = overdueInvoices(invoices, asOf);
+  const overdueList = overdueResult.ok ? overdueResult.value : [];
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Get top 3 customers by outstanding amount
+  const customerDue = {};
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .forEach((inv) => {
+      if (!customerDue[inv.customerId]) {
+        customerDue[inv.customerId] = 0;
+      }
+      customerDue[inv.customerId] += balanceDue(inv);
+    });
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({ counts, outstanding, overdue, topCustomers });
+}
