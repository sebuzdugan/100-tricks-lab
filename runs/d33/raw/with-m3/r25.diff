@@ -131,3 +131,191 @@ test('renderInvoiceText with large quantities', () => {
   assert.match(text, /Discount: -€25\.00/);
   assert.match(text, /Total: €975\.00/);
 });
+
+test('renderInvoiceText shows line-level discount', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [
+      { name: 'Item', qty: 5, unitPrice: 1000, discountPercent: 10, vatRate: 0 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5 × Item @ €10\.00 = €50\.00 \(discount: -€5\.00\)/);
+});
+
+test('renderInvoiceText hides line discount when zero', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [
+      { name: 'Item', qty: 5, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5 × Item @ €10\.00 = €50\.00$/m);
+  assert.equal(text.includes('discount:'), false);
