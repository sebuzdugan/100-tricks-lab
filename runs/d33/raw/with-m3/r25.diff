+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [
+      { name: 'Item A', qty: 5, unitPrice: 1000, discountPercent: 10, vatRate: 0 },
+      { name: 'Item B', qty: 3, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5 × Item A @ €10\.00 = €50\.00 \(discount: -€5\.00\)/);
+  assert.match(text, /3 × Item B @ €10\.00 = €30\.00$/m);
+});
+
+test('renderInvoiceText shows voucher before total', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerName: 'Test Customer',
+    lines: [
+      { name: 'Item', qty: 1, unitPrice: 10000, vatRate: 0 },
+    ],
+    voucher: { code: 'SAVE10', amount: 1000 },
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  const voucherLine = lines.findIndex((l) => l.includes('SAVE10'));
+  const totalLine = lines.findIndex((l) => l.startsWith('Total:'));
+  assert.equal(voucherLine !== -1, true);
+  assert.equal(voucherLine < totalLine, true);
+  assert.match(text, /Voucher \(SAVE10\): -€10\.00/);
