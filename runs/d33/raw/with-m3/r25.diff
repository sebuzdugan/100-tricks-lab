diff --git a/src/render.js b/src/render.js
index 8818193..b3364b9 100644
--- a/src/render.js
+++ b/src/render.js
@@ -1,9 +1,9 @@
 import { formatEuros } from './money.js';
-import { lineTotal, invoiceTotals } from './invoices.js';
+import { lineTotal, invoiceTotals, lineDiscount } from './invoices.js';
 
 /**
  * Render an invoice as plain text for display to customers.
- * @param {{ number?: string, customerName: string, lines: Array<{ name: string, qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }}
+ * @param {{ number?: string, customerName: string, lines: Array<{ name: string, qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, dueDate?: string, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number }> }}
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -18,7 +18,14 @@ export function renderInvoiceText(invoice) {
   // Line items
   for (const line of invoice.lines) {
     const total = lineTotal(line);
-    const lineText = `  ${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    const discount = lineDiscount(line);
+    let lineText = `  ${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+
+    // Add line discount if present
+    if (discount > 0) {
+      lineText += ` (discount: -${formatEuros(discount)})`;
+    }
+
     lines.push(lineText);
   }
 
@@ -38,8 +45,24 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  // Voucher (if any)
+  if (invoice.voucher && invoice.voucher.amount > 0) {
+    lines.push(`Voucher (${invoice.voucher.code}): -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   // Total
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date (if present)
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid amount (if any payments)
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
diff --git a/test/render.test.js b/test/render.test.js
