@@ -0,0 +1,24 @@
+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {Array<string>} existingNumbers - array of invoice numbers already used (e.g., ["INV-2024-0001"])
+ * @param {string} issueDate - issue date in YYYY-MM-DD format
+ * @returns {string} the next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+
+  // Filter numbers for this year
+  const yearPrefix = `INV-${year}-`;
+  const numbersThisYear = existingNumbers.filter((num) => num.startsWith(yearPrefix));
+
+  // Extract counters and find the maximum
+  let maxCounter = 0;
+  for (const num of numbersThisYear) {
+    const counter = parseInt(num.substring(yearPrefix.length), 10);
+    if (counter > maxCounter) maxCounter = counter;
+  }
+
+  // Return the next counter, zero-padded to 4 digits
+  return `${yearPrefix}${String(maxCounter + 1).padStart(4, '0')}`;
+}
