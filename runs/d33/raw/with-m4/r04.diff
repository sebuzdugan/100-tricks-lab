diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..c394c93
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates the first number of the year', () => {
+  const number = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2024-03-20');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber handles multiple years independently', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2023-0001'];
+  const number = nextInvoiceNumber(existing, '2024-01-01');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber resets counter for a new year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003'];
+  const number = nextInvoiceNumber(existing, '2025-01-01');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber zero-pads the counter to 4 digits', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0100');
+});
+
+test('nextInvoiceNumber works with unordered existing numbers', () => {
+  const existing = ['INV-2024-0003', 'INV-2024-0001', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(number, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2023-0100', 'INV-2024-0001', 'INV-2025-0050'];
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0002');
+});
