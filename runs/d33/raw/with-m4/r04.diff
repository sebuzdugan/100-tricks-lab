+
+/**
+ * Issue a draft invoice by assigning a number and changing status to 'issued'.
+ * @param {{ status: string, issueDate: string, lines: Array }} invoice
+ * @param {Array<string>} existingNumbers - array of invoice numbers already used
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check if status is 'draft'
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  const newInvoice = {
+    ...invoice,
+    number,
+    status: 'issued',
+  };
+
+  return ok(newInvoice);
+}
