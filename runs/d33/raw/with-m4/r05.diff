+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string} plain-text invoice
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer info
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) {
+    throw new Error(`Customer not found: ${invoice.customerId}`);
+  }
+  const customer = customerResult.value;
+
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  const invoiceNumber = invoice.number || 'DRAFT';
+  lines.push(invoiceNumber);
+
+  // Second line: customer name
+  lines.push(customer.name);
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Total line
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..5d729a0
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,127 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r1.ok, true);
+  const r2 = issueInvoice(r1.value, []);
+  assert.equal(r2.ok, true);
+  const text = renderInvoiceText(r2.value);
+  assert.match(text, /^INV-2024-0001\n/);
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /^DRAFT\nNorthwind Studio\n/);
+});
+
+test('renderInvoiceText shows invoice lines with formatting', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /2 × Design work \(hour\) @ €85\.00 = €170\.00/);
+});
+
+test('renderInvoiceText shows total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Total: €170\.00$/);
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // DRAFT, Customer, 2 product lines, Total
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /2 × Design work \(hour\)/);
+  assert.match(lines[3], /3 × Development \(hour\)/);
+  assert.match(lines[4], /Total:/);
+});
+
+test('renderInvoiceText formats amounts correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'ICON-SET', qty: 5 },
+      { sku: 'STICKER', qty: 10 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /€9\.80/); // ICON-SET unit price
+  assert.match(text, /€49\.00/); // 5 × 980
+  assert.match(text, /€0\.50/); // STICKER unit price
+  assert.match(text, /€5\.00/); // 10 × 50
+  assert.match(text, /Total: €54\.00/);
+});
+
+test('renderInvoiceText throws for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+  assert.throws(() => renderInvoiceText(invoice), /Customer not found/);
+});
+
+test('renderInvoiceText produces valid plain text format', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-06-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'SUPPORT-HOUR', qty: 2 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.ok(lines.length >= 5);
+  assert.ok(lines[0]); // Invoice number/DRAFT
+  assert.ok(lines[1]); // Customer name
+  assert.match(lines[0], /^(DRAFT|INV-)/);
+});
