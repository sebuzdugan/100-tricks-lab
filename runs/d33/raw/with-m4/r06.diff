+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.lines[0].qty, 5);
+  assert.equal(r2.value.lines[0].discountPercent, 20);
+});
+
+test('addLine with discount does not mutate the original invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r1.ok, true);
+  const original = JSON.stringify(r1.value);
+  addLine(r1.value, { sku: 'DEV-HOUR', qty: 3, discountPercent: 10 });
+  assert.equal(JSON.stringify(r1.value), original);
+});
