+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('  C-001  '), 'C-001');
+  assert.equal(normalizeId('\tC-001\t'), 'C-001');
+  assert.equal(normalizeId(' c-001 '), 'C-001');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('C-001'), 'C-001');
+  assert.equal(normalizeId('c-C0c-C1'), 'C-C0C-C1');
+});
+
+test('normalizeId handles mixed case and spaces', () => {
+  assert.equal(normalizeId('  c-007 '), 'C-007');
+  assert.equal(normalizeId('c-002'), 'C-002');
+});
+
+test('getCustomer works with unnormalized IDs', () => {
+  const r1 = getCustomer('  c-001  ');
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.id, 'C-001');
+  assert.equal(r1.value.name, 'Northwind Studio');
+});
+
+test('getCustomer works with lowercase IDs', () => {
+  const r = getCustomer('c-003');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.id, 'C-003');
+  assert.equal(r.value.name, 'Kite & Co');
+});
+
+test('getCustomer rejects unknown IDs even with normalization', () => {
+  const r = getCustomer('  c-999  ');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
