+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the total amount paid on an invoice.
+ * @param {{ payments?: Array<{ amount: number, date: string }> }} invoice
+ * @returns {number} total paid in cents
+ */
+function totalPaid(invoice) {
+  if (!invoice.payments) return 0;
+  return invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+}
+
+/**
+ * Calculate the balance due on an invoice.
+ * @param {{ lines: Array<any>, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @returns {number} balance due in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = totalPaid(invoice);
+  return Math.max(0, totals.total - paid);
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, lines: Array<any>, customerId: string, issueDate: string, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  // Check if invoice is issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Check for overpayment
+  const owed = balanceDue(invoice);
+  if (amount > owed) return fail('OVERPAYMENT');
+
+  // Create new invoice with payment recorded
+  const newInvoice = {
+    ...invoice,
+    payments: [...(invoice.payments ?? []), { amount, date }],
+  };
+
+  // Determine new status based on balance after payment
+  const newBalance = balanceDue(newInvoice);
+  if (newBalance === 0) {
+    newInvoice.status = 'paid';
+  } else {
+    newInvoice.status = 'partially_paid';
+  }
+
+  return ok(newInvoice);
+}
