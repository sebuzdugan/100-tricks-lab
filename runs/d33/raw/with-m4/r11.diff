+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+function createTestInvoice() {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!r.ok) throw new Error('Failed to create test invoice');
+  return r.value;
+}
+
+function createIssuedInvoice() {
+  const invoice = createTestInvoice();
+  const issueResult = issueInvoice(invoice, []);
+  if (!issueResult.ok) throw new Error('Failed to issue invoice');
+  return issueResult.value;
+}
+
+test('balanceDue returns total when no payments made', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  assert.equal(balanceDue(invoice), totals.total);
+});
+
+test('balanceDue returns zero when fully paid', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const invoiceWithPayment = {
+    ...invoice,
+    payments: [{ amount: totals.total, date: '2024-01-20' }],
+  };
+  assert.equal(balanceDue(invoiceWithPayment), 0);
+});
+
+test('balanceDue returns balance after partial payment', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const paid = Math.floor(totals.total / 2);
+  const invoiceWithPayment = {
+    ...invoice,
+    payments: [{ amount: paid, date: '2024-01-20' }],
+  };
+  assert.equal(balanceDue(invoiceWithPayment), totals.total - paid);
+});
+
+test('balanceDue with multiple payments', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const invoiceWithPayments = {
+    ...invoice,
+    payments: [
+      { amount: 1000, date: '2024-01-20' },
+      { amount: 2000, date: '2024-01-25' },
+    ],
+  };
+  assert.equal(balanceDue(invoiceWithPayments), totals.total - 3000);
+});
+
+test('recordPayment returns error for draft invoice', () => {
+  const invoice = createTestInvoice();
+  const r = recordPayment(invoice, { amount: 1000, date: '2024-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment returns error for amount zero', () => {
+  const invoice = createIssuedInvoice();
+  const r = recordPayment(invoice, { amount: 0, date: '2024-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment returns error for negative amount', () => {
+  const invoice = createIssuedInvoice();
+  const r = recordPayment(invoice, { amount: -100, date: '2024-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment returns error for non-integer amount', () => {
+  const invoice = createIssuedInvoice();
+  const r = recordPayment(invoice, { amount: 100.5, date: '2024-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment returns error for overpayment', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const r = recordPayment(invoice, { amount: totals.total + 1, date: '2024-01-20' });
+  assert.deepEqual(r, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment records payment on issued invoice', () => {
+  const invoice = createIssuedInvoice();
+  const r = recordPayment(invoice, { amount: 5000, date: '2024-01-20' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.deepEqual(r.value.payments[0], { amount: 5000, date: '2024-01-20' });
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = createIssuedInvoice();
+  assert.equal(invoice.payments, undefined);
+  const r = recordPayment(invoice, { amount: 1000, date: '2024-01-20' });
+  assert.equal(r.ok, true);
+  assert.equal(Array.isArray(r.value.payments), true);
+  assert.equal(r.value.payments.length, 1);
