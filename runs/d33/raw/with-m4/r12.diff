+/**
+ * Calculate the due date based on terms and issue date.
+ * @param {string} issueDate in YYYY-MM-DD format
+ * @param {string} terms NET14, NET30, or EOM
+ * @returns {string} due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    // Get the last day of the month by going to first day of next month and back 1 day
+    const [year, month, day] = issueDate.split('-').map(Number);
+    const nextMonth = month === 12 ? `${year + 1}-01-01` : `${year}-${String(month + 1).padStart(2, '0')}-01`;
+    return addDays(nextMonth, -1);
+  }
+  return null;
+}
