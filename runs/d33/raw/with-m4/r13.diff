--- a/src/invoices.js
+++ b/src/invoices.js
@@ -142,15 +142,41 @@ export function lineVat(line) {
 
 /**
  * Calculate totals for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, vat: number, total: number }} all in cents
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} all in cents
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
   const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
-  const total = Math.max(0, subtotal - discount + vat);
-  return { subtotal, discount, vat, total };
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return { subtotal, discount, vat, voucher, total };
+}
+
+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: { code: string, amount: number }, lines: Array<any> }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check if status is 'draft'
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  // Check if voucher already exists
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Create new invoice with voucher applied
+  const newInvoice = {
+    ...invoice,
+    voucher: { code, amount },
+  };
+
+  return ok(newInvoice);
 }
 
