+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement showing all outstanding invoices.
+ * @param {string} customerId the customer's normalized ID
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate?: string, status: string, lines: Array<any>, payments?: Array<any>, voucher?: any }>} invoices all invoices to filter
+ * @param {string} asOf date in YYYY-MM-DD format (statement date cutoff)
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices: customer match, issued/partially_paid, issueDate <= asOf
+  const relevantInvoices = invoices.filter(inv =>
+    inv.customerId === customerId &&
+    (inv.status === 'issued' || inv.status === 'partially_paid') &&
+    inv.issueDate <= asOf
+  );
+
+  // Map to statement format with due amounts
+  const statementInvoices = relevantInvoices.map(inv => {
+    const totals = invoiceTotals(inv);
+    return {
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: totals.total,
+      due: balanceDue(inv),
+    };
+  });
+
+  // Sort by issueDate
+  statementInvoices.sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate totalDue
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
