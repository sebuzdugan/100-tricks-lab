+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+function createAndIssueInvoice(customerId, issueDate, lines = [{ sku: 'DES-HOUR', qty: 2 }]) {
+  const r = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+  });
+  if (!r.ok) throw new Error('Failed to create invoice');
+  const issued = issueInvoice(r.value, []);
+  if (!issued.ok) throw new Error('Failed to issue invoice');
+  return issued.value;
+}
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const r = createCreditNote(invoice, { amount: 1000, reason: 'Overpaid', date: '2024-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2024-0001');
+  assert.equal(r.value.invoiceNumber, invoice.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 1000);
+  assert.equal(r.value.reason, 'Overpaid');
+  assert.equal(r.value.date, '2024-01-20');
+});
+
+test('createCreditNote creates credit note for partially_paid invoice', () => {
+  let invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: Math.floor(totals.total / 2), date: '2024-01-20' });
+  invoice = payment.value;
+
+  const r = createCreditNote(invoice, { amount: 500, reason: 'Discount', date: '2024-01-25' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote creates credit note for paid invoice', () => {
+  let invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2024-01-20' });
+  invoice = payment.value;
+
+  const r = createCreditNote(invoice, { amount: 500, reason: 'Return', date: '2024-01-25' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote returns error for draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const r = createCreditNote(draft, { amount: 1000, reason: 'Test', date: '2024-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote returns error for zero amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const r = createCreditNote(invoice, { amount: 0, reason: 'Test', date: '2024-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns error for negative amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const r = createCreditNote(invoice, { amount: -100, reason: 'Test', date: '2024-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns error for non-integer amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const r = createCreditNote(invoice, { amount: 100.5, reason: 'Test', date: '2024-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns error for invalid date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const r = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '01/20/2024' }, []);
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote returns error if amount exceeds invoice total', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+  const r = createCreditNote(invoice, { amount: totals.total + 1, reason: 'Test', date: '2024-01-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit note equal to invoice total', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+  const r = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2024-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, totals.total);
+});
+
+test('createCreditNote generates sequential numbers', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2024-01-15');
+  const invoice2 = createAndIssueInvoice('C-002', '2024-01-15');
+
+  const r1 = createCreditNote(invoice1, { amount: 1000, reason: 'Credit 1', date: '2024-01-20' }, []);
+  assert.equal(r1.value.number, 'CN-2024-0001');
+
+  const r2 = createCreditNote(invoice2, { amount: 1000, reason: 'Credit 2', date: '2024-01-21' }, [r1.value.number]);
+  assert.equal(r2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote has separate counter from invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003'];
+
+  const r = createCreditNote(invoice, { amount: 1000, reason: 'Credit', date: '2024-01-20' }, existingNumbers);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote with mixed invoice and credit note numbers', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const existingNumbers = ['INV-2024-0001', 'CN-2024-0001', 'INV-2024-0002', 'CN-2024-0002'];
+
+  const r = createCreditNote(invoice, { amount: 1000, reason: 'Credit', date: '2024-01-20' }, existingNumbers);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2024-0003');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const invoice2023 = createAndIssueInvoice('C-001', '2023-01-15');
+  const invoice2024 = createAndIssueInvoice('C-001', '2024-01-15');
+  const existingNumbers = ['CN-2023-0001', 'CN-2023-0002', 'CN-2023-0003'];
+
+  const r = createCreditNote(invoice2024, { amount: 1000, reason: 'Credit', date: '2024-01-20' }, existingNumbers);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote pads counter to 4 digits', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const existingNumbers = Array.from({ length: 10 }, (_, i) => `CN-2024-${String(i + 1).padStart(4, '0')}`);
+
+  const r = createCreditNote(invoice, { amount: 1000, reason: 'Credit', date: '2024-01-20' }, existingNumbers);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2024-0011');
+});
+
+test('createCreditNote includes invoice number in credit note', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const r = createCreditNote(invoice, { amount: 1000, reason: 'Credit', date: '2024-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoiceNumber, invoice.number);
+});
+
+test('createCreditNote includes customer ID', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const r = createCreditNote(invoice, { amount: 1000, reason: 'Credit', date: '2024-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+});
+
+test('createCreditNote with different reasons', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const reasons = ['Quality issue', 'Overpaid', 'Return', 'Discount applied'];
+
+  reasons.forEach((reason, idx) => {
+    const inv = createAndIssueInvoice('C-001', '2024-01-15');
+    const r = createCreditNote(inv, { amount: 1000, reason, date: '2024-01-20' }, []);
+    assert.equal(r.ok, true);
+    assert.equal(r.value.reason, reason);
+  });
+});
+
+test('createCreditNote with large amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+  const r = createCreditNote(invoice, { amount: totals.total, reason: 'Full credit', date: '2024-01-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, totals.total);
+});
+
+test('createCreditNote with date in different month', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  const r = createCreditNote(invoice, { amount: 1000, reason: 'Late credit', date: '2024-03-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.date, '2024-03-20');
+});
+
+test('createCreditNote with date before invoice issue date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-15');
+  // This should still work - the business logic doesn't prevent it
+  const r = createCreditNote(invoice, { amount: 1000, reason: 'Early credit', date: '2024-01-01' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.date, '2024-01-01');
+});
