+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Extract the credit note counter for a given year from existing numbers.
+ * @param {Array<string>} existingNumbers all existing credit note numbers
+ * @param {number} year the year to count for
+ * @returns {number} the highest counter for that year, or 0 if none
+ */
+function getHighestCreditCounter(existingNumbers, year) {
+  const yearPrefix = `CN-${year}-`;
+  const creditNumbers = existingNumbers.filter(num => num.startsWith(yearPrefix));
+  if (creditNumbers.length === 0) return 0;
+  const counters = creditNumbers.map(num => parseInt(num.slice(yearPrefix.length), 10));
+  return Math.max(...counters);
+}
+
+/**
+ * Generate the next credit note number for a given year.
+ * @param {Array<string>} existingNumbers all existing numbers (invoices and credit notes)
+ * @param {string} date in YYYY-MM-DD format
+ * @returns {string} next credit note number in CN-YYYY-NNNN format
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = parseInt(date.slice(0, 4), 10);
+  const highest = getHighestCreditCounter(existingNumbers, year);
+  const counter = highest + 1;
+  return `CN-${year}-${String(counter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number?: string, customerId: string, lines: Array<any>, payments?: Array<any>, voucher?: any }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNoteData
+ * @param {Array<string>} existingNumbers all existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check if invoice is issued, partially_paid, or paid
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  // Validate date format
+  if (!isValidDate(date)) return fail('DATE_INVALID');
+
+  // Calculate invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) return fail('CREDIT_TOO_HIGH');
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
