+import { ok, fail } from './result.js';
+import { daysBetween, isValidDate } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a report of invoices past their due date.
+ * @param {Array<{ number?: string, customerId: string, dueDate: string, status: string, payments?: Array<any> }>} invoices all invoices to filter
+ * @param {string} asOf date in YYYY-MM-DD format (report cutoff date)
+ * @returns {{ ok: true, value: Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }> } | { ok: false, error: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  const overdue = invoices
+    .filter(inv => (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate < asOf)
+    .map(inv => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return ok(overdue);
+}
