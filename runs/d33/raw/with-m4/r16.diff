+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+function createAndIssueInvoice(customerId, issueDate, lines = [{ sku: 'DES-HOUR', qty: 2 }], terms = 'NET30') {
+  const r = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+    terms,
+  });
+  if (!r.ok) throw new Error('Failed to create invoice');
+  const issued = issueInvoice(r.value, []);
+  if (!issued.ok) throw new Error('Failed to issue invoice');
+  return issued.value;
+}
+
+test('overdueInvoices returns empty array when no invoices', () => {
+  const r = overdueInvoices([], '2024-12-31');
+  assert.equal(r.ok, true);
+  assert.deepEqual(r.value, []);
+});
+
+test('overdueInvoices returns empty array when all invoices are paid', () => {
+  let invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2024-02-15' });
+  invoice = payment.value;
+
+  const r = overdueInvoices([invoice], '2024-12-31');
+  assert.equal(r.ok, true);
+  assert.deepEqual(r.value, []);
+});
+
+test('overdueInvoices returns empty array when no invoices past due date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-12-01');
+  const r = overdueInvoices([invoice], '2024-12-15');
+  assert.equal(r.ok, true);
+  assert.deepEqual(r.value, []);
+});
+
+test('overdueInvoices includes issued invoices past due date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+  const r = overdueInvoices([invoice], '2024-02-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 1);
+  assert.equal(r.value[0].number, invoice.number);
+  assert.equal(r.value[0].customerId, 'C-001');
+  assert.equal(r.value[0].dueDate, invoice.dueDate);
+  assert.equal(r.value[0].due, totals.total);
+  assert.equal(r.value[0].daysOverdue > 0, true);
+});
