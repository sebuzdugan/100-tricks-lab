   return ok(overdue);
 }
+
+/**
+ * Generate a VAT summary grouped by tax rate.
+ * @param {Array<{ status: string, lines: Array<{ vatRate: number, qty: number, unitPrice: number, discountPercent?: number }> }>} invoices all invoices to analyze
+ * @returns {{ ok: true, value: Array<{ rate: number, base: number, vat: number }> }} sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const byRate = {};
+
+  invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach(inv => {
+      inv.lines.forEach(line => {
+        const rate = line.vatRate;
+        const base = Math.max(0, line.qty * line.unitPrice - lineDiscount(line));
+        const vat = lineVat(line);
+
+        if (!byRate[rate]) {
+          byRate[rate] = { rate, base: 0, vat: 0 };
+        }
+        byRate[rate].base += base;
+        byRate[rate].vat += vat;
+      });
+    });
+
+  const summary = Object.values(byRate).sort((a, b) => b.rate - a.rate);
+  return ok(summary);
+}
