 }
+
+/**
+ * Calculate late fee for an invoice.
+ * @param {Object} invoice the invoice to check
+ * @param {string} asOf date in YYYY-MM-DD format (check date)
+ * @returns {number} late fee in integer cents (0.04% per day × days overdue × amount due)
+ */
+export function lateFee(invoice, asOf) {
+  if (!isValidDate(asOf)) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  const fee = due * 0.0004 * daysOverdue;
+  return roundCents(fee);
+}
