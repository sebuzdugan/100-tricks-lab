+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { getCustomer } from './customers.js';
+
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+function formatEuro(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array<{ number: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array }>} invoices invoices to export
+ * @returns {string} CSV text with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map(inv => {
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : inv.customerId;
+
+    const fields = [
+      inv.number,
+      customerName,
+      inv.issueDate,
+      inv.dueDate,
+      inv.status,
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ];
+
+    return fields.map(escapeCsvField).join(',') + '\n';
+  });
+
+  return header + lines.join('');
+}
diff --git a/test/export.test.js b/test/export.test.js
