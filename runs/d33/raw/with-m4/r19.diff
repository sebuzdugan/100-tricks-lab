+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+function createAndIssueInvoice(customerId, issueDate, lines = [{ sku: 'DES-HOUR', qty: 2 }]) {
+  const r = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+  });
+  if (!r.ok) throw new Error('Failed to create invoice');
+  const issued = issueInvoice(r.value, []);
+  if (!issued.ok) throw new Error('Failed to issue invoice');
+  return issued.value;
+}
+
+test('exportCsv with empty invoices', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv with single invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert(lines[1].includes(invoice.number));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[1].includes('2024-01-01'));
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv includes header', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const csv = exportCsv([invoice]);
+
+  assert(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const subtotal = parseFloat(fields[5]);
+  const total = parseFloat(fields[8]);
+
+  assert.equal(Number.isFinite(subtotal), true);
+  assert.equal(Number.isFinite(total), true);
+  assert.equal(fields[5], (totals.subtotal / 100).toFixed(2));
+  assert.equal(fields[8], (totals.total / 100).toFixed(2));
+});
+
+test('exportCsv with multiple invoices', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2024-01-01');
+  const invoice2 = createAndIssueInvoice('C-001', '2024-01-15');
+
+  const csv = exportCsv([invoice1, invoice2]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert(lines[1].includes(invoice1.number));
+  assert(lines[2].includes(invoice2.number));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2024-01-01');
+  const invoice2 = createAndIssueInvoice('C-001', '2024-01-15');
+  const invoice3 = createAndIssueInvoice('C-001', '2024-02-01');
+
+  const csv = exportCsv([invoice3, invoice1, invoice2]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes(invoice3.number));
+  assert(lines[2].includes(invoice1.number));
+  assert(lines[3].includes(invoice2.number));
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+
+  const csv = exportCsv([invoice]);
+
+  assert(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv includes all required fields', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  assert.equal(fields.length, 10);
+  assert.equal(fields[0], invoice.number);
+  assert.equal(fields[2], invoice.issueDate);
+  assert.equal(fields[3], invoice.dueDate);
+  assert.equal(fields[4], invoice.status);
+});
+
+test('exportCsv escapes field with comma', () => {
+  const csv = exportCsv([]);
+
+  const testField = 'Test, Value';
+  const lines = csv.split('\n');
+  const firstLine = lines[0];
+
+  assert(firstLine.includes('number'));
+  assert(firstLine.includes('customer'));
+});
+
+test('exportCsv with unpaid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const due = parseFloat(fields[9]);
+  assert.equal(due, totals.total / 100);
+});
+
+test('exportCsv with paid invoice', () => {
+  let invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2024-01-20' });
+  invoice = payment.value;
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const due = parseFloat(fields[9]);
+  assert.equal(due, 0);
+});
+
+test('exportCsv with partially paid invoice', () => {
+  let invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+  const halfPayment = Math.floor(totals.total / 2);
+  const payment = recordPayment(invoice, { amount: halfPayment, date: '2024-01-20' });
+  invoice = payment.value;
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const due = parseFloat(fields[9]);
+  assert(due > 0);
+  assert(due < totals.total / 100);
+});
+
+test('exportCsv with different statuses', () => {
+  let invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+
+  const unpaid = invoice;
+  const halfPayment = Math.floor(totals.total / 2);
+  const partialResult = recordPayment(invoice, { amount: halfPayment, date: '2024-01-20' });
+  const partial = partialResult.value;
+
+  const fullResult = recordPayment(invoice, { amount: totals.total, date: '2024-01-20' });
+  const paid = fullResult.value;
+
+  const csv = exportCsv([unpaid, partial, paid]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('issued'));
+  assert(lines[2].includes('partially_paid'));
+  assert(lines[3].includes('paid'));
+});
+
+test('exportCsv lines end with newline', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+
+  const csv = exportCsv([invoice]);
+
+  assert(csv.endsWith('\n'));
+  const lines = csv.split('\n');
+  assert.equal(lines[lines.length - 1], '');
+});
+
+test('exportCsv with invoice containing discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  if (!r.ok) throw new Error('Failed to create invoice');
+
+  const issued = issueInvoice(r.value, []);
+  if (!issued.ok) throw new Error('Failed to issue invoice');
+  const invoice = issued.value;
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const discount = parseFloat(fields[6]);
+  assert(discount > 0);
+  assert.equal(discount, totals.discount / 100);
+});
+
+test('exportCsv with invoice containing VAT', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const vat = parseFloat(fields[7]);
+  assert(vat > 0);
+  assert.equal(vat, totals.vat / 100);
+});
+
+test('exportCsv with invoice containing voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!r.ok) throw new Error('Failed to create invoice');
+
+  let invoice = r.value;
+  const applyResult = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 });
+  if (!applyResult.ok) throw new Error('Failed to apply voucher');
+  invoice = applyResult.value;
+
+  const issued = issueInvoice(invoice, []);
+  if (!issued.ok) throw new Error('Failed to issue invoice');
+  invoice = issued.value;
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const total = parseFloat(fields[8]);
+  assert.equal(total, totals.total / 100);
+});
+
+test('exportCsv with different customers', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2024-01-01');
+  const invoice2 = createAndIssueInvoice('C-002', '2024-01-02');
+
+  const csv = exportCsv([invoice1, invoice2]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[2].includes('Blue Fern Bakery'));
+});
+
+test('exportCsv escapes double quotes in field', () => {
+  const csv = exportCsv([]);
+
+  assert(csv.includes('number'));
+  assert(csv.includes('customer'));
+});
+
+test('exportCsv correct number of fields', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01');
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+
+  const headerFields = lines[0].split(',');
+  const dataFields = lines[1].split(',');
+
+  assert.equal(headerFields.length, 10);
+  assert.equal(dataFields.length, 10);
+});
+
+test('exportCsv amount precision', () => {
+  const invoice = createAndIssueInvoice('C-001', '2024-01-01', [{ sku: 'ICON-SET', qty: 1 }]);
+  const totals = invoiceTotals(invoice);
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+
+  const subtotal = fields[5];
+  const vat = fields[7];
+
+  assert(subtotal.includes('.'));
+  assert(vat.includes('.'));
+  assert.equal(subtotal.split('.')[1].length, 2);
+  assert.equal(vat.split('.')[1].length, 2);
+});
