+
+test('RATES defined for EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const r = convert(10000, 'EUR');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 10000);
+});
+
+test('convert EUR to USD multiplies by rate', () => {
+  const r = convert(10000, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, Math.round(10000 * 1.085));
+});
+
+test('convert EUR to GBP multiplies by rate', () => {
+  const r = convert(10000, 'GBP');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, Math.round(10000 * 0.8425));
+});
+
+test('convert returns unknown currency error', () => {
+  const r = convert(10000, 'JPY');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with zero amount', () => {
+  const r = convert(0, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 0);
+});
+
+test('convert with negative amount', () => {
+  const r = convert(-10000, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, -Math.round(10000 * 1.085));
+});
+
+test('convert with small amount', () => {
+  const r = convert(5, 'USD');
+  assert.equal(r.ok, true);
+  assert(typeof r.value === 'number');
+});
+
+test('convert rounds to integer cents', () => {
+  const r = convert(123, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(Number.isInteger(r.value), true);
+});
+
+test('formatMoney with EUR currency', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+  assert.equal(formatMoney(5, 'EUR'), '€0.05');
+  assert.equal(formatMoney(-250, 'EUR'), '-€2.50');
+});
+
+test('formatMoney with USD currency', () => {
+  assert.equal(formatMoney(123456, 'USD'), '$1,234.56');
+  assert.equal(formatMoney(5, 'USD'), '$0.05');
+  assert.equal(formatMoney(-250, 'USD'), '-$2.50');
+});
+
+test('formatMoney with GBP currency', () => {
+  assert.equal(formatMoney(123456, 'GBP'), '£1,234.56');
+  assert.equal(formatMoney(5, 'GBP'), '£0.05');
+  assert.equal(formatMoney(-250, 'GBP'), '-£2.50');
+});
+
+test('formatMoney with unknown currency defaults to EUR', () => {
+  assert.equal(formatMoney(123456, 'JPY'), '€1,234.56');
+});
+
+test('formatMoney with large amounts', () => {
+  assert.equal(formatMoney(100000000, 'USD'), '$1,000,000.00');
+  assert.equal(formatMoney(100000000, 'GBP'), '£1,000,000.00');
+});
+
+test('formatMoney with zero', () => {
+  assert.equal(formatMoney(0, 'USD'), '$0.00');
+  assert.equal(formatMoney(0, 'GBP'), '£0.00');
+});
+
+test('formatMoney with negative zero', () => {
+  assert.equal(formatMoney(-0, 'USD'), '$0.00');
+});
+
+test('convert then format roundtrip', () => {
+  const eur = 10000;
+  const converted = convert(eur, 'USD');
+  assert.equal(converted.ok, true);
+  const formatted = formatMoney(converted.value, 'USD');
+  assert(formatted.startsWith('$'));
+  assert(formatted.includes('.'));
+});
+
+test('convert multiple currencies', () => {
+  const eur = 50000;
+  const usd = convert(eur, 'USD');
+  const gbp = convert(eur, 'GBP');
+
+  assert.equal(usd.ok, true);
+  assert.equal(gbp.ok, true);
+  assert(usd.value > eur);
+  assert(gbp.value < eur);
+});
+
+test('formatMoney preserves hundreds place', () => {
+  assert.equal(formatMoney(15, 'USD'), '$0.15');
+  assert.equal(formatMoney(101, 'USD'), '$1.01');
+  assert.equal(formatMoney(10001, 'GBP'), '£100.01');
+});
