+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const line = { qty: 2, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 17000);
+});
+
+test('lineTotal returns integer cents', () => {
+  const line = { qty: 1, unitPrice: 6000 };
+  assert.equal(lineTotal(line), 6000);
+  assert.equal(Number.isInteger(lineTotal(line)), true);
+});
+
+test('lineTotal handles single unit', () => {
+  const line = { qty: 1, unitPrice: 120000 };
+  assert.equal(lineTotal(line), 120000);
+});
+
+test('lineTotal with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 5000 };
+  assert.equal(lineTotal(line), 5000000);
+});
+
+test('lineTotal with fractional unitPrice (rare but possible)', () => {
+  const line = { qty: 3, unitPrice: 333.33 };
+  assert.equal(lineTotal(line), 999.99);
+});
+
+test('lineDiscount calculates discount amount', () => {
+  const line = { qty: 2, unitPrice: 10000, discountPercent: 10 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  assert.equal(discount, Math.round(total * 10 / 100));
+});
+
+test('lineDiscount defaults discountPercent to 0', () => {
+  const line = { qty: 2, unitPrice: 10000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount handles decimal discounts', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 12.5 };
+  const discount = lineDiscount(line);
+  assert.equal(Number.isInteger(discount), true);
+});
+
+test('lineDiscount rounds to nearest cent', () => {
+  const line = { qty: 3, unitPrice: 100, discountPercent: 33.333 };
+  const discount = lineDiscount(line);
+  assert.equal(Number.isInteger(discount), true);
+});
+
+test('lineDiscount returns 0 when discountPercent is 0', () => {
+  const line = { qty: 100, unitPrice: 10000, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 2, unitPrice: 10000, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 20000);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 2, unitPrice: 10000, discountPercent: 0, vatRate: 21 };
+  const total = lineTotal(line);
+  const vat = lineVat(line);
+  assert.equal(vat, Math.round(total * 21 / 100));
+});
+
+test('lineVat with 21% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 21 };
+  const vat = lineVat(line);
+  assert.equal(vat, 2100);
+});
+
+test('lineVat with 9% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 9 };
+  const vat = lineVat(line);
+  assert.equal(vat, 900);
+});
+
+test('lineVat with 0% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with discount and VAT', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  const expectedVat = Math.round(amountAfterDiscount * 21 / 100);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat rounds to nearest cent', () => {
+  const line = { qty: 3, unitPrice: 1000, discountPercent: 33.333, vatRate: 19.99 };
+  const vat = lineVat(line);
+  assert.equal(Number.isInteger(vat), true);
+});
+
+test('lineVat defaults vatRate to 0', () => {
+  const line = { qty: 2, unitPrice: 10000, discountPercent: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('invoiceTotals sums line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, vatRate: 0 },
+      { qty: 5, unitPrice: 9500, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 64500, discount: 0, vat: 0, voucher: 0, total: 64500 });
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 3, unitPrice: 6000, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 18000, discount: 0, vat: 0, voucher: 0, total: 18000 });
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, vatRate: 0 },
+      { qty: 2, unitPrice: 9500, vatRate: 0 },
+      { qty: 3, unitPrice: 6000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 45500, discount: 0, vat: 0, voucher: 0, total: 45500 });
+});
+
+test('invoiceTotals includes discount field', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 10000);
+});
+
+test('invoiceTotals sums discounts from multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 },
+      { qty: 100, unitPrice: 1000, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 30000);
+});
+
+test('invoiceTotals with mixed discount lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 },
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+      { qty: 100, unitPrice: 1000, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 300000);
+  assert.equal(totals.discount, 30000);
+  assert.equal(totals.total, 270000);
+});
+
+test('invoiceTotals clamps total at 0 if discount exceeds subtotal', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 200, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals returns discount: 0 when no discounts', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals includes vat field', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 2100);
+});
+
+test('invoiceTotals calculates total = subtotal - discount + vat', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 10000;
+  const discount = 1000;
+  const vat = Math.round((subtotal - discount) * 21 / 100);
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, subtotal - discount + vat);
+});
+
+test('invoiceTotals with multiple lines and different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 9 },
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const expectedVat = 2100 + 900 + 0;
+  assert.equal(totals.subtotal, 30000);
+  assert.equal(totals.vat, expectedVat);
+  assert.equal(totals.total, 30000 + expectedVat);
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 10000;
+  const discount = 1000;
+  const vat = Math.round((10000 - 1000) * 21 / 100);
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, subtotal - discount + vat);
+});
+
+test('invoiceTotals clamps total at 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, discountPercent: 200, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes voucher field', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 0 }],
+    voucher: { code: 'SUMMER10', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals subtracts voucher from total', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 0 }],
+    voucher: { code: 'SUMMER10', amount: 2000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 8000);
+});
+
+test('invoiceTotals with discount and voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 0 }],
+    voucher: { code: 'CODE', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1000);
+  assert.equal(totals.voucher, 500);
+  assert.equal(totals.total, 10000 - 1000 - 500);
+});
+
+test('invoiceTotals clamps total at 0 after voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 0 }],
+    voucher: { code: 'BIG', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals returns a new object', () => {
+  const invoice = { lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }] };
+  const totals1 = invoiceTotals(invoice);
+  const totals2 = invoiceTotals(invoice);
+  assert.notEqual(totals1, totals2);
+  assert.deepEqual(totals1, totals2);
+});
+
+test('invoiceTotals without voucher field defaults to 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, { subtotal: 0, discount: 0, vat: 0, voucher: 0, total: 0 });
+});
