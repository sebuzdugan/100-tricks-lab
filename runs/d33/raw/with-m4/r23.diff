 }
 
 /**
- * Calculate the discount amount for a line (lineTotal × discountPercent / 100).
+ * Calculate the discount amount for a line (lineTotal × discountPercent / 100, plus bulk discount if qty >= 10).
+ * Bulk discount is 2.5% of the amount remaining after the first discount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number} discount in cents
  */
 export function lineDiscount(line) {
   const total = lineTotal(line);
   const discountPercent = line.discountPercent ?? 0;
-  return roundCents(total * discountPercent / 100);
+  const baseDiscount = roundCents(total * discountPercent / 100);
+
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const amountAfterBaseDiscount = total - baseDiscount;
+    bulkDiscount = roundCents(amountAfterBaseDiscount * 2.5 / 100);
+  }
+
+  return baseDiscount + bulkDiscount;
 }
 
