+/**
+ * Generate a dashboard with key metrics.
+ * @param {Array<{ status: string, customerId: string, dueDate: string, payments?: Array<any> }>} invoices all invoices
+ * @param {string} asOf date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  invoices.forEach(inv => {
+    if (counts.hasOwnProperty(inv.status)) {
+      counts[inv.status]++;
+    }
+  });
+
+  // Calculate outstanding (invoices with status 'issued' or 'partially_paid')
+  const outstanding = invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid')
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  // Get overdue invoices
+  const overdueResult = overdueInvoices(invoices, asOf);
+  const overdueList = overdueResult.ok ? overdueResult.value : [];
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Group by customerId and calculate total due
+  const customerDueMap = {};
+  invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid')
+    .forEach(inv => {
+      const due = balanceDue(inv);
+      if (due > 0) {
+        if (!customerDueMap[inv.customerId]) {
+          customerDueMap[inv.customerId] = 0;
+        }
+        customerDueMap[inv.customerId] += due;
+      }
+    });
+
+  // Get top 3 customers with most outstanding
+  const topCustomers = Object.entries(customerDueMap)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({ counts, outstanding, overdue, topCustomers });
+}
