 export function renderInvoiceText(invoice) {
@@ -51,7 +52,24 @@ export function renderInvoiceText(invoice) {
   if (hasVat) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+
+  // Voucher (if any)
+  if (invoice.voucher && invoice.voucher.amount > 0) {
+    lines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date (if invoice has one)
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid amount (if invoice has payments)
+  const paid = invoice.payments ? invoice.payments.reduce((sum, p) => sum + p.amount, 0) : 0;
+  if (paid > 0) {
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return lines.join('\n');
 }
