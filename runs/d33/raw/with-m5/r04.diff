diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..074cf5c
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,38 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 when no invoices exist for that year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for the same year', () => {
+  const number = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber handles numbers in any order', () => {
+  const number = nextInvoiceNumber(['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const number = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0002', 'INV-2025-0005'], '2027-01-15');
+  assert.equal(number, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores invoices from other years', () => {
+  const number = nextInvoiceNumber(['INV-2025-0010', 'INV-2026-0002', 'INV-2027-0005'], '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber handles high counters', () => {
+  const number = nextInvoiceNumber(['INV-2026-9999'], '2026-12-31');
+  assert.equal(number, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber handles gaps in numbering', () => {
+  const number = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0005'], '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
