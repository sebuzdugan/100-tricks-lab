+++ b/src/numbering.js
@@ -0,0 +1,25 @@
+/**
+ * Get the next invoice number for a given year.
+ * @param {Array<string>} existingNumbers - Invoice numbers already issued (e.g., 'INV-2026-0001')
+ * @param {string} issueDate - Invoice issue date in YYYY-MM-DD format
+ * @returns {string} The next invoice number (e.g., 'INV-2026-0005')
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Extract counters for this year
+  const yearCounters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = parseInt(num.substring(prefix.length), 10);
+      return counter;
+    })
+    .filter((counter) => !isNaN(counter));
+
+  // Find the next counter
+  const maxCounter = yearCounters.length > 0 ? Math.max(...yearCounters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
