+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+import { getCustomer } from './customers.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string} Plain-text invoice
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  lines.push(invoice.number ?? 'DRAFT');
+
+  // Second line: customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+  lines.push(customerName);
+
+  // One line per invoice line
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineParts = [
+      line.qty,
+      '×',
+      line.name,
+      '@',
+      formatEuros(line.unitPrice),
+      '=',
+      formatEuros(total),
+    ];
+    lines.push(lineParts.join(' '));
+  }
+
+  // Total line
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..dacd522
