+++ b/test/render.test.js
@@ -0,0 +1,111 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const text = renderInvoiceText(r2.value);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /\nNorthwind Studio\n/);
+});
+
+test('renderInvoiceText shows line details', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /10 × Design work \(hour\) @ €85\.00 = €850\.00/);
+});
+
+test('renderInvoiceText shows multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /10 × Design work \(hour\) @ €85\.00 = €850\.00/);
+  assert.match(text, /1 × Logo package @ €1,200\.00 = €1,200\.00/);
+});
+
+test('renderInvoiceText shows total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /\nTotal: €850\.00$/);
+});
+
+test('renderInvoiceText calculates total correctly for multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Total: €1,325\.00$/);
+});
+
+test('renderInvoiceText has correct line order', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /Design work/);
+  assert.match(lines[3], /Development/);
+  assert.match(lines[4], /Total:/);
+});
+
+test('renderInvoiceText formats amounts as euros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 50 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /€9\.80/);
+  assert.match(text, /Total: €490\.00/);
+});
