+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(r.ok, true);
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.total, 80750);
+});
+
+test('createInvoice silver customer totals with tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(r.ok, true);
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 2125);
+  assert.equal(totals.total, 82875);
+});
+
+test('createInvoice standard customer totals with tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(r.ok, true);
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 85000);
+});
+
+test('createInvoice multiple lines with different tier applications', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5, discountPercent: 10 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+  assert.equal(r.value.lines[1].discountPercent, 10);
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal > 0, true);
+  assert.equal(totals.discount > 0, true);
+  assert.equal(totals.total, totals.subtotal - totals.discount);
+});
