+});
+
+test('createInvoice applies silver tier discount (2.5%) when no discountPercent', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
