+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  // Check format
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(String(text))) {
+    return false;
+  }
+
+  // Parse and verify it's a valid date
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) {
+    return false;
+  }
+
+  // Verify the parsed date matches the input (catches Feb 30, Apr 31, etc.)
+  return date.toISOString().substring(0, 10) === text;
+}
+
+/**
+ * Add n days to a date in YYYY-MM-DD format (UTC arithmetic).
+ * Returns a new date string in YYYY-MM-DD format.
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} New date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const date = new Date(dateStr + 'T00:00:00Z');
+  date.setUTCDate(date.getUTCDate() + n);
+  return date.toISOString().substring(0, 10);
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a, in UTC).
+ * Both dates are in YYYY-MM-DD format.
+ * @param {string} a - Start date in YYYY-MM-DD format
+ * @param {string} b - End date in YYYY-MM-DD format
+ * @returns {number} Number of whole days from a to b
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
