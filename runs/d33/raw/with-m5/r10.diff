diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..7c52668
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,137 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('26-10-07'), false);
+});
+
+test('isValidDate rejects impossible dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-10-32'), false);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2026-02-29'), false);
+  assert.equal(isValidDate('2100-02-29'), false);
+});
+
+test('isValidDate accepts leap year Feb 29', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('2004-02-29'), true);
+});
+
+test('isValidDate rejects non-string inputs', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate('2026-10-07extra'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 7), '2026-10-14');
+  assert.equal(addDays('2026-10-07', 365), '2027-10-07');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -7), '2026-09-30');
+  assert.equal(addDays('2026-10-07', -365), '2025-10-07');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-11-30', 1), '2026-12-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles month boundaries backwards', () => {
+  assert.equal(addDays('2026-11-01', -1), '2026-10-31');
+  assert.equal(addDays('2026-12-01', -1), '2026-11-30');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-03-01', -1), '2024-02-29');
+});
+
+test('addDays returns zero days as same date', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween calculates days forward', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-14'), 7);
+  assert.equal(daysBetween('2026-10-07', '2027-10-07'), 365);
+});
+
+test('daysBetween calculates days backward (negative)', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-14', '2026-10-07'), -7);
+  assert.equal(daysBetween('2027-10-07', '2026-10-07'), -365);
+});
+
+test('daysBetween same date returns zero', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-10-31', '2026-11-02'), 2);
+  assert.equal(daysBetween('2026-11-01', '2026-10-31'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('daysBetween in UTC (timezone independent)', () => {
+  const a = '2026-10-07';
+  const b = '2026-10-14';
+  assert.equal(daysBetween(a, b), 7);
+  assert.equal(daysBetween(b, a), -7);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const start = '2026-10-07';
+  const days = 42;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+});
+
+test('addDays roundtrip with negative days', () => {
+  const start = '2026-10-07';
+  const days = 100;
+  const end = addDays(start, days);
+  const back = addDays(end, -days);
+  assert.equal(back, start);
+});
