+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the total amount paid on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {number} Total paid in cents
+ */
+export function totalPaid(invoice) {
+  if (!Array.isArray(invoice.payments)) {
+    return 0;
+  }
+  return invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+}
+
+/**
+ * Calculate the balance due on an invoice.
+ * @param {{ lines: Array<any>, payments?: Array<{ amount: number }> }} invoice
+ * @returns {number} Balance due in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  return Math.max(0, totals.total - totalPaid(invoice));
+}
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array<any>, payments?: Array<any> }} invoice
+ * @param {{ amount: number, date: string }} param1
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check status: must be 'issued' or 'partially_paid'
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date format
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount: must be a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check for overpayment
+  const owed = balanceDue(invoice);
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array
+  const newPayments = Array.isArray(invoice.payments) ? [...invoice.payments] : [];
+  newPayments.push({ amount, date });
+
+  // Determine new status
+  const totalPaidAfter = totalPaid({ payments: newPayments });
+  const totals = invoiceTotals(invoice);
+  let newStatus;
+  if (totalPaidAfter >= totals.total) {
+    newStatus = 'paid';
+  } else {
+    newStatus = 'partially_paid';
+  }
+
+  return ok({
+    ...invoice,
+    status: newStatus,
+    payments: newPayments,
+  });
+}
