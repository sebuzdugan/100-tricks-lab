+/**
+ * Calculate the last day of the month for a given date.
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @returns {string} Last day of the month in YYYY-MM-DD format
+ */
+function lastDayOfMonth(dateStr) {
+  const [year, month] = dateStr.split('-');
+  const nextMonth = String(parseInt(month) + 1).padStart(2, '0');
+  const nextMonthFirstDay = `${year}-${nextMonth}-01`;
+  return addDays(nextMonthFirstDay, -1);
+}
+
+/**
+ * Calculate the due date based on payment terms.
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @param {string} terms - Payment terms: 'NET14', 'NET30', or 'EOM'
+ * @returns {string} Due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    return lastDayOfMonth(issueDate);
+  }
+  return null;
+}
 
