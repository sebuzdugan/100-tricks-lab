     status: 'issued',
   });
 }
+
+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: any, lines: Array<any> }} invoice
+ * @param {{ code: string, amount: number }} param1
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check status: must be draft
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Check if voucher already exists
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  // Validate amount: must be a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
