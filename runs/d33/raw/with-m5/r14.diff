+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = statement('C-999', [], '2026-10-07');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement returns DATE_INVALID for invalid asOf date', () => {
+  const r = statement('C-001', [], '2026-13-01');
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('statement includes only issued and partially_paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement excludes draft invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+
+  const r = statement('C-001', [draft], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement includes invoices on asOf date', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement normalizes customer id', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = statement('c-001', [issued], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+});
+
+test('statement returns invoice number, dates, total, and due', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+
+  const inv = r.value.invoices[0];
+  assert.equal(inv.number, 'INV-2026-0001');
+  assert.equal(inv.issueDate, '2026-10-07');
+  assert.equal(inv.dueDate, '2026-11-06');
+  assert.equal(typeof inv.total, 'number');
+  assert.equal(typeof inv.due, 'number');
+});
+
+test('statement calculates due as balance remaining', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-10');
+  assert.equal(r.ok, true);
+
+  const inv = r.value.invoices[0];
+  assert.equal(inv.due, inv.total);
+});
+
+test('statement calculates due after partial payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const withPayment = recordPayment(issued, { amount: 30000, date: '2026-10-08' }).value;
+
+  const r = statement('C-001', [withPayment], '2026-10-10');
+  assert.equal(r.ok, true);
+
+  const inv = r.value.invoices[0];
+  assert.equal(inv.due, inv.total - 30000);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const inv1 = issueInvoice(inv1Result.value, ['INV-2026-0001']).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2026-0001']).value;
+
+  const inv3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const inv3 = issueInvoice(inv3Result.value, ['INV-2026-0001']).value;
+
+  const r = statement('C-001', [inv1, inv2, inv3], '2026-10-20');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-10');
+  assert.equal(r.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement sums totalDue from all invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2026-0001']).value;
+
+  const r = statement('C-001', [inv1, inv2], '2026-10-20');
+  assert.equal(r.ok, true);
+
+  // totalDue should equal sum of due from all invoices
+  const totalFromInvoices = r.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(r.value.totalDue, totalFromInvoices);
+});
+
+test('statement filters by customer', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2026-0001']).value;
+
+  const r = statement('C-001', [inv1, inv2], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const partial = recordPayment(issued, { amount: 30000, date: '2026-10-08' }).value;
+
+  const r = statement('C-001', [partial], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(partial.status, 'partially_paid');
+});
+
+test('statement returns empty list for customer with no invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement handles multiple payments on same invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  let current = issued;
+  current = recordPayment(current, { amount: 20000, date: '2026-10-08' }).value;
+  current = recordPayment(current, { amount: 20000, date: '2026-10-09' }).value;
+
+  const r = statement('C-001', [current], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+
+  const inv = r.value.invoices[0];
+  assert.equal(inv.due, inv.total - 40000);
+});
+
+test('statement handles empty invoices array', () => {
+  const r = statement('C-001', [], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
