+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Partial refund', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Partial refund');
+  assert.equal(r.value.date, '2026-10-10');
+});
+
+test('createCreditNote works on partially_paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const partial = recordPayment(issued, { amount: 30000, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(partial, { amount: 5000, reason: 'Adjustment', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(paid, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote reports NOT_ISSUED for draft invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+
+  const r = createCreditNote(draft, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for non-positive amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const result1 = createCreditNote(issued, { amount: 0, reason: 'Refund', date: '2026-10-10' }, []);
+  assert.deepEqual(result1, { ok: false, error: 'AMOUNT_INVALID' });
+
+  const result2 = createCreditNote(issued, { amount: -1000, reason: 'Refund', date: '2026-10-10' }, []);
+  assert.deepEqual(result2, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for non-integer amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = createCreditNote(issued, { amount: 5000.50, reason: 'Refund', date: '2026-10-10' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote reports DATE_INVALID for invalid date', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2026-13-01' }, []);
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote reports CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const r = createCreditNote(issued, { amount: totals.total + 1, reason: 'Refund', date: '2026-10-10' }, []);
+  assert.deepEqual(r, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const r = createCreditNote(issued, { amount: totals.total, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, totals.total);
+});
+
+test('createCreditNote generates sequential numbers within a year', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r1 = createCreditNote(issued, { amount: 5000, reason: 'Refund 1', date: '2026-10-10' }, []);
+  assert.equal(r1.value.number, 'CN-2026-0001');
+
+  const r2 = createCreditNote(issued, { amount: 3000, reason: 'Refund 2', date: '2026-10-15' }, ['CN-2026-0001']);
+  assert.equal(r2.value.number, 'CN-2026-0002');
+
+  const r3 = createCreditNote(issued, { amount: 2000, reason: 'Refund 3', date: '2026-10-20' }, ['CN-2026-0001', 'CN-2026-0002']);
+  assert.equal(r3.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r1 = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, ['CN-2026-0005']);
+  assert.equal(r1.value.number, 'CN-2026-0006');
+
+  const r2 = createCreditNote(issued, { amount: 3000, reason: 'Refund', date: '2027-01-15' }, ['CN-2026-0010']);
+  assert.equal(r2.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote ignores invoice numbers when counting credit notes', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003']);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote credit note number sequence independent of invoice numbers', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const existingNumbers = ['INV-2026-0001', 'CN-2026-0001', 'INV-2026-0002', 'CN-2026-0002', 'INV-2026-0003'];
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, existingNumbers);
+  assert.equal(r.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote preserves invoice number in credit note', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']);
+  assert.equal(r.value.invoiceNumber, 'INV-2026-0001');
+});
+
+test('createCreditNote handles high counter numbers', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const existingNumbers = Array.from({ length: 9999 }, (_, i) => `CN-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, existingNumbers);
+  assert.equal(r.value.number, 'CN-2026-10000');
+});
+
+test('createCreditNote with multiple lines invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const r = createCreditNote(issued, { amount: 50000, reason: 'Partial refund', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert(r.value.amount <= totals.total);
+});
+
+test('createCreditNote with voucher on invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const r = createCreditNote(issued, { amount: totals.total, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, totals.total);
+});
+
+test('createCreditNote preserves customer ID', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, []);
