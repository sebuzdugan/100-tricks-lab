+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate the next credit note number.
+ * @param {Array<string>} existingNumbers - All existing invoice and credit note numbers
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} Credit note number in format CN-YYYY-NNNN
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+
+  // Filter to credit notes from this year
+  const creditNotesThisYear = existingNumbers
+    .filter((num) => num.startsWith('CN-'))
+    .filter((num) => num.startsWith(`CN-${year}-`));
+
+  // Find the highest counter
+  let maxCounter = 0;
+  for (const num of creditNotesThisYear) {
+    const match = num.match(/CN-\d+-(\d+)/);
+    if (match) {
+      const counter = parseInt(match[1], 10);
+      maxCounter = Math.max(maxCounter, counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an invoice.
+ * @param {{ number?: string, customerId: string, status: string, lines: Array<any>, payments?: Array<any>, voucher?: any }} invoice
+ * @param {{ amount: number, reason: string, date: string }} param1
+ * @param {Array<string>} existingNumbers - All existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check status: must be issued, partially_paid, or paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date format
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount: must be a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check credit amount doesn't exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number || 'DRAFT',
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
