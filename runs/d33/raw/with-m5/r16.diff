+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns DATE_INVALID for invalid asOf date', () => {
+  const r = overdueInvoices([], '2026-13-01');
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('overdueInvoices returns empty array for no invoices', () => {
+  const r = overdueInvoices([], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.deepEqual(r.value, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+
+  const r = overdueInvoices([draft], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.deepEqual(r.value, []);
+});
+
+test('overdueInvoices excludes invoices with status paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-05' }).value;
+
+  const r = overdueInvoices([paid], '2026-11-07');
+  assert.equal(r.ok, true);
+  assert.deepEqual(r.value, []);
+});
+
+test('overdueInvoices excludes invoices with dueDate on or after asOf', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const r = overdueInvoices([issued], '2026-10-30');
+  assert.equal(r.ok, true);
+  assert.deepEqual(r.value, []);
+});
+
+test('overdueInvoices includes issued invoice with dueDate before asOf', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const r = overdueInvoices([issued], '2026-11-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 1);
+  assert.equal(r.value[0].number, issued.number);
+  assert.equal(r.value[0].customerId, 'C-001');
+  assert.equal(r.value[0].dueDate, issued.dueDate);
+});
+
+test('overdueInvoices includes partially_paid invoice with dueDate before asOf', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+  const partial = recordPayment(issued, { amount: 1000, date: '2026-10-05' }).value;
+
+  const r = overdueInvoices([partial], '2026-11-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 1);
+  assert.equal(r.value[0].number, partial.number);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const r = overdueInvoices([issued], '2026-11-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value[0].daysOverdue, 37);
+});
+
+test('overdueInvoices includes due amount from balanceDue', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+  const partial = recordPayment(issued, { amount: 1000, date: '2026-10-05' }).value;
+
+  const r = overdueInvoices([partial], '2026-11-07');
+  assert.equal(r.ok, true);
+  const totals = invoiceTotals(partial);
+  assert.equal(r.value[0].due, totals.total - 1000);
+});
+
+test('overdueInvoices sorts by daysOverdue descending (most overdue first)', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2026-0001']).value;
+
+  const r = overdueInvoices([inv2, inv1], '2026-11-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 2);
+  assert.equal(r.value[0].number, inv1.number);
+  assert.equal(r.value[1].number, inv2.number);
+  assert(r.value[0].daysOverdue > r.value[1].daysOverdue);
+});
+
+test('overdueInvoices handles multiple invoices from same customer', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2026-0001']).value;
+
+  const r = overdueInvoices([inv1, inv2], '2026-11-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 2);
+  assert.equal(r.value[0].customerId, 'C-001');
+  assert.equal(r.value[1].customerId, 'C-001');
+});
+
+test('overdueInvoices handles one day overdue (dueDate is one day before asOf)', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const r = overdueInvoices([issued], '2026-11-01');
+  assert.equal(r.ok, true);
+  assert.equal(r.value[0].daysOverdue, 1);
+});
