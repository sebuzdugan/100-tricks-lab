@@ -30,3 +31,39 @@ export function overdueInvoices(invoices, asOf) {
 
   return ok(overdue);
 }
+
+/**
+ * Generate a VAT summary over invoices.
+ * @param {Array<any>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const rateMap = {};
+
+  for (const invoice of invoices) {
+    if (
+      invoice.status !== 'issued' &&
+      invoice.status !== 'partially_paid' &&
+      invoice.status !== 'paid'
+    ) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate ?? 0;
+      const discount = lineDiscount(line);
+      const lineTotal = line.qty * line.unitPrice;
+      const base = lineTotal - discount;
+      const vat = lineVat(line);
+
+      if (!rateMap[rate]) {
+        rateMap[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      rateMap[rate].base += base;
+      rateMap[rate].vat += vat;
+    }
+  }
+
+  return Object.values(rateMap).sort((a, b) => b.rate - a.rate);
+}
