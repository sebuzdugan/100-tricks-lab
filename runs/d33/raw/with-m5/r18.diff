 /**
  * Get overdue invoices.
@@ -67,3 +68,24 @@ export function vatSummary(invoices) {
 
   return Object.values(rateMap).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate the late fee on an invoice.
+ * @param {{ dueDate: string, lines: Array<any>, payments?: Array<any> }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lateFee(invoice, asOf) {
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return ok(0);
+  }
+
+  const due = balanceDue(invoice);
+  const fee = roundCents(due * 0.0004 * daysOverdue);
+  return ok(Math.max(0, fee));
+}
