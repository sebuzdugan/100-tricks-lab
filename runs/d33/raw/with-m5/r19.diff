+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Convert cents to euros string with 2 decimals.
+ * @param {number} cents
+ * @returns {string}
+ */
+function centsToEuros(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Escape a field for CSV: double quotes around field if it contains comma, quote, or newline.
+ * Double any quotes inside the field.
+ * @param {*} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  const str = String(field);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<any>} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const rows = invoices.map((invoice) => {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number || 'DRAFT',
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      centsToEuros(totals.subtotal),
+      centsToEuros(totals.discount),
+      centsToEuros(totals.vat),
+      centsToEuros(totals.total),
+      centsToEuros(due),
+    ];
+
+    return fields.map(escapeCsvField).join(',') + '\n';
+  });
+
+  return header + rows.join('');
+}
diff --git a/test/export.test.js b/test/export.test.js
