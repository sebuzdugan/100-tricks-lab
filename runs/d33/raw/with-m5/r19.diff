+++ b/test/export.test.js
@@ -0,0 +1,265 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns header line', () => {
+  const csv = exportCsv([]);
+  assert(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv handles empty invoices array', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const csv = exportCsv([issued]);
+  assert(csv.includes('INV-2026-0001'));
+  assert(csv.includes('Northwind'));
+  assert(csv.includes('2026-09-01'));
+});
+
+test('exportCsv includes all columns for issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+
+  assert(dataLine.includes('INV-2026-0001'));
+  assert(dataLine.includes('Northwind'));
+  assert(dataLine.includes('2026-09-01'));
+  assert(dataLine.includes('2026-10-01'));
+  assert(dataLine.includes('issued'));
+  assert(dataLine.includes((totals.subtotal / 100).toFixed(2)));
+  assert(dataLine.includes((totals.total / 100).toFixed(2)));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const csv = exportCsv([issued]);
+  assert(csv.includes('50.00'));
+});
+
+test('exportCsv shows DRAFT for unseen invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+
+  const csv = exportCsv([draft]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  assert(dataLine.startsWith('DRAFT'));
+});
+
+test('exportCsv includes multiple invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2026-0001']).value;
+
+  const csv = exportCsv([inv1, inv2]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 4);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv escapes fields with commas', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const csv = exportCsv([issued]);
+  assert(csv.includes('"Smith'));
+});
+
+test('exportCsv escapes fields with quotes', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const csv = exportCsv([issued]);
+  assert(csv.includes('""'));
+});
+
+test('exportCsv includes partially_paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+  const partial = recordPayment(issued, { amount: 1000, date: '2026-10-05' }).value;
+
+  const csv = exportCsv([partial]);
+  assert(csv.includes('partially_paid'));
+});
+
+test('exportCsv includes paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-05' }).value;
+
+  const csv = exportCsv([paid]);
+  assert(csv.includes('paid'));
+});
+
+test('exportCsv shows due amount of 0 for paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-05' }).value;
+
+  const csv = exportCsv([paid]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  assert(dataLine.endsWith('0.00\n') || dataLine.trim().endsWith('0.00'));
+});
+
+test('exportCsv shows correct due amount for partially paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+  const totals = invoiceTotals(issued);
+  const partial = recordPayment(issued, { amount: totals.total / 2, date: '2026-10-05' }).value;
+
+  const csv = exportCsv([partial]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  const due = parseFloat(fields[fields.length - 1]);
+  assert(due > 0);
+});
+
+test('exportCsv lines end with newline', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+  assert(lines[0].includes('number'));
+  assert(lines[1].includes('INV-2026-0001'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2026-0001']).value;
+
+  const inv3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-03',
+    lines: [{ sku: 'COPY-HOUR', qty: 1 }],
+  });
+  const inv3 = issueInvoice(inv3Result.value, ['INV-2026-0002']).value;
+
+  const csv = exportCsv([inv3, inv1, inv2]);
+  const lines = csv.split('\n');
+  assert(lines[1].includes('INV-2026-0003'));
+  assert(lines[2].includes('INV-2026-0001'));
+  assert(lines[3].includes('INV-2026-0002'));
+});
+
+test('exportCsv handles invoices with discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  assert(dataLine.includes('0.00') || dataLine.includes('850'));
+});
+
+test('exportCsv escapes multiple quotes correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const csv = exportCsv([issued]);
+  assert(csv.includes('""'));
+});
