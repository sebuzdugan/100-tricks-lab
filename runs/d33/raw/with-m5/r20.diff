+
+test('convert returns ok for known currencies', () => {
+  const r = convert(100, 'EUR');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 100);
+});
+
+test('convert returns UNKNOWN_CURRENCY for unknown currency', () => {
+  const r = convert(100, 'JPY');
