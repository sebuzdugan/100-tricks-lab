+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 1000 }), 5000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 8500 }), 8500);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 250 }), 25000);
+});
+
+test('lineDiscount defaults discountPercent to 0', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000 }), 0);
+});
+
+test('lineDiscount calculates discount as percentage of line total', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 10 }), 10000);
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 5 }), 5000);
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 100 }), 100000);
+});
+
+test('lineDiscount handles 0% discount', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 0 }), 0);
+});
+
+test('lineDiscount rounds fractional cents', () => {
+  assert.equal(lineDiscount({ qty: 3, unitPrice: 1000, discountPercent: 33.33 }), 1000);
+});
+
+test('lineDiscount clamps result to 0 minimum', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: -10 }), 0);
+});
+
+test('lineVat defaults vatRate to 0', () => {
+  assert.equal(lineVat({ qty: 100, unitPrice: 1000 }), 0);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 };
+  const total = 100000;
+  const discount = 10000;
+  const afterDiscount = 90000;
+  const expectedVat = Math.round(afterDiscount * 0.21);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat handles 0% VAT', () => {
+  assert.equal(lineVat({ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 }), 0);
+});
+
+test('lineVat handles 9% VAT', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 9 };
+  const total = 100000;
+  const expectedVat = Math.round(total * 0.09);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat handles 21% VAT', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 };
+  const total = 100000;
+  const expectedVat = Math.round(total * 0.21);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat clamps result to 0 minimum', () => {
+  assert.equal(lineVat({ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: -5 }), 0);
+});
+
+test('invoiceTotals returns subtotal and total', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 100000);
+  assert.equal(result.total, 100000);
+});
+
+test('invoiceTotals includes discount, vat, and voucher fields', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.ok('discount' in result);
+  assert.ok('vat' in result);
+  assert.ok('voucher' in result);
+});
+
+test('invoiceTotals works with single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 85000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+});
+
+test('invoiceTotals works with many lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000 },
+      { qty: 20, unitPrice: 2000 },
+      { qty: 5, unitPrice: 5000 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 75000);
+});
+
+test('invoiceTotals calculates discount on single line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 10000);
+});
+
+test('invoiceTotals handles multiple lines with different discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10 },
+      { qty: 50, unitPrice: 1000, discountPercent: 20 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 20000);
+});
+
+test('invoiceTotals handles 0% discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 0);
+});
+
+test('invoiceTotals handles 100% discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 100 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 100000);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals handles decimal discount percentages', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 5.5 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 5500);
+});
+
+test('invoiceTotals includes vat field', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.vat, 21000);
+});
+
+test('invoiceTotals calculates total as subtotal - discount + vat', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.total, 100000 - 10000 + 18900);
+});
+
+test('invoiceTotals handles multiple lines with different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.vat, 21000 + 9000);
+});
+
+test('invoiceTotals with discount and VAT on multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 2000, discountPercent: 20, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  const line1Discount = 10000;
+  const line1Vat = Math.round((100000 - 10000) * 0.21);
+  const line2Discount = Math.round(100000 * 0.20);
+  const line2Vat = Math.round((100000 - line2Discount) * 0.09);
+  assert.equal(result.subtotal, 200000);
+  assert.equal(result.discount, line1Discount + line2Discount);
+  assert.equal(result.vat, line1Vat + line2Vat);
+});
+
+test('invoiceTotals clamps vat to 0 minimum', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: -5 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.vat, 0);
+});
+
+test('invoiceTotals does not mutate invoice', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const linesBefore = JSON.stringify(invoice.lines);
+  invoiceTotals(invoice);
+  const linesAfter = JSON.stringify(invoice.lines);
+  assert.equal(linesBefore, linesAfter);
+});
+
+test('invoiceTotals with real products', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 200000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 242500);
+});
+
+test('invoiceTotals without voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 100000);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000 }],
+    voucher: { code: 'SAVE10', amount: 10000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 10000);
+  assert.equal(result.total, 90000);
+});
+
+test('invoiceTotals with voucher subtracts from total', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE5', amount: 5000 },
+  };
+  const result = invoiceTotals(invoice);
+  const expectedTotal = 100000 - 10000 + 18900 - 5000;
+  assert.equal(result.total, expectedTotal);
+});
+
+test('invoiceTotals clamps all values to 0 minimum', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 100, vatRate: 21 }],
+    voucher: { code: 'X', amount: 50000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.ok(result.subtotal >= 0);
+  assert.ok(result.discount >= 0);
+  assert.ok(result.vat >= 0);
+  assert.ok(result.voucher >= 0);
+  assert.ok(result.total >= 0);
+});
+
+test('invoiceTotals returns all five fields: subtotal, discount, vat, voucher, total', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 5, vatRate: 21 }],
+    voucher: { code: 'X', amount: 1000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.ok('subtotal' in result && typeof result.subtotal === 'number');
+  assert.ok('discount' in result && typeof result.discount === 'number');
+  assert.ok('vat' in result && typeof result.vat === 'number');
+  assert.ok('voucher' in result && typeof result.voucher === 'number');
+  assert.ok('total' in result && typeof result.total === 'number');
+});
