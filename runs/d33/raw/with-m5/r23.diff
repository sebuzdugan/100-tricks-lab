@@ -10,15 +10,20 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount for a single invoice line.
+ * Calculate the discount for a single invoice line (including bulk discount).
+ * First applies line discount, then applies 2.5% bulk discount if qty >= 10.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
- * @returns {number} Discount in cents
+ * @returns {number} Total discount in cents (line discount + bulk discount)
  */
 export function lineDiscount(line) {
   const discountPercent = line.discountPercent ?? 0;
   const total = lineTotal(line);
-  const discount = roundCents(total * discountPercent / 100);
-  return Math.max(0, discount);
+  const lineDiscountAmount = roundCents(total * discountPercent / 100);
+
+  const bulkDiscountAmount = line.qty >= 10 ? roundCents((total - lineDiscountAmount) * 2.5 / 100) : 0;
+
+  const totalDiscount = lineDiscountAmount + bulkDiscountAmount;
+  return Math.max(0, totalDiscount);
 }
 
