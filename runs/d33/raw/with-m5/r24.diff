+test('dashboard counts invoices by status', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 9 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 9 }],
+  }).value;
+
+  const issued2 = issueInvoice(draft2, ['INV-2026-0001']).value;
+  const partial = recordPayment(issued2, { amount: 1000, date: '2026-10-05' }).value;
+
+  const invoices = [draft, issued, partial];
+  const r = dashboard(invoices, '2026-10-07');
