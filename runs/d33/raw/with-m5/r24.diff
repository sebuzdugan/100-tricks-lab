   const fee = roundCents(due * 0.0004 * daysOverdue);
   return ok(Math.max(0, fee));
 }
+
+/**
+ * Generate a dashboard summary of invoices.
+ * @param {Array<any>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDueMap = {};
+
+  for (const invoice of invoices) {
+    counts[invoice.status]++;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDueMap[invoice.customerId]) {
+        customerDueMap[invoice.customerId] = 0;
+      }
+      customerDueMap[invoice.customerId] += due;
+    }
+  }
+
+  const overdueResult = overdueInvoices(invoices, asOf);
+  let overdue = { count: 0, amount: 0 };
+  if (overdueResult.ok) {
+    overdue.count = overdueResult.value.length;
+    overdue.amount = overdueResult.value.reduce((sum, inv) => sum + inv.due, 0);
+  }
+
+  const topCustomers = Object.entries(customerDueMap)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  });
+}
