@@ -0,0 +1,167 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a valid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 8500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice handles multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[1].name, 'Icon set (24 icons)');
+});
+
+test('createInvoice rejects unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026/10/07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects date without time component', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '10-07-2026',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects invalid date values', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-13-32',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects empty lines array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice rejects non-array lines', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: null,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice rejects zero quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 0 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects negative quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: -1 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects fractional quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'NOPE', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice copies product data without mutation', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  };
+  const r1 = createInvoice(input);
+  r1.value.lines[0].unitPrice = 9999;
+  const r2 = createInvoice(input);
+  assert.equal(r2.value.lines[0].unitPrice, 8500);
+});
+
+test('createInvoice rejects invalid quantity type', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 'five' }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
