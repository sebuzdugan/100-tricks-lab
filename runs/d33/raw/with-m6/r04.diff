new file mode 100644
index 0000000..342500e
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,25 @@
+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<4-digit counter starting at 0001>.
+ * @param {Array<string>} existingNumbers - invoice numbers already issued
+ * @param {string} issueDate - in YYYY-MM-DD format
+ * @returns {string} next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Find all numbers for this year and extract their counters
+  const countersForYear = existingNumbers
+    .filter((num) => num.startsWith(`INV-${year}-`))
+    .map((num) => {
+      const counter = num.substring(`INV-${year}-`.length);
+      return parseInt(counter, 10);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  // Find the max counter, default to 0 if none exist
+  const maxCounter = countersForYear.length > 0 ? Math.max(...countersForYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
