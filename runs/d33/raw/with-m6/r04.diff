diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..6a9a21d
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,51 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates first number for a year', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter within a year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0100', 'INV-2026-0001', 'INV-2026-0002', 'INV-2027-0050'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = Array.from({ length: 999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber handles gaps in numbering', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0005'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber works across year boundary', () => {
+  const existing = ['INV-2025-9999', 'INV-2026-0001', 'INV-2027-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2025-12-31'), 'INV-2025-10000');
+  assert.equal(nextInvoiceNumber(existing, '2026-01-01'), 'INV-2026-0002');
+  assert.equal(nextInvoiceNumber(existing, '2027-06-15'), 'INV-2027-0002');
+});
