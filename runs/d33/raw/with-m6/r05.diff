+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string} plain-text invoice
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown';
+
+  // Build lines
+  const lines = [];
+
+  // Header: invoice number or DRAFT
+  lines.push(invoice.number ?? 'DRAFT');
+
+  // Customer name
+  lines.push(customerName);
+
+  // Line items
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Total
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..aa4cfea
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,147 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsaved invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText formats line items with quantities and totals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5 Design work \(hour\)/);
+  assert.match(text, /€85\.00/);
+  assert.match(text, /€425\.00/);
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /3 Design work \(hour\)/);
+  assert.match(text, /2 Icon set \(24 icons\)/);
+  assert.match(text, /€255\.00/);
+  assert.match(text, /€19\.60/);
+});
+
+test('renderInvoiceText shows total at the end', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Total: €425\.00$/);
+});
+
+test('renderInvoiceText sums multiple lines in total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'ICON-SET', qty: 10 },
+    ],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Total: €523\.00$/);
+});
+
+test('renderInvoiceText formats prices with euro symbol and two decimals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /€0\.50/);
+  assert.match(text, /€50\.00/);
+});
+
+test('renderInvoiceText works with different customers', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const text1 = renderInvoiceText(invoice1);
+  const text2 = renderInvoiceText(invoice2);
+  assert.match(text1, /Northwind Studio/);
+  assert.match(text2, /Kite & Co/);
+});
+
+test('renderInvoiceText returns multiline text', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'ICON-SET', qty: 3 },
+    ],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  const lineCount = text.split('\n').length;
+  assert.equal(lineCount, 5); // DRAFT, customer, line1, line2, total
+});
+
+test('renderInvoiceText includes all required elements in order', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'ICON-SET', qty: 1 },
+    ],
+  }).value;
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /1 Design work/);
+  assert.match(lines[3], /1 Icon set/);
+  assert.match(lines[4], /Total:/);
+});
