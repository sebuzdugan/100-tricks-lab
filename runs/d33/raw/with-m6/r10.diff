diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..2cf68d9
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,122 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid date formats', () => {
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026-10-07T00:00:00Z'), false);
+  assert.equal(isValidDate('2026-1-7'), false);
+});
+
+test('isValidDate rejects invalid calendar dates', () => {
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate rejects empty and null values', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('   '), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('2004-02-29'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2001-02-29'), false);
+  assert.equal(isValidDate('2100-02-29'), false);
+  assert.equal(isValidDate('2200-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 100), '2027-01-15');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+  assert.equal(addDays('2026-10-07', -100), '2026-06-29');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween calculates difference in days', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2027-01-15'), 100);
+});
+
+test('daysBetween handles same date', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles negative differences', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+  assert.equal(daysBetween('2027-01-15', '2026-10-07'), -100);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+});
+
+test('daysBetween handles leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween handles non-leap year', () => {
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const start = '2026-10-07';
+  const n = 50;
+  const end = addDays(start, n);
+  assert.equal(daysBetween(start, end), n);
+  assert.equal(addDays(end, -n), start);
+});
+
+test('addDays with large positive numbers', () => {
+  const result = addDays('2020-01-01', 2000);
+  assert.equal(daysBetween('2020-01-01', result), 2000);
+});
+
+test('addDays with large negative numbers', () => {
+  const result = addDays('2030-01-01', -2000);
+  assert.equal(daysBetween(result, '2030-01-01'), 2000);
+});
+
+test('daysBetween with far apart dates', () => {
+  const days = daysBetween('2000-01-01', '2026-10-07');
+  assert(days > 9700 && days < 9800);
+});
