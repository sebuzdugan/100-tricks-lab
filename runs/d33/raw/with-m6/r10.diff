+/**
+ * Validate a date string in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean} true if valid date
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) {
+    return false;
+  }
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) {
+    return false;
+  }
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  const normalized = `${year}-${month}-${day}`;
+  return normalized === text;
+}
+
+/**
+ * Add days to a date. All operations in UTC.
+ * @param {string} date YYYY-MM-DD format
+ * @param {number} n days to add (can be negative)
+ * @returns {string} YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  const year = d.getUTCFullYear();
+  const month = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate days between two dates (b - a, in whole days).
+ * @param {string} a YYYY-MM-DD format
+ * @param {string} b YYYY-MM-DD format
+ * @returns {number} whole days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
+  return diffDays;
+}
