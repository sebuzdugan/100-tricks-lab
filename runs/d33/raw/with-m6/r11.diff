+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }>, lines: Array }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate invoice is issued or partially paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Calculate balance due
+  const balance = balanceDue(invoice);
+
+  // Validate payment doesn't exceed balance due
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new invoice with payment recorded
+  const payments = invoice.payments ? [...invoice.payments] : [];
+  payments.push({ amount, date });
+
+  const totalInvoice = invoiceTotals(invoice).total;
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+
+  const newStatus = totalPaid >= totalInvoice ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }>, lines: Array }} invoice
+ * @returns {number} amount still owed in cents
+ */
+export function balanceDue(invoice) {
+  const totalInvoice = invoiceTotals(invoice).total;
+  const totalPaid = invoice.payments ? invoice.payments.reduce((sum, p) => sum + p.amount, 0) : 0;
+  return Math.max(0, totalInvoice - totalPaid);
+}
