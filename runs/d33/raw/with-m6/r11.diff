+
+test('recordPayment with multiple payments accumulates correctly', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const p1 = 5000;
+  const r1 = recordPayment(invoice, { amount: p1, date: '2026-10-08' });
+  assert.equal(r1.ok, true);
+
+  const p2 = 4000;
+  const r2 = recordPayment(r1.value, { amount: p2, date: '2026-10-09' });
