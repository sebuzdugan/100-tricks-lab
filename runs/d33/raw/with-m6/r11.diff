+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, invoiceTotals, issueInvoice } from '../src/invoices.js';
+
+// Helper to create an issued invoice
+function createTestInvoice() {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }], // 2 × 8500 = 17000 cents before VAT
+  });
+  assert.equal(draftResult.ok, true);
+  const issuedResult = issueInvoice(draftResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  return issuedResult.value;
+}
+
+test('balanceDue returns full total for issued invoice with no payments', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  assert.equal(balanceDue(invoice), totals.total);
+});
+
+test('recordPayment records a payment on issued invoice', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  const payment = Math.floor(totals.total / 2);
+
+  const r = recordPayment(invoice, { amount: payment, date: '2026-10-08' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, payment);
+  assert.equal(r.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment sets status to partially_paid when payment is partial', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  const payment = Math.floor(totals.total / 2);
+
+  const r = recordPayment(invoice, { amount: payment, date: '2026-10-08' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when payment equals total', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment can add payment to partially_paid invoice', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  const payment1 = Math.floor(totals.total / 3);
+
+  const r1 = recordPayment(invoice, { amount: payment1, date: '2026-10-08' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.status, 'partially_paid');
+
+  const payment2 = totals.total - payment1;
+  const r2 = recordPayment(r1.value, { amount: payment2, date: '2026-10-09' });
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.payments.length, 2);
+  assert.equal(r2.value.status, 'paid');
+});
+
+test('balanceDue decreases after payment', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  const payment = Math.floor(totals.total / 2);
+
+  const r = recordPayment(invoice, { amount: payment, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+
+  const remaining = balanceDue(r.value);
+  assert.equal(remaining, totals.total - payment);
+});
+
+test('balanceDue returns zero after full payment', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const r = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+
+  assert.equal(balanceDue(r.value), 0);
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const invoice = createTestInvoice();
+
+  const r = recordPayment(invoice, { amount: 1234.56, date: '2026-10-08' });
+
+  assert.equal(r.ok, false);
