+/**
+ * Calculate due date based on payment terms.
+ * @param {string} issueDate - YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    // Get the last day of the month of issueDate
+    const [year, month] = issueDate.split('-');
+    const nextMonth = parseInt(month) + 1;
+    const yearForNextMonth = nextMonth === 13 ? parseInt(year) + 1 : year;
+    const monthForNextMonth = nextMonth === 13 ? '01' : String(nextMonth).padStart(2, '0');
+    const firstOfNextMonth = `${yearForNextMonth}-${monthForNextMonth}-01`;
+    // Last day of current month is one day before first of next month
+    return addDays(firstOfNextMonth, -1);
+  }
+}
+
+/**
+ * Validate payment terms.
+ * @param {any} terms
+ * @returns {boolean}
+ */
+function isValidTerms(terms) {
+  return terms === 'NET14' || terms === 'NET30' || terms === 'EOM';
+}
