 /**
- * Calculate subtotal, discount, VAT, and total for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, vat: number, total: number }} amounts in cents
+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} amounts in cents
  */
 export function invoiceTotals(invoice) {
   const subtotal = roundCents(invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
   const discount = roundCents(invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0));
   const vat = roundCents(invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0));
-  const total = Math.max(0, roundCents(subtotal - discount + vat));
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, roundCents(subtotal - discount + vat - voucher));
   return {
     subtotal,
     discount,
     vat,
+    voucher,
     total,
   };
 }
@@ -294,3 +296,31 @@ export function issueInvoice(invoice, existingNumbers) {
     status: 'issued',
   });
 }
+
+/**
+ * Apply a voucher to an invoice.
+ * @param {{ status: string, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Validate invoice is draft
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check if voucher already exists
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
