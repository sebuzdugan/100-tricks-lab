+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+// Helper to create and issue an invoice for a specific customer
+function createAndIssueInvoice(customerId, issueDate, sku = 'DES-HOUR', qty = 1) {
+  const draftResult = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku, qty }],
+  });
+  assert.equal(draftResult.ok, true);
+  const issuedResult = issueInvoice(draftResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  return issuedResult.value;
+}
+
+test('statement returns empty list for customer with no invoices', () => {
+  const r = statement('C-002', [], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-002');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = statement('C-999', [], '2026-10-07');
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement normalizes customer ID', () => {
+  const invoices = [createAndIssueInvoice('C-001', '2026-10-07')];
+
+  const r = statement('c-001', invoices, '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+});
+
+test('statement includes issued invoices', () => {
+  const invoices = [createAndIssueInvoice('C-001', '2026-10-07')];
+
+  const r = statement('C-001', invoices, '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, invoices[0].number);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07', 'DES-HOUR', 5);
+  const paymentResult = recordPayment(invoice, { amount: 10000, date: '2026-10-08' });
+  assert.equal(paymentResult.ok, true);
+
+  const r = statement('C-001', [paymentResult.value], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].due > 0, true);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(draft.ok, true);
+
+  const r = statement('C-001', [draft.value], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07', 'DES-HOUR', 1);
+  const totals = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(paymentResult.ok, true);
+
+  const r = statement('C-001', [paymentResult.value], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes invoices issued after asOf date', () => {
+  const invoices = [
+    createAndIssueInvoice('C-001', '2026-10-07'),
+    createAndIssueInvoice('C-001', '2026-10-15'),
+  ];
+
+  const r = statement('C-001', invoices, '2026-10-10');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement includes invoices issued on asOf date', () => {
+  const invoices = [createAndIssueInvoice('C-001', '2026-10-07')];
+
+  const r = statement('C-001', invoices, '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoices = [
+    createAndIssueInvoice('C-001', '2026-10-15'),
+    createAndIssueInvoice('C-001', '2026-10-07'),
+    createAndIssueInvoice('C-001', '2026-10-10'),
+  ];
+
+  const r = statement('C-001', invoices, '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-10');
+  assert.equal(r.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement includes correct invoice fields', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const r = statement('C-001', [invoice], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  const statInvoice = r.value.invoices[0];
+  assert.equal(typeof statInvoice.number, 'string');
+  assert.equal(statInvoice.issueDate, '2026-10-07');
+  assert.equal(typeof statInvoice.dueDate, 'string');
+  assert.equal(typeof statInvoice.total, 'number');
+  assert.equal(typeof statInvoice.due, 'number');
+});
+
+test('statement calculates due from balanceDue', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07', 'DES-HOUR', 2);
+
+  const r = statement('C-001', [invoice], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].total, invoiceTotals(invoice).total);
+  assert.equal(r.value.invoices[0].due, balanceDue(invoice));
+});
+
+test('statement with partial payment shows reduced due', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07', 'DES-HOUR', 2);
+  const payment = recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+
+  const r = statement('C-001', [payment.value], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  const statInvoice = r.value.invoices[0];
+  assert.equal(statInvoice.total, invoiceTotals(payment.value).total);
+  assert.equal(statInvoice.due, balanceDue(payment.value));
+  assert.equal(statInvoice.due, statInvoice.total - 5000);
+});
+
+test('statement totalDue is sum of all due amounts', () => {
+  const invoices = [
+    createAndIssueInvoice('C-001', '2026-10-07', 'DES-HOUR', 1),
+    createAndIssueInvoice('C-001', '2026-10-10', 'DES-HOUR', 2),
+  ];
+
+  const r = statement('C-001', invoices, '2026-10-10');
+
+  assert.equal(r.ok, true);
+  const expectedTotal = r.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(r.value.totalDue, expectedTotal);
+});
+
+test('statement filters by customer in mixed invoice list', () => {
+  const invoices = [
+    createAndIssueInvoice('C-001', '2026-10-07'),
+    createAndIssueInvoice('C-002', '2026-10-07'),
+    createAndIssueInvoice('C-001', '2026-10-10'),
+  ];
+
+  const r = statement('C-001', invoices, '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-10');
+});
+
+test('statement handles invoices with discounts and VAT', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+  assert.equal(draft.ok, true);
+  const invoice = issueInvoice(draft.value, []);
+  assert.equal(invoice.ok, true);
+
+  const r = statement('C-001', [invoice.value], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].total, invoiceTotals(invoice.value).total);
+  assert.equal(r.value.invoices[0].due, balanceDue(invoice.value));
+});
+
+test('statement handles year boundary dates', () => {
+  const invoices = [
+    createAndIssueInvoice('C-001', '2025-12-31'),
+    createAndIssueInvoice('C-001', '2026-01-01'),
+  ];
+
+  const r = statement('C-001', invoices, '2026-01-01');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].issueDate, '2025-12-31');
+  assert.equal(r.value.invoices[1].issueDate, '2026-01-01');
+});
+
+test('statement with multiple invoices and payments', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-07', 'DES-HOUR', 1);
+  const payment1 = recordPayment(invoice1, { amount: 5000, date: '2026-10-08' });
+  assert.equal(payment1.ok, true);
+
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-10', 'DES-HOUR', 2);
+
+  const r = statement('C-001', [payment1.value, invoice2], '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.totalDue, balanceDue(payment1.value) + balanceDue(invoice2));
+});
+
+test('statement with empty asOf date comparison', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const r = statement('C-001', [invoice], '2026-10-06');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
