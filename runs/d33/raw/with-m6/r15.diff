+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Extract year from a YYYY-MM-DD date string.
+ * @param {string} date
+ * @returns {number}
+ */
+function getYear(date) {
+  return parseInt(date.split('-')[0]);
+}
+
+/**
+ * Generate the next credit note number for a given year.
+ * @param {Array<string>} existingNumbers - all invoice and credit note numbers
+ * @param {string} date - YYYY-MM-DD format date for the credit note
+ * @returns {string} credit note number in format CN-YYYY-NNNN
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = getYear(date);
+  const creditNoteNumbers = existingNumbers.filter((num) => num.startsWith('CN-'));
+  const numbersThisYear = creditNoteNumbers.filter((num) => {
+    const numYear = parseInt(num.split('-')[1]);
+    return numYear === year;
+  });
+
+  let maxCounter = 0;
+  for (const num of numbersThisYear) {
+    const counter = parseInt(num.split('-')[2]);
+    if (counter > maxCounter) {
+      maxCounter = counter;
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `CN-${year}-${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNoteData
+ * @param {Array<string>} existingNumbers - existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice is not draft
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate amount doesn't exceed invoice total
+  const invoiceTotal = invoiceTotals(invoice).total;
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
