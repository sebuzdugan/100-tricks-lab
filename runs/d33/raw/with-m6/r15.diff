+++ b/test/credits.test.js
@@ -0,0 +1,236 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue an invoice
+function createAndIssueInvoice(customerId, issueDate, sku = 'DES-HOUR', qty = 1) {
+  const draftResult = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku, qty }],
+  });
+  assert.equal(draftResult.ok, true);
+  const issuedResult = issueInvoice(draftResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  return issuedResult.value;
+}
+
+test('nextCreditNoteNumber generates first credit note for a year', () => {
+  const number = nextCreditNoteNumber([], '2026-10-07');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber increments counter within a year', () => {
+  const numbers = ['CN-2026-0001', 'CN-2026-0002'];
+  const number = nextCreditNoteNumber(numbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0003');
+});
+
+test('nextCreditNoteNumber restarts counter for new year', () => {
+  const numbers = ['CN-2026-0005', 'CN-2027-0001'];
+  const number = nextCreditNoteNumber(numbers, '2027-12-31');
+  assert.equal(number, 'CN-2027-0002');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001'];
+  const number = nextCreditNoteNumber(numbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0002');
+});
+
+test('nextCreditNoteNumber ignores credit notes from other years', () => {
+  const numbers = ['CN-2025-9999', 'CN-2026-0001', 'CN-2027-0001'];
+  const number = nextCreditNoteNumber(numbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0002');
+});
+
+test('nextCreditNoteNumber pads counter with zeros', () => {
+  const numbers = Array.from({ length: 15 }, (_, i) => `CN-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextCreditNoteNumber(numbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0016');
+});
+
+test('nextCreditNoteNumber handles unordered numbers', () => {
+  const numbers = ['CN-2026-0005', 'CN-2026-0001', 'CN-2026-0003', 'CN-2026-0004'];
+  const number = nextCreditNoteNumber(numbers, '2026-10-07');
+  assert.equal(number, 'CN-2026-0006');
+});
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, invoice.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Refund');
+  assert.equal(r.value.date, '2026-10-08');
+});
+
+test('createCreditNote works with partially_paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07', 'DES-HOUR', 2);
+  const payment = recordPayment(invoice, { amount: 10000, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+
+  const r = createCreditNote(payment.value, { amount: 5000, reason: 'Partial refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, 5000);
+});
+
+test('createCreditNote works with paid invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07', 'DES-HOUR', 1);
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+
+  const r = createCreditNote(payment.value, { amount: 5000, reason: 'Full refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, 5000);
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(draft.ok, true);
+
+  const r = createCreditNote(draft.value, { amount: 5000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const r = createCreditNote(invoice, { amount: 5000.50, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const r = createCreditNote(invoice, { amount: 0, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const r = createCreditNote(invoice, { amount: -1000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects invalid date format', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '10/08/2026' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'DATE_INVALID');
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07', 'DES-HOUR', 1);
+  const totals = invoiceTotals(invoice);
+  const excessAmount = totals.total + 1;
+
+  const r = createCreditNote(invoice, { amount: excessAmount, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote allows credit for full invoice amount', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const totals = invoiceTotals(invoice);
+
+  const r = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2026-10-08' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, totals.total);
+});
+
+test('createCreditNote uses correct number with existing invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const existingNumbers = [invoice.number, 'CN-2026-0001'];
+
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2026-10-08' }, existingNumbers);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote with invoice from different year', () => {
+  const invoice = createAndIssueInvoice('C-001', '2025-12-15');
+
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2026-01-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote preserves all invoice data', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  assert.equal(draft.ok, true);
+  const invoice = issueInvoice(draft.value, ['INV-2026-0001']);
+  assert.equal(invoice.ok, true);
+
+  const r = createCreditNote(invoice.value, { amount: 10000, reason: 'Discount refund', date: '2026-10-10' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-002');
+  assert.equal(r.value.invoiceNumber, invoice.value.number);
+});
+
+test('createCreditNote with multiple invoices and credit notes', () => {
+  const inv1 = createAndIssueInvoice('C-001', '2026-01-01');
+  const inv2 = createAndIssueInvoice('C-001', '2026-02-01');
+
+  const existingNumbers = [inv1.number, inv2.number, 'CN-2026-0001', 'CN-2026-0002'];
+
+  const r = createCreditNote(inv2, { amount: 5000, reason: 'Refund', date: '2026-02-10' }, existingNumbers);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0003');
+  assert.equal(r.value.invoiceNumber, inv2.number);
+});
+
+test('createCreditNote with detailed reason text', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const reason = 'Customer requested refund due to damaged goods';
+
+  const r = createCreditNote(invoice, { amount: 5000, reason, date: '2026-10-08' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.reason, reason);
+});
+
+test('createCreditNote returns correct date in response', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-07');
+  const creditDate = '2026-10-15';
+
+  const r = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: creditDate }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.date, creditDate);
+});
