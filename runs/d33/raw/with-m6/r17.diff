+/**
+ * Generate a VAT summary for invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} one entry per VAT rate, sorted by rate descending (high to low)
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVAT(line);
+
+        if (!vatMap[rate]) {
+          vatMap[rate] = { rate, base: 0, vat: 0 };
+        }
+        vatMap[rate].base += base;
+        vatMap[rate].vat += vat;
+      });
+    });
+
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
