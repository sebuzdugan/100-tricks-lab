+
+/**
+ * Calculate late fee for an invoice.
+ * @param {{ dueDate: string, status: string, payments?: Array<{ amount: number, date: string }>, lines: Array }} invoice
+ * @param {string} asOf - YYYY-MM-DD format, cutoff date
+ * @returns {number} late fee in cents (0.04% per day overdue), or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+  const due = balanceDue(invoice);
+  return roundCents(due * 0.0004 * daysOverdue);
+}
