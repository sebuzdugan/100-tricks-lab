+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format amount in cents as euros with 2 decimals.
+ * @param {number} cents
+ * @returns {string} formatted as "1234.50"
+ */
+function formatEuros(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Escape a field for CSV: wrap in quotes if it contains comma/quote/newline, and double internal quotes.
+ * @param {string|number} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  let str = typeof field === 'string' ? field : String(field);
+
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    str = str.replace(/"/g, '""');
+    return '"' + str + '"';
+  }
+
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ number?: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array<{ amount: number, date: string }>, voucher?: { code: string, amount: number } }>} invoices
+ * @returns {string} CSV with header and one line per invoice, ending with \n
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  invoices.forEach((invoice) => {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      escapeCsvField(invoice.number || ''),
+      escapeCsvField(customerName),
+      escapeCsvField(invoice.issueDate),
+      escapeCsvField(invoice.dueDate),
+      escapeCsvField(invoice.status),
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    lines.push(fields.join(','));
+  });
+
+  return lines.join('\n') + '\n';
+}
