+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+// Helper to create and issue an invoice for a specific customer
+function createAndIssueInvoice(customerId, issueDate, sku = 'DES-HOUR', qty = 1, terms = 'NET30') {
+  const draftResult = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku, qty }],
+    terms,
+  });
+  assert.equal(draftResult.ok, true);
+  const issuedResult = issueInvoice(draftResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  return issuedResult.value;
+}
+
+test('exportCsv with empty invoices list', () => {
+  const result = exportCsv([]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv with single invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[2], '');
+});
+
+test('exportCsv header is correct', () => {
+  const result = exportCsv([]);
+
+  const firstLine = result.split('\n')[0];
+  assert.equal(firstLine, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv ends with newline', () => {
+  const result = exportCsv([]);
+
+  assert.equal(result[result.length - 1], '\n');
+});
+
+test('exportCsv includes invoice number', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  assert.equal(result.includes(invoice.number), true);
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  assert.equal(result.includes('Northwind'), true);
+});
+
+test('exportCsv includes issue date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  assert.equal(result.includes('2026-10-01'), true);
+});
+
+test('exportCsv includes due date', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  assert.equal(result.includes(invoice.dueDate), true);
+});
+
+test('exportCsv includes status', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  assert.equal(result.includes('issued'), true);
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+
+  assert.equal(fields.length, 10);
+  assert.equal(fields[5].includes('.'), true);
+});
+
+test('exportCsv amounts use dot separator', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  assert.equal(dataLine.includes('.'), true);
+  assert.equal(dataLine.includes(','), true);
+});
+
+test('exportCsv no currency symbol', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  assert.equal(result.includes('€'), false);
+});
+
+test('exportCsv no thousands separator', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'BRAND-BOOK', 1);
+
+  const result = exportCsv([invoice]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  assert.equal(dataLine.includes(','), true);
+});
+
+test('exportCsv with multiple invoices', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+  const invoice2 = createAndIssueInvoice('C-002', '2026-10-02', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice1, invoice2]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4);
+});
+
+test('exportCsv maintains invoice order', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-02', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice1, invoice2]);
+
+  const lines = result.split('\n');
+  assert.equal(lines[1].includes(invoice1.number), true);
+  assert.equal(lines[2].includes(invoice2.number), true);
+});
+
+test('exportCsv with paid invoice shows due of 0', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+
+  const result = exportCsv([payment.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  assert.equal(dataLine.endsWith('0.00'), true);
+});
+
+test('exportCsv with partially paid invoice shows remaining due', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 5);
+  const payment = recordPayment(invoice, { amount: 10000, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+
+  const result = exportCsv([payment.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  const due = balanceDue(payment.value);
+  const expectedDueStr = (due / 100).toFixed(2);
+  assert.equal(fields[9], expectedDueStr);
+});
+
+test('exportCsv escapes commas in customer name', () => {
+  const invoice = createAndIssueInvoice('C-004', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  assert.equal(result.includes('"'), true);
+});
+
+test('exportCsv escapes double quotes in customer name', () => {
+  const invoice = createAndIssueInvoice('C-006', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  assert.equal(result.includes('""'), true);
+});
+
+test('exportCsv with discounted invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+  assert.equal(draftResult.ok, true);
+  const invoice = issueInvoice(draftResult.value, []);
+  assert.equal(invoice.ok, true);
+
+  const result = exportCsv([invoice.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  const totals = invoiceTotals(invoice.value);
+
+  assert.equal(fields[6], (totals.discount / 100).toFixed(2));
+});
+
+test('exportCsv with VAT invoice', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(fields[7], (totals.vat / 100).toFixed(2));
+});
+
+test('exportCsv with draft invoice shows draft status', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(draftResult.ok, true);
+
+  const result = exportCsv([draftResult.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  assert.equal(dataLine.includes('draft'), true);
+});
+
+test('exportCsv CSV parsing roundtrip', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  const lines = result.split('\n');
+  assert.equal(lines[1].split(',').length, 10);
+});
+
+test('exportCsv with zero amount invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  assert.equal(draftResult.ok, true);
+  const invoice = issueInvoice(draftResult.value, []);
+  assert.equal(invoice.ok, true);
+
+  const result = exportCsv([invoice.value]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  assert.equal(dataLine.includes('.'), true);
+});
+
+test('exportCsv does not mutate invoices', () => {
+  const invoice = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+
+  exportCsv([invoice]);
+
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('exportCsv with many invoices', () => {
+  const invoices = [];
+  for (let i = 0; i < 100; i++) {
+    invoices.push(createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1));
+  }
+
+  const result = exportCsv(invoices);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 102);
+});
+
+test('exportCsv special characters in customer name', () => {
+  const invoice = createAndIssueInvoice('C-006', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice]);
+
+  assert.equal(result.includes('Marlow'), true);
+  assert.equal(result.includes('""'), true);
+});
+
+test('exportCsv with different statuses', () => {
+  const issued = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+  const payment = recordPayment(issued, { amount: 5000, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+
+  const result = exportCsv([issued, payment.value]);
+
+  assert.equal(result.includes('issued'), true);
+  assert.equal(result.includes('partially_paid'), true);
+});
+
+test('exportCsv amounts are formatted consistently', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-01', 'STICKER', 1);
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice1, invoice2]);
+
+  const lines = result.split('\n');
+  const line1 = lines[1];
+  const line2 = lines[2];
+
+  const fields1 = line1.split(',');
+  const fields2 = line2.split(',');
+
+  assert.equal(fields1[5].split('.').length, 2);
+  assert.equal(fields2[5].split('.').length, 2);
+});
+
+test('exportCsv lines separated by newline', () => {
+  const invoice1 = createAndIssueInvoice('C-001', '2026-10-01', 'DES-HOUR', 1);
+  const invoice2 = createAndIssueInvoice('C-001', '2026-10-02', 'DES-HOUR', 1);
+
+  const result = exportCsv([invoice1, invoice2]);
+
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1].length > 0, true);
+  assert.equal(lines[2].length > 0, true);
+  assert.equal(lines[3], '');
+});
