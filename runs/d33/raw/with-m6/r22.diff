+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 5, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 42500);
+});
+
+test('lineDiscount calculates discount from discountPercent', () => {
+  const line = { qty: 4, unitPrice: 2500, discountPercent: 10 };
+  const total = lineTotal(line);
+  assert.equal(total, 10000);
+  const discount = lineDiscount(line);
+  assert.equal(discount, 1000);
+});
+
+test('lineDiscount defaults discountPercent to 0 if not provided', () => {
+  const line = { qty: 10, unitPrice: 1000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount clamps discount to 0 minimum', () => {
+  const line = { qty: 1, unitPrice: 100, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVAT calculates VAT on line after discount', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 };
+  const total = lineTotal(line);
+  assert.equal(total, 100000);
+  const vat = lineVAT(line);
+  assert.equal(vat, 21000);
+});
+
+test('lineVAT calculates VAT after applying discount', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 };
+  const total = lineTotal(line);
+  assert.equal(total, 100000);
+  const discount = lineDiscount(line);
+  assert.equal(discount, 10000);
+  const vat = lineVAT(line);
+  assert.equal(vat, 18900);
+});
+
+test('lineVAT with different VAT rates', () => {
+  const line9 = { qty: 100, unitPrice: 1000, vatRate: 9 };
+  const line21 = { qty: 100, unitPrice: 1000, vatRate: 21 };
+  const line0 = { qty: 100, unitPrice: 1000, vatRate: 0 };
+  assert.equal(lineVAT(line9), 9000);
+  assert.equal(lineVAT(line21), 21000);
+  assert.equal(lineVAT(line0), 0);
+});
+
+test('lineVAT clamps VAT to 0 minimum', () => {
+  const line = { qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('invoiceTotals returns discount and vat fields', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.discount > 0);
+  assert(totals.vat > 0);
+  assert(totals.subtotal > 0);
+  assert(totals.total > 0);
+});
+
+test('invoiceTotals sums discounts across multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 },
+      { qty: 100, unitPrice: 1000, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 30000);
+  assert.equal(totals.subtotal, 200000);
+  assert.equal(totals.total, 170000);
+});
+
+test('invoiceTotals handles mixed discount and no-discount lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+      { qty: 100, unitPrice: 1000, discountPercent: 50, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 200000);
+  assert.equal(totals.discount, 50000);
+  assert.equal(totals.total, 150000);
+});
+
+test('invoiceTotals clamps total to 0 minimum', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'TEST', amount: 200000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals clamps total when discount equals subtotal', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 100, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 100000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes voucher field', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with discount and voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+    voucher: { code: 'SUMMER20', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 18900);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 103900);
+});
+
+test('invoiceTotals with multiple lines and voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 50, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+      { qty: 50, unitPrice: 2000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'BULK', amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 150000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 31500);
+  assert.equal(totals.voucher, 10000);
+  assert.equal(totals.total, 171500);
+});
+
+test('invoiceTotals with VAT 21%', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.total, 121000);
+});
+
+test('invoiceTotals with VAT 9%', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 9 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.vat, 9000);
+  assert.equal(totals.total, 109000);
+});
+
+test('invoiceTotals with VAT 0%', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 100000);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, vatRate: 21 },
+      { qty: 100, unitPrice: 1000, vatRate: 9 },
+      { qty: 100, unitPrice: 1000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 300000);
+  assert.equal(totals.vat, 30000);
+  assert.equal(totals.total, 330000);
+});
+
+test('invoiceTotals VAT calculated after discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 50, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 50000);
+  assert.equal(totals.vat, 10500);
+  assert.equal(totals.total, 60500);
+});
+
+test('invoiceTotals with tier discount and VAT', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 5000);
+  assert.equal(totals.vat, 19950);
+  assert.equal(totals.total, 114950);
+});
+
+test('invoiceTotals with explicit discount and VAT', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.total, 121000);
+});
