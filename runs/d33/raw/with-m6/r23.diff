diff --git a/src/totals.js b/src/totals.js
index 15be3ad..7e4036e 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -11,14 +11,25 @@ export function lineTotal(line) {
 
 /**
  * Calculate the discount amount for a single line item.
+ * Includes both regular discount and bulk discount (2.5% extra for qty >= 10).
+ * Bulk discount is applied after regular discount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
- * @returns {number} discount in cents, clamped at 0
+ * @returns {number} total discount in cents, clamped at 0
  */
 export function lineDiscount(line) {
   const discountPercent = line.discountPercent ?? 0;
   const total = lineTotal(line);
-  const discount = roundCents((total * discountPercent) / 100);
-  return Math.max(0, discount);
+  const regularDiscount = roundCents((total * discountPercent) / 100);
+
+  // Bulk discount: extra 2.5% off on qty >= 10, applied after regular discount
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const afterRegularDiscount = Math.max(0, total - regularDiscount);
+    bulkDiscount = roundCents((afterRegularDiscount * 2.5) / 100);
+  }
+
+  const totalDiscount = Math.max(0, regularDiscount + bulkDiscount);
+  return totalDiscount;
 }
 
