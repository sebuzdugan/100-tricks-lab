+/**
+ * Generate a dashboard summary of invoice metrics.
+ * @param {Array<{ status: string, customerId: string, dueDate: string, lines: Array, payments?: Array }>} invoices
+ * @param {string} asOf - YYYY-MM-DD format, cutoff date
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+  invoices.forEach((inv) => {
+    if (inv.status in counts) {
+      counts[inv.status]++;
+    }
+  });
+
+  // Calculate outstanding amount (issued or partially_paid)
+  const outstanding = invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  // Calculate overdue invoices
+  const overdue_list = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_list.length,
+    amount: overdue_list.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Get top 3 customers by total due
+  const customerDue = {};
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .forEach((inv) => {
+      const due = balanceDue(inv);
+      if (!customerDue[inv.customerId]) {
+        customerDue[inv.customerId] = 0;
+      }
+      customerDue[inv.customerId] += due;
+    });
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
