@@ -21,21 +22,42 @@ export function renderInvoiceText(invoice) {
   // Customer name
   lines.push(customerName);
 
-  // Line items
+  // Line items with optional discount
   for (const line of invoice.lines) {
     const total = lineTotal(line);
-    const lineText = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
+    let lineText = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      lineText += ` -${formatEuros(discount)}`;
+    }
     lines.push(lineText);
   }
 
-  // Subtotal, discount, VAT, and total
+  // Subtotal, discount, VAT, voucher, and total
   const totals = invoiceTotals(invoice);
   lines.push(`Subtotal: ${formatEuros(totals.subtotal)}`);
   if (totals.discount > 0) {
     lines.push(`Discount: ${formatEuros(totals.discount)}`);
   }
   lines.push(`VAT: ${formatEuros(totals.vat)}`);
+
+  // Show voucher if present
+  if (invoice.voucher) {
+    lines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Show due date if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Show amount paid if payments exist
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
