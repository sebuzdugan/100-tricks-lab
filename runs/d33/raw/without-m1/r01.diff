+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice succeeds with valid input', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2025-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(r.value.lines[0].name, 'Development (hour)');
+  assert.equal(r.value.lines[0].qty, 10);
+  assert.equal(r.value.lines[0].unitPrice, 9500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+  assert.equal(r.value.lines[1].sku, 'LOGO-PACK');
+  assert.equal(r.value.lines[1].name, 'Logo package');
+  assert.equal(r.value.lines[1].qty, 1);
+  assert.equal(r.value.lines[1].unitPrice, 120000);
+  assert.equal(r.value.lines[1].vatRate, 21);
+});
+
+test('createInvoice reports unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '07-10-2025',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects invalid date like 2025-02-30', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects undefined lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: undefined,
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects qty that is not an integer', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1.5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects qty of 0', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects negative qty', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 10 }];
+  const originalLines = JSON.stringify(lines);
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines,
+  });
+  assert.equal(JSON.stringify(lines), originalLines);
+});
+
+test('createInvoice with varying VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].vatRate, 9);
+  assert.equal(r.value.lines[1].vatRate, 0);
+});
