new file mode 100644
index 0000000..6e96c0c
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,20 @@
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const yearPattern = `INV-${year}-`;
+
+  const thisYearNumbers = existingNumbers.filter((n) => n.startsWith(yearPattern));
+
+  if (thisYearNumbers.length === 0) {
+    return `INV-${year}-0001`;
+  }
+
+  const counters = thisYearNumbers.map((n) => {
+    const counterStr = n.substring(yearPattern.length);
+    return parseInt(counterStr, 10);
+  });
+
+  const maxCounter = Math.max(...counters);
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
