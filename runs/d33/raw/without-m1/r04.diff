diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..9abfe1e
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,60 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number for empty list', () => {
+  const num = nextInvoiceNumber([], '2025-10-07');
+  assert.equal(num, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber returns first number for a year with no existing numbers', () => {
+  const num = nextInvoiceNumber(['INV-2024-0001', 'INV-2024-0002'], '2025-10-07');
+  assert.equal(num, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const num = nextInvoiceNumber(['INV-2025-0001'], '2025-10-07');
+  assert.equal(num, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber handles multiple existing numbers', () => {
+  const num = nextInvoiceNumber(['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'], '2025-10-07');
+  assert.equal(num, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const num = nextInvoiceNumber(
+    ['INV-2024-0001', 'INV-2024-0099', 'INV-2025-0001', 'INV-2026-0001'],
+    '2025-10-07'
+  );
+  assert.equal(num, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const num = nextInvoiceNumber(['INV-2025-0003', 'INV-2025-0001', 'INV-2025-0002'], '2025-10-07');
+  assert.equal(num, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber handles gaps in numbering', () => {
+  const num = nextInvoiceNumber(['INV-2025-0001', 'INV-2025-0003', 'INV-2025-0005'], '2025-10-07');
+  assert.equal(num, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const num = nextInvoiceNumber(['INV-2025-9998', 'INV-2025-9999'], '2025-10-07');
+  assert.equal(num, 'INV-2025-10000');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const num = nextInvoiceNumber([], '2025-10-07');
+  assert.equal(num, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber uses year from issueDate', () => {
+  const num2024 = nextInvoiceNumber([], '2024-12-25');
+  const num2025 = nextInvoiceNumber([], '2025-01-01');
+  const num2026 = nextInvoiceNumber([], '2026-06-15');
+  assert.equal(num2024, 'INV-2024-0001');
+  assert.equal(num2025, 'INV-2025-0001');
+  assert.equal(num2026, 'INV-2026-0001');
+});
