+++ b/src/render.js
@@ -0,0 +1,21 @@
+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown';
+
+  const number = invoice.number || 'DRAFT';
+
+  const lineStrings = invoice.lines.map((line) => {
+    const total = lineTotal(line);
+    return `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+  });
+
+  const { total } = invoiceTotals(invoice);
+
+  const parts = [number, customerName, ...lineStrings, `Total: ${formatEuros(total)}`];
+
+  return parts.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..2ce05a8
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,146 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const text = renderInvoiceText(r2.value);
+  assert.ok(text.startsWith('INV-2025-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText formats single line correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // Line format: qty x name @ unitPrice = lineTotal
+  // 10 x Development (hour) @ €95.00 = €950.00
+  assert.equal(lines[2], '10 x Development (hour) @ €95.00 = €950.00');
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // DRAFT, customer, 2 product lines, total
+  assert.equal(lines[2], '10 x Development (hour) @ €95.00 = €950.00');
+  assert.equal(lines[3], '1 x Logo package @ €1,200.00 = €1,200.00');
+});
+
+test('renderInvoiceText calculates and shows correct total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // 10 * 9500 + 1 * 120000 = 95000 + 120000 = 215000 cents = €2,150.00
+  assert.equal(lines[4], 'Total: €2,150.00');
+});
+
+test('renderInvoiceText formats prices with formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  // STICKER: unitPrice = 50 cents = €0.50
+  // 100 * 50 = 5000 cents = €50.00
+  assert.ok(text.includes('€0.50'));
+  assert.ok(text.includes('€50.00'));
+});
+
+test('renderInvoiceText includes all product details', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 5 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // Customer name should be Kite & Co
+  assert.equal(lines[1], 'Kite & Co');
+  // Line should show: 5 x Icon set (24 icons) @ €9.80 = €49.00
+  assert.equal(lines[2], '5 x Icon set (24 icons) @ €9.80 = €49.00');
+});
+
+test('renderInvoiceText output is multiline text', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(typeof text === 'string');
+  assert.ok(text.includes('\n'));
+  const lines = text.split('\n');
+  assert.ok(lines.length >= 4); // at least: number, customer, line, total
+});
+
+test('renderInvoiceText with issued invoice and multiple lines', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'PRINT-A3', qty: 50 },
+    ],
+  });
+  const r2 = issueInvoice(r1.value, ['INV-2025-0001']);
+  const text = renderInvoiceText(r2.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2025-0002');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  // 100 * 37 = 3700 cents = €37.00
+  assert.equal(lines[2], '100 x Printed flyer A4 (each) @ €0.37 = €37.00');
+  // 50 * 249 = 12450 cents = €124.50
+  assert.equal(lines[3], '50 x Printed poster A3 (each) @ €2.49 = €124.50');
+  // Total: 3700 + 12450 = 16150 cents = €161.50
+  assert.equal(lines[4], 'Total: €161.50');
+});
