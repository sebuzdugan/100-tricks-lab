+function validateDiscount(discountPercent) {
+  if (discountPercent === undefined) return ok(0);
+  if (typeof discountPercent !== 'number' || discountPercent < 0 || discountPercent > 100) {
+    return fail('DISCOUNT_INVALID');
+  }
+  return ok(discountPercent);
+}
+
 export function lineTotal(line) {
   return line.qty * line.unitPrice;
 }
 
+export function discountAmount(line) {
+  const discount = line.discountPercent ?? 0;
+  return Math.round(lineTotal(line) * discount / 100);
+}
