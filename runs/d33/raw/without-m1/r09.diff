+test('normalizeId converts lowercase to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-003'), 'C-003');
+  assert.equal(normalizeId('c-007'), 'C-007');
+});
+
+test('normalizeId trims leading and trailing whitespace', () => {
+  assert.equal(normalizeId('c-001 '), 'C-001');
+  assert.equal(normalizeId(' c-001'), 'C-001');
