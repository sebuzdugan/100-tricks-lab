diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..c9dd171
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,138 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid YYYY-MM-DD format', () => {
+  assert.equal(isValidDate('2025-10-07'), true);
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('07-10-2025'), false);
+  assert.equal(isValidDate('2025/10/07'), false);
+  assert.equal(isValidDate('10-07-2025'), false);
+  assert.equal(isValidDate('2025-10-7'), false);
+  assert.equal(isValidDate('2025-1-07'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+  assert.equal(isValidDate('2025-10-32'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(123), false);
+  assert.equal(isValidDate({ year: 2025 }), false);
+});
+
+test('isValidDate rejects leap year invalid dates', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects leading/trailing spaces', () => {
+  assert.equal(isValidDate(' 2025-10-07'), false);
+  assert.equal(isValidDate('2025-10-07 '), false);
+  assert.equal(isValidDate(' 2025-10-07 '), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-10-07', 1), '2025-10-08');
+  assert.equal(addDays('2025-10-07', 10), '2025-10-17');
+  assert.equal(addDays('2025-10-07', 100), '2026-01-15');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2025-10-07', -1), '2025-10-06');
+  assert.equal(addDays('2025-10-07', -10), '2025-09-27');
+  assert.equal(addDays('2025-10-07', -100), '2025-06-29');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-10-31', 1), '2025-11-01');
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+  assert.equal(addDays('2025-02-01', -1), '2025-01-31');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays handles zero', () => {
+  assert.equal(addDays('2025-10-07', 0), '2025-10-07');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+});
+
+test('daysBetween calculates difference in days', () => {
+  assert.equal(daysBetween('2025-10-07', '2025-10-08'), 1);
+  assert.equal(daysBetween('2025-10-07', '2025-10-17'), 10);
+  assert.equal(daysBetween('2025-10-07', '2026-01-15'), 100);
+});
+
+test('daysBetween handles negative differences', () => {
+  assert.equal(daysBetween('2025-10-08', '2025-10-07'), -1);
+  assert.equal(daysBetween('2025-10-17', '2025-10-07'), -10);
+  assert.equal(daysBetween('2026-01-15', '2025-10-07'), -100);
+});
+
+test('daysBetween with same date returns zero', () => {
+  assert.equal(daysBetween('2025-10-07', '2025-10-07'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2025-10-31', '2025-11-01'), 1);
+  assert.equal(daysBetween('2025-01-31', '2025-02-01'), 1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2025-12-25', '2026-01-03'), 9);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const start = '2025-10-07';
+  const days = 42;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+  assert.equal(addDays(end, -days), start);
+});
+
+test('addDays returns correct format', () => {
+  const result = addDays('2025-01-05', 1);
+  assert.equal(/^\d{4}-\d{2}-\d{2}$/.test(result), true);
+});
+
+test('isValidDate rejects empty string', () => {
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate handles year boundaries correctly', () => {
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('0001-01-01'), true);
+  assert.equal(isValidDate('9999-12-31'), true);
+});
+
+test('daysBetween works with far-apart dates', () => {
+  assert.equal(daysBetween('2000-01-01', '2025-10-07'), 9411);
+  assert.equal(daysBetween('2025-10-07', '2000-01-01'), -9411);
+});
