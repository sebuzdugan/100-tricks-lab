+  const issued = issuedResult.value;
+  const totals = invoiceTotals(issued);
+  const third = Math.floor(totals.total / 3);
+
+  const paid1 = recordPayment(issued, { amount: third, date: '2025-10-08' }).value;
+  assert.equal(paid1.payments.length, 1);
+
+  const paid2 = recordPayment(paid1, { amount: third, date: '2025-10-09' }).value;
+  assert.equal(paid2.payments.length, 2);
+  assert.equal(paid2.payments[0].amount, third);
+  assert.equal(paid2.payments[1].amount, third);
