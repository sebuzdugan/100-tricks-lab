+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue returns total when no payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  assert.equal(balanceDue(issued), totals.total);
+});
+
+test('balanceDue returns reduced balance after payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const half = Math.floor(totals.total / 2);
+  const paid = recordPayment(issued, { amount: half, date: '2025-10-08' }).value;
+  assert.equal(balanceDue(paid), totals.total - half);
+});
+
+test('balanceDue returns 0 when fully paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2025-10-08' }).value;
+  assert.equal(balanceDue(paid), 0);
+});
+
+test('recordPayment rejects draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const result = recordPayment(invoice, { amount: 100, date: '2025-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment rejects non-integer amounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
