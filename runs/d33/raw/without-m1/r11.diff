+
+test('balanceDue sums multiple payments correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  assert.equal(issuedResult.ok, true);
+  const issued = issuedResult.value;
+  const totals = invoiceTotals(issued);
+
+  const paid1 = recordPayment(issued, { amount: 1000, date: '2025-10-08' }).value;
+  const paid2 = recordPayment(paid1, { amount: 1000, date: '2025-10-09' }).value;
+
+  const totalPaid = 2000;
+  const expectedBalance = totals.total - totalPaid;
+  assert.equal(balanceDue(paid2), Math.max(0, expectedBalance));
+});
