+test('recordPayment creates payments array if missing', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    number: 'INV-2025-0001',
+    status: 'issued',
+    lines: [
+      {
+        sku: 'DES-HOUR',
