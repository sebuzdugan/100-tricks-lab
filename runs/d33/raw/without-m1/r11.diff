+
+test('recordPayment rejects overpayment on partially paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  assert.equal(issuedResult.ok, true);
+  const issued = issuedResult.value;
+  const totals = invoiceTotals(issued);
+  const half = Math.floor(totals.total / 2);
+
+  const paid1 = recordPayment(issued, { amount: half, date: '2025-10-08' }).value;
+  const remaining = balanceDue(paid1);
+
+  const result = recordPayment(paid1, { amount: remaining + 1, date: '2025-10-09' });
