 }
+
+export function lastDayOfMonth(date) {
+  const [year, month] = date.split('-');
+  const lastDay = new Date(Date.UTC(year, month, 0)).getUTCDate();
+  return `${year}-${month}-${String(lastDay).padStart(2, '0')}`;
+}
