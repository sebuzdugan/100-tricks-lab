+export function applyVoucher(invoice, { code, amount }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    terms: invoice.terms,
+    dueDate: invoice.dueDate,
+    status: invoice.status,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    voucher: { code, amount },
+  });
 }
 
