+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = statement('C-001', [issued], '2025-10-07');
+  assert.equal(r3.value.invoices.length, 1);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv1 = issueInvoice(r1.value, []);
+  const inv2 = issueInvoice(r2.value, ['INV-2025-0001']);
+  const inv3 = issueInvoice(r3.value, ['INV-2025-0001', 'INV-2025-0002']);
+
+  const r4 = statement('C-001', [inv1.value, inv2.value, inv3.value], '2025-10-31');
+  assert.equal(r4.value.invoices[0].issueDate, '2025-10-07');
+  assert.equal(r4.value.invoices[1].issueDate, '2025-10-10');
+  assert.equal(r4.value.invoices[2].issueDate, '2025-10-15');
+});
+
+test('statement sums totalDue from all invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  const inv1 = issueInvoice(r1.value, []);
+  const inv2 = issueInvoice(r2.value, ['INV-2025-0001']);
+
+  const r3 = statement('C-001', [inv1.value, inv2.value], '2025-10-31');
+  const expectedTotal = r3.value.invoices[0].due + r3.value.invoices[1].due;
+  assert.equal(r3.value.totalDue, expectedTotal);
+});
+
+test('statement excludes other customers invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv1 = issueInvoice(r1.value, []);
+  const inv2 = issueInvoice(r2.value, ['INV-2025-0001']);
+
+  const r3 = statement('C-001', [inv1.value, inv2.value], '2025-10-31');
+  assert.equal(r3.value.invoices.length, 1);
+  assert.equal(r3.value.invoices[0].number, 'INV-2025-0001');
+});
+
+test('statement handles partially_paid status', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+  const totals = invoiceTotals(issued);
+  const half = Math.floor(totals.total / 2);
+  const r3 = recordPayment(issued, { amount: half, date: '2025-10-08' });
+  const partially = r3.value;
+
+  const r4 = statement('C-001', [partially], '2025-10-31');
+  assert.equal(r4.value.invoices.length, 1);
+  assert.equal(r4.value.invoices[0].due, totals.total - half);
