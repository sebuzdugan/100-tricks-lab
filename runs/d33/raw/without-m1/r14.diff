+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns customer not found for unknown customer', () => {
+  const r = statement('C-999', [], '2025-10-31');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement returns empty invoices for customer with no issued invoices', () => {
+  const r = statement('C-001', [], '2025-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes single issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = statement('C-001', [issued], '2025-10-31');
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.invoices.length, 1);
+  assert.equal(r3.value.invoices[0].number, 'INV-2025-0001');
+  assert.equal(r3.value.invoices[0].issueDate, '2025-10-07');
+});
+
+test('statement includes dueDate in invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = statement('C-001', [issued], '2025-10-31');
+  assert.equal(r3.value.invoices[0].dueDate, '2025-10-21');
+});
+
+test('statement includes total in invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = statement('C-001', [issued], '2025-10-31');
+  assert.ok(r3.value.invoices[0].total > 0);
+});
+
+test('statement includes due (unpaid balance) in invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = statement('C-001', [issued], '2025-10-31');
+  assert.equal(r3.value.invoices[0].due, r3.value.invoices[0].total);
+});
+
+test('statement calculates due after partial payment', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+  const totals = invoiceTotals(issued);
+  const half = Math.floor(totals.total / 2);
+  const r3 = recordPayment(issued, { amount: half, date: '2025-10-08' });
+  const paid = r3.value;
+
+  const r4 = statement('C-001', [paid], '2025-10-31');
+  assert.equal(r4.value.invoices[0].due, totals.total - half);
+});
+
+test('statement excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+
+  const r2 = statement('C-001', [invoice], '2025-10-31');
+  assert.equal(r2.value.invoices.length, 0);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = statement('C-001', [issued], '2025-10-06');
+  assert.equal(r3.value.invoices.length, 0);
