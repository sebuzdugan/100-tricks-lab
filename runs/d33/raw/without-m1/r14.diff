+
+test('statement excludes paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+  const totals = invoiceTotals(issued);
+  const r3 = recordPayment(issued, { amount: totals.total, date: '2025-10-08' });
+  const paid = r3.value;
+
+  const r4 = statement('C-001', [paid], '2025-10-31');
+  assert.equal(r4.value.invoices.length, 0);
+});
+
+test('statement normalizes customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = statement(' c-001 ', [issued], '2025-10-31');
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.customerId, 'C-001');
+  assert.equal(r3.value.invoices.length, 1);
+});
+
+test('statement with voucher applied', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = applyVoucher(invoice, { code: 'WELCOME', amount: 1000 });
+  const vouched = r2.value;
+  const r3 = issueInvoice(vouched, []);
+  const issued = r3.value;
+  const totals = invoiceTotals(issued);
+
+  const r4 = statement('C-001', [issued], '2025-10-31');
+  assert.equal(r4.value.invoices[0].total, totals.total);
+});
+
+test('statement returns customer ID in response', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = statement('C-001', [issued], '2025-10-31');
+  assert.equal(r3.value.customerId, 'C-001');
+});
+
+test('statement with multiple invoices and mixed payment status', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  });
+
+  const inv1 = issueInvoice(r1.value, []);
+  const inv2 = issueInvoice(r2.value, ['INV-2025-0001']);
+  const inv3 = issueInvoice(r3.value, ['INV-2025-0001', 'INV-2025-0002']);
+
+  const totals1 = invoiceTotals(inv1.value);
+  const totals2 = invoiceTotals(inv2.value);
+
+  const inv2Paid = recordPayment(inv2.value, { amount: Math.floor(totals2.total / 2), date: '2025-10-12' }).value;
+
+  const r4 = statement('C-001', [inv1.value, inv2Paid, inv3.value], '2025-10-31');
+  assert.equal(r4.value.invoices.length, 3);
+  assert.equal(r4.value.invoices[0].due, totals1.total);
+  assert.equal(r4.value.invoices[1].due, Math.ceil(totals2.total / 2));
+  assert.ok(r4.value.totalDue > 0);
+});
