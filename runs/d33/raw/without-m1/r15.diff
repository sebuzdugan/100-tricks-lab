+
+  const r3 = createCreditNote(issued, { amount: 1000.5, reason: 'Return', date: '2025-10-15' }, []);
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'AMOUNT_INVALID');
+});
