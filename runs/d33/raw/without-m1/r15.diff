+  const partially = r3.value;
+
+  const r4 = createCreditNote(partially, { amount: 500, reason: 'Adjustment', date: '2025-10-15' }, []);
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.number, 'CN-2025-0001');
