+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote returns credit note object', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = createCreditNote(issued, { amount: 1000, reason: 'Return', date: '2025-10-15' }, []);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2025-0001');
+  assert.equal(r3.value.invoiceNumber, 'INV-2025-0001');
+  assert.equal(r3.value.customerId, 'C-001');
+  assert.equal(r3.value.amount, 1000);
+  assert.equal(r3.value.reason, 'Return');
+  assert.equal(r3.value.date, '2025-10-15');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+
+  const r2 = createCreditNote(invoice, { amount: 1000, reason: 'Return', date: '2025-10-15' }, []);
+  assert.equal(r2.ok, false);
+  assert.equal(r2.error, 'NOT_ISSUED');
+});
+
