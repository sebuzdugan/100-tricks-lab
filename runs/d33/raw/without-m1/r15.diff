+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const creditNotes = existingNumbers
+    .filter((num) => num.startsWith('CN-'))
+    .filter((num) => num.startsWith(`CN-${year}-`));
+
+  const counters = creditNotes.map((num) => parseInt(num.split('-')[2], 10)).filter((n) => !isNaN(n));
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+
+  const newCounter = maxCounter + 1;
+  return `CN-${year}-${String(newCounter).padStart(4, '0')}`;
+}
+
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  const validStatuses = ['issued', 'partially_paid', 'paid'];
+  if (!validStatuses.includes(invoice.status)) return fail('NOT_ISSUED');
+
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) return fail('CREDIT_TOO_HIGH');
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
