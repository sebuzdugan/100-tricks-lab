+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns empty array when no invoices', () => {
+  const r = overdueInvoices([], '2025-10-31');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+
+  const r2 = overdueInvoices([invoice], '2025-10-31');
+  assert.equal(r2.length, 0);
+});
+
+test('overdueInvoices includes issued invoice past due date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = overdueInvoices([issued], '2025-10-22');
+  assert.equal(r3.length, 1);
+  assert.equal(r3[0].number, 'INV-2025-0001');
+  assert.equal(r3[0].customerId, 'C-001');
+  assert.equal(r3[0].dueDate, '2025-10-21');
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = overdueInvoices([issued], '2025-10-21');
+  assert.equal(r3.length, 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
