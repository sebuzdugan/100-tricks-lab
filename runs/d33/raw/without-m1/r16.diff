+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const r3 = overdueInvoices([issued], '2025-10-30');
+  assert.equal(r3[0].daysOverdue, 9);
+});
+
+test('overdueInvoices includes due amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+  const totals = invoiceTotals(issued);
+
+  const r3 = overdueInvoices([issued], '2025-10-22');
+  assert.equal(r3[0].due, totals.total);
+});
+
+test('overdueInvoices calculates due after partial payment', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+  const totals = invoiceTotals(issued);
+  const half = Math.floor(totals.total / 2);
+
