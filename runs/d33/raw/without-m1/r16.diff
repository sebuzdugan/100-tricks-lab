@@ -0,0 +1,31 @@
+import { invoiceTotals } from './invoices.js';
+
+function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments ?? []).reduce((sum, payment) => sum + payment.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
+
+function daysOverdue(dueDate, asOf) {
+  const due = new Date(dueDate + 'T00:00:00Z');
+  const asOfDate = new Date(asOf + 'T00:00:00Z');
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((asOfDate.getTime() - due.getTime()) / msPerDay);
+}
+
+export function overdueInvoices(invoices, asOf) {
+  const validStatuses = ['issued', 'partially_paid'];
+  const overdue = invoices
+    .filter((inv) => validStatuses.includes(inv.status))
+    .filter((inv) => inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysOverdue(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
