+import { invoiceTotals, lineTotal, discountAmount, lineVAT } from './invoices.js';
 
 function balanceDue(invoice) {
   const totals = invoiceTotals(invoice);
@@ -29,3 +29,26 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+export function vatSummary(invoices) {
+  const validStatuses = ['issued', 'partially_paid', 'paid'];
+  const vatMap = {};
+
+  for (const invoice of invoices) {
+    if (!validStatuses.includes(invoice.status)) continue;
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - discountAmount(line);
+      const vat = lineVAT(line);
+
+      if (!vatMap[rate]) {
+        vatMap[rate] = { rate, base: 0, vat: 0 };
+      }
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vat;
+    }
+  }
+
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
