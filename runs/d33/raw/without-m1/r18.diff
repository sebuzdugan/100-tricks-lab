@@ -52,3 +52,15 @@ export function vatSummary(invoices) {
 
   return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
 }
+
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const days = daysOverdue(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = Math.round(days * due * 0.0004);
+
+  return fee;
+}
