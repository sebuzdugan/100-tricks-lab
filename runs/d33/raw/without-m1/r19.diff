+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns string', () => {
+  const r = exportCsv([]);
+  assert.equal(typeof r, 'string');
+});
+
+test('exportCsv with empty invoice list', () => {
+  const r = exportCsv([]);
+  const lines = r.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines.length, 2);
+});
+
+test('exportCsv includes header line', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const csv = exportCsv([issued]);
+  assert.ok(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv ends with newline', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issued = r2.value;
+
+  const csv = exportCsv([issued]);
+  assert.ok(csv.endsWith('\n'));
+});
+
