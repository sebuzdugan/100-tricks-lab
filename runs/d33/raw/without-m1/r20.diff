+
+test('RATES has EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const r = convert(10000, 'EUR');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 10000);
+});
+
+test('convert EUR to USD applies rate', () => {
+  const r = convert(10000, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, Math.round(10000 * 1.085));
+});
+
+test('convert EUR to GBP applies rate', () => {
+  const r = convert(10000, 'GBP');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, Math.round(10000 * 0.8425));
+});
+
+test('convert with unknown currency returns error', () => {
+  const r = convert(10000, 'JPY');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert handles fractional results', () => {
+  const r = convert(123, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(typeof r.value, 'number');
+  assert.equal(r.value % 1, 0);
+});
+
+test('convert with zero amount', () => {
+  const r = convert(0, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 0);
+});
+
+test('convert with negative amount', () => {
+  const r = convert(-10000, 'USD');
+  assert.equal(r.ok, true);
+  assert.ok(r.value < 0);
+});
+
+test('formatMoney for EUR uses euro symbol', () => {
