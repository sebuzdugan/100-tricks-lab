+test('mergeCustomers merges one customer into another', () => {
+  const customers = [
+    { id: 'C-001', name: 'Northwind Studio', email: 'a@b.com', tier: 'gold' },
+    { id: 'C-002', name: 'Second Org', email: 'b@c.com', tier: 'silver' },
+  ];
+  const invoices = [];
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, 1);
+  assert.equal(r.value.customers[0].id, 'C-002');
+});
