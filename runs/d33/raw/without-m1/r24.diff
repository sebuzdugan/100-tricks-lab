   return fee;
 }
+
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDues = {};
+
+  for (const invoice of invoices) {
+    counts[invoice.status]++;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDues[invoice.customerId]) {
+        customerDues[invoice.customerId] = 0;
+      }
+      customerDues[invoice.customerId] += due;
+    }
+  }
+
+  const overdueList = overdueInvoices(invoices, asOf);
+  let overdueAmount = 0;
+  for (const item of overdueList) {
+    overdueAmount += item.due;
+  }
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueAmount,
+  };
+
+  const topCustomers = Object.entries(customerDues)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return { counts, outstanding, overdue, topCustomers };
+}
