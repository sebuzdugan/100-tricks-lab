@@ -10,12 +10,32 @@ export function renderInvoiceText(invoice) {
 
   const lineStrings = invoice.lines.map((line) => {
     const total = lineTotal(line);
-    return `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    const discount = discountAmount(line);
+    let lineStr = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    if (discount > 0) {
+      lineStr += ` (discount: ${formatEuros(discount)})`;
+    }
+    return lineStr;
   });
 
-  const { vat, total } = invoiceTotals(invoice);
+  const { vat, voucher, total } = invoiceTotals(invoice);
 
-  const parts = [number, customerName, ...lineStrings, `VAT: ${formatEuros(vat)}`, `Total: ${formatEuros(total)}`];
+  const parts = [number, customerName, ...lineStrings, `VAT: ${formatEuros(vat)}`];
+
+  if (voucher > 0) {
+    parts.push(`Voucher: ${formatEuros(-voucher)}`);
+  }
+
+  parts.push(`Total: ${formatEuros(total)}`);
+
+  if (invoice.dueDate) {
+    parts.push(`Due: ${invoice.dueDate}`);
+  }
+
+  const paid = (invoice.payments ?? []).reduce((sum, payment) => sum + payment.amount, 0);
+  if (paid > 0) {
+    parts.push(`Paid: ${formatEuros(paid)}`);
+  }
 
   return parts.join('\n');
 }
