@@ -0,0 +1,179 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates an invoice with valid inputs', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 8500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].name, 'Development (hour)');
+  assert.equal(r.value.lines[0].qty, 10);
+  assert.equal(r.value.lines[1].name, 'Logo package');
+  assert.equal(r.value.lines[1].qty, 1);
+});
+
+test('createInvoice reports unknown customer', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-999',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'CUSTOMER_NOT_FOUND' }
+  );
+});
+
+test('createInvoice requires valid date in YYYY-MM-DD format', () => {
+  const validCustomer = { customerId: 'C-001', lines: [{ sku: 'DES-HOUR', qty: 1 }] };
+
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, issueDate: '2026-13-01' }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, issueDate: '2026/10/07' }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, issueDate: '10-07-2026' }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, issueDate: '2026-10-32' }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, issueDate: '2026-02-30' }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, issueDate: 'not-a-date' }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects empty lines array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice rejects missing lines', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: undefined,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice requires positive integer quantities', () => {
+  const validCustomer = { customerId: 'C-001', issueDate: '2026-10-07' };
+
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, lines: [{ sku: 'DES-HOUR', qty: 0 }] }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, lines: [{ sku: 'DES-HOUR', qty: -5 }] }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, lines: [{ sku: 'DES-HOUR', qty: 1.5 }] }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+  assert.deepEqual(
+    createInvoice({ ...validCustomer, lines: [{ sku: 'DES-HOUR', qty: '5' }] }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice reports unknown SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice does not mutate the input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  };
+  const originalInput = JSON.stringify(input);
+
+  createInvoice(input);
+
+  assert.equal(JSON.stringify(input), originalInput);
+});
+
+test('createInvoice copies product details without mutation', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  });
+
+  assert.equal(r1.value.lines[0].qty, 5);
+  assert.equal(r2.value.lines[0].qty, 3);
+  assert.equal(r1.value.lines[0].name, r2.value.lines[0].name);
+  assert.equal(r1.value.lines[0].unitPrice, r2.value.lines[0].unitPrice);
+});
+
+test('createInvoice handles products with different VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].vatRate, 21);
+  assert.equal(r.value.lines[1].vatRate, 9);
+  assert.equal(r.value.lines[2].vatRate, 0);
+});
