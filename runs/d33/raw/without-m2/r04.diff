+++ b/test/numbering.test.js
@@ -0,0 +1,72 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates the first number for a year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter for the same year', () => {
+  const existing = ['INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles multiple existing numbers in same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0999', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber starts fresh for a new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0999'];
+  const number = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber uses correct year from issueDate', () => {
+  const existing = [];
+  const number2027 = nextInvoiceNumber(existing, '2027-06-15');
+  assert.equal(number2027, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0099'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = Array.from({ length: 999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2026-XXXX', 'INV-2026-', 'invalid', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber is not affected by input order', () => {
+  const numbers1 = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'];
+  const numbers2 = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const result1 = nextInvoiceNumber(numbers1, '2026-10-07');
+  const result2 = nextInvoiceNumber(numbers2, '2026-10-07');
+  assert.equal(result1, result2);
+  assert.equal(result1, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber does not mutate the existingNumbers array', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const original = JSON.stringify(existing);
+  nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(JSON.stringify(existing), original);
+});
