+++ b/test/render.test.js
@@ -0,0 +1,195 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { formatEuros } from '../src/money.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const text = renderInvoiceText(issued.value);
+  assert.ok(text.startsWith('INV-2026-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText formats amounts in euros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('€'));
+});
+
+test('renderInvoiceText shows qty, product name, unit price and line total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('5 x Design work (hour)'));
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€425.00'));
+});
+
+test('renderInvoiceText shows multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.ok(lines.some((line) => line.includes('Design work (hour)')));
+  assert.ok(lines.some((line) => line.includes('Logo package')));
+});
+
+test('renderInvoiceText calculates correct line totals', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 2 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('10 x Design work (hour) @ €85.00 = €850.00'));
+  assert.ok(text.includes('2 x Logo package @ €1,200.00 = €2,400.00'));
+});
+
+test('renderInvoiceText ends with Total line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.ok(lines[lines.length - 1].startsWith('Total: €'));
+});
+
+test('renderInvoiceText calculates correct total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const expectedTotal = 5 * 8500 + 1 * 120000;
+  const expectedTotalFormatted = formatEuros(expectedTotal);
+  assert.ok(text.includes(`Total: ${expectedTotalFormatted}`));
+});
+
+test('renderInvoiceText handles different VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('Printed flyer A4 (each)'));
+  assert.ok(text.includes('Brand workshop (day, VAT exempt)'));
+});
+
+test('renderInvoiceText handles different customers', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text1 = renderInvoiceText(r1.value);
+  const text2 = renderInvoiceText(r2.value);
+  assert.ok(text1.includes('Northwind Studio'));
+  assert.ok(text2.includes('Kite & Co'));
+});
+
+test('renderInvoiceText formats large amounts correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 3 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('€2,450.00'));
+  assert.ok(text.includes('€7,350.00'));
+});
+
+test('renderInvoiceText formats small amounts correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('€0.50'));
+  assert.ok(text.includes('€2.50'));
+});
+
+test('renderInvoiceText handles single line invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.ok(lines[2].includes('Design work'));
+  assert.ok(lines[3].startsWith('Total:'));
+});
+
+test('renderInvoiceText does not mutate invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = r.value;
+  const original = JSON.stringify(invoice);
+  renderInvoiceText(invoice);
+  assert.equal(JSON.stringify(invoice), original);
+});
