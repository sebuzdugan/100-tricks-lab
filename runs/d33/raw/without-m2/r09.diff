+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-007'), 'C-007');
+  assert.equal(normalizeId('C-001'), 'C-001');
+});
+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('c-007 '), 'C-007');
+  assert.equal(normalizeId(' c-007'), 'C-007');
+  assert.equal(normalizeId('  c-007  '), 'C-007');
+  assert.equal(normalizeId('\tc-007\n'), 'C-007');
+});
+
+test('normalizeId handles mixed case and whitespace', () => {
+  assert.equal(normalizeId(' c-007 '), 'C-007');
+  assert.equal(normalizeId(' C-001 '), 'C-001');
+  assert.equal(normalizeId('C-003  '), 'C-003');
+});
+
+test('normalizeId handles null and undefined', () => {
+  assert.equal(normalizeId(null), '');
+  assert.equal(normalizeId(undefined), '');
+  assert.equal(normalizeId(''), '');
+});
+
+test('getCustomer works with lowercase id', () => {
+  const r = getCustomer('c-003');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Kite & Co');
+});
+
+test('getCustomer works with mixed case and whitespace', () => {
+  const r = getCustomer(' c-001 ');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Northwind Studio');
+});
+
+test('getCustomer works with uppercase with spaces', () => {
+  const r = getCustomer('C-007  ');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Halvorsen Architects');
+});
+
+test('getCustomer still fails for truly unknown ids', () => {
+  assert.deepEqual(getCustomer('c-999'), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+  assert.deepEqual(getCustomer(' C-999 '), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
