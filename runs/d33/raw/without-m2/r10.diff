new file mode 100644
index 0000000..faae43c
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,37 @@
+/**
+ * Validate a date string in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+  const match = /^\d{4}-\d{2}-\d{2}$/.exec(text);
+  if (!match) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  return date instanceof Date && !isNaN(date) && date.toISOString().startsWith(text);
+}
+
+/**
+ * Add n days to a date, in UTC.
+ * @param {string} date - date in YYYY-MM-DD format
+ * @param {number} n - number of days to add (can be negative)
+ * @returns {string} - result in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a), in UTC.
+ * @param {string} a - start date in YYYY-MM-DD format
+ * @param {string} b - end date in YYYY-MM-DD format
+ * @returns {number} - number of days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
