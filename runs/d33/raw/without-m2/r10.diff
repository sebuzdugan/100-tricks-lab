diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..e1de461
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,145 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate validates correct date format', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2027-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-13-01'), false); // invalid month
+  assert.equal(isValidDate('2026-02-30'), false); // invalid day
+  assert.equal(isValidDate('2026-10-32'), false); // invalid day
+  assert.equal(isValidDate('1999-02-29'), false); // not a leap year
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(12345), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(['2026-10-07']), false);
+});
+
+test('isValidDate rejects strings with extra whitespace', () => {
+  assert.equal(isValidDate(' 2026-10-07'), false);
+  assert.equal(isValidDate('2026-10-07 '), false);
+  assert.equal(isValidDate(' 2026-10-07 '), false);
+});
+
+test('addDays adds positive number of days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 30), '2026-11-06');
+});
+
+test('addDays handles month overflow', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles year overflow', () => {
+  assert.equal(addDays('2026-12-25', 10), '2027-01-04');
+  assert.equal(addDays('2025-12-31', 365), '2026-12-31');
+});
+
+test('addDays subtracts with negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+  assert.equal(addDays('2026-10-07', -30), '2026-09-07');
+});
+
+test('addDays handles month underflow', () => {
+  assert.equal(addDays('2026-10-01', -1), '2026-09-30');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays handles leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // leap year
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01'); // after leap day
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01'); // non-leap year
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-11-06'), 30);
+});
+
+test('daysBetween calculates across month boundary', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-09-30', '2026-10-15'), 15);
+});
+
+test('daysBetween calculates across year boundary', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2025-12-25', '2026-01-01'), 7);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+  assert.equal(daysBetween('2026-11-06', '2026-10-07'), -30);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween same date returns zero', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles leap year', () => {
+  // Feb 28 to Mar 1 in leap year
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  // Feb 28 to Mar 1 in non-leap year
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1);
+});
+
+test('daysBetween works across years', () => {
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is leap year
+});
+
+test('daysBetween large date ranges', () => {
+  assert.equal(daysBetween('2000-01-01', '2026-10-07'), 9776);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const startDate = '2026-10-07';
+  const daysAdded = 42;
+  const endDate = addDays(startDate, daysAdded);
+  assert.equal(daysBetween(startDate, endDate), daysAdded);
+});
+
+test('addDays commutes correctly with daysBetween', () => {
+  const date1 = '2026-10-07';
+  const date2 = '2026-11-15';
+  const days = daysBetween(date1, date2);
+  assert.equal(addDays(date1, days), date2);
+  assert.equal(addDays(date2, -days), date1);
+});
+
+test('isValidDate works in UTC timezone', () => {
+  // Test that it always uses UTC, not local timezone
+  assert.equal(isValidDate('2026-02-29'), false); // not a leap year
+  assert.equal(isValidDate('2024-02-29'), true);  // is a leap year
+});
+
+test('addDays works in UTC timezone', () => {
+  // 2026-12-31 + 1 day should be 2027-01-01 (not affected by local timezone)
+  const result = addDays('2026-12-31', 1);
+  assert.equal(result, '2027-01-01');
+});
