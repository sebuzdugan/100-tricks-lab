+function calculateDueDate(issueDate, terms) {
+  const validTerms = ['NET14', 'NET30', 'EOM'];
+  if (!validTerms.includes(terms)) {
+    return null;
+  }
+
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-');
+    const monthNum = parseInt(month, 10);
+    const nextMonthNum = monthNum === 12 ? 1 : monthNum + 1;
+    const nextYear = monthNum === 12 ? String(parseInt(year, 10) + 1) : year;
+    const nextMonthStr = String(nextMonthNum).padStart(2, '0');
+    const firstOfNextMonth = `${nextYear}-${nextMonthStr}-01`;
+    return addDays(firstOfNextMonth, -1);
+  }
+}
