+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement.
+ * @param {string} customerId
+ * @param {Array<{ number: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array, voucher?: { code: string, amount: number } }>} invoices
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  const statementInvoices = invoices
+    .filter((inv) => inv.customerId === customerId && (inv.status === 'issued' || inv.status === 'partially_paid') && inv.issueDate <= asOf)
+    .map((inv) => {
+      const totals = invoiceTotals(inv);
+      return {
+        number: inv.number,
+        issueDate: inv.issueDate,
+        dueDate: inv.dueDate,
+        total: totals.total,
+        due: balanceDue(inv),
+      };
+    })
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
