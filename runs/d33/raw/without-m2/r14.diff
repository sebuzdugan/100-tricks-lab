+
+test('statement returns correct customerId', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = statement('C-003', [issued.value], '2026-10-31');
+
+  assert.equal(result.value.customerId, 'C-003');
+});
+
+test('statement with voucher correctly reflects due amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const withVoucher = applyVoucher(r.value, { code: 'SAVE10', amount: 10000 });
