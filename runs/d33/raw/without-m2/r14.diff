+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const issued1 = issueInvoice(r1.value, []);
+  const issued2 = issueInvoice(r2.value, ['INV-2026-0001']);
+  const issued3 = issueInvoice(r3.value, ['INV-2026-0001', 'INV-2026-0002']);
+
+  const result = statement('C-001', [issued1.value, issued2.value, issued3.value], '2026-10-31');
+  const issueDates = result.value.invoices.map((inv) => inv.issueDate);
+
+  assert.deepEqual(issueDates, ['2026-10-07', '2026-10-15', '2026-10-20']);
+});
+
+test('statement calculates totalDue as sum of due amounts', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issued1 = issueInvoice(r1.value, []);
+  const issued2 = issueInvoice(r2.value, ['INV-2026-0001']);
+
+  const result = statement('C-001', [issued1.value, issued2.value], '2026-10-31');
+  const expectedTotalDue = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  assert.equal(result.value.totalDue, expectedTotalDue);
+});
+
+test('statement with partially paid invoice includes correct due', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const partial = recordPayment(issued.value, { amount: 30000, date: '2026-10-15' });
+
+  const result = statement('C-001', [partial.value], '2026-10-31');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, result.value.totalDue);
+});
+
+test('statement with multiple invoices calculates totalDue correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issued1 = issueInvoice(r1.value, []);
