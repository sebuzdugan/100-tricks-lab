+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('C-999', [], '2026-10-31');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement returns empty invoices for customer with no issued invoices', () => {
+  const result = statement('C-001', [], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes issued invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = statement('C-001', [issued.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, issued.value.number);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const partial = recordPayment(issued.value, { amount: 20000, date: '2026-10-15' });
+
+  const result = statement('C-001', [partial.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement excludes draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const result = statement('C-001', [r.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-15' });
+
+  const result = statement('C-001', [paid.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-11-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = statement('C-001', [issued.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement includes invoices with issueDate equal to asOf', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-31',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = statement('C-001', [issued.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement returns invoice details', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = statement('C-001', [issued.value], '2026-10-31');
+  const inv = result.value.invoices[0];
