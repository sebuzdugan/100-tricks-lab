@@ -0,0 +1,264 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote returns NOT_ISSUED for draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = createCreditNote(r.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote accepts issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, issued.value.number);
+});
+
+test('createCreditNote accepts partially_paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const partial = recordPayment(issued.value, { amount: 20000, date: '2026-10-15' });
+
+  const result = createCreditNote(partial.value, { amount: 10000, reason: 'Refund', date: '2026-10-20' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote accepts paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-15' });
+
+  const result = createCreditNote(paid.value, { amount: 10000, reason: 'Refund', date: '2026-10-20' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote returns AMOUNT_INVALID for non-integer amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 100.50, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns AMOUNT_INVALID for zero amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 0, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns AMOUNT_INVALID for negative amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: -10000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns DATE_INVALID for invalid date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-13-01' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote returns CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = createCreditNote(issued.value, { amount: totals.total + 1, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows amount equal to invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = createCreditNote(issued.value, { amount: totals.total, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote allows amount less than invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 10000);
+});
+
+test('createCreditNote includes customerId in result', () => {
+  const r = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.equal(result.value.customerId, 'C-005');
+});
+
+test('createCreditNote includes reason in result', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Customer requested refund', date: '2026-10-15' }, []);
+
+  assert.equal(result.value.reason, 'Customer requested refund');
+});
+
+test('createCreditNote includes date in result', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.equal(result.value.date, '2026-10-15');
+});
+
+test('createCreditNote generates CN prefix', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.match(result.value.number, /^CN-2026-\d{4}$/);
+});
+
+test('createCreditNote increments CN counter independently from INV', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result1 = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, ['INV-2026-0001']);
+  const result2 = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-20' }, ['INV-2026-0001', result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote continues CN counter across years', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const existing = ['CN-2025-0001', 'CN-2025-0002'];
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, existing);
+
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote with multiple credit notes same year', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const existing = ['CN-2026-0001', 'CN-2026-0005', 'CN-2026-0003'];
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, existing);
+
+  assert.equal(result.value.number, 'CN-2026-0006');
+});
+
+test('createCreditNote preserves invoice information', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.equal(result.value.invoiceNumber, issued.value.number);
+  assert.equal(result.value.customerId, issued.value.customerId);
+});
