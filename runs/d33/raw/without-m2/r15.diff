+
+/**
+ * Get the next credit note number for a given year.
+ * Format: CN-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {string[]} existingNumbers - array of all numbers already used (invoices and credit notes)
+ * @param {string} issueDate - issue date in YYYY-MM-DD format
+ * @returns {string} the next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  const countersForYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counterStr = num.substring(prefix.length);
+      const counter = Number(counterStr);
+      return Number.isInteger(counter) && counter > 0 ? counter : 0;
+    })
+    .filter((c) => c > 0);
+
+  const maxCounter = countersForYear.length > 0 ? Math.max(...countersForYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
diff --git a/test/credits.test.js b/test/credits.test.js
