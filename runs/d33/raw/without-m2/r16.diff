+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array for empty invoices', () => {
+  const result = overdueInvoices([], '2026-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty array when no invoices are overdue', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = overdueInvoices([issued.value], '2026-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes issued invoices that are overdue', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = overdueInvoices([issued.value], '2026-11-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.value.number);
+});
+
+test('overdueInvoices includes partially_paid invoices that are overdue', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const partial = recordPayment(issued.value, { amount: 20000, date: '2026-10-15' });
+
+  const result = overdueInvoices([partial.value], '2026-11-15');
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = overdueInvoices([r.value], '2026-11-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-15' });
+
+  const result = overdueInvoices([paid.value], '2026-11-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = overdueInvoices([issued.value], '2026-10-30');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes invoices due exactly on asOf date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const dueDate = issued.value.dueDate;
+
+  const result = overdueInvoices([issued.value], dueDate);
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = overdueInvoices([issued.value], '2026-11-13');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 7);
+});
+
+test('overdueInvoices includes customerId in result', () => {
+  const r = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = overdueInvoices([issued.value], '2026-11-15');
+  assert.equal(result[0].customerId, 'C-005');
+});
+
+test('overdueInvoices includes dueDate in result', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+
+  const result = overdueInvoices([issued.value], '2026-11-15');
+  assert.equal(result[0].dueDate, issued.value.dueDate);
+});
+
+test('overdueInvoices calculates due amount correctly for unpaid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = overdueInvoices([issued.value], '2026-11-15');
+  assert.equal(result[0].due, totals.total);
+});
+
+test('overdueInvoices calculates due amount correctly for partially paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const partial = recordPayment(issued.value, { amount: 20000, date: '2026-10-15' });
+  const totals = invoiceTotals(issued.value);
+  const expectedDue = totals.total - 20000;
+
+  const result = overdueInvoices([partial.value], '2026-11-15');
+  assert.equal(result[0].due, expectedDue);
+});
+
+test('overdueInvoices sorts by most overdue first', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(r1.value, ['INV-2026-0001']);
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued2 = issueInvoice(r2.value, ['INV-2026-0001', 'INV-2026-0002']);
+
+  const result = overdueInvoices([issued2.value, issued1.value], '2026-11-06');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, issued1.value.number);
+  assert.equal(result[1].number, issued2.value.number);
+  assert.ok(result[0].daysOverdue > result[1].daysOverdue);
+});
+
+test('overdueInvoices filters mixed statuses correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(r1.value, ['INV-2026-0001']);
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued2 = issueInvoice(r2.value, ['INV-2026-0001', 'INV-2026-0002']);
+  const partial2 = recordPayment(issued2.value, { amount: 20000, date: '2026-10-15' });
+
+  const r3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = overdueInvoices([issued1.value, partial2.value, r3.value], '2026-11-15');
+  assert.equal(result.length, 2);
+  assert.ok(result.some((inv) => inv.number === issued1.value.number));
+  assert.ok(result.some((inv) => inv.number === partial2.value.number));
+});
+
+test('overdueInvoices with multiple overdue invoices maintains sort order', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(r1.value, ['INV-2026-0001']);
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued2 = issueInvoice(r2.value, ['INV-2026-0001', 'INV-2026-0002']);
+
+  const r3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued3 = issueInvoice(r3.value, ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003']);
+
+  const result = overdueInvoices([issued2.value, issued1.value, issued3.value], '2026-11-10');
+  assert.equal(result.length, 3);
+  assert.equal(result[0].number, issued1.value.number);
+  assert.equal(result[1].number, issued3.value.number);
+  assert.equal(result[2].number, issued2.value.number);
+  for (let i = 0; i < result.length - 1; i++) {
+    assert.ok(result[i].daysOverdue >= result[i + 1].daysOverdue);
+  }
+});
