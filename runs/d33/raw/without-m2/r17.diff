@@ -21,3 +23,39 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Get a summary of VAT by rate across invoices.
+ * @param {Array} invoices - array of invoice objects
+ * @returns {Array<{ rate: number, base: number, vat: number }>} entries sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  invoices
+    .filter((invoice) => invoice.status === 'issued' || invoice.status === 'partially_paid' || invoice.status === 'paid')
+    .forEach((invoice) => {
+      invoice.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const lineBase = lineTotal(line);
+        const discountPercent = line.discountPercent ?? 0;
+        const lineDiscount = roundCents(lineBase * (discountPercent / 100));
+        const baseAmount = lineBase - lineDiscount;
+        const vatAmount = roundCents(baseAmount * (rate / 100));
+
+        if (!vatMap[rate]) {
+          vatMap[rate] = { rate, base: 0, vat: 0 };
+        }
+        vatMap[rate].base += baseAmount;
+        vatMap[rate].vat += vatAmount;
+      });
+    });
+
+  return Object.values(vatMap)
+    .map((entry) => ({
+      rate: entry.rate,
+      base: entry.base,
+      vat: entry.vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
