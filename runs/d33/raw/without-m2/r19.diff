+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function formatAmount(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array} invoices - array of invoice objects
+ * @returns {string} CSV content with header and data rows
+ */
+export function exportCsv(invoices) {
+  const header = ['number', 'customer', 'issueDate', 'dueDate', 'status', 'subtotal', 'discount', 'vat', 'total', 'due'].join(',');
+
+  const rows = invoices.map((invoice) => {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number,
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatAmount(totals.subtotal),
+      formatAmount(totals.discount),
+      formatAmount(totals.vat),
+      formatAmount(totals.total),
+      formatAmount(due),
+    ];
+
+    return fields.map(escapeCsvField).join(',');
+  });
+
+  return header + '\n' + rows.join('\n') + '\n';
+}
