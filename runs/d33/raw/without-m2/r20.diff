--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,36 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount in euros (cents) to another currency (cents).
+ * @param {number} cents - amount in euro cents
+ * @param {string} currency - target currency (EUR, USD, or GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const rate = RATES[currency];
+  return ok(roundCents(cents * rate));
+}
+
+/**
+ * Format cents as money in the specified currency: 123456 -> "$1,234.56" (USD), "£1,234.56" (GBP), "€1,234.56" (EUR).
+ * @param {number} cents
+ * @param {string} currency
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+  const symbol = symbols[currency] ?? currency;
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
