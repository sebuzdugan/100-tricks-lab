+test('convert EUR returns same amount', () => {
+  const result = convert(100, 'EUR');
+  assert.deepEqual(result, { ok: true, value: 100 });
+});
+
+test('convert USD multiplies by rate and rounds', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, roundCents(100 * 1.085));
+});
+
+test('convert GBP multiplies by rate and rounds', () => {
