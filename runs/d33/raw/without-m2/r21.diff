diff --git a/src/customers.js b/src/customers.js
index deb9dbf..87a44a3 100644
--- a/src/customers.js
+++ b/src/customers.js
@@ -43,3 +43,36 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge two customers: remove fromId and reassign its invoices to intoId.
+ * @param {Array} customers - array of customer objects
+ * @param {Array} invoices - array of invoice objects
+ * @param {string} fromId - customer id to merge from
+ * @param {string} intoId - customer id to merge into
+ * @returns {{ ok: true, value: { customers, invoices } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  const fromCustomerExists = customers.some(c => c.id === normalizedFromId);
+  const intoCustomerExists = customers.some(c => c.id === normalizedIntoId);
+
+  if (!fromCustomerExists || !intoCustomerExists) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const updatedCustomers = customers.filter(c => c.id !== normalizedFromId);
+  const updatedInvoices = invoices.map(invoice =>
+    invoice.customerId === normalizedFromId
+      ? { ...invoice, customerId: normalizedIntoId }
+      : invoice,
+  );
+
+  return ok({ customers: updatedCustomers, invoices: updatedInvoices });
+}
