diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..03fd580
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,49 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line: qty * unitPrice.
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number} total in cents
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent: number, vatRate: number }>, voucher?: { code: string, amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = roundCents(invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
+
+  const discount = roundCents(
+    invoice.lines.reduce((sum, line) => {
+      const discountPercent = line.discountPercent ?? 0;
+      const lineDiscount = roundCents(lineTotal(line) * (discountPercent / 100));
+      return sum + lineDiscount;
+    }, 0)
+  );
+
+  const vat = roundCents(
+    invoice.lines.reduce((sum, line) => {
+      const discountPercent = line.discountPercent ?? 0;
+      const lineSubtotal = lineTotal(line);
+      const lineDiscount = roundCents(lineSubtotal * (discountPercent / 100));
+      const lineAmount = lineSubtotal - lineDiscount;
+      const lineVat = roundCents(lineAmount * (line.vatRate / 100));
+      return sum + lineVat;
+    }, 0)
+  );
+
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
