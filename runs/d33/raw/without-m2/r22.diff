+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+import { roundCents } from '../src/money.js';
+import { createInvoice } from '../src/invoices.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 120000 }), 120000);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 6000 }), 60000);
+});
+
+test('lineTotal returns cents as integer', () => {
+  const result = lineTotal({ qty: 3, unitPrice: 6000 });
+  assert.equal(Number.isInteger(result), true);
+});
+
+test('invoiceTotals sums line totals for subtotal and total', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 },
+      { qty: 1, unitPrice: 120000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500 + 120000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 162500);
+});
+
+test('invoiceTotals handles single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 6000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 60000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 60000);
+});
+
+test('invoiceTotals handles empty lines array', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals works with real invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  const totals = invoiceTotals(r.value);
+  const subtotal = 5 * 8500 + 1 * 120000;
+  const discount = roundCents(subtotal * 0.05);
+  const line1Amount = (5 * 8500) - roundCents((5 * 8500) * 0.05);
+  const line2Amount = (1 * 120000) - roundCents((1 * 120000) * 0.05);
+  const vat = roundCents(line1Amount * 0.21) + roundCents(line2Amount * 0.21);
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, subtotal - discount + vat);
+});
+
+test('invoiceTotals does not mutate the invoice', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 },
+      { qty: 1, unitPrice: 120000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const original = JSON.stringify(invoice);
+  invoiceTotals(invoice);
+  assert.equal(JSON.stringify(invoice), original);
+});
+
+test('invoiceTotals returns discount field', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+});
+
+test('invoiceTotals calculates discount correctly for single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 10 * 8500;
+  const expectedDiscount = roundCents(subtotal * 0.1);
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.discount, expectedDiscount);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, subtotal - expectedDiscount);
+});
+
+test('invoiceTotals calculates discount for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 0 },
+      { qty: 1, unitPrice: 120000, discountPercent: 5, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const line1Total = 5 * 8500;
+  const line2Total = 1 * 120000;
+  const line1Discount = roundCents(line1Total * 0.1);
+  const line2Discount = roundCents(line2Total * 0.05);
+  const expectedDiscount = line1Discount + line2Discount;
+  assert.equal(totals.subtotal, line1Total + line2Total);
+  assert.equal(totals.discount, expectedDiscount);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, totals.subtotal - expectedDiscount);
+});
+
