+test('invoiceTotals multiple lines with different bulk discount scenarios', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 2000, discountPercent: 0, vatRate: 21 },
+      { qty: 10, unitPrice: 2000, discountPercent: 10, vatRate: 21 },
+      { qty: 15, unitPrice: 2000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  const line1Subtotal = 10000;
+  const line1Discount = 0;
+  const line1BulkDiscount = 0;
+  const line1Amount = line1Subtotal - line1Discount - line1BulkDiscount;
+
+  const line2Subtotal = 20000;
+  const line2Discount = roundCents(line2Subtotal * 0.1);
+  const line2BulkDiscount = roundCents((line2Subtotal - line2Discount) * 0.025);
+  const line2Amount = line2Subtotal - line2Discount - line2BulkDiscount;
+
+  const line3Subtotal = 30000;
+  const line3Discount = 0;
+  const line3BulkDiscount = roundCents(line3Subtotal * 0.025);
+  const line3Amount = line3Subtotal - line3Discount - line3BulkDiscount;
+
+  const totalDiscount = line1Discount + line1BulkDiscount + line2Discount + line2BulkDiscount + line3Discount + line3BulkDiscount;
+  const totalVAT = roundCents(line1Amount * 0.21) + roundCents(line2Amount * 0.21) + roundCents(line3Amount * 0.21);
+  const expectedSubtotal = line1Subtotal + line2Subtotal + line3Subtotal;
+
+  assert.equal(totals.subtotal, expectedSubtotal);
+  assert.equal(totals.discount, totalDiscount);
+  assert.equal(totals.vat, totalVAT);
+  assert.equal(totals.total, expectedSubtotal - totalDiscount + totalVAT);
+});
