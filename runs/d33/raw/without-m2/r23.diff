+  const tierDiscount = roundCents(lineSubtotal * 0.05);
+  const amountAfterTierDiscount = lineSubtotal - tierDiscount;
+  const bulkDiscount = roundCents(amountAfterTierDiscount * 0.025);
+  assert.equal(totals.discount, tierDiscount + bulkDiscount);
+});
