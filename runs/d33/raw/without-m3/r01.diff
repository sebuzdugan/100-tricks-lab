--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,137 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates an invoice with enriched line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+  assert.equal(result.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[0].qty, 5);
+  assert.equal(result.value.lines[0].unitPrice, 8500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice supports multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[1].name, 'Icon set (24 icons)');
+});
+
+test('createInvoice reports unknown customer', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice validates issueDate format', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '10/07/2026',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-13-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects empty lines', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice validates qty is a positive integer', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports unknown SKU', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'NOPE', qty: 1 }],
+  }), { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const originalLines = JSON.stringify(lines);
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+
+  assert.equal(JSON.stringify(lines), originalLines);
+});
+
+test('createInvoice accepts various VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PRINT-A4', qty: 100 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 9);
+});
+
+test('createInvoice accepts VAT-exempt items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 0);
+});
