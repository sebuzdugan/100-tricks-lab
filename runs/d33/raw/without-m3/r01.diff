+++ b/src/invoices.js
@@ -0,0 +1,46 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+function isValidDate(dateStr) {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!m) return false;
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  return date instanceof Date && !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === dateStr;
+}
+
+/**
+ * Create an invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customer = getCustomer(customerId);
+  if (!customer.ok) return fail('CUSTOMER_NOT_FOUND');
+
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  const invoiceLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    const product = getProduct(line.sku);
+    if (!product.ok) return fail('UNKNOWN_SKU');
+
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.value.name,
+      qty: line.qty,
+      unitPrice: product.value.unitPrice,
+      vatRate: product.value.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
