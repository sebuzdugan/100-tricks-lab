+
+test('addLine adds a new line to an invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const newInvoice = addLine(result.value, { sku: 'DEV-HOUR', qty: 10 });
+  assert.equal(newInvoice.ok, true);
+  assert.equal(newInvoice.value.lines.length, 2);
+  assert.equal(newInvoice.value.lines[1].sku, 'DEV-HOUR');
+  assert.equal(newInvoice.value.lines[1].qty, 10);
+});
+
