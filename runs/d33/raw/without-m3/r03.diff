     lines: invoiceLines,
   });
 }
+
+/**
+ * Add a line to an invoice (or increase qty if the SKU already exists).
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {{ sku: string, qty: number }} line
+ */
+export function addLine(invoice, { sku, qty }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  const product = getProduct(sku);
+  if (!product.ok) return fail('UNKNOWN_SKU');
+
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+  const existingLine = newLines.find((line) => line.sku === sku);
+
+  if (existingLine) {
+    existingLine.qty += qty;
+  } else {
+    newLines.push({
+      sku,
+      name: product.value.name,
+      qty,
+      unitPrice: product.value.unitPrice,
+      vatRate: product.value.vatRate,
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {string} sku
+ */
+export function removeLine(invoice, sku) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  const newLines = invoice.lines.filter((line, index) => index !== lineIndex);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
