diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..41e611c
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,59 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for existing numbers', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber restarts counter for different years', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-9999', 'INV-2027-0001'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber finds max counter regardless of order', () => {
+  const numbers = ['INV-2026-0005', 'INV-2026-0002', 'INV-2026-0010', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber zero-pads to 4 digits', () => {
+  const numbers = [];
+  for (let i = 1; i <= 100; i++) {
+    numbers.push(`INV-2026-${String(i).padStart(4, '0')}`);
+  }
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0101');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const numbers = ['INV-2026-9999'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-abc', 'INV-2026-', 'INVALID'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber extracts year from issueDate', () => {
+  const numbers = ['INV-2025-0001'];
+  const number = nextInvoiceNumber(numbers, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
