--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,23 @@
+/**
+ * Get the next invoice number for a given issue date.
+ * Invoice numbers are INV-<year>-<counter> where counter is zero-padded to 4 digits.
+ * @param {string[]} existingNumbers - array of invoice numbers already used
+ * @param {string} issueDate - in YYYY-MM-DD format
+ * @returns {string} the next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `INV-${year}-`;
+
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.slice(prefix.length);
+      return Number(counter);
+    })
+    .filter((n) => Number.isInteger(n) && n > 0)
+    .sort((a, b) => a - b);
+
+  const nextCounter = thisYearNumbers.length > 0 ? thisYearNumbers[thisYearNumbers.length - 1] + 1 : 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
