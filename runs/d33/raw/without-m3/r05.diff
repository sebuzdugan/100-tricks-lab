+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number, vatRate: number }> }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customer = getCustomer(invoice.customerId);
+  const customerName = customer.ok ? customer.value.name : 'Unknown Customer';
+
+  const lines = [];
+
+  lines.push(invoice.number ?? 'DRAFT');
+  lines.push(customerName);
+
+  for (const line of invoice.lines) {
+    const unitPriceText = formatEuros(line.unitPrice);
+    const lineTotalText = formatEuros(lineTotal(line));
+    lines.push(`${line.qty} ${line.name} ${unitPriceText} ${lineTotalText}`);
+  }
+
+  const totals = invoiceTotals(invoice);
+  const totalText = formatEuros(totals.total);
+  lines.push(`Total: ${totalText}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..faa68e7
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,154 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText includes DRAFT for draft invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText includes invoice number for issued invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(result.value, []);
+  const text = renderInvoiceText(issued.value);
+  assert.ok(text.startsWith('INV-2026-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  assert.ok(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText includes line items with qty, name, unit price and total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  assert.ok(text.includes('5'));
+  assert.ok(text.includes('Design work (hour)'));
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€425.00'));
+});
+
+test('renderInvoiceText includes total line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  assert.ok(text.includes('Total: €425.00'));
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.ok(lines[2].includes('5'));
+  assert.ok(lines[2].includes('Design work (hour)'));
+  assert.ok(lines[3].includes('10'));
+  assert.ok(lines[3].includes('Development (hour)'));
+  assert.ok(lines[4].startsWith('Total:'));
+});
+
+test('renderInvoiceText formats amounts in euros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  assert.ok(text.includes('€1,200.00'));
+});
+
+test('renderInvoiceText calculates correct line totals', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+  // 8 * 9500 = 76000 cents = €760.00
+  assert.ok(text.includes('€760.00'));
+});
+
+test('renderInvoiceText calculates correct total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'ICON-SET', qty: 10 },
+    ],
+  });
+
+  const text = renderInvoiceText(result.value);
+  // 5 * 8500 + 10 * 980 = 42500 + 9800 = 52300 cents = €523.00
+  assert.ok(text.includes('Total: €523.00'));
+});
+
+test('renderInvoiceText works with various products', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 2 },
+    ],
+  });
+
+  const text = renderInvoiceText(result.value);
+  assert.ok(text.includes('Blue Fern Bakery'));
+  assert.ok(text.includes('Printed flyer A4 (each)'));
+  assert.ok(text.includes('Brand workshop (day, VAT exempt)'));
+});
+
+test('renderInvoiceText is multiline text', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // header + customer + 2 items + total
+});
