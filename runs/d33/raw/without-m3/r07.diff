+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount (2.5%) when not specified', () => {
+  // C-003 is Kite & Co with silver tier
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount (0%) when not specified', () => {
+  // C-002 is Blue Fern Bakery with standard tier
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice explicit discountPercent overrides tier discount', () => {
+  // C-001 is gold tier (5%), but explicit 10% should override
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice explicit discountPercent of 0 overrides tier discount', () => {
+  // C-001 is gold tier (5%), but explicit 0% should override
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice applies tier discount to multiple lines', () => {
+  // C-003 is silver tier (2.5%)
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+  assert.equal(result.value.lines[1].discountPercent, 2.5);
+});
+
+test('createInvoice mixed tier and explicit discounts', () => {
+  // C-001 is gold tier (5%)
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 }, // Should get tier discount
+      { sku: 'DEV-HOUR', qty: 10, discountPercent: 8 }, // Explicit discount
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+  assert.equal(result.value.lines[1].discountPercent, 8);
+});
+
+test('invoiceTotals with tier discount applied', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 5 }, // 42500 * 5 / 100 = 2125
+      { qty: 10, unitPrice: 9500, discountPercent: 5 }, // 95000 * 5 / 100 = 4750
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal = 42500 + 95000 = 137500
+  // Discount = 2125 + 4750 = 6875
+  // Total = 137500 - 6875 = 130625
+  assert.equal(totals.subtotal, 137500);
+  assert.equal(totals.discount, 6875);
+  assert.equal(totals.total, 130625);
+});
