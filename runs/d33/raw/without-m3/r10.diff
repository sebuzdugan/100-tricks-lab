diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..f08ab0b
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,103 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('10/07/2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026-10-07 '), false);
+  assert.equal(isValidDate(' 2026-10-07'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-01-00'), false);
+  assert.equal(isValidDate('2026-01-32'), false);
+});
+
+test('isValidDate rejects leap year edge cases correctly', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // 2024 is a leap year
+  assert.equal(isValidDate('2025-02-29'), false); // 2025 is not a leap year
+  assert.equal(isValidDate('2000-02-29'), true); // 2000 is a leap year
+  assert.equal(isValidDate('1900-02-29'), false); // 1900 is not a leap year
+});
+
+test('addDays adds days correctly', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+});
+
+test('addDays throws on invalid date', () => {
+  assert.throws(() => addDays('2026-02-30', 1), /Invalid date format/);
+  assert.throws(() => addDays('invalid', 1), /Invalid date format/);
+});
+
+test('daysBetween calculates days correctly', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles negative differences', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is a leap year
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365); // 2025 is not a leap year
+});
+
+test('daysBetween throws on invalid dates', () => {
+  assert.throws(() => daysBetween('2026-02-30', '2026-10-07'), /Invalid date format/);
+  assert.throws(() => daysBetween('2026-10-07', 'invalid'), /Invalid date format/);
+  assert.throws(() => daysBetween('invalid', 'invalid'), /Invalid date format/);
+});
+
+test('date functions work in UTC regardless of local timezone', () => {
+  // These tests verify that operations are done in UTC by checking
+  // specific date calculations that would differ in other timezones
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+});
