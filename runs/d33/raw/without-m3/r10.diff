+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(text);
+  if (!m) return false;
+  const date = new Date(`${text}T00:00:00Z`);
+  return date instanceof Date && !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === text;
+}
+
+/**
+ * Add days to a date string, working in UTC.
+ * @param {string} date - YYYY-MM-DD format
+ * @param {number} n - number of days to add
+ * @returns {string} - YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  if (!isValidDate(date)) throw new Error('Invalid date format');
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().slice(0, 10);
+}
+
+/**
+ * Calculate the number of days between two dates (b - a), in whole days, using UTC.
+ * @param {string} a - YYYY-MM-DD format (start date)
+ * @param {string} b - YYYY-MM-DD format (end date)
+ * @returns {number} - whole days between a and b
+ */
+export function daysBetween(a, b) {
+  if (!isValidDate(a) || !isValidDate(b)) throw new Error('Invalid date format');
+  const dateA = new Date(`${a}T00:00:00Z`);
+  const dateB = new Date(`${b}T00:00:00Z`);
+  return Math.floor((dateB - dateA) / (1000 * 60 * 60 * 24));
+}
