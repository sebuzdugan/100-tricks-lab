diff --git a/src/payments.js b/src/payments.js
new file mode 100644
index 0000000..86864a3
--- /dev/null
+++ b/src/payments.js
@@ -0,0 +1,45 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ lines: Array, payments?: Array<{ amount: number }> }} invoice
+ * @returns {number} balance due in cents
+ */
+export function balanceDue(invoice) {
+  const { total } = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments || []).reduce((sum, payment) => sum + payment.amount, 0);
+  return Math.max(0, total - totalPaid);
+}
+
+/**
+ * Record a payment on an issued invoice.
+ * @param {{ status: string, lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: boolean, value?: object, error?: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const due = balanceDue(invoice);
+  if (amount > due) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = [...(invoice.payments || []), { amount, date }];
+  const { total } = invoiceTotals(invoice);
+  const totalPaid = newPayments.reduce((sum, p) => sum + p.amount, 0);
+  const newStatus = totalPaid >= total ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
index 0000000..d0b4e3b
--- /dev/null
+++ b/test/payments.test.js
@@ -0,0 +1,191 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+function createTestInvoice({ status = 'issued', lines = [], total = 10000, payments = [] } = {}) {
+  return {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status,
+    number: 'INV-2026-0001',
+    lines,
+    payments,
+  };
+}
+
+function createSimpleInvoice(total = 10000) {
+  return {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 1, unitPrice: total, vatRate: 0, discountPercent: 0 },
+    ],
+    payments: [],
+  };
+}
+
+test('balanceDue returns full total when no payments', () => {
+  const inv = createSimpleInvoice(10000);
+  assert.equal(balanceDue(inv), 10000);
+});
+
+test('balanceDue returns remaining after one payment', () => {
+  const inv = createSimpleInvoice(10000);
+  inv.payments = [{ amount: 3000, date: '2026-10-07' }];
+  assert.equal(balanceDue(inv), 7000);
+});
+
+test('balanceDue returns 0 when fully paid', () => {
+  const inv = createSimpleInvoice(10000);
+  inv.payments = [{ amount: 10000, date: '2026-10-07' }];
+  assert.equal(balanceDue(inv), 0);
+});
+
+test('balanceDue returns 0 when overpaid (clamped)', () => {
+  const inv = createSimpleInvoice(10000);
+  inv.payments = [{ amount: 15000, date: '2026-10-07' }];
+  assert.equal(balanceDue(inv), 0);
+});
+
+test('balanceDue with multiple payments', () => {
+  const inv = createSimpleInvoice(10000);
+  inv.payments = [
+    { amount: 3000, date: '2026-10-07' },
+    { amount: 2000, date: '2026-10-08' },
+  ];
+  assert.equal(balanceDue(inv), 5000);
+});
+
+test('recordPayment fails on draft invoice', () => {
+  const inv = createTestInvoice({ status: 'draft' });
+  const r = recordPayment(inv, { amount: 5000, date: '2026-10-07' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_ISSUED');
+});
+
+test('recordPayment fails on paid invoice', () => {
+  const inv = createTestInvoice({ status: 'paid' });
+  const r = recordPayment(inv, { amount: 5000, date: '2026-10-07' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_ISSUED');
+});
+
+test('recordPayment fails on non-integer amount', () => {
+  const inv = createSimpleInvoice(10000);
+  const r = recordPayment(inv, { amount: 5000.5, date: '2026-10-07' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment fails on negative amount', () => {
+  const inv = createSimpleInvoice(10000);
+  const r = recordPayment(inv, { amount: -5000, date: '2026-10-07' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment fails on zero amount', () => {
+  const inv = createSimpleInvoice(10000);
+  const r = recordPayment(inv, { amount: 0, date: '2026-10-07' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment fails on overpayment', () => {
+  const inv = createSimpleInvoice(10000);
+  const r = recordPayment(inv, { amount: 10001, date: '2026-10-07' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'OVERPAYMENT');
+});
+
+test('recordPayment succeeds on issued invoice', () => {
+  const inv = createSimpleInvoice(10000);
+  const r = recordPayment(inv, { amount: 5000, date: '2026-10-07' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment changes status from issued to partially_paid', () => {
+  const inv = createSimpleInvoice(10000);
+  const r = recordPayment(inv, { amount: 5000, date: '2026-10-07' });
+  assert.equal(r.value.status, 'partially_paid');
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 5000);
+});
+
+test('recordPayment changes status to paid when fully paid', () => {
+  const inv = createSimpleInvoice(10000);
+  const r = recordPayment(inv, { amount: 10000, date: '2026-10-07' });
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment stays partially_paid for additional partial payments', () => {
+  const inv = createSimpleInvoice(10000);
+  const r1 = recordPayment(inv, { amount: 3000, date: '2026-10-07' });
+  assert.equal(r1.value.status, 'partially_paid');
+
+  const r2 = recordPayment(r1.value, { amount: 2000, date: '2026-10-08' });
+  assert.equal(r2.value.status, 'partially_paid');
+  assert.equal(balanceDue(r2.value), 5000);
+});
+
+test('recordPayment accumulates multiple payments', () => {
+  const inv = createSimpleInvoice(10000);
+  const r1 = recordPayment(inv, { amount: 3000, date: '2026-10-07' });
+  const r2 = recordPayment(r1.value, { amount: 4000, date: '2026-10-08' });
+  const r3 = recordPayment(r2.value, { amount: 3000, date: '2026-10-09' });
+
+  assert.equal(r3.value.payments.length, 3);
+  assert.equal(r3.value.status, 'paid');
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const inv = createSimpleInvoice(10000);
+  delete inv.payments;
+  const r = recordPayment(inv, { amount: 5000, date: '2026-10-07' });
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 5000);
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const inv = createSimpleInvoice(10000);
+  const original = { ...inv, payments: [...inv.payments] };
+  recordPayment(inv, { amount: 5000, date: '2026-10-07' });
+  assert.deepEqual(inv, original);
+});
+
+test('recordPayment stores payment date', () => {
+  const inv = createSimpleInvoice(10000);
+  const r = recordPayment(inv, { amount: 5000, date: '2026-10-09' });
+  assert.equal(r.value.payments[0].date, '2026-10-09');
+});
+
+test('recordPayment on partially_paid invoice can reach paid status', () => {
+  const inv = createSimpleInvoice(10000);
+  const r1 = recordPayment(inv, { amount: 6000, date: '2026-10-07' });
+  assert.equal(r1.value.status, 'partially_paid');
+
+  const r2 = recordPayment(r1.value, { amount: 4000, date: '2026-10-08' });
+  assert.equal(r2.value.status, 'paid');
+});
+
+test('recordPayment with complex invoice (with discount and VAT)', () => {
+  const inv = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [
+      { sku: 'WIDGET', name: 'Widget', qty: 2, unitPrice: 1000, vatRate: 10, discountPercent: 5 },
+    ],
+    payments: [],
+  };
+
+  // Total should be: (2 * 1000) - discount + VAT
+  // = 2000 - 100 + 190.5 (rounded) ≈ 2090
+  const due = balanceDue(inv);
+  const r = recordPayment(inv, { amount: due, date: '2026-10-07' });
+  assert.equal(r.value.status, 'paid');
+});
