diff --git a/test/terms.test.js b/test/terms.test.js
new file mode 100644
index 0000000..5b02581
--- /dev/null
+++ b/test/terms.test.js
@@ -0,0 +1,196 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, addLine, removeLine, issueInvoice } from '../src/invoices.js';
+
+function createValidInvoiceInput(overrides = {}) {
+  return {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    ...overrides,
+  };
+}
+
+test('createInvoice defaults to NET30 terms', () => {
+  const r = createInvoice(createValidInvoiceInput());
+  assert.equal(r.value.terms, 'NET30');
+  assert.equal(r.value.dueDate, '2026-11-06');
+});
+
+test('createInvoice accepts NET14 terms', () => {
+  const r = createInvoice(createValidInvoiceInput({ terms: 'NET14' }));
+  assert.equal(r.value.terms, 'NET14');
+  assert.equal(r.value.dueDate, '2026-10-21');
+});
+
+test('createInvoice accepts NET30 terms explicitly', () => {
+  const r = createInvoice(createValidInvoiceInput({ terms: 'NET30' }));
+  assert.equal(r.value.terms, 'NET30');
+  assert.equal(r.value.dueDate, '2026-11-06');
+});
+
+test('createInvoice accepts EOM terms', () => {
+  const r = createInvoice(createValidInvoiceInput({ terms: 'EOM' }));
+  assert.equal(r.value.terms, 'EOM');
+  assert.equal(r.value.dueDate, '2026-10-31');
+});
+
+test('createInvoice rejects unknown terms', () => {
+  const r = createInvoice(createValidInvoiceInput({ terms: 'NET45' }));
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'TERMS_INVALID');
+});
+
+test('createInvoice rejects invalid terms type', () => {
+  const r = createInvoice(createValidInvoiceInput({ terms: 'net30' }));
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'TERMS_INVALID');
+});
+
+test('NET14 due date calculation', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-01-15',
+    terms: 'NET14',
+  }));
+  assert.equal(r.value.dueDate, '2026-01-29');
+});
+
+test('NET30 due date calculation', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-01-15',
+    terms: 'NET30',
+  }));
+  assert.equal(r.value.dueDate, '2026-02-14');
+});
+
+test('EOM due date on first of month', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-10-01',
+    terms: 'EOM',
+  }));
+  assert.equal(r.value.dueDate, '2026-10-31');
+});
+
+test('EOM due date on last of month', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-10-31',
+    terms: 'EOM',
+  }));
+  assert.equal(r.value.dueDate, '2026-10-31');
+});
+
+test('EOM due date in February non-leap year', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2025-02-14',
+    terms: 'EOM',
+  }));
+  assert.equal(r.value.dueDate, '2025-02-28');
+});
+
+test('EOM due date in February leap year', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2024-02-14',
+    terms: 'EOM',
+  }));
+  assert.equal(r.value.dueDate, '2024-02-29');
+});
+
+test('EOM due date in month with 30 days', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-04-15',
+    terms: 'EOM',
+  }));
+  assert.equal(r.value.dueDate, '2026-04-30');
+});
+
+test('EOM due date in month with 31 days', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-05-15',
+    terms: 'EOM',
+  }));
+  assert.equal(r.value.dueDate, '2026-05-31');
+});
+
+test('NET14 crosses month boundary', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-10-25',
+    terms: 'NET14',
+  }));
+  assert.equal(r.value.dueDate, '2026-11-08');
+});
+
+test('NET30 crosses month boundary', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-10-15',
+    terms: 'NET30',
+  }));
+  assert.equal(r.value.dueDate, '2026-11-14');
+});
+
+test('NET30 crosses year boundary', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-12-15',
+    terms: 'NET30',
+  }));
+  assert.equal(r.value.dueDate, '2027-01-14');
+});
+
+test('NET14 crosses year boundary', () => {
+  const r = createInvoice(createValidInvoiceInput({
+    issueDate: '2026-12-25',
+    terms: 'NET14',
+  }));
+  assert.equal(r.value.dueDate, '2027-01-08');
+});
+
+test('addLine preserves terms and dueDate', () => {
+  const inv = createInvoice(createValidInvoiceInput({ terms: 'NET14' })).value;
+  const r = addLine(inv, { sku: 'BRAND-BOOK', qty: 2 });
+  assert.equal(r.value.terms, 'NET14');
+  assert.equal(r.value.dueDate, '2026-10-21');
+});
+
+test('removeLine preserves terms and dueDate', () => {
+  const inv = createInvoice(createValidInvoiceInput({
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+    terms: 'EOM',
+  })).value;
+  const r = removeLine(inv, 'BRAND-BOOK');
+  assert.equal(r.value.terms, 'EOM');
+  assert.equal(r.value.dueDate, '2026-10-31');
+});
+
+test('issueInvoice preserves terms and dueDate', () => {
+  const inv = createInvoice(createValidInvoiceInput({ terms: 'NET14' })).value;
+  const r = issueInvoice(inv, []);
+  assert.equal(r.value.terms, 'NET14');
+  assert.equal(r.value.dueDate, '2026-10-21');
+  assert.equal(r.value.status, 'issued');
+});
+
+test('terms and dueDate set in draft status', () => {
+  const r = createInvoice(createValidInvoiceInput({ terms: 'NET14' }));
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.terms, 'NET14');
+  assert.equal(r.value.dueDate, '2026-10-21');
+});
+
+test('multiple invoices can have different terms', () => {
+  const r1 = createInvoice(createValidInvoiceInput({ terms: 'NET14' }));
+  const r2 = createInvoice(createValidInvoiceInput({ terms: 'NET30' }));
+  const r3 = createInvoice(createValidInvoiceInput({ terms: 'EOM' }));
+
+  assert.equal(r1.value.dueDate, '2026-10-21');
+  assert.equal(r2.value.dueDate, '2026-11-06');
+  assert.equal(r3.value.dueDate, '2026-10-31');
+});
+
+test('terms do not mutate input', () => {
+  const input = createValidInvoiceInput({ terms: 'NET14' });
+  const original = { ...input };
+  createInvoice(input);
+  assert.deepEqual(input, original);
+});
