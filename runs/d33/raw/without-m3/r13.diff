+
+/**
+ * Apply a voucher to an invoice (draft only, one per invoice).
+ * @param {{ status: string, voucher?: object, lines: Array }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
diff --git a/test/vouchers.test.js b/test/vouchers.test.js
new file mode 100644
index 0000000..be546ce
--- /dev/null
+++ b/test/vouchers.test.js
@@ -0,0 +1,216 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, applyVoucher, invoiceTotals, addLine, removeLine, issueInvoice } from '../src/invoices.js';
+
+function createValidInvoiceInput(overrides = {}) {
+  return {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    ...overrides,
+  };
+}
+
+test('applyVoucher adds voucher to draft invoice', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const r = applyVoucher(inv, { code: 'SUMMER20', amount: 5000 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher.code, 'SUMMER20');
+  assert.equal(r.value.voucher.amount, 5000);
+});
+
+test('applyVoucher fails on issued invoice', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const issued = issueInvoice(inv, []).value;
+  const r = applyVoucher(issued, { code: 'SUMMER20', amount: 5000 });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_DRAFT');
+});
+
+test('applyVoucher fails on paid invoice', () => {
+  const inv = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'paid',
+    lines: [{ sku: 'LOGO-PACK', name: 'Logo Pack', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }],
+  };
+  const r = applyVoucher(inv, { code: 'SUMMER20', amount: 5000 });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_DRAFT');
+});
+
+test('applyVoucher fails when voucher already exists', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const r1 = applyVoucher(inv, { code: 'SUMMER20', amount: 5000 });
+  const r2 = applyVoucher(r1.value, { code: 'FALL30', amount: 3000 });
+  assert.equal(r2.ok, false);
+  assert.equal(r2.error, 'VOUCHER_EXISTS');
+});
+
+test('applyVoucher fails on non-integer amount', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const r = applyVoucher(inv, { code: 'SUMMER20', amount: 5000.5 });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('applyVoucher fails on negative amount', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const r = applyVoucher(inv, { code: 'SUMMER20', amount: -5000 });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('applyVoucher fails on zero amount', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const r = applyVoucher(inv, { code: 'SUMMER20', amount: 0 });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('applyVoucher does not mutate original invoice', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const original = { ...inv };
+  applyVoucher(inv, { code: 'SUMMER20', amount: 5000 });
+  assert.deepEqual(inv, original);
+  assert.equal(inv.voucher, undefined);
+});
+
+test('invoiceTotals includes voucher amount of 0 when no voucher', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const totals = invoiceTotals(inv);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals includes voucher amount when applied', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const withVoucher = applyVoucher(inv, { code: 'SUMMER20', amount: 5000 }).value;
+  const totals = invoiceTotals(withVoucher);
+  assert.equal(totals.voucher, 5000);
+});
+
+test('invoiceTotals calculates total = subtotal - discount + vat - voucher', () => {
+  const inv = createInvoice(createValidInvoiceInput({
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }], // qty 2 doubles the subtotal
+  })).value;
+  const beforeVoucher = invoiceTotals(inv);
+  const withVoucher = applyVoucher(inv, { code: 'SUMMER20', amount: 5000 }).value;
+  const afterVoucher = invoiceTotals(withVoucher);
+
+  assert.equal(afterVoucher.total, beforeVoucher.total - 5000);
+});
+
+test('invoiceTotals clamps total to 0 when voucher exceeds subtotal - discount + vat', () => {
+  const inv = createInvoice(createValidInvoiceInput({
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  })).value;
+  const beforeVoucher = invoiceTotals(inv);
+  const withVoucher = applyVoucher(inv, { code: 'SUMMER20', amount: beforeVoucher.total + 10000 }).value;
+  const afterVoucher = invoiceTotals(withVoucher);
+
+  assert.equal(afterVoucher.total, 0);
+});
+
+test('addLine preserves voucher', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const withVoucher = applyVoucher(inv, { code: 'SUMMER20', amount: 5000 }).value;
+  const r = addLine(withVoucher, { sku: 'BRAND-BOOK', qty: 1 });
+
+  assert.equal(r.value.voucher.code, 'SUMMER20');
+  assert.equal(r.value.voucher.amount, 5000);
+});
+
+test('removeLine preserves voucher', () => {
+  const inv = createInvoice(createValidInvoiceInput({
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  })).value;
+  const withVoucher = applyVoucher(inv, { code: 'SUMMER20', amount: 5000 }).value;
+  const r = removeLine(withVoucher, 'BRAND-BOOK');
+
+  assert.equal(r.value.voucher.code, 'SUMMER20');
+  assert.equal(r.value.voucher.amount, 5000);
+});
+
+test('issueInvoice preserves voucher', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const withVoucher = applyVoucher(inv, { code: 'SUMMER20', amount: 5000 }).value;
+  const r = issueInvoice(withVoucher, []);
+
+  assert.equal(r.value.voucher.code, 'SUMMER20');
+  assert.equal(r.value.voucher.amount, 5000);
+});
+
+test('voucher is applied after discount and VAT', () => {
+  const inv = createInvoice(createValidInvoiceInput({
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  })).value;
+  const withVoucher = applyVoucher(inv, { code: 'SUMMER20', amount: 1000 }).value;
+
+  const totals = invoiceTotals(withVoucher);
+  // Verify order: subtotal - discount + vat - voucher
+  const { subtotal, discount, vat, voucher, total } = totals;
+  const calculatedTotal = Math.max(0, subtotal - discount + vat - voucher);
+
+  assert.equal(total, calculatedTotal);
+});
+
+test('voucher reduces invoice total linearly', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const totalsWithout = invoiceTotals(inv);
+
+  const withVoucher = applyVoucher(inv, { code: 'VOUCHER', amount: 1000 }).value;
+  const totalsWith = invoiceTotals(withVoucher);
+
+  assert.equal(totalsWith.total, totalsWithout.total - 1000);
+});
+
+test('multiple invoices can have different vouchers', () => {
+  const inv1 = createInvoice(createValidInvoiceInput()).value;
+  const inv2 = createInvoice(createValidInvoiceInput()).value;
+
+  const v1 = applyVoucher(inv1, { code: 'SUMMER20', amount: 5000 }).value;
+  const v2 = applyVoucher(inv2, { code: 'FALL30', amount: 3000 }).value;
+
+  assert.equal(v1.voucher.code, 'SUMMER20');
+  assert.equal(v2.voucher.code, 'FALL30');
+});
+
+test('voucher with large amount', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const r = applyVoucher(inv, { code: 'MEGA', amount: 999999999 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher.amount, 999999999);
+});
+
+test('voucher totals structure after application', () => {
+  const inv = createInvoice(createValidInvoiceInput()).value;
+  const withVoucher = applyVoucher(inv, { code: 'SUMMER20', amount: 2000 }).value;
+  const totals = invoiceTotals(withVoucher);
+
+  assert.equal(typeof totals.subtotal, 'number');
+  assert.equal(typeof totals.discount, 'number');
+  assert.equal(typeof totals.vat, 'number');
+  assert.equal(typeof totals.voucher, 'number');
+  assert.equal(typeof totals.total, 'number');
+});
+
+test('voucher with complex invoice (multiple lines, discount, VAT)', () => {
+  const inv = createInvoice(createValidInvoiceInput({
+    lines: [
+      { sku: 'LOGO-PACK', qty: 2, discountPercent: 10 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  })).value;
+
+  const withVoucher = applyVoucher(inv, { code: 'SUMMER20', amount: 5000 }).value;
+  const totals = invoiceTotals(withVoucher);
+
+  assert.equal(totals.voucher, 5000);
+  assert.ok(totals.subtotal > 0);
+  assert.ok(totals.discount >= 0);
+  assert.ok(totals.vat >= 0);
+  assert.equal(totals.total, Math.max(0, totals.subtotal - totals.discount + totals.vat - 5000));
+});
