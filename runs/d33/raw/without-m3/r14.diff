+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { invoiceTotals } from '../src/invoices.js';
+import { balanceDue } from '../src/payments.js';
+
+function createInvoice({
+  customerId = 'C-002',
+  number = 'INV-2026-0001',
+  issueDate = '2026-10-07',
+  dueDate = '2026-11-06',
+  status = 'issued',
+  lines = [{ sku: 'LOGO-PACK', name: 'Logo Pack', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }],
+  payments = [],
+  voucher,
+} = {}) {
+  const invoice = {
+    customerId,
+    number,
+    issueDate,
+    dueDate,
+    status,
+    lines,
+    payments,
+  };
+  if (voucher !== undefined) {
+    invoice.voucher = voucher;
+  }
+  return invoice;
+}
+
+test('statement returns issued invoices for customer', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement returns partially_paid invoices', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'partially_paid', payments: [{ amount: 5000, date: '2026-10-07' }] }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement excludes draft invoices', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'draft' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'paid', payments: [{ amount: 10000, date: '2026-10-15' }] }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes invoices issued after asOf date', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', issueDate: '2026-11-07', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement includes invoices issued on asOf date', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', issueDate: '2026-10-31', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement filters by customerId', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-001', number: 'INV-2026-0001', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0002', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0002');
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoices = [];
+  const r = statement('C-999', invoices, '2026-10-31');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement returns DATE_INVALID for invalid asOf date', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31 ');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'DATE_INVALID');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0003', issueDate: '2026-10-20', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', issueDate: '2026-10-07', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0002', issueDate: '2026-10-15', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(r.value.invoices[1].number, 'INV-2026-0002');
+  assert.equal(r.value.invoices[2].number, 'INV-2026-0003');
+});
+
+test('statement includes correct invoice fields', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', issueDate: '2026-10-07', dueDate: '2026-11-06', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  const inv = r.value.invoices[0];
+
+  assert.equal(inv.number, 'INV-2026-0001');
+  assert.equal(inv.issueDate, '2026-10-07');
+  assert.equal(inv.dueDate, '2026-11-06');
+  assert.equal(typeof inv.total, 'number');
+  assert.equal(typeof inv.due, 'number');
+});
+
+test('statement total matches invoiceTotals', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  const expectedTotal = invoiceTotals(invoices[0]).total;
+
+  assert.equal(r.value.invoices[0].total, expectedTotal);
+});
+
+test('statement due matches balanceDue', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  const expectedDue = balanceDue(invoices[0]);
+
+  assert.equal(r.value.invoices[0].due, expectedDue);
+});
+
+test('statement due is less than total when invoice has payments', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'partially_paid', payments: [{ amount: 3000, date: '2026-10-15' }] }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+
+  assert.ok(r.value.invoices[0].due < r.value.invoices[0].total);
+  assert.equal(r.value.invoices[0].due, invoiceTotals(invoices[0]).total - 3000);
+});
+
+test('statement calculates totalDue as sum of due amounts', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', issueDate: '2026-10-07', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0002', issueDate: '2026-10-15', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+
+  const inv1Total = invoiceTotals(invoices[0]).total;
+  const inv2Total = invoiceTotals(invoices[1]).total;
+  const expectedTotalDue = inv1Total + inv2Total;
+
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.totalDue, expectedTotalDue);
+});
+
+test('statement returns empty invoices list when no matching invoices', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-001', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement with multiple invoices different statuses', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0002', status: 'partially_paid', payments: [{ amount: 5000, date: '2026-10-10' }] }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0003', status: 'paid', payments: [{ amount: 10000, date: '2026-10-20' }] }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0004', status: 'draft' }),
+  ];
+  const r = statement('C-002', invoices, '2026-10-31');
+
+  // Only issued and partially_paid should be included
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(r.value.invoices[1].number, 'INV-2026-0002');
+});
+
+test('statement with past dates', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', issueDate: '2026-01-01', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0002', issueDate: '2026-06-15', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0003', issueDate: '2026-10-07', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2026-06-30');
+
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].issueDate, '2026-01-01');
+  assert.equal(r.value.invoices[1].issueDate, '2026-06-15');
+});
+
+test('statement with complex invoice including discount and voucher', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [
+      { sku: 'LOGO-PACK', name: 'Logo Pack', qty: 2, unitPrice: 10000, vatRate: 10, discountPercent: 5 },
+    ],
+    voucher: { code: 'SUMMER20', amount: 2000 },
+  });
+  const r = statement('C-002', [invoice], '2026-10-31');
+
+  const expectedTotal = invoiceTotals(invoice).total;
+  assert.equal(r.value.invoices[0].total, expectedTotal);
+});
+
+test('statement does not mutate input invoices', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'issued' }),
+  ];
+  const original = JSON.parse(JSON.stringify(invoices[0]));
+  statement('C-002', invoices, '2026-10-31');
+  assert.deepEqual(invoices[0], original);
+});
+
+test('statement with normalized customerId', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', status: 'issued' }),
+  ];
+  // getCustomer normalizes the ID, so this should work
+  const r = statement('c-002', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement with year boundary dates', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', issueDate: '2025-12-31', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0002', issueDate: '2026-01-01', status: 'issued' }),
+  ];
+  const r = statement('C-002', invoices, '2025-12-31');
+
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2025-12-31');
+});
