+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate a customer statement.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array, voucher?: object }>} invoices
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {{ ok: boolean, value?: object, error?: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  const normalizedCustomerId = normalizeId(customerId);
+  const customer = getCustomer(normalizedCustomerId);
+  if (!customer.ok) return fail('CUSTOMER_NOT_FOUND');
+
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  const relevantInvoices = invoices
+    .filter((inv) => inv.customerId === normalizedCustomerId && (inv.status === 'issued' || inv.status === 'partially_paid') && inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate))
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }));
+
+  const totalDue = relevantInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: relevantInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
