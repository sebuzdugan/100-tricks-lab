   const nextCounter = thisYearNumbers.length > 0 ? thisYearNumbers[thisYearNumbers.length - 1] + 1 : 1;
   return `${prefix}${String(nextCounter).padStart(4, '0')}`;
 }
+
+/**
+ * Get the next credit note number for a given issue date.
+ * Credit note numbers are CN-<year>-<counter> where counter is zero-padded to 4 digits.
+ * @param {string[]} existingNumbers - array of invoice and credit note numbers already used
+ * @param {string} date - in YYYY-MM-DD format
+ * @returns {string} the next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.slice(0, 4);
+  const prefix = `CN-${year}-`;
+
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.slice(prefix.length);
+      return Number(counter);
+    })
+    .filter((n) => Number.isInteger(n) && n > 0)
+    .sort((a, b) => a - b);
+
+  const nextCounter = thisYearNumbers.length > 0 ? thisYearNumbers[thisYearNumbers.length - 1] + 1 : 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..64ad2cd
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,232 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+function createInvoice({
+  status = 'issued',
+  number = 'INV-2026-0001',
+  customerId = 'C-002',
+  lines = [{ sku: 'LOGO-PACK', name: 'Logo Pack', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }],
+  payments = [],
+  voucher = undefined,
+} = {}) {
+  const invoice = {
+    status,
+    number,
+    customerId,
+    lines,
+    payments,
+  };
+  if (voucher !== undefined) {
+    invoice.voucher = voucher;
+  }
+  return invoice;
+}
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Damaged goods', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r.value.customerId, 'C-002');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Damaged goods');
+  assert.equal(r.value.date, '2026-10-15');
+});
+
+test('createCreditNote creates credit note for partially_paid invoice', () => {
+  const inv = createInvoice({ status: 'partially_paid', payments: [{ amount: 3000, date: '2026-10-10' }] });
+  const r = createCreditNote(inv, { amount: 2000, reason: 'Partial refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote creates credit note for paid invoice', () => {
+  const inv = createInvoice({ status: 'paid', payments: [{ amount: 10000, date: '2026-10-15' }] });
+  const r = createCreditNote(inv, { amount: 1000, reason: 'Overpayment refund', date: '2026-10-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote fails on draft invoice', () => {
+  const inv = createInvoice({ status: 'draft' });
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote fails on non-integer amount', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const r = createCreditNote(inv, { amount: 5000.5, reason: 'Refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote fails on negative amount', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const r = createCreditNote(inv, { amount: -5000, reason: 'Refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote fails on zero amount', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const r = createCreditNote(inv, { amount: 0, reason: 'Refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote fails when amount exceeds invoice total', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const total = invoiceTotals(inv).total;
+  const r = createCreditNote(inv, { amount: total + 1, reason: 'Refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote accepts amount equal to invoice total', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const total = invoiceTotals(inv).total;
+  const r = createCreditNote(inv, { amount: total, reason: 'Full refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, total);
+});
+
+test('createCreditNote fails on invalid date', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Refund', date: '2026-10-15 ' }, []);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'DATE_INVALID');
+});
+
+test('createCreditNote increments credit note counter per year', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const r1 = createCreditNote(inv, { amount: 5000, reason: 'Refund 1', date: '2026-10-15' }, []);
+  const r2 = createCreditNote(inv, { amount: 3000, reason: 'Refund 2', date: '2026-10-16' }, [r1.value.number]);
+
+  assert.equal(r1.value.number, 'CN-2026-0001');
+  assert.equal(r2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote respects year boundaries in numbering', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const existingNumbers = ['CN-2025-0001', 'CN-2025-0002'];
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, existingNumbers);
+
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote handles existing invoice numbers in numbering', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001'];
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, existingNumbers);
+
+  assert.equal(r.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote zero-pads counter to 4 digits', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const existingNumbers = Array.from({ length: 9 }, (_, i) => `CN-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, existingNumbers);
+
+  assert.equal(r.value.number, 'CN-2026-0010');
+});
+
+test('createCreditNote with complex invoice (discount + VAT)', () => {
+  const inv = createInvoice({
+    status: 'issued',
+    lines: [
+      { sku: 'LOGO-PACK', name: 'Logo Pack', qty: 2, unitPrice: 10000, vatRate: 10, discountPercent: 5 },
+    ],
+  });
+
+  const total = invoiceTotals(inv).total;
+  const r = createCreditNote(inv, { amount: Math.floor(total / 2), reason: 'Partial refund', date: '2026-10-15' }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, Math.floor(total / 2));
+});
+
+test('createCreditNote with voucher applied', () => {
+  const inv = createInvoice({
+    status: 'issued',
+    voucher: { code: 'SUMMER20', amount: 2000 },
+  });
+
+  const total = invoiceTotals(inv).total;
+  const r = createCreditNote(inv, { amount: 1000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.equal(r.ok, true);
+  assert.ok(r.value.amount <= total);
+});
+
+test('createCreditNote with large amount', () => {
+  const inv = createInvoice({
+    status: 'issued',
+    lines: [
+      { sku: 'LOGO-PACK', name: 'Logo Pack', qty: 100, unitPrice: 100000, vatRate: 0, discountPercent: 0 },
+    ],
+  });
+
+  const r = createCreditNote(inv, { amount: 9999999, reason: 'Large refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, 9999999);
+});
+
+test('createCreditNote stores correct invoiceNumber', () => {
+  const inv = createInvoice({ status: 'issued', number: 'INV-2026-0042' });
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.equal(r.value.invoiceNumber, 'INV-2026-0042');
+});
+
+test('createCreditNote stores correct customerId', () => {
+  const inv = createInvoice({ status: 'issued', customerId: 'C-007' });
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.equal(r.value.customerId, 'C-007');
+});
+
+test('createCreditNote stores reason', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const reasons = [
+    'Damaged goods',
+    'Change of mind',
+    'Quality issue',
+    'Customer request',
+  ];
+
+  for (const reason of reasons) {
+    const r = createCreditNote(inv, { amount: 1000, reason, date: '2026-10-15' }, []);
+    assert.equal(r.value.reason, reason);
+  }
+});
+
+test('createCreditNote date is credit note issue date', () => {
+  const inv = createInvoice({ status: 'issued', issueDate: '2026-10-07' });
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Refund', date: '2026-10-20' }, []);
+
+  assert.equal(r.value.date, '2026-10-20');
+});
+
+test('createCreditNote does not mutate original invoice', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const original = JSON.parse(JSON.stringify(inv));
+  createCreditNote(inv, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, []);
+
+  assert.deepEqual(inv, original);
+});
+
+test('createCreditNote with multiple credit notes for same invoice', () => {
+  const inv = createInvoice({ status: 'issued' });
+  const total = invoiceTotals(inv).total;
+
+  const r1 = createCreditNote(inv, { amount: Math.floor(total / 3), reason: 'Refund 1', date: '2026-10-15' }, []);
+  const r2 = createCreditNote(inv, { amount: Math.floor(total / 3), reason: 'Refund 2', date: '2026-10-16' }, [r1.value.number]);
+
+  assert.equal(r1.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r2.value.invoiceNumber, 'INV-2026-0001');
+  assert.notEqual(r1.value.number, r2.value.number);
+});
