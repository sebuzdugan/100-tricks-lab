+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { balanceDue } from '../src/payments.js';
+
+function createInvoice({
+  customerId = 'C-002',
+  number = 'INV-2026-0001',
+  dueDate = '2026-10-15',
+  status = 'issued',
+  lines = [{ sku: 'LOGO-PACK', name: 'Logo Pack', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }],
+  payments = [],
+  voucher,
+} = {}) {
+  const invoice = {
+    customerId,
+    number,
+    dueDate,
+    status,
+    lines,
+    payments,
+  };
+  if (voucher !== undefined) {
+    invoice.voucher = voucher;
+  }
+  return invoice;
+}
+
+test('overdueInvoices returns issued invoices with dueDate before asOf', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 1);
+  assert.equal(r.value[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices returns partially_paid invoices with dueDate before asOf', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'partially_paid', payments: [{ amount: 5000, date: '2026-10-12' }] }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 1);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'draft' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'paid', payments: [{ amount: 10000, date: '2026-10-12' }] }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 0);
+});
+
+test('overdueInvoices excludes invoices with dueDate equal to asOf', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-15', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 0);
+});
+
+test('overdueInvoices excludes invoices with dueDate after asOf', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-20', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 0);
+});
+
+test('overdueInvoices returns DATE_INVALID for invalid asOf', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15 ');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'DATE_INVALID');
+});
+
+test('overdueInvoices includes correct fields', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  const invoice = r.value[0];
+
+  assert.equal(typeof invoice.number, 'string');
+  assert.equal(typeof invoice.customerId, 'string');
+  assert.equal(typeof invoice.dueDate, 'string');
+  assert.equal(typeof invoice.daysOverdue, 'number');
+  assert.equal(typeof invoice.due, 'number');
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+
+  // From 2026-10-10 to 2026-10-15 is 5 days
+  assert.equal(r.value[0].daysOverdue, 5);
+});
+
+test('overdueInvoices calculates due from balanceDue', () => {
+  const inv = createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'issued' });
+  const invoices = [inv];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  const expectedDue = balanceDue(inv);
+
+  assert.equal(r.value[0].due, expectedDue);
+});
+
+test('overdueInvoices sorts by daysOverdue descending (most overdue first)', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-13', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0002', dueDate: '2026-10-10', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0003', dueDate: '2026-10-05', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+
+  assert.equal(r.value[0].number, 'INV-2026-0003');
+  assert.equal(r.value[0].daysOverdue, 10);
+  assert.equal(r.value[1].number, 'INV-2026-0002');
+  assert.equal(r.value[1].daysOverdue, 5);
+  assert.equal(r.value[2].number, 'INV-2026-0001');
+  assert.equal(r.value[2].daysOverdue, 2);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-20', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 0);
+});
+
+test('overdueInvoices with invoice having payments', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'partially_paid', payments: [{ amount: 5000, date: '2026-10-12' }] }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+  const expectedDue = 10000 - 5000;
+
+  assert.equal(r.value[0].due, expectedDue);
+});
+
+test('overdueInvoices with complex invoice including discount and VAT', () => {
+  const invoices = [
+    createInvoice({
+      customerId: 'C-002',
+      number: 'INV-2026-0001',
+      dueDate: '2026-10-10',
+      status: 'issued',
+      lines: [
+        { sku: 'LOGO-PACK', name: 'Logo Pack', qty: 2, unitPrice: 10000, vatRate: 10, discountPercent: 5 },
+      ],
+    }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value[0].daysOverdue, 5);
+  assert.equal(typeof r.value[0].due, 'number');
+});
+
+test('overdueInvoices with voucher applied', () => {
+  const invoices = [
+    createInvoice({
+      customerId: 'C-002',
+      number: 'INV-2026-0001',
+      dueDate: '2026-10-10',
+      status: 'issued',
+      voucher: { code: 'SUMMER20', amount: 2000 },
+    }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 1);
+  assert.equal(r.value[0].daysOverdue, 5);
+});
+
+test('overdueInvoices with mixed statuses', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0002', dueDate: '2026-10-10', status: 'partially_paid', payments: [{ amount: 3000, date: '2026-10-12' }] }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0003', dueDate: '2026-10-10', status: 'paid', payments: [{ amount: 10000, date: '2026-10-12' }] }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0004', dueDate: '2026-10-10', status: 'draft' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+
+  assert.equal(r.value.length, 2);
+  assert.equal(r.value[0].number, 'INV-2026-0001');
+  assert.equal(r.value[1].number, 'INV-2026-0002');
+});
+
+test('overdueInvoices does not mutate input invoices', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'issued' }),
+  ];
+  const original = JSON.parse(JSON.stringify(invoices[0]));
+  overdueInvoices(invoices, '2026-10-15');
+
+  assert.deepEqual(invoices[0], original);
+});
+
+test('overdueInvoices with different customers', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-001', number: 'INV-2026-0001', dueDate: '2026-10-10', status: 'issued' }),
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0002', dueDate: '2026-10-10', status: 'issued' }),
+    createInvoice({ customerId: 'C-003', number: 'INV-2026-0003', dueDate: '2026-10-10', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+
+  assert.equal(r.value.length, 3);
+  assert.ok(r.value.some((inv) => inv.customerId === 'C-001'));
+  assert.ok(r.value.some((inv) => inv.customerId === 'C-002'));
+  assert.ok(r.value.some((inv) => inv.customerId === 'C-003'));
+});
+
+test('overdueInvoices with large daysOverdue value', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2025-01-01', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+
+  assert.equal(r.ok, true);
+  assert.ok(r.value[0].daysOverdue > 280);
+});
+
+test('overdueInvoices with single day overdue', () => {
+  const invoices = [
+    createInvoice({ customerId: 'C-002', number: 'INV-2026-0001', dueDate: '2026-10-14', status: 'issued' }),
+  ];
+  const r = overdueInvoices(invoices, '2026-10-15');
+
+  assert.equal(r.value[0].daysOverdue, 1);
+});
