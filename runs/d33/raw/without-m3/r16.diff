+import { ok, fail } from './result.js';
+import { balanceDue } from './payments.js';
+import { isValidDate, daysBetween } from './dates.js';
+
+/**
+ * Get invoices that are overdue.
+ * @param {Array} invoices
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {{ ok: boolean, value?: Array, error?: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  const overdue = invoices
+    .filter((inv) => (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return ok(overdue);
+}
