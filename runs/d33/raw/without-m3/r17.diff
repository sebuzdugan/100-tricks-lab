@@ -24,3 +25,37 @@ export function overdueInvoices(invoices, asOf) {
 
   return ok(overdue);
 }
+
+/**
+ * Get VAT summary across invoices.
+ * @param {Array} invoices
+ * @returns {{ ok: boolean, value?: Array }}
+ */
+export function vatSummary(invoices) {
+  const rates = new Map();
+
+  const eligibleInvoices = invoices.filter(
+    (inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid'
+  );
+
+  for (const invoice of eligibleInvoices) {
+    for (const line of invoice.lines) {
+      const lineTotal = line.qty * line.unitPrice;
+      const lineDiscount = roundCents(lineTotal * line.discountPercent / 100);
+      const lineBase = lineTotal - lineDiscount;
+      const lineVat = roundCents(lineBase * line.vatRate / 100);
+
+      const rate = line.vatRate;
+      if (!rates.has(rate)) {
+        rates.set(rate, { base: 0, vat: 0 });
+      }
+      const current = rates.get(rate);
+      rates.set(rate, { base: current.base + lineBase, vat: current.vat + lineVat });
+    }
+  }
+
+  const result = Array.from(rates, ([rate, { base, vat }]) => ({ rate, base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return ok(result);
+}
