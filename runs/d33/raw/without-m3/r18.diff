+/**
+ * Calculate late fee for an invoice.
+ * Late fee is 0.04% of the balance due per day overdue.
+ * @param {{ status: string, dueDate: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {{ ok: boolean, value?: number, error?: string }}
+ */
+export function lateFee(invoice, asOf) {
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  if (invoice.status === 'draft' || invoice.status === 'paid') {
+    return ok(0);
+  }
+
+  if (invoice.dueDate >= asOf) {
+    return ok(0);
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const feeAmount = roundCents(due * 0.0004 * daysOverdue);
+
+  return ok(feeAmount);
+}
