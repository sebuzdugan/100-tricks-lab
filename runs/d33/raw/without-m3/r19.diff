+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Escape a field for CSV: wrap in quotes if it contains comma or quote, and double any quotes inside.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCSV(field) {
+  if (typeof field !== 'string') {
+    field = String(field);
+  }
+
+  if (field.includes(',') || field.includes('"')) {
+    return '"' + field.replace(/"/g, '""') + '"';
+  }
+
+  return field;
+}
+
+/**
+ * Format cents as plain euros: 1234 -> "12.34"
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const rows = [];
+
+  rows.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  for (const invoice of invoices) {
+    const customer = getCustomer(invoice.customerId);
+    const customerName = customer.ok ? customer.value.name : 'Unknown Customer';
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const row = [
+      escapeCSV(invoice.number),
+      escapeCSV(customerName),
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    rows.push(row.join(','));
+  }
+
+  return rows.join('\n') + '\n';
+}
