+
+test('exportCsv with zero discount', () => {
+  const invoices = [createInvoice({ lines: [{ sku: 'LOGO-PACK', name: 'Logo Pack', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }] })];
+  const r = exportCsv(invoices);
+
+  assert.ok(r.includes('0.00'));
