+
+test('exportCsv field count matches header', () => {
+  const invoices = [createInvoice()];
+  const r = exportCsv(invoices);
+  const lines = r.split('\n');
+  const headerFields = lines[0].split(',');
+  const dataFields = lines[1].split(',');
+
+  assert.equal(dataFields.length, headerFields.length);
+});
+
+test('exportCsv with customer containing comma (hypothetical)', () => {
+  // We can't easily create a customer with a comma in the name, but we test the escaping
+  const invoices = [
+    {
+      number: 'INV-2026-0001',
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      dueDate: '2026-11-06',
+      status: 'issued',
+      lines: [{ sku: 'LOGO-PACK', name: 'Logo Pack', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }],
+    },
+  ];
+  const r = exportCsv(invoices);
+
+  assert.equal(typeof r, 'string');
