+
+test('exportCsv multiple invoices with different amounts', () => {
+  const invoices = [
+    createInvoice({ number: 'INV-2026-0001', lines: [{ sku: 'LOGO-PACK', name: 'Logo Pack', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }] }),
+    createInvoice({ number: 'INV-2026-0002', lines: [{ sku: 'LOGO-PACK', name: 'Logo Pack', qty: 2, unitPrice: 20000, vatRate: 0, discountPercent: 0 }] }),
+  ];
+  const r = exportCsv(invoices);
+
+  assert.ok(r.includes('100.00'));
+  assert.ok(r.includes('400.00'));
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const invoices = [createInvoice({ customerId: 'C-004' })]; // "Smith, Jones & Partners"
+  const r = exportCsv(invoices);
+
+  // Should escape the comma: "Smith, Jones & Partners"
+  assert.ok(r.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer name with quote', () => {
+  const invoices = [createInvoice({ customerId: 'C-006' })]; // Marlow "The Print Shop"
+  const r = exportCsv(invoices);
+
+  // Should double the quote: "Marlow ""The Print Shop"""
+  assert.ok(r.includes('"Marlow ""The Print Shop"""'));
+});
