+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 5, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 42500);
+});
+
+test('lineTotal works with qty 1', () => {
+  const line = { qty: 1, unitPrice: 120000 };
+  assert.equal(lineTotal(line), 120000);
+});
+
+test('lineTotal returns an integer', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  const total = lineTotal(line);
+  assert.ok(Number.isInteger(total));
+});
+
+test('invoiceTotals calculates subtotal from line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 },
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5 * 8500 + 10 * 9500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 3, unitPrice: 6000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 18000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 18000);
+});
+
+test('invoiceTotals returns equal subtotal and total when no discount or VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 120000, discountPercent: 0, vatRate: 0 },
+      { qty: 1, unitPrice: 245000, discountPercent: 0, vatRate: 0 },
+      { qty: 100, unitPrice: 37, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, totals.total);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 2 * 120000 + 1 * 245000 + 100 * 37);
+});
+
+test('invoiceTotals returns integers', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(Number.isInteger(totals.subtotal));
+  assert.ok(Number.isInteger(totals.discount));
+  assert.ok(Number.isInteger(totals.vat));
+  assert.ok(Number.isInteger(totals.total));
+});
+
+test('invoiceTotals does not mutate invoice', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 }],
+  };
+  const original = JSON.stringify(invoice);
+  invoiceTotals(invoice);
+  assert.equal(JSON.stringify(invoice), original);
+});
+
+test('lineDiscount calculates discount as lineTotal times discountPercent / 100', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 10 };
+  // lineTotal = 5 * 8500 = 42500, discount = 42500 * 10 / 100 = 4250
+  assert.equal(lineDiscount(line), 4250);
+});
+
+test('lineDiscount returns 0 when discountPercent is 0', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount handles decimal discount percentages', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 12.5 };
+  // lineTotal = 100 * 1000 = 100000, discount = 100000 * 12.5 / 100 = 12500
+  assert.equal(lineDiscount(line), 12500);
+});
+
+test('lineDiscount handles fractional cents with rounding', () => {
+  const line = { qty: 1, unitPrice: 1001, discountPercent: 12.5 };
+  // lineTotal = 1 * 1001 = 1001, discount = 1001 * 12.5 / 100 = 125.125, rounds to 125
+  assert.equal(lineDiscount(line), 125);
+});
+
+test('lineDiscount clamps negative results to 0', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: -5 };
+  // Invalid discount should not happen due to validation, but lineDiscount should clamp
+  assert.equal(lineDiscount(line) >= 0, true);
+});
+
+test('invoiceTotals calculates total discount as sum of line discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 0 },
+      { qty: 10, unitPrice: 9500, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: 42500 * 10 / 100 = 4250
+  // Line 2: 95000 * 20 / 100 = 19000
+  // Total discount = 4250 + 19000 = 23250
+  assert.equal(totals.discount, 23250);
+  assert.equal(totals.vat, 0);
+});
+
+test('invoiceTotals calculates total as subtotal minus discount plus VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 0 },
+      { qty: 10, unitPrice: 9500, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal = 42500 + 95000 = 137500
+  // Discount = 4250 + 19000 = 23250
+  // VAT = 0
+  // Total = 137500 - 23250 + 0 = 114250
+  assert.equal(totals.subtotal, 137500);
+  assert.equal(totals.discount, 23250);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 114250);
+});
+
+test('invoiceTotals clamps total to 0 if discount exceeds subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, discountPercent: 150, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total >= 0, true);
+});
+
+test('invoiceTotals with tier discount applied', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 0 }, // 42500 * 5 / 100 = 2125
+      { qty: 10, unitPrice: 9500, discountPercent: 5, vatRate: 0 }, // 95000 * 5 / 100 = 4750
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal = 42500 + 95000 = 137500
+  // Discount = 2125 + 4750 = 6875
+  // VAT = 0
+  // Total = 137500 - 6875 + 0 = 130625
+  assert.equal(totals.subtotal, 137500);
+  assert.equal(totals.discount, 6875);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 130625);
+});
+
+test('lineVat calculates VAT on line amount after discount', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 };
+  // lineTotal = 5 * 8500 = 42500
+  // discount = 42500 * 10 / 100 = 4250
+  // amountAfterDiscount = 42500 - 4250 = 38250
+  // vat = 38250 * 21 / 100 = 8032.5, rounds to 8032
+  assert.equal(lineVat(line), 8032);
+});
+
+test('lineVat returns 0 when vatRate is 0', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat handles different VAT rates', () => {
+  const line9 = { qty: 10, unitPrice: 10000, discountPercent: 0, vatRate: 9 };
+  // lineTotal = 10 * 10000 = 100000
+  // discount = 0
+  // amountAfterDiscount = 100000
+  // vat = 100000 * 9 / 100 = 9000
+  assert.equal(lineVat(line9), 9000);
+
+  const line21 = { qty: 10, unitPrice: 10000, discountPercent: 0, vatRate: 21 };
+  // vat = 100000 * 21 / 100 = 21000
+  assert.equal(lineVat(line21), 21000);
+});
+
+test('lineVat handles fractional cents with rounding', () => {
+  const line = { qty: 1, unitPrice: 1001, discountPercent: 0, vatRate: 21 };
+  // lineTotal = 1 * 1001 = 1001
+  // discount = 0
+  // amountAfterDiscount = 1001
+  // vat = 1001 * 21 / 100 = 210.21, rounds to 210
+  assert.equal(lineVat(line), 210);
+});
+
+test('lineVat clamps negative results to 0', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: -10, vatRate: 21 };
+  assert.equal(lineVat(line) >= 0, true);
+});
+
+test('invoiceTotals calculates VAT as sum of line VATs', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }, // 42500 * 21 / 100 = 8925
+      { qty: 10, unitPrice: 10000, discountPercent: 0, vatRate: 9 }, // 100000 * 9 / 100 = 9000
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Total VAT = 8925 + 9000 = 17925
+  assert.equal(totals.vat, 17925);
+});
+
+test('invoiceTotals calculates total as subtotal minus discount plus VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal = 42500
+  // Discount = 4250
+  // Amount after discount = 38250
+  // VAT = 8032
+  // Total = 42500 - 4250 + 8032 = 46282
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.vat, 8032);
+  assert.equal(totals.total, 46282);
+});
+
+test('invoiceTotals returns integers for all values', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(Number.isInteger(totals.subtotal));
+  assert.ok(Number.isInteger(totals.discount));
+  assert.ok(Number.isInteger(totals.vat));
+  assert.ok(Number.isInteger(totals.total));
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 },
+    ],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal = 42500
+  // Discount = 0
+  // VAT = 0
+  // Voucher = 5000
+  // Total = 42500 - 0 + 0 - 5000 = 37500
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 37500);
+});
+
+test('invoiceTotals without voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 42500);
+});
+
+test('invoiceTotals clamps total to 0 if voucher exceeds total', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+    voucher: { code: 'HUGE', amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+  assert.ok(totals.total >= 0);
+});
+
+test('lineTotal with zero values', () => {
+  const line = { qty: 0, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineDiscount with zero discount percent', () => {
+  const line = { qty: 10, unitPrice: 5000, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVat with zero VAT rate', () => {
+  const line = { qty: 10, unitPrice: 5000, discountPercent: 5, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('invoiceTotals with multiple lines and complex calculations', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+      { qty: 2, unitPrice: 5000, discountPercent: 5, vatRate: 9 },
+      { qty: 1, unitPrice: 8000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: total=30000, discount=3000, after discount=27000, vat=5670, subtotal line=30000
+  // Line 2: total=10000, discount=500, after discount=9500, vat=855, subtotal line=10000
+  // Line 3: total=8000, discount=0, after discount=8000, vat=0, subtotal line=8000
+  // Subtotal = 30000 + 10000 + 8000 = 48000
+  // Total discount = 3000 + 500 + 0 = 3500
+  // Total VAT = 5670 + 855 + 0 = 6525
+  // Total = 48000 - 3500 + 6525 = 51025
+  assert.equal(totals.subtotal, 48000);
+  assert.equal(totals.discount, 3500);
+  assert.equal(totals.vat, 6525);
+  assert.equal(totals.total, 51025);
+});
+
+test('lineDiscount with missing discountPercent uses 0', () => {
+  const line = { qty: 10, unitPrice: 5000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVat with missing discountPercent uses 0', () => {
+  const line = { qty: 10, unitPrice: 5000, vatRate: 21 };
+  // lineTotal = 50000, discount = 0, after discount = 50000, vat = 10500
+  assert.equal(lineVat(line), 10500);
+});
+
+test('lineVat with missing vatRate uses 0', () => {
+  const line = { qty: 10, unitPrice: 5000, discountPercent: 10 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('invoiceTotals preserves precision through calculations', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 333, discountPercent: 7, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line total = 999 cents
+  // Discount = 999 * 7 / 100 = 69.93 rounds to 70
+  // After discount = 999 - 70 = 929
+  // VAT = 929 * 21 / 100 = 195.09 rounds to 195
+  // Total = 999 - 70 + 195 = 1124
+  assert.equal(totals.subtotal, 999);
+  assert.equal(totals.discount, 70);
+  assert.equal(totals.vat, 195);
+  assert.equal(totals.total, 1124);
+});
