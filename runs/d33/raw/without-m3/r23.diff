@@ -20,24 +20,38 @@ export function lineDiscount(line) {
 }
 
 /**
- * Calculate VAT for a single line (amount after discount * vatRate / 100, rounded).
+ * Calculate bulk discount for a line (2.5% off for 10+ units, applied after line discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent: number }}
+ * @returns {number} bulk discount in cents, 0 if qty < 10
+ */
+export function lineBulkDiscount(line) {
+  if (line.qty < 10) return 0;
+  const amountAfterLineDiscount = lineTotal(line) - lineDiscount(line);
+  const bulkDiscount = amountAfterLineDiscount * 2.5 / 100;
+  return Math.max(0, roundCents(bulkDiscount));
+}
+
+/**
+ * Calculate VAT for a single line (amount after all discounts * vatRate / 100, rounded).
  * @param {{ qty: number, unitPrice: number, discountPercent: number, vatRate: number }}
  * @returns {number} VAT in cents, clamped at 0
  */
 export function lineVat(line) {
-  const amountAfterDiscount = lineTotal(line) - lineDiscount(line);
-  const vat = amountAfterDiscount * (line.vatRate ?? 0) / 100;
+  const amountAfterLineDiscount = lineTotal(line) - lineDiscount(line);
+  const amountAfterAllDiscounts = amountAfterLineDiscount - lineBulkDiscount(line);
+  const vat = amountAfterAllDiscounts * (line.vatRate ?? 0) / 100;
   return Math.max(0, roundCents(vat));
 }
 
 /**
  * Calculate invoice totals (subtotal, discount, vat, voucher, and total).
+ * Discount includes both line discounts and bulk discounts.
  * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent: number, vatRate: number }>, voucher?: { amount: number } }}
  * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} in cents
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
-  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line) + lineBulkDiscount(line), 0);
   const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
   const voucher = invoice.voucher?.amount ?? 0;
   const total = Math.max(0, subtotal - discount + vat - voucher);
