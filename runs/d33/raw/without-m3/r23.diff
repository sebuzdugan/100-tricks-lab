+      { qty: 10, unitPrice: 2000, discountPercent: 0, vatRate: 21 },
+      { qty: 8, unitPrice: 1500, discountPercent: 10, vatRate: 9 },
+      { qty: 12, unitPrice: 1000, discountPercent: 5, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: total=5000, discount=250, bulk=0, after=4750, vat=997.5→998
+  // Line 2: total=20000, discount=0, bulk=500, after=19500, vat=4095
+  // Line 3: total=12000, discount=1200, bulk=0, after=10800, vat=972
+  // Line 4: total=12000, discount=600, bulk=285, after=11115, vat=0
+  // Subtotal = 49000
+  // Total discount = 250 + 0 + 1200 + 600 + 0 + 500 + 0 + 285 = 2835
+  // Total VAT = 998 + 4095 + 972 + 0 = 6065
+  // Total = 49000 - 2835 + 6065 = 52230
+  assert.equal(totals.subtotal, 49000);
+  assert.equal(totals.discount, 2835);
+  assert.equal(totals.vat, 6065);
+  assert.equal(totals.total, 52230);
