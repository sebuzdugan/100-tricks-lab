   return ok(feeAmount);
 }
+
+/**
+ * Get dashboard summary of invoices.
+ * @param {Array} invoices
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {{ ok: boolean, value?: { counts, outstanding, overdue, topCustomers }, error?: string }}
+ */
+export function dashboard(invoices, asOf) {
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = new Map();
+
+  for (const inv of invoices) {
+    counts[inv.status]++;
+
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const due = balanceDue(inv);
+      outstanding += due;
+      const current = customerDue.get(inv.customerId) ?? 0;
+      customerDue.set(inv.customerId, current + due);
+    }
+  }
+
+  const overdueResult = overdueInvoices(invoices, asOf);
+  let overdueCount = 0;
+  let overdueAmount = 0;
+  if (overdueResult.ok) {
+    overdueCount = overdueResult.value.length;
+    overdueAmount = overdueResult.value.reduce((sum, inv) => sum + inv.due, 0);
+  }
+
+  const topCustomers = Array.from(customerDue, ([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({
+    counts,
+    outstanding,
+    overdue: { count: overdueCount, amount: overdueAmount },
+    topCustomers,
+  });
+}
