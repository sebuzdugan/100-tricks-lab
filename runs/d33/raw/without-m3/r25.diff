@@ -20,6 +21,12 @@ export function renderInvoiceText(invoice) {
     const unitPriceText = formatEuros(line.unitPrice);
     const lineTotalText = formatEuros(lineTotal(line));
     lines.push(`${line.qty} ${line.name} ${unitPriceText} ${lineTotalText}`);
+
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      const discountText = formatEuros(discount);
+      lines.push(`  Discount: ${discountText}`);
+    }
   }
 
   const totals = invoiceTotals(invoice);
@@ -27,8 +34,24 @@ export function renderInvoiceText(invoice) {
     const vatText = formatEuros(totals.vat);
     lines.push(`VAT: ${vatText}`);
   }
+
+  if (totals.voucher > 0) {
+    const voucherText = formatEuros(totals.voucher);
+    lines.push(`Voucher: -${voucherText}`);
+  }
+
   const totalText = formatEuros(totals.total);
   lines.push(`Total: ${totalText}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const paid = invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+    const paidText = formatEuros(paid);
+    lines.push(`Paid: ${paidText}`);
+  }
+
   return lines.join('\n');
 }
