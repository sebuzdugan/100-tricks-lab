+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const result = addLine(invoiceResult.value, { sku: 'DES-HOUR', qty: 2 });
