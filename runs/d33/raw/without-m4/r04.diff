+/**
+ * Get the next invoice number for a given issue date.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded.
+ * Counter resets each year, starting at 0001.
+ * @param {Array<string>} existingNumbers - Invoice numbers already used
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  // Extract year from issueDate (YYYY-MM-DD)
+  const year = issueDate.substring(0, 4);
+
+  // Find the highest counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const match = /^INV-(\d{4})-(\d{4})$/.exec(num);
+    if (match && match[1] === year) {
+      const counter = parseInt(match[2], 10);
+      if (counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  // Next counter
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+
+  return `INV-${year}-${paddedCounter}`;
+}
