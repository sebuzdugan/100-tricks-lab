+++ b/test/numbering.test.js
@@ -0,0 +1,70 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2024-03-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2024-06-20');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2023-0050', 'INV-2024-0002', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2024-09-15');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2024-0050', 'INV-2024-0025'];
+  const number = nextInvoiceNumber(existing, '2025-01-01');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber handles unsorted input', () => {
+  const existing = ['INV-2024-0005', 'INV-2024-0001', 'INV-2024-0010', 'INV-2024-0003'];
+  const number = nextInvoiceNumber(existing, '2024-03-15');
+  assert.equal(number, 'INV-2024-0011');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2024-000${i + 1}`);
+  const number = nextInvoiceNumber(existing, '2024-03-15');
+  assert.equal(number, 'INV-2024-0010');
+});
+
+test('nextInvoiceNumber handles large counter values', () => {
+  const existing = ['INV-2024-9999'];
+  const number = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(number, 'INV-2024-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2024-0001', 'INVALID', 'INV-24-0002', 'INV-2024-ABC', ''];
+  const number = nextInvoiceNumber(existing, '2024-03-15');
+  assert.equal(number, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber extracts year from issueDate correctly', () => {
+  const existing = ['INV-2023-0001'];
+  const number2024 = nextInvoiceNumber(existing, '2024-01-15');
+  const number2025 = nextInvoiceNumber(existing, '2025-12-31');
+
+  assert.equal(number2024, 'INV-2024-0001');
+  assert.equal(number2025, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber with empty array', () => {
+  const number = nextInvoiceNumber([], '2024-03-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber with only other years', () => {
+  const existing = ['INV-2022-9999', 'INV-2023-0050', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0001');
+});
