+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals, lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  // Get totals
+  const totals = invoiceTotals(invoice);
+
+  // Build lines
+  const lines = [];
+
+  // Header: invoice number or DRAFT
+  lines.push(invoice.number ? invoice.number : 'DRAFT');
+
+  // Customer name
+  lines.push(customerName);
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const lineTotalCents = lineTotal(line);
+    const formattedUnitPrice = formatEuros(line.unitPrice);
+    const formattedLineTotal = formatEuros(lineTotalCents);
+    lines.push(`${line.qty}x ${line.name} @ ${formattedUnitPrice} = ${formattedLineTotal}`);
+  }
+
+  // Total line
+  const formattedTotal = formatEuros(totals.total);
+  lines.push(`Total: ${formattedTotal}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
