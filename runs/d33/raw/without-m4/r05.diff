+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for unpublished invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+
+  const text = renderInvoiceText(issuedResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2024-0001');
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText formats single line correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  // DEV-HOUR: 9500 cents = €95.00, qty 5 = €475.00
+  assert.equal(lines[2], '5x Development (hour) @ €95.00 = €475.00');
+});
+
+test('renderInvoiceText formats multiple lines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '5x Development (hour) @ €95.00 = €475.00');
+  assert.equal(lines[3], '2x Design work (hour) @ €85.00 = €170.00');
+  assert.equal(lines[4], '3x Copywriting (hour) @ €60.00 = €180.00');
+});
+
+test('renderInvoiceText shows total at the end', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 2 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  // DEV-HOUR: 9500 * 5 = 47500
+  // DES-HOUR: 8500 * 2 = 17000
+  // Total: 64500 cents = €645.00
+  assert.equal(lines[lines.length - 1], 'Total: €645.00');
+});
+
+test('renderInvoiceText handles different currency amounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 }, // 120000 cents
+      { sku: 'ICON-SET', qty: 2 },  // 980 * 2 = 1960 cents
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '1x Logo package @ €1,200.00 = €1,200.00');
+  assert.equal(lines[3], '2x Icon set (24 icons) @ €9.80 = €19.60');
+  assert.equal(lines[lines.length - 1], 'Total: €1,219.60');
+});
+
+test('renderInvoiceText with different customer', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText includes all required sections', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  // Should have at least: invoice header, customer, line, total
+  assert(lines.length >= 4);
+  assert(lines[0].includes('DRAFT') || lines[0].includes('INV-'));
+  assert(lines[lines.length - 1].startsWith('Total: '));
+});
+
+test('renderInvoiceText formats with thousands separators', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 2 }, // 245000 * 2 = 490000 cents = €4,900.00
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert(lines[2].includes('€2,450.00'));
+  assert(lines[lines.length - 1].includes('€4,900.00'));
+});
+
+test('renderInvoiceText output is readable text', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'HOST-MONTH', qty: 12 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+
+  // Should be a string with newlines
+  assert(typeof text === 'string');
+  assert(text.includes('\n'));
+
+  // Should have readable formatting
+  assert(text.includes('Development (hour)'));
+  assert(text.includes('Website hosting (month)'));
+  assert(text.includes('Total:'));
+});
