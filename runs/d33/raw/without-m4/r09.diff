+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice stores normalized customer ID with tier discount applied', () => {
+  const result = createInvoice({
+    customerId: 'c-001', // gold tier (5% discount) - lowercase
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.lines[0].discountPercent, 5); // gold tier discount
+});
