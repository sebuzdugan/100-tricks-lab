+
+test('createInvoice normalizes customer ID to uppercase', () => {
+  const result = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createInvoice normalizes customer ID by trimming spaces', () => {
+  const result = createInvoice({
+    customerId: ' c-003 ',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+});
+
+test('createInvoice normalizes customer ID for case and spaces', () => {
+  const result = createInvoice({
+    customerId: ' c-002 ',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+});
+
+test('createInvoice with normalized ID still validates customer', () => {
+  const result = createInvoice({
+    customerId: ' C-999 ',
+    issueDate: '2024-03-15',
