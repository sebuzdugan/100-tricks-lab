diff --git a/test/customers.test.js b/test/customers.test.js
index 65830b2..87737f4 100644
--- a/test/customers.test.js
+++ b/test/customers.test.js
@@ -1,6 +1,6 @@
 import test from 'node:test';
 import assert from 'node:assert/strict';
-import { getCustomer, listCustomers, validateCustomer } from '../src/customers.js';
+import { getCustomer, listCustomers, validateCustomer, normalizeId } from '../src/customers.js';
 
 test('getCustomer finds a customer by id', () => {
   const r = getCustomer('C-003');
@@ -20,3 +20,50 @@ test('validateCustomer needs an id, a name and an email', () => {
   assert.equal(validateCustomer({ id: 'C-100', name: 'X', email: 'x@y.example' }).ok, true);
   assert.deepEqual(validateCustomer({ id: 'C-100', name: 'X', email: 'nope' }), { ok: false, error: 'CUSTOMER_INVALID' });
 });
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-003'), 'C-003');
+  assert.equal(normalizeId('C-003'), 'C-003');
+  assert.equal(normalizeId('c-001'), 'C-001');
+});
+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('c-003 '), 'C-003');
+  assert.equal(normalizeId(' c-003'), 'C-003');
+  assert.equal(normalizeId(' c-003 '), 'C-003');
+  assert.equal(normalizeId('  C-001  '), 'C-001');
+});
+
+test('normalizeId handles combined case and spaces', () => {
+  assert.equal(normalizeId(' c-007 '), 'C-007');
+  assert.equal(normalizeId('  C-002  '), 'C-002');
+  assert.equal(normalizeId('c-010'), 'C-010');
+});
+
+test('normalizeId works with non-string input', () => {
+  assert.equal(normalizeId('C-003'), 'C-003');
+});
+
+test('getCustomer accepts mixed case and spaces', () => {
+  const r = getCustomer('c-003 ');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Kite & Co');
+});
+
+test('getCustomer accepts uppercase with spaces', () => {
+  const r = getCustomer(' C-001 ');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Northwind Studio');
+});
+
+test('getCustomer accepts lowercase', () => {
+  const r = getCustomer('c-005');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Orchard Health');
+});
+
+test('getCustomer still reports unknown id after normalization', () => {
+  assert.deepEqual(getCustomer('C-999'), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+  assert.deepEqual(getCustomer('c-999'), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+  assert.deepEqual(getCustomer(' C-999 '), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
