diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..bbc48d6
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,147 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+// isValidDate tests
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2024-03-15'), true);
+  assert.equal(isValidDate('2024-01-01'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2024-02-30'), false); // February doesn't have 30 days
+  assert.equal(isValidDate('2023-02-29'), false); // 2023 is not a leap year
+  assert.equal(isValidDate('2024-13-01'), false); // month 13 doesn't exist
+  assert.equal(isValidDate('2024-00-15'), false); // month 0 doesn't exist
+  assert.equal(isValidDate('2024-03-00'), false); // day 0 doesn't exist
+  assert.equal(isValidDate('2024-03-32'), false); // March doesn't have 32 days
+});
+
+test('isValidDate rejects wrong format', () => {
+  assert.equal(isValidDate('03-15-2024'), false); // wrong order
+  assert.equal(isValidDate('2024/03/15'), false); // wrong separators
+  assert.equal(isValidDate('2024-3-15'), false); // missing leading zero
+  assert.equal(isValidDate('2024-03-5'), false); // missing leading zero
+  assert.equal(isValidDate('24-03-15'), false); // short year
+  assert.equal(isValidDate('2024-03-15T00:00:00Z'), false); // includes time
+  assert.equal(isValidDate(''), false); // empty string
+  assert.equal(isValidDate('not-a-date'), false); // garbage
+});
+
+test('isValidDate handles leap years correctly', () => {
+  assert.equal(isValidDate('2000-02-29'), true); // leap year (divisible by 400)
+  assert.equal(isValidDate('2004-02-29'), true); // leap year (divisible by 4)
+  assert.equal(isValidDate('1900-02-29'), false); // not a leap year (divisible by 100 but not 400)
+  assert.equal(isValidDate('2023-02-29'), false); // not a leap year
+});
+
+// addDays tests
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2024-03-15', 1), '2024-03-16');
+  assert.equal(addDays('2024-03-15', 5), '2024-03-20');
+  assert.equal(addDays('2024-03-15', 10), '2024-03-25');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2024-03-15', -1), '2024-03-14');
+  assert.equal(addDays('2024-03-15', -5), '2024-03-10');
+  assert.equal(addDays('2024-03-15', -10), '2024-03-05');
+});
+
+test('addDays handles month boundaries', () => {
+  // End of month to next month
+  assert.equal(addDays('2024-03-31', 1), '2024-04-01');
+  // Start of month to previous month
+  assert.equal(addDays('2024-04-01', -1), '2024-03-31');
+});
+
+test('addDays handles year boundaries', () => {
+  // End of year to next year
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+  // Start of year to previous year
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays handles leap year boundaries', () => {
+  // February to March in non-leap year
+  assert.equal(addDays('2023-02-28', 1), '2023-03-01');
+  // February to March in leap year
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2024-03-15', 0), '2024-03-15');
+});
+
+test('addDays handles large day offsets', () => {
+  assert.equal(addDays('2024-01-01', 365), '2024-12-31'); // 2024 is leap year (366 days)
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01');
+});
+
+// daysBetween tests
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2024-03-15', '2024-03-16'), 1);
+  assert.equal(daysBetween('2024-03-15', '2024-03-20'), 5);
+  assert.equal(daysBetween('2024-03-15', '2024-03-25'), 10);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2024-03-20', '2024-03-15'), -5);
+  assert.equal(daysBetween('2024-03-25', '2024-03-15'), -10);
+});
+
+test('daysBetween calculates zero difference', () => {
+  assert.equal(daysBetween('2024-03-15', '2024-03-15'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2024-03-31', '2024-04-01'), 1);
+  assert.equal(daysBetween('2024-04-01', '2024-03-31'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2024-12-31'), -1);
+});
+
+test('daysBetween handles leap years', () => {
+  // 2024 is a leap year with 366 days
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2); // skip Feb 29
+  assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365); // day 366 - day 1 = 365 days difference
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // full leap year (366 days)
+});
+
+test('daysBetween handles large date ranges', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // leap year
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365); // non-leap year
+});
+
+test('daysBetween with addDays roundtrip', () => {
+  const date1 = '2024-03-15';
+  const date2 = addDays(date1, 10);
+  assert.equal(daysBetween(date1, date2), 10);
+
+  const date3 = addDays(date1, -5);
+  assert.equal(daysBetween(date1, date3), -5);
+});
+
+test('isValidDate and addDays work together', () => {
+  const date = '2024-03-15';
+  const newDate = addDays(date, 5);
+
+  assert.equal(isValidDate(date), true);
+  assert.equal(isValidDate(newDate), true);
+});
+
+test('all dates work in UTC consistently', () => {
+  // These tests verify UTC behavior by ensuring consistent results
+  // regardless of machine's local timezone
+  assert.equal(daysBetween('2024-03-14', '2024-03-15'), 1);
+  assert.equal(addDays('2024-03-15', 1), '2024-03-16');
+
+  // Verify that the same calculation gives same result when called multiple times
+  assert.equal(daysBetween('2024-01-01', '2024-03-15'), daysBetween('2024-01-01', '2024-03-15'));
+});
