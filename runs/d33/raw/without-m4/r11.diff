+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the balance due on an invoice (total minus payments).
+ * @param {{ payments?: Array<{ amount: number, date: string }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
+
+/**
+ * Record a payment against an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }>, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {{ amount: number, date: string }} params
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check invoice is issued or partially paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create payments array if it doesn't exist
+  const payments = invoice.payments ?? [];
+
+  // Add the payment
+  const newPayments = [...payments, { amount, date }];
+
+  // Calculate new balance after this payment
+  const newBalance = balance - amount;
+
+  // Determine new status
+  let newStatus = invoice.status;
+  if (newBalance === 0) {
+    newStatus = 'paid';
+  } else {
+    newStatus = 'partially_paid';
+  }
+
+  // Create new invoice with payment added
+  const newInvoice = { ...invoice, payments: newPayments, status: newStatus };
+  return ok(newInvoice);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
