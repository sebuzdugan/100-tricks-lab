+/**
+ * Calculate due date based on payment terms.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} Due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    // Find the last day of the month of issueDate
+    const [year, month] = issueDate.split('-');
+    // Create a date for the 1st of next month, then subtract 1 day
+    let nextMonth = String(Number(month) + 1).padStart(2, '0');
+    let nextMonthYear = year;
+    if (Number(month) === 12) {
+      nextMonthYear = String(Number(year) + 1);
+      nextMonth = '01';
+    }
+    const firstOfNextMonth = `${nextMonthYear}-${nextMonth}-01`;
+    return addDays(firstOfNextMonth, -1);
+  }
+}
 
