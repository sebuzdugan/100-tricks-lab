+++ b/test/vouchers.test.js
@@ -0,0 +1,271 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, invoiceTotals, applyVoucher, issueInvoice } from '../src/invoices.js';
+
+// Helper to create a test invoice
+function createTestInvoice() {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+    ],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+  return result.value;
+}
+
+// Basic voucher application
+test('applyVoucher adds voucher to invoice', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'SUMMER20', amount: 1000 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher.code, 'SUMMER20');
+  assert.equal(result.value.voucher.amount, 1000);
+});
+
+test('applyVoucher creates voucher object if missing', () => {
+  const invoice = createTestInvoice();
+  assert.equal(invoice.voucher, undefined);
+  const result = applyVoucher(invoice, { code: 'TEST', amount: 500 });
+  assert.ok(result.value.voucher);
+});
+
+test('applyVoucher preserves other invoice fields', () => {
+  const invoice = createTestInvoice();
+  const originalCustomerId = invoice.customerId;
+  const originalIssueDate = invoice.issueDate;
+  const originalStatus = invoice.status;
+  const originalLines = invoice.lines;
+
+  const result = applyVoucher(invoice, { code: 'VOUCHER', amount: 1000 });
+  assert.equal(result.value.customerId, originalCustomerId);
+  assert.equal(result.value.issueDate, originalIssueDate);
+  assert.equal(result.value.status, originalStatus);
+  assert.deepEqual(result.value.lines, originalLines);
+});
+
+test('applyVoucher does not mutate input invoice', () => {
+  const invoice = createTestInvoice();
+  const originalVoucher = invoice.voucher;
+
+  applyVoucher(invoice, { code: 'TEST', amount: 500 });
+
+  assert.equal(invoice.voucher, originalVoucher);
+});
+
+// Voucher restrictions
+test('applyVoucher rejects NOT_DRAFT if invoice is issued', () => {
+  const draftResult = createTestInvoice();
+  const issuedResult = issueInvoice(draftResult, []);
+  const issued = issuedResult.value;
+
+  const result = applyVoucher(issued, { code: 'TEST', amount: 1000 });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_DRAFT');
+});
+
+test('applyVoucher rejects VOUCHER_EXISTS if already applied', () => {
+  const invoice = createTestInvoice();
+  const result1 = applyVoucher(invoice, { code: 'FIRST', amount: 1000 });
+  const result2 = applyVoucher(result1.value, { code: 'SECOND', amount: 500 });
+
+  assert.equal(result2.ok, false);
+  assert.equal(result2.error, 'VOUCHER_EXISTS');
+});
+
+test('applyVoucher rejects AMOUNT_INVALID if amount is not positive', () => {
+  const invoice = createTestInvoice();
+
+  const r1 = applyVoucher(invoice, { code: 'TEST', amount: 0 });
+  assert.equal(r1.error, 'AMOUNT_INVALID');
+
+  const r2 = applyVoucher(invoice, { code: 'TEST', amount: -100 });
+  assert.equal(r2.error, 'AMOUNT_INVALID');
+
+  const r3 = applyVoucher(invoice, { code: 'TEST', amount: 100.5 });
+  assert.equal(r3.error, 'AMOUNT_INVALID');
+
+  const r4 = applyVoucher(invoice, { code: 'TEST', amount: NaN });
+  assert.equal(r4.error, 'AMOUNT_INVALID');
+});
+
+// invoiceTotals with voucher
+test('invoiceTotals includes voucher in return', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.hasOwnProperty('voucher'));
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals returns voucher amount from applied voucher', () => {
+  const invoice = createTestInvoice();
+  const voucherResult = applyVoucher(invoice, { code: 'TEST', amount: 2500 });
+  const totals = invoiceTotals(voucherResult.value);
+  assert.equal(totals.voucher, 2500);
+});
+
+test('invoiceTotals calculates total with voucher: subtotal - discount + vat - voucher', () => {
+  const invoice = createTestInvoice();
+  const voucherResult = applyVoucher(invoice, { code: 'TEST', amount: 1000 });
+  const totals = invoiceTotals(voucherResult.value);
+
+  const expectedTotal = totals.subtotal - totals.discount + totals.vat - 1000;
+  assert.equal(totals.total, expectedTotal);
+});
+
+test('invoiceTotals clamps total to 0 if voucher exceeds subtotal + vat', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  // Apply voucher larger than the invoice total
+  const voucherResult = applyVoucher(invoice, { code: 'BIG', amount: totals.total + 10000 });
+  const newTotals = invoiceTotals(voucherResult.value);
+
+  assert.equal(newTotals.total, 0);
+});
+
+// Voucher amounts
+test('applyVoucher with small voucher amount', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'SMALL', amount: 1 });
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.voucher, 1);
+});
+
+test('applyVoucher with large voucher amount', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'LARGE', amount: 999999 });
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.voucher, 999999);
+});
+
+test('applyVoucher with voucher equal to invoice total', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = applyVoucher(invoice, { code: 'EXACT', amount: totals.total });
+  const newTotals = invoiceTotals(result.value);
+  assert.equal(newTotals.total, 0);
+});
+
+// Voucher codes
+test('applyVoucher with various code formats', () => {
+  const invoice = createTestInvoice();
+
+  const codes = ['SUMMER20', 'VIP', 'PROMO-2024', 'v123', 'ABC123XYZ'];
+  for (const code of codes) {
+    const result = applyVoucher(invoice, { code, amount: 1000 });
+    assert.equal(result.ok, true, `Failed with code: ${code}`);
+    assert.equal(result.value.voucher.code, code);
+  }
+});
+
+test('applyVoucher with empty code', () => {
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: '', amount: 1000 });
+  // Empty code is allowed (code is just stored as-is)
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher.code, '');
+});
+
+// Interaction with discounts and VAT
+test('applyVoucher works with invoices having line discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2, discountPercent: 10 },
+    ],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+  const invoice = result.value;
+
+  const voucherResult = applyVoucher(invoice, { code: 'TEST', amount: 5000 });
+  const totals = invoiceTotals(voucherResult.value);
+
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.voucher > 0);
+  assert.ok(totals.vat > 0);
+});
+
+test('applyVoucher with tier discount invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // gold tier (5% discount)
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+    ],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+  const invoice = result.value;
+
+  const voucherResult = applyVoucher(invoice, { code: 'GOLD', amount: 3000 });
+  const totals = invoiceTotals(voucherResult.value);
+
+  assert.ok(totals.discount > 0); // tier discount applied
+  assert.equal(totals.voucher, 3000);
+});
+
+// Total formula verification
+test('invoiceTotals voucher field is 0 when no voucher', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals returns complete breakdown with voucher', () => {
+  const invoice = createTestInvoice();
+  const voucherResult = applyVoucher(invoice, { code: 'TEST', amount: 10000 });
+  const totals = invoiceTotals(voucherResult.value);
+
+  assert.ok(totals.subtotal >= 0);
+  assert.ok(totals.discount >= 0);
+  assert.ok(totals.vat >= 0);
+  assert.equal(totals.voucher, 10000);
+  assert.equal(totals.total, Math.max(0, totals.subtotal - totals.discount + totals.vat - 10000));
+});
+
+// Edge cases
+test('applyVoucher on invoice with no lines still works', () => {
+  // This should fail on createInvoice, not applyVoucher
+  // Testing that voucher logic doesn't break with valid invoices
+  const invoice = createTestInvoice();
+  const result = applyVoucher(invoice, { code: 'EDGE', amount: 1 });
+  assert.equal(result.ok, true);
+});
+
+test('applyVoucher multiple times on different draft invoices', () => {
+  const invoice1 = createTestInvoice();
+  const invoice2 = createTestInvoice();
+
+  const result1 = applyVoucher(invoice1, { code: 'V1', amount: 1000 });
+  const result2 = applyVoucher(invoice2, { code: 'V2', amount: 2000 });
+
+  assert.equal(result1.value.voucher.code, 'V1');
+  assert.equal(result2.value.voucher.code, 'V2');
+  assert.equal(result1.value.voucher.amount, 1000);
+  assert.equal(result2.value.voucher.amount, 2000);
+});
+
+test('invoice totals with all features: discount, VAT, and voucher', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10, discountPercent: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+  const invoice = result.value;
+
+  const voucherResult = applyVoucher(invoice, { code: 'COMBO', amount: 50000 });
+  const totals = invoiceTotals(voucherResult.value);
+
+  // Verify all components are present and non-negative (voucher is exactly applied)
+  assert.ok(totals.subtotal > 0);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.voucher, 50000);
+  assert.equal(totals.total, Math.max(0, totals.subtotal - totals.discount + totals.vat - 50000));
+});
