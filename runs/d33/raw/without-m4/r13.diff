+/**
+ * Apply a voucher to an invoice (draft only, one voucher per invoice).
+ * @param {{ status: string, voucher?: any }} invoice
+ * @param {{ code: string, amount: number }} params
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if voucher already applied
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Create new invoice with voucher
+  const newInvoice = { ...invoice, voucher: { code, amount } };
+  return ok(newInvoice);
+}
