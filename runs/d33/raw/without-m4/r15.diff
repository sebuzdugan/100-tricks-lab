diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..32d4bb0
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,364 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue invoices
+function createIssuedInvoice(customerId = 'C-001', issueDate = '2024-03-15', qty = 1) {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DEV-HOUR', qty }],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  return issued.value;
+}
+
+// Basic credit note creation
+test('createCreditNote creates a credit note', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Defective', date: '2024-03-16' }, []);
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.number);
+});
+
+test('createCreditNote includes required fields', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Refund', date: '2024-03-16' }, []);
+  const creditNote = result.value;
+
+  assert.ok(creditNote.number);
+  assert.equal(creditNote.invoiceNumber, invoice.number);
+  assert.equal(creditNote.customerId, invoice.customerId);
+  assert.equal(creditNote.amount, 1000);
+  assert.equal(creditNote.reason, 'Refund');
+  assert.equal(creditNote.date, '2024-03-16');
+});
+
+test('createCreditNote credit note number starts with CN', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-03-16' }, []);
+
+  assert.ok(result.value.number.startsWith('CN-'));
+});
+
+// Credit note numbering
+test('createCreditNote generates CN-YYYY-#### format', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-03-16' }, []);
+
+  const pattern = /^CN-\d{4}-\d{4}$/;
+  assert.ok(pattern.test(result.value.number));
+});
+
+test('createCreditNote with first credit note uses 0001', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-03-16' }, []);
+
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote increments counter for same year', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const result1 = createCreditNote(invoice, { amount: 1000, reason: 'Test1', date: '2024-03-16' }, []);
+  const existing1 = [result1.value.number];
+
+  const result2 = createCreditNote(invoice, { amount: 1000, reason: 'Test2', date: '2024-03-17' }, existing1);
+
+  assert.equal(result1.value.number, 'CN-2024-0001');
+  assert.equal(result2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const invoice = createIssuedInvoice();
+
+  const result1 = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-12-31' }, []);
+  const result2 = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2025-01-01' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2024-0001');
+  assert.equal(result2.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote ignores invoice numbers in numbering', () => {
+  const invoice = createIssuedInvoice();
+
+  const invoiceNumbers = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003'];
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-03-16' }, invoiceNumbers);
+
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote ignores malformed numbers', () => {
+  const invoice = createIssuedInvoice();
+
+  const numbers = ['CN-2024-XXXX', 'CN-2024-', 'INVALID'];
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-03-16' }, numbers);
+
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+// Invoice status validation
+test('createCreditNote accepts issued invoices', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-03-16' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote accepts partially_paid invoices', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const half = Math.floor(totals.total / 2);
+
+  const payment = recordPayment(invoice, { amount: half, date: '2024-03-16' });
+  assert.equal(payment.value.status, 'partially_paid');
+
+  const result = createCreditNote(payment.value, { amount: 1000, reason: 'Test', date: '2024-03-17' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote accepts paid invoices', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2024-03-16' });
+  assert.equal(payment.value.status, 'paid');
+
+  const result = createCreditNote(payment.value, { amount: 1000, reason: 'Refund', date: '2024-03-17' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const result = createCreditNote(draft.value, { amount: 1000, reason: 'Test', date: '2024-03-16' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+// Amount validation
+test('createCreditNote rejects zero amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 0, reason: 'Test', date: '2024-03-16' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: -1000, reason: 'Test', date: '2024-03-16' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects decimal amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000.5, reason: 'Test', date: '2024-03-16' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects NaN amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: NaN, reason: 'Test', date: '2024-03-16' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+// Credit limit validation
+test('createCreditNote accepts amount equal to invoice total', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2024-03-16' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: totals.total + 1, reason: 'Test', date: '2024-03-16' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote with small amounts', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1, reason: 'Small refund', date: '2024-03-16' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 1);
+});
+
+test('createCreditNote with large amounts', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15', 100);
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: totals.total - 1, reason: 'Large refund', date: '2024-03-16' }, []);
+  assert.equal(result.ok, true);
+});
+
+// Reason field
+test('createCreditNote stores reason', () => {
+  const invoice = createIssuedInvoice();
+  const reasons = ['Defective product', 'Customer request', 'Wrong item shipped', ''];
+
+  for (const reason of reasons) {
+    const result = createCreditNote(invoice, { amount: 1000, reason, date: '2024-03-16' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.reason, reason);
+  }
+});
+
+// Date field
+test('createCreditNote stores date', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-06-15' }, []);
+
+  assert.equal(result.value.date, '2024-06-15');
+});
+
+test('createCreditNote can have different date from invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-04-20' }, []);
+
+  assert.equal(result.value.date, '2024-04-20');
+  assert.notEqual(result.value.date, invoice.issueDate);
+});
+
+// Multiple credit notes
+test('createCreditNote multiple on same invoice', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const third = Math.floor(totals.total / 3);
+
+  const result1 = createCreditNote(invoice, { amount: third, reason: 'First', date: '2024-03-16' }, []);
+  const existing = [result1.value.number];
+
+  const result2 = createCreditNote(invoice, { amount: third, reason: 'Second', date: '2024-03-17' }, existing);
+
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  assert.notEqual(result1.value.number, result2.value.number);
+  assert.equal(result1.value.invoiceNumber, result2.value.invoiceNumber);
+});
+
+// Mixed invoices and credit notes
+test('createCreditNote numbering with mixed invoice and credit note numbers', () => {
+  const invoice = createIssuedInvoice();
+
+  const mixedNumbers = [
+    'INV-2024-0001',
+    'CN-2024-0001',
+    'INV-2024-0002',
+    'CN-2024-0002',
+    'INV-2025-0001',
+  ];
+
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-06-15' }, mixedNumbers);
+
+  assert.equal(result.value.number, 'CN-2024-0003');
+});
+
+// Edge cases
+test('createCreditNote for partially paid invoice respects invoice total', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const half = Math.floor(totals.total / 2);
+
+  const payment = recordPayment(invoice, { amount: half, date: '2024-03-16' });
+
+  // Credit is still limited by the original invoice total, not the remaining balance
+  const result = createCreditNote(payment.value, { amount: totals.total, reason: 'Full refund', date: '2024-03-17' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote with invoices having discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+  const invoice = issued.value;
+
+  const totals = invoiceTotals(invoice);
+  const creditResult = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2024-03-16' }, []);
+
+  assert.equal(creditResult.ok, true);
+  assert.equal(creditResult.value.amount, totals.total);
+});
+
+test('createCreditNote with invoices having VAT', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const creditResult = createCreditNote(invoice, { amount: totals.total / 2, reason: 'Partial refund', date: '2024-03-16' }, []);
+
+  assert.equal(creditResult.ok, true);
+  assert.equal(creditResult.value.amount, Math.floor(totals.total / 2));
+});
+
+test('createCreditNote with multiple SKUs', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'STICKER', qty: 10 },
+    ],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+  const invoice = issued.value;
+
+  const totals = invoiceTotals(invoice);
+  const creditResult = createCreditNote(invoice, { amount: Math.floor(totals.total / 2), reason: 'Partial refund', date: '2024-03-16' }, []);
+
+  assert.equal(creditResult.ok, true);
+});
+
+test('createCreditNote across year boundary', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-12-31');
+
+  const result2024 = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-12-31' }, []);
+  const result2025 = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2025-01-01' }, [result2024.value.number]);
+
+  assert.equal(result2024.value.number, 'CN-2024-0001');
+  assert.equal(result2025.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote does not modify invoice', () => {
+  const invoice = createIssuedInvoice();
+  const originalStatus = invoice.status;
+  const originalNumber = invoice.number;
+
+  createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2024-03-16' }, []);
+
+  assert.equal(invoice.status, originalStatus);
+  assert.equal(invoice.number, originalNumber);
+});
