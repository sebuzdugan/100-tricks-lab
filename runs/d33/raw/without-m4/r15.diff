+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next credit note number in the sequence.
+ * @param {Array<string>} existingNumbers - All existing invoice and credit note numbers
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} Next credit note number in format CN-YYYY-####
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+
+  // Find all credit note numbers for this year
+  const creditNotesThisYear = existingNumbers
+    .filter((num) => num.startsWith('CN-' + year + '-'))
+    .map((num) => {
+      const match = num.match(/CN-\d+-(\d+)/);
+      return match ? parseInt(match[1], 10) : null;
+    })
+    .filter((n) => n !== null);
+
+  // Find highest counter
+  const highest = creditNotesThisYear.length > 0 ? Math.max(...creditNotesThisYear) : 0;
+
+  // Next counter
+  const nextCounter = highest + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+
+  return `CN-${year}-${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} params
+ * @param {Array<string>} existingNumbers - All existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is issued, partially paid, or paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const totals = invoiceTotals(invoice);
+
+  // Check credit amount doesn't exceed invoice total
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Get next credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  // Create credit note
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
