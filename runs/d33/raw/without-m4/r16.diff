+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create and issue invoices
+function createIssuedInvoice(customerId = 'C-001', issueDate = '2024-03-15', dueDate = '2024-03-29', qty = 1) {
+  const result = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DEV-HOUR', qty }],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+
+  return issued.value;
+}
+
+// Basic functionality
+test('overdueInvoices returns overdue invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = overdueInvoices([invoice], '2024-04-15');
+
+  assert.equal(result.length, 1);
+  assert.ok(result[0].daysOverdue > 0);
+});
+
+test('overdueInvoices with no overdue invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = overdueInvoices([invoice], '2024-03-15');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices returns invoice number', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = overdueInvoices([invoice], '2024-04-15');
+
+  assert.equal(result[0].number, invoice.number);
+});
+
+test('overdueInvoices returns customer ID', () => {
+  const invoice = createIssuedInvoice('C-002', '2024-03-15');
+  const result = overdueInvoices([invoice], '2024-04-15');
+
+  assert.equal(result[0].customerId, 'C-002');
+});
+
+test('overdueInvoices returns due date', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = overdueInvoices([invoice], '2024-04-15');
+
+  assert.equal(result[0].dueDate, invoice.dueDate);
+});
+
+test('overdueInvoices returns due amount', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = overdueInvoices([invoice], '2024-04-15');
+
+  assert.ok(typeof result[0].due === 'number');
+  assert.ok(result[0].due > 0);
+});
+
+// Status filtering
+test('overdueInvoices includes issued invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  assert.equal(invoice.status, 'issued');
+
+  const result = overdueInvoices([invoice], '2024-04-15');
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const totals = invoiceTotals(invoice);
+  const half = Math.floor(totals.total / 2);
+
+  const payment = recordPayment(invoice, { amount: half, date: '2024-03-16' });
+  assert.equal(payment.value.status, 'partially_paid');
+
+  const result = overdueInvoices([payment.value], '2024-04-15');
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const result = overdueInvoices([draft.value], '2024-04-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const totals = invoiceTotals(invoice);
+
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2024-03-16' });
+  assert.equal(payment.value.status, 'paid');
+
+  const result = overdueInvoices([payment.value], '2024-04-15');
+  assert.equal(result.length, 0);
+});
+
+// Date filtering
+test('overdueInvoices excludes invoices with dueDate on asOf', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = overdueInvoices([invoice], invoice.dueDate);
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices with dueDate after asOf', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = overdueInvoices([invoice], '2024-03-20');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoices with dueDate before asOf', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const result = overdueInvoices([invoice], '2024-04-15');
+
+  assert.equal(result.length, 1);
+});
+
+// Days overdue calculation
+test('overdueInvoices calculates daysOverdue correctly for one day', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-01');
+  // Invoice with issueDate 2024-03-01 has dueDate 2024-03-31 (NET30)
+  const result = overdueInvoices([invoice], '2024-04-02');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 2);
+});
+
+test('overdueInvoices calculates daysOverdue correctly for multiple days', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  // Invoice with issueDate 2024-03-15 has dueDate 2024-04-14 (NET30)
+  const result = overdueInvoices([invoice], '2024-04-22');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 8);
+});
+
+test('overdueInvoices calculates daysOverdue across month boundary', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-02-01');
+  // Invoice with issueDate 2024-02-01 has dueDate 2024-03-02 (NET30)
+  const result = overdueInvoices([invoice], '2024-03-17');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 15);
+});
+
+test('overdueInvoices calculates daysOverdue across year boundary', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-12-01');
+  // Invoice with issueDate 2024-12-01 has dueDate 2024-12-31 (NET30)
+  const result = overdueInvoices([invoice], '2025-01-16');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 16);
+});
+
+// Due amount calculation
+test('overdueInvoices due equals total for unpaid invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const totals = invoiceTotals(invoice);
+  const result = overdueInvoices([invoice], '2024-04-15');
+
+  assert.equal(result[0].due, totals.total);
+});
+
+test('overdueInvoices due equals balance for partially paid invoice', () => {
+  const invoice = createIssuedInvoice('C-001', '2024-03-15');
+  const totals = invoiceTotals(invoice);
+  const half = Math.floor(totals.total / 2);
+
+  const payment = recordPayment(invoice, { amount: half, date: '2024-03-16' });
+  const result = overdueInvoices([payment.value], '2024-04-15');
+
+  assert.equal(result[0].due, totals.total - half);
+});
+
+// Sorting
+test('overdueInvoices sorts by most overdue first', () => {
+  const inv1 = createIssuedInvoice('C-001', '2024-01-15');
+  const inv2 = createIssuedInvoice('C-001', '2024-02-15');
+  const inv3 = createIssuedInvoice('C-001', '2024-03-15');
+
+  const result = overdueInvoices([inv1, inv2, inv3], '2024-04-15');
+
+  assert.equal(result[0].daysOverdue, result[1].daysOverdue + 31);
+  assert.equal(result[1].daysOverdue, result[2].daysOverdue + 29);
+});
+
+test('overdueInvoices stable sort for same daysOverdue', () => {
+  const inv1 = createIssuedInvoice('C-001', '2024-01-15');
+  const inv2 = createIssuedInvoice('C-002', '2024-01-15');
+
+  const result = overdueInvoices([inv1, inv2], '2024-02-15');
+
+  assert.equal(result.length, 2);
+  assert.equal(result[0].daysOverdue, result[1].daysOverdue);
+});
+
+// Multiple invoices
+test('overdueInvoices with multiple customers', () => {
+  const inv1 = createIssuedInvoice('C-001', '2024-03-10');
+  const inv2 = createIssuedInvoice('C-002', '2024-03-15');
+  const inv3 = createIssuedInvoice('C-003', '2024-02-15');
+
+  const result = overdueInvoices([inv1, inv2, inv3], '2024-04-15');
+
+  assert.equal(result.length, 3);
+  const customers = result.map(r => r.customerId);
+  assert.ok(customers.includes('C-001'));
+  assert.ok(customers.includes('C-002'));
+  assert.ok(customers.includes('C-003'));
+});
+
+test('overdueInvoices filters out recent invoices', () => {
+  const old = createIssuedInvoice('C-001', '2024-01-15');
+  const recent = createIssuedInvoice('C-001', '2024-03-15');
+
+  const result = overdueInvoices([old, recent], '2024-04-14');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, old.number);
+});
+
+// Edge cases
+test('overdueInvoices with empty list', () => {
+  const result = overdueInvoices([], '2024-04-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices with large number of invoices', () => {
+  const invoices = [];
+  for (let i = 1; i <= 50; i++) {
+    const month = String((i % 12) + 1).padStart(2, '0');
+    const day = String((i % 28) + 1).padStart(2, '0');
+    invoices.push(createIssuedInvoice('C-001', `2024-${month}-${day}`));
+  }
+
+  const result = overdueInvoices(invoices, '2024-05-15');
+
+  assert.ok(result.length > 0);
+  // Most should be sorted correctly
+  for (let i = 1; i < result.length; i++) {
+    assert.ok(result[i - 1].daysOverdue >= result[i].daysOverdue);
+  }
+});
+
+test('overdueInvoices with discounted invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+  const invoice = issued.value;
+
+  const overdue = overdueInvoices([invoice], '2024-04-15');
+
+  assert.equal(overdue.length, 1);
+  assert.ok(overdue[0].due > 0);
+});
+
+test('overdueInvoices with multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'STICKER', qty: 5 },
+    ],
+  });
+  if (!result.ok) throw new Error(`createInvoice failed: ${result.error}`);
+
+  const issued = issueInvoice(result.value, []);
+  if (!issued.ok) throw new Error(`issueInvoice failed: ${issued.error}`);
+  const invoice = issued.value;
+
+  const overdue = overdueInvoices([invoice], '2024-04-15');
+
+  assert.equal(overdue.length, 1);
+  assert.ok(overdue[0].due > 0);
+});
+
+test('overdueInvoices with payments on various amounts', () => {
+  const inv1 = createIssuedInvoice('C-001', '2024-03-01');
+  const totals1 = invoiceTotals(inv1);
+  const quarter = Math.floor(totals1.total / 4);
+
+  const payment1 = recordPayment(inv1, { amount: quarter, date: '2024-03-02' });
+  const payment2 = recordPayment(payment1.value, { amount: quarter * 2, date: '2024-03-03' });
+
+  const result = overdueInvoices([payment2.value], '2024-04-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, quarter);
+});
