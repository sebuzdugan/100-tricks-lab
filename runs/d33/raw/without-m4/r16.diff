+import { balanceDue } from './payments.js';
+
+/**
+ * Get invoices with status 'issued' or 'partially_paid' that are overdue.
+ * @param {Array<{ number: string, customerId: string, dueDate: string, status: string, payments?: Array }> invoices
+ * @param {string} asOf - Report cutoff date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>} Overdue invoices, sorted most overdue first
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) =>
+      (inv.status === 'issued' || inv.status === 'partially_paid') &&
+      inv.dueDate < asOf
+    )
+    .map((inv) => {
+      const daysOverdue = Math.floor(
+        (new Date(asOf) - new Date(inv.dueDate)) / (1000 * 60 * 60 * 24)
+      );
+      return {
+        number: inv.number,
+        customerId: inv.customerId,
+        dueDate: inv.dueDate,
+        daysOverdue,
+        due: balanceDue(inv),
+      };
+    })
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
