+/**
+ * Get VAT summary by rate from invoices.
+ * @param {Array<{ status: string, lines: Array<{ sku: string, qty: number, discountPercent?: number }> }> invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} VAT summary, sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const catalogue = listProducts();
+  const vatMap = new Map(); // Map of rate -> { base, vat }
+
+  for (const invoice of invoices) {
+    // Only include issued, partially_paid, or paid invoices
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const product = catalogue.find(p => p.sku === line.sku);
+      if (!product) continue;
+
+      const lineSubtotal = line.qty * product.unitPrice;
+      const lineDiscount = Math.round(lineSubtotal * (line.discountPercent || 0) / 100);
+      const lineBase = lineSubtotal - lineDiscount;
+      const vatAmount = Math.round(lineBase * product.vatRate / 100);
+
+      if (!vatMap.has(product.vatRate)) {
+        vatMap.set(product.vatRate, { base: 0, vat: 0 });
+      }
+
+      const entry = vatMap.get(product.vatRate);
+      entry.base += lineBase;
+      entry.vat += vatAmount;
+    }
+  }
+
+  // Convert to array and sort by rate descending
+  return Array.from(vatMap.entries())
+    .map(([rate, { base, vat }]) => ({ rate, base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+}
