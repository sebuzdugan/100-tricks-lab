+
+/**
+ * Calculate late fee for an invoice.
+ * @param {{ dueDate?: string, payments?: Array, lines: Array, status: string }} invoice
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents (0.04% per day of amount due, 0 if not overdue)
+ */
+export function lateFee(invoice, asOf) {
+  // Check if invoice has a dueDate (draft invoices don't)
+  if (!invoice.dueDate) {
+    return 0;
+  }
+
+  // Check if invoice is overdue
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = Math.floor(
+    (new Date(asOf) - new Date(invoice.dueDate)) / (1000 * 60 * 60 * 24)
+  );
+
+  // Get amount still due
+  const amountDue = balanceDue(invoice);
+
+  // Calculate late fee: 0.04% per day
+  const fee = Math.round(amountDue * daysOverdue * 0.0004);
+
+  return fee;
+}
