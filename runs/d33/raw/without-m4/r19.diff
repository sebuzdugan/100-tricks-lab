+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros with 2 decimal places.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuro(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Escape a CSV field: quote if contains comma or quote, double any quotes.
+ * @param {string|number} field
+ * @returns {string}
+ */
+function escapeCsv(field) {
+  if (field === undefined || field === null) {
+    return '';
+  }
+
+  const str = String(field);
+
+  // Check if field needs quoting (contains comma, quote, or newline)
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    // Escape double quotes by doubling them
+    const escaped = str.replace(/"/g, '""');
+    return `"${escaped}"`;
+  }
+
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ number: string, customerId: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array, voucher?: any }>} invoices
+ * @returns {string} CSV string with header and data rows, lines ending with \n
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data rows
+  for (const invoice of invoices) {
+    // Get customer name
+    let customerName = '';
+    const customerResult = getCustomer(invoice.customerId);
+    if (customerResult.ok) {
+      customerName = customerResult.value.name;
+    }
+
+    // Calculate totals
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    // Format as euros (2 decimals)
+    const fields = [
+      invoice.number,
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate || '',
+      invoice.status,
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ];
+
+    // Escape and join
+    const line = fields.map(escapeCsv).join(',');
+    lines.push(line);
+  }
+
+  return lines.join('\n') + '\n';
+}
