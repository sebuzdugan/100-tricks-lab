 import { ok, fail } from './result.js';
 
 /**
- * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
- * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
- * @param {number} x
+ * Round to the nearest cent, using banker's rounding (round half to even).
+ * @param {number} amount
  * @returns {number}
  */
-export function roundCents(x) {
-  const r = Math.round(x * 1e6) / 1e6; // drop binary noise such as 124.49999999999999
-  const floor = Math.floor(r);
-  const diff = r - floor;
-  if (diff > 0.5) return floor + 1;
-  if (diff < 0.5) return floor === 0 ? 0 : floor;
-  return floor % 2 === 0 ? floor : floor + 1;
+export function roundCents(amount) {
+  const sign = amount < 0 ? -1 : 1;
+  const abs = Math.abs(amount);
+  const fractionPart = abs - Math.floor(abs);
+
+  if (fractionPart < 0.5) {
+    const result = sign * Math.floor(abs);
+    return result === -0 ? 0 : result;
+  }
+  if (fractionPart > 0.5) {
+    const result = sign * Math.ceil(abs);
+    return result === -0 ? 0 : result;
+  }
+
+  // Banker's rounding: round half to even
+  const floored = Math.floor(abs);
+  const result = sign * (floored % 2 === 0 ? floored : floored + 1);
+  return result === -0 ? 0 : result;
 }
 
 /**
- * Format cents as euros for people: 123456 -> "€1,234.56", -5 -> "-€0.05".
+ * Format cents as euros with € symbol, thousands separators, and 2 decimals.
  * @param {number} cents
  * @returns {string}
  */
 export function formatEuros(cents) {
-  const sign = cents < 0 ? '-' : '';
+  const isNegative = cents < 0;
   const abs = Math.abs(cents);
-  const euros = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
-  return `${sign}€${euros}.${String(abs % 100).padStart(2, '0')}`;
+  const euros = (abs / 100).toFixed(2);
+  const parts = euros.split('.');
+  const intPart = parts[0];
+  const fracPart = parts[1];
+
+  // Add thousands separators
+  const withSeparators = intPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+
+  const formatted = withSeparators + '.' + fracPart;
+  return (isNegative ? '-' : '') + '€' + formatted;
 }
 
 /**
- * Parse a euro amount typed by a person ("12", "12.5", "1,234.56") into cents.
- * @param {string} text
+ * Parse a user-entered euro amount (e.g., "12.50" or "1,234.56") to cents.
+ * @param {string} str
  * @returns {{ ok: true, value: number } | { ok: false, error: string }}
  */
-export function parseEuros(text) {
-  const m = /^(\d{1,3}(?:,\d{3})*|\d+)(?:\.(\d{1,2}))?$/.exec(String(text).trim());
-  if (!m) return fail('AMOUNT_INVALID');
-  const euros = Number(m[1].replace(/,/g, ''));
-  const cents = Number((m[2] ?? '').padEnd(2, '0'));
-  return ok(euros * 100 + cents);
+export function parseEuros(str) {
+  // Remove thousands separators
+  const cleaned = str.replace(/,/g, '');
+
+  // Parse as float
+  const parsed = parseFloat(cleaned);
+  if (isNaN(parsed)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Convert to cents
+  const cents = Math.round(parsed * 100);
+
+  // Check for too many decimal places (more than 2)
+  // by checking if the input had more than 2 decimal places
+  const decimalIndex = cleaned.indexOf('.');
+  if (decimalIndex !== -1) {
+    const decimalPlaces = cleaned.length - decimalIndex - 1;
+    if (decimalPlaces > 2) {
+      return fail('AMOUNT_INVALID');
+    }
+  }
+
+  return ok(cents);
+}
+
+/**
+ * Exchange rates: units of that currency per euro.
+ * EUR: 1 (1 EUR = 1 EUR), USD: 1.085 (1 EUR = 1.085 USD), GBP: 0.8425 (1 EUR = 0.8425 GBP)
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert an amount from EUR cents to another currency's cents.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }} Amount in target currency cents, rounded
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const convertedCents = Math.round(cents * RATES[currency]);
+  return ok(convertedCents);
+}
+
+/**
+ * Format an amount in EUR cents as money in the specified currency.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Currency (EUR, USD, GBP)
+ * @returns {string} Formatted money (e.g., "$123.45", "£100.00", "95.50")
+ */
+export function formatMoney(cents, currency) {
+  const rate = RATES[currency];
+  if (!rate) {
+    return (cents / 100).toFixed(2); // fallback
+  }
+
+  const convertedCents = Math.round(cents * rate);
+  const amount = (convertedCents / 100).toFixed(2);
+
+  const symbols = {
+    USD: '$',
+    GBP: '£',
+    EUR: '', // no symbol for EUR
+  };
+
+  const symbol = symbols[currency] || '';
+  return symbol + amount;
 }
