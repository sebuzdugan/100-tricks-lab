diff --git a/src/customers.js b/src/customers.js
index 6905904..eae4abf 100644
--- a/src/customers.js
+++ b/src/customers.js
@@ -43,3 +43,34 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge a duplicate customer into another customer.
+ * Removes fromId customer and updates all invoices to point to intoId.
+ * @param {Array} customers
+ * @param {Array} invoices
+ * @param {string} fromId Customer to merge away
+ * @param {string} intoId Customer to merge into
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  if (fromId === intoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  const fromCustomer = customers.find(c => c.id === fromId);
+  const intoCustomer = customers.find(c => c.id === intoId);
+
+  if (!fromCustomer || !intoCustomer) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const newCustomers = customers.filter(c => c.id !== fromId);
+  const newInvoices = invoices.map(inv =>
+    inv.customerId === fromId
+      ? { ...inv, customerId: intoId }
+      : inv
+  );
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
