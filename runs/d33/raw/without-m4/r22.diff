@@ -0,0 +1,273 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+// lineTotal tests
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 5, unitPrice: 2000 };
+  assert.equal(lineTotal(line), 10000);
+});
+
+test('lineTotal handles single quantity', () => {
+  const line = { qty: 1, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 9500);
+});
+
+test('lineTotal handles zero price', () => {
+  const line = { qty: 10, unitPrice: 0 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 10000 };
+  assert.equal(lineTotal(line), 10000000);
+});
+
+// lineDiscount tests
+test('lineDiscount calculates discount correctly', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 10 };
+  const total = lineTotal(line);
+  const expected = Math.round(total * 10 / 100);
+  assert.equal(lineDiscount(line), expected);
+});
+
+test('lineDiscount defaults to 0% discount', () => {
+  const line = { qty: 100, unitPrice: 1000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount rounds fractional cents correctly', () => {
+  const line = { qty: 3, unitPrice: 100, discountPercent: 33.33 };
+  const result = lineDiscount(line);
+  assert.ok(Number.isInteger(result));
+});
+
+test('lineDiscount clamps to 0 if somehow negative', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: -5 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 100000);
+});
+
+test('lineDiscount with decimal discount percentage', () => {
+  const line = { qty: 5, unitPrice: 2000, discountPercent: 2.5 };
+  const result = lineDiscount(line);
+  assert.ok(Number.isInteger(result));
+});
+
+// lineVat tests
+test('lineVat calculates VAT on undiscounted amount', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21 };
+  const total = lineTotal(line);
+  const expected = Math.round(total * 21 / 100);
+  assert.equal(lineVat(line), expected);
+});
+
+test('lineVat calculates VAT on discounted amount', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: 10 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const discountedAmount = total - discount;
+  const expected = Math.round(discountedAmount * 21 / 100);
+  assert.equal(lineVat(line), expected);
+});
+
+test('lineVat handles 9% VAT rate', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 9 };
+  const result = lineVat(line);
+  assert.ok(Number.isInteger(result));
+});
+
+test('lineVat handles 0% VAT rate', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat rounds fractional cents correctly', () => {
+  const line = { qty: 3, unitPrice: 100, vatRate: 21 };
+  const result = lineVat(line);
+  assert.ok(Number.isInteger(result));
+});
+
+test('lineVat with negative discount calculates on clamped discount', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: -5 };
+  const result = lineVat(line);
+  assert.ok(result > 0);
+});
+
+test('lineVat clamps to 0 if somehow negative', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: -5 };
+  assert.equal(lineVat(line) < 0, false);
+});
+
+// invoiceTotals tests
+test('invoiceTotals calculates subtotal from all lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+      { qty: 3, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+});
+
+test('invoiceTotals with no VAT returns subtotal equal to total', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, totals.total);
+});
+
+test('invoiceTotals handles single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 2000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.subtotal > 0);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+  assert.ok(totals.total > 0);
+});
+
+test('invoiceTotals handles empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes discount and calculates total', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat);
+});
+
+test('invoiceTotals with multiple lines and different discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 3, unitPrice: 1000, discountPercent: 20, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+});
+
+test('invoiceTotals clamps total to 0 if discount exceeds subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 101, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes voucher in return', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.voucher === 5000);
+});
+
+test('invoiceTotals returns voucher amount from applied voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE', amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 10000);
+});
+
+test('invoiceTotals calculates total with voucher: subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals clamps total to 0 if voucher exceeds subtotal + vat', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'HUGE', amount: 50000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals voucher field is 0 when no voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals returns complete breakdown with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 500, discountPercent: 0, vatRate: 9 },
+    ],
+    voucher: { code: 'CODE', amount: 3000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.subtotal > 0);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+  assert.ok(totals.voucher > 0);
+  assert.ok(totals.total > 0);
+  assert.equal(totals.total, Math.max(0, totals.subtotal - totals.discount + totals.vat - totals.voucher));
+});
+
+test('invoiceTotals with 21% VAT and discount produces correct total', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const lineAmount = 100 * 1000;
+  const discount = Math.round(lineAmount * 10 / 100);
+  const discountedAmount = lineAmount - discount;
+  const vat = Math.round(discountedAmount * 21 / 100);
+  const expected = lineAmount - discount + vat;
+  assert.equal(totals.total, expected);
+});
