--- a/src/totals.js
+++ b/src/totals.js
@@ -11,12 +11,23 @@ export function lineTotal(line) {
 
 /**
  * Calculate the discount on a line (lineTotal times discountPercent / 100, rounded to cents).
+ * Includes bulk discount (2.5%) if qty >= 10, applied after the first discount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
   const discountPercent = line.discountPercent ?? 0;
-  return Math.max(0, roundCents(lineTotal(line) * discountPercent / 100));
+  const total = lineTotal(line);
+  const firstDiscount = Math.max(0, roundCents(total * discountPercent / 100));
+
+  // Bulk discount: 2.5% off the amount remaining after the first discount (if qty >= 10)
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const afterFirstDiscount = total - firstDiscount;
+    bulkDiscount = Math.max(0, roundCents(afterFirstDiscount * 2.5 / 100));
+  }
+
+  return firstDiscount + bulkDiscount;
 }
 
