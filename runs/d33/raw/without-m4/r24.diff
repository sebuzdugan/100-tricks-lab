+// Dashboard tests
+test('dashboard returns structure with all fields', () => {
+  const result = dashboard([], '2024-03-15');
+  assert.ok(result.counts);
+  assert.ok(result.outstanding !== undefined);
+  assert.ok(result.overdue);
+  assert.ok(result.topCustomers);
+});
+
+test('dashboard with empty invoice list', () => {
+  const result = dashboard([], '2024-03-15');
+  assert.deepEqual(result.counts, { draft: 0, issued: 0, partially_paid: 0, paid: 0 });
+  assert.equal(result.outstanding, 0);
+  assert.deepEqual(result.overdue, { count: 0, amount: 0 });
+  assert.deepEqual(result.topCustomers, []);
+});
+
+test('dashboard counts invoices by status', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
