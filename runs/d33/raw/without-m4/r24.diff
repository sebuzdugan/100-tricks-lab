+/**
+ * Get dashboard summary of invoice metrics.
+ * @param {Array<{ status: string, customerId: string, payments?: Array, lines: Array }> invoices
+ * @param {string} asOf - Report cutoff date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    if (invoice.status in counts) {
+      counts[invoice.status]++;
+    }
+  }
+
+  // Calculate outstanding (issued or partially_paid)
+  let outstanding = 0;
+  const customerDues = new Map(); // Map of customerId -> totalDue
+
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      // Track customer dues
+      if (!customerDues.has(invoice.customerId)) {
+        customerDues.set(invoice.customerId, 0);
+      }
+      customerDues.set(invoice.customerId, customerDues.get(invoice.customerId) + due);
+    }
+  }
+
+  // Get overdue info
+  const overdueList = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdueList.reduce((sum, inv) => sum + inv.due, 0);
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueAmount,
+  };
+
+  // Get top 3 customers by due amount
+  const topCustomers = Array.from(customerDues.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
