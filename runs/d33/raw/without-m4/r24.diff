+
+  const issued = issueInvoice(draft.value, []);
+
+  const paid = recordPayment(issued.value, { amount: invoiceTotals(issued.value).total, date: '2024-03-16' });
+
+  const invoices = [draft.value, issued.value, paid.value];
+  const result = dashboard(invoices, '2024-03-15');
+
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.paid, 1);
+});
