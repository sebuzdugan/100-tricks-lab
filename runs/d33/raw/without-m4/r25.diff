 export function renderInvoiceText(invoice) {
@@ -24,21 +25,46 @@ export function renderInvoiceText(invoice) {
   // Customer name
   lines.push(customerName);
 
-  // Invoice lines
+  // Invoice lines with line discounts
   for (const line of invoice.lines) {
     const lineTotalCents = lineTotal(line);
     const formattedUnitPrice = formatEuros(line.unitPrice);
     const formattedLineTotal = formatEuros(lineTotalCents);
     lines.push(`${line.qty}x ${line.name} @ ${formattedUnitPrice} = ${formattedLineTotal}`);
+
+    // Show line discount if present
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      const formattedDiscount = formatEuros(discount);
+      lines.push(`  Discount: -${formattedDiscount}`);
+    }
   }
 
   // VAT line
   const formattedVat = formatEuros(totals.vat);
   lines.push(`VAT: ${formattedVat}`);
 
+  // Voucher line (if any)
+  if (invoice.voucher && invoice.voucher.amount > 0) {
+    const formattedVoucher = formatEuros(invoice.voucher.amount);
+    lines.push(`Voucher (${invoice.voucher.code}): -${formattedVoucher}`);
+  }
+
   // Total line
   const formattedTotal = formatEuros(totals.total);
   lines.push(`Total: ${formattedTotal}`);
 
+  // Due date line (if present)
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid amount line (if any payments)
+  if (invoice.payments && invoice.payments.length > 0) {
+    const amountPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const formattedPaid = formatEuros(amountPaid);
+    lines.push(`Paid: ${formattedPaid}`);
+  }
+
   return lines.join('\n');
 }
