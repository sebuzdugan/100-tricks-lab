diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..6158c3b
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,64 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create an invoice with the given customer, issue date, and line items.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Validate issueDate format (YYYY-MM-DD) and that it's a real date
+  const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!dateRegex.test(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+
+  const [year, month, day] = issueDate.split('-').map(Number);
+  const date = new Date(year, month - 1, day);
+  if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines is not empty and is an array
+  if (!Array.isArray(lines) || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Build invoice lines
+  const invoiceLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Get product details
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) {
+      return productResult;
+    }
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..7646999
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,157 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with lines from the catalogue', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 20 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2024-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+
+  assert.equal(result.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[0].qty, 10);
+  assert.equal(result.value.lines[0].unitPrice, 8500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+
+  assert.equal(result.value.lines[1].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[1].name, 'Development (hour)');
+  assert.equal(result.value.lines[1].qty, 20);
+  assert.equal(result.value.lines[1].unitPrice, 9500);
+  assert.equal(result.value.lines[1].vatRate, 21);
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for an unknown customer', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for invalid date format', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024/01/15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '15-01-2024',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports DATE_INVALID for non-existent dates', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-13-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports NO_LINES for an empty lines array', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [],
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports NO_LINES when lines is not an array', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: null,
+  }), { ok: false, error: 'NO_LINES' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: undefined,
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer quantities', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: '5' }],
+  }), { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for zero or negative quantities', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports UNKNOWN_SKU for a SKU not in the catalogue', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'NOPE-SKU', qty: 1 }],
+  }), { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate the input lines array', () => {
+  const originalLines = [
+    { sku: 'DES-HOUR', qty: 5 },
+    { sku: 'DEV-HOUR', qty: 10 },
+  ];
+  const lines = JSON.parse(JSON.stringify(originalLines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines,
+  });
+
+  assert.deepEqual(lines, originalLines);
+});
+
+test('createInvoice works with products of different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 9);
+  assert.equal(result.value.lines[1].vatRate, 0);
+});
