+
+test('addLine adds a new line to a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const result = addLine(invoice, { sku: 'DEV-HOUR', qty: 5 });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[1].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[1].qty, 5);
+  assert.equal(result.value.lines[1].name, 'Development (hour)');
+  assert.equal(result.value.lines[1].unitPrice, 9500);
+});
+
