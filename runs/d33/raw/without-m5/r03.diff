+/**
+ * Add or increase a line on a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string, qty: number, unitPrice: number, vatRate: number, name: string }> }} invoice
+ * @param {{ sku: string, qty: number }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Validate qty is positive integer
+  if (!Number.isInteger(qty) || qty <= 0) {
+    return fail('QTY_INVALID');
+  }
+
+  // Validate SKU exists in catalogue
+  const productResult = getProduct(sku);
+  if (!productResult.ok) {
+    return productResult;
+  }
+
+  const product = productResult.value;
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+  const existingLineIndex = newLines.findIndex((l) => l.sku === sku);
+
+  if (existingLineIndex >= 0) {
+    // Update existing line
+    newLines[existingLineIndex] = {
+      ...newLines[existingLineIndex],
+      qty: newLines[existingLineIndex].qty + qty,
+    };
+  } else {
+    // Add new line
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string }> }}
+ * @param {string} sku
+ */
+export function removeLine(invoice, sku) {
+  // Check status
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Find the line
+  const lineIndex = invoice.lines.findIndex((l) => l.sku === sku);
+  if (lineIndex < 0) {
+    return fail('LINE_NOT_FOUND');
+  }
+
+  // Check if it's the last line
+  if (invoice.lines.length === 1) {
+    return fail('NO_LINES');
+  }
+
+  const newLines = invoice.lines.filter((_, i) => i !== lineIndex);
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
