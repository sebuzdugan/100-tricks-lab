diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..e8a48b9
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,52 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns INV-<year>-0001 for the first invoice of a year', () => {
+  assert.equal(nextInvoiceNumber([], '2024-01-15'), 'INV-2024-0001');
+  assert.equal(nextInvoiceNumber([], '2025-06-30'), 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments the counter for the same year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0005'];
+  assert.equal(nextInvoiceNumber(existing, '2024-03-15'), 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = [
+    'INV-2023-0001',
+    'INV-2023-0002',
+    'INV-2024-0001',
+    'INV-2025-0001',
+    'INV-2025-0002',
+  ];
+  assert.equal(nextInvoiceNumber(existing, '2024-01-15'), 'INV-2024-0002');
+  assert.equal(nextInvoiceNumber(existing, '2025-01-15'), 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber restarts counter each year', () => {
+  const existing = ['INV-2024-0042'];
+  assert.equal(nextInvoiceNumber(existing, '2024-01-15'), 'INV-2024-0043');
+  assert.equal(nextInvoiceNumber(existing, '2025-01-15'), 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existing = ['INV-2024-0005', 'INV-2024-0001', 'INV-2024-0003'];
+  assert.equal(nextInvoiceNumber(existing, '2024-01-15'), 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  assert.equal(nextInvoiceNumber(existing, '2024-01-15'), 'INV-2024-0100');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = [
+    'INV-2024-0001',
+    'INVALID-2024-0001',
+    'INV-2024-ABC',
+    'INV-XXXX-0001',
+    'INV-2024-1',
+  ];
+  assert.equal(nextInvoiceNumber(existing, '2024-01-15'), 'INV-2024-0002');
+});
