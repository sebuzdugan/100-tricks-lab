--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,23 @@
+/**
+ * Get the next free invoice number for a given issue date.
+ * Format: INV-<year>-<counter>, where counter is 4 digits, zero-padded, restarting each year.
+ * @param {Array<string>} existingNumbers - invoice numbers already used, in any order
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const pattern = new RegExp(`^INV-${year}-(\\d{4})$`);
+
+  const counters = existingNumbers
+    .map((num) => {
+      const match = pattern.exec(num);
+      return match ? parseInt(match[1], 10) : null;
+    })
+    .filter((c) => c !== null);
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
