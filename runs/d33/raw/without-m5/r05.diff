+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown';
+
+  // Invoice header
+  const number = invoice.number ?? 'DRAFT';
+  const output = [number, customerName];
+
+  // Line items
+  for (const line of invoice.lines) {
+    const total = line.qty * line.unitPrice;
+    const lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    output.push(lineText);
+  }
+
+  // Total
+  const totals = invoiceTotals(invoice);
+  output.push(`Total: ${formatEuros(totals.total)}`);
+
+  return output.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..ae1f3bb
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,145 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unpublished invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows the invoice number when issued', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2024-0001');
+});
+
+test('renderInvoiceText shows the customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText formats line items with quantities and totals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /^10 × Design work \(hour\) @ €85\.00 = €850\.00$/);
+  assert.match(lines[3], /^100 × Sticker sheet @ €0\.50 = €50\.00$/);
+});
+
+test('renderInvoiceText formats amounts with thousands separators', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /€2,400\.00/);
+});
+
+test('renderInvoiceText shows the total at the end', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 20 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lastLine = text.split('\n').pop();
+
+  assert.match(lastLine, /^Total: €/);
+});
+
+test('renderInvoiceText calculates the correct total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lastLine = text.split('\n').pop();
+
+  // 10 × 8500 + 100 × 50 = 85000 + 5000 = 90000 cents = €900.00
+  assert.equal(lastLine, 'Total: €900.00');
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 6); // number, customer, 3 lines, total
+  assert.match(lines[2], /Design work/);
+  assert.match(lines[3], /Development/);
+  assert.match(lines[4], /Copywriting/);
+});
+
+test('renderInvoiceText preserves line order', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 1 },
+      { sku: 'ICON-SET', qty: 10 },
+      { sku: 'STICKER', qty: 50 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /Brand guidelines/);
+  assert.match(lines[3], /Icon set/);
+  assert.match(lines[4], /Sticker sheet/);
+});
