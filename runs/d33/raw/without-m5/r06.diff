+});
+
+test('addLine defaults discountPercent to 0 when omitted', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const result = addLine(invoice, { sku: 'DEV-HOUR', qty: 5 });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 0);
+});
+
+test('addLine reports DISCOUNT_INVALID for invalid discounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  assert.deepEqual(addLine(invoice, { sku: 'DEV-HOUR', qty: 5, discountPercent: 150 }), { ok: false, error: 'DISCOUNT_INVALID' });
+  assert.deepEqual(addLine(invoice, { sku: 'DEV-HOUR', qty: 5, discountPercent: 'invalid' }), { ok: false, error: 'DISCOUNT_INVALID' });
+});
