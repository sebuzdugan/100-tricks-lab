   assert.equal('number' in invoice, hasNumber);
 });
+
+test('createInvoice accepts discountPercent on a line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice defaults discountPercent to 0 when omitted', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice accepts decimal discount percentages', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 12.5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 12.5);
+});
+
+test('createInvoice reports DISCOUNT_INVALID for discounts outside 0-100', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: -5 }],
+  }), { ok: false, error: 'DISCOUNT_INVALID' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 101 }],
+  }), { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('createInvoice reports DISCOUNT_INVALID for non-numeric discounts', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: '50' }],
+  }), { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('invoiceTotals returns subtotal, discount, and total', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 8500);
+  assert.equal(totals.total, 76500);
+});
+
+test('invoiceTotals calculates discount correctly with multiple lines', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 10 },
