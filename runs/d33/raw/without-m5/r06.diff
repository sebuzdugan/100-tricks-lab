+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000 + 190000);
+  assert.equal(totals.discount, 8500 + 9500);
+  assert.equal(totals.total, 275000 - 18000);
+});
+
