+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // Line 1: total=100000, discount=10000, afterDiscount=90000, VAT=18900
+  // Line 2: total=50000, discount=0, afterDiscount=50000, VAT=10500
+  // Subtotal=150000, Discount=10000, VAT=29400, Total=150000-10000+29400=169400
+  assert.equal(totals.subtotal, 150000);
