+});
+
+test('createInvoice normalizes customer ID with spaces', () => {
+  const result = createInvoice({
+    customerId: '  c-007  ',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-007');
+});
+
+test('createInvoice normalizes mixed case with spaces', () => {
+  const result = createInvoice({
+    customerId: '  C-003  ',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
