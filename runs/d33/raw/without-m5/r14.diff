@@ -0,0 +1,193 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create an issued invoice for a specific customer
+function createIssuedForCustomer(customerId, issueDate) {
+  const created = createInvoice({
+    customerId,
+    issueDate,
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+    ],
+  });
+  const issued = issueInvoice(created.value, []);
+  return issued.value;
+}
+
+test('statement returns invoices for a customer', () => {
+  const invoice = createIssuedForCustomer('C-001', '2024-01-15');
+  const result = statement('C-001', [invoice], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice.number);
+});
+
+test('statement filters invoices by status (issued only)', () => {
+  const invoice1 = createIssuedForCustomer('C-001', '2024-01-15');
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = statement('C-001', [invoice1, draft], '2024-02-01');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice1.number);
+});
+
+test('statement filters invoices by date (on or before asOf)', () => {
+  const invoice1 = createIssuedForCustomer('C-001', '2024-01-15');
+  const invoice2 = createIssuedForCustomer('C-001', '2024-02-10');
+
+  const result = statement('C-001', [invoice1, invoice2], '2024-02-01');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+});
+
+test('statement includes invoice with issueDate equal to asOf', () => {
+  const invoice = createIssuedForCustomer('C-001', '2024-02-01');
+
+  const result = statement('C-001', [invoice], '2024-02-01');
+
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement filters by customer', () => {
+  const invoice1 = createIssuedForCustomer('C-001', '2024-01-15');
+  const invoice2 = createIssuedForCustomer('C-002', '2024-01-20');
+
+  const result = statement('C-001', [invoice1, invoice2], '2024-02-01');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice1.number);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoice1 = createIssuedForCustomer('C-001', '2024-03-15');
+  const invoice2 = createIssuedForCustomer('C-001', '2024-01-15');
+  const invoice3 = createIssuedForCustomer('C-001', '2024-02-15');
+
+  const result = statement('C-001', [invoice1, invoice2, invoice3], '2024-04-01');
+
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+  assert.equal(result.value.invoices[1].issueDate, '2024-02-15');
+  assert.equal(result.value.invoices[2].issueDate, '2024-03-15');
+});
+
+test('statement includes all required fields for each invoice', () => {
+  const invoice = createIssuedForCustomer('C-001', '2024-01-15');
+
+  const result = statement('C-001', [invoice], '2024-02-01');
+
+  const inv = result.value.invoices[0];
+  assert.ok(inv.number);
+  assert.ok(inv.issueDate);
+  assert.ok(inv.dueDate);
+  assert.equal(typeof inv.total, 'number');
+  assert.equal(typeof inv.due, 'number');
+});
+
+test('statement calculates totalDue as sum of individual due amounts', () => {
+  const invoice1 = createIssuedForCustomer('C-001', '2024-01-15');
+  const invoice2 = createIssuedForCustomer('C-001', '2024-02-15');
+
+  const result = statement('C-001', [invoice1, invoice2], '2024-03-01');
+
+  const expectedTotal = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(result.value.totalDue, expectedTotal);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invoice = createIssuedForCustomer('C-001', '2024-01-15');
+  const partial = recordPayment(invoice, { amount: 5000, date: '2024-01-20' }).value;
+
+  const result = statement('C-001', [partial], '2024-02-01');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due > 0, true);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoice = createIssuedForCustomer('C-001', '2024-01-15');
+  const totals = invoiceTotals(invoice);
+  const paidResult = recordPayment(invoice, { amount: totals.total, date: '2024-01-20' });
+
+  assert.equal(paidResult.ok, true);
+  const result = statement('C-001', [paidResult.value], '2024-02-01');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoice = createIssuedForCustomer('C-001', '2024-01-15');
+
+  const result = statement('C-999', [invoice], '2024-02-01');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement returns empty list for no matching invoices', () => {
+  const invoice = createIssuedForCustomer('C-001', '2024-03-15');
+
+  const result = statement('C-001', [invoice], '2024-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement handles invoices with vouchers', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const withVoucher = applyVoucher(draft, { code: 'SUMMER20', amount: 5000 }).value;
+  const issued = issueInvoice(withVoucher, []).value;
+
+  const result = statement('C-001', [issued], '2024-02-01');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(typeof result.value.invoices[0].due, 'number');
+});
+
+test('statement with multiple customers and dates', () => {
+  const c1_inv1 = createIssuedForCustomer('C-001', '2024-01-10');
+  const c1_inv2 = createIssuedForCustomer('C-001', '2024-02-10');
+  const c2_inv1 = createIssuedForCustomer('C-002', '2024-01-15');
+
+  const result = statement('C-001', [c1_inv1, c1_inv2, c2_inv1], '2024-02-01');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-10');
+});
+
+test('statement totalDue correctly reflects balance after partial payment', () => {
+  const invoice1 = createIssuedForCustomer('C-001', '2024-01-15');
+  const invoice2 = createIssuedForCustomer('C-001', '2024-02-15');
+
+  const partial = recordPayment(invoice1, { amount: 5000, date: '2024-01-20' }).value;
+
+  const result = statement('C-001', [partial, invoice2], '2024-03-01');
+
+  const expectedTotal = result.value.invoices[0].due + result.value.invoices[1].due;
+  assert.equal(result.value.totalDue, expectedTotal);
+});
+
+test('statement preserves invoice state (immutability)', () => {
+  const invoice = createIssuedForCustomer('C-001', '2024-01-15');
+  const originalNumber = invoice.number;
+
+  statement('C-001', [invoice], '2024-02-01');
+
+  assert.equal(invoice.number, originalNumber);
+});
