+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const pattern = new RegExp(`^CN-${year}-(\\d{4})$`);
+
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const match = pattern.exec(num);
+    if (match) {
+      const counter = Number(match[1]);
+      if (counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `CN-${year}-${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for a refund on an issued invoice.
+ * @param {{ total: number, status: string, number: string, customerId: string }} invoice - The invoice being credited
+ * @param {{ amount: number, reason: string, date: string }} creditData - Credit note details
+ * @param {Array<string>} existingNumbers - All existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, creditData, existingNumbers) {
+  // Check invoice is in an issued state
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  const { amount, reason, date } = creditData;
+
+  // Validate date format
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate amount does not exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
