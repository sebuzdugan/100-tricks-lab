diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..d4e5c94
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,216 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create an issued invoice
+function createIssuedInvoice(customerId = 'C-001', issueDate = '2024-01-15') {
+  const created = createInvoice({
+    customerId,
+    issueDate,
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+    ],
+  });
+  const issued = issueInvoice(created.value, []);
+  return issued.value;
+}
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Damaged goods', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, invoice.customerId);
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Damaged goods');
+  assert.equal(result.value.date, '2024-01-20');
+});
+
+test('createCreditNote creates a credit note for a partially_paid invoice', () => {
+  const invoice = createIssuedInvoice();
+  const partial = recordPayment(invoice, { amount: 5000, date: '2024-01-20' }).value;
+
+  const result = createCreditNote(partial, { amount: 3000, reason: 'Partial refund', date: '2024-01-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 3000);
+});
+
+test('createCreditNote creates a credit note for a paid invoice', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2024-01-20' }).value;
+
+  const result = createCreditNote(paid, { amount: 5000, reason: 'Full refund', date: '2024-01-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 5000);
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = createCreditNote(draft, { amount: 5000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: -1000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 0, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1000.5, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: totals.total + 1000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote allows credit up to invoice total', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote rejects invalid date format', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024/01/20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createCreditNote generates CN number with correct format', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.match(result.value.number, /^CN-\d{4}-\d{4}$/);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote increments counter for same year', () => {
+  const invoice = createIssuedInvoice();
+  const result1 = createCreditNote(invoice, { amount: 5000, reason: 'Refund 1', date: '2024-01-20' }, []);
+  const result2 = createCreditNote(invoice, { amount: 3000, reason: 'Refund 2', date: '2024-02-15' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2024-0001');
+  assert.equal(result2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote restarts counter for different year', () => {
+  const invoice = createIssuedInvoice();
+  const result1 = createCreditNote(invoice, { amount: 5000, reason: 'Refund 1', date: '2024-01-20' }, []);
+
+  const invoice2 = createIssuedInvoice('C-001', '2025-01-15');
+  const result2 = createCreditNote(invoice2, { amount: 3000, reason: 'Refund 2', date: '2025-02-15' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2024-0001');
+  assert.equal(result2.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote separates counter from invoices', () => {
+  const invoice = createIssuedInvoice();
+
+  // Simulate having invoice numbers
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003'];
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024-01-20' }, existingNumbers);
+
+  // Should not be affected by invoice numbers
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  const invoice = createIssuedInvoice();
+
+  // Simulate having both types of numbers
+  const existingNumbers = ['INV-2024-0001', 'CN-2024-0001', 'CN-2024-0002', 'INV-2024-0002'];
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024-01-20' }, existingNumbers);
+
+  // Should continue from highest credit note number
+  assert.equal(result.value.number, 'CN-2024-0003');
+});
+
+test('createCreditNote zero-pads counter to 4 digits', () => {
+  const invoice = createIssuedInvoice();
+
+  // Simulate having 9999 credit notes (edge case for padding)
+  const existingNumbers = Array.from({ length: 9999 }, (_, i) => `CN-2024-${String(i + 1).padStart(4, '0')}`);
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024-01-20' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2024-10000');
+});
+
+test('createCreditNote preserves invoice relationship', () => {
+  const invoice1 = createIssuedInvoice('C-001', '2024-01-15');
+  const invoice2 = createIssuedInvoice('C-002', '2024-01-20');
+
+  const result1 = createCreditNote(invoice1, { amount: 5000, reason: 'Refund 1', date: '2024-02-01' }, []);
+  const result2 = createCreditNote(invoice2, { amount: 3000, reason: 'Refund 2', date: '2024-02-05' }, [result1.value.number]);
+
+  assert.equal(result1.value.invoiceNumber, invoice1.number);
+  assert.equal(result1.value.customerId, 'C-001');
+
+  assert.equal(result2.value.invoiceNumber, invoice2.number);
+  assert.equal(result2.value.customerId, 'C-002');
+});
+
+test('createCreditNote includes all required fields', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Quality issue', date: '2024-01-20' }, []);
+
+  const cn = result.value;
+  assert.ok(cn.number);
+  assert.ok(cn.invoiceNumber);
+  assert.ok(cn.customerId);
+  assert.equal(typeof cn.amount, 'number');
+  assert.equal(cn.reason, 'Quality issue');
+  assert.ok(cn.date);
+});
+
+test('createCreditNote does not mutate invoice', () => {
+  const invoice = createIssuedInvoice();
+  const originalNumber = invoice.number;
+  const originalStatus = invoice.status;
+
+  createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(invoice.number, originalNumber);
+  assert.equal(invoice.status, originalStatus);
+});
