+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Generate a report of overdue invoices.
+ * @param {Array} invoices - All invoices
+ * @param {string} asOf - Report date (YYYY-MM-DD), invoices overdue as of this date
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter(inv => inv.dueDate < asOf)
+    .map(inv => {
+      const daysOverdue = daysBetween(inv.dueDate, asOf);
+      const due = balanceDue(inv);
+      return {
+        number: inv.number,
+        customerId: inv.customerId,
+        dueDate: inv.dueDate,
+        daysOverdue,
+        due,
+      };
+    })
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
diff --git a/test/reports.test.js b/test/reports.test.js
new file mode 100644
index 0000000..2af86cb
--- /dev/null
+++ b/test/reports.test.js
@@ -0,0 +1,201 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create an issued invoice with a specific due date
+function createIssuedWithDueDate(customerId = 'C-001', issueDate = '2024-01-15', dueDate = '2024-02-14') {
+  const created = createInvoice({
+    customerId,
+    issueDate,
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+    ],
+  }).value;
+  const issued = issueInvoice(created, []).value;
+  // Manually set dueDate for testing (in real use, terms would be set)
+  return {
+    ...issued,
+    dueDate,
+  };
+}
+
+test('overdueInvoices returns invoices with dueDate before asOf', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const result = overdueInvoices([invoice], '2024-02-20');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoice.number);
+  assert.equal(result[0].customerId, 'C-001');
+});
+
+test('overdueInvoices excludes invoices with dueDate equal to asOf', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const result = overdueInvoices([invoice], '2024-02-14');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices with dueDate after asOf', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-20');
+  const result = overdueInvoices([invoice], '2024-02-14');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices filters by status (issued only)', () => {
+  const issued = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  draft.dueDate = '2024-02-14';
+
+  const result = overdueInvoices([issued, draft], '2024-02-20');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.number);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const issued = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const partial = recordPayment(issued, { amount: 5000, date: '2024-02-15' }).value;
+
+  const result = overdueInvoices([partial], '2024-02-20');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.number);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const issued = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2024-02-15' }).value;
+
+  const result = overdueInvoices([paid], '2024-02-20');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const result = overdueInvoices([invoice], '2024-02-20');
+
+  // 2024-02-20 minus 2024-02-14 = 6 days
+  assert.equal(result[0].daysOverdue, 6);
+});
+
+test('overdueInvoices calculates due amount from balanceDue', () => {
+  const issued = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const partial = recordPayment(issued, { amount: 5000, date: '2024-02-15' }).value;
+  const totals = invoiceTotals(partial);
+
+  const result = overdueInvoices([partial], '2024-02-20');
+
+  const expectedDue = totals.total - 5000;
+  assert.equal(result[0].due, expectedDue);
+});
+
+test('overdueInvoices sorts by daysOverdue (most overdue first)', () => {
+  const invoice1 = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const invoice2 = createIssuedWithDueDate('C-002', '2024-01-20', '2024-02-19');
+  const invoice3 = createIssuedWithDueDate('C-003', '2024-01-10', '2024-02-09');
+
+  const result = overdueInvoices([invoice1, invoice2, invoice3], '2024-02-20');
+
+  assert.equal(result.length, 3);
+  // invoice3: 2024-02-20 - 2024-02-09 = 11 days (most overdue)
+  // invoice1: 2024-02-20 - 2024-02-14 = 6 days
+  // invoice2: 2024-02-20 - 2024-02-19 = 1 day (least overdue)
+  assert.equal(result[0].daysOverdue, 11);
+  assert.equal(result[1].daysOverdue, 6);
+  assert.equal(result[2].daysOverdue, 1);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-20');
+  const result = overdueInvoices([invoice], '2024-02-14');
+
+  assert.equal(result.length, 0);
+  assert.ok(Array.isArray(result));
+});
+
+test('overdueInvoices includes all required fields', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const result = overdueInvoices([invoice], '2024-02-20');
+
+  const overdue = result[0];
+  assert.ok(overdue.number);
+  assert.ok(overdue.customerId);
+  assert.ok(overdue.dueDate);
+  assert.equal(typeof overdue.daysOverdue, 'number');
+  assert.equal(typeof overdue.due, 'number');
+});
+
+test('overdueInvoices handles multiple customers', () => {
+  const invoice1 = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const invoice2 = createIssuedWithDueDate('C-002', '2024-01-15', '2024-02-14');
+  const invoice3 = createIssuedWithDueDate('C-003', '2024-01-15', '2024-02-14');
+
+  const result = overdueInvoices([invoice1, invoice2, invoice3], '2024-02-20');
+
+  assert.equal(result.length, 3);
+  assert.ok(result.some(r => r.customerId === 'C-001'));
+  assert.ok(result.some(r => r.customerId === 'C-002'));
+  assert.ok(result.some(r => r.customerId === 'C-003'));
+});
+
+test('overdueInvoices does not mutate input invoices', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const originalNumber = invoice.number;
+  const originalStatus = invoice.status;
+
+  overdueInvoices([invoice], '2024-02-20');
+
+  assert.equal(invoice.number, originalNumber);
+  assert.equal(invoice.status, originalStatus);
+});
+
+test('overdueInvoices with large date difference', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-01', '2024-01-05');
+  const result = overdueInvoices([invoice], '2024-12-31');
+
+  assert.equal(result.length, 1);
+  // 2024-12-31 minus 2024-01-05 = 361 days (2024 is leap year)
+  assert.equal(result[0].daysOverdue, 361);
+});
+
+test('overdueInvoices year boundary', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2023-12-15', '2023-12-31');
+  const result = overdueInvoices([invoice], '2024-01-15');
+
+  assert.equal(result.length, 1);
+  // 2024-01-15 minus 2023-12-31 = 15 days
+  assert.equal(result[0].daysOverdue, 15);
+});
+
+test('overdueInvoices mixed statuses', () => {
+  const issued = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2024-02-15' }).value;
+  paid.dueDate = '2024-02-14';
+
+  const partial = createIssuedWithDueDate('C-002', '2024-01-15', '2024-02-14');
+  const partial2 = recordPayment(partial, { amount: 5000, date: '2024-02-15' }).value;
+
+  const result = overdueInvoices([issued, paid, partial2], '2024-02-20');
+
+  // Should include issued and partially_paid, exclude paid
+  assert.equal(result.length, 2);
+  assert.ok(result.some(r => r.customerId === 'C-001'));
+  assert.ok(result.some(r => r.customerId === 'C-002'));
+});
+
+test('overdueInvoices with empty array', () => {
+  const result = overdueInvoices([], '2024-02-20');
+
+  assert.equal(result.length, 0);
+  assert.ok(Array.isArray(result));
+});
