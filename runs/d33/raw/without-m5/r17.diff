 /**
  * Generate a report of overdue invoices.
@@ -26,3 +27,36 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Generate a VAT summary report over invoices.
+ * @param {Array} invoices - All invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const lineTotal = line.qty * line.unitPrice;
+      const discountPercent = line.discountPercent ?? 0;
+      const lineDiscount = roundCents(lineTotal * discountPercent / 100);
+      const lineBase = lineTotal - lineDiscount;
+      const lineVAT = roundCents(lineBase * line.vatRate / 100);
+
+      const rate = line.vatRate;
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { rate, base: 0, vat: 0 };
+      }
+      vatByRate[rate].base += lineBase;
+      vatByRate[rate].vat += lineVAT;
+    }
+  }
+
+  const summary = Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
+  return summary;
+}
