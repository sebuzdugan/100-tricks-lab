+
+test('lateFee returns 0 for invoice not yet due', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+
+  const fee = lateFee(invoice, '2024-02-14');
+
+  assert.equal(fee, 0);
+});
+
+test('lateFee returns 0 for invoice due in the future', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-20');
+
+  const fee = lateFee(invoice, '2024-02-14');
+
+  assert.equal(fee, 0);
+});
+
+test('lateFee calculates fee for 1 day overdue', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const totals = invoiceTotals(invoice);
+
+  const fee = lateFee(invoice, '2024-02-15');
+
+  // Fee = total * 1 day * 0.04% = total * 0.0004
+  const expectedFee = Math.round(totals.total * 1 * 0.0004);
+  assert.equal(fee, expectedFee);
+});
+
+test('lateFee calculates fee for multiple days overdue', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const totals = invoiceTotals(invoice);
+
+  const fee = lateFee(invoice, '2024-02-24');
+
+  // 10 days overdue
+  // Fee = total * 10 * 0.04% = total * 0.004
+  const expectedFee = Math.round(totals.total * 10 * 0.0004);
+  assert.equal(fee, expectedFee);
+});
+
+test('lateFee uses balanceDue not invoice total', () => {
+  const issued = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const partial = recordPayment(issued, { amount: 5000, date: '2024-02-15' }).value;
+  const totals = invoiceTotals(partial);
+  const due = totals.total - 5000;
+
+  const fee = lateFee(partial, '2024-02-24');
+
+  // 10 days overdue on remaining balance
+  const expectedFee = Math.round(due * 10 * 0.0004);
+  assert.equal(fee, expectedFee);
+});
+
+test('lateFee rounds fractional cents', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
