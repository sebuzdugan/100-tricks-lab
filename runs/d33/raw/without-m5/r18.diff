+
+test('lateFee returns positive number', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+
+  const fee = lateFee(invoice, '2024-02-20');
+
+  assert.ok(fee >= 0);
