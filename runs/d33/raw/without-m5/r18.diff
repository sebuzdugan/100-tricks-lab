+test('lateFee with large day difference', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-01', '2024-01-05');
+  const totals = invoiceTotals(invoice);
+
+  const fee = lateFee(invoice, '2024-12-31');
+
+  // 361 days overdue (from Jan 5 to Dec 31 in leap year)
