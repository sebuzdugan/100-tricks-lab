+++ b/src/reports.js
@@ -60,3 +60,23 @@ export function vatSummary(invoices) {
   const summary = Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
   return summary;
 }
+
+/**
+ * Calculate late fee for an invoice.
+ * Late fee is 0.04% of the amount due for each day overdue.
+ * @param {{ dueDate: string }} invoice - The invoice
+ * @param {string} asOf - Report date (YYYY-MM-DD)
+ * @returns {number} Late fee in cents, rounded
+ */
+export function lateFee(invoice, asOf) {
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  const fee = roundCents(due * daysOverdue * 0.0004);
+
+  return fee;
+}
