@@ -0,0 +1,245 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+// Helper to create an issued invoice with a specific due date
+function createIssuedWithDueDate(customerId = 'C-001', issueDate = '2024-01-15', dueDate = '2024-02-14') {
+  const created = createInvoice({
+    customerId,
+    issueDate,
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+    ],
+  });
+  const issued = issueInvoice(created.value, []);
+  return {
+    ...issued.value,
+    dueDate,
+  };
+}
+
+test('exportCsv returns string', () => {
+  const result = exportCsv([]);
+
+  assert.equal(typeof result, 'string');
+});
+
+test('exportCsv includes header line', () => {
+  const result = exportCsv([]);
+
+  assert.ok(result.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoice = createIssuedWithDueDate();
+  const result = exportCsv([invoice]);
+
+  const lines = result.split('\n').filter(l => l);
+  assert.equal(lines.length, 2);
+  assert.ok(lines[0].includes('number,customer'));
+  assert.ok(lines[1].includes(invoice.number));
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const invoice1 = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const invoice2 = createIssuedWithDueDate('C-002', '2024-01-20', '2024-02-19');
+
+  const result = exportCsv([invoice1, invoice2]);
+
+  const lines = result.split('\n').filter(l => l);
+  assert.equal(lines.length, 3);
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = createIssuedWithDueDate('C-001');
+  const result = exportCsv([invoice]);
+
+  assert.ok(result.includes('Northwind Studio'));
+});
+
+test('exportCsv includes invoice dates', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const result = exportCsv([invoice]);
+
+  assert.ok(result.includes('2024-01-15'));
+  assert.ok(result.includes('2024-02-14'));
+});
+
+test('exportCsv includes invoice status', () => {
+  const invoice = createIssuedWithDueDate();
+  const result = exportCsv([invoice]);
+
+  assert.ok(result.includes('issued'));
+});
+
+test('exportCsv formats amounts with 2 decimals and dot', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const result = exportCsv([invoice]);
+
+  // Amounts should have 2 decimal places with dot separator
+  assert.ok(/\d+\.\d{2}/.test(result));
+  // Should not have thousands separator
+  assert.equal(result.includes(',000'), false);
+});
+
+test('exportCsv does not include currency sign', () => {
+  const invoice = createIssuedWithDueDate();
+  const result = exportCsv([invoice]);
+
+  // Exclude header line and only check amount fields
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  // Fields 5-9 are amounts
+  for (let i = 5; i < 10; i++) {
+    assert.equal(fields[i].includes('€'), false);
+  }
+});
+
+test('exportCsv escapes fields with commas', () => {
+  const invoice = createIssuedWithDueDate('C-003', '2024-01-15', '2024-02-14'); // Kite & Co
+  const result = exportCsv([invoice]);
+
+  // Fields with commas should be quoted
+  assert.ok(result.includes('"Kite & Co"') || result.includes('Kite & Co'));
+});
+
+test('exportCsv escapes fields with quotes', () => {
+  const invoices = [];
+
+  // Manually create an invoice with a quote in the name
+  const invoice = createIssuedWithDueDate('C-006', '2024-01-15', '2024-02-14');
+  // C-006 is Marlow "The Print Shop"
+  invoices.push(invoice);
+
+  const result = exportCsv(invoices);
+
+  // Quotes should be escaped (doubled)
+  assert.ok(result.includes('Marlow ""The Print Shop""') || result.includes('Marlow "The Print Shop"'));
+});
+
+test('exportCsv includes all field values in correct order', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const totals = invoiceTotals(invoice);
+  const result = exportCsv([invoice]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  // Check order: number, customer, issueDate, dueDate, status, subtotal, discount, vat, total, due
+  assert.ok(dataLine.includes(invoice.number));
+  assert.ok(dataLine.includes('Northwind Studio'));
+  assert.ok(dataLine.includes('2024-01-15'));
+  assert.ok(dataLine.includes('2024-02-14'));
+  assert.ok(dataLine.includes('issued'));
+});
+
+test('exportCsv returns empty array as header only', () => {
+  const result = exportCsv([]);
+
+  const lines = result.split('\n').filter(l => l);
+  assert.equal(lines.length, 1);
+  assert.ok(lines[0].includes('number,customer'));
+});
+
+test('exportCsv ends with newline', () => {
+  const invoice = createIssuedWithDueDate();
+  const result = exportCsv([invoice]);
+
+  assert.equal(result[result.length - 1], '\n');
+});
+
+test('exportCsv lines are separated by newline', () => {
+  const invoice1 = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const invoice2 = createIssuedWithDueDate('C-002', '2024-01-20', '2024-02-19');
+
+  const result = exportCsv([invoice1, invoice2]);
+
+  const lines = result.split('\n').filter(l => l);
+  assert.equal(lines.length, 3);
+});
+
+test('exportCsv includes amounts from invoiceTotals', () => {
+  const invoice = createIssuedWithDueDate();
+  const totals = invoiceTotals(invoice);
+  const result = exportCsv([invoice]);
+
+  // Check that totals are included
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  assert.ok(dataLine.includes(totals.subtotal / 100));
+});
+
+test('exportCsv includes due amount from balanceDue', () => {
+  const issued = createIssuedWithDueDate();
+  const partial = recordPayment(issued, { amount: 5000, date: '2024-02-15' }).value;
+  partial.dueDate = '2024-02-14';
+
+  const result = exportCsv([partial]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  // Due should be included (not the full total)
+  assert.ok(dataLine.includes('partially_paid'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invoice1 = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const invoice2 = createIssuedWithDueDate('C-002', '2024-01-20', '2024-02-19');
+  const invoice3 = createIssuedWithDueDate('C-003', '2024-01-25', '2024-02-24');
+
+  const result = exportCsv([invoice1, invoice2, invoice3]);
+
+  const lines = result.split('\n').filter(l => l);
+  // Check order by looking for invoice numbers
+  assert.ok(lines[1].includes(invoice1.number));
+  assert.ok(lines[2].includes(invoice2.number));
+  assert.ok(lines[3].includes(invoice3.number));
+});
+
+test('exportCsv does not mutate invoices', () => {
+  const invoice = createIssuedWithDueDate();
+  const originalNumber = invoice.number;
+  const originalStatus = invoice.status;
+
+  exportCsv([invoice]);
+
+  assert.equal(invoice.number, originalNumber);
+  assert.equal(invoice.status, originalStatus);
+});
+
+test('exportCsv with various amount values', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const result = exportCsv([invoice]);
+
+  // Check that amounts are formatted correctly
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  // Last part should be due amount (after last comma)
+  const dueStr = parts[parts.length - 1];
+  assert.ok(/^\d+\.\d{2}$/.test(dueStr), 'Due amount should be formatted as X.XX');
+});
+
+test('exportCsv handles zero amounts', () => {
+  const invoice = createIssuedWithDueDate('C-001', '2024-01-15', '2024-02-14');
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2024-02-15' }).value;
+  paid.dueDate = '2024-02-14';
+
+  const result = exportCsv([paid]);
+
+  // Due should be 0.00
+  assert.ok(result.includes('0.00'));
+});
+
+test('exportCsv with special characters in customer name', () => {
+  const invoice = createIssuedWithDueDate('C-006', '2024-01-15', '2024-02-14');
+  const result = exportCsv([invoice]);
+
+  // Should handle quotes properly
+  assert.ok(result.length > 0);
+});
