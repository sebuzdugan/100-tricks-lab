+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros with 2 decimal places and dot separator.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: wrap in quotes if it contains comma or quote, and double any quotes.
+ * @param {string} value
+ * @returns {string}
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices - Invoices to export
+ * @returns {string} CSV string with header and invoice lines
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header line
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Invoice lines
+  for (const invoice of invoices) {
+    const customer = getCustomer(invoice.customerId);
+    const customerName = customer.ok ? customer.value.name : '';
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      escapeCsvField(invoice.number),
+      escapeCsvField(customerName),
+      escapeCsvField(invoice.issueDate),
+      escapeCsvField(invoice.dueDate),
+      escapeCsvField(invoice.status),
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    lines.push(fields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
diff --git a/test/export.test.js b/test/export.test.js
