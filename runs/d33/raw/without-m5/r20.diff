@@ -0,0 +1,200 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { RATES, convert, formatMoney, roundCents } from '../src/money.js';
+
+test('RATES object exists', () => {
+  assert.ok(RATES);
+  assert.ok(RATES.EUR);
+  assert.ok(RATES.USD);
+  assert.ok(RATES.GBP);
+});
+
+test('RATES has correct values', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(100000, 'USD');
+
+  assert.equal(result.ok, true);
+  // 100000 cents = 1000 euros * 1.085 = 1085 dollars = 108500 cents
+  assert.equal(result.value, 108500);
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(100000, 'GBP');
+
+  assert.equal(result.ok, true);
+  // 100000 cents = 1000 euros * 0.8425 = 842.5 pounds = 84250 cents
+  assert.equal(result.value, 84250);
+});
+
+test('convert EUR to EUR', () => {
+  const result = convert(100000, 'EUR');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 100000);
+});
+
+test('convert rejects unknown currency', () => {
+  const result = convert(100000, 'JPY');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with small amount', () => {
+  const result = convert(1, 'USD');
+
+  assert.equal(result.ok, true);
+  // 1 cent = 0.01 euros * 1.085 = 0.01085 dollars = 1.085 cents -> rounds to 1
+  assert.equal(result.value, 1);
+});
+
+test('convert rounds fractional cents', () => {
+  const result = convert(12345, 'USD');
+
+  assert.equal(result.ok, true);
+  // 12345 cents = 123.45 euros * 1.085 = 133.8393 dollars = 13383.93 cents -> rounds
+  assert.equal(typeof result.value, 'number');
+  assert.equal(Number.isInteger(result.value), true);
+});
+
+test('convert handles zero', () => {
+  const result = convert(0, 'USD');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert with negative amount', () => {
+  const result = convert(-100000, 'USD');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -108500);
+});
+
+test('formatMoney EUR with positive amount', () => {
+  const result = formatMoney(123456, 'EUR');
+
+  assert.equal(result, '€1,234.56');
+});
+
+test('formatMoney USD with positive amount', () => {
+  const result = formatMoney(123456, 'USD');
+
+  assert.equal(result, '$1,234.56');
+});
+
+test('formatMoney GBP with positive amount', () => {
+  const result = formatMoney(123456, 'GBP');
+
+  assert.equal(result, '£1,234.56');
+});
+
+test('formatMoney with negative amount', () => {
+  const result = formatMoney(-5, 'USD');
+
+  assert.equal(result, '-$0.05');
+});
+
+test('formatMoney with zero', () => {
+  const result = formatMoney(0, 'EUR');
+
+  assert.equal(result, '€0.00');
+});
+
+test('formatMoney with large amount', () => {
+  const result = formatMoney(1234567890, 'USD');
+
+  assert.equal(result, '$12,345,678.90');
+});
+
+test('formatMoney includes thousands separators', () => {
+  const result = formatMoney(123456, 'GBP');
+
+  assert.ok(result.includes(','));
+});
+
+test('formatMoney with single digit cents', () => {
+  const result = formatMoney(1005, 'EUR');
+
+  assert.equal(result, '€10.05');
+});
+
+test('formatMoney with zero cents', () => {
+  const result = formatMoney(10000, 'USD');
+
+  assert.equal(result, '$100.00');
+});
+
+test('convert and format roundtrip EUR to USD', () => {
+  const original = 50000; // 500 euros
+  const converted = convert(original, 'USD');
+
+  assert.equal(converted.ok, true);
+  const formatted = formatMoney(converted.value, 'USD');
+
+  assert.ok(formatted.startsWith('$'));
+  assert.ok(formatted.includes('.'));
+});
+
+test('convert negative to USD', () => {
+  const result = convert(-100000, 'USD');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -108500);
+});
+
+test('formatMoney with unknown currency', () => {
+  const result = formatMoney(123456, 'UNKNOWN');
+
+  // Should format without symbol
+  assert.equal(result, '1,234.56');
+});
+
+test('convert case sensitivity', () => {
+  const result = convert(100000, 'usd');
+
+  // Should fail for lowercase
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert precision with USD', () => {
+  // Test that conversion maintains precision through rounding
+  const amounts = [1, 10, 100, 1000, 10000, 100000];
+
+  for (const amount of amounts) {
+    const result = convert(amount, 'USD');
+    assert.equal(result.ok, true);
+    assert.equal(Number.isInteger(result.value), true);
+  }
+});
+
+test('formatMoney negative EUR', () => {
+  const result = formatMoney(-123456, 'EUR');
+
+  assert.equal(result, '-€1,234.56');
+});
+
+test('formatMoney negative GBP', () => {
+  const result = formatMoney(-50, 'GBP');
+
+  assert.equal(result, '-£0.50');
+});
+
+test('convert USD to EUR (reverse)', () => {
+  // Convert 100000 EUR to USD
+  const usd = convert(100000, 'USD');
+
+  // Now convert back: (usd_cents / 100) / 1.085 * 1 * 100
+  // But we need to reverse the rate
+  const usd_cents = usd.value;
+  const eur_from_usd = roundCents((usd_cents / 100) / 1.085 * 100);
+
+  // Should be close to original (may differ due to rounding)
+  assert.ok(Math.abs(eur_from_usd - 100000) <= 10);
+});
