+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  const line = { qty: 10, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 85000);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { qty: 1, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 9500);
+});
+
+test('lineTotal with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 5000 };
+  assert.equal(lineTotal(line), 5000000);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('invoiceTotals with single line and no discount', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 20000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 4200);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 24200);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, vatRate: 21 },
+      { qty: 20, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 275000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 57750);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 332750);
+});
+
+test('invoiceTotals with discount on a line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  const lineTotal = 100000;
+  const lineDiscount = 10000;
+  const amountAfterDiscount = 90000;
+  const vat = 18900;
+
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, lineDiscount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 108900);
+});
+
+test('invoiceTotals with multiple lines with different discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+      { qty: 5, unitPrice: 20000, discountPercent: 5, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: 100000, discount 10000, after discount 90000, vat 18900
+  // Line 2: 100000, discount 5000, after discount 95000, vat 8550
+  assert.equal(totals.subtotal, 200000);
+  assert.equal(totals.discount, 15000);
+  assert.equal(totals.vat, 27450);
+  assert.equal(totals.total, 212450);
+});
+
+test('invoiceTotals with zero VAT rate', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 100000);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 116000);
+});
+
+test('invoiceTotals with discount and voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, discountPercent: 10, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 3000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 100000, discount 10000, after discount 90000, vat 18900
+  // Total: 100000 - 10000 + 18900 - 3000 = 105900
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 18900);
+  assert.equal(totals.voucher, 3000);
+  assert.equal(totals.total, 105900);
+});
+
+test('invoiceTotals with no voucher field returns 0 for voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with undefined voucher returns 0', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, vatRate: 21 }],
+    voucher: undefined,
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals clamps total at 0 if discount and voucher exceed subtotal+vat', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 0 }],
+    voucher: { code: 'HUGE', amount: 20000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 20000);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with decimal discount percentage', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, discountPercent: 12.5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 100000, discount 12500, after discount 87500, vat 18375
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 12500);
+  assert.equal(totals.vat, 18375);
+  assert.equal(totals.total, 105875);
+});
+
+test('invoiceTotals rounds VAT per line before summing', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10001, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 10001, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Each line: 10001, no discount, vat = 2100.21 rounds to 2100
+  // Total vat = 2100 + 2100 = 4200
+  assert.equal(totals.vat, 4200);
+});
+
+test('invoiceTotals with fractional cents in VAT calculation', () => {
+  const invoice = {
+    lines: [{ qty: 3, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 30000, vat = 6300
+  assert.equal(totals.vat, 6300);
+  assert.equal(totals.total, 36300);
+});
+
+test('invoiceTotals with large amounts', () => {
+  const invoice = {
+    lines: [{ qty: 10000, unitPrice: 100000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 1000000000);
+  assert.equal(totals.vat, 210000000);
+  assert.equal(totals.total, 1210000000);
+});
+
+test('invoiceTotals with zero amount', () => {
+  const invoice = {
+    lines: [{ qty: 0, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals does not mutate the invoice', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const originalLines = JSON.stringify(invoice.lines);
+  const originalVoucher = JSON.stringify(invoice.voucher);
+
+  invoiceTotals(invoice);
+
+  assert.equal(JSON.stringify(invoice.lines), originalLines);
+  assert.equal(JSON.stringify(invoice.voucher), originalVoucher);
+});
+
+test('invoiceTotals returns correct structure', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+  assert.equal(Object.keys(totals).length, 5);
+});
+
+test('lineTotal with different price points', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 1 }), 1);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 100 }), 10000);
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 1 }), 1000);
+});
+
+test('invoiceTotals with tier discount already applied', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 100000, discount 5000, after discount 95000, vat 19950
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 5000);
+  assert.equal(totals.vat, 19950);
+  assert.equal(totals.total, 114950);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, vatRate: 21 },
+      { qty: 5, unitPrice: 10000, vatRate: 9 },
+      { qty: 2, unitPrice: 10000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: 100000, vat 21000
+  // Line 2: 50000, vat 4500
+  // Line 3: 20000, vat 0
+  assert.equal(totals.subtotal, 170000);
+  assert.equal(totals.vat, 25500);
+  assert.equal(totals.total, 195500);
+});
+
+test('invoiceTotals with all discount, VAT, and voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+      { qty: 5, unitPrice: 10000, discountPercent: 5, vatRate: 9 },
+    ],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: 100000, discount 10000, after 90000, vat 18900
+  // Line 2: 50000, discount 2500, after 47500, vat 4275
+  // Total: 150000 - 12500 + 23175 - 5000 = 155675
+  assert.equal(totals.subtotal, 150000);
+  assert.equal(totals.discount, 12500);
+  assert.equal(totals.vat, 23175);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 155675);
+});
