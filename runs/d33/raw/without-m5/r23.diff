+test('invoiceTotals with bulk discount at threshold (qty=10)', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 100000, no line discount, bulk discount 2500, after 97500, vat 20475
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 2500);
+  assert.equal(totals.vat, 20475);
+  assert.equal(totals.total, 117975);
+});
+
+test('invoiceTotals without bulk discount below threshold (qty=9)', () => {
+  const invoice = {
+    lines: [{ qty: 9, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 90000, no discounts, vat 18900
+  assert.equal(totals.subtotal, 90000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 18900);
+  assert.equal(totals.total, 108900);
+});
+
+test('invoiceTotals bulk discount applied after line discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, discountPercent: 20, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 100000, line discount 20000, after 80000, bulk discount 2000, after 78000, vat 0
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 22000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 78000);
+});
+
+test('invoiceTotals bulk discount with high line discount', () => {
+  const invoice = {
+    lines: [{ qty: 20, unitPrice: 10000, discountPercent: 50, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 200000, line discount 100000, after 100000, bulk discount 2500, after 97500, vat 20475
+  assert.equal(totals.subtotal, 200000);
+  assert.equal(totals.discount, 102500);
+  assert.equal(totals.vat, 20475);
+  assert.equal(totals.total, 117975);
+});
+
+test('invoiceTotals bulk discount with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, vatRate: 21 },
+      { qty: 15, unitPrice: 5000, vatRate: 9 },
+      { qty: 8, unitPrice: 8000, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: 100000, bulk 2500, after 97500, vat 20475
+  // Line 2: 75000, bulk 1875, after 73125, vat 6581
+  // Line 3: 64000, no bulk, vat 13440
+  // Discount: 2500 + 1875 = 4375
+  // VAT: 20475 + 6581 + 13440 = 40496
+  // Total: 239000 - 4375 + 40496 = 275121
+  assert.equal(totals.subtotal, 239000);
+  assert.equal(totals.discount, 4375);
+  assert.equal(totals.vat, 40496);
+  assert.equal(totals.total, 275121);
+});
+
+test('invoiceTotals bulk discount with zero VAT', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 100000, bulk 2500, after 97500, vat 0
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 2500);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 97500);
+});
+
+test('invoiceTotals bulk discount rounding', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9999, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 99990, bulk 2499.75 → 2500, after 97490, vat 20472.9 → 20473
+  assert.equal(totals.subtotal, 99990);
+  assert.equal(totals.discount, 2500);
+  assert.equal(totals.vat, 20473);
+  assert.equal(totals.total, 117963);
+});
+
+test('invoiceTotals bulk discount with tier discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 10000, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line: 100000, line discount 5000, after 95000, bulk 2375, after 92625, vat 19451.25 → 19451
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 7375);
+  assert.equal(totals.vat, 19451);
+  assert.equal(totals.total, 112076);
