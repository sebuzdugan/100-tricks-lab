+/**
+ * Generate a dashboard summary of invoices.
+ * @param {Array} invoices - All invoices
+ * @param {string} asOf - Dashboard date (YYYY-MM-DD)
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] || 0) + 1;
+  }
+
+  // Calculate outstanding amount (issued + partially_paid)
+  let outstanding = 0;
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      outstanding += balanceDue(invoice);
+    }
+  }
+
+  // Get overdue information
+  const overdue = overdueInvoices(invoices, asOf);
+  let overdueAmount = 0;
+  for (const inv of overdue) {
+    overdueAmount += inv.due;
+  }
+
+  // Calculate top customers by amount due
+  const customerDue = {};
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const customerId = invoice.customerId;
+      const due = balanceDue(invoice);
+      customerDue[customerId] = (customerDue[customerId] || 0) + due;
+    }
+  }
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
