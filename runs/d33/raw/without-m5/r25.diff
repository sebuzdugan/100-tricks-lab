+    const lineTotal = line.qty * line.unitPrice;
+    let lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lineTotal)}`;
+
+    // Show line discount if present (from discountPercent or bulk discount)
+    const discountPercent = line.discountPercent ?? 0;
+    const lineDiscount = roundCents(lineTotal * discountPercent / 100);
+    let amountAfterDiscount = lineTotal - lineDiscount;
+    let bulkDiscount = 0;
+
+    if (line.qty >= 10 && amountAfterDiscount > 0) {
+      bulkDiscount = roundCents(amountAfterDiscount * 2.5 / 100);
+      amountAfterDiscount -= bulkDiscount;
+    }
+
+    const totalLineDiscount = lineDiscount + bulkDiscount;
+    if (totalLineDiscount > 0) {
