   if (totals.vat > 0) {
     output.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+
+  // Voucher if present
+  if (invoice.voucher && invoice.voucher.amount > 0) {
+    output.push(`Voucher ${invoice.voucher.code}: −${formatEuros(invoice.voucher.amount)}`);
+  }
+
   output.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date if present
+  if (invoice.dueDate) {
+    output.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid amount if there are payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    output.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return output.join('\n');
 }
