diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..3de5689
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,60 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates the first number for a year', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber generates sequential numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber restarts counter for each year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2026-0001'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0100', 'INV-2027-0050'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber zero-pads the counter to 4 digits', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003', 'INV-2026-0004', 'INV-2026-0005', 'INV-2026-0006', 'INV-2026-0007', 'INV-2026-0008', 'INV-2026-0009'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber handles numbers out of order', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber handles a large counter', () => {
+  const existing = ['INV-2026-0999'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2026-XXXX', 'INV-2026-0001', 'INVALID-0001'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber extracts year from issueDate correctly', () => {
+  const existing = ['INV-2024-0001'];
+  const num2024 = nextInvoiceNumber(existing, '2024-12-31');
+  const num2025 = nextInvoiceNumber(existing, '2025-01-01');
+  const num2026 = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(num2024, 'INV-2024-0002');
+  assert.equal(num2025, 'INV-2025-0001');
+  assert.equal(num2026, 'INV-2026-0001');
+});
