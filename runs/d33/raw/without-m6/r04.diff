@@ -0,0 +1,21 @@
+/**
+ * Generate the next invoice number for a given issue date.
+ * Format: INV-YYYY-#### where #### is a zero-padded counter starting at 0001 per year.
+ * @param {Array<string>} existingNumbers - array of invoice numbers already used, e.g. ['INV-2026-0001', 'INV-2026-0002']
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @returns {string} the next free invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length), 10))
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
