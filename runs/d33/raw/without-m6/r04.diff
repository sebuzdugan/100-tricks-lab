+
+test('issueInvoice assigns a number and changes status to issued', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.number, 'INV-2026-0001');
+  assert.equal(r2.value.status, 'issued');
+  assert.equal(r2.value.customerId, 'C-001');
+  assert.equal(r2.value.issueDate, '2026-10-07');
+});
+
+test('issueInvoice uses the next available number', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, ['INV-2026-0001', 'INV-2026-0002']);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.number, 'INV-2026-0003');
+});
+
+test('issueInvoice resets counter for different years', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, ['INV-2026-0099']);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.number, 'INV-2027-0001');
+});
+
+test('issueInvoice rejects non-draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const issued = { ...r1.value, status: 'issued' };
+  assert.deepEqual(issueInvoice(issued, []), { ok: false, error: 'NOT_DRAFT' });
+});
+
+test('issueInvoice does not mutate the original invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const invoiceCopy = JSON.parse(JSON.stringify(r1.value));
+  issueInvoice(r1.value, []);
+  assert.deepEqual(r1.value, invoiceCopy);
+});
+
