+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number, vatRate: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) {
+    throw new Error(`Customer not found: ${invoice.customerId}`);
+  }
+
+  const customer = customerResult.value;
+  const { total } = invoiceTotals(invoice);
+
+  const lines = [
+    invoice.number || 'DRAFT',
+    customer.name,
+    ...invoice.lines.map((line) => {
+      const lt = lineTotal(line);
+      return `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lt)}`;
+    }),
+    `Total: ${formatEuros(total)}`,
+  ];
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..37f1b36
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,147 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for an unsent invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows the invoice number if issued', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const text = renderInvoiceText(r2.value);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText shows the customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText formats a single line item', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /5 x Development \(hour\) @ €95\.00 = €475\.00/);
+});
+
+test('renderInvoiceText formats multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 2 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /5 x Development \(hour\) @ €95\.00 = €475\.00/);
+  assert.match(text, /2 x Design work \(hour\) @ €85\.00 = €170\.00/);
+});
+
+test('renderInvoiceText calculates the total correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 }, // €475
+      { sku: 'DES-HOUR', qty: 2 }, // €170
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Total: €645\.00/);
+});
+
+test('renderInvoiceText ends with the total line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Total: €95\.00\n?$/);
+});
+
+test('renderInvoiceText handles small prices correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /100 x Sticker sheet @ €0\.50 = €50\.00/);
+});
+
+test('renderInvoiceText handles large prices correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 2 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /2 x Brand guidelines document @ €2,450\.00 = €4,900\.00/);
+  assert.match(text, /Total: €4,900\.00/);
+});
+
+test('renderInvoiceText shows different customer names', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const text1 = renderInvoiceText(r1.value);
+  const text2 = renderInvoiceText(r2.value);
+  assert.match(text1, /Northwind Studio/);
+  assert.match(text2, /Kite & Co/);
+});
+
+test('renderInvoiceText throws for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 }],
+  };
+  assert.throws(() => renderInvoiceText(invoice), /Customer not found/);
+});
+
+test('renderInvoiceText produces readable multi-line output', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines.length, 6); // DRAFT + name + 3 lines + total
+  assert.match(lines[lines.length - 1], /^Total:/);
+});
