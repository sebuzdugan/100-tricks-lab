+/**
+ * Validate that a date string is in YYYY-MM-DD format and is a real date (UTC).
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+  const [year, month, day] = text.split('-').map(Number);
+  return date.getUTCFullYear() === year && date.getUTCMonth() + 1 === month && date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date string, returning a new date string (UTC).
+ * @param {string} date - YYYY-MM-DD format
+ * @param {number} n - number of days to add
+ * @returns {string} - new date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const [year, month, day] = date.split('-').map(Number);
+  const d = new Date(Date.UTC(year, month - 1, day));
+  d.setUTCDate(d.getUTCDate() + n);
+  const y = d.getUTCFullYear();
+  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const dd = String(d.getUTCDate()).padStart(2, '0');
+  return `${y}-${m}-${dd}`;
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a), in UTC.
+ * @param {string} a - YYYY-MM-DD format
+ * @param {string} b - YYYY-MM-DD format
+ * @returns {number} - number of days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const [ya, ma, da] = a.split('-').map(Number);
+  const [yb, mb, db] = b.split('-').map(Number);
+  const dateA = new Date(Date.UTC(ya, ma - 1, da));
+  const dateB = new Date(Date.UTC(yb, mb - 1, db));
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
