@@ -0,0 +1,132 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10/07/2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-01-32'), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2026-02-29'), false);
+  assert.equal(isValidDate('2100-02-29'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(20261007), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-28', 5), '2026-11-02');
+  assert.equal(addDays('2026-01-28', 5), '2026-02-02');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-30', 2), '2027-01-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays adds negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -7), '2026-09-30');
+});
+
+test('addDays handles negative days across month boundary', () => {
+  assert.equal(addDays('2026-11-02', -5), '2026-10-28');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays handles leap year transitions', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-10-28', '2026-11-02'), 5);
+  assert.equal(daysBetween('2026-11-02', '2026-10-28'), -5);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-30', '2027-01-01'), 2);
+  assert.equal(daysBetween('2027-01-01', '2026-12-30'), -2);
+});
+
+test('daysBetween with same dates returns 0', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+});
+
+test('daysBetween returns whole days', () => {
+  // Even though times might be different, we only care about whole days
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+  assert.equal(daysBetween('2026-01-01', '2026-02-01'), 31);
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+});
+
+test('daysBetween with large date ranges', () => {
+  assert.equal(daysBetween('2000-01-01', '2026-10-07'), 9776);
+  assert.equal(daysBetween('2026-10-07', '2000-01-01'), -9776);
+});
+
+test('isValidDate and addDays work together', () => {
+  const date = '2026-10-07';
+  assert.equal(isValidDate(date), true);
+  const newDate = addDays(date, 5);
+  assert.equal(isValidDate(newDate), true);
+  assert.equal(daysBetween(date, newDate), 5);
+});
+
+test('addDays and daysBetween are inverse operations', () => {
+  const date1 = '2026-10-07';
+  const date2 = addDays(date1, 15);
+  assert.equal(daysBetween(date1, date2), 15);
+  assert.equal(daysBetween(date2, date1), -15);
+});
