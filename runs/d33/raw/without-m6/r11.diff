+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('recordPayment rejects draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const result = recordPayment(inv.value, { amount: 1000, date: '2026-10-07' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment rejects paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-07' });
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.status, 'paid');
+
+  const result = recordPayment(paid.value, { amount: 1000, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment rejects invalid amount (not integer)', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = recordPayment(issued.value, { amount: 1000.50, date: '2026-10-07' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects zero amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = recordPayment(issued.value, { amount: 0, date: '2026-10-07' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects negative amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = recordPayment(issued.value, { amount: -1000, date: '2026-10-07' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects overpayment', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = recordPayment(issued.value, { amount: totals.total + 1, date: '2026-10-07' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment accepts payment equal to balance', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = recordPayment(issued.value, { amount: totals.total, date: '2026-10-07' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+  assert.deepEqual(result.value.payments, [{ amount: totals.total, date: '2026-10-07' }]);
+});
+
+test('recordPayment sets status to partially_paid for partial payment', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = recordPayment(issued.value, { amount: totals.total - 1000, date: '2026-10-07' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment accepts second payment on partially_paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const half = Math.floor(totals.total / 2);
+
+  const partial = recordPayment(issued.value, { amount: half, date: '2026-10-07' });
+  assert.equal(partial.ok, true);
+
+  const result = recordPayment(partial.value, { amount: totals.total - half, date: '2026-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+  assert.equal(result.value.payments.length, 2);
+});
+
+test('recordPayment accumulates payments', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const third = Math.floor(totals.total / 3);
+
+  let current = issued.value;
+  const dates = ['2026-10-07', '2026-10-08', '2026-10-09'];
+
+  for (const date of dates) {
+    const result = recordPayment(current, { amount: third, date });
+    assert.equal(result.ok, true);
+    current = result.value;
+  }
+
+  assert.equal(current.payments.length, 3);
+  const totalPaid = current.payments.reduce((sum, p) => sum + p.amount, 0);
+  assert.equal(totalPaid, third * 3);
+});
+
+test('recordPayment preserves invoice properties', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const original = issued.value;
+  const totals = invoiceTotals(original);
+
+  const result = recordPayment(original, { amount: 5000, date: '2026-10-07' });
+  assert.equal(result.ok, true);
+
+  assert.equal(result.value.customerId, original.customerId);
+  assert.equal(result.value.issueDate, original.issueDate);
+  assert.equal(result.value.number, original.number);
+  assert.deepEqual(result.value.lines, original.lines);
+});
+
+test('balanceDue returns total when no payments', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const balance = balanceDue(issued.value);
+  assert.equal(balance, totals.total);
+});
+
+test('balanceDue returns remainder after partial payment', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const partialAmount = Math.floor(totals.total / 2);
+  const payment = recordPayment(issued.value, { amount: partialAmount, date: '2026-10-07' });
+
+  const balance = balanceDue(payment.value);
+  assert.equal(balance, totals.total - partialAmount);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-07' });
+
+  const balance = balanceDue(paid.value);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue accounts for multiple payments', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const third = Math.floor(totals.total / 3);
+
+  let current = issued.value;
+  for (let i = 0; i < 2; i++) {
+    const result = recordPayment(current, { amount: third, date: `2026-10-0${7 + i}` });
+    current = result.value;
+  }
+
+  const balance = balanceDue(current);
+  assert.equal(balance, totals.total - third * 2);
+});
+
+test('balanceDue works on invoice without payments property', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  assert.equal(!('payments' in issued.value), true);
+  const balance = balanceDue(issued.value);
+  assert.equal(balance, totals.total);
+});
+
+test('recordPayment with VAT and discounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = recordPayment(issued.value, { amount: totals.total, date: '2026-10-07' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('balanceDue with VAT and discounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const half = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued.value, { amount: half, date: '2026-10-07' });
+
+  const balance = balanceDue(partial.value);
+  assert.equal(balance, totals.total - half);
+});
