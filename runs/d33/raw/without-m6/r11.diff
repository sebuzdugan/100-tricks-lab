+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Validate that an amount is a positive integer (in cents).
+ * @param {unknown} amount
+ * @returns {boolean}
+ */
+function isValidAmount(amount) {
+  return Number.isInteger(amount) && amount > 0;
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }>, lines: Array<any>, issueDate: string, customerId: string }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!isValidAmount(amount)) return fail('AMOUNT_INVALID');
+
+  const totals = invoiceTotals(invoice);
+  const currentPayments = invoice.payments ?? [];
+  const totalPaid = currentPayments.reduce((sum, p) => sum + p.amount, 0);
+  const owed = totals.total - totalPaid;
+
+  if (amount > owed) return fail('OVERPAYMENT');
+
+  const newPayments = [...currentPayments, { amount, date }];
+  const newTotalPaid = totalPaid + amount;
+  const newOwed = totals.total - newTotalPaid;
+
+  const newStatus = newOwed === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number, date: string }>, lines: Array<any>, issueDate: string, customerId: string }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const payments = invoice.payments ?? [];
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
