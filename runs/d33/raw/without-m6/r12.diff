@@ -0,0 +1,265 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, addLine } from '../src/invoices.js';
+import { daysBetween } from '../src/dates.js';
+
+test('createInvoice uses NET30 as default terms', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(daysBetween(result.value.issueDate, result.value.dueDate), 30);
+});
+
+test('createInvoice accepts NET14 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET14');
+  assert.equal(daysBetween(result.value.issueDate, result.value.dueDate), 14);
+});
+
+test('createInvoice accepts NET30 terms explicitly', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(daysBetween(result.value.issueDate, result.value.dueDate), 30);
+});
+
+test('createInvoice accepts EOM terms', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'EOM');
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('createInvoice rejects invalid terms', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET60',
+  });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'TERMS_INVALID');
+});
+
+test('createInvoice rejects unknown terms string', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'INVALID',
+  });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'TERMS_INVALID');
+});
+
+test('NET14 due date is 14 days after issue date', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  assert.equal(result.value.dueDate, '2026-01-29');
+});
+
+test('NET30 due date is 30 days after issue date', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(result.value.dueDate, '2026-01-31');
+});
+
+test('NET14 crosses month boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  assert.equal(result.value.dueDate, '2026-02-03');
+});
+
+test('NET30 crosses month boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-05',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(result.value.dueDate, '2026-02-04');
+});
+
+test('NET14 crosses year boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-12-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  assert.equal(result.value.dueDate, '2027-01-03');
+});
+
+test('NET30 crosses year boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-12-02',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(result.value.dueDate, '2027-01-01');
+});
+
+test('EOM in January', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.value.dueDate, '2026-01-31');
+});
+
+test('EOM in February (non-leap year)', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.value.dueDate, '2026-02-28');
+});
+
+test('EOM in February (leap year)', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.value.dueDate, '2024-02-29');
+});
+
+test('EOM in April (30 days)', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-04-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.value.dueDate, '2026-04-30');
+});
+
+test('EOM in December', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.value.dueDate, '2026-12-31');
+});
+
+test('EOM at start of month', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('EOM on last day of month', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-31',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('terms and dueDate preserved when issuing invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  assert.equal(issued.value.terms, 'NET14');
+  assert.equal(issued.value.dueDate, inv.value.dueDate);
+});
+
+test('terms and dueDate preserved when adding lines', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  const updated = addLine(inv.value, { sku: 'DEV-HOUR', qty: 1 });
+
+  assert.equal(updated.value.terms, 'EOM');
+  assert.equal(updated.value.dueDate, inv.value.dueDate);
+});
+
+test('different customers can have different terms on same day', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(inv1.value.dueDate, '2026-10-21');
+  assert.equal(inv2.value.dueDate, '2026-11-06');
+});
+
+test('same customer can have different terms on different invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(inv1.value.terms, 'NET14');
+  assert.equal(inv2.value.terms, 'EOM');
+});
