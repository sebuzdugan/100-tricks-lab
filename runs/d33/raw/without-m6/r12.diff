+/**
+ * Validate that payment terms are one of the accepted values.
+ * @param {unknown} terms
+ * @returns {boolean}
+ */
+function isValidTerms(terms) {
+  return ['NET14', 'NET30', 'EOM'].includes(terms);
+}
+
+/**
+ * Calculate the due date based on issue date and terms.
+ * @param {string} issueDate - YYYY-MM-DD format
+ * @param {string} terms - NET14, NET30, or EOM
+ * @returns {string} - due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') return addDays(issueDate, 14);
+  if (terms === 'NET30') return addDays(issueDate, 30);
+
+  // EOM: last day of the month of the issue date
+  const [year, month] = issueDate.split('-').map(Number);
+  const nextMonth = month === 12 ? 1 : month + 1;
+  const nextYear = month === 12 ? year + 1 : year;
+  const d = new Date(Date.UTC(nextYear, nextMonth - 1, 1));
+  d.setUTCDate(d.getUTCDate() - 1);
+  const y = d.getUTCFullYear();
+  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${y}-${m}-${day}`;
+}
