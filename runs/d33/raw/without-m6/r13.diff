diff --git a/test/vouchers.test.js b/test/vouchers.test.js
new file mode 100644
index 0000000..b3307e3
--- /dev/null
+++ b/test/vouchers.test.js
@@ -0,0 +1,279 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher, addLine } from '../src/invoices.js';
+
+test('applyVoucher adds voucher to draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const result = applyVoucher(inv.value, { code: 'SAVE10', amount: 1000 });
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.voucher, { code: 'SAVE10', amount: 1000 });
+});
+
+test('applyVoucher rejects issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const result = applyVoucher(issued.value, { code: 'SAVE10', amount: 1000 });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_DRAFT');
+});
+
+test('applyVoucher rejects paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const result = applyVoucher(issued.value, { code: 'SAVE10', amount: 1000 });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_DRAFT');
+});
+
+test('applyVoucher rejects non-integer amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const result = applyVoucher(inv.value, { code: 'SAVE10', amount: 1000.50 });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('applyVoucher rejects zero amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const result = applyVoucher(inv.value, { code: 'SAVE10', amount: 0 });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('applyVoucher rejects negative amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const result = applyVoucher(inv.value, { code: 'SAVE10', amount: -1000 });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('applyVoucher prevents multiple vouchers on one invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const withVoucher = applyVoucher(inv.value, { code: 'SAVE10', amount: 1000 });
+  const result = applyVoucher(withVoucher.value, { code: 'EXTRA5', amount: 500 });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'VOUCHER_EXISTS');
+});
+
+test('invoiceTotals includes voucher amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const withVoucher = applyVoucher(inv.value, { code: 'SAVE10', amount: 1000 });
+  const totals = invoiceTotals(withVoucher.value);
+
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals returns 0 voucher when none applied', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const totals = invoiceTotals(inv.value);
+
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals calculates total correctly with voucher', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const totals1 = invoiceTotals(inv.value);
+  const withVoucher = applyVoucher(inv.value, { code: 'SAVE10', amount: 1000 });
+  const totals2 = invoiceTotals(withVoucher.value);
+
+  assert.equal(totals2.total, totals1.total - 1000);
+});
+
+test('voucher amount comes after VAT in calculation', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const totals1 = invoiceTotals(inv.value);
+  const withVoucher = applyVoucher(inv.value, { code: 'SAVE10', amount: 500 });
+  const totals2 = invoiceTotals(withVoucher.value);
+
+  // total = subtotal - discount + vat - voucher
+  const expected = totals1.subtotal - totals1.discount + totals1.vat - 500;
+  assert.equal(totals2.total, expected);
+});
+
+test('voucher cannot exceed invoice total (no negative totals)', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const totals1 = invoiceTotals(inv.value);
+  const withVoucher = applyVoucher(inv.value, { code: 'SAVE10', amount: totals1.total + 5000 });
+  const totals2 = invoiceTotals(withVoucher.value);
+
+  // Total is clamped at 0
+  assert.equal(totals2.total, 0);
+});
+
+test('voucher with discounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  const withVoucher = applyVoucher(inv.value, { code: 'SAVE10', amount: 1000 });
+  const totals = invoiceTotals(withVoucher.value);
+
+  assert.equal(totals.discount, totals.discount); // discount applied
+  assert.equal(totals.voucher, 1000);
+});
+
+test('voucher with tier discounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const withVoucher = applyVoucher(inv.value, { code: 'SAVE10', amount: 1000 });
+  const totals = invoiceTotals(withVoucher.value);
+
+  // C-001 is gold tier (5% discount)
+  assert(totals.discount > 0);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('voucher preserved when adding lines', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const withVoucher = applyVoucher(inv.value, { code: 'SAVE10', amount: 1000 });
+  const updated = addLine(withVoucher.value, { sku: 'DEV-HOUR', qty: 1 });
+
+  assert.deepEqual(updated.value.voucher, { code: 'SAVE10', amount: 1000 });
+});
+
+test('voucher with different codes', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const codes = ['PROMO2024', 'SAVE25', 'WELCOME', 'VIP'];
+
+  for (const code of codes) {
+    const result = applyVoucher(inv.value, { code, amount: 1000 });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.voucher.code, code);
+  }
+});
+
+test('voucher with various amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const amounts = [1, 100, 1000, 10000, 999999];
+
+  for (const amount of amounts) {
+    const result = applyVoucher(inv.value, { code: 'TEST', amount });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.voucher.amount, amount);
+  }
+});
+
+test('invoiceTotals includes all components with voucher', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 5 }],
+  });
+  const withVoucher = applyVoucher(inv.value, { code: 'SAVE10', amount: 2000 });
+  const totals = invoiceTotals(withVoucher.value);
+
+  assert('subtotal' in totals);
+  assert('discount' in totals);
+  assert('vat' in totals);
+  assert('voucher' in totals);
+  assert('total' in totals);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat - totals.voucher);
+});
+
+test('multiple invoices can have different vouchers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const with1 = applyVoucher(inv1.value, { code: 'SAVE10', amount: 1000 });
+  const with2 = applyVoucher(inv2.value, { code: 'SAVE20', amount: 2000 });
+
+  assert.equal(with1.value.voucher.code, 'SAVE10');
+  assert.equal(with1.value.voucher.amount, 1000);
+  assert.equal(with2.value.voucher.code, 'SAVE20');
+  assert.equal(with2.value.voucher.amount, 2000);
+});
+
+test('voucher preserves other invoice properties', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  });
+  const original = inv.value;
+  const withVoucher = applyVoucher(original, { code: 'SAVE10', amount: 1000 });
+
+  assert.equal(withVoucher.value.customerId, original.customerId);
+  assert.equal(withVoucher.value.issueDate, original.issueDate);
+  assert.equal(withVoucher.value.terms, original.terms);
+  assert.equal(withVoucher.value.dueDate, original.dueDate);
+  assert.equal(withVoucher.value.status, original.status);
+});
