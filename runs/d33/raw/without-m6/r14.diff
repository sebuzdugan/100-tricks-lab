+test('statement with mixed invoice statuses', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-06',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const issued1 = issueInvoice(inv1.value, []);
+  const issued2 = issueInvoice(inv2.value, ['INV-001']);
+  const issued3 = issueInvoice(inv3.value, ['INV-001', 'INV-002']);
+
+  const totals2 = invoiceTotals(issued2.value);
+  const partial2 = recordPayment(issued2.value, { amount: Math.floor(totals2.total / 2), date: '2026-10-08' });
+
+  const totals3 = invoiceTotals(issued3.value);
+  const paid3 = recordPayment(issued3.value, { amount: totals3.total, date: '2026-10-08' });
+
+  const result = statement('C-002', [issued1.value, partial2.value, paid3.value], '2026-10-07');
