+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate a customer statement showing issued and partially paid invoices.
+ * @param {string} customerId
+ * @param {Array<any>} invoices - all invoices to filter
+ * @param {string} asOf - statement date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const relevantInvoices = invoices
+    .filter((inv) => inv.customerId === customerId)
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .filter((inv) => inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate))
+    .map((inv) => {
+      const totals = invoiceTotals(inv);
+      const due = balanceDue(inv);
+      return {
+        number: inv.number,
+        issueDate: inv.issueDate,
+        dueDate: inv.dueDate || null,
+        total: totals.total,
+        due,
+      };
+    });
+
+  const totalDue = relevantInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId,
+    invoices: relevantInvoices,
+    totalDue,
+  });
+}
