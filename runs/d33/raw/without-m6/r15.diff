+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert('number' in result.value);
+  assert('invoiceNumber' in result.value);
+  assert('customerId' in result.value);
+  assert('amount' in result.value);
+  assert('reason' in result.value);
+  assert('date' in result.value);
+  assert.equal(Object.keys(result.value).length, 6);
+});
