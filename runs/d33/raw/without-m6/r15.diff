+  const issued = issueInvoice(inv.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.value.number, 'CN-0001');
+});
+
+test('createCreditNote increments CN number', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result1 = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, []);
+  const result2 = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-09' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-0001');
+  assert.equal(result2.value.number, 'CN-0002');
