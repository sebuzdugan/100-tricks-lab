+
+test('createCreditNote handles mixed invoice and credit numbers', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'CN-0001', 'CN-0002'];
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-0003');
+});
+
+test('createCreditNote stores correct credit note data', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const creditData = { amount: 2500, reason: 'Partial refund for defect', date: '2026-10-09' };
+  const result = createCreditNote(issued.value, creditData, []);
+
+  assert.equal(result.value.invoiceNumber, issued.value.number);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 2500);
+  assert.equal(result.value.reason, 'Partial refund for defect');
+  assert.equal(result.value.date, '2026-10-09');
+});
+
+test('createCreditNote with different reasons', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const reasons = ['Customer request', 'Quality issue', 'Duplicate charge', 'Service not rendered'];
+
+  for (const reason of reasons) {
+    const result = createCreditNote(issued.value, { amount: 1000, reason, date: '2026-10-08' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.reason, reason);
+  }
+});
+
+test('createCreditNote with various amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }], // High value item
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const amounts = [1, 100, 10000, Math.floor(totals.total / 2), totals.total];
+
+  for (const amount of amounts) {
+    const result = createCreditNote(issued.value, { amount, reason: 'Refund', date: '2026-10-08' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.amount, amount);
+  }
+});
+
+test('createCreditNote date can be before or after invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const before = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-05' }, []);
+  const same = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-07' }, []);
+  const after = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-10' }, []);
+
+  assert.equal(before.ok, true);
+  assert.equal(same.ok, true);
+  assert.equal(after.ok, true);
+});
+
+test('createCreditNote with invoices with discounts and VAT', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const result = createCreditNote(issued.value, { amount: totals.total, reason: 'Full refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote with invoices with vouchers', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('multiple credit notes for same invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const cn1 = createCreditNote(issued.value, { amount: 5000, reason: 'Partial refund 1', date: '2026-10-08' }, []);
+  const cn2 = createCreditNote(issued.value, { amount: 3000, reason: 'Partial refund 2', date: '2026-10-09' }, [cn1.value.number]);
+
+  assert.equal(cn1.ok, true);
+  assert.equal(cn2.ok, true);
+  assert(cn1.value.amount + cn2.value.amount <= totals.total);
+});
+
+test('credit note for partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const half = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued.value, { amount: half, date: '2026-10-08' });
+  const result = createCreditNote(partial.value, { amount: 1000, reason: 'Refund', date: '2026-10-09' }, []);
+
+  assert.equal(result.ok, true);
+  // Credit can be for amount up to full invoice total (not just remaining balance)
+  assert(result.value.amount <= totals.total);
+});
+
+test('credit note structure has all required fields', () => {
