+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate the next credit note number.
+ * Format: CN-#### where #### is a zero-padded counter.
+ * @param {Array<string>} existingNumbers - array of all numbers (invoices and credit notes)
+ * @returns {string} the next free credit note number
+ */
+function nextCreditNoteNumber(existingNumbers) {
+  const prefix = 'CN-';
+
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length), 10))
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Validate that an amount is a positive integer (in cents).
+ * @param {unknown} amount
+ * @returns {boolean}
+ */
+function isValidAmount(amount) {
+  return Number.isInteger(amount) && amount > 0;
+}
+
+/**
+ * Create a credit note (refund) for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array<any>, issueDate: string }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {Array<string>} existingNumbers - array of all numbers already used
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!isValidDate(date)) return fail('DATE_INVALID');
+
+  if (!isValidAmount(amount)) return fail('AMOUNT_INVALID');
+
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) return fail('CREDIT_TOO_HIGH');
+
+  const number = nextCreditNoteNumber(existingNumbers);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
