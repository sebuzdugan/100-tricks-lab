+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote rejects draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const result = createCreditNote(inv.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote accepts issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, issued.value.number);
+});
+
+test('createCreditNote accepts partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const partial = recordPayment(issued.value, { amount: Math.floor(totals.total / 2), date: '2026-10-08' });
+  const result = createCreditNote(partial.value, { amount: 1000, reason: 'Refund', date: '2026-10-09' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote accepts paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-08' });
+  const result = createCreditNote(paid.value, { amount: 1000, reason: 'Refund', date: '2026-10-09' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-13-01' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createCreditNote rejects non-integer amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000.50, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const result = createCreditNote(issued.value, { amount: 0, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects negative amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const result = createCreditNote(issued.value, { amount: -1000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
