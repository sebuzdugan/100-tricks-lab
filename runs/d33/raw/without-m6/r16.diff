+import { ok, fail } from './result.js';
+import { isValidDate } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Calculate days overdue (positive means past due date, 0 means due today, negative means not yet due).
+ * @param {string} dueDate - date in YYYY-MM-DD format
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {number} days overdue
+ */
+function daysOverdue(dueDate, asOf) {
+  const due = new Date(Date.UTC(
+    parseInt(dueDate.substring(0, 4), 10),
+    parseInt(dueDate.substring(5, 7), 10) - 1,
+    parseInt(dueDate.substring(8, 10), 10),
+  ));
+
+  const as = new Date(Date.UTC(
+    parseInt(asOf.substring(0, 4), 10),
+    parseInt(asOf.substring(5, 7), 10) - 1,
+    parseInt(asOf.substring(8, 10), 10),
+  ));
+
+  const diffTime = as - due;
+  return Math.floor(diffTime / (1000 * 60 * 60 * 24));
+}
+
+/**
+ * Get invoices that are overdue as of a given date.
+ * @param {Array<any>} invoices
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: Array<any> } | { ok: false, error: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  const overdue = invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .filter((inv) => inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysOverdue(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.dueDate.localeCompare(b.dueDate));
+
+  return ok(overdue);
+}
