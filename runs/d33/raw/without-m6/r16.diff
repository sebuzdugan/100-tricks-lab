+test('overdueInvoices with large number of overdue invoices', () => {
+  const invoices = [];
+  for (let i = 1; i <= 10; i++) {
+    const inv = createInvoice({
+      customerId: 'C-002',
+      issueDate: `2026-${String((10 - i + 1).toString().padStart(2, '0')).slice(-2)}-01`,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET14',
+    });
+    const issued = issueInvoice(inv.value, invoices.length > 0 ? [`INV-${invoices.length}`] : []);
+    invoices.push(issued.value);
+  }
+
+  const result = overdueInvoices(invoices, '2026-10-25');
+
+  assert(result.value.length > 0);
+  // Verify sorted by dueDate ascending (most overdue first)
+  for (let i = 1; i < result.value.length; i++) {
+    assert(result.value[i - 1].dueDate <= result.value[i].dueDate);
+  }
+});
