@@ -48,3 +49,40 @@ export function overdueInvoices(invoices, asOf) {
 
   return ok(overdue);
 }
+
+/**
+ * Get a summary of VAT collected across invoices, grouped by VAT rate.
+ * @param {Array<any>} invoices
+ * @returns {{ ok: true, value: Array<any> }}
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) continue;
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVAT(line);
+
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { base: 0, vat: 0 });
+      }
+
+      const entry = vatMap.get(rate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  const result = Array.from(vatMap).map(([rate, { base, vat }]) => ({
+    rate,
+    base,
+    vat,
+  }));
+
+  result.sort((a, b) => b.rate - a.rate);
+
+  return ok(result);
+}
