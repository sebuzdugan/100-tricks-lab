+      { sku: 'DES-HOUR', qty: 1, discountPercent: 20 },
+    ],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = vatSummary([issued.value]);
+
+  assert.equal(result.ok, true);
+  let totalBase = 0;
+  let totalVat = 0;
+  for (const line of issued.value.lines) {
+    totalBase += lineTotal(line) - lineDiscount(line);
+    totalVat += lineVAT(line);
+  }
+  assert.equal(result.value[0].base, totalBase);
+  assert.equal(result.value[0].vat, totalVat);
