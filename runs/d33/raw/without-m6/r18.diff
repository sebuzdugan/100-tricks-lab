+/**
+ * Calculate the late fee for an invoice based on days overdue.
+ * Late fee is 0.04% per day on the amount still due.
+ * @param {{ dueDate: string, lines: Array<any>, payments?: Array<any>, voucher?: any }} invoice
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {number} late fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  const due = balanceDue(invoice);
+  const daysOver = daysOverdue(invoice.dueDate, asOf);
+
+  if (daysOver <= 0) return 0;
+
+  return roundCents(due * 0.0004 * daysOver);
+}
