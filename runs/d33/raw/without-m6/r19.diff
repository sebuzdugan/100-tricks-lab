+test('exportCsv preserves invoice order', () => {
+  const invoices = [];
+  for (let i = 0; i < 5; i++) {
+    const inv = createInvoice({
+      customerId: 'C-002',
+      issueDate: `2026-10-0${i + 1}`,
+      lines: [{ sku: 'DES-HOUR', qty: i + 1 }],
+    });
+    const issued = issueInvoice(inv.value, invoices.length > 0 ? [`INV-${invoices.length}`] : []);
+    invoices.push(issued.value);
+  }
+
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+
+  for (let i = 0; i < invoices.length; i++) {
+    assert(lines[i + 1].includes(invoices[i].number));
+  }
+});
