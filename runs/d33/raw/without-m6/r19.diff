+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns string with header', () => {
+  const result = exportCsv([]);
+  assert(typeof result === 'string');
+  assert(result.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv header is first line', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv empty invoices list', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv single issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+
+  assert(lines[1].includes(issued.value.number));
+  assert(lines[1].includes('2026-10-07'));
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  const issued1 = issueInvoice(inv1.value, []);
+  const issued2 = issueInvoice(inv2.value, ['INV-001']);
+
+  const result = exportCsv([issued1.value, issued2.value]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert(lines[1].includes(issued1.value.number));
+  assert(lines[2].includes(issued2.value.number));
+});
+
+test('exportCsv includes customer name', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = exportCsv([issued.value]);
+
+  assert(result.includes('Blue Fern Bakery'));
+});
+
+test('exportCsv formats amounts in euros', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = exportCsv([issued.value]);
+
+  const euros = (totals.subtotal / 100).toFixed(2);
+  assert(result.includes(euros));
+});
+
+test('exportCsv amounts have 2 decimal places', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  const subtotal = fields[5];
+  assert(subtotal.includes('.'));
+  const decimals = subtotal.split('.')[1];
+  assert.equal(decimals.length, 2);
+});
