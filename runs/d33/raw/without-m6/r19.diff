+test('exportCsv partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const half = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued.value, { amount: half, date: '2026-10-08' });
+
+  const result = exportCsv([partial.value]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  const due = parseFloat(fields[9]);
+  assert(due > 0);
+  assert(due < totals.total / 100);
+});
