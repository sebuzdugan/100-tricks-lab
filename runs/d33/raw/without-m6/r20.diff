+++ b/src/money.js
@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,39 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount from euros to another currency.
+ * @param {number} centEUR - amount in euro cents
+ * @param {string} currency - target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(centEUR, currency) {
+  if (!(currency in RATES)) return fail('UNKNOWN_CURRENCY');
+
+  const rate = RATES[currency];
+  const amountInCurrency = centEUR * rate / 100;
+  const centInCurrency = roundCents(amountInCurrency * 100);
+
+  return ok(centInCurrency);
+}
+
+/**
+ * Format cents as money for a given currency: 123456 USD -> "$1,234.56", 5 GBP -> "£0.05".
+ * @param {number} cents - amount in that currency's cents
+ * @param {string} currency - EUR, USD, or GBP
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const whole = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const fraction = String(abs % 100).padStart(2, '0');
+
+  let symbol = '';
+  if (currency === 'USD') symbol = '$';
+  else if (currency === 'GBP') symbol = '£';
+  else if (currency === 'EUR') symbol = '€';
+
+  return `${sign}${symbol}${whole}.${fraction}`;
+}
