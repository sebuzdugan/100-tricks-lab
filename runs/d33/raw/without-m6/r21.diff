+test('mergeCustomers removes fromId and keeps intoId', () => {
+  const customers = listCustomers();
+  const result = mergeCustomers(customers, [], 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+  assert(!result.value.customers.some((c) => c.id === 'C-001'));
+  assert(result.value.customers.some((c) => c.id === 'C-002'));
+});
