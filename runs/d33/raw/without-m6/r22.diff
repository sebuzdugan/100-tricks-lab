+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { qty: 1, unitPrice: 2500 };
+  assert.equal(lineTotal(line), 2500);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with large amounts', () => {
+  const line = { qty: 100, unitPrice: 95000 };
+  assert.equal(lineTotal(line), 9500000);
+});
+
+test('lineDiscount without discount percent', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 10% discount', () => {
+  const line = { qty: 5, unitPrice: 1000, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 500);
+});
+
+test('lineDiscount with 5% discount on development rate', () => {
+  const line = { qty: 5, unitPrice: 9500, discountPercent: 5 };
+  assert.equal(lineDiscount(line), roundCentsManual(47500 * 5 / 100));
+});
+
+test('lineDiscount 100% discount', () => {
+  const line = { qty: 5, unitPrice: 1000, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 5000);
+});
+
+test('lineDiscount zero discount', () => {
+  const line = { qty: 5, unitPrice: 1000, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount precision with rounding', () => {
+  const line = { qty: 3, unitPrice: 1000, discountPercent: 33 };
+  const result = lineDiscount(line);
+  assert(Number.isInteger(result));
+});
+
+test('lineVAT basic calculation', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 };
+  assert.equal(lineVAT(line), 2100);
+});
+
+test('lineVAT with discount applied before VAT', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 10 };
+  const discountedAmount = 10000 - 1000;
+  const expectedVat = roundCentsManual(discountedAmount * 21 / 100);
+  assert.equal(lineVAT(line), expectedVat);
+});
+
+test('lineVAT different VAT rates', () => {
+  const line6 = { qty: 1, unitPrice: 10000, vatRate: 6, discountPercent: 0 };
+  const line21 = { qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 };
+  assert.equal(lineVAT(line6), 600);
+  assert.equal(lineVAT(line21), 2100);
+  assert(lineVAT(line21) > lineVAT(line6));
+});
+
+test('lineVAT with 0% VAT rate', () => {
+  const line = { qty: 5, unitPrice: 1000, vatRate: 0, discountPercent: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT on discounted amount not original', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 50 };
+  const vat = lineVAT(line);
+  const vatOn10000 = 2100;
+  const vatOn5000 = 1050;
+  assert.equal(vat, vatOn5000);
+});
+
+test('invoiceTotals single line no discount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 12100);
+});
+
+test('invoiceTotals multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 },
+      { qty: 2, unitPrice: 5000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 20000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 4200);
+  assert.equal(totals.total, 24200);
+});
+
+test('invoiceTotals with line discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1000);
+  assert(totals.vat < 2100);
+});
+
+test('invoiceTotals different VAT rates per line', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 },
+      { qty: 1, unitPrice: 10000, vatRate: 6, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 20000);
+  assert.equal(totals.vat, 2700);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 }],
+    voucher: { code: 'TEST', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 1000);
+  assert.equal(totals.total, 11100);
+});
+
+test('invoiceTotals no voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals voucher never goes negative', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 0 }],
+    voucher: { code: 'TEST', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.total >= 0);
+});
+
+test('invoiceTotals large voucher caps total at zero', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 0 }],
+    voucher: { code: 'TEST', amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals empty lines array', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals all amounts are integers', () => {
+  const invoice = {
+    lines: [{ qty: 3, unitPrice: 1000, vatRate: 33, discountPercent: 33 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(Number.isInteger(totals.subtotal));
+  assert(Number.isInteger(totals.discount));
+  assert(Number.isInteger(totals.vat));
+  assert(Number.isInteger(totals.voucher));
+  assert(Number.isInteger(totals.total));
+});
+
+test('invoiceTotals returns all required fields', () => {
+  const invoice = { lines: [{ qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 0 }] };
+  const totals = invoiceTotals(invoice);
+  assert('subtotal' in totals);
+  assert('discount' in totals);
+  assert('vat' in totals);
+  assert('voucher' in totals);
+  assert('total' in totals);
+});
+
+test('invoiceTotals complex scenario with discounts and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 5 },
+      { qty: 2, unitPrice: 15000, vatRate: 21, discountPercent: 10 },
+      { qty: 1, unitPrice: 5000, vatRate: 6, discountPercent: 0 },
+    ],
+    voucher: { code: 'WELCOME', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.subtotal > 0);
+  assert(totals.discount > 0);
+  assert(totals.vat > 0);
+  assert.equal(totals.voucher, 500);
+  assert(totals.total > 0);
+  assert.equal(totals.subtotal - totals.discount + totals.vat - totals.voucher, totals.total);
+});
+
+test('invoiceTotals does not mutate input', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 0 }],
+  };
+  const original = JSON.stringify(invoice);
+  invoiceTotals(invoice);
+  assert.equal(JSON.stringify(invoice), original);
+});
+
+test('lineVAT handles rounding correctly', () => {
+  const line = { qty: 1, unitPrice: 1, vatRate: 33, discountPercent: 0 };
+  const vat = lineVAT(line);
+  assert(Number.isInteger(vat));
+});
+
+test('invoiceTotals subtotal is sum of line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+      { qty: 3, unitPrice: 500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 3500);
+});
+
+test('invoiceTotals discount is sum of line discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 10 },
+      { qty: 1, unitPrice: 1000, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 150);
+});
+
+// Helper for manual calculation (banker's rounding simulation)
+function roundCentsManual(x) {
+  const r = Math.round(x * 1e6) / 1e6;
+  const floor = Math.floor(r);
+  const diff = r - floor;
+  if (diff > 0.5) return floor + 1;
+  if (diff < 0.5) return floor === 0 ? 0 : floor;
+  return floor % 2 === 0 ? floor : floor + 1;
+}
