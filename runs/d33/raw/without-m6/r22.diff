+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line item (qty * unitPrice).
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount for a single line item.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const discountPercent = line.discountPercent ?? 0;
+  return roundCents(lineTotal(line) * discountPercent / 100);
+}
+
+/**
+ * Calculate the VAT for a single line item (on the discounted amount).
+ * @param {{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }}
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const discountedAmount = total - discount;
+  return roundCents(discountedAmount * line.vatRate / 100);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }>, voucher?: { code: string, amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = roundCents(invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
+  const discount = roundCents(invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0));
+  const vat = roundCents(invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0));
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
