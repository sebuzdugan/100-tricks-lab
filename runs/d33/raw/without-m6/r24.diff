+/**
+ * Get a dashboard summary of invoice metrics.
+ * @param {Array<any>} invoices
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { counts: object, outstanding: number, overdue: object, topCustomers: Array<any> } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    counts[invoice.status]++;
+  }
+
+  // Calculate outstanding amount (issued or partially_paid)
+  const outstanding = invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  // Get overdue data
+  const overdueResult = overdueInvoices(invoices, asOf);
+  const overdueList = overdueResult.value || [];
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Calculate due amount by customer
+  const customerDueMap = new Map();
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) continue;
+
+    const due = balanceDue(invoice);
+    if (due === 0) continue;
+
+    const customerId = invoice.customerId;
+    if (!customerDueMap.has(customerId)) {
+      customerDueMap.set(customerId, 0);
+    }
+    customerDueMap.set(customerId, customerDueMap.get(customerId) + due);
+  }
+
+  // Get top 3 customers by due amount
+  const topCustomers = Array.from(customerDueMap.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  });
+}
