+test('invoiceTotals sums line totals', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21 },
+      { sku: 'DEV-HOUR', qty: 10, unitPrice: 9500, name: 'Development (hour)', vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5 * 8500 + 10 * 9500);
+  assert.equal(totals.subtotal, 137500);
+  assert.equal(totals.total, 137500);
