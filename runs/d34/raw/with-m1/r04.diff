diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..68883a5
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,41 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for an empty list', () => {
+  assert.equal(nextInvoiceNumber([], '2026-10-07'), 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  assert.equal(nextInvoiceNumber(['INV-2026-0001'], '2026-10-07'), 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles multiple existing numbers', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  assert.equal(nextInvoiceNumber(numbers, '2026-10-07'), 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0042'];
+  assert.equal(nextInvoiceNumber(numbers, '2027-01-01'), 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-9999', 'INV-2026-0001'];
+  assert.equal(nextInvoiceNumber(numbers, '2026-10-07'), 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber ignores invalid numbers', () => {
+  const numbers = ['INV-2026-0001', 'INVALID', 'INV-2026-abc', 'INV-2026-0002'];
+  assert.equal(nextInvoiceNumber(numbers, '2026-10-07'), 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const numbers = Array.from({ length: 9 }, (_, i) => `INV-2026-000${i + 1}`);
+  assert.equal(nextInvoiceNumber(numbers, '2026-10-07'), 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber works with high counters', () => {
+  const numbers = ['INV-2026-9999'];
+  assert.equal(nextInvoiceNumber(numbers, '2026-10-07'), 'INV-2026-10000');
+});
