+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio/);
+  assert.match(text, /5 × Design work \(hour\) @ €85.00 = €425.00/);
+  assert.match(text, /Total: €425.00/);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = {
+    number: 'INV-2026-0042',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0042');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(text, /5 × Design work \(hour\) @ €85.00 = €425.00/);
+  assert.match(text, /1 × Logo package @ €1,200.00 = €1,200.00/);
+  assert.match(text, /Total: €1,625.00/);
+});
+
+test('renderInvoiceText includes all invoice lines', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 2, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 3, unitPrice: 9500, vatRate: 21 },
+      { sku: 'SUPPORT-HOUR', name: 'Support (hour)', qty: 1, unitPrice: 7250, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 6);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.match(lines[2], /2 × Design work \(hour\) @ €85.00 = €170.00/);
+  assert.match(lines[3], /3 × Development \(hour\) @ €95.00 = €285.00/);
+  assert.match(lines[4], /1 × Support \(hour\) @ €72.50 = €72.50/);
+  assert.match(lines[5], /Total: €527.50/);
+});
+
+test('renderInvoiceText formats amounts with thousands separator', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'BRAND-BOOK', name: 'Brand guidelines document', qty: 1, unitPrice: 245000, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /€2,450.00/);
+  assert.match(text, /Total: €2,450.00/);
+});
+
+test('renderInvoiceText renders multiple lines with different prices', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-008',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'PRINT-A4', name: 'Printed flyer A4 (each)', qty: 100, unitPrice: 37, vatRate: 9 },
+      { sku: 'PRINT-A3', name: 'Printed poster A3 (each)', qty: 50, unitPrice: 249, vatRate: 9 },
+      { sku: 'HOST-MONTH', name: 'Website hosting (month)', qty: 12, unitPrice: 1500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Lumen Records');
+  assert.match(text, /100 × Printed flyer A4 \(each\) @ €0.37 = €37.00/);
+  assert.match(text, /50 × Printed poster A3 \(each\) @ €2.49 = €124.50/);
+  assert.match(text, /12 × Website hosting \(month\) @ €15.00 = €180.00/);
+  assert.match(text, /Total: €341.50/);
+});
+
+test('renderInvoiceText produces multiline string', () => {
+  const invoice = {
+    number: 'INV-2026-0099',
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 3, unitPrice: 980, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'INV-2026-0099');
+  assert.equal(lines[1], 'Orchard Health');
+  assert.match(lines[2], /^3 × Icon set/);
+  assert.match(lines[3], /^Total:/);
+});
