diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..c9104a5
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate validates correct format', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-10'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-10-32'), false);
+});
+
+test('isValidDate rejects leap year edge cases', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 100), '2027-01-15');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+  assert.equal(addDays('2026-10-07', -100), '2026-06-29');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-25', 10), '2027-01-04');
+  assert.equal(addDays('2027-01-05', -10), '2026-12-26');
+});
+
+test('addDays handles zero', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween same day', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2027-01-15'), 100);
+});
+
+test('daysBetween negative difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-06'), -1);
+  assert.equal(daysBetween('2026-10-07', '2026-09-27'), -10);
+  assert.equal(daysBetween('2026-10-07', '2026-06-29'), -100);
+});
+
+test('daysBetween across years', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2026-12-25', '2027-01-04'), 10);
+});
+
+test('daysBetween is commutative inverse', () => {
+  const a = '2026-10-07';
+  const b = '2026-10-17';
+  assert.equal(daysBetween(a, b), -daysBetween(b, a));
+  assert.equal(daysBetween(a, b), 10);
+  assert.equal(daysBetween(b, a), -10);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1);
+});
