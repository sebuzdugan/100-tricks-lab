+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('recordPayment on issued invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const result = recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2026-10-10');
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment fully pays invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = { subtotal: 85000, discount: 0, vat: 17850, total: 102850 };
+  const result = recordPayment(invoice, { amount: 102850, date: '2026-10-10' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'partially_paid',
+    payments: [{ amount: 50000, date: '2026-10-10' }],
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const result = recordPayment(invoice, { amount: 52850, date: '2026-10-15' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 2);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment rejects draft invoice', () => {
