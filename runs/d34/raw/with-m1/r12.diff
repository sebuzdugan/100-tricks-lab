+    ],
+    terms: 'INVALID',
+  }), { ok: false, error: 'TERMS_INVALID' });
+});
+
+test('createInvoice NET30 crosses month boundary', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-20',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
