+test('statement for customer with outstanding invoices', () => {
+  const invoices = [
+    {
+      customerId: 'C-001',
+      number: 'INV-2026-0001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [
+        { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+      ],
+    },
+    {
+      customerId: 'C-001',
+      number: 'INV-2026-0002',
+      issueDate: '2026-10-15',
+      dueDate: '2026-11-14',
+      status: 'partially_paid',
+      payments: [{ amount: 50000, date: '2026-10-20' }],
+      lines: [
+        { sku: 'DEV-HOUR', qty: 5, unitPrice: 9500, name: 'Development (hour)', vatRate: 21, discountPercent: 0 },
+      ],
+    },
+  ];
+  const result = statement('C-001', invoices, '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(result.value.invoices[1].number, 'INV-2026-0002');
+  assert(result.value.totalDue > 0);
+});
