+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+
+test('createCreditNote on issued invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-01',
+    dueDate: '2026-10-31',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const result = createCreditNote(invoice, { amount: 50000, reason: 'Partial refund', date: '2026-10-10' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2026-10-10');
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
