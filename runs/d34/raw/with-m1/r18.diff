+++ b/src/reports.js
@@ -1,6 +1,7 @@
 import { daysBetween } from './dates.js';
 import { balanceDue } from './payments.js';
 import { lineTotal, lineDiscount, lineVat } from './invoices.js';
+import { roundCents } from './money.js';
 
 export function overdueInvoices(invoices, asOf) {
   return invoices
@@ -41,3 +42,15 @@ export function vatSummary(invoices) {
 
   return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
 }
+
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const feeAmount = due * 0.0004 * daysOverdue;
+
+  return Math.max(0, roundCents(feeAmount));
+}
