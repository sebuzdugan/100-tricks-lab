+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv empty array', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv single invoice', () => {
+  const invoices = [
+    {
+      customerId: 'C-001',
+      number: 'INV-2026-0001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [
+        { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+      ],
+    },
+  ];
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[1].includes('2026-10-01'));
+  assert(lines[1].includes('2026-10-31'));
+  assert(lines[1].includes('issued'));
+  assert.equal(lines[2], '');
+});
