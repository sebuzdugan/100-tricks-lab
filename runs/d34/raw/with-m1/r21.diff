+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mergeCustomers, listCustomers } from '../src/customers.js';
+
+test('mergeCustomers successfully merges two customers', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', country: 'NL', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', country: 'NL', tier: 'silver' },
+  ];
+  const invoices = [
+    { customerId: 'C-001', number: 'INV-2026-0001', status: 'issued' },
+    { customerId: 'C-002', number: 'INV-2026-0002', status: 'issued' },
+  ];
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.customers[0].id, 'C-002');
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  assert.equal(result.value.invoices[1].customerId, 'C-002');
+});
+
+test('mergeCustomers fromId not found', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', country: 'NL', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', country: 'NL', tier: 'silver' },
+  ];
+  const invoices = [];
+  const result = mergeCustomers(customers, invoices, 'C-999', 'C-002');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('mergeCustomers intoId not found', () => {
