--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,244 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  const line = { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 };
+  assert.equal(lineTotal(line), 85000);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { sku: 'ITEM', qty: 1, unitPrice: 5000, name: 'Item', vatRate: 21, discountPercent: 0 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with large quantity', () => {
+  const line = { sku: 'ITEM', qty: 1000, unitPrice: 100000, name: 'Item', vatRate: 21, discountPercent: 0 };
+  assert.equal(lineTotal(line), 100000000);
+});
+
+test('lineDiscount calculates percentage correctly', () => {
+  const line = { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 5 };
+  assert.equal(lineDiscount(line), 4250);
+});
+
+test('lineDiscount defaults to 0 discount when discountPercent is absent', () => {
+  const line = { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 0 discount', () => {
+  const line = { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100 discount', () => {
+  const line = { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 85000);
+});
+
+test('lineDiscount with decimal percentage', () => {
+  const line = { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 2.5 };
+  assert.equal(lineDiscount(line), 2125);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 5 };
+  const expectedBase = 85000 - 4250;
+  const expectedVat = Math.round(expectedBase * 21 / 100);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat handles different VAT rates', () => {
+  const line21 = { sku: 'DES', qty: 10, unitPrice: 8500, name: 'Design', vatRate: 21, discountPercent: 0 };
+  const line9 = { sku: 'BOOK', qty: 5, unitPrice: 2000, name: 'Book', vatRate: 9, discountPercent: 0 };
+  const line0 = { sku: 'FOOD', qty: 2, unitPrice: 1500, name: 'Food', vatRate: 0, discountPercent: 0 };
+  assert.equal(lineVat(line21), 17850);
+  assert.equal(lineVat(line9), 900);
+  assert.equal(lineVat(line0), 0);
+});
+
+test('lineVat rounds per line', () => {
+  const line = { sku: 'ITEM', qty: 1, unitPrice: 111111, name: 'Item', vatRate: 21, discountPercent: 0 };
+  const vat = lineVat(line);
+  assert.equal(typeof vat, 'number');
+  assert.equal(vat, Math.round(vat));
+});
+
+test('invoiceTotals sums line totals', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+      { sku: 'DEV-HOUR', qty: 5, unitPrice: 9500, name: 'Development (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000 + 47500);
+});
+
+test('invoiceTotals includes discount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 5 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 4250);
+});
+
+test('invoiceTotals includes VAT', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 17850);
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 5 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const expectedSubtotal = 85000;
+  const expectedDiscount = 4250;
+  const expectedVat = Math.round((expectedSubtotal - expectedDiscount) * 21 / 100);
+  const expectedTotal = expectedSubtotal - expectedDiscount + expectedVat;
+  assert.equal(totals.subtotal, expectedSubtotal);
+  assert.equal(totals.discount, expectedDiscount);
+  assert.equal(totals.vat, expectedVat);
+  assert.equal(totals.total, expectedTotal);
+});
+
+test('invoiceTotals sums VAT from multiple lines with different rates', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+      { sku: 'BOOK', qty: 5, unitPrice: 2000, name: 'Book', vatRate: 9, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 17850 + 900);
+});
+
+test('invoiceTotals clamps negative values at zero', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 17850);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 102850);
+});
+
+test('invoiceTotals includes voucher', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    voucher: { code: 'PROMO10', amount: 10000 },
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 10000);
+  assert.equal(totals.total, 102850 - 10000);
+});
+
+test('invoiceTotals returns zero voucher when none exists', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals total calculation order', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    voucher: { code: 'PROMO', amount: 5000 },
+    lines: [
+      { sku: 'ITEM', qty: 10, unitPrice: 5000, name: 'Item', vatRate: 21, discountPercent: 10 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 50000;
+  const discount = 5000;
+  const vat = Math.round((subtotal - discount) * 21 / 100);
+  const total = subtotal - discount + vat - 5000;
+  assert.equal(totals.total, total);
+});
+
+test('invoiceTotals with multiple lines and operations', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    voucher: { code: 'PROMO', amount: 10000 },
+    lines: [
+      { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 5 },
+      { sku: 'DEV-HOUR', qty: 5, unitPrice: 9500, name: 'Development (hour)', vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000 + 47500);
+  assert.equal(totals.discount, 4250);
+  assert(totals.vat > 0);
+  assert(totals.total > 0);
+});
+
+test('invoiceTotals empty lines', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    status: 'issued',
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('lineTotal and lineDiscount work together in lineVat', () => {
+  const line = { sku: 'DES-HOUR', qty: 10, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21, discountPercent: 5 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const base = total - discount;
+  const expectedVat = Math.round(base * 21 / 100);
+  assert.equal(lineVat(line), expectedVat);
+});
