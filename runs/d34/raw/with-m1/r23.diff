diff --git a/src/totals.js b/src/totals.js
index 384f324..fa56e6f 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -10,15 +10,29 @@ export function lineDiscount(line) {
   return Math.max(0, discount);
 }
 
+function bulkDiscount(line) {
+  if (line.qty < 100) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const firstDiscount = lineDiscount(line);
+  const remaining = total - firstDiscount;
+  const bulk = remaining * 2.5 / 100;
+  return Math.max(0, bulk);
+}
+
 export function lineVat(line) {
-  const amount = lineTotal(line) - lineDiscount(line);
+  const total = lineTotal(line);
+  const firstDiscount = lineDiscount(line);
+  const bulk = bulkDiscount(line);
+  const amount = total - firstDiscount - bulk;
   const vat = amount * line.vatRate / 100;
   return Math.max(0, roundCents(vat));
 }
 
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
-  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line) + bulkDiscount(line), 0);
   const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
   const voucher = invoice.voucher ? invoice.voucher.amount : 0;
   const total = subtotal - discount + vat - voucher;
