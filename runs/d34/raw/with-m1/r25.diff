+
+test('renderInvoiceText orders output correctly', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    dueDate: '2026-10-31',
+    status: 'partially_paid',
+    lines: [{ sku: 'ITEM1', name: 'Widget', qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 10 }],
+    voucher: { code: 'PROMO', amount: 500 },
+    payments: [{ amount: 4000, date: '2026-10-15' }],
+  };
+  const lines = renderInvoiceText(invoice).split('\n');
+  const invoiceNumberIdx = lines.findIndex(l => l.includes('INV-2026-0001'));
+  const customerIdx = lines.findIndex(l => l.includes('Northwind Studio'));
+  const lineItemIdx = lines.findIndex(l => l.includes('Widget'));
+  const vatIdx = lines.findIndex(l => l.includes('VAT:'));
+  const voucherIdx = lines.findIndex(l => l.includes('Voucher:'));
+  const totalIdx = lines.findIndex(l => l.includes('Total:'));
+  const dueIdx = lines.findIndex(l => l.includes('Due:'));
+  const paidIdx = lines.findIndex(l => l.includes('Paid:'));
+
+  assert(invoiceNumberIdx < customerIdx);
+  assert(customerIdx < lineItemIdx);
+  assert(lineItemIdx < vatIdx);
+  assert(vatIdx < voucherIdx);
+  assert(voucherIdx < totalIdx);
+  assert(totalIdx < dueIdx);
+  assert(dueIdx < paidIdx);
+});
+
+test('renderInvoiceText shows discount on high-quantity line with bulk discount', () => {
+  const invoice = {
