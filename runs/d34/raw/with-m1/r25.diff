diff --git a/src/render.js b/src/render.js
index 334d156..b83411c 100644
--- a/src/render.js
+++ b/src/render.js
@@ -1,6 +1,6 @@
 import { getCustomer } from './customers.js';
 import { formatEuros } from './money.js';
-import { lineTotal, invoiceTotals, lineVat } from './invoices.js';
+import { lineTotal, lineDiscount, invoiceTotals } from './invoices.js';
 
 export function renderInvoiceText(invoice) {
   const customerResult = getCustomer(invoice.customerId);
@@ -13,7 +13,11 @@ export function renderInvoiceText(invoice) {
 
   for (const line of invoice.lines) {
     const total = lineTotal(line);
-    const lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    const discount = lineDiscount(line);
+    let lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    if (discount > 0) {
+      lineText += ` (discount: ${formatEuros(discount)})`;
+    }
     lines.push(lineText);
   }
 
@@ -21,7 +25,21 @@ export function renderInvoiceText(invoice) {
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: ${formatEuros(totals.voucher)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const amountPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(amountPaid)}`);
+  }
+
   return lines.join('\n');
 }
diff --git a/test/render.test.js b/test/render.test.js
