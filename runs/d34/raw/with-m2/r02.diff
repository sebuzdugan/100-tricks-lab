+
+test('lineTotal multiplies qty by unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 120000 }), 120000);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 50 }), 500);
+});
+
+test('invoiceTotals calculates subtotal and total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'ICON-SET', qty: 5 },
+    ],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 2 * 8500 + 5 * 980);
+  assert.equal(totals.total, totals.subtotal);
+});
+
+test('invoiceTotals handles single line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 25500);
+  assert.equal(totals.total, 25500);
+});
+
+test('invoiceTotals handles empty lines array edge case', () => {
+  const invoice = {
+    customerId: 'C-003',
