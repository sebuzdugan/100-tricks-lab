diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..9e34d31
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 when no existing numbers', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0005'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber resets counter per year', () => {
+  const existing = ['INV-2025-0050', 'INV-2026-0010'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0999', 'INV-2025-0050', 'INV-2027-0001'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2026-ABC', 'INVOICE-2026-0001', 'INV-2026', 'INV-2026-00001'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber works with unordered input', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2026-9999'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-10000');
+});
