diff --git a/src/render.js b/src/render.js
new file mode 100644
index 0000000..672e3fc
--- /dev/null
+++ b/src/render.js
@@ -0,0 +1,24 @@
+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+import { formatEuros } from './money.js';
+
+export function renderInvoiceText(invoice) {
+  const number = invoice.number || 'DRAFT';
+
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  const totals = invoiceTotals(invoice);
+
+  const lines = [number, customerName];
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineStr = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineStr);
+  }
+
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..9d92006
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,105 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '2 x Design work (hour) @ €85.00 = €170.00');
+  assert.equal(lines[3], 'Total: €170.00');
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText renders multiple invoice lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'ICON-SET', qty: 5 },
+      { sku: 'SUPPORT-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '2 x Design work (hour) @ €85.00 = €170.00');
+  assert.equal(lines[3], '5 x Icon set (24 icons) @ €9.80 = €49.00');
+  assert.equal(lines[4], '3 x Support (hour) @ €72.50 = €217.50');
+  assert.equal(lines[5], 'Total: €436.50');
+});
+
+test('renderInvoiceText formats amounts correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '1 x Logo package @ €1,200.00 = €1,200.00');
+  assert.equal(lines[3], '100 x Sticker sheet @ €0.50 = €50.00');
+  assert.equal(lines[4], 'Total: €1,250.00');
+});
+
+test('renderInvoiceText handles unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Unknown Customer');
+});
+
+test('renderInvoiceText renders invoice with issued number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0005'];
+  const issued = issueInvoice(invoice, existingNumbers).value;
+  const text = renderInvoiceText(issued);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0006');
+});
