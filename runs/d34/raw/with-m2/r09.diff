+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('C-003 '), 'C-003');
+  assert.equal(normalizeId(' C-003'), 'C-003');
+  assert.equal(normalizeId(' C-003 '), 'C-003');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-003'), 'C-003');
+  assert.equal(normalizeId('C-003'), 'C-003');
+  assert.equal(normalizeId('c-003'), 'C-003');
+});
+
+test('normalizeId handles mixed case with spaces', () => {
+  assert.equal(normalizeId(' c-003 '), 'C-003');
+  assert.equal(normalizeId(' C-007 '), 'C-007');
+  assert.equal(normalizeId('c-001 '), 'C-001');
+});
+
+test('getCustomer finds customer with normalized id', () => {
+  const r1 = getCustomer('C-003');
+  const r2 = getCustomer('c-003');
+  const r3 = getCustomer(' c-003 ');
+
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+  assert.equal(r3.ok, true);
+  assert.equal(r1.value.name, 'Kite & Co');
+  assert.equal(r2.value.name, 'Kite & Co');
+  assert.equal(r3.value.name, 'Kite & Co');
+});
