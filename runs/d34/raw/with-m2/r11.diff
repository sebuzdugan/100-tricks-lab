new file mode 100644
index 0000000..53e0f19
--- /dev/null
+++ b/src/payments.js
@@ -0,0 +1,39 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
+
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const balance = balanceDue(invoice);
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  const payments = invoice.payments || [];
+  const newPayments = [...payments, { amount, date }];
+  const newBalance = balance - amount;
+  const status = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
index 0000000..6514a94
--- /dev/null
+++ b/test/payments.test.js
@@ -0,0 +1,189 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue returns total for unpaid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const balance = balanceDue(issued);
+  assert.ok(balance > 0);
+});
+
+test('balanceDue returns zero for fully paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  const payment1 = recordPayment(issued, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(balanceDue(payment1.value), 0);
+});
+
+test('balanceDue tracks partial payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const halfPayment = Math.floor(totals.total / 2);
+
+  const payment1 = recordPayment(issued, { amount: halfPayment, date: '2026-10-08' });
+  const remaining = balanceDue(payment1.value);
+  assert.equal(remaining, totals.total - halfPayment);
+});
+
+test('recordPayment requires issued status', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  assert.deepEqual(recordPayment(invoice, { amount: 1000, date: '2026-10-08' }), { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment requires positive integer amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 0, date: '2026-10-08' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(recordPayment(issued, { amount: -100, date: '2026-10-08' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(recordPayment(issued, { amount: 100.5, date: '2026-10-08' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(recordPayment(issued, { amount: 'hundred', date: '2026-10-08' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment requires valid date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 1000, date: '10/08/2026' }), { ok: false, error: 'DATE_INVALID' });
+  assert.deepEqual(recordPayment(issued, { amount: 1000, date: 'not-a-date' }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  assert.deepEqual(recordPayment(issued, { amount: totals.total + 1, date: '2026-10-08' }), { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment records payment on issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r = recordPayment(issued, { amount: 5000, date: '2026-10-08' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 5000);
+  assert.equal(r.value.payments[0].date, '2026-10-08');
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment marks invoice as paid when fully paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  const r = recordPayment(issued, { amount: totals.total, date: '2026-10-08' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+  assert.equal(balanceDue(r.value), 0);
+});
+
+test('recordPayment handles multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const thirdAmount = Math.floor(totals.total / 3);
+
+  const payment1 = recordPayment(issued, { amount: thirdAmount, date: '2026-10-08' });
+  assert.equal(payment1.value.status, 'partially_paid');
+
+  const payment2 = recordPayment(payment1.value, { amount: thirdAmount, date: '2026-10-09' });
+  assert.equal(payment2.value.status, 'partially_paid');
+  assert.equal(payment2.value.payments.length, 2);
+
+  const remaining = balanceDue(payment2.value);
+  const payment3 = recordPayment(payment2.value, { amount: remaining, date: '2026-10-10' });
+  assert.equal(payment3.ok, true);
+  assert.equal(payment3.value.status, 'paid');
+  assert.equal(payment3.value.payments.length, 3);
+});
+
+test('recordPayment allows payment on partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const halfPayment = Math.floor(totals.total / 2);
+
+  const payment1 = recordPayment(issued, { amount: halfPayment, date: '2026-10-08' });
+  assert.equal(payment1.value.status, 'partially_paid');
+
+  const r = recordPayment(payment1.value, { amount: halfPayment, date: '2026-10-09' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  recordPayment(issued, { amount: 5000, date: '2026-10-08' });
+
+  assert.equal(issued.payments, undefined);
+  assert.equal(issued.status, 'issued');
+});
