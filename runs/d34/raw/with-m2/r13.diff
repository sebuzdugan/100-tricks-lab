+test('applyVoucher applies a voucher to a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = applyVoucher(invoice, { code: 'SUMMER20', amount: 5000 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher.code, 'SUMMER20');
+  assert.equal(r.value.voucher.amount, 5000);
+});
+
+test('applyVoucher updates invoiceTotals with voucher', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const totalsWithoutVoucher = invoiceTotals(invoice);
+  const withVoucher = applyVoucher(invoice, { code: 'PROMO', amount: 1000 }).value;
+  const totalsWithVoucher = invoiceTotals(withVoucher);
+
+  assert.equal(totalsWithVoucher.voucher, 1000);
+  assert.equal(totalsWithVoucher.total, totalsWithoutVoucher.total - 1000);
+});
+
+test('applyVoucher requires draft status', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  assert.deepEqual(applyVoucher(issued, { code: 'TEST', amount: 1000 }), { ok: false, error: 'NOT_DRAFT' });
+});
+
+test('applyVoucher rejects duplicate vouchers', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
