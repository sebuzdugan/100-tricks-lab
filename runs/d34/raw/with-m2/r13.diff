+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'FIRST', amount: 1000 }).value;
+  assert.deepEqual(applyVoucher(withVoucher, { code: 'SECOND', amount: 500 }), { ok: false, error: 'VOUCHER_EXISTS' });
+});
+
+test('applyVoucher requires positive integer amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
