+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns invoices for a customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const r = statement('C-003', [issued1, issued2], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-15');
+});
+
+test('statement filters by date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const r = statement('C-003', [issued1, issued2], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement filters by status', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, []).value;
+
+  const r = statement('C-003', [inv1, issued2], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-02');
+});
+
+test('statement excludes fully paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-05' }).value;
+
+  const r = statement('C-003', [paid], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement calculates total due', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+  const totals1 = invoiceTotals(issued1);
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+  const totals2 = invoiceTotals(issued2);
+
+  const r = statement('C-003', [issued1, issued2], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.totalDue, totals1.total + totals2.total);
+});
+
+test('statement sorts invoices by issue date', () => {
+  const inv3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued3 = issueInvoice(inv3, []).value;
+
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, ['INV-2026-0001']).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0002']).value;
+
+  const r = statement('C-003', [issued3, issued1, issued2], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-10');
+  assert.equal(r.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement with partial payment', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const halfPayment = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued, { amount: halfPayment, date: '2026-10-05' }).value;
+
+  const r = statement('C-003', [partial], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].due, totals.total - halfPayment);
+  assert.equal(r.value.totalDue, totals.total - halfPayment);
+});
+
+test('statement filters by customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const r = statement('C-003', [issued1, issued2], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement returns empty list for no matching invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = statement('C-003', [inv], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  assert.deepEqual(statement('C-999', [inv], '2026-10-31'), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
