diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..dbc5f8d
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,161 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Discount');
+  assert.equal(r.value.date, '2026-10-10');
+});
+
+test('createCreditNote works for partially paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const halfPayment = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued, { amount: halfPayment, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(partial, { amount: 1000, reason: 'Defect', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, 1000);
+});
+
+test('createCreditNote works for paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(paid, { amount: 5000, reason: 'Return', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  assert.deepEqual(createCreditNote(inv, { amount: 5000, reason: 'Test', date: '2026-10-10' }, []), { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote requires positive integer amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  assert.deepEqual(createCreditNote(issued, { amount: 0, reason: 'Test', date: '2026-10-10' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(createCreditNote(issued, { amount: -100, reason: 'Test', date: '2026-10-10' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(createCreditNote(issued, { amount: 100.5, reason: 'Test', date: '2026-10-10' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(createCreditNote(issued, { amount: 'hundred', reason: 'Test', date: '2026-10-10' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote requires valid date', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  assert.deepEqual(createCreditNote(issued, { amount: 5000, reason: 'Test', date: '10/10/2026' }, []), { ok: false, error: 'DATE_INVALID' });
+  assert.deepEqual(createCreditNote(issued, { amount: 5000, reason: 'Test', date: 'not-a-date' }, []), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote rejects credit notes exceeding invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  assert.deepEqual(createCreditNote(issued, { amount: totals.total + 1, reason: 'Test', date: '2026-10-10' }, []), { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote numbers independently from invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const cn1 = createCreditNote(issued1, { amount: 5000, reason: 'Test', date: '2026-10-10' }, ['INV-2026-0001', 'INV-2026-0002']).value;
+  const cn2 = createCreditNote(issued2, { amount: 5000, reason: 'Test', date: '2026-10-10' }, ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001']).value;
+
+  assert.equal(cn1.number, 'CN-2026-0001');
+  assert.equal(cn2.number, 'CN-2026-0002');
+});
+
+test('createCreditNote credit note counter resets by year', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2027-05-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001', 'INV-2027-0001']).value;
+
+  const cn1 = createCreditNote(issued1, { amount: 5000, reason: 'Test', date: '2026-10-10' }, ['CN-2026-0001', 'CN-2026-0002']).value;
+  const cn2 = createCreditNote(issued2, { amount: 5000, reason: 'Test', date: '2027-05-16' }, ['CN-2026-0001', 'CN-2026-0002']).value;
+
+  assert.equal(cn1.number, 'CN-2026-0003');
+  assert.equal(cn2.number, 'CN-2027-0001');
+});
+
+test('createCreditNote with maximum amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const r = createCreditNote(issued, { amount: totals.total, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, totals.total);
+});
