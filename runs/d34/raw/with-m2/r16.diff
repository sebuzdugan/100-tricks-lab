@@ -0,0 +1,166 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices includes invoices with dueDate before asOf', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const overdue = overdueInvoices([issued], '2026-10-20');
+  assert.equal(overdue.length, 1);
+  assert.equal(overdue[0].number, 'INV-2026-0001');
+  assert.equal(overdue[0].dueDate, '2026-10-15');
+});
+
+test('overdueInvoices excludes future due dates', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const overdue = overdueInvoices([issued], '2026-10-14');
+  assert.equal(overdue.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-10' }).value;
+
+  const overdue = overdueInvoices([paid], '2026-10-20');
+  assert.equal(overdue.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const overdue = overdueInvoices([inv], '2026-10-20');
+  assert.equal(overdue.length, 0);
+});
+
+test('overdueInvoices sorts by most overdue first', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const overdue = overdueInvoices([issued2, issued1], '2026-10-25');
+  assert.equal(overdue.length, 2);
+  assert.equal(overdue[0].dueDate, '2026-10-15');
+  assert.equal(overdue[0].daysOverdue, 10);
+  assert.equal(overdue[1].dueDate, '2026-10-19');
+  assert.equal(overdue[1].daysOverdue, 6);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const overdue = overdueInvoices([issued], '2026-10-25');
+  assert.equal(overdue.length, 1);
+  assert.equal(overdue[0].daysOverdue, 10);
+});
+
+test('overdueInvoices includes due amount from partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const halfPayment = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued, { amount: halfPayment, date: '2026-10-10' }).value;
+
+  const overdue = overdueInvoices([partial], '2026-10-20');
+  assert.equal(overdue.length, 1);
+  assert.equal(overdue[0].due, totals.total - halfPayment);
+});
+
+test('overdueInvoices returns empty list when no overdue invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const overdue = overdueInvoices([issued], '2026-10-15');
+  assert.equal(overdue.length, 0);
+});
+
+test('overdueInvoices includes customerId in result', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const overdue = overdueInvoices([issued], '2026-10-20');
+  assert.equal(overdue.length, 1);
+  assert.equal(overdue[0].customerId, 'C-003');
+});
+
+test('overdueInvoices with multiple statuses', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+  const totals2 = invoiceTotals(issued2);
+  const partial = recordPayment(issued2, { amount: Math.floor(totals2.total / 2), date: '2026-10-10' }).value;
+
+  const overdue = overdueInvoices([issued1, partial], '2026-10-25');
+  assert.equal(overdue.length, 2);
+});
