 export function overdueInvoices(invoices, asOf) {
   const overdue = invoices
@@ -16,3 +17,36 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVAT(line);
+
+      if (!vatMap[rate]) {
+        vatMap[rate] = { base: 0, vat: 0 };
+      }
+
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vat;
+    }
+  }
+
+  const result = Object.entries(vatMap)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseInt(rate, 10),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return result;
+}
