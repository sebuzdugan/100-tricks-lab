+  assert.equal(fee, expectedFee);
+});
+
+test('lateFee charges on amount still due', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const halfPayment = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued, { amount: halfPayment, date: '2026-10-10' }).value;
+
+  const fee = lateFee(partial, '2026-10-20');
+  const amountDue = totals.total - halfPayment;
+  const expectedFee = Math.round(amountDue * 0.0004 * 5);
+  assert.equal(fee, expectedFee);
+});
