+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function formatEuro(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+function escapeCsvField(field) {
+  const str = String(field);
+  if (str.includes(',') || str.includes('"')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+export function exportCsv(invoices) {
+  const lines = [];
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number || 'DRAFT',
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate || '',
+      invoice.status,
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ];
+
+    const csvLine = fields.map(escapeCsvField).join(',');
+    lines.push(csvLine);
+  }
+
+  return lines.join('\n') + '\n';
+}
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..62a12fa
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,177 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv includes header line', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv exports a single issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const csv = exportCsv([issued]);
+  const lines = csv.trim().split('\n');
+  assert.equal(lines.length, 2);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('2026-10-01'));
+  assert(lines[1].includes(issued.status));
+});
+
+test('exportCsv shows DRAFT for draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const csv = exportCsv([inv]);
+  const lines = csv.trim().split('\n');
+  assert(lines[1].startsWith('DRAFT,'));
+});
+
+test('exportCsv shows empty dueDate for draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const csv = exportCsv([inv]);
+  const lines = csv.trim().split('\n');
+  assert(lines[1].includes('DRAFT'));
+});
+
+test('exportCsv exports multiple invoices in order', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const csv = exportCsv([issued1, issued2]);
+  const lines = csv.trim().split('\n');
+  assert.equal(lines.length, 3);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv formats amounts in euros', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+  assert(csv.includes('.00'));
+  assert(!csv.includes('€'));
+  assert(!csv.includes(',00'));
+});
+
+test('exportCsv includes customer name', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+  assert(csv.includes('Kite & Co'));
+});
+
+test('exportCsv escapes fields with commas', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+  const lines = csv.trim().split('\n');
+  assert(lines[1].length > 0);
+});
+
+test('exportCsv handles different invoice statuses', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-05' }).value;
+
+  const csv = exportCsv([paid]);
+  assert(csv.includes('paid'));
+});
+
+test('exportCsv calculates due amount with payments', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const halfPayment = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued, { amount: halfPayment, date: '2026-10-05' }).value;
+
+  const csv = exportCsv([partial]);
+  const expectedDue = ((totals.total - halfPayment) / 100).toFixed(2);
+  assert(csv.includes(expectedDue));
+});
+
+test('exportCsv includes discount and VAT', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 10 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const csv = exportCsv([issued]);
+  const discountStr = (totals.discount / 100).toFixed(2);
+  const vatStr = (totals.vat / 100).toFixed(2);
+  assert(csv.includes(discountStr));
+  assert(csv.includes(vatStr));
+});
+
+test('exportCsv ends with newline', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+  assert(csv.endsWith('\n'));
+});
+
+test('exportCsv with empty invoice list', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
