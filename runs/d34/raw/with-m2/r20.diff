 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,43 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert cents in EUR to cents in the target currency.
+ * @param {number} cents
+ * @param {string} currency
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const convertedCents = roundCents(cents * rate);
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents in EUR as money in the target currency: 123456 in USD -> "$1,234.56".
+ * @param {number} cents
+ * @param {string} currency
+ * @returns {string}
+ */
+export function formatMoney(cents, currency = 'EUR') {
+  if (!RATES[currency]) {
+    return 'Unknown currency';
+  }
+
+  const symbol = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  }[currency];
+
+  const convertedCents = currency === 'EUR' ? cents : roundCents(cents * RATES[currency]);
+  const sign = convertedCents < 0 ? '-' : '';
+  const abs = Math.abs(convertedCents);
+  const main = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${main}.${String(abs % 100).padStart(2, '0')}`;
+}
