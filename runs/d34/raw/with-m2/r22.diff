diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..c8509ae
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,35 @@
+import { roundCents } from './money.js';
+
+function validateDiscount(discountPercent) {
+  return typeof discountPercent === 'number' && discountPercent >= 0 && discountPercent <= 100;
+}
+
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+export function lineDiscount(line) {
+  const discount = (lineTotal(line) * (line.discountPercent ?? 0)) / 100;
+  return Math.max(0, roundCents(discount));
+}
+
+export function lineVAT(line) {
+  const lineAmount = lineTotal(line) - lineDiscount(line);
+  const vat = (lineAmount * (line.vatRate ?? 0)) / 100;
+  return Math.max(0, roundCents(vat));
+}
+
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..054aaac
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,167 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('lineTotal calculates qty * unitPrice', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineDiscount returns 0 when no discount', () => {
+  const line = { qty: 1, unitPrice: 8500, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount calculates percentage discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 10 };
+  const total = lineTotal(line);
+  const expected = Math.round((total * 10) / 100);
+  assert.equal(lineDiscount(line), expected);
+});
+
+test('lineDiscount returns 0 when no discountPercent', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount handles decimal discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 2.5 };
+  const total = lineTotal(line);
+  const discount = (total * 2.5) / 100;
+  assert.equal(lineDiscount(line), Math.round(discount));
+});
+
+test('lineVAT calculates tax on amount after discount', () => {
+  const line = { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 };
+  const amount = lineTotal(line) - lineDiscount(line);
+  const expectedVAT = Math.round((amount * 21) / 100);
+  assert.equal(lineVAT(line), expectedVAT);
+});
+
+test('lineVAT with discount', () => {
+  const line = { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 10 };
+  const amount = lineTotal(line) - lineDiscount(line);
+  const expectedVAT = Math.round((amount * 21) / 100);
+  assert.equal(lineVAT(line), expectedVAT);
+});
+
+test('lineVAT returns 0 for zero VAT rate', () => {
+  const line = { qty: 1, unitPrice: 8500, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT with 9% rate', () => {
+  const line = { qty: 5, unitPrice: 2000, vatRate: 9 };
+  const amount = lineTotal(line);
+  const expectedVAT = Math.round((amount * 9) / 100);
+  assert.equal(lineVAT(line), expectedVAT);
+});
+
+test('invoiceTotals calculates subtotal', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const totals = invoiceTotals(inv);
+  const expectedSubtotal = 1 * 8500;
+  assert.equal(totals.subtotal, expectedSubtotal);
+});
+
+test('invoiceTotals calculates discount', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  }).value;
+
+  const totals = invoiceTotals(inv);
+  assert(totals.discount > 0);
+});
+
+test('invoiceTotals calculates VAT', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const totals = invoiceTotals(inv);
+  assert(totals.vat > 0);
+});
+
+test('invoiceTotals includes voucher deduction', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const invWithVoucher = {
+    ...inv,
+    voucher: { code: 'PROMO', amount: 1000 },
+  };
+
+  const totals = invoiceTotals(invWithVoucher);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals total formula', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const totals = invoiceTotals(inv);
+  const expected = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 10 },
+    ],
+  }).value;
+
+  const totals = invoiceTotals(inv);
+  assert(totals.subtotal > 0);
+  assert(totals.vat > 0);
+});
+
+test('invoiceTotals total never goes negative', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const invWithLargeVoucher = {
+    ...inv,
+    voucher: { code: 'MEGA', amount: 1000000 },
+  };
+
+  const totals = invoiceTotals(invWithLargeVoucher);
+  assert.equal(totals.total, 0);
+});
+
+test('lineDiscount never negative', () => {
+  const line = { qty: 1, unitPrice: 8500, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVAT never negative', () => {
+  const line = { qty: 1, unitPrice: 8500, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
