+import { lineTotal, lineDiscount, invoiceTotals } from './invoices.js';
 import { formatEuros } from './money.js';
 
 export function renderInvoiceText(invoice) {
@@ -16,13 +16,31 @@ export function renderInvoiceText(invoice) {
     const total = lineTotal(line);
     const lineStr = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
     lines.push(lineStr);
+
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      lines.push(`  Discount: ${formatEuros(discount)}`);
+    }
   }
 
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: ${formatEuros(totals.voucher)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const paid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return lines.join('\n');
 }
