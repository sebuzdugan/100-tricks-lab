@@ -0,0 +1,56 @@
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Create an invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {object}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate date format and reality
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+  const date = new Date(issueDate);
+  if (date.toISOString().substring(0, 10) !== issueDate) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines array
+  if (!lines || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Validate and enrich lines
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Validate and get product
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    enrichedLines.push({
+      sku: line.sku,
+      name: productResult.value.name,
+      qty: line.qty,
+      unitPrice: productResult.value.unitPrice,
+      vatRate: productResult.value.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
