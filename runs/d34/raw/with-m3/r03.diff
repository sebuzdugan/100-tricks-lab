diff --git a/src/invoices.js b/src/invoices.js
index b9ab575..a8da9d2 100644
--- a/src/invoices.js
+++ b/src/invoices.js
@@ -73,3 +73,73 @@ export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   return { subtotal, total: subtotal };
 }
+
+/**
+ * Add or update a line on an invoice.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }}
+ * @returns {object}
+ */
+export function addLine(invoice, { sku, qty }) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  if (!Number.isInteger(qty) || qty <= 0) {
+    return fail('QTY_INVALID');
+  }
+
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const newLines = invoice.lines.map(line => ({ ...line }));
+  const existingIndex = newLines.findIndex(line => line.sku === sku);
+
+  if (existingIndex >= 0) {
+    newLines[existingIndex] = {
+      ...newLines[existingIndex],
+      qty: newLines[existingIndex].qty + qty,
+    };
+  } else {
+    newLines.push({
+      sku: sku,
+      name: productResult.value.name,
+      qty: qty,
+      unitPrice: productResult.value.unitPrice,
+      vatRate: productResult.value.vatRate,
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {object}
+ */
+export function removeLine(invoice, sku) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  const lineIndex = invoice.lines.findIndex(line => line.sku === sku);
+  if (lineIndex < 0) {
+    return fail('LINE_NOT_FOUND');
+  }
+
+  if (invoice.lines.length === 1) {
+    return fail('NO_LINES');
+  }
+
+  const newLines = invoice.lines.filter((_, index) => index !== lineIndex);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
