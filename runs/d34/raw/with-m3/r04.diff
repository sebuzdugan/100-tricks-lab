new file mode 100644
index 0000000..c1cc958
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,22 @@
+/**
+ * Generate the next invoice number for a given issue date.
+ * Format: INV-<year>-<4-digit counter starting at 0001>
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  const counters = existingNumbers
+    .filter(num => num.startsWith(prefix))
+    .map(num => {
+      const counterStr = num.substring(prefix.length);
+      return parseInt(counterStr, 10);
+    })
+    .filter(n => !isNaN(n));
+
+  const nextCounter = (counters.length === 0 ? 0 : Math.max(...counters)) + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
