diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..c9237e3
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,38 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for new year', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const result = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber finds max counter in any order', () => {
+  const result = nextInvoiceNumber(['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const result = nextInvoiceNumber(['INV-2025-0100', 'INV-2026-0001', 'INV-2027-0002'], '2026-05-15');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber pads counter with leading zeros', () => {
+  const result = nextInvoiceNumber([], '2026-01-01');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber handles empty array', () => {
+  const result = nextInvoiceNumber([], '2025-12-31');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const result = nextInvoiceNumber(['INV-2026-NOPE', 'INV-2026-0001'], '2026-06-01');
+  assert.equal(result, 'INV-2026-0002');
+});
