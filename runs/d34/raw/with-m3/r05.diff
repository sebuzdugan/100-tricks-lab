+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  const lines = [];
+
+  // Header
+  const invoiceNumber = invoice.number ?? 'DRAFT';
+  lines.push(invoiceNumber);
+  lines.push(customerName);
+
+  // Line items
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `  ${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Total
+  const invoiceTotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  lines.push(`Total: ${formatEuros(invoiceTotal)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..753fe6f
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+  assert.ok(text.includes('2 x Design work (hour)'));
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€170.00'));
+  assert.ok(text.includes('Total: €170.00'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  assert.ok(text.includes('INV-2026-0001'));
+  assert.ok(!text.includes('DRAFT'));
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Kite & Co'));
+  assert.ok(text.includes('2 x Design work (hour)'));
+  assert.ok(text.includes('3 x Development (hour)'));
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // DRAFT + customer + 2 items + total
+});
+
+test('renderInvoiceText formats amounts as euros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 100 },
+      { sku: 'ICON-SET', qty: 50 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  // STICKER: 100 * 50 cents = 5000 cents = €50.00
+  assert.ok(text.includes('€0.50')); // unit price
+  // ICON-SET: 50 * 980 cents = 49000 cents = €490.00
+  assert.ok(text.includes('€9.80')); // unit price
+  assert.ok(text.includes('€50.00')); // STICKER total
+  assert.ok(text.includes('€490.00')); // ICON-SET total
+  assert.ok(text.includes('Total: €540.00'));
+});
+
+test('renderInvoiceText shows line structure correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // Check line format: qty x name @ price = total
+  assert.ok(lines[2].includes('2 x Design work (hour) @'));
+  assert.ok(lines[2].includes('= €170.00'));
+});
