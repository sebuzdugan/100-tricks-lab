@@ -0,0 +1,54 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, payments?: Array, lines: Array }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {object}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const currentBalance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > currentBalance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array
+  const payments = invoice.payments ? invoice.payments.map(p => ({ ...p })) : [];
+  payments.push({ amount, date });
+
+  // Calculate new balance and determine status
+  const totals = invoiceTotals(invoice);
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  const newStatus = totalPaid >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array, lines: Array }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
index 0000000..be1d680
--- /dev/null
+++ b/test/payments.test.js
@@ -0,0 +1,180 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('recordPayment records a payment on issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }], // 17000 + 3570 VAT = 20570
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = recordPayment(issued, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 10000);
+  assert.equal(r.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment marks invoice as paid when fully paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }], // 20570 total
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r = recordPayment(issued, { amount: 20570, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment records multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }], // 20570 total
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const r1 = recordPayment(issued, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.payments.length, 1);
+
+  const r2 = recordPayment(r1.value, { amount: 10570, date: '2026-10-09' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'paid');
+  assert.equal(r2.value.payments.length, 2);
+  assert.equal(r2.value.payments[1].amount, 10570);
+});
+
+test('recordPayment returns NOT_ISSUED for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  assert.deepEqual(recordPayment(invoice, { amount: 10000, date: '2026-10-08' }), {
+    ok: false,
+    error: 'NOT_ISSUED',
+  });
+});
+
+test('recordPayment returns AMOUNT_INVALID for invalid amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 0, date: '2026-10-08' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(recordPayment(issued, { amount: -1000, date: '2026-10-08' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(recordPayment(issued, { amount: 10.5, date: '2026-10-08' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment returns OVERPAYMENT if amount exceeds balance', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }], // 20570 total
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 20571, date: '2026-10-08' }), {
+    ok: false,
+    error: 'OVERPAYMENT',
+  });
+});
+
+test('recordPayment does not mutate input invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const original = JSON.parse(JSON.stringify(issued));
+
+  recordPayment(issued, { amount: 10000, date: '2026-10-08' });
+  assert.deepEqual(issued, original);
+});
+
+test('balanceDue returns full amount for new issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }], // 20570 total
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.equal(balanceDue(issued), 20570);
+});
+
+test('balanceDue returns zero for paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }], // 20570 total
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const paid = recordPayment(issued, { amount: 20570, date: '2026-10-08' }).value;
+
+  assert.equal(balanceDue(paid), 0);
+});
+
+test('balanceDue returns remaining balance after partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }], // 20570 total
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const partial = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+
+  assert.equal(balanceDue(partial), 10570);
+});
+
+test('balanceDue accounts for multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }], // 20570 total
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const p1 = recordPayment(issued, { amount: 5000, date: '2026-10-08' }).value;
+  const p2 = recordPayment(p1, { amount: 8000, date: '2026-10-09' }).value;
+
+  assert.equal(balanceDue(p2), 7570);
+});
+
+test('recordPayment allows payment on partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const partial = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+
+  assert.equal(partial.status, 'partially_paid');
+
+  const r = recordPayment(partial, { amount: 10570, date: '2026-10-09' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
