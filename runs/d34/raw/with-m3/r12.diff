--- a/src/dates.js
+++ b/src/dates.js
@@ -38,3 +38,34 @@ export function daysBetween(a, b) {
   const diffMs = dateB - dateA;
   return Math.floor(diffMs / (1000 * 60 * 60 * 24));
 }
+
+/**
+ * Get the last day of the month for a given date.
+ * @param {string} date
+ * @returns {string}
+ */
+export function lastDayOfMonth(date) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCMonth(d.getUTCMonth() + 1);
+  d.setUTCDate(0);
+  return d.toISOString().substring(0, 10);
+}
+
+/**
+ * Calculate due date based on payment terms.
+ * @param {string} issueDate
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string | null}
+ */
+export function calculateDueDate(issueDate, terms) {
+  switch (terms) {
+    case 'NET14':
+      return addDays(issueDate, 14);
+    case 'NET30':
+      return addDays(issueDate, 30);
+    case 'EOM':
+      return lastDayOfMonth(issueDate);
+    default:
+      return null;
+  }
+}
