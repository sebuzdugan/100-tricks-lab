+test('invoiceTotals includes voucher in total', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 2, unitPrice: 8500, vatRate: 21, name: 'Design work', discountPercent: 0 }],
