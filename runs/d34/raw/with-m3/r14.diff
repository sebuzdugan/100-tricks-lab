+++ b/test/statements.test.js
@@ -0,0 +1,185 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns empty list for customer with no invoices', () => {
+  const r = statement('C-001', [], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes issued invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv1, []).value;
+
+  const r = statement('C-002', [issued], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[0].total, 20570);
+  assert.equal(r.value.invoices[0].due, 20570);
+  assert.equal(r.value.totalDue, 20570);
+});
+
+test('statement includes partially paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv1, []).value;
+  const partial = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+
+  const r = statement('C-002', [partial], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].due, 10570); // 20570 - 10000
+  assert.equal(r.value.totalDue, 10570);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const r = statement('C-002', [draft], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv1, []).value;
+  const paid = recordPayment(issued, { amount: 20570, date: '2026-10-08' }).value;
+
+  const r = statement('C-002', [paid], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement filters by asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const r = statement('C-002', [issued1, issued2], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement filters by customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const r = statement('C-002', [issued1, issued2], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.customerId, 'C-002');
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  assert.deepEqual(statement('C-999', [], '2026-10-31'), {
+    ok: false,
+    error: 'CUSTOMER_NOT_FOUND',
+  });
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+  const issued3 = issueInvoice(inv3, ['INV-2026-0001', 'INV-2026-0002']).value;
+
+  const r = statement('C-002', [issued1, issued2, issued3], '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-15');
+  assert.equal(r.value.invoices[2].issueDate, '2026-10-20');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+  const partial2 = recordPayment(issued2, { amount: 5000, date: '2026-10-16' }).value;
+
+  const r = statement('C-002', [issued1, partial2], '2026-10-31');
+  assert.equal(r.ok, true);
+  // inv1: 20570, inv2: 10285 - 5000 = 5285
+  assert.equal(r.value.totalDue, 25855);
+});
+
+test('statement includes voucher in due calculation', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const withVoucher = applyVoucher(inv1, { code: 'SAVE50', amount: 5000 }).value;
+  const issued = issueInvoice(withVoucher, []).value;
+
+  const r = statement('C-002', [issued], '2026-10-31');
+  assert.equal(r.ok, true);
+  // Total with voucher: 20570 - 5000 = 15570
+  assert.equal(r.value.invoices[0].total, 15570);
+  assert.equal(r.value.invoices[0].due, 15570);
+  assert.equal(r.value.totalDue, 15570);
+});
