+import { invoiceTotals } from './invoices.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} options
+ * @param {Array<string>} existingNumbers - both INV and CN numbers
+ * @returns {object}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice is not draft
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total and validate credit doesn't exceed it
+  const { total } = invoiceTotals(invoice);
+  if (amount > total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const year = date.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  const counters = existingNumbers
+    .filter(num => num.startsWith(prefix))
+    .map(num => {
+      const counterStr = num.substring(prefix.length);
+      return parseInt(counterStr, 10);
+    })
+    .filter(n => !isNaN(n));
+
+  const nextCounter = (counters.length === 0 ? 0 : Math.max(...counters)) + 1;
+  const number = `${prefix}${String(nextCounter).padStart(4, '0')}`;
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
