+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates credit note from issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: 5000,
+    reason: 'Partial refund',
+    date: '2026-10-08',
+  }, ['INV-2026-0001']);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r.value.customerId, 'C-002');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Partial refund');
+  assert.equal(r.value.date, '2026-10-08');
+});
+
+test('createCreditNote creates credit note from partially_paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(partial, {
+    amount: 3000,
+    reason: 'Adjustment',
+    date: '2026-10-09',
+  }, ['INV-2026-0001']);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, 'INV-2026-0001');
+});
+
+test('createCreditNote creates credit note from paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const paid = recordPayment(issued, { amount: 20570, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(paid, {
+    amount: 10000,
+    reason: 'Full refund',
+    date: '2026-10-09',
+  }, ['INV-2026-0001']);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote returns NOT_ISSUED for draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const r = createCreditNote(draft, {
+    amount: 5000,
+    reason: 'Refund',
+    date: '2026-10-08',
+  }, []);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote returns AMOUNT_INVALID for zero amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: 0,
+    reason: 'Refund',
+    date: '2026-10-08',
+  }, ['INV-2026-0001']);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote returns AMOUNT_INVALID for negative amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: -5000,
+    reason: 'Refund',
+    date: '2026-10-08',
+  }, ['INV-2026-0001']);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote returns AMOUNT_INVALID for fractional amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: 5000.5,
+    reason: 'Refund',
+    date: '2026-10-08',
+  }, ['INV-2026-0001']);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote returns CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: 30000, // invoice total is 20570
+    reason: 'Refund',
+    date: '2026-10-08',
+  }, ['INV-2026-0001']);
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote allows credit up to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: 20570, // exactly the total
+    reason: 'Full refund',
+    date: '2026-10-08',
+  }, ['INV-2026-0001']);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, 20570);
+});
+
+test('createCreditNote numbers start at CN-YYYY-0001', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: 5000,
+    reason: 'Refund',
+    date: '2026-10-07',
+  }, []);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote increments credit note counter', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r1 = createCreditNote(issued, {
+    amount: 5000,
+    reason: 'Refund 1',
+    date: '2026-10-07',
+  }, []);
+
+  const r2 = createCreditNote(issued, {
+    amount: 3000,
+    reason: 'Refund 2',
+    date: '2026-10-07',
+  }, [r1.value.number]);
+
+  assert.equal(r1.value.number, 'CN-2026-0001');
+  assert.equal(r2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote uses separate counter from invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: 5000,
+    reason: 'Refund',
+    date: '2026-10-07',
+  }, ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003']);
+
+  // Credit note should still be 0001, not 0004
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote handles mixed INV and CN numbers', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: 5000,
+    reason: 'Refund',
+    date: '2026-10-07',
+  }, ['INV-2026-0001', 'CN-2026-0001', 'INV-2026-0002']);
+
+  // Should increment CN counter to 0002
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote does not mutate input invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const invoiceSnapshot = JSON.stringify(issued);
+
+  createCreditNote(issued, {
+    amount: 5000,
+    reason: 'Refund',
+    date: '2026-10-08',
+  }, ['INV-2026-0001']);
+
+  assert.equal(JSON.stringify(issued), invoiceSnapshot);
+});
+
+test('createCreditNote uses year from credit note date for numbering', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, {
+    amount: 5000,
+    reason: 'Refund',
+    date: '2027-01-15',
+  }, ['CN-2026-0001']);
+
+  // Should use 2027, so counter is separate
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2027-0001');
+});
