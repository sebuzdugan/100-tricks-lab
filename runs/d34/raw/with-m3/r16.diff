+++ b/test/reports.test.js
@@ -0,0 +1,241 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array for no invoices', () => {
+  const r = overdueInvoices([], '2026-10-31');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices includes overdue issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14', // due 2026-10-15
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = overdueInvoices([issued], '2026-10-20');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].number, 'INV-2026-0001');
+  assert.equal(r[0].customerId, 'C-002');
+  assert.equal(r[0].dueDate, '2026-10-15');
+  assert.equal(r[0].daysOverdue, 5);
+  assert.equal(r[0].due, 20570);
+});
+
+test('overdueInvoices includes overdue partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+
+  const r = overdueInvoices([partial], '2026-10-20');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].daysOverdue, 5);
+  assert.equal(r[0].due, 10570); // 20570 - 10000
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+
+  const r = overdueInvoices([draft], '2026-10-20');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const paid = recordPayment(issued, { amount: 20570, date: '2026-10-08' }).value;
+
+  const r = overdueInvoices([paid], '2026-10-20');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices excludes invoices with future due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET30', // due 2026-10-31
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = overdueInvoices([issued], '2026-10-20');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices excludes invoices with due date equal to asOf', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14', // due 2026-10-15
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = overdueInvoices([issued], '2026-10-15');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14', // due 2026-10-15
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = overdueInvoices([issued], '2026-10-22');
+  assert.equal(r[0].daysOverdue, 7); // 2026-10-22 - 2026-10-15 = 7 days
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14', // due 2026-10-15
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14', // due 2026-10-19
+  }).value;
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14', // due 2026-10-22
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+  const issued3 = issueInvoice(inv3, ['INV-2026-0001', 'INV-2026-0002']).value;
+
+  const r = overdueInvoices([issued1, issued2, issued3], '2026-10-25');
+
+  // All three are overdue as of 2026-10-25
+  assert.equal(r.length, 3);
+  // inv1 due 2026-10-15: 10 days overdue
+  assert.equal(r[0].number, 'INV-2026-0001');
+  assert.equal(r[0].daysOverdue, 10);
+  // inv2 due 2026-10-19: 6 days overdue
+  assert.equal(r[1].number, 'INV-2026-0002');
+  assert.equal(r[1].daysOverdue, 6);
+  // inv3 due 2026-10-22: 3 days overdue
+  assert.equal(r[2].number, 'INV-2026-0003');
+  assert.equal(r[2].daysOverdue, 3);
+});
+
+test('overdueInvoices includes correct customerId', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const r = overdueInvoices([issued1, issued2], '2026-10-20');
+
+  assert.equal(r.length, 2);
+  assert.equal(r[0].customerId, 'C-001');
+  assert.equal(r[1].customerId, 'C-002');
+});
+
+test('overdueInvoices includes partially paid amount due', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2026-10-08' }).value;
+  const partial2 = recordPayment(partial, { amount: 3000, date: '2026-10-10' }).value;
+
+  const r = overdueInvoices([partial2], '2026-10-20');
+
+  assert.equal(r.length, 1);
+  assert.equal(r[0].due, 12570); // 20570 - 5000 - 3000
+});
+
+test('overdueInvoices does not mutate input array', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const invoices = [issued];
+  const snapshot = JSON.stringify(invoices);
+
+  overdueInvoices(invoices, '2026-10-20');
+
+  assert.equal(JSON.stringify(invoices), snapshot);
+});
+
+test('overdueInvoices handles mixed statuses', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-03',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+  const issued3 = issueInvoice(inv3, ['INV-2026-0001', 'INV-2026-0002']).value;
+
+  const partial2 = recordPayment(issued2, { amount: 10000, date: '2026-10-08' }).value;
+  const paid3 = recordPayment(issued3, { amount: 20570, date: '2026-10-09' }).value;
+
+  // Check as of a date when all are overdue
+  const r = overdueInvoices([issued1, partial2, paid3], '2026-10-25');
+
+  // Only issued and partially_paid should be included
+  assert.equal(r.length, 2);
+  assert.equal(r[0].number, 'INV-2026-0001'); // issued
+  assert.equal(r[1].number, 'INV-2026-0002'); // partially_paid
+});
