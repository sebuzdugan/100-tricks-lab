+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }], // 8500 base, 1785 vat
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
