+
+test('vatSummary returns empty array for no invoices', () => {
+  const r = vatSummary([]);
+  assert.deepEqual(r, []);
+});
+
+test('vatSummary returns empty array for only draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const r = vatSummary([draft]);
+  assert.deepEqual(r, []);
+});
+
+test('vatSummary calculates VAT base and amount for single invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = vatSummary([issued]);
+
+  // DES-HOUR: unitPrice 8500, vatRate 21
+  // line total: 2 * 8500 = 17000
+  // no discount (standard tier 0%)
+  // base: 17000
+  // vat: 17000 * 0.21 = 3570
+  assert.equal(r.length, 1);
+  assert.equal(r[0].rate, 21);
+  assert.equal(r[0].base, 17000);
+  assert.equal(r[0].vat, 3570);
+});
+
+test('vatSummary sorts by rate descending', () => {
+  // PRINT-A4: unitPrice 37, vatRate 9 (print)
+  // DES-HOUR: unitPrice 8500, vatRate 21 (services)
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PRINT-A4', qty: 1 }], // 37 base, 3.33 vat (9%)
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }], // 8500 base, 1785 vat (21%)
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const r = vatSummary([issued1, issued2]);
+
+  assert.equal(r.length, 2);
+  assert.equal(r[0].rate, 21); // highest rate first
+  assert.equal(r[1].rate, 9);
+});
+
