+/**
+ * Get VAT summary aggregated by rate.
+ * @param {Array} invoices
+ * @returns {Array} array of { rate, base, vat }
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  for (const invoice of invoices) {
+    if (invoice.status === 'draft') continue;
+
+    for (const line of invoice.lines) {
+      const lineamt = line.qty * line.unitPrice;
+      const lineDiscount = lineamt * (line.discountPercent ?? 0) / 100;
+      const roundedLineDiscount = roundCents(lineDiscount);
+      const lineAmountAfterDiscount = lineamt - roundedLineDiscount;
+
+      const lineVat = lineAmountAfterDiscount * (line.vatRate ?? 0) / 100;
+      const roundedLineVat = roundCents(lineVat);
+
+      const rate = line.vatRate ?? 0;
+      if (!vatMap[rate]) {
+        vatMap[rate] = { base: 0, vat: 0 };
+      }
+      vatMap[rate].base += lineAmountAfterDiscount;
+      vatMap[rate].vat += roundedLineVat;
+    }
+  }
+
+  return Object.entries(vatMap)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseInt(rate, 10),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
