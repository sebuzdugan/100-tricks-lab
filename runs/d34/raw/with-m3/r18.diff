+/**
+ * Calculate late fee for an invoice.
+ * 0.04% of the amount due for each day overdue.
+ * @param {{ dueDate: string, payments?: Array, lines: Array }} invoice
+ * @param {string} asOf - YYYY-MM-DD date
+ * @returns {number} late fee in cents
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const amountDue = balanceDue(invoice);
+
+  const fee = amountDue * 0.0004 * daysOverdue;
+  return roundCents(fee);
+}
