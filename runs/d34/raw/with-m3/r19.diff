+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header for empty invoices', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv exports single issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3); // header + data + trailing newline
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  // DES-HOUR qty 2: 17000 subtotal, 0 discount (standard tier), 3570 vat, 20570 total
+  assert.equal(lines[1], 'INV-2026-0001,Blue Fern Bakery,2026-10-07,2026-10-21,issued,170.00,0.00,35.70,205.70,205.70');
+  assert.equal(lines[2], '');
+});
+
+test('exportCsv formats amounts without currency sign or thousands separator', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }], // 120000 base + 25200 vat = 145200
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  // Check that amounts are formatted correctly: 1200.00, 0.00, 252.00, 1452.00
+  assert(lines[1].includes('1200.00'));
+  assert(lines[1].includes('252.00'));
+  assert(lines[1].includes('1452.00'));
+  // Should not contain € or commas in amounts
+  assert(!lines[1].includes('€'));
+  assert(lines[1].match(/,\d{2},/) || lines[1].match(/,\d{3}/)); // CSV comma separators only
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const inv = createInvoice({
+    customerId: 'C-004', // "Smith, Jones & Partners"
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  // Customer name should be quoted because it contains a comma
+  assert(lines[1].includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer name with double quote', () => {
+  const inv = createInvoice({
+    customerId: 'C-006', // "Marlow \"The Print Shop\""
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  // Customer name should be quoted and double quotes should be doubled
+  // Original: Marlow "The Print Shop"
+  // Escaped: "Marlow ""The Print Shop"""
+  assert(lines[1].includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const csv = exportCsv([issued1, issued2]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 4); // header + 2 data + trailing newline
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv shows zero due for paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const paid = recordPayment(issued, { amount: 20570, date: '2026-10-08' }).value;
+
+  const csv = exportCsv([paid]);
+
+  const lines = csv.split('\n');
+  // Last field (due) should be 0.00
+  assert(lines[1].endsWith('0.00'));
+});
+
+test('exportCsv shows partial due amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+
+  const csv = exportCsv([partial]);
+
+  const lines = csv.split('\n');
+  // Due: 20570 - 10000 = 10570, formatted as 105.70
+  assert(lines[1].includes('105.70'));
+});
+
+test('exportCsv ends with newline', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+
+  assert(csv.endsWith('\n'));
+});
+
+test('exportCsv uses correct date format YYYY-MM-DD', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  // Should contain dates in format YYYY-MM-DD
+  assert(lines[1].includes('2026-10-07'));
+  assert(lines[1].includes('2026-10-21')); // NET14 = 14 days later
+});
+
+test('exportCsv handles draft invoice with no number', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const csv = exportCsv([draft]);
+
+  const lines = csv.split('\n');
+  // First field should be empty for draft (no number)
+  assert(lines[1].startsWith(','));
+});
+
+test('exportCsv includes correct status', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2026-10-08' }).value;
+
+  const csv = exportCsv([partial]);
+
+  const lines = csv.split('\n');
+  // Status should be 'partially_paid'
+  assert(lines[1].includes('partially_paid'));
+});
+
+test('exportCsv does not mutate input array', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const invoices = [issued];
+  const snapshot = JSON.stringify(invoices);
+
+  exportCsv(invoices);
+
+  assert.equal(JSON.stringify(invoices), snapshot);
+});
+
+test('exportCsv handles subtotal separately from total', () => {
+  // Create invoice with discount to show subtotal != total
+  const inv = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  // gold tier gets 5% discount: 17000 * 0.05 = 850
+  // subtotal: 17000, discount: 850, vat on 16150: 3391.5 ≈ 3392, total: 17000 - 850 + 3392 = 19542
+  // Fields: subtotal, discount, vat, total
+  assert(lines[1].includes('170.00')); // subtotal: 17000 cents = 170.00
+  assert(lines[1].includes('8.50')); // discount: 850 cents = 8.50
+  assert(lines[1].includes('33.92')); // vat
+  assert(lines[1].includes('195.42')); // total
+});
