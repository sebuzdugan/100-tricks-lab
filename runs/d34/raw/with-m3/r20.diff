 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -15,6 +24,22 @@ export function roundCents(x) {
   return floor % 2 === 0 ? floor : floor + 1;
 }
 
+/**
+ * Convert EUR cents to another currency.
+ * @param {number} cents - amount in EUR cents
+ * @param {string} currency - target currency code
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const convertedCents = roundCents(cents * rate);
+  return ok(convertedCents);
+}
+
 /**
  * Format cents as euros for people: 123456 -> "€1,234.56", -5 -> "-€0.05".
  * @param {number} cents
@@ -27,6 +52,26 @@ export function formatEuros(cents) {
   return `${sign}€${euros}.${String(abs % 100).padStart(2, '0')}`;
 }
 
+/**
+ * Format cents in any currency for people: 123456 EUR -> "€1,234.56", 123456 USD -> "$1,234.56".
+ * @param {number} cents
+ * @param {string} currency
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  const symbol = symbols[currency] ?? '?';
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
+
