+test('mergeCustomers merges two customers successfully', () => {
+  const customers = listCustomers();
+  const invoices = [
+    issueInvoice(createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value, []).value,
+    issueInvoice(createInvoice({
+      customerId: 'C-003',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value, ['INV-2026-0001']).value,
+  ];
+
+  const r = mergeCustomers(customers, invoices, 'C-002', 'C-003');
+
+  assert.equal(r.ok, true);
+  // C-002 should be removed
+  assert(!r.value.customers.find(c => c.id === 'C-002'));
+  // C-003 should still exist
+  assert(r.value.customers.find(c => c.id === 'C-003'));
+  // Both invoices should now be for C-003
+  assert.equal(r.value.invoices[0].customerId, 'C-003');
+  assert.equal(r.value.invoices[1].customerId, 'C-003');
+});
