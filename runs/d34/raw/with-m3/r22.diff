+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line item.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
+    const lineamt = lineTotal(line);
+    subtotal += lineamt;
+
+    const lineDiscount = lineamt * (line.discountPercent ?? 0) / 100;
+    const roundedLineDiscount = roundCents(lineDiscount);
+    discount += roundedLineDiscount;
+
+    const lineAmountAfterDiscount = lineamt - roundedLineDiscount;
+    const lineVat = lineAmountAfterDiscount * (line.vatRate ?? 0) / 100;
+    vat += roundCents(lineVat);
+  }
+
+  const voucherAmount = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucherAmount);
+  return { subtotal, discount, vat, voucher: voucherAmount, total };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..5edd37a
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,181 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 2, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 17000);
+});
+
+test('lineTotal with single qty', () => {
+  const line = { qty: 1, unitPrice: 10000 };
+  assert.equal(lineTotal(line), 10000);
+});
+
+test('invoiceTotals calculates subtotal and total', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 17000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 3570); // 17000 * 0.21 = 3570
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 20570);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 37, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: 17000 * 0.21 = 3570
+  // Line 2: 37 * 0.09 = 3.33 → rounds to 3
+  assert.equal(totals.subtotal, 17037);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 3573); // 3570 + 3
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 20610); // 17037 + 3573
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // line total: 17000
+  // discount: 17000 * 0.10 = 1700
+  // vat base: 17000 - 1700 = 15300
+  // vat: 15300 * 0.21 = 3213
+  assert.equal(totals.subtotal, 17000);
+  assert.equal(totals.discount, 1700);
+  assert.equal(totals.vat, 3213);
+  assert.equal(totals.total, 18513); // 17000 - 1700 + 3213
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE50', amount: 5000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 17000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 3570);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 15570); // 17000 + 3570 - 5000
+});
+
+test('invoiceTotals defaults discountPercent to 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals calculates VAT on discounted amount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 20, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // line: 10000
+  // discount: 10000 * 0.20 = 2000
+  // vat base: 10000 - 2000 = 8000
+  // vat: 8000 * 0.21 = 1680
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 2000);
+  assert.equal(totals.vat, 1680);
+  assert.equal(totals.total, 9680); // 10000 - 2000 + 1680
+});
+
+test('invoiceTotals handles zero VAT rate', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 60000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 60000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 60000);
+});
+
+test('invoiceTotals with multiple different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 9 },
+      { qty: 1, unitPrice: 5000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: vat = 10000 * 0.21 = 2100
+  // Line 2: vat = 1000 * 0.09 = 90
+  // Line 3: vat = 0
+  assert.equal(totals.subtotal, 16000);
+  assert.equal(totals.vat, 2190); // 2100 + 90
+  assert.equal(totals.total, 18190); // 16000 + 2190
+});
+
+test('invoiceTotals prevents negative total', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+    voucher: { code: 'BIG', amount: 5000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // total would be: 1000 - 5000 = -4000, but clamped to 0
+  assert.equal(totals.total, 0);
+});
+
+test('lineTotal with large numbers', () => {
+  const line = { qty: 1000, unitPrice: 120000 };
+  assert.equal(lineTotal(line), 120000000);
+});
+
+test('invoiceTotals with large numbers', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 120000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 12000000);
+  assert.equal(totals.vat, 2520000); // 12000000 * 0.21
+  assert.equal(totals.total, 14520000);
+});
