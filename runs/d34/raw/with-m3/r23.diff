 test('renderInvoiceText shows line structure correctly', () => {
diff --git a/test/totals.test.js b/test/totals.test.js
index 5edd37a..20ce6af 100644
--- a/test/totals.test.js
+++ b/test/totals.test.js
@@ -175,7 +175,165 @@ test('invoiceTotals with large numbers', () => {
 
   const totals = invoiceTotals(invoice);
 
+  // line: 100 * 120000 = 12000000
+  // bulk discount (qty >= 10, 2.5%): 12000000 * 0.025 = 300000
+  // vat base: 12000000 - 300000 = 11700000
+  // vat: 11700000 * 0.21 = 2457000
   assert.equal(totals.subtotal, 12000000);
-  assert.equal(totals.vat, 2520000); // 12000000 * 0.21
-  assert.equal(totals.total, 14520000);
+  assert.equal(totals.discount, 300000);
+  assert.equal(totals.vat, 2457000);
+  assert.equal(totals.total, 14157000); // 12000000 - 300000 + 2457000
+});
+
+test('invoiceTotals applies bulk discount for qty >= 10', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // line: 10 * 10000 = 100000
+  // no line discount
+  // bulk discount (2.5%): 100000 * 0.025 = 2500
+  // vat base: 100000 - 2500 = 97500
+  // vat: 97500 * 0.21 = 20475
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 2500);
+  assert.equal(totals.vat, 20475);
+  assert.equal(totals.total, 117975); // 100000 - 2500 + 20475
+});
+
+test('invoiceTotals does not apply bulk discount for qty < 10', () => {
+  const invoice = {
+    lines: [
+      { qty: 9, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // line: 9 * 10000 = 90000
+  // no line discount, no bulk discount
+  // vat: 90000 * 0.21 = 18900
+  assert.equal(totals.subtotal, 90000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 18900);
+  assert.equal(totals.total, 108900);
+});
+
+test('invoiceTotals applies bulk discount after line discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // line: 10 * 10000 = 100000
+  // line discount (10%): 100000 * 0.10 = 10000
+  // amount after line discount: 100000 - 10000 = 90000
+  // bulk discount (2.5% of 90000): 90000 * 0.025 = 2250
+  // total discount: 10000 + 2250 = 12250
+  // vat base: 100000 - 12250 = 87750
+  // vat: 87750 * 0.21 = 18427.5 ≈ 18428 (banker's rounding)
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 12250);
+  assert.equal(totals.vat, 18428);
+  assert.equal(totals.total, 106178); // 100000 - 12250 + 18428
+});
+
+test('invoiceTotals with bulk discount and multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 5000, discountPercent: 0, vatRate: 21 }, // bulk applies
+      { qty: 5, unitPrice: 5000, discountPercent: 0, vatRate: 21 },  // no bulk
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: 10 * 5000 = 50000
+  //   - line discount: 0
+  //   - bulk discount (2.5%): 50000 * 0.025 = 1250
+  //   - vat base: 50000 - 1250 = 48750
+  //   - vat: 48750 * 0.21 = 10237.5 ≈ 10238
+  // Line 2: 5 * 5000 = 25000
+  //   - line discount: 0
+  //   - bulk discount: 0 (qty < 10)
+  //   - vat base: 25000
+  //   - vat: 25000 * 0.21 = 5250
+  assert.equal(totals.subtotal, 75000);
+  assert.equal(totals.discount, 1250);
+  assert.equal(totals.vat, 15488); // 10238 + 5250
+  assert.equal(totals.total, 89238); // 75000 - 1250 + 15488
+});
+
+test('invoiceTotals bulk discount with large qty', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // line: 100 * 1000 = 100000
+  // bulk discount (2.5%): 100000 * 0.025 = 2500
+  // vat base: 100000 - 2500 = 97500
+  // vat: 97500 * 0.21 = 20475
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 2500);
+  assert.equal(totals.vat, 20475);
+  assert.equal(totals.total, 117975);
+});
+
+test('invoiceTotals bulk discount exact threshold (qty = 10)', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // exactly 10 units should trigger bulk discount
+  assert.equal(totals.discount, 250); // 10000 * 0.025 = 250
+});
+
+test('invoiceTotals bulk discount just below threshold (qty = 9)', () => {
+  const invoice = {
+    lines: [
+      { qty: 9, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // 9 units should not trigger bulk discount
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals bulk discount does not affect voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE', amount: 5000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // line: 100000
+  // bulk discount: 2500
+  // vat base: 97500
+  // vat: 20475
+  // total: 100000 - 2500 + 20475 - 5000 = 112975
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 2500);
+  assert.equal(totals.vat, 20475);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 112975);
 });
