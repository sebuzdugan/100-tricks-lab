--- a/src/totals.js
+++ b/src/totals.js
@@ -23,12 +23,24 @@ export function invoiceTotals(invoice) {
     const lineamt = lineTotal(line);
     subtotal += lineamt;
 
+    // Apply line discount (explicit or tier)
     const lineDiscount = lineamt * (line.discountPercent ?? 0) / 100;
     const roundedLineDiscount = roundCents(lineDiscount);
-    discount += roundedLineDiscount;
+    const amountAfterLineDiscount = lineamt - roundedLineDiscount;
 
-    const lineAmountAfterDiscount = lineamt - roundedLineDiscount;
-    const lineVat = lineAmountAfterDiscount * (line.vatRate ?? 0) / 100;
+    // Apply bulk discount if qty >= 10
+    let bulkDiscount = 0;
+    if (line.qty >= 10) {
+      bulkDiscount = amountAfterLineDiscount * 0.025; // 2.5% off
+    }
+    const roundedBulkDiscount = roundCents(bulkDiscount);
+
+    // Total discount and amount after all discounts
+    const totalLineDiscount = roundedLineDiscount + roundedBulkDiscount;
+    discount += totalLineDiscount;
+
+    const lineAmountAfterAllDiscounts = lineamt - totalLineDiscount;
+    const lineVat = lineAmountAfterAllDiscounts * (line.vatRate ?? 0) / 100;
     vat += roundCents(lineVat);
   }
 
