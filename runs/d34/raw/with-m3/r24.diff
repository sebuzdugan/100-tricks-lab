+test('dashboard returns empty counts for empty invoices', () => {
+  const d = dashboard([], '2026-10-31');
+  assert.deepEqual(d.counts, { draft: 0, issued: 0, partially_paid: 0, paid: 0 });
+  assert.equal(d.outstanding, 0);
+  assert.deepEqual(d.overdue, { count: 0, amount: 0 });
+  assert.deepEqual(d.topCustomers, []);
+});
+
+test('dashboard counts invoices by status', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+  const partial2 = recordPayment(issued2, { amount: 5000, date: '2026-10-09' }).value;
+  const paid3 = recordPayment(issueInvoice(inv3, ['INV-2026-0001', 'INV-2026-0002']).value, { amount: 10285, date: '2026-10-10' }).value;
+
+  const d = dashboard([inv1, issued1, partial2, paid3], '2026-10-31');
+
+  assert.equal(d.counts.draft, 1);
+  assert.equal(d.counts.issued, 1);
+  assert.equal(d.counts.partially_paid, 1);
+  assert.equal(d.counts.paid, 1);
+});
+
