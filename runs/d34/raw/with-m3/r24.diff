+test('dashboard identifies top 3 customers by due amount', () => {
+  const invoices = [];
+
+  // C-002: 20570 + 10285 = 30855
+  for (let i = 0; i < 2; i++) {
+    const inv = createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 + i }],
+    }).value;
+    invoices.push(issueInvoice(inv, invoices.map(a => a.number).filter(Boolean)).value);
+  }
+
+  // C-003: 10285
+  let inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  invoices.push(issueInvoice(inv, invoices.map(a => a.number).filter(Boolean)).value);
+
+  // C-004: 5142.5 ≈ 5143 (half of DES-HOUR total)
+  inv = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-03',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, invoices.map(a => a.number).filter(Boolean)).value;
+  const partial = recordPayment(issued, { amount: 5143, date: '2026-10-04' }).value;
