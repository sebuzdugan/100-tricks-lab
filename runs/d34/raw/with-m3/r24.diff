--- a/src/reports.js
+++ b/src/reports.js
@@ -80,3 +80,56 @@ export function lateFee(invoice, asOf) {
   const fee = amountDue * 0.0004 * daysOverdue;
   return roundCents(fee);
 }
+
+/**
+ * Get dashboard summary of invoices.
+ * @param {Array} invoices
+ * @param {string} asOf - YYYY-MM-DD date
+ * @returns {{ counts, outstanding, overdue, topCustomers }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const inv of invoices) {
+    counts[inv.status]++;
+  }
+
+  // Outstanding: total due on issued or partially_paid
+  let outstanding = 0;
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      outstanding += balanceDue(inv);
+    }
+  }
+
+  // Overdue: use overdueInvoices function
+  const overdueLst = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdueLst.length,
+    amount: overdueLst.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Top customers by due amount
+  const customerDue = {};
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      if (!customerDue[inv.customerId]) {
+        customerDue[inv.customerId] = 0;
+      }
+      customerDue[inv.customerId] += balanceDue(inv);
+    }
+  }
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return { counts, outstanding, overdue, topCustomers };
+}
