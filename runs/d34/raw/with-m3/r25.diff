   }
 
   // Calculate totals
@@ -33,8 +39,24 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  // Voucher line (if any)
+  if (invoice.voucher) {
+    lines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   // Total
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date line (if any)
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid line (if payments exist)
