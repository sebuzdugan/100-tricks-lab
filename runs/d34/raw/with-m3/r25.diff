@@ -23,6 +23,12 @@ export function renderInvoiceText(invoice) {
     const total = lineTotal(line);
     const lineText = `  ${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
     lines.push(lineText);
+
+    // Line discount (if any)
+    if (line.discountPercent > 0) {
+      const discount = roundCents(total * line.discountPercent / 100);
+      lines.push(`    Discount (${line.discountPercent}%): -${formatEuros(discount)}`);
