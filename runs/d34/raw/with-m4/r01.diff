diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..80e5a22
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,57 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create an invoice in draft status.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate date format (YYYY-MM-DD) and that it represents a valid date
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) return fail('DATE_INVALID');
+  const date = new Date(issueDate + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return fail('DATE_INVALID');
+  const [year, month, day] = issueDate.split('-');
+  if (date.getUTCFullYear() !== Number(year) ||
+      date.getUTCMonth() !== Number(month) - 1 ||
+      date.getUTCDate() !== Number(day)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines array is not empty
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  // Build and validate invoice lines
+  const invoiceLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Get product from catalogue
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  const invoice = {
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  };
+
+  return ok(invoice);
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..ca3b657
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,118 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 8500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice reports unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports invalid date format', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-13-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports invalid date string format', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: 'not-a-date',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports missing lines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports invalid quantity (not integer)', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports invalid quantity (zero)', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports invalid quantity (negative)', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: -1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports unknown SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'NOPE', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice with multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].qty, 2);
+  assert.equal(r.value.lines[1].qty, 3);
+});
+
+test('createInvoice does not mutate the argument', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+  createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines,
+  });
+  assert.deepEqual(lines, [{ sku: 'DES-HOUR', qty: 1 }]);
+});
