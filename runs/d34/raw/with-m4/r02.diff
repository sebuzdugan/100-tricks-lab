--- a/src/invoices.js
+++ b/src/invoices.js
@@ -55,3 +55,25 @@ export function createInvoice({ customerId, issueDate, lines }) {
 
   return ok(invoice);
 }
+
+/**
+ * Calculate the total amount for a line: qty × unitPrice.
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate invoice totals: subtotal (sum of line totals) and total.
+ * @param {{ lines: Array }}
+ * @returns {{ subtotal: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  for (const line of invoice.lines) {
+    subtotal += lineTotal(line);
+  }
+  return { subtotal, total: subtotal };
+}
