+/**
+ * Add or increase a line on a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} line
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+  const newLines = invoice.lines.map(l => ({ ...l }));
+
+  const existingLineIndex = newLines.findIndex(l => l.sku === sku);
+  if (existingLineIndex !== -1) {
+    newLines[existingLineIndex] = {
+      ...newLines[existingLineIndex],
+      qty: newLines[existingLineIndex].qty + qty,
+    };
+  } else {
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const lineIndex = invoice.lines.findIndex(l => l.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  const newLines = invoice.lines.filter(l => l.sku !== sku);
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
