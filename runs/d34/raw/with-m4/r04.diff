diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..d59a46b
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,39 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number for a year', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const result = nextInvoiceNumber(['INV-2026-0001'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber finds max counter for same year', () => {
+  const result = nextInvoiceNumber(['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const result = nextInvoiceNumber(['INV-2025-0050', 'INV-2026-0001'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const result = nextInvoiceNumber(['INV-2025-0100', 'INV-2026-0010'], '2027-10-07');
+  assert.equal(result, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+
+  const result100 = nextInvoiceNumber(
+    Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`),
+    '2026-10-07'
+  );
+  assert.equal(result100, 'INV-2026-0100');
+});
