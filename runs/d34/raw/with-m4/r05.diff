+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Kite & Co/);
+  assert.match(text, /5x Design work \(hour\) @ €85\.00 = €425\.00/);
+  assert.match(text, /Total: €425\.00$/);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^INV-2026-0001\n/);
+  assert.match(text, /Kite & Co/);
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 3, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5x Design work \(hour\) @ €85\.00 = €425\.00/);
+  assert.match(text, /3x Development \(hour\) @ €95\.00 = €285\.00/);
+  assert.match(text, /Total: €710\.00$/);
+});
+
+test('renderInvoiceText formats amounts with proper EUR symbols and decimals', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 10, unitPrice: 980, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /10x Icon set \(24 icons\) @ €9\.80 = €98\.00/);
+  assert.match(text, /Total: €98\.00$/);
+});
+
+test('renderInvoiceText renders single-digit qty correctly', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /1x Logo package @ €1,200\.00 = €1,200\.00/);
+});
+
+test('renderInvoiceText renders large amounts with thousands separators', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'BRAND-BOOK', name: 'Brand guidelines document', qty: 2, unitPrice: 245000, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /2x Brand guidelines document @ €2,450\.00 = €4,900\.00/);
+  assert.match(text, /Total: €4,900\.00$/);
+});
+
+test('renderInvoiceText has proper line structure', () => {
+  const invoice = {
+    number: 'INV-2026-0042',
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 2, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0042');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '2x Design work (hour) @ €85.00 = €170.00');
+  assert.equal(lines[3], '1x Development (hour) @ €95.00 = €95.00');
+  assert.equal(lines[4], 'Total: €265.00');
+  assert.equal(lines.length, 5);
+});
