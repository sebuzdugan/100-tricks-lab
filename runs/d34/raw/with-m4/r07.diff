diff --git a/test/invoices.test.js b/test/invoices.test.js
index 5c8eca4..e09d953 100644
--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -487,3 +487,81 @@ test('addLine rejects invalid discountPercent', () => {
   };
   assert.deepEqual(addLine(invoice, { sku: 'DEV-HOUR', qty: 1, discountPercent: 150 }), { ok: false, error: 'DISCOUNT_INVALID' });
 });
+
+test('createInvoice applies gold tier discount (5%)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount (2.5%)', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice does not set discount for standard tier (0%)', () => {
+  const r = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, undefined);
+});
+
+test('createInvoice explicit discountPercent overrides tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice explicit 0 discount overrides tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice applies tier discount to each line independently', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3, discountPercent: 10 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+  assert.equal(r.value.lines[1].discountPercent, 10);
+  assert.equal(r.value.lines[2].discountPercent, 5);
+});
+
+test('invoiceTotals includes tier discounts', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.total, 80750);
+});
