+/**
+ * Check if a date string is valid (YYYY-MM-DD format and represents a real date).
+ * Uses UTC, never local time.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+  const [year, month, day] = text.split('-');
+  return (
+    date.getUTCFullYear() === Number(year) &&
+    date.getUTCMonth() === Number(month) - 1 &&
+    date.getUTCDate() === Number(day)
+  );
+}
+
+/**
+ * Add n days to a date string (YYYY-MM-DD), returning a new date string.
+ * Uses UTC, never local time.
+ * @param {string} date - YYYY-MM-DD format
+ * @param {number} n - number of days to add (can be negative)
+ * @returns {string} - YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  const year = d.getUTCFullYear();
+  const month = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate the number of whole days between two date strings (b - a).
+ * Uses UTC, never local time.
+ * @param {string} a - YYYY-MM-DD format (start date)
+ * @param {string} b - YYYY-MM-DD format (end date)
+ * @returns {number} - number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const millisPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB.getTime() - dateA.getTime()) / millisPerDay);
+}
