@@ -0,0 +1,64 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array }} invoice
+ * @param {{ amount: number, date: string }} payment - amount in cents, date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Calculate current balance due
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array if missing
+  const payments = invoice.payments ? [...invoice.payments] : [];
+  payments.push({ amount, date });
+
+  // Calculate new balance
+  const newBalance = balance - amount;
+
+  // Determine new status
+  const status = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  // Return new invoice
+  const newInvoice = {
+    ...invoice,
+    payments,
+    status,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Calculate the balance due on an invoice (total minus payments).
+ * @param {{ payments?: Array }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPayments = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPayments);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
index 0000000..4ad976e
--- /dev/null
+++ b/test/payments.test.js
@@ -0,0 +1,197 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment adds a payment to an issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  const r = recordPayment(issuedInvoice, { amount: 50000, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 50000);
+  assert.equal(r.value.payments[0].date, '2026-10-10');
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment transitions to paid when fully paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  const totals = invoiceTotals(issuedInvoice);
+
+  const r = recordPayment(issuedInvoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+  assert.equal(r.value.payments.length, 1);
+});
+
+test('recordPayment accepts multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  let current = issuedResult.value;
+
+  const r1 = recordPayment(current, { amount: 30000, date: '2026-10-10' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.status, 'partially_paid');
+  current = r1.value;
+
+  const r2 = recordPayment(current, { amount: 40000, date: '2026-10-15' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.payments.length, 2);
+});
+
+test('recordPayment rejects non-issued invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+
+  assert.deepEqual(recordPayment(invoice, { amount: 50000, date: '2026-10-10' }), { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects invalid amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: 0, date: '2026-10-10' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: -1000, date: '2026-10-10' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: 1000.5, date: '2026-10-10' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects invalid date', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: 50000, date: 'invalid' }), { ok: false, error: 'DATE_INVALID' });
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: 50000, date: '2026-13-01' }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: 1000000, date: '2026-10-10' }), { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment allows payment on partially_paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  let current = issuedResult.value;
+
+  const r1 = recordPayment(current, { amount: 30000, date: '2026-10-10' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.status, 'partially_paid');
+
+  const r2 = recordPayment(r1.value, { amount: 20000, date: '2026-10-15' });
+  assert.equal(r2.ok, true);
+});
+
+test('balanceDue returns total for unpaid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  const due = balanceDue(issuedInvoice);
+  assert.equal(typeof due, 'number');
+  assert.ok(due > 0);
+});
+
+test('balanceDue calculates remaining balance after partial payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  let current = issuedResult.value;
+
+  const initialDue = balanceDue(current);
+  const r = recordPayment(current, { amount: 50, date: '2026-10-10' });
+  const newDue = balanceDue(r.value);
+
+  assert.equal(newDue, initialDue - 50);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  const totals = invoiceTotals(issuedInvoice);
+  const r = recordPayment(issuedInvoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(balanceDue(r.value), 0);
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  const originalStatus = issuedInvoice.status;
+  const originalPayments = issuedInvoice.payments;
+
+  recordPayment(issuedInvoice, { amount: 50000, date: '2026-10-10' });
+
+  assert.equal(issuedInvoice.status, originalStatus);
+  assert.equal(issuedInvoice.payments, originalPayments);
+});
