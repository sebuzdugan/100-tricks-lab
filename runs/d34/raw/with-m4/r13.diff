+test('applyVoucher adds a voucher to a draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const r = applyVoucher(invoice, { code: 'SUMMER2026', amount: 5000 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher.code, 'SUMMER2026');
+  assert.equal(r.value.voucher.amount, 5000);
+});
+
+test('applyVoucher rejects non-draft invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  assert.deepEqual(applyVoucher(issuedInvoice, { code: 'SUMMER2026', amount: 5000 }), { ok: false, error: 'NOT_DRAFT' });
+});
+
+test('applyVoucher rejects duplicate vouchers', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const r1 = applyVoucher(invoice, { code: 'SUMMER2026', amount: 5000 });
+  assert.equal(r1.ok, true);
+
+  const r2 = applyVoucher(r1.value, { code: 'ANOTHER', amount: 2000 });
+  assert.deepEqual(r2, { ok: false, error: 'VOUCHER_EXISTS' });
+});
+
+test('applyVoucher rejects invalid amount', () => {
