+++ b/test/statements.test.js
@@ -0,0 +1,183 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoices() {
+  // Create several invoices for testing
+  const inv1Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const inv1Issued = issueInvoice(inv1Result.value, ['INV-2026-0001']).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const inv2Issued = issueInvoice(inv2Result.value, ['INV-2026-0001', 'INV-2026-0002']).value;
+
+  const inv3Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-11-01',
+    lines: [{ sku: 'STICKER', qty: 20 }],
+  });
+  const inv3Issued = issueInvoice(inv3Result.value, ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003']).value;
+
+  const inv4Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8 }],
+  });
+  const inv4Issued = issueInvoice(inv4Result.value, ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003', 'INV-2026-0004']).value;
+
+  return [inv1Issued, inv2Issued, inv3Issued, inv4Issued];
+}
+
+test('statement returns customer invoices as of date', () => {
+  const invoices = createTestInvoices();
+
+  const result = statement('C-003', invoices, '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2026-09-01');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-01');
+});
+
+test('statement filters by asOf date', () => {
+  const invoices = createTestInvoices();
+
+  const result1 = statement('C-003', invoices, '2026-08-31');
+  assert.equal(result1.value.invoices.length, 0);
+
+  const result2 = statement('C-003', invoices, '2026-09-15');
+  assert.equal(result2.value.invoices.length, 1);
+
+  const result3 = statement('C-003', invoices, '2026-12-31');
+  assert.equal(result3.value.invoices.length, 3);
+});
+
+test('statement filters by customer ID', () => {
+  const invoices = createTestInvoices();
+
+  const result = statement('C-001', invoices, '2026-12-31');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-15');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoices = createTestInvoices();
+
+  const result = statement('C-003', invoices, '2026-12-31');
+  const dates = result.value.invoices.map(inv => inv.issueDate);
+  assert.deepEqual(dates, ['2026-09-01', '2026-10-01', '2026-11-01']);
+});
+
+test('statement includes invoice details', () => {
+  const invoices = createTestInvoices();
+
+  const result = statement('C-003', invoices, '2026-12-31');
+  const inv = result.value.invoices[0];
+
+  assert.ok(inv.number);
+  assert.equal(inv.issueDate, '2026-09-01');
+  assert.ok(inv.dueDate);
+  assert.ok(typeof inv.total === 'number');
+  assert.ok(typeof inv.due === 'number');
+});
+
+test('statement calculates totalDue', () => {
+  const invoices = createTestInvoices();
+
+  const result = statement('C-003', invoices, '2026-12-31');
+  const sumOfDue = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  assert.equal(result.value.totalDue, sumOfDue);
+  assert.ok(result.value.totalDue > 0);
+});
+
+test('statement with partial payment', () => {
+  const invoices = createTestInvoices();
+  const paidInvoice = recordPayment(invoices[0], { amount: 10000, date: '2026-09-15' }).value;
+  const updatedInvoices = [paidInvoice, invoices[1], invoices[2], invoices[3]];
+
+  const result = statement('C-003', updatedInvoices, '2026-12-31');
+  const paidInv = result.value.invoices[0];
+
+  assert.ok(paidInv.due < paidInv.total);
+});
+
+test('statement excludes draft invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = statement('C-003', [inv1Result.value], '2026-10-31');
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const inv1Issued = issueInvoice(inv1Result.value, ['INV-2026-0001']).value;
+  const totals = invoiceTotals(inv1Issued);
+  const inv1Paid = recordPayment(inv1Issued, { amount: totals.total, date: '2026-10-15' }).value;
+
+  const result = statement('C-003', [inv1Paid], '2026-10-31');
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoices = createTestInvoices();
+
+  const result = statement('C-999', invoices, '2026-10-31');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement normalizes customer ID', () => {
+  const invoices = createTestInvoices();
+
+  const result1 = statement('c-003', invoices, '2026-12-31');
+  const result2 = statement('C-003', invoices, '2026-12-31');
+  const result3 = statement('  C-003  ', invoices, '2026-12-31');
+
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  assert.equal(result3.ok, true);
+  assert.equal(result1.value.customerId, 'C-003');
+  assert.equal(result2.value.customerId, 'C-003');
+  assert.equal(result3.value.customerId, 'C-003');
+});
+
+test('statement with empty result', () => {
+  const invoices = createTestInvoices();
+
+  const result = statement('C-002', invoices, '2026-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement with voucher applied', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const inv1WithVoucher = applyVoucher(inv1Result.value, { code: 'SUMMER', amount: 5000 }).value;
+  const inv1Issued = issueInvoice(inv1WithVoucher, ['INV-2026-0001']).value;
+
+  const result = statement('C-003', [inv1Issued], '2026-10-31');
+  assert.equal(result.value.invoices.length, 1);
+  const inv = result.value.invoices[0];
+  assert.ok(inv.due > 0);
+});
