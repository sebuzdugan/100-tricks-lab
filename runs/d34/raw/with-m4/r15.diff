diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..bc7e70c
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,150 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoice() {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  return issueInvoice(invResult.value, ['INV-2026-0001']).value;
+}
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: 50000, reason: 'Service issue', date: '2026-09-20' }, ['CN-2026-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0002');
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Service issue');
+  assert.equal(result.value.date, '2026-09-20');
+});
+
+test('createCreditNote works on partially_paid invoice', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  const paidInvoice = recordPayment(invoice, { amount: 50000, date: '2026-09-17' }).value;
+
+  const result = createCreditNote(paidInvoice, { amount: 30000, reason: 'Discount', date: '2026-09-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works on paid invoice', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+  const paidInvoice = recordPayment(invoice, { amount: totals.total, date: '2026-09-17' }).value;
+
+  const result = createCreditNote(paidInvoice, { amount: 50000, reason: 'Overpayment', date: '2026-09-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote returns NOT_ISSUED for draft invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const result = createCreditNote(invResult.value, { amount: 50000, reason: 'Test', date: '2026-09-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote returns AMOUNT_INVALID for zero amount', () => {
+  const invoice = createTestInvoice();
+
+  const result = createCreditNote(invoice, { amount: 0, reason: 'Test', date: '2026-09-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns AMOUNT_INVALID for negative amount', () => {
+  const invoice = createTestInvoice();
+
+  const result = createCreditNote(invoice, { amount: -10000, reason: 'Test', date: '2026-09-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns AMOUNT_INVALID for non-integer amount', () => {
+  const invoice = createTestInvoice();
+
+  const result = createCreditNote(invoice, { amount: 10000.5, reason: 'Test', date: '2026-09-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns CREDIT_TOO_HIGH when amount exceeds invoice total', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: totals.total + 1, reason: 'Test', date: '2026-09-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const invoice = createTestInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2026-09-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote generates correct CN number format', () => {
+  const invoice = createTestInvoice();
+
+  const result = createCreditNote(invoice, { amount: 10000, reason: 'Test', date: '2026-09-20' }, []);
+  assert.match(result.value.number, /^CN-2026-\d{4}$/);
+});
+
+test('createCreditNote increments counter correctly', () => {
+  const invoice = createTestInvoice();
+
+  const result1 = createCreditNote(invoice, { amount: 10000, reason: 'Test 1', date: '2026-09-20' }, []);
+  const result2 = createCreditNote(invoice, { amount: 10000, reason: 'Test 2', date: '2026-09-20' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote restarts counter per year', () => {
+  const invoice1 = createTestInvoice();
+  const invoiceResult2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice2 = issueInvoice(invoiceResult2.value, ['INV-2027-0001']).value;
+
+  const creditNote1 = createCreditNote(invoice1, { amount: 10000, reason: 'Test', date: '2026-09-20' }, []).value;
+  const creditNote2 = createCreditNote(invoice2, { amount: 10000, reason: 'Test', date: '2027-01-20' }, [creditNote1.number]).value;
+
+  assert.equal(creditNote1.number, 'CN-2026-0001');
+  assert.equal(creditNote2.number, 'CN-2027-0001');
+});
+
+test('createCreditNote with mixed existing invoice and credit note numbers', () => {
+  const invoice = createTestInvoice();
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001', 'CN-2026-0002'];
+
+  const result = createCreditNote(invoice, { amount: 10000, reason: 'Test', date: '2026-09-20' }, existingNumbers);
+  assert.equal(result.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote includes all required fields', () => {
+  const invoice = createTestInvoice();
+
+  const result = createCreditNote(invoice, { amount: 25000, reason: 'Discount applied', date: '2026-09-20' }, []);
+  assert.ok(result.value.number);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, invoice.customerId);
+  assert.equal(result.value.amount, 25000);
+  assert.equal(result.value.reason, 'Discount applied');
+  assert.equal(result.value.date, '2026-09-20');
+});
