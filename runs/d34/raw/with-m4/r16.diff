+++ b/src/reports.js
@@ -0,0 +1,26 @@
+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Get invoices that are overdue as of a given date.
+ * @param {Array} invoices - all invoices in the system
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {Array} - array of { number, customerId, dueDate, daysOverdue, due }, sorted by daysOverdue descending
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = invoices
+    .filter(inv =>
+      (inv.status === 'issued' || inv.status === 'partially_paid') &&
+      inv.dueDate < asOf
+    )
+    .map(inv => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
diff --git a/test/reports.test.js b/test/reports.test.js
new file mode 100644
index 0000000..9f06a4a
--- /dev/null
+++ b/test/reports.test.js
@@ -0,0 +1,183 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoice(customerId, issueDate, lines) {
+  const invResult = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+  });
+  return issueInvoice(invResult.value, []).value;
+}
+
+test('overdueInvoices includes invoices with dueDate before asOf', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  const result = overdueInvoices([invoice], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoice.number);
+});
+
+test('overdueInvoices excludes invoices with dueDate equal to asOf', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  // Default NET30 means dueDate is 2026-10-01
+  const result = overdueInvoices([invoice], '2026-10-01');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices with dueDate after asOf', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  // Default NET30 means dueDate is 2026-10-01
+  const result = overdueInvoices([invoice], '2026-09-30');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  // dueDate is 2026-10-01 (NET30)
+
+  const result = overdueInvoices([invoice], '2026-10-08');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 7);
+});
+
+test('overdueInvoices includes issued invoices', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  const result = overdueInvoices([invoice], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoice.number);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  const paidInvoice = recordPayment(invoice, { amount: 50000, date: '2026-09-15' }).value;
+
+  const result = overdueInvoices([paidInvoice], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, paidInvoice.number);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const result = overdueInvoices([invoice], '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  const totals = invoiceTotals(invoice);
+  const paidInvoice = recordPayment(invoice, { amount: totals.total, date: '2026-09-15' }).value;
+
+  const result = overdueInvoices([paidInvoice], '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices sorts by daysOverdue descending (most overdue first)', () => {
+  const inv1 = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  // dueDate: 2026-10-01
+
+  const inv2 = createTestInvoice('C-002', '2026-09-10', [{ sku: 'DES-HOUR', qty: 10 }]);
+  // dueDate: 2026-10-10
+
+  const result = overdueInvoices([inv2, inv1], '2026-10-20');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].daysOverdue, 19);
+  assert.equal(result[1].daysOverdue, 10);
+});
+
+test('overdueInvoices includes all required fields', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  const result = overdueInvoices([invoice], '2026-10-15');
+  const item = result[0];
+
+  assert.ok(item.number);
+  assert.equal(item.customerId, 'C-001');
+  assert.equal(item.dueDate, '2026-10-01');
+  assert.ok(typeof item.daysOverdue === 'number');
+  assert.ok(item.daysOverdue > 0);
+  assert.ok(typeof item.due === 'number');
+  assert.ok(item.due > 0);
+});
+
+test('overdueInvoices calculates correct due amount', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  const totals = invoiceTotals(invoice);
+  const paidInvoice = recordPayment(invoice, { amount: 50000, date: '2026-09-15' }).value;
+
+  const result = overdueInvoices([paidInvoice], '2026-10-15');
+  assert.equal(result[0].due, totals.total - 50000);
+});
+
+test('overdueInvoices returns empty array when no invoices are overdue', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  const result = overdueInvoices([invoice], '2026-09-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices handles multiple invoices with various dates', () => {
+  const inv1 = createTestInvoice('C-001', '2026-08-01', [{ sku: 'DES-HOUR', qty: 5 }]);
+  // dueDate: 2026-08-31
+
+  const inv2 = createTestInvoice('C-002', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  // dueDate: 2026-10-01
+
+  const inv3 = createTestInvoice('C-003', '2026-10-01', [{ sku: 'DES-HOUR', qty: 3 }]);
+  // dueDate: 2026-10-31 (not overdue)
+
+  const result = overdueInvoices([inv1, inv2, inv3], '2026-10-15');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[1].customerId, 'C-002');
+});
+
+test('overdueInvoices with NET14 terms', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const invoice = issueInvoice(invResult.value, []).value;
+  // dueDate: 2026-09-15
+
+  const result = overdueInvoices([invoice], '2026-09-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 5);
+});
+
+test('overdueInvoices with EOM terms', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'EOM',
+  });
+  const invoice = issueInvoice(invResult.value, []).value;
+  // dueDate: 2026-09-30
+
+  const result = overdueInvoices([invoice], '2026-10-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 15);
+});
+
+test('overdueInvoices with zero days overdue is still included', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  // dueDate: 2026-10-01
+
+  const result = overdueInvoices([invoice], '2026-10-02');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 1);
+});
