@@ -24,3 +25,30 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Get a summary of VAT by rate across invoices.
+ * @param {Array} invoices - all invoices in the system
+ * @returns {Array} - array of { rate, base, vat }, sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  invoices
+    .filter(inv => ['issued', 'partially_paid', 'paid'].includes(inv.status))
+    .forEach(inv => {
+      inv.lines.forEach(line => {
+        const rate = line.vatRate;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVat(line);
+
+        if (!vatMap[rate]) {
+          vatMap[rate] = { rate, base: 0, vat: 0 };
+        }
+        vatMap[rate].base += base;
+        vatMap[rate].vat += vat;
+      });
+    });
+
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
diff --git a/test/vat-summary.test.js b/test/vat-summary.test.js
new file mode 100644
index 0000000..e92fa53
--- /dev/null
+++ b/test/vat-summary.test.js
@@ -0,0 +1,252 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { vatSummary } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals, lineTotal, lineDiscount, lineVat } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoice(customerId, issueDate, lines) {
+  const invResult = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+  });
+  return issueInvoice(invResult.value, []).value;
+}
+
+test('vatSummary returns empty array for no invoices', () => {
+  const result = vatSummary([]);
+  assert.deepEqual(result, []);
+});
+
+test('vatSummary returns empty array for only draft invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const result = vatSummary([invResult.value]);
+  assert.deepEqual(result, []);
+});
+
+test('vatSummary summarizes VAT for a single invoice', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  const result = vatSummary([invoice]);
+  assert.equal(result.length, 1);
+  assert.equal(result[0].rate, 21);
+  assert.ok(result[0].base > 0);
+  assert.ok(result[0].vat > 0);
+});
+
+test('vatSummary calculates base as lineTotal minus lineDiscount', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 10, discountPercent: 10 },
+  ]);
+
+  const line = invoice.lines[0];
+  const expectedBase = lineTotal(line) - lineDiscount(line);
+  const expectedVat = lineVat(line);
+
+  const result = vatSummary([invoice]);
+  assert.equal(result[0].base, expectedBase);
+  assert.equal(result[0].vat, expectedVat);
+});
+
+test('vatSummary includes invoices with issued status', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  const result = vatSummary([invoice]);
+  assert.equal(result.length, 1);
+});
+
+test('vatSummary includes invoices with partially_paid status', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  const paidInvoice = recordPayment(invoice, { amount: 50000, date: '2026-09-15' }).value;
+
+  const result = vatSummary([paidInvoice]);
+  assert.equal(result.length, 1);
+});
+
+test('vatSummary includes invoices with paid status', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  const totals = invoiceTotals(invoice);
+  const paidInvoice = recordPayment(invoice, { amount: totals.total, date: '2026-09-15' }).value;
+
+  const result = vatSummary([paidInvoice]);
+  assert.equal(result.length, 1);
+});
+
+test('vatSummary excludes draft invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const result = vatSummary([invResult.value]);
+  assert.equal(result.length, 0);
+});
+
+test('vatSummary aggregates VAT across multiple invoices with same rate', () => {
+  const inv1 = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+  const inv2 = createTestInvoice('C-002', '2026-09-02', [{ sku: 'DES-HOUR', qty: 5 }]);
+
+  const result = vatSummary([inv1, inv2]);
+  assert.equal(result.length, 1);
+  assert.equal(result[0].rate, 21);
+
+  const expectedBase = (lineTotal(inv1.lines[0]) - lineDiscount(inv1.lines[0])) +
+                       (lineTotal(inv2.lines[0]) - lineDiscount(inv2.lines[0]));
+  const expectedVat = lineVat(inv1.lines[0]) + lineVat(inv2.lines[0]);
+
+  assert.equal(result[0].base, expectedBase);
+  assert.equal(result[0].vat, expectedVat);
+});
+
+test('vatSummary handles multiple VAT rates', () => {
+  // DES-HOUR has 21% VAT, STICKER has 0% VAT
+  const invoice = createTestInvoice('C-001', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 10 },
+    { sku: 'WORKSHOP-DAY', qty: 1 },
+  ]);
+
+  const result = vatSummary([invoice]);
+  assert.equal(result.length, 2);
+
+  // Should be sorted by rate descending (21 first, then 0)
+  assert.equal(result[0].rate, 21);
+  assert.equal(result[1].rate, 0);
+});
+
+test('vatSummary sorts by rate descending', () => {
+  const inv1 = createTestInvoice('C-001', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 10 },
+  ]);
+  const inv2 = createTestInvoice('C-002', '2026-09-02', [
+    { sku: 'PRINT-A4', qty: 1000 },
+  ]);
+
+  const result = vatSummary([inv2, inv1]);
+  assert.equal(result.length, 2);
+  assert.equal(result[0].rate, 21);
+  assert.equal(result[1].rate, 9);
+});
+
+test('vatSummary with multiple lines in single invoice', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 10 },
+    { sku: 'DES-HOUR', qty: 5 },
+    { sku: 'STICKER', qty: 50 },
+  ]);
+
+  const result = vatSummary([invoice]);
+
+  // Filter for 21% rate and aggregate (all three lines have 21% VAT)
+  const rate21 = result.find(r => r.rate === 21);
+  assert.ok(rate21);
+  assert.equal(rate21.base,
+    (lineTotal(invoice.lines[0]) - lineDiscount(invoice.lines[0])) +
+    (lineTotal(invoice.lines[1]) - lineDiscount(invoice.lines[1])) +
+    (lineTotal(invoice.lines[2]) - lineDiscount(invoice.lines[2]))
+  );
+});
+
+test('vatSummary includes all required fields', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  const result = vatSummary([invoice]);
+  const entry = result[0];
+
+  assert.ok(typeof entry.rate === 'number');
+  assert.ok(typeof entry.base === 'number');
+  assert.ok(typeof entry.vat === 'number');
+  assert.ok(entry.base > 0);
+  assert.ok(entry.vat > 0);
+});
+
+test('vatSummary with 0% VAT rate', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'WORKSHOP-DAY', qty: 1 }]);
+
+  const result = vatSummary([invoice]);
+  assert.equal(result.length, 1);
+  assert.equal(result[0].rate, 0);
+  assert.ok(result[0].base > 0);
+  assert.equal(result[0].vat, 0);
+});
+
+test('vatSummary with discounted line', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 10, discountPercent: 20 },
+  ]);
+
+  const line = invoice.lines[0];
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const base = total - discount;
+
+  const result = vatSummary([invoice]);
+  assert.equal(result[0].base, base);
+  assert.ok(discount > 0);
+  assert.ok(base < total);
+});
+
+test('vatSummary across three different VAT rates', () => {
+  const inv1 = createTestInvoice('C-001', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 10 },  // 21%
+  ]);
+
+  const inv2 = createTestInvoice('C-002', '2026-09-02', [
+    { sku: 'PRINT-A4', qty: 1000 },  // 9%
+  ]);
+
+  const inv3 = createTestInvoice('C-003', '2026-09-03', [
+    { sku: 'WORKSHOP-DAY', qty: 1 },  // 0%
+  ]);
+
+  const result = vatSummary([inv1, inv2, inv3]);
+  assert.equal(result.length, 3);
+
+  // Check sorting (descending)
+  assert.equal(result[0].rate, 21);
+  assert.equal(result[1].rate, 9);
+  assert.equal(result[2].rate, 0);
+});
+
+test('vatSummary with customer tier discount', () => {
+  // C-008 is gold tier (5% discount)
+  const invoice = createTestInvoice('C-008', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 10 },
+  ]);
+
+  const line = invoice.lines[0];
+  const result = vatSummary([invoice]);
+
+  // The line should have 5% discount from tier
+  assert.ok(line.discountPercent > 0);
+  const expectedBase = lineTotal(line) - lineDiscount(line);
+  assert.equal(result[0].base, expectedBase);
+});
+
+test('vatSummary with mixed invoice statuses', () => {
+  const inv1 = createTestInvoice('C-001', '2026-09-01', [{ sku: 'DES-HOUR', qty: 10 }]);
+
+  const inv2 = createTestInvoice('C-002', '2026-09-02', [{ sku: 'DES-HOUR', qty: 5 }]);
+  const paidInv2 = recordPayment(inv2, { amount: invoiceTotals(inv2).total, date: '2026-09-15' }).value;
+
+  const draftResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-03',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+
+  const result = vatSummary([inv1, paidInv2, draftResult]);
+
+  // Should include issued and paid, exclude draft
+  assert.equal(result.length, 1);
+  assert.equal(result[0].rate, 21);
+  const expectedBase =
+    (lineTotal(inv1.lines[0]) - lineDiscount(inv1.lines[0])) +
+    (lineTotal(inv2.lines[0]) - lineDiscount(inv2.lines[0]));
+  assert.equal(result[0].base, expectedBase);
+});
