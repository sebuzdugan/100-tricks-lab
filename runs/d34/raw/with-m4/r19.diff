@@ -0,0 +1,255 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoice(customerId, issueDate, lines) {
+  const invResult = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+  });
+  return issueInvoice(invResult.value, []).value;
+}
+
+test('exportCsv returns header for empty list', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].includes('INV-2026-0001'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[1].includes('2026-09-01'));
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv exports multiple invoices in order', () => {
+  const inv1 = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+  const inv2 = createTestInvoice('C-002', '2026-09-02', [{ sku: 'STICKER', qty: 50 }]);
+
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n');
+
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[2].includes('Blue Fern Bakery'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+  const dataLine = result.split('\n')[1];
+
+  // Should have euro amounts with 2 decimals, no thousands separator
+  assert.match(dataLine, /\d+\.\d{2}/);
+  assert.ok(!dataLine.includes('€'));
+  assert.ok(!dataLine.includes(',00'));
+});
+
+test('exportCsv escapes fields with commas', () => {
+  const invoice = createTestInvoice('C-006', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+  const dataLine = result.split('\n')[1];
+
+  // Customer name is 'Marlow "The Print Shop"', should be quoted
+  assert.ok(dataLine.includes('"'));
+});
+
+test('exportCsv escapes fields with quotes', () => {
+  const invoice = createTestInvoice('C-006', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+  const dataLine = result.split('\n')[1];
+
+  // Customer name contains a quote, should be escaped
+  assert.ok(dataLine.includes('""'));
+});
+
+test('exportCsv handles draft invoices (no number)', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  const result = exportCsv([invResult.value]);
+  const dataLine = result.split('\n')[1];
+
+  // Draft invoice has no number, should have empty field
+  assert.ok(dataLine.startsWith(','));
+});
+
+test('exportCsv includes customer name from lookup', () => {
+  const invoice = createTestInvoice('C-003', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+  const dataLine = result.split('\n')[1];
+
+  assert.ok(dataLine.includes('Kite & Co'));
+});
+
+test('exportCsv includes correct due date', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+  const dataLine = result.split('\n')[1];
+
+  // Default NET30 means due date is 2026-10-01
+  assert.ok(dataLine.includes('2026-10-01'));
+});
+
+test('exportCsv includes invoice status', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+  const dataLine = result.split('\n')[1];
+
+  assert.ok(dataLine.includes('issued'));
+});
+
+test('exportCsv calculates totals correctly', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+  const totals = invoiceTotals(invoice);
+
+  const result = exportCsv([invoice]);
+  const dataLine = result.split('\n')[1];
+
+  // Check that amounts are included
+  assert.ok(dataLine.includes((totals.subtotal / 100).toFixed(2)));
+  assert.ok(dataLine.includes((totals.total / 100).toFixed(2)));
+});
+
+test('exportCsv includes due amount (balance)', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+  const totals = invoiceTotals(invoice);
+
+  const result = exportCsv([invoice]);
+  const dataLine = result.split('\n')[1];
+
+  // For unpaid invoice, due = total
+  const dueStr = (totals.total / 100).toFixed(2);
+  const fields = dataLine.split(',');
+  // Last field is due
+  assert.ok(fields[fields.length - 1].includes(dueStr));
+});
+
+test('exportCsv with partial payment', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+  const totals = invoiceTotals(invoice);
+  const paymentAmount = Math.floor(totals.total / 2);
+  const paidInvoice = recordPayment(invoice, { amount: paymentAmount, date: '2026-09-15' }).value;
+
+  const result = exportCsv([paidInvoice]);
+  const dataLine = result.split('\n')[1];
+
+  // Status should be partially_paid
+  assert.ok(dataLine.includes('partially_paid'));
+  // Due should be total - paymentAmount
+  const expectedDue = (totals.total - paymentAmount) / 100;
+  assert.ok(dataLine.includes(expectedDue.toFixed(2)));
+});
+
+test('exportCsv ends with newline', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+
+  assert.ok(result.endsWith('\n'));
+});
+
+test('exportCsv lines end with newline', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+
+  // All non-empty lines should be preceded by content
+  assert.equal(lines[lines.length - 1], '');
+});
+
+test('exportCsv CSV parsing roundtrip', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+
+  // Parse CSV manually to verify format
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  const dataLine = lines[1];
+
+  // Should have exactly 10 comma-separated fields
+  const fields = [];
+  let current = '';
+  let inQuotes = false;
+  for (let i = 0; i < dataLine.length; i++) {
+    const char = dataLine[i];
+    if (char === '"') {
+      if (inQuotes && dataLine[i + 1] === '"') {
+        current += '"';
+        i++;
+      } else {
+        inQuotes = !inQuotes;
+      }
+    } else if (char === ',' && !inQuotes) {
+      fields.push(current);
+      current = '';
+    } else {
+      current += char;
+    }
+  }
+  fields.push(current);
+
+  assert.equal(fields.length, 10);
+});
+
+test('exportCsv with amount containing dot', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 1 }]);
+
+  const result = exportCsv([invoice]);
+  const dataLine = result.split('\n')[1];
+
+  // Amount should have dot as decimal separator
+  assert.ok(dataLine.includes('.'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invoices = [];
+  for (let i = 1; i <= 5; i++) {
+    const inv = createTestInvoice('C-001', `2026-0${i}-01`, [{ sku: 'STICKER', qty: 100 }]);
+    invoices.push(inv);
+  }
+
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+
+  // Check that dates are in order
+  assert.ok(lines[1].includes('2026-01-01'));
+  assert.ok(lines[2].includes('2026-02-01'));
+  assert.ok(lines[3].includes('2026-03-01'));
+  assert.ok(lines[4].includes('2026-04-01'));
+  assert.ok(lines[5].includes('2026-05-01'));
+});
+
+test('exportCsv header is always first line', () => {
+  const invoices = [];
+  for (let i = 0; i < 10; i++) {
+    const inv = createTestInvoice('C-001', '2026-09-01', [{ sku: 'STICKER', qty: 100 }]);
+    invoices.push(inv);
+  }
+
+  const result = exportCsv(invoices);
+  const firstLine = result.split('\n')[0];
+
+  assert.equal(firstLine, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
