@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,31 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount from euros to another currency.
+ * @param {number} centAmount - amount in euro cents
+ * @param {string} currency - 'EUR', 'USD', or 'GBP'
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(centAmount, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const converted = centAmount * RATES[currency];
+  return ok(roundCents(converted));
+}
+
+/**
+ * Format an amount in the given currency for display.
+ * @param {number} centAmount - amount in the currency's cents (e.g., 12345 for $123.45)
+ * @param {string} currency - 'EUR', 'USD', or 'GBP'
+ * @returns {string}
+ */
+export function formatMoney(centAmount, currency) {
+  const sign = centAmount < 0 ? '-' : '';
+  const abs = Math.abs(centAmount);
+  const symbol = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+  const major = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${major}.${String(abs % 100).padStart(2, '0')}`;
+}
diff --git a/test/currency.test.js b/test/currency.test.js
