@@ -0,0 +1,194 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { RATES, convert, formatMoney } from '../src/money.js';
+
+test('RATES contains EUR, USD, and GBP', () => {
+  assert.ok('EUR' in RATES);
+  assert.ok('USD' in RATES);
+  assert.ok('GBP' in RATES);
+});
+
+test('RATES has correct exchange rates', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert EUR to USD multiplies by rate', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 10000 * 1.085 = 10850
+  assert.equal(result.value, 10850);
+});
+
+test('convert EUR to GBP multiplies by rate', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  // 10000 * 0.8425 = 8425
+  assert.equal(result.value, 8425);
+});
+
+test('convert 100 euros to USD is 108.50 dollars', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 100 EUR = 108.5 USD = 10850 cents
+  assert.equal(result.value, 10850);
+});
+
+test('convert 1 euro to USD is 108.5 cents', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  // 1 EUR = 1.085 USD = 108.5 cents, banker's rounding rounds 108.5 to 108 (even)
+  assert.equal(result.value, 108);
+});
+
+test('convert 1 euro to GBP is 84.25 pence', () => {
+  const result = convert(100, 'GBP');
+  assert.equal(result.ok, true);
+  // 1 EUR = 0.8425 GBP = 84.25 pence, rounded to 84
+  assert.equal(result.value, 84);
+});
+
+test('convert with unknown currency returns error', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with invalid currency returns error', () => {
+  const result = convert(10000, 'XXX');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert rounds using banker\'s rounding', () => {
+  // Test that rounding is applied correctly
+  const result1 = convert(33, 'USD');
+  assert.equal(result1.ok, true);
+  // 33 * 1.085 = 35.805, rounds to 36
+  assert.equal(result1.value, 36);
+});
+
+test('convert handles zero amount', () => {
+  const result = convert(0, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert handles negative amounts', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -10850);
+});
+
+test('formatMoney EUR uses euro symbol', () => {
+  const result = formatMoney(12345, 'EUR');
+  assert.ok(result.includes('€'));
+  assert.ok(result.includes('123.45'));
+});
+
+test('formatMoney USD uses dollar symbol', () => {
+  const result = formatMoney(12345, 'USD');
+  assert.ok(result.includes('$'));
+  assert.ok(result.includes('123.45'));
+});
+
+test('formatMoney GBP uses pound symbol', () => {
+  const result = formatMoney(12345, 'GBP');
+  assert.ok(result.includes('£'));
+  assert.ok(result.includes('123.45'));
+});
+
+test('formatMoney formats with thousands separator', () => {
+  const result = formatMoney(1234567, 'EUR');
+  assert.ok(result.includes('12,345.67'));
+});
+
+test('formatMoney formats small amounts with leading zero', () => {
+  const result = formatMoney(50, 'EUR');
+  assert.ok(result.includes('0.50'));
+});
+
+test('formatMoney handles negative amounts with minus sign', () => {
+  const result = formatMoney(-12345, 'EUR');
+  assert.ok(result.startsWith('-'));
+  assert.ok(result.includes('€'));
+});
+
+test('formatMoney zero amount', () => {
+  const result = formatMoney(0, 'EUR');
+  assert.equal(result, '€0.00');
+});
+
+test('formatMoney single cent', () => {
+  const result = formatMoney(1, 'USD');
+  assert.equal(result, '$0.01');
+});
+
+test('formatMoney large amount', () => {
+  const result = formatMoney(123456789, 'EUR');
+  assert.ok(result.includes('1,234,567.89'));
+});
+
+test('convert and formatMoney roundtrip EUR to USD', () => {
+  const eurAmount = 10000;
+  const convertResult = convert(eurAmount, 'USD');
+  assert.equal(convertResult.ok, true);
+
+  const formatted = formatMoney(convertResult.value, 'USD');
+  assert.ok(formatted.includes('$'));
+  assert.ok(formatted.includes('108.50'));
+});
+
+test('convert and formatMoney roundtrip EUR to GBP', () => {
+  const eurAmount = 10000;
+  const convertResult = convert(eurAmount, 'GBP');
+  assert.equal(convertResult.ok, true);
+
+  const formatted = formatMoney(convertResult.value, 'GBP');
+  assert.ok(formatted.includes('£'));
+  assert.ok(formatted.includes('84.25'));
+});
+
+test('convert USD back to EUR should approximately match', () => {
+  const eurAmount = 100;
+  const usdResult = convert(eurAmount, 'USD');
+  assert.equal(usdResult.ok, true);
+
+  // Convert back: USD amount / RATES.USD should be close to original
+  // This won't be exact due to rounding, but should be within 1 cent
+  const backResult = convert(Math.round(usdResult.value / RATES.USD), 'EUR');
+  assert.equal(backResult.ok, true);
+  assert.ok(Math.abs(backResult.value - eurAmount) <= 1);
+});
+
+test('formatMoney EUR for 1 cent', () => {
+  const result = formatMoney(1, 'EUR');
+  assert.equal(result, '€0.01');
+});
+
+test('formatMoney GBP for 1 pound', () => {
+  const result = formatMoney(100, 'GBP');
+  assert.equal(result, '£1.00');
+});
+
+test('convert maintains reasonable precision', () => {
+  // Test that convert produces reasonable results for various amounts
+  const amounts = [100, 1000, 10000, 100000];
+
+  for (const amount of amounts) {
+    const usdResult = convert(amount, 'USD');
+    assert.equal(usdResult.ok, true);
+    assert.ok(usdResult.value > 0);
+
+    const gbpResult = convert(amount, 'GBP');
+    assert.equal(gbpResult.ok, true);
+    assert.ok(gbpResult.value > 0);
+  }
+});
