+++ b/test/merge-customers.test.js
@@ -0,0 +1,225 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mergeCustomers, listCustomers } from '../src/customers.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+function createTestInvoice(customerId, issueDate) {
+  const invResult = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  return issueInvoice(invResult.value, []).value;
+}
+
+test('mergeCustomers removes fromId customer', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+
+  const mergedCustomers = result.value.customers;
+  const c001 = mergedCustomers.find(c => c.id === 'C-001');
+  assert.equal(c001, undefined);
+});
+
+test('mergeCustomers keeps intoId customer', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+
+  const mergedCustomers = result.value.customers;
+  const c002 = mergedCustomers.find(c => c.id === 'C-002');
+  assert.ok(c002);
+});
+
+test('mergeCustomers reassigns invoices from fromId to intoId', () => {
+  const customers = listCustomers();
+  const invoices = [
+    createTestInvoice('C-001', '2026-09-01'),
+    createTestInvoice('C-001', '2026-09-02'),
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+
+  const mergedInvoices = result.value.invoices;
+  assert.equal(mergedInvoices[0].customerId, 'C-002');
+  assert.equal(mergedInvoices[1].customerId, 'C-002');
+});
+
+test('mergeCustomers preserves other invoices', () => {
+  const customers = listCustomers();
+  const invoices = [
+    createTestInvoice('C-001', '2026-09-01'),
+    createTestInvoice('C-003', '2026-09-02'),
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+
+  const mergedInvoices = result.value.invoices;
+  assert.equal(mergedInvoices[0].customerId, 'C-002');
+  assert.equal(mergedInvoices[1].customerId, 'C-003');
+});
+
+test('mergeCustomers returns SAME_CUSTOMER error when ids are identical', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-001');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'SAME_CUSTOMER');
+});
+
+test('mergeCustomers returns CUSTOMER_NOT_FOUND when fromId not found', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-999', 'C-002');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('mergeCustomers returns CUSTOMER_NOT_FOUND when intoId not found', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-999');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('mergeCustomers normalizes fromId', () => {
+  const customers = listCustomers();
+  const invoices = [
+    createTestInvoice('C-001', '2026-09-01'),
+  ];
+
+  const result = mergeCustomers(customers, invoices, '  c-001  ', 'C-002');
+  assert.equal(result.ok, true);
+
+  const mergedInvoices = result.value.invoices;
+  assert.equal(mergedInvoices[0].customerId, 'C-002');
+});
+
+test('mergeCustomers normalizes intoId', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', '  c-002  ');
+  assert.equal(result.ok, true);
+  // C-001 should be removed
+  assert.equal(result.value.customers.find(c => c.id === 'C-001'), undefined);
+  // C-002 should still exist
+  assert.ok(result.value.customers.find(c => c.id === 'C-002'));
+});
+
+test('mergeCustomers with empty invoice list', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('mergeCustomers with multiple invoices from same customer', () => {
+  const customers = listCustomers();
+  const invoices = [
+    createTestInvoice('C-001', '2026-09-01'),
+    createTestInvoice('C-001', '2026-09-02'),
+    createTestInvoice('C-001', '2026-09-03'),
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+
+  const mergedInvoices = result.value.invoices;
+  assert.equal(mergedInvoices.length, 3);
+  assert.ok(mergedInvoices.every(inv => inv.customerId === 'C-002'));
+});
+
+test('mergeCustomers preserves invoice data other than customerId', () => {
+  const customers = listCustomers();
+  const invoices = [
+    createTestInvoice('C-001', '2026-09-01'),
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+
+  const mergedInvoice = result.value.invoices[0];
+  assert.equal(mergedInvoice.issueDate, '2026-09-01');
+  assert.equal(mergedInvoice.status, 'issued');
+  assert.ok(mergedInvoice.number);
+});
+
+test('mergeCustomers does not modify input arrays', () => {
+  const customers = listCustomers();
+  const originalCustomersLength = customers.length;
+  const invoices = [
+    createTestInvoice('C-001', '2026-09-01'),
+  ];
+  const originalInvoicesLength = invoices.length;
+
+  mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(customers.length, originalCustomersLength);
+  assert.equal(invoices.length, originalInvoicesLength);
+  assert.equal(invoices[0].customerId, 'C-001');
+});
+
+test('mergeCustomers reduces customer count by one', () => {
+  const customers = listCustomers();
+  const invoices = [];
+  const originalCount = customers.length;
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+
+  assert.equal(result.value.customers.length, originalCount - 1);
+});
+
+test('mergeCustomers with mixed invoices', () => {
+  const customers = listCustomers();
+  const invoices = [
+    createTestInvoice('C-001', '2026-09-01'),
+    createTestInvoice('C-002', '2026-09-02'),
+    createTestInvoice('C-001', '2026-09-03'),
+    createTestInvoice('C-003', '2026-09-04'),
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+
+  const mergedInvoices = result.value.invoices;
+  assert.equal(mergedInvoices[0].customerId, 'C-002');
+  assert.equal(mergedInvoices[1].customerId, 'C-002');
+  assert.equal(mergedInvoices[2].customerId, 'C-002');
+  assert.equal(mergedInvoices[3].customerId, 'C-003');
+});
+
+test('mergeCustomers returns both customers and invoices', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+  assert.ok('customers' in result.value);
+  assert.ok('invoices' in result.value);
+  assert.ok(Array.isArray(result.value.customers));
+  assert.ok(Array.isArray(result.value.invoices));
+});
+
+test('mergeCustomers case insensitive with same customer error', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'c-001', 'C-001');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'SAME_CUSTOMER');
+});
