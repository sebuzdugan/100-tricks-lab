+++ b/src/totals.js
@@ -0,0 +1,49 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total amount for a line: qty × unitPrice.
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount amount for a line: lineTotal × discountPercent / 100, rounded to whole cents.
+ * @param {{ discountPercent?: number }}
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  if (line.discountPercent === undefined) return 0;
+  return roundCents(lineTotal(line) * line.discountPercent / 100);
+}
+
+/**
+ * Calculate the VAT amount for a line: (lineTotal - lineDiscount) × vatRate / 100, rounded to whole cents.
+ * @param {{ vatRate: number, discountPercent?: number }}
+ * @returns {number}
+ */
+export function lineVat(line) {
+  const lineAfterDiscount = lineTotal(line) - lineDiscount(line);
+  return roundCents(lineAfterDiscount * line.vatRate / 100);
+}
+
+/**
+ * Calculate invoice totals: subtotal, discount, vat, voucher, and total.
+ * @param {{ lines: Array, voucher?: { code: string, amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+  for (const line of invoice.lines) {
+    subtotal += lineTotal(line);
+    discount += lineDiscount(line);
+    vat += lineVat(line);
+  }
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return { subtotal, discount, vat, voucher, total };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
