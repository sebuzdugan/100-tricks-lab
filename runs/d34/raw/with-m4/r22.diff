@@ -0,0 +1,276 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+function createTestInvoice(customerId, issueDate, lines) {
+  const invResult = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+  });
+  return issueInvoice(invResult.value, []).value;
+}
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const line = { qty: 10, unitPrice: 8500 };
+  const result = lineTotal(line);
+  assert.equal(result, 85000);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { qty: 1, unitPrice: 50 };
+  const result = lineTotal(line);
+  assert.equal(result, 50);
+});
+
+test('lineTotal with large amounts', () => {
+  const line = { qty: 100, unitPrice: 120000 };
+  const result = lineTotal(line);
+  assert.equal(result, 12000000);
+});
+
+test('lineDiscount returns 0 when no discount', () => {
+  const line = { qty: 10, unitPrice: 8500 };
+  const result = lineDiscount(line);
+  assert.equal(result, 0);
+});
+
+test('lineDiscount calculates with discountPercent', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 10 };
+  const result = lineDiscount(line);
+  // lineTotal: 85000, discount: 85000 * 10 / 100 = 8500
+  assert.equal(result, 8500);
+});
+
+test('lineDiscount with 5% discount', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 5 };
+  const result = lineDiscount(line);
+  // lineTotal: 5000, discount: 5000 * 5 / 100 = 250
+  assert.equal(result, 250);
+});
+
+test('lineDiscount with decimal discount percent', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 2.5 };
+  const result = lineDiscount(line);
+  // lineTotal: 85000, discount: 85000 * 2.5 / 100 = 2125
+  assert.equal(result, 2125);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 10, unitPrice: 8500, vatRate: 21 };
+  const result = lineVat(line);
+  // lineTotal: 85000, no discount, VAT: 85000 * 21 / 100 = 17850
+  assert.equal(result, 17850);
+});
+
+test('lineVat with discount applied', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 };
+  const result = lineVat(line);
+  // lineTotal: 85000, discount: 8500, amount: 76500, VAT: 76500 * 21 / 100 = 16065
+  assert.equal(result, 16065);
+});
+
+test('lineVat with 9% rate', () => {
+  const line = { qty: 1000, unitPrice: 37, vatRate: 9 };
+  const result = lineVat(line);
+  // lineTotal: 37000, VAT: 37000 * 9 / 100 = 3330
+  assert.equal(result, 3330);
+});
+
+test('lineVat with 0% rate', () => {
+  const line = { qty: 1, unitPrice: 60000, vatRate: 0 };
+  const result = lineVat(line);
+  assert.equal(result, 0);
+});
+
+test('invoiceTotals single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 85000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 17850);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 102850);
+});
+
+test('invoiceTotals multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, vatRate: 21 },
+      { qty: 100, unitPrice: 50, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  // Line 1: subtotal 85000, vat 17850
+  // Line 2: subtotal 5000, vat 1050
+  // Total: subtotal 90000, vat 18900
+  assert.equal(result.subtotal, 90000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 18900);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 108900);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  // subtotal: 85000, discount: 4250, amount: 80750, vat: 80750 * 21 / 100 = 16957.5 ≈ 16958
+  assert.equal(result.subtotal, 85000);
+  assert.equal(result.discount, 4250);
+  assert.equal(result.vat, 16958);
+  assert.equal(result.total, 97708);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 85000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 17850);
+  assert.equal(result.voucher, 5000);
+  assert.equal(result.total, 97850);
+});
+
+test('invoiceTotals with discount and voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const result = invoiceTotals(invoice);
+
+  // subtotal: 85000, discount: 8500, amount: 76500, vat: 16065, voucher: 5000
+  // total: 85000 - 8500 + 16065 - 5000 = 87565
+  assert.equal(result.subtotal, 85000);
+  assert.equal(result.discount, 8500);
+  assert.equal(result.vat, 16065);
+  assert.equal(result.voucher, 5000);
+  assert.equal(result.total, 87565);
+});
+
+test('invoiceTotals clamps total to 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 0 },
+    ],
+    voucher: { code: 'TEST', amount: 200 },
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with multiple VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, vatRate: 21 },
+      { qty: 1000, unitPrice: 37, vatRate: 9 },
+      { qty: 1, unitPrice: 60000, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  // Line 1: subtotal 85000, vat 17850
+  // Line 2: subtotal 37000, vat 3330
+  // Line 3: subtotal 60000, vat 0
+  // Total: subtotal 182000, vat 21180
+  assert.equal(result.subtotal, 182000);
+  assert.equal(result.vat, 21180);
+  assert.equal(result.total, 203180);
+});
+
+test('invoiceTotals with real invoice from createInvoice', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 10 },
+  ]);
+
+  const result = invoiceTotals(invoice);
+
+  // DES-HOUR: unitPrice 8500, vatRate 21, qty 10
+  // C-001 is gold tier, so 5% discount
+  // subtotal: 85000, discount: 4250, amount: 80750
+  // vat: 80750 * 21 / 100 = 16957.5 ≈ 16958
+  // total: 80750 + 16958 = 97708
+  assert.equal(result.subtotal, 85000);
+  assert.equal(result.discount, 4250);
+  assert.equal(result.vat, 16958);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 97708);
+});
+
+test('invoiceTotals calculates all fields correctly together', () => {
+  const invoice = createTestInvoice('C-002', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 5 },
+    { sku: 'STICKER', qty: 100 },
+  ]);
+
+  const result = invoiceTotals(invoice);
+
+  // All amounts should be positive
+  assert.ok(result.subtotal > 0);
+  assert.ok(result.vat >= 0);
+  assert.ok(result.total > 0);
+
+  // Total should be: subtotal - discount + vat - voucher
+  const calculated = result.subtotal - result.discount + result.vat - result.voucher;
+  assert.equal(result.total, Math.max(0, calculated));
+});
+
+test('invoiceTotals handles empty lines gracefully', () => {
+  // This shouldn't happen in practice, but test defensive behavior
+  const invoice = {
+    lines: [],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.subtotal, 0);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 0);
+});
+
+test('lineTotal, lineDiscount, lineVat work together', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 };
+
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const vat = lineVat(line);
+
+  // Verify relationships (lineDiscount and lineVat apply rounding)
+  // Discount should be close to the calculated value
+  assert.ok(Math.abs(discount - Math.round(total * 5 / 100)) <= 1);
+  // VAT should be calculated on the amount after discount
+  assert.ok(Math.abs(vat - Math.round((total - discount) * 21 / 100)) <= 1);
+});
+
+test('invoiceTotals field relationships', () => {
+  const invoice = createTestInvoice('C-001', '2026-09-01', [
+    { sku: 'DES-HOUR', qty: 10 },
+  ]);
+
+  const result = invoiceTotals(invoice);
+
+  // Verify: total = subtotal - discount + vat - voucher
+  const expectedTotal = result.subtotal - result.discount + result.vat - result.voucher;
+  assert.equal(result.total, Math.max(0, expectedTotal));
+});
