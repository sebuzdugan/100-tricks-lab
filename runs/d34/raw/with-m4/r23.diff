index 64f7c10..aef5a58 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -10,13 +10,33 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount amount for a line: lineTotal × discountPercent / 100, rounded to whole cents.
- * @param {{ discountPercent?: number }}
+ * Calculate the discount amount for a line: initial discount plus bulk discount if qty >= 10.
+ * Bulk discount (2.5%) is applied to the amount after the initial discount.
+ * @param {{ qty: number, discountPercent?: number }}
  * @returns {number}
  */
 export function lineDiscount(line) {
-  if (line.discountPercent === undefined) return 0;
-  return roundCents(lineTotal(line) * line.discountPercent / 100);
+  const total = lineTotal(line);
+  if (line.discountPercent === undefined && line.discountPercent !== 0) {
+    // No discount provided, check for bulk discount only
+    if (line.qty >= 10) {
+      const bulkDiscount = roundCents(total * 2.5 / 100);
+      return bulkDiscount;
+    }
+    return 0;
+  }
+
+  // Calculate first discount (line's own discount)
+  const firstDiscount = roundCents(total * (line.discountPercent ?? 0) / 100);
+  const amountAfterFirstDiscount = total - firstDiscount;
+
+  // Calculate bulk discount (if qty >= 10)
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    bulkDiscount = roundCents(amountAfterFirstDiscount * 2.5 / 100);
+  }
+
+  return firstDiscount + bulkDiscount;
 }
 
