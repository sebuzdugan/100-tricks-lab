+test('renderInvoiceText renders lines in correct order', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    dueDate: '2026-10-15',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 10 },
+    ],
+    voucher: { code: 'SUMMER', amount: 2000 },
+    payments: [
+      { amount: 20000, date: '2026-10-10' },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Check order: number, customer, line items, discount, VAT, voucher, total, due, paid
+  const numberIdx = lines.findIndex(l => l === 'INV-2026-0001');
+  const customerIdx = lines.findIndex(l => l === 'Kite & Co');
+  const lineIdx = lines.findIndex(l => l.includes('Design work'));
+  const discountIdx = lines.findIndex(l => l.includes('Discount:'));
+  const vatIdx = lines.findIndex(l => l.includes('VAT:'));
+  const voucherIdx = lines.findIndex(l => l.includes('Voucher:'));
+  const totalIdx = lines.findIndex(l => l.startsWith('Total:'));
+  const dueIdx = lines.findIndex(l => l.startsWith('Due:'));
+  const paidIdx = lines.findIndex(l => l.startsWith('Paid:'));
+
+  assert.ok(numberIdx < customerIdx);
+  assert.ok(customerIdx < lineIdx);
+  assert.ok(lineIdx < discountIdx);
+  assert.ok(discountIdx < vatIdx);
+  assert.ok(vatIdx < voucherIdx);
+  assert.ok(voucherIdx < totalIdx);
+  assert.ok(totalIdx < dueIdx);
+  assert.ok(dueIdx < paidIdx);
+});
