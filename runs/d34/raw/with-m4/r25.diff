+import { lineTotal, invoiceTotals, lineVat, lineDiscount } from './invoices.js';
 
 /**
  * Render an invoice as plain text.
- * @param {{ number?: string, customerId: string, lines: Array }} invoice
+ * @param {{ number?: string, customerId: string, lines: Array, voucher?: any, dueDate?: string, payments?: Array }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -22,13 +22,32 @@ export function renderInvoiceText(invoice) {
     const priceStr = formatEuros(line.unitPrice);
     const totalStr = formatEuros(total);
     lines.push(`${qtyStr}x ${nameStr} @ ${priceStr} = ${totalStr}`);
+
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      lines.push(`  Discount: ${formatEuros(discount)}`);
+    }
   }
 
   const totals = invoiceTotals(invoice);
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+
+  if (invoice.voucher) {
+    lines.push(`Voucher: ${formatEuros(invoice.voucher.amount)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
