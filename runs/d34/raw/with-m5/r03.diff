+/**
+ * Add or increase a line on a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string, qty: number, unitPrice: number, vatRate: number, name: string }>, customerId: string, issueDate: string }} invoice
+ * @param {{ sku: string, qty: number }} item
+ * @returns {import('./result.js').Result<{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }>}
+ */
+export function addLine(invoice, item) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (!Number.isInteger(item.qty) || item.qty <= 0) return fail('QTY_INVALID');
+
+  const productResult = getProduct(item.sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+  const existingLineIndex = newLines.findIndex((line) => line.sku === item.sku);
+
+  if (existingLineIndex >= 0) {
+    newLines[existingLineIndex].qty += item.qty;
+  } else {
+    newLines.push({
+      sku: item.sku,
+      name: product.name,
+      qty: item.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string }>, customerId: string, issueDate: string }} invoice
+ * @param {string} sku
+ * @returns {import('./result.js').Result<{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }>}
+ */
+export function removeLine(invoice, sku) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex < 0) return fail('LINE_NOT_FOUND');
+
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  const newLines = invoice.lines.filter((line) => line.sku !== sku).map((line) => ({ ...line }));
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: newLines,
+  });
+}
+
