index 0000000..60c9157
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 when no numbers exist', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber finds the highest counter even if not sequential', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber restarts counter for a new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0099', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2027-01-01');
+  assert.equal(number, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0050', 'INV-2026-0001', 'INV-2026-0003', 'INV-2027-0100'];
+  const number = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 100 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-06-01');
+  assert.equal(number, 'INV-2026-0101');
+});
+
+test('nextInvoiceNumber ignores invalid numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-XXXX', 'INV-2026-0003', 'INV-invalid-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
