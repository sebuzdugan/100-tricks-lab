@@ -0,0 +1,19 @@
+/**
+ * Get the next available invoice number for a given year.
+ * Format: INV-<year>-<4-digit counter starting at 0001>
+ * @param {Array<string>} existingNumbers - Invoice numbers already in use (e.g., ["INV-2026-0001", "INV-2026-0003"])
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  const currentYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length), 10))
+    .filter((num) => !isNaN(num));
+
+  const nextCounter = currentYearNumbers.length === 0 ? 1 : Math.max(...currentYearNumbers) + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
