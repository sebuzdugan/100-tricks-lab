+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const invoice = r.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '5x Development (hour) @ €95.00 = €475.00');
+  assert.equal(lines[3], 'Total: €475.00');
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  const invoice = r.value;
+
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const text = renderInvoiceText(issuedInvoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '1x Logo package @ €1,200.00 = €1,200.00');
+  assert.equal(lines[3], 'Total: €1,200.00');
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 10 },
+    ],
+  });
+  const invoice = r.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '5x Development (hour) @ €95.00 = €475.00');
+  assert.equal(lines[3], '10x Copywriting (hour) @ €60.00 = €600.00');
+  assert.equal(lines[4], 'Total: €1,075.00');
+});
+
+test('renderInvoiceText shows correct customer names', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const text1 = renderInvoiceText(r1.value);
+  assert.match(text1, /Blue Fern Bakery/);
+
+  const r2 = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const text2 = renderInvoiceText(r2.value);
+  assert.match(text2, /Orchard Health/);
+});
+
+test('renderInvoiceText formats prices with thousands separators', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 5 },
+    ],
+  });
+  const invoice = r.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /€2,450\.00/);
+  assert.match(text, /Total: €12,250\.00/);
+});
+
+test('renderInvoiceText handles single-digit prices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /100x Sticker sheet @ €0\.50 = €50\.00/);
+  assert.match(text, /Total: €50\.00/);
+});
+
+test('renderInvoiceText preserves order and line structure', () => {
+  const r = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2025-06-15',
+    lines: [
+      { sku: 'PRINT-A4', qty: 500 },
+      { sku: 'PRINT-A3', qty: 100 },
+      { sku: 'HOST-MONTH', qty: 12 },
+    ],
+  });
+  const invoice = r.value;
+
+  const r2 = issueInvoice(invoice, ['INV-2025-0001']);
+  const issuedInvoice = r2.value;
+
+  const text = renderInvoiceText(issuedInvoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2025-0002');
+  assert.equal(lines[1], 'Lumen Records');
+  assert.equal(lines[2], '500x Printed flyer A4 (each) @ €0.37 = €185.00');
+  assert.equal(lines[3], '100x Printed poster A3 (each) @ €2.49 = €249.00');
+  assert.equal(lines[4], '12x Website hosting (month) @ €15.00 = €180.00');
+  assert.equal(lines[5], 'Total: €614.00');
+});
