+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the balance due on an invoice: total minus payments.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const payments = invoice.payments ?? [];
+  const paid = payments.reduce((sum, p) => sum + p.amount, 0);
+  return totals.total - paid;
+}
+
+/**
+ * Record a payment on an issued or partially-paid invoice.
+ * @param {{ status: string, customerId: string, issueDate: string, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {import('./result.js').Result<{ status: string, customerId: string, issueDate: string, payments: Array<{ amount: number, date: string }> }>}
+ */
+export function recordPayment(invoice, payment) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(payment.amount) || payment.amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const due = balanceDue(invoice);
+  if (payment.amount > due) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = [...(invoice.payments ?? [])];
+  newPayments.push({
+    amount: payment.amount,
+    date: payment.date,
+  });
+
+  const newBalance = due - payment.amount;
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
