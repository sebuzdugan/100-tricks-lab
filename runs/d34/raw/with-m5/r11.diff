+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('balanceDue returns total when no payments made', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const due = balanceDue(issuedInvoice);
+  assert.equal(due, 114950);
+});
+
+test('balanceDue reduces by payment amount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const totalDue = balanceDue(issuedInvoice);
+  assert.equal(totalDue, 6050);
+
+  const r3 = recordPayment(issuedInvoice, { amount: 3000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  const after = balanceDue(r3.value);
+  assert.equal(after, 3050);
+});
+
+test('recordPayment with full payment changes status to paid', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const totalDue = balanceDue(issuedInvoice);
+  assert.equal(totalDue, 6050);
+  const r3 = recordPayment(issuedInvoice, { amount: totalDue, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'paid');
+  assert.equal(balanceDue(r3.value), 0);
+});
+
+test('recordPayment with partial payment changes status to partially_paid', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = recordPayment(issuedInvoice, { amount: 50000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'partially_paid');
+});
+
+test('recordPayment from partially_paid to paid', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const totalDue = balanceDue(issuedInvoice);
+
+  const r3 = recordPayment(issuedInvoice, { amount: 50000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  const partiallyPaid = r3.value;
+
+  const remainingDue = balanceDue(partiallyPaid);
+  const r4 = recordPayment(partiallyPaid, { amount: remainingDue, date: '2026-10-09' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.status, 'paid');
+  assert.equal(balanceDue(r4.value), 0);
+});
+
+test('recordPayment rejects draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+
+  const r2 = recordPayment(invoice, { amount: 10000, date: '2026-10-08' });
+  assert.deepEqual(r2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const totalDue = balanceDue(issuedInvoice);
+  const r3 = recordPayment(issuedInvoice, { amount: totalDue, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+
+  const r4 = recordPayment(r3.value, { amount: 1000, date: '2026-10-09' });
+  assert.deepEqual(r4, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects invalid amount (zero)', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = recordPayment(issuedInvoice, { amount: 0, date: '2026-10-08' });
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects invalid amount (negative)', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = recordPayment(issuedInvoice, { amount: -1000, date: '2026-10-08' });
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = recordPayment(issuedInvoice, { amount: 1000.5, date: '2026-10-08' });
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const totalDue = balanceDue(issuedInvoice);
+  const r3 = recordPayment(issuedInvoice, { amount: totalDue + 1000, date: '2026-10-08' });
+  assert.deepEqual(r3, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment with partial then overpayment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const totalDue = balanceDue(issuedInvoice);
+  const r3 = recordPayment(issuedInvoice, { amount: 50000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  const partiallyPaid = r3.value;
+
+  const remainingDue = balanceDue(partiallyPaid);
+  const r4 = recordPayment(partiallyPaid, { amount: remainingDue + 1000, date: '2026-10-09' });
+  assert.deepEqual(r4, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate the original invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+  const originalCopy = JSON.parse(JSON.stringify(issuedInvoice));
+
+  recordPayment(issuedInvoice, { amount: 10000, date: '2026-10-08' });
+  assert.deepEqual(issuedInvoice, originalCopy);
+});
+
+test('recordPayment stores payment with date', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const totalDue = balanceDue(issuedInvoice);
+  assert.equal(totalDue, 6050);
+  const r3 = recordPayment(issuedInvoice, { amount: 3000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 1);
+  assert.deepEqual(r3.value.payments[0], { amount: 3000, date: '2026-10-08' });
+});
+
+test('recordPayment accumulates multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const invoice = r.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = recordPayment(issuedInvoice, { amount: 30000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+
+  const r4 = recordPayment(r3.value, { amount: 40000, date: '2026-10-09' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.payments.length, 2);
+  assert.equal(r4.value.payments[0].amount, 30000);
+  assert.equal(r4.value.payments[1].amount, 40000);
+});
