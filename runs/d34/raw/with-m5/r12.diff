+/**
+ * Calculate the due date based on payment terms and issue date.
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @param {string} terms - Payment terms: 'NET14', 'NET30', or 'EOM'
+ * @returns {string} Due date in YYYY-MM-DD format
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const date = new Date(issueDate + 'T00:00:00Z');
+    const year = date.getUTCFullYear();
+    const month = date.getUTCMonth();
+    const lastDayOfMonth = new Date(Date.UTC(year, month + 1, 0));
+    return lastDayOfMonth.toISOString().split('T')[0];
+  }
+  return null;
+}
