diff --git a/src/statements.js b/src/statements.js
new file mode 100644
index 0000000..eee9482
--- /dev/null
+++ b/src/statements.js
@@ -0,0 +1,41 @@
+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement for a given date.
+ * @param {string} customerId
+ * @param {Array<{ number: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {import('./result.js').Result<{ customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number }>}
+ */
+export function statement(customerId, invoices, asOf) {
+  const normalizedId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedId);
+  if (!customerResult.ok) return customerResult;
+
+  const relevantInvoices = invoices
+    .filter((invoice) => invoice.customerId === normalizedId)
+    .filter((invoice) => invoice.status === 'issued' || invoice.status === 'partially_paid')
+    .filter((invoice) => invoice.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate))
+    .map((invoice) => {
+      const totals = invoiceTotals(invoice);
+      return {
+        number: invoice.number,
+        issueDate: invoice.issueDate,
+        dueDate: invoice.dueDate,
+        total: totals.total,
+        due: balanceDue(invoice),
+      };
+    });
+
+  const totalDue = relevantInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedId,
+    invoices: relevantInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
