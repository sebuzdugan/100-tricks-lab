+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next available credit note number for a given year.
+ * Format: CN-<year>-<4-digit counter starting at 0001>
+ * @param {Array<string>} existingNumbers - All invoice and credit note numbers already in use
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  const creditNoteNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length), 10))
+    .filter((num) => !isNaN(num));
+
+  const nextCounter = creditNoteNumbers.length === 0 ? 1 : Math.max(...creditNoteNumbers) + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ number: string, customerId: string, status: string, lines: Array, voucher?: { amount: number }, payments?: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {Array<string>} existingNumbers - All invoice and credit note numbers already in use
+ * @returns {import('./result.js').Result<{ number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string }>}
+ */
+export function createCreditNote(invoice, creditData, existingNumbers) {
+  const { amount, reason, date } = creditData;
+
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
