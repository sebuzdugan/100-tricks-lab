+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote on issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice, { amount: 1000, reason: 'Damage', date: '2026-10-02' }, [issuedInvoice.number]);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0001');
+  assert.equal(r3.value.invoiceNumber, issuedInvoice.number);
+  assert.equal(r3.value.customerId, 'C-002');
+  assert.equal(r3.value.amount, 1000);
+  assert.equal(r3.value.reason, 'Damage');
+  assert.equal(r3.value.date, '2026-10-02');
+});
+
+test('createCreditNote on partially_paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+  const r3 = recordPayment(issuedInvoice, { amount: 3000, date: '2026-10-02' });
+
+  const r4 = createCreditNote(r3.value, { amount: 1000, reason: 'Discount', date: '2026-10-03' }, [issuedInvoice.number]);
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote on paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+  const r3 = recordPayment(issuedInvoice, { amount: 6050, date: '2026-10-02' });
+
+  const r4 = createCreditNote(r3.value, { amount: 1000, reason: 'Return', date: '2026-10-03' }, [issuedInvoice.number]);
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+
+  const r2 = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2026-10-02' }, []);
+  assert.deepEqual(r2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects invalid amount (zero)', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice, { amount: 0, reason: 'Test', date: '2026-10-02' }, [issuedInvoice.number]);
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects invalid amount (negative)', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice, { amount: -1000, reason: 'Test', date: '2026-10-02' }, [issuedInvoice.number]);
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice, { amount: 1000.5, reason: 'Test', date: '2026-10-02' }, [issuedInvoice.number]);
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice, { amount: 10000, reason: 'Test', date: '2026-10-02' }, [issuedInvoice.number]);
+  assert.deepEqual(r3, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows amount equal to invoice total', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice, { amount: 6050, reason: 'Full refund', date: '2026-10-02' }, [issuedInvoice.number]);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.amount, 6050);
+});
+
+test('createCreditNote generates CN numbers with separate counter', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice1 = r1.value;
+  const r2 = issueInvoice(invoice1, ['INV-2026-0001', 'INV-2026-0002']);
+  const issuedInvoice1 = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice1, { amount: 1000, reason: 'Test', date: '2026-10-02' }, ['INV-2026-0001', 'INV-2026-0002']);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote increments CN counter independently', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice1 = r1.value;
+  const r2 = issueInvoice(invoice1, ['INV-2026-0001']);
+  const issuedInvoice1 = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice1, { amount: 1000, reason: 'First', date: '2026-10-02' }, ['INV-2026-0001', 'CN-2026-0001']);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote with mixed INV and CN numbers', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003']);
+  const issuedInvoice = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice, { amount: 1000, reason: 'Test', date: '2026-10-02' }, ['INV-2026-0001', 'CN-2026-0001', 'INV-2026-0002', 'CN-2026-0002', 'INV-2026-0003']);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote with different year resets counter', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, ['CN-2025-0005']);
+  const issuedInvoice = r2.value;
+
+  const r3 = createCreditNote(issuedInvoice, { amount: 1000, reason: 'Test', date: '2026-10-02' }, ['CN-2025-0005']);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote does not mutate input', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+  const originalCopy = JSON.parse(JSON.stringify(issuedInvoice));
+
+  createCreditNote(issuedInvoice, { amount: 1000, reason: 'Test', date: '2026-10-02' }, [issuedInvoice.number]);
+  assert.deepEqual(issuedInvoice, originalCopy);
+});
+
+test('createCreditNote with voucher subtracts voucher from total', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 });
+  const withVoucher = r2.value;
+  const r3 = issueInvoice(withVoucher, []);
+  const issuedInvoice = r3.value;
+
+  const r4 = createCreditNote(issuedInvoice, { amount: 5050, reason: 'Full refund', date: '2026-10-02' }, [issuedInvoice.number]);
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.amount, 5050);
+});
