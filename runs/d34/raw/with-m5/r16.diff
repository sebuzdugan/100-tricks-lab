+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices with empty list', () => {
+  const result = overdueInvoices([], '2026-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices with single overdue invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = overdueInvoices([issuedInvoice], '2026-10-16');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issuedInvoice.number);
+  assert.equal(result[0].customerId, 'C-002');
+  assert.equal(result[0].dueDate, '2026-10-15');
+  assert.equal(result[0].daysOverdue, 1);
+  assert.equal(result[0].due, 6050);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const invoice1 = r1.value;
+  const r2 = issueInvoice(invoice1, ['INV-2026-0001']);
+  const issuedInvoice1 = r2.value;
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+    terms: 'NET14',
+  });
+  const invoice2 = r3.value;
+  const r4 = issueInvoice(invoice2, ['INV-2026-0001', 'INV-2026-0002']);
+  const issuedInvoice2 = r4.value;
+
+  const result = overdueInvoices([issuedInvoice1, issuedInvoice2], '2026-10-25');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].daysOverdue, 10);
+  assert.equal(result[1].daysOverdue, 6);
+});
+
