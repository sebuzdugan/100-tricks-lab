+import { daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Get overdue invoices sorted by most overdue first.
+ * @param {Array<{ number: string, customerId: string, status: string, dueDate: string, payments?: Array, lines: Array, voucher?: { amount: number } }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((invoice) => invoice.status === 'issued' || invoice.status === 'partially_paid')
+    .filter((invoice) => invoice.dueDate < asOf)
+    .map((invoice) => ({
+      number: invoice.number,
+      customerId: invoice.customerId,
+      dueDate: invoice.dueDate,
+      daysOverdue: daysBetween(invoice.dueDate, asOf),
+      due: balanceDue(invoice),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
