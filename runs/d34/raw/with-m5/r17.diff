 }
+
+/**
+ * Get VAT summary grouped by rate.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  invoices
+    .filter((invoice) => invoice.status === 'issued' || invoice.status === 'partially_paid' || invoice.status === 'paid')
+    .forEach((invoice) => {
+      invoice.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVat(line);
+
+        if (!vatByRate[rate]) {
+          vatByRate[rate] = { base: 0, vat: 0 };
+        }
+        vatByRate[rate].base += base;
+        vatByRate[rate].vat += vat;
+      });
+    });
+
+  return Object.entries(vatByRate)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseFloat(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
