+/**
+ * Calculate late fee for an invoice: 0.04% per day overdue.
+ * @param {{ dueDate: string, payments?: Array, lines: Array, voucher?: { amount: number } }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} Fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const amountDue = balanceDue(invoice);
+  const fee = amountDue * 0.0004 * daysOverdue;
+  return roundCents(fee);
+}
