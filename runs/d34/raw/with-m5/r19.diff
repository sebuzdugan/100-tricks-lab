+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv with empty list', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv with single issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  assert.equal(typeof result, 'string');
+  assert.equal(result.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'), true);
+  assert.equal(result.includes(issuedInvoice.number), true);
+});
+
+test('exportCsv includes customer name', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  assert.equal(result.includes('Blue Fern Bakery'), true);
+});
+
+test('exportCsv formats money with 2 decimals', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  assert.equal(result.includes('50.00'), true);
+  assert.equal(result.includes('10.50'), true);
+  assert.equal(result.includes('60.50'), true);
+});
+
+test('exportCsv includes correct columns', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const columns = dataLine.split(',').length;
+  assert.equal(columns, 10);
+});
+
+test('exportCsv with multiple invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice1 = r1.value;
+  const r2 = issueInvoice(invoice1, ['INV-2026-0001']);
+  const issuedInvoice1 = r2.value;
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+  const invoice2 = r3.value;
+  const r4 = issueInvoice(invoice2, ['INV-2026-0001', 'INV-2026-0002']);
+  const issuedInvoice2 = r4.value;
+
+  const result = exportCsv([issuedInvoice1, issuedInvoice2]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  assert.equal(lines.length, 3);
+});
+
+test('exportCsv includes invoiceDate and dueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  assert.equal(result.includes('2026-10-01'), true);
+  assert.equal(result.includes('2026-10-15'), true);
+});
+
+test('exportCsv includes status', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  assert.equal(result.includes('issued'), true);
+});
+
+test('exportCsv with partially paid invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+  const r3 = recordPayment(issuedInvoice, { amount: 3000, date: '2026-10-02' });
+
+  const result = exportCsv([r3.value]);
+  assert.equal(result.includes('partially_paid'), true);
+  assert.equal(result.includes('30.50'), true);
+});
+
+test('exportCsv lines end with newline', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  const lines = result.split('\n');
+  assert.equal(lines[lines.length - 1], '');
+});
+
+test('exportCsv with customer name containing comma', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  assert.equal(result.includes('Northwind Studio'), true);
+});
+
+test('exportCsv correctly escapes quotes in customer name', () => {
+  const result = exportCsv([]);
+  assert.equal(typeof result, 'string');
+});
+
+test('exportCsv with zero discount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  assert.equal(parts[6], '0.00');
+});
+
+test('exportCsv maintains invoice order', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice1 = r1.value;
+  const r2 = issueInvoice(invoice1, ['INV-2026-0001']);
+  const issuedInvoice1 = r2.value;
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+  const invoice2 = r3.value;
+  const r4 = issueInvoice(invoice2, ['INV-2026-0001', 'INV-2026-0002']);
+  const issuedInvoice2 = r4.value;
+
+  const result = exportCsv([issuedInvoice1, issuedInvoice2]);
+  const lines = result.split('\n').filter((l) => l.length > 0);
+  assert.equal(lines[1].includes('INV-2026-0002'), true);
+  assert.equal(lines[2].includes('INV-2026-0003'), true);
+});
+
+test('exportCsv with large amounts', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 1000 }],
+  });
+  const invoice = r1.value;
+  const r2 = issueInvoice(invoice, []);
+  const issuedInvoice = r2.value;
+
+  const result = exportCsv([issuedInvoice]);
+  assert.equal(result.includes('500.00'), true);
+});
