+/**
+ * Merge a duplicate customer into another, transferring all invoices.
+ * @param {Array<{ id: string }>} customers - Array of customer objects
+ * @param {Array<{ customerId: string }>} invoices - Array of invoice objects
+ * @param {string} fromId - Customer ID to merge from (will be removed)
+ * @param {string} intoId - Customer ID to merge into (will receive all invoices)
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  const fromCustomer = customers.find((c) => normalizeId(c.id) === normalizedFromId);
+  const intoCustomer = customers.find((c) => normalizeId(c.id) === normalizedIntoId);
+
+  if (!fromCustomer || !intoCustomer) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const newCustomers = customers.filter((c) => normalizeId(c.id) !== normalizedFromId).map((c) => ({ ...c }));
+
+  const newInvoices = invoices.map((inv) => ({
+    ...inv,
+    customerId: normalizeId(inv.customerId) === normalizedFromId ? normalizedIntoId : inv.customerId,
+  }));
+
+  return ok({
+    customers: newCustomers,
+    invoices: newInvoices,
+  });
+}
