@@ -0,0 +1,133 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 100, unitPrice: 50 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with fractional unitPrice', () => {
+  const line = { qty: 3, unitPrice: 33.33 };
+  assert.equal(lineTotal(line), 99.99);
+});
+
+test('lineDiscount calculates lineTotal times discountPercent / 100', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 500);
+});
+
+test('lineDiscount with no discountPercent', () => {
+  const line = { qty: 100, unitPrice: 50 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount is clamped to 0', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: -10 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 50, vatRate: 21 };
+  const vat = lineVat(line);
+  assert.equal(typeof vat, 'number');
+  assert.equal(vat > 0, true);
+});
+
+test('lineVat with discount', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 10, vatRate: 21 };
+  const vat = lineVat(line);
+  const expectedBase = 100 * 50 - (100 * 50 * 0.1);
+  const expectedVat = expectedBase * 0.21;
+  assert.equal(vat, Math.round(expectedVat * 100) / 100);
+});
+
+test('lineVat with zero discount', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 };
+  const vat = lineVat(line);
+  assert.equal(typeof vat, 'number');
+  assert.equal(vat > 0, true);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 0);
+  assert.equal(typeof totals.vat, 'number');
+  assert.equal(totals.voucher, 0);
+  assert.equal(typeof totals.total, 'number');
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, vatRate: 21 },
+      { qty: 50, unitPrice: 100, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 500);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 1000);
+  assert.equal(totals.total < totals.subtotal + totals.vat, true);
+});
+
+test('invoiceTotals total formula', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals clamps total to 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10, vatRate: 21 }],
+    voucher: { code: 'BIG', amount: 100000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with empty lines', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes all required fields', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(Object.keys(totals).length, 5);
+  assert.equal('subtotal' in totals, true);
+  assert.equal('discount' in totals, true);
+  assert.equal('vat' in totals, true);
+  assert.equal('voucher' in totals, true);
+  assert.equal('total' in totals, true);
+});
