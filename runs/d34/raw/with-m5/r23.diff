 /**
- * Calculate the VAT for a single line: (lineTotal - lineDiscount) times vatRate / 100, rounded per line.
+ * Calculate the bulk discount for a single line: 2.5% off for 10+ units, applied after primary discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineBulkDiscount(line) {
+  if (line.qty < 10) return 0;
+
+  const primaryDiscount = lineDiscount(line);
+  const amountAfterPrimaryDiscount = lineTotal(line) - primaryDiscount;
+  const bulkDiscount = amountAfterPrimaryDiscount * 0.025;
+  return bulkDiscount;
+}
+
+/**
+ * Calculate the VAT for a single line: (lineTotal - allDiscounts) times vatRate / 100, rounded per line.
