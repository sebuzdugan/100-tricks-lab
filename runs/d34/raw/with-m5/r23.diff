-  const vat = amountAfterDiscount * (line.vatRate / 100);
+  const primaryDiscount = lineDiscount(line);
+  const bulkDiscount = lineBulkDiscount(line);
+  const amountAfterDiscounts = lineTotal(line) - primaryDiscount - bulkDiscount;
+  const vat = amountAfterDiscounts * (line.vatRate / 100);
   return roundCents(vat);
 }
 
