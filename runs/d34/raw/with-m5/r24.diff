+test('dashboard with empty invoices', () => {
+  const result = dashboard([], '2026-10-07');
+  assert.deepEqual(result.counts, { draft: 0, issued: 0, partially_paid: 0, paid: 0 });
+  assert.equal(result.outstanding, 0);
+  assert.deepEqual(result.overdue, { count: 0, amount: 0 });
+  assert.deepEqual(result.topCustomers, []);
+});
+
+test('dashboard counts invoices by status', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const draft = r1.value;
+
+  const r2 = issueInvoice(draft, []);
+  const issued = r2.value;
+
+  const r3 = recordPayment(issued, { amount: 2000, date: '2026-10-02' });
+  const partiallyPaid = r3.value;
+
+  const r4 = recordPayment(partiallyPaid, { amount: 3899, date: '2026-10-03' });
+  const paid = r4.value;
+
+  const result = dashboard([draft, issued, partiallyPaid, paid], '2026-10-07');
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.partially_paid, 1);
+  assert.equal(result.counts.paid, 1);
+});
+
