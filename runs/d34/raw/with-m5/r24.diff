@@ -72,3 +72,51 @@ export function lateFee(invoice, asOf) {
   const fee = amountDue * 0.0004 * daysOverdue;
   return roundCents(fee);
 }
+
+/**
+ * Get dashboard metrics for invoices.
+ * @param {Array<{ status: string, customerId: string, payments?: Array, lines: Array, voucher?: { amount: number }, dueDate: string }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = {};
+
+  invoices.forEach((invoice) => {
+    counts[invoice.status] = (counts[invoice.status] || 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      const customerId = invoice.customerId;
+      customerDue[customerId] = (customerDue[customerId] || 0) + due;
+    }
+  });
+
+  const overdue_ = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue_.reduce((sum, inv) => sum + inv.due, 0);
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue_.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
