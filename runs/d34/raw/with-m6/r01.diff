+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate that a string is a valid date in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!match) return false;
+  const date = new Date(dateStr);
+  if (!(date instanceof Date) || isNaN(date.getTime())) return false;
+  const [_, year, month, day] = match;
+  return date.getUTCFullYear() === parseInt(year) &&
+         date.getUTCMonth() + 1 === parseInt(month) &&
+         date.getUTCDate() === parseInt(day);
+}
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!lines || !Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  const customer = getCustomer(customerId);
+  if (!customer.ok) return customer;
+
+  const invoiceLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    const product = getProduct(line.sku);
+    if (!product.ok) return product;
+
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.value.name,
+      qty: line.qty,
+      unitPrice: product.value.unitPrice,
+      vatRate: product.value.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
