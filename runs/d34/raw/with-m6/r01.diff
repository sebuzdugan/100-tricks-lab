@@ -0,0 +1,137 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice returns a draft invoice with product details', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[0].qty, 2);
+  assert.equal(r.value.lines[0].unitPrice, 8500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[1].name, 'Development (hour)');
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for missing issueDate', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports DATE_INVALID for bad date format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026/10/07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports DATE_INVALID for non-existent date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports NO_LINES for missing lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: undefined,
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for zero quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for negative quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: -1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports UNKNOWN_SKU for invalid SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PRD-999', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  };
+  const inputCopy = JSON.parse(JSON.stringify(input));
+  createInvoice(input);
+  assert.deepEqual(input, inputCopy);
+});
