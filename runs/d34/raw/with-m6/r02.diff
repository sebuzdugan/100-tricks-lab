+  assert.equal(lineTotal(line), 8500);
+});
+
+test('invoiceTotals sums all line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500 },
+      { qty: 1, unitPrice: 9500 },
+      { qty: 3, unitPrice: 6000 },
+    ],
+  };
