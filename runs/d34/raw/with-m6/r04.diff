diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..8eb2792
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for the same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0099', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0099', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2027-01-15');
+  assert.equal(num, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber handles unsorted input', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2026-000${i + 1}`);
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber handles high counters', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber ignores invalid formats', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-XXXX', 'INV-INVALID', 'not-a-number'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0002');
+});
