new file mode 100644
index 0000000..163b315
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,19 @@
+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded.
+ * @param {string[]} existingNumbers - Array of existing invoice numbers
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} The next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const yearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length)))
+    .filter((n) => !isNaN(n));
+
+  const nextCounter = Math.max(0, ...yearNumbers) + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
