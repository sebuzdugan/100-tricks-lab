+++ b/test/render.test.js
@@ -0,0 +1,130 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for an invoice without a number', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(inv.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows the invoice number if present', () => {
+  const inv = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(inv);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0001');
+});
+
+test('renderInvoiceText shows the customer name', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(inv.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText renders one line item', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const text = renderInvoiceText(inv.value);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '2 × Design work (hour) @ €85.00 = €170.00');
+});
+
+test('renderInvoiceText renders multiple line items', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  const text = renderInvoiceText(inv.value);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '2 × Design work (hour) @ €85.00 = €170.00');
+  assert.equal(lines[3], '3 × Development (hour) @ €95.00 = €285.00');
+});
+
+test('renderInvoiceText shows the total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const text = renderInvoiceText(inv.value);
+  const lines = text.split('\n');
+  assert.equal(lines[3], 'Total: €170.00');
+});
+
+test('renderInvoiceText formats large amounts with thousands separator', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  });
+  const text = renderInvoiceText(inv.value);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '2 × Logo package @ €1,200.00 = €2,400.00');
+  assert.equal(lines[3], 'Total: €2,400.00');
+});
+
+test('renderInvoiceText calculates totals correctly for multiple lines', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 2 },
+    ],
+  });
+  const text = renderInvoiceText(inv.value);
+  const lines = text.split('\n');
+  // 1 × 8500 = 8500, 2 × 9500 = 19000, total = 27500
+  assert.equal(lines[4], 'Total: €275.00');
+});
+
+test('renderInvoiceText shows unknown customer if lookup fails', () => {
+  const inv = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(inv);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Unknown Customer');
+});
+
+test('renderInvoiceText includes all required sections in order', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(inv.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert(lines[2].includes('Design work (hour)'));
+  assert(lines[3].startsWith('Total:'));
+});
