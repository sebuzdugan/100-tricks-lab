+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const line1Total = 17000;
+  const line1Discount = 1700;
+  const line1Vat = Math.round((line1Total - line1Discount) * 21 / 100 * 1e6) / 1e6;
+  const line2Vat = Math.round(10000 * 9 / 100 * 1e6) / 1e6;
+  assert.equal(totals.subtotal, 27000);
