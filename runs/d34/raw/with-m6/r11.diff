@@ -0,0 +1,219 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('balanceDue returns total when no payments', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const balance = balanceDue(issued.value);
+  assert.equal(balance, 19542);
+});
+
+test('balanceDue returns 0 when fully paid', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const paid = recordPayment(issued.value, { amount: 19542, date: '2026-10-08' });
+  const balance = balanceDue(paid.value);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue returns remaining after partial payment', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const paid = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  const balance = balanceDue(paid.value);
+  assert.equal(balance, 9542);
+});
+
+test('recordPayment adds payment to issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 10000);
+  assert.equal(r.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = recordPayment(issued.value, { amount: 19542, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment sets status to partially_paid when amount owed remains', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment allows subsequent payments on partially_paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const first = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  const second = recordPayment(first.value, { amount: 9542, date: '2026-10-09' });
+  assert.equal(second.ok, true);
+  assert.equal(second.value.payments.length, 2);
+  assert.equal(second.value.status, 'paid');
+});
+
+test('recordPayment reports NOT_ISSUED for draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const r = recordPayment(inv.value, { amount: 10000, date: '2026-10-08' });
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment reports NOT_ISSUED for paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const paid = recordPayment(issued.value, { amount: 19542, date: '2026-10-08' });
+  const r = recordPayment(paid.value, { amount: 1000, date: '2026-10-09' });
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment reports AMOUNT_INVALID for non-positive amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r1 = recordPayment(issued.value, { amount: 0, date: '2026-10-08' });
+  const r2 = recordPayment(issued.value, { amount: -1000, date: '2026-10-08' });
+  assert.deepEqual(r1, { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(r2, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment reports AMOUNT_INVALID for non-integer amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = recordPayment(issued.value, { amount: 1000.5, date: '2026-10-08' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment reports DATE_INVALID for invalid date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = recordPayment(issued.value, { amount: 10000, date: '2026/10/08' });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('recordPayment reports OVERPAYMENT if payment exceeds balance', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = recordPayment(issued.value, { amount: 20000, date: '2026-10-08' });
+  assert.deepEqual(r, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment reports OVERPAYMENT if payment exceeds remaining balance', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const first = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  const r = recordPayment(first.value, { amount: 10000, date: '2026-10-09' });
+  assert.deepEqual(r, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate input invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const invCopy = JSON.parse(JSON.stringify(issued.value));
+  recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.deepEqual(issued.value, invCopy);
+});
+
+test('recordPayment preserves invoice metadata', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.number, issued.value.number);
+});
+
+test('recordPayment handles multiple incremental payments', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  let invoice = issued.value;
+
+  const p1 = recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+  assert.equal(p1.ok, true);
+  invoice = p1.value;
+
+  const p2 = recordPayment(invoice, { amount: 5000, date: '2026-10-09' });
+  assert.equal(p2.ok, true);
+  invoice = p2.value;
+
+  const p3 = recordPayment(invoice, { amount: 9542, date: '2026-10-10' });
+  assert.equal(p3.ok, true);
+  assert.equal(p3.value.status, 'paid');
+  assert.equal(p3.value.payments.length, 3);
+});
