--- /dev/null
+++ b/src/payments.js
@@ -0,0 +1,64 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @param {number} total - the invoice total
+ * @returns {number} amount still owed in cents
+ */
+function calculateBalanceDue(invoice, total) {
+  const paid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return total - paid;
+}
+
+/**
+ * Get the balance due on an invoice.
+ * @param {{ payments?: Array<{ amount: number }>, lines: Array }} invoice
+ * @returns {number} amount still owed in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  return calculateBalanceDue(invoice, totals.total);
+}
+
+/**
+ * Record a payment on an issued invoice.
+ * @param {{ status: string, customerId: string, issueDate: string, number: string, lines: Array, payments?: Array }} invoice
+ * @param {{ amount: number, date: string }} payment - amount in cents, date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  const currentBalance = calculateBalanceDue(invoice, totals.total);
+
+  if (amount > currentBalance) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = [...(invoice.payments ?? []), { amount, date }];
+  const newBalance = currentBalance - amount;
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    number: invoice.number,
+    status: newStatus,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments: newPayments,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
