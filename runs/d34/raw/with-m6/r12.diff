+/**
+ * Validate payment terms.
+ * @param {string} terms
+ * @returns {boolean}
+ */
+function isValidTerms(terms) {
+  return terms === 'NET14' || terms === 'NET30' || terms === 'EOM';
+}
+
+/**
+ * Calculate the due date based on issue date and terms.
+ * @param {string} issueDate - in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-');
+    const nextMonth = parseInt(month) === 12 ? '01' : String(parseInt(month) + 1).padStart(2, '0');
+    const nextYear = parseInt(month) === 12 ? String(parseInt(year) + 1) : year;
+    const firstOfNextMonth = `${nextYear}-${nextMonth}-01`;
+    return addDays(firstOfNextMonth, -1);
+  }
+}
