+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array, terms?: string, dueDate?: string, voucher?: object }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    ...(invoice.terms && { terms: invoice.terms }),
+    ...(invoice.dueDate && { dueDate: invoice.dueDate }),
+    voucher: { code, amount },
+  });
+}
