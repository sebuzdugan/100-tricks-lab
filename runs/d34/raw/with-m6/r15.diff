@@ -0,0 +1,230 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote returns ok with correct structure', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(typeof r.value.number, 'string');
+  assert.equal(r.value.invoiceNumber, issued.value.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Discount');
+  assert.equal(r.value.date, '2026-10-08');
+});
+
+test('createCreditNote assigns number with CN prefix', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = createCreditNote(issued.value, { amount: 2000, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote increments counter for multiple notes in same year', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+  const cn1 = createCreditNote(issued1.value, { amount: 2000, reason: 'First', date: '2026-10-08' }, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']);
+  const cn2 = createCreditNote(issued2.value, { amount: 3000, reason: 'Second', date: '2026-10-09' }, [cn1.value.number]);
+  assert.equal(cn2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote uses separate counter from invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = createCreditNote(issued.value, { amount: 2000, reason: 'Test', date: '2026-10-07' }, [
+    'INV-2026-0001',
+    'INV-2026-0002',
+    'INV-2026-0003',
+  ]);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoices with NOT_ISSUED', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r = createCreditNote(inv.value, { amount: 2000, reason: 'Test', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote accepts issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = createCreditNote(issued.value, { amount: 2000, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote accepts partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const partial = recordPayment(issued.value, { amount: 5000, date: '2026-10-08' });
+  const r = createCreditNote(partial.value, { amount: 2000, reason: 'Test', date: '2026-10-09' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote accepts paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const paid = recordPayment(issued.value, { amount: 19542, date: '2026-10-08' });
+  const r = createCreditNote(paid.value, { amount: 2000, reason: 'Refund', date: '2026-10-09' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote rejects invalid amount with AMOUNT_INVALID', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = createCreditNote(issued.value, { amount: 0, reason: 'Test', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount with AMOUNT_INVALID', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = createCreditNote(issued.value, { amount: -1000, reason: 'Test', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects non-integer amount with AMOUNT_INVALID', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = createCreditNote(issued.value, { amount: 2000.5, reason: 'Test', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects invalid date with DATE_INVALID', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = createCreditNote(issued.value, { amount: 2000, reason: 'Test', date: '2026-13-01' }, []);
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote rejects amount exceeding invoice total with CREDIT_TOO_HIGH', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r = createCreditNote(issued.value, { amount: totals.total + 1, reason: 'Test', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote accepts amount equal to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r = createCreditNote(issued.value, { amount: totals.total, reason: 'Full', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, totals.total);
+});
+
+test('createCreditNote handles numbers across different years', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+  const cn1 = createCreditNote(issued1.value, { amount: 2000, reason: 'First', date: '2025-12-08' }, []);
+  assert.equal(cn1.value.number, 'CN-2025-0001');
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued2 = issueInvoice(inv2.value, []);
+  const cn2 = createCreditNote(issued2.value, { amount: 2000, reason: 'Second', date: '2026-10-08' }, [cn1.value.number]);
+  assert.equal(cn2.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = createCreditNote(issued.value, { amount: 2000, reason: 'Test', date: '2026-10-08' }, [
+    'INV-2026-0001',
+    'CN-2026-0001',
+    'INV-2026-0002',
+    'CN-2026-0002',
+  ]);
+  assert.equal(r.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote preserves all invoice references correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  });
+  const issued = issueInvoice(inv.value, ['INV-2026-0001']);
+  const r = createCreditNote(issued.value, { amount: 5000, reason: 'Adjustment', date: '2026-10-15' }, []);
+  assert.equal(r.value.invoiceNumber, issued.value.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.date, '2026-10-15');
+});
