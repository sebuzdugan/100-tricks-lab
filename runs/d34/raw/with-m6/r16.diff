+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array for empty invoices', () => {
+  const r = overdueInvoices([], '2026-10-31');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const r = overdueInvoices([inv.value], '2026-10-31');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const paid = recordPayment(issued.value, { amount: 19542, date: '2026-10-02' });
+  const r = overdueInvoices([paid.value], '2026-10-31');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices excludes invoices with future due dates', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = overdueInvoices([issued.value], '2026-11-02');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices includes issued invoices that are overdue', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = overdueInvoices([issued.value], '2026-10-20');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].number, issued.value.number);
+});
+
+test('overdueInvoices includes partially_paid invoices that are overdue', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const partial = recordPayment(issued.value, { amount: 5000, date: '2026-10-02' });
+  const r = overdueInvoices([partial.value], '2026-10-20');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].number, partial.value.number);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = overdueInvoices([issued.value], '2026-10-20');
+  assert.equal(r[0].daysOverdue, 5);
+});
+
+test('overdueInvoices includes all required fields', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = overdueInvoices([issued.value], '2026-10-20');
+  const invoice = r[0];
+  assert.equal(typeof invoice.number, 'string');
+  assert.equal(invoice.customerId, 'C-001');
+  assert.equal(invoice.dueDate, '2026-10-15');
+  assert.equal(typeof invoice.daysOverdue, 'number');
+  assert.equal(typeof invoice.due, 'number');
+});
+
+test('overdueInvoices calculates due amount correctly for issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = overdueInvoices([issued.value], '2026-10-20');
+  assert.equal(r[0].due, 19542);
+});
+
+test('overdueInvoices calculates due amount correctly for partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const partial = recordPayment(issued.value, { amount: 5000, date: '2026-10-02' });
+  const r = overdueInvoices([partial.value], '2026-10-20');
+  assert.equal(r[0].due, 14542);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']);
+
+  const r = overdueInvoices([issued1.value, issued2.value], '2026-10-20');
+  assert.equal(r.length, 2);
+  assert.equal(r[0].daysOverdue, 5);
+  assert.equal(r[1].daysOverdue, 1);
+});
+
+test('overdueInvoices handles multiple overdue invoices from different customers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']);
+
+  const r = overdueInvoices([issued1.value, issued2.value], '2026-10-20');
+  assert.equal(r.length, 2);
+  assert.equal(r[0].customerId, 'C-001');
+  assert.equal(r[1].customerId, 'C-002');
+});
+
+test('overdueInvoices excludes invoices with no dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  delete issued.value.dueDate;
+  const r = overdueInvoices([issued.value], '2026-10-20');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices handles edge case where dueDate equals asOf', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = overdueInvoices([issued.value], '2026-10-15');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices handles EOM terms', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = overdueInvoices([issued.value], '2026-11-01');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].dueDate, '2026-10-31');
+  assert.equal(r[0].daysOverdue, 1);
+});
+
+test('overdueInvoices with NET30 terms', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const r = overdueInvoices([issued.value], '2026-11-05');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].dueDate, '2026-10-31');
+  assert.equal(r[0].daysOverdue, 5);
+});
+
+test('overdueInvoices does not mutate input array', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+  const invoices = [issued.value];
+  const original = JSON.stringify(invoices);
+  overdueInvoices(invoices, '2026-10-20');
+  assert.equal(JSON.stringify(invoices), original);
+});
