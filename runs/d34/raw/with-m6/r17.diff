+/**
+ * Get a summary of VAT by rate across invoices.
+ * @param {Array} invoices - all invoices to summarize
+ * @returns {Array} VAT summary entries sorted by rate high to low
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  for (const inv of invoices) {
+    if (inv.status !== 'issued' && inv.status !== 'partially_paid' && inv.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of inv.lines) {
+      const rate = line.vatRate ?? 0;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVat(line);
+
+      if (!vatMap[rate]) {
+        vatMap[rate] = { rate, base: 0, vat: 0 };
+      }
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vat;
+    }
+  }
+
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
