+
+/**
+ * Calculate late fee for an overdue invoice.
+ * Late fee is 0.04% of amount due per day overdue.
+ * @param {{ status: string, dueDate?: string }} invoice
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {number} late fee in cents, 0 if not overdue or paid
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.status === 'paid' || !invoice.dueDate) {
+    return 0;
+  }
+
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = due * daysOverdue * 0.0004;
+  return Math.round(fee);
+}
