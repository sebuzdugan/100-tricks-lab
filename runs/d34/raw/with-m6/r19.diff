+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros with 2 decimal places.
+ * @param {number} cents
+ * @returns {string} formatted as "1234.50"
+ */
+function formatEuro(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Quote a CSV field if it contains comma, double quote, or newline.
+ * @param {string} value
+ * @returns {string} quoted if necessary
+ */
+function quoteCsvField(value) {
+  const str = String(value ?? '');
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices - invoices to export
+ * @returns {string} CSV formatted string with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const lines = ['number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'];
+
+  for (const inv of invoices) {
+    const customer = getCustomer(inv.customerId);
+    const customerName = customer.ok ? customer.value.name : '';
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const row = [
+      quoteCsvField(inv.number || 'DRAFT'),
+      quoteCsvField(customerName),
+      quoteCsvField(inv.issueDate),
+      quoteCsvField(inv.dueDate || ''),
+      quoteCsvField(inv.status),
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ];
+
+    lines.push(row.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
