diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..030dc1b
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,62 @@
+import { roundCents } from './money.js';
+
+/**
+ * Validate that a discount percent is between 0 and 100.
+ * @param {number} discountPercent
+ * @returns {boolean}
+ */
+export function isValidDiscount(discountPercent) {
+  return typeof discountPercent === 'number' && discountPercent >= 0 && discountPercent <= 100;
+}
+
+/**
+ * Calculate the total for a single line.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number} total in cents
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount for a single line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} discount in cents
+ */
+export function lineDiscount(line) {
+  if (!line.discountPercent) return 0;
+  return Math.max(0, lineTotal(line) * line.discountPercent / 100);
+}
+
+/**
+ * Calculate the VAT for a single line: VAT is on the amount after discount, rounded per line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }} line
+ * @returns {number} VAT in cents
+ */
+export function lineVat(line) {
+  const vatRate = line.vatRate ?? 0;
+  if (vatRate === 0) return 0;
+  const amountAfterDiscount = lineTotal(line) - lineDiscount(line);
+  const vat = amountAfterDiscount * vatRate / 100;
+  return Math.max(0, roundCents(vat));
+}
+
+/**
+ * Calculate the totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = subtotal - discount + vat - voucher;
+  return {
+    subtotal: Math.max(0, subtotal),
+    discount: Math.max(0, discount),
+    vat: Math.max(0, vat),
+    voucher: Math.max(0, voucher),
+    total: Math.max(0, total),
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..cdc3543
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,238 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDiscount, lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('isValidDiscount accepts valid discounts', () => {
+  assert.equal(isValidDiscount(0), true);
+  assert.equal(isValidDiscount(50), true);
+  assert.equal(isValidDiscount(100), true);
+  assert.equal(isValidDiscount(2.5), true);
+});
+
+test('isValidDiscount rejects invalid discounts', () => {
+  assert.equal(isValidDiscount(-1), false);
+  assert.equal(isValidDiscount(101), false);
+  assert.equal(isValidDiscount('50'), false);
+  assert.equal(isValidDiscount(null), false);
+});
+
+test('lineTotal returns qty times unitPrice', () => {
+  const line = { qty: 3, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 3000);
+});
+
+test('lineTotal handles large quantities', () => {
+  const line = { qty: 100, unitPrice: 10000 };
+  assert.equal(lineTotal(line), 1000000);
+});
+
+test('lineTotal handles single unit', () => {
+  const line = { qty: 1, unitPrice: 500 };
+  assert.equal(lineTotal(line), 500);
+});
+
+test('lineDiscount returns 0 when no discount', () => {
+  const line = { qty: 1, unitPrice: 1000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount calculates correct discount', () => {
+  const line = { qty: 2, unitPrice: 1000, discountPercent: 10 };
+  const expected = 2000 * 0.1;
+  assert.equal(lineDiscount(line), expected);
+});
+
+test('lineDiscount handles percentage discount', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 5 };
+  assert.equal(lineDiscount(line), 500);
+});
+
+test('lineDiscount never returns negative', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 0 };
+  assert.equal(lineDiscount(line) >= 0, true);
+});
+
+test('lineVat returns 0 when no VAT', () => {
+  const line = { qty: 1, unitPrice: 1000, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat returns 0 when no vatRate specified', () => {
+  const line = { qty: 1, unitPrice: 1000 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 10000, unitPrice: 100, discountPercent: 10, vatRate: 21 };
+  const total = 10000 * 100;
+  const afterDiscount = total * 0.9;
+  const vat = afterDiscount * 0.21;
+  assert.equal(lineVat(line), Math.round(vat));
+});
+
+test('lineVat rounds to whole cents', () => {
+  const line = { qty: 1, unitPrice: 1234, vatRate: 21 };
+  const result = lineVat(line);
+  assert.equal(Number.isInteger(result), true);
+});
+
+test('lineVat handles 21% VAT', () => {
+  const line = { qty: 100, unitPrice: 10000, vatRate: 21 };
+  const result = lineVat(line);
+  assert(result > 0);
+});
+
+test('lineVat handles 9% VAT', () => {
+  const line = { qty: 100, unitPrice: 10000, vatRate: 9 };
+  const result = lineVat(line);
+  assert(result > 0);
+});
+
+test('invoiceTotals returns all fields', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.subtotal !== undefined);
+  assert(totals.discount !== undefined);
+  assert(totals.vat !== undefined);
+  assert(totals.voucher !== undefined);
+  assert(totals.total !== undefined);
+});
+
+test('invoiceTotals calculates subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+      { qty: 3, unitPrice: 500, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 3500);
+});
+
+test('invoiceTotals calculates total discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1000, unitPrice: 100, discountPercent: 10, vatRate: 0 },
+      { qty: 1000, unitPrice: 100, discountPercent: 5, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 10000 + 5000);
+});
+
+test('invoiceTotals calculates total VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.vat > 0);
+});
+
+test('invoiceTotals calculates total correctly', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 10000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = totals.subtotal - totals.discount + totals.vat;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals includes voucher in calculation', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'TEST', amount: 50000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 50000);
+  assert.equal(totals.total, 1000000 - 50000);
+});
+
+test('invoiceTotals returns zero voucher when none', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals never returns negative totals', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.subtotal >= 0);
+  assert(totals.discount >= 0);
+  assert(totals.vat >= 0);
+  assert(totals.voucher >= 0);
+  assert(totals.total >= 0);
+});
+
+test('invoiceTotals formula is correct', () => {
+  const invoice = {
+    lines: [
+      { qty: 50, unitPrice: 20000, discountPercent: 5, vatRate: 21 },
+      { qty: 10, unitPrice: 10000, discountPercent: 2.5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = totals.subtotal - totals.discount + totals.vat;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals with multiple lines and voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+      { qty: 50, unitPrice: 5000, discountPercent: 10, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 100000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 1000000 + 250000);
+  assert.equal(totals.discount, 0 + 25000);
+  assert(totals.vat > 0);
+  assert.equal(totals.voucher, 100000);
+  const expected = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals empty lines returns zeros', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('lineVat + lineDiscount + lineTotal match invoiceTotals', () => {
+  const line = { qty: 75, unitPrice: 15000, discountPercent: 7, vatRate: 21 };
+  const invoice = { lines: [line] };
+  const totals = invoiceTotals(invoice);
+  const lineT = lineTotal(line);
+  const lineD = lineDiscount(line);
+  const lineV = lineVat(line);
+  assert.equal(totals.subtotal, lineT);
+  assert.equal(totals.discount, lineD);
+  assert.equal(totals.vat, lineV);
+  assert.equal(totals.total, lineT - lineD + lineV);
+});
+
+test('invoiceTotals works with real invoice from createInvoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+  assert(totals.subtotal > 0);
+  assert(totals.vat > 0);
+  assert(totals.total > 0);
+});
