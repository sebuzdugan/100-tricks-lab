--- a/src/totals.js
+++ b/src/totals.js
@@ -20,12 +20,21 @@ export function lineTotal(line) {
 
 /**
  * Calculate the discount for a single line.
+ * Regular discount is applied first, then bulk discount (2.5% for 10+ units) on the remainder.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
- * @returns {number} discount in cents
+ * @returns {number} discount in cents (regular + bulk)
  */
 export function lineDiscount(line) {
-  if (!line.discountPercent) return 0;
-  return Math.max(0, lineTotal(line) * line.discountPercent / 100);
+  const lineT = lineTotal(line);
+  const regularDiscount = line.discountPercent ? lineT * line.discountPercent / 100 : 0;
+
+  let bulkDiscountAmount = 0;
+  if (line.qty >= 10) {
+    const amountAfterRegular = lineT - regularDiscount;
+    bulkDiscountAmount = roundCents(amountAfterRegular * 0.025);
+  }
+
+  return Math.max(0, regularDiscount + bulkDiscountAmount);
 }
 
