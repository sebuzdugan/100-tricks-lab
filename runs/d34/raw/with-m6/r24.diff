 }
+
+/**
+ * Get a dashboard summary of invoice metrics.
+ * @param {Array} invoices - all invoices
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {{ counts: object, outstanding: number, overdue: object, topCustomers: Array }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDues = {};
+
+  for (const inv of invoices) {
+    counts[inv.status] = (counts[inv.status] || 0) + 1;
+
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const due = balanceDue(inv);
+      outstanding += due;
+
+      if (due > 0) {
+        customerDues[inv.customerId] = (customerDues[inv.customerId] || 0) + due;
+      }
+    }
+  }
+
+  const overdue_ = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_.length,
+    amount: overdue_.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const topCustomers = Object.entries(customerDues)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
