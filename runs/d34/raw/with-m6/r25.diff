+  const text = renderInvoiceText(withVoucher.value);
+  const lines = text.split('\n');
+  const voucherLine = lines.findIndex((l) => l.startsWith('Voucher:'));
+  const totalLine = lines.findIndex((l) => l.startsWith('Total:'));
+  assert(voucherLine >= 0);
+  assert(totalLine > voucherLine);
