diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..12b4ade
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,61 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a draft invoice for a customer with line items.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {import('./result.js').ok<{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }> | import('./result.js').fail}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  const invoiceLines = [];
+  for (const line of lines) {
+    if (typeof line.qty !== 'number' || !Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku: product.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
+
+/**
+ * Check if a date string is valid in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+  const match = /^\d{4}-\d{2}-\d{2}$/.exec(dateStr);
+  if (!match) return false;
+
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const isValid = date instanceof Date && !Number.isNaN(date.getTime());
+  if (!isValid) return false;
+
+  const [year, month, day] = dateStr.split('-').map(Number);
+  return date.getUTCFullYear() === year && date.getUTCMonth() + 1 === month && date.getUTCDate() === day;
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..032e864
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,147 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with valid inputs', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.lines.length, 1);
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 10,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice handles multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-05',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[1].name, 'Logo package');
+  assert.equal(result.value.lines[2].name, 'Sticker sheet');
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for invalid date format', () => {
+  const invalidDates = ['2026-10-7', '26-10-07', '2026/10/07', '2026-13-01', '2026-02-30', 'not-a-date', '', null, undefined, 2026];
+  for (const date of invalidDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, false, `Expected failure for date: ${JSON.stringify(date)}`);
+    assert.equal(result.error, 'DATE_INVALID', `Wrong error for date: ${JSON.stringify(date)}`);
+  }
+});
+
+test('createInvoice accepts valid dates', () => {
+  const validDates = ['2026-01-01', '2026-12-31', '2000-02-29', '1900-01-01'];
+  for (const date of validDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, true, `Expected success for date: ${date}`);
+  }
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports NO_LINES when lines is not an array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer quantities', () => {
+  const invalidQtys = [0, -5, 1.5, 'abc', null, undefined, -0];
+  for (const qty of invalidQtys) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    });
+    assert.equal(result.ok, false, `Expected failure for qty: ${JSON.stringify(qty)}`);
+    assert.equal(result.error, 'QTY_INVALID', `Wrong error for qty: ${JSON.stringify(qty)}`);
+  }
+});
+
+test('createInvoice accepts positive integer quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }, { sku: 'DEV-HOUR', qty: 999 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].qty, 1);
+  assert.equal(result.value.lines[1].qty, 999);
+});
+
+test('createInvoice reports UNKNOWN_SKU for products not in catalogue', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input lines', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const original = JSON.parse(JSON.stringify(lines));
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+  assert.deepEqual(lines, original);
+});
+
+test('createInvoice products include products with zero VAT rate', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 0);
+  assert.equal(result.value.lines[0].unitPrice, 60000);
+});
