+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 10, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 85000);
+});
+
+test('lineTotal handles zero and large quantities', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 1000 }), 0);
+  assert.equal(lineTotal({ qty: 999, unitPrice: 10000 }), 9990000);
+});
+
+test('lineTotal handles fractional cent calculations (all cents are integers anyway)', () => {
+  const line = { qty: 3, unitPrice: 100 };
+  assert.equal(lineTotal(line), 300);
+});
+
+test('invoiceTotals calculates subtotal from multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500 },
+      { qty: 5, unitPrice: 9500 },
+      { qty: 1, unitPrice: 120000 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000 + 47500 + 120000);
+  assert.equal(totals.total, 252500);
