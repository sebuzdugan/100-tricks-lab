@@ -0,0 +1,19 @@
+/**
+ * Generate the next invoice number for a given issue date.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded, restarting each year.
+ * @param {string[]} existingNumbers - array of invoice numbers already used (in any order)
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const numbersThisYear = existingNumbers.filter((num) => num.startsWith(prefix));
+  const counters = numbersThisYear.map((num) => Number(num.slice(prefix.length)));
+
+  const maxCounter = counters.length === 0 ? 0 : Math.max(...counters);
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
