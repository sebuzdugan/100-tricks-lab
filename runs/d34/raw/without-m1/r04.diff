+++ b/test/numbering.test.js
@@ -0,0 +1,63 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates INV-YYYY-0001 for the first invoice of a year', () => {
+  const number = nextInvoiceNumber([], '2026-01-15');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2026-06-20');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber restarts counter for different years', () => {
+  const existing = ['INV-2025-9999', 'INV-2025-9998'];
+  const number = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0050', 'INV-2026-0010', 'INV-2027-0100'];
+  const number = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(number, 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = ['INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2026-03-15');
+  assert.equal(number, 'INV-2026-0002');
+
+  const existing2 = ['INV-2026-0099'];
+  const number2 = nextInvoiceNumber(existing2, '2026-03-15');
+  assert.equal(number2, 'INV-2026-0100');
+
+  const existing3 = ['INV-2026-0999'];
+  const number3 = nextInvoiceNumber(existing3, '2026-03-15');
+  assert.equal(number3, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber works at year boundaries', () => {
+  const existing2025 = ['INV-2025-9998', 'INV-2025-9999'];
+  const jan2026 = nextInvoiceNumber(existing2025, '2026-01-01');
+  assert.equal(jan2026, 'INV-2026-0001');
+
+  const existing2026 = ['INV-2026-0001'];
+  const dec2026 = nextInvoiceNumber(existing2026, '2026-12-31');
+  assert.equal(dec2026, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber does not mutate existingNumbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const original = JSON.parse(JSON.stringify(existing));
+  nextInvoiceNumber(existing, '2026-06-15');
+  assert.deepEqual(existing, original);
+});
