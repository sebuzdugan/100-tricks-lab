+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) throw new Error('Customer not found');
+
+  const customer = customerResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const lines = [];
+
+  lines.push(invoice.number ?? 'DRAFT');
+  lines.push(customer.name);
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const qtyStr = String(line.qty);
+    const nameStr = line.name;
+    const unitPriceStr = formatEuros(line.unitPrice);
+    const totalStr = formatEuros(total);
+    lines.push(`${qtyStr} × ${nameStr} @ ${unitPriceStr} = ${totalStr}`);
+  }
+
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..fbc8c24
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,185 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for unsigned invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+
+  const issueResult = issueInvoice(result.value, []);
+  assert.equal(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText shows line items with qty, name, unit price and total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  assert.equal(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /^10 × Design work \(hour\) @ €85\.00 = €850\.00$/);
+  assert.match(lines[3], /^5 × Development \(hour\) @ €95\.00 = €475\.00$/);
+});
+
+test('renderInvoiceText formats amounts with formatEuros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /€1,200\.00/);
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  assert.equal(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  const lastLine = lines[lines.length - 1];
+
+  assert.match(lastLine, /^Total: €1,325\.00$/);
+});
+
+test('renderInvoiceText has correct structure', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  assert.equal(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 5);
+  assert.match(lines[0], /^DRAFT$/);
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /^2 × Design work/);
+  assert.match(lines[3], /^100 × Sticker sheet/);
+  assert.match(lines[4], /^Total:/);
+});
+
+test('renderInvoiceText handles products with 0% VAT', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /€600\.00/);
+  assert.match(text, /Total: €600\.00/);
+});
+
+test('renderInvoiceText renders single line invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 3 }],
+  });
+  assert.equal(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert.match(lines[0], /^DRAFT$/);
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.match(lines[2], /^3 × Icon set/);
+  assert.match(lines[3], /^Total: €29\.40$/);
+});
+
+test('renderInvoiceText shows all line details correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 1 },
+      { sku: 'PRINT-A4', qty: 50 },
+    ],
+  });
+  assert.equal(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /1 × Brand guidelines document @ €2,450\.00 = €2,450\.00/);
+  assert.match(text, /50 × Printed flyer A4 \(each\) @ €0\.37 = €18\.50/);
+});
+
+test('renderInvoiceText with issued invoice shows complete details', () => {
+  const createResult = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-11-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'SUPPORT-HOUR', qty: 4 },
+    ],
+  });
+  assert.equal(createResult.ok, true);
+
+  const issueResult = issueInvoice(createResult.value, ['INV-2026-0001']);
+  assert.equal(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0002');
+  assert.equal(lines[1], 'Orchard Health');
+  assert.match(lines[2], /8 × Development/);
+  assert.match(lines[3], /4 × Support/);
+  assert.match(lines[4], /^Total:/);
+});
