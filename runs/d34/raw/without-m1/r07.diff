+});
+
+test('invoiceTotals correctly calculates with tier discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  assert.equal(result.ok, true);
+
+  const totals = invoiceTotals(result.value);
+  const expectedSubtotal = 10 * 8500 + 5 * 9500; // 132500
+  const expectedDiscount = (expectedSubtotal * 5) / 100; // 6625
+  const expectedTotal = expectedSubtotal - expectedDiscount; // 125875
+
+  assert.equal(totals.subtotal, expectedSubtotal);
+  assert.equal(totals.discount, expectedDiscount);
+  assert.equal(totals.total, expectedTotal);
+});
