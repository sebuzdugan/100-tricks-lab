diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..cde0528
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,132 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates in YYYY-MM-DD format', () => {
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-01-01'), true);
+});
+
+test('isValidDate rejects invalid date formats', () => {
+  assert.equal(isValidDate('2026-1-1'), false);
+  assert.equal(isValidDate('26-01-01'), false);
+  assert.equal(isValidDate('2026/01/01'), false);
+  assert.equal(isValidDate('01-01-2026'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects invalid calendar dates', () => {
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate rejects non-string inputs', () => {
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(20260101), false);
+  assert.equal(isValidDate(['2026-01-01']), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2021-02-29'), false);
+  assert.equal(isValidDate('2022-02-29'), false);
+  assert.equal(isValidDate('2100-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-01-01', 1), '2026-01-02');
+  assert.equal(addDays('2026-01-01', 10), '2026-01-11');
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-01-02', -1), '2026-01-01');
+  assert.equal(addDays('2026-02-01', -1), '2026-01-31');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2026-01-01', 0), '2026-01-01');
+});
+
+test('addDays handles large day counts', () => {
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01');
+});
+
+test('daysBetween calculates positive differences', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+  assert.equal(daysBetween('2026-01-01', '2026-01-11'), 10);
+  assert.equal(daysBetween('2026-01-01', '2026-02-01'), 31);
+});
+
+test('daysBetween calculates negative differences', () => {
+  assert.equal(daysBetween('2026-01-02', '2026-01-01'), -1);
+  assert.equal(daysBetween('2026-01-11', '2026-01-01'), -10);
+});
+
+test('daysBetween returns zero for same date', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-01'), 0);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1);
+});
+
+test('daysBetween with large date ranges', () => {
+  assert.equal(daysBetween('2000-01-01', '2000-12-31'), 365);
+  assert.equal(daysBetween('2000-01-01', '2001-01-01'), 366);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const date = '2026-01-15';
+  const n = 25;
+  const newDate = addDays(date, n);
+  assert.equal(daysBetween(date, newDate), n);
+
+  const negDate = addDays(date, -10);
+  assert.equal(daysBetween(negDate, date), 10);
+});
+
+test('dates work in UTC regardless of local timezone', () => {
+  // These tests verify that dates are handled in UTC
+  assert.equal(isValidDate('2026-01-01'), true);
+  const result = addDays('2026-01-01', 1);
+  assert.equal(result, '2026-01-02');
+  const diff = daysBetween('2026-01-01', '2026-01-02');
+  assert.equal(diff, 1);
+});
+
+test('daysBetween with various date combinations', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-12-31'), 364);
+  assert.equal(daysBetween('2000-01-01', '2026-01-01'), 9497);
+  assert.equal(daysBetween('2026-06-15', '2026-06-15'), 0);
+});
