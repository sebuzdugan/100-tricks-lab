+/**
+ * Check if a date string is valid in YYYY-MM-DD format.
+ * All dates are treated as UTC dates.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+  const match = /^\d{4}-\d{2}-\d{2}$/.exec(dateStr);
+  if (!match) return false;
+
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const isValid = date instanceof Date && !Number.isNaN(date.getTime());
+  if (!isValid) return false;
+
+  const [year, month, day] = dateStr.split('-').map(Number);
+  return date.getUTCFullYear() === year && date.getUTCMonth() + 1 === month && date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date string (in UTC).
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - New date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  const year = d.getUTCFullYear();
+  const month = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate the number of days between two dates (b - a, in whole days, in UTC).
+ * @param {string} a - Date in YYYY-MM-DD format
+ * @param {string} b - Date in YYYY-MM-DD format
+ * @returns {number} - Number of days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  const diffDays = diffMs / (1000 * 60 * 60 * 24);
+  return Math.round(diffDays);
+}
