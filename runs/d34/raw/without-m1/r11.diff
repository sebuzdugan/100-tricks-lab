+
+  const payment2 = recordPayment(payment1.value, { amount: 30000, date: '2026-10-15' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.status, 'partially_paid');
+});
+
+test('recordPayment reports AMOUNT_INVALID for non-positive amounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
