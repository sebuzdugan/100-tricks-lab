+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {import('./result.js').ok | import('./result.js').fail}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (typeof amount !== 'number' || !Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  const currentPayments = invoice.payments ?? [];
+  const currentPaidAmount = currentPayments.reduce((sum, p) => sum + p.amount, 0);
+  const stillOwed = totals.total - currentPaidAmount;
+
+  if (amount > stillOwed) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = [...currentPayments, { amount, date }];
+  const totalPaid = currentPaidAmount + amount;
+  const newStatus = totalPaid >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {number} - Amount in cents still owed
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const currentPayments = invoice.payments ?? [];
+  const paidAmount = currentPayments.reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - paidAmount);
+}
