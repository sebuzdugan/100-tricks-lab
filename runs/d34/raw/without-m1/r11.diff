+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  let invoice = issuedResult.value;
+
+  const totals = invoiceTotals(invoice);
+
+  const payment1 = recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.equal(payment1.ok, true);
+  assert.equal(balanceDue(payment1.value), totals.total - 50000);
+
+  const payment2 = recordPayment(payment1.value, { amount: 30000, date: '2026-10-15' });
+  assert.equal(payment2.ok, true);
+  assert.equal(balanceDue(payment2.value), totals.total - 80000);
