+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('recordPayment adds a payment to an issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  const invoice = issuedResult.value;
+
+  const paymentResult = recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.payments.length, 1);
+  assert.deepEqual(paymentResult.value.payments[0], { amount: 50000, date: '2026-10-10' });
+  assert.equal(paymentResult.value.status, 'partially_paid');
+});
+
+test('recordPayment marks invoice as paid when full amount is paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  let invoice = issuedResult.value;
+
+  const totals = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'paid');
+});
+
+test('recordPayment accepts multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  let invoice = issuedResult.value;
+
+  const payment1 = recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.equal(payment1.ok, true);
+  invoice = payment1.value;
+
+  const payment2 = recordPayment(invoice, { amount: 30000, date: '2026-10-15' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.payments.length, 2);
+  assert.equal(payment2.value.payments[0].amount, 50000);
+  assert.equal(payment2.value.payments[1].amount, 30000);
+});
+
+test('recordPayment reports NOT_ISSUED if invoice is draft', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const result = recordPayment(invoiceResult.value, { amount: 50000, date: '2026-10-10' });
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment reports NOT_ISSUED if invoice is paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  let invoice = issuedResult.value;
+
+  const totals = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(paymentResult.ok, true);
+  invoice = paymentResult.value;
+
+  const secondPaymentResult = recordPayment(invoice, { amount: 10000, date: '2026-10-15' });
+  assert.deepEqual(secondPaymentResult, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment accepts partially_paid status', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
