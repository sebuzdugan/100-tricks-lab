+  const invoice = issuedResult.value;
+
+  const invalidAmounts = [0, -1000, -100, 1.5, 'abc', null, undefined];
+  for (const amount of invalidAmounts) {
+    const result = recordPayment(invoice, { amount, date: '2026-10-10' });
+    assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' }, `Expected AMOUNT_INVALID for amount: ${JSON.stringify(amount)}`);
+  }
+});
+
+test('recordPayment reports OVERPAYMENT if amount exceeds balance', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  let invoice = issuedResult.value;
+
+  const totals = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: totals.total + 100, date: '2026-10-10' });
+  assert.deepEqual(paymentResult, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment allows payment equal to balance due', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  const invoice = issuedResult.value;
+
+  const totals = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'paid');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  const invoice = issuedResult.value;
+
+  const original = JSON.parse(JSON.stringify(invoice));
+  recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.deepEqual(invoice, original);
+});
+
+test('balanceDue returns full amount for unpaid issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  const invoice = issuedResult.value;
+
+  const totals = invoiceTotals(invoice);
+  const due = balanceDue(invoice);
+  assert.equal(due, totals.total);
+});
+
+test('balanceDue calculates remaining balance after partial payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  let invoice = issuedResult.value;
+
+  const totals = invoiceTotals(invoice);
