+
+test('balanceDue returns zero for fully paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issuedResult.ok, true);
+  let invoice = issuedResult.value;
+
+  const totals = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(paymentResult.ok, true);
+
+  const due = balanceDue(paymentResult.value);
+  assert.equal(due, 0);
