+/**
+ * Calculate the due date based on payment terms.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string|null} - Due date in YYYY-MM-DD format, or null if terms are invalid
+ */
+function calculateDueDate(issueDate, terms) {
+  switch (terms) {
+    case 'NET14':
+      return addDays(issueDate, 14);
+    case 'NET30':
+      return addDays(issueDate, 30);
+    case 'EOM':
+      return getLastDayOfMonth(issueDate);
+    default:
+      return null;
+  }
+}
+
+/**
+ * Get the last day of the month for a given date.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} - Last day of the month in YYYY-MM-DD format
+ */
+function getLastDayOfMonth(date) {
+  const d = new Date(date + 'T00:00:00Z');
+  const year = d.getUTCFullYear();
+  const month = d.getUTCMonth();
+  const lastDay = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
+  const monthStr = String(month + 1).padStart(2, '0');
+  const dayStr = String(lastDay).padStart(2, '0');
+  return `${year}-${monthStr}-${dayStr}`;
+}
