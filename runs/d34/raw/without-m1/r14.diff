+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement includes issued invoices for customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(inv1.ok, true);
+
+  const issued1 = issueInvoice(inv1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const result = statement('C-002', [issued1.value], '2026-10-10');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, issued1.value.number);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(draft.ok, true);
+
+  const result = statement('C-002', [draft.value], '2026-10-10');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
