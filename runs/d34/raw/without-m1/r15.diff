+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, issueDate?: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNoteParams
+ * @param {string[]} existingNumbers - array of invoice and credit note numbers already used
+ * @returns {import('./result.js').ok<{ number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string }> | import('./result.js').fail}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status === 'draft') return fail('NOT_ISSUED');
+
+  if (typeof amount !== 'number' || !Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) return fail('CREDIT_TOO_HIGH');
+
+  const creditNoteNumber = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number: creditNoteNumber,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
+
+/**
+ * Generate the next credit note number.
+ * Format: CN-YYYY-NNNN where YYYY is the year and NNNN is a zero-padded counter starting at 0001.
+ * The counter resets each year.
+ * @param {string[]} existingNumbers - array of all numbers (invoice and credit note) already used
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} - The next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.substring(0, 4);
+  const creditNoteRegex = /^CN-(\d{4})-(\d{4})$/;
+
+  const thisYearNumbers = existingNumbers
+    .filter(num => {
+      const match = creditNoteRegex.exec(num);
+      return match && match[1] === year;
+    })
+    .map(num => {
+      const match = creditNoteRegex.exec(num);
+      return parseInt(match[2], 10);
+    });
+
+  const nextCounter = thisYearNumbers.length === 0 ? 1 : Math.max(...thisYearNumbers) + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `CN-${year}-${paddedCounter}`;
+}
