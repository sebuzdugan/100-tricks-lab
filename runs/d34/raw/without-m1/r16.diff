+test('overdueInvoices returns empty list when no invoices are overdue', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = overdueInvoices([issued.value], '2026-10-20');
+  assert.deepEqual(result, []);
+});
+
