+/**
+ * Get a VAT summary for invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach(inv => {
+      inv.lines.forEach(line => {
+        const rate = line.vatRate ?? 0;
+        const total = lineTotal(line);
+        const discount = lineDiscount(line);
+        const base = total - discount;
+        const vat = lineVat(line);
+
+        if (!vatMap[rate]) {
+          vatMap[rate] = { rate, base: 0, vat: 0 };
+        }
+        vatMap[rate].base += base;
+        vatMap[rate].vat += vat;
+      });
+    });
+
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
