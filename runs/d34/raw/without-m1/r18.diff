+
+/**
+ * Calculate the late fee for an invoice.
+ * Late fee is 0.04% of the amount due for every day the invoice is overdue.
+ * @param {{ dueDate: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, rounded
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.status === 'draft') return 0;
+
+  if (invoice.dueDate >= asOf) return 0;
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+
+  if (due <= 0) return 0;
+
+  const fee = due * daysOverdue * 0.0004;
+  return Math.max(0, roundCents(fee));
+}
