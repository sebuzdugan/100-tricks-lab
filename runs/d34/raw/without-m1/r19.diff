+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Convert cents to euros string with 2 decimals and dot decimal separator.
+ * @param {number} cents
+ * @returns {string} - e.g., "1234.50"
+ */
+function formatEurosSimple(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: wrap in quotes if it contains comma or quote, and double any quotes.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  if (field.includes(',') || field.includes('"')) {
+    return '"' + field.replace(/"/g, '""') + '"';
+  }
+  return field;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ number: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array }>} invoices
+ * @returns {string} - CSV string with header and invoice rows
+ */
+export function exportCsv(invoices) {
+  const lines = ['number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'];
+
+  invoices.forEach(invoice => {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const row = [
+      escapeCsvField(invoice.number || 'DRAFT'),
+      escapeCsvField(customerName),
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatEurosSimple(totals.subtotal),
+      formatEurosSimple(totals.discount),
+      formatEurosSimple(totals.vat),
+      formatEurosSimple(totals.total),
+      formatEurosSimple(due),
+    ].join(',');
+
+    lines.push(row);
+  });
+
+  return lines.join('\n') + '\n';
+}
