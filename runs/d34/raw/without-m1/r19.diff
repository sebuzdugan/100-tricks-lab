+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns CSV string with header', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv ends with newline', () => {
+  const result = exportCsv([]);
+  assert(result.endsWith('\n'));
+});
+
+test('exportCsv with single invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('Blue Fern Bakery'));
+});
+
+test('exportCsv includes all required columns', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  const row = lines[1];
+
+  assert(row.includes('INV-2026-0001'));
+  assert(row.includes('Blue Fern Bakery'));
+  assert(row.includes('2026-10-07'));
+  assert(row.includes('2026-11-06'));
+  assert(row.includes('issued'));
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  const row = lines[1];
+
+  const matches = row.match(/\d+\.\d{2}/g);
+  assert(matches && matches.length > 0);
+  matches.forEach(match => {
+    assert.equal(match.split('.')[1].length, 2);
+  });
+});
+
+test('exportCsv uses dot decimal separator', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  const row = lines[1];
+
+  const amounts = row.match(/\d+\.\d{2}/g) || [];
+  assert(amounts.length > 0);
+});
+
