+test('exportCsv preserves invoice order', () => {
+  const invoices = [];
+
+  for (let i = 0; i < 3; i++) {
+    const inv = createInvoice({
+      customerId: 'C-002',
+      issueDate: `2026-10-${String(7 + i).padStart(2, '0')}`,
+      lines: [{ sku: 'DES-HOUR', qty: 5 + i }],
+    });
+    assert.equal(inv.ok, true);
+    const issued = issueInvoice(inv.value, invoices.map(inv => inv.number).filter(Boolean));
+    assert.equal(issued.ok, true);
+    invoices.push(issued.value);
+  }
+
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 5);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+  assert(lines[3].includes('INV-2026-0003'));
+});
