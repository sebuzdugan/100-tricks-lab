+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 10, unitPrice: 8500 }), 85000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 100 }), 100);
+  assert.equal(lineTotal({ qty: 5, unitPrice: 1000 }), 5000);
+});
+
+test('lineTotal handles zero and large quantities', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 8500 }), 0);
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 8500 }), 8500000);
+});
+
+test('lineDiscount calculates discount as lineTotal × discountPercent / 100', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 10 };
+  const expected = 85000 * 0.1;
+  assert.equal(lineDiscount(line), expected);
+});
+
+test('lineDiscount handles decimal discounts', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 12.5 };
+  const expected = 85000 * 0.125;
+  assert.equal(lineDiscount(line), expected);
+});
+
+test('lineDiscount defaults to 0 if discountPercent is missing', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 8500 }), 0);
+});
+
+test('lineDiscount clamps to 0 if calculation gives negative', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 8500, discountPercent: -10 }), 0);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 };
+  const total = 85000;
+  const discount = 8500;
+  const baseAmount = total - discount;
+  const expectedVat = Math.round(baseAmount * 0.21);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat rounds per line', () => {
+  const line = { qty: 3, unitPrice: 980, discountPercent: 0, vatRate: 21 };
+  assert.equal(typeof lineVat(line), 'number');
+  assert.equal(lineVat(line), Math.round(lineVat(line)));
+});
+
+test('lineVat with 0% VAT rate', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with 9% VAT rate', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 9 };
+  const total = 85000;
+  const expectedVat = Math.round(total * 0.09);
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat clamps to 0', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: -10 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('invoiceTotals calculates subtotal from multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000 + 47500);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+  assert(totals.vat > 0);
+});
+
+test('invoiceTotals with empty lines', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes discount and calculates total correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.discount > 0);
+  const expected = totals.subtotal - totals.discount + totals.vat;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals with 100% discount clamps total to 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 100, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.subtotal > 0);
+  assert(totals.discount > 0);
+  assert(totals.vat > 0);
+  assert(totals.total > 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 37, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.vat > 0);
+  const expected = totals.subtotal + totals.vat;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals includes voucher amount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals calculates total with voucher correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = totals.subtotal + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals returns voucher 0 for invoices without voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals clamps total to 0 even with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE', amount: 999999999 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with multiple lines and discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+      { qty: 5, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.subtotal > 0);
+  assert(totals.discount > 0);
+  assert(totals.vat > 0);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals handles complex invoice with discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(typeof totals.subtotal, 'number');
+  assert.equal(typeof totals.discount, 'number');
+  assert.equal(typeof totals.vat, 'number');
+  assert.equal(typeof totals.voucher, 'number');
+  assert.equal(typeof totals.total, 'number');
+  assert(totals.subtotal > 0);
+  assert(totals.discount > 0);
+  assert(totals.vat > 0);
+});
+
+test('invoiceTotals amounts are all non-negative integers', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 9 },
+    ],
+    voucher: { code: 'SAVE', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.subtotal >= 0);
+  assert(totals.discount >= 0);
+  assert(totals.vat >= 0);
+  assert(totals.voucher >= 0);
+  assert(totals.total >= 0);
+  assert.equal(Number.isInteger(totals.subtotal), true);
+  assert.equal(Number.isInteger(totals.discount), true);
+  assert.equal(Number.isInteger(totals.vat), true);
+  assert.equal(Number.isInteger(totals.voucher), true);
+  assert.equal(Number.isInteger(totals.total), true);
+});
