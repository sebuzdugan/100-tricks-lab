 /**
- * Calculate VAT for a single line item, based on the amount after discount.
- * VAT = (lineTotal - lineDiscount) × vatRate / 100, rounded per line.
+ * Calculate bulk discount for a single line item (2.5% off if qty >= 10, applied after first discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineBulkDiscount(line) {
+  if (line.qty < 10) return 0;
+  const total = lineTotal(line);
+  const firstDiscount = lineDiscount(line);
+  const amountAfterFirstDiscount = total - firstDiscount;
+  const bulkDiscount = amountAfterFirstDiscount * 0.025;
+  return Math.max(0, roundCents(bulkDiscount));
+}
+
+/**
+ * Calculate VAT for a single line item, based on the amount after all discounts.
+ * VAT = (lineTotal - lineDiscount - lineBulkDiscount) × vatRate / 100, rounded per line.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
  * @returns {number}
  */
 export function lineVat(line) {
   const total = lineTotal(line);
   const discount = lineDiscount(line);
-  const baseAmount = total - discount;
+  const bulkDiscount = lineBulkDiscount(line);
+  const baseAmount = total - discount - bulkDiscount;
   const vat = baseAmount * (line.vatRate ?? 0) / 100;
   return Math.max(0, roundCents(vat));
 }
