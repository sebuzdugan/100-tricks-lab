 /**
  * Render an invoice as plain text.
- * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number }> }} invoice
+ * @param {{ number?: string, customerId: string, dueDate?: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number }>, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number }> }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -46,7 +46,20 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(totals.voucher)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.number && invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
