+test('addLine adds a new line to an invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const result = addLine(invoice, { sku: 'DEV-HOUR', qty: 3 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[1].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[1].name, 'Development (hour)');
+  assert.equal(result.value.lines[1].qty, 3);
+  assert.equal(result.value.lines[1].unitPrice, 9500);
+});
