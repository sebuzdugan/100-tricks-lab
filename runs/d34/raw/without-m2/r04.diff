diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..ebe79c3
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates first number of the year', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber handles unsorted existing numbers', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const existing = ['INV-2026-0100', 'INV-2027-0001'];
+  const num = nextInvoiceNumber(existing, '2028-01-01');
+  assert.equal(num, 'INV-2028-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0999', 'INV-2026-0005', 'INV-2027-0050'];
+  const num = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = Array.from({ length: 999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const num = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(num, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2026-9999'];
+  const num = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(num, 'INV-2026-10000');
+});
