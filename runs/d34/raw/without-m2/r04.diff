+/**
+ * Issue an invoice, assigning it a number and changing status to 'issued'.
+ * @param {{ status: string, lines: Array, customerId: string, issueDate: string }} invoice
+ * @param {string[]} existingNumbers - Array of existing invoice numbers
+ * @returns {{ ok: true, value } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    ...invoice,
+    number,
+    status: 'issued',
+  });
+}
