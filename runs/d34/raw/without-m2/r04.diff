--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,24 @@
+/**
+ * Get the next invoice number for a given issue date.
+ * @param {string[]} existingNumbers - Array of existing numbers like "INV-2026-0001"
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - Next invoice number like "INV-2026-0001"
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterStr = num.slice(prefix.length);
+      const counter = Number(counterStr);
+      if (Number.isInteger(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
