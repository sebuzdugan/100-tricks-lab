+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /5x Design work \(hour\) @ €85.00 = €425.00\n/);
+  assert.match(text, /Total: €425.00$/);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /^INV-2026-0001\n/);
+  assert.match(text, /Northwind Studio\n/);
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 2, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /Blue Fern Bakery/);
+  assert.match(text, /2x Design work \(hour\) @ €85.00 = €170.00/);
+  assert.match(text, /10x Development \(hour\) @ €95.00 = €950.00/);
+  assert.match(text, /Total: €1,120.00$/);
+});
+
+test('renderInvoiceText formats large amounts correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 5, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /5x Logo package @ €1,200.00 = €6,000.00/);
+  assert.match(text, /Total: €6,000.00$/);
+});
+
+test('renderInvoiceText handles customer with special characters in name', () => {
+  const invoice = {
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /Marlow "The Print Shop"/);
+});
+
+test('renderInvoiceText returns error for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('renderInvoiceText line format is consistent', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'STICKER', name: 'Sticker sheet', qty: 100, unitPrice: 50, vatRate: 21 },
+    ],
+  };
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '100x Sticker sheet @ €0.50 = €50.00');
+  assert.equal(lines[3], 'Total: €50.00');
+});
