+/**
+ * Check if a text string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+
+  const date = new Date(text + 'T00:00:00Z');
+  if (Number.isNaN(date.getTime())) return false;
+
+  const [year, month, day] = text.split('-').map(Number);
+  if (
+    date.getUTCFullYear() !== year ||
+    date.getUTCMonth() !== month - 1 ||
+    date.getUTCDate() !== day
+  ) {
+    return false;
+  }
+
+  return true;
+}
+
+/**
+ * Add n days to a date string (YYYY-MM-DD), working in UTC.
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add
+ * @returns {string} - Date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const date = new Date(dateStr + 'T00:00:00Z');
+  date.setUTCDate(date.getUTCDate() + n);
+
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate the number of days between two dates (b - a), in whole days, working in UTC.
+ * @param {string} a - Date in YYYY-MM-DD format
+ * @param {string} b - Date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+
+  const diffMs = dateB.getTime() - dateA.getTime();
+  const diffDays = diffMs / (24 * 60 * 60 * 1000);
+
+  return Math.floor(diffDays);
+}
