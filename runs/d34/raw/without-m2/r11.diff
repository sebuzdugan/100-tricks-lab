--- /dev/null
+++ b/src/payments.js
@@ -0,0 +1,56 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the balance due on an invoice (total owed minus payments received).
+ * @param {{ lines: Array, payments?: Array<{ amount: number }> }} invoice
+ * @returns {number} - Amount still owed in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = invoice.payments?.reduce((sum, p) => sum + p.amount, 0) ?? 0;
+  return Math.max(0, totals.total - paid);
+}
+
+/**
+ * Record a payment against an invoice.
+ * @param {{ status: string, lines: Array, payments?: Array, number: string, issueDate: string, customerId: string }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate invoice status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Check for overpayment
+  const owed = balanceDue(invoice);
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new invoice with payment recorded
+  const newPayments = [...(invoice.payments ?? []), { amount, date }];
+  const totalPaid = newPayments.reduce((sum, p) => sum + p.amount, 0);
+  const totals = invoiceTotals(invoice);
+
+  const newStatus = totalPaid >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
