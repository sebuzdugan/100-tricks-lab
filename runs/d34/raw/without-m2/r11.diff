@@ -0,0 +1,194 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue returns full invoice total when no payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  assert.equal(balanceDue(invoice), 102850);
+});
+
+test('balanceDue returns remaining balance after partial payment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+    payments: [{ amount: 50000, date: '2026-10-10' }],
+  };
+  assert.equal(balanceDue(invoice), 52850);
+});
+
+test('balanceDue returns zero when fully paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+    payments: [{ amount: 102850, date: '2026-10-10' }],
+  };
+  assert.equal(balanceDue(invoice), 0);
+});
+
+test('recordPayment records a partial payment', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  const result = recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment marks invoice as paid when payment covers balance', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  const result = recordPayment(invoice, { amount: 102850, date: '2026-10-10' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment records multiple payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  const result1 = recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.equal(result1.ok, true);
+
+  const result2 = recordPayment(result1.value, { amount: 52850, date: '2026-10-15' });
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.status, 'paid');
+  assert.equal(result2.value.payments.length, 2);
+});
+
+test('recordPayment fails if invoice not issued or partially_paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  assert.deepEqual(
+    recordPayment(invoice, { amount: 50000, date: '2026-10-10' }),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('recordPayment fails if amount is not a positive integer', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  assert.deepEqual(
+    recordPayment(invoice, { amount: 0, date: '2026-10-10' }),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+  assert.deepEqual(
+    recordPayment(invoice, { amount: -100, date: '2026-10-10' }),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+  assert.deepEqual(
+    recordPayment(invoice, { amount: 50000.5, date: '2026-10-10' }),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('recordPayment fails if date is invalid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  assert.deepEqual(
+    recordPayment(invoice, { amount: 50000, date: '2026-10-32' }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+  assert.deepEqual(
+    recordPayment(invoice, { amount: 50000, date: '10/10/2026' }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('recordPayment fails if payment exceeds balance due', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  assert.deepEqual(
+    recordPayment(invoice, { amount: 102851, date: '2026-10-10' }),
+    { ok: false, error: 'OVERPAYMENT' }
+  );
+});
+
+test('recordPayment accepts payment on partially_paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+    payments: [{ amount: 50000, date: '2026-10-10' }],
+  };
+  const result = recordPayment(invoice, { amount: 52850, date: '2026-10-15' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+  assert.equal(result.value.payments.length, 2);
+});
+
+test('recordPayment does not mutate the original invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+  recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('recordPayment works with invoices with discounts and VAT', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 10 }],
+  };
+  const balance = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: balance, date: '2026-10-10' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
