+test('applyVoucher applies a voucher to a draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 }],
+  };
+  const result = applyVoucher(invoice, { code: 'HOLIDAY10', amount: 10000 });
+  assert.equal(result.ok, true);
