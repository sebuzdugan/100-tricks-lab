+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a statement for a customer showing outstanding invoices.
+ * @param {string} customerId
+ * @param {Array} invoices - All invoices
+ * @param {string} asOf - Statement date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize customer ID
+  const normalizedCustomerId = normalizeId(customerId);
+
+  // Validate customer exists
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer with outstanding balance
+  const statementLines = invoices
+    .filter((inv) =>
+      normalizeId(inv.customerId) === normalizedCustomerId &&
+      (inv.status === 'issued' || inv.status === 'partially_paid') &&
+      inv.issueDate <= asOf
+    )
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementLines.reduce((sum, line) => sum + line.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: statementLines,
+    totalDue,
+  });
+}
