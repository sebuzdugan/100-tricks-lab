+  assert.deepEqual(
+    statement('C-999', [], '2026-10-31'),
+    { ok: false, error: 'CUSTOMER_NOT_FOUND' }
+  );
+});
+
+test('statement normalizes customer ID', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result1 = statement('c-001', [issued], '2026-10-31');
+  const result2 = statement(' C-001 ', [issued], '2026-10-31');
+
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  assert.equal(result1.value.customerId, 'C-001');
+  assert.equal(result2.value.customerId, 'C-001');
+});
+
+test('statement calculates correct due amounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const partiallyPaid = recordPayment(issued, { amount: 30000, date: '2026-10-10' }).value;
+
+  const result = statement('C-001', [partiallyPaid], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].total, 97708);
+  assert.equal(result.value.invoices[0].due, 67708);
+  assert.equal(result.value.totalDue, 67708);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2026-0001']).value;
+
+  const invoice3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-20',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+  const issued3 = issueInvoice(invoice3, ['INV-2026-0002']).value;
+
+  const result = statement('C-001', [issued1, issued2, issued3], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2026-09-15');
+  assert.equal(result.value.invoices[1].issueDate, '2026-09-20');
+  assert.equal(result.value.invoices[2].issueDate, '2026-10-07');
+});
+
+test('statement calculates total due correctly for multiple invoices', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2026-0001']).value;
+  const partiallyPaid2 = recordPayment(issued2, { amount: 50000, date: '2026-10-10' }).value;
+
+  const result = statement('C-001', [issued1, partiallyPaid2], '2026-10-31');
+  assert.equal(result.ok, true);
+  const expectedTotal = result.value.invoices[0].due + result.value.invoices[1].due;
+  assert.equal(result.value.totalDue, expectedTotal);
+});
+
+test('statement includes all required fields for each invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = statement('C-001', [issued], '2026-10-31');
+  assert.equal(result.ok, true);
+  const line = result.value.invoices[0];
+  assert.ok(line.number);
+  assert.ok(line.issueDate);
+  assert.ok(line.dueDate);
+  assert.ok(line.total !== undefined);
+  assert.ok(line.due !== undefined);
+});
