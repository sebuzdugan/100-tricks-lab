diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..b0b873c
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,190 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, invoiceTotals } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Partial refund', date: '2026-10-15' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 10000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2026-10-15');
+});
+
+test('createCreditNote works on partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const partiallyPaid = recordPayment(issued, { amount: 50000, date: '2026-10-10' }).value;
+
+  const result = createCreditNote(partiallyPaid, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-10-10' }).value;
+
+  const result = createCreditNote(paid, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote fails for draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  assert.deepEqual(
+    createCreditNote(invoice, { amount: 10000, reason: 'Refund', date: '2026-10-15' }, []),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('createCreditNote fails on invalid amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(
+    createCreditNote(issued, { amount: 0, reason: 'Refund', date: '2026-10-15' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+  assert.deepEqual(
+    createCreditNote(issued, { amount: -1000, reason: 'Refund', date: '2026-10-15' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+  assert.deepEqual(
+    createCreditNote(issued, { amount: 1000.5, reason: 'Refund', date: '2026-10-15' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote fails on invalid date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(
+    createCreditNote(issued, { amount: 10000, reason: 'Refund', date: '2026-02-30' }, []),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createCreditNote fails if credit exceeds invoice total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(
+    createCreditNote(issued, { amount: 1000000, reason: 'Refund', date: '2026-10-15' }, []),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
+
+test('createCreditNote generates separate sequence for credit notes', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2026-0001']).value;
+
+  const credit1 = createCreditNote(issued1, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']).value;
+  const credit2 = createCreditNote(issued2, { amount: 10000, reason: 'Refund', date: '2026-10-20' }, ['INV-2026-0002', 'CN-2026-0001']).value;
+
+  assert.equal(credit1.number, 'CN-2026-0001');
+  assert.equal(credit2.number, 'CN-2026-0002');
+});
+
+test('createCreditNote resets counter per year', () => {
+  const invoice2026 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued2026 = issueInvoice(invoice2026, []).value;
+
+  const invoice2027 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued2027 = issueInvoice(invoice2027, ['INV-2026-0001']).value;
+
+  const credit2026 = createCreditNote(issued2026, { amount: 5000, reason: 'Refund', date: '2026-10-10' }, ['INV-2026-0001']).value;
+  const credit2027 = createCreditNote(issued2027, { amount: 5000, reason: 'Refund', date: '2027-01-20' }, ['CN-2026-0001']).value;
+
+  assert.equal(credit2026.number, 'CN-2026-0001');
+  assert.equal(credit2027.number, 'CN-2027-0001');
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: totals.total, reason: 'Full refund', date: '2026-10-15' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote handles multiple credit notes for same invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const credit1 = createCreditNote(issued, { amount: 10000, reason: 'Refund 1', date: '2026-10-10' }, []).value;
+  const credit2 = createCreditNote(issued, { amount: 5000, reason: 'Refund 2', date: '2026-10-15' }, ['CN-2026-0001']).value;
+
+  assert.equal(credit1.number, 'CN-2026-0001');
+  assert.equal(credit2.number, 'CN-2026-0002');
+  assert.equal(credit1.invoiceNumber, issued.number);
+  assert.equal(credit2.invoiceNumber, issued.number);
+});
