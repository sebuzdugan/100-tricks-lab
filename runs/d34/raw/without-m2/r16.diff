+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, invoiceTotals } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns invoices past their due date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-09-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.number);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-09-15');
+  assert.equal(result[0].daysOverdue, 5);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices due on asOf date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-09-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const partiallyPaid = recordPayment(issued, { amount: 50000, date: '2026-09-10' }).value;
+
+  const result = overdueInvoices([partiallyPaid], '2026-09-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 47708);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const result = overdueInvoices([invoice], '2026-09-20');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2026-09-10' }).value;
+
+  const result = overdueInvoices([paid], '2026-09-20');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices sorts by most overdue first', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2026-0001']).value;
+
+  const result = overdueInvoices([issued2, issued1], '2026-09-30');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].dueDate, '2026-09-15');
+  assert.equal(result[0].daysOverdue, 15);
+  assert.equal(result[1].dueDate, '2026-09-24');
+  assert.equal(result[1].daysOverdue, 6);
+});
+
+test('overdueInvoices calculates days overdue correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'EOM',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-10');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 10);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-10-15');
+  assert.equal(result.length, 0);
+  assert.ok(Array.isArray(result));
+});
+
+test('overdueInvoices includes all required fields', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-09-20');
+  assert.equal(result.length, 1);
+  const line = result[0];
+  assert.ok(line.number);
+  assert.ok(line.customerId);
+  assert.ok(line.dueDate);
+  assert.ok(line.daysOverdue !== undefined);
+  assert.ok(line.due !== undefined);
+});
+
+test('overdueInvoices calculates correct due amounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2026-09-20');
+  assert.equal(result.length, 1);
+  assert.ok(result[0].due > 0);
+});
+
+test('overdueInvoices with multiple days overdue', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-08-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2026-0001']).value;
+
+  const result = overdueInvoices([issued1, issued2], '2026-10-01');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].daysOverdue, 47);
+  assert.equal(result[1].daysOverdue, 16);
+});
