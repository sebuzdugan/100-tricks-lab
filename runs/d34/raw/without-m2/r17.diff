+/**
+ * Generate a VAT summary report.
+ * @param {Array} invoices - All invoices
+ * @returns {Array} - Array of VAT summary entries sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  // Filter invoices with status 'issued', 'partially_paid', or 'paid'
+  const relevantInvoices = invoices.filter((inv) =>
+    ['issued', 'partially_paid', 'paid'].includes(inv.status)
+  );
+
+  // Process each invoice
+  for (const invoice of relevantInvoices) {
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = roundCents(base * rate / 100);
+
+      if (!vatMap[rate]) {
+        vatMap[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vat;
+    }
+  }
+
+  // Convert to array and sort by rate descending
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
