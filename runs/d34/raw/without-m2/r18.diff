   // Convert to array and sort by rate descending
   return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fees for an invoice.
+ * @param {{ status: string, dueDate: string, payments: Array }} invoice
+ * @param {string} asOf - Report date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (asOf <= invoice.dueDate) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  if (due === 0) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  return roundCents(due * daysOverdue * 0.04 / 100);
+}
