+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const totals = invoiceTotals(issued);
+  const payment = totals.total - 10000;
+  const paid = recordPayment(issued, { amount: payment, date: '2026-10-10' }).value;
+
+  const csv = exportCsv([paid]);
+  const lines = csv.split('\n');
+  const parts = lines[1].split(',');
+  const due = parseFloat(parts[parts.length - 1]);
+
+  const expected = 10000 / 100;
+  assert.equal(due, expected);
+});
