+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, invoiceTotals } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv exports single invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+
+  assert.ok(csv.startsWith('number,customer,'));
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.ok(lines.length >= 2);
+  assert.equal(lines[lines.length - 1], '');
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+
+  assert.ok(lines[1].includes('Northwind'));
+});
+
+test('exportCsv formats amounts with 2 decimal places', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+  const parts = lines[1].split(',');
+
+  // Check that the total (second to last field) has 2 decimal places
+  const total = parts[parts.length - 2];
+  assert.ok(total.includes('.'));
+  const decimals = total.split('.')[1];
+  assert.equal(decimals.length, 2);
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2026-0001']).value;
+
+  const csv = exportCsv([issued1, issued2]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[2].includes('Blue Fern Bakery'));
+});
+
