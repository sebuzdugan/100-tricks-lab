+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+function formatEurosForCsv(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array} invoices - Array of invoices to export
+ * @returns {string} - CSV formatted string with header and invoice rows
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due';
+
+  const lines = [header];
+
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number,
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatEurosForCsv(totals.subtotal),
+      formatEurosForCsv(totals.discount),
+      formatEurosForCsv(totals.vat),
+      formatEurosForCsv(totals.total),
+      formatEurosForCsv(due),
+    ];
+
+    const line = fields.map(escapeCsvField).join(',');
+    lines.push(line);
+  }
+
+  return lines.join('\n') + '\n';
+}
