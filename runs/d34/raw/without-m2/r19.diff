+test('exportCsv preserves order of invoices', () => {
+  const invoices = [];
+  for (let i = 0; i < 3; i++) {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: `2026-10-0${i + 7}`,
+      lines: [{ sku: 'DES-HOUR', qty: i + 1 }],
+    }).value;
+    const issued = issueInvoice(inv, invoices.length > 0 ? [invoices[invoices.length - 1].number] : []).value;
+    invoices.push(issued);
+  }
