@@ -43,3 +43,40 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge two customers, moving all invoices from fromId to intoId.
+ * @param {Array} customers - Array of customer objects
+ * @param {Array} invoices - Array of invoice objects
+ * @param {string} fromId - Customer ID to merge from
+ * @param {string} intoId - Customer ID to merge into
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  const fromCustomer = customers.find((c) => c.id === normalizedFromId);
+  if (!fromCustomer) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const intoCustomer = customers.find((c) => c.id === normalizedIntoId);
+  if (!intoCustomer) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const newCustomers = customers.filter((c) => c.id !== normalizedFromId);
+  const newInvoices = invoices.map((inv) => {
+    if (inv.customerId === normalizedFromId) {
+      return { ...inv, customerId: normalizedIntoId };
+    }
+    return inv;
+  });
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
