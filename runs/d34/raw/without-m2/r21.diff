+test('mergeCustomers merges two customers', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, customers.length - 1);
+  assert.ok(!result.value.customers.find((c) => c.id === 'C-001'));
+  assert.ok(result.value.customers.find((c) => c.id === 'C-002'));
+});
