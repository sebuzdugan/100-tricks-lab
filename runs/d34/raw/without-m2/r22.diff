diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..434e2ca
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,50 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line: qty * unitPrice (in cents).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount for a single line: lineTotal * discountPercent / 100 (in cents).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const discountPercent = line.discountPercent ?? 0;
+  return roundCents(lineTotal(line) * discountPercent / 100);
+}
+
+/**
+ * Calculate the VAT for a single line: (lineTotal - lineDiscount) * vatRate / 100 (in cents).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number}
+ */
+export function lineVat(line) {
+  const netAmount = lineTotal(line) - lineDiscount(line);
+  return roundCents(netAmount * line.vatRate / 100);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..b79ebf6
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,216 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty and unitPrice', () => {
+  const line = { qty: 25, unitPrice: 1700 };
+  assert.equal(lineTotal(line), 42500);
+});
+
+test('lineTotal works with quantity 1', () => {
+  const line = { qty: 1, unitPrice: 1500 };
+  assert.equal(lineTotal(line), 1500);
+});
+
+test('lineTotal works with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 950 };
+  assert.equal(lineTotal(line), 950000);
+});
+
+test('lineTotal works with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineDiscount calculates discount correctly', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 1000);
+});
+
+test('lineDiscount handles decimal discounts', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 2.5 };
+  assert.equal(lineDiscount(line), 250);
+});
+
+test('lineDiscount defaults to zero when discountPercent is missing', () => {
+  const line = { qty: 10, unitPrice: 1000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with no discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 10000);
+});
+
+test('lineVat calculates VAT correctly', () => {
+  const line = { qty: 10, unitPrice: 1000, vatRate: 21 };
+  // lineTotal = 10000, lineDiscount = 0, netAmount = 10000
+  // VAT = 10000 * 21 / 100 = 2100
+  assert.equal(lineVat(line), 2100);
+});
+
+test('lineVat with discount', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 21 };
+  // lineTotal = 10000, lineDiscount = 1000, netAmount = 9000
+  // VAT = 9000 * 21 / 100 = 1890
+  assert.equal(lineVat(line), 1890);
+});
+
+test('lineVat with 0% rate', () => {
+  const line = { qty: 10, unitPrice: 1000, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with 9% rate', () => {
+  const line = { qty: 10, unitPrice: 1000, vatRate: 9 };
+  // lineTotal = 10000, lineDiscount = 0, netAmount = 10000
+  // VAT = 10000 * 9 / 100 = 900
+  assert.equal(lineVat(line), 900);
+});
+
+test('invoiceTotals calculates subtotal and total for single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 12100);
+});
+
+test('invoiceTotals sums multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21 },
+      { qty: 5, unitPrice: 2000, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 20000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100 + 900);
+  assert.equal(totals.total, 20000 + 3000);
+});
+
+test('invoiceTotals works with empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals does not mutate the invoice', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 21 }],
+  };
+  const invoiceCopy = JSON.stringify(invoice);
+
+  invoiceTotals(invoice);
+
+  assert.equal(JSON.stringify(invoice), invoiceCopy);
+});
+
+test('invoiceTotals includes voucher in calculation', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 21 }],
+    voucher: { code: 'PROMO', amount: 2000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.voucher, 2000);
+  assert.equal(totals.total, 12100 - 2000);
+});
+
+test('invoiceTotals handles voucher without discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 21 }],
+    voucher: { code: 'PROMO', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.total, 12100 - 1000);
+});
+
+test('invoiceTotals returns zero voucher when none applied', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // subtotal = 10000, discount = 1000, vat = (10000 - 1000) * 21 / 100 = 1890
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1000);
+  assert.equal(totals.vat, 1890);
+  assert.equal(totals.total, 10000 - 1000 + 1890);
+});
+
+test('invoiceTotals total is clamped at 0', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, vatRate: 0 }],
+    voucher: { code: 'BIG', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  // subtotal = 1000, discount = 0, vat = 0, voucher = 5000
+  // total = max(0, 1000 - 0 + 0 - 5000) = 0
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals returns object with all required fields', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
+
+test('invoiceTotals with multiple VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21 },
+      { qty: 20, unitPrice: 500, vatRate: 9 },
+      { qty: 5, unitPrice: 2000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  const subtotal = 10000 + 10000 + 10000;
+  const vat1 = 2100;
+  const vat2 = 900;
+  const vat3 = 0;
+
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.vat, vat1 + vat2 + vat3);
+  assert.equal(totals.total, subtotal + vat1 + vat2 + vat3);
+});
