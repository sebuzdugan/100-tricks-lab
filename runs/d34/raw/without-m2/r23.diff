@@ -10,13 +10,29 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount for a single line: lineTotal * discountPercent / 100 (in cents).
+ * Calculate bulk discount for a line: 2.5% off the amount after regular discount, if qty >= 10.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function bulkDiscount(line) {
+  if (line.qty < 10) {
+    return 0;
+  }
+  const discountPercent = line.discountPercent ?? 0;
+  const regularDiscount = roundCents(lineTotal(line) * discountPercent / 100);
+  const amountAfterRegularDiscount = lineTotal(line) - regularDiscount;
+  return roundCents(amountAfterRegularDiscount * 2.5 / 100);
+}
+
+/**
+ * Calculate the discount for a single line: lineTotal * discountPercent / 100 + bulk discount (in cents).
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
   const discountPercent = line.discountPercent ?? 0;
-  return roundCents(lineTotal(line) * discountPercent / 100);
+  const regularDiscount = roundCents(lineTotal(line) * discountPercent / 100);
+  return regularDiscount + bulkDiscount(line);
 }
 
