 }
+
+/**
+ * Generate a dashboard with key metrics about invoices.
+ * @param {Array} invoices - All invoices
+ * @param {string} asOf - Report date in YYYY-MM-DD format
+ * @returns {{ counts: {draft, issued, partially_paid, paid}, outstanding: number, overdue: {count, amount}, topCustomers: [{customerId, due}] }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDueMap = {};
+
+  for (const inv of invoices) {
+    counts[inv.status]++;
+
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const due = balanceDue(inv);
+      outstanding += due;
+
+      if (!customerDueMap[inv.customerId]) {
+        customerDueMap[inv.customerId] = 0;
+      }
+      customerDueMap[inv.customerId] += due;
+    }
+  }
+
+  const overdueInvoicesList = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdueInvoicesList.reduce((sum, inv) => sum + inv.due, 0);
+  const overdue = {
+    count: overdueInvoicesList.length,
+    amount: overdueAmount,
+  };
+
+  const topCustomers = Object.entries(customerDueMap)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
