+test('dashboard counts invoices by status', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice2, []).value;
+
+  const invoice3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued2 = issueInvoice(invoice3, ['INV-2026-0001']).value;
+  const partiallyPaid = recordPayment(issued2, { amount: 20000, date: '2026-10-10' }).value;
+
+  const invoice4 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued3 = issueInvoice(invoice4, ['INV-2026-0001', 'INV-2026-0002']).value;
+  const totals = invoiceTotals(issued3);
+  const paid = recordPayment(issued3, { amount: totals.total, date: '2026-10-11' }).value;
+
+  const result = dashboard([draft, issued, partiallyPaid, paid], '2026-10-31');
+
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.partially_paid, 1);
+  assert.equal(result.counts.paid, 1);
