diff --git a/src/render.js b/src/render.js
index 755aac2..18be89e 100644
--- a/src/render.js
+++ b/src/render.js
@@ -5,7 +5,7 @@ import { lineTotal, lineDiscount, lineVat, invoiceTotals } from './invoices.js';
 
 /**
  * Render an invoice as plain text.
- * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @param {{ customerId: string, number?: string, issueDate?: string, dueDate?: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number }>, voucher?: { amount: number }, payments?: Array<{ amount: number }> }} invoice
  * @returns {{ ok: true, value: string } | { ok: false, error: string }}
  */
 export function renderInvoiceText(invoice) {
@@ -23,14 +23,18 @@ export function renderInvoiceText(invoice) {
   // Second line: customer name
   lines.push(customer.name);
 
-  // One line per invoice line
+  // One line per invoice line with optional discount
   for (const line of invoice.lines) {
     const total = lineTotal(line);
+    const discount = lineDiscount(line);
     const qtyDisplay = line.qty;
     const nameDisplay = line.name;
     const priceDisplay = formatEuros(line.unitPrice);
     const totalDisplay = formatEuros(total);
     lines.push(`${qtyDisplay}x ${nameDisplay} @ ${priceDisplay} = ${totalDisplay}`);
+    if (discount > 0) {
+      lines.push(`  Discount: -${formatEuros(discount)}`);
+    }
   }
 
   // Calculate totals
@@ -41,8 +45,24 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  // Voucher line if present
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(totals.voucher)}`);
+  }
+
   // Total line
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date line if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid line if there are payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return ok(lines.join('\n'));
 }
diff --git a/test/render.test.js b/test/render.test.js
