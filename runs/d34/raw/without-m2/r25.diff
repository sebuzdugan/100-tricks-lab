+test('renderInvoiceText combines discount, voucher, due date, and paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    number: 'INV-2026-0001',
+    dueDate: '2026-11-06',
+    lines: [
