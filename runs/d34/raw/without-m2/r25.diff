--- a/test/render.test.js
+++ b/test/render.test.js
@@ -132,3 +132,148 @@ test('renderInvoiceText omits VAT line when VAT is zero', () => {
   assert.equal(lines[2], '1x Brand workshop (day, VAT exempt) @ €600.00 = €600.00');
   assert.equal(lines[3], 'Total: €600.00');
 });
+
+test('renderInvoiceText shows line discount when present', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /5x Design work \(hour\) @ €85.00 = €425.00\n/);
+  assert.match(text, /  Discount: -€42.50\n/);
+});
+
+test('renderInvoiceText omits line discount when zero', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.ok(!text.includes('Discount:'));
