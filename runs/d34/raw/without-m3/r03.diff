+/**
+ * Add or increase a line on a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} line
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  const product = getProduct(sku);
+  if (!product.ok) return product;
+
+  const existingLine = invoice.lines.find((line) => line.sku === sku);
+
+  let newLines;
+  if (existingLine) {
+    newLines = invoice.lines.map((line) => {
+      if (line.sku === sku) {
+        return { ...line, qty: line.qty + qty };
+      }
+      return line;
+    });
+  } else {
+    newLines = [
+      ...invoice.lines,
+      {
+        sku: product.value.sku,
+        name: product.value.name,
+        qty,
+        unitPrice: product.value.unitPrice,
+        vatRate: product.value.vatRate,
+      },
+    ];
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  const newLines = invoice.lines.filter((_, i) => i !== lineIndex);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
