@@ -0,0 +1,67 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number for empty list', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const existingNumbers = ['INV-2026-0001'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber increments from multiple existing numbers', () => {
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0999', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber works when numbers are not in order', () => {
+  const existingNumbers = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber handles year transition', () => {
+  const existingNumbers = ['INV-2025-0999', 'INV-2026-0001'];
+  const numberFor2026 = nextInvoiceNumber(existingNumbers, '2026-06-01');
+  const numberFor2027 = nextInvoiceNumber(existingNumbers, '2027-01-01');
+  assert.equal(numberFor2026, 'INV-2026-0002');
+  assert.equal(numberFor2027, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existingNumbers = [];
+  assert.equal(nextInvoiceNumber(existingNumbers, '2026-01-01'), 'INV-2026-0001');
+  assert.equal(
+    nextInvoiceNumber(['INV-2026-0009'], '2026-06-01'),
+    'INV-2026-0010',
+  );
+  assert.equal(
+    nextInvoiceNumber(['INV-2026-0099'], '2026-07-01'),
+    'INV-2026-0100',
+  );
+  assert.equal(
+    nextInvoiceNumber(['INV-2026-0999'], '2026-08-01'),
+    'INV-2026-1000',
+  );
+});
+
+test('nextInvoiceNumber with high counters', () => {
+  const existingNumbers = [
+    'INV-2026-0001',
+    'INV-2026-0500',
+    'INV-2026-9999',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-12-31');
+  assert.equal(number, 'INV-2026-10000');
+});
