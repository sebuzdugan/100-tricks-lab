diff --git a/src/render.js b/src/render.js
new file mode 100644
index 0000000..a4161f0
--- /dev/null
+++ b/src/render.js
@@ -0,0 +1,26 @@
+import { formatEuros } from './money.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerName: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  const number = invoice.number ?? 'DRAFT';
+  lines.push(number);
+  lines.push(invoice.customerName);
+
+  for (const line of invoice.lines) {
+    const total = line.qty * line.unitPrice;
+    const formattedUnitPrice = formatEuros(line.unitPrice);
+    const formattedTotal = formatEuros(total);
+    lines.push(`${line.qty} ${line.name} ${formattedUnitPrice} ${formattedTotal}`);
+  }
+
+  const subtotal = invoice.lines.reduce((sum, line) => sum + line.qty * line.unitPrice, 0);
+  lines.push(`Total: ${formatEuros(subtotal)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..98e5025
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,158 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  assert.equal(
+    text,
+    'DRAFT\nNorthwind Studio\n5 Development (hour) €95.00 €475.00\nTotal: €475.00',
+  );
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const text = renderInvoiceText(issued.value);
+  assert.equal(
+    text,
+    'INV-2026-0001\nNorthwind Studio\n5 Development (hour) €95.00 €475.00\nTotal: €475.00',
+  );
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  assert.equal(
+    text,
+    'DRAFT\nNorthwind Studio\n10 Development (hour) €95.00 €950.00\n1 Logo package €1,200.00 €1,200.00\nTotal: €2,150.00',
+  );
+});
+
+test('renderInvoiceText with products having different prices', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-06-15',
+    lines: [
+      { sku: 'COPY-HOUR', qty: 8 },
+      { sku: 'ICON-SET', qty: 5 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.equal(lines[2], '8 Copywriting (hour) €60.00 €480.00');
+  assert.equal(lines[3], '5 Icon set (24 icons) €9.80 €49.00');
+  assert.equal(lines[4], '100 Printed flyer A4 (each) €0.37 €37.00');
+  assert.equal(lines[5], 'Total: €566.00');
+});
+
+test('renderInvoiceText displays different customer names', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const result2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+
+  const text1 = renderInvoiceText(result1.value);
+  const text2 = renderInvoiceText(result2.value);
+
+  assert.match(text1, /Northwind Studio/);
+  assert.match(text2, /Kite & Co/);
+});
+
+test('renderInvoiceText with large quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 5000 }],
+  });
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  assert.equal(
+    text,
+    'DRAFT\nNorthwind Studio\n5000 Sticker sheet €0.50 €2,500.00\nTotal: €2,500.00',
+  );
+});
+
+test('renderInvoiceText with high-value items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'WORKSHOP-DAY', qty: 2 },
+      { sku: 'BRAND-BOOK', qty: 3 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '2 Brand workshop (day, VAT exempt) €600.00 €1,200.00');
+  assert.equal(lines[3], '3 Brand guidelines document €2,450.00 €7,350.00');
+  assert.equal(lines[4], 'Total: €8,550.00');
+});
+
+test('renderInvoiceText preserves line order', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'COPY-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'DES-HOUR', qty: 1 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '1 Copywriting (hour) €60.00 €60.00');
+  assert.equal(lines[3], '1 Development (hour) €95.00 €95.00');
+  assert.equal(lines[4], '1 Design work (hour) €85.00 €85.00');
+});
+
+test('renderInvoiceText with issued invoice includes number in header', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(result.ok, true);
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const issued = issueInvoice(result.value, existing);
+  assert.equal(issued.ok, true);
+  const text = renderInvoiceText(issued.value);
+  assert.equal(text.split('\n')[0], 'INV-2026-0003');
+});
