     const lineDiscount = roundCents(total * discountPercent / 100);
-    discount += Math.max(0, lineDiscount);
+    const clampedLineDiscount = Math.max(0, lineDiscount);
+    discount += clampedLineDiscount;
+
+    const lineAmount = total - clampedLineDiscount;
+    const lineVat = roundCents(lineAmount * line.vatRate / 100);
+    const clampedLineVat = Math.max(0, lineVat);
+    vat += clampedLineVat;
   }
 
