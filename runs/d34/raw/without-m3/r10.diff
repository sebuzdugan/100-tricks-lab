+/**
+ * Check if a date string is valid in YYYY-MM-DD format (UTC).
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(text);
+  if (!m) return false;
+  const date = new Date(`${m[1]}-${m[2]}-${m[3]}T00:00:00Z`);
+  return date instanceof Date && !isNaN(date) && date.toISOString().slice(0, 10) === text;
+}
+
+/**
+ * Add n days to a date (in UTC).
+ * @param {string} date - YYYY-MM-DD format
+ * @param {number} n - number of days to add
+ * @returns {string} - new date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().slice(0, 10);
+}
+
+/**
+ * Calculate the number of days between two dates (b - a) in UTC.
+ * @param {string} a - YYYY-MM-DD format
+ * @param {string} b - YYYY-MM-DD format
+ * @returns {number} - number of whole days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(`${a}T00:00:00Z`);
+  const dateB = new Date(`${b}T00:00:00Z`);
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB - dateA) / msPerDay);
+}
