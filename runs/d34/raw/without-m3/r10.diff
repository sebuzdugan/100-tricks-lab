@@ -0,0 +1,112 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+  assert.equal(isValidDate('2025-01-01'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('26-10-07'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2025-02-29'), false); // not a leap year
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(123), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+});
+
+test('addDays adds days correctly', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 365), '2027-10-07');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // leap year
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+  assert.equal(addDays('2026-10-01', -1), '2026-09-30');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween calculates days correctly', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2027-10-07'), 365);
+});
+
+test('daysBetween with same date', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween with reversed dates', () => {
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+  assert.equal(daysBetween('2027-10-07', '2026-10-07'), -365);
+});
+
+test('daysBetween across month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+});
+
+test('daysBetween across leap year boundary', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2); // leap year
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1); // non-leap year
+});
+
+test('daysBetween large date range', () => {
+  assert.equal(daysBetween('2000-01-01', '2026-10-07'), 9776); // 26+ years with leap days
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const start = '2026-10-07';
+  const n = 100;
+  const end = addDays(start, n);
+  assert.equal(daysBetween(start, end), n);
+  assert.equal(addDays(end, -n), start);
+});
+
+test('addDays with multiple operations', () => {
+  let date = '2026-10-07';
+  date = addDays(date, 10);
+  assert.equal(date, '2026-10-17');
+  date = addDays(date, -5);
+  assert.equal(date, '2026-10-12');
+  date = addDays(date, 365);
+  assert.equal(date, '2027-10-12');
+});
+
+test('isValidDate works with addDays result', () => {
+  const result = addDays('2026-10-07', 50);
+  assert.equal(isValidDate(result), true);
+  const backDate = addDays(result, -50);
+  assert.equal(isValidDate(backDate), true);
+});
