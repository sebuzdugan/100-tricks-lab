+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('balanceDue on issued invoice equals total', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const due = balanceDue(issued.value);
+  // subtotal = 95000, vat = 19950, total = 114950
+  assert.equal(due, 114950);
+});
+
+test('balanceDue on paid invoice equals zero', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const invoice = issued.value;
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+  const due = balanceDue(payment.value);
+  assert.equal(due, 0);
+});
+
+test('recordPayment on issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const payment = recordPayment(issued.value, { amount: 50000, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.status, 'partially_paid');
+  assert.equal(payment.value.payments.length, 1);
+  assert.equal(payment.value.payments[0].amount, 50000);
+  assert.equal(payment.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  let invoice = issued.value;
+  const payment1 = recordPayment(invoice, { amount: 50000, date: '2026-10-08' });
+  assert.equal(payment1.ok, true);
+  invoice = payment1.value;
+  const payment2 = recordPayment(invoice, { amount: 50000, date: '2026-10-15' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.status, 'partially_paid');
+  assert.equal(payment2.value.payments.length, 2);
+});
+
+test('recordPayment transitions to paid status', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const invoice = issued.value;
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.status, 'paid');
+});
+
+test('recordPayment handles NOT_ISSUED for draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const payment = recordPayment(result.value, { amount: 50000, date: '2026-10-08' });
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'NOT_ISSUED');
+});
+
+test('recordPayment handles NOT_ISSUED for paid invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const invoice = issued.value;
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+  const invoice2 = payment.value;
+  const payment2 = recordPayment(invoice2, { amount: 1000, date: '2026-10-15' });
+  assert.equal(payment2.ok, false);
+  assert.equal(payment2.error, 'NOT_ISSUED');
+});
+
+test('recordPayment handles AMOUNT_INVALID for zero', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const payment = recordPayment(issued.value, { amount: 0, date: '2026-10-08' });
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment handles AMOUNT_INVALID for negative', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const payment = recordPayment(issued.value, { amount: -1000, date: '2026-10-08' });
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment handles AMOUNT_INVALID for fractional', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const payment = recordPayment(issued.value, { amount: 1000.5, date: '2026-10-08' });
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment handles DATE_INVALID', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const payment = recordPayment(issued.value, { amount: 50000, date: '10-08-2026' });
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'DATE_INVALID');
+});
+
+test('recordPayment handles OVERPAYMENT', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const invoice = issued.value;
+  const totals = invoiceTotals(invoice);
+  const payment = recordPayment(invoice, { amount: totals.total + 1000, date: '2026-10-08' });
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'OVERPAYMENT');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const invoice = issued.value;
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+  recordPayment(invoice, { amount: 50000, date: '2026-10-08' });
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('recordPayment with multiple payments accumulating', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  let invoice = issued.value;
+
+  invoice = recordPayment(invoice, { amount: 30000, date: '2026-10-08' }).value;
+  assert.equal(invoice.payments.length, 1);
+  assert.equal(balanceDue(invoice), 84950);
+
+  invoice = recordPayment(invoice, { amount: 40000, date: '2026-10-15' }).value;
+  assert.equal(invoice.payments.length, 2);
+  assert.equal(balanceDue(invoice), 44950);
+
+  invoice = recordPayment(invoice, { amount: 44950, date: '2026-10-22' }).value;
+  assert.equal(invoice.payments.length, 3);
+  assert.equal(invoice.status, 'paid');
+  assert.equal(balanceDue(invoice), 0);
+});
+
+test('balanceDue on invoice without payments', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  const due = balanceDue(issued.value);
+  // subtotal = 5000, vat = 1050, total = 6050
+  assert.equal(due, 6050);
+});
