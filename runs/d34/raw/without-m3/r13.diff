+test('applyVoucher applies voucher to draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const invoice = result.value;
+  const voucher = applyVoucher(invoice, { code: 'SAVE10', amount: 10000 });
+  assert.equal(voucher.ok, true);
+  assert.equal(voucher.value.voucher.code, 'SAVE10');
+  assert.equal(voucher.value.voucher.amount, 10000);
+});
+
+test('applyVoucher handles NOT_DRAFT', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const invoice = { ...result.value, status: 'issued' };
+  const voucher = applyVoucher(invoice, { code: 'SAVE10', amount: 10000 });
+  assert.equal(voucher.ok, false);
+  assert.equal(voucher.error, 'NOT_DRAFT');
+});
+
+test('applyVoucher handles VOUCHER_EXISTS', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  let invoice = result.value;
+
+  const voucher1 = applyVoucher(invoice, { code: 'SAVE10', amount: 10000 });
+  assert.equal(voucher1.ok, true);
+  invoice = voucher1.value;
+
+  const voucher2 = applyVoucher(invoice, { code: 'SAVE20', amount: 20000 });
+  assert.equal(voucher2.ok, false);
+  assert.equal(voucher2.error, 'VOUCHER_EXISTS');
+});
