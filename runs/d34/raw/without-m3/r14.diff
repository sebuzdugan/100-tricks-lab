+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns empty list when no invoices for customer', () => {
+  const result = statement('C-002', [], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value, {
+    customerId: 'C-002',
+    invoices: [],
+    totalDue: 0,
+  });
+});
+
+test('statement handles CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('C-999', [], '2026-10-07');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement normalizes customer ID', () => {
+  const invoices = [];
+  const result = statement('c-002 ', invoices, '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+});
+
+test('statement includes issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = statement('C-002', [issued.value], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  let invoice = issueInvoice(inv.value, []).value;
+  const payment = recordPayment(invoice, { amount: 50000, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+
+  const result = statement('C-002', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  let invoice = issueInvoice(inv.value, []).value;
+  const payment = recordPayment(invoice, { amount: 114950, date: '2026-10-08' });
+  assert.equal(payment.ok, true);
+  invoice = payment.value;
+
+  const result = statement('C-002', [invoice], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes draft invoices', () => {
