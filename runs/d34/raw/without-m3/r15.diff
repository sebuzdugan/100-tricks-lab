+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = createCreditNote(issued.value, { amount: 50000, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Refund');
+  assert.equal(result.value.date, '2026-10-08');
+});
+
+test('createCreditNote creates credit note for partially_paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  let invoice = issueInvoice(inv.value, []).value;
+  invoice = recordPayment(invoice, { amount: 50000, date: '2026-10-08' }).value;
+
+  const result = createCreditNote(invoice, { amount: 30000, reason: 'Partial refund', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote creates credit note for paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  let invoice = issueInvoice(inv.value, []).value;
+  invoice = recordPayment(invoice, { amount: 114950, date: '2026-10-08' }).value;
+
+  const result = createCreditNote(invoice, { amount: 20000, reason: 'Goodwill refund', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
