   return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
 }
+
+/**
+ * Calculate the next free credit note number for a given year.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  const thisYearPattern = new RegExp(`^CN-${year}-(\\d{4})$`);
+  const thisYearCounters = existingNumbers
+    .map((num) => {
+      const match = thisYearPattern.exec(num);
+      return match ? parseInt(match[1], 10) : null;
+    })
+    .filter((num) => num !== null);
+
+  const maxCounter = thisYearCounters.length === 0 ? 0 : Math.max(...thisYearCounters);
+  const nextCounter = maxCounter + 1;
+
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
