+test('overdueInvoices excludes invoices with dueDate on or after asOf', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+  // dueDate = 2026-10-21
+
+  const result = overdueInvoices([issued.value], '2026-10-21');
+  assert.equal(result.length, 0);
+});
