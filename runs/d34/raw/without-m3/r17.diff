+/**
+ * Summarize VAT collected across invoices, grouped by rate.
+ * @param {Array} invoices - all invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const total = line.qty * line.unitPrice;
+      const discountPercent = line.discountPercent ?? 0;
+      const lineDiscount = roundCents(total * discountPercent / 100);
+      const lineAmount = total - lineDiscount;
+      const lineVat = roundCents(lineAmount * rate / 100);
+
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { base: 0, vat: 0 };
+      }
+      vatByRate[rate].base += lineAmount;
+      vatByRate[rate].vat += lineVat;
+    }
+  }
+
+  return Object.entries(vatByRate)
+    .map(([rate, data]) => ({
+      rate: parseInt(rate, 10),
+      base: data.base,
+      vat: data.vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
