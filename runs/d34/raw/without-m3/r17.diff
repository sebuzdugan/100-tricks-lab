+test('vatSummary returns empty array when no invoices', () => {
+  const result = vatSummary([]);
+  assert.deepEqual(result, []);
+});
+
+test('vatSummary excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const result = vatSummary([inv.value]);
+  assert.equal(result.length, 0);
+});
+
+test('vatSummary includes issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = vatSummary([issued.value]);
