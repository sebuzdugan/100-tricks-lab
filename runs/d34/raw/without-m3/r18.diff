+/**
+ * Calculate late fee on an invoice as of a given date.
+ * Late fee is 0.04% of amount due per day overdue.
+ * @param {object} invoice
+ * @param {string} asOf - YYYY-MM-DD format cutoff date
+ * @returns {number} - late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (!invoice.dueDate || asOf < invoice.dueDate || asOf === invoice.dueDate) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = roundCents(daysOverdue * due * 0.0004);
+
+  return Math.max(0, fee);
+}
