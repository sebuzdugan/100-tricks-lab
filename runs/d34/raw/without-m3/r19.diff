+
+test('exportCsv with amounts containing fractional cents (rounding)', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 12.5 }],
+  });
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  // subtotal = 950, discount = 118.75, lineAmount = 831.25, vat = 174.56
+  assert(csv.includes('118.75'));
+  assert(csv.includes('174.56'));
