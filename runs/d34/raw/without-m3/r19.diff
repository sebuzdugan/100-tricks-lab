+    ],
+  });
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  // subtotal = 950 + 1200 + 37 = 2187 euros
+  assert(csv.includes('2187.00'));
+});
