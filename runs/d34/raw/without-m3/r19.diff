+
+test('exportCsv escapes both comma and quote', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv.ok, true);
+  const invoice = inv.value;
+  invoice.customerName = 'Smith, "The Boss" Co.';
+
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('"Smith, ""The Boss"" Co."'));
+});
+
+test('exportCsv does not escape fields without special chars', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv.ok, true);
+  const invoice = inv.value;
