+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header for empty array', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header line', () => {
+  const csv = exportCsv([]);
+  assert(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv exports single draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const csv = exportCsv([inv.value]);
+  assert(csv.includes('DRAFT'));
+  assert(csv.includes('Blue Fern Bakery'));
+  assert(csv.includes('2026-10-07'));
+  assert(csv.includes('950.00'));
+});
+
+test('exportCsv exports issued invoice with number', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  assert(csv.includes('INV-2026-0001'));
+  assert(csv.includes('issued'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  assert(csv.includes('950.00')); // subtotal
+  assert(csv.includes('199.50')); // vat
+  assert(csv.includes('1149.50')); // invoice total
+});
+
+test('exportCsv includes customer name', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv.ok, true);
+
+  const csv = exportCsv([inv.value]);
+  assert(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv.ok, true);
+  const invoice = inv.value;
+  invoice.customerName = 'Smith, John';
+
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('"Smith, John"'));
+});
+
+test('exportCsv escapes customer name with double quote', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv.ok, true);
+  const invoice = inv.value;
+  invoice.customerName = 'John "Johnny" Doe';
+
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('"John ""Johnny"" Doe"'));
+});
+
+test('exportCsv shows due amount for issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  assert(csv.includes('1149.50'));
+});
+
+test('exportCsv shows due amount for partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  let invoice = issueInvoice(inv.value, []).value;
+  invoice = recordPayment(invoice, { amount: 50000, date: '2026-10-08' }).value;
+
+  const csv = exportCsv([invoice]);
+  assert(csv.includes('649.50')); // 1149.50 - 500.00
+});
+
+test('exportCsv shows zero due for paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv.ok, true);
+  let invoice = issueInvoice(inv.value, []).value;
+  invoice = recordPayment(invoice, { amount: 114950, date: '2026-10-08' }).value;
+
+  const csv = exportCsv([invoice]);
+  assert(csv.endsWith('0.00\n'));
+});
+
+test('exportCsv includes multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']);
+
+  const csv = exportCsv([issued1.value, issued2.value]);
+  assert(csv.includes('INV-2026-0001'));
+  assert(csv.includes('INV-2026-0002'));
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 4); // header + 2 invoices + trailing newline
+});
+
+test('exportCsv preserves invoice order', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv2.ok, true);
