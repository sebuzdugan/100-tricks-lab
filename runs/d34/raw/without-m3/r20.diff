+test('convert returns ok with converted amount for EUR', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert returns ok with converted amount for USD', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 10000 EUR cents * 1.085 = 10850 USD cents
+  assert.equal(result.value, 10850);
+});
+
+test('convert returns ok with converted amount for GBP', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  // 10000 EUR cents * 0.8425 = 8425 GBP cents
+  assert.equal(result.value, 8425);
+});
+
+test('convert handles fractional results with rounding', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  // 100 * 1.085 = 108.5 -> 108 or 109 (banker's rounding)
+  assert.equal(result.value, 108);
+});
