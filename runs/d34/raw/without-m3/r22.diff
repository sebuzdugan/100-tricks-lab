+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * VAT is computed per line on the amount after discount, rounded per line, then summed.
+ * Voucher is applied after VAT.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    subtotal += total;
+
+    const discountPercent = line.discountPercent ?? 0;
+    const lineDiscount = roundCents(total * discountPercent / 100);
+    const clampedLineDiscount = Math.max(0, lineDiscount);
+    discount += clampedLineDiscount;
+
+    const lineAmount = total - clampedLineDiscount;
+    const lineVat = roundCents(lineAmount * line.vatRate / 100);
+    const clampedLineVat = Math.max(0, lineVat);
+    vat += clampedLineVat;
+  }
+
+  const voucher = (invoice.voucher?.amount) ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
