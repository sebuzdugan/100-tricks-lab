+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 10, unitPrice: 9500 }), 95000);
+});
+
+test('lineTotal with qty of 1', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 50 }), 50);
+});
+
+test('lineTotal with qty of 0', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 9500 }), 0);
+});
+
+test('lineTotal with large quantities', () => {
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 5000 }), 5000000);
+});
+
+test('invoiceTotals calculates subtotal and total for single line', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 47500,
+    discount: 0,
+    vat: 9975,
+    voucher: 0,
+    total: 57475,
+  });
+});
+
+test('invoiceTotals calculates subtotal and total for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 120000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 215000,
+    discount: 0,
+    vat: 45150,
+    voucher: 0,
+    total: 260150,
+  });
+});
+
+test('invoiceTotals with multiple lines of different products', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 120000, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 37, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 218700,
+    discount: 0,
+    vat: 45483,
+    voucher: 0,
+    total: 264183,
+  });
+});
+
+test('invoiceTotals calculates discount for single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 95000,
+    discount: 9500,
+    vat: 17955,
+    voucher: 0,
+    total: 103455,
+  });
+});
+
+test('invoiceTotals with 100% discount on one line', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 120000, discountPercent: 100, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 215000,
+    discount: 120000,
+    vat: 19950,
+    voucher: 0,
+    total: 114950,
+  });
+});
+
+test('invoiceTotals with decimal discount percent', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 12.5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 95000,
+    discount: 11875,
+    vat: 17456,
+    voucher: 0,
+    total: 100581,
+  });
+});
+
+test('invoiceTotals clamps negative amounts to 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 200, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with VAT 21%', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 9500, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 950000,
+    discount: 0,
+    vat: 199500,
+    voucher: 0,
+    total: 1149500,
+  });
+});
+
+test('invoiceTotals with VAT 9%', () => {
+  const invoice = {
+    lines: [{ qty: 1000, unitPrice: 37, discountPercent: 0, vatRate: 9 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 37000,
+    discount: 0,
+    vat: 3330,
+    voucher: 0,
+    total: 40330,
+  });
+});
+
+test('invoiceTotals with VAT 0%', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 60000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 60000,
+    discount: 0,
+    vat: 0,
+    voucher: 0,
+    total: 60000,
+  });
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 37, discountPercent: 0, vatRate: 9 },
+      { qty: 1, unitPrice: 60000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 158700,
+    discount: 0,
+    vat: 20283,
+    voucher: 0,
+    total: 178983,
+  });
+});
+
+test('invoiceTotals VAT on discounted amount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 50, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 95000,
+    discount: 47500,
+    vat: 9975,
+    voucher: 0,
+    total: 57475,
+  });
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 95000,
+    discount: 0,
+    vat: 19950,
+    voucher: 10000,
+    total: 104950,
+  });
+});
+
+test('invoiceTotals voucher = 0 when no voucher applied', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals total formula: subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 5, vatRate: 21 }],
+    voucher: { code: 'SAVE5', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat - totals.voucher);
+});
+
+test('invoiceTotals with discount and voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+      { qty: 1, unitPrice: 120000, discountPercent: 20, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 215000,
+    discount: 33500,
+    vat: 38115,
+    voucher: 5000,
+    total: 214615,
+  });
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 0,
+    discount: 0,
+    vat: 0,
+    voucher: 0,
+    total: 0,
+  });
+});
