+/**
+ * Get a dashboard summary of invoices.
+ * @param {Array} invoices - all invoices
+ * @param {string} asOf - YYYY-MM-DD format cutoff date
+ * @returns {{ counts: object, outstanding: number, overdue: object, topCustomers: Array }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = {};
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] || 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      const customerId = invoice.customerId;
+      customerDue[customerId] = (customerDue[customerId] || 0) + due;
+    }
+  }
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueData = {
+    count: overdue.length,
+    amount: overdue.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: overdueData,
+    topCustomers,
+  };
+}
