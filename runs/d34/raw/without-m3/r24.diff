+test('dashboard with empty invoices', () => {
+  const result = dashboard([], '2026-10-15');
+  assert.deepEqual(result, {
+    counts: { draft: 0, issued: 0, partially_paid: 0, paid: 0 },
+    outstanding: 0,
+    overdue: { count: 0, amount: 0 },
+    topCustomers: [],
