+test('dashboard counts invoices by status', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv1.ok, true);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']);
+  assert.equal(issued2.ok, true);
+
+  const inv3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv3.ok, true);
+  let issued3 = issueInvoice(inv3.value, ['INV-2026-0001', 'INV-2026-0002']);
+  assert.equal(issued3.ok, true);
+  issued3 = recordPayment(issued3.value, { amount: 50000, date: '2026-10-08' });
+  assert.equal(issued3.ok, true);
+
+  const result = dashboard([inv1.value, issued2.value, issued3.value], '2026-10-15');
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.partially_paid, 1);
+  assert.equal(result.counts.paid, 0);
+});
