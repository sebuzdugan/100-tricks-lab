 import { formatEuros } from './money.js';
 import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
 
 /**
  * Render an invoice as plain text.
- * @param {{ number?: string, customerName: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @param {{ number?: string, customerName: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate: number }>, dueDate?: string, payments?: Array, voucher?: { code: string, amount: number } }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -17,14 +18,34 @@ export function renderInvoiceText(invoice) {
     const total = line.qty * line.unitPrice;
     const formattedUnitPrice = formatEuros(line.unitPrice);
     const formattedTotal = formatEuros(total);
-    lines.push(`${line.qty} ${line.name} ${formattedUnitPrice} ${formattedTotal}`);
+    let lineText = `${line.qty} ${line.name} ${formattedUnitPrice} ${formattedTotal}`;
+
+    if (line.discountPercent && line.discountPercent > 0) {
+      lineText += ` (-${line.discountPercent}%)`;
+    }
+
+    lines.push(lineText);
   }
 
   const totals = invoiceTotals(invoice);
+
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(totals.voucher)}`);
+  }
+
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
