+++ b/src/invoices.js
@@ -0,0 +1,59 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(dateStr);
+  if (!match) return false;
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  return date instanceof Date && !isNaN(date) && date.toISOString().startsWith(dateStr);
+}
+
+/**
+ * Create a new invoice in draft status.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: unknown }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issue date
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  // Validate lines is not empty
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate quantity
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Get product and validate SKU
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..38d0d31
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,142 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice succeeds with valid customer, date, and one line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2025-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+  assert.equal(result.value.lines[0].sku, 'LOGO-PACK');
+  assert.equal(result.value.lines[0].name, 'Logo package');
+  assert.equal(result.value.lines[0].qty, 2);
+  assert.equal(result.value.lines[0].unitPrice, 120000);
+  assert.equal(result.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice succeeds with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].sku, 'LOGO-PACK');
+  assert.equal(result.value.lines[1].sku, 'BRAND-BOOK');
+  assert.equal(result.value.lines[1].name, 'Brand guidelines document');
+  assert.equal(result.value.lines[1].qty, 2);
+});
+
+test('createInvoice fails with unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'UNKNOWN',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice fails with invalid date format', () => {
+  const tests = [
+    '2025-10-7',
+    '2025-1-07',
+    '25-10-07',
+    '10-07-2025',
+    '2025/10/07',
+    'invalid',
+    '2025-13-01',
+    '2025-02-30',
+  ];
+
+  for (const dateStr of tests) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    });
+
+    assert.equal(result.ok, false, `Should fail for date: ${dateStr}`);
+    assert.equal(result.error, 'DATE_INVALID', `Should fail with DATE_INVALID for date: ${dateStr}`);
+  }
+});
+
+test('createInvoice fails with empty lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice fails with non-array lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: null,
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice fails with invalid quantity', () => {
+  const tests = [
+    { qty: 0, desc: 'zero' },
+    { qty: -1, desc: 'negative' },
+    { qty: 1.5, desc: 'non-integer' },
+    { qty: '2', desc: 'string' },
+    { qty: null, desc: 'null' },
+  ];
+
+  for (const { qty, desc } of tests) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-10-07',
+      lines: [{ sku: 'LOGO-PACK', qty }],
+    });
+
+    assert.equal(result.ok, false, `Should fail for ${desc}`);
+    assert.equal(result.error, 'QTY_INVALID', `Should fail with QTY_INVALID for ${desc}`);
+  }
+});
+
+test('createInvoice fails with unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'UNKNOWN_SKU', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  };
+  const original = JSON.stringify(input);
+
+  createInvoice(input);
+
+  assert.equal(JSON.stringify(input), original);
+});
