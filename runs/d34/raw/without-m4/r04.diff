diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..55d64e4
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,61 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const result = nextInvoiceNumber([], '2025-10-07');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(result, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2025-0999', 'INV-2025-1000'];
+  const result = nextInvoiceNumber(existing, '2025-12-31');
+  assert.equal(result, 'INV-2025-1001');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2024-0050', 'INV-2024-0051', 'INV-2025-0001'];
+  const result = nextInvoiceNumber(existing, '2025-01-15');
+  assert.equal(result, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0100', 'INV-2026-0050'];
+  const result = nextInvoiceNumber(existing, '2025-06-01');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber works with mixed invoice numbers', () => {
+  const existing = [
+    'INV-2024-0005',
+    'INV-2025-0001',
+    'INV-2025-0003',
+    'INV-2025-0002',
+    'INV-2026-0001',
+  ];
+  const result = nextInvoiceNumber(existing, '2025-07-20');
+  assert.equal(result, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const result1 = nextInvoiceNumber([], '2025-01-01');
+  assert.equal(result1, 'INV-2025-0001');
+
+  const result2 = nextInvoiceNumber(['INV-2025-0009'], '2025-06-01');
+  assert.equal(result2, 'INV-2025-0010');
+
+  const result3 = nextInvoiceNumber(['INV-2025-0099'], '2025-12-01');
+  assert.equal(result3, 'INV-2025-0100');
+});
+
+test('nextInvoiceNumber handles out-of-order input', () => {
+  const existing = ['INV-2025-0003', 'INV-2025-0001', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existing, '2025-08-15');
+  assert.equal(result, 'INV-2025-0004');
+});
