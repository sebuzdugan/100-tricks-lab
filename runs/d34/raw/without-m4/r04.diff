--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,26 @@
+/**
+ * Get the next free invoice number for a given issue date.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {Array<string>} existingNumbers Array of invoice numbers already used
+ * @param {string} issueDate Invoice date in YYYY-MM-DD format
+ * @returns {string} Next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  // Find the highest counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterStr = num.slice(prefix.length);
+      const counter = parseInt(counterStr, 10);
+      if (!isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
