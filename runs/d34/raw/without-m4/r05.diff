+++ b/test/render.test.js
@@ -0,0 +1,174 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT when invoice has no number', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.startsWith('DRAFT\n'));
+});
+
+test('renderInvoiceText shows invoice number when present', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issueResult = issueInvoice(result.value, []);
+  assert.equal(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+
+  assert(text.startsWith('INV-2025-0001\n'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText formats single line item', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.includes('2x Logo package @ €1,200.00 = €2,400.00'));
+});
+
+test('renderInvoiceText formats multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.includes('1x Logo package @ €1,200.00 = €1,200.00'));
+  assert(text.includes('2x Brand guidelines document @ €2,450.00 = €4,900.00'));
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.endsWith('Total: €3,650.00'));
+});
+
+test('renderInvoiceText formats prices with formatEuros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // ICON-SET is 980 cents = €9.80, qty 5 = €49.00
+  assert(text.includes('5x Icon set (24 icons) @ €9.80 = €49.00'));
+  assert(text.includes('Total: €49.00'));
+});
+
+test('renderInvoiceText handles small amounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'STICKER', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // STICKER is 50 cents = €0.50, qty 10 = €5.00
+  assert(text.includes('10x Sticker sheet @ €0.50 = €5.00'));
+  assert(text.includes('Total: €5.00'));
+});
+
+test('renderInvoiceText with issued invoice shows all components', () => {
+  const createResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(createResult.ok, true);
+  const issueResult = issueInvoice(createResult.value, ['INV-2025-0001']);
+  assert.equal(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2025-0002');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert(lines[2].includes('Design work (hour)'));
+  assert(lines[3].includes('Development (hour)'));
+  assert(lines[4].startsWith('Total:'));
+});
+
+test('renderInvoiceText output has correct line structure', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  // First line: DRAFT
+  assert(lines[0] === 'DRAFT');
+  // Second line: customer name
+  assert(lines[1] === 'Northwind Studio');
+  // Third and fourth lines: line items
+  assert(lines[2].includes('Logo package'));
+  assert(lines[3].includes('Brand guidelines document'));
+  // Fifth line: total
+  assert(lines[4].startsWith('Total:'));
+  // Should be exactly 5 lines
+  assert.equal(lines.length, 5);
+});
