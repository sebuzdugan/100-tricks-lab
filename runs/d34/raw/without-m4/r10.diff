+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid YYYY-MM-DD dates', () => {
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2020-02-29'), true); // leap year
+  assert.equal(isValidDate('2000-01-01'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2025-1-01'), false);
+  assert.equal(isValidDate('2025-01-1'), false);
+  assert.equal(isValidDate('25-01-01'), false);
+  assert.equal(isValidDate('01-01-2025'), false);
+  assert.equal(isValidDate('2025/01/01'), false);
+  assert.equal(isValidDate('invalid'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects invalid calendar dates', () => {
+  assert.equal(isValidDate('2025-13-01'), false); // invalid month
+  assert.equal(isValidDate('2025-02-30'), false); // invalid day
+  assert.equal(isValidDate('2021-02-29'), false); // not a leap year
+  assert.equal(isValidDate('2025-04-31'), false); // April has 30 days
+});
+
+test('addDays adds positive number of days', () => {
+  assert.equal(addDays('2025-01-01', 1), '2025-01-02');
+  assert.equal(addDays('2025-01-01', 10), '2025-01-11');
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays subtracts negative number of days', () => {
+  assert.equal(addDays('2025-01-02', -1), '2025-01-01');
+  assert.equal(addDays('2025-02-01', -1), '2025-01-31');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays adds zero days', () => {
+  assert.equal(addDays('2025-01-15', 0), '2025-01-15');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // leap year
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01'); // not a leap year
+});
+
+test('addDays handles large day additions', () => {
+  assert.equal(addDays('2025-01-01', 365), '2026-01-01');
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01'); // 2024 is leap year
+});
+
+test('daysBetween calculates correct positive difference', () => {
+  assert.equal(daysBetween('2025-01-01', '2025-01-02'), 1);
+  assert.equal(daysBetween('2025-01-01', '2025-01-11'), 10);
+  assert.equal(daysBetween('2025-01-01', '2025-02-01'), 31);
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+});
+
+test('daysBetween calculates correct negative difference', () => {
+  assert.equal(daysBetween('2025-01-02', '2025-01-01'), -1);
+  assert.equal(daysBetween('2025-01-11', '2025-01-01'), -10);
+  assert.equal(daysBetween('2025-02-01', '2025-01-01'), -31);
+});
+
+test('daysBetween returns zero for same date', () => {
+  assert.equal(daysBetween('2025-01-01', '2025-01-01'), 0);
+  assert.equal(daysBetween('2025-12-31', '2025-12-31'), 0);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is leap year
+});
+
+test('daysBetween handles large date ranges', () => {
+  // 2020-01-01 to 2025-01-01 is 5 years
+  // 2020 is leap year: 366 days
+  // 2021-2023: 3 * 365 = 1095 days
+  // 2024 is leap year: 366 days
+  // Total: 366 + 1095 + 366 = 1827 days
+  assert.equal(daysBetween('2020-01-01', '2025-01-01'), 1827);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const start = '2025-01-15';
+  for (const n of [-100, -10, -1, 0, 1, 10, 100]) {
+    const end = addDays(start, n);
+    const diff = daysBetween(start, end);
+    assert.equal(diff, n, `addDays and daysBetween should be consistent for n=${n}`);
+  }
+});
+
+test('dates work with renderInvoiceText context', () => {
+  // Verify dates work in YYYY-MM-DD format as used in invoices
+  assert.equal(isValidDate('2025-10-07'), true);
+  assert.equal(daysBetween('2025-10-01', '2025-10-07'), 6);
+  assert.equal(addDays('2025-10-07', 5), '2025-10-12');
+});
