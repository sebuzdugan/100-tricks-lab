index 0000000..3d997e4
--- /dev/null
+++ b/src/payments.js
@@ -0,0 +1,53 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, payments?: Array, ...rest }} invoice
+ * @param {{ amount: unknown, date: string }} payment
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check invoice is issued or partially paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new invoice with payment recorded
+  const newPayments = invoice.payments ? invoice.payments.map((p) => ({ ...p })) : [];
+  newPayments.push({ amount, date });
+
+  // Determine new status
+  const newBalance = balance - amount;
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the balance due on an invoice.
+ * @param {{ payments?: Array<{ amount: number }>, ...rest }} invoice
+ * @returns {number} Balance due in cents, clamped at 0
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = invoice.payments ? invoice.payments.reduce((sum, p) => sum + p.amount, 0) : 0;
+  return Math.max(0, totals.total - paid);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
