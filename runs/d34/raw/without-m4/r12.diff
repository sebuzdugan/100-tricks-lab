+/**
+ * Calculate the due date for an invoice based on terms.
+ * @param {string} issueDate Date in YYYY-MM-DD format
+ * @param {string} terms 'NET14', 'NET30', or 'EOM'
+ * @returns {string} Due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    // Get last day of the month
+    const [year, month] = issueDate.split('-');
+    const nextMonth = parseInt(month) + 1;
+    const nextMonthYear = nextMonth > 12 ? parseInt(year) + 1 : year;
+    const nextMonthNum = nextMonth > 12 ? 1 : nextMonth;
+    const lastDayStr = `${String(nextMonthYear).padStart(4, '0')}-${String(nextMonthNum).padStart(2, '0')}-01`;
+    return addDays(lastDayStr, -1);
+  }
+}
