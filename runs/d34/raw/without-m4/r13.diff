+/**
+ * Apply a voucher to an invoice (draft only).
+ * @param {{ status: string, voucher?: object, ...rest }} invoice
+ * @param {{ code: string, amount: unknown }} voucher
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check draft status
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check no existing voucher
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
