+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns empty invoices for unknown customer', () => {
+  const result = statement('UNKNOWN', [], '2025-10-31');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement returns empty list when no invoices match customer', () => {
+  const result = statement('C-001', [], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes issued invoices within date range', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv1.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = statement('C-001', [issued.value], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2025-0001');
+  assert.equal(result.value.invoices[0].issueDate, '2025-10-07');
+  assert.equal(result.value.invoices[0].total, totals.total);
+  assert.equal(result.value.invoices[0].due, totals.total);
+  assert.equal(result.value.totalDue, totals.total);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv1.value, []);
+
+  const result = statement('C-001', [issued.value], '2025-10-14');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes invoices on asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv1.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = statement('C-001', [issued.value], '2025-10-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.totalDue, totals.total);
+});
+
+test('statement excludes draft invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const result = statement('C-001', [inv1.value], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  let invoice = issueInvoice(inv1.value, []).value;
+  const totals = invoiceTotals(invoice);
+
+  // Make partial payment
+  const payment = recordPayment(invoice, {
+    amount: Math.floor(totals.total / 2),
+    date: '2025-10-10',
+  });
+
+  const result = statement('C-001', [payment.value], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].due, Math.ceil(totals.total / 2));
+});
+
+test('statement excludes paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  let invoice = issueInvoice(inv1.value, []).value;
+  const totals = invoiceTotals(invoice);
+
+  // Pay in full
+  const payment = recordPayment(invoice, {
+    amount: totals.total,
+    date: '2025-10-10',
+  });
+
+  const result = statement('C-001', [payment.value], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement filters by customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-08',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+
+  const issued1 = issueInvoice(inv1.value, []);
+  const issued2 = issueInvoice(inv2.value, ['INV-2025-0001']);
+
+  const result = statement('C-001', [issued1.value, issued2.value], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2025-0001');
+});
+
+test('statement sorts by issueDate', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  });
+
+  const issued1 = issueInvoice(inv1.value, []);
+  const issued2 = issueInvoice(inv2.value, ['INV-2025-0001']);
+  const issued3 = issueInvoice(inv3.value, ['INV-2025-0001', 'INV-2025-0002']);
+
+  const result = statement('C-001', [issued1.value, issued2.value, issued3.value], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2025-10-05');
+  assert.equal(result.value.invoices[1].issueDate, '2025-10-10');
+  assert.equal(result.value.invoices[2].issueDate, '2025-10-15');
+});
+
+test('statement normalizes customer ID', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv1.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  // Use lowercase and spaces
+  const result = statement(' c-001 ', [issued.value], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.totalDue, totals.total);
+});
+
+test('statement calculates totalDue correctly with multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+
+  const issued1 = issueInvoice(inv1.value, []);
+  const issued2 = issueInvoice(inv2.value, ['INV-2025-0001']);
+
+  const totals1 = invoiceTotals(issued1.value);
+  const totals2 = invoiceTotals(issued2.value);
+
+  const result = statement('C-001', [issued1.value, issued2.value], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.totalDue, totals1.total + totals2.total);
+});
+
+test('statement with mixed payment states', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+
+  let issued1 = issueInvoice(inv1.value, []).value;
+  let issued2 = issueInvoice(inv2.value, ['INV-2025-0001']).value;
+
+  const totals1 = invoiceTotals(issued1);
+  const totals2 = invoiceTotals(issued2);
+
+  // Partial payment on first, full payment on second
+  issued1 = recordPayment(issued1, {
+    amount: Math.floor(totals1.total / 2),
+    date: '2025-10-08',
+  }).value;
+
+  issued2 = recordPayment(issued2, {
+    amount: totals2.total,
+    date: '2025-10-11',
+  }).value;
+
+  const result = statement('C-001', [issued1, issued2], '2025-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1); // Only partially_paid included
+  assert.equal(result.value.invoices[0].due, Math.ceil(totals1.total / 2));
+  assert.equal(result.value.totalDue, Math.ceil(totals1.total / 2));
+});
