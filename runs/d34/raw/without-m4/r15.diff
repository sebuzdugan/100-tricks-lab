+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next free credit note number for a given date.
+ * Format: CN-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {Array<string>} existingNumbers Array of invoice/credit note numbers already used
+ * @param {string} date Credit note date in YYYY-MM-DD format
+ * @returns {string} Next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+  const prefix = `CN-${year}-`;
+
+  // Find the highest counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterStr = num.slice(prefix.length);
+      const counter = parseInt(counterStr, 10);
+      if (!isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array, payments?: Array, voucher?: object }} invoice
+ * @param {{ amount: unknown, reason: string, date: string }} creditData
+ * @param {Array<string>} existingNumbers Array of existing invoice/credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check credit amount doesn't exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
