diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..f693043
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,261 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+
+test('nextCreditNoteNumber starts at 0001 for a new year', () => {
+  const result = nextCreditNoteNumber([], '2025-10-07');
+  assert.equal(result, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber increments counter for same year', () => {
+  const existing = ['CN-2025-0001', 'CN-2025-0002'];
+  const result = nextCreditNoteNumber(existing, '2025-10-15');
+  assert.equal(result, 'CN-2025-0003');
+});
+
+test('nextCreditNoteNumber restarts counter for new year', () => {
+  const existing = ['CN-2024-0050', 'CN-2025-0001'];
+  const result = nextCreditNoteNumber(existing, '2025-01-15');
+  assert.equal(result, 'CN-2025-0002');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existing = ['INV-2025-0050', 'INV-2025-0100'];
+  const result = nextCreditNoteNumber(existing, '2025-10-07');
+  assert.equal(result, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber handles mixed numbers', () => {
+  const existing = [
+    'INV-2025-0001',
+    'CN-2025-0001',
+    'INV-2025-0002',
+    'CN-2025-0002',
+    'INV-2025-0003',
+  ];
+  const result = nextCreditNoteNumber(existing, '2025-10-07');
+  assert.equal(result, 'CN-2025-0003');
+});
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const creditResult = createCreditNote(issued.value, {
+    amount: 50000,
+    reason: 'Damaged goods',
+    date: '2025-10-10',
+  }, ['INV-2025-0001']);
+
+  assert.equal(creditResult.ok, true);
+  assert.equal(creditResult.value.number, 'CN-2025-0001');
+  assert.equal(creditResult.value.invoiceNumber, 'INV-2025-0001');
+  assert.equal(creditResult.value.customerId, 'C-002');
+  assert.equal(creditResult.value.amount, 50000);
+  assert.equal(creditResult.value.reason, 'Damaged goods');
+  assert.equal(creditResult.value.date, '2025-10-10');
+});
+
+test('createCreditNote works for partially_paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  let issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  // Make partial payment
+  issued = recordPayment(issued, {
+    amount: Math.floor(totals.total / 2),
+    date: '2025-10-08',
+  }).value;
+
+  const creditResult = createCreditNote(issued, {
+    amount: 25000,
+    reason: 'Discount',
+    date: '2025-10-10',
+  }, ['INV-2025-0001']);
+
+  assert.equal(creditResult.ok, true);
+  assert.equal(creditResult.value.status, undefined); // Credit note has no status
+});
+
+test('createCreditNote works for paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  let issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  // Pay in full
+  issued = recordPayment(issued, {
+    amount: totals.total,
+    date: '2025-10-08',
+  }).value;
+
+  const creditResult = createCreditNote(issued, {
+    amount: 50000,
+    reason: 'Refund',
+    date: '2025-10-10',
+  }, ['INV-2025-0001']);
+
+  assert.equal(creditResult.ok, true);
+  assert.equal(creditResult.value.invoiceNumber, 'INV-2025-0001');
+});
+
+test('createCreditNote fails for draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const creditResult = createCreditNote(inv.value, {
+    amount: 50000,
+    reason: 'Damage',
+    date: '2025-10-10',
+  }, []);
+
+  assert.equal(creditResult.ok, false);
+  assert.equal(creditResult.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote fails with invalid amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+
+  const tests = [
+    { amount: 0, desc: 'zero' },
+    { amount: -100, desc: 'negative' },
+    { amount: 100.5, desc: 'non-integer' },
+    { amount: '50000', desc: 'string' },
+  ];
+
+  for (const { amount, desc } of tests) {
+    const creditResult = createCreditNote(issued, {
+      amount,
+      reason: 'Test',
+      date: '2025-10-10',
+    }, ['INV-2025-0001']);
+
+    assert.equal(creditResult.ok, false, `Should fail for ${desc}`);
+    assert.equal(creditResult.error, 'AMOUNT_INVALID', `Should fail with AMOUNT_INVALID for ${desc}`);
+  }
+});
+
+test('createCreditNote fails if credit exceeds invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const creditResult = createCreditNote(issued, {
+    amount: totals.total + 100000,
+    reason: 'Too much',
+    date: '2025-10-10',
+  }, ['INV-2025-0001']);
+
+  assert.equal(creditResult.ok, false);
+  assert.equal(creditResult.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const creditResult = createCreditNote(issued, {
+    amount: totals.total,
+    reason: 'Full refund',
+    date: '2025-10-10',
+  }, ['INV-2025-0001']);
+
+  assert.equal(creditResult.ok, true);
+  assert.equal(creditResult.value.amount, totals.total);
+});
+
+test('createCreditNote increments number correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+
+  const credit1 = createCreditNote(issued, {
+    amount: 50000,
+    reason: 'First',
+    date: '2025-10-10',
+  }, ['INV-2025-0001']);
+
+  const credit2 = createCreditNote(issued, {
+    amount: 25000,
+    reason: 'Second',
+    date: '2025-10-11',
+  }, ['INV-2025-0001', 'CN-2025-0001']);
+
+  assert.equal(credit1.value.number, 'CN-2025-0001');
+  assert.equal(credit2.value.number, 'CN-2025-0002');
+});
+
+test('createCreditNote with multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+
+  const issued1 = issueInvoice(inv1.value, []).value;
+  const issued2 = issueInvoice(inv2.value, ['INV-2025-0001']).value;
+
+  const credit1 = createCreditNote(issued1, {
+    amount: 50000,
+    reason: 'Damage',
+    date: '2025-10-10',
+  }, ['INV-2025-0001', 'INV-2025-0002']);
+
+  const credit2 = createCreditNote(issued2, {
+    amount: 30000,
+    reason: 'Discount',
+    date: '2025-10-11',
+  }, ['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001']);
+
+  assert.equal(credit1.value.invoiceNumber, 'INV-2025-0001');
+  assert.equal(credit1.value.number, 'CN-2025-0001');
+  assert.equal(credit2.value.invoiceNumber, 'INV-2025-0002');
+  assert.equal(credit2.value.number, 'CN-2025-0002');
+});
