+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Get a list of overdue invoices sorted by days overdue (most overdue first).
+ * @param {Array} invoices Array of invoice objects
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) => (inv.status === 'issued' || inv.status === 'partially_paid'))
+    .filter((inv) => inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
diff --git a/test/reports.test.js b/test/reports.test.js
new file mode 100644
index 0000000..7219078
--- /dev/null
+++ b/test/reports.test.js
@@ -0,0 +1,265 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns empty for no invoices', () => {
+  const result = overdueInvoices([], '2025-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty when no invoices are overdue', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+
+  // Due date is 2025-11-06, asOf is 2025-10-15, so not overdue
+  const result = overdueInvoices([issued], '2025-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices filters draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  // Draft invoice, would be overdue if it were issued
+  const result = overdueInvoices([inv.value], '2025-10-25');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices filters paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  let issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  // Pay in full
+  issued = recordPayment(issued, {
+    amount: totals.total,
+    date: '2025-10-20',
+  }).value;
+
+  const result = overdueInvoices([issued], '2025-10-25');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices filters invoices after asOf date', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+
+  // Due 2025-10-21, but asOf is 2025-10-20
+  const result = overdueInvoices([issued], '2025-10-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes issued overdue invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = overdueInvoices([issued], '2025-10-25');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2025-0001');
+  assert.equal(result[0].customerId, 'C-002');
+  assert.equal(result[0].dueDate, '2025-10-21');
+  assert.equal(result[0].daysOverdue, 4);
+  assert.equal(result[0].due, totals.total);
+});
+
+test('overdueInvoices includes partially_paid overdue invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  let issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  // Make partial payment
+  const paymentAmount = Math.floor(totals.total / 2);
+  issued = recordPayment(issued, {
+    amount: paymentAmount,
+    date: '2025-10-20',
+  }).value;
+
+  const result = overdueInvoices([issued], '2025-10-25');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2025-0001');
+  assert.equal(result[0].dueDate, '2025-10-21');
+  assert.equal(result[0].daysOverdue, 4);
+  assert.equal(result[0].due, totals.total - paymentAmount);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+
+  // Due 2025-10-15, asOf 2025-10-30 = 15 days overdue
+  const result = overdueInvoices([issued], '2025-10-30');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 15);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const issued1 = issueInvoice(inv1.value, []).value;
+  const issued2 = issueInvoice(inv2.value, ['INV-2025-0001']).value;
+
+  const result = overdueInvoices([issued2, issued1], '2025-10-30');
+
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, 'INV-2025-0001');
+  assert.equal(result[0].daysOverdue, 15);
+  assert.equal(result[1].number, 'INV-2025-0002');
+  assert.equal(result[1].daysOverdue, 11);
+});
+
+test('overdueInvoices with multiple invoices in different states', () => {
+  // Invoice 1: issued, overdue
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+
+  // Invoice 2: partially_paid, overdue
+  const inv2 = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+    terms: 'NET14',
+  });
+  let issued2 = issueInvoice(inv2.value, ['INV-2025-0001']).value;
+  const totals2 = invoiceTotals(issued2);
+  issued2 = recordPayment(issued2, {
+    amount: Math.floor(totals2.total / 3),
+    date: '2025-10-20',
+  }).value;
+
+  // Invoice 3: draft (should be filtered out)
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  // Invoice 4: paid (should be filtered out)
+  const inv4 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-09-20',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+  let issued4 = issueInvoice(inv4.value, ['INV-2025-0001', 'INV-2025-0002']).value;
+  const totals4 = invoiceTotals(issued4);
+  issued4 = recordPayment(issued4, {
+    amount: totals4.total,
+    date: '2025-10-05',
+  }).value;
+
+  // Invoice 5: issued, not yet overdue
+  const inv5 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-20',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued5 = issueInvoice(inv5.value, ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003']).value;
+
+  const result = overdueInvoices(
+    [issued1, issued2, inv3.value, issued4, issued5],
+    '2025-10-25'
+  );
+
+  // Only issued1 and issued2 should be in result
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, 'INV-2025-0001');
+  assert.equal(result[1].number, 'INV-2025-0002');
+});
+
+test('overdueInvoices handles EOM terms correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+
+  // EOM from 2025-10-15 = 2025-10-31, asOf 2025-11-01 = 1 day overdue
+  const result = overdueInvoices([issued], '2025-11-01');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2025-10-31');
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices returns empty when asOf equals dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+
+  // Due 2025-10-21, asOf 2025-10-21 = not overdue (dueDate is not before asOf)
+  const result = overdueInvoices([issued], '2025-10-21');
+  assert.deepEqual(result, []);
+});
