+/**
+ * Get a VAT summary over issued/partially_paid/paid invoices.
+ * @param {Array} invoices Array of invoice objects
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const inv of invoices) {
+    if (inv.status !== 'issued' && inv.status !== 'partially_paid' && inv.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of inv.lines) {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVat(line);
+
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { rate, base: 0, vat: 0 });
+      }
+
+      const entry = vatMap.get(rate);
+      entry.base = roundCents(entry.base + base);
+      entry.vat = roundCents(entry.vat + vat);
+    }
+  }
+
+  return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
+}
