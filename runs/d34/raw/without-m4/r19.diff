+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros with 2 decimals and a dot, no currency sign.
+ * @param {number} cents Amount in cents
+ * @returns {string} Formatted as "1234.50"
+ */
+function formatEurosForExport(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a field for CSV export: add quotes if it contains comma or quote, double any quotes.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  if (field.includes(',') || field.includes('"')) {
+    return `"${field.replace(/"/g, '""')}"`;
+  }
+  return field;
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array} invoices Array of invoice objects
+ * @returns {string} CSV content
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data rows
+  for (const inv of invoices) {
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const fields = [
+      inv.number || 'DRAFT',
+      escapeCsvField(customerName),
+      inv.issueDate,
+      inv.dueDate || '',
+      inv.status,
+      formatEurosForExport(totals.subtotal),
+      formatEurosForExport(totals.discount),
+      formatEurosForExport(totals.vat),
+      formatEurosForExport(totals.total),
+      formatEurosForExport(due),
+    ];
+
+    lines.push(fields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
