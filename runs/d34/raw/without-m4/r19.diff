+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv with empty list returns header only', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv with single issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.trim().split('\n');
+  assert.equal(lines.length, 2); // Header + 1 data row
+
+  // Check header
+  assert.equal(
+    lines[0],
+    'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'
+  );
+
+  // Check data row
+  assert(lines[1].includes('INV-2025-0001'));
+  assert(lines[1].includes('Blue Fern Bakery')); // C-002 customer name
+  assert(lines[1].includes('2025-10-07'));
+  assert(lines[1].includes('2025-10-21')); // dueDate
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  // LOGO-PACK: 120000 cents = 1200.00
+  // VAT 21%: 25200 cents = 252.00
+  // Total: 145200 cents = 1452.00
+  assert(dataLine.includes('1200.00')); // subtotal
+  assert(dataLine.includes('252.00')); // vat
+  assert(dataLine.includes('1452.00')); // total
+});
+
+test('exportCsv with multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued1 = issueInvoice(inv1.value, []).value;
+  const issued2 = issueInvoice(inv2.value, ['INV-2025-0001']).value;
+
+  const result = exportCsv([issued1, issued2]);
+
+  const lines = result.trim().split('\n');
+  assert.equal(lines.length, 3); // Header + 2 data rows
+  assert(lines[1].includes('INV-2025-0001'));
+  assert(lines[2].includes('INV-2025-0002'));
+});
+
+test('exportCsv escapes commas in customer name', () => {
+  // C-006 is "Marlow \"The Print Shop\"", which has a quote
+  const inv = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  // Customer name has quote, should be escaped
+  assert(dataLine.includes('Marlow ""The Print Shop""'));
+});
+
+test('exportCsv draft invoice shows DRAFT as number', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const result = exportCsv([inv.value]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  assert(dataLine.startsWith('DRAFT,'));
+});
+
+test('exportCsv with partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  let issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  issued = recordPayment(issued, {
+    amount: Math.floor(totals.total / 2),
+    date: '2025-10-10',
+  }).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  assert(dataLine.includes('partially_paid'));
+  // Due should be half of total
+  assert(dataLine.includes('726.')); // Approximately 726.00
+});
+
+test('exportCsv with paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  let issued = issueInvoice(inv.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  issued = recordPayment(issued, {
+    amount: totals.total,
+    date: '2025-10-10',
+  }).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  assert(dataLine.includes('paid'));
+  assert(dataLine.endsWith('0.00')); // due = 0 at end of line
+});
+
+test('exportCsv formats no discount correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  // Split by comma to find discount field
+  const fields = dataLine.split(',');
+  // Fields: number, customer, issueDate, dueDate, status, subtotal, discount, vat, total, due
+  // Index 6 is discount
+  assert.equal(fields[6], '0.00');
+});
+
+test('exportCsv with discount', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 10 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  // LOGO-PACK 120000, discount 10% = 12000 cents = 120.00
+  assert(dataLine.includes('120.00')); // discount
+});
+
+test('exportCsv with tier discount', () => {
+  // C-001 is gold tier with 5% discount
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  // LOGO-PACK 120000, tier discount 5% = 6000 cents = 60.00
+  assert(dataLine.includes('60.00')); // discount
+});
+
+test('exportCsv lines end with newline', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const result = exportCsv([issued]);
+
+  assert(result.endsWith('\n'));
+});
+
+test('exportCsv with dueDate for draft', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const result = exportCsv([inv.value]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  // Draft status still has dueDate calculated (from terms)
+  const fields = dataLine.split(',');
+  // Fields: number, customer, issueDate, dueDate, status, subtotal, discount, vat, total, due
+  // dueDate should be set to 2025-10-21 (2025-10-07 + 14 days)
+  assert.equal(fields[3], '2025-10-21'); // dueDate
+});
+
+test('exportCsv preserves field order', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const issued = issueInvoice(inv.value, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.trim().split('\n');
+  const dataLine = lines[1];
+
+  const fields = dataLine.split(',');
+  // Verify order: number, customer, issueDate, dueDate, status, subtotal, discount, vat, total, due
+  assert.equal(fields.length, 10);
+  assert(fields[0].includes('INV-')); // number
+  assert(fields[1].includes('Blue Fern')); // customer
+  assert.equal(fields[2], '2025-10-07'); // issueDate
+  assert.equal(fields[3], '2025-10-21'); // dueDate (NET14)
+  assert.equal(fields[4], 'issued'); // status
+});
