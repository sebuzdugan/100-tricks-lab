diff --git a/src/money.js b/src/money.js
index fadf486..0f02284 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,12 @@
 import { ok, fail } from './result.js';
 
+/** Exchange rates: units of that currency per euro */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +46,40 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert cents from euros to another currency.
+ * @param {number} cents Amount in euro cents
+ * @param {string} currency Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  const rate = RATES[currency];
+  if (rate === undefined) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const converted = cents * rate;
+  return ok(roundCents(converted));
+}
+
+/**
+ * Format cents as money with currency symbol for the given currency.
+ * @param {number} cents Amount in euro cents
+ * @param {string} currency Currency code (EUR, USD, GBP)
+ * @returns {string} Formatted as "€1,234.56", "$1,234.56", "£1,234.56"
+ */
+export function formatMoney(cents, currency) {
+  const rate = RATES[currency];
+  if (rate === undefined) {
+    return 'UNKNOWN';
+  }
+
+  const symbols = { EUR: '€', USD: '$', GBP: '£' };
+  const symbol = symbols[currency];
+
+  const converted = roundCents(cents * rate);
+  const sign = converted < 0 ? '-' : '';
+  const abs = Math.abs(converted);
+  const whole = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${whole}.${String(abs % 100).padStart(2, '0')}`;
+}
