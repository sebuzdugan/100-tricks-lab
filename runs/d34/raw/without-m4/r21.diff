+test('mergeCustomers removes fromId and reassigns invoices', () => {
+  const customers = listCustomers();
+
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const invoices = [inv1.value, inv2.value];
+
+  const result = mergeCustomers(customers, invoices, 'C-002', 'C-003');
+
+  assert.equal(result.ok, true);
+  assert(result.value.customers.find((c) => c.id === 'C-003'));
+  assert(!result.value.customers.find((c) => c.id === 'C-002'));
+  assert.equal(result.value.invoices[0].customerId, 'C-003');
+  assert.equal(result.value.invoices[1].customerId, 'C-003');
+});
