+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total of a single line item (qty * unitPrice, before discount).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount amount for a single line item.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} Discount amount in cents
+ */
+export function lineDiscount(line) {
+  if (!line.discountPercent) return 0;
+  return roundCents(lineTotal(line) * line.discountPercent / 100);
+}
+
+/**
+ * Calculate the VAT for a single line item (on the amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number} VAT amount in cents
+ */
+export function lineVat(line) {
+  const amountAfterDiscount = lineTotal(line) - lineDiscount(line);
+  return roundCents(amountAfterDiscount * line.vatRate / 100);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} Amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = roundCents(invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
+  const discount = roundCents(invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0));
+  const vat = roundCents(invoice.lines.reduce((sum, line) => sum + lineVat(line), 0));
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, roundCents(subtotal - discount + vat - voucher));
+
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..1f04b97
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,255 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty * unitPrice', () => {
+  const line = { qty: 2, unitPrice: 50000 };
+  assert.equal(lineTotal(line), 100000);
+});
+
+test('lineTotal with single quantity', () => {
+  const line = { qty: 1, unitPrice: 120000 };
+  assert.equal(lineTotal(line), 120000);
+});
+
+test('lineTotal rounds correctly', () => {
+  const line = { qty: 3, unitPrice: 33333 };
+  assert.equal(lineTotal(line), 99999);
+});
+
+test('lineDiscount returns 0 when no discount', () => {
+  const line = { qty: 1, unitPrice: 100000 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with discount percent', () => {
+  const line = { qty: 1, unitPrice: 100000, discountPercent: 10 };
+  // 100000 * 10 / 100 = 10000
+  assert.equal(lineDiscount(line), 10000);
+});
+
+test('lineDiscount with multiple items and discount', () => {
+  const line = { qty: 2, unitPrice: 50000, discountPercent: 20 };
+  // lineTotal = 100000, discount = 100000 * 20 / 100 = 20000
+  assert.equal(lineDiscount(line), 20000);
+});
+
+test('lineDiscount with small percentage', () => {
+  const line = { qty: 1, unitPrice: 100000, discountPercent: 2.5 };
+  // 100000 * 2.5 / 100 = 2500
+  assert.equal(lineDiscount(line), 2500);
+});
+
+test('lineDiscount rounds correctly', () => {
+  const line = { qty: 1, unitPrice: 123456, discountPercent: 5 };
+  // 123456 * 5 / 100 = 6172.8 → 6173
+  assert.equal(lineDiscount(line), 6173);
+});
+
+test('lineVat with 21% rate', () => {
+  const line = { qty: 1, unitPrice: 100000, vatRate: 21 };
+  // 100000 * 21 / 100 = 21000
+  assert.equal(lineVat(line), 21000);
+});
+
+test('lineVat with 9% rate', () => {
+  const line = { qty: 1, unitPrice: 100000, vatRate: 9 };
+  // 100000 * 9 / 100 = 9000
+  assert.equal(lineVat(line), 9000);
+});
+
+test('lineVat with 0% rate', () => {
+  const line = { qty: 1, unitPrice: 100000, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat applied after discount', () => {
+  const line = { qty: 1, unitPrice: 100000, discountPercent: 10, vatRate: 21 };
+  // lineTotal = 100000, discount = 10000, amountAfterDiscount = 90000
+  // vat = 90000 * 21 / 100 = 18900
+  assert.equal(lineVat(line), 18900);
+});
+
+test('lineVat with multiple items', () => {
+  const line = { qty: 2, unitPrice: 50000, vatRate: 21 };
+  // lineTotal = 100000, vat = 100000 * 21 / 100 = 21000
+  assert.equal(lineVat(line), 21000);
+});
+
+test('invoiceTotals with single line no discount no vat', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100000, vatRate: 0 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 100000);
+});
+
+test('invoiceTotals with single line with vat', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100000, vatRate: 21 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 121000);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100000, discountPercent: 10, vatRate: 21 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // subtotal = 100000, discount = 10000, vat = (100000 - 10000) * 0.21 = 18900
+  // total = 100000 - 10000 + 18900 = 108900
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 18900);
+  assert.equal(totals.total, 108900);
+});
+
+test('invoiceTotals with multiple lines different vat', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100000, vatRate: 21 },
+      { qty: 1, unitPrice: 50000, vatRate: 9 },
+      { qty: 1, unitPrice: 25000, vatRate: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // subtotal = 175000
+  // vat = 100000 * 0.21 + 50000 * 0.09 + 25000 * 0 = 21000 + 4500 = 25500
+  // total = 175000 + 25500 = 200500
+  assert.equal(totals.subtotal, 175000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 25500);
+  assert.equal(totals.total, 200500);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100000, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 10000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // subtotal = 100000, vat = 21000, voucher = 10000
+  // total = 100000 + 21000 - 10000 = 111000
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.voucher, 10000);
+  assert.equal(totals.total, 111000);
+});
+
+test('invoiceTotals clamps total at 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 50000, vatRate: 21 }],
+    voucher: { code: 'LARGE', amount: 100000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // subtotal = 50000, vat = 10500, total before voucher = 60500
+  // total = 60500 - 100000 = -39500 → clamped to 0
+  assert.equal(totals.subtotal, 50000);
+  assert.equal(totals.vat, 10500);
+  assert.equal(totals.voucher, 100000);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with multiple lines and discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 100000, discountPercent: 5, vatRate: 21 },
+      { qty: 1, unitPrice: 50000, discountPercent: 10, vatRate: 9 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: subtotal = 200000, discount = 10000, vat = 190000 * 0.21 = 39900
+  // Line 2: subtotal = 50000, discount = 5000, vat = 45000 * 0.09 = 4050
+  // totals: subtotal = 250000, discount = 15000, vat = 43950, total = 250000 - 15000 + 43950 = 278950
+  assert.equal(totals.subtotal, 250000);
+  assert.equal(totals.discount, 15000);
+  assert.equal(totals.vat, 43950);
+  assert.equal(totals.total, 278950);
+});
+
+test('invoiceTotals returns object with all fields', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100000, vatRate: 21 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert(totals.hasOwnProperty('subtotal'));
+  assert(totals.hasOwnProperty('discount'));
+  assert(totals.hasOwnProperty('vat'));
+  assert(totals.hasOwnProperty('voucher'));
+  assert(totals.hasOwnProperty('total'));
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('lineTotal works with fractional unitPrice', () => {
+  const line = { qty: 3, unitPrice: 333.33 };
+  // 3 * 333.33 = 999.99 rounded
+  const result = lineTotal(line);
+  assert.equal(result, Math.round(999.99));
+});
+
+test('invoiceTotals preserves rounding through aggregation', () => {
+  // Test that using invoiceTotals gives same result as manual calculation
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 123456, discountPercent: 7.5, vatRate: 21 },
+      { qty: 2, unitPrice: 54321, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // Manual calculation
+  const line1Total = 123456;
+  const line1Discount = Math.round(123456 * 7.5 / 100);
+  const line1Vat = Math.round((123456 - line1Discount) * 21 / 100);
+
+  const line2Total = 108642;
+  const line2Discount = 0;
+  const line2Vat = Math.round(108642 * 9 / 100);
+
+  const expectedSubtotal = line1Total + line2Total;
+  const expectedDiscount = line1Discount + line2Discount;
+  const expectedVat = line1Vat + line2Vat;
+
+  assert.equal(totals.subtotal, expectedSubtotal);
+  assert.equal(totals.discount, expectedDiscount);
+  assert.equal(totals.vat, expectedVat);
+});
