diff --git a/src/totals.js b/src/totals.js
index d43bf40..1379454 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -10,17 +10,39 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount amount for a single line item.
+ * Calculate the line discount (before bulk discount).
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
- * @returns {number} Discount amount in cents
+ * @returns {number} Line discount amount in cents
  */
-export function lineDiscount(line) {
+function lineDiscountAmount(line) {
   if (!line.discountPercent) return 0;
   return roundCents(lineTotal(line) * line.discountPercent / 100);
 }
 
 /**
- * Calculate the VAT for a single line item (on the amount after discount).
+ * Calculate the bulk discount (2.5% for 10+ units, applied after line discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} Bulk discount amount in cents
+ */
+function bulkDiscountAmount(line) {
+  if (line.qty < 10) return 0;
+  const amountAfterLineDiscount = lineTotal(line) - lineDiscountAmount(line);
+  return roundCents(amountAfterLineDiscount * 2.5 / 100);
+}
+
+/**
+ * Calculate the discount amount for a single line item (line discount + bulk discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} Total discount amount in cents
+ */
+export function lineDiscount(line) {
+  const lineDisc = lineDiscountAmount(line);
+  const bulkDisc = bulkDiscountAmount(line);
+  return roundCents(lineDisc + bulkDisc);
+}
+
+/**
+ * Calculate the VAT for a single line item (on the amount after all discounts).
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
  * @returns {number} VAT amount in cents
  */
