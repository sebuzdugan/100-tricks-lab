+test('dashboard with empty invoices', () => {
+  const result = dashboard([], '2025-10-15');
+
+  assert.deepEqual(result.counts, { draft: 0, issued: 0, partially_paid: 0, paid: 0 });
+  assert.equal(result.outstanding, 0);
+  assert.deepEqual(result.overdue, { count: 0, amount: 0 });
+  assert.deepEqual(result.topCustomers, []);
+});
+
+test('dashboard counts invoices by status', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issued2 = issueInvoice(inv2.value, []).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  let issued3 = issueInvoice(inv3.value, ['INV-2025-0001']).value;
+  const totals3 = invoiceTotals(issued3);
+  issued3 = recordPayment(issued3, {
+    amount: Math.floor(totals3.total / 2),
+    date: '2025-10-10',
+  }).value;
+
+  const result = dashboard([inv1.value, issued2, issued3], '2025-10-15');
+
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.partially_paid, 1);
+  assert.equal(result.counts.paid, 0);
+});
