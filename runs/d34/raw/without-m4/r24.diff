+/**
+ * Generate a dashboard with key metrics.
+ * @param {Array} invoices Array of invoice objects
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const inv of invoices) {
+    counts[inv.status] = (counts[inv.status] || 0) + 1;
+  }
+
+  // Calculate outstanding amount (issued or partially_paid)
+  let outstanding = 0;
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      outstanding += balanceDue(inv);
+    }
+  }
+
+  // Get overdue invoices
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue.reduce((sum, inv) => sum + inv.due, 0);
+
+  // Get top customers by amount due
+  const customerDue = new Map();
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const customerId = inv.customerId;
+      const due = balanceDue(inv);
+      customerDue.set(customerId, (customerDue.get(customerId) || 0) + due);
+    }
+  }
+
+  const topCustomers = Array.from(customerDue.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
