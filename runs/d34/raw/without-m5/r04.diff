+/**
+ * Issue a draft invoice, assigning it a number and changing its status to 'issued'.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, number?: string }} invoice
+ * @param {string[]} existingNumbers - Array of already-issued invoice numbers
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    number,
+    status: 'issued',
+    lines: invoice.lines,
+  });
+}
