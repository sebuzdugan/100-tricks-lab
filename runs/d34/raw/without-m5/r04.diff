diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..9322e16
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,58 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for empty list', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber returns 0002 when 0001 exists', () => {
+  const number = nextInvoiceNumber(['INV-2026-0001'], '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles multiple existing numbers', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-0999', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const numbers = ['INV-2025-0100', 'INV-2025-0099'];
+  const number = nextInvoiceNumber(numbers, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const numbers = Array.from({ length: 999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber works when numbers are out of order', () => {
+  const numbers = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0010', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber ignores invalid counter formats', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-abc', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber extracts year from issueDate', () => {
+  const numbers = [];
+  const number1 = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number1, 'INV-2026-0001');
+
+  const number2 = nextInvoiceNumber(numbers, '2025-12-25');
+  assert.equal(number2, 'INV-2025-0001');
+});
