+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert(text.includes('DRAFT'));
+  assert(text.includes('Northwind Studio'));
+  assert(text.includes('5 × Design work (hour)'));
+  assert(text.includes('€85.00'));
+  assert(text.includes('€425.00'));
+  assert(text.includes('Total: €425.00'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = {
+    customerId: 'C-002',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert(text.includes('INV-2026-0001'));
+  assert(text.includes('Blue Fern Bakery'));
+  assert(text.includes('Logo package'));
+  assert(text.includes('€1,200.00'));
+  assert(text.includes('Total: €1,200.00'));
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const invoice = {
+    customerId: 'C-001',
+    number: 'INV-2026-0005',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 3, unitPrice: 9500, vatRate: 21 },
+      { sku: 'COPY-HOUR', name: 'Copywriting (hour)', qty: 2, unitPrice: 6000, vatRate: 21 },
+    ],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0005');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert(lines[2].includes('5 × Design work (hour)'));
+  assert(lines[2].includes('€425.00'));
+  assert(lines[3].includes('3 × Development (hour)'));
+  assert(lines[3].includes('€285.00'));
+  assert(lines[4].includes('2 × Copywriting (hour)'));
+  assert(lines[4].includes('€120.00'));
+  assert.equal(lines[5], 'Total: €830.00');
+});
+
+test('renderInvoiceText formats all amounts as euros', () => {
+  const invoice = {
+    customerId: 'C-001',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 10, unitPrice: 980, vatRate: 21 },
+      { sku: 'STICKER', name: 'Sticker sheet', qty: 250, unitPrice: 50, vatRate: 21 },
+    ],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert(text.includes('€9.80'));
+  assert(text.includes('€98.00'));
+  assert(text.includes('€0.50'));
+  assert(text.includes('€125.00'));
+  assert(text.includes('Total: €223.00'));
+});
+
+test('renderInvoiceText handles single small amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'PHOTO-LIC', name: 'Stock photo licence', qty: 5, unitPrice: 996, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert(text.includes('€9.96'));
+  assert(text.includes('€49.80'));
+});
+
+test('renderInvoiceText handles large amounts', () => {
+  const invoice = {
+    customerId: 'C-008',
+    number: 'INV-2026-0100',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'BRAND-BOOK', name: 'Brand guidelines document', qty: 5, unitPrice: 245000, vatRate: 21 },
