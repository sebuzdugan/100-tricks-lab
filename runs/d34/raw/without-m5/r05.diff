+
+test('renderInvoiceText returns CUSTOMER_NOT_FOUND for invalid customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('renderInvoiceText uses DRAFT when invoice has no number', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const firstLine = text.split('\n')[0];
+  assert.equal(firstLine, 'DRAFT');
+});
+
+test('renderInvoiceText outputs line format correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '5 × Design work (hour) @ €85.00 = €425.00');
+  assert.equal(lines[3], 'Total: €425.00');
+});
+
+test('renderInvoiceText shows line totals correctly for different quantities', () => {
+  const invoice = {
+    customerId: 'C-001',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'PRINT-A4', name: 'Printed flyer A4 (each)', qty: 100, unitPrice: 37, vatRate: 9 },
+    ],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert(text.includes('100 × Printed flyer A4 (each)'));
+  assert(text.includes('€0.37'));
+  assert(text.includes('€37.00'));
+  assert(text.includes('Total: €37.00'));
+});
