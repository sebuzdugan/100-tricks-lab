+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const customer = customerResult.value;
+  const invoiceNumber = invoice.number ?? 'DRAFT';
+
+  const lines = [];
+  lines.push(invoiceNumber);
+  lines.push(customer.name);
+
+  for (const line of invoice.lines) {
+    const lineTotal = line.qty * line.unitPrice;
+    lines.push(
+      `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lineTotal)}`
+    );
+  }
+
+  const total = invoice.lines.reduce((sum, line) => sum + line.qty * line.unitPrice, 0);
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return ok(lines.join('\n'));
+}
