+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ total?: number, payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
+
+/**
+ * Record a payment on an issued invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, number?: string, lines: Array, payments?: Array }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate invoice status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const owed = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Add payment
+  const newPayments = [...(invoice.payments ?? []), { amount, date }];
+  const totalPaid = newPayments.reduce((sum, p) => sum + p.amount, 0);
+  const totals = invoiceTotals(invoice);
+
+  // Determine new status
+  let newStatus = 'issued';
+  if (totalPaid >= totals.total) {
+    newStatus = 'paid';
+  } else if (totalPaid > 0) {
+    newStatus = 'partially_paid';
+  }
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    number: invoice.number,
+    status: newStatus,
+    lines: invoice.lines,
+    payments: newPayments,
+  });
+}
