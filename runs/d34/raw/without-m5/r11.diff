+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue returns total when no payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const due = balanceDue(invoice);
+  const expectedTotal = 425 * 100 + Math.round(425 * 100 * 0.21);
+  assert.equal(due, expectedTotal);
+});
+
+test('balanceDue subtracts payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    payments: [{ amount: 20000, date: '2026-10-08' }],
+  };
+
+  const due = balanceDue(invoice);
+  const expectedTotal = 425 * 100 + Math.round(425 * 100 * 0.21);
+  assert.equal(due, expectedTotal - 20000);
+});
+
+test('balanceDue returns 0 when fully paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+    payments: [{ amount: 8500, date: '2026-10-08' }],
+  };
+
+  assert.equal(balanceDue(invoice), 0);
+});
+
+test('recordPayment adds payment to issued invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 5000);
+  assert.equal(result.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment changes status to partially_paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment changes status to paid when fully paid', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 8500, date: '2026-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment accepts multiple payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result1 = recordPayment(invoice, { amount: 3000, date: '2026-10-08' });
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.status, 'partially_paid');
+
+  const result2 = recordPayment(result1.value, { amount: 7000, date: '2026-10-09' });
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.payments.length, 2);
+  assert.equal(result2.value.status, 'paid');
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment rejects payment on paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+    payments: [{ amount: 8500, date: '2026-10-08' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 1000, date: '2026-10-09' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment accepts payment on partially_paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }],
+    payments: [{ amount: 3000, date: '2026-10-08' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 7000, date: '2026-10-09' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment rejects invalid date', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 5000, date: '10/08/2026' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('recordPayment rejects negative amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: -1000, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects zero amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 0, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 5000.5, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
