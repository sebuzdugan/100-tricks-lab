+
+test('recordPayment rejects overpayment with existing payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }],
+    payments: [{ amount: 6000, date: '2026-10-08' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 5000, date: '2026-10-09' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment preserves invoice data', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 10 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.number, 'INV-2026-0001');
+  assert.deepEqual(result.value.lines, invoice.lines);
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+  recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('recordPayment handles complex invoice with discount and VAT', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
