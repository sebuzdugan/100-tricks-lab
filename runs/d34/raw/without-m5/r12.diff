@@ -34,3 +34,35 @@ export function daysBetween(a, b) {
   const ms = dateB.getTime() - dateA.getTime();
   return Math.floor(ms / (1000 * 60 * 60 * 24));
 }
+
+/**
+ * Get the last day of the month for a given date (in UTC).
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function lastDayOfMonth(date) {
+  const d = new Date(date + 'T00:00:00Z');
+  const year = d.getUTCFullYear();
+  const month = d.getUTCMonth();
+  const lastDay = new Date(Date.UTC(year, month + 1, 0));
+  return lastDay.toISOString().substring(0, 10);
+}
+
+/**
+ * Calculate the due date based on payment terms (in UTC).
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @param {string} terms - Payment terms: 'NET14', 'NET30', or 'EOM'
+ * @returns {string | null}
+ */
+export function calculateDueDate(issueDate, terms) {
+  switch (terms) {
+    case 'NET14':
+      return addDays(issueDate, 14);
+    case 'NET30':
+      return addDays(issueDate, 30);
+    case 'EOM':
+      return lastDayOfMonth(issueDate);
+    default:
+      return null;
+  }
+}
