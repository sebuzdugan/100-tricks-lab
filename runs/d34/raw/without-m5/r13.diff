+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, voucher?: object }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Only on draft invoices
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Check if voucher already exists
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    dueDate: invoice.dueDate,
+    terms: invoice.terms,
+    status: invoice.status,
+    lines: invoice.lines,
+    voucher: { code, amount },
+  });
+}
