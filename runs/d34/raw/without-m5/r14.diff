+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement listing their issued/partially paid invoices.
+ * @param {string} customerId
+ * @param {Array} invoices - All invoices to filter from
+ * @param {string} asOf - Statement date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize and validate customer
+  const normalizedCustomerId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer with relevant statuses and dates
+  const customerInvoices = invoices
+    .filter(
+      (inv) =>
+        normalizeId(inv.customerId) === normalizedCustomerId &&
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.issueDate <= asOf
+    )
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: inv.total ?? invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = customerInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: customerInvoices,
+    totalDue,
+  });
+}
+
+// Import here to avoid circular dependency issues
+import { invoiceTotals } from './invoices.js';
