+test('statement returns empty list for customer with no invoices', () => {
+  const invoices = [];
+  const result = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
