+import { ok, fail } from './result.js';
+import { nextCreditNoteNumber } from './numbering.js';
+import { isValidDate } from './dates.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Create a credit note for a refund on an issued invoice.
+ * @param {{ customerId: string, issueDate: string, number: string, status: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} input
+ * @param {string[]} existingNumbers - Array of existing invoice and credit note numbers
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate status: must be issued, partially_paid, or paid
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date format
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount: must be positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate amount doesn't exceed invoice total
+  const invoiceTotal = invoiceTotals(invoice).total;
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
