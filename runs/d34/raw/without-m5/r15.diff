+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote returns ok with credit note details', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = createCreditNote(invoice, { amount: 4000, reason: 'Partial refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 4000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2026-10-08');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = createCreditNote(invoice, { amount: 4000, reason: 'Partial refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote accepts issued invoices', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    number: 'INV-2026-0001',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
