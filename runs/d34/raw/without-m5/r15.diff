 }
+
+/**
+ * Generate the next credit note number for a given date.
+ * Format: CN-<year>-<counter>, where counter is 4 digits zero-padded.
+ * Counter starts at 0001 and resets every year.
+ * @param {string[]} existingNumbers - Array of already-used numbers (invoices and credit notes)
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return Number.isInteger(Number(counter)) ? Number(counter) : 0;
+    })
+    .filter((num) => num > 0);
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
