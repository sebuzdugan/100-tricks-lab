index 0000000..9ef30b3
--- /dev/null
+++ b/src/reports.js
@@ -0,0 +1,21 @@
+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Generate a report of invoices that are overdue.
+ * @param {Array} invoices - All invoices to check
+ * @param {string} asOf - Reference date in YYYY-MM-DD format
+ * @returns {Array} Array of overdue invoices sorted by daysOverdue (most overdue first)
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) => (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
