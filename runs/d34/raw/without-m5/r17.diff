+        { sku: 'BOOK', name: 'Book', qty: 5, unitPrice: 2000, vatRate: 6, discountPercent: 0 },
+        { sku: 'EXEMPT', name: 'Exempt item', qty: 2, unitPrice: 5000, vatRate: 0, discountPercent: 0 },
+      ],
+    },
+  ];
+
+  const result = vatSummary(invoices);
+  assert.equal(result.length, 3);
+  assert.equal(result[0].rate, 21);
+  assert.equal(result[1].rate, 6);
+  assert.equal(result[2].rate, 0);
+
+  // 21% VAT: 100000 * 0.95 = 95000 base, VAT = 95000 * 0.21 = 19950
+  assert.equal(result[0].base, 95000);
+  assert.equal(result[0].vat, 19950);
+
+  // 6% VAT: 10000 base, VAT = 10000 * 0.06 = 600
+  assert.equal(result[1].base, 10000);
+  assert.equal(result[1].vat, 600);
+
+  // 0% VAT: 10000 base, VAT = 0
+  assert.equal(result[2].base, 10000);
+  assert.equal(result[2].vat, 0);
+});
