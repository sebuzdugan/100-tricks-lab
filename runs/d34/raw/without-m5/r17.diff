+/**
+ * Generate a VAT summary across all invoices.
+ * @param {Array} invoices - All invoices to summarize
+ * @returns {Array} Array of { rate, base, vat } sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate ?? 0;
+        const lt = lineTotal(line);
+        const discount = roundCents((lt * (line.discountPercent ?? 0)) / 100);
+        const base = lt - discount;
+        const vat = roundCents((base * rate) / 100);
+
+        if (!vatByRate[rate]) {
+          vatByRate[rate] = { base: 0, vat: 0 };
+        }
+        vatByRate[rate].base += base;
+        vatByRate[rate].vat += vat;
+      });
+    });
+
+  return Object.entries(vatByRate)
+    .map(([rate, values]) => ({
+      rate: Number(rate),
+      base: values.base,
+      vat: values.vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
