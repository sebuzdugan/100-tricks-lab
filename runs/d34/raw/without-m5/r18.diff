+/**
+ * Calculate the late fee for an invoice.
+ * Late fee is 0.04% of amount due per day overdue, clamped at 0 if not overdue.
+ * @param {{ dueDate: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - Reference date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents
+ */
+export function lateFee(invoice, asOf) {
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  const fee = roundCents((due * daysOverdue * 0.04) / 100);
+
+  return fee;
+}
