+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Escape a field value for CSV: wrap in quotes if it contains comma/quote, double internal quotes.
+ * @param {string} value
+ * @returns {string}
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Format cents as euros with 2 decimals and dot separator.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatCents(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices - Array of invoices to export
+ * @returns {string} CSV formatted string
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data rows
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number,
+      escapeCsvField(customerName),
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatCents(totals.subtotal),
+      formatCents(totals.discount),
+      formatCents(totals.vat),
+      formatCents(totals.total),
+      formatCents(due),
+    ];
+
+    lines.push(fields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
