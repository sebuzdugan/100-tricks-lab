+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns CSV string for empty invoices', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header line', () => {
+  const result = exportCsv([]);
+  assert.ok(result.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoices = [
+    {
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      dueDate: '2026-11-06',
+      number: 'INV-2026-0001',
+      status: 'issued',
+      lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+    },
+  ];
+
+  const result = exportCsv(invoices);
+  const lines = result.trim().split('\n');
+  assert.equal(lines.length, 2);
+  assert.ok(lines[1].includes('INV-2026-0001'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+});
