@@ -1,5 +1,14 @@
 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +48,45 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount in euro cents to another currency's cents.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  if (currency === 'EUR') {
+    return ok(cents);
+  }
+
+  const euros = cents / 100;
+  const otherCurrency = euros * RATES[currency];
+  const otherCents = roundCents(otherCurrency * 100);
+  return ok(otherCents);
+}
+
+/**
+ * Format cents as money in a given currency.
+ * @param {number} cents - Amount in cents of the given currency
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const euros = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  let symbol;
+  if (currency === 'USD') {
+    symbol = '$';
+  } else if (currency === 'GBP') {
+    symbol = '£';
+  } else {
+    symbol = '€';
+  }
+  return `${sign}${symbol}${euros}.${String(abs % 100).padStart(2, '0')}`;
+}
