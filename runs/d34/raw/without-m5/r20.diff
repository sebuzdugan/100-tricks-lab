+
+// Currency conversion tests
+
+test('RATES are exported', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert returns euro cents unchanged for EUR currency', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert returns USD cents for USD currency', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 10000 EUR cents = 100 EUR, 100 * 1.085 = 108.5 USD = 10850 USD cents
+  assert.equal(result.value, 10850);
+});
+
+test('convert returns GBP cents for GBP currency', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  // 10000 EUR cents = 100 EUR, 100 * 0.8425 = 84.25 GBP = 8425 GBP cents
+  assert.equal(result.value, 8425);
+});
+
+test('convert handles small amounts', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  // 100 EUR cents = 1 EUR, 1 * 1.085 = 1.085 USD = 108.5 USD cents
+  // 108.5 rounds to 108 (banker's rounding, half to even, 108 is even)
+  assert.equal(result.value, 108);
+});
+
+test('convert handles zero', () => {
+  const result = convert(0, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert rejects unknown currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert handles negative amounts', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -10850);
+});
+
+test('convert uses banker\'s rounding', () => {
+  // Test with amount that has a .5 fraction
+  const result = convert(10050, 'GBP');
+  assert.equal(result.ok, true);
+  // 10050 EUR cents = 100.5 EUR, 100.5 * 0.8425 = 84.67125 GBP = 8467.125 GBP cents
+  // 8467.125 rounds to 8467 (banker's rounding, half to even)
+  assert.equal(result.value, 8467);
+});
+
