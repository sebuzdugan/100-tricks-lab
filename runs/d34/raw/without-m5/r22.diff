@@ -0,0 +1,243 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with single quantity', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal with large amounts', () => {
+  const line = { qty: 100, unitPrice: 50000 };
+  assert.equal(lineTotal(line), 5000000);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('invoiceTotals returns correct structure', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.ok('subtotal' in result);
+  assert.ok('discount' in result);
+  assert.ok('vat' in result);
+  assert.ok('voucher' in result);
+  assert.ok('total' in result);
+});
+
+test('invoiceTotals with single line no discount no VAT', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 8500);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 8500);
+});
+
+test('invoiceTotals with VAT', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 8500);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 1785);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 10285);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 1000);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 9000);
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 1000);
+  assert.equal(result.vat, 1890);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 10890);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'PROMO', amount: 2000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 2000);
+  assert.equal(result.total, 8000);
+});
+
+test('invoiceTotals clamps total at 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'HUGE', amount: 5000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 1000);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 },
+      { qty: 10, unitPrice: 10000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 42500 + 100000);
+  assert.equal(result.total, 142500);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 5000, discountPercent: 0, vatRate: 6 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 8500 + 5000);
+  assert.equal(result.vat, 1785 + 300);
+  assert.equal(result.total, 13500 + 2085);
+});
+
+test('invoiceTotals with default discountPercent', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 0);
+});
+
+test('invoiceTotals with default vatRate', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.vat, 0);
+});
+
+test('invoiceTotals without voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 10000);
+});
+
+test('invoiceTotals with complex scenario', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, discountPercent: 5, vatRate: 21 },
+      { qty: 5, unitPrice: 2000, discountPercent: 0, vatRate: 6 },
+    ],
+    voucher: { code: 'SUMMER', amount: 5000 },
+  };
+  const result = invoiceTotals(invoice);
+  // Line 1: 10 * 10000 = 100000, discount = 5000, after discount = 95000, VAT = 19950, subtotal = 100000
+  // Line 2: 5 * 2000 = 10000, discount = 0, after discount = 10000, VAT = 600, subtotal = 10000
+  // Total VAT = 19950 + 600 = 20550
+  // Total discount = 5000
+  // Total = 100000 + 10000 - 5000 + 20550 - 5000 = 120550
+  assert.equal(result.subtotal, 110000);
+  assert.equal(result.discount, 5000);
+  assert.equal(result.vat, 20550);
+  assert.equal(result.voucher, 5000);
+  assert.equal(result.total, 120550);
+});
+
+test('invoiceTotals with rounding', () => {
+  const invoice = {
+    lines: [{ qty: 3, unitPrice: 333, discountPercent: 33, vatRate: 17 }],
+  };
+  const result = invoiceTotals(invoice);
+  // 3 * 333 = 999, discount = 329.67 -> 330, after discount = 669, VAT = 113.73 -> 114
+  assert.equal(result.subtotal, 999);
+  assert.equal(result.discount, 330);
+  assert.equal(result.vat, 114);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 0);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals VAT calculation is per-line', () => {
+  // Test that VAT is calculated per line, not on the total discount
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 20, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  // Line: 10000, discount = 2000, after discount = 8000, VAT = 1680
+  assert.equal(result.discount, 2000);
+  assert.equal(result.vat, 1680);
+  assert.equal(result.total, 9680);
+});
+
+test('invoiceTotals with large numbers', () => {
+  const invoice = {
+    lines: [{ qty: 1000, unitPrice: 100000, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 100000000);
+  assert.equal(result.total, 100000000);
+});
+
+test('invoiceTotals with small amounts', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 1);
+  assert.equal(result.total, 1);
+});
+
+test('invoiceTotals does not mutate invoice', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 0 }],
+  };
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+  invoiceTotals(invoice);
+  assert.deepEqual(invoice, invoiceCopy);
+});
