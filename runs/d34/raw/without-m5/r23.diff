diff --git a/src/totals.js b/src/totals.js
index 5d8e058..300ea3c 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -23,10 +23,18 @@ export function invoiceTotals(invoice) {
     const lt = lineTotal(line);
     const disc = roundCents((lt * (line.discountPercent ?? 0)) / 100);
     const afterDiscount = lt - disc;
-    const v = roundCents((afterDiscount * (line.vatRate ?? 0)) / 100);
+
+    // Apply bulk discount (2.5%) if qty >= 10, on amount after line discount
+    let bulkDisc = 0;
+    if (line.qty >= 10) {
+      bulkDisc = roundCents((afterDiscount * 2.5) / 100);
+    }
+    const afterBulkDiscount = afterDiscount - bulkDisc;
+
+    const v = roundCents((afterBulkDiscount * (line.vatRate ?? 0)) / 100);
 
     subtotal += lt;
-    discount += disc;
+    discount += disc + bulkDisc;
     vat += v;
   }
 
