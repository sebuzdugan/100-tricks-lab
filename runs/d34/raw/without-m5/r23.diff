 test('invoiceTotals with small amounts', () => {
@@ -241,3 +250,210 @@ test('invoiceTotals does not mutate invoice', () => {
   invoiceTotals(invoice);
   assert.deepEqual(invoice, invoiceCopy);
 });
+
+// Bulk discount tests
+
+test('invoiceTotals with bulk discount (qty >= 10)', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 10 * 1000 = 10000
+  // Line discount = 0
+  // After line discount = 10000
+  // Bulk discount = 10000 * 2.5 / 100 = 250
+  // After bulk discount = 9750
+  // VAT = 0
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 250);
+  assert.equal(result.vat, 0);
+  assert.equal(result.total, 9750);
+});
+
+test('invoiceTotals without bulk discount (qty < 10)', () => {
+  const invoice = {
+    lines: [{ qty: 9, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 9 * 1000 = 9000
+  // Line discount = 0
+  // Bulk discount = 0 (qty < 10)
+  // VAT = 0
+  assert.equal(result.subtotal, 9000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.total, 9000);
+});
+
+test('invoiceTotals with line discount + bulk discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 5, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 10 * 1000 = 10000
+  // Line discount = 10000 * 5 / 100 = 500
+  // After line discount = 9500
+  // Bulk discount = 9500 * 2.5 / 100 = 237.5 -> 238 (banker's rounding, 237.5 -> 238)
+  // After bulk discount = 9262
+  // Total discount = 500 + 238 = 738
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 738);
+  assert.equal(result.total, 9262);
+});
+
+test('invoiceTotals bulk discount with VAT', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 10 * 1000 = 10000
+  // Line discount = 0
+  // After line discount = 10000
+  // Bulk discount = 10000 * 2.5 / 100 = 250
+  // After bulk discount = 9750
+  // VAT = 9750 * 21 / 100 = 2047.5 -> 2048 (banker's rounding, 2047.5 -> 2048)
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 250);
+  assert.equal(result.vat, 2048);
+  assert.equal(result.total, 11798);
+});
+
+test('invoiceTotals VAT is calculated after bulk discount', () => {
+  // This test verifies that VAT is not applied to the bulk discount amount
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  // If VAT were applied to 10000 (before bulk discount): VAT = 2100
+  // But it should be applied to 9750 (after bulk discount): VAT = 2047.5 -> 2048
+  assert.equal(result.vat, 2048);
+  assert.notEqual(result.vat, 2100);
+});
+
+test('invoiceTotals bulk discount at exactly 10 units', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 500, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 10 * 500 = 5000
+  // Bulk discount applies at qty >= 10
+  // Bulk discount = 5000 * 2.5 / 100 = 125
+  assert.equal(result.discount, 125);
+});
+
+test('invoiceTotals bulk discount just below 10 units', () => {
+  const invoice = {
+    lines: [{ qty: 9, unitPrice: 500, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 9 * 500 = 4500
+  // Bulk discount does NOT apply at qty < 10
+  assert.equal(result.discount, 0);
+});
+
+test('invoiceTotals multiple lines with different quantities', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+      { qty: 5, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  // Line 1: total = 10000, bulk discount = 250, subtotal line = 10000
+  // Line 2: total = 5000, bulk discount = 0, subtotal line = 5000
+  // Total discount = 250
+  assert.equal(result.subtotal, 15000);
+  assert.equal(result.discount, 250);
+  assert.equal(result.total, 14750);
+});
+
+test('invoiceTotals bulk discount with line discount', () => {
+  const invoice = {
+    lines: [{ qty: 20, unitPrice: 1000, discountPercent: 10, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 20 * 1000 = 20000
+  // Line discount = 20000 * 10 / 100 = 2000
+  // After line discount = 18000
+  // Bulk discount = 18000 * 2.5 / 100 = 450
+  // Total discount = 2000 + 450 = 2450
+  assert.equal(result.subtotal, 20000);
+  assert.equal(result.discount, 2450);
+  assert.equal(result.total, 17550);
+});
+
+test('invoiceTotals bulk discount rounding', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 333, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 10 * 333 = 3330
+  // Line discount = 0
+  // After line discount = 3330
+  // Bulk discount = 3330 * 2.5 / 100 = 83.25 -> 83 (banker's rounding, 83.25 -> 83)
+  assert.equal(result.subtotal, 3330);
+  assert.equal(result.discount, 83);
+  assert.equal(result.total, 3247);
+});
+
+test('invoiceTotals bulk discount with large quantities', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 100 * 1000 = 100000
+  // Bulk discount = 100000 * 2.5 / 100 = 2500
+  assert.equal(result.subtotal, 100000);
+  assert.equal(result.discount, 2500);
+  assert.equal(result.total, 97500);
+});
+
+test('invoiceTotals bulk discount with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'EXTRA', amount: 1000 },
+  };
+  const result = invoiceTotals(invoice);
+  // Line total = 10000, bulk discount = 250
+  // After bulk discount = 9750
+  // Voucher is applied to final total
+  // Total = 9750 - 1000 = 8750
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 250);
+  assert.equal(result.voucher, 1000);
+  assert.equal(result.total, 8750);
+});
+
+test('invoiceTotals bulk discount multiple lines with mixed discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 15, unitPrice: 1000, discountPercent: 5, vatRate: 21 },
+      { qty: 10, unitPrice: 500, discountPercent: 0, vatRate: 6 },
+      { qty: 3, unitPrice: 2000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  // Line 1: 15*1000=15000, disc=750, after=14250, bulk=356, after_bulk=13894, vat=2917
+  // Line 2: 10*500=5000, disc=0, after=5000, bulk=125, after_bulk=4875, vat=293 (actually 292.5 -> 292)
+  // Line 3: 3*2000=6000, disc=600, after=5400, bulk=0, after_bulk=5400, vat=1134
+  // Total discount = 750 + 356 + 0 + 125 + 600 = 1831
+  assert.equal(result.subtotal, 26000);
+  assert.ok(result.discount > 1000);
+});
+
+test('invoiceTotals bulk discount does not affect lines with qty < 10', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+      { qty: 9, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+      { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  // Only first line gets bulk discount
+  // Line 1: discount = 250
+  // Line 2: discount = 0
+  // Line 3: discount = 0
+  // Total discount = 250
+  assert.equal(result.discount, 250);
+});
