+/**
+ * Generate a dashboard with key metrics about invoices.
+ * @param {Array} invoices - All invoices
+ * @param {string} asOf - Reference date in YYYY-MM-DD format
+ * @returns {Object} Dashboard with counts, outstanding, overdue, and topCustomers
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const inv of invoices) {
+    if (counts.hasOwnProperty(inv.status)) {
+      counts[inv.status]++;
+    }
+  }
+
+  // Calculate outstanding (issued or partially_paid)
+  let outstanding = 0;
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      outstanding += balanceDue(inv);
+    }
+  }
+
+  // Get overdue information
+  const overdueList = overdueInvoices(invoices, asOf);
+  const overdueData = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Calculate top customers by outstanding due
+  const customerDueMap = {};
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const customerId = inv.customerId;
+      const due = balanceDue(inv);
+      if (!customerDueMap[customerId]) {
+        customerDueMap[customerId] = 0;
+      }
+      customerDueMap[customerId] += due;
+    }
+  }
+
+  const topCustomers = Object.entries(customerDueMap)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: overdueData,
+    topCustomers,
+  };
+}
