+    customerId: 'C-001',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    dueDate: '2026-11-06',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 0, discountPercent: 0 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert(text.includes('Due: 2026-11-06'));
+  const lines = text.split('\n');
+  assert.equal(lines[lines.length - 1], 'Due: 2026-11-06');
+});
+
