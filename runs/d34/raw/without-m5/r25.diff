+test('renderInvoiceText shows voucher, due date, and paid amount together', () => {
+  const invoice = {
+    customerId: 'C-001',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    dueDate: '2026-11-06',
+    status: 'partially_paid',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 }],
+    voucher: { code: 'PROMO', amount: 2000 },
+    payments: [{ amount: 5000, date: '2026-10-20' }],
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  assert(text.includes('Voucher: -€20.00'));
+  assert(text.includes('Due: 2026-11-06'));
+  assert(text.includes('Paid: €50.00'));
+
+  // Check order: Voucher before Total, Due and Paid after Total
+  const voucherIdx = lines.findIndex(l => l.includes('Voucher:'));
+  const totalIdx = lines.findIndex(l => l.includes('Total:'));
+  const dueIdx = lines.findIndex(l => l.includes('Due:'));
+  const paidIdx = lines.findIndex(l => l.includes('Paid:'));
+
+  assert(voucherIdx < totalIdx, 'Voucher should appear before Total');
+  assert(totalIdx < dueIdx, 'Total should appear before Due');
+  assert(dueIdx < paidIdx, 'Due should appear before Paid');
+});
