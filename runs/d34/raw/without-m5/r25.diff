+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number }>, voucher?: { code: string, amount: number }, dueDate?: string, payments?: Array }} invoice
  * @returns {{ ok: true, value: string } | { ok: false, error: string }}
