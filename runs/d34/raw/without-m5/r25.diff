@@ -397,3 +397,164 @@ test('renderInvoiceText handles complex invoice with all features', () => {
   assert(text.includes('VAT:'));
   assert(text.includes('Total:'));
 });
+
+test('renderInvoiceText shows voucher', () => {
+  const invoice = {
+    customerId: 'C-001',
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    dueDate: '2026-11-06',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+    voucher: { code: 'PROMO-001', amount: 5000 },
+  };
+
+  const result = renderInvoiceText(invoice);
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert(text.includes('Voucher: -€50.00'));
+  const lines = text.split('\n');
+  const voucherLine = lines.find(l => l.includes('Voucher:'));
+  const totalLine = lines.find(l => l.includes('Total:'));
+  assert(lines.indexOf(voucherLine) < lines.indexOf(totalLine), 'Voucher should appear before Total');
+});
+
+test('renderInvoiceText shows due date when available', () => {
