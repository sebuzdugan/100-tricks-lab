diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..4b4d610
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,51 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} input
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: 'draft', lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issueDate format (YYYY-MM-DD)
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) return fail('DATE_INVALID');
+  const date = new Date(issueDate + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return fail('DATE_INVALID');
+
+  // Validate lines is not empty
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Validate SKU exists and get product details
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..619e8f7
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,160 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 2);
+  assert.deepEqual(r.value.lines[0], {
+    sku: 'DEV-HOUR',
+    name: 'Development (hour)',
+    qty: 5,
+    unitPrice: 9500,
+    vatRate: 21,
+  });
+  assert.deepEqual(r.value.lines[1], {
+    sku: 'LOGO-PACK',
+    name: 'Logo package',
+    qty: 1,
+    unitPrice: 120000,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-999',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'CUSTOMER_NOT_FOUND' }
+  );
+});
+
+test('createInvoice returns DATE_INVALID for malformed dates', () => {
+  const cases = ['2026-13-01', '2026-10-32', '26-10-07', '2026/10/07', '2026-10', 'not-a-date', '', '2026-10-07T12:00:00'];
+  for (const date of cases) {
+    assert.deepEqual(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: date,
+        lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+      }),
+      { ok: false, error: 'DATE_INVALID' },
+      `should reject: ${date}`
+    );
+  }
+});
+
+test('createInvoice accepts valid dates in YYYY-MM-DD format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+});
+
+test('createInvoice returns NO_LINES for empty lines array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice returns NO_LINES for missing lines property', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: undefined,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice returns QTY_INVALID for invalid quantities', () => {
+  const cases = [
+    { qty: 0, desc: 'zero' },
+    { qty: -1, desc: 'negative' },
+    { qty: 1.5, desc: 'fractional' },
+    { qty: '5', desc: 'string' },
+    { qty: null, desc: 'null' },
+    { qty: undefined, desc: 'undefined' },
+  ];
+  for (const { qty, desc } of cases) {
+    assert.deepEqual(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: '2026-10-07',
+        lines: [{ sku: 'DEV-HOUR', qty }],
+      }),
+      { ok: false, error: 'QTY_INVALID' },
+      `should reject qty: ${desc}`
+    );
+  }
+});
+
+test('createInvoice accepts positive integer quantities', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].qty, 100);
+});
+
+test('createInvoice returns UNKNOWN_SKU for unknown SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'INVALID-SKU', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice handles multiple lines with different VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].vatRate, 21);
+  assert.equal(r.value.lines[1].vatRate, 9);
+  assert.equal(r.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  };
+  const original = JSON.parse(JSON.stringify(input));
+  createInvoice(input);
+  assert.deepEqual(input, original);
+});
