+/**
+ * Add or increase a line on a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string, qty: number }> }} invoice
+ * @param {{ sku: string, qty: number }} input
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check invoice exists and is draft
+  if (!invoice || invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) {
+    return fail('QTY_INVALID');
+  }
+
+  // Validate SKU exists
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Check if line already exists
+  const existingLineIndex = invoice.lines.findIndex((l) => l.sku === sku);
+
+  if (existingLineIndex !== -1) {
+    // Update existing line's qty
+    const newLines = invoice.lines.map((line, i) =>
+      i === existingLineIndex ? { ...line, qty: line.qty + qty } : line
+    );
+    return ok({ ...invoice, lines: newLines });
+  } else {
+    // Add new line
+    const newLine = {
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    };
+    return ok({ ...invoice, lines: [...invoice.lines, newLine] });
+  }
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string }> }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check invoice exists and is draft
+  if (!invoice || invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Find the line
+  const lineIndex = invoice.lines.findIndex((l) => l.sku === sku);
+  if (lineIndex === -1) {
+    return fail('LINE_NOT_FOUND');
+  }
+
+  // Check if it's the last line
+  if (invoice.lines.length === 1) {
+    return fail('NO_LINES');
+  }
+
+  // Remove the line
+  const newLines = invoice.lines.filter((_, i) => i !== lineIndex);
+  return ok({ ...invoice, lines: newLines });
+}
