diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..206b57d
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,43 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns INV-YYYY-0001 for empty list', () => {
+  assert.equal(nextInvoiceNumber([], '2026-10-07'), 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber returns INV-YYYY-0002 for one existing number', () => {
+  assert.equal(nextInvoiceNumber(['INV-2026-0001'], '2026-10-07'), 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber continues counting correctly', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-9999', 'INV-2026-0001', 'INV-2027-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles unordered numbers', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0002', 'INV-2026-0010', 'INV-2026-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2026-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2025-01-01'), 'INV-2025-0003');
+  assert.equal(nextInvoiceNumber(existing, '2026-01-01'), 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 9998 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-9999');
+});
+
+test('nextInvoiceNumber extracts year from issueDate correctly', () => {
+  assert.equal(nextInvoiceNumber([], '2025-01-01'), 'INV-2025-0001');
+  assert.equal(nextInvoiceNumber([], '2026-12-31'), 'INV-2026-0001');
+  assert.equal(nextInvoiceNumber([], '2050-06-15'), 'INV-2050-0001');
+});
