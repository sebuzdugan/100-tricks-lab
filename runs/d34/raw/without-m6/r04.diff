+/**
+ * Issue a draft invoice (assign number and change status to 'issued').
+ * @param {{ status: string, issueDate: string }} invoice
+ * @param {Array<string>} existingNumbers - Invoice numbers already in use
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check invoice exists and is draft
+  if (!invoice || invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Get the next invoice number
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  // Return new invoice with number and status 'issued'
+  return ok({ ...invoice, number, status: 'issued' });
+}
