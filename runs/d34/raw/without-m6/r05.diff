+++ b/test/render.test.js
@@ -0,0 +1,182 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /^DRAFT$/m);
+  assert.match(text, /^Northwind Studio$/m);
+  assert.match(text, /5x Development \(hour\) @ €95\.00 = €475\.00/);
+  assert.match(text, /^Total: €475\.00$/m);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issueResult.ok, true);
+
+  const r = renderInvoiceText(issueResult.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /^INV-2026-0001$/m);
+  assert.match(text, /^Northwind Studio$/m);
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.equal(r.ok, true);
+  const lines = r.value.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.match(lines[2], /5x Development \(hour\)/);
+  assert.match(lines[3], /1x Logo package/);
+  assert.match(lines[4], /3x Copywriting \(hour\)/);
+  assert.match(lines[5], /^Total:/);
+});
+
+test('renderInvoiceText formats large amounts with thousands separators', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 2 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /€2,450\.00/); // unitPrice for BRAND-BOOK is 245000 cents = €2,450.00
+  assert.match(text, /€4,900\.00/); // line total 2 * 245000 = 490000 cents = €4,900.00
+});
+
+test('renderInvoiceText calculates correct total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  const expected = 5 * 9500 + 1 * 120000; // 167500 cents = €1,675.00
+  assert.match(text, /Total: €1,675\.00/);
+});
+
+test('renderInvoiceText returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 }],
+  };
+
+  assert.deepEqual(renderInvoiceText(invoice), {
+    ok: false,
+    error: 'CUSTOMER_NOT_FOUND',
+  });
+});
+
+test('renderInvoiceText returns INVALID_INVOICE for missing customerId', () => {
+  const invoice = {
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ qty: 1, name: 'Test', unitPrice: 1000, vatRate: 21 }],
+  };
+
+  assert.deepEqual(renderInvoiceText(invoice), {
+    ok: false,
+    error: 'INVALID_INVOICE',
+  });
+});
+
+test('renderInvoiceText returns INVALID_INVOICE for null invoice', () => {
+  assert.deepEqual(renderInvoiceText(null), {
+    ok: false,
+    error: 'INVALID_INVOICE',
+  });
+});
+
+test('renderInvoiceText includes all required fields', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 10 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4); // DRAFT, customer, 1 line item, total
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /10x Icon set \(24 icons\) @ €9\.80 = €98\.00/);
+  assert.equal(lines[3], 'Total: €98.00');
+});
+
+test('renderInvoiceText works with different customers', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-010',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'HOST-MONTH', qty: 12 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /^Tidewater Museum$/m);
+});
+
+test('renderInvoiceText on issued invoice with multiple numbers', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DOMAIN-YEAR', qty: 3 }],
+  });
+  assert.equal(draft.ok, true);
+
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const issued = issueInvoice(draft.value, existing);
+  assert.equal(issued.ok, true);
+
+  const r = renderInvoiceText(issued.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /^INV-2026-0003$/m);
+});
