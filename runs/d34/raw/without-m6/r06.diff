+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.total, 0);
+});
+
+test('invoiceTotals with fractional discount rounding', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 1, discountPercent: 33.33 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const r = invoiceTotals(invoiceResult.value);
+  assert.equal(r.ok, true);
+  const lineTotal = 1 * 980;
+  const expectedDiscount = Math.round(lineTotal * 33.33 / 100 * 1e6) / 1e6;
+  assert.equal(r.value.subtotal, lineTotal);
+  assert(r.value.discount > 0);
+});
