+  assert(r.value.hasOwnProperty('discount'));
+  assert(r.value.hasOwnProperty('total'));
+});
+
+test('invoiceTotals calculates discount correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10, discountPercent: 10 },
+      { sku: 'LOGO-PACK', qty: 1, discountPercent: 20 },
+    ],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const r = invoiceTotals(invoiceResult.value);
+  assert.equal(r.ok, true);
+  const lineTotal1 = 10 * 9500; // 95000
+  const lineTotal2 = 1 * 120000; // 120000
+  const discount1 = Math.round(lineTotal1 * 10 / 100); // 9500
+  const discount2 = Math.round(lineTotal2 * 20 / 100); // 24000
+  assert.equal(r.value.subtotal, lineTotal1 + lineTotal2);
+  assert.equal(r.value.discount, discount1 + discount2);
+  assert.equal(r.value.total, r.value.subtotal - r.value.discount);
+});
