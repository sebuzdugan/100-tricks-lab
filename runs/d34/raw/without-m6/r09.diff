@@ -998,3 +998,52 @@ test('invoiceTotals VAT rounded per line', () => {
   assert(r.value.vat > 0);
   assert(Number.isInteger(r.value.vat));
 });
+
+test('createInvoice normalizes customer ID to upper case', () => {
+  const r = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+});
+
+test('createInvoice normalizes customer ID with leading/trailing spaces', () => {
+  const r = createInvoice({
+    customerId: '  c-001  ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+});
+
+test('createInvoice works with mixed case and spaces', () => {
+  const r = createInvoice({
+    customerId: ' c-007 ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-007');
+});
+
+test('createInvoice with all lowercase customer ID', () => {
+  const r = createInvoice({
+    customerId: 'c-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-003');
+});
+
+test('createInvoice normalizes ID for unknown customer lookup', () => {
+  const r = createInvoice({
+    customerId: ' c-999 ',
