+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(String(text))) return false;
+
+  // Parse components
+  const [year, month, day] = String(text).split('-').map(Number);
+
+  // Create date and check if it's valid by verifying components match
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+
+  // Verify the parsed date matches the input (catches invalid dates like 2026-02-30)
+  return date.getUTCFullYear() === year &&
+         (date.getUTCMonth() + 1) === month &&
+         date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date, returning a new date string in YYYY-MM-DD format (UTC).
+ * @param {string} date Date in YYYY-MM-DD format
+ * @param {number} n Number of days to add (can be negative)
+ * @returns {string} New date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of whole days between two dates (b minus a).
+ * @param {string} a First date in YYYY-MM-DD format
+ * @param {string} b Second date in YYYY-MM-DD format
+ * @returns {number} Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (24 * 60 * 60 * 1000));
+}
