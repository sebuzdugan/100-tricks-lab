diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..f1c10f0
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,106 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2025-06-15'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid date formats', () => {
+  assert.equal(isValidDate('01-01-2026'), false);
+  assert.equal(isValidDate('2026/01/01'), false);
+  assert.equal(isValidDate('2026-1-1'), false);
+  assert.equal(isValidDate('2026-01'), false);
+  assert.equal(isValidDate('01-01'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-01-32'), false);
+});
+
+test('isValidDate handles leap years', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2026-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-01-01', 1), '2026-01-02');
+  assert.equal(addDays('2026-01-01', 10), '2026-01-11');
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-01-10', -5), '2026-01-05');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays crosses month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+});
+
+test('addDays crosses year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays with zero returns same date', () => {
+  assert.equal(addDays('2026-06-15', 0), '2026-06-15');
+});
+
+test('daysBetween with same date returns 0', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-01'), 0);
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+  assert.equal(daysBetween('2026-01-01', '2026-01-11'), 10);
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-01-10', '2026-01-05'), -5);
+  assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+});
+
+test('daysBetween across month boundaries', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-02-01', '2026-01-31'), -1);
+});
+
+test('daysBetween across year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+});
+
+test('date arithmetic is consistent', () => {
+  const start = '2026-06-15';
+  const added = addDays(start, 10);
+  const diff = daysBetween(start, added);
+  assert.equal(diff, 10);
+});
+
+test('date functions use UTC', () => {
+  // These tests verify UTC behavior by checking that dates
+  // are consistent regardless of local timezone
+  const date1 = '2026-01-01';
+  const date2 = '2026-01-02';
+  assert.equal(daysBetween(date1, date2), 1);
+  assert.equal(addDays(date1, 1), date2);
+});
+
+test('daysBetween is inverse of addDays', () => {
+  const date = '2026-06-15';
+  const n = 42;
+  const newDate = addDays(date, n);
+  assert.equal(daysBetween(date, newDate), n);
+  assert.equal(daysBetween(newDate, date), -n);
+});
