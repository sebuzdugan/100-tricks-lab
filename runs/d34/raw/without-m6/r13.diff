+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: any }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check invoice exists and is draft
+  if (!invoice || invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Check if voucher already applied
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({ ...invoice, voucher: { code, amount } });
