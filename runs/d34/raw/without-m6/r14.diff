+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns customer statement with issued invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv1Result.ok, true);
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(inv2Result.ok, true);
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  assert.equal(issued1.ok, true);
+
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2026-0001']);
+  assert.equal(issued2.ok, true);
+
+  const r = statement('C-001', [issued1.value, issued2.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.totalDue, r.value.invoices[0].due + r.value.invoices[1].due);
+});
+
+test('statement normalizes customer ID', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = statement('  c-002  ', [issued.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-002');
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = statement('UNKNOWN', [], '2026-10-07');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement filters by date', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(inv1Result.ok, true);
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(inv2Result.ok, true);
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  assert.equal(issued1.ok, true);
+
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2026-0001']);
+  assert.equal(issued2.ok, true);
+
+  const r = statement('C-001', [issued1.value, issued2.value], '2026-10-05');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement excludes draft invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const r = statement('C-001', [invResult.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const due = balanceDue(issued.value);
+  const paid = recordPayment(issued.value, { amount: due, date: '2026-10-02' });
+  assert.equal(paid.ok, true);
+
+  const r = statement('C-001', [paid.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const partial = recordPayment(issued.value, { amount: 50000, date: '2026-10-02' });
+  assert.equal(partial.ok, true);
+
+  const r = statement('C-001', [partial.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert(r.value.invoices[0].due > 0);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const inv3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv1Result.ok, true);
+  assert.equal(inv2Result.ok, true);
+  assert.equal(inv3Result.ok, true);
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2026-0001']);
+  const issued3 = issueInvoice(inv3Result.value, ['INV-2026-0001', 'INV-2026-0002']);
+
+  const r = statement('C-001', [issued3.value, issued1.value, issued2.value], '2026-10-12');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-05');
+  assert.equal(r.value.invoices[2].issueDate, '2026-10-10');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(inv1Result.ok, true);
+  assert.equal(inv2Result.ok, true);
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2026-0001']);
+
+  const r = statement('C-001', [issued1.value, issued2.value], '2026-10-07');
+  assert.equal(r.ok, true);
+
+  const expectedTotal = r.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(r.value.totalDue, expectedTotal);
+});
+
+test('statement excludes other customers', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(inv1Result.ok, true);
+  assert.equal(inv2Result.ok, true);
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2026-0001']);
+
+  const r = statement('C-001', [issued1.value, issued2.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement returns DATE_INVALID for invalid asOf date', () => {
+  const r = statement('C-001', [], 'invalid-date');
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('statement returns empty invoices for customer with no open invoices', () => {
+  const r = statement('C-001', [], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes invoices with due date in past', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = statement('C-001', [issued.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement includes invoice fields: number, issueDate, dueDate, total, due', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET30',
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = statement('C-001', [issued.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+
+  const inv = r.value.invoices[0];
+  assert(inv.number);
+  assert.equal(inv.issueDate, '2026-10-01');
+  assert.equal(inv.dueDate, '2026-10-31');
+  assert(typeof inv.total === 'number' && inv.total > 0);
+  assert(typeof inv.due === 'number' && inv.due > 0);
+});
+
+test('statement with multiple partially-paid invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  });
+
+  assert.equal(inv1Result.ok, true);
+  assert.equal(inv2Result.ok, true);
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2026-0001']);
+
+  const partial1 = recordPayment(issued1.value, { amount: 50000, date: '2026-10-02' });
+  const partial2 = recordPayment(issued2.value, { amount: 25000, date: '2026-10-06' });
+
+  assert.equal(partial1.ok, true);
+  assert.equal(partial2.ok, true);
+
+  const r = statement('C-001', [partial1.value, partial2.value], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+  assert(r.value.invoices[0].due > 0);
+  assert(r.value.invoices[1].due > 0);
+  assert.equal(r.value.totalDue, r.value.invoices[0].due + r.value.invoices[1].due);
+});
