+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate a statement for a customer.
+ * @param {string} customerId
+ * @param {Array} invoices
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize customer ID
+  const normalizedCustomerId = normalizeId(customerId);
+
+  // Validate customer exists
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Validate invoices is an array
+  if (!Array.isArray(invoices)) {
+    return fail('INVALID_INVOICE');
+  }
+
+  // Filter invoices for this customer with status issued or partially_paid and issueDate <= asOf
+  const customerInvoices = invoices.filter(inv =>
+    inv &&
+    inv.customerId === normalizedCustomerId &&
+    (inv.status === 'issued' || inv.status === 'partially_paid') &&
+    inv.issueDate <= asOf
+  );
+
+  // Sort by issueDate
+  customerInvoices.sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Build result invoices with number, issueDate, dueDate, total, due
+  const resultInvoices = [];
+  let totalDue = 0;
+
+  for (const inv of customerInvoices) {
+    const totalsResult = invoiceTotals(inv);
+    if (!totalsResult.ok) return totalsResult;
+
+    const total = totalsResult.value.total;
+    const due = balanceDue(inv);
+
+    resultInvoices.push({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total,
+      due,
+    });
+
+    totalDue += due;
+  }
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: resultInvoices,
+    totalDue,
+  });
+}
