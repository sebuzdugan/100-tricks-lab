+++ b/test/credits.test.js
@@ -0,0 +1,283 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote creates a credit note on an issued invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = createCreditNote(issued.value, { amount: 50000, reason: 'Discount', date: '2026-10-08' }, ['INV-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoiceNumber, issued.value.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 50000);
+  assert.equal(r.value.reason, 'Discount');
+  assert.equal(r.value.date, '2026-10-08');
+});
+
+test('createCreditNote creates credit note on partially_paid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const partial = recordPayment(issued.value, { amount: 50000, date: '2026-10-08' });
+  assert.equal(partial.ok, true);
+
+  const r = createCreditNote(partial.value, { amount: 25000, reason: 'Partial refund', date: '2026-10-09' }, ['INV-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoiceNumber, issued.value.number);
+});
+
+test('createCreditNote creates credit note on paid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const totalsResult = invoiceTotals(issued.value);
+  const due = totalsResult.value.total;
+  const paid = recordPayment(issued.value, { amount: due, date: '2026-10-08' });
+  assert.equal(paid.ok, true);
+
+  const r = createCreditNote(paid.value, { amount: 25000, reason: 'Refund', date: '2026-10-09' }, ['INV-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoiceNumber, issued.value.number);
+});
+
+test('createCreditNote returns NOT_ISSUED for draft invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const r = createCreditNote(invResult.value, { amount: 50000, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote returns AMOUNT_INVALID for invalid amounts', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const cases = [
+    { amount: 0, desc: 'zero' },
+    { amount: -1000, desc: 'negative' },
+    { amount: 123.45, desc: 'fractional' },
+    { amount: '50000', desc: 'string' },
+    { amount: null, desc: 'null' },
+  ];
+
+  for (const { amount, desc } of cases) {
+    assert.deepEqual(
+      createCreditNote(issued.value, { amount, reason: 'Refund', date: '2026-10-08' }, []),
+      { ok: false, error: 'AMOUNT_INVALID' },
+      `should reject: ${desc}`
+    );
+  }
+});
+
+test('createCreditNote returns CREDIT_TOO_HIGH when amount exceeds invoice total', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const totalsResult = invoiceTotals(issued.value);
+  const invoiceTotal = totalsResult.value.total;
+
+  const r = createCreditNote(issued.value, { amount: invoiceTotal + 1, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote credit can equal invoice total', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const totalsResult = invoiceTotals(issued.value);
+  const invoiceTotal = totalsResult.value.total;
+
+  const r = createCreditNote(issued.value, { amount: invoiceTotal, reason: 'Full refund', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, invoiceTotal);
+});
+
+test('createCreditNote numbers are CN-YYYY-NNNN format', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = createCreditNote(issued.value, { amount: 25000, reason: 'Refund', date: '2026-10-08' }, ['INV-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.match(r.value.number, /^CN-2026-\d{4}$/);
+});
+
+test('createCreditNote has separate counter from invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  // Create multiple credit notes with existing invoices
+  const r1 = createCreditNote(issued.value, { amount: 10000, reason: 'Refund 1', date: '2026-10-08' }, ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003']);
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.number, 'CN-2026-0001');
+
+  const r2 = createCreditNote(issued.value, { amount: 10000, reason: 'Refund 2', date: '2026-10-08' }, ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003', 'CN-2026-0001']);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote increments counter per year', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  // Create credit notes, second should be 0002
+  const r1 = createCreditNote(issued.value, { amount: 10000, reason: 'Refund 1', date: '2026-10-08' }, ['CN-2026-0001']);
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  // Existing numbers from previous year
+  const r = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2027-01-15' }, ['CN-2026-0001', 'CN-2026-0002', 'CN-2026-0003']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote preserves invoice number and customer ID', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = createCreditNote(issued.value, { amount: 25000, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoiceNumber, issued.value.number);
+  assert.equal(r.value.customerId, 'C-002');
+});
+
+test('createCreditNote with reason and date', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = createCreditNote(issued.value, { amount: 50000, reason: 'Customer request', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.reason, 'Customer request');
+  assert.equal(r.value.date, '2026-10-15');
+});
+
+test('createCreditNote on invoice with VAT and discount', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const totalsResult = invoiceTotals(issued.value);
+  const invoiceTotal = totalsResult.value.total;
+
+  // Credit should not exceed total (which includes VAT after discount)
+  const r = createCreditNote(issued.value, { amount: invoiceTotal - 1, reason: 'Partial refund', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote ignores non-CN and non-INV numbers', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  // Mix of valid and invalid numbers
+  const r = createCreditNote(issued.value, { amount: 25000, reason: 'Refund', date: '2026-10-08' }, ['INV-2026-0001', 'RANDOM-2026-0001', 'CN-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0002');
+});
