+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns invoices past their due date', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+  // dueDate is 2026-10-15
+
+  const r = overdueInvoices([issued.value], '2026-10-16');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 1);
+  assert.equal(r.value[0].number, issued.value.number);
+  assert.equal(r.value[0].customerId, 'C-001');
+  assert.equal(r.value[0].dueDate, '2026-10-15');
+  assert.equal(r.value[0].daysOverdue, 1);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+  // dueDate is 2026-10-15
+
+  const r = overdueInvoices([issued.value], '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
