+import { ok, fail } from './result.js';
+import { isValidDate, daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Get invoices that are overdue.
+ * @param {Array} invoices
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }> } | { ok: false, error: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Validate invoices is an array
+  if (!Array.isArray(invoices)) {
+    return fail('INVALID_INVOICE');
+  }
+
+  // Filter to issued/partially_paid invoices with dueDate before asOf
+  const overdue = invoices.filter(inv =>
+    inv &&
+    (inv.status === 'issued' || inv.status === 'partially_paid') &&
+    inv.dueDate < asOf
+  );
+
+  // Map to result format with daysOverdue calculation
+  const result = overdue.map(inv => {
+    const daysOverdue = daysBetween(inv.dueDate, asOf);
+    const due = balanceDue(inv);
+
+    return {
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue,
+      due,
+    };
+  });
+
+  // Sort by daysOverdue descending (most overdue first)
+  result.sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return ok(result);
+}
