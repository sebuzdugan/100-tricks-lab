+/**
+ * Get a summary of VAT by rate across invoices.
+ * @param {Array} invoices
+ * @returns {{ ok: true, value: Array<{ rate: number, base: number, vat: number }> } | { ok: false, error: string }}
+ */
+export function vatSummary(invoices) {
+  // Validate invoices is an array
+  if (!Array.isArray(invoices)) {
+    return fail('INVALID_INVOICE');
+  }
+
+  // Filter to issued/partially_paid/paid invoices
+  const filtered = invoices.filter(inv =>
+    inv &&
+    (inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+  );
+
+  // Group by VAT rate
+  const vatMap = {};
+
+  for (const invoice of filtered) {
+    if (!Array.isArray(invoice.lines)) continue;
+
+    for (const line of invoice.lines) {
+      const lineTotal = line.qty * line.unitPrice;
+      const discountFractional = lineTotal * (line.discountPercent ?? 0) / 100;
+      const discountAmount = roundCents(discountFractional);
+      const base = lineTotal - discountAmount;
+
+      const vatFractional = base * (line.vatRate ?? 0) / 100;
+      const vatAmount = roundCents(vatFractional);
+
+      const rate = line.vatRate ?? 0;
+      if (!vatMap[rate]) {
+        vatMap[rate] = { rate, base: 0, vat: 0 };
+      }
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vatAmount;
+    }
+  }
+
+  // Convert to array and sort by rate descending (high to low)
+  const result = Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+
+  return ok(result);
+}
