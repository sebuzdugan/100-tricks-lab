+/**
+ * Calculate late fee for an invoice.
+ * Fee is 0.04% of amount due per day overdue, 0 if not overdue.
+ * @param {{ status: string, dueDate: string }} invoice
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lateFee(invoice, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Draft invoices or those not issued have no late fee
+  if (!invoice || (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid')) {
+    return ok(0);
+  }
+
+  // Not overdue - no fee
+  if (invoice.dueDate >= asOf) {
+    return ok(0);
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // Calculate amount still due
+  const due = balanceDue(invoice);
+
+  // If nothing due (paid invoice), no fee
+  if (due === 0) {
+    return ok(0);
+  }
+
+  // Calculate fee: 0.04% per day of amount due
+  const feeFractional = due * (daysOverdue * 0.0004);
+  const fee = roundCents(feeFractional);
+
+  return ok(fee);
+}
