+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns header line', () => {
+  const r = exportCsv([]);
+  assert.equal(r.ok, true);
+  assert(r.value.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv includes header and ends with newline', () => {
+  const r = exportCsv([]);
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv with single issued invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = exportCsv([issued.value]);
+  assert.equal(r.ok, true);
+
+  const lines = r.value.trim().split('\n');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert(lines[1].includes(issued.value.number));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv with multiple invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 3, discountPercent: 0 }],
+  });
+
+  assert.equal(inv1Result.ok, true);
+  assert.equal(inv2Result.ok, true);
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  const issued2 = issueInvoice(inv2Result.value, ['INV-2026-0001']);
+
+  const r = exportCsv([issued1.value, issued2.value]);
+  assert.equal(r.ok, true);
+
+  const lines = r.value.trim().split('\n');
+  assert.equal(lines.length, 3);
+  assert(lines[1].includes(issued1.value.number));
+  assert(lines[2].includes(issued2.value.number));
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = exportCsv([issued.value]);
+  assert.equal(r.ok, true);
+
+  // Check that amounts have 2 decimals
+  const lines = r.value.trim().split('\n');
+  const dataLine = lines[1];
+  // Amounts should be formatted like 50.00, 1.05, etc.
+  const parts = dataLine.split(',');
+  const subtotal = parts[5];
+  const discount = parts[6];
+  const vat = parts[7];
+  const total = parts[8];
+  const due = parts[9];
+
+  // All amounts should have 2 decimal places
+  assert(/^\d+\.\d{2}$/.test(subtotal));
+  assert(/^\d+\.\d{2}$/.test(discount));
+  assert(/^\d+\.\d{2}$/.test(vat));
+  assert(/^\d+\.\d{2}$/.test(total));
+  assert(/^\d+\.\d{2}$/.test(due));
+});
