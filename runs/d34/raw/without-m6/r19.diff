+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format an amount in cents as euros with 2 decimals.
+ * @param {number} cents
+ * @returns {string} e.g. "1234.50"
+ */
+function formatAmount(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Escape a field for CSV: quote if contains comma or quote, double any quotes inside.
+ * @param {any} value
+ * @returns {string}
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function exportCsv(invoices) {
+  // Validate invoices is an array
+  if (!Array.isArray(invoices)) {
+    return fail('INVALID_INVOICE');
+  }
+
+  const lines = [];
+
+  // Add header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Add each invoice
+  for (const invoice of invoices) {
+    if (!invoice) continue;
+
+    // Get customer name
+    const customerResult = getCustomer(invoice.customerId);
+    if (!customerResult.ok) continue; // Skip invoices with invalid customers
+    const customerName = customerResult.value.name;
+
+    // Get totals
+    const totalsResult = invoiceTotals(invoice);
+    if (!totalsResult.ok) continue; // Skip if totals calculation fails
+
+    const { subtotal, discount, vat, total } = totalsResult.value;
+    const due = balanceDue(invoice);
+
+    // Build line
+    const line = [
+      escapeCsvField(invoice.number || ''),
+      escapeCsvField(customerName),
+      escapeCsvField(invoice.issueDate || ''),
+      escapeCsvField(invoice.dueDate || ''),
+      escapeCsvField(invoice.status || ''),
+      formatAmount(subtotal),
+      formatAmount(discount),
+      formatAmount(vat),
+      formatAmount(total),
+      formatAmount(due),
+    ].join(',');
+
+    lines.push(line);
+  }
+
+  return ok(lines.join('\n') + '\n');
+}
