+
+test('RATES constant has EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR cents to USD', () => {
+  const r = convert(50000, 'USD');
+  assert.equal(r.ok, true);
+  // 50000 * 1.085 = 54250
+  assert.equal(r.value, 54250);
+});
+
+test('convert EUR cents to GBP', () => {
+  const r = convert(50000, 'GBP');
+  assert.equal(r.ok, true);
+  // 50000 * 0.8425 = 42125
