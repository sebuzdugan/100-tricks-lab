   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/** Exchange rates: units of currency per euro. */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert cents (always EUR) to another currency's cents.
+ * @param {number} cents Amount in EUR cents
+ * @param {string} currency Currency code: EUR, USD, or GBP
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES.hasOwnProperty(currency)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const convertedFractional = cents * rate;
+  const converted = roundCents(convertedFractional);
+
+  return ok(converted);
+}
+
+/**
+ * Format cents (EUR) as money in the given currency with symbol.
+ * @param {number} cents Amount in EUR cents
+ * @param {string} currency Currency code: EUR, USD, or GBP
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function formatMoney(cents, currency) {
+  if (!RATES.hasOwnProperty(currency)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const convertResult = convert(cents, currency);
+  if (!convertResult.ok) return convertResult;
+
+  const convertedCents = convertResult.value;
+  const sign = convertedCents < 0 ? '-' : '';
+  const abs = Math.abs(convertedCents);
+  const euros = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const cents_part = String(abs % 100).padStart(2, '0');
+
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  const formatted = `${sign}${symbols[currency]}${euros}.${cents_part}`;
+  return ok(formatted);
+}
