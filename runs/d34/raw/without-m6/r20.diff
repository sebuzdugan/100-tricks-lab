+test('convert and formatMoney consistency', () => {
+  const cents = 100000;
+  const convertResult = convert(cents, 'USD');
+  const formatResult = formatMoney(cents, 'USD');
+
+  assert.equal(convertResult.ok, true);
+  assert.equal(formatResult.ok, true);
+
+  // formatMoney should use the converted amount with proper formatting (thousands separators)
+  const convertedCents = convertResult.value;
+  const euros = Math.floor(convertedCents / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const cents_part = String(convertedCents % 100).padStart(2, '0');
+  const expectedFormatted = `$${euros}.${cents_part}`;
