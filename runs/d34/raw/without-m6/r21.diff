+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { mergeCustomers, listCustomers } from '../src/customers.js';
+
+test('mergeCustomers removes fromId customer', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+  const invoices = [];
+
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, 1);
+  assert.equal(r.value.customers[0].id, 'C-002');
+});
+
+test('mergeCustomers updates invoices from fromId to intoId', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const inv3Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+
+  assert.equal(inv1Result.ok, true);
+  assert.equal(inv2Result.ok, true);
+  assert.equal(inv3Result.ok, true);
+
+  const invoices = [inv1Result.value, inv2Result.value, inv3Result.value];
+
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+
+  // All invoices should now be for C-002
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].customerId, 'C-002');
+  assert.equal(r.value.invoices[1].customerId, 'C-002');
+  assert.equal(r.value.invoices[2].customerId, 'C-002');
+});
+
+test('mergeCustomers returns SAME_CUSTOMER when merging same customer', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+  ];
+  const invoices = [];
+
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-001');
+  assert.deepEqual(r, { ok: false, error: 'SAME_CUSTOMER' });
+});
+
+test('mergeCustomers returns CUSTOMER_NOT_FOUND if fromId not found', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+  ];
+  const invoices = [];
+
+  const r = mergeCustomers(customers, invoices, 'C-999', 'C-001');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('mergeCustomers returns CUSTOMER_NOT_FOUND if intoId not found', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+  ];
+  const invoices = [];
+
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-999');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('mergeCustomers normalizes customer IDs', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+  const invoices = [];
+
+  const r = mergeCustomers(customers, invoices, '  c-001  ', '  c-002  ');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, 1);
+});
+
+test('mergeCustomers does not mutate original arrays', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+  const invoices = [];
+  const originalCustomersLength = customers.length;
+
+  mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(customers.length, originalCustomersLength);
+  assert.equal(customers[0].id, 'C-001');
+});
+
+test('mergeCustomers with multiple invoices from different customers', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+    { id: 'C-003', name: 'Charlie', email: 'charlie@example.com', tier: 'standard' },
+  ];
+
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const inv3Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv1Result.ok, true);
+  assert.equal(inv2Result.ok, true);
+  assert.equal(inv3Result.ok, true);
+
+  const invoices = [inv1Result.value, inv2Result.value, inv3Result.value];
+
+  const r = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+
+  // Only fromId's invoice should be updated
+  assert.equal(r.value.invoices[0].customerId, 'C-002');
+  assert.equal(r.value.invoices[1].customerId, 'C-002');
+  assert.equal(r.value.invoices[2].customerId, 'C-003');
+
+  // fromId customer should be gone
+  assert.equal(r.value.customers.length, 2);
+  assert(!r.value.customers.some(c => c.id === 'C-001'));
+});
+
+test('mergeCustomers with issued invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const issued = issueInvoice(invResult.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = mergeCustomers(customers, [issued.value], 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].customerId, 'C-002');
+});
+
+test('mergeCustomers preserves invoice data', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const r = mergeCustomers(customers, [invResult.value], 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+
+  const mergedInvoice = r.value.invoices[0];
+  assert.equal(mergedInvoice.customerId, 'C-002');
+  assert.equal(mergedInvoice.issueDate, '2026-10-07');
+  assert.equal(mergedInvoice.lines.length, 1);
+  assert.equal(mergedInvoice.lines[0].sku, 'DEV-HOUR');
+});
+
+test('mergeCustomers with empty invoices array', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+
+  const r = mergeCustomers(customers, [], 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, 1);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('mergeCustomers case insensitive', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+  ];
+
+  const invResult = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const r = mergeCustomers(customers, [invResult.value], 'c-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].customerId, 'C-002');
+});
+
+test('mergeCustomers SAME_CUSTOMER with case variations', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'standard' },
+  ];
+
+  const r = mergeCustomers(customers, [], 'c-001', 'C-001');
+  assert.deepEqual(r, { ok: false, error: 'SAME_CUSTOMER' });
+});
