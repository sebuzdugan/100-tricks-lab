+++ b/src/totals.js
@@ -0,0 +1,54 @@
+import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineTotal(line) {
+  if (!line || line.qty == null || line.unitPrice == null) {
+    return fail('INVALID_LINE');
+  }
+  return ok(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { amount: number } }} invoice
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, voucher: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines) || invoice.lines.length === 0) {
+    return fail('INVALID_INVOICE');
+  }
+
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
+    const result = lineTotal(line);
+    if (!result.ok) return result;
+    const lineTotalAmount = result.value;
+    subtotal += lineTotalAmount;
+
+    // Calculate line discount
+    const discountFractional = lineTotalAmount * (line.discountPercent ?? 0) / 100;
+    const lineDiscount = roundCents(discountFractional);
+    discount += lineDiscount;
+
+    // Calculate line VAT (on amount after discount)
+    const amountAfterDiscount = lineTotalAmount - lineDiscount;
+    const vatFractional = amountAfterDiscount * (line.vatRate ?? 0) / 100;
+    const lineVat = roundCents(vatFractional);
+    vat += lineVat;
+  }
+
+  const voucher = invoice.voucher?.amount ?? 0;
+
+  // Clamp total at 0
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+
+  return ok({ subtotal, discount, vat, voucher, total });
+}
diff --git a/test/totals.test.js b/test/totals.test.js
