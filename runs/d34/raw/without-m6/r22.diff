@@ -0,0 +1,214 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const r = lineTotal({ qty: 10, unitPrice: 5000 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 50000);
+});
+
+test('lineTotal returns INVALID_LINE for missing qty', () => {
+  const r = lineTotal({ unitPrice: 5000 });
+  assert.deepEqual(r, { ok: false, error: 'INVALID_LINE' });
+});
+
+test('lineTotal returns INVALID_LINE for missing unitPrice', () => {
+  const r = lineTotal({ qty: 10 });
+  assert.deepEqual(r, { ok: false, error: 'INVALID_LINE' });
+});
+
+test('lineTotal returns INVALID_LINE for null line', () => {
+  const r = lineTotal(null);
+  assert.deepEqual(r, { ok: false, error: 'INVALID_LINE' });
+});
+
+test('lineTotal with zero qty', () => {
+  const r = lineTotal({ qty: 0, unitPrice: 5000 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 0);
+});
+
+test('lineTotal with large numbers', () => {
+  const r = lineTotal({ qty: 1000000, unitPrice: 1000000 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 1000000000000);
+});
+
+test('invoiceTotals basic calculation', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 50000);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 10500);
+  assert.equal(r.value.voucher, 0);
+  assert.equal(r.value.total, 60500);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 5000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 50000);
+  assert.equal(r.value.discount, 5000);
+  assert.equal(r.value.vat, 9450);
+  assert.equal(r.value.total, 54450);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+      { qty: 3, unitPrice: 5000, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 40000);
+  assert.equal(r.value.discount, 0);
+  // Line 1 VAT: 25000 * 0.21 = 5250, Line 2 VAT: 15000 * 0.09 = 1350
+  assert.equal(r.value.vat, 6600);
+  assert.equal(r.value.total, 46600);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE10', amount: 5000 },
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 50000);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 10500);
+  assert.equal(r.value.voucher, 5000);
+  assert.equal(r.value.total, 55500);
+});
+
+test('invoiceTotals returns INVALID_INVOICE for null invoice', () => {
+  const r = invoiceTotals(null);
+  assert.deepEqual(r, { ok: false, error: 'INVALID_INVOICE' });
+});
+
+test('invoiceTotals returns INVALID_INVOICE for empty lines', () => {
+  const r = invoiceTotals({ lines: [] });
+  assert.deepEqual(r, { ok: false, error: 'INVALID_INVOICE' });
+});
+
+test('invoiceTotals returns INVALID_INVOICE for missing lines', () => {
+  const r = invoiceTotals({});
+  assert.deepEqual(r, { ok: false, error: 'INVALID_INVOICE' });
+});
+
+test('invoiceTotals clamps total at zero', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE', amount: 100000 },
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.total, 0);
+});
+
+test('invoiceTotals with zero VAT rate', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 5000, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 50000);
+  assert.equal(r.value.vat, 0);
+  assert.equal(r.value.total, 50000);
+});
+
+test('invoiceTotals without discount and VAT fields', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 5000 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 50000);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 0);
+  assert.equal(r.value.total, 50000);
+});
+
+test('invoiceTotals with multiple lines and discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 10000, discountPercent: 5, vatRate: 21 },
+      { qty: 3, unitPrice: 8000, discountPercent: 10, vatRate: 9 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+
+  // Line 1: 50000 - 2500 = 47500, VAT: 47500 * 0.21 = 9975
+  // Line 2: 24000 - 2400 = 21600, VAT: 21600 * 0.09 = 1944
+  assert.equal(r.value.subtotal, 74000);
+  assert.equal(r.value.discount, 4900);
+  assert.equal(r.value.vat, 11919);
+});
+
+test('invoiceTotals returns error from lineTotal', () => {
+  const invoice = {
+    lines: [
+      { unitPrice: 5000 }, // Missing qty
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'INVALID_LINE');
+});
+
+test('invoiceTotals without voucher field', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher, 0);
+});
+
+test('invoiceTotals with large amounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1000, unitPrice: 100000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 100000000);
+  assert.equal(r.value.vat, 21000000);
+  assert.equal(r.value.total, 121000000);
+});
