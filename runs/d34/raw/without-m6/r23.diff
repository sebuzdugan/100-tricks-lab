-    // Calculate line discount
-    const discountFractional = lineTotalAmount * (line.discountPercent ?? 0) / 100;
-    const lineDiscount = roundCents(discountFractional);
+    // Calculate first discount (line or tier discount)
+    const discountFractional1 = lineTotalAmount * (line.discountPercent ?? 0) / 100;
+    const lineDiscount1 = roundCents(discountFractional1);
+
+    // Calculate bulk discount (2.5% if qty >= 10, applied to amount after first discount)
+    let lineDiscount2 = 0;
+    if (line.qty >= 10) {
+      const bulkDiscountFractional = (lineTotalAmount - lineDiscount1) * 2.5 / 100;
+      lineDiscount2 = roundCents(bulkDiscountFractional);
+    }
+
+    const lineDiscount = lineDiscount1 + lineDiscount2;
     discount += lineDiscount;
 
-    // Calculate line VAT (on amount after discount)
+    // Calculate line VAT (on amount after all discounts)
     const amountAfterDiscount = lineTotalAmount - lineDiscount;
     const vatFractional = amountAfterDiscount * (line.vatRate ?? 0) / 100;
     const lineVat = roundCents(vatFractional);
