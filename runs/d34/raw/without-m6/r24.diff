+/**
+ * Generate a dashboard summary of invoice metrics.
+ * @param {Array} invoices
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Validate invoices is an array
+  if (!Array.isArray(invoices)) {
+    return fail('INVALID_INVOICE');
+  }
+
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const inv of invoices) {
+    if (inv && inv.status && counts.hasOwnProperty(inv.status)) {
+      counts[inv.status]++;
+    }
+  }
+
+  // Calculate outstanding (issued + partially_paid with balance due)
+  let outstanding = 0;
+  for (const inv of invoices) {
+    if (inv && (inv.status === 'issued' || inv.status === 'partially_paid')) {
+      outstanding += balanceDue(inv);
+    }
+  }
+
+  // Get overdue invoices
+  const overdueResult = overdueInvoices(invoices, asOf);
+  const overdue = overdueResult.ok
+    ? { count: overdueResult.value.length, amount: overdueResult.value.reduce((sum, inv) => sum + inv.due, 0) }
+    : { count: 0, amount: 0 };
+
+  // Calculate top 3 customers by amount due
+  const customerDueMap = {};
+  for (const inv of invoices) {
+    if (inv && inv.customerId && (inv.status === 'issued' || inv.status === 'partially_paid')) {
+      const due = balanceDue(inv);
+      if (!customerDueMap[inv.customerId]) {
+        customerDueMap[inv.customerId] = 0;
+      }
+      customerDueMap[inv.customerId] += due;
+    }
+  }
+
+  const topCustomers = Object.entries(customerDueMap)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  });
+}
