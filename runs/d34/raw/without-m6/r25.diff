+test('renderInvoiceText displays voucher before total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const voucherResult = applyVoucher(invoiceResult.value, { amount: 10000 });
+  assert.equal(voucherResult.ok, true);
+
+  const r = renderInvoiceText(voucherResult.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  const lines = text.split('\n');
+  const voucherLineIndex = lines.findIndex(l => l.startsWith('Voucher:'));
+  const totalLineIndex = lines.findIndex(l => l.startsWith('Total:'));
+  assert(voucherLineIndex !== -1, 'Voucher line should exist');
+  assert(voucherLineIndex < totalLineIndex, 'Voucher line should appear before Total line');
+});
