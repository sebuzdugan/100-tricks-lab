+test('renderInvoiceText shows voucher when applied', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const voucherResult = applyVoucher(invoiceResult.value, { amount: 10000 });
