+test('renderInvoiceText with voucher, due date, and payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invoiceResult.ok, true);
+
+  const voucherResult = applyVoucher(invoiceResult.value, { amount: 5000 });
+  assert.equal(voucherResult.ok, true);
+
+  const issueResult = issueInvoice(voucherResult.value, []);
+  assert.equal(issueResult.ok, true);
+
+  const paymentResult = recordPayment(issueResult.value, { amount: 40000, date: '2026-10-08' });
+  assert.equal(paymentResult.ok, true);
+
+  const r = renderInvoiceText(paymentResult.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.match(text, /Voucher: -€50\.00/);
+  assert.match(text, /Due: 2026-11-06/);
+  assert.match(text, /Paid: €400\.00/);
+
+  const lines = text.split('\n');
+  const voucherLineIndex = lines.findIndex(l => l.startsWith('Voucher:'));
+  const totalLineIndex = lines.findIndex(l => l.startsWith('Total:'));
+  const dueLineIndex = lines.findIndex(l => l.startsWith('Due:'));
+  const paidLineIndex = lines.findIndex(l => l.startsWith('Paid:'));
+
+  assert(voucherLineIndex < totalLineIndex, 'Voucher should be before Total');
+  assert(totalLineIndex < dueLineIndex, 'Total should be before Due');
+  assert(dueLineIndex < paidLineIndex, 'Due should be before Paid');
+});
