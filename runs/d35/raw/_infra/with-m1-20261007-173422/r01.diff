+import { test } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice: happy path with valid inputs', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DEV-HOUR',
+    name: 'Development (hour)',
+    qty: 10,
+    unitPrice: 9500,
+    vatRate: 21,
+  });
+
+  assert.deepEqual(result.value.lines[1], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 5,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice: single line item', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 1);
+  assert.equal(result.value.lines[0].name, 'Logo package');
+  assert.equal(result.value.lines[0].unitPrice, 120000);
+});
+
+test('createInvoice: various VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice: CUSTOMER_NOT_FOUND', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice: DATE_INVALID - wrong format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '10/07/2026',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: DATE_INVALID - invalid date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: DATE_INVALID - missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: NO_LINES - empty array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice: NO_LINES - null lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice: NO_LINES - undefined lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: undefined,
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice: QTY_INVALID - zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: QTY_INVALID - negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: QTY_INVALID - fractional quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 2.5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: QTY_INVALID - non-numeric quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 'five' }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: UNKNOWN_SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice: error in second line item', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'BAD-SKU', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice: does not mutate input', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 1 }];
+  const input = { customerId: 'C-001', issueDate: '2026-10-07', lines };
+
+  createInvoice(input);
+
+  assert.deepEqual(lines, [{ sku: 'DEV-HOUR', qty: 1 }]);
+  assert.deepEqual(input, { customerId: 'C-001', issueDate: '2026-10-07', lines });
+});
+
+test('createInvoice: valid dates at boundaries', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2000-01-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result1.ok, true);
+
+  const result2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2099-12-31',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result2.ok, true);
+});
