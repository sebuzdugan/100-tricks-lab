+/**
+ * Add or increase a line on an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {{ sku: string, qty: number }} input
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (!isValidQty(qty)) return fail('QTY_INVALID');
+
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return fail('UNKNOWN_SKU');
+
+  const product = productResult.value;
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+
+  const existingIndex = newLines.findIndex((line) => line.sku === sku);
+  if (existingIndex >= 0) {
+    newLines[existingIndex] = {
+      ...newLines[existingIndex],
+      qty: newLines[existingIndex].qty + qty,
+    };
+  } else {
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const index = invoice.lines.findIndex((line) => line.sku === sku);
+  if (index < 0) return fail('LINE_NOT_FOUND');
+
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: newLines,
+  });
+}
