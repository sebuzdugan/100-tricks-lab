+/**
+ * Get the next invoice number for a given date.
+ * Format: INV-YYYY-0001 (4-digit zero-padded counter, resets each year).
+ * @param {Array<string>} existingNumbers - Invoice numbers already in use
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const yearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.slice(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  const maxCounter = yearNumbers.length > 0 ? Math.max(...yearNumbers) : 0;
+  const nextCounter = (maxCounter + 1).toString().padStart(4, '0');
+
+  return `${prefix}${nextCounter}`;
+}
