diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..212ef47
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,68 @@
+import { test } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber: first invoice of the year', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: sequential invoices same year', () => {
+  const existing = ['INV-2026-0001'];
+  const result = nextInvoiceNumber(existing, '2026-10-15');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: multiple invoices same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const result = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber: unordered existing numbers', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'];
+  const result = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber: counter wraps to 4 digits', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const result = nextInvoiceNumber(existing, '2026-11-11');
+  assert.equal(result, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber: ignores other years', () => {
+  const existing = ['INV-2025-0099', 'INV-2026-0001', 'INV-2027-0001'];
+  const result = nextInvoiceNumber(existing, '2026-08-20');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: year resets counter', () => {
+  const existing = ['INV-2025-0099', 'INV-2025-0100'];
+  const result = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: ignores malformed numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-ABC', 'BAD-NUMBER', 'INV-2026-0002'];
+  const result = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(result, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber: handles large counters', () => {
+  const existing = ['INV-2026-9999'];
+  const result = nextInvoiceNumber(existing, '2026-07-01');
+  assert.equal(result, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber: padding with zeros', () => {
+  const existing = [];
+  const result1 = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(result1, 'INV-2026-0001');
+
+  const result2 = nextInvoiceNumber(['INV-2026-0001'], '2026-02-01');
+  assert.equal(result2, 'INV-2026-0002');
+
+  const result3 = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0002', ...(Array.from({ length: 8 }, (_, i) => `INV-2026-${String(i + 3).padStart(4, '0')}`))], '2026-03-01');
+  assert.equal(result3, 'INV-2026-0011');
+});
