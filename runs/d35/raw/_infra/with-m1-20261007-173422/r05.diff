+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { invoiceTotals, lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display.
+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customer = customerResult.ok ? customerResult.value : null;
+
+  const lines = [];
+
+  const invoiceNumber = invoice.number || 'DRAFT';
+  lines.push(invoiceNumber);
+
+  if (customer) {
+    lines.push(customer.name);
+  }
+
+  const totals = invoiceTotals(invoice);
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const qtyStr = line.qty.toString();
+    const nameStr = line.name;
+    const priceStr = formatEuros(line.unitPrice);
+    const totalStr = formatEuros(total);
+    lines.push(`${qtyStr} ${nameStr} ${priceStr} ${totalStr}`);
+  }
+
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
