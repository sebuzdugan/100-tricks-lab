+import { test } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText: draft invoice with one line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '10 Development (hour) €95.00 €950.00');
+  assert.equal(lines[3], 'Total: €950.00');
+});
+
+test('renderInvoiceText: issued invoice with number', () => {
+  const result1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result1.ok, true);
+
+  const result2 = issueInvoice(result1.value, []);
+  assert.equal(result2.ok, true);
+
+  const text = renderInvoiceText(result2.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.equal(lines[2], '5 Design work (hour) €85.00 €425.00');
+  assert.equal(lines[3], 'Total: €425.00');
+});
+
+test('renderInvoiceText: multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '10 Development (hour) €95.00 €950.00');
+  assert.equal(lines[3], '5 Design work (hour) €85.00 €425.00');
+  assert.equal(lines[4], '2 Copywriting (hour) €60.00 €120.00');
+  assert.equal(lines[5], 'Total: €1,495.00');
+});
+
+test('renderInvoiceText: expensive items', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '1 Logo package €1,200.00 €1,200.00');
+  assert.equal(lines[3], '1 Brand guidelines document €2,450.00 €2,450.00');
+  assert.equal(lines[4], 'Total: €3,650.00');
+});
+
+test('renderInvoiceText: small amounts', () => {
+  const result = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 100 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Marlow "The Print Shop"');
+  assert.equal(lines[2], '100 Sticker sheet €0.50 €50.00');
+  assert.equal(lines[3], '2 Icon set (24 icons) €9.80 €19.60');
+  assert.equal(lines[4], 'Total: €69.60');
+});
+
+test('renderInvoiceText: large quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-009',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PRINT-A4', qty: 5000 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Pine & Pixel');
+  assert.equal(lines[2], '5000 Printed flyer A4 (each) €0.37 €1,850.00');
+  assert.equal(lines[3], 'Total: €1,850.00');
+});
+
+test('renderInvoiceText: line breaks structure', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'DES-HOUR', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert(lines[2].startsWith('1 '));
+  assert(lines[3].startsWith('1 '));
+  assert(lines[4].startsWith('Total: '));
+});
+
+test('renderInvoiceText: sequential invoice numbers', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv1Result.ok, true);
+
+  const issued1 = issueInvoice(inv1Result.value, []);
+  assert.equal(issued1.ok, true);
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv2Result.ok, true);
+
+  const issued2 = issueInvoice(inv2Result.value, [issued1.value.number]);
+  assert.equal(issued2.ok, true);
+
+  const text1 = renderInvoiceText(issued1.value);
+  const text2 = renderInvoiceText(issued2.value);
+
+  assert(text1.startsWith('INV-2026-0001'));
+  assert(text2.startsWith('INV-2026-0002'));
+});
+
+test('renderInvoiceText: with quoted customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Marlow "The Print Shop"');
+});
+
+test('renderInvoiceText: currency formatting with commas', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert(lines[2].includes('€2,450.00'));
+  assert(lines[3].includes('€12,250.00'));
+});
+
+test('renderInvoiceText: does not mutate invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+
+  const original = JSON.parse(JSON.stringify(result.value));
+  renderInvoiceText(result.value);
+
+  assert.deepEqual(result.value, original);
+});
