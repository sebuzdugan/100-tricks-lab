+test('normalizeId: converts lowercase to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+});
+
+test('normalizeId: trims whitespace', () => {
+  assert.equal(normalizeId('  C-001  '), 'C-001');
+  assert.equal(normalizeId('C-001 '), 'C-001');
+  assert.equal(normalizeId(' C-001'), 'C-001');
+});
+
+test('normalizeId: handles mixed case with spaces', () => {
+  assert.equal(normalizeId('  c-007 '), 'C-007');
+  assert.equal(normalizeId('C-007 '), 'C-007');
+  assert.equal(normalizeId('c-007'), 'C-007');
+});
+
+test('normalizeId: already normalized stays the same', () => {
+  assert.equal(normalizeId('C-001'), 'C-001');
+});
+
+test('getCustomer: normalizes input before lookup', () => {
+  const result1 = getCustomer('c-001');
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.name, 'Northwind Studio');
+
+  const result2 = getCustomer('  C-001  ');
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.name, 'Northwind Studio');
+
+  const result3 = getCustomer('c-007 ');
+  assert.equal(result3.ok, true);
+  assert.equal(result3.value.name, 'Halvorsen Architects');
+});
+
+test('getCustomer: still reports unknown id for normalized non-existent id', () => {
+  assert.deepEqual(getCustomer('c-999'), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+  assert.deepEqual(getCustomer('  C-999  '), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
