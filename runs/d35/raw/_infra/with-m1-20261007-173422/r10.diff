diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..b3f550b
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,126 @@
+import { test } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate: accepts valid YYYY-MM-DD dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+  assert.equal(isValidDate('2025-02-28'), true);
+});
+
+test('isValidDate: rejects invalid formats', () => {
+  assert.equal(isValidDate('10/07/2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('26-10-07'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate: rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-01-32'), false);
+});
+
+test('isValidDate: handles leap years', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('addDays: adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 365), '2027-10-07');
+});
+
+test('addDays: subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+  assert.equal(addDays('2026-10-07', -7), '2026-09-30');
+});
+
+test('addDays: handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-03-01', -1), '2026-02-28');
+});
+
+test('addDays: handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays: zero days returns same date', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays: handles leap year transitions', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+});
+
+test('daysBetween: same date returns 0', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween: positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-11-07'), 31);
+});
+
+test('daysBetween: negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+  assert.equal(daysBetween('2026-11-07', '2026-10-07'), -31);
+});
+
+test('daysBetween: across months', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-02-28', '2026-03-01'), 1);
+});
+
+test('daysBetween: across years', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween: large differences', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-12-31'), 364);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween: leap year handling', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365);
+});
+
+test('isValidDate and addDays work together', () => {
+  const date = '2026-10-07';
+  assert.equal(isValidDate(date), true);
+
+  const nextDay = addDays(date, 1);
+  assert.equal(isValidDate(nextDay), true);
+  assert.equal(nextDay, '2026-10-08');
+
+  const prevDay = addDays(date, -1);
+  assert.equal(isValidDate(prevDay), true);
+  assert.equal(prevDay, '2026-10-06');
+});
+
+test('isValidDate and daysBetween work together', () => {
+  const dateA = '2026-10-07';
+  const dateB = '2026-10-17';
+
+  assert.equal(isValidDate(dateA), true);
+  assert.equal(isValidDate(dateB), true);
+  assert.equal(daysBetween(dateA, dateB), 10);
+  assert.equal(daysBetween(dateB, dateA), -10);
+});
