+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {{ amount: number, date: string }} input
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!isValidAmount(amount)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  const paid = sumPayments(invoice.payments);
+  const owed = Math.max(0, totals.total - paid);
+
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = invoice.payments ? [...invoice.payments] : [];
+  newPayments.push({ amount, date });
+
+  const newPaid = paid + amount;
+  const newStatus = newPaid >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    number: invoice.number,
+    status: newStatus,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments: newPayments,
+  });
+}
+
+/**
+ * Calculate the balance still due on an invoice.
+ * @param {{ status?: string, lines?: Array, payments?: Array }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = sumPayments(invoice.payments);
+  return Math.max(0, totals.total - paid);
+}
+
+function isValidAmount(amount) {
+  return Number.isInteger(amount) && amount > 0;
+}
+
+function sumPayments(payments) {
+  if (!payments || !Array.isArray(payments)) return 0;
+  return payments.reduce((sum, payment) => sum + payment.amount, 0);
+}
