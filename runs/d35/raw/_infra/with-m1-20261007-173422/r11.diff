+
+test('recordPayment: multiple payments', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+
+  const payment1Result = recordPayment(issuedResult.value, { amount: 30000, date: '2026-10-10' });
+  assert.equal(payment1Result.ok, true);
+  assert.equal(payment1Result.value.status, 'partially_paid');
+  assert.equal(payment1Result.value.payments.length, 1);
+
+  const payment2Result = recordPayment(payment1Result.value, { amount: 30000, date: '2026-10-15' });
+  assert.equal(payment2Result.ok, true);
+  assert.equal(payment2Result.value.status, 'partially_paid');
+  assert.equal(payment2Result.value.payments.length, 2);
+  assert.deepEqual(payment2Result.value.payments[1], { amount: 30000, date: '2026-10-15' });
+});
+
+test('recordPayment: does not mutate original invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  const original = JSON.parse(JSON.stringify(issuedResult.value));
+
+  recordPayment(issuedResult.value, { amount: 50000, date: '2026-10-10' });
+
+  assert.deepEqual(issuedResult.value, original);
+});
+
+test('recordPayment: preserves invoice data', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+
+  const paymentResult = recordPayment(issuedResult.value, { amount: 50000, date: '2026-10-10' });
+
+  assert.equal(paymentResult.value.customerId, 'C-001');
+  assert.equal(paymentResult.value.issueDate, '2026-10-07');
+  assert.equal(paymentResult.value.status, 'partially_paid');
+  assert.equal(paymentResult.value.lines.length, 1);
+});
+
+test('recordPayment: on partially_paid invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  const partial1 = recordPayment(issuedResult.value, { amount: 30000, date: '2026-10-10' });
+
+  const partial2Result = recordPayment(partial1.value, { amount: 30000, date: '2026-10-15' });
+
+  assert.equal(partial2Result.ok, true);
+  assert.equal(partial2Result.value.payments.length, 2);
+});
+
+test('balanceDue: no payments returns full balance', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  const due = balanceDue(issuedResult.value);
+
+  const expectedTotal = issuedResult.value.lines[0].qty * issuedResult.value.lines[0].unitPrice * 1.21;
+
+  assert.equal(due, Math.round(expectedTotal));
+});
+
+test('balanceDue: after partial payment', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  const paidResult = recordPayment(issuedResult.value, { amount: 50000, date: '2026-10-10' });
+
+  const due = balanceDue(paidResult.value);
+  const expectedTotal = issuedResult.value.lines[0].qty * issuedResult.value.lines[0].unitPrice * 1.21;
+
+  assert.equal(due, Math.round(expectedTotal) - 50000);
+});
+
+test('balanceDue: after full payment returns zero', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  const totals = invoiceTotals(issuedResult.value);
