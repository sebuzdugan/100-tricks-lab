+  const paidResult = recordPayment(issuedResult.value, { amount: totals.total, date: '2026-10-10' });
+
+  const due = balanceDue(paidResult.value);
+
+  assert.equal(due, 0);
+});
+
+test('balanceDue: on unpaid issued invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+
+  const due = balanceDue(issuedResult.value);
+  const expectedTotal = issuedResult.value.lines[0].qty * issuedResult.value.lines[0].unitPrice * 1.21;
+
+  assert.equal(due, Math.round(expectedTotal));
+});
+
+test('balanceDue: with multiple payments', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  const p1Result = recordPayment(issuedResult.value, { amount: 30000, date: '2026-10-10' });
+  const p2Result = recordPayment(p1Result.value, { amount: 25000, date: '2026-10-15' });
+
+  const due = balanceDue(p2Result.value);
+  const expectedTotal = issuedResult.value.lines[0].qty * issuedResult.value.lines[0].unitPrice * 1.21;
+
+  assert.equal(due, Math.round(expectedTotal) - 30000 - 25000);
+});
+
+test('balanceDue: never negative', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+
+  const invoice = {
+    customerId: issuedResult.value.customerId,
+    issueDate: issuedResult.value.issueDate,
+    status: 'paid',
+    lines: issuedResult.value.lines,
+    payments: [{ amount: 999999999, date: '2026-10-10' }],
+  };
+
+  const due = balanceDue(invoice);
+
+  assert.equal(due, 0);
+});
