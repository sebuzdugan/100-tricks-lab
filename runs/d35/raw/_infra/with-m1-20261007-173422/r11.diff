+import { test } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment: add payment to issued invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+
+  const paymentResult = recordPayment(issuedResult.value, { amount: 50000, date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'partially_paid');
+  assert.equal(paymentResult.value.payments.length, 1);
+  assert.deepEqual(paymentResult.value.payments[0], { amount: 50000, date: '2026-10-10' });
+});
+
+test('recordPayment: payment covers full balance', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  const totalDue = issuedResult.value.lines[0].qty * issuedResult.value.lines[0].unitPrice * 1.21;
+
+  const paymentResult = recordPayment(issuedResult.value, { amount: Math.round(totalDue), date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'paid');
+});
+
+test('recordPayment: NOT_ISSUED for draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const paymentResult = recordPayment(result.value, { amount: 50000, date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, false);
+  assert.equal(paymentResult.error, 'NOT_ISSUED');
+});
+
+test('recordPayment: NOT_ISSUED for paid invoice', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+  const totals = invoiceTotals(issuedResult.value);
+
+  const paidResult = recordPayment(issuedResult.value, { amount: totals.total, date: '2026-10-10' });
+
+  const secondPaymentResult = recordPayment(paidResult.value, { amount: 100, date: '2026-10-11' });
+
+  assert.equal(secondPaymentResult.ok, false);
+  assert.equal(secondPaymentResult.error, 'NOT_ISSUED');
+});
+
+test('recordPayment: AMOUNT_INVALID for zero', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+
+  const paymentResult = recordPayment(issuedResult.value, { amount: 0, date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, false);
+  assert.equal(paymentResult.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: AMOUNT_INVALID for negative', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+
+  const paymentResult = recordPayment(issuedResult.value, { amount: -100, date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, false);
+  assert.equal(paymentResult.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: AMOUNT_INVALID for fractional', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(draftResult.value, []);
+
+  const paymentResult = recordPayment(issuedResult.value, { amount: 100.5, date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, false);
+  assert.equal(paymentResult.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: OVERPAYMENT', () => {
+  const draftResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
