+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice with valid single line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+  assert.equal(result.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[0].qty, 10);
+  assert.equal(result.value.lines[0].unitPrice, 9500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-02-20',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[1].name, 'Logo package');
+  assert.equal(result.value.lines[2].name, 'Printed flyer A4 (each)');
+});
+
+test('createInvoice with invalid customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice with invalid date format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '15-01-2026',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice with invalid date (non-existent)', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice with non-string date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: 20260115,
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice with empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice with non-array lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: null,
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice with non-integer qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5.5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice with zero qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice with negative qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice with unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice does not mutate input lines array', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 5 }];
+  const originalLine = { ...lines[0] };
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines,
+  });
+
+  assert.deepEqual(lines[0], originalLine);
+});
+
+test('createInvoice returns a new lines array', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 5 }];
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines,
+  });
+
+  assert.notEqual(result.value.lines, lines);
+});
+
+test('createInvoice with various VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 1 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice with large quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'STICKER', qty: 10000 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].qty, 10000);
+});
+
+test('createInvoice stops at first validation error in lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'UNKNOWN-SKU', qty: 10 },
+      { sku: 'DEV-HOUR', qty: -1 },
+    ],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
