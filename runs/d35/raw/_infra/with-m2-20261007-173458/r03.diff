+test('addLine adds a new line to an invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const result = addLine(invoice, { sku: 'COPY-HOUR', qty: 3 });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[1].sku, 'COPY-HOUR');
+  assert.equal(result.value.lines[1].name, 'Copywriting (hour)');
+  assert.equal(result.value.lines[1].qty, 3);
+  assert.equal(result.value.lines[1].unitPrice, 6000);
+});
+
