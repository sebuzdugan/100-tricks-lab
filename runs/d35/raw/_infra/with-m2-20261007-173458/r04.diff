+++ b/test/numbering.test.js
@@ -0,0 +1,68 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber with no existing numbers', () => {
+  const number = nextInvoiceNumber([], '2026-01-15');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber with one existing number', () => {
+  const number = nextInvoiceNumber(['INV-2026-0001'], '2026-01-15');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber with multiple existing numbers', () => {
+  const number = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'], '2026-01-15');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from different years', () => {
+  const number = nextInvoiceNumber(['INV-2025-0010', 'INV-2026-0002', 'INV-2027-0001'], '2026-01-15');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber with unordered numbers', () => {
+  const number = nextInvoiceNumber(['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'], '2026-01-15');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber with zero-padded counters', () => {
+  const number = nextInvoiceNumber(['INV-2026-0099'], '2026-02-20');
+  assert.equal(number, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber respects year in issueDate', () => {
+  const number2025 = nextInvoiceNumber(['INV-2025-0005'], '2025-12-31');
+  assert.equal(number2025, 'INV-2025-0006');
+
+  const number2026 = nextInvoiceNumber(['INV-2025-0005'], '2026-01-01');
+  assert.equal(number2026, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber starts fresh for new year even with high counter elsewhere', () => {
+  const number = nextInvoiceNumber(['INV-2025-0999'], '2026-03-15');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const number = nextInvoiceNumber(['INV-2026-9998'], '2026-01-15');
+  assert.equal(number, 'INV-2026-9999');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2026-0001', 'INV-2026-ABC', 'NOT-A-NUMBER', 'INV-2026-00001'],
+    '2026-01-15'
+  );
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber does not mutate existingNumbers', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0002'];
+  const original = JSON.stringify(numbers);
+
+  nextInvoiceNumber(numbers, '2026-01-15');
+
+  assert.equal(JSON.stringify(numbers), original);
+});
