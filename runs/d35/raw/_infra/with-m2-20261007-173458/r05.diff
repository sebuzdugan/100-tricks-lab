+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, addLine, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText with draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const rendered = renderInvoiceText(result.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /5x Development \(hour\) @ €95\.00 = €475\.00\n/);
+  assert.match(text, /Total: €475\.00$/);
+});
+
+test('renderInvoiceText with issued invoice', () => {
+  const createResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issueResult = issueInvoice(createResult.value, []);
+  const rendered = renderInvoiceText(issueResult.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  assert.match(text, /^INV-2026-0001\n/);
+  assert.match(text, /Blue Fern Bakery\n/);
+  assert.match(text, /1x Logo package @ €1,200\.00 = €1,200\.00\n/);
+  assert.match(text, /Total: €1,200\.00$/);
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+
+  const rendered = renderInvoiceText(result.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /3x Design work \(hour\) @ €85\.00 = €255\.00/);
+  assert.match(lines[3], /5x Development \(hour\) @ €95\.00 = €475\.00/);
+  assert.match(lines[4], /2x Copywriting \(hour\) @ €60\.00 = €120\.00/);
+  assert.equal(lines[5], 'Total: €850.00');
+});
+
+test('renderInvoiceText with large quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'PRINT-A4', qty: 500 }],
+  });
+
+  const rendered = renderInvoiceText(result.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  assert.match(text, /500x Printed flyer A4 \(each\) @ €0\.37 = €185\.00/);
+});
+
+test('renderInvoiceText with high-value items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+
+  const rendered = renderInvoiceText(result.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  assert.match(text, /1x Brand guidelines document @ €2,450\.00 = €2,450\.00/);
+  assert.match(text, /Total: €2,450\.00$/);
+});
+
+test('renderInvoiceText with items of different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 1 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  const rendered = renderInvoiceText(result.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  assert.match(text, /1x Development \(hour\) @ €95\.00 = €95\.00/);
+  assert.match(text, /1x Printed flyer A4 \(each\) @ €0\.37 = €0\.37/);
+  assert.match(text, /1x Brand workshop \(day, VAT exempt\) @ €600\.00 = €600\.00/);
+  assert.match(text, /Total: €695\.37$/);
+});
+
+test('renderInvoiceText with invoice number sequence', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const issueResult = issueInvoice(createResult.value, ['INV-2026-0001', 'INV-2026-0002']);
+  const rendered = renderInvoiceText(issueResult.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  assert.match(text, /^INV-2026-0003\n/);
+});
+
+test('renderInvoiceText with different year invoice numbers', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-06-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const issueResult = issueInvoice(createResult.value, ['INV-2026-0001']);
+  const rendered = renderInvoiceText(issueResult.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  assert.match(text, /^INV-2027-0001\n/);
+});
+
+test('renderInvoiceText with unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const rendered = renderInvoiceText(invoice);
+
+  assert.equal(rendered.ok, false);
+  assert.equal(rendered.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('renderInvoiceText after chaining addLine', () => {
+  const createResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-02-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const addResult1 = addLine(createResult.value, { sku: 'COPY-HOUR', qty: 3 });
+  const addResult2 = addLine(addResult1.value, { sku: 'DEV-HOUR', qty: 2 });
+
+  const rendered = renderInvoiceText(addResult2.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.match(lines[2], /7x Development/);
+  assert.match(lines[3], /3x Copywriting/);
+});
+
+test('renderInvoiceText formats all amounts through formatEuros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'ICON-SET', qty: 3 },
+      { sku: 'STICKER', qty: 7 },
+    ],
+  });
+
+  const rendered = renderInvoiceText(result.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  assert.match(text, /€9\.80/);
+  assert.match(text, /€0\.50/);
+});
+
+test('renderInvoiceText with single line', () => {
+  const result = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2026-03-10',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  });
+
+  const rendered = renderInvoiceText(result.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Lumen Records');
+  assert.match(lines[2], /2x Brand workshop/);
+  assert.match(lines[3], /Total:/);
+});
+
+test('renderInvoiceText output is readable', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 20 },
+    ],
+  });
+
+  const rendered = renderInvoiceText(result.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+  assert.ok(text.includes('Design work (hour)'));
+  assert.ok(text.includes('Development (hour)'));
+  assert.ok(text.includes('@'));
+  assert.ok(text.includes('='));
+  assert.ok(text.includes('Total:'));
+  assert.ok(text.includes('€'));
+});
+
+test('renderInvoiceText does not mutate invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const originalInvoice = JSON.stringify(invoice);
+  renderInvoiceText(invoice);
+
+  assert.equal(JSON.stringify(invoice), originalInvoice);
+});
