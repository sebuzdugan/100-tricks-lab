+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 2 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+  assert.equal(result.value.lines[1].discountPercent, 5);
+  assert.equal(result.value.lines[2].discountPercent, 5);
+});
+
+test('createInvoice applies tier discount to all silver customer lines', () => {
+  const result = createInvoice({
+    customerId: 'C-010',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+  assert.equal(result.value.lines[1].discountPercent, 2.5);
+});
+
+test('invoiceTotals with tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const totals = invoiceTotals(result.value);
+  const lineTotal_ = 10 * 9500;
+  const discount = Math.round((lineTotal_ * 5) / 100);
+  assert.equal(totals.subtotal, lineTotal_);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.total, lineTotal_ - discount);
+});
+
+test('renderInvoiceText shows tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const rendered = renderInvoiceText(result.value);
+
+  assert.equal(rendered.ok, true);
+  const text = rendered.value;
+  assert.match(text, /5% off/);
+});
+
+test('createInvoice tier discount works with different tiers', () => {
+  const goldResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const silverResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const standardResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const goldTotals = invoiceTotals(goldResult.value);
+  const silverTotals = invoiceTotals(silverResult.value);
+  const standardTotals = invoiceTotals(standardResult.value);
+
+  assert.ok(goldTotals.discount > silverTotals.discount);
+  assert.ok(silverTotals.discount > standardTotals.discount);
+  assert.equal(standardTotals.discount, 0);
+});
