--- a/src/invoices.js
+++ b/src/invoices.js
@@ -79,24 +79,41 @@ export function lineDiscount(line) {
   return Math.max(0, discount);
 }
 
+/**
+ * Calculate the VAT for a single line item (computed on amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number} VAT in cents, clamped at 0
+ */
+export function lineVat(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const netAmount = Math.max(0, total - discount);
+  const vat = roundCents((netAmount * line.vatRate) / 100);
+  return Math.max(0, vat);
+}
+
 /**
  * Calculate totals for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }} Totals in cents
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }} Totals in cents
  */
 export function invoiceTotals(invoice) {
   let subtotal = 0;
   let discount = 0;
+  let vat = 0;
   for (const line of invoice.lines) {
     subtotal += lineTotal(line);
     discount += lineDiscount(line);
+    vat += lineVat(line);
   }
   subtotal = roundCents(subtotal);
   discount = roundCents(discount);
-  const total = Math.max(0, subtotal - discount);
+  vat = roundCents(vat);
+  const total = Math.max(0, subtotal - discount + vat);
   return {
     subtotal,
     discount,
+    vat,
     total: roundCents(total),
   };
 }
