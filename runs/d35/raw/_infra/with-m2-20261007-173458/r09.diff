+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('  C-001  '), 'C-001');
+  assert.equal(normalizeId('C-001 '), 'C-001');
+  assert.equal(normalizeId(' C-001'), 'C-001');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-007'), 'C-007');
+  assert.equal(normalizeId('C-001'), 'C-001');
+});
+
+test('normalizeId handles mixed case with spaces', () => {
+  assert.equal(normalizeId('  c-001  '), 'C-001');
+  assert.equal(normalizeId(' c-007 '), 'C-007');
+  assert.equal(normalizeId('c-012 '), 'C-012');
+});
+
+test('normalizeId with tab and newline characters', () => {
+  assert.equal(normalizeId('\tC-001\n'), 'C-001');
+  assert.equal(normalizeId(' \t c-001 \n '), 'C-001');
+});
+
+test('getCustomer finds customer with mixed case ID', () => {
+  const result = getCustomer('c-001');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.id, 'C-001');
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer finds customer with spaces in ID', () => {
+  const result = getCustomer(' C-001 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.id, 'C-001');
+});
+
+test('getCustomer finds customer with mixed case and spaces', () => {
+  const result = getCustomer('  c-007  ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.id, 'C-007');
+  assert.equal(result.value.name, 'Halvorsen Architects');
+});
+
+test('getCustomer with all different customers', () => {
+  for (let i = 1; i <= 12; i++) {
+    const id = `c-${String(i).padStart(3, '0')}`;
+    const result = getCustomer(id);
+    assert.equal(result.ok, true);
+  }
+});
+
+test('getCustomer with spaces and mixed case for different IDs', () => {
+  assert.equal(getCustomer(' c-002 ').value.name, 'Blue Fern Bakery');
+  assert.equal(getCustomer(' C-003 ').value.name, 'Kite & Co');
+  assert.equal(getCustomer('c-008 ').value.name, 'Lumen Records');
+});
+
+test('normalizeId does not mutate string', () => {
+  const id = '  c-001  ';
+  const original = id;
+  normalizeId(id);
+  assert.equal(id, original);
+});
+
+test('normalizeId is idempotent', () => {
+  const id1 = normalizeId('c-001');
+  const id2 = normalizeId(id1);
+  assert.equal(id1, id2);
+});
