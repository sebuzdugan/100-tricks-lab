diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..6f18e0b
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,149 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate with valid dates', () => {
+  assert.equal(isValidDate('2026-01-15'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-25'), true);
+});
+
+test('isValidDate with leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-01-32'), false);
+});
+
+test('isValidDate rejects wrong format', () => {
+  assert.equal(isValidDate('01-15-2026'), false);
+  assert.equal(isValidDate('2026/01/15'), false);
+  assert.equal(isValidDate('2026-1-15'), false);
+  assert.equal(isValidDate('2026-01-5'), false);
+});
+
+test('isValidDate rejects non-string', () => {
+  assert.equal(isValidDate(20260115), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(['2026-01-15']), false);
+});
+
+test('isValidDate rejects strings with spaces', () => {
+  assert.equal(isValidDate(' 2026-01-15'), false);
+  assert.equal(isValidDate('2026-01-15 '), false);
+  assert.equal(isValidDate('2026 -01-15'), false);
+});
+
+test('addDays with positive days', () => {
+  assert.equal(addDays('2026-01-15', 1), '2026-01-16');
+  assert.equal(addDays('2026-01-15', 10), '2026-01-25');
+  assert.equal(addDays('2026-01-15', 100), '2026-04-25');
+});
+
+test('addDays with negative days', () => {
+  assert.equal(addDays('2026-01-15', -1), '2026-01-14');
+  assert.equal(addDays('2026-01-15', -10), '2026-01-05');
+  assert.equal(addDays('2026-01-15', -15), '2025-12-31');
+});
+
+test('addDays with zero', () => {
+  assert.equal(addDays('2026-01-15', 0), '2026-01-15');
+});
+
+test('addDays across month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+});
+
+test('addDays across year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+});
+
+test('addDays with leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays large positive', () => {
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+  assert.equal(addDays('2026-01-01', 1000), '2028-09-27');
+});
+
+test('addDays large negative', () => {
+  assert.equal(addDays('2026-12-31', -365), '2025-12-31');
+  assert.equal(addDays('2026-01-01', -1000), '2023-04-07');
+});
+
+test('daysBetween same dates', () => {
+  assert.equal(daysBetween('2026-01-15', '2026-01-15'), 0);
+});
+
+test('daysBetween forward', () => {
+  assert.equal(daysBetween('2026-01-15', '2026-01-16'), 1);
+  assert.equal(daysBetween('2026-01-15', '2026-01-25'), 10);
+  assert.equal(daysBetween('2026-01-15', '2026-04-25'), 100);
+});
+
+test('daysBetween backward', () => {
+  assert.equal(daysBetween('2026-01-16', '2026-01-15'), -1);
+  assert.equal(daysBetween('2026-01-25', '2026-01-15'), -10);
+});
+
+test('daysBetween across month', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-02-01', '2026-01-31'), -1);
+});
+
+test('daysBetween across year', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+});
+
+test('daysBetween large difference', () => {
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+  assert.equal(daysBetween('2026-01-01', '2028-01-01'), 730);
+});
+
+test('daysBetween with leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const date1 = '2026-01-15';
+  const date2 = addDays(date1, 100);
+  assert.equal(daysBetween(date1, date2), 100);
+
+  const date3 = addDays(date2, -50);
+  assert.equal(daysBetween(date3, date2), 50);
+});
+
+test('isValidDate handles edge cases', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('2026-01-15T00:00:00Z'), false);
+  assert.equal(isValidDate('2026-01-15 00:00:00'), false);
+});
+
+test('addDays returns valid date format', () => {
+  const result = addDays('2026-01-15', 1);
+  assert.equal(isValidDate(result), true);
+  assert.match(result, /^\d{4}-\d{2}-\d{2}$/);
+});
+
+test('daysBetween is precise to whole days', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-01'), 0);
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+  assert.equal(daysBetween('2026-01-01', '2026-01-01'), daysBetween('2026-01-01', '2026-01-01'));
+});
