+import { invoiceTotals } from './invoices.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Record a payment for an invoice.
+ * @param {{ number?: string, customerId: string, issueDate: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  const currentPayments = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  const amountOwed = Math.max(0, totals.total - currentPayments);
+
+  if (amount > amountOwed) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = [...(invoice.payments ?? []), { amount, date }];
+  const totalPaid = currentPayments + amount;
+
+  let newStatus;
+  if (totalPaid >= totals.total) {
+    newStatus = 'paid';
+  } else {
+    newStatus = 'partially_paid';
+  }
+
+  return ok({
+    number: invoice.number,
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: newStatus,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments: newPayments,
+  });
+}
+
+/**
+ * Calculate the balance due on an invoice.
+ * @param {{ lines: Array, payments?: Array }} invoice
+ * @returns {number} Amount due in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
