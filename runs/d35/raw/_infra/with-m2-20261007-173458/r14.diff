+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement with no invoices for customer', () => {
+  const result = statement('C-001', [], '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement with single issued invoice', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issueResult = issueInvoice(createResult.value, []);
+  const invoices = [issueResult.value];
+
+  const result = statement('C-001', invoices, '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(result.value.invoices[0].issueDate, '2026-01-15');
+  assert.ok(result.value.invoices[0].dueDate);
+  assert.ok(result.value.invoices[0].total > 0);
+  assert.ok(result.value.invoices[0].due > 0);
+});
+
+test('statement excludes draft invoices', () => {
+  const draftInvoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const result = statement('C-001', [draftInvoice.value], '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes future-dated invoices', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-06-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issueResult = issueInvoice(createResult.value, []);
+  const invoices = [issueResult.value];
+
+  const result = statement('C-001', invoices, '2026-01-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement includes invoices up to asOf date', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issueResult = issueInvoice(createResult.value, []);
+  const invoices = [issueResult.value];
+
+  const result = statement('C-001', invoices, '2026-01-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement with unknown customer', () => {
+  const result = statement('C-999', [], '2026-12-31');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement with multiple invoices', () => {
+  const invoices = [];
+  const issuedNumbers = [];
+  for (let i = 1; i <= 3; i++) {
+    const createResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: `2026-0${i}-15`,
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    });
+
+    const issueResult = issueInvoice(createResult.value, issuedNumbers);
+    issuedNumbers.push(issueResult.value.number);
+    invoices.push(issueResult.value);
+  }
+
+  const result = statement('C-001', invoices, '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(result.value.invoices[1].number, 'INV-2026-0002');
+  assert.equal(result.value.invoices[2].number, 'INV-2026-0003');
+});
+
+test('statement sorts by issueDate', () => {
+  const invoices = [];
+  const issuedNumbers = [];
+  const dates = ['2026-03-15', '2026-01-15', '2026-02-15'];
+  for (let i = 0; i < 3; i++) {
+    const createResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: dates[i],
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    });
+
+    const issueResult = issueInvoice(createResult.value, issuedNumbers);
+    issuedNumbers.push(issueResult.value.number);
+    invoices.push(issueResult.value);
+  }
+
+  const result = statement('C-001', invoices, '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].issueDate, '2026-01-15');
+  assert.equal(result.value.invoices[1].issueDate, '2026-02-15');
+  assert.equal(result.value.invoices[2].issueDate, '2026-03-15');
+});
+
+test('statement calculates totalDue', () => {
+  const invoices = [];
+  const issuedNumbers = [];
+  for (let i = 1; i <= 2; i++) {
+    const createResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: `2026-0${i}-15`,
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    });
+
+    const issueResult = issueInvoice(createResult.value, issuedNumbers);
+    issuedNumbers.push(issueResult.value.number);
+    invoices.push(issueResult.value);
+  }
+
+  const result = statement('C-001', invoices, '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.totalDue, result.value.invoices[0].due + result.value.invoices[1].due);
+});
+
+test('statement with partially paid invoice', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issueResult = issueInvoice(createResult.value, []);
+  let invoice = issueResult.value;
+
+  const paymentResult = recordPayment(invoice, { amount: 50000, date: '2026-02-01' });
+  invoice = paymentResult.value;
+
+  const result = statement('C-001', [invoice], '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.ok(result.value.invoices[0].due > 0);
+  assert.ok(result.value.invoices[0].due < result.value.invoices[0].total);
+});
+
+test('statement excludes paid invoices', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issueResult = issueInvoice(createResult.value, []);
+  let invoice = issueResult.value;
+
+  const totals = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2026-02-01' });
+  invoice = paymentResult.value;
+
+  const result = statement('C-001', [invoice], '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement with mixed customer invoices', () => {
+  const invoices = [];
+  const issuedNumbers = [];
+
+  for (const customerId of ['C-001', 'C-002', 'C-001']) {
+    const createResult = createInvoice({
+      customerId,
+      issueDate: '2026-01-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    });
+
+    const issueResult = issueInvoice(createResult.value, issuedNumbers);
+    issuedNumbers.push(issueResult.value.number);
+    invoices.push(issueResult.value);
+  }
+
+  const result = statement('C-001', invoices, '2026-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
