+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.strictEqual(result.ok, true);
+  assert.strictEqual(result.value.customerId, 'C-001');
+  assert.strictEqual(result.value.issueDate, '2026-01-15');
+  assert.strictEqual(result.value.status, 'draft');
+  assert.strictEqual(result.value.lines.length, 1);
+
+  const line = result.value.lines[0];
+  assert.strictEqual(line.sku, 'DEV-HOUR');
+  assert.strictEqual(line.name, 'Development (hour)');
+  assert.strictEqual(line.qty, 5);
+  assert.strictEqual(line.unitPrice, 9500);
+  assert.strictEqual(line.vatRate, 21);
+});
+
+test('createInvoice with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-02-20',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.strictEqual(result.ok, true);
+  assert.strictEqual(result.value.lines.length, 3);
+  assert.strictEqual(result.value.lines[0].name, 'Development (hour)');
+  assert.strictEqual(result.value.lines[1].name, 'Design work (hour)');
+  assert.strictEqual(result.value.lines[2].name, 'Logo package');
+});
+
+test('createInvoice fails with CUSTOMER_NOT_FOUND', () => {
+  const result = createInvoice({
+    customerId: 'UNKNOWN',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice fails with DATE_INVALID for missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: undefined,
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice fails with DATE_INVALID for empty string', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice fails with DATE_INVALID for wrong format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '01/15/2026',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice fails with DATE_INVALID for invalid date values', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice fails with DATE_INVALID for non-string date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: 20260115,
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice fails with NO_LINES for empty array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'NO_LINES');
+});
+
+test('createInvoice fails with NO_LINES for undefined lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: undefined,
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'NO_LINES');
+});
+
+test('createInvoice fails with NO_LINES for null lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: null,
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'NO_LINES');
+});
+
+test('createInvoice fails with QTY_INVALID for zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice fails with QTY_INVALID for negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice fails with QTY_INVALID for fractional quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 3.5 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice fails with QTY_INVALID for non-numeric quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 'five' }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice fails with UNKNOWN_SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'INVALID-SKU', qty: 1 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice fails with UNKNOWN_SKU on second line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'INVALID-SKU', qty: 1 },
+    ],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice does not mutate input lines array', () => {
+  const inputLines = [{ sku: 'DEV-HOUR', qty: 5 }];
+  const originalLine = { ...inputLines[0] };
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: inputLines,
+  });
+
+  assert.deepStrictEqual(inputLines[0], originalLine);
+});
+
+test('createInvoice accepts valid dates', () => {
+  const validDates = [
+    '2026-01-01',
+    '2026-12-31',
+    '2025-02-28',
+    '2024-02-29', // leap year
+  ];
+
+  for (const date of validDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.strictEqual(result.ok, true, `Date ${date} should be valid`);
+  }
+});
+
+test('createInvoice with products having different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 }, // 21% VAT
+      { sku: 'PRINT-A4', qty: 100 }, // 9% VAT
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0% VAT
+    ],
+  });
+
+  assert.strictEqual(result.ok, true);
+  assert.strictEqual(result.value.lines[0].vatRate, 21);
+  assert.strictEqual(result.value.lines[1].vatRate, 9);
+  assert.strictEqual(result.value.lines[2].vatRate, 0);
+});
