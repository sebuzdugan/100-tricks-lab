+/**
+ * Calculate the total for a single invoice line (qty times unitPrice in cents).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate invoice totals.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number }> }} invoice
+ * @returns {{ subtotal: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  return {
+    subtotal,
+    total: subtotal,
+  };
+}
