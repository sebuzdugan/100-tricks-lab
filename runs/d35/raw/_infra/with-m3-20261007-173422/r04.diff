diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..eee3fab
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,56 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns INV-2026-0001 for first invoice of the year', () => {
+  const number = nextInvoiceNumber([], '2026-01-15');
+  assert.strictEqual(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber returns next counter for same year', () => {
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-05-20');
+  assert.strictEqual(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber skips to next counter even with gaps', () => {
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-06-10');
+  assert.strictEqual(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existingNumbers = Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existingNumbers, '2026-12-31');
+  assert.strictEqual(number, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0050', 'INV-2026-0001', 'INV-2026-0010'];
+  const number = nextInvoiceNumber(existingNumbers, '2027-01-01');
+  assert.strictEqual(number, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = ['INV-2025-0050', 'INV-2026-0003', 'INV-2027-0005'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-06-15');
+  assert.strictEqual(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber handles unordered input', () => {
+  const existingNumbers = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-03-20');
+  assert.strictEqual(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existingNumbers = ['INV-2026-9999'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-12-31');
+  assert.strictEqual(number, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existingNumbers = ['INV-2026-0001', 'INVALID', 'INV-2026-abc', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-05-15');
+  assert.strictEqual(number, 'INV-2026-0004');
+});
