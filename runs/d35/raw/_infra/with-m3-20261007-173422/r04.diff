@@ -0,0 +1,20 @@
+/**
+ * Generate the next invoice number.
+ * Invoice numbers have the format INV-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * The counter resets every year.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const thisYearNumbers = existingNumbers.filter((num) => num.startsWith(prefix));
+  const counters = thisYearNumbers.map((num) => parseInt(num.slice(prefix.length), 10)).filter((c) => !isNaN(c));
+
+  const maxCounter = counters.length === 0 ? 0 : Math.max(...counters);
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
