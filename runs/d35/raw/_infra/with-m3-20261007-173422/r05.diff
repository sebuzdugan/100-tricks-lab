+++ b/test/render.test.js
@@ -0,0 +1,178 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const issueResult = issueInvoice(result.value, []);
+  assert.strictEqual(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText shows single line correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /5 Development \(hour\) €95\.00 €475\.00/);
+  assert.match(text, /Total: €475\.00/);
+});
+
+test('renderInvoiceText shows multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /5 Development \(hour\) €95\.00 €475\.00/);
+  assert.match(text, /3 Design work \(hour\) €85\.00 €255\.00/);
+  assert.match(text, /Total: €730\.00/);
+});
+
+test('renderInvoiceText pads quantity column', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'STICKER', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 100 },
+    ],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+  const stickerLine = lines.find((l) => l.includes('Sticker'));
+  const logoLine = lines.find((l) => l.includes('Logo'));
+
+  assert.strictEqual(stickerLine.substring(0, 3), '  5');
+  assert.strictEqual(logoLine.substring(0, 3), '100');
+});
+
+test('renderInvoiceText calculates correct line totals', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /1 Logo package €1,200\.00 €1,200\.00/);
+  assert.match(text, /Total: €1,200\.00/);
+});
+
+test('renderInvoiceText formats euros correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'ICON-SET', qty: 5 },
+    ],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /€0\.37/);
+  assert.match(text, /€9\.80/);
+  assert.match(text, /€37\.00/);
+  assert.match(text, /€49\.00/);
+  assert.match(text, /Total: €86\.00/);
+});
+
+test('renderInvoiceText output structure', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.strictEqual(lines[0], 'DRAFT');
+  assert.strictEqual(lines[1], 'Northwind Studio');
+  assert.strictEqual(lines[2], '');
+  assert.match(lines[3], /^\s+1 Development/);
+  assert.strictEqual(lines[4], '');
+  assert.match(lines[5], /^Total:/);
+});
+
+test('renderInvoiceText with zero VAT products', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'WORKSHOP-DAY', qty: 2 },
+      { sku: 'TALK', qty: 1 },
+    ],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const text = renderInvoiceText(result.value);
+  assert.match(text, /2 Brand workshop \(day, VAT exempt\) €600\.00 €1,200\.00/);
+  assert.match(text, /1 Conference talk \(VAT exempt\) €350\.00 €350\.00/);
+  assert.match(text, /Total: €1,550\.00/);
+});
+
+test('renderInvoiceText with issued invoice preserves number', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-06-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  assert.strictEqual(result.ok, true);
+
+  const issueResult = issueInvoice(result.value, ['INV-2026-0001', 'INV-2026-0005']);
+  assert.strictEqual(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+  assert.match(text, /^INV-2026-0006\n/);
+  assert.match(text, /Kite & Co/);
+  assert.match(text, /Total: €285\.00/);
+});
