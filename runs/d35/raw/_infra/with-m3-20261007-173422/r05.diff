+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  const lines = [];
+
+  lines.push(invoice.number || 'DRAFT');
+  lines.push(customerName);
+  lines.push('');
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const unitPriceEuros = formatEuros(line.unitPrice);
+    const lineTotalEuros = formatEuros(total);
+
+    const lineText = `${String(line.qty).padStart(3)} ${line.name} ${unitPriceEuros} ${lineTotalEuros}`;
+    lines.push(lineText);
+  }
+
+  lines.push('');
+
+  const { total } = invoiceTotals(invoice);
+  const totalEuros = formatEuros(total);
+  lines.push(`Total: ${totalEuros}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
