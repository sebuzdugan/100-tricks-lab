+
+  const addResult = addLine(invoice, { sku: 'DES-HOUR', qty: 3, discountPercent: 15 });
+
+  assert.strictEqual(addResult.ok, true);
+  assert.strictEqual(addResult.value.lines[1].discountPercent, 15);
