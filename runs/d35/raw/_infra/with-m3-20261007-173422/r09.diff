+
+test('normalizeId trims whitespace', () => {
+  assert.strictEqual(normalizeId('  C-001  '), 'C-001');
+  assert.strictEqual(normalizeId('\tC-002\n'), 'C-002');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.strictEqual(normalizeId('c-001'), 'C-001');
+  assert.strictEqual(normalizeId('c-003'), 'C-003');
+});
+
+test('normalizeId handles mixed case with spaces', () => {
+  assert.strictEqual(normalizeId('  c-007 '), 'C-007');
+  assert.strictEqual(normalizeId('C-007 '), 'C-007');
+  assert.strictEqual(normalizeId(' c-007'), 'C-007');
+});
+
+test('normalizeId returns string', () => {
+  assert.strictEqual(typeof normalizeId('c-001'), 'string');
+});
+
+test('getCustomer normalizes ID before lookup', () => {
+  const result = getCustomer('  c-001  ');
+  assert.strictEqual(result.ok, true);
+  assert.strictEqual(result.value.id, 'C-001');
+  assert.strictEqual(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer finds customer with lowercase ID', () => {
+  const result = getCustomer('c-003');
+  assert.strictEqual(result.ok, true);
+  assert.strictEqual(result.value.id, 'C-003');
+  assert.strictEqual(result.value.name, 'Kite & Co');
+});
+
+test('getCustomer finds customer with mixed case and spaces', () => {
+  const result = getCustomer(' c-005 ');
+  assert.strictEqual(result.ok, true);
+  assert.strictEqual(result.value.id, 'C-005');
+  assert.strictEqual(result.value.name, 'Orchard Health');
+});
