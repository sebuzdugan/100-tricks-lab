new file mode 100644
index 0000000..31bf95d
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,46 @@
+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+
+  const [year, month, day] = text.split('-');
+  return (
+    date.getUTCFullYear() === parseInt(year, 10) &&
+    date.getUTCMonth() === parseInt(month, 10) - 1 &&
+    date.getUTCDate() === parseInt(day, 10)
+  );
+}
+
+/**
+ * Add days to a date, returning a YYYY-MM-DD string.
+ * All arithmetic is done in UTC.
+ * @param {string} date A date in YYYY-MM-DD format
+ * @param {number} days Number of days to add (can be negative)
+ * @returns {string} A date in YYYY-MM-DD format
+ */
+export function addDays(date, days) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + days);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of whole days between two dates (b minus a).
+ * All arithmetic is done in UTC.
+ * @param {string} a A date in YYYY-MM-DD format
+ * @param {string} b A date in YYYY-MM-DD format
+ * @returns {number} Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const ms = dateB.getTime() - dateA.getTime();
+  return Math.floor(ms / (1000 * 60 * 60 * 24));
+}
