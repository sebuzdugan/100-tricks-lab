diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..f05c2ba
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,118 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+// isValidDate tests
+test('isValidDate accepts valid dates', () => {
+  assert.strictEqual(isValidDate('2026-01-15'), true);
+  assert.strictEqual(isValidDate('2026-12-31'), true);
+  assert.strictEqual(isValidDate('2025-02-28'), true);
+  assert.strictEqual(isValidDate('2024-02-29'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.strictEqual(isValidDate('01/15/2026'), false);
+  assert.strictEqual(isValidDate('2026/01/15'), false);
+  assert.strictEqual(isValidDate('2026-1-15'), false);
+  assert.strictEqual(isValidDate('26-01-15'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.strictEqual(isValidDate('2026-02-30'), false);
+  assert.strictEqual(isValidDate('2025-13-01'), false);
+  assert.strictEqual(isValidDate('2025-00-15'), false);
+  assert.strictEqual(isValidDate('2025-01-32'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.strictEqual(isValidDate(20260115), false);
+  assert.strictEqual(isValidDate(null), false);
+  assert.strictEqual(isValidDate(undefined), false);
+  assert.strictEqual(isValidDate({ year: 2026 }), false);
+});
+
+test('isValidDate rejects empty string', () => {
+  assert.strictEqual(isValidDate(''), false);
+});
+
+test('isValidDate rejects strings with spaces', () => {
+  assert.strictEqual(isValidDate(' 2026-01-15'), false);
+  assert.strictEqual(isValidDate('2026-01-15 '), false);
+  assert.strictEqual(isValidDate('2026 -01-15'), false);
+});
+
+// addDays tests
+test('addDays adds positive days', () => {
+  assert.strictEqual(addDays('2026-01-15', 1), '2026-01-16');
+  assert.strictEqual(addDays('2026-01-15', 10), '2026-01-25');
+  assert.strictEqual(addDays('2026-01-15', 365), '2027-01-15');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.strictEqual(addDays('2026-01-15', -1), '2026-01-14');
+  assert.strictEqual(addDays('2026-01-15', -10), '2026-01-05');
+  assert.strictEqual(addDays('2026-01-15', -365), '2025-01-15');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.strictEqual(addDays('2026-01-31', 1), '2026-02-01');
+  assert.strictEqual(addDays('2026-02-28', 1), '2026-03-01');
+  assert.strictEqual(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles leap years', () => {
+  assert.strictEqual(addDays('2024-02-28', 1), '2024-02-29');
+  assert.strictEqual(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.strictEqual(addDays('2026-01-15', 0), '2026-01-15');
+});
+
+test('addDays returns YYYY-MM-DD format', () => {
+  const result = addDays('2026-01-05', 1);
+  assert.match(result, /^\d{4}-\d{2}-\d{2}$/);
+});
+
+// daysBetween tests
+test('daysBetween calculates positive difference', () => {
+  assert.strictEqual(daysBetween('2026-01-15', '2026-01-20'), 5);
+  assert.strictEqual(daysBetween('2026-01-15', '2026-02-15'), 31);
+  assert.strictEqual(daysBetween('2026-01-01', '2026-12-31'), 364);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.strictEqual(daysBetween('2026-01-20', '2026-01-15'), -5);
+  assert.strictEqual(daysBetween('2026-02-15', '2026-01-15'), -31);
+});
+
+test('daysBetween with same date returns zero', () => {
+  assert.strictEqual(daysBetween('2026-01-15', '2026-01-15'), 0);
+});
+
+test('daysBetween returns whole days', () => {
+  assert.strictEqual(Number.isInteger(daysBetween('2026-01-15', '2026-01-20')), true);
+});
+
+test('daysBetween with one day difference', () => {
+  assert.strictEqual(daysBetween('2026-01-15', '2026-01-16'), 1);
+  assert.strictEqual(daysBetween('2026-01-16', '2026-01-15'), -1);
+});
+
+test('daysBetween across year boundary', () => {
+  assert.strictEqual(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.strictEqual(daysBetween('2025-12-30', '2026-01-02'), 3);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.strictEqual(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.strictEqual(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const start = '2026-01-15';
+  const n = 42;
+  const end = addDays(start, n);
+  assert.strictEqual(daysBetween(start, end), n);
+  assert.strictEqual(daysBetween(end, start), -n);
+});
