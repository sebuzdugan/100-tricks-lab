@@ -0,0 +1,266 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('creates a valid invoice with one line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DEV-HOUR',
+    name: 'Development (hour)',
+    qty: 5,
+    unitPrice: 9500,
+    vatRate: 21,
+  });
+});
+
+test('creates a valid invoice with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 3 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.lines.length, 3);
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 2,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+  assert.deepEqual(result.value.lines[2], {
+    sku: 'WORKSHOP-DAY',
+    name: 'Brand workshop (day, VAT exempt)',
+    qty: 1,
+    unitPrice: 60000,
+    vatRate: 0,
+  });
+});
+
+test('returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('returns DATE_INVALID for missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: undefined,
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('returns DATE_INVALID for invalid date format', () => {
+  const testCases = [
+    '2026-10-7',
+    '26-10-07',
+    '2026/10/07',
+    '2026.10.07',
+    '10-07-2026',
+    '2026-13-01',
+    '2026-10',
+    '10/07/2026',
+    '',
+  ];
+
+  for (const date of testCases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert(result.ok === false, `Expected DATE_INVALID for date: ${date}`);
+    assert.equal(result.error, 'DATE_INVALID');
+  }
+});
+
+test('returns DATE_INVALID for invalid dates (e.g., Feb 30)', () => {
+  const testCases = [
+    '2026-02-30',
+    '2026-04-31',
+    '2026-02-29',
+  ];
+
+  for (const date of testCases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert(result.ok === false, `Expected DATE_INVALID for date: ${date}`);
+    assert.equal(result.error, 'DATE_INVALID');
+  }
+});
+
+test('returns NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('returns NO_LINES for missing lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: undefined,
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('returns QTY_INVALID for zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('returns QTY_INVALID for negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('returns QTY_INVALID for fractional quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 2.5 }],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('returns QTY_INVALID for non-numeric quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 'five' }],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('returns UNKNOWN_SKU for invalid SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'INVALID-SKU', qty: 1 }],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('returns UNKNOWN_SKU when one of multiple lines has invalid SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'INVALID-SKU', qty: 2 },
+    ],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('does not mutate the input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  };
+  const originalInput = JSON.parse(JSON.stringify(input));
+
+  createInvoice(input);
+
+  assert.deepEqual(input, originalInput);
+});
+
+test('returns a new lines array, not a reference to input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  };
+
+  const result = createInvoice(input);
+
+  assert(result.ok === true);
+  assert(result.value.lines !== input.lines);
+});
+
+test('handles all catalogue products', () => {
+  const skus = [
+    'DES-HOUR',
+    'DEV-HOUR',
+    'COPY-HOUR',
+    'SUPPORT-HOUR',
+    'LOGO-PACK',
+    'BRAND-BOOK',
+    'ICON-SET',
+    'PHOTO-LIC',
+    'FONT-LIC',
+    'STICKER',
+    'HOST-MONTH',
+    'DOMAIN-YEAR',
+    'PRINT-A4',
+    'PRINT-A3',
+    'BOOK-DESIGN',
+    'MAGAZINE',
+    'WORKSHOP-DAY',
+    'TALK',
+  ];
+
+  for (const sku of skus) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku, qty: 1 }],
+    });
+    assert(result.ok === true, `Failed for SKU: ${sku}`);
+  }
+});
