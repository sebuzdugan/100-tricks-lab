diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..deb2700
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,96 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existingNumbers = ['INV-2026-0998', 'INV-2026-0999'];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2025-0003',
+    'INV-2026-0001',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existingNumbers = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2025-0003',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existingNumbers = [
+    'INV-2026-0003',
+    'INV-2026-0001',
+    'INV-2026-0002',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existingNumbers = [
+    'INV-2026-0001',
+    'INVALID-2026-0001',
+    'INV-2026-abc',
+    '2026-0002',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existingNumbers = [];
+  const number1 = nextInvoiceNumber(existingNumbers, '2026-01-01');
+  assert.equal(number1, 'INV-2026-0001');
+
+  const existingNumbers9 = ['INV-2026-0009'];
+  const number10 = nextInvoiceNumber(existingNumbers9, '2026-01-01');
+  assert.equal(number10, 'INV-2026-0010');
+
+  const existingNumbers99 = ['INV-2026-0099'];
+  const number100 = nextInvoiceNumber(existingNumbers99, '2026-01-01');
+  assert.equal(number100, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber works across different dates in the same year', () => {
+  const existingNumbers = ['INV-2026-0001'];
+  const number1 = nextInvoiceNumber(existingNumbers, '2026-01-15');
+  const number2 = nextInvoiceNumber(
+    [...existingNumbers, number1],
+    '2026-12-31',
+  );
+  assert.equal(number1, 'INV-2026-0002');
+  assert.equal(number2, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber ignores numbers with leading zeros in counter', () => {
+  const existingNumbers = [
+    'INV-2026-0001',
+    'INV-2026-00002',
+  ];
+  const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
