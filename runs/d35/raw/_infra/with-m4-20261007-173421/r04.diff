index 0000000..c3cc8b6
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,24 @@
+/**
+ * Calculate the next invoice number for a given issue date.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {Array<string>} existingNumbers - Array of invoice numbers already used, in any order
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `INV-${year}-`;
+
+  const currentYearNumbers = existingNumbers
+    .filter((num) => {
+      if (!num.startsWith(prefix)) return false;
+      const counterStr = num.slice(prefix.length);
+      return /^\d{4}$/.test(counterStr);
+    })
+    .map((num) => Number(num.slice(prefix.length)));
+
+  const maxCounter = currentYearNumbers.length > 0 ? Math.max(...currentYearNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
