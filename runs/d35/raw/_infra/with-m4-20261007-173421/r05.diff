@@ -0,0 +1,187 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === true);
+  const renderResult = renderInvoiceText(result.value);
+
+  assert(renderResult.ok === true);
+  const text = renderResult.value;
+  assert(text.includes('DRAFT'));
+  assert(text.includes('Northwind Studio'));
+  assert(text.includes('5 Development (hour)'));
+  assert(text.includes('€95.00'));
+  assert(text.includes('€475.00'));
+  assert(text.includes('Total: €475.00'));
+});
+
+test('renderInvoiceText renders an issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === true);
+  const issueResult = issueInvoice(result.value, []);
+
+  assert(issueResult.ok === true);
+  const renderResult = renderInvoiceText(issueResult.value);
+
+  assert(renderResult.ok === true);
+  const text = renderResult.value;
+  assert(text.includes('INV-2026-0001'));
+  assert(!text.includes('DRAFT'));
+  assert(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText formats multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 3 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  assert(result.ok === true);
+  const renderResult = renderInvoiceText(result.value);
+
+  assert(renderResult.ok === true);
+  const text = renderResult.value;
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert(lines[2].includes('2 Design work (hour)'));
+  assert(lines[2].includes('€85.00'));
+  assert(lines[2].includes('€170.00'));
+  assert(lines[3].includes('3 Copywriting (hour)'));
+  assert(lines[3].includes('€60.00'));
+  assert(lines[3].includes('€180.00'));
+  assert(lines[4].includes('1 Brand workshop (day, VAT exempt)'));
+  assert(lines[4].includes('€600.00'));
+  assert(lines[5].includes('Total: €950.00'));
+});
+
+test('renderInvoiceText calculates totals correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 100 },
+      { sku: 'ICON-SET', qty: 10 },
+    ],
+  });
+
+  assert(result.ok === true);
+  const renderResult = renderInvoiceText(result.value);
+
+  assert(renderResult.ok === true);
+  const text = renderResult.value;
+  const expected = 100 * 50 + 10 * 980;
+  assert(text.includes(`Total: €${String(expected / 100).replace('.', ',')}`));
+});
+
+test('renderInvoiceText returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500 }],
+  };
+
+  const result = renderInvoiceText(invoice);
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('renderInvoiceText preserves line order', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'COPY-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+
+  assert(result.ok === true);
+  const renderResult = renderInvoiceText(result.value);
+
+  assert(renderResult.ok === true);
+  const text = renderResult.value;
+  const lines = text.split('\n');
+
+  assert(lines[2].includes('Copywriting'));
+  assert(lines[3].includes('Development'));
+  assert(lines[4].includes('Design work'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert(result.ok === true);
+  const renderResult = renderInvoiceText(result.value);
+
+  assert(renderResult.ok === true);
+  const text = renderResult.value;
+  assert(text.includes('Marlow "The Print Shop"'));
+});
+
+test('renderInvoiceText formats prices with two decimal places', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 3 },
+      { sku: 'PRINT-A4', qty: 2 },
+    ],
+  });
+
+  assert(result.ok === true);
+  const renderResult = renderInvoiceText(result.value);
+
+  assert(renderResult.ok === true);
+  const text = renderResult.value;
+  assert(text.includes('€0.50'));
+  assert(text.includes('€1.50'));
+  assert(text.includes('€0.37'));
+  assert(text.includes('€0.74'));
+});
+
+test('renderInvoiceText structure is consistent', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === true);
+  const renderResult = renderInvoiceText(result.value);
+
+  assert(renderResult.ok === true);
+  const text = renderResult.value;
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert(lines[0] === 'DRAFT' || lines[0].startsWith('INV-'));
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert(lines[2].includes('Development (hour)'));
+  assert(lines[3].startsWith('Total: €'));
+});
