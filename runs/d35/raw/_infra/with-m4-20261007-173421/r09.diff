 });
+
+test('createInvoice normalizes customer ID to uppercase', () => {
+  const result = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createInvoice normalizes customer ID with spaces', () => {
+  const result = createInvoice({
+    customerId: '  C-001  ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createInvoice normalizes customer ID with mixed case and spaces', () => {
+  const result = createInvoice({
+    customerId: '  c-003  ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.customerId, 'C-003');
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice returns CUSTOMER_NOT_FOUND after normalization', () => {
+  const result = createInvoice({
+    customerId: '  c-999  ',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
