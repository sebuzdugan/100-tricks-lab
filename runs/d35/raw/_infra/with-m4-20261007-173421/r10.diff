new file mode 100644
index 0000000..e4368c1
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,37 @@
+/**
+ * Check if a date string is valid YYYY-MM-DD format and represents a real date.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.test(text);
+  if (!match) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  return date instanceof Date && !isNaN(date) && date.toISOString().startsWith(text);
+}
+
+/**
+ * Add n days to a date, returning a new YYYY-MM-DD string in UTC.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add
+ * @returns {string}
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().slice(0, 10);
+}
+
+/**
+ * Calculate the number of days between two dates (b minus a), in UTC.
+ * @param {string} a - Date in YYYY-MM-DD format
+ * @param {string} b - Date in YYYY-MM-DD format
+ * @returns {number} - Whole number of days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
