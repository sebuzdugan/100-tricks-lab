@@ -0,0 +1,237 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('balanceDue returns total for unpaid invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === true);
+  const invoice = result.value;
+  const totals = invoiceTotals(invoice);
+  const due = balanceDue(invoice);
+  assert.equal(due, totals.total);
+});
+
+test('balanceDue with no payments array', () => {
+  const invoice = {
+    status: 'issued',
+    lines: [{ qty: 5, unitPrice: 9500, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const due = balanceDue(invoice);
+  const totals = invoiceTotals(invoice);
+  assert.equal(due, totals.total);
+});
+
+test('recordPayment adds payment to invoice', () => {
+  const issueResult = issueInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  }, []);
+
+  assert(issueResult.ok === true);
+  const invoice = issueResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const payResult = recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+
+  assert(payResult.ok === true);
+  assert.equal(payResult.value.payments.length, 1);
+  assert.equal(payResult.value.payments[0].amount, 10000);
+  assert.equal(payResult.value.payments[0].date, '2026-10-10');
+  assert.equal(payResult.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const issueResult = issueInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  }, []);
+
+  assert(issueResult.ok === true);
+  const invoice = issueResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const payResult = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+
+  assert(payResult.ok === true);
+  assert.equal(payResult.value.status, 'paid');
+  assert.equal(balanceDue(payResult.value), 0);
+});
+
+test('recordPayment records multiple payments', () => {
+  const issueResult = issueInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  }, []);
+
+  assert(issueResult.ok === true);
+  let invoice = issueResult.value;
+
+  const pay1 = recordPayment(invoice, { amount: 20000, date: '2026-10-10' });
+  assert(pay1.ok === true);
+  invoice = pay1.value;
+  assert.equal(invoice.payments.length, 1);
+  assert.equal(invoice.status, 'partially_paid');
+
+  const pay2 = recordPayment(invoice, { amount: 30000, date: '2026-10-15' });
+  assert(pay2.ok === true);
+  invoice = pay2.value;
+  assert.equal(invoice.payments.length, 2);
+  assert.equal(invoice.status, 'partially_paid');
+
+  const pay3 = recordPayment(invoice, { amount: balanceDue(invoice), date: '2026-10-20' });
+  assert(pay3.ok === true);
+  invoice = pay3.value;
+  assert.equal(invoice.payments.length, 3);
+  assert.equal(invoice.status, 'paid');
+});
+
+test('recordPayment does not modify draft invoices', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment requires issued or partially_paid status', () => {
+  const statusTests = ['draft', 'cancelled', 'overdue'];
+
+  for (const status of statusTests) {
+    const invoice = {
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      status,
+      lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+    };
+
+    const result = recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+
+    assert(result.ok === false);
+    assert.equal(result.error, 'NOT_ISSUED');
+  }
+});
+
+test('recordPayment rejects zero amount', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 0, date: '2026-10-10' });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects negative amount', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: -1000, date: '2026-10-10' });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects fractional amount', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 10000.5, date: '2026-10-10' });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const owed = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: owed + 1, date: '2026-10-10' });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment accepts payment exactly equal to amount owed', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const owed = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: owed, date: '2026-10-10' });
+
+  assert(result.ok === true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const originalStatus = invoice.status;
+  const originalPayments = invoice.payments;
+
+  recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+
+  assert.equal(invoice.status, originalStatus);
+  assert.equal(invoice.payments, originalPayments);
+});
+
+test('balanceDue decreases after payments', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const initialDue = balanceDue(invoice);
+
+  const pay1Result = recordPayment(invoice, { amount: 20000, date: '2026-10-10' });
+  assert(pay1Result.ok === true);
+
+  const remainingDue = balanceDue(pay1Result.value);
+  assert.equal(remainingDue, initialDue - 20000);
+});
