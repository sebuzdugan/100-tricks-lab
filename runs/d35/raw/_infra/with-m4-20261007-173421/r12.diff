@@ -20,6 +20,10 @@ export function createInvoice({ customerId, issueDate, lines }) {
 
   if (!isValidDate(issueDate)) return fail('DATE_INVALID');
 
+  const resolvedTerms = terms ?? 'NET30';
+  const dueDate = calculateDueDate(issueDate, resolvedTerms);
+  if (!dueDate) return fail('TERMS_INVALID');
+
   if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
 
   const invoiceLines = [];
@@ -50,6 +54,8 @@ export function createInvoice({ customerId, issueDate, lines }) {
   return ok({
     customerId: normalizedCustomerId,
     issueDate,
+    terms: resolvedTerms,
+    dueDate,
     status: 'draft',
     lines: invoiceLines,
   });
@@ -197,6 +203,20 @@ export function issueInvoice(invoice, existingNumbers) {
   });
 }
 
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const year = parseInt(issueDate.slice(0, 4), 10);
+    const month = parseInt(issueDate.slice(5, 7), 10);
+    const lastDay = new Date(Date.UTC(year, month, 0)).getUTCDate();
+    return `${issueDate.slice(0, 7)}-${String(lastDay).padStart(2, '0')}`;
+  }
+  return null;
+}
+
 function isValidDiscount(discountPercent) {
   return typeof discountPercent === 'number' && discountPercent >= 0 && discountPercent <= 100;
 }
diff --git a/test/invoices.test.js b/test/invoices.test.js
index 94dacf5..ca8ed67 100644
--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -1222,3 +1222,98 @@ test('createInvoice returns CUSTOMER_NOT_FOUND after normalization', () => {
   assert(result.ok === false);
   assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
 });
+
+test('createInvoice defaults to NET30 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(result.value.dueDate, '2026-11-06');
+});
+
+test('createInvoice with NET14 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.terms, 'NET14');
+  assert.equal(result.value.dueDate, '2026-10-21');
+});
+
+test('createInvoice with NET30 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET30',
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(result.value.dueDate, '2026-11-06');
+});
+
+test('createInvoice with EOM terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'EOM',
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.terms, 'EOM');
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
+
+test('createInvoice with EOM terms on different months', () => {
+  const testCases = [
+    { issueDate: '2026-02-15', expectedDue: '2026-02-28' },
+    { issueDate: '2026-01-15', expectedDue: '2026-01-31' },
+    { issueDate: '2026-04-15', expectedDue: '2026-04-30' },
+  ];
+
+  for (const { issueDate, expectedDue } of testCases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate,
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+      terms: 'EOM',
+    });
+
+    assert(result.ok === true);
+    assert.equal(result.value.dueDate, expectedDue, `Failed for date ${issueDate}`);
+  }
+});
+
+test('createInvoice rejects invalid terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'INVALID',
+  });
+
+  assert(result.ok === false);
+  assert.equal(result.error, 'TERMS_INVALID');
+});
+
+test('createInvoice with EOM on last day of month', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-31',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'EOM',
+  });
+
+  assert(result.ok === true);
+  assert.equal(result.value.dueDate, '2026-10-31');
+});
