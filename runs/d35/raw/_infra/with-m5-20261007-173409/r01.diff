@@ -0,0 +1,195 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice: creates invoice with valid input', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2025-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+
+  const line = result.value.lines[0];
+  assert.equal(line.sku, 'DEV-HOUR');
+  assert.equal(line.name, 'Development (hour)');
+  assert.equal(line.qty, 5);
+  assert.equal(line.unitPrice, 9500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice: creates invoice with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-09-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[1].name, 'Logo package');
+  assert.equal(result.value.lines[2].name, 'Sticker sheet');
+});
+
+test('createInvoice: returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'UNKNOWN',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice: returns DATE_INVALID for wrong format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '07-10-2025',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: returns DATE_INVALID for invalid date values', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: returns DATE_INVALID for missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: returns NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice: returns NO_LINES for missing lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: null,
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice: returns QTY_INVALID for non-integer quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1.5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: returns QTY_INVALID for zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: returns QTY_INVALID for negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: returns UNKNOWN_SKU for missing SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice: does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  };
+  const inputCopy = JSON.parse(JSON.stringify(input));
+
+  createInvoice(input);
+
+  assert.deepEqual(input, inputCopy);
+});
+
+test('createInvoice: accepts valid dates', () => {
+  const validDates = [
+    '2025-01-31',
+    '2025-02-28',
+    '2024-02-29',
+    '2000-12-31',
+    '1999-01-01',
+  ];
+
+  for (const date of validDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, true, `Should accept date ${date}`);
+  }
+});
+
+test('createInvoice: rejects leap year dates incorrectly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-29',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
