index 0000000..34994ed
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,26 @@
+/**
+ * Get the next available invoice number for a given date.
+ * Invoice numbers are in the format INV-<year>-<counter> where counter is 4 digits (0001-9999),
+ * restarting each year.
+ * @param {Array<string>} existingNumbers - Array of invoice numbers already used
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - The next available invoice number (e.g., 'INV-2025-0001')
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const yearPrefix = `INV-${year}-`;
+
+  const thisYearCounters = existingNumbers
+    .filter((num) => num.startsWith(yearPrefix))
+    .map((num) => {
+      const counterStr = num.substring(yearPrefix.length);
+      const counter = parseInt(counterStr, 10);
+      return isNaN(counter) ? 0 : counter;
+    });
+
+  const maxCounter = thisYearCounters.length === 0 ? 0 : Math.max(...thisYearCounters);
+  const nextCounter = maxCounter + 1;
+
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `${yearPrefix}${paddedCounter}`;
+}
