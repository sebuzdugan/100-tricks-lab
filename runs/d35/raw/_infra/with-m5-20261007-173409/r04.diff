diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..b01e90e
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,87 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber: first number for a year', () => {
+  const number = nextInvoiceNumber([], '2025-10-07');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber: next number after one existing', () => {
+  const number = nextInvoiceNumber(['INV-2025-0001'], '2025-10-07');
+  assert.equal(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber: next number after multiple existing', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0005'],
+    '2025-10-07'
+  );
+  assert.equal(number, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber: ignores numbers from other years', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2024-0099', 'INV-2025-0001', 'INV-2026-0001'],
+    '2025-10-07'
+  );
+  assert.equal(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber: ignores unsorted numbers', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2025-0005', 'INV-2025-0001', 'INV-2025-0003'],
+    '2025-10-07'
+  );
+  assert.equal(number, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber: pads counter with leading zeros', () => {
+  const numbers = Array.from({ length: 9 }, (_, i) =>
+    `INV-2025-${String(i + 1).padStart(4, '0')}`
+  );
+  const number = nextInvoiceNumber(numbers, '2025-10-07');
+  assert.equal(number, 'INV-2025-0010');
+});
+
+test('nextInvoiceNumber: handles large counters', () => {
+  const numbers = Array.from({ length: 999 }, (_, i) =>
+    `INV-2025-${String(i + 1).padStart(4, '0')}`
+  );
+  const number = nextInvoiceNumber(numbers, '2025-10-07');
+  assert.equal(number, 'INV-2025-1000');
+});
+
+test('nextInvoiceNumber: restarts counter for new year', () => {
+  const number = nextInvoiceNumber(
+    [
+      'INV-2024-0001',
+      'INV-2024-0002',
+      'INV-2024-0003',
+    ],
+    '2025-01-01'
+  );
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber: ignores malformed numbers', () => {
+  const number = nextInvoiceNumber(
+    [
+      'INV-2025-0001',
+      'INVOICE-2025-0002',
+      'INV-2025-XXXX',
+      'INV-2025-0003',
+    ],
+    '2025-10-07'
+  );
+  assert.equal(number, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber: does not mutate input', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+  const copy = [...existingNumbers];
+
+  nextInvoiceNumber(existingNumbers, '2025-10-07');
+
+  assert.deepEqual(existingNumbers, copy);
+});
