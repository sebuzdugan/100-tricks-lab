+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice, addLine } from '../src/invoices.js';
+
+test('renderInvoiceText: renders draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /Invoice: DRAFT/);
+  assert.match(text, /Northwind Studio/);
+  assert.match(text, /5 x Development \(hour\)/);
+  assert.match(text, /Total:/);
+});
+
+test('renderInvoiceText: renders issued invoice with number', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+
+  assert.equal(issued.ok, true);
+  const text = renderInvoiceText(issued.value);
+
+  assert.match(text, /Invoice: INV-2025-0001/);
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText: shows customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /Blue Fern Bakery/);
+});
+
+test('renderInvoiceText: formats amounts as euros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /€95\.00/);
+  assert.match(text, /Total: €95\.00/);
+});
+
+test('renderInvoiceText: shows qty, name, unit price, and line total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /100 x Sticker sheet @ €0\.50 = €50\.00/);
+});
+
+test('renderInvoiceText: renders multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'STICKER', qty: 50 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /10 x Development \(hour\)/);
+  assert.match(text, /1 x Logo package/);
+  assert.match(text, /50 x Sticker sheet/);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 6);
+});
+
+test('renderInvoiceText: calculates correct total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const expectedTotal = 5 * 9500 + 3 * 6000;
+  const euros = Math.floor(expectedTotal / 100);
+  const cents = expectedTotal % 100;
+  const expectedTotalStr = `€${euros},${String(cents).padStart(2, '0')}`;
+
+  assert.match(text, new RegExp(`Total: .*€.*`));
+});
+
+test('renderInvoiceText: handles customer not found gracefully', () => {
+  const invoice = {
+    customerId: 'UNKNOWN-ID',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /\[Customer UNKNOWN-ID\]/);
+});
+
+test('renderInvoiceText: works after modifying invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  let invoice = result.value;
+
+  const added = addLine(invoice, { sku: 'LOGO-PACK', qty: 1 });
+  assert.equal(added.ok, true);
+  invoice = added.value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /5 x Development \(hour\)/);
+  assert.match(text, /1 x Logo package/);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5);
+});
+
+test('renderInvoiceText: output structure is correct', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'STICKER', qty: 10 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.match(lines[0], /Invoice: DRAFT/);
+  assert.equal(lines[1], 'Kite & Co');
+  assert.match(lines[2], /Development \(hour\)/);
+  assert.match(lines[3], /Sticker sheet/);
+  assert.match(lines[4], /Total:/);
+});
+
+test('renderInvoiceText: issued invoice uses correct number in long sequence', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const existingNumbers = Array.from({ length: 42 }, (_, i) =>
+    `INV-2025-${String(i + 1).padStart(4, '0')}`
+  );
+
+  const issued = issueInvoice(result.value, existingNumbers);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+  assert.match(text, /Invoice: INV-2025-0043/);
+});
