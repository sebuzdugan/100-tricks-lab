+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array, ... }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const header = invoice.number ? `Invoice: ${invoice.number}` : 'Invoice: DRAFT';
+
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok
+    ? customerResult.value.name
+    : `[Customer ${invoice.customerId}]`;
+
+  const lineTexts = invoice.lines.map((line) => {
+    const total = lineTotal(line);
+    return `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+  });
+
+  const totals = invoiceTotals(invoice);
+
+  const parts = [header, customerName, ...lineTexts, `Total: ${formatEuros(totals.total)}`];
+  return parts.join('\n');
+}
