diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..d223382
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,118 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate: accepts valid dates', () => {
+  assert.equal(isValidDate('2025-10-07'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+});
+
+test('isValidDate: rejects invalid formats', () => {
+  assert.equal(isValidDate('2025-10-7'), false);
+  assert.equal(isValidDate('2025-1-07'), false);
+  assert.equal(isValidDate('25-10-07'), false);
+  assert.equal(isValidDate('07-10-2025'), false);
+  assert.equal(isValidDate('2025/10/07'), false);
+});
+
+test('isValidDate: rejects invalid dates', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+});
+
+test('isValidDate: rejects non-date strings', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('abc'), false);
+  assert.equal(isValidDate('2025-10-07 '), false);
+});
+
+test('isValidDate: rejects with leading/trailing spaces', () => {
+  assert.equal(isValidDate(' 2025-10-07'), false);
+  assert.equal(isValidDate('2025-10-07 '), false);
+  assert.equal(isValidDate(' 2025-10-07 '), false);
+});
+
+test('addDays: adds positive days', () => {
+  assert.equal(addDays('2025-10-07', 1), '2025-10-08');
+  assert.equal(addDays('2025-10-07', 5), '2025-10-12');
+  assert.equal(addDays('2025-10-07', 30), '2025-11-06');
+});
+
+test('addDays: adds days across month boundary', () => {
+  assert.equal(addDays('2025-10-28', 5), '2025-11-02');
+  assert.equal(addDays('2025-12-28', 5), '2026-01-02');
+});
+
+test('addDays: subtracts negative days', () => {
+  assert.equal(addDays('2025-10-07', -1), '2025-10-06');
+  assert.equal(addDays('2025-10-07', -5), '2025-10-02');
+});
+
+test('addDays: subtracts days across month boundary', () => {
+  assert.equal(addDays('2025-10-05', -5), '2025-09-30');
+  assert.equal(addDays('2025-01-05', -5), '2024-12-31');
+});
+
+test('addDays: handles leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays: adds zero days', () => {
+  assert.equal(addDays('2025-10-07', 0), '2025-10-07');
+});
+
+test('addDays: adds large numbers of days', () => {
+  assert.equal(addDays('2025-01-01', 365), '2026-01-01');
+  assert.equal(addDays('2025-01-01', 1000), '2027-09-28');
+});
+
+test('daysBetween: positive difference', () => {
+  assert.equal(daysBetween('2025-10-07', '2025-10-08'), 1);
+  assert.equal(daysBetween('2025-10-07', '2025-10-12'), 5);
+  assert.equal(daysBetween('2025-10-07', '2025-11-07'), 31);
+});
+
+test('daysBetween: negative difference', () => {
+  assert.equal(daysBetween('2025-10-08', '2025-10-07'), -1);
+  assert.equal(daysBetween('2025-10-12', '2025-10-07'), -5);
+});
+
+test('daysBetween: same day', () => {
+  assert.equal(daysBetween('2025-10-07', '2025-10-07'), 0);
+});
+
+test('daysBetween: across month boundary', () => {
+  assert.equal(daysBetween('2025-09-28', '2025-10-02'), 4);
+  assert.equal(daysBetween('2024-12-28', '2025-01-02'), 5);
+});
+
+test('daysBetween: across year boundary', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2024-12-31', '2025-12-31'), 365);
+});
+
+test('daysBetween: large differences', () => {
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+  assert.equal(daysBetween('2025-01-01', '2030-01-01'), 1826);
+});
+
+test('daysBetween: leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const date = '2025-10-07';
+  const days = 42;
+
+  const future = addDays(date, days);
+  assert.equal(daysBetween(date, future), days);
+
+  const past = addDays(date, -days);
+  assert.equal(daysBetween(past, date), days);
+});
