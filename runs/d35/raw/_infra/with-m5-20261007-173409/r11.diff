+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the balance due on an invoice (total minus payments).
+ * @param {{ payments?: Array<{ amount: number }>, ... }} invoice
+ * @returns {number} - the amount still owed in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
+
+/**
+ * Record a payment against an invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }>, ... }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: invoice } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const owed = balanceDue(invoice);
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  const payments = [...(invoice.payments || [])];
+  payments.push({ amount, date });
+
+  const newInvoice = {
+    ...invoice,
+    payments,
+  };
+
+  const totals = invoiceTotals(newInvoice);
+  const totalPayments = payments.reduce((sum, p) => sum + p.amount, 0);
+
+  if (totalPayments >= totals.total) {
+    newInvoice.status = 'paid';
+  } else {
+    newInvoice.status = 'partially_paid';
+  }
+
+  return ok(newInvoice);
+}
