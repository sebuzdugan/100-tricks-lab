+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('balanceDue: returns total when no payments', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const due = balanceDue(issued.value);
+  const { total } = invoiceTotals(issued.value);
+  assert.equal(due, total);
+});
+
+test('balanceDue: returns remaining balance after partial payment', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment1 = recordPayment(issued.value, { amount: 50000, date: '2025-11-07' });
+  assert.equal(payment1.ok, true);
+
+  const due = balanceDue(payment1.value);
+  const { total } = invoiceTotals(payment1.value);
+  assert.equal(due, total - 50000);
+});
+
+test('balanceDue: returns zero when fully paid', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const { total } = invoiceTotals(issued.value);
+  const payment = recordPayment(issued.value, { amount: total, date: '2025-11-07' });
+  assert.equal(payment.ok, true);
+
+  const due = balanceDue(payment.value);
+  assert.equal(due, 0);
+});
+
+test('recordPayment: records payment on issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment = recordPayment(issued.value, { amount: 50000, date: '2025-11-07' });
+
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.payments.length, 1);
+  assert.equal(payment.value.payments[0].amount, 50000);
+  assert.equal(payment.value.payments[0].date, '2025-11-07');
+});
+
+test('recordPayment: changes status to partially_paid after first payment', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+  assert.equal(issued.value.status, 'issued');
+
+  const payment = recordPayment(issued.value, { amount: 50000, date: '2025-11-07' });
+
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.status, 'partially_paid');
+});
+
+test('recordPayment: changes status to paid when fully paid', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const { total } = invoiceTotals(issued.value);
+  const payment = recordPayment(issued.value, { amount: total, date: '2025-11-07' });
+
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.status, 'paid');
+});
+
+test('recordPayment: allows multiple payments', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment1 = recordPayment(issued.value, { amount: 50000, date: '2025-11-07' });
+  assert.equal(payment1.ok, true);
+
+  const payment2 = recordPayment(payment1.value, { amount: 30000, date: '2025-12-07' });
+  assert.equal(payment2.ok, true);
+
+  assert.equal(payment2.value.payments.length, 2);
+  assert.equal(payment2.value.payments[0].amount, 50000);
+  assert.equal(payment2.value.payments[1].amount, 30000);
+});
+
+test('recordPayment: returns NOT_ISSUED for draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+
+  const payment = recordPayment(result.value, { amount: 50000, date: '2025-11-07' });
+
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'NOT_ISSUED');
+});
+
+test('recordPayment: returns AMOUNT_INVALID for non-integer amount', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment = recordPayment(issued.value, { amount: 50000.5, date: '2025-11-07' });
+
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: returns AMOUNT_INVALID for zero amount', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment = recordPayment(issued.value, { amount: 0, date: '2025-11-07' });
+
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: returns AMOUNT_INVALID for negative amount', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment = recordPayment(issued.value, { amount: -50000, date: '2025-11-07' });
+
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: returns OVERPAYMENT if payment exceeds balance', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const { total } = invoiceTotals(issued.value);
+  const payment = recordPayment(issued.value, { amount: total + 1, date: '2025-11-07' });
+
+  assert.equal(payment.ok, false);
+  assert.equal(payment.error, 'OVERPAYMENT');
+});
+
+test('recordPayment: accepts payment exactly equal to balance', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const { total } = invoiceTotals(issued.value);
+  const payment = recordPayment(issued.value, { amount: total, date: '2025-11-07' });
+
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.status, 'paid');
+});
+
+test('recordPayment: does not mutate original invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const invoiceCopy = JSON.parse(JSON.stringify(issued.value));
+
+  recordPayment(issued.value, { amount: 50000, date: '2025-11-07' });
+
+  assert.deepEqual(issued.value, invoiceCopy);
+});
+
+test('recordPayment: creates payments array if missing', () => {
+  const invoice = {
+    customerId: 'C-004',
+    issueDate: '2025-10-07',
+    status: 'issued',
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const payment = recordPayment(invoice, { amount: 50000, date: '2025-11-07' });
+
+  assert.equal(payment.ok, true);
+  assert.ok(Array.isArray(payment.value.payments));
+  assert.equal(payment.value.payments.length, 1);
+});
