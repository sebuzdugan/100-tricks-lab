diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..1ee61cd
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,82 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber with empty existing numbers', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber with one existing number', () => {
+  const result = nextInvoiceNumber(['INV-2026-0001'], '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber with multiple existing numbers', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0005'],
+    '2026-10-07'
+  );
+  assert.equal(result, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber ignores other years', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2025-0010', 'INV-2025-0020', 'INV-2026-0003'],
+    '2026-10-07'
+  );
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber with unordered numbers', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'],
+    '2026-10-07'
+  );
+  assert.equal(result, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber with different years', () => {
+  const result2025 = nextInvoiceNumber(
+    ['INV-2025-0001', 'INV-2025-0002'],
+    '2025-05-15'
+  );
+  assert.equal(result2025, 'INV-2025-0003');
+
+  const result2026 = nextInvoiceNumber(
+    ['INV-2025-0001', 'INV-2025-0002'],
+    '2026-05-15'
+  );
+  assert.equal(result2026, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber with high counter', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2026-9999'],
+    '2026-10-07'
+  );
+  assert.equal(result, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber pads zeros correctly', () => {
+  const result = nextInvoiceNumber(
+    [],
+    '2026-10-07'
+  );
+  assert.equal(result, 'INV-2026-0001');
+  assert.match(result, /INV-2026-0001$/);
+});
+
+test('nextInvoiceNumber with mixed years and unordered', () => {
+  const result = nextInvoiceNumber(
+    [
+      'INV-2024-0050',
+      'INV-2026-0005',
+      'INV-2025-0010',
+      'INV-2026-0001',
+      'INV-2025-0005',
+    ],
+    '2026-10-07'
+  );
+  assert.equal(result, 'INV-2026-0006');
+});
