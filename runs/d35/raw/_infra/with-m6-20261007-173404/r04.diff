@@ -0,0 +1,19 @@
+/**
+ * Get the next free invoice number for a given issue date.
+ * Invoice numbers are INV-YYYY-NNNN where NNNN is a 4-digit counter per year.
+ * @param {string[]} existingNumbers - array of already-used invoice numbers
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  const thisYearNumbers = existingNumbers.filter((num) => num.startsWith(prefix));
+  const counters = thisYearNumbers.map((num) => parseInt(num.substring(prefix.length), 10));
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
