+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to a customer.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+  const lines = [];
+
+  const invoiceNumber = invoice.number || 'DRAFT';
+  lines.push(invoiceNumber);
+
+  lines.push(customerName);
+
+  let total = 0;
+  for (const line of invoice.lines) {
+    const lineAmount = lineTotal(line);
+    total += lineAmount;
+    const qtyStr = String(line.qty);
+    const priceStr = formatEuros(line.unitPrice);
+    const amountStr = formatEuros(lineAmount);
+    lines.push(`${qtyStr} ${line.name} @ ${priceStr} = ${amountStr}`);
+  }
+
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return lines.join('\n');
+}
