+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText with draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio/);
+  assert.match(text, /5 Development \(hour\) @ €95\.00 = €475\.00/);
+  assert.match(text, /Total: €475\.00$/);
+});
+
+test('renderInvoiceText with issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+
+  assert.match(text, /^INV-2026-0001\n/);
+  assert.match(text, /Blue Fern Bakery/);
+  assert.match(text, /100 Sticker sheet @ €0\.50 = €50\.00/);
+  assert.match(text, /Total: €50\.00$/);
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 6); // DRAFT, customer, 3 lines, total
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /^5 Development \(hour\)/);
+  assert.match(lines[3], /^1 Logo package/);
+  assert.match(lines[4], /^3 Copywriting \(hour\)/);
+  assert.match(lines[5], /^Total:/);
+});
+
+test('renderInvoiceText calculates total correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 1 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+
+  const expectedTotal = 2 * 9500 + 1 * 6000;
+  assert.match(text, new RegExp(`Total: €${(expectedTotal / 100).toFixed(2)}$`, 'm'));
+});
+
+test('renderInvoiceText with large amounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 2 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+
+  assert.match(text, /2 Brand guidelines document @ €2,450\.00 = €4,900\.00/);
+  assert.match(text, /Total: €4,900\.00$/);
+});
+
+test('renderInvoiceText preserves line order', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'COPY-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /Copywriting/);
+  assert.match(lines[3], /Development/);
+  assert.match(lines[4], /Logo/);
+});
+
+test('renderInvoiceText with different customer', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+
+  assert.match(text, /Lumen Records/);
+});
+
+test('renderInvoiceText with single line', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4); // DRAFT, customer, line, total
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.match(lines[2], /^5 Icon set/);
+  assert.match(lines[3], /^Total:/);
+});
+
+test('renderInvoiceText formats amounts as euros', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 7 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+
+  assert.match(text, /€0\.50/);
+  assert.match(text, /€3\.50/);
+});
+
+test('renderInvoiceText with issued invoice number', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const issueResult = issueInvoice(invoiceResult.value, [
+    'INV-2026-0001',
+    'INV-2026-0002',
+  ]);
+  assert.equal(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+  assert.match(text, /^INV-2026-0003\n/);
+});
+
+test('renderInvoiceText multiline string structure', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const text = renderInvoiceText(invoiceResult.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], / @ /);
+  assert.match(lines[2], / = /);
+  assert.match(lines[3], /^Total: /);
+});
