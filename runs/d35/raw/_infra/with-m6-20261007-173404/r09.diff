+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('  C-001  '), 'C-001');
+  assert.equal(normalizeId('\tC-001\n'), 'C-001');
+  assert.equal(normalizeId('C-001 '), 'C-001');
+  assert.equal(normalizeId(' C-001'), 'C-001');
+});
+
+test('normalizeId uppercases', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-007'), 'C-007');
+  assert.equal(normalizeId('C-001'), 'C-001');
+});
+
+test('normalizeId trims and uppercases combined', () => {
+  assert.equal(normalizeId('  c-001  '), 'C-001');
+  assert.equal(normalizeId(' c-007 '), 'C-007');
+  assert.equal(normalizeId('\tc-012\n'), 'C-012');
+});
+
+test('normalizeId with empty string', () => {
+  assert.equal(normalizeId(''), '');
+});
+
+test('normalizeId with only whitespace', () => {
+  assert.equal(normalizeId('   '), '');
+  assert.equal(normalizeId('\t\n'), '');
+});
+
+test('getCustomer finds customer with lowercase id', () => {
+  const result = getCustomer('c-001');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer finds customer with mixed-case id', () => {
+  const result = getCustomer('C-001');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer finds customer with spaces and lowercase', () => {
+  const result = getCustomer('  c-007  ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Halvorsen Architects');
+});
+
+test('getCustomer finds customer with tab and uppercase', () => {
+  const result = getCustomer('\tC-012\n');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Northwind Studio B.V.');
+});
+
+test('getCustomer returns CUSTOMER_NOT_FOUND for unknown normalized id', () => {
+  const result = getCustomer('  C-999  ');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('all customers can be found with lowercase', () => {
+  for (let i = 1; i <= 12; i++) {
+    const padded = String(i).padStart(3, '0');
+    const id = `c-${padded}`;
+    const result = getCustomer(id);
+    assert.equal(result.ok, true, `Should find customer ${id}`);
+  }
+});
+
+test('all customers can be found with mixed case and spaces', () => {
+  const testIds = ['  c-001  ', ' C-002 ', '\tc-003\n', 'C-004'];
+  for (const id of testIds) {
+    const result = getCustomer(id);
+    assert.equal(result.ok, true, `Should find customer ${id}`);
+  }
+});
