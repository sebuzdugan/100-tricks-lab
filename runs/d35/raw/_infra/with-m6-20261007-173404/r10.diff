index 0000000..313a8cb
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,38 @@
+/**
+ * Check if a date string is valid and in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(text);
+  if (!match) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  return date instanceof Date && !isNaN(date) && date.toISOString().startsWith(text);
+}
+
+/**
+ * Add days to a date string (YYYY-MM-DD format), working in UTC.
+ * @param {string} date - Date string in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - Date string in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().substring(0, 10);
+}
+
+/**
+ * Calculate the number of days between two date strings (b - a), in whole days.
+ * Uses UTC midnight to midnight.
+ * @param {string} a - Start date string in YYYY-MM-DD format
+ * @param {string} b - End date string in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const millisecondsPerDay = 1000 * 60 * 60 * 24;
+  return Math.floor((dateB - dateA) / millisecondsPerDay);
+}
