+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment records a payment on issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.equal(issueResult.ok, true);
+  const issued = issueResult.value;
+
+  const result = recordPayment(issued, { amount: 50000, date: '2026-10-10' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment sets status to partially_paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = recordPayment(issued, { amount: totals.total - 10000, date: '2026-10-10' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = recordPayment(issued, { amount: totals.total, date: '2026-10-10' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+  assert.equal(result.value.payments.length, 1);
+});
+
+test('recordPayment multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  let invoice = issued;
+  const result1 = recordPayment(invoice, { amount: totals.total / 2, date: '2026-10-10' });
+  assert.equal(result1.ok, true);
+  invoice = result1.value;
+  assert.equal(invoice.status, 'partially_paid');
+
+  const result2 = recordPayment(invoice, { amount: totals.total / 2, date: '2026-10-15' });
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.status, 'paid');
+  assert.equal(result2.value.payments.length, 2);
+});
+
+test('recordPayment returns NOT_ISSUED for draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const result = recordPayment(invoiceResult.value, { amount: 10000, date: '2026-10-10' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment returns NOT_ISSUED for paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result1 = recordPayment(issued, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(result1.ok, true);
+
+  const result2 = recordPayment(result1.value, { amount: 1000, date: '2026-10-15' });
+  assert.equal(result2.ok, false);
+  assert.equal(result2.error, 'NOT_ISSUED');
+});
+
+test('recordPayment returns AMOUNT_INVALID for zero', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const result = recordPayment(issued, { amount: 0, date: '2026-10-10' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment returns AMOUNT_INVALID for negative', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const result = recordPayment(issued, { amount: -1000, date: '2026-10-10' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment returns AMOUNT_INVALID for non-integer', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+
+  const result = recordPayment(issued, { amount: 1000.5, date: '2026-10-10' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment returns OVERPAYMENT', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = recordPayment(issued, { amount: totals.total + 1, date: '2026-10-10' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment partial then overpayment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result1 = recordPayment(issued, { amount: totals.total / 2, date: '2026-10-10' });
+  assert.equal(result1.ok, true);
+
+  const result2 = recordPayment(result1.value, { amount: totals.total / 2 + 1, date: '2026-10-15' });
+  assert.equal(result2.ok, false);
+  assert.equal(result2.error, 'OVERPAYMENT');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const originalStatus = issued.status;
+
+  recordPayment(issued, { amount: 10000, date: '2026-10-10' });
+
+  assert.equal(issued.status, originalStatus);
+  assert.equal(issued.payments, undefined);
+});
+
+test('balanceDue with no payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  assert.equal(balanceDue(issued), totals.total);
+});
+
+test('balanceDue with partial payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const paymentResult = recordPayment(issued, { amount: 50000, date: '2026-10-10' });
+
+  assert.equal(balanceDue(paymentResult.value), totals.total - 50000);
+});
+
+test('balanceDue with full payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const paymentResult = recordPayment(issued, { amount: totals.total, date: '2026-10-10' });
+
+  assert.equal(balanceDue(paymentResult.value), 0);
+});
+
+test('balanceDue with multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  let invoice = issued;
+  const result1 = recordPayment(invoice, { amount: 30000, date: '2026-10-10' });
+  invoice = result1.value;
+
+  const result2 = recordPayment(invoice, { amount: 20000, date: '2026-10-15' });
+  invoice = result2.value;
+
+  assert.equal(balanceDue(invoice), totals.total - 50000);
+});
+
+test('recordPayment accepts partially_paid status', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result1 = recordPayment(issued, { amount: totals.total / 2, date: '2026-10-10' });
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.status, 'partially_paid');
+
+  const result2 = recordPayment(result1.value, { amount: totals.total / 2, date: '2026-10-15' });
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.status, 'paid');
+});
