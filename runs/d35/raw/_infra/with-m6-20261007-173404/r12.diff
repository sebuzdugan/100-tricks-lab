+const VALID_TERMS = ['NET14', 'NET30', 'EOM'];
+
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-');
+    const lastDay = new Date(Date.UTC(parseInt(year), parseInt(month), 0));
+    return lastDay.toISOString().substring(0, 10);
+  }
+}
 
