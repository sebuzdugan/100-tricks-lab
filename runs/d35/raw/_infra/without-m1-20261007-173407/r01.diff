+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.customerId, 'C-001');
+  assert.equal(invoice.issueDate, '2026-10-07');
+  assert.equal(invoice.status, 'draft');
+  assert.equal(invoice.lines.length, 2);
+  assert.deepEqual(invoice.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 5,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+  assert.deepEqual(invoice.lines[1], {
+    sku: 'DEV-HOUR',
+    name: 'Development (hour)',
+    qty: 3,
+    unitPrice: 9500,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice reports unknown customer', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports invalid date format', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '10-07-2026',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports invalid date value', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports empty lines array', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports missing lines', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports non-integer quantity', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports zero quantity', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports negative quantity', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  }), { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports unknown SKU', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN', qty: 1 }],
+  }), { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice works with products that have different VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.lines[0].vatRate, 9);
+  assert.equal(invoice.lines[1].vatRate, 0);
+});
+
+test('createInvoice does not mutate input lines', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const linesCopy = JSON.stringify(lines);
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+  assert.equal(JSON.stringify(lines), linesCopy);
+});
