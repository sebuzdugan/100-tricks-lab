--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,23 @@
+/**
+ * Calculate the next invoice number for a given date.
+ * Format: INV-YYYY-XXXX where XXXX is 4-digit counter starting at 0001 each year.
+ * @param {Array<string>} existingNumbers array of numbers already issued
+ * @param {string} issueDate date in YYYY-MM-DD format
+ * @returns {string} next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const thisYearPattern = new RegExp(`^INV-${year}-\\d{4}$`);
+  const thisYearNumbers = existingNumbers.filter(num => thisYearPattern.test(num));
+
+  const counters = thisYearNumbers.map(num => {
+    const match = num.match(/^INV-\d{4}-(\d{4})$/);
+    return match ? parseInt(match[1], 10) : 0;
+  });
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+
+  return `INV-${year}-${paddedCounter}`;
+}
