diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..4a2d4c3
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,48 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number for empty list', () => {
+  assert.equal(nextInvoiceNumber([], '2026-10-07'), 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber returns next counter for existing numbers in same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-15'), 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0099', 'INV-2026-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0099', 'INV-2026-0005'];
+  assert.equal(nextInvoiceNumber(existing, '2027-01-01'), 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber finds max counter out of order', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0002', 'INV-2026-0010', 'INV-2026-0003'];
+  assert.equal(nextInvoiceNumber(existing, '2026-12-31'), 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber pads counter with leading zeros', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003', 'INV-2026-0004', 'INV-2026-0005',
+    'INV-2026-0006', 'INV-2026-0007', 'INV-2026-0008', 'INV-2026-0009'];
+  assert.equal(nextInvoiceNumber(existing, '2026-05-05'), 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber handles large counter numbers', () => {
+  const existing = ['INV-2026-0999'];
+  assert.equal(nextInvoiceNumber(existing, '2026-06-01'), 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber skips malformed numbers in existing list', () => {
+  const existing = ['INV-2026-0001', 'INVALID', 'INV-2026-0002', 'INV-2026', 'INV-2026-0003'];
+  assert.equal(nextInvoiceNumber(existing, '2026-03-15'), 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber uses year from issueDate not from existing numbers', () => {
+  const existing = ['INV-2025-0050', 'INV-2025-0100'];
+  assert.equal(nextInvoiceNumber(existing, '2026-01-01'), 'INV-2026-0001');
+});
