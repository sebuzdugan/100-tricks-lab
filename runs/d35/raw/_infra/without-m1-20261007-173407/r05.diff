@@ -0,0 +1,136 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /5x Design work \(hour\) @ €85\.00 = €425\.00/);
+  assert.match(text, /Total: €425\.00$/);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const text = renderInvoiceText(r2.value);
+  assert.match(text, /^INV-2026-0001\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /3x Development \(hour\) @ €95\.00 = €285\.00/);
+  assert.match(text, /Total: €285\.00$/);
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 4 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Blue Fern Bakery/);
+  assert.match(text, /2x Design work \(hour\) @ €85\.00 = €170\.00/);
+  assert.match(text, /1x Development \(hour\) @ €95\.00 = €95\.00/);
+  assert.match(text, /4x Copywriting \(hour\) @ €60\.00 = €240\.00/);
+  assert.match(text, /Total: €505\.00$/);
+});
+
+test('renderInvoiceText formats amounts with euros', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /1x Logo package @ €1,200\.00 = €1,200\.00/);
+  assert.match(text, /Total: €1,200\.00$/);
+});
+
+test('renderInvoiceText handles unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    lines: [{ qty: 5, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Unknown Customer\n/);
+  assert.match(text, /5x Design work \(hour\) @ €85\.00 = €425\.00/);
+});
+
+test('renderInvoiceText includes blank lines for readability', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '');
+  assert.match(lines[3], /1x Design work/);
+  assert.equal(lines[4], '');
+  assert.match(lines[5], /Total:/);
+});
+
+test('renderInvoiceText shows correct totals with multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 10 },
+      { sku: 'FONT-LIC', qty: 3 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /10x Icon set \(24 icons\) @ €9\.80 = €98\.00/);
+  assert.match(text, /3x Font licence \(desktop\) @ €10\.10 = €30\.30/);
+  assert.match(text, /Total: €128\.30$/);
+});
+
+test('renderInvoiceText works with products having different VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PRINT-A4', qty: 50 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /50x Printed flyer A4 \(each\) @ €0\.37 = €18\.50/);
+  assert.match(text, /1x Brand workshop \(day, VAT exempt\) @ €600\.00 = €600\.00/);
+  assert.match(text, /Total: €618\.50$/);
+});
+
+test('renderInvoiceText preserves customer name with special characters', () => {
+  const r = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Marlow "The Print Shop"/);
+});
