diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..2f355af
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,117 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2026-02-28'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('26-10-07'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-01-00'), false);
+});
+
+test('isValidDate handles leap years', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('isValidDate rejects empty and null-like strings', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('null'), false);
+  assert.equal(isValidDate('undefined'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 30), '2026-11-06');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+});
+
+test('addDays subtracts with negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays handles large numbers', () => {
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+  assert.equal(addDays('2026-01-01', 1000), '2028-09-27');
+});
+
+test('daysBetween calculates positive differences', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2026-11-06'), 30);
+});
+
+test('daysBetween calculates negative differences', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+});
+
+test('daysBetween handles same date', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+});
+
+test('daysBetween handles large differences', () => {
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+  assert.equal(daysBetween('2026-01-01', '2028-01-01'), 730);
+});
+
+test('daysBetween and addDays are inverses', () => {
+  const start = '2026-10-07';
+  const days = 42;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+  assert.equal(addDays(end, -days), start);
+});
+
+test('dates work in UTC, not local time', () => {
+  const date = addDays('2026-10-31', 1);
+  assert.equal(date, '2026-11-01');
+
+  const diff = daysBetween('2026-12-30', '2027-01-02');
+  assert.equal(diff, 3);
+});
