+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('balanceDue returns total when no payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const invoice = r2.value;
+  const { total } = invoiceTotals(invoice);
+  const balance = balanceDue(invoice);
+  assert.equal(balance, total);
+});
+
+test('balanceDue subtracts payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const invoice = r2.value;
+  const { total } = invoiceTotals(invoice);
+  assert.equal(balanceDue(invoice), total);
+
+  const r3 = recordPayment(invoice, { amount: 50000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(balanceDue(r3.value), total - 50000);
+});
+
+test('recordPayment requires issued or partially_paid status', () => {
+  const draftInvoice = {
+    status: 'draft',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 5 }],
+  };
+  assert.deepEqual(recordPayment(draftInvoice, { amount: 1000, date: '2026-10-08' }), {
+    ok: false,
+    error: 'NOT_ISSUED',
+  });
+
+  const paidInvoice = {
+    status: 'paid',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 5 }],
+  };
+  assert.deepEqual(recordPayment(paidInvoice, { amount: 1000, date: '2026-10-08' }), {
+    ok: false,
+    error: 'NOT_ISSUED',
+  });
+});
+
+test('recordPayment validates amount is positive integer', () => {
+  const issuedInvoice = {
+    status: 'issued',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 5 }],
+  };
+
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: 0, date: '2026-10-08' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: -1000, date: '2026-10-08' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: 1000.5, date: '2026-10-08' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment validates date format', () => {
+  const issuedInvoice = {
+    status: 'issued',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 5 }],
+  };
+
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: 1000, date: '10-08-2026' }), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+
+  assert.deepEqual(recordPayment(issuedInvoice, { amount: 1000, date: '2026-13-01' }), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+});
+
+test('recordPayment prevents overpayment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const invoice = r2.value;
+  const total = invoiceTotals(invoice).total;
+
+  assert.deepEqual(recordPayment(invoice, { amount: total + 1, date: '2026-10-08' }), {
+    ok: false,
+    error: 'OVERPAYMENT',
+  });
+});
+
+test('recordPayment creates payments array', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const invoice = r2.value;
+  assert.equal(invoice.payments, undefined);
+
+  const r3 = recordPayment(invoice, { amount: 20000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 1);
+  assert.deepEqual(r3.value.payments[0], { amount: 20000, date: '2026-10-08' });
+});
+
+test('recordPayment sets status to partially_paid for partial payment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const invoice = r2.value;
+  assert.equal(invoice.status, 'issued');
+
+  const r3 = recordPayment(invoice, { amount: 20000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const invoice = r2.value;
+  const total = invoiceTotals(invoice).total;
+
+  const r3 = recordPayment(invoice, { amount: total, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'paid');
+  assert.equal(balanceDue(r3.value), 0);
+});
+
+test('recordPayment records multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  let invoice = r2.value;
+
+  const r3 = recordPayment(invoice, { amount: 20000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 1);
+  invoice = r3.value;
+
+  const r4 = recordPayment(invoice, { amount: 20000, date: '2026-10-09' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.payments.length, 2);
+  assert.deepEqual(r4.value.payments[1], { amount: 20000, date: '2026-10-09' });
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+  const invoice = r2.value;
+  const invoiceCopy = JSON.stringify(invoice);
+
+  recordPayment(invoice, { amount: 100000, date: '2026-10-08' });
+  assert.equal(JSON.stringify(invoice), invoiceCopy);
+});
