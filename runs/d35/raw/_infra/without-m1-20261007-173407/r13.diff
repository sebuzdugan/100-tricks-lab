- * @returns {{ subtotal: number, discount: number, vat: number, total: number }} amounts in cents
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { code: string, amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} amounts in cents
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
   const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
-  const total = Math.max(0, subtotal - discount + vat);
-  return { subtotal, discount, vat, total };
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return { subtotal, discount, vat, voucher, total };
 }
 
 /**
@@ -215,3 +216,24 @@ export function issueInvoice(invoice, existingNumbers) {
     status: 'issued',
   });
 }
+
+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: any }} invoice
+ * @param {{ code: string, amount: number }}
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
