+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a valid draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 8 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2024-10-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 8,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+
+  assert.deepEqual(result.value.lines[1], {
+    sku: 'ICON-SET',
+    name: 'Icon set (24 icons)',
+    qty: 2,
+    unitPrice: 980,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice returns DATE_INVALID for missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns DATE_INVALID for malformed date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '15-10-2024',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns DATE_INVALID for non-existent date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns DATE_INVALID for invalid date format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-13-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice returns QTY_INVALID for zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice returns QTY_INVALID for negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice returns QTY_INVALID for fractional quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice returns UNKNOWN_SKU for invalid SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'INVALID-SKU', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice stops at first error in line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'INVALID-SKU', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice works with single line', () => {
+  const result = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2023-12-25',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-005');
+  assert.equal(result.value.issueDate, '2023-12-25');
+  assert.equal(result.value.lines.length, 1);
+  assert.equal(result.value.lines[0].name, 'Brand workshop (day, VAT exempt)');
+  assert.equal(result.value.lines[0].vatRate, 0);
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 3 }];
+  const linesCopy = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines,
+  });
+
+  assert.deepEqual(lines, linesCopy);
+});
