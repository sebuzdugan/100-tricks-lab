--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,25 @@
+/**
+ * Get the next invoice number for a given date.
+ * @param {string[]} existingNumbers - Invoice numbers already used, e.g. ['INV-2024-0001', 'INV-2024-0002']
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} The next invoice number, e.g. 'INV-2024-0003'
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Find all numbers from this year
+  const yearPrefix = `INV-${year}-`;
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(yearPrefix))
+    .map((num) => {
+      const counter = num.substring(yearPrefix.length);
+      return Number(counter);
+    })
+    .filter((num) => !Number.isNaN(num));
+
+  // Find the max counter, or 0 if none exist
+  const maxCounter = thisYearNumbers.length > 0 ? Math.max(...thisYearNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${yearPrefix}${String(nextCounter).padStart(4, '0')}`;
+}
