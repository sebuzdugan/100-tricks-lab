diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..89f16b8
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const result = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(result, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments the counter for the same year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002'];
+  const result = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber resets counter for a new year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-9999'];
+  const result = nextInvoiceNumber(existing, '2025-01-15');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber handles unsorted numbers', () => {
+  const existing = ['INV-2024-0003', 'INV-2024-0001', 'INV-2024-0002'];
+  const result = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(result, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = [
+    'INV-2023-0001',
+    'INV-2023-9999',
+    'INV-2024-0001',
+    'INV-2024-0002',
+    'INV-2025-0001',
+  ];
+  const result = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = Array.from({ length: 10 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const result = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(result, 'INV-2024-0011');
+});
+
+test('nextInvoiceNumber handles gaps in counter sequence', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0005'];
+  const result = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(result, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2024-0001', 'INVALID', 'INV-2024-ABC', 'INV-2024-0002'];
+  const result = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(result, 'INV-2024-0003');
+});
