+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, issueDate: string, status: string, lines: Array }} invoice
+ * @returns {string} Plain-text invoice
+ */
+export function renderInvoiceText(invoice) {
+  // First line: invoice number or DRAFT
+  const invoiceNumber = invoice.number ?? 'DRAFT';
+
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  // Render line items
+  const lineTexts = invoice.lines.map((line) => {
+    const total = lineTotal(line);
+    const formattedUnitPrice = formatEuros(line.unitPrice);
+    const formattedTotal = formatEuros(total);
+    return `${line.qty}x ${line.name} @ ${formattedUnitPrice} = ${formattedTotal}`;
+  });
+
+  // Calculate total
+  const totalAmount = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const formattedTotal = formatEuros(totalAmount);
+
+  // Assemble all lines
+  const allLines = [invoiceNumber, customerName, ...lineTexts, `Total: ${formattedTotal}`];
+
+  return allLines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..6c7ea0d
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,143 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice with DRAFT label', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /8x Design work \(hour\) @ €85\.00 = €680\.00\n/);
+  assert.match(text, /Total: €680\.00$/);
+});
+
+test('renderInvoiceText renders an issued invoice with invoice number', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8 }],
+  });
+
+  const issueResult = issueInvoice(result.value, []);
+  const text = renderInvoiceText(issueResult.value);
+
+  assert.match(text, /^INV-2024-0001\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /8x Design work \(hour\) @ €85\.00 = €680\.00\n/);
+  assert.match(text, /Total: €680\.00$/);
+});
+
+test('renderInvoiceText shows multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 8 },
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /8x Design work \(hour\) @ €85\.00 = €680\.00/);
+  assert.match(lines[3], /2x Icon set \(24 icons\) @ €9\.80 = €19\.60/);
+  assert.match(lines[4], /100x Sticker sheet @ €0\.50 = €50\.00/);
+  assert.match(lines[5], /Total: €749\.60/);
+});
+
+test('renderInvoiceText uses formatEuros for all amounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+
+  // formatEuros shows € symbol and thousand separators
+  assert.match(text, /€1,200\.00/);
+  assert.match(text, /Total: €1,200\.00/);
+});
+
+test('renderInvoiceText handles different customer names', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /^DRAFT\nKite & Co\n/);
+});
+
+test('renderInvoiceText shows unknown customer gracefully', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2024-10-15',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 1,
+        unitPrice: 8500,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /^DRAFT\nUnknown Customer\n/);
+});
+
+test('renderInvoiceText with small prices and large quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'PRINT-A4', qty: 500 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /500x Printed flyer A4 \(each\) @ €0\.37 = €185\.00/);
+  assert.match(text, /Total: €185\.00/);
+});
+
+test('renderInvoiceText returns a string', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+
+  assert.equal(typeof text, 'string');
+  assert.ok(text.includes('\n'));
+});
+
+test('renderInvoiceText with VAT-exempt items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  });
+
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /2x Brand workshop \(day, VAT exempt\) @ €600\.00 = €1,200\.00/);
+  assert.match(text, /Total: €1,200\.00/);
+});
