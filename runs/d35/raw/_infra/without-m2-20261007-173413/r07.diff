+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount (2.5%) to lines without explicit discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount (0%) to lines without explicit discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice: explicit discountPercent overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 15 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 15);
+});
+
+test('createInvoice: explicit 0 discountPercent overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice: different lines can have different tier discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 8 },
+      { sku: 'ICON-SET', qty: 2, discountPercent: 10 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+  assert.equal(result.value.lines[1].discountPercent, 10);
+});
+
+test('addLine applies tier discount to new lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8 }],
+  });
+
+  const invoice = result.value;
+  const addResult = addLine(invoice, { sku: 'ICON-SET', qty: 5 });
+
+  assert.equal(addResult.ok, true);
+  assert.equal(addResult.value.lines[1].discountPercent, 5);
+});
+
+test('addLine: explicit discountPercent overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8 }],
+  });
+
+  const invoice = result.value;
+  const addResult = addLine(invoice, { sku: 'ICON-SET', qty: 5, discountPercent: 12 });
+
+  assert.equal(addResult.ok, true);
+  assert.equal(addResult.value.lines[1].discountPercent, 12);
+});
+
+test('tier discount affects invoice totals', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8 }],
+  });
+
+  assert.equal(result.ok, true);
+  const totals = invoiceTotals(result.value);
+
+  assert.equal(totals.subtotal, 68000);
+  assert.equal(totals.discount, 3400);
+  assert.equal(totals.total, 64600);
+});
