   const formattedDiscount = formatEuros(totals.discount);
+  const formattedVat = formatEuros(totals.vat);
   const formattedTotal = formatEuros(totals.total);
 
   // Assemble all lines
   const allLines = [invoiceNumber, customerName, ...lineTexts];
 
+  // Show breakdown if there are discounts
   if (totals.discount > 0) {
     allLines.push(`Subtotal: ${formattedSubtotal}`);
     allLines.push(`Discount: -${formattedDiscount}`);
   }
 
+  // Show VAT if there's any
+  if (totals.vat > 0) {
+    allLines.push(`VAT: ${formattedVat}`);
+  }
+
   allLines.push(`Total: ${formattedTotal}`);
 
   return allLines.join('\n');
