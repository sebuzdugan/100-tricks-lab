+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(text);
+  if (!match) return false;
+
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+
+  // Check month and day ranges
+  if (month < 1 || month > 12 || day < 1 || day > 31) return false;
+
+  // Use Date to validate the actual date in UTC
+  const date = new Date(`${text}T00:00:00Z`);
+  return date.toISOString().startsWith(text);
+}
+
+/**
+ * Parse a date string as a UTC date.
+ * @param {string} dateString YYYY-MM-DD format
+ * @returns {Date}
+ */
+function parseUtcDate(dateString) {
+  return new Date(`${dateString}T00:00:00Z`);
+}
+
+/**
+ * Format a UTC date as YYYY-MM-DD.
+ * @param {Date} date
+ * @returns {string}
+ */
+function formatUtcDate(date) {
+  return date.toISOString().split('T')[0];
+}
+
+/**
+ * Add n days to a date, returning result in YYYY-MM-DD format (UTC).
+ * @param {string} date YYYY-MM-DD format
+ * @param {number} n Number of days to add
+ * @returns {string} YYYY-MM-DD format in UTC
+ */
+export function addDays(date, n) {
+  const d = parseUtcDate(date);
+  d.setUTCDate(d.getUTCDate() + n);
+  return formatUtcDate(d);
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a) in UTC.
+ * @param {string} a YYYY-MM-DD format
+ * @param {string} b YYYY-MM-DD format
+ * @returns {number} Number of days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = parseUtcDate(a);
+  const dateB = parseUtcDate(b);
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
