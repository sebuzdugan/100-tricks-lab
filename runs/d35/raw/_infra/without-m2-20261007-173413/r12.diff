   return typeof discountPercent === 'number' && discountPercent >= 0 && discountPercent <= 100;
 }
 
+function addDaysUtc(dateStr, n) {
+  const d = new Date(`${dateStr}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDaysUtc(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDaysUtc(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-');
+    const yearNum = parseInt(year);
+    const monthNum = parseInt(month);
+
+    let nextMonth = monthNum + 1;
+    let nextYear = yearNum;
+    if (nextMonth > 12) {
+      nextMonth = 1;
+      nextYear += 1;
+    }
+
+    const nextMonthFirstDay = `${nextYear}-${nextMonth.toString().padStart(2, '0')}-01`;
+    return addDaysUtc(nextMonthFirstDay, -1);
+  }
+  return null;
+}
