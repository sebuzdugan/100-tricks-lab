+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement.
+ * @param {string} customerId
+ * @param {Array} invoices - All invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize and validate customer exists
+  const normalizedCustomerId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer with qualifying status and date
+  const qualifyingInvoices = invoices.filter((invoice) => {
+    // Must belong to this customer
+    if (invoice.customerId !== normalizedCustomerId) return false;
+
+    // Must have issued or partially_paid status
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') return false;
+
+    // Issue date must be on or before asOf
+    if (invoice.issueDate > asOf) return false;
+
+    return true;
+  });
+
+  // Sort by issue date ascending and build statement lines
+  const statementInvoices = qualifyingInvoices
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate))
+    .map((invoice) => {
+      const totals = invoiceTotals(invoice);
+      const due = balanceDue(invoice);
+      return {
+        number: invoice.number,
+        issueDate: invoice.issueDate,
+        dueDate: invoice.dueDate,
+        total: totals.total,
+        due,
+      };
+    });
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
