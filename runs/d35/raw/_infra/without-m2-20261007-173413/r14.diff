+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns customer statement with issued invoices', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2], '2024-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2024-10-01');
+  assert.equal(result.value.invoices[1].issueDate, '2024-10-15');
+});
+
+test('statement filters invoices by customer', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2], '2024-10-31');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, inv1.number);
+});
+
+test('statement filters by date (asOf)', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-09-01',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2], '2024-10-01');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-09-01');
+});
+
+test('statement includes invoices with issueDate equal to asOf', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv], '2024-10-15');
+
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement excludes invoices with issueDate after asOf', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-16',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv], '2024-10-15');
+
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+  }).value;
+
+  const issued = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [draft, issued], '2024-10-31');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, issued.number);
+});
+
+test('statement includes partially_paid invoices', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  inv = recordPayment(inv, { amount: 40000, date: '2024-10-15' }).value;
+
+  const result = statement('C-001', [inv], '2024-10-31');
+
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, inv.number);
+});
+
+test('statement excludes paid invoices', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  inv = recordPayment(inv, { amount: 6050, date: '2024-10-15' }).value;
+
+  const result = statement('C-001', [inv], '2024-10-31');
+
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement calculates due for each invoice', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  inv = recordPayment(inv, { amount: 40000, date: '2024-10-15' }).value;
+
+  const result = statement('C-001', [inv], '2024-10-31');
+
+  assert.equal(result.value.invoices[0].due, 42280);
+});
+
+test('statement calculates totalDue', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2], '2024-10-31');
+
+  assert.equal(result.value.totalDue, 6050 + 6050);
+});
+
+test('statement sorts invoices by issueDate ascending', () => {
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-20',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-10',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv3, inv1, inv2], '2024-10-31');
+
+  assert.equal(result.value.invoices[0].issueDate, '2024-10-01');
+  assert.equal(result.value.invoices[1].issueDate, '2024-10-10');
+  assert.equal(result.value.invoices[2].issueDate, '2024-10-20');
+});
+
+test('statement includes invoice details', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+      terms: 'NET14',
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv], '2024-10-31');
+
+  const stmtInv = result.value.invoices[0];
+  assert.equal(stmtInv.number, inv.number);
+  assert.equal(stmtInv.issueDate, '2024-10-01');
+  assert.equal(stmtInv.dueDate, '2024-10-15');
+  assert.equal(stmtInv.total, 82280);
+  assert.equal(stmtInv.due, 82280);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('C-999', [], '2024-10-31');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement with normalized customer ID', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement(' c-001 ', [inv], '2024-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement returns empty invoice list when no qualifying invoices', () => {
+  const result = statement('C-001', [], '2024-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
