+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Discount applied', date: '2024-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Discount applied');
+  assert.equal(result.value.date, '2024-10-20');
+});
+
+test('createCreditNote works for partially_paid invoices', () => {
+  let invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  invoice = recordPayment(invoice, { amount: 40000, date: '2024-10-18' }).value;
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Partial refund', date: '2024-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote works for paid invoices', () => {
+  let invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  invoice = recordPayment(invoice, { amount: 6050, date: '2024-10-18' }).value;
+
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Return', date: '2024-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote returns NOT_ISSUED for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+  }).value;
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Discount', date: '2024-10-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote returns AMOUNT_INVALID for zero amount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = createCreditNote(invoice, { amount: 0, reason: 'Test', date: '2024-10-20' }, []);
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote returns AMOUNT_INVALID for negative amount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = createCreditNote(invoice, { amount: -1000, reason: 'Test', date: '2024-10-20' }, []);
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote returns AMOUNT_INVALID for fractional amount', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = createCreditNote(invoice, { amount: 1000.5, reason: 'Test', date: '2024-10-20' }, []);
+
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote returns CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = createCreditNote(invoice, { amount: 100000, reason: 'Invalid', date: '2024-10-20' }, []);
+
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote allows amount equal to invoice total', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = createCreditNote(invoice, { amount: 6050, reason: 'Full refund', date: '2024-10-20' }, []);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote uses separate counter from invoices', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003'];
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024-10-20' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote increments credit note counter', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const existingNumbers = ['CN-2024-0001', 'CN-2024-0002'];
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024-10-20' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2024-0003');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const existingNumbers = ['CN-2024-0001', 'CN-2024-0002'];
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2025-01-20' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote pads counter with zeros', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const existingNumbers = Array.from({ length: 10 }, (_, i) => `CN-2024-${String(i + 1).padStart(4, '0')}`);
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024-10-20' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2024-0011');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 8, discountPercent: 0 }],
+    }).value,
+    [],
+  ).value;
+
+  const existingNumbers = [
+    'INV-2024-0001',
+    'CN-2024-0001',
+    'INV-2024-0002',
+    'CN-2024-0002',
+    'INV-2024-0003',
+  ];
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2024-10-20' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2024-0003');
+});
