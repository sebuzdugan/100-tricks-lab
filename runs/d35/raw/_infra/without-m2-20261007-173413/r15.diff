+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next credit note number.
+ * @param {string[]} existingNumbers - All existing invoice and credit note numbers
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} Next credit note number (CN-<year>-<counter>)
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.substring(0, 4);
+
+  // Find all credit note numbers from this year
+  const yearPrefix = `CN-${year}-`;
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(yearPrefix))
+    .map((num) => {
+      const counter = num.substring(yearPrefix.length);
+      return Number(counter);
+    })
+    .filter((num) => !Number.isNaN(num));
+
+  // Find the max counter, or 0 if none exist
+  const maxCounter = thisYearNumbers.length > 0 ? Math.max(...thisYearNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${yearPrefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {string[]} existingNumbers - All existing invoice and credit note numbers
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice has been issued
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check amount doesn't exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
