 }
+
+/**
+ * Add a line to an invoice, or increase qty if the SKU already exists.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} line
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Validate SKU
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return fail('UNKNOWN_SKU');
+
+  const product = productResult.value;
+  const newInvoice = {
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: [],
+  };
+
+  // Check if SKU already exists
+  let found = false;
+  for (const line of invoice.lines) {
+    if (line.sku === sku) {
+      newInvoice.lines.push({
+        sku: line.sku,
+        name: line.name,
+        qty: line.qty + qty,
+        unitPrice: line.unitPrice,
+        vatRate: line.vatRate,
+      });
+      found = true;
+    } else {
+      newInvoice.lines.push({ ...line });
+    }
+  }
+
+  // If SKU wasn't found, add new line
+  if (!found) {
+    newInvoice.lines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok(newInvoice);
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Find and remove the line
+  const newLines = [];
+  let found = false;
+  for (const line of invoice.lines) {
+    if (line.sku === sku) {
+      found = true;
+    } else {
+      newLines.push({ ...line });
+    }
+  }
+
+  // Check if SKU was found
+  if (!found) return fail('LINE_NOT_FOUND');
+
+  // Check if this would remove the last line
+  if (newLines.length === 0) return fail('NO_LINES');
+
+  const newInvoice = {
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
