index 0000000..bfeeb3f
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,24 @@
+/**
+ * Generate the next invoice number for a given issue date.
+ * Format: INV-<year>-<counter>, where counter is 4 digits starting at 0001 per year.
+ * @param {string[]} existingNumbers - array of invoice numbers already used
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Find the maximum counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterStr = num.substring(prefix.length);
+      const counter = Number(counterStr);
+      if (counter > maxCounter) maxCounter = counter;
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
