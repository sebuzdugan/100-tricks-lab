diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..43d6da2
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2025-06-15');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter within a year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(number, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2024-0001'];
+  const number = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0050', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber handles unordered input', () => {
+  const existing = ['INV-2025-0005', 'INV-2025-0001', 'INV-2025-0010'];
+  const number = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(number, 'INV-2025-0011');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2025-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(number, 'INV-2025-0100');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2025-9999'];
+  const number = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(number, 'INV-2025-10000');
+});
