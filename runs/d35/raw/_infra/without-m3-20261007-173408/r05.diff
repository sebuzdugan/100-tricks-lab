+++ b/test/render.test.js
@@ -0,0 +1,144 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  assert.ok(text.startsWith('INV-2025-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Kite & Co'));
+});
+
+test('renderInvoiceText formats line items with quantities and prices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('10x Design work (hour) @ €85.00 = €850.00'));
+  assert.ok(text.includes('5x Development (hour) @ €95.00 = €475.00'));
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('Total: €1,325.00'));
+});
+
+test('renderInvoiceText formats single line item correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 3 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('3x Logo package @ €1,200.00 = €3,600.00'));
+  assert.ok(text.includes('Total: €3,600.00'));
+});
+
+test('renderInvoiceText has correct line structure', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.ok(lines[2].startsWith('100x Sticker sheet'));
+  assert.ok(lines[3].startsWith('Total:'));
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [
+      { sku: 'STICKER', qty: 1000 },
+      { sku: 'ICON-SET', qty: 5 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('1000x Sticker sheet @ €0.50 = €500.00'));
+  assert.ok(text.includes('5x Icon set (24 icons) @ €9.80 = €49.00'));
+  assert.ok(text.includes('1x Brand guidelines document @ €2,450.00 = €2,450.00'));
+  assert.ok(text.includes('Total: €2,999.00'));
+});
+
+test('renderInvoiceText uses thousands separators', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'BRAND-BOOK', qty: 50 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('€2,450.00'));
+  assert.ok(text.includes('€122,500.00'));
+});
+
+test('renderInvoiceText works with zero VAT items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('Brand workshop (day, VAT exempt)'));
+  assert.ok(text.includes('€600.00'));
+});
