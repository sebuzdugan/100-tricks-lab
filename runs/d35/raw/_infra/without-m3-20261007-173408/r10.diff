@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-06-15'), true);
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('2025/06/15'), false);
+  assert.equal(isValidDate('15-06-2025'), false);
+  assert.equal(isValidDate('2025-6-15'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+});
+
+test('isValidDate rejects invalid month', () => {
+  assert.equal(isValidDate('2025-00-01'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+});
+
+test('isValidDate rejects invalid day', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-04-31'), false);
+  assert.equal(isValidDate('2025-06-00'), false);
+});
+
+test('isValidDate rejects non-existent leap day', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate accepts leap day in leap year', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-06-15', 1), '2025-06-16');
+  assert.equal(addDays('2025-06-15', 10), '2025-06-25');
+  assert.equal(addDays('2025-06-15', 365), '2026-06-15');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2025-06-15', -1), '2025-06-14');
+  assert.equal(addDays('2025-06-15', -10), '2025-06-05');
+  assert.equal(addDays('2025-06-15', -365), '2024-06-15');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-06-30', 1), '2025-07-01');
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays handles leap year boundaries', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles zero', () => {
+  assert.equal(addDays('2025-06-15', 0), '2025-06-15');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2025-06-15', '2025-06-16'), 1);
+  assert.equal(daysBetween('2025-06-15', '2025-06-25'), 10);
+  assert.equal(daysBetween('2025-06-15', '2026-06-15'), 365);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2025-06-16', '2025-06-15'), -1);
+  assert.equal(daysBetween('2025-06-25', '2025-06-15'), -10);
+  assert.equal(daysBetween('2026-06-15', '2025-06-15'), -365);
+});
+
+test('daysBetween returns zero for same date', () => {
+  assert.equal(daysBetween('2025-06-15', '2025-06-15'), 0);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('daysBetween works across months and years', () => {
+  assert.equal(daysBetween('2025-06-30', '2025-07-01'), 1);
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+});
