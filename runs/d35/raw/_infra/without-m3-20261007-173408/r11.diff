+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('balanceDue returns total for unpaid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 102850);
+});
+
+test('balanceDue returns 0 for paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const invoice2 = {
+    ...invoice,
+    payments: [{ amount: 102850, date: '2025-06-20' }],
+  };
+
+  const balance = balanceDue(invoice2);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue returns remainder for partially paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const invoice2 = {
+    ...invoice,
+    payments: [{ amount: 50000, date: '2025-06-20' }],
+  };
+
+  const balance = balanceDue(invoice2);
+  assert.equal(balance, 52850);
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r = recordPayment(issued, { amount: 50000, date: '2025-06-20' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 50000);
+  assert.equal(r.value.payments[0].date, '2025-06-20');
+});
+
+test('recordPayment appends to existing payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r1 = recordPayment(issued, { amount: 50000, date: '2025-06-20' });
+  const r2 = recordPayment(r1.value, { amount: 51850, date: '2025-06-25' });
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.payments.length, 2);
+  assert.equal(r2.value.payments[0].amount, 50000);
+  assert.equal(r2.value.payments[1].amount, 51850);
+});
+
+test('recordPayment sets status to partially_paid for partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r = recordPayment(issued, { amount: 50000, date: '2025-06-20' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r = recordPayment(issued, { amount: 102850, date: '2025-06-20' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment reports NOT_ISSUED for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  assert.deepEqual(recordPayment(invoice, { amount: 50000, date: '2025-06-20' }), {
+    ok: false,
+    error: 'NOT_ISSUED',
+  });
+});
+
+test('recordPayment reports NOT_ISSUED for paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const paid = recordPayment(issued, { amount: 102850, date: '2025-06-20' }).value;
+
+  assert.deepEqual(recordPayment(paid, { amount: 1000, date: '2025-06-25' }), {
+    ok: false,
+    error: 'NOT_ISSUED',
+  });
+});
+
+test('recordPayment reports AMOUNT_INVALID for zero', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 0, date: '2025-06-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment reports AMOUNT_INVALID for negative', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: -1000, date: '2025-06-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment reports AMOUNT_INVALID for decimal', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 1000.5, date: '2025-06-20' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment reports DATE_INVALID for invalid date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 50000, date: '2025/06/20' }), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+});
+
+test('recordPayment reports OVERPAYMENT when amount exceeds balance', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(recordPayment(issued, { amount: 102851, date: '2025-06-20' }), {
+    ok: false,
+    error: 'OVERPAYMENT',
+  });
+});
+
+test('recordPayment reports OVERPAYMENT when additional payment exceeds balance', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r1 = recordPayment(issued, { amount: 50000, date: '2025-06-20' });
+  const r2 = recordPayment(r1.value, { amount: 52851, date: '2025-06-25' });
+
+  assert.equal(r2.ok, false);
+  assert.equal(r2.error, 'OVERPAYMENT');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const original = JSON.parse(JSON.stringify(issued));
+
+  recordPayment(issued, { amount: 50000, date: '2025-06-20' });
+
+  assert.deepEqual(issued, original);
+});
+
+test('recordPayment preserves invoice number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r = recordPayment(issued, { amount: 50000, date: '2025-06-20' });
+
+  assert.equal(r.value.number, 'INV-2025-0001');
+});
+
+test('recordPayment allows payment on partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r1 = recordPayment(issued, { amount: 50000, date: '2025-06-20' });
+  const r2 = recordPayment(r1.value, { amount: 52850, date: '2025-06-25' });
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'paid');
+});
