+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }>, total?: number }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, payments?: Array, total?: number }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Check for overpayment
+  const balance = balanceDue(invoice);
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new invoice with payment added
+  const newInvoice = {
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments: [...(invoice.payments ?? []), { amount, date }],
+  };
+
+  // Copy any other fields that might exist
+  if (invoice.number) newInvoice.number = invoice.number;
+
+  // Update status based on total paid
+  const totals = invoiceTotals(newInvoice);
+  const totalPaid = newInvoice.payments.reduce((sum, p) => sum + p.amount, 0);
+
+  if (totalPaid >= totals.total) {
+    newInvoice.status = 'paid';
+  } else if (totalPaid > 0) {
+    newInvoice.status = 'partially_paid';
+  }
+
+  return ok(newInvoice);
+}
