+
+/**
+ * Apply a voucher to an invoice (draft only).
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array, terms?: string, dueDate?: string, voucher?: object }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Check voucher doesn't already exist
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const newInvoice = {
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    terms: invoice.terms,
+    dueDate: invoice.dueDate,
+    voucher: { code, amount },
+  };
+
+  // Copy optional fields
+  if (invoice.number) newInvoice.number = invoice.number;
+  if (invoice.payments) newInvoice.payments = invoice.payments.map(p => ({ ...p }));
+
+  return ok(newInvoice);
+}
