+++ b/src/invoices.js
@@ -0,0 +1,70 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Parse and validate a date string in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  const regex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!regex.test(dateStr)) return false;
+  const d = new Date(dateStr + 'T00:00:00Z');
+  return d instanceof Date && !isNaN(d) && d.toISOString().startsWith(dateStr);
+}
+
+/**
+ * Create a new invoice with the given customer, issue date, and line items.
+ * Each line must have a SKU and quantity; name, unitPrice, and vatRate are copied from the catalogue.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate date
+  if (!isValidDate(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines array
+  if (!lines || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Get product and validate SKU
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) {
+      return productResult;
+    }
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  const invoice = {
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  };
+
+  return ok(invoice);
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..4afbb82
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,153 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a valid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(r.value.lines[0].name, 'Development (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 9500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice with multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].name, 'Development (hour)');
+  assert.equal(r.value.lines[1].name, 'Logo package');
+});
+
+test('createInvoice reports unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '07/10/2026',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects non-existent date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects date without hyphens', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '20261007',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects null lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects zero quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects negative quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects fractional quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 2.5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  };
+  const original = JSON.stringify(input);
+  createInvoice(input);
+  assert.equal(JSON.stringify(input), original);
+});
+
+test('createInvoice handles various SKUs with different VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].vatRate, 21);
+  assert.equal(r.value.lines[1].vatRate, 9);
+  assert.equal(r.value.lines[2].vatRate, 0);
+});
