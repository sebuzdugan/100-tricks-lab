diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..9f88eda
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,58 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0050', 'INV-2026-0001', 'INV-2027-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber works regardless of order', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0005', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = ['INV-2026-0099'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber handles year transitions', () => {
+  const existing = ['INV-2025-9999', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2027-01-01');
+  assert.equal(number, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber extracts year from issueDate', () => {
+  const existing = ['INV-2026-0001'];
+  const number1 = nextInvoiceNumber(existing, '2026-01-15');
+  const number2 = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(number1, 'INV-2026-0002');
+  assert.equal(number2, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-ABC', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores negative numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
