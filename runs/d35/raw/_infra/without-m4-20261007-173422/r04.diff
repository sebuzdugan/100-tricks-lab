+/**
+ * Calculate the next free invoice number for a given year.
+ * Format: INV-<year>-<counter>, where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (in any order)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - The next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Filter numbers from the same year and extract their counters
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((c) => Number.isInteger(c) && c > 0);
+
+  // Find the maximum counter, or 0 if none exist
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
