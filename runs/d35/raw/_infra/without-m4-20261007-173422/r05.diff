+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * Format: invoice number (or DRAFT), customer name, one line per item, total.
+ * All amounts are formatted using formatEuros().
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  lines.push(invoice.number || 'DRAFT');
+
+  // Second line: customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+  lines.push(customerName);
+
+  // Invoice lines: qty × name - unit price each = line total
+  for (const line of invoice.lines) {
+    const lineAmount = line.qty * line.unitPrice;
+    const lineText = `${line.qty} × ${line.name} - ${formatEuros(line.unitPrice)} each = ${formatEuros(lineAmount)}`;
+    lines.push(lineText);
+  }
+
+  // Total line
+  const { total } = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..7d98029
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,172 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const text = renderInvoiceText(r2.value);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Kite & Co/);
+});
+
+test('renderInvoiceText formats line items correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  // 5 hours × €95.00 = €475.00
+  assert.match(text, /5 × Development \(hour\) - €95\.00 each = €475\.00/);
+});
+
+test('renderInvoiceText shows correct totals', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  // 3 × 9500 + 1 × 120000 = 28500 + 120000 = 148500 cents = €1,485.00
+  assert.match(text, /Total: €1,485\.00/);
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.match(lines[2], /3 × Development \(hour\)/);
+  assert.match(lines[3], /1 × Logo package/);
+  assert.match(lines[4], /Total:/);
+});
+
+test('renderInvoiceText formats euro amounts correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  // 100 stickers × €0.50 = €50.00
+  assert.match(text, /100 × Sticker sheet - €0\.50 each = €50\.00/);
+});
+
+test('renderInvoiceText handles different VAT rates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 50 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  // Should have 6 lines: DRAFT, customer, 3 items, total
+  assert.equal(lines.length, 6);
+  assert.match(lines[2], /1 × Development \(hour\)/);
+  assert.match(lines[3], /50 × Printed flyer A4 \(each\)/);
+  assert.match(lines[4], /1 × Brand workshop \(day, VAT exempt\)/);
+});
+
+test('renderInvoiceText with unknown customer shows customer ID', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'C-999');
+});
+
+test('renderInvoiceText output is a single string', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.equal(typeof text, 'string');
+  assert.match(text, /\n/);
+});
+
+test('renderInvoiceText preserves invoice data', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+
+  const original = JSON.stringify(r.value);
+  renderInvoiceText(r.value);
+  assert.equal(JSON.stringify(r.value), original);
+});
