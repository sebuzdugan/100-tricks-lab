+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * All date operations use UTC, never the local time zone.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const regex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!regex.test(text)) return false;
+  const d = new Date(text + 'T00:00:00Z');
+  return d instanceof Date && !isNaN(d) && d.toISOString().startsWith(text);
+}
+
+/**
+ * Add days to a date (YYYY-MM-DD format). Result is in UTC.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - Date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().substring(0, 10);
+}
+
+/**
+ * Calculate the number of days between two dates (b minus a), in whole days.
+ * All calculations are in UTC.
+ * @param {string} a - Date in YYYY-MM-DD format
+ * @param {string} b - Date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const da = new Date(a + 'T00:00:00Z');
+  const db = new Date(b + 'T00:00:00Z');
+  const diffMs = db - da;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
