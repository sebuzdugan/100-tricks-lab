+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate a customer statement: list of outstanding invoices and total amount due.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate: string, status: string }>} invoices - All invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number?: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Normalize and validate customer
+  const normalizedId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Filter invoices: matching customer, issued/partially_paid status, issueDate on or before asOf
+  const customerInvoices = invoices
+    .filter(
+      (inv) =>
+        normalizeId(inv.customerId) === normalizedId &&
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.issueDate <= asOf
+    )
+    .map((inv) => {
+      const { total } = invoiceTotals(inv);
+      const due = balanceDue(inv);
+      return {
+        number: inv.number || 'DRAFT',
+        issueDate: inv.issueDate,
+        dueDate: inv.dueDate,
+        total,
+        due,
+      };
+    })
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = customerInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedId,
+    invoices: customerInvoices,
+    totalDue,
+  });
+}
