+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('statement lists issued invoices for a customer', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, []);
+
+  const stmt = statement('C-001', [r2.value, r4.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.customerId, 'C-001');
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-999', [r2.value], '2026-10-31');
+  assert.equal(stmt.ok, false);
+  assert.equal(stmt.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement filters by issued status', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  // Don't issue this one
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, []);
+
+  const stmt = statement('C-001', [r1.value, r4.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].issueDate, '2026-10-02');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const { total } = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: Math.floor(total / 2), date: '2026-10-15' });
+
+  const stmt = statement('C-001', [r3.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+});
+
+test('statement excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const stmt = statement('C-001', [r1.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const { total } = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: total, date: '2026-10-15' });
+
+  const stmt = statement('C-001', [r3.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 0);
+});
+
+test('statement filters by asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, []);
+
+  // Only invoices before Oct 10
+  const stmt = statement('C-001', [r2.value, r4.value], '2026-10-10');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, []);
+
+  const r5 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  const r6 = issueInvoice(r5.value, []);
+
+  // Pass in reverse order
+  const stmt = statement('C-001', [r2.value, r4.value, r6.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 3);
+  assert.equal(stmt.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(stmt.value.invoices[1].issueDate, '2026-10-10');
+  assert.equal(stmt.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement includes invoice details', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-001', [r2.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+
+  const inv = stmt.value.invoices[0];
+  assert.equal(inv.number, r2.value.number);
+  assert.equal(inv.issueDate, '2026-10-01');
+  assert.equal(inv.dueDate, r2.value.dueDate);
+  assert.equal(typeof inv.total, 'number');
+  assert.equal(typeof inv.due, 'number');
+});
+
+test('statement calculates due amounts correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const { total } = invoiceTotals(r2.value);
+
+  // Pay half
+  const r3 = recordPayment(r2.value, { amount: Math.floor(total / 2), date: '2026-10-15' });
+
+  const stmt = statement('C-001', [r3.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+
+  const inv = stmt.value.invoices[0];
+  assert.equal(inv.total, total);
+  assert.equal(inv.due, Math.ceil(total / 2));
+});
+
+test('statement calculates totalDue correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const r4 = issueInvoice(r3.value, []);
+
+  const stmt = statement('C-001', [r2.value, r4.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+
+  const expectedTotal = stmt.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(stmt.value.totalDue, expectedTotal);
+});
+
+test('statement normalizes customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  // Request with different case
+  const stmt = statement('c-001', [r2.value], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.customerId, 'C-001');
+  assert.equal(stmt.value.invoices.length, 1);
+});
+
+test('statement rejects invalid asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-001', [r2.value], '10-31-2026');
+  assert.equal(stmt.ok, false);
+  assert.equal(stmt.error, 'DATE_INVALID');
+});
+
+test('statement shows DRAFT for invoices without number', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  // Manually create an invoice without a number
+  const invoiceNoNumber = { ...r2.value, number: undefined };
+
+  const stmt = statement('C-001', [invoiceNoNumber], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices[0].number, 'DRAFT');
+});
+
+test('statement handles empty invoice list', () => {
+  const stmt = statement('C-001', [], '2026-10-31');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 0);
+  assert.equal(stmt.value.totalDue, 0);
+});
