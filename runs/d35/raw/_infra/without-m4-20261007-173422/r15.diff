+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+
+  const cn = createCreditNote(r2.value, { amount: 5000, reason: 'Discount applied', date: '2026-10-10' }, []);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.number, 'CN-2026-0001');
+  assert.equal(cn.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(cn.value.customerId, 'C-001');
+  assert.equal(cn.value.amount, 5000);
+  assert.equal(cn.value.reason, 'Discount applied');
+  assert.equal(cn.value.date, '2026-10-10');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const cn = createCreditNote(r.value, { amount: 5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(cn.ok, false);
+  assert.equal(cn.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote works with partially_paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const { total } = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: Math.floor(total / 2), date: '2026-10-08' });
+
+  const cn = createCreditNote(r3.value, { amount: 5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(cn.ok, true);
+});
+
+test('createCreditNote works with paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const { total } = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: total, date: '2026-10-08' });
+
+  const cn = createCreditNote(r3.value, { amount: 5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(cn.ok, true);
+});
+
+test('createCreditNote rejects invalid amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+
+  const cn1 = createCreditNote(r2.value, { amount: 0, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(cn1.ok, false);
+  assert.equal(cn1.error, 'AMOUNT_INVALID');
+
+  const cn2 = createCreditNote(r2.value, { amount: -5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(cn2.ok, false);
+  assert.equal(cn2.error, 'AMOUNT_INVALID');
+
+  const cn3 = createCreditNote(r2.value, { amount: 5000.5, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(cn3.ok, false);
+  assert.equal(cn3.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+
+  const cn = createCreditNote(r2.value, { amount: 5000, reason: 'Test', date: '10-10-2026' }, []);
+  assert.equal(cn.ok, false);
+  assert.equal(cn.error, 'DATE_INVALID');
+});
+
+test('createCreditNote rejects credit exceeding invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const { total } = invoiceTotals(r2.value);
+
+  const cn = createCreditNote(r2.value, { amount: total + 1, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(cn.ok, false);
+  assert.equal(cn.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const { total } = invoiceTotals(r2.value);
+
+  const cn = createCreditNote(r2.value, { amount: total, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.amount, total);
+});
+
+test('createCreditNote increments credit note counter', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const cn1 = createCreditNote(r2.value, { amount: 5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(cn1.ok, true);
+  assert.equal(cn1.value.number, 'CN-2026-0001');
+
+  const cn2 = createCreditNote(r2.value, { amount: 3000, reason: 'Test', date: '2026-10-11' }, [cn1.value.number]);
+  assert.equal(cn2.ok, true);
+  assert.equal(cn2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote keeps invoice and credit counters separate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  // Simulate existing invoice numbers
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+
+  const cn = createCreditNote(r2.value, { amount: 5000, reason: 'Test', date: '2026-10-10' }, existingNumbers);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote handles mixed invoice and credit numbers', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+
+  const existingNumbers = [
+    'INV-2026-0001',
+    'CN-2026-0001',
+    'INV-2026-0002',
+    'CN-2026-0002',
+    'CN-2026-0003',
+  ];
+
+  const cn = createCreditNote(r2.value, { amount: 5000, reason: 'Test', date: '2026-10-10' }, existingNumbers);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.number, 'CN-2026-0004');
+});
+
+test('createCreditNote resets counter per year', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+
+  const existingNumbers = ['CN-2026-0001', 'CN-2026-0002'];
+
+  // Create credit note in new year
+  const cn = createCreditNote(r2.value, { amount: 5000, reason: 'Test', date: '2027-01-10' }, existingNumbers);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote shows DRAFT for invoices without number', () => {
+  const invoice = {
+    status: 'issued',
+    customerId: 'C-001',
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const cn = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.invoiceNumber, 'DRAFT');
+});
+
+test('createCreditNote includes reason', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+
+  const reason = 'Customer complaint - wrong qty shipped';
+  const cn = createCreditNote(r2.value, { amount: 5000, reason, date: '2026-10-10' }, []);
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.reason, reason);
+});
+
+test('createCreditNote is immutable', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+
+  const original = JSON.stringify(r2.value);
+  createCreditNote(r2.value, { amount: 5000, reason: 'Test', date: '2026-10-10' }, []);
+  assert.equal(JSON.stringify(r2.value), original);
+});
