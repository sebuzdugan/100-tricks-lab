+import { ok, fail } from './result.js';
+import { isValidDate } from './dates.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next credit note number for a given year.
+ * Format: CN-<year>-<counter>, with separate counters for credits.
+ * @param {string[]} existingNumbers - Array of all numbers (invoices and credits)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - The next credit note number
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  // Filter numbers from the same year and extract their counters
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((c) => Number.isInteger(c) && c > 0);
+
+  // Find the maximum counter, or 0 if none exist
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number?: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} credit
+ * @param {string[]} existingNumbers - Array of all invoice and credit numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice status
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check credit amount doesn't exceed invoice total
+  const { total } = invoiceTotals(invoice);
+  if (amount > total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Get next credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number || 'DRAFT',
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
