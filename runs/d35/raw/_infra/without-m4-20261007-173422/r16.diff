+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  // r2 due Sep 4, r4 due Oct 15, check as of Oct 25
+  const report = overdueInvoices([r4.value, r2.value], '2026-10-25');
+  assert.equal(report.ok, true);
+  assert.equal(report.value.length, 2);
+  // First should be r2 (21 days overdue), then r4 (10 days overdue)
+  assert.equal(report.value[0].daysOverdue, 21);
+  assert.equal(report.value[1].daysOverdue, 10);
+});
+
+test('overdueInvoices calculates due amounts', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const { total } = invoiceTotals(r2.value);
+
+  const report = overdueInvoices([r2.value], '2026-10-20');
+  assert.equal(report.ok, true);
+  assert.equal(report.value[0].due, total);
+});
+
+test('overdueInvoices calculates due amounts for partially paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const { total } = invoiceTotals(r2.value);
+  const paid = Math.floor(total / 2);
+  const r3 = recordPayment(r2.value, { amount: paid, date: '2026-10-15' });
+
+  const report = overdueInvoices([r3.value], '2026-10-20');
+  assert.equal(report.ok, true);
+  assert.equal(report.value[0].due, total - paid);
+});
+
+test('overdueInvoices shows DRAFT for invoices without number', () => {
+  const invoice = {
+    status: 'issued',
+    customerId: 'C-001',
+    dueDate: '2026-10-15',
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const report = overdueInvoices([invoice], '2026-10-20');
+  assert.equal(report.ok, true);
+  assert.equal(report.value[0].number, 'DRAFT');
+});
+
+test('overdueInvoices rejects invalid asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const report = overdueInvoices([r2.value], '10-20-2026');
+  assert.equal(report.ok, false);
+  assert.equal(report.error, 'DATE_INVALID');
+});
+
+test('overdueInvoices handles empty invoice list', () => {
+  const report = overdueInvoices([], '2026-10-20');
+  assert.equal(report.ok, true);
+  assert.equal(report.value.length, 0);
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
