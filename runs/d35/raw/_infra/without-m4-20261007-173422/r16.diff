+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('overdueInvoices finds overdue invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  // Check as of Oct 20 (due date is Oct 15, so overdue)
+  const report = overdueInvoices([r2.value], '2026-10-20');
+  assert.equal(report.ok, true);
+  assert.equal(report.value.length, 1);
+  assert.equal(report.value[0].number, r2.value.number);
+  assert.equal(report.value[0].customerId, 'C-001');
+  assert.equal(report.value[0].dueDate, '2026-10-15');
+  assert.equal(report.value[0].daysOverdue, 5);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  // Due Oct 15, check as of Oct 25 (10 days overdue)
+  const report = overdueInvoices([r2.value], '2026-10-25');
+  assert.equal(report.ok, true);
+  assert.equal(report.value[0].daysOverdue, 10);
+});
+
+test('overdueInvoices excludes not-yet-due invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  // Check as of Oct 14 (due date is Oct 15, not overdue yet)
+  const report = overdueInvoices([r2.value], '2026-10-14');
+  assert.equal(report.ok, true);
+  assert.equal(report.value.length, 0);
+});
+
+test('overdueInvoices excludes invoices due on asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  // Check as of due date (Oct 15, not overdue)
+  const report = overdueInvoices([r2.value], '2026-10-15');
+  assert.equal(report.ok, true);
+  assert.equal(report.value.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const report = overdueInvoices([r1.value], '2026-10-20');
+  assert.equal(report.ok, true);
+  assert.equal(report.value.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const { total } = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: total, date: '2026-10-15' });
+
+  const report = overdueInvoices([r3.value], '2026-10-20');
+  assert.equal(report.ok, true);
+  assert.equal(report.value.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
