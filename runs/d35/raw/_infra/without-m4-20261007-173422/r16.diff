+import { isValidDate, daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+import { fail } from './result.js';
+
+/**
+ * Get invoices that are overdue as of a given date.
+ * @param {Array<{ number?: string, status: string, dueDate: string, customerId: string }>} invoices - All invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }> } | { ok: false, error: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Filter to issued/partially_paid invoices with dueDate before asOf, calculate daysOverdue
+  const overdue = invoices
+    .filter(
+      (inv) =>
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.dueDate < asOf
+    )
+    .map((inv) => ({
+      number: inv.number || 'DRAFT',
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return { ok: true, value: overdue };
+}
