+
+test('overdueInvoices with various due dates', () => {
+  // Create invoices with different due dates
+  const inv1 = { status: 'issued', customerId: 'C-001', dueDate: '2026-10-01', number: 'INV-1', lines: [{ qty: 1, unitPrice: 1000, vatRate: 0, discountPercent: 0 }] };
+  const inv2 = { status: 'issued', customerId: 'C-002', dueDate: '2026-10-10', number: 'INV-2', lines: [{ qty: 1, unitPrice: 1000, vatRate: 0, discountPercent: 0 }] };
+  const inv3 = { status: 'issued', customerId: 'C-003', dueDate: '2026-10-20', number: 'INV-3', lines: [{ qty: 1, unitPrice: 1000, vatRate: 0, discountPercent: 0 }] };
+  const inv4 = { status: 'issued', customerId: 'C-004', dueDate: '2026-10-26', number: 'INV-4', lines: [{ qty: 1, unitPrice: 1000, vatRate: 0, discountPercent: 0 }] };
+
+  // Check as of Oct 25: inv1 (24 days), inv2 (15 days), inv3 (5 days) are overdue, inv4 is not
+  const report = overdueInvoices([inv1, inv2, inv3, inv4], '2026-10-25');
+  assert.equal(report.ok, true);
+  assert.equal(report.value.length, 3);
+  // Sorted by daysOverdue descending
+  assert.equal(report.value[0].daysOverdue, 24);
+  assert.equal(report.value[1].daysOverdue, 15);
+  assert.equal(report.value[2].daysOverdue, 5);
+  assert.equal(report.value[0].number, 'INV-1');
+  assert.equal(report.value[1].number, 'INV-2');
+  assert.equal(report.value[2].number, 'INV-3');
+});
