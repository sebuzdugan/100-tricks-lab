+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate that issueDate is in YYYY-MM-DD format and is a real date.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  if (!m) return false;
+  const [, year, month, day] = m;
+  try {
+    const d = new Date(`${year}-${month}-${day}T00:00:00Z`);
+    return d.toISOString().startsWith(dateStr);
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Create an invoice from a customer id, issue date, and line items.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} input
+ * @returns {import('./result.js').Result<{ customerId: string, issueDate: string, status: 'draft', lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }>}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  const invoiceLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const { name, unitPrice, vatRate } = productResult.value;
+    invoiceLines.push({
+      sku: line.sku,
+      name,
+      qty: line.qty,
+      unitPrice,
+      vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
