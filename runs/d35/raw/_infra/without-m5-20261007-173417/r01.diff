@@ -0,0 +1,175 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with valid data', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  };
+  const r = createInvoice(input);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2024-03-15');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].qty, 2);
+  assert.ok(r.value.lines[0].name);
+  assert.ok(typeof r.value.lines[0].unitPrice === 'number');
+  assert.ok(typeof r.value.lines[0].vatRate === 'number');
+});
+
+test('createInvoice expands catalogue data for each line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  const line = r.value.lines[0];
+  assert.equal(line.name, 'Design work (hour)');
+  assert.equal(line.unitPrice, 8500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].qty, 2);
+  assert.equal(r.value.lines[1].sku, 'DEV-HOUR');
+  assert.equal(r.value.lines[1].qty, 3);
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'WIDGET-A', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for bad format', () => {
+  const tests = ['2024/03/15', '03-15-2024', '2024-3-15', '2024-13-01', 'not a date', ''];
+  for (const date of tests) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(r.ok, false, `should reject: ${date}`);
+    assert.equal(r.error, 'DATE_INVALID', `should reject: ${date}`);
+  }
+});
+
+test('createInvoice reports DATE_INVALID for impossible dates', () => {
+  const tests = ['2024-02-30', '2024-04-31', '2000-13-01'];
+  for (const date of tests) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(r.ok, false, `should reject impossible date: ${date}`);
+    assert.equal(r.error, 'DATE_INVALID', `should reject impossible date: ${date}`);
+  }
+});
+
+test('createInvoice accepts valid dates at boundaries', () => {
+  const tests = ['2024-01-01', '2024-12-31', '2000-02-29'];
+  for (const date of tests) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(r.ok, true, `should accept valid date: ${date}`);
+    assert.equal(r.value.issueDate, date);
+  }
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports NO_LINES for missing lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer qty', () => {
+  const tests = [1.5, -1, 0, -0.5, 'not a number', null, undefined, true, false];
+  for (const qty of tests) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-03-15',
+      lines: [{ sku: 'WIDGET-A', qty }],
+    });
+    assert.equal(r.ok, false, `should reject qty: ${qty}`);
+    assert.equal(r.error, 'QTY_INVALID', `should reject qty: ${qty}`);
+  }
+});
+
+test('createInvoice accepts positive integer qty', () => {
+  const tests = [1, 2, 100, 999999];
+  for (const qty of tests) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-03-15',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    });
+    assert.equal(r.ok, true, `should accept qty: ${qty}`);
+    assert.equal(r.value.lines[0].qty, qty);
+  }
+});
+
+test('createInvoice reports UNKNOWN_SKU for missing SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'MISSING-SKU', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'WIDGET-A', qty: 2 }],
+  };
+  const inputCopy = JSON.parse(JSON.stringify(input));
+  createInvoice(input);
+  assert.deepEqual(input, inputCopy);
+});
+
+test('createInvoice returns new objects, not references to input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 2 }];
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines,
+  });
+  assert.ok(r.ok);
+  assert.notEqual(r.value.lines, lines);
+  assert.notEqual(r.value.lines[0], lines[0]);
+});
