@@ -57,3 +58,38 @@ export function createInvoice({ customerId, issueDate, lines }) {
     lines: invoiceLines,
   });
 }
+
+/**
+ * Calculate the total amount for a single line (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {import('./result.js').Result<number>}
+ */
+export function lineTotal(line) {
+  if (!line || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number') {
+    return fail('LINE_INVALID');
+  }
+  return ok(roundCents(line.qty * line.unitPrice));
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number }> }} invoice
+ * @returns {import('./result.js').Result<{ subtotal: number, total: number }>}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines) || invoice.lines.length === 0) {
+    return fail('INVOICE_INVALID');
+  }
+
+  let subtotal = 0;
+  for (const line of invoice.lines) {
+    const result = lineTotal(line);
+    if (!result.ok) return result;
+    subtotal += result.value;
+  }
+
+  return ok({
+    subtotal: roundCents(subtotal),
+    total: roundCents(subtotal),
+  });
+}
