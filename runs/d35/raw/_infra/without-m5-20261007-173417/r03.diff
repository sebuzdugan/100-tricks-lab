+/**
+ * Add a line to an invoice, or increase qty if the SKU already exists.
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {{ sku: string, qty: number }} input
+ * @returns {import('./result.js').Result<{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }>}
+ */
+export function addLine(invoice, { sku, qty }) {
+  if (!invoice || invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const { name, unitPrice, vatRate } = productResult.value;
+
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+  const existingIndex = newLines.findIndex((line) => line.sku === sku);
+
+  if (existingIndex >= 0) {
+    newLines[existingIndex].qty += qty;
+  } else {
+    newLines.push({
+      sku,
+      name,
+      qty,
+      unitPrice,
+      vatRate,
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {string} sku
+ * @returns {import('./result.js').Result<{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }>}
+ */
+export function removeLine(invoice, sku) {
+  if (!invoice || invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex < 0) return fail('LINE_NOT_FOUND');
+
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  const newLines = invoice.lines.filter((_, index) => index !== lineIndex);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
