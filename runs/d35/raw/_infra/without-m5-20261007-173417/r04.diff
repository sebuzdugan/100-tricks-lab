+/**
+ * Issue an invoice, assigning it a number and changing status to 'issued'.
+ * @param {{ status: string, issueDate: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {Array<string>} existingNumbers
+ * @returns {import('./result.js').Result<{ status: string, number: string, issueDate: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }>}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  if (!invoice || invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const numberResult = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+  if (!numberResult.ok) return numberResult;
+
+  return ok({
+    ...invoice,
+    number: numberResult.value,
+    status: 'issued',
+  });
+}
diff --git a/src/numbering.js b/src/numbering.js
new file mode 100644
index 0000000..2240766
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,55 @@
+import { ok, fail } from './result.js';
+
+/**
+ * Parse an invoice number to extract year and counter.
+ * @param {string} number
+ * @returns {{ year: number, counter: number } | null}
+ */
+function parseInvoiceNumber(number) {
+  const m = /^INV-(\d{4})-(\d{4})$/.exec(number);
+  if (!m) return null;
+  return {
+    year: Number(m[1]),
+    counter: Number(m[2]),
+  };
+}
+
+/**
+ * Extract the year from an issueDate.
+ * @param {string} dateStr
+ * @returns {number | null}
+ */
+function extractYear(dateStr) {
+  if (typeof dateStr !== 'string') return null;
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
+  return m ? Number(m[1]) : null;
+}
+
+/**
+ * Get the next free invoice number for a given year.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate
+ * @returns {import('./result.js').Result<string>}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = extractYear(issueDate);
+  if (year === null) return fail('DATE_INVALID');
+
+  if (!Array.isArray(existingNumbers)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  let maxCounter = 0;
+  for (const number of existingNumbers) {
+    const parsed = parseInvoiceNumber(number);
+    if (parsed && parsed.year === year) {
+      maxCounter = Math.max(maxCounter, parsed.counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  if (nextCounter > 9999) return fail('AMOUNT_INVALID');
+
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return ok(`INV-${year}-${paddedCounter}`);
+}
