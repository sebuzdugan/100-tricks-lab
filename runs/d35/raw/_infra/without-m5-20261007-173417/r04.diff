+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = issueInvoice(invoiceResult.value, []);
+  assert.ok(r.ok);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2024-03-15');
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[1].sku, 'DEV-HOUR');
+});
+
+test('issueInvoice does not mutate original invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const original = invoiceResult.value;
+  issueInvoice(original, []);
+  assert.equal(original.status, 'draft');
+  assert.ok(!original.number);
+});
diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..38feaeb
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for first invoice of a year', () => {
+  const r = nextInvoiceNumber([], '2024-03-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber returns next counter for same year', () => {
+  const r = nextInvoiceNumber(['INV-2024-0001'], '2024-06-20');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber finds max counter among multiple numbers', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0003', 'INV-2024-0002'];
+  const r = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from different years', () => {
+  const existing = ['INV-2023-0099', 'INV-2024-0005', 'INV-2025-0001'];
+  const r = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const existing = ['INV-2023-9999', 'INV-2023-0001'];
+  const r = nextInvoiceNumber(existing, '2024-01-01');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003', 'INV-2024-0004', 'INV-2024-0005', 'INV-2024-0006', 'INV-2024-0007', 'INV-2024-0008', 'INV-2024-0009'];
+  const r = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2024-0010');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = Array.from({ length: 9998 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const r = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2024-9999');
+});
+
+test('nextInvoiceNumber reports error when counter exceeds 9999', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const r = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('nextInvoiceNumber reports DATE_INVALID for bad date format', () => {
+  const tests = ['2024/03/15', '03-15-2024', '2024-3-15', 'not a date', ''];
+  for (const date of tests) {
+    const r = nextInvoiceNumber([], date);
+    assert.equal(r.ok, false, `should reject date: ${date}`);
+    assert.equal(r.error, 'DATE_INVALID');
+  }
+});
+
+test('nextInvoiceNumber ignores malformed existing numbers', () => {
+  const existing = ['INV-2024-0001', 'invalid', 'INV-2024-0002', 'INV-999-0001'];
+  const r = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber works with empty existing numbers array', () => {
+  const r = nextInvoiceNumber([], '2024-01-01');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber works with null existingNumbers treated as error', () => {
+  const r = nextInvoiceNumber(null, '2024-06-15');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
