+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {import('./result.js').Result<string>}
+ */
+export function renderInvoiceText(invoice) {
+  if (!invoice) return fail('INVOICE_INVALID');
+
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+  const customer = customerResult.value;
+
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+  const { total } = totalsResult.value;
+
+  const lines = [];
+  lines.push(invoice.number || 'DRAFT');
+  lines.push(customer.name);
+
+  for (const line of invoice.lines) {
+    const lineTotalResult = lineTotal(line);
+    if (!lineTotalResult.ok) return lineTotalResult;
+    const lineAmount = lineTotalResult.value;
+
+    const text = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lineAmount)}`;
+    lines.push(text);
+  }
+
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return ok(lines.join('\n'));
+}
diff --git a/test/render.test.js b/test/render.test.js
