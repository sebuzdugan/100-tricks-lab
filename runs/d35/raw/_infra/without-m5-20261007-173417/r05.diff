+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.ok(r.ok);
+  const text = r.value;
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /2 × Design work \(hour\)/);
+  assert.match(text, /€85\.00/);
+  assert.match(text, /€170\.00/);
+  assert.match(text, /Total: €170\.00/);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const r = renderInvoiceText(issueResult.value);
+  assert.ok(r.ok);
+  const text = r.value;
+  assert.match(text, /^INV-2024-0001\n/);
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText shows multiple lines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 1 },
+    ],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.ok(r.ok);
+  const text = r.value;
+  const lines = text.split('\n');
+  assert.equal(lines.length, 6);
+  assert.match(lines[2], /2 × Design work \(hour\)/);
+  assert.match(lines[3], /3 × Development \(hour\)/);
+  assert.match(lines[4], /1 × Copywriting \(hour\)/);
+  assert.match(lines[5], /Total:/);
+});
+
+test('renderInvoiceText formats prices correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.ok(r.ok);
+  const text = r.value;
+  assert.match(text, /€1,200\.00/);
+  assert.match(text, /Total: €1,200\.00/);
+});
+
+test('renderInvoiceText uses correct customer name', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.ok(r.ok);
+  const text = r.value;
+  assert.match(text, /Kite & Co/);
+});
+
+test('renderInvoiceText reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2024-03-15',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+  const r = renderInvoiceText(invoice);
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('renderInvoiceText reports INVOICE_INVALID for null invoice', () => {
+  const r = renderInvoiceText(null);
+  assert.deepEqual(r, { ok: false, error: 'INVOICE_INVALID' });
+});
+
+test('renderInvoiceText reports INVOICE_INVALID for undefined invoice', () => {
+  const r = renderInvoiceText(undefined);
+  assert.deepEqual(r, { ok: false, error: 'INVOICE_INVALID' });
+});
+
+test('renderInvoiceText returns string with newlines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.ok(r.ok);
+  assert.equal(typeof r.value, 'string');
+  const lines = r.value.split('\n');
+  assert.ok(lines.length >= 4);
+});
+
+test('renderInvoiceText shows invoice number in first line', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const r = renderInvoiceText(issueResult.value);
+  assert.ok(r.ok);
+  const firstLine = r.value.split('\n')[0];
+  assert.equal(firstLine, 'INV-2025-0001');
+});
+
+test('renderInvoiceText shows DRAFT for draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.ok(r.ok);
+  const firstLine = r.value.split('\n')[0];
+  assert.equal(firstLine, 'DRAFT');
+});
+
+test('renderInvoiceText calculates line totals correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.ok(r.ok);
+  const text = r.value;
+  assert.match(text, /= €425\.00/);
+  assert.match(text, /Total: €425\.00/);
+});
+
+test('renderInvoiceText handles products with different unit prices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'STICKER', qty: 100 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.ok(r.ok);
+  const text = r.value;
+  assert.match(text, /100 × Sticker sheet @ €0\.50/);
+  assert.match(text, /1 × Logo package @ €1,200\.00/);
+});
+
+test('renderInvoiceText invoice is in correct order', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = renderInvoiceText(invoiceResult.value);
+  assert.ok(r.ok);
+  const lines = r.value.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.match(lines[2], /Design work/);
+  assert.match(lines[3], /Development/);
+  assert.match(lines[4], /Total:/);
+});
