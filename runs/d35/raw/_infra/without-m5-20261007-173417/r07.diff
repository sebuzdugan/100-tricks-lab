+  });
+  assert.ok(r.ok);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount (2.5%) when no discountPercent given', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(r.ok);
+  assert.equal(r.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice does not set discountPercent for standard tier (0%)', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(r.ok);
+  assert.ok(!r.value.lines[0].discountPercent);
+});
+
+test('createInvoice explicit discountPercent overrides tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 15 }],
+  });
+  assert.ok(r.ok);
+  assert.equal(r.value.lines[0].discountPercent, 15);
+});
+
+test('createInvoice explicit zero discount overrides tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.ok(r.ok);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice applies tier discount to multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 2 },
+    ],
+  });
+  assert.ok(r.ok);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+  assert.equal(r.value.lines[1].discountPercent, 5);
+});
+
+test('createInvoice tier discount applies only to lines without explicit discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 2, discountPercent: 10 },
+      { sku: 'COPY-HOUR', qty: 3, discountPercent: 0 },
+    ],
+  });
+  assert.ok(r.ok);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+  assert.equal(r.value.lines[1].discountPercent, 10);
+  assert.equal(r.value.lines[2].discountPercent, 0);
+});
