+/**
+ * Calculate the VAT amount for a single line.
+ * VAT is calculated on the line total after discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {import('./result.js').Result<number>}
+ */
+export function lineVat(line) {
+  if (!line || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number' || typeof line.vatRate !== 'number') {
+    return fail('LINE_INVALID');
+  }
+
+  const totalResult = lineTotal(line);
+  if (!totalResult.ok) return totalResult;
+
+  const discountResult = lineDiscount(line);
+  if (!discountResult.ok) return discountResult;
+
+  const amountAfterDiscount = Math.max(0, totalResult.value - discountResult.value);
+  const vat = roundCents((amountAfterDiscount * line.vatRate) / 100);
+  return ok(Math.max(0, vat));
+}
+
