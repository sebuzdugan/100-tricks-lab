+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId(' C-001 '), 'C-001');
+  assert.equal(normalizeId('\t C-003 \n'), 'C-003');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-007'), 'C-007');
+});
+
+test('normalizeId handles mixed case and spaces', () => {
+  assert.equal(normalizeId(' c-001 '), 'C-001');
+  assert.equal(normalizeId('c-007 '), 'C-007');
+});
+
+test('getCustomer finds customer by normalized id', () => {
+  const r1 = getCustomer('C-003');
+  const r2 = getCustomer('c-003');
+  const r3 = getCustomer(' c-003 ');
+  assert.deepEqual(r1.value, r2.value);
+  assert.deepEqual(r2.value, r3.value);
+  assert.equal(r1.value.name, 'Kite & Co');
+});
+
+test('getCustomer with various normalized ids', () => {
+  const tests = [
+    ['C-001', 'Northwind Studio'],
+    ['c-001', 'Northwind Studio'],
+    [' C-001 ', 'Northwind Studio'],
+    ['c-002', 'Blue Fern Bakery'],
+    [' c-002 ', 'Blue Fern Bakery'],
+  ];
+  for (const [id, expectedName] of tests) {
+    const r = getCustomer(id);
+    assert.equal(r.ok, true, `should find customer for: ${id}`);
+    assert.equal(r.value.name, expectedName);
+  }
+});
