--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,149 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate validates correct dates', () => {
+  const valid = [
+    '2024-01-01',
+    '2024-12-31',
+    '2000-02-29',
+    '1999-03-15',
+    '2025-06-30',
+  ];
+  for (const date of valid) {
+    assert.ok(isValidDate(date), `should accept: ${date}`);
+  }
+});
+
+test('isValidDate rejects bad format', () => {
+  const invalid = [
+    '2024/01/01',
+    '01-01-2024',
+    '2024-1-1',
+    '2024-13-01',
+    '2024-02-30',
+    '2024-04-31',
+    'not a date',
+    '',
+    '2024-01',
+    '2024',
+  ];
+  for (const date of invalid) {
+    assert.ok(!isValidDate(date), `should reject: ${date}`);
+  }
+});
+
+test('isValidDate rejects non-string input', () => {
+  const invalid = [null, undefined, 123, true, {}];
+  for (const val of invalid) {
+    assert.ok(!isValidDate(val), `should reject: ${val}`);
+  }
+});
+
+test('isValidDate rejects impossible dates', () => {
+  const invalid = [
+    '2024-02-30',
+    '2024-04-31',
+    '2000-13-01',
+    '1999-00-01',
+  ];
+  for (const date of invalid) {
+    assert.ok(!isValidDate(date), `should reject impossible date: ${date}`);
+  }
+});
+
+test('isValidDate accepts leap year Feb 29', () => {
+  assert.ok(isValidDate('2024-02-29'));
+  assert.ok(isValidDate('2020-02-29'));
+  assert.ok(isValidDate('2000-02-29'));
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.ok(!isValidDate('2023-02-29'));
+  assert.ok(!isValidDate('1900-02-29'));
+  assert.ok(!isValidDate('2001-02-29'));
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2024-01-01', 1), '2024-01-02');
+  assert.equal(addDays('2024-01-01', 10), '2024-01-11');
+  assert.equal(addDays('2024-01-25', 10), '2024-02-04');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2024-01-31', 1), '2024-02-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+  assert.equal(addDays('2024-12-25', 10), '2025-01-04');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2024-02-01', -1), '2024-01-31');
+  assert.equal(addDays('2024-03-01', -10), '2024-02-20');
+});
+
+test('addDays handles zero', () => {
+  assert.equal(addDays('2024-06-15', 0), '2024-06-15');
+});
+
+test('addDays handles large numbers', () => {
+  assert.equal(addDays('2024-01-01', 365), '2024-12-31');
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01');
+});
+
+test('daysBetween calculates forward difference', () => {
+  assert.equal(daysBetween('2024-01-01', '2024-01-02'), 1);
+  assert.equal(daysBetween('2024-01-01', '2024-01-11'), 10);
+  assert.equal(daysBetween('2024-01-01', '2024-02-01'), 31);
+});
+
+test('daysBetween calculates backward difference (negative)', () => {
+  assert.equal(daysBetween('2024-01-02', '2024-01-01'), -1);
+  assert.equal(daysBetween('2024-02-01', '2024-01-01'), -31);
+});
+
+test('daysBetween same date returns zero', () => {
+  assert.equal(daysBetween('2024-01-01', '2024-01-01'), 0);
+  assert.equal(daysBetween('2024-06-15', '2024-06-15'), 0);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2023-12-31', '2024-12-31'), 366);
+});
+
+test('daysBetween handles leap years correctly', () => {
+  assert.equal(daysBetween('2024-01-01', '2024-02-29'), 59);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('daysBetween uses UTC (not affected by timezone)', () => {
+  const a = '2024-01-15';
+  const b = '2024-01-20';
+  const result = daysBetween(a, b);
+  assert.equal(result, 5);
+  assert.equal(result, daysBetween(a, b));
+});
+
+test('daysBetween calculates whole days only', () => {
+  assert.equal(daysBetween('2024-01-01', '2024-01-02'), 1);
+  assert.equal(daysBetween('2024-01-01', '2024-01-03'), 2);
+});
+
+test('addDays and daysBetween are inverse operations', () => {
+  const start = '2024-06-15';
+  const days = 42;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+  assert.equal(addDays(end, -days), start);
+});
+
+test('date string roundtrip through addDays', () => {
+  const date = '2024-03-15';
+  assert.equal(addDays(date, 0), date);
+  assert.equal(addDays(addDays(date, 10), -10), date);
+});
