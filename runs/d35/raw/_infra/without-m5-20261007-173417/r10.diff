+/**
+ * Validate that a date string is in YYYY-MM-DD format and represents a real date.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(text);
+  if (!m) return false;
+  const [, year, month, day] = m;
+  try {
+    const d = new Date(`${year}-${month}-${day}T00:00:00Z`);
+    return d.toISOString().startsWith(text);
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Add n days to a date. All arithmetic is in UTC.
+ * @param {string} date YYYY-MM-DD format
+ * @param {number} n number of days to add
+ * @returns {string} YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(`${date}T00:00:00Z`);
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of days between two dates (b - a), in whole days, using UTC.
+ * @param {string} a YYYY-MM-DD format
+ * @param {string} b YYYY-MM-DD format
+ * @returns {number} whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(`${a}T00:00:00Z`);
+  const dateB = new Date(`${b}T00:00:00Z`);
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB.getTime() - dateA.getTime()) / msPerDay);
+}
