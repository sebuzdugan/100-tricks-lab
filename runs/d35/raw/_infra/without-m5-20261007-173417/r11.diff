+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue returns total for unpaid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const invoice = invoiceResult.value;
+  const due = balanceDue(invoice);
+  assert.equal(due, 102850);
+});
+
+test('balanceDue with no payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const due = balanceDue(invoiceResult.value);
+  assert.ok(due > 0);
+});
+
+test('recordPayment adds payment to issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const r = recordPayment(issueResult.value, { amount: 50000, date: '2024-03-20' });
+  assert.ok(r.ok);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 50000);
+  assert.equal(r.value.payments[0].date, '2024-03-20');
+});
+
+test('recordPayment changes status to partially_paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const r = recordPayment(issueResult.value, { amount: 100000, date: '2024-03-20' });
+  assert.ok(r.ok);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment changes status to paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const total = 6050;
+  const r = recordPayment(issueResult.value, { amount: total, date: '2024-03-20' });
+  assert.ok(r.ok);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment accumulates multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  let invoice = issueResult.value;
+  const r1 = recordPayment(invoice, { amount: 50000, date: '2024-03-20' });
+  assert.ok(r1.ok);
+  assert.equal(r1.value.payments.length, 1);
+  invoice = r1.value;
+  const r2 = recordPayment(invoice, { amount: 52850, date: '2024-03-25' });
+  assert.ok(r2.ok);
+  assert.equal(r2.value.payments.length, 2);
+  assert.equal(r2.value.payments[0].amount, 50000);
+  assert.equal(r2.value.payments[1].amount, 52850);
+});
+
+test('recordPayment reports NOT_ISSUED for draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const r = recordPayment(invoiceResult.value, { amount: 50000, date: '2024-03-20' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_ISSUED');
+});
+
+test('recordPayment reports NOT_ISSUED for paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const payResult = recordPayment(issueResult.value, { amount: 6050, date: '2024-03-20' });
+  assert.ok(payResult.ok);
+  const r = recordPayment(payResult.value, { amount: 1000, date: '2024-03-25' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'NOT_ISSUED');
+});
+
+test('recordPayment reports AMOUNT_INVALID for zero amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const r = recordPayment(issueResult.value, { amount: 0, date: '2024-03-20' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment reports AMOUNT_INVALID for negative amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const r = recordPayment(issueResult.value, { amount: -1000, date: '2024-03-20' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment reports AMOUNT_INVALID for non-integer amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const tests = [100.5, '100', true, null];
+  for (const amount of tests) {
+    const r = recordPayment(issueResult.value, { amount, date: '2024-03-20' });
+    assert.equal(r.ok, false, `should reject amount: ${amount}`);
+    assert.equal(r.error, 'AMOUNT_INVALID');
+  }
+});
+
+test('recordPayment reports DATE_INVALID for bad date', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const tests = ['2024/03/20', '03-20-2024', 'not a date'];
+  for (const date of tests) {
+    const r = recordPayment(issueResult.value, { amount: 50000, date });
+    assert.equal(r.ok, false, `should reject date: ${date}`);
+    assert.equal(r.error, 'DATE_INVALID');
+  }
+});
+
+test('recordPayment reports OVERPAYMENT', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const total = 6050;
+  const r = recordPayment(issueResult.value, { amount: total + 1, date: '2024-03-20' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'OVERPAYMENT');
+});
+
+test('recordPayment reports OVERPAYMENT on partial payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const r1 = recordPayment(issueResult.value, { amount: 50000, date: '2024-03-20' });
+  assert.ok(r1.ok);
+  const balance = balanceDue(r1.value);
+  const r2 = recordPayment(r1.value, { amount: balance + 1, date: '2024-03-25' });
+  assert.equal(r2.ok, false);
+  assert.equal(r2.error, 'OVERPAYMENT');
+});
+
+test('recordPayment allows payment of exact balance', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const r1 = recordPayment(issueResult.value, { amount: 50000, date: '2024-03-20' });
+  assert.ok(r1.ok);
+  const balance = balanceDue(r1.value);
+  const r2 = recordPayment(r1.value, { amount: balance, date: '2024-03-25' });
+  assert.ok(r2.ok);
+  assert.equal(r2.value.status, 'paid');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const original = issueResult.value;
+  const originalPayments = original.payments;
+  recordPayment(original, { amount: 50000, date: '2024-03-20' });
+  assert.equal(original.payments, originalPayments);
+  assert.equal(original.status, 'issued');
+});
+
+test('balanceDue returns zero for paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const payResult = recordPayment(issueResult.value, { amount: 6050, date: '2024-03-20' });
+  assert.ok(payResult.ok);
+  const due = balanceDue(payResult.value);
+  assert.equal(due, 0);
+});
+
+test('balanceDue with multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  let invoice = issueResult.value;
+  const r1 = recordPayment(invoice, { amount: 30000, date: '2024-03-20' });
+  assert.ok(r1.ok);
+  invoice = r1.value;
+  const r2 = recordPayment(invoice, { amount: 50000, date: '2024-03-25' });
+  assert.ok(r2.ok);
+  const due = balanceDue(r2.value);
+  const expectedTotal = balanceDue(issueResult.value);
+  assert.equal(due, expectedTotal - 80000);
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  assert.ok(issueResult.ok);
+  const r1 = recordPayment(issueResult.value, { amount: 50000, date: '2024-03-20' });
+  assert.ok(r1.ok);
+  assert.equal(r1.value.status, 'partially_paid');
+  const r2 = recordPayment(r1.value, { amount: 30000, date: '2024-03-25' });
+  assert.ok(r2.ok);
+  assert.equal(r2.value.status, 'partially_paid');
+});
