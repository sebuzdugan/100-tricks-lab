+  assert.equal(r.value.voucher.amount, 10000);
+});
+
+test('applyVoucher reduces total by voucher amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  assert.ok(invoiceResult.ok);
+  const totalWithoutVoucher = invoiceTotals(invoiceResult.value).value.total;
+  const voucherResult = applyVoucher(invoiceResult.value, { code: 'SAVE10', amount: 1000 });
+  assert.ok(voucherResult.ok);
+  const totalWithVoucher = invoiceTotals(voucherResult.value).value.total;
+  assert.equal(totalWithVoucher, totalWithoutVoucher - 1000);
+});
