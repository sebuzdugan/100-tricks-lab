+/**
+ * Apply a voucher to an invoice.
+ * @param {{ status: string, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {import('./result.js').Result<{ status: string, voucher: { code: string, amount: number } }>}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  if (!invoice || invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
