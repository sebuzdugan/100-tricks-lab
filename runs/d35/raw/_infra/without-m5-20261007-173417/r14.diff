+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { statement } from '../src/statements.js';
+
+// Helper to create and issue an invoice
+function createIssuedInvoice(customerId, issueDate, lines) {
+  const invoiceResult = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+  });
+  if (!invoiceResult.ok) return null;
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  if (!issueResult.ok) return null;
+  const issued = issueResult.value;
+  const totalsResult = invoiceTotals(issued);
+  if (!totalsResult.ok) return null;
+  return { ...issued, total: totalsResult.value.total };
+}
+
+test('statement filters invoices by customer', () => {
+  const inv1 = createIssuedInvoice('C-001', '2024-03-15', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const inv2 = createIssuedInvoice('C-002', '2024-03-20', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const inv3 = createIssuedInvoice('C-001', '2024-03-25', [{ sku: 'DES-HOUR', qty: 1 }]);
+
+  const r = statement('C-001', [inv1, inv2, inv3], '2024-04-01');
+  assert.ok(r.ok);
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].number, inv1.number);
+  assert.equal(r.value.invoices[1].number, inv3.number);
+});
+
+test('statement filters by status', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const draft = invoiceResult.value;
+  const issued = issueInvoice(draft, []).value;
+
+  const r = statement('C-001', [draft, issued], '2024-04-01');
+  assert.ok(r.ok);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, issued.number);
+});
+
+test('statement filters by asOf date', () => {
+  const inv1 = createIssuedInvoice('C-001', '2024-03-10', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const inv2 = createIssuedInvoice('C-001', '2024-03-15', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const inv3 = createIssuedInvoice('C-001', '2024-03-20', [{ sku: 'DES-HOUR', qty: 1 }]);
+
+  const r = statement('C-001', [inv1, inv2, inv3], '2024-03-15');
+  assert.ok(r.ok);
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].number, inv1.number);
+  assert.equal(r.value.invoices[1].number, inv2.number);
+});
+
+test('statement includes invoice details', () => {
+  const inv = createIssuedInvoice('C-002', '2024-03-15', [{ sku: 'STICKER', qty: 100 }]);
+  const r = statement('C-002', [inv], '2024-04-01');
+  assert.ok(r.ok);
+  const invoiceItem = r.value.invoices[0];
+  assert.equal(invoiceItem.number, inv.number);
+  assert.equal(invoiceItem.issueDate, '2024-03-15');
+  assert.equal(invoiceItem.dueDate, inv.dueDate);
+  assert.equal(typeof invoiceItem.total, 'number');
+  assert.ok(invoiceItem.total > 0);
+});
+
+test('statement calculates due as balance due', () => {
+  const inv = createIssuedInvoice('C-002', '2024-03-15', [{ sku: 'STICKER', qty: 100 }]);
+  const r = statement('C-002', [inv], '2024-04-01');
+  assert.ok(r.ok);
+  const invoiceItem = r.value.invoices[0];
+  assert.equal(invoiceItem.due, inv.total);
+});
+
+test('statement sorts invoices by issue date', () => {
+  const inv1 = createIssuedInvoice('C-001', '2024-03-20', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const inv2 = createIssuedInvoice('C-001', '2024-03-10', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const inv3 = createIssuedInvoice('C-001', '2024-03-15', [{ sku: 'DES-HOUR', qty: 1 }]);
+
+  const r = statement('C-001', [inv1, inv2, inv3], '2024-04-01');
+  assert.ok(r.ok);
+  assert.equal(r.value.invoices[0].issueDate, '2024-03-10');
+  assert.equal(r.value.invoices[1].issueDate, '2024-03-15');
+  assert.equal(r.value.invoices[2].issueDate, '2024-03-20');
+});
+
+test('statement sums total due', () => {
+  const inv1 = createIssuedInvoice('C-001', '2024-03-10', [{ sku: 'STICKER', qty: 100 }]);
+  const inv2 = createIssuedInvoice('C-001', '2024-03-20', [{ sku: 'STICKER', qty: 50 }]);
+
+  const r = statement('C-001', [inv1, inv2], '2024-04-01');
+  assert.ok(r.ok);
+  const expected = inv1.total + inv2.total;
+  assert.equal(r.value.totalDue, expected);
+});
+
+test('statement normalizes customer id', () => {
+  const inv = createIssuedInvoice('C-001', '2024-03-15', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const r1 = statement('C-001', [inv], '2024-04-01');
+  const r2 = statement('c-001', [inv], '2024-04-01');
+  const r3 = statement(' c-001 ', [inv], '2024-04-01');
+
+  assert.ok(r1.ok);
+  assert.ok(r2.ok);
+  assert.ok(r3.ok);
+  assert.equal(r1.value.invoices.length, r2.value.invoices.length);
+  assert.equal(r2.value.invoices.length, r3.value.invoices.length);
+});
+
+test('statement reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = statement('C-999', [], '2024-04-01');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement returns empty invoices for customer with no outstanding', () => {
+  const r = statement('C-001', [], '2024-04-01');
+  assert.ok(r.ok);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(invResult.value, []).value;
+
+  // Simulate a paid invoice by manually setting status
+  const paid = { ...issued, status: 'paid', payments: [] };
+
+  const r = statement('C-001', [paid], '2024-04-01');
+  assert.ok(r.ok);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes partially paid invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(invResult.value, []).value;
+
+  // Simulate a partially paid invoice
+  const partiallyPaid = {
+    ...issued,
+    status: 'partially_paid',
+    payments: [{ amount: 2000, date: '2024-03-20' }],
+  };
+
+  const r = statement('C-001', [partiallyPaid], '2024-04-01');
+  assert.ok(r.ok);
+  assert.equal(r.value.invoices.length, 1);
+  assert.ok(r.value.totalDue > 0);
+});
+
+test('statement with multiple customers and complex filtering', () => {
+  const inv1 = createIssuedInvoice('C-001', '2024-03-10', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const inv2 = createIssuedInvoice('C-002', '2024-03-12', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const inv3 = createIssuedInvoice('C-001', '2024-03-15', [{ sku: 'DES-HOUR', qty: 1 }]);
+  const inv4 = createIssuedInvoice('C-001', '2024-03-25', [{ sku: 'DES-HOUR', qty: 1 }]);
+
+  const r = statement('C-001', [inv1, inv2, inv3, inv4], '2024-03-20');
+  assert.ok(r.ok);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].number, inv1.number);
+  assert.equal(r.value.invoices[1].number, inv3.number);
+  assert.equal(r.value.totalDue, inv1.total + inv3.total);
+});
