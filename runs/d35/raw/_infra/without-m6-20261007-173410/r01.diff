diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..7a2b0d1
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,52 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Validate that a string is a date in YYYY-MM-DD format.
+ * @param {string} dateString
+ * @returns {boolean}
+ */
+function isValidDate(dateString) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateString)) return false;
+  const date = new Date(dateString);
+  return date instanceof Date && !isNaN(date) && date.toISOString().startsWith(dateString);
+}
+
+/**
+ * Create a draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: 'draft', lines: Array<any> } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  const processedLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    processedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: processedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..8a3630e
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,136 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with product details', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 8500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[1].name, 'Development (hour)');
+});
+
+test('createInvoice rejects unknown customer', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-999',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'CUSTOMER_NOT_FOUND' }
+  );
+});
+
+test('createInvoice rejects invalid date format', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '07-10-2026',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects non-existent date', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-02-30',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects empty lines array', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice rejects zero quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 0 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects negative quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: -5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects fractional quantity', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'NOPE', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice does not mutate arguments', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+  assert.equal(lines[0].sku, 'DES-HOUR');
+  assert.equal(lines[0].qty, 5);
+  assert.equal(Object.keys(lines[0]).length, 2);
+});
