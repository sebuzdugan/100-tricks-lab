new file mode 100644
index 0000000..546fc79
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,31 @@
+/**
+ * Parse an invoice number and return { year, counter } or null if invalid.
+ * @param {string} number
+ * @returns {{ year: number, counter: number } | null}
+ */
+function parseInvoiceNumber(number) {
+  const m = /^INV-(\d{4})-(\d{4})$/.exec(number);
+  if (!m) return null;
+  return { year: Number(m[1]), counter: Number(m[2]) };
+}
+
+/**
+ * Get the next invoice number for a given year.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used, in any order
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = Number(issueDate.substring(0, 4));
+
+  let maxCounter = 0;
+  for (const number of existingNumbers) {
+    const parsed = parseInvoiceNumber(number);
+    if (parsed && parsed.year === year) {
+      maxCounter = Math.max(maxCounter, parsed.counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
