diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..48b6216
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,38 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number for a year', () => {
+  assert.equal(nextInvoiceNumber([], '2026-10-07'), 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments within the same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber finds max counter regardless of order', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0005', 'INV-2026-0003'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber starts fresh in a new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0005', 'INV-2026-0002'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0003');
+  assert.equal(nextInvoiceNumber(existing, '2025-10-07'), 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber ignores invalid numbers', () => {
+  const existing = ['INV-2026-0001', 'INVALID', 'INV-2026-0003'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = ['INV-2026-0099'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-0100');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2026-9999'];
+  assert.equal(nextInvoiceNumber(existing, '2026-10-07'), 'INV-2026-10000');
+});
