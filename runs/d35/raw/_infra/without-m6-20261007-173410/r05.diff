+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const text = renderInvoiceText(r2.value);
+  assert.ok(text.startsWith('INV-2026-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText formats amounts using formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('€85.00'));
+});
+
+test('renderInvoiceText shows line details', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('2 × Design work (hour) @ €85.00 = €170.00'));
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.ok(lines.some((l) => l.includes('Design work (hour)')));
+  assert.ok(lines.some((l) => l.includes('Development (hour)')));
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  const expectedTotal = 2 * 8500 + 1 * 9500;
+  assert.ok(text.includes(`Total: €${(expectedTotal / 100).toFixed(2)}`));
+});
+
+test('renderInvoiceText has correct line structure', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.ok(lines[2].includes('Design work'));
+  assert.ok(lines[3].startsWith('Total:'));
+});
+
+test('renderInvoiceText uses formatEuros for all amounts', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 5 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  assert.equal(r.ok, true);
+
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('€9.80'));
+  assert.ok(text.includes('€0.50'));
+});
