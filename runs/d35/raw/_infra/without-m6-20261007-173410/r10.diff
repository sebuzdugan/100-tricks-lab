@@ -0,0 +1,96 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate('2026'), false);
+  assert.equal(isValidDate('not a date'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2021-02-29'), false);
+});
+
+test('isValidDate rejects invalid day-of-month', () => {
+  assert.equal(isValidDate('2026-01-32'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2026-06-31'), false);
+  assert.equal(isValidDate('2026-09-31'), false);
+  assert.equal(isValidDate('2026-11-31'), false);
+});
+
+test('addDays adds positive number of days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 100), '2027-01-15');
+});
+
+test('addDays subtracts negative number of days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -7), '2026-09-30');
+  assert.equal(addDays('2026-10-07', -100), '2026-06-29');
+});
+
+test('addDays handles month and year boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+  assert.equal(addDays('2020-02-28', 1), '2020-02-29');
+  assert.equal(addDays('2020-02-29', 1), '2020-03-01');
+});
+
+test('addDays handles negative boundaries', () => {
+  assert.equal(addDays('2026-02-01', -1), '2026-01-31');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  assert.equal(addDays('2026-03-01', -1), '2026-02-28');
+  assert.equal(addDays('2020-03-01', -1), '2020-02-29');
+});
+
+test('daysBetween calculates difference between two dates', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+});
+
+test('daysBetween handles negative differences', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+});
+
+test('daysBetween handles large date differences', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-12-31'), 364);
+  assert.equal(daysBetween('2020-01-01', '2020-12-31'), 365);
+});
+
+test('daysBetween is consistent with addDays', () => {
+  const start = '2026-10-07';
+  const end = addDays(start, 100);
+  assert.equal(daysBetween(start, end), 100);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+});
+
+test('addDays and daysBetween work with leap years', () => {
+  const before = '2020-02-28';
+  const after = addDays(before, 2);
+  assert.equal(after, '2020-03-01');
+  assert.equal(daysBetween(before, after), 2);
+});
