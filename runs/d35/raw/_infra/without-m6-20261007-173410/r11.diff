+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('recordPayment records a full payment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const totalAmountDue = 8500 + Math.round(8500 * 0.21);
+  const r3 = recordPayment(r2.value, { amount: totalAmountDue, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'paid');
+  assert.equal(r3.value.payments.length, 1);
+  assert.equal(r3.value.payments[0].amount, totalAmountDue);
+  assert.equal(r3.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment records a partial payment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const halfPayment = 5000;
+  const r3 = recordPayment(r2.value, { amount: halfPayment, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'partially_paid');
+  assert.equal(r3.value.payments.length, 1);
+});
+
+test('recordPayment records multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const r3 = recordPayment(r2.value, { amount: 5000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+
+  const totalAmountDue = 8500 + Math.round(8500 * 0.21);
+  const r4 = recordPayment(r3.value, { amount: totalAmountDue - 5000, date: '2026-10-09' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.status, 'paid');
+  assert.equal(r4.value.payments.length, 2);
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  assert.deepEqual(recordPayment(r.value, { amount: 1000, date: '2026-10-08' }), {
+    ok: false,
+    error: 'NOT_ISSUED',
+  });
+});
+
+test('recordPayment rejects invalid amount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  assert.deepEqual(recordPayment(r2.value, { amount: 0, date: '2026-10-08' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+  assert.deepEqual(recordPayment(r2.value, { amount: -1000, date: '2026-10-08' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+  assert.deepEqual(recordPayment(r2.value, { amount: 1000.5, date: '2026-10-08' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment rejects invalid date', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  assert.deepEqual(recordPayment(r2.value, { amount: 1000, date: '2026-13-01' }), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const totalAmountDue = 8500 + Math.round(8500 * 0.21);
+  assert.deepEqual(recordPayment(r2.value, { amount: totalAmountDue + 1, date: '2026-10-08' }), {
+    ok: false,
+    error: 'OVERPAYMENT',
+  });
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const original = r2.value;
+  recordPayment(original, { amount: 1000, date: '2026-10-08' });
+  assert.equal(original.payments, undefined);
+  assert.equal(original.status, 'issued');
+});
+
+test('balanceDue returns full amount for unpaid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const totalAmountDue = 8500 + Math.round(8500 * 0.21);
+  assert.equal(balanceDue(r2.value), totalAmountDue);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const totalAmountDue = 8500 + Math.round(8500 * 0.21);
+  const r3 = recordPayment(r2.value, { amount: totalAmountDue, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+
+  assert.equal(balanceDue(r3.value), 0);
+});
+
+test('balanceDue returns remaining balance for partially paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const totalAmountDue = 8500 + Math.round(8500 * 0.21);
+  const payment = 5000;
+  const r3 = recordPayment(r2.value, { amount: payment, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+
+  assert.equal(balanceDue(r3.value), totalAmountDue - payment);
+});
+
+test('balanceDue with multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const totalAmountDue = 8500 + Math.round(8500 * 0.21);
+  const r3 = recordPayment(r2.value, { amount: 3000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+
+  const r4 = recordPayment(r3.value, { amount: 2000, date: '2026-10-09' });
+  assert.equal(r4.ok, true);
+
+  assert.equal(balanceDue(r4.value), totalAmountDue - 5000);
+});
+
+test('recordPayment on partially_paid invoice allows additional payment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = issueInvoice(r.value, []);
+  assert.equal(r2.ok, true);
+
+  const r3 = recordPayment(r2.value, { amount: 5000, date: '2026-10-08' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'partially_paid');
+
+  const r4 = recordPayment(r3.value, { amount: 1000, date: '2026-10-09' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.payments.length, 2);
+});
