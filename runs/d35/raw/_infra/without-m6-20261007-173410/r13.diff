+
+test('applyVoucher updates invoiceTotals', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+
+  const r2 = applyVoucher(r.value, { code: 'SAVE10', amount: 1000 });
+  assert.equal(r2.ok, true);
+
+  const totals = invoiceTotals(r2.value);
+  assert.equal(totals.voucher, 1000);
+  const totalBefore = invoiceTotals(r.value).total;
+  const totalAfter = totals.total;
+  assert.equal(totalAfter, totalBefore - 1000);
+});
