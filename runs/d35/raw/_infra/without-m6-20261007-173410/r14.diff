+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns invoices for customer', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const invoices = [inv1, inv2];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+});
+
+test('statement filters by issueDate', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const invoices = [inv1, inv2];
+  const r = statement('C-001', invoices, '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement filters by status', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+  }).value;
+
+  const invoices = [inv1, draft];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, inv1.number);
+});
+
+test('statement filters by customer', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const invoices = [inv1, inv2];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, inv1.number);
+});
+
+test('statement sorts by issueDate', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const invoices = [inv1, inv2];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-15');
+});
+
+test('statement includes invoice details', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+      terms: 'NET30',
+    }).value,
+    []
+  ).value;
+
+  const invoices = [inv];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  const invStatement = r.value.invoices[0];
+  assert.equal(invStatement.number, inv.number);
+  assert.equal(invStatement.issueDate, '2026-10-07');
+  assert.equal(invStatement.dueDate, '2026-11-06');
+  assert.equal(typeof invStatement.total, 'number');
+  assert.equal(typeof invStatement.due, 'number');
+});
+
+test('statement calculates totalDue', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    ['INV-2026-0001']
+  ).value;
+
+  const invoices = [inv1, inv2];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  const expectedTotal = r.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(r.value.totalDue, expectedTotal);
+});
+
+test('statement accounts for partial payments', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const totalDue = 8500 + Math.round(8500 * 0.21);
+  inv = recordPayment(inv, { amount: 5000, date: '2026-10-10' }).value;
+
+  const invoices = [inv];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].due, totalDue - 5000);
+  assert.equal(r.value.totalDue, totalDue - 5000);
+});
+
+test('statement accounts for vouchers', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  }).value;
+
+  inv = applyVoucher(inv, { code: 'SAVE500', amount: 500 }).value;
+  inv = issueInvoice(inv, []).value;
+
+  const totalDue = 8500 + Math.round(8500 * 0.21) - 500;
+  const invoices = [inv];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].due, totalDue);
+  assert.equal(r.value.totalDue, totalDue);
+});
+
+test('statement handles unknown customer', () => {
+  const invoices = [];
+  const r = statement('C-999', invoices, '2026-10-31');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement rejects invalid asOf date', () => {
+  const invoices = [];
+  const r = statement('C-001', invoices, '2026-13-01');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'DATE_INVALID');
+});
+
+test('statement handles empty statement', () => {
+  const invoices = [];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement normalizes customer ID', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const invoices = [inv];
+  const r = statement('c-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
