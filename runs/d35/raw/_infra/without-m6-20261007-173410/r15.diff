diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..da28d1f
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,199 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const r = createCreditNote(inv, { amount: 1000, reason: 'Damaged goods', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, inv.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 1000);
+  assert.equal(r.value.reason, 'Damaged goods');
+  assert.equal(r.value.date, '2026-10-10');
+});
+
+test('createCreditNote accepts partially_paid invoice', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const r = createCreditNote(inv, { amount: 1000, reason: 'Adjustment', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote accepts paid invoice', () => {
+  let inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  inv.status = 'paid';
+
+  const r = createCreditNote(inv, { amount: 1000, reason: 'Refund', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  }).value;
+
+  assert.deepEqual(
+    createCreditNote(inv, { amount: 1000, reason: 'Damaged goods', date: '2026-10-10' }, []),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('createCreditNote rejects invalid amount', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  assert.deepEqual(
+    createCreditNote(inv, { amount: 0, reason: 'Damaged goods', date: '2026-10-10' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+  assert.deepEqual(
+    createCreditNote(inv, { amount: -1000, reason: 'Damaged goods', date: '2026-10-10' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+  assert.deepEqual(
+    createCreditNote(inv, { amount: 1000.5, reason: 'Damaged goods', date: '2026-10-10' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  assert.deepEqual(
+    createCreditNote(inv, { amount: 1000, reason: 'Damaged goods', date: '2026-13-01' }, []),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createCreditNote rejects credit higher than invoice total', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const invoiceTotal = 8500 + Math.round(8500 * 0.21);
+  assert.deepEqual(
+    createCreditNote(inv, { amount: invoiceTotal + 1, reason: 'Damaged goods', date: '2026-10-10' }, []),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
+
+test('createCreditNote allows credit up to invoice total', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const invoiceTotal = 8500 + Math.round(8500 * 0.21);
+  const r = createCreditNote(inv, { amount: invoiceTotal, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, invoiceTotal);
+});
+
+test('nextCreditNoteNumber returns first number for a year', () => {
+  assert.equal(nextCreditNoteNumber([], '2026-10-07'), 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber increments within the same year', () => {
+  const existing = ['CN-2026-0001', 'CN-2026-0002'];
+  assert.equal(nextCreditNoteNumber(existing, '2026-10-07'), 'CN-2026-0003');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001'];
+  assert.equal(nextCreditNoteNumber(existing, '2026-10-07'), 'CN-2026-0002');
+});
+
+test('nextCreditNoteNumber finds max counter regardless of order', () => {
+  const existing = ['CN-2026-0001', 'CN-2026-0005', 'CN-2026-0003'];
+  assert.equal(nextCreditNoteNumber(existing, '2026-10-07'), 'CN-2026-0006');
+});
+
+test('nextCreditNoteNumber starts fresh in a new year', () => {
+  const existing = ['CN-2025-0001', 'CN-2025-0005', 'CN-2026-0002'];
+  assert.equal(nextCreditNoteNumber(existing, '2026-10-07'), 'CN-2026-0003');
+  assert.equal(nextCreditNoteNumber(existing, '2025-10-07'), 'CN-2025-0006');
+});
+
+test('createCreditNote with vouchers accounts for voucher in total', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  }).value;
+
+  inv = applyVoucher(inv, { code: 'SAVE500', amount: 500 }).value;
+  inv = issueInvoice(inv, []).value;
+
+  const totalAfterVoucher = 8500 + Math.round(8500 * 0.21) - 500;
+  const r = createCreditNote(inv, { amount: totalAfterVoucher, reason: 'Full refund', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, totalAfterVoucher);
+});
+
+test('createCreditNote rejects credit higher than invoice total with voucher', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  }).value;
+
+  inv = applyVoucher(inv, { code: 'SAVE500', amount: 500 }).value;
+  inv = issueInvoice(inv, []).value;
+
+  const totalAfterVoucher = 8500 + Math.round(8500 * 0.21) - 500;
+  assert.deepEqual(
+    createCreditNote(inv, { amount: totalAfterVoucher + 1, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
