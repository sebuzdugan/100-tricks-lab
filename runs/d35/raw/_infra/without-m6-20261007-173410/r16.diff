+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns overdue invoices', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+      terms: 'NET14',
+    }).value,
+    []
+  ).value;
+
+  const invoices = [inv1];
+  const report = overdueInvoices(invoices, '2026-10-20');
+  assert.equal(report.length, 1);
+  assert.equal(report[0].number, inv1.number);
+  assert.equal(report[0].daysOverdue, 5);
+});
+
+test('overdueInvoices filters by status', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+      terms: 'NET14',
+    }).value,
+    []
+  ).value;
+
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  }).value;
+
+  const paid = JSON.parse(JSON.stringify(inv1));
+  paid.status = 'paid';
+
+  const invoices = [inv1, draft, paid];
+  const report = overdueInvoices(invoices, '2026-10-20');
+  assert.equal(report.length, 1);
+  assert.equal(report[0].number, inv1.number);
+});
+
