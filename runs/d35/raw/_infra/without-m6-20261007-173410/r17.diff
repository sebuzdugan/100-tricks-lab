+test('vatSummary returns VAT rates with base and vat amounts', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    }).value,
+    []
+  ).value;
+
+  const invoices = [inv];
+  const report = vatSummary(invoices);
+  assert.equal(report.length, 1);
+  assert.equal(report[0].rate, 21);
