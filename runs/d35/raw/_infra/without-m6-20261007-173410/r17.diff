+/**
+ * Generate a VAT summary report.
+ * @param {Array<any>} invoices - Array of all invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const summary = {};
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const amount = lineTotal(line) - lineDiscount(line);
+        const vatAmount = lineVAT(line);
+
+        if (!summary[rate]) {
+          summary[rate] = { base: 0, vat: 0 };
+        }
+
+        summary[rate].base += amount;
+        summary[rate].vat += vatAmount;
+      });
+    });
+
+  return Object.entries(summary)
+    .map(([rate, { base, vat }]) => ({
+      rate: Number(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
