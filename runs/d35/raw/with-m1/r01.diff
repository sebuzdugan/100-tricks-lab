+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice: happy path with single line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.deepEqual(result, {
+    ok: true,
+    value: {
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      status: 'draft',
+      lines: [
+        {
+          sku: 'DEV-HOUR',
+          name: 'Development (hour)',
+          qty: 10,
+          unitPrice: 9500,
+          vatRate: 21,
+        },
+      ],
+    },
+  });
+});
+
+test('createInvoice: happy path with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-01-20',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'HOST-MONTH', qty: 12 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 3);
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 5,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+  assert.deepEqual(result.value.lines[1], {
+    sku: 'LOGO-PACK',
+    name: 'Logo package',
+    qty: 1,
+    unitPrice: 120000,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice: customer not found', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice: date invalid - wrong format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '15/10/2024',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice: date invalid - missing leading zero', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-1-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice: date invalid - non-existent day', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice: date invalid - non-leap year February 29', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-02-29',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice: date valid - leap year February 29', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.issueDate, '2024-02-29');
+});
+
+test('createInvoice: date invalid - just a year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice: no lines - empty array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice: no lines - undefined', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: undefined,
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice: qty invalid - zero', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice: qty invalid - negative', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice: qty invalid - float', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 2.5 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice: qty invalid - string', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: '10' }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice: unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice: multiple lines, one has unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'UNKNOWN-SKU', qty: 1 },
+    ],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice: does not mutate input lines array', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 1 }];
+  const linesCopy = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines,
+  });
+
+  assert.deepEqual(lines, linesCopy);
+});
+
+test('createInvoice: different customers', () => {
+  const result1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'COPY-HOUR', qty: 3 }],
+  });
+
+  const result2 = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2024-10-16',
+    lines: [{ sku: 'BRAND-BOOK', qty: 2 }],
+  });
+
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.customerId, 'C-002');
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.customerId, 'C-008');
+});
+
+test('createInvoice: handles products with different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 }, // vatRate: 21
+      { sku: 'PRINT-A4', qty: 100 }, // vatRate: 9
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // vatRate: 0
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice: large quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 10000 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].qty, 10000);
+});
