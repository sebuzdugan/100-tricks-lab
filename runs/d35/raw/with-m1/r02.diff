@@ -43,3 +43,38 @@ export function createInvoice({ customerId, issueDate, lines }) {
     lines: invoiceLines,
   });
 }
+
+/**
+ * Calculate the total amount for a line item (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineTotal(line) {
+  if (!line || !Number.isInteger(line.qty) || line.qty <= 0) {
+    return fail('LINE_INVALID');
+  }
+  if (typeof line.unitPrice !== 'number' || line.unitPrice < 0) {
+    return fail('LINE_INVALID');
+  }
+  return ok(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate totals for an invoice: subtotal (sum of line totals) and total.
+ * @param {{ lines: Array }}
+ * @returns {{ ok: true, value: { subtotal: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines)) {
+    return fail('INVOICE_INVALID');
+  }
+
+  let subtotal = 0;
+  for (const line of invoice.lines) {
+    const result = lineTotal(line);
+    if (!result.ok) return result;
+    subtotal += result.value;
+  }
+
+  return ok({ subtotal, total: subtotal });
+}
