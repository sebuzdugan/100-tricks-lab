@@ -0,0 +1,24 @@
+/**
+ * Get the next invoice number based on existing numbers and issue date.
+ * Format: INV-<year>-<4-digit counter>, restarting each year.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const match = num.match(/^INV-(\d{4})-(\d{4})$/);
+    if (match && match[1] === year) {
+      const counter = parseInt(match[2], 10);
+      if (counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
