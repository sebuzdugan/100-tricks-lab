diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..050b0b3
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,90 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber: empty array starts at 0001', () => {
+  const result = nextInvoiceNumber([], '2024-10-15');
+  assert.equal(result, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber: increments counter', () => {
+  const result = nextInvoiceNumber(['INV-2024-0001', 'INV-2024-0002'], '2024-10-15');
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber: ignores numbers from other years', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2023-0001', 'INV-2023-0099', 'INV-2024-0005'],
+    '2024-10-15'
+  );
+  assert.equal(result, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber: handles unordered array', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2024-0005', 'INV-2024-0001', 'INV-2024-0003'],
+    '2024-10-15'
+  );
+  assert.equal(result, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber: ignores malformed numbers', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2024-001', 'INV-2024-0001', 'INVALID', 'INV-2024-0002'],
+    '2024-10-15'
+  );
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber: handles large counter values', () => {
+  const result = nextInvoiceNumber(['INV-2024-9999'], '2024-10-15');
+  assert.equal(result, 'INV-2024-10000');
+});
+
+test('nextInvoiceNumber: year boundary - 2023 and 2024', () => {
+  const numbers = ['INV-2023-0005', 'INV-2024-0001'];
+
+  const result2023 = nextInvoiceNumber(numbers, '2023-12-31');
+  assert.equal(result2023, 'INV-2023-0006');
+
+  const result2024 = nextInvoiceNumber(numbers, '2024-01-01');
+  assert.equal(result2024, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber: new year starts fresh', () => {
+  const result2024 = nextInvoiceNumber(['INV-2023-0100'], '2024-01-15');
+  assert.equal(result2024, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber: single digit counter is zero-padded', () => {
+  const result = nextInvoiceNumber([], '2024-10-15');
+  assert.equal(result, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber: multiple digit counter keeps padding', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003', 'INV-2024-0004', 'INV-2024-0005'],
+    '2024-10-15'
+  );
+  assert.equal(result, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber: uses issueDate year not current year', () => {
+  const result = nextInvoiceNumber(['INV-2020-0050'], '2024-10-15');
+  assert.equal(result, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber: mixed years with duplicates', () => {
+  const numbers = [
+    'INV-2023-0001',
+    'INV-2023-0002',
+    'INV-2024-0001',
+    'INV-2024-0001', // duplicate (shouldn't affect logic)
+    'INV-2024-0003',
+    'INV-2025-0001',
+  ];
+
+  assert.equal(nextInvoiceNumber(numbers, '2023-06-15'), 'INV-2023-0003');
+  assert.equal(nextInvoiceNumber(numbers, '2024-06-15'), 'INV-2024-0004');
+  assert.equal(nextInvoiceNumber(numbers, '2025-06-15'), 'INV-2025-0002');
+});
