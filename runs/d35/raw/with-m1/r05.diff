+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text suitable for display or printing.
+ * @param {{ customerId: string, number?: string, lines: Array }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  const header = invoice.number || 'DRAFT';
+
+  const lineItems = invoice.lines.map((line) => {
+    const lineTotalResult = lineTotal(line);
+    const total = lineTotalResult.ok ? lineTotalResult.value : 0;
+    return `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+  });
+
+  const totalsResult = invoiceTotals(invoice);
+  const total = totalsResult.ok ? totalsResult.value.total : 0;
+
+  const lines = [header, customerName, ...lineItems, `Total: ${formatEuros(total)}`];
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
