+++ b/test/render.test.js
@@ -0,0 +1,238 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText: draft invoice with single line', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  assert.equal(
+    text,
+    `DRAFT
+Northwind Studio
+10 x Development (hour) @ €95.00 = €950.00
+Total: €950.00`
+  );
+});
+
+test('renderInvoiceText: issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const text = renderInvoiceText(issuedResult.value);
+
+  assert.equal(
+    text,
+    `INV-2024-0001
+Northwind Studio
+10 x Development (hour) @ €95.00 = €950.00
+Total: €950.00`
+  );
+});
+
+test('renderInvoiceText: multiple line items', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.equal(lines[2], '5 x Development (hour) @ €95.00 = €475.00');
+  assert.equal(lines[3], '3 x Design work (hour) @ €85.00 = €255.00');
+  assert.equal(lines[4], '2 x Copywriting (hour) @ €60.00 = €120.00');
+  assert.equal(lines[5], 'Total: €850.00');
+});
+
+test('renderInvoiceText: large amounts with thousand separators', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 10 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  assert.equal(
+    text,
+    `DRAFT
+Northwind Studio
+10 x Logo package @ €1,200.00 = €12,000.00
+Total: €12,000.00`
+  );
+});
+
+test('renderInvoiceText: different customers', () => {
+  const invoice1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const invoice2Result = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const text1 = renderInvoiceText(invoice1Result.value);
+  const text2 = renderInvoiceText(invoice2Result.value);
+
+  assert(text1.includes('Northwind Studio'));
+  assert(text2.includes('Lumen Records'));
+});
+
+test('renderInvoiceText: decimal amounts', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'STICKER',
+        name: 'Sticker sheet',
+        qty: 5,
+        unitPrice: 50,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert.equal(
+    text,
+    `DRAFT
+Northwind Studio
+5 x Sticker sheet @ €0.50 = €2.50
+Total: €2.50`
+  );
+});
+
+test('renderInvoiceText: various VAT rates', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 }, // 21% VAT
+      { sku: 'PRINT-A4', qty: 100 }, // 9% VAT
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0% VAT
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  const lines = text.split('\n');
+  assert(lines[2].includes('Development (hour)'));
+  assert(lines[3].includes('Printed flyer A4'));
+  assert(lines[4].includes('Brand workshop'));
+  assert(lines[5].startsWith('Total:'));
+});
+
+test('renderInvoiceText: high quantity items', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 5000 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  assert(text.includes('5000 x Sticker sheet'));
+  assert(text.includes('Total: €2,500.00'));
+});
+
+test('renderInvoiceText: multiple invoices have different numbers', () => {
+  const invoice1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const invoice2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const issued1 = issueInvoice(invoice1Result.value, []);
+  const issued2 = issueInvoice(invoice2Result.value, [issued1.value.number]);
+
+  const text1 = renderInvoiceText(issued1.value);
+  const text2 = renderInvoiceText(issued2.value);
+
+  assert(text1.startsWith('INV-2024-0001'));
+  assert(text2.startsWith('INV-2024-0002'));
+  assert(!text1.includes('INV-2024-0002'));
+  assert(!text2.includes('INV-2024-0001'));
+});
+
+test('renderInvoiceText: formatEuros is used for all amounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'ICON-SET', qty: 3 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  // ICON-SET: 980 cents = €9.80
+  // 3 x 980 = 2940 cents = €29.40
+  assert(text.includes('€9.80'));
+  assert(text.includes('€29.40'));
+  assert(!text.includes('980'));
+  assert(!text.includes('2940'));
+});
+
+test('renderInvoiceText: line structure', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 5); // header, customer, 2 items, total
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert(lines[2].startsWith('5 x'));
+  assert(lines[3].startsWith('3 x'));
+  assert(lines[4].startsWith('Total:'));
+});
+
+test('renderInvoiceText: issued invoice from different year', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-12-31',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, ['INV-2023-0050']);
+  const text = renderInvoiceText(issuedResult.value);
+
+  assert(text.startsWith('INV-2023-0051'));
+  assert(text.includes('Northwind Studio'));
+});
