diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..12c9178
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,130 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate: valid dates', () => {
+  assert.equal(isValidDate('2024-10-15'), true);
+  assert.equal(isValidDate('2024-01-01'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+});
+
+test('isValidDate: invalid format', () => {
+  assert.equal(isValidDate('2024/10/15'), false);
+  assert.equal(isValidDate('15-10-2024'), false);
+  assert.equal(isValidDate('2024-10'), false);
+  assert.equal(isValidDate('2024'), false);
+  assert.equal(isValidDate('15/10/2024'), false);
+});
+
+test('isValidDate: invalid dates', () => {
+  assert.equal(isValidDate('2024-02-30'), false); // Feb 30 doesn't exist
+  assert.equal(isValidDate('2023-02-29'), false); // not a leap year
+  assert.equal(isValidDate('2024-04-31'), false); // April has 30 days
+  assert.equal(isValidDate('2024-13-01'), false); // month 13
+  assert.equal(isValidDate('2024-00-15'), false); // month 0
+});
+
+test('isValidDate: missing leading zeros', () => {
+  assert.equal(isValidDate('2024-1-15'), false);
+  assert.equal(isValidDate('2024-10-5'), false);
+  assert.equal(isValidDate('2024-1-5'), false);
+});
+
+test('isValidDate: non-date strings', () => {
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('2024-ab-cd'), false);
+});
+
+test('addDays: positive days', () => {
+  assert.equal(addDays('2024-10-15', 1), '2024-10-16');
+  assert.equal(addDays('2024-10-15', 5), '2024-10-20');
+  assert.equal(addDays('2024-10-15', 10), '2024-10-25');
+});
+
+test('addDays: negative days', () => {
+  assert.equal(addDays('2024-10-15', -1), '2024-10-14');
+  assert.equal(addDays('2024-10-15', -5), '2024-10-10');
+  assert.equal(addDays('2024-10-15', -10), '2024-10-05');
+});
+
+test('addDays: zero days', () => {
+  assert.equal(addDays('2024-10-15', 0), '2024-10-15');
+});
+
+test('addDays: crosses month boundary', () => {
+  assert.equal(addDays('2024-10-31', 1), '2024-11-01');
+  assert.equal(addDays('2024-10-15', 20), '2024-11-04');
+});
+
+test('addDays: crosses year boundary', () => {
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+  assert.equal(addDays('2024-12-25', 10), '2025-01-04');
+});
+
+test('addDays: crosses leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays: large days', () => {
+  assert.equal(addDays('2024-01-01', 365), '2024-12-31');
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01'); // leap year
+});
+
+test('daysBetween: same date', () => {
+  assert.equal(daysBetween('2024-10-15', '2024-10-15'), 0);
+});
+
+test('daysBetween: positive difference', () => {
+  assert.equal(daysBetween('2024-10-15', '2024-10-16'), 1);
+  assert.equal(daysBetween('2024-10-15', '2024-10-20'), 5);
+  assert.equal(daysBetween('2024-10-15', '2024-10-25'), 10);
+});
+
+test('daysBetween: negative difference', () => {
+  assert.equal(daysBetween('2024-10-15', '2024-10-14'), -1);
+  assert.equal(daysBetween('2024-10-15', '2024-10-10'), -5);
+  assert.equal(daysBetween('2024-10-15', '2024-10-05'), -10);
+});
+
+test('daysBetween: crosses month boundary', () => {
+  assert.equal(daysBetween('2024-10-31', '2024-11-01'), 1);
+  assert.equal(daysBetween('2024-10-15', '2024-11-04'), 20);
+});
+
+test('daysBetween: crosses year boundary', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2024-12-25', '2025-01-04'), 10);
+});
+
+test('daysBetween: year to year', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is leap year
+});
+
+test('daysBetween: consistency with addDays', () => {
+  const start = '2024-10-15';
+  const days = 42;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+});
+
+test('daysBetween: round trip', () => {
+  const date1 = '2024-01-15';
+  const date2 = '2024-12-20';
+  const diff = daysBetween(date1, date2);
+  assert.equal(addDays(date1, diff), date2);
+});
+
+test('isValidDate works with invoices: valid dates pass', () => {
+  assert.equal(isValidDate('2024-10-15'), true);
+  assert.equal(isValidDate('2024-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+});
+
+test('isValidDate works with invoices: invalid dates fail', () => {
+  assert.equal(isValidDate('2024-02-30'), false);
+  assert.equal(isValidDate('2024-13-01'), false);
+  assert.equal(isValidDate('24-10-15'), false);
+});
