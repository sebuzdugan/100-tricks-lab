@@ -0,0 +1,65 @@
+import { ok, fail } from './result.js';
+import { isValidDate } from './dates.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {number} total - the invoice total in cents
+ * @returns {number} - amount owed in cents
+ */
+function amountOwed(invoice, total) {
+  const paid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, total - paid);
+}
+
+/**
+ * Calculate the balance due (amount still owed) for an invoice.
+ * @param {{ payments?: Array<{ amount: number, date: string }> }} invoice
+ * @returns {number} - balance due in cents (0 if paid)
+ */
+export function balanceDue(invoice) {
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return 0;
+  return amountOwed(invoice, totalsResult.value.total);
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }}
+ * @returns {{ ok: true, value: { status: string, payments: Array } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (!invoice || (invoice.status !== 'issued' && invoice.status !== 'partially_paid')) {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+
+  const total = totalsResult.value.total;
+  const owed = amountOwed(invoice, total);
+
+  if (amount > owed) {
+    return fail('OVERPAYMENT');
+  }
+
+  const payments = [...(invoice.payments ?? []), { amount, date }];
+  const newOwed = amountOwed({ payments }, total);
+  const status = newOwed === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments,
+    status,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
