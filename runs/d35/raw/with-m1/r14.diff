+
+test('statement: totalDue is sum of all dues', () => {
+  const invoice1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const invoice2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-20',
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    }).value,
+    []
+  ).value;
+
+  const paidInvoice2 = recordPayment(invoice2, { amount: 30000, date: '2024-10-22' }).value;
+
+  const result = statement('C-001', [invoice1, paidInvoice2], '2024-10-25');
+
+  assert.equal(result.ok, true);
+  // Invoice 1: 109202 (unpaid)
+  // Invoice 2: 54601 - 30000 = 24601 (partially paid)
+  // Total: 109202 + 24601 = 133803
+  assert.equal(result.value.totalDue, 133803);
+});
+
+test('statement: unknown customer', () => {
+  const result = statement('C-999', [], '2024-10-20');
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement: normalizes customerId', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const result = statement(' c-001 ', [invoice], '2024-10-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement: includes dueDate if present', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
