+
+test('statement: omits dueDate if not present', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  // Manually create an invoice without dueDate for testing
+  const invoiceWithoutDueDate = {
+    ...invoiceResult.value,
+    status: 'issued',
+    number: 'INV-2024-0001',
+  };
+  delete invoiceWithoutDueDate.dueDate;
