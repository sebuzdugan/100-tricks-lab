+
+test('statement: with voucher', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const withVoucher = applyVoucher(invoiceResult.value, { code: 'SAVE10', amount: 10000 });
+  const issuedResult = issueInvoice(withVoucher.value, []);
+  const result = statement('C-001', [issuedResult.value], '2024-10-20');
+
+  assert.equal(result.ok, true);
+  // Total before voucher: 109202, after voucher: 99202
+  assert.equal(result.value.invoices[0].total, 99202);
+  assert.equal(result.value.invoices[0].due, 99202);
+});
+
+test('statement: empty invoice list', () => {
+  const result = statement('C-001', [], '2024-10-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement: invoices with different years', () => {
