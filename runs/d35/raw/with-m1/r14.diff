+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }).value,
+    []
+  ).value;
+
+  const result = statement('C-001', [invoice2023, invoice2024], '2024-01-02');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2023-12-31');
+  assert.equal(result.value.invoices[1].issueDate, '2024-01-01');
+});
+
+test('statement: large totalDue', () => {
+  const invoices = [];
+  for (let i = 0; i < 100; i++) {
+    const inv = issueInvoice(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: '2024-10-15',
+        lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+      }).value,
+      []
+    ).value;
+    invoices.push(inv);
+  }
+
+  const result = statement('C-001', invoices, '2024-10-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 100);
+  assert(result.value.totalDue > 0);
+});
