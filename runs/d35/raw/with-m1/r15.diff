+import { ok, fail } from './result.js';
+import { isValidDate } from './dates.js';
+import { invoiceTotals } from './invoices.js';
+
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.slice(0, 4);
+  const cnPattern = /^CN-(\d{4})-(\d{4})$/;
+
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const match = num.match(cnPattern);
+    if (match && match[1] === year) {
+      const counter = parseInt(match[2], 10);
+      maxCounter = Math.max(maxCounter, counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `CN-${year}-${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }}
+ * @param {Array<string>} existingNumbers - can contain both INV and CN numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (!invoice || (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid')) {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+
+  const invoiceTotal = totalsResult.value.total;
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
