+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote: happy path', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = createCreditNote(issuedResult.value, { amount: 5000, reason: 'Discount', date: '2024-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2024-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Discount');
+  assert.equal(result.value.date, '2024-10-20');
+});
+
+test('createCreditNote: on issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = createCreditNote(issuedResult.value, { amount: 10000, reason: 'Refund', date: '2024-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote: on partially paid invoice', () => {
+  const invoiceResult = createInvoice({
