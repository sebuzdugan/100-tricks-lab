+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoices = [issuedResult.value];
+  const original = JSON.parse(JSON.stringify(invoices));
+
+  overdueInvoices(invoices, '2024-10-20');
+
