+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices: happy path with single overdue invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Due date is 2024-10-15, checking as of 2024-10-20
+  const result = overdueInvoices([issuedResult.value], '2024-10-20');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2024-0001');
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2024-10-15');
+  assert.equal(result[0].daysOverdue, 5);
+  assert.equal(result[0].due, 109202);
+});
+
+test('overdueInvoices: invoice not yet due', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Due date is 2024-10-15, checking as of 2024-10-14
+  const result = overdueInvoices([issuedResult.value], '2024-10-14');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices: invoice due today (not overdue)', () => {
