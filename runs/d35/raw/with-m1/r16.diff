+
+test('overdueInvoices: large dataset', () => {
+  const invoices = [];
+  for (let i = 0; i < 1000; i++) {
+    const day = String((i % 28) + 1).padStart(2, '0');
+    const inv = issueInvoice(
+      createInvoice({
+        customerId: `C-${String((i % 10) + 1).padStart(3, '0')}`,
+        issueDate: `2024-09-${day}`,
+        lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+        terms: 'NET14',
+      }).value,
+      []
+    ).value;
+    invoices.push(inv);
+  }
+
+  const result = overdueInvoices(invoices, '2024-10-20');
+
+  assert(result.length > 0);
+  // All invoices from September should be overdue by October 20
+  assert.equal(result.length, 1000);
+  // First should be most overdue
+  assert(result[0].daysOverdue > result[result.length - 1].daysOverdue);
+});
