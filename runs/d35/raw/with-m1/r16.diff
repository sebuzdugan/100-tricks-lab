+import { daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Get invoices that are overdue as of a given date.
+ * @param {Array<{ number: string, customerId: string, dueDate?: string, status: string, lines: Array, payments?: Array }>} invoices
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>} - sorted by most overdue first
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = [];
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') continue;
+    if (!invoice.dueDate) continue;
+    if (invoice.dueDate >= asOf) continue;
+
+    const daysOverdue = daysBetween(invoice.dueDate, asOf);
+    const due = balanceDue(invoice);
+
+    overdue.push({
+      number: invoice.number,
+      customerId: invoice.customerId,
+      dueDate: invoice.dueDate,
+      daysOverdue,
+      due,
+    });
+  }
+
+  overdue.sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
