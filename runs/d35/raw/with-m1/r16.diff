+
+test('overdueInvoices: across year boundary', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Due: 2024-12-29, as of: 2025-01-05 = 7 days overdue
+  const result = overdueInvoices([issuedResult.value], '2025-01-05');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 7);
