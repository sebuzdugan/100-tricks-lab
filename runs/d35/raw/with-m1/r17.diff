+/**
+ * Get a summary of VAT by rate for all non-draft invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} - sorted by rate from high to low
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const totalResult = lineTotal(line);
+      if (!totalResult.ok) continue;
+
+      const discountResult = lineDiscount(line);
+      if (!discountResult.ok) continue;
+
+      const base = totalResult.value - discountResult.value;
+      const rate = line.vatRate;
+
+      const vatResult = lineVat(line);
+      if (!vatResult.ok) continue;
+
+      const vat = vatResult.value;
+
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      vatByRate[rate].base += base;
+      vatByRate[rate].vat += vat;
+    }
+  }
+
+  const summary = Object.values(vatByRate);
+  summary.sort((a, b) => b.rate - a.rate);
+
+  return summary;
+}
