   return summary;
 }
+
+/**
+ * Calculate the late fee for an invoice: 0.04% per day overdue.
+ * @param {{ dueDate?: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {number} - late fee in cents, 0 if not overdue or no dueDate
+ */
+export function lateFee(invoice, asOf) {
+  if (!invoice.dueDate) return 0;
+  if (invoice.dueDate >= asOf) return 0;
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const amountDue = balanceDue(invoice);
+
+  const fee = roundCents(amountDue * 0.0004 * daysOverdue);
+  return Math.max(0, fee);
+}
