+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function formatAmount(cents) {
+  if (!Number.isInteger(cents)) {
+    cents = Math.round(cents);
+  }
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array<{ number: string, customerId: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array }>} invoices
+ * @returns {string} - CSV formatted string with header and invoice rows
+ */
+export function exportCsv(invoices) {
+  const rows = [];
+  rows.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+    const totalsResult = invoiceTotals(invoice);
+    const totals = totalsResult.ok
+      ? totalsResult.value
+      : { subtotal: 0, discount: 0, vat: 0, total: 0, voucher: 0 };
+
+    const due = balanceDue(invoice);
+    const dueDate = invoice.dueDate || '';
+
+    const row = [
+      escapeCsvField(invoice.number),
+      escapeCsvField(customerName),
+      escapeCsvField(invoice.issueDate),
+      escapeCsvField(dueDate),
+      escapeCsvField(invoice.status),
+      formatAmount(totals.subtotal),
+      formatAmount(totals.discount),
+      formatAmount(totals.vat),
+      formatAmount(totals.total),
+      formatAmount(due),
+    ].join(',');
+
+    rows.push(row);
+  }
+
+  return rows.join('\n') + '\n';
+}
