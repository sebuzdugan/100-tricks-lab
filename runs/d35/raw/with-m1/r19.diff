+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv: empty list', () => {
+  const result = exportCsv([]);
+
+  assert.equal(
+    result,
+    'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'
+  );
+});
+
+test('exportCsv: header line', () => {
+  const result = exportCsv([]);
+
+  const lines = result.split('\n');
+  assert.equal(
+    lines[0],
+    'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'
+  );
+});
+
+test('exportCsv: single invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3); // header, data, trailing newline
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert(lines[1].includes('INV-2024-0001'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[1].includes('2024-10-15'));
+  assert(lines[1].includes('2024-10-29'));
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv: amounts formatted correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // subtotal should be 950.00 (95000 cents)
+  assert(fields[5].includes('950'));
+  // discount should be 47.50 (4750 cents, 5% tier discount)
+  assert(fields[6].includes('47'));
+  // vat should be 189.52 (18952 cents)
+  assert(fields[7].includes('189'));
+  // total should be 1092.02 (109202 cents)
+  assert(fields[8].includes('1092'));
+});
+
+test('exportCsv: multiple invoices', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2024-10-20',
+      lines: [{ sku: 'STICKER', qty: 50 }],
+    }).value,
+    [inv1.number]
+  ).value;
+
+  const result = exportCsv([inv1, inv2]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4); // header, 2 data rows, trailing newline
+  assert(lines[1].includes('INV-2024-0001'));
+  assert(lines[2].includes('INV-2024-0002'));
+});
+
+test('exportCsv: with dueDate', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  const lines = result.split('\n');
+  assert(lines[1].includes('2024-10-29'));
+});
+
+test('exportCsv: without dueDate', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // Manually remove dueDate
+  const invoiceWithoutDueDate = { ...issuedResult.value };
+  delete invoiceWithoutDueDate.dueDate;
+
+  const result = exportCsv([invoiceWithoutDueDate]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // dueDate field should be empty
+  assert.equal(fields[3], '');
+});
+
+test('exportCsv: customer with comma in name', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  const lines = result.split('\n');
+  // Studio Lumen doesn't have a comma, so field should not be quoted
+  assert(!lines[1].startsWith('INV-2024-0001,"'));
+});
+
+test('exportCsv: customer name with special characters', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  // Should not throw and should produce valid CSV
+  assert(typeof result === 'string');
+  assert(result.length > 0);
+});
+
+test('exportCsv: partially paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const paidResult = recordPayment(issuedResult.value, { amount: 50000, date: '2024-10-20' });
+
+  const result = exportCsv([paidResult.value]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // due should be 592.02 (59202 cents: 109202 - 50000)
+  assert(fields[9].includes('592'));
+});
+
+test('exportCsv: fully paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const paidResult = recordPayment(issuedResult.value, { amount: 109202, date: '2024-10-20' });
+
+  const result = exportCsv([paidResult.value]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // due should be 0.00
+  assert.equal(fields[9], '0.00');
+});
+
+test('exportCsv: ends with newline', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  assert(result.endsWith('\n'));
+});
+
+test('exportCsv: CSV parsing - valid format', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  // Should be parseable as CSV
+  const lines = result.trim().split('\n');
+  assert.equal(lines.length, 2); // header and one data line
+
+  const headerFields = lines[0].split(',');
+  assert.equal(headerFields.length, 10);
+});
+
+test('exportCsv: decimal precision', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // All amounts should have exactly 2 decimal places
+  for (let i = 5; i < 10; i++) {
+    assert(fields[i].includes('.'));
+    const parts = fields[i].split('.');
+    assert.equal(parts[1].length, 2, `Field ${i} should have 2 decimal places: ${fields[i]}`);
+  }
+});
+
+test('exportCsv: zero amounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  // WORKSHOP-DAY costs 60000 cents, with 5% tier discount = 57000 cents
+  const paidResult = recordPayment(issuedResult.value, { amount: 57000, date: '2024-10-20' });
+
+  const result = exportCsv([paidResult.value]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // vat should be 0.00 (WORKSHOP-DAY has 0% VAT)
+  assert.equal(fields[7], '0.00');
+  // due should be 0.00 (fully paid)
+  assert.equal(fields[9], '0.00');
+});
+
+test('exportCsv: invoice with discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // discount should be reflected
+  assert(parseFloat(fields[6]) > 0);
+});
+
+test('exportCsv: amounts in plain euros', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const result = exportCsv([issuedResult.value]);
+
+  const lines = result.split('\n');
+  assert(lines[1].includes('950.00')); // subtotal in euros
+  assert(!lines[1].includes('€'));
+  assert(!lines[1].includes('1,092')); // no thousands separator
+});
+
+test('exportCsv: different statuses', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+
+  const partial = recordPayment(issued, { amount: 50000, date: '2024-10-20' }).value;
+
+  const result = exportCsv([draft, issued, partial]);
+
+  const lines = result.split('\n');
+  assert(lines[1].includes('draft'));
+  assert(lines[2].includes('issued'));
+  assert(lines[3].includes('partially_paid'));
+});
+
+test('exportCsv: preserves invoice order', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }).value,
+    []
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-16',
+      lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+    }).value,
+    []
+  ).value;
+
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-10-17',
+      lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+    }).value,
+    []
+  ).value;
+
+  const result = exportCsv([inv3, inv1, inv2]);
+
+  const lines = result.split('\n');
+  // Should be in order: inv3, inv1, inv2
+  assert(lines[1].includes('2024-10-17'));
+  assert(lines[2].includes('2024-10-15'));
+  assert(lines[3].includes('2024-10-16'));
+});
+
+test('exportCsv: large dataset', () => {
+  const invoices = [];
+  for (let i = 0; i < 100; i++) {
+    const inv = issueInvoice(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: '2024-10-15',
+        lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+      }).value,
+      []
+    ).value;
+    invoices.push(inv);
+  }
+
+  const result = exportCsv(invoices);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 102); // header + 100 invoices + trailing empty line
+});
+
+test('exportCsv: escape comma in field', () => {
+  // Create an invoice and manually add a comma to test escaping
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoiceWithComma = {
+    ...issuedResult.value,
+    number: 'INV-2024-0001,TEST',
+  };
+
+  const result = exportCsv([invoiceWithComma]);
+
+  const lines = result.split('\n');
+  // Field with comma should be quoted
+  assert(lines[1].includes('"INV-2024-0001,TEST"'));
+});
+
+test('exportCsv: escape double quote in field', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoiceWithQuote = {
+    ...issuedResult.value,
+    number: 'INV"2024',
+  };
+
+  const result = exportCsv([invoiceWithQuote]);
+
+  const lines = result.split('\n');
+  // Double quotes should be escaped and field quoted
+  assert(lines[1].includes('"INV""2024"'));
+});
+
+test('exportCsv: unknown customer ID', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoiceWithUnknownCustomer = {
+    ...issuedResult.value,
+    customerId: 'C-999',
+  };
+
+  const result = exportCsv([invoiceWithUnknownCustomer]);
+
+  const lines = result.split('\n');
+  // Should fall back to using customer ID
+  assert(lines[1].includes('C-999'));
+});
