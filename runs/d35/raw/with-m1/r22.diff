+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal: happy path', () => {
+  const result = lineTotal({ qty: 10, unitPrice: 9500 });
+  assert.deepEqual(result, { ok: true, value: 95000 });
+});
+
+test('lineTotal: calculates correctly for different quantities', () => {
+  assert.deepEqual(lineTotal({ qty: 1, unitPrice: 100 }), { ok: true, value: 100 });
+  assert.deepEqual(lineTotal({ qty: 5, unitPrice: 200 }), { ok: true, value: 1000 });
+  assert.deepEqual(lineTotal({ qty: 100, unitPrice: 50 }), { ok: true, value: 5000 });
+});
+
+test('lineTotal: invalid - missing qty', () => {
+  assert.deepEqual(lineTotal({ unitPrice: 100 }), { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineTotal: invalid - qty is zero', () => {
+  assert.deepEqual(lineTotal({ qty: 0, unitPrice: 100 }), { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineTotal: invalid - qty is negative', () => {
+  assert.deepEqual(lineTotal({ qty: -5, unitPrice: 100 }), { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineTotal: invalid - qty is not an integer', () => {
+  assert.deepEqual(lineTotal({ qty: 5.5, unitPrice: 100 }), { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineTotal: invalid - missing unitPrice', () => {
+  assert.deepEqual(lineTotal({ qty: 10 }), { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineTotal: invalid - unitPrice is negative', () => {
+  assert.deepEqual(lineTotal({ qty: 10, unitPrice: -100 }), { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineTotal: invalid - line is null', () => {
+  assert.deepEqual(lineTotal(null), { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineTotal: invalid - line is undefined', () => {
+  assert.deepEqual(lineTotal(undefined), { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineDiscount: no discount', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 100 });
+  assert.deepEqual(result, { ok: true, value: 0 });
+});
+
+test('lineDiscount: 10% discount', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 100, discountPercent: 10 });
+  assert.deepEqual(result, { ok: true, value: 100 });
+});
+
+test('lineDiscount: 50% discount', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 200, discountPercent: 50 });
+  assert.deepEqual(result, { ok: true, value: 1000 });
+});
+
+test('lineDiscount: fractional discount with rounding', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 100, discountPercent: 2.5 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 25);
+});
+
+test('lineDiscount: clamped at zero', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 100, discountPercent: 0 });
+  assert.deepEqual(result, { ok: true, value: 0 });
+});
+
+test('lineVat: no discount, 21% VAT', () => {
+  const result = lineVat({ qty: 10, unitPrice: 100, vatRate: 21 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 210);
+});
+
+test('lineVat: with discount, 21% VAT', () => {
+  const result = lineVat({ qty: 10, unitPrice: 100, discountPercent: 10, vatRate: 21 });
+  assert.equal(result.ok, true);
+  // Line total: 1000, discount: 100, amount: 900, VAT: 189
+  assert.equal(result.value, 189);
+});
+
+test('lineVat: 9% VAT', () => {
+  const result = lineVat({ qty: 100, unitPrice: 100, vatRate: 9 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 900);
+});
+
+test('lineVat: 0% VAT (exempt)', () => {
+  const result = lineVat({ qty: 10, unitPrice: 100, vatRate: 0 });
+  assert.deepEqual(result, { ok: true, value: 0 });
+});
+
+test('lineVat: fractional VAT with rounding', () => {
+  const result = lineVat({ qty: 10, unitPrice: 100, vatRate: 21 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 210);
+});
+
+test('lineVat: clamped at zero', () => {
+  const result = lineVat({ qty: 10, unitPrice: 100, vatRate: 0 });
+  assert.deepEqual(result, { ok: true, value: 0 });
+});
+
+test('invoiceTotals: happy path with single line', () => {
+  const result = invoiceTotals({
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 10,
+        unitPrice: 9500,
+        vatRate: 21,
+        discountPercent: 5,
+      },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 95000);
+  assert.equal(result.value.discount, 4750);
+  assert.equal(result.value.vat, 18952);
+  assert.equal(result.value.voucher, 0);
+  assert.equal(result.value.total, 109202);
+});
+
+test('invoiceTotals: happy path with multiple lines', () => {
+  const result = invoiceTotals({
+    lines: [
+      { sku: 'SKU1', name: 'Item 1', qty: 10, unitPrice: 100, vatRate: 21 },
+      { sku: 'SKU2', name: 'Item 2', qty: 5, unitPrice: 200, vatRate: 9 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert(result.value.subtotal > 0);
+  assert(result.value.vat > 0);
+});
+
+test('invoiceTotals: total with VAT and no discount', () => {
+  const result = invoiceTotals({
+    lines: [{ sku: 'SKU', name: 'Item', qty: 100, unitPrice: 100, vatRate: 21 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 10000);
+  assert.equal(result.value.discount, 0);
+  assert.equal(result.value.vat, 2100);
+  assert.equal(result.value.total, 12100);
+});
+
+test('invoiceTotals: invalid - invoice is null', () => {
+  assert.deepEqual(invoiceTotals(null), { ok: false, error: 'INVOICE_INVALID' });
+});
+
+test('invoiceTotals: invalid - invoice is undefined', () => {
+  assert.deepEqual(invoiceTotals(undefined), { ok: false, error: 'INVOICE_INVALID' });
+});
+
+test('invoiceTotals: invalid - invoice has no lines property', () => {
+  assert.deepEqual(invoiceTotals({}), { ok: false, error: 'INVOICE_INVALID' });
+});
+
+test('invoiceTotals: invalid - lines is not an array', () => {
+  assert.deepEqual(invoiceTotals({ lines: 'not an array' }), { ok: false, error: 'INVOICE_INVALID' });
+});
+
+test('invoiceTotals: with single line discount', () => {
+  const result = invoiceTotals({
+    lines: [
+      {
+        sku: 'SKU',
+        name: 'Item',
+        qty: 100,
+        unitPrice: 100,
+        vatRate: 21,
+        discountPercent: 10,
+      },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 10000);
+  assert.equal(result.value.discount, 1000);
+  assert.equal(result.value.vat, 1890);
+  assert.equal(result.value.total, 10890);
+});
+
+test('invoiceTotals: with multiple lines and mixed discounts', () => {
+  const result = invoiceTotals({
+    lines: [
+      { sku: 'SKU1', name: 'Item 1', qty: 10, unitPrice: 100, vatRate: 21, discountPercent: 10 },
+      { sku: 'SKU2', name: 'Item 2', qty: 5, unitPrice: 200, vatRate: 9 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert(result.value.discount > 0);
+  assert(result.value.vat > 0);
+});
+
+test('invoiceTotals: discount cannot make total negative', () => {
+  const result = invoiceTotals({
+    lines: [{ sku: 'SKU', name: 'Item', qty: 1, unitPrice: 100, vatRate: 0, discountPercent: 50 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert(result.value.total >= 0);
+});
+
+test('invoiceTotals: total is clamped at 0', () => {
+  const result = invoiceTotals({
+    lines: [
+      {
+        sku: 'SKU',
+        name: 'Item',
+        qty: 1,
+        unitPrice: 100,
+        vatRate: 0,
+        discountPercent: 100,
+      },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.total, 0);
+});
+
+test('invoiceTotals: with mixed VAT rates', () => {
+  const result = invoiceTotals({
+    lines: [
+      { sku: 'SKU1', name: 'Item 1', qty: 10, unitPrice: 100, vatRate: 21 },
+      { sku: 'SKU2', name: 'Item 2', qty: 5, unitPrice: 100, vatRate: 9 },
+      { sku: 'SKU3', name: 'Item 3', qty: 2, unitPrice: 100, vatRate: 0 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 1700);
+  assert(result.value.vat > 0);
+  assert(result.value.total > 0);
+});
+
+test('invoiceTotals: VAT on discounted amounts', () => {
+  const result = invoiceTotals({
+    lines: [
+      {
+        sku: 'SKU',
+        name: 'Item',
+        qty: 100,
+        unitPrice: 100,
+        vatRate: 21,
+        discountPercent: 50,
+      },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  // Subtotal: 10000, discount: 5000, amount: 5000, VAT: 1050
+  assert.equal(result.value.subtotal, 10000);
+  assert.equal(result.value.discount, 5000);
+  assert.equal(result.value.vat, 1050);
+  assert.equal(result.value.total, 6050);
+});
+
+test('invoiceTotals: 100% discount results in 0 total', () => {
+  const result = invoiceTotals({
+    lines: [
+      {
+        sku: 'SKU',
+        name: 'Item',
+        qty: 100,
+        unitPrice: 100,
+        vatRate: 21,
+        discountPercent: 100,
+      },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.discount, 10000);
+  assert.equal(result.value.vat, 0);
+  assert.equal(result.value.total, 0);
+});
+
+test('invoiceTotals: with voucher', () => {
+  const result = invoiceTotals({
+    lines: [
+      {
+        sku: 'SKU',
+        name: 'Item',
+        qty: 100,
+        unitPrice: 100,
+        vatRate: 21,
+        discountPercent: 10,
+      },
+    ],
+    voucher: { code: 'SAVE50', amount: 5000 },
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher, 5000);
+  // Subtotal: 10000, discount: 1000, VAT: 1890, total: 10890, after voucher: 5890
+  assert.equal(result.value.total, 5890);
+});
+
+test('invoiceTotals: large invoice with many lines', () => {
+  const lines = [];
+  for (let i = 0; i < 100; i++) {
+    lines.push({
+      sku: `SKU-${i}`,
+      name: `Item ${i}`,
+      qty: 10,
+      unitPrice: 1000,
+      vatRate: 21,
+    });
+  }
+
+  const result = invoiceTotals({ lines });
+
+  assert.equal(result.ok, true);
+  assert(result.value.subtotal > 0);
+  assert(result.value.vat > 0);
+  assert(result.value.total > 0);
+});
