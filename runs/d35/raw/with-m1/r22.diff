+import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
+
+export function isValidDiscount(discountPercent) {
+  return typeof discountPercent === 'number' && discountPercent >= 0 && discountPercent <= 100;
+}
+
+/**
+ * Calculate the total amount for a line item (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineTotal(line) {
+  if (!line || !Number.isInteger(line.qty) || line.qty <= 0) {
+    return fail('LINE_INVALID');
+  }
+  if (typeof line.unitPrice !== 'number' || line.unitPrice < 0) {
+    return fail('LINE_INVALID');
+  }
+  return ok(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount amount for a line item.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineDiscount(line) {
+  const totalResult = lineTotal(line);
+  if (!totalResult.ok) return totalResult;
+
+  if (!line.discountPercent) {
+    return ok(0);
+  }
+
+  if (!isValidDiscount(line.discountPercent)) {
+    return fail('DISCOUNT_INVALID');
+  }
+
+  const discount = roundCents(totalResult.value * line.discountPercent / 100);
+  return ok(Math.max(0, discount));
+}
+
+/**
+ * Calculate the VAT amount for a line item.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }}
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineVat(line) {
+  const totalResult = lineTotal(line);
+  if (!totalResult.ok) return totalResult;
+
+  const discountResult = lineDiscount(line);
+  if (!discountResult.ok) return discountResult;
+
+  const amountAfterDiscount = totalResult.value - discountResult.value;
+  if (typeof line.vatRate !== 'number' || line.vatRate < 0) {
+    return fail('LINE_INVALID');
+  }
+
+  const vat = roundCents(amountAfterDiscount * line.vatRate / 100);
+  return ok(Math.max(0, vat));
+}
+
+/**
+ * Calculate totals for an invoice: subtotal, discount, VAT, voucher, and total.
+ * @param {{ lines: Array, voucher?: { code: string, amount: number } }}
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, voucher: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines)) {
+    return fail('INVOICE_INVALID');
+  }
+
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
+    const totalResult = lineTotal(line);
+    if (!totalResult.ok) return totalResult;
+    subtotal += totalResult.value;
+
+    const discountResult = lineDiscount(line);
+    if (!discountResult.ok) return discountResult;
+    discount += discountResult.value;
+
+    const vatResult = lineVat(line);
+    if (!vatResult.ok) return vatResult;
+    vat += vatResult.value;
+  }
+
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+
+  return ok({ subtotal, discount, vat, voucher, total });
+}
