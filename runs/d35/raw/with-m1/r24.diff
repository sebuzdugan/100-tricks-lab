+test('dashboard: large invoice set', () => {
+  const invoices = [];
+  for (let i = 0; i < 100; i++) {
+    const status = i % 4;
+    const issueDate = `2024-${String((i % 12) + 1).padStart(2, '0')}-01`;
+
+    let invoice = createInvoice({
+      customerId: `C-${String((i % 20) + 1).padStart(3, '0')}`,
+      issueDate,
+      lines: [{ sku: 'DEV-HOUR', qty: (i % 10) + 1 }],
+      terms: 'NET14',
+    }).value;
+
+    if (status === 0) {
+      // Draft - don't issue
+    } else if (status === 1) {
+      // Issued
+      invoice = issueInvoice(invoice, []).value;
+    } else if (status === 2) {
+      // Partially paid
+      invoice = issueInvoice(invoice, []).value;
+      invoice = recordPayment(invoice, { amount: 50000, date: '2024-10-16' }).value;
+    } else {
+      // Paid
+      invoice = issueInvoice(invoice, []).value;
+      const totalDue = 109202 * ((i % 10) + 1) / 10;
+      invoice = recordPayment(invoice, { amount: Math.round(totalDue), date: '2024-10-16' }).value;
+    }
+
+    invoices.push(invoice);
+  }
+
+  const result = dashboard(invoices, '2024-10-20');
+
+  assert(result.counts.draft > 0);
+  assert(result.counts.issued > 0);
+  assert(result.counts.paid > 0);
+  assert(result.outstanding >= 0);
+  assert(result.overdue.count >= 0);
+  assert.equal(result.topCustomers.length <= 3, true);
+});
+
+test('dashboard: does not mutate input', () => {
