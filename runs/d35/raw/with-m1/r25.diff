 export function renderInvoiceText(invoice) {
@@ -16,18 +16,43 @@ export function renderInvoiceText(invoice) {
   const lineItems = invoice.lines.map((line) => {
     const lineTotalResult = lineTotal(line);
     const total = lineTotalResult.ok ? lineTotalResult.value : 0;
-    return `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    const lines = [];
+    lines.push(`${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`);
+
+    if (line.discountPercent) {
+      const discountResult = lineDiscount(line);
+      const discount = discountResult.ok ? discountResult.value : 0;
+      lines.push(`  Discount: ${formatEuros(discount)}`);
+    }
+
+    return lines.join('\n');
   });
 
   const totalsResult = invoiceTotals(invoice);
   const vat = totalsResult.ok ? totalsResult.value.vat : 0;
+  const voucher = totalsResult.ok ? totalsResult.value.voucher : 0;
   const total = totalsResult.ok ? totalsResult.value.total : 0;
 
   const lines = [header, customerName, ...lineItems];
+
   if (vat > 0) {
     lines.push(`VAT: ${formatEuros(vat)}`);
   }
+
+  if (invoice.voucher) {
+    lines.push(`Voucher ${invoice.voucher.code}: -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   lines.push(`Total: ${formatEuros(total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
