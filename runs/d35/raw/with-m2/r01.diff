+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice: success with one line item', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+
+  const line = result.value.lines[0];
+  assert.equal(line.sku, 'DEV-HOUR');
+  assert.equal(line.name, 'Development (hour)');
+  assert.equal(line.qty, 8);
+  assert.equal(line.unitPrice, 9500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice: success with multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.lines.length, 3);
+
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[0].qty, 5);
+
+  assert.equal(result.value.lines[1].name, 'Development (hour)');
+  assert.equal(result.value.lines[1].qty, 10);
+
+  assert.equal(result.value.lines[2].name, 'Logo package');
+  assert.equal(result.value.lines[2].qty, 1);
+  assert.equal(result.value.lines[2].unitPrice, 120000);
+});
+
+test('createInvoice: preserves original lines array', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 5 }];
+  const original = [...lines];
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+
+  assert.deepEqual(lines, original);
+});
+
+test('createInvoice: error CUSTOMER_NOT_FOUND', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice: error DATE_INVALID - wrong format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '10/07/2026',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: error DATE_INVALID - invalid date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: error DATE_INVALID - not a string', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: 20261007,
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: error DATE_INVALID - missing date part', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: error NO_LINES - empty array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice: error NO_LINES - not an array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice: error QTY_INVALID - not an integer', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5.5 }],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: error QTY_INVALID - zero', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: error QTY_INVALID - negative', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: error UNKNOWN_SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'INVALID-SKU', qty: 1 }],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice: error UNKNOWN_SKU in second line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'FAKE-SKU', qty: 1 },
+    ],
+  });
+
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice: preserves different VAT rates from catalogue', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 1 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
