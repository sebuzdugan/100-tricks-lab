+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a draft invoice from a customer id and line items.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customer = getCustomer(customerId);
+  if (!customer.ok) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Validate issueDate format
+  if (!isValidDate(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines array is not empty
+  if (!Array.isArray(lines) || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Get product from catalogue
+    const product = getProduct(line.sku);
+    if (!product.ok) {
+      return fail('UNKNOWN_SKU');
+    }
+
+    const p = product.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: p.name,
+      qty: line.qty,
+      unitPrice: p.unitPrice,
+      vatRate: p.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
+
+/**
+ * Check if a date string is valid and in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(dateStr);
+  if (!match) return false;
+  const date = new Date(dateStr + 'T00:00:00Z');
+  return date instanceof Date && !isNaN(date) && date.toISOString().startsWith(dateStr);
+}
