+/**
+ * Add or increase a line item on a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string, qty: number, unitPrice: number, vatRate: number, name: string }> }} invoice
+ * @param {{ sku: string, qty: number }} item
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Validate qty is a positive integer
+  if (!Number.isInteger(qty) || qty <= 0) {
+    return fail('QTY_INVALID');
+  }
+
+  // Get product from catalogue
+  const product = getProduct(sku);
+  if (!product.ok) {
+    return fail('UNKNOWN_SKU');
+  }
+
+  const p = product.value;
+
+  // Copy lines array and check if SKU already exists
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+  const existingIndex = newLines.findIndex((line) => line.sku === sku);
+
+  if (existingIndex !== -1) {
+    // Increase qty of existing line
+    newLines[existingIndex].qty += qty;
+  } else {
+    // Add new line at the end
+    newLines.push({
+      sku,
+      name: p.name,
+      qty,
+      unitPrice: p.unitPrice,
+      vatRate: p.vatRate,
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line item from a draft invoice.
+ * @param {{ status: string, lines: Array<{ sku: string }> }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Find the line with this SKU
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+
+  if (lineIndex === -1) {
+    return fail('LINE_NOT_FOUND');
+  }
+
+  // Check if it's the last line
+  if (invoice.lines.length === 1) {
+    return fail('NO_LINES');
+  }
+
+  // Copy lines array without the line at lineIndex
+  const newLines = invoice.lines.filter((_, index) => index !== lineIndex);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
