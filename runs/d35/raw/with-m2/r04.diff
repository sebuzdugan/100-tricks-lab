@@ -0,0 +1,71 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber: first invoice of the year', () => {
+  const result = nextInvoiceNumber([], '2026-01-15');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: second invoice of the year', () => {
+  const result = nextInvoiceNumber(['INV-2026-0001'], '2026-02-15');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: multiple invoices', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const result = nextInvoiceNumber(existing, '2026-05-15');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber: out of order existing numbers', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'];
+  const result = nextInvoiceNumber(existing, '2026-05-15');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber: large counter', () => {
+  const existing = ['INV-2026-0099', 'INV-2026-0050', 'INV-2026-0100'];
+  const result = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(result, 'INV-2026-0101');
+});
+
+test('nextInvoiceNumber: different years', () => {
+  const existing = ['INV-2025-0005', 'INV-2026-0002', 'INV-2027-0001'];
+  const result = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(result, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber: new year resets counter', () => {
+  const existing = ['INV-2025-0099', 'INV-2025-0100'];
+  const result = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: ignores non-matching numbers', () => {
+  const existing = ['INV-2026-0001', 'SOME-OTHER-001', 'INV-2025-0010', 'INV-2027-0005'];
+  const result = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: ignores malformed numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-abc', 'INV-2026-', 'INV-2026-00001'];
+  const result = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: counter format with leading zeros', () => {
+  const existing = ['INV-2026-0009'];
+  const result = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(result, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber: four-digit padding consistency', () => {
+  const existing = [];
+  const r1 = nextInvoiceNumber(existing, '2026-01-01');
+  const r2 = nextInvoiceNumber(['INV-2026-0001'], '2026-01-01');
+
+  assert.equal(r1, 'INV-2026-0001');
+  assert.equal(r2, 'INV-2026-0002');
+  assert.equal(r1.length, r2.length);
+});
