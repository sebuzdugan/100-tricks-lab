+/**
+ * Generate the next invoice number for a given date.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Filter for numbers from this year and extract counters
+  const thisYearCounters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return Number(counter);
+    })
+    .filter((n) => !isNaN(n));
+
+  // Find max counter, default to 0 if none exist
+  const maxCounter = thisYearCounters.length > 0 ? Math.max(...thisYearCounters) : 0;
+
+  // Return next counter, zero-padded to 4 digits
+  return `${prefix}${String(maxCounter + 1).padStart(4, '0')}`;
+}
