@@ -0,0 +1,203 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText: draft invoice with one line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+  assert.ok(text.includes('8 ×'));
+  assert.ok(text.includes('Development (hour)'));
+  assert.ok(text.includes('€95.00'));
+  assert.ok(text.includes('€760.00'));
+  assert.ok(text.includes('Total: €760.00'));
+});
+
+test('renderInvoiceText: draft invoice with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.ok(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Blue Fern Bakery'));
+  assert.ok(text.includes('8 × Development (hour)'));
+  assert.ok(text.includes('5 × Design work (hour)'));
+  assert.ok(text.includes('Total:'));
+});
+
+test('renderInvoiceText: issued invoice with number', () => {
+  const createResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(createResult.ok);
+
+  const issueResult = issueInvoice(createResult.value, []);
+  assert.ok(issueResult.ok);
+
+  const text = renderInvoiceText(issueResult.value);
+
+  assert.ok(text.includes('INV-2026-0001'));
+  assert.ok(!text.includes('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText: formats amounts as euros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.ok(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  // Logo package costs 120000 cents = €1,200.00
+  assert.ok(text.includes('€1,200.00'));
+  assert.ok(text.includes('Total: €1,200.00'));
+});
+
+test('renderInvoiceText: small amounts formatted correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 5 }],
+  });
+
+  assert.ok(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  // Sticker costs 50 cents = €0.50 per unit, 5 = €2.50 total
+  assert.ok(text.includes('€0.50'));
+  assert.ok(text.includes('Total: €2.50'));
+});
+
+test('renderInvoiceText: line format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(result.ok);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.ok(lines[2].includes('8 ×'));
+  assert.ok(lines[2].includes('Development (hour)'));
+  assert.ok(lines[2].includes('@'));
+  assert.ok(lines[2].includes('='));
+  assert.ok(lines[3].includes('Total:'));
+});
+
+test('renderInvoiceText: multiple lines format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  });
+
+  assert.ok(result.ok);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines.length, 6); // DRAFT, customer, 3 lines, total
+  assert.ok(lines[2].includes('Development (hour)'));
+  assert.ok(lines[3].includes('Design work (hour)'));
+  assert.ok(lines[4].includes('Copywriting (hour)'));
+  assert.ok(lines[5].includes('Total:'));
+});
+
+test('renderInvoiceText: total calculation', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.ok(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  // 10 * 9500 = 95000, 5 * 8500 = 42500, total = 137500 = €1,375.00
+  assert.ok(text.includes('Total: €1,375.00'));
+});
+
+test('renderInvoiceText: different customers', () => {
+  const c1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const c2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.ok(c1.ok);
+  assert.ok(c2.ok);
+
+  const text1 = renderInvoiceText(c1.value);
+  const text2 = renderInvoiceText(c2.value);
+
+  assert.ok(text1.includes('Northwind Studio'));
+  assert.ok(text2.includes('Kite & Co'));
+  assert.notEqual(text1, text2);
+});
+
+test('renderInvoiceText: issued invoice from workflow', () => {
+  const createResult = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'SUPPORT-HOUR', qty: 20 },
+      { sku: 'HOST-MONTH', qty: 3 },
+    ],
+  });
+
+  assert.ok(createResult.ok);
+
+  const issueResult = issueInvoice(createResult.value, ['INV-2026-0001']);
+  assert.ok(issueResult.ok);
+
+  const text = renderInvoiceText(issueResult.value);
+
+  assert.ok(text.includes('INV-2026-0002'));
+  assert.ok(text.includes('Orchard Health'));
+  assert.ok(text.includes('20 × Support (hour)'));
+  assert.ok(text.includes('3 × Website hosting (month)'));
+  assert.ok(text.includes('€72.50'));
+  assert.ok(text.includes('€15.00'));
+  assert.ok(text.includes('Total:'));
+});
