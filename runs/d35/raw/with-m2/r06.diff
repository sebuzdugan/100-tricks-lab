+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1, name: 'Development (hour)', unitPrice: 9500, vatRate: 21, discountPercent: 110 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.total >= 0);
+  assert.equal(totals.total, 0);
+});
+
+test('addLine: with discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(result.ok);
+  const invoice = result.value;
+
+  const addResult = addLine(invoice, { sku: 'DES-HOUR', qty: 5, discountPercent: 15 });
+  assert.ok(addResult.ok);
+  assert.equal(addResult.value.lines[1].discountPercent, 15);
+});
+
+test('addLine: error DISCOUNT_INVALID', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(result.ok);
+  const invoice = result.value;
+
+  const addResult = addLine(invoice, { sku: 'DES-HOUR', qty: 5, discountPercent: 150 });
+  assert.ok(!addResult.ok);
+  assert.equal(addResult.error, 'DISCOUNT_INVALID');
+});
