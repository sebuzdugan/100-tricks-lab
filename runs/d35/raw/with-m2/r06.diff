+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.ok(result.ok);
+  const totals = invoiceTotals(result.value);
+  // Dev: 8 * 9500 = 76000, 100% = 76000
+  // Des: 5 * 8500 = 42500, 0% = 0
+  // Subtotal: 118500, Discount: 76000, Total: 42500
+  assert.equal(totals.subtotal, 118500);
+  assert.equal(totals.discount, 76000);
+  assert.equal(totals.total, 42500);
+});
+
+test('invoiceTotals: clamps negative total to 0', () => {
