+});
+
+test('createInvoice: with decimal discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8, discountPercent: 12.5 }],
+  });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.lines[0].discountPercent, 12.5);
+});
+
+test('createInvoice: with zero discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
