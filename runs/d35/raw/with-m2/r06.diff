+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 76000);
+});
+
+test('invoiceTotals: with single line discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8, discountPercent: 10 }],
+  });
+
+  assert.ok(result.ok);
+  const totals = invoiceTotals(result.value);
+  // 8 * 9500 = 76000, 10% = 7600
+  assert.equal(totals.subtotal, 76000);
+  assert.equal(totals.discount, 7600);
+  assert.equal(totals.total, 68400);
+});
+
+test('invoiceTotals: with multiple line discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
