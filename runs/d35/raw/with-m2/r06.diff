+  });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice: with 100 discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8, discountPercent: 100 }],
+  });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.lines[0].discountPercent, 100);
+});
+
+test('createInvoice: error DISCOUNT_INVALID - negative', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
