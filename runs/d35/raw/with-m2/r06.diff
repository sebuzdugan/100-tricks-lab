+      { sku: 'DES-HOUR', qty: 5, discountPercent: 20 },
+    ],
+  });
+
+  assert.ok(result.ok);
+  const totals = invoiceTotals(result.value);
+  // Dev: 8 * 9500 = 76000, 10% = 7600
+  // Des: 5 * 8500 = 42500, 20% = 8500
+  // Subtotal: 118500, Discount: 16100, Total: 102400
+  assert.equal(totals.subtotal, 118500);
+  assert.equal(totals.discount, 16100);
+  assert.equal(totals.total, 102400);
+});
+
+test('invoiceTotals: with 100% discount on one line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
