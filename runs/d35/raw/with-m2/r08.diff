@@ -34,12 +34,21 @@ export function renderInvoiceText(invoice) {
   const totals = invoiceTotals(invoice);
   const output = [numberLine, customerName, ...lineItems];
 
-  // Add subtotal and discount if discount exists
-  if (totals.discount > 0) {
+  // Add subtotal if there are discounts or VAT
+  if (totals.discount > 0 || totals.vat > 0) {
     output.push(`Subtotal: ${formatEuros(totals.subtotal)}`);
+  }
+
+  // Add discount line if discount exists
+  if (totals.discount > 0) {
     output.push(`Discount: -${formatEuros(totals.discount)}`);
   }
 
+  // Add VAT line if VAT exists
+  if (totals.vat > 0) {
+    output.push(`VAT: +${formatEuros(totals.vat)}`);
+  }
+
   output.push(`Total: ${formatEuros(totals.total)}`);
 
   return output.join('\n');
