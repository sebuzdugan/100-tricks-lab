@@ -95,10 +96,22 @@ export function invoiceTotals(invoice) {
     const lineDiscount = Math.round(lineTotal(line) * percent / 100);
     return sum + lineDiscount;
   }, 0);
-  const total = Math.max(0, subtotal - discount);
+
+  // Calculate VAT per line on the discounted amount, rounded per line
+  const vat = invoice.lines.reduce((sum, line) => {
+    const total = lineTotal(line);
+    const lineDiscountPercent = line.discountPercent ?? 0;
+    const lineDiscount = Math.round(total * lineDiscountPercent / 100);
+    const discountedAmount = total - lineDiscount;
+    const lineVat = roundCents(discountedAmount * line.vatRate / 100);
+    return sum + lineVat;
+  }, 0);
+
+  const total = Math.max(0, subtotal - discount + vat);
   return {
     subtotal,
     discount,
+    vat,
     total,
   };
 }
diff --git a/src/render.js b/src/render.js
