diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..c16e631
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,129 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate: accepts valid dates', () => {
+  assert.ok(isValidDate('2026-01-01'));
+  assert.ok(isValidDate('2026-10-07'));
+  assert.ok(isValidDate('2026-12-31'));
+});
+
+test('isValidDate: rejects invalid format', () => {
+  assert.ok(!isValidDate('01-01-2026'));
+  assert.ok(!isValidDate('2026/01/01'));
+  assert.ok(!isValidDate('2026-1-1'));
+  assert.ok(!isValidDate('2026-01-01 '));
+  assert.ok(!isValidDate(' 2026-01-01'));
+});
+
+test('isValidDate: rejects invalid dates', () => {
+  assert.ok(!isValidDate('2026-02-30'));
+  assert.ok(!isValidDate('2026-13-01'));
+  assert.ok(!isValidDate('2026-00-01'));
+});
+
+test('isValidDate: rejects non-string', () => {
+  assert.ok(!isValidDate(20260101));
+  assert.ok(!isValidDate(null));
+  assert.ok(!isValidDate(undefined));
+});
+
+test('isValidDate: handles leap years', () => {
+  assert.ok(isValidDate('2024-02-29'));
+  assert.ok(!isValidDate('2025-02-29'));
+});
+
+test('addDays: adds positive days', () => {
+  assert.equal(addDays('2026-01-01', 1), '2026-01-02');
+  assert.equal(addDays('2026-01-01', 10), '2026-01-11');
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+});
+
+test('addDays: adds negative days', () => {
+  assert.equal(addDays('2026-01-02', -1), '2026-01-01');
+  assert.equal(addDays('2026-01-10', -5), '2026-01-05');
+  assert.equal(addDays('2027-01-01', -365), '2026-01-01');
+});
+
+test('addDays: handles month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-01-31', 28), '2026-02-28');
+  assert.equal(addDays('2026-02-01', -1), '2026-01-31');
+});
+
+test('addDays: handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays: handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-03-01', -1), '2024-02-29');
+});
+
+test('addDays: zero days returns same date', () => {
+  assert.equal(addDays('2026-01-01', 0), '2026-01-01');
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays: returns string in YYYY-MM-DD format', () => {
+  const result = addDays('2026-01-01', 5);
+  assert.ok(/^\d{4}-\d{2}-\d{2}$/.test(result));
+});
+
+test('daysBetween: calculates days between dates', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+  assert.equal(daysBetween('2026-01-01', '2026-01-11'), 10);
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+});
+
+test('daysBetween: handles negative differences', () => {
+  assert.equal(daysBetween('2026-01-02', '2026-01-01'), -1);
+  assert.equal(daysBetween('2026-01-11', '2026-01-01'), -10);
+  assert.equal(daysBetween('2027-01-01', '2026-01-01'), -365);
+});
+
+test('daysBetween: same date returns 0', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-01'), 0);
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween: handles month boundaries', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-02-01', '2026-01-31'), -1);
+});
+
+test('daysBetween: handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween: handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+});
+
+test('daysBetween: returns whole days', () => {
+  // All dates are at 00:00:00 UTC, so differences should be whole days
+  const result = daysBetween('2026-01-01', '2026-01-05');
+  assert.ok(Number.isInteger(result));
+  assert.equal(result, 4);
+});
+
+test('addDays and daysBetween are inverse operations', () => {
+  const date = '2026-01-15';
+  const days = 10;
+
+  const later = addDays(date, days);
+  assert.equal(daysBetween(date, later), days);
+
+  const earlier = addDays(date, -days);
+  assert.equal(daysBetween(earlier, date), days);
+});
+
+test('round-trip addDays', () => {
+  const date = '2026-06-15';
+  const result = addDays(addDays(date, 100), -100);
+  assert.equal(result, date);
+});
