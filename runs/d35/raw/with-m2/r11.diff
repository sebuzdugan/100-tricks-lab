+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('balanceDue: returns full amount for issued invoice with no payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+
+  const due = balanceDue(issued.value);
+  // Line total: 76000, VAT 21% = 15960, total = 91960
+  assert.equal(due, 91960);
+});
+
+test('balanceDue: returns zero for paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+  const invoice = issued.value;
+
+  const due = balanceDue(invoice);
+  const payment1 = recordPayment(invoice, { amount: due, date: '2026-10-10' });
+  assert.ok(payment1.ok);
+
+  assert.equal(balanceDue(payment1.value), 0);
+});
+
+test('balanceDue: returns remaining amount for partially paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+  const invoice = issued.value;
+
+  const due = balanceDue(invoice);
+  const payment1 = recordPayment(invoice, { amount: 30000, date: '2026-10-10' });
+  assert.ok(payment1.ok);
+
+  assert.equal(balanceDue(payment1.value), due - 30000);
+});
+
+test('recordPayment: records payment on issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+
+  const result = recordPayment(issued.value, { amount: 50000, date: '2026-10-10' });
+  assert.ok(result.ok);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment: sets status to partially_paid when partially paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+  const invoice = issued.value;
+
+  const due = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: Math.floor(due / 2), date: '2026-10-10' });
+  assert.ok(result.ok);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment: sets status to paid when fully paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+  const invoice = issued.value;
+
+  const due = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: due, date: '2026-10-10' });
+  assert.ok(result.ok);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment: multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+  let invoice = issued.value;
+
+  const payment1 = recordPayment(invoice, { amount: 30000, date: '2026-10-10' });
+  assert.ok(payment1.ok);
+  assert.equal(payment1.value.status, 'partially_paid');
+  assert.equal(payment1.value.payments.length, 1);
+
+  invoice = payment1.value;
+  const payment2 = recordPayment(invoice, { amount: 40000, date: '2026-10-15' });
+  assert.ok(payment2.ok);
+  assert.equal(payment2.value.payments.length, 2);
+  assert.equal(payment2.value.payments[0].amount, 30000);
+  assert.equal(payment2.value.payments[1].amount, 40000);
+});
+
+test('recordPayment: error NOT_ISSUED for draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(result.ok);
+  const invoice = result.value;
+
+  const payment = recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.ok(!payment.ok);
+  assert.equal(payment.error, 'NOT_ISSUED');
+});
+
+test('recordPayment: error NOT_ISSUED for paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+  let invoice = issued.value;
+
+  const due = balanceDue(invoice);
+  const payment1 = recordPayment(invoice, { amount: due, date: '2026-10-10' });
+  assert.ok(payment1.ok);
+
+  invoice = payment1.value;
+  const payment2 = recordPayment(invoice, { amount: 1000, date: '2026-10-15' });
+  assert.ok(!payment2.ok);
+  assert.equal(payment2.error, 'NOT_ISSUED');
+});
+
+test('recordPayment: error AMOUNT_INVALID for non-positive', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+
+  const result1 = recordPayment(issued.value, { amount: 0, date: '2026-10-10' });
+  assert.ok(!result1.ok);
+  assert.equal(result1.error, 'AMOUNT_INVALID');
+
+  const result2 = recordPayment(issued.value, { amount: -1000, date: '2026-10-10' });
+  assert.ok(!result2.ok);
+  assert.equal(result2.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: error AMOUNT_INVALID for non-integer', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+
+  const result = recordPayment(issued.value, { amount: 50000.5, date: '2026-10-10' });
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: error DATE_INVALID', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+
+  const result = recordPayment(issued.value, { amount: 50000, date: '10/07/2026' });
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('recordPayment: error OVERPAYMENT', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+  const invoice = issued.value;
+
+  const due = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: due + 1000, date: '2026-10-10' });
+  assert.ok(!result.ok);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment: does not mutate original invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+  const invoice = issued.value;
+
+  const original = JSON.stringify(invoice);
+  recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+  assert.equal(JSON.stringify(invoice), original);
+});
+
+test('recordPayment: creates payments array if missing', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.ok(invoiceResult.ok);
+  const issued = issueInvoice(invoiceResult.value, []);
+  assert.ok(issued.ok);
+  const invoice = issued.value;
+
+  // New issued invoices don't have a payments array initially
+  assert.ok(!invoice.payments);
+
+  const due = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: Math.floor(due / 2), date: '2026-10-10' });
+  assert.ok(result.ok, `recordPayment failed: ${result.error}`);
+  assert.ok(Array.isArray(result.value.payments));
+  assert.equal(result.value.payments.length, 1);
+});
