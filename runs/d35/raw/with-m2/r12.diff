@@ -1,6 +1,6 @@
 import test from 'node:test';
 import assert from 'node:assert/strict';
-import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+import { isValidDate, addDays, daysBetween, calculateDueDate } from '../src/dates.js';
 
 test('isValidDate: accepts valid dates', () => {
   assert.ok(isValidDate('2026-01-01'));
@@ -127,3 +127,47 @@ test('round-trip addDays', () => {
   const result = addDays(addDays(date, 100), -100);
   assert.equal(result, date);
 });
+
+test('calculateDueDate: NET14 adds 14 days', () => {
+  assert.equal(calculateDueDate('2026-01-01', 'NET14'), '2026-01-15');
+  assert.equal(calculateDueDate('2026-10-07', 'NET14'), '2026-10-21');
+});
+
+test('calculateDueDate: NET30 adds 30 days', () => {
+  assert.equal(calculateDueDate('2026-01-01', 'NET30'), '2026-01-31');
+  assert.equal(calculateDueDate('2026-10-07', 'NET30'), '2026-11-06');
+});
+
+test('calculateDueDate: NET30 adds 30 days across year boundary', () => {
+  assert.equal(calculateDueDate('2026-12-02', 'NET30'), '2027-01-01');
+});
+
+test('calculateDueDate: EOM returns last day of issue month', () => {
+  assert.equal(calculateDueDate('2026-01-01', 'EOM'), '2026-01-31');
+  assert.equal(calculateDueDate('2026-01-15', 'EOM'), '2026-01-31');
+  assert.equal(calculateDueDate('2026-01-31', 'EOM'), '2026-01-31');
+});
+
+test('calculateDueDate: EOM for February in leap year', () => {
+  assert.equal(calculateDueDate('2024-02-01', 'EOM'), '2024-02-29');
+  assert.equal(calculateDueDate('2024-02-15', 'EOM'), '2024-02-29');
+});
+
+test('calculateDueDate: EOM for February in non-leap year', () => {
+  assert.equal(calculateDueDate('2026-02-01', 'EOM'), '2026-02-28');
+  assert.equal(calculateDueDate('2026-02-15', 'EOM'), '2026-02-28');
+});
+
+test('calculateDueDate: EOM for April (30 days)', () => {
+  assert.equal(calculateDueDate('2026-04-01', 'EOM'), '2026-04-30');
+});
+
+test('calculateDueDate: EOM for December', () => {
+  assert.equal(calculateDueDate('2026-12-15', 'EOM'), '2026-12-31');
+});
+
+test('calculateDueDate: invalid terms returns null', () => {
+  assert.equal(calculateDueDate('2026-01-01', 'NET60'), null);
+  assert.equal(calculateDueDate('2026-01-01', 'INVALID'), null);
+  assert.equal(calculateDueDate('2026-01-01', ''), null);
+});
