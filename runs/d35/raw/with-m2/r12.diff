@@ -37,3 +37,30 @@ export function daysBetween(a, b) {
   const msPerDay = 24 * 60 * 60 * 1000;
   return Math.round((dateB - dateA) / msPerDay);
 }
+
+/**
+ * Calculate due date based on payment terms.
+ * NET14: 14 days after issue date
+ * NET30: 30 days after issue date
+ * EOM: last day of the issue date's month
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string|null} - due date in YYYY-MM-DD format, or null if terms invalid
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-');
+    const nextMonth = new Date(`${year}-${month}-01T00:00:00Z`);
+    nextMonth.setUTCMonth(nextMonth.getUTCMonth() + 1);
+    const lastDay = new Date(nextMonth);
+    lastDay.setUTCDate(0);
+    return lastDay.toISOString().split('T')[0];
+  }
+  return null;
+}
