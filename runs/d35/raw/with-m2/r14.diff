+test('statement: calculates due correctly for unpaid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
