+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement listing unpaid invoices.
+ * @param {string} customerId - the customer ID
+ * @param {Array<{ customerId: string, number: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array, voucher?: { amount: number } }>} invoices - all invoices
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists
+  const customer = getCustomer(customerId);
+  if (!customer.ok) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Normalize the customer ID for comparison
+  const normalizedId = normalizeId(customerId);
+
+  // Filter invoices for this customer with status issued or partially_paid and issueDate <= asOf
+  const relevantInvoices = invoices
+    .filter((inv) => inv.customerId === normalizedId)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate))
+    .map((inv) => {
+      const totals = invoiceTotals(inv);
+      const due = balanceDue(inv);
+      return {
+        number: inv.number,
+        issueDate: inv.issueDate,
+        dueDate: inv.dueDate,
+        total: totals.total,
+        due,
+      };
+    });
+
+  // Calculate total due
+  const totalDue = relevantInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedId,
+    invoices: relevantInvoices,
+    totalDue,
+  });
+}
