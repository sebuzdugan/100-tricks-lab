+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement: returns customer statement with issued invoices', () => {
+  // Create invoices
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(inv1Result.ok);
+  const issued1 = issueInvoice(inv1Result.value, []);
+  assert.ok(issued1.ok);
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.ok(inv2Result.ok);
+  const issued2 = issueInvoice(inv2Result.value, [issued1.value.number]);
+  assert.ok(issued2.ok);
+
+  const result = statement('C-001', [issued1.value, issued2.value], '2026-12-31');
+  assert.ok(result.ok);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 2);
+  assert.ok(result.value.totalDue > 0);
+});
+
+test('statement: filters by issueDate', () => {
+  // Create invoices
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(inv1Result.ok);
+  const issued1 = issueInvoice(inv1Result.value, []);
+  assert.ok(issued1.ok);
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.ok(inv2Result.ok);
+  const issued2 = issueInvoice(inv2Result.value, [issued1.value.number]);
+  assert.ok(issued2.ok);
+
+  const result = statement('C-001', [issued1.value, issued2.value], '2026-02-28');
+  assert.ok(result.ok);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-01-15');
+});
+
+test('statement: includes both issued and partially_paid invoices', () => {
+  // Create first invoice
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(inv1Result.ok);
+  const issued1 = issueInvoice(inv1Result.value, []);
+  assert.ok(issued1.ok);
+
+  // Create second invoice
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.ok(inv2Result.ok);
+  const issued2 = issueInvoice(inv2Result.value, [issued1.value.number]);
+  assert.ok(issued2.ok);
+
+  // Record partial payment on second invoice
+  const paymentResult = recordPayment(issued2.value, { amount: 10000, date: '2026-02-20' });
+  assert.ok(paymentResult.ok);
+  const partiallyPaid = paymentResult.value;
+
+  const result = statement('C-001', [issued1.value, partiallyPaid], '2026-12-31');
+  assert.ok(result.ok);
+  assert.equal(result.value.invoices.length, 2);
+});
+
