+  });
+  assert.ok(invResult.ok);
+  const issued = issueInvoice(invResult.value, []);
+  assert.ok(issued.ok);
+
+  const paymentResult = recordPayment(issued.value, { amount: 91960, date: '2026-01-20' });
+  assert.ok(paymentResult.ok);
+
