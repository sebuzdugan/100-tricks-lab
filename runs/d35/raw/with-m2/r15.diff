+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote: create credit note for issued invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(invResult.ok);
+  const issued = issueInvoice(invResult.value, []);
+  assert.ok(issued.ok);
+
+  const creditResult = createCreditNote(issued.value, { amount: 10000, reason: 'Discount', date: '2026-01-20' }, []);
+  assert.ok(creditResult.ok);
+  assert.equal(creditResult.value.number, 'CN-2026-0001');
+  assert.equal(creditResult.value.invoiceNumber, issued.value.number);
+  assert.equal(creditResult.value.customerId, 'C-002');
+  assert.equal(creditResult.value.amount, 10000);
+  assert.equal(creditResult.value.reason, 'Discount');
+  assert.equal(creditResult.value.date, '2026-01-20');
+});
+
+test('createCreditNote: creates credit note for partially paid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(invResult.ok);
+  const issued = issueInvoice(invResult.value, []);
+  assert.ok(issued.ok);
+
+  const paymentResult = recordPayment(issued.value, { amount: 30000, date: '2026-01-20' });
+  assert.ok(paymentResult.ok);
+
+  const creditResult = createCreditNote(paymentResult.value, { amount: 5000, reason: 'Adjustment', date: '2026-01-25' }, []);
+  assert.ok(creditResult.ok);
+  assert.equal(creditResult.value.number, 'CN-2026-0001');
+});
+
