+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Get invoices that are overdue as of a given date.
+ * @param {Array<{ status: string, number: string, customerId: string, dueDate: string, lines: Array, payments?: Array }>} invoices
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>} - sorted by daysOverdue descending
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.dueDate < asOf)
+    .map((inv) => {
+      const daysOverdue = daysBetween(inv.dueDate, asOf);
+      const due = balanceDue(inv);
+      return {
+        number: inv.number,
+        customerId: inv.customerId,
+        dueDate: inv.dueDate,
+        daysOverdue,
+        due,
+      };
+    })
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
