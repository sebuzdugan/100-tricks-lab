+test('overdueInvoices: returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2026-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: returns empty array when no overdue invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+    terms: 'NET30',
+  });
+  assert.ok(invResult.ok);
+  const issued = issueInvoice(invResult.value, []);
+  assert.ok(issued.ok);
+
+  // Invoice due date is 2026-11-06, check as of 2026-11-05
+  const result = overdueInvoices([issued.value], '2026-11-05');
+  assert.deepEqual(result, []);
+});
