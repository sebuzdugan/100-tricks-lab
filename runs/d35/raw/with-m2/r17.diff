+/**
+ * Get VAT summary over invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} - sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const lineTotal = line.qty * line.unitPrice;
+        const lineDiscountPercent = line.discountPercent ?? 0;
+        const lineDiscount = Math.round(lineTotal * lineDiscountPercent / 100);
+        const discountedAmount = lineTotal - lineDiscount;
+        const lineVat = roundCents(discountedAmount * line.vatRate / 100);
+
+        const rate = line.vatRate;
+        if (!vatMap.has(rate)) {
+          vatMap.set(rate, { base: 0, vat: 0 });
+        }
+
+        const entry = vatMap.get(rate);
+        entry.base += discountedAmount;
+        entry.vat += lineVat;
+      });
+    });
+
+  // Convert map to array and sort by rate descending
+  const result = Array.from(vatMap.entries())
+    .map(([rate, { base, vat }]) => ({ rate, base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return result;
+}
