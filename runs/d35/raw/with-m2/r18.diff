+/**
+ * Calculate late fee for an invoice.
+ * Late fee is 0.04% of the amount due per day overdue, 0 if not overdue.
+ * @param {{ dueDate: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {number} - late fee in cents, rounded to nearest cent
+ */
+export function lateFee(invoice, asOf) {
+  // If invoice is not issued or partially paid, no late fee
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // If not overdue, return 0
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  // Get amount due
+  const due = balanceDue(invoice);
+
+  // Calculate fee: 0.04% per day = 0.0004 per day
+  const fee = due * daysOverdue * 0.0004;
+
+  // Round to nearest cent
+  return Math.round(fee);
+}
