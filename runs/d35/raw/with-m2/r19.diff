+
+  const result = exportCsv([mockInvoice]);
+  const lines = result.split('\n');
+  // Should have empty customer name for unknown customer
+  assert.ok(lines[1].includes('INV-2026-0001'));
+});
+
+test('exportCsv: small amounts format correctly', () => {
