+
+  assert.equal(fields.length, 10);
+  assert.equal(fields[0], 'number');
+  assert.equal(fields[1], 'customer');
+  assert.equal(fields[2], 'issueDate');
+  assert.equal(fields[3], 'dueDate');
+  assert.equal(fields[4], 'status');
+  assert.equal(fields[5], 'subtotal');
+  assert.equal(fields[6], 'discount');
+  assert.equal(fields[7], 'vat');
+  assert.equal(fields[8], 'total');
+  assert.equal(fields[9], 'due');
