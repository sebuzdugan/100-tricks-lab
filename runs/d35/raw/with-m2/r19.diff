+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ number: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array, voucher?: { amount: number } }>} invoices
+ * @returns {string} - CSV data with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map((invoice) => {
+    const customer = getCustomer(invoice.customerId);
+    const customerName = customer.ok ? customer.value.name : '';
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number,
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    return fields.map(escapeField).join(',') + '\n';
+  });
+
+  return header + lines.join('');
+}
+
+/**
+ * Format amount as euros: 1234.50 (no sign, no thousands separator).
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: wrap in quotes if it contains comma or quote, and double any quotes inside.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeField(field) {
+  field = String(field);
+  if (field.includes(',') || field.includes('"')) {
+    return '"' + field.replace(/"/g, '""') + '"';
+  }
+  return field;
+}
