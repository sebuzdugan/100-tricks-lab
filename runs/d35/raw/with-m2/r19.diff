+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv: returns header line', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv: empty invoice list', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv: single invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(invResult.ok);
+  const issued = issueInvoice(invResult.value, []);
+  assert.ok(issued.ok);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3); // header, data, empty line at end
+  assert.ok(lines[1].includes('INV-2026-0001'));
+  assert.ok(lines[1].includes('Blue Fern Bakery'));
+  assert.ok(lines[1].includes('2026-01-15'));
+});
+
+test('exportCsv: formats amounts correctly', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(invResult.ok);
+  const issued = issueInvoice(invResult.value, []);
+  assert.ok(issued.ok);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  // Subtotal: 76000 = 760.00, VAT: 15960 = 159.60, Total: 91960 = 919.60
+  assert.ok(lines[1].includes('760.00'));
+  assert.ok(lines[1].includes('0.00')); // discount
+  assert.ok(lines[1].includes('159.60'));
+  assert.ok(lines[1].includes('919.60'));
+});
+
+test('exportCsv: handles draft invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(invResult.ok);
+
+  const result = exportCsv([invResult.value]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('draft'));
+});
+
+test('exportCsv: handles issued invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(invResult.ok);
+  const issued = issueInvoice(invResult.value, []);
+  assert.ok(issued.ok);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv: handles partially_paid invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+  assert.ok(invResult.ok);
+  const issued = issueInvoice(invResult.value, []);
+  assert.ok(issued.ok);
+
+  const paymentResult = recordPayment(issued.value, { amount: 30000, date: '2026-01-20' });
+  assert.ok(paymentResult.ok);
+
+  const result = exportCsv([paymentResult.value]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('partially_paid'));
+  assert.ok(lines[1].includes('619.60')); // due = 91960 - 30000 = 61960 cents = 619.60 euros
+});
+
