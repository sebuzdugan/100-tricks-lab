diff --git a/src/money.js b/src/money.js
index fadf486..29062a7 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,14 @@
 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +48,45 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert cents from euros to another currency.
+ * @param {number} cents - amount in euro cents
+ * @param {string} currency - currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }} - amount in that currency's cents
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const euros = cents / 100;
+  const amountInCurrency = euros * rate;
+  const amountInCurrencyCents = Math.round(amountInCurrency * 100);
+
+  return ok(amountInCurrencyCents);
+}
+
+/**
+ * Format cents as money with currency symbol: 123456 -> "$1,234.56" for USD, "£1,234.56" for GBP.
+ * @param {number} cents
+ * @param {string} currency - EUR, USD, or GBP
+ * @returns {string} - formatted amount with currency symbol, or error message if currency unknown
+ */
+export function formatMoney(cents, currency) {
+  const symbol = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  }[currency];
+
+  if (!symbol) {
+    return 'UNKNOWN_CURRENCY';
+  }
+
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
