+
+test('convert: EUR to EUR (identity)', () => {
+  const result = convert(10000, 'EUR');
+  assert.ok(result.ok);
+  assert.equal(result.value, 10000);
+});
+
+test('convert: EUR to USD', () => {
+  // 100 EUR = 108.50 USD (100 * 1.085)
+  const result = convert(10000, 'USD');
+  assert.ok(result.ok);
+  assert.equal(result.value, 10850);
+});
+
+test('convert: EUR to GBP', () => {
+  // 100 EUR = 84.25 GBP (100 * 0.8425)
+  const result = convert(10000, 'GBP');
+  assert.ok(result.ok);
+  assert.equal(result.value, 8425);
+});
+
+test('convert: small amount EUR to USD', () => {
+  // 1 EUR = 1.085 USD (1 * 1.085), rounds to 109 cents
+  const result = convert(100, 'USD');
+  assert.ok(result.ok);
+  assert.equal(result.value, 109);
+});
+
+test('convert: rounding', () => {
+  // 50 EUR = 54.25 USD (50 * 1.085), rounds to 5425 cents
+  const result = convert(5000, 'USD');
