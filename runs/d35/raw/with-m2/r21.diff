+test('mergeCustomers: merges invoices from one customer to another', () => {
+  const customers = listCustomers();
+  const invoices = [
+    { customerId: 'C-001', number: 'INV-2026-0001' },
+    { customerId: 'C-002', number: 'INV-2026-0002' },
+    { customerId: 'C-001', number: 'INV-2026-0003' },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.ok(result.ok);
+  assert.equal(result.value.customers.length, customers.length - 1);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  assert.equal(result.value.invoices[1].customerId, 'C-002');
+  assert.equal(result.value.invoices[2].customerId, 'C-002');
+});
