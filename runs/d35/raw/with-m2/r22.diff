+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal: calculates qty times unitPrice', () => {
+  const line = { qty: 8, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 76000);
+});
+
+test('lineTotal: single unit', () => {
+  const line = { qty: 1, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 9500);
+});
+
+test('lineTotal: multiple units', () => {
+  const line = { qty: 10, unitPrice: 37 };
+  assert.equal(lineTotal(line), 370);
+});
+
+test('lineTotal: zero units', () => {
+  const line = { qty: 0, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('invoiceTotals: single line without discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 8, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 76000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 15960);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 91960);
+});
+
+test('invoiceTotals: single line with discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 8, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 76000);
+  assert.equal(totals.discount, 7600);
+  assert.equal(totals.vat, 14364);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 82764);
+});
+
+test('invoiceTotals: multiple lines same VAT rate', () => {
+  const invoice = {
+    lines: [
+      { qty: 8, unitPrice: 9500, vatRate: 21 },
+      { qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 118500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 24885);
+  assert.equal(totals.total, 143385);
+});
+
+test('invoiceTotals: multiple lines different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 8, unitPrice: 9500, vatRate: 21 },
+      { qty: 10, unitPrice: 37, vatRate: 9 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 76370);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 15993);
+  assert.equal(totals.total, 92363);
+});
+
+test('invoiceTotals: with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 8, unitPrice: 9500, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 76000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 15960);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 86960);
+});
+
+test('invoiceTotals: with all features', () => {
+  const invoice = {
+    lines: [
+      { qty: 8, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+      { qty: 5, unitPrice: 8500, discountPercent: 20, vatRate: 21 },
+    ],
+    voucher: { code: 'SUMMER', amount: 3000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  // Dev: 76000 - 7600 = 68400, VAT = 14364
+  // Des: 42500 - 8500 = 34000, VAT = 7140
+  // Subtotal: 118500, Discount: 16100, VAT: 21504, Voucher: 3000
+  // Total: 118500 - 16100 + 21504 - 3000 = 120904
+  assert.equal(totals.subtotal, 118500);
+  assert.equal(totals.discount, 16100);
+  assert.equal(totals.vat, 21504);
+  assert.equal(totals.voucher, 3000);
+  assert.equal(totals.total, 120904);
+});
+
+test('invoiceTotals: VAT on zero-rated line', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 60000, vatRate: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 60000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 60000);
+});
+
+test('invoiceTotals: with 100% discount on one line', () => {
+  const invoice = {
+    lines: [
+      { qty: 8, unitPrice: 9500, discountPercent: 100, vatRate: 21 },
+      { qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // Dev: 76000 - 76000 = 0, VAT = 0
+  // Des: 42500, VAT = 8925
+  // Total: 118500 - 76000 + 8925 = 51425
+  assert.equal(totals.subtotal, 118500);
+  assert.equal(totals.discount, 76000);
+  assert.equal(totals.vat, 8925);
+  assert.equal(totals.total, 51425);
+});
+
+test('invoiceTotals: negative total clamped to zero', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, vatRate: 0 },
+    ],
+    voucher: { code: 'BIG', amount: 2000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals: no voucher field uses zero', () => {
+  const invoice = {
+    lines: [
+      { qty: 8, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals: returns all fields', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+  assert.equal(Object.keys(totals).length, 5);
+});
+
+test('invoiceTotals: VAT rounding per line', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 980, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // Line total: 2940, VAT: 2940 * 21 / 100 = 617.4 → 617
+  assert.equal(totals.subtotal, 2940);
+  assert.equal(totals.vat, 617);
+  assert.equal(totals.total, 3557);
+});
+
+test('invoiceTotals: multiple discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 8, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 60000, discountPercent: 20, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // Dev: 76000 - 7600 = 68400, VAT = 14364
+  // Des: 42500, VAT = 8925
+  // Workshop: 60000 - 12000 = 48000, VAT = 10080
+  // Subtotal: 178500, Discount: 19600, VAT: 33369
+  // Total: 178500 - 19600 + 33369 = 192269
+  assert.equal(totals.subtotal, 178500);
+  assert.equal(totals.discount, 19600);
+  assert.equal(totals.vat, 33369);
+  assert.equal(totals.total, 192269);
+});
+
+test('invoiceTotals: decimal discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 2.5, vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // Line total: 10000, Discount: 10000 * 2.5 / 100 = 250
+  // Discounted: 9750, VAT: 9750 * 21 / 100 = 2047.5 → 2048
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 250);
+  assert.equal(totals.vat, 2048);
+  assert.equal(totals.total, 11798);
+});
