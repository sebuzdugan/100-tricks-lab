+/**
+ * Get a dashboard summary of invoicing data.
+ * @param {Array<{ status: string, customerId: string, dueDate: string, lines: Array, payments?: Array }>} invoices
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Counts by status
+  const counts = {
+    draft: invoices.filter((inv) => inv.status === 'draft').length,
+    issued: invoices.filter((inv) => inv.status === 'issued').length,
+    partially_paid: invoices.filter((inv) => inv.status === 'partially_paid').length,
+    paid: invoices.filter((inv) => inv.status === 'paid').length,
+  };
+
+  // Outstanding: total due on issued or partially_paid invoices
+  const outstanding = invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  // Overdue data
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueData = {
+    count: overdue.length,
+    amount: overdue.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Top customers by due amount
+  const customerDueMap = new Map();
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .forEach((inv) => {
+      const due = balanceDue(inv);
+      if (!customerDueMap.has(inv.customerId)) {
+        customerDueMap.set(inv.customerId, 0);
+      }
+      customerDueMap.set(inv.customerId, customerDueMap.get(inv.customerId) + due);
+    });
+
+  const topCustomers = Array.from(customerDueMap.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: overdueData,
+    topCustomers,
+  };
+}
