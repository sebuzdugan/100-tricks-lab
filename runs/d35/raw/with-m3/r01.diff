+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issueDate format (YYYY-MM-DD)
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) return fail('DATE_INVALID');
+  const date = new Date(issueDate + 'T00:00:00Z');
+  if (isNaN(date.getTime()) || date.toISOString().split('T')[0] !== issueDate) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines array is not empty
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  // Validate and build lines with product info
+  const invoiceLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Validate and get product
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  const invoice = {
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  };
+
+  return ok(invoice);
+}
