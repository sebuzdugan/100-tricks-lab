diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..de37da1
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber: starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: increments counter for same year', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber: ignores numbers from other years', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: restarts counter for different year', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(numbers, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: finds maximum counter regardless of order', () => {
+  const numbers = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0005', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber: zero-pads counter to 4 digits', () => {
+  const numbers = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003', 'INV-2026-0004', 'INV-2026-0005', 'INV-2026-0006', 'INV-2026-0007', 'INV-2026-0008', 'INV-2026-0009'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber: handles large counters', () => {
+  const numbers = ['INV-2026-9998', 'INV-2026-9999'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber: ignores malformed numbers', () => {
+  const numbers = ['INV-2026-0001', 'INVALID', 'INV-2026-ABC', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(numbers, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber: works at year boundary', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(numbers, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: extracts year from issueDate correctly', () => {
+  const numbers = [];
+  const num1 = nextInvoiceNumber(numbers, '2020-06-15');
+  assert.equal(num1, 'INV-2020-0001');
+
+  const num2 = nextInvoiceNumber([], '2099-12-31');
+  assert.equal(num2, 'INV-2099-0001');
+});
