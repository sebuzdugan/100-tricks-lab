+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText: shows DRAFT for unsent invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText: shows invoice number for issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const text = renderInvoiceText(issuedResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0001');
+});
+
+test('renderInvoiceText: shows customer name', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText: formats invoice lines correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  // Line format: qty × name @ unitPrice = total
+  // DEV-HOUR: 5 × Development (hour) @ €95.00 = €475.00
+  assert.equal(lines[2], '5 × Development (hour) @ €95.00 = €475.00');
+});
+
+test('renderInvoiceText: shows total amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  assert.equal(lines[3], 'Total: €475.00');
+});
+
+test('renderInvoiceText: handles multiple lines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '5 × Development (hour) @ €95.00 = €475.00');
+  assert.equal(lines[3], '3 × Design work (hour) @ €85.00 = €255.00');
+  assert.equal(lines[4], 'Total: €730.00');
+});
+
+test('renderInvoiceText: formats amounts with currency symbol and decimals', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 100 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Pine & Pixel');
+  const lines = text.split('\n');
+
+  // ICON-SET: unitPrice = 980 cents = €9.80
+  // 100 × 980 = 98000 cents = €980.00
+  assert.equal(lines[2], '100 × Icon set (24 icons) @ €9.80 = €980.00');
+});
+
+test('renderInvoiceText: formats large amounts with thousands separators', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 100 },
+      { sku: 'DES-HOUR', qty: 100 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  // DEV-HOUR: 100 × 9500 = 950000 cents = €9,500.00
+  // DES-HOUR: 100 × 8500 = 850000 cents = €8,500.00
+  // Total = €18,000.00
+  assert.equal(lines[4], 'Total: €18,000.00');
+});
+
+test('renderInvoiceText: works with VAT-exempt products', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Orchard Health');
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '1 × Brand workshop (day, VAT exempt) @ €600.00 = €600.00');
+  assert.equal(lines[3], 'Total: €600.00');
+});
+
+test('renderInvoiceText: full invoice example', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'DES-HOUR', qty: 4 },
+      { sku: 'SUPPORT-HOUR', qty: 2 },
+    ],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const text = renderInvoiceText(issuedResult.value, 'Kite & Co');
+
+  const expected =
+    'INV-2026-0001\n' +
+    'Kite & Co\n' +
+    '8 × Development (hour) @ €95.00 = €760.00\n' +
+    '4 × Design work (hour) @ €85.00 = €340.00\n' +
+    '2 × Support (hour) @ €72.50 = €145.00\n' +
+    'Total: €1,245.00';
+
+  assert.equal(text, expected);
+});
+
+test('renderInvoiceText: works with small amounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 10 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Test Customer');
+  const lines = text.split('\n');
+
+  // STICKER: unitPrice = 50 cents = €0.50
+  // 10 × 50 = 500 cents = €5.00
+  assert.equal(lines[2], '10 × Sticker sheet @ €0.50 = €5.00');
+  assert.equal(lines[3], 'Total: €5.00');
+});
