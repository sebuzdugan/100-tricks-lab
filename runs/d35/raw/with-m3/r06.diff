diff --git a/test/invoices.test.js b/test/invoices.test.js
index 2c08722..94d33ae 100644
--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -576,3 +576,137 @@ test('issueInvoice: preserves all invoice properties', () => {
   assert.equal(result.value.lines[0].sku, 'DEV-HOUR');
   assert.equal(result.value.lines[1].sku, 'DES-HOUR');
 });
+
+test('createInvoice: accepts discountPercent on lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice: accepts decimal discount percent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 12.5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 12.5);
+});
+
+test('createInvoice: rejects discount below 0', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: -1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DISCOUNT_INVALID');
+});
+
+test('createInvoice: rejects discount above 100', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 101 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DISCOUNT_INVALID');
+});
+
+test('createInvoice: rejects non-numeric discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: '10' }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DISCOUNT_INVALID');
+});
+
+test('invoiceTotals: returns discount in result', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 100, discountPercent: 10 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000); // 100 × 100
+  assert.equal(totals.discount, 1000); // 10000 × 10%
+  assert.equal(totals.total, 9000); // 10000 - 1000
+});
+
+test('invoiceTotals: calculates discount for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 100, discountPercent: 20 },
+      { qty: 10, unitPrice: 100, discountPercent: 10 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 500 + 1000); // 1500
+  assert.equal(totals.discount, 100 + 100); // 200
+  assert.equal(totals.total, 1300);
+});
+
+test('invoiceTotals: no discount if discountPercent is 0', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 100, discountPercent: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 500);
+});
+
+test('invoiceTotals: clamps total at 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 200 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100);
+  assert.equal(totals.discount, 200);
+  assert.equal(totals.total, 0); // Clamped at 0
+});
+
+test('addLine: accepts discountPercent', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const result = addLine(invoiceResult.value, { sku: 'DES-HOUR', qty: 3, discountPercent: 15 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 15);
+});
+
+test('addLine: rejects invalid discountPercent', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const result = addLine(invoiceResult.value, { sku: 'DES-HOUR', qty: 3, discountPercent: 150 });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DISCOUNT_INVALID');
+});
+
+test('addLine: discountPercent is optional', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const result = addLine(invoiceResult.value, { sku: 'DES-HOUR', qty: 3 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, undefined);
+});
diff --git a/test/render.test.js b/test/render.test.js
index 0435283..1f6db3a 100644
--- a/test/render.test.js
+++ b/test/render.test.js
@@ -179,3 +179,93 @@ test('renderInvoiceText: works with small amounts', () => {
   assert.equal(lines[2], '10 × Sticker sheet @ €0.50 = €5.00');
   assert.equal(lines[3], 'Total: €5.00');
 });
+
+test('renderInvoiceText: shows line discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  // Line: 5 × €95.00 = €475.00, discount 10% = €47.50
+  assert.equal(lines[2], '5 × Development (hour) @ €95.00 = €475.00 (−€47.50 @ 10%)');
+});
+
+test('renderInvoiceText: shows invoice-level discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5, discountPercent: 10 },
+      { sku: 'DES-HOUR', qty: 5, discountPercent: 20 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  // Line 1: 5 × €95.00 = €475.00, discount 10% = €47.50
+  // Line 2: 5 × €85.00 = €425.00, discount 20% = €85.00
+  // Subtotal: €900.00
+  // Total discount: €132.50
+  // Total: €767.50
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '5 × Development (hour) @ €95.00 = €475.00 (−€47.50 @ 10%)');
+  assert.equal(lines[3], '5 × Design work (hour) @ €85.00 = €425.00 (−€85.00 @ 20%)');
+  assert.equal(lines[4], 'Discount: −€132.50');
+  assert.equal(lines[5], 'Total: €767.50');
+});
+
+test('renderInvoiceText: does not show discount line if no discounts', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '5 × Development (hour) @ €95.00 = €475.00');
+  assert.equal(lines[3], 'Total: €475.00');
+});
+
+test('renderInvoiceText: shows decimal discount percent', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 12.5 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  // 5 × €95.00 = €475.00, discount 12.5% = €59.38
+  assert.equal(lines[2], '5 × Development (hour) @ €95.00 = €475.00 (−€59.38 @ 12.5%)');
+});
+
+test('renderInvoiceText: shows total clamped at 0', () => {
+  // Manually create an invoice with >100% discount to test clamping
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21, discountPercent: 150 }],
+  };
+
+  const text = renderInvoiceText(invoice, 'Northwind Studio');
+  const lines = text.split('\n');
+
+  // Line: 1 × €95.00 = €95.00 with 150% discount = €142.50
+  // Discount shown: €142.50
+  // Total clamped at 0
+  assert.equal(lines[2], '1 × Development (hour) @ €95.00 = €95.00 (−€142.50 @ 150%)');
+  assert.equal(lines[3], 'Discount: −€142.50');
+  assert.equal(lines[4], 'Total: €0.00');
+});
