 });
+
+test('createInvoice: applies gold tier discount (5%) when no explicit discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // Northwind Studio, tier: gold
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice: applies silver tier discount (2.5%) when no explicit discount', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // Kite & Co, tier: silver
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice: applies standard tier discount (0%) when no explicit discount', () => {
+  const result = createInvoice({
+    customerId: 'C-002', // Blue Fern Bakery, tier: standard
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, undefined); // 0% discount is not stored
+});
+
+test('createInvoice: explicit discount overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // Northwind Studio, tier: gold (5%)
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10); // Explicit 10% wins over gold 5%
+});
+
+test('createInvoice: explicit 0% discount overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // Northwind Studio, tier: gold (5%)
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, undefined); // 0% discount is not stored
+});
+
+test('createInvoice: tier discounts apply to multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // Kite & Co, tier: silver (2.5%)
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 2, discountPercent: 5 }, // Explicit discount
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5); // Silver tier
+  assert.equal(result.value.lines[1].discountPercent, 2.5); // Silver tier
+  assert.equal(result.value.lines[2].discountPercent, 5); // Explicit
+});
+
+test('createInvoice: tier discount is included in totals', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // Northwind Studio, tier: gold (5%)
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const totals = invoiceTotals(result.value);
+  // DEV-HOUR: 10 × 9500 = 95000 cents
+  // Discount: 5% of 95000 = 4750 cents
+  // Total: 95000 - 4750 = 90250 cents
+  assert.equal(totals.subtotal, 95000);
+  assert.equal(totals.discount, 4750);
+  assert.equal(totals.total, 90250);
+});
