+/**
+ * Check if text is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+
+  // Verify the parsed date matches the input (e.g., reject 2026-02-30)
+  const isoString = date.toISOString().split('T')[0];
+  return isoString === text;
+}
+
+/**
+ * Add days to a date.
+ * @param {string} date - date in YYYY-MM-DD format
+ * @param {number} days - number of days to add
+ * @returns {string} - date in YYYY-MM-DD format
+ */
+export function addDays(date, days) {
+  const [year, month, day] = date.split('-').map(Number);
+  const utcDate = new Date(Date.UTC(year, month - 1, day));
+  utcDate.setUTCDate(utcDate.getUTCDate() + days);
+
+  const y = utcDate.getUTCFullYear();
+  const m = String(utcDate.getUTCMonth() + 1).padStart(2, '0');
+  const d = String(utcDate.getUTCDate()).padStart(2, '0');
+  return `${y}-${m}-${d}`;
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a).
+ * @param {string} a - date in YYYY-MM-DD format
+ * @param {string} b - date in YYYY-MM-DD format
+ * @returns {number} - number of whole days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const [aYear, aMonth, aDay] = a.split('-').map(Number);
+  const [bYear, bMonth, bDay] = b.split('-').map(Number);
+
+  const dateA = new Date(Date.UTC(aYear, aMonth - 1, aDay));
+  const dateB = new Date(Date.UTC(bYear, bMonth - 1, bDay));
+
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
