diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..428a496
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,129 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate: accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+});
+
+test('isValidDate: rejects invalid format', () => {
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate('26-10-07'), false);
+});
+
+test('isValidDate: rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false); // February doesn't have 30 days
+  assert.equal(isValidDate('2026-04-31'), false); // April doesn't have 31 days
+  assert.equal(isValidDate('2026-13-01'), false); // Month 13 doesn't exist
+  assert.equal(isValidDate('2026-00-01'), false); // Month 0 doesn't exist
+});
+
+test('isValidDate: handles leap years', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // 2024 is a leap year
+  assert.equal(isValidDate('2026-02-29'), false); // 2026 is not a leap year
+  assert.equal(isValidDate('2000-02-29'), true); // 2000 is a leap year (divisible by 400)
+});
+
+test('isValidDate: rejects non-existent dates', () => {
+  assert.equal(isValidDate('2026-00-00'), false);
+  assert.equal(isValidDate('2026-01-00'), false);
+  assert.equal(isValidDate('2026-01-32'), false);
+});
+
+test('isValidDate: rejects empty and null-like strings', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('null'), false);
+  assert.equal(isValidDate('undefined'), false);
+});
+
+test('addDays: adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 365), '2027-10-07');
+});
+
+test('addDays: adds zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays: adds negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+});
+
+test('addDays: handles month boundaries', () => {
+  assert.equal(addDays('2026-09-30', 1), '2026-10-01');
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays: handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // Leap year
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01'); // Non-leap year
+});
+
+test('addDays: handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 365), '2027-12-31');
+});
+
+test('daysBetween: calculates positive differences', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2027-10-07'), 365);
+});
+
+test('daysBetween: calculates zero difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween: calculates negative differences', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+});
+
+test('daysBetween: handles month boundaries', () => {
+  assert.equal(daysBetween('2026-09-30', '2026-10-01'), 1);
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+});
+
+test('daysBetween: handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2026-12-31', '2027-12-31'), 365);
+});
+
+test('daysBetween: handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  assert.equal(daysBetween('2023-02-28', '2024-02-29'), 366); // Full leap year
+});
+
+test('addDays and daysBetween: are inverses', () => {
+  const date1 = '2026-10-07';
+  const date2 = addDays(date1, 15);
+  assert.equal(daysBetween(date1, date2), 15);
+
+  const date3 = '2026-01-01';
+  const date4 = addDays(date3, -50);
+  assert.equal(daysBetween(date4, date3), 50);
+});
+
+test('addDays: works in UTC (not local timezone)', () => {
+  // This test verifies that the function uses UTC
+  const date = addDays('2026-10-07', 1);
+  assert.equal(date, '2026-10-08');
+  // If timezone-aware, behavior might differ based on where test runs
+  // UTC ensures consistent results everywhere
+});
+
+test('daysBetween: uses UTC (not local timezone)', () => {
+  // Verify UTC usage by checking specific date boundaries
+  const diff = daysBetween('2026-10-07', '2026-10-08');
+  assert.equal(diff, 1);
+  // UTC ensures consistent results regardless of machine timezone
+});
