+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue: returns total for unpaid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002', // Standard tier, 0% discount
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const due = balanceDue(issued.value);
+  // DEV-HOUR: 5 × €95.00 = €475.00, VAT 21% = €99.75, Total = €574.75
+  assert.equal(due, 57475);
+});
+
+test('balanceDue: returns 0 for fully paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const invoice = issued.value;
+  const totalOwed = invoice.lines.reduce((sum, line) => sum + (line.qty * line.unitPrice), 0);
+  const vatAmount = 475 * 0.21; // €99.75
+  const totalWithVat = 475 + Math.round(vatAmount);
+
+  const paid = {
+    ...invoice,
+    payments: [{ amount: 57475, date: '2026-10-10' }],
+  };
+  const due = balanceDue(paid);
+  assert.equal(due, 0);
+});
+
+test('balanceDue: returns remaining amount for partially paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const invoice = issued.value;
+
+  const partialPaid = {
+    ...invoice,
+    payments: [{ amount: 50000, date: '2026-10-10' }], // €500.00
+  };
+  const due = balanceDue(partialPaid);
+  // Total is €1,149.50, paid €500.00, remaining €649.50
+  assert.equal(due, 64950);
+});
+
+test('recordPayment: records payment on issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const result = recordPayment(issued.value, { amount: 30000, date: '2026-10-10' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 30000);
+  assert.equal(result.value.payments[0].date, '2026-10-10');
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment: changes status to paid when fully paid', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const result = recordPayment(issued.value, { amount: 57475, date: '2026-10-10' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment: records multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  let invoice = issued.value;
+
+  // First payment
+  let result = recordPayment(invoice, { amount: 40000, date: '2026-10-10' });
+  assert.equal(result.ok, true);
+  invoice = result.value;
+  assert.equal(invoice.payments.length, 1);
+
+  // Second payment
+  result = recordPayment(invoice, { amount: 30000, date: '2026-10-15' });
+  assert.equal(result.ok, true);
+  invoice = result.value;
+  assert.equal(invoice.payments.length, 2);
+  assert.equal(invoice.status, 'partially_paid');
+
+  // Third payment (complete)
+  // Total is €1,149.50 = 114950 cents, paid 40000 + 30000 = 70000, remaining 44950
+  result = recordPayment(invoice, { amount: 44950, date: '2026-10-20' });
+  assert.equal(result.ok, true);
+  invoice = result.value;
+  assert.equal(invoice.payments.length, 3);
+  assert.equal(invoice.status, 'paid');
+});
+
+test('recordPayment: rejects payment on draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const result = recordPayment(invoiceResult.value, { amount: 30000, date: '2026-10-10' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment: rejects invalid amount (not integer)', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const result = recordPayment(issued.value, { amount: 30000.5, date: '2026-10-10' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: rejects zero amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const result = recordPayment(issued.value, { amount: 0, date: '2026-10-10' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: rejects negative amount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const result = recordPayment(issued.value, { amount: -1000, date: '2026-10-10' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: rejects overpayment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const result = recordPayment(issued.value, { amount: 100000, date: '2026-10-10' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment: does not mutate original invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const original = JSON.parse(JSON.stringify(issued.value));
+  recordPayment(issued.value, { amount: 30000, date: '2026-10-10' });
+  assert.deepEqual(issued.value, original);
+});
+
+test('recordPayment: can record payment on partially paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  let invoice = issued.value;
+
+  // First payment
+  let result = recordPayment(invoice, { amount: 40000, date: '2026-10-10' });
+  assert.equal(result.ok, true);
+  invoice = result.value;
+  assert.equal(invoice.status, 'partially_paid');
+
+  // Second payment (on partially paid invoice)
+  result = recordPayment(invoice, { amount: 30000, date: '2026-10-15' });
+  assert.equal(result.ok, true);
+  assert.equal(invoice.status, 'partially_paid');
+});
+
+test('recordPayment: rejects payment on paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  let invoice = issued.value;
+
+  // Pay in full
+  let result = recordPayment(invoice, { amount: 57475, date: '2026-10-10' });
+  invoice = result.value;
+  assert.equal(invoice.status, 'paid');
+
+  // Try to record another payment
+  result = recordPayment(invoice, { amount: 1000, date: '2026-10-15' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment: preserves invoice properties', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const result = recordPayment(issued.value, { amount: 30000, date: '2026-10-10' });
+
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.number, issued.value.number);
+  assert.equal(result.value.lines.length, 1);
+});
+
+test('balanceDue: handles multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const invoice = {
+    ...issued.value,
+    payments: [
+      { amount: 40000, date: '2026-10-10' },
+      { amount: 30000, date: '2026-10-15' },
+    ],
+  };
+
+  const due = balanceDue(invoice);
+  // Total is €1,149.50 = 114950 cents, paid €700.00 = 70000 cents, remaining €449.50 = 44950 cents
+  assert.equal(due, 44950);
+});
+
+test('balanceDue: returns 0 for overpaid invoice if possible', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const issued = issueInvoice(invoiceResult.value, []);
+  const invoice = {
+    ...issued.value,
+    payments: [
+      { amount: 30000, date: '2026-10-10' },
+      { amount: 30000, date: '2026-10-15' },
+    ],
+  };
+
+  const due = balanceDue(invoice);
+  assert.equal(due, 0); // Clamped at 0 even if overpaid
+});
