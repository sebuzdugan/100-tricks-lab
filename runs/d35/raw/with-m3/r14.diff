+import { test } from 'node:test';
+import assert from 'assert';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement: lists invoices for customer with status issued or partially_paid', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  assert.equal(inv1Result.ok, true);
+  const inv1Issued = issueInvoice(inv1Result.value, []);
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  assert.equal(inv2Result.ok, true);
+  const inv2Issued = issueInvoice(inv2Result.value, [inv1Issued.value.number]);
+
+  const invoices = [inv1Issued.value, inv2Issued.value];
+  const result = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 2);
+});
+
+test('statement: filters out draft invoices', () => {
+  const inv1Result = createInvoice({
