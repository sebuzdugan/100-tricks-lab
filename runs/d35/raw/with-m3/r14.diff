+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  assert.equal(inv2Result.ok, true);
+  // inv2Result.value is still in draft status
+
+  const invoices = [inv1Issued.value, inv2Result.value];
+  const result = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, inv1Issued.value.number);
+});
+
