+  const paymentResult = recordPayment(inv1, { amount: 10000, date: '2026-10-05' });
+  assert.equal(paymentResult.ok, true);
+  inv1 = paymentResult.value;
+
+  const invoices = [inv1];
+  const result = statement('C-002', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  const stmt = result.value.invoices[0];
+  // Total €229.90 (22990), paid €100.00 (10000), due €129.90 (12990)
+  assert.equal(stmt.total, 22990);
+  assert.equal(stmt.due, 12990);
+  assert.equal(result.value.totalDue, 12990);
+});
