 }
+
+/**
+ * Calculate the next free credit note number for a given year.
+ * Format: CN-<year>-<counter> where counter is 4 digits, zero-padded.
+ * @param {Array<string>} existingNumbers - Array of already-used numbers (invoices and credit notes)
+ * @param {string} date - Credit note date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+
+  // Filter numbers for this year and extract counters
+  const yearPrefix = `CN-${year}-`;
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(yearPrefix))
+    .map((num) => parseInt(num.slice(yearPrefix.length), 10))
+    .filter((counter) => !isNaN(counter));
+
+  // Find the maximum counter, or 0 if none exist
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${yearPrefix}${String(nextCounter).padStart(4, '0')}`;
+}
