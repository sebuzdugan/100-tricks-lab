+
+test('createCreditNote: rejects negative amount', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const result = createCreditNote(issued.value, { amount: -5000, reason: 'Discount', date: '2026-10-05' }, [issued.value.number]);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: rejects amount exceeding invoice total', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  // Invoice total is 57475 cents (5 * 9500 + VAT 21% = 47500 + 9975)
+  const result = createCreditNote(issued.value, { amount: 60000, reason: 'Discount', date: '2026-10-05' }, [issued.value.number]);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote: allows amount equal to invoice total', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  // Invoice total is 57475 cents
+  const result = createCreditNote(issued.value, { amount: 57475, reason: 'Full refund', date: '2026-10-05' }, [issued.value.number]);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 57475);
+});
+
+test('createCreditNote: credit note with different dates resets counter each year', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const cn2026 = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-05' }, [issued.value.number]);
+  assert.equal(cn2026.ok, true);
+
+  const cn2027 = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2027-01-05' }, [issued.value.number, cn2026.value.number]);
+  assert.equal(cn2027.ok, true);
+
+  // Both should have counter 0001 as they're in different years
+  assert(cn2026.value.number.includes('2026'));
+  assert(cn2027.value.number.includes('2027'));
+  assert.equal(cn2026.value.number.slice(-4), '0001');
+  assert.equal(cn2027.value.number.slice(-4), '0001');
+});
+
+test('createCreditNote: works with invoice having line discounts', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  // With 10% discount, total should be less
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Discount', date: '2026-10-05' }, [issued.value.number]);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote: works with invoice having voucher', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  let inv = invResult.value;
+
+  const voucherResult = { ok: true, value: { ...inv, voucher: { code: 'PROMO', amount: 5000 } } };
+  const issued = issueInvoice(voucherResult.value, []);
+
+  // Invoice total with voucher deducted
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Discount', date: '2026-10-05' }, [issued.value.number]);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote: includes existing invoice numbers in numbering', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const existingNumbers = [
+    issued.value.number,
+    'CN-2026-0001',
+    'CN-2026-0002',
+  ];
+
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-05' }, existingNumbers);
+
+  assert.equal(result.ok, true);
+  // Next credit note number should be 0003
+  assert.equal(result.value.number, 'CN-2026-0003');
+});
