+import { test } from 'node:test';
+import assert from 'assert';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote: creates credit note for issued invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-05' }, [issued.value.number]);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, issued.value.number);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Discount');
+  assert.equal(result.value.date, '2026-10-05');
+});
+
+test('createCreditNote: generates CN number with CN prefix', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-05' }, [issued.value.number]);
+
+  assert.equal(result.ok, true);
+  assert(result.value.number.startsWith('CN-'));
+  assert(result.value.number.includes('2026'));
+});
+
+test('createCreditNote: separate counter for credit notes', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const cn1 = createCreditNote(issued.value, { amount: 1000, reason: 'Partial', date: '2026-10-05' }, [issued.value.number]);
+  assert.equal(cn1.ok, true);
+
+  const cn2 = createCreditNote(issued.value, { amount: 1000, reason: 'Remaining', date: '2026-10-05' }, [issued.value.number, cn1.value.number]);
+  assert.equal(cn2.ok, true);
+
+  // CN numbers should be different
+  assert.notEqual(cn1.value.number, cn2.value.number);
+});
+
+test('createCreditNote: rejects draft invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+
+  const result = createCreditNote(invResult.value, { amount: 5000, reason: 'Discount', date: '2026-10-05' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote: accepts issued invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-05' }, [issued.value.number]);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote: accepts partially_paid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  let inv = issued.value;
+  const paymentResult = recordPayment(inv, { amount: 10000, date: '2026-10-05' });
+  assert.equal(paymentResult.ok, true);
+  inv = paymentResult.value;
+
+  const result = createCreditNote(inv, { amount: 5000, reason: 'Discount', date: '2026-10-06' }, [issued.value.number]);
+
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote: accepts paid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  let inv = issued.value;
+  const paymentResult = recordPayment(inv, { amount: 22990, date: '2026-10-05' });
+  assert.equal(paymentResult.ok, true);
+  inv = paymentResult.value;
+
+  const result = createCreditNote(inv, { amount: 5000, reason: 'Return', date: '2026-10-06' }, [issued.value.number]);
+
+  assert.equal(result.ok, true);
+});
+
