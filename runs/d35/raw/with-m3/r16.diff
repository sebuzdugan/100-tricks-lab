+test('overdueInvoices: handles multiple overdue invoices', () => {
+  const invoices = [];
+  const existingNumbers = [];
+
+  for (let i = 0; i < 3; i++) {
+    const invResult = createInvoice({
+      customerId: 'C-002',
+      issueDate: `2026-10-0${i + 1}`,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.equal(invResult.ok, true);
+    const issued = issueInvoice(invResult.value, existingNumbers);
+    invoices.push(issued.value);
+    existingNumbers.push(issued.value.number);
+  }
+
+  const result = overdueInvoices(invoices, '2026-11-15');
+
+  assert.equal(result.length, 3);
+  // Verify sorted by daysOverdue descending
+  for (let i = 0; i < result.length - 1; i++) {
+    assert(result[i].daysOverdue >= result[i + 1].daysOverdue);
+  }
+});
