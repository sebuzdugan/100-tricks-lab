+test('overdueInvoices: returns invoices with dueDate before asOf', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  assert.equal(inv1Result.ok, true);
+  const inv1Issued = issueInvoice(inv1Result.value, []);
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  assert.equal(inv2Result.ok, true);
+  const inv2Issued = issueInvoice(inv2Result.value, [inv1Issued.value.number]);
+
+  const invoices = [inv1Issued.value, inv2Issued.value];
+  const result = overdueInvoices(invoices, '2026-11-15');
+
+  assert.equal(result.length, 2);
+});
+
