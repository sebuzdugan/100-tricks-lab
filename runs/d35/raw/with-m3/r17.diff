+/**
+ * Get a VAT summary for invoices.
+ * @param {Array} invoices - all invoices
+ * @returns {Array} - [{ rate, base, vat }], sorted by rate from high to low
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  invoices
+    .filter((inv) => ['issued', 'partially_paid', 'paid'].includes(inv.status))
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const lineTotal = line.qty * line.unitPrice;
+        const lineDiscount = roundCents(lineTotal * (line.discountPercent ?? 0) / 100);
+        const lineAfterDiscount = Math.max(0, lineTotal - lineDiscount);
+        const lineVat = roundCents(lineAfterDiscount * rate / 100);
+
+        if (!vatMap[rate]) {
+          vatMap[rate] = { rate, base: 0, vat: 0 };
+        }
+        vatMap[rate].base += lineAfterDiscount;
+        vatMap[rate].vat += lineVat;
+      });
+    });
+
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
