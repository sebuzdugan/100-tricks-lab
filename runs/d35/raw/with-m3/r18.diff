+/**
+ * Calculate late fee for an invoice.
+ * @param {{ number?: string, status: string, dueDate: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - current date in YYYY-MM-DD format
+ * @returns {number} - late fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) return 0;
+
+  const due = balanceDue(invoice);
+  const fee = roundCents(due * daysOverdue * 0.0004);
+  return fee;
+}
