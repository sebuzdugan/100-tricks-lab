+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+
+  // DEV-HOUR: 2 × €95.00 = €190.00, VAT 21% = €39.90, Total = €229.90
+  assert(lines[1].includes('190.00')); // subtotal
+  assert(lines[1].includes('0.00'));   // discount (no discount)
+  assert(lines[1].includes('39.90'));  // vat
+  assert(lines[1].includes('229.90')); // total
