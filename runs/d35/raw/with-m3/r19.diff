+import { test } from 'node:test';
+import assert from 'assert';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv: includes header line', () => {
+  const result = exportCsv([]);
+
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv: exports single invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 3); // header, data, empty final line
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert(lines[1].includes('INV-2026'));
+  assert(lines[1].includes('Blue Fern Bakery'));
+  assert(lines[1].includes('2026-10-01'));
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv: exports multiple invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(inv1Result.ok, true);
+  const inv1Issued = issueInvoice(inv1Result.value, []);
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  assert.equal(inv2Result.ok, true);
+  const inv2Issued = issueInvoice(inv2Result.value, [inv1Issued.value.number]);
+
+  const result = exportCsv([inv1Issued.value, inv2Issued.value]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 4); // header, 2 data, empty final
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv: includes customer name from getCustomer', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.equal(invResult.ok, true);
+  const issued = issueInvoice(invResult.value, []);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+
+  // C-001 is Northwind Studio
+  assert(lines[1].includes('Northwind Studio'));
