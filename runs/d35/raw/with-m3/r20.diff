--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,40 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert euros (in cents) to another currency (in cents of that currency).
+ * @param {number} cents - amount in euros cents
+ * @param {string} currency - target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const rate = RATES[currency];
+  const converted = roundCents(cents * rate);
+  return ok(converted);
+}
+
+/**
+ * Format cents as currency for the given currency.
+ * @param {number} cents - amount in cents (of the currency)
+ * @param {string} currency - currency (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const decimals = String(abs % 100).padStart(2, '0');
+
+  if (currency === 'USD') {
+    return `${sign}$${units}.${decimals}`;
+  } else if (currency === 'GBP') {
+    return `${sign}£${units}.${decimals}`;
+  } else {
+    // EUR or default
+    return `${sign}€${units}.${decimals}`;
+  }
+}
