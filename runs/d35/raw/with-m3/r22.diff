+import { test } from 'node:test';
+import assert from 'assert';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal: calculates qty × unitPrice', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal: handles single unit', () => {
+  const line = { qty: 1, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 9500);
+});
+
+test('lineTotal: handles large amounts', () => {
+  const line = { qty: 100, unitPrice: 245000 };
+  assert.equal(lineTotal(line), 24500000);
+});
+
+test('lineTotal: handles small amounts', () => {
+  const line = { qty: 1, unitPrice: 50 };
+  assert.equal(lineTotal(line), 50);
+});
+
+test('invoiceTotals: calculates subtotal without discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 5000, vatRate: 21 },
+      { qty: 1, unitPrice: 3000, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 13000);
+});
+
+test('invoiceTotals: calculates discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 1000);
+});
+
+test('invoiceTotals: calculates VAT on discounted amount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // After 10% discount: 10000 - 1000 = 9000
+  // VAT 21% of 9000 = 1890
+  assert.equal(totals.vat, 1890);
+});
+
+test('invoiceTotals: calculates total correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 19000, Discount: 0, VAT: 3990, Total: 22990
+  assert.equal(totals.total, 22990);
+});
+
+test('invoiceTotals: handles multiple lines with different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, vatRate: 21 },
+      { qty: 1, unitPrice: 10000, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1 VAT: 21% of 10000 = 2100
+  // Line 2 VAT: 9% of 10000 = 900
+  // Total VAT: 3000
+  assert.equal(totals.vat, 3000);
+});
+
+test('invoiceTotals: clamps negative total at 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, discountPercent: 200, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals: includes voucher amount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 2000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 2000);
+});
+
+test('invoiceTotals: subtracts voucher from total', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 2000 },
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 10000, VAT: 2100, Before voucher: 12100, After voucher: 10100
+  assert.equal(totals.total, 10100);
+});
+
+test('invoiceTotals: returns 0 voucher when not present', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals: returns all required fields', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(typeof totals.subtotal, 'number');
+  assert.equal(typeof totals.discount, 'number');
+  assert.equal(typeof totals.vat, 'number');
+  assert.equal(typeof totals.voucher, 'number');
+  assert.equal(typeof totals.total, 'number');
+});
+
+test('invoiceTotals: handles empty discount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals: handles 0% discount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 0);
+});
+
+test('invoiceTotals: banker\'s rounding on VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1, vatRate: 21 },
+      { qty: 1, unitPrice: 1, vatRate: 21 },
+      { qty: 1, unitPrice: 1, vatRate: 21 },
+      { qty: 1, unitPrice: 1, vatRate: 21 },
+      { qty: 1, unitPrice: 1, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Each line: 1 cent, VAT 21% = 0.21 cents → 0 cents (banker's rounding)
+  // Total VAT: 0 cents
+  assert.equal(totals.vat, 0);
+});
+
+test('invoiceTotals: large invoice', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 245000, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 24,500,000
+  // Discount: 5% of 24,500,000 = 1,225,000
+  // After discount: 23,275,000
+  // VAT: 21% of 23,275,000 = 4,887,750
+  // Total: 28,162,750
+  assert.equal(totals.subtotal, 24500000);
+  assert.equal(totals.discount, 1225000);
+  assert.equal(totals.vat, 4887750);
+  assert.equal(totals.total, 28162750);
+});
+
+test('invoiceTotals: mixed discount and VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+      { qty: 1, unitPrice: 8500, discountPercent: 20, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: 19000 - 1900 = 17100, VAT: 3591, subtotal: 19000, discount: 1900
+  // Line 2: 8500 - 1700 = 6800, VAT: 612, subtotal: 8500, discount: 1700
+  // Total subtotal: 27500
+  // Total discount: 3600
+  // Total VAT: 4203
+  // Total: 27500 - 3600 + 4203 = 28103
+  assert.equal(totals.subtotal, 27500);
+  assert.equal(totals.discount, 3600);
+  assert.equal(totals.vat, 4203);
+  assert.equal(totals.total, 28103);
+});
+
+test('invoiceTotals: discount clamped at line amount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, discountPercent: 200, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line total: 100, discount 200% = 200 (clamped), after discount = 0
+  assert.equal(totals.discount, 200);
+  assert.equal(totals.vat, 0);
+});
+
+test('invoiceTotals: does not mutate invoice', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 10000, vatRate: 21 }],
+  };
+  const original = JSON.parse(JSON.stringify(invoice));
+  invoiceTotals(invoice);
+  assert.deepEqual(invoice, original);
+});
