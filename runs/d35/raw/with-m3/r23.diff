index 18777c6..7930b7f 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -11,19 +11,27 @@ export function lineTotal(line) {
 
 /**
  * Calculate invoice totals (subtotal, discount, VAT, voucher, and total in cents).
+ * Bulk discount (2.5%) applies on lines with qty >= 10, after any line/tier discount.
  * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
  * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   const discount = invoice.lines.reduce((sum, line) => {
-    const lineDiscount = roundCents(lineTotal(line) * (line.discountPercent ?? 0) / 100);
-    return sum + Math.max(0, lineDiscount);
+    const lineTotal_ = lineTotal(line);
+    const lineDiscount = roundCents(lineTotal_ * (line.discountPercent ?? 0) / 100);
+    const lineAfterDiscount = Math.max(0, lineTotal_ - lineDiscount);
+    // Bulk discount: 2.5% extra on lines with 10+ units, applied after line discount
+    const bulkDiscount = line.qty >= 10 ? roundCents(lineAfterDiscount * 2.5 / 100) : 0;
+    return sum + Math.max(0, lineDiscount) + Math.max(0, bulkDiscount);
   }, 0);
   const vat = invoice.lines.reduce((sum, line) => {
     const lineTotal_ = lineTotal(line);
     const lineDiscount = roundCents(lineTotal_ * (line.discountPercent ?? 0) / 100);
-    const lineAfterDiscount = Math.max(0, lineTotal_ - lineDiscount);
+    const lineAfterFirstDiscount = Math.max(0, lineTotal_ - lineDiscount);
+    // Bulk discount applied after line discount
+    const bulkDiscount = line.qty >= 10 ? roundCents(lineAfterFirstDiscount * 2.5 / 100) : 0;
+    const lineAfterDiscount = Math.max(0, lineAfterFirstDiscount - bulkDiscount);
     const lineVat = roundCents(lineAfterDiscount * line.vatRate / 100);
     return sum + Math.max(0, lineVat);
   }, 0);
