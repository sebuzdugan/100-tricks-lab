+test('invoiceTotals: bulk discount calculation with rounding', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9999, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 99990
+  // Bulk discount: 2.5% of 99990 = 2499.75 → 2500 (banker's rounding)
+  // After discount: 97490
+  // VAT: 21% of 97490 = 20472.9 → 20473
+  // Total: 99990 - 2500 + 20473 = 117963
+  assert.equal(totals.discount, 2500);
