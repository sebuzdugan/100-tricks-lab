+/**
+ * Generate a dashboard summary for invoices.
+ * @param {Array} invoices - all invoices
+ * @param {string} asOf - cutoff date in YYYY-MM-DD format
+ * @returns {Object} - { counts, outstanding, overdue, topCustomers }
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+  invoices.forEach((inv) => {
+    counts[inv.status] = (counts[inv.status] || 0) + 1;
+  });
+
+  // Calculate outstanding amount (issued + partially_paid)
+  const outstanding = invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  // Get overdue invoices
+  const overdue_ = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_.length,
+    amount: overdue_.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Find top 3 customers by due amount
+  const customersDue = {};
+  invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .forEach((inv) => {
+      const due = balanceDue(inv);
+      if (due > 0) {
+        customersDue[inv.customerId] = (customersDue[inv.customerId] || 0) + due;
+      }
+    });
+
+  const topCustomers = Object.entries(customersDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return { counts, outstanding, overdue, topCustomers };
+}
