+
+  const text = renderInvoiceText(withVoucher, 'Test Customer');
+  const lines = text.split('\n');
+
+  // DEV-HOUR: 5 × €95.00 = €475.00, VAT 21% = €99.75
+  // Total before voucher: €574.75
+  // After voucher (€50.00): €524.75
