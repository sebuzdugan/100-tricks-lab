+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice returns invoice with correct structure', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2025-12-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+});
+
+test('createInvoice populates line with product data', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+
+  assert.equal(result.ok, true);
+  const line = result.value.lines[0];
+  assert.equal(line.sku, 'DEV-HOUR');
+  assert.equal(line.name, 'Development (hour)');
+  assert.equal(line.qty, 3);
+  assert.equal(line.unitPrice, 9500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-01-01',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'STICKER', qty: 50 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[1].sku, 'LOGO-PACK');
+  assert.equal(result.value.lines[2].sku, 'STICKER');
+});
+
+test('createInvoice returns DATE_INVALID for missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns DATE_INVALID for wrong format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025/12/15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns DATE_INVALID for invalid date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice returns NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice returns NO_LINES for null lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: null,
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice returns QTY_INVALID for non-integer qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1.5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice returns QTY_INVALID for zero qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice returns QTY_INVALID for negative qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice returns UNKNOWN_SKU for unknown product', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice does not mutate input lines array', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 1 }];
+  const linesCopy = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines,
+  });
+
+  assert.deepEqual(lines, linesCopy);
+});
+
+test('createInvoice validates all lines before creating invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'VALID-SKU', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice accepts valid dates at boundaries', () => {
+  const result1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2000-01-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result1.ok, true);
+
+  const result2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2099-12-31',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result2.ok, true);
+});
