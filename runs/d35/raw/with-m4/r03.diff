   return ok(invoice);
 }
+
+/**
+ * Add a line to an invoice, or increase qty if the SKU already exists.
+ * @param {object} invoice
+ * @param {{ sku: string, qty: number }} line
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Validate sku exists
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Check if line already exists
+  const existingLineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+
+  let newLines;
+  if (existingLineIndex !== -1) {
+    // Update existing line: create new array with updated line
+    newLines = invoice.lines.map((line, i) =>
+      i === existingLineIndex ? { ...line, qty: line.qty + qty } : line
+    );
+  } else {
+    // Add new line
+    newLines = [
+      ...invoice.lines,
+      {
+        sku,
+        name: product.name,
+        qty,
+        unitPrice: product.unitPrice,
+        vatRate: product.vatRate,
+      },
+    ];
+  }
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {object} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Find the line
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  // Check if it's the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new invoice without this line
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
