diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..2b660b8
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,59 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for new year', () => {
+  const number = nextInvoiceNumber([], '2025-12-15');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = ['INV-2024-9999', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber handles unordered input', () => {
+  const existingNumbers = ['INV-2025-0005', 'INV-2025-0002', 'INV-2025-0010'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'INV-2025-0011');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existingNumbers = ['INV-2025-0099'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'INV-2025-0100');
+});
+
+test('nextInvoiceNumber works at year boundaries', () => {
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-01-01');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber handles single digit year correctly', () => {
+  const number = nextInvoiceNumber([], '0999-12-15');
+  assert.equal(number, 'INV-0999-0001');
+});
+
+test('nextInvoiceNumber extracts year from issueDate correctly', () => {
+  const number = nextInvoiceNumber([], '2026-03-15');
+  assert.equal(number.startsWith('INV-2026-'), true);
+});
+
+test('nextInvoiceNumber handles large counter values', () => {
+  const existingNumbers = ['INV-2025-9998'];
+  const number = nextInvoiceNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'INV-2025-9999');
+});
+
+test('nextInvoiceNumber with empty array for year', () => {
+  const number = nextInvoiceNumber([], '2025-06-01');
+  assert.equal(number, 'INV-2025-0001');
+});
