new file mode 100644
index 0000000..247d2ab
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,27 @@
+/**
+ * Get the next invoice number in the sequence INV-<year>-<counter>.
+ * Counter has 4 digits, zero-padded, starting at 0001 and restarting every year.
+ * @param {string[]} existingNumbers Array of invoice numbers already used, in any order
+ * @param {string} issueDate Invoice date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Find the maximum counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterStr = num.slice(prefix.length);
+      const counter = Number(counterStr);
+      if (!isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `${prefix}${paddedCounter}`;
+}
