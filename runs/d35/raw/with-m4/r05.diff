+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {object} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer data
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const customer = customerResult.value;
+  const totals = invoiceTotals(invoice);
+
+  // First line: invoice number or DRAFT
+  const numberLine = invoice.number || 'DRAFT';
+
+  // Second line: customer name
+  const customerLine = customer.name;
+
+  // Line items
+  const lineItems = invoice.lines.map((line) => {
+    const lineTotalCents = line.qty * line.unitPrice;
+    return `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(lineTotalCents)}`;
+  });
+
+  // Total line
+  const totalLine = `Total: ${formatEuros(totals.total)}`;
+
+  // Combine all lines
+  const lines = [numberLine, customerLine, ...lineItems, totalLine];
+  return ok(lines.join('\n'));
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..cf8b622
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,219 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  assert.match(text, /^DRAFT/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  let invoice = result.value;
+  const issueResult = issueInvoice(invoice, []);
+  invoice = issueResult.value;
+
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  assert.match(text, /^INV-2025-0001/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText includes line item details', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  // Should show: qty, name, unitPrice, lineTotal
+  assert.match(text, /5 Development \(hour\)/);
+  assert.match(text, /€95.00/); // unit price
+  assert.match(text, /€475.00/); // line total
+});
+
+test('renderInvoiceText shows total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  assert.match(text, /Total: €190.00/);
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  const lines = text.split('\n');
+  // Should have: number line, customer line, 2 item lines, total line
+  assert.equal(lines.length, 5);
+  assert.match(lines[2], /2 Development \(hour\)/);
+  assert.match(lines[3], /1 Logo package/);
+});
+
+test('renderInvoiceText returns CUSTOMER_NOT_FOUND for missing customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2025-12-15',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, false);
+  assert.equal(renderResult.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('renderInvoiceText formats all amounts as euros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 3 }], // 3 * 50 cents = 150 cents = €1.50
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  // Should show €0.50 for unit price and €1.50 for total
+  assert.match(text, /€0.50/);
+  assert.match(text, /€1.50/);
+});
+
+test('renderInvoiceText displays line total correctly for each line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'COPY-HOUR', qty: 3 }, // 3 * 6000 = 18000 cents = €180.00
+      { sku: 'HOST-MONTH', qty: 2 }, // 2 * 1500 = 3000 cents = €30.00
+    ],
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  assert.match(text, /3 Copywriting \(hour\).*€180.00/);
+  assert.match(text, /2 Website hosting \(month\).*€30.00/);
+});
+
+test('renderInvoiceText sums line totals correctly for total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'COPY-HOUR', qty: 2 }, // 2 * 6000 = 12000
+      { sku: 'SUPPORT-HOUR', qty: 2 }, // 2 * 7250 = 14500
+    ],
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  // 12000 + 14500 = 26500 cents = €265.00
+  assert.match(text, /Total: €265.00/);
+});
+
+test('renderInvoiceText line format is consistent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'LOGO-PACK', qty: 2 },
+    ],
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  const lines = text.split('\n');
+  // Each line item should have 4 parts: qty name price total
+  const line1Parts = lines[2].split(' ').filter(p => p); // First item line
+  const line2Parts = lines[3].split(' ').filter(p => p); // Second item line
+  // Both should have similar structure (qty at start, euro amounts at end)
+  assert(line1Parts[0] === '1');
+  assert(line2Parts[0] === '2');
+  assert(line1Parts[line1Parts.length - 1].startsWith('€'));
+  assert(line2Parts[line2Parts.length - 1].startsWith('€'));
+});
+
+test('renderInvoiceText works with large quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 1000 }], // 1000 * 50 = 50000 cents
+  });
+
+  const invoice = result.value;
+  const renderResult = renderInvoiceText(invoice);
+
+  assert.equal(renderResult.ok, true);
+  const text = renderResult.value;
+  assert.match(text, /1000 Sticker sheet/);
+  assert.match(text, /Total: €500.00/);
+});
