+
+test('createInvoice explicit discount overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-008', // Gold tier (5%)
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }], // Explicit 10%
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.discount, 9500); // 95000 * 10 / 100
+  assert.equal(totals.total, 85500);
+});
+
+test('createInvoice explicit 0% discount overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-008', // Gold tier (5%)
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }], // Explicit 0%
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 95000);
+});
+
+test('createInvoice with multiple lines applies tier to all', () => {
+  const result = createInvoice({
+    customerId: 'C-008', // Gold tier (5%)
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 }, // No explicit discount
+      { sku: 'LOGO-PACK', qty: 1, discountPercent: 10 }, // Explicit 10%
+      { sku: 'STICKER', qty: 100 }, // No explicit discount
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5); // Tier discount
+  assert.equal(result.value.lines[1].discountPercent, 10); // Explicit
+  assert.equal(result.value.lines[2].discountPercent, 5); // Tier discount
+});
+
+test('addLine applies tier discount when not specified', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // Silver tier (2.5%)
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  let invoice = result.value;
+  const addResult = addLine(invoice, { sku: 'LOGO-PACK', qty: 1 }); // No discountPercent
+
+  assert.equal(addResult.ok, true);
+  assert.equal(addResult.value.lines[1].discountPercent, 2.5); // Silver tier discount
+});
+
+test('addLine explicit discount overrides tier', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // Silver tier (2.5%)
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  let invoice = result.value;
+  const addResult = addLine(invoice, { sku: 'LOGO-PACK', qty: 1, discountPercent: 15 });
+
+  assert.equal(addResult.ok, true);
+  assert.equal(addResult.value.lines[1].discountPercent, 15); // Explicit discount
+});
