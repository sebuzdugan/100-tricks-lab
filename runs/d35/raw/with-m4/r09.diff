--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -965,3 +965,56 @@ test('invoiceTotals VAT computed per line and summed', () => {
   // Total VAT should be 21 + 21 + 21 = 63, not 297 * 21 / 100 = 62.37 -> 62
   assert.equal(totals.vat, 63);
 });
+
+test('createInvoice normalizes customer ID', () => {
+  const result = createInvoice({
+    customerId: 'c-001', // lowercase
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001'); // stored as uppercase
+});
+
+test('createInvoice normalizes customer ID with spaces', () => {
+  const result = createInvoice({
+    customerId: ' C-002 ', // with spaces
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002'); // stored without spaces
+});
+
+test('createInvoice normalizes customer ID case and spaces together', () => {
+  const result = createInvoice({
+    customerId: ' c-003 ', // mixed case with spaces
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003'); // normalized
+});
+
+test('createInvoice finds customer with normalized ID', () => {
+  const result1 = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const result2 = createInvoice({
+    customerId: 'c-008', // lowercase
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  // Both should have the same customer (gold tier 5% discount)
+  assert.equal(result1.value.lines[0].discountPercent, 5);
+  assert.equal(result2.value.lines[0].discountPercent, 5);
+});
