+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-099'), 'C-099');
+  assert.equal(normalizeId('C-001'), 'C-001');
+});
+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId(' C-001 '), 'C-001');
+  assert.equal(normalizeId('C-001 '), 'C-001');
+  assert.equal(normalizeId(' C-001'), 'C-001');
+  assert.equal(normalizeId('\tC-001\n'), 'C-001');
+});
+
+test('normalizeId handles mixed case with spaces', () => {
+  assert.equal(normalizeId(' c-007 '), 'C-007');
+  assert.equal(normalizeId('c-003 '), 'C-003');
+});
+
+test('getCustomer accepts mixed case ID', () => {
+  const result = getCustomer('c-001');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer accepts ID with spaces', () => {
+  const result = getCustomer(' C-001 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer accepts mixed case with spaces', () => {
+  const result = getCustomer(' c-003 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Kite & Co');
+});
+
+test('getCustomer with normalized ID finds same customer as uppercase', () => {
+  const result1 = getCustomer('C-008');
+  const result2 = getCustomer('c-008');
+  assert.deepEqual(result1, result2);
+  assert.equal(result1.value.name, 'Lumen Records');
+});
diff --git a/test/invoices.test.js b/test/invoices.test.js
