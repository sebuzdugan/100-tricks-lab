diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..2ea2569
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,118 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+import { createInvoice } from '../src/invoices.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-12-15'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+  assert.equal(isValidDate('2025-02-28'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('2025/12/15'), false);
+  assert.equal(isValidDate('15-12-2025'), false);
+  assert.equal(isValidDate('2025-12-15T00:00:00Z'), false);
+  assert.equal(isValidDate('2025-12-15 '), false);
+  assert.equal(isValidDate(' 2025-12-15'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false); // Feb doesn't have 30 days
+  assert.equal(isValidDate('2025-13-01'), false); // Month 13
+  assert.equal(isValidDate('2025-00-01'), false); // Month 0
+  assert.equal(isValidDate('2025-01-00'), false); // Day 0
+  assert.equal(isValidDate('2025-01-32'), false); // Jan has 31 days
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // 2024 is leap year
+  assert.equal(isValidDate('2025-02-29'), false); // 2025 is not leap year
+  assert.equal(isValidDate('2000-02-29'), true); // 2000 is leap year
+  assert.equal(isValidDate('1900-02-29'), false); // 1900 is not leap year
+});
+
+test('isValidDate rejects empty/missing input', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('2025'), false);
+  assert.equal(isValidDate('2025-12'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-01-01', 0), '2025-01-01');
+  assert.equal(addDays('2025-01-01', 1), '2025-01-02');
+  assert.equal(addDays('2025-01-01', 30), '2025-01-31');
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2025-01-02', -1), '2025-01-01');
+  assert.equal(addDays('2025-02-01', -1), '2025-01-31');
+  assert.equal(addDays('2025-03-01', -30), '2025-01-30'); // March 1 - 30 days = Jan 30
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  assert.equal(addDays('2024-01-01', -1), '2023-12-31');
+});
+
+test('addDays handles large day values', () => {
+  assert.equal(addDays('2025-01-01', 365), '2026-01-01'); // 2025 is non-leap (365 days)
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01'); // 2024 is leap (366 days total year)
+  assert.equal(addDays('2025-01-01', -366), '2024-01-01'); // Go back 366 days (2024 is leap year)
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2025-01-01', '2025-01-01'), 0);
+  assert.equal(daysBetween('2025-01-01', '2025-01-02'), 1);
+  assert.equal(daysBetween('2025-01-01', '2025-01-31'), 30);
+  assert.equal(daysBetween('2025-01-01', '2025-02-01'), 31);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2025-01-02', '2025-01-01'), -1);
+  assert.equal(daysBetween('2025-02-01', '2025-01-01'), -31);
+  assert.equal(daysBetween('2026-01-01', '2025-01-01'), -365);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+  assert.equal(daysBetween('2024-12-31', '2025-12-31'), 365); // From Dec 31 2024 to Dec 31 2025 = 365 days
+});
+
+test('daysBetween handles leap years', () => {
+  // 2024 is leap year (366 days), 2025 is not (365 days)
+  assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365); // Jan 1 to Dec 31 = 365 days
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // Full leap year (366 days)
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365); // Non-leap year (365 days)
+});
+
+test('daysBetween with large date differences', () => {
+  assert.equal(daysBetween('2000-01-01', '2025-01-01'), 9132); // ~25 years
+  assert.equal(daysBetween('2025-01-01', '2000-01-01'), -9132);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const startDate = '2025-06-15';
+  const endDate = addDays(startDate, 100);
+  assert.equal(daysBetween(startDate, endDate), 100);
+
+  const reversedDate = addDays(endDate, -100);
+  assert.equal(reversedDate, startDate);
+});
+
+test('isValidDate used in createInvoice', () => {
+  // This test verifies that createInvoice uses isValidDate correctly
+  // by checking that invalid dates are rejected
+  const invalidResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30', // Invalid date
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invalidResult.ok, false);
+  assert.equal(invalidResult.error, 'DATE_INVALID');
+});
