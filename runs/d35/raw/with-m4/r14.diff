+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, invoiceTotals } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('C-999', [], '2025-12-31');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement with no invoices returns empty list', () => {
+  const result = statement('C-001', [], '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes issued invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = statement('C-001', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2025-12-15');
+  assert.equal(result.value.invoices[0].number, 'INV-2025-0001');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  invoice = recordPayment(invoice, { amount: 50000, date: '2025-12-20' }).value;
+
+  assert.equal(invoice.status, 'partially_paid');
+
+  const invoices = [invoice];
+  const result = statement('C-001', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2025-12-15');
+});
+
+test('statement excludes draft invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const invoices = [invoiceResult.value];
+  const result = statement('C-001', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(invoice);
+  invoice = recordPayment(invoice, { amount: totals.total, date: '2025-12-20' }).value;
+
+  assert.equal(invoice.status, 'paid');
+
+  const invoices = [invoice];
+  const result = statement('C-001', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-25',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = statement('C-001', invoices, '2025-12-24'); // asOf before issue date
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement includes invoices on asOf date', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-25',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = statement('C-001', invoices, '2025-12-25'); // asOf on issue date
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement includes due amount for unpaid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 100 }], // 5000, vat 1050 = 6050 total
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = statement('C-002', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].total, 6050);
+  assert.equal(result.value.invoices[0].due, 6050);
+});
+
+test('statement includes due amount for partially paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 100 }], // 5000, vat 1050 = 6050 total
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  invoice = recordPayment(invoice, { amount: 2000, date: '2025-12-20' }).value;
+
+  const invoices = [invoice];
+  const result = statement('C-002', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].total, 6050);
+  assert.equal(result.value.invoices[0].due, 6050 - 2000); // 4050
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-25',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const inv3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  let inv1 = issueInvoice(inv1Result.value, ['INV-2025-0001']).value;
+  let inv2 = issueInvoice(inv2Result.value, ['INV-2025-0001', 'INV-2025-0002']).value;
+  let inv3 = issueInvoice(inv3Result.value, ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003']).value;
+
+  const invoices = [inv1, inv2, inv3]; // Out of order
+
+  const result = statement('C-001', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2025-12-10');
+  assert.equal(result.value.invoices[1].issueDate, '2025-12-20');
+  assert.equal(result.value.invoices[2].issueDate, '2025-12-25');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001', // Gold tier (5% discount)
+    issueDate: '2025-12-10',
+    lines: [{ sku: 'STICKER', qty: 100 }], // 5000, discount 250, vat 998 = 5748
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001', // Gold tier (5% discount)
+    issueDate: '2025-12-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }], // 47500, discount 2375, vat 9476 = 54601
+  });
+
+  let inv1 = issueInvoice(inv1Result.value, ['INV-2025-0001']).value;
+  let inv2 = issueInvoice(inv2Result.value, ['INV-2025-0001', 'INV-2025-0002']).value;
+
+  // Pay partial on first invoice
+  inv1 = recordPayment(inv1, { amount: 2000, date: '2025-12-15' }).value;
+
+  const invoices = [inv1, inv2];
+  const result = statement('C-001', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  // inv1 total: 5748, due: 5748 - 2000 = 3748
+  // inv2 total: 54601, due: 54601
+  // totalDue: 3748 + 54601 = 58349
+  assert.equal(result.value.totalDue, 58349);
+});
+
+test('statement with customer ID normalization', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  // Use different case and spaces
+  const result = statement('c-001 ', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement only includes this customer invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  // Issue invoices - each gets a unique number
+  let inv1 = issueInvoice(inv1Result.value, []).value;
+  let inv2 = issueInvoice(inv2Result.value, [inv1.number]).value;
+
+  const invoices = [inv1, inv2];
+
+  const result = statement('C-001', invoices, '2025-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, inv1.number); // C-001's invoice
+});
