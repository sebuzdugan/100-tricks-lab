+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next credit note number in the sequence CN-<year>-<counter>.
+ * Counter has 4 digits, zero-padded, starting at 0001 and restarting every year.
+ * @param {string[]} existingNumbers Array of invoice and credit note numbers already used, in any order
+ * @param {string} date Credit note date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.slice(0, 4);
+  const prefix = `CN-${year}-`;
+
+  // Find the maximum counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterStr = num.slice(prefix.length);
+      const counter = Number(counterStr);
+      if (!isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `${prefix}${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for an invoice (for refunds).
+ * @param {object} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData amount in cents, date in YYYY-MM-DD
+ * @param {string[]} existingNumbers existing invoice and credit note numbers
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice status is issued, partially_paid, or paid
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check credit amount doesn't exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
