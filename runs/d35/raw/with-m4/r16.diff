+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, invoiceTotals } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array when no invoices are overdue', () => {
+  const result = overdueInvoices([], '2025-12-31');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  const invoices = [invoiceResult.value];
+  const result = overdueInvoices(invoices, '2026-02-28');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(invoice);
+  invoice = recordPayment(invoice, { amount: totals.total, date: '2025-12-20' }).value;
+
+  const invoices = [invoice];
+  const result = overdueInvoices(invoices, '2026-02-28');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes issued invoice past due date', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14', // Due 2025-12-29
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2025-12-31'); // asOf after due date
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoice.number);
+  assert.equal(result[0].dueDate, '2025-12-29');
+});
+
+test('overdueInvoices includes partially_paid invoice past due date', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14', // Due 2025-12-29
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  invoice = recordPayment(invoice, { amount: 50000, date: '2025-12-20' }).value;
+
+  const invoices = [invoice];
+  const result = overdueInvoices(invoices, '2025-12-31');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].customerId, 'C-001');
+});
+
+test('overdueInvoices excludes invoice with due date on asOf', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14', // Due 2025-12-29
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2025-12-29'); // asOf on due date
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoice with due date after asOf', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-25',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET30', // Due 2026-01-24
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2026-01-01'); // asOf before due date
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14', // Due 2025-12-15
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14', // Due 2025-12-29
+  });
+
+  const inv3Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-12-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14', // Due 2026-01-03
+  });
+
+  let inv1 = issueInvoice(inv1Result.value, ['INV-2025-0001']).value;
+  let inv2 = issueInvoice(inv2Result.value, ['INV-2025-0001', 'INV-2025-0002']).value;
+  let inv3 = issueInvoice(inv3Result.value, ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003']).value;
+
+  const invoices = [inv2, inv3, inv1]; // Out of order
+  const result = overdueInvoices(invoices, '2025-12-31');
+
+  assert.equal(result.length, 2);
+  // Most overdue first: inv1 (16 days), inv2 (2 days); inv3 due 2026-01-03 not overdue yet
+  assert.equal(result[0].dueDate, '2025-12-15'); // 16 days overdue
+  assert.equal(result[1].dueDate, '2025-12-29'); // 2 days overdue
+});
+
+test('overdueInvoices calculates correct daysOverdue', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14', // Due 2025-12-29
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2026-01-05'); // 7 days overdue
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 7);
+});
+
+test('overdueInvoices includes due amount for unpaid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 100 }], // ~6050 total
+    terms: 'NET14',
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(invoice);
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2026-01-01');
+
+  assert.equal(result[0].due, totals.total);
+});
+
+test('overdueInvoices includes due amount for partially paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const totals = invoiceTotals(invoice);
+  invoice = recordPayment(invoice, { amount: 2000, date: '2025-12-20' }).value;
+
+  const invoices = [invoice];
+  const result = overdueInvoices(invoices, '2026-01-01');
+
+  // Due should be total - 2000
+  assert.equal(result[0].due, totals.total - 2000);
+});
+
+test('overdueInvoices with multiple invoices different statuses', () => {
+  // Draft - should be excluded
+  const draftResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  // Issued - should be included if overdue
+  const issuedResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  // Paid - should be excluded
+  const paidResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-12-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  let issued = issueInvoice(issuedResult.value, ['INV-2025-0001']).value;
+  let paid = issueInvoice(paidResult.value, ['INV-2025-0001', 'INV-2025-0002']).value;
+  const totals = invoiceTotals(paid);
+  paid = recordPayment(paid, { amount: totals.total, date: '2025-12-10' }).value;
+
+  const invoices = [draftResult.value, issued, paid];
+  const result = overdueInvoices(invoices, '2025-12-31');
+
+  // Only issued invoice should be in results
+  assert.equal(result.length, 1);
+  assert.equal(result[0].customerId, 'C-002');
+});
+
+test('overdueInvoices with EOM terms', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-06-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'EOM', // Due 2025-06-30
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2025-07-15'); // 15 days overdue
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 15);
+  assert.equal(result[0].dueDate, '2025-06-30');
+});
+
+test('overdueInvoices includes customerId', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const invoices = [invoice];
+
+  const result = overdueInvoices(invoices, '2025-12-31');
+
+  assert.equal(result[0].customerId, 'C-005');
+});
