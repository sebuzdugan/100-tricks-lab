+/**
+ * Get VAT summary by rate for invoices with status issued, partially_paid, or paid.
+ * @param {Array<object>} invoices array of all invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const summaryMap = {};
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const vat = lineVat(line);
+      const lineAmount = line.qty * line.unitPrice;
+      const discount = roundCents(lineAmount * (line.discountPercent || 0) / 100);
+      const base = lineAmount - discount;
+
+      if (!summaryMap[rate]) {
+        summaryMap[rate] = { base: 0, vat: 0 };
+      }
+
+      summaryMap[rate].base += base;
+      summaryMap[rate].vat += vat;
+    }
+  }
+
+  return Object.entries(summaryMap)
+    .map(([rate, { base, vat }]) => ({ rate: Number(rate), base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+}
