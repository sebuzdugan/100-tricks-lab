+
+/**
+ * Calculate late fee for an invoice: 0.04% per day on the amount still due.
+ * Returns 0 if the invoice is not overdue or has no balance due.
+ * @param {object} invoice
+ * @param {string} asOf YYYY-MM-DD format (cutoff date)
+ * @returns {number} late fee in cents, rounded
+ */
+export function lateFee(invoice, asOf) {
+  const daysOverdue = Math.max(0, daysBetween(invoice.dueDate, asOf));
+  if (daysOverdue === 0) return 0;
+
+  const due = balanceDue(invoice);
+  if (due <= 0) return 0;
+
+  const fee = due * 0.0004 * daysOverdue;
+  return roundCents(fee);
+}
