+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros with 2 decimals: 123456 -> "1234.56", -5 -> "-0.05"
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEurosPlain(cents) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const euros = Math.floor(abs / 100);
+  const centsPart = abs % 100;
+  return `${sign}${euros}.${String(centsPart).padStart(2, '0')}`;
+}
+
+/**
+ * Escape a field for CSV: wrap in quotes if it contains comma or quote, and double internal quotes.
+ * @param {string} value
+ * @returns {string}
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array<object>} invoices
+ * @returns {string} CSV string with newlines
+ */
+export function exportCsv(invoices) {
+  const header = ['number', 'customer', 'issueDate', 'dueDate', 'status', 'subtotal', 'discount', 'vat', 'total', 'due'];
+  const lines = [header.join(',')];
+
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const row = [
+      escapeCsvField(invoice.number || ''),
+      escapeCsvField(customerName),
+      escapeCsvField(invoice.issueDate || ''),
+      escapeCsvField(invoice.dueDate || ''),
+      escapeCsvField(invoice.status || ''),
+      formatEurosPlain(totals.subtotal),
+      formatEurosPlain(totals.discount),
+      formatEurosPlain(totals.vat),
+      formatEurosPlain(totals.total),
+      formatEurosPlain(due),
+    ];
+
+    lines.push(row.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
