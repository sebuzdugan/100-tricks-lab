+
+test('RATES contains EUR, USD, GBP', () => {
+  assert.ok('EUR' in RATES);
+  assert.ok('USD' in RATES);
+  assert.ok('GBP' in RATES);
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 10000 EUR cents = 100 EUR * 1.085 = 108.5 USD = 10850 USD cents
+  assert.equal(result.value, 10850);
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  // 10000 EUR cents = 100 EUR * 0.8425 = 84.25 GBP = 8425 GBP cents
+  assert.equal(result.value, 8425);
+});
+
+test('convert unknown currency returns UNKNOWN_CURRENCY error', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with negative amount', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -10850);
+});
+
+test('convert with zero amount', () => {
+  const result = convert(0, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert with fractional result rounds correctly', () => {
+  // 1 EUR cent * 1.085 = 1.085 USD cents -> rounds to 1
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1);
+});
+
+test('convert with .5 fractional uses banker\'s rounding', () => {
+  // 1000 EUR cents = 10 EUR * 0.8425 = 8.425 GBP = 842.5 GBP cents -> rounds to 842 (even)
+  const result = convert(1000, 'GBP');
+  assert.equal(result.value, 842);
+});
+
+test('formatMoney EUR with currency sign', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+});
+
+test('formatMoney USD with dollar sign', () => {
+  assert.equal(formatMoney(123456, 'USD'), '$1,234.56');
+});
+
+test('formatMoney GBP with pound sign', () => {
+  assert.equal(formatMoney(123456, 'GBP'), '£1,234.56');
+});
+
+test('formatMoney with negative amounts', () => {
+  assert.equal(formatMoney(-123456, 'USD'), '-$1,234.56');
+  assert.equal(formatMoney(-123456, 'GBP'), '-£1,234.56');
+  assert.equal(formatMoney(-123456, 'EUR'), '-€1,234.56');
+});
+
+test('formatMoney with small amounts', () => {
+  assert.equal(formatMoney(5, 'USD'), '$0.05');
+  assert.equal(formatMoney(50, 'GBP'), '£0.50');
+});
+
+test('formatMoney with zero', () => {
+  assert.equal(formatMoney(0, 'USD'), '$0.00');
+  assert.equal(formatMoney(0, 'GBP'), '£0.00');
+});
+
+test('formatMoney with large amounts and thousands separators', () => {
+  assert.equal(formatMoney(12345678, 'USD'), '$123,456.78');
+  assert.equal(formatMoney(1000000, 'GBP'), '£10,000.00');
+});
+
+test('convert and formatMoney workflow', () => {
+  // Invoice for 1000 EUR = 100000 EUR cents
+  const eurCents = 100000;
+
+  // Customer in USD
+  const usdResult = convert(eurCents, 'USD');
+  assert.equal(usdResult.ok, true);
+  const usdFormatted = formatMoney(usdResult.value, 'USD');
+  // 100000 * 1.085 = 108500 cents = $1,085.00
+  assert.equal(usdFormatted, '$1,085.00');
+
+  // Customer in GBP
+  const gbpResult = convert(eurCents, 'GBP');
+  assert.equal(gbpResult.ok, true);
+  const gbpFormatted = formatMoney(gbpResult.value, 'GBP');
+  // 100000 * 0.8425 = 84250 cents = £842.50
+  assert.equal(gbpFormatted, '£842.50');
+});
