+import { roundCents } from './money.js';
+
+/**
+ * Validate a discount percent value.
+ * @param {unknown} discountPercent
+ * @returns {boolean}
+ */
+export function isValidDiscountPercent(discountPercent) {
+  return typeof discountPercent === 'number' && discountPercent >= 0 && discountPercent <= 100;
+}
+
+/**
+ * Calculate the total for a line item (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the VAT for a line item (computed on amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number}
+ */
+export function lineVat(line) {
+  const total = lineTotal(line);
+  const discount = roundCents(total * (line.discountPercent || 0) / 100);
+  const amountAfterDiscount = total - discount;
+  return roundCents(amountAfterDiscount * line.vatRate / 100);
+}
+
+/**
+ * Calculate the totals for an invoice (subtotal, discount, VAT, voucher, and total).
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => {
+    const lineDiscount = roundCents(lineTotal(line) * (line.discountPercent || 0) / 100);
+    return sum + lineDiscount;
+  }, 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return { subtotal, discount, vat, voucher, total };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
