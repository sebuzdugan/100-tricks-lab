+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDiscountPercent, lineTotal, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('isValidDiscountPercent accepts 0', () => {
+  assert.equal(isValidDiscountPercent(0), true);
+});
+
+test('isValidDiscountPercent accepts 100', () => {
+  assert.equal(isValidDiscountPercent(100), true);
+});
+
+test('isValidDiscountPercent accepts decimal values', () => {
+  assert.equal(isValidDiscountPercent(5.5), true);
+  assert.equal(isValidDiscountPercent(2.5), true);
+});
+
+test('isValidDiscountPercent rejects negative', () => {
+  assert.equal(isValidDiscountPercent(-1), false);
+});
+
+test('isValidDiscountPercent rejects > 100', () => {
+  assert.equal(isValidDiscountPercent(101), false);
+});
+
+test('isValidDiscountPercent rejects non-number', () => {
+  assert.equal(isValidDiscountPercent('50'), false);
+  assert.equal(isValidDiscountPercent(null), false);
+  assert.equal(isValidDiscountPercent(undefined), false);
+});
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 5, unitPrice: 100 };
+  assert.equal(lineTotal(line), 500);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { qty: 1, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 9500);
+});
+
+test('lineTotal with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 100 };
+  assert.equal(lineTotal(line), 100000);
+});
+
+test('lineVat calculates VAT on amount after discount', () => {
+  // 100 qty * 50 unitPrice = 5000
+  // No discount
+  // VAT at 21% = 5000 * 0.21 = 1050
+  const line = { qty: 100, unitPrice: 50, vatRate: 21 };
+  assert.equal(lineVat(line), 1050);
+});
+
+test('lineVat with discount', () => {
+  // 100 qty * 50 unitPrice = 5000
+  // 10% discount = 500
+  // Amount after discount = 4500
+  // VAT at 21% = 4500 * 0.21 = 945
+  const line = { qty: 100, unitPrice: 50, discountPercent: 10, vatRate: 21 };
+  assert.equal(lineVat(line), 945);
+});
+
+test('lineVat with 0% VAT', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with 9% VAT', () => {
+  // 100 qty * 50 unitPrice = 5000
+  // No discount
+  // VAT at 9% = 5000 * 0.09 = 450
+  const line = { qty: 100, unitPrice: 50, vatRate: 9 };
+  assert.equal(lineVat(line), 450);
+});
+
+test('lineVat rounds to cents', () => {
+  // 10 qty * 1 unitPrice = 10
+  // 5.5% discount = 0.55 -> rounds to 1
+  // Amount after discount = 9
+  // VAT at 21% = 1.89 -> rounds to 2
+  const line = { qty: 10, unitPrice: 1, discountPercent: 5.5, vatRate: 21 };
+  const vat = lineVat(line);
+  assert.equal(vat, 2);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 1050);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 6050);
+});
+
+test('invoiceTotals with line discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 500);
+  assert.equal(totals.vat, 945);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 5445);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, vatRate: 21 },
+      { qty: 50, unitPrice: 100, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: 100*50 = 5000, VAT 1050, subtotal 5000
+  // Line 2: 50*100 = 5000, VAT 450, subtotal 5000
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 1500); // 1050 + 450
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 11500);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, vatRate: 21 },
+    ],
+    voucher: { code: 'SUMMER', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 1050);
+  assert.equal(totals.voucher, 500);
+  assert.equal(totals.total, 5550);
+});
+
+test('invoiceTotals with tier discount (applied as line discount)', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 5, vatRate: 21 }, // Gold tier discount
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 250); // 5% of 5000
+  assert.equal(totals.vat, 998); // (5000-250)*0.21 = 998.1 -> 998
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 5748);
+});
+
+test('invoiceTotals with multiple lines and mixed discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, discountPercent: 5, vatRate: 21 },
+      { qty: 50, unitPrice: 100, discountPercent: 0, vatRate: 9 },
+    ],
+    voucher: { code: 'PROMO', amount: 100 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Line 1: subtotal 5000, discount 250, after 4750, vat 998 (4750 * 0.21 = 997.5 -> 998)
+  // Line 2: subtotal 5000, discount 0, vat 450
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 250);
+  assert.equal(totals.vat, 1448); // 998 + 450
+  assert.equal(totals.voucher, 100);
+  assert.equal(totals.total, 11098); // 10000 - 250 + 1448 - 100
+});
+
+test('invoiceTotals with zero VAT lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, vatRate: 0 },
+      { qty: 200, unitPrice: 25, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 10000); // 5000 + 5000
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 10000);
+});
+
+test('invoiceTotals prevents negative total', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 0 },
+    ],
+    voucher: { code: 'HUGE', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.total, 0); // Math.max(0, ...)
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with complex line discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 9500, discountPercent: 5, vatRate: 21 }, // DEV-HOUR with gold discount
+      { qty: 1, unitPrice: 8500, discountPercent: 2.5, vatRate: 21 }, // DES-HOUR with silver discount
+      { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 }, // STICKER with no discount
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  // DEV-HOUR: 9500, discount 475 (5%), after 9025, vat 1895
+  // DES-HOUR: 8500, discount 212.5->212 (2.5%, banker's rounding), after 8288, vat 1740
+  // STICKER: 5000, discount 0, vat 1050
+  assert.equal(totals.subtotal, 23000);
+  assert.equal(totals.discount, 687); // 475 + 212 + 0
+  assert.equal(totals.voucher, 0);
+});
+
+test('lineTotal is used consistently in invoiceTotals', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 21 };
+  const lineAmt = lineTotal(line);
+
+  const invoice = { lines: [line] };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, lineAmt);
+});
+
+test('lineVat is used in invoiceTotals', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 10, vatRate: 21 };
+  const expectedVat = lineVat(line);
+
+  const invoice = { lines: [line] };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.vat, expectedVat);
+});
