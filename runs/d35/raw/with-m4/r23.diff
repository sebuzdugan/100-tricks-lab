diff --git a/src/totals.js b/src/totals.js
index c30c4b8..1864a2a 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -32,17 +32,38 @@ export function lineVat(line) {
 
 /**
  * Calculate the totals for an invoice (subtotal, discount, VAT, voucher, and total).
+ * Bulk discount (2.5% for 10+ units) is applied after line discount to the remaining amount.
+ * VAT is calculated on amount after both discounts.
  * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
  * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
-  const discount = invoice.lines.reduce((sum, line) => {
-    const lineDiscount = roundCents(lineTotal(line) * (line.discountPercent || 0) / 100);
-    return sum + lineDiscount;
-  }, 0);
-  const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
+
+  let totalDiscount = 0;
+  let totalVat = 0;
+
+  for (const line of invoice.lines) {
+    const lineAmount = lineTotal(line);
+    // Apply line's own discount (or tier discount)
+    const lineDiscount = roundCents(lineAmount * (line.discountPercent || 0) / 100);
+    const afterLineDiscount = lineAmount - lineDiscount;
+
+    // Apply bulk discount (2.5% for 10+ units) to what remains after first discount
+    let bulkDiscount = 0;
+    if (line.qty >= 10) {
+      bulkDiscount = roundCents(afterLineDiscount * 2.5 / 100);
+    }
+
+    // Calculate VAT on amount after both discounts
+    const afterAllDiscounts = afterLineDiscount - bulkDiscount;
+    const vat = roundCents(afterAllDiscounts * line.vatRate / 100);
+
+    totalDiscount += lineDiscount + bulkDiscount;
+    totalVat += vat;
+  }
+
   const voucher = invoice.voucher ? invoice.voucher.amount : 0;
-  const total = Math.max(0, subtotal - discount + vat - voucher);
-  return { subtotal, discount, vat, voucher, total };
+  const total = Math.max(0, subtotal - totalDiscount + totalVat - voucher);
+  return { subtotal, discount: totalDiscount, vat: totalVat, voucher, total };
 }
