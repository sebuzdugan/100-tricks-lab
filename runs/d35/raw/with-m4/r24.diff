 }
+
+/**
+ * Get dashboard summary statistics for invoices.
+ * @param {Array<object>} invoices array of all invoices
+ * @param {string} asOf YYYY-MM-DD format (cutoff date)
+ * @returns {{ counts: object, outstanding: number, overdue: object, topCustomers: Array }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices per status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] || 0) + 1;
+  }
+
+  // Calculate outstanding (total due for issued and partially_paid)
+  let outstanding = 0;
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      outstanding += balanceDue(invoice);
+    }
+  }
+
+  // Get overdue info
+  const overduList = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overduList.length,
+    amount: overduList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Get top 3 customers with most still due
+  const customerDue = {};
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const customerId = invoice.customerId;
+      const due = balanceDue(invoice);
+      customerDue[customerId] = (customerDue[customerId] || 0) + due;
+    }
+  }
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return { counts, outstanding, overdue, topCustomers };
+}
