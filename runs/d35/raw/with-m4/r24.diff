+test('dashboard with empty invoices array', () => {
+  const result = dashboard([], '2025-12-31');
+
+  assert.deepEqual(result.counts, { draft: 0, issued: 0, partially_paid: 0, paid: 0 });
+  assert.equal(result.outstanding, 0);
+  assert.deepEqual(result.overdue, { count: 0, amount: 0 });
+  assert.deepEqual(result.topCustomers, []);
+});
+
+test('dashboard counts invoices per status', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-16',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const inv2 = issueInvoice(inv2Result.value, []).value;
+
+  const inv3Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-12-17',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  let inv3 = issueInvoice(inv3Result.value, ['INV-2025-0001']).value;
+  const totals = invoiceTotals(inv3);
+  inv3 = recordPayment(inv3, { amount: totals.total, date: '2025-12-20' }).value;
+
+  const result = dashboard([inv1, inv2, inv3], '2025-12-31');
+
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.partially_paid, 0);
+  assert.equal(result.counts.paid, 1);
+});
+
+test('dashboard calculates outstanding amount', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 100 }], // ~5900 total
+  });
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-12-16',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }], // ~11000 total
+  });
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2025-0001']).value;
+
+  const invoices = [inv1, inv2];
+  const result = dashboard(invoices, '2025-12-31');
+
+  // Outstanding should be sum of issued invoices with balance due
+  assert.ok(result.outstanding > 0);
+  assert.ok(result.outstanding > 5000); // Both invoices unpaid
+});
