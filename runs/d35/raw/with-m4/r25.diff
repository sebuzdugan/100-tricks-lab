 import { invoiceTotals } from './invoices.js';
 
 /**
- * Render an invoice as plain text.
+ * Render an invoice as plain text with details including discounts, vouchers, due date, and payments.
  * @param {object} invoice
  * @returns {{ ok: true, value: string } | { ok: false, error: string }}
  */
@@ -22,19 +22,44 @@ export function renderInvoiceText(invoice) {
   // Second line: customer name
   const customerLine = customer.name;
 
-  // Line items
+  // Line items with optional discount
   const lineItems = invoice.lines.map((line) => {
     const lineTotalCents = line.qty * line.unitPrice;
-    return `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(lineTotalCents)}`;
+    let lineStr = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(lineTotalCents)}`;
+
+    // Add discount if line has one
+    if (line.discountPercent > 0) {
+      const discountAmount = Math.round(lineTotalCents * line.discountPercent / 100);
+      lineStr += ` (${line.discountPercent}% off: ${formatEuros(discountAmount)})`;
+    }
+
+    return lineStr;
   });
 
   // VAT line
   const vatLine = `VAT: ${formatEuros(totals.vat)}`;
 
-  // Total line
-  const totalLine = `Total: ${formatEuros(totals.total)}`;
+  // Build lines array with optional sections
+  const lines = [numberLine, customerLine, ...lineItems, vatLine];
+
+  // Add voucher before total if present
+  if (invoice.voucher) {
+    lines.push(`Voucher: ${formatEuros(invoice.voucher.amount)}`);
+  }
+
+  // Add total line
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  // Add due date if invoice has been issued (has a number)
+  if (invoice.number && invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Add paid amount if invoice has payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
 
-  // Combine all lines
-  const lines = [numberLine, customerLine, ...lineItems, vatLine, totalLine];
   return ok(lines.join('\n'));
 }
