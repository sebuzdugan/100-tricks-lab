+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice: happy path with single line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2025-03-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+
+  const line = result.value.lines[0];
+  assert.equal(line.sku, 'DEV-HOUR');
+  assert.equal(line.name, 'Development (hour)');
+  assert.equal(line.qty, 8);
+  assert.equal(line.unitPrice, 9500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice: happy path with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-01',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[1].sku, 'LOGO-PACK');
+  assert.equal(result.value.lines[1].name, 'Logo package');
+});
+
+test('createInvoice: preserves immutability of input', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 3 }];
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines,
+  });
+
+  assert.equal(result.ok, true);
+  // Verify input lines weren't mutated
+  assert.equal(lines[0].sku, 'DEV-HOUR');
+  assert.equal(lines[0].qty, 3);
+  assert(!('name' in lines[0]));
+});
+
+test('createInvoice: CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'INVALID-999',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice: DATE_INVALID for wrong format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '14-02-2025',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: DATE_INVALID for non-existent date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: DATE_INVALID for invalid month', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-13-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: DATE_INVALID for empty date string', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice: NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice: NO_LINES for missing lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice: QTY_INVALID for non-integer qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 2.5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: QTY_INVALID for zero qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: QTY_INVALID for negative qty', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice: UNKNOWN_SKU for invalid SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'INVALID-SKU', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice: UNKNOWN_SKU when second line has invalid SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'INVALID-SKU', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice: handles different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice: status is always draft', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'draft');
+});
