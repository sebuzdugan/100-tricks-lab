+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} invoice
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Validate issueDate format and is a real date
+  if (!isValidDate(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines is not empty
+  if (!Array.isArray(lines) || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Validate and build invoice lines
+  const invoiceLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Validate SKU exists in catalogue
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) {
+      return fail('UNKNOWN_SKU');
+    }
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  const invoice = {
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  };
+
+  return ok(invoice);
+}
+
+function isValidDate(dateString) {
+  // Check format YYYY-MM-DD
+  const regex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!regex.test(dateString)) {
+    return false;
+  }
+
+  // Parse and check if it's a valid date
+  const date = new Date(dateString + 'T00:00:00Z');
+  const parts = dateString.split('-');
+  const year = parseInt(parts[0], 10);
+  const month = parseInt(parts[1], 10);
+  const day = parseInt(parts[2], 10);
+
+  // Check if date components match (handles invalid dates like 2025-02-30)
+  return date.getUTCFullYear() === year &&
+         date.getUTCMonth() === month - 1 &&
+         date.getUTCDate() === day;
+}
