+/**
+ * Add or increase a line on an invoice.
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {{ sku: string, qty: number }} line
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check invoice status
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) {
+    return fail('QTY_INVALID');
+  }
+
+  // Validate SKU exists in catalogue
+  const productResult = getProduct(sku);
+  if (!productResult.ok) {
+    return fail('UNKNOWN_SKU');
+  }
+
+  const product = productResult.value;
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+
+  // Check if SKU already exists on invoice
+  const existingLineIndex = newLines.findIndex((line) => line.sku === sku);
+  if (existingLineIndex !== -1) {
+    // Increase qty of existing line
+    newLines[existingLineIndex] = {
+      ...newLines[existingLineIndex],
+      qty: newLines[existingLineIndex].qty + qty,
+    };
+  } else {
+    // Add new line
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Remove a line from an invoice.
+ * @param {{ status: string, lines: Array<{ sku: string }> }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check invoice status
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Check if line exists
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex === -1) {
+    return fail('LINE_NOT_FOUND');
+  }
+
+  // Check if this is the last line
+  if (invoice.lines.length === 1) {
+    return fail('NO_LINES');
+  }
+
+  // Create new lines without the removed line
+  const newLines = invoice.lines.filter((line) => line.sku !== sku).map((line) => ({ ...line }));
+
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
