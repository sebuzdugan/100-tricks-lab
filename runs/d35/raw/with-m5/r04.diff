diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..6fe1dba
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,71 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber: first invoice of year is 0001', () => {
+  const result = nextInvoiceNumber([], '2025-02-14');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber: increments counter for same year', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existingNumbers, '2025-03-15');
+  assert.equal(result, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber: finds next counter among unordered numbers', () => {
+  const existingNumbers = ['INV-2025-0005', 'INV-2025-0002', 'INV-2025-0003'];
+  const result = nextInvoiceNumber(existingNumbers, '2025-04-20');
+  assert.equal(result, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber: restarts counter for new year', () => {
+  const existingNumbers = ['INV-2024-0099', 'INV-2024-0100'];
+  const result = nextInvoiceNumber(existingNumbers, '2025-01-01');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber: ignores numbers from other years', () => {
+  const existingNumbers = ['INV-2023-0050', 'INV-2024-0075', 'INV-2025-0003'];
+  const result = nextInvoiceNumber(existingNumbers, '2025-06-01');
+  assert.equal(result, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber: handles mixed years with highest current year', () => {
+  const existingNumbers = [
+    'INV-2023-0001',
+    'INV-2024-0001',
+    'INV-2024-0002',
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2025-0005',
+  ];
+  const result = nextInvoiceNumber(existingNumbers, '2025-12-31');
+  assert.equal(result, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber: zero-pads counter to 4 digits', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+  const result = nextInvoiceNumber(existingNumbers, '2025-01-01');
+  assert.equal(result, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber: handles high counters', () => {
+  const existingNumbers = Array.from({ length: 150 }, (_, i) =>
+    `INV-2025-${String(i + 1).padStart(4, '0')}`
+  );
+  const result = nextInvoiceNumber(existingNumbers, '2025-12-31');
+  assert.equal(result, 'INV-2025-0151');
+});
+
+test('nextInvoiceNumber: ignores malformed numbers', () => {
+  const existingNumbers = ['INV-2025-0001', 'INVALID-NUMBER', 'INV-2025-xyz'];
+  const result = nextInvoiceNumber(existingNumbers, '2025-02-14');
+  assert.equal(result, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber: works with different year format from issueDate', () => {
+  const existingNumbers = ['INV-2024-0001'];
+  const result = nextInvoiceNumber(existingNumbers, '2025-06-15');
+  assert.equal(result, 'INV-2025-0001');
+});
