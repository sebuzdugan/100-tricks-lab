@@ -0,0 +1,25 @@
+/**
+ * Get the next invoice number for a given issue date.
+ * Invoice numbers have format INV-<year>-<counter> where counter resets each year.
+ * @param {Array<string>} existingNumbers - Array of already-used invoice numbers (any order)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - Next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Find all numbers for this year and extract their counters
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((num) => !isNaN(num) && num > 0);
+
+  // Find the next available counter
+  const nextCounter = countersThisYear.length === 0 ? 1 : Math.max(...countersThisYear) + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
