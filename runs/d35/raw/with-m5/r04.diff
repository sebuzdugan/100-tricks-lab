+/**
+ * Issue an invoice, assigning it a number and marking it as issued.
+ * @param {{ status: string, issueDate: string }} invoice
+ * @param {Array<string>} existingNumbers - Array of already-used invoice numbers
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check invoice status
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  // Generate next invoice number
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  const issuedInvoice = {
+    ...invoice,
+    number,
+    status: 'issued',
+  };
+
+  return ok(issuedInvoice);
+}
