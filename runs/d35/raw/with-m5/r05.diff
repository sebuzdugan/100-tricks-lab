+  assert.match(lines[4], /Brand workshop/);
+});
+
+test('renderInvoiceText: unknown customer shows fallback', () => {
+  const invoice = {
+    customerId: 'UNKNOWN-CUSTOMER',
+    issueDate: '2025-02-14',
+    lines: [{ qty: 1, name: 'Test Item', unitPrice: 1000, sku: 'TEST' }],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Unknown Customer');
+});
+
+test('renderInvoiceText: returns string with newlines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'DES-HOUR', qty: 1 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.equal(typeof text, 'string');
+  assert(text.includes('\n'));
+  const lines = text.split('\n');
+  assert(lines.length >= 4);
+});
+
+test('renderInvoiceText: issued invoice has correct structure', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2025-03-20',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = invoiceResult.value;
+
+  const issueResult = issueInvoice(invoice, []);
+  assert.equal(issueResult.ok, true);
+  invoice = issueResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2025-0001');
