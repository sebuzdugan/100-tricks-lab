+
+test('renderInvoiceText: handles different VAT rates', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
