+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText: shows DRAFT for unsent invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText: shows invoice number when issued', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = invoiceResult.value;
+
+  const issueResult = issueInvoice(invoice, []);
+  assert.equal(issueResult.ok, true);
+  invoice = issueResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2025-0001');
+});
+
+test('renderInvoiceText: includes customer name', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText: shows line items with qty, name, unit price, total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /8 × Development \(hour\) @ €95\.00 = €760\.00/);
+});
+
+test('renderInvoiceText: formats prices with formatEuros', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  // 2 × Logo package at €1,200.00 = €2,400.00
+  assert.match(text, /2 × Logo package @ €1,200\.00 = €2,400\.00/);
+});
+
+test('renderInvoiceText: shows total line', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 8 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /^Total: €760\.00$/m);
+});
+
+test('renderInvoiceText: calculates correct total for multiple lines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  // 5 × 9500 + 3 × 8500 = 47500 + 25500 = 73000 cents = 730.00
+  assert.match(text, /^Total: €730\.00$/m);
+});
+
+test('renderInvoiceText: shows all lines in order', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-14',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'ICON-SET', qty: 10 },
+    ],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 6); // DRAFT + customer + 3 lines + total
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.match(lines[2], /Development \(hour\)/);
+  assert.match(lines[3], /Design work \(hour\)/);
+  assert.match(lines[4], /Icon set/);
+  assert.match(lines[5], /^Total:/);
+});
