+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string} - Plain-text invoice
+ */
+export function renderInvoiceText(invoice) {
+  // Get invoice number or DRAFT
+  const invoiceNumber = invoice.number ?? 'DRAFT';
+
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  // Build lines
+  const lines = [invoiceNumber, customerName];
+
+  // Add invoice lines
+  let total = 0;
+  for (const line of invoice.lines) {
+    const lineTotalResult = lineTotal(line);
+    if (lineTotalResult.ok) {
+      const lineAmount = lineTotalResult.value;
+      total += lineAmount;
+      lines.push(
+        `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lineAmount)}`
+      );
+    }
+  }
+
+  // Add total line
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return lines.join('\n');
+}
