+/**
+ * Calculate the VAT for a single line ((lineTotal - lineDiscount) × vatRate / 100).
+ * @param {{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineVAT(line) {
+  if (!line || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number' || typeof line.vatRate !== 'number') {
+    return fail('LINE_INVALID');
+  }
+
+  const lineTotalResult = lineTotal(line);
+  if (!lineTotalResult.ok) {
+    return lineTotalResult;
+  }
+
