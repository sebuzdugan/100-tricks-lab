+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('getCustomer: normalizes various formats consistently', () => {
+  const variants = ['C-005', 'c-005', ' C-005 ', ' c-005 '];
+  const expected = { ok: true, value: { id: 'C-005', name: 'Orchard Health', email: 'billing@orchard.example', country: 'DE', tier: 'silver' } };
