+test('normalizeId: trims whitespace from ID', () => {
+  assert.equal(normalizeId(' C-001 '), 'C-001');
+  assert.equal(normalizeId('  C-005  '), 'C-005');
+});
+
+test('normalizeId: converts lowercase to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-007'), 'C-007');
+});
+
+test('normalizeId: handles mixed case and spaces', () => {
+  assert.equal(normalizeId(' c-001 '), 'C-001');
+  assert.equal(normalizeId('C-007 '), 'C-007');
+  assert.equal(normalizeId(' c-007'), 'C-007');
+});
+
+test('normalizeId: handles already-normalized IDs', () => {
+  assert.equal(normalizeId('C-001'), 'C-001');
+  assert.equal(normalizeId('C-012'), 'C-012');
+});
+
+test('normalizeId: works with non-string input', () => {
+  assert.equal(normalizeId(123), '123');
+});
+
+test('getCustomer: finds customer with lowercase ID', () => {
+  const result = getCustomer('c-001');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer: finds customer with mixed case and spaces', () => {
+  const result = getCustomer(' c-002 ');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Blue Fern Bakery');
+});
+
+test('getCustomer: finds customer with uppercase and spaces', () => {
+  const result = getCustomer(' C-003 ');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Kite & Co');
+});
+
+test('getCustomer: still reports unknown customer correctly', () => {
