diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..19bd09e
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,119 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate: accepts valid dates in YYYY-MM-DD format', () => {
+  assert.equal(isValidDate('2025-02-14'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2025-12-25'), true);
+});
+
+test('isValidDate: rejects invalid format', () => {
+  assert.equal(isValidDate('2025/02/14'), false);
+  assert.equal(isValidDate('14-02-2025'), false);
+  assert.equal(isValidDate('02-14-2025'), false);
+  assert.equal(isValidDate('2025-2-14'), false);
+  assert.equal(isValidDate('2025-02-4'), false);
+});
+
+test('isValidDate: rejects non-existent dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-04-31'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-15'), false);
+});
+
+test('isValidDate: handles leap years correctly', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('isValidDate: rejects empty string', () => {
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate: rejects strings with whitespace', () => {
+  assert.equal(isValidDate(' 2025-02-14'), false);
+  assert.equal(isValidDate('2025-02-14 '), false);
+  assert.equal(isValidDate(' 2025-02-14 '), false);
+});
+
+test('addDays: adds positive number of days', () => {
+  assert.equal(addDays('2025-02-14', 1), '2025-02-15');
+  assert.equal(addDays('2025-02-14', 10), '2025-02-24');
+  assert.equal(addDays('2025-02-14', 365), '2026-02-14');
+});
+
+test('addDays: handles month boundaries', () => {
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+});
+
+test('addDays: handles year boundaries', () => {
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+  assert.equal(addDays('2024-01-01', 365), '2024-12-31');
+});
+
+test('addDays: handles leap year correctly', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays: subtracts days with negative number', () => {
+  assert.equal(addDays('2025-02-14', -1), '2025-02-13');
+  assert.equal(addDays('2025-02-14', -10), '2025-02-04');
+  assert.equal(addDays('2025-03-01', -1), '2025-02-28');
+});
+
+test('addDays: handles zero days', () => {
+  assert.equal(addDays('2025-02-14', 0), '2025-02-14');
+});
+
+test('addDays: handles large day counts', () => {
+  assert.equal(addDays('2025-01-01', 1000), '2027-09-28');
+});
+
+test('daysBetween: calculates positive difference', () => {
+  assert.equal(daysBetween('2025-02-14', '2025-02-15'), 1);
+  assert.equal(daysBetween('2025-02-14', '2025-02-24'), 10);
+  assert.equal(daysBetween('2025-02-14', '2026-02-14'), 365);
+});
+
+test('daysBetween: calculates negative difference', () => {
+  assert.equal(daysBetween('2025-02-15', '2025-02-14'), -1);
+  assert.equal(daysBetween('2025-02-24', '2025-02-14'), -10);
+});
+
+test('daysBetween: returns zero for same date', () => {
+  assert.equal(daysBetween('2025-02-14', '2025-02-14'), 0);
+});
+
+test('daysBetween: handles month boundaries', () => {
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1);
+  assert.equal(daysBetween('2025-01-31', '2025-02-01'), 1);
+});
+
+test('daysBetween: handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
+
+test('daysBetween: handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween: handles large date differences', () => {
+  assert.equal(daysBetween('2000-01-01', '2025-02-14'), 9176);
+});
+
+test('addDays and daysBetween: are inverse operations', () => {
+  const start = '2025-02-14';
+  const n = 100;
+  const end = addDays(start, n);
+  assert.equal(daysBetween(start, end), n);
+});
