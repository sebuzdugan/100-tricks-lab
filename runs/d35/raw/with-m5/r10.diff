new file mode 100644
index 0000000..9acd63c
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,51 @@
+/**
+ * Check if text is a valid date in 'YYYY-MM-DD' format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  // Check format YYYY-MM-DD
+  const regex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!regex.test(text)) {
+    return false;
+  }
+
+  // Parse and check if it's a valid date
+  const date = new Date(text + 'T00:00:00Z');
+  const parts = text.split('-');
+  const year = parseInt(parts[0], 10);
+  const month = parseInt(parts[1], 10);
+  const day = parseInt(parts[2], 10);
+
+  // Check if date components match (handles invalid dates like 2025-02-30)
+  return date.getUTCFullYear() === year &&
+         date.getUTCMonth() === month - 1 &&
+         date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date in UTC.
+ * @param {string} date - Date in 'YYYY-MM-DD' format
+ * @param {number} n - Number of days to add
+ * @returns {string} - Date in 'YYYY-MM-DD' format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.getUTCFullYear() +
+         '-' + String(d.getUTCMonth() + 1).padStart(2, '0') +
+         '-' + String(d.getUTCDate()).padStart(2, '0');
+}
+
+/**
+ * Calculate the number of days between two dates (b - a) in UTC.
+ * @param {string} a - Date in 'YYYY-MM-DD' format
+ * @param {string} b - Date in 'YYYY-MM-DD' format
+ * @returns {number} - Number of whole days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
