+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement: CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('UNKNOWN-CUSTOMER', [], '2025-02-14');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement: DATE_INVALID for invalid asOf date', () => {
+  const result = statement('C-001', [], '2025-13-01');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('statement: returns empty list for customer with no invoices', () => {
+  const result = statement('C-001', [], '2025-02-14');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement: includes only issued invoices', () => {
+  const draftInvoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(draftInvoiceResult.ok, true);
+  const draftInvoice = draftInvoiceResult.value;
+
+  const result = statement('C-001', [draftInvoice], '2025-02-14');
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement: includes only issued invoices, not partially paid', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = invoiceResult.value;
+
+  const issueResult = issueInvoice(invoice, []);
+  assert.equal(issueResult.ok, true);
+  invoice = issueResult.value;
+
+  const paymentResult = recordPayment(invoice, { amount: 500, date: '2025-02-20' });
+  assert.equal(paymentResult.ok, true);
+  invoice = paymentResult.value;
+
+  const result = statement('C-001', [invoice], '2025-02-20');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice.number);
+});
+
+test('statement: excludes invoices with issueDate after asOf', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = invoiceResult.value;
+
+  const issueResult = issueInvoice(invoice, []);
+  assert.equal(issueResult.ok, true);
+  invoice = issueResult.value;
+
+  const result = statement('C-001', [invoice], '2025-02-14');
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement: includes invoices with issueDate equal to asOf', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = invoiceResult.value;
+
+  const issueResult = issueInvoice(invoice, []);
+  assert.equal(issueResult.ok, true);
+  invoice = issueResult.value;
+
+  const result = statement('C-001', [invoice], '2025-02-14');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement: filters by customerId correctly', () => {
+  let invoice1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  let invoice2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+
+  assert.equal(invoice1Result.ok, true);
+  assert.equal(invoice2Result.ok, true);
+
+  let invoice1 = issueInvoice(invoice1Result.value, []).value;
+  let invoice2 = issueInvoice(invoice2Result.value, []).value;
+
+  const result = statement('C-001', [invoice1, invoice2], '2025-02-14');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, invoice1.number);
+});
+
+test('statement: normalizes customerId', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = statement('c-001', [invoice], '2025-02-14');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement: sorts invoices by issueDate', () => {
+  let invoice1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  let invoice2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+
+  let invoice3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+
+  assert.equal(invoice1Result.ok, true);
+  assert.equal(invoice2Result.ok, true);
+  assert.equal(invoice3Result.ok, true);
+
+  let invoice1 = issueInvoice(invoice1Result.value, ['2025-0001']).value;
+  let invoice2 = issueInvoice(invoice2Result.value, ['2025-0001']).value;
+  let invoice3 = issueInvoice(invoice3Result.value, ['2025-0001']).value;
+
+  const result = statement('C-001', [invoice1, invoice2, invoice3], '2025-02-28');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2025-02-10');
+  assert.equal(result.value.invoices[1].issueDate, '2025-02-15');
+  assert.equal(result.value.invoices[2].issueDate, '2025-02-20');
+});
+
+test('statement: includes invoice number, issueDate, dueDate, total, and due', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = statement('C-001', [invoice], '2025-02-14');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  const statementInvoice = result.value.invoices[0];
+  assert('number' in statementInvoice);
+  assert('issueDate' in statementInvoice);
+  assert('dueDate' in statementInvoice);
+  assert('total' in statementInvoice);
+  assert('due' in statementInvoice);
+});
+
+test('statement: calculates totalDue as sum of due amounts', () => {
+  let invoice1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  let invoice2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoice1Result.ok, true);
+  assert.equal(invoice2Result.ok, true);
+
+  let invoice1 = issueInvoice(invoice1Result.value, []).value;
+  let invoice2 = issueInvoice(invoice2Result.value, ['2025-0001']).value;
+
+  const result = statement('C-001', [invoice1, invoice2], '2025-02-28');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  const expected = result.value.invoices[0].due + result.value.invoices[1].due;
+  assert.equal(result.value.totalDue, expected);
+});
+
+test('statement: reflects partial payments in due amount', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const paymentResult = recordPayment(invoice, { amount: 5000, date: '2025-02-20' });
+  assert.equal(paymentResult.ok, true);
+  invoice = paymentResult.value;
+
+  const result = statement('C-001', [invoice], '2025-02-28');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  // Due should be less than total
+  assert(result.value.invoices[0].due < result.value.invoices[0].total);
+});
+
+
+test('statement: includes multiple invoices for customer', () => {
+  const invoiceCount = 5;
+  const invoices = [];
+
+  for (let i = 0; i < invoiceCount; i++) {
+    const date = `2025-02-${String(10 + i).padStart(2, '0')}`;
+    let invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DEV-HOUR', qty: i + 1 }],
+    });
+    assert.equal(invoiceResult.ok, true);
+
+    const issued = issueInvoice(invoiceResult.value, invoices.map(inv => inv.number)).value;
+    invoices.push(issued);
+  }
+
+  const result = statement('C-001', invoices, '2025-02-28');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, invoiceCount);
+});
+
+test('statement: preserves immutability of input invoices', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+  const originalStatus = invoice.status;
+
+  statement('C-001', [invoice], '2025-02-14');
+
+  assert.equal(invoice.status, originalStatus);
+});
+
+test('statement: handles invoices with discounts and VAT', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = statement('C-001', [invoice], '2025-02-14');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert(result.value.invoices[0].total > 0);
+  assert(result.value.invoices[0].due > 0);
+});
+
