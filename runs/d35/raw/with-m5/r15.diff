+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote: creates credit note for issued invoice', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Damaged goods', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert('number' in result.value);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Damaged goods');
+  assert.equal(result.value.date, '2025-02-20');
+});
+
+test('createCreditNote: NOT_ISSUED for draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Damaged goods', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote: works for partially_paid invoice', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const paymentResult = recordPayment(invoice, { amount: 5000, date: '2025-02-20' });
+  assert.equal(paymentResult.ok, true);
+  invoice = paymentResult.value;
+
+  assert.equal(invoice.status, 'partially_paid');
+
+  const result = createCreditNote(invoice, { amount: 2000, reason: 'Discount', date: '2025-02-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert('number' in result.value);
+});
+
+test('createCreditNote: AMOUNT_INVALID for zero amount', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = createCreditNote(invoice, { amount: 0, reason: 'Invalid', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: AMOUNT_INVALID for negative amount', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = createCreditNote(invoice, { amount: -1000, reason: 'Invalid', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: AMOUNT_INVALID for fractional amount', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = createCreditNote(invoice, { amount: 5000.5, reason: 'Invalid', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: CREDIT_TOO_HIGH for amount exceeding invoice total', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  // Invoice total is 9500 + 21% VAT = 11495
+  const result = createCreditNote(invoice, { amount: 20000, reason: 'Too high', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote: uses CN prefix for credit note number', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert(result.value.number.startsWith('CN-'));
+});
+
+test('createCreditNote: assigns incrementing numbers', () => {
+  let invoice1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  let invoice2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoice1Result.ok, true);
+  assert.equal(invoice2Result.ok, true);
+
+  let invoice1 = issueInvoice(invoice1Result.value, []).value;
+  let invoice2 = issueInvoice(invoice2Result.value, ['2025-0001']).value;
+
+  const result1 = createCreditNote(invoice1, { amount: 1000, reason: 'Test 1', date: '2025-02-20' }, []);
+  assert.equal(result1.ok, true);
+
+  const result2 = createCreditNote(invoice2, { amount: 1000, reason: 'Test 2', date: '2025-02-20' }, [result1.value.number]);
+
+  assert.equal(result2.ok, true);
+  assert.notEqual(result1.value.number, result2.value.number);
+});
+
+test('createCreditNote: separates credit note counter from invoice counter', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, ['INV-2025-0005']).value;
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2025-02-14' }, ['INV-2025-0005']);
+
+  assert.equal(result.ok, true);
+  // Credit note should start at 0001, not affected by invoice numbers
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote: includes invoiceNumber from issued invoice', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert(result.value.invoiceNumber.startsWith('INV-'));
+});
+
+test('createCreditNote: preserves immutability of invoice', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const originalStatus = invoice.status;
+  const originalNumber = invoice.number;
+
+  createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2025-02-20' }, []);
+
+  assert.equal(invoice.status, originalStatus);
+  assert.equal(invoice.number, originalNumber);
+});
+
+test('createCreditNote: handles multiple credit notes for same invoice', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 20 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result1 = createCreditNote(invoice, { amount: 5000, reason: 'First credit', date: '2025-02-20' }, []);
+  assert.equal(result1.ok, true);
+
+  const result2 = createCreditNote(invoice, { amount: 3000, reason: 'Second credit', date: '2025-02-25' }, [result1.value.number]);
+  assert.equal(result2.ok, true);
+
+  assert.notEqual(result1.value.number, result2.value.number);
+  assert.equal(result1.value.invoiceNumber, result2.value.invoiceNumber);
+});
+
+test('createCreditNote: handles mixed invoice and credit note numbers', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const existingNumbers = [
+    'INV-2025-0001',
+    'CN-2025-0001',
+    'INV-2025-0002',
+    'CN-2025-0002',
+    'INV-2025-0003',
+  ];
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2025-02-14' }, existingNumbers);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0003');
+});
+
+test('createCreditNote: handles year boundary for numbering', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const existingNumbers = ['CN-2025-0001', 'CN-2025-0002'];
+
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2026-01-14' }, existingNumbers);
+
+  assert.equal(result.ok, true);
+  // New year should restart counter at 0001
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote: validates invoice with discounts', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  // Invoice: 95000 - 9500 + 17955 = 103455 total
+  const result = createCreditNote(invoice, { amount: 103455, reason: 'Full refund', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 103455);
+});
+
+test('createCreditNote: rejects credit note exceeding discounted invoice', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = createCreditNote(invoice, { amount: 200000, reason: 'Too high', date: '2025-02-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
