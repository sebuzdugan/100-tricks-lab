   return `${prefix}${String(nextCounter).padStart(4, '0')}`;
 }
+
+/**
+ * Get the next credit note number for a given issue date.
+ * Credit note numbers have format CN-<year>-<counter> where counter resets each year.
+ * @param {Array<string>} existingNumbers - Array of already-used numbers (invoices and credit notes, any order)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - Next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  // Find all credit note numbers for this year and extract their counters
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.substring(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((num) => !isNaN(num) && num > 0);
+
+  // Find the next available counter
+  const nextCounter = countersThisYear.length === 0 ? 1 : Math.max(...countersThisYear) + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
