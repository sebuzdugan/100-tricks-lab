+
+test('overdueInvoices: handles multiple overdue invoices for same customer', () => {
+  const invoices = [];
+
+  for (let i = 0; i < 5; i++) {
+    const date = `2025-02-${String(10 + i).padStart(2, '0')}`;
+    let invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.equal(invoiceResult.ok, true);
+
+    const issued = issueInvoice(invoiceResult.value, invoices.map(inv => inv.number || '')).value;
+    invoices.push(issued);
+  }
+
+  const result = overdueInvoices(invoices, '2025-03-30');
+
+  assert.equal(result.length, 5);
+  assert.equal(result[0].customerId, 'C-001');
+});
