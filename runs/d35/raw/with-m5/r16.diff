+    customerId: 'C-001',
+    issueDate: '2025-02-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  let invoice2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  let invoice3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(invoice1Result.ok, true);
+  assert.equal(invoice2Result.ok, true);
+  assert.equal(invoice3Result.ok, true);
+
+  let invoice1 = issueInvoice(invoice1Result.value, []).value;
+  let invoice2 = issueInvoice(invoice2Result.value, ['2025-0001']).value;
+  let invoice3 = issueInvoice(invoice3Result.value, ['2025-0001', '2025-0002']).value;
+
+  const result = overdueInvoices([invoice3, invoice1, invoice2], '2025-03-25');
+
+  assert.equal(result.length, 3);
+  // invoice1 due 2025-03-03, days overdue = 22
+  // invoice2 due 2025-03-12, days overdue = 13
+  // invoice3 due 2025-03-22, days overdue = 3
+  assert.equal(result[0].number, invoice1.number);
+  assert.equal(result[1].number, invoice2.number);
+  assert.equal(result[2].number, invoice3.number);
+});
+
+test('overdueInvoices: handles mixed issued and partially_paid', () => {
+  let invoice1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
