+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = overdueInvoices([invoice], '2025-03-20');
+
+  assert.equal(result.length, 1);
+  const overdue = result[0];
