+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices: returns empty array for no invoices', () => {
+  const result = overdueInvoices([], '2025-03-01');
+
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: returns empty array for no overdue invoices', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  // Invoice due date is 2025-03-16 (NET30), so not overdue on 2025-03-15
+  const result = overdueInvoices([invoice], '2025-03-15');
+
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: includes invoice with dueDate before asOf', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  // Invoice due date is 2025-03-16, so overdue on 2025-03-17
+  const result = overdueInvoices([invoice], '2025-03-17');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoice.number);
+});
+
+test('overdueInvoices: excludes draft invoices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = invoiceResult.value;
+
+  const result = overdueInvoices([invoice], '2025-04-01');
+
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: includes partially_paid invoices', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const paymentResult = recordPayment(invoice, { amount: 50000, date: '2025-03-01' });
+  assert.equal(paymentResult.ok, true);
+  invoice = paymentResult.value;
+
+  assert.equal(invoice.status, 'partially_paid');
+
+  const result = overdueInvoices([invoice], '2025-03-17');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoice.number);
+});
+
+test('overdueInvoices: calculates daysOverdue correctly', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  // Due date is 2025-03-16, overdue report on 2025-03-26 = 10 days overdue
+  const result = overdueInvoices([invoice], '2025-03-26');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 10);
