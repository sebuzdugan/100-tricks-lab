+/**
+ * Generate a VAT summary report.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} - VAT by rate, sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    // Only process invoices with these statuses
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      // Calculate taxable amount (line total after discount)
+      const lineTotal = line.qty * line.unitPrice;
+      const lineDiscount = line.discountPercent ? roundCents((lineTotal * line.discountPercent) / 100) : 0;
+      const taxableAmount = roundCents(lineTotal - lineDiscount);
+
+      // Calculate VAT
+      const lineVAT = roundCents((taxableAmount * line.vatRate) / 100);
+
+      // Group by rate
+      const rate = line.vatRate;
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { base: 0, vat: 0 };
+      }
+
+      vatByRate[rate].base += taxableAmount;
+      vatByRate[rate].vat += lineVAT;
+    }
+  }
+
+  // Convert to array and sort by rate descending
+  const result = Object.entries(vatByRate)
+    .map(([rate, data]) => ({
+      rate: parseFloat(rate),
+      base: roundCents(data.base),
+      vat: roundCents(data.vat),
+    }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return result;
+}
