+/**
+ * Calculate late fee for an overdue invoice.
+ * @param {{ dueDate: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents (0.04% per day of amount due), or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  // Check if invoice is overdue
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // Calculate amount due
+  const due = balanceDue(invoice);
+
+  // Calculate late fee: 0.04% per day
+  const feeRate = 0.04 / 100;
+  const fee = roundCents(due * feeRate * daysOverdue);
+
+  return fee;
+}
