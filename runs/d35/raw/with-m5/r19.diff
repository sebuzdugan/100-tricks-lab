+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Escape a field for CSV export.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  if (field == null) {
+    return '';
+  }
+
+  const str = String(field);
+
+  // If field contains comma, double quote, or newline, wrap in quotes and escape quotes
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+
+  return str;
+}
+
+/**
+ * Format amount in cents as euros string with 2 decimals.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array<{ number: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array }>} invoices
+ * @returns {string} - CSV formatted string with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Add header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Add invoice lines
+  for (const invoice of invoices) {
+    // Get customer name
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+    // Calculate totals
+    const totalsResult = invoiceTotals(invoice);
+    const totals = totalsResult.ok ? totalsResult.value : { subtotal: 0, discount: 0, vat: 0, total: 0 };
+
+    // Calculate amount due
+    const due = balanceDue(invoice);
+
+    // Build CSV line
+    const fields = [
+      invoice.number || '',
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    const csvLine = fields.map(escapeCsvField).join(',');
+    lines.push(csvLine);
+  }
+
+  return lines.join('\n') + '\n';
+}
