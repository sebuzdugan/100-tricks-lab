+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv: returns CSV string starting with header', () => {
+  const result = exportCsv([]);
+
+  assert(result.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+  assert(result.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv: ends with newline', () => {
+  const result = exportCsv([]);
+
+  assert(result.endsWith('\n'));
+});
+
+test('exportCsv: exports single invoice', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = exportCsv([invoice]);
+
+  assert(result.includes('Northwind Studio'));
+  assert(result.includes('2025-02-14'));
+  assert(result.includes('issued'));
+});
+
+test('exportCsv: includes invoice number', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = exportCsv([invoice]);
+
+  assert(result.includes(invoice.number));
+});
+
+test('exportCsv: includes customer name', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
