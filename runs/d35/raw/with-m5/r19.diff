+test('exportCsv: formats amounts as euros with 2 decimals', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  const invoice = issueInvoice(invoiceResult.value, []).value;
+
+  const result = exportCsv([invoice]);
+
+  // Check that amounts have 2 decimal places
+  assert(result.includes('.00'));
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  // Check that at least some amount fields have 2 decimals
+  assert(parts.some(p => /\d+\.\d{2}/.test(p)));
+});
