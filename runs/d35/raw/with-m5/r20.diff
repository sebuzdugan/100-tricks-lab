+
+test('RATES has EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert: returns ok for valid currencies', () => {
+  const result = convert(100, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 100);
+});
+
+test('convert: EUR to USD', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 10000 cents EUR * 1.085 = 10850 cents USD
+  assert.equal(result.value, 10850);
+});
+
+test('convert: EUR to GBP', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  // 10000 cents EUR * 0.8425 = 8425 cents GBP
+  assert.equal(result.value, 8425);
+});
+
+test('convert: returns same amount for EUR', () => {
+  const result = convert(12345, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 12345);
+});
+
+test('convert: UNKNOWN_CURRENCY for invalid code', () => {
+  const result = convert(100, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert: rounds result to whole cents', () => {
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  // 1 * 1.085 = 1.085, rounds to 1
+  assert.equal(result.value, 1);
+});
+
+test('convert: handles large amounts', () => {
+  const result = convert(100000000, 'USD');
+  assert.equal(result.ok, true);
+  // 100000000 * 1.085 = 108500000
+  assert.equal(result.value, 108500000);
+});
+
+test('convert: handles negative amounts', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  // -10000 * 1.085 = -10850
+  assert.equal(result.value, -10850);
+});
+
+test('formatMoney: EUR uses euro symbol', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+});
+
+test('formatMoney: USD uses dollar symbol', () => {
