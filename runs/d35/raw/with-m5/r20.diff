diff --git a/src/money.js b/src/money.js
index fadf486..6d235ff 100644
--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,53 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert an amount from euros to another currency.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }} - Amount in target currency's cents
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const targetCents = roundCents(cents * rate);
+
+  return ok(targetCents);
+}
+
+/**
+ * Format cents in a specific currency for people.
+ * @param {number} cents - Amount in cents of the target currency
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string} - Formatted string like €1,234.56 or $1,234.56
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const wholeAmount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const fractional = String(abs % 100).padStart(2, '0');
+
+  let symbol;
+  if (currency === 'USD') {
+    symbol = '$';
+  } else if (currency === 'GBP') {
+    symbol = '£';
+  } else {
+    symbol = '€';
+  }
+
+  return `${sign}${symbol}${wholeAmount}.${fractional}`;
+}
