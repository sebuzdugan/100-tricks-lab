+test('mergeCustomers: merges duplicate customer successfully', () => {
+  const customers = listCustomers();
+  const invoices = [
+    { customerId: 'C-001', number: 'INV-2025-0001' },
+    { customerId: 'C-002', number: 'INV-2025-0002' },
+    { customerId: 'C-001', number: 'INV-2025-0003' },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, customers.length - 1);
+  assert.equal(result.value.invoices.length, 3);
+});
+
+test('mergeCustomers: removes fromId customer', () => {
