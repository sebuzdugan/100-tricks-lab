+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal: calculates qty × unitPrice', () => {
+  const result = lineTotal({ qty: 10, unitPrice: 9500 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 95000);
+});
+
+test('lineTotal: works with qty of 1', () => {
+  const result = lineTotal({ qty: 1, unitPrice: 1200 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1200);
+});
+
+test('lineTotal: works with large quantities', () => {
+  const result = lineTotal({ qty: 1000, unitPrice: 9500 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 9500000);
+});
+
+test('lineTotal: LINE_INVALID for missing qty', () => {
+  const result = lineTotal({ unitPrice: 1200 });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'LINE_INVALID');
+});
+
+test('lineTotal: LINE_INVALID for missing unitPrice', () => {
+  const result = lineTotal({ qty: 10 });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'LINE_INVALID');
+});
+
+test('lineTotal: LINE_INVALID for null line', () => {
+  const result = lineTotal(null);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'LINE_INVALID');
+});
+
+test('lineTotal: LINE_INVALID for undefined line', () => {
+  const result = lineTotal(undefined);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'LINE_INVALID');
+});
+
+test('lineDiscount: calculates lineTotal × discountPercent / 100', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 9500, discountPercent: 10 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 9500);
+});
+
+test('lineDiscount: returns 0 when no discount', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 9500 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('lineDiscount: handles decimal discount percentages', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 10000, discountPercent: 2.5 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 2500);
+});
+
+test('lineDiscount: clamps negative discounts to 0', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 9500, discountPercent: -5 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('lineVAT: calculates (lineTotal - lineDiscount) × vatRate / 100', () => {
+  const result = lineVAT({ qty: 10, unitPrice: 9500, vatRate: 21 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 19950);
+});
+
+test('lineVAT: calculates VAT on line total after discount', () => {
+  const result = lineVAT({ qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 10 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 17955);
+});
+
+test('lineVAT: handles 9% VAT', () => {
+  const result = lineVAT({ qty: 5, unitPrice: 2490, vatRate: 9 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1120);
+});
+
+test('lineVAT: handles 0% VAT (VAT exempt)', () => {
+  const result = lineVAT({ qty: 1, unitPrice: 10000, vatRate: 0 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('lineVAT: clamps negative VAT to 0', () => {
+  const result = lineVAT({ qty: 10, unitPrice: 9500, vatRate: -5 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('invoiceTotals: calculates subtotal and total for single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 95000);
+  assert.equal(result.value.discount, 0);
+  assert.equal(result.value.vat, 19950);
+  assert.equal(result.value.voucher, 0);
+  assert.equal(result.value.total, 114950);
+});
+
+test('invoiceTotals: calculates subtotal and total for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+      { qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  // Line 1: 10 * 9500 = 95000, Line 2: 5 * 8500 = 42500, Subtotal = 137500
+  // VAT: (95000 + 42500) * 21% = 28875, Total = 137500 + 28875 = 166375
+  assert.equal(result.value.subtotal, 137500);
+  assert.equal(result.value.total, 166375);
+});
+
+test('invoiceTotals: returns zero totals for empty lines', () => {
+  const invoice = { lines: [] };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 0);
+  assert.equal(result.value.discount, 0);
+  assert.equal(result.value.vat, 0);
+  assert.equal(result.value.total, 0);
+});
+
+test('invoiceTotals: INVOICE_INVALID for missing lines', () => {
+  const invoice = {};
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'INVOICE_INVALID');
+});
+
+test('invoiceTotals: INVOICE_INVALID for null invoice', () => {
+  const result = invoiceTotals(null);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'INVOICE_INVALID');
+});
+
+test('invoiceTotals: INVOICE_INVALID for undefined invoice', () => {
+  const result = invoiceTotals(undefined);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'INVOICE_INVALID');
+});
+
+test('invoiceTotals: LINE_INVALID if a line is malformed', () => {
+  const invoice = {
+    lines: [{ qty: 10 }],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'LINE_INVALID');
+});
+
+test('invoiceTotals: VAT and discounts added to subtotal', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 10 }],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 95000);
+  assert.equal(result.value.discount, 9500);
+  assert.equal(result.value.vat, 17955);
+  assert.equal(result.value.total, 103455);
+});
+
+test('invoiceTotals: includes voucher field', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 1000 },
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert('voucher' in result.value);
+  assert.equal(result.value.voucher, 1000);
+});
+
+test('invoiceTotals: calculates total with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21 }],
+    voucher: { code: 'DISCOUNT', amount: 1000 },
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.total, 113950);
+});
+
+test('invoiceTotals: returns voucher 0 when no voucher applied', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher, 0);
+});
+
+test('invoiceTotals: total = subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 10 }],
+    voucher: { code: 'TEST', amount: 500 },
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 95000);
+  assert.equal(result.value.discount, 9500);
+  assert.equal(result.value.vat, 17955);
+  assert.equal(result.value.voucher, 500);
+  assert.equal(result.value.total, 102955);
+});
