+++ b/src/totals.js
@@ -0,0 +1,110 @@
+import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineTotal(line) {
+  if (!line || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number') {
+    return fail('LINE_INVALID');
+  }
+  return ok(roundCents(line.qty * line.unitPrice));
+}
+
+/**
+ * Calculate the discount for a single line (lineTotal × discountPercent / 100).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineDiscount(line) {
+  if (!line || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number') {
+    return fail('LINE_INVALID');
+  }
+
+  if (!line.discountPercent) {
+    return ok(0);
+  }
+
+  const lineTotalResult = lineTotal(line);
+  if (!lineTotalResult.ok) {
+    return lineTotalResult;
+  }
+
+  const discount = roundCents((lineTotalResult.value * line.discountPercent) / 100);
+  return ok(Math.max(0, discount));
+}
+
+/**
+ * Calculate the VAT for a single line ((lineTotal - lineDiscount) × vatRate / 100).
+ * @param {{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineVAT(line) {
+  if (!line || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number' || typeof line.vatRate !== 'number') {
+    return fail('LINE_INVALID');
+  }
+
+  const lineTotalResult = lineTotal(line);
+  if (!lineTotalResult.ok) {
+    return lineTotalResult;
+  }
+
+  const lineDiscountResult = lineDiscount(line);
+  if (!lineDiscountResult.ok) {
+    return lineDiscountResult;
+  }
+
+  const taxableAmount = lineTotalResult.value - lineDiscountResult.value;
+  const vat = roundCents((taxableAmount * line.vatRate) / 100);
+  return ok(Math.max(0, vat));
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, voucher: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines)) {
+    return fail('INVOICE_INVALID');
+  }
+
+  let subtotal = 0;
+  let totalDiscount = 0;
+  let totalVAT = 0;
+  for (const line of invoice.lines) {
+    const lineTotalResult = lineTotal(line);
+    if (!lineTotalResult.ok) {
+      return fail('LINE_INVALID');
+    }
+    subtotal += lineTotalResult.value;
+
+    const lineDiscountResult = lineDiscount(line);
+    if (!lineDiscountResult.ok) {
+      return fail('LINE_INVALID');
+    }
+    totalDiscount += lineDiscountResult.value;
+
+    const lineVATResult = lineVAT(line);
+    if (!lineVATResult.ok) {
+      return fail('LINE_INVALID');
+    }
+    totalVAT += lineVATResult.value;
+  }
+
+  subtotal = roundCents(subtotal);
+  totalDiscount = roundCents(totalDiscount);
+  totalVAT = roundCents(totalVAT);
+  const voucherAmount = invoice.voucher ? roundCents(invoice.voucher.amount) : 0;
+  const total = Math.max(0, roundCents(subtotal - totalDiscount + totalVAT - voucherAmount));
+
+  return ok({
+    subtotal,
+    discount: totalDiscount,
+    vat: totalVAT,
+    voucher: voucherAmount,
+    total,
+  });
+}
