+test('dashboard: returns empty counts for empty invoices', () => {
+  const result = dashboard([], '2025-03-01');
+
+  assert.deepEqual(result.counts, {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  });
+  assert.equal(result.outstanding, 0);
+  assert.equal(result.overdue.count, 0);
+  assert.equal(result.overdue.amount, 0);
+  assert.deepEqual(result.topCustomers, []);
+});
+
+test('dashboard: counts invoices by status', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value, []).value;
+
+  const result = dashboard([draft1, draft2, issued], '2025-03-01');
+
+  assert.equal(result.counts.draft, 2);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.partially_paid, 0);
+  assert.equal(result.counts.paid, 0);
+});
+
+test('dashboard: calculates outstanding amount', () => {
+  const issued = issueInvoice(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value, []).value;
+
+  const result = dashboard([issued], '2025-03-01');
+
+  // C-001 is gold tier (5% discount)
+  // 5 * 9500 = 47500, tier discount: 47500 * 5% = 2375
+  // Taxable: 47500 - 2375 = 45125, VAT: 45125 * 21% = 9476.25 ≈ 9476
+  // Total: 47500 - 2375 + 9476 = 54601
+  assert.equal(result.outstanding, 54601);
+});
+
+test('dashboard: includes only issued or partially_paid in outstanding', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  let issued1 = issueInvoice(createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value, []).value;
+
+  let issued2 = issueInvoice(createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value, ['2025-0001']).value;
+
+  const paymentResult = recordPayment(issued2, { amount: 30, date: '2025-03-01' });
+  assert.equal(paymentResult.ok, true);
+  const partially_paid = paymentResult.value;
+
+  const result = dashboard([draft, issued1, partially_paid], '2025-03-01');
+
+  // issued1: STICKER 1 * 50 = 50 (C-002 standard tier 0%), VAT: 50 * 21% = 10.5 ≈ 10, total = 60
+  // partially_paid: same as issued1 = 60, minus 30 paid = 30 still due
+  // draft: not counted
+  // outstanding: 60 + 30 = 90
+  assert.equal(result.outstanding, 90);
+});
