+/**
+ * Generate a dashboard summary.
+ * @param {Array<{ status: string, customerId: string, dueDate: string, lines: Array, payments?: Array }>} invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format (inclusive)
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    const status = invoice.status || 'draft';
+    if (status in counts) {
+      counts[status]++;
+    }
+  }
+
+  // Calculate outstanding amount (issued or partially_paid invoices)
+  let outstanding = 0;
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      outstanding += balanceDue(invoice);
+    }
+  }
+  outstanding = roundCents(outstanding);
+
+  // Get overdue information
+  const overdueList = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdueList.length,
+    amount: roundCents(overdueList.reduce((sum, inv) => sum + inv.due, 0)),
+  };
+
+  // Calculate top customers by amount due
+  const customerDue = {};
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const customerId = invoice.customerId;
+      const due = balanceDue(invoice);
+      if (!customerDue[customerId]) {
+        customerDue[customerId] = 0;
+      }
+      customerDue[customerId] += due;
+    }
+  }
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({
+      customerId,
+      due: roundCents(due),
+    }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
