+test('renderInvoiceText: includes due date, paid, and voucher together', () => {
+  let invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-14',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+
+  assert.equal(invoiceResult.ok, true);
+  let invoice = invoiceResult.value;
+
+  const voucherResult = applyVoucher(invoice, { code: 'SAVE', amount: 10 });
+  assert.equal(voucherResult.ok, true);
+  invoice = voucherResult.value;
+
+  invoice = issueInvoice(invoice, []).value;
+
+  const paymentResult = recordPayment(invoice, { amount: 20, date: '2025-03-01' });
+  assert.equal(paymentResult.ok, true);
+  invoice = paymentResult.value;
+
+  const text = renderInvoiceText(invoice);
+
+  const lines = text.split('\n');
+  const totalIndex = lines.findIndex((l) => l.startsWith('Total:'));
+  const voucherIndex = lines.findIndex((l) => l.startsWith('Voucher:'));
+  const dueIndex = lines.findIndex((l) => l.startsWith('Due:'));
+  const paidIndex = lines.findIndex((l) => l.startsWith('Paid:'));
+
+  // Voucher should be before Total
+  assert(voucherIndex < totalIndex);
+  // Due should be after Total
+  assert(dueIndex > totalIndex);
+  // Paid should be after Due
+  assert(paidIndex > dueIndex);
+});
