@@ -62,3 +63,22 @@ export function createInvoice({ customerId, issueDate, lines }) {
 
   return ok(invoice);
 }
+
+/**
+ * Calculate the total for a single invoice line.
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate subtotal and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number }> }}
+ * @returns {{ subtotal: number, total: number }} Amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = roundCents(invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
+  return { subtotal, total: subtotal };
+}
