+++ b/test/numbering.test.js
@@ -0,0 +1,84 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber: first invoice of the year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: second invoice of the year', () => {
+  const number = nextInvoiceNumber(['INV-2026-0001'], '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: ignores invoices from other years', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'],
+    '2026-10-07'
+  );
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: finds max counter across multiple years', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2025-0010', 'INV-2026-0001', 'INV-2026-0005', 'INV-2027-0001'],
+    '2026-10-07'
+  );
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber: handles unordered input', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'],
+    '2026-10-07'
+  );
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber: zero-pads counter to 4 digits', () => {
+  const numbers = [];
+  for (let i = 0; i < 12; i++) {
+    const num = nextInvoiceNumber(numbers, '2026-10-07');
+    numbers.push(num);
+  }
+  assert.equal(numbers[0], 'INV-2026-0001');
+  assert.equal(numbers[9], 'INV-2026-0010');
+  assert.equal(numbers[11], 'INV-2026-0012');
+});
+
+test('nextInvoiceNumber: handles large counters', () => {
+  const number = nextInvoiceNumber(['INV-2026-9999'], '2026-10-07');
+  assert.equal(number, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber: different year, different starting point', () => {
+  const invoicesFromPrevYear = [
+    'INV-2025-0050',
+    'INV-2025-0051',
+  ];
+
+  const num2025 = nextInvoiceNumber(invoicesFromPrevYear, '2025-12-31');
+  assert.equal(num2025, 'INV-2025-0052');
+
+  const num2026 = nextInvoiceNumber(invoicesFromPrevYear, '2026-01-01');
+  assert.equal(num2026, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber: extracts year from issueDate correctly', () => {
+  const number = nextInvoiceNumber([], '2026-06-15');
+  assert(number.startsWith('INV-2026-'));
+});
+
+test('nextInvoiceNumber: ignores invalid formats in existingNumbers', () => {
+  const number = nextInvoiceNumber(
+    ['INV-2026-0001', 'INVALID', 'INV-2025-0005', 'INV-2026-notanumber'],
+    '2026-10-07'
+  );
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber: handles empty existingNumbers array', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
