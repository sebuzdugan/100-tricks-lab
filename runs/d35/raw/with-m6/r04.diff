@@ -0,0 +1,27 @@
+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<4-digit counter>
+ * @param {string[]} existingNumbers Array of existing invoice numbers in any order
+ * @param {string} issueDate Invoice date in YYYY-MM-DD format
+ * @returns {string} The next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Find the highest counter for this year
+  let maxCounter = 0;
+
+  for (const number of existingNumbers) {
+    if (number.startsWith(prefix)) {
+      const counterStr = number.slice(prefix.length);
+      const counter = parseInt(counterStr, 10);
+      if (!isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
