+++ b/test/render.test.js
@@ -0,0 +1,217 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText: draft invoice shows DRAFT', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText: issued invoice shows number', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok);
+  const issueResult = issueInvoice(result.value, []);
+  assert(issueResult.ok);
+
+  const text = renderInvoiceText(issueResult.value);
+
+  assert(text.startsWith('INV-2026-0001'));
+});
+
+test('renderInvoiceText: includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText: single line invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4); // DRAFT, customer, line item, total
+  assert(lines[2].includes('5x Development (hour)'));
+  assert(lines[2].includes('€95.00'));
+  assert(lines[2].includes('€475.00'));
+});
+
+test('renderInvoiceText: multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 6); // DRAFT, customer, 3 items, total
+  assert(lines[2].includes('Development (hour)'));
+  assert(lines[3].includes('Design work (hour)'));
+  assert(lines[4].includes('Copywriting (hour)'));
+});
+
+test('renderInvoiceText: formats amounts as euros', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  // DEV-HOUR is 9500 cents = €95.00
+  // 10 x €95.00 = €950.00
+  assert(text.includes('€95.00'));
+  assert(text.includes('€950.00'));
+});
+
+test('renderInvoiceText: shows total at the end', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 }, // 5 * 95 = 475
+      { sku: 'DES-HOUR', qty: 3 }, // 3 * 85 = 255
+    ],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  const lastLine = lines[lines.length - 1];
+  assert(lastLine.startsWith('Total:'));
+  assert(lastLine.includes('€730.00'));
+});
+
+test('renderInvoiceText: works with different customers', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.includes('Kite & Co'));
+});
+
+test('renderInvoiceText: different VAT rates still show correct unit price', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 }, // 21% VAT, 9500 cents
+      { sku: 'PRINT-A4', qty: 100 }, // 9% VAT, 37 cents
+    ],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.includes('Development (hour)'));
+  assert(text.includes('€95.00'));
+  assert(text.includes('Printed flyer A4'));
+  assert(text.includes('€0.37'));
+});
+
+test('renderInvoiceText: large quantities formatted correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 5000 }],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  // STICKER is 50 cents
+  // 5000 x €0.50 = €2,500.00
+  assert(text.includes('5000x'));
+  assert(text.includes('€0.50'));
+  assert(text.includes('€2,500.00'));
+});
+
+test('renderInvoiceText: with issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok);
+  const issueResult = issueInvoice(result.value, ['INV-2026-0001', 'INV-2026-0002']);
+  assert(issueResult.ok);
+
+  const text = renderInvoiceText(issueResult.value);
+
+  assert(text.startsWith('INV-2026-0003'));
+  assert(text.includes('Northwind Studio'));
+  assert(text.includes('Development (hour)'));
+  assert(text.includes('Total: €475.00'));
+});
+
+test('renderInvoiceText: unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('Unknown customer'));
+});
+
+test('renderInvoiceText: returns string with newlines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+
+  assert(result.ok);
+  const text = renderInvoiceText(result.value);
+
+  assert(typeof text === 'string');
+  const lines = text.split('\n');
+  assert(lines.length >= 4); // At least DRAFT, customer, 2 items, total
+});
