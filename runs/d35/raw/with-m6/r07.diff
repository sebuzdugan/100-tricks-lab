+  });
+
+  assert(result.ok);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice: silver customer gets 2.5% tier discount', () => {
+  // C-003 is silver tier (Kite & Co)
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice: standard customer gets 0% tier discount', () => {
+  // C-002 is standard tier (Blue Fern Bakery)
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok);
+  // Standard tier has 0% discount, so discountPercent should not be set
+  assert.equal(result.value.lines[0].discountPercent, undefined);
+});
+
+test('createInvoice: line discountPercent overrides tier discount', () => {
+  // C-001 is gold (5%), but line specifies 10%
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }],
+  });
+
+  assert(result.ok);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice: line discountPercent of 0 overrides tier discount', () => {
+  // C-001 is gold (5%), but line explicitly sets 0%
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  assert(result.ok);
+  // Explicit 0% should not set discountPercent at all
+  assert.equal(result.value.lines[0].discountPercent, undefined);
+});
+
+test('createInvoice: multiple lines get tier discount applied to all', () => {
+  // C-003 is silver (2.5%)
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+
+  assert(result.ok);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+  assert.equal(result.value.lines[1].discountPercent, 2.5);
+});
+
+test('createInvoice: mixed tier and explicit discounts', () => {
+  // C-001 is gold (5%)
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 }, // gets gold tier 5%
+      { sku: 'DES-HOUR', qty: 3, discountPercent: 10 }, // explicit 10%
+      { sku: 'COPY-HOUR', qty: 2, discountPercent: 0 }, // explicit 0%
+    ],
+  });
+
+  assert(result.ok);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+  assert.equal(result.value.lines[1].discountPercent, 10);
+  assert.equal(result.value.lines[2].discountPercent, undefined);
+});
+
+test('invoiceTotals: includes tier discount in calculation', () => {
+  // C-001 is gold (5%)
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok);
+  const totals = invoiceTotals(result.value);
+  // 5 x 9500 = 47500, 5% discount = 2375
+  assert.equal(totals.subtotal, 47500);
+  assert.equal(totals.discount, 2375);
+  assert.equal(totals.total, 45125);
+});
+
+test('invoiceTotals: tier and explicit discounts combined', () => {
+  // C-003 is silver (2.5%)
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 }, // 5 x 9500 = 47500, 2.5% = 1187.50
+      { sku: 'DES-HOUR', qty: 3, discountPercent: 10 }, // 3 x 8500 = 25500, 10% = 2550
+    ],
+  });
+
+  assert(result.ok);
+  const totals = invoiceTotals(result.value);
+  // Subtotal: 47500 + 25500 = 73000
+  // Discount: 1187.50 + 2550 = 3737.50
+  // Total: 69262.50
+  assert.equal(totals.subtotal, 73000);
+  assert.equal(totals.discount, 3738); // rounded
+  assert.equal(totals.total, 69262);
+});
