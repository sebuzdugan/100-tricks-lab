@@ -109,15 +109,29 @@ export function lineDiscount(line) {
 }
 
 /**
- * Calculate subtotal, discount and total for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }}
- * @returns {{ subtotal: number, discount: number, total: number }} Amounts in cents
+ * Calculate the VAT amount for a single invoice line (VAT is on the amount after discount).
+ * @param {{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }}
+ * @returns {number} VAT amount in cents
+ */
+export function lineVAT(line) {
+  const lineAmountTotal = lineTotal(line);
+  const discountAmount = lineDiscount(line);
+  const lineAmountAfterDiscount = Math.max(0, lineAmountTotal - discountAmount);
+  const vat = roundCents(lineAmountAfterDiscount * line.vatRate / 100);
+  return Math.max(0, vat);
+}
+
+/**
+ * Calculate subtotal, discount, VAT and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }> }}
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }} Amounts in cents
  */
 export function invoiceTotals(invoice) {
   const subtotal = roundCents(invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
   const discount = roundCents(invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0));
-  const total = Math.max(0, roundCents(subtotal - discount));
-  return { subtotal, discount, total };
+  const vat = roundCents(invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0));
+  const total = Math.max(0, roundCents(subtotal - discount + vat));
+  return { subtotal, discount, vat, total };
 }
 
