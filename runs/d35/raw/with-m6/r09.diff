+
+test('normalizeId: trims whitespace', () => {
+  assert.equal(normalizeId(' C-003 '), 'C-003');
+  assert.equal(normalizeId('C-003 '), 'C-003');
+  assert.equal(normalizeId(' C-003'), 'C-003');
+  assert.equal(normalizeId('\tC-003\n'), 'C-003');
+});
+
+test('normalizeId: converts to uppercase', () => {
+  assert.equal(normalizeId('c-003'), 'C-003');
+  assert.equal(normalizeId('C-003'), 'C-003');
+  assert.equal(normalizeId('c-003'), 'C-003');
+});
+
+test('normalizeId: trims and converts to uppercase', () => {
+  assert.equal(normalizeId(' c-003 '), 'C-003');
+  assert.equal(normalizeId('\tc-007\t'), 'C-007');
+});
+
+test('getCustomer: accepts mixed case and whitespace', () => {
+  const result = getCustomer(' c-003 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Kite & Co');
+});
+
+test('getCustomer: finds customer with uppercase and spaces', () => {
+  const result = getCustomer('c-001 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer: still reports unknown id for non-existent customer', () => {
+  assert.deepEqual(getCustomer(' c-999 '), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
