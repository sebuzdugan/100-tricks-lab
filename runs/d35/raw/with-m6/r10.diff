diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..dcff98e
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,122 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate: accepts valid dates', () => {
+  assert(isValidDate('2026-10-07'));
+  assert(isValidDate('2026-01-01'));
+  assert(isValidDate('2026-12-31'));
+  assert(isValidDate('2000-02-29')); // leap year
+});
+
+test('isValidDate: rejects invalid format', () => {
+  assert(!isValidDate('10-07-2026'));
+  assert(!isValidDate('2026/10/07'));
+  assert(!isValidDate('2026-10-7'));
+  assert(!isValidDate('2026-1-07'));
+  assert(!isValidDate('26-10-07'));
+});
+
+test('isValidDate: rejects non-existent dates', () => {
+  assert(!isValidDate('2026-02-30'));
+  assert(!isValidDate('2026-04-31'));
+  assert(!isValidDate('2026-13-01'));
+  assert(!isValidDate('2026-00-01'));
+});
+
+test('isValidDate: rejects non-existent leap day', () => {
+  assert(!isValidDate('2026-02-29')); // not a leap year
+  assert(isValidDate('2024-02-29')); // is a leap year
+});
+
+test('isValidDate: rejects non-date strings', () => {
+  assert(!isValidDate('not-a-date'));
+  assert(!isValidDate(''));
+  assert(!isValidDate('2026-10-07T12:00:00Z'));
+  assert(!isValidDate('  2026-10-07  '));
+});
+
+test('addDays: adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+});
+
+test('addDays: subtracts with negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays: crosses month boundary', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-11-01', -1), '2026-10-31');
+});
+
+test('addDays: crosses year boundary', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays: handles leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays: large offsets', () => {
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+  assert.equal(addDays('2026-01-01', 730), '2028-01-01');
+});
+
+test('daysBetween: same date', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween: positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+});
+
+test('daysBetween: negative difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-06'), -1);
+  assert.equal(daysBetween('2026-10-07', '2026-09-27'), -10);
+});
+
+test('daysBetween: across months', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-11-01', '2026-10-31'), -1);
+});
+
+test('daysBetween: across years', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween: long span', () => {
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // leap year
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const date = '2026-10-07';
+  const n = 50;
+  const result = addDays(date, n);
+  assert.equal(daysBetween(date, result), n);
+});
+
+test('isValidDate works with addDays output', () => {
+  assert(isValidDate(addDays('2026-10-07', 1)));
+  assert(isValidDate(addDays('2026-10-07', 365)));
+  assert(isValidDate(addDays('2026-10-07', -100)));
+});
+
+test('UTC timezone consistency', () => {
+  // Adding 1 day should always be exactly 24 hours in UTC
+  const date1 = '2026-10-07';
+  const date2 = addDays(date1, 1);
+  assert.equal(daysBetween(date1, date2), 1);
+
+  // Verify round-trip
+  assert.equal(addDays(addDays(date1, 5), -5), date1);
+});
