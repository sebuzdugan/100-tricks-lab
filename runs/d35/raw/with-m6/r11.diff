+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }>, ...rest }} invoice
+ * @param {{ amount: number, date: string }}
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check invoice is issued or partially paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due before this payment
+  const due = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > due) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array
+  const payments = (invoice.payments ?? []).map((p) => ({ ...p }));
+  payments.push({ amount, date });
+
+  // Calculate new balance
+  const newBalance = due - amount;
+
+  // Determine new status
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  // Create new invoice
+  const newInvoice = {
+    ...invoice,
+    payments,
+    status: newStatus,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }>, ...rest }} invoice
+ * @returns {number} Balance due in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
