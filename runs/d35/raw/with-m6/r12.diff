+/**
+ * Calculate the due date based on payment terms and issue date.
+ * @param {string} issueDate Date in YYYY-MM-DD format
+ * @param {string} terms Payment terms: 'NET14', 'NET30', or 'EOM'
+ * @returns {string | null} Due date in YYYY-MM-DD format, or null if terms are invalid
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    // Due on the last day of the issue month
+    const [year, month] = issueDate.split('-');
+    const currentMonth = parseInt(month);
+    const currentYear = parseInt(year);
+
+    // Get last day of the month by going to day 1 of next month and subtracting 1 day
+    let nextMonth = currentMonth + 1;
+    let nextYear = currentYear;
+    if (nextMonth > 12) {
+      nextMonth = 1;
+      nextYear = currentYear + 1;
+    }
+
+    const firstOfNextMonth = `${String(nextYear).padStart(4, '0')}-${String(nextMonth).padStart(2, '0')}-01`;
+    return addDays(firstOfNextMonth, -1);
+  }
+  return null;
+}
 
