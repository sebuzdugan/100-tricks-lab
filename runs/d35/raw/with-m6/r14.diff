+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement: returns invoices for customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv1.ok);
+
+  const inv1Issue = issueInvoice(inv1.value, []);
+  assert(inv1Issue.ok);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  });
+  assert(inv2.ok);
+
+  const inv2Issue = issueInvoice(inv2.value, ['INV-2026-0001']);
+  assert(inv2Issue.ok);
+
+  const result = statement('C-001', [inv1Issue.value, inv2Issue.value], '2026-10-20');
+
+  assert(result.ok);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(result.value.invoices[1].number, 'INV-2026-0002');
+});
+
+test('statement: sorts by issueDate', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv1.ok);
+  const inv1Issue = issueInvoice(inv1.value, []);
+  assert(inv1Issue.ok);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv2.ok);
+  const inv2Issue = issueInvoice(inv2.value, ['INV-2026-0001']);
+  assert(inv2Issue.ok);
+
+  const result = statement('C-001', [inv1Issue.value, inv2Issue.value], '2026-10-25');
+
+  assert(result.ok);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-10');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-20');
+});
+
+test('statement: filters by asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv1.ok);
+  const inv1Issue = issueInvoice(inv1.value, []);
+  assert(inv1Issue.ok);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv2.ok);
+  const inv2Issue = issueInvoice(inv2.value, ['INV-2026-0001']);
+  assert(inv2Issue.ok);
+
+  const result = statement('C-001', [inv1Issue.value, inv2Issue.value], '2026-10-10');
+
+  assert(result.ok);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement: includes dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const result = statement('C-001', [invIssue.value], '2026-10-20');
+
+  assert(result.ok);
+  assert.equal(result.value.invoices[0].dueDate, '2026-10-21');
+});
+
+test('statement: calculates total and due', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const result = statement('C-001', [invIssue.value], '2026-10-20');
+
+  assert(result.ok);
+  assert(result.value.invoices[0].total > 0);
+  assert.equal(result.value.invoices[0].due, result.value.invoices[0].total);
+});
+
+test('statement: calculates due after partial payment', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const payment = recordPayment(invIssue.value, { amount: 30000, date: '2026-10-10' });
+  assert(payment.ok);
+
+  const result = statement('C-001', [payment.value], '2026-10-20');
+
+  assert(result.ok);
+  assert.equal(result.value.invoices[0].due, result.value.invoices[0].total - 30000);
+});
+
+test('statement: calculates totalDue', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv1.ok);
+  const inv1Issue = issueInvoice(inv1.value, []);
+  assert(inv1Issue.ok);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  });
+  assert(inv2.ok);
+  const inv2Issue = issueInvoice(inv2.value, ['INV-2026-0001']);
+  assert(inv2Issue.ok);
+
+  const result = statement('C-001', [inv1Issue.value, inv2Issue.value], '2026-10-20');
+
+  assert(result.ok);
+  const sumOfDue = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(result.value.totalDue, sumOfDue);
+});
+
+test('statement: excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const result = statement('C-001', [inv.value], '2026-10-20');
+
+  assert(result.ok);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement: excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const total = invIssue.value.lines.reduce((sum, line) => {
+    const lineAmount = line.qty * line.unitPrice;
+    const lineDiscount = Math.round(lineAmount * (line.discountPercent || 0) / 100);
+    const amountAfterDiscount = lineAmount - lineDiscount;
+    const lineVAT = Math.round(amountAfterDiscount * line.vatRate / 100);
+    return sum + lineAmount - lineDiscount + lineVAT;
+  }, 0);
+
+  const payment = recordPayment(invIssue.value, { amount: total, date: '2026-10-10' });
+  assert(payment.ok);
+  assert.equal(payment.value.status, 'paid');
+
+  const result = statement('C-001', [payment.value], '2026-10-20');
+
+  assert(result.ok);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement: unknown customer returns error', () => {
+  const result = statement('C-999', [], '2026-10-20');
+
+  assert(!result.ok);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement: filters by customer ID', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv1.ok);
+  const inv1Issue = issueInvoice(inv1.value, []);
+  assert(inv1Issue.ok);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv2.ok);
+  const inv2Issue = issueInvoice(inv2.value, ['INV-2026-0001']);
+  assert(inv2Issue.ok);
+
+  const result = statement('C-001', [inv1Issue.value, inv2Issue.value], '2026-10-20');
+
+  assert(result.ok);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement: handles empty statement', () => {
+  const result = statement('C-001', [], '2026-10-20');
+
+  assert(result.ok);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement: normalizes customer ID', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const result = statement('c-001 ', [invIssue.value], '2026-10-20');
+
+  assert(result.ok);
+  assert.equal(result.value.invoices.length, 1);
+});
