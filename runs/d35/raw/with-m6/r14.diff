diff --git a/src/statements.js b/src/statements.js
new file mode 100644
index 0000000..0149bd4
--- /dev/null
+++ b/src/statements.js
@@ -0,0 +1,51 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement showing outstanding invoices.
+ * @param {string} customerId Customer ID
+ * @param {Array} invoices Array of invoice objects
+ * @param {string} asOf Date in YYYY-MM-DD format to filter invoices by
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Verify customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Filter invoices for this customer with status issued or partially_paid and issueDate <= asOf
+  const relevantInvoices = invoices.filter((inv) => {
+    return inv.customerId === customerResult.value.id &&
+           (inv.status === 'issued' || inv.status === 'partially_paid') &&
+           inv.issueDate <= asOf;
+  });
+
+  // Map to statement format
+  const statementInvoices = relevantInvoices
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: inv.lines.reduce((sum, line) => {
+        const lineAmount = line.qty * line.unitPrice;
+        const lineDiscount = Math.round(lineAmount * (line.discountPercent || 0) / 100);
+        const amountAfterDiscount = lineAmount - lineDiscount;
+        const lineVAT = Math.round(amountAfterDiscount * line.vatRate / 100);
+        return sum + lineAmount - lineDiscount + lineVAT;
+      }, 0) - (inv.voucher?.amount || 0),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: customerResult.value.id,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
