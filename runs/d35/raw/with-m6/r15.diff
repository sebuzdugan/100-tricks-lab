+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote: creates a credit note for issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const result = createCreditNote(invIssue.value, { amount: 50000, reason: 'Refund', date: '2026-10-10' }, ['CN-2026-0000']);
+
+  assert(result.ok);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Refund');
+  assert.equal(result.value.date, '2026-10-10');
+});
+
+test('createCreditNote: rejects draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const result = createCreditNote(inv.value, { amount: 50000, reason: 'Refund', date: '2026-10-10' }, []);
+
+  assert(!result.ok);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote: accepts partially_paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const payment = recordPayment(invIssue.value, { amount: 30000, date: '2026-10-10' });
+  assert(payment.ok);
+  assert.equal(payment.value.status, 'partially_paid');
+
+  const result = createCreditNote(payment.value, { amount: 50000, reason: 'Refund', date: '2026-10-11' }, []);
+
+  assert(result.ok);
+});
+
+test('createCreditNote: accepts paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const total = invIssue.value.lines.reduce((sum, line) => {
+    const lineAmount = line.qty * line.unitPrice;
+    const lineDiscount = Math.round(lineAmount * (line.discountPercent || 0) / 100);
+    const amountAfterDiscount = lineAmount - lineDiscount;
+    const lineVAT = Math.round(amountAfterDiscount * line.vatRate / 100);
+    return sum + lineAmount - lineDiscount + lineVAT;
+  }, 0);
+
+  const payment = recordPayment(invIssue.value, { amount: total, date: '2026-10-10' });
+  assert(payment.ok);
+  assert.equal(payment.value.status, 'paid');
+
+  const result = createCreditNote(payment.value, { amount: 50000, reason: 'Refund', date: '2026-10-11' }, []);
+
+  assert(result.ok);
+});
+
+test('createCreditNote: validates amount is positive integer', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const result = createCreditNote(invIssue.value, { amount: -50000, reason: 'Refund', date: '2026-10-10' }, []);
+
+  assert(!result.ok);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: rejects zero amount', () => {
