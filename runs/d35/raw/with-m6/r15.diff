 }
+
+/**
+ * Generate the next credit note number for a given year.
+ * Format: CN-<year>-<4-digit counter>
+ * @param {string[]} existingNumbers Array of existing numbers (both INV and CN) in any order
+ * @param {string} date Credit note date in YYYY-MM-DD format
+ * @returns {string} The next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.slice(0, 4);
+  const prefix = `CN-${year}-`;
+
+  // Find the highest counter for this year
+  let maxCounter = 0;
+
+  for (const number of existingNumbers) {
+    if (number.startsWith(prefix)) {
+      const counterStr = number.slice(prefix.length);
+      const counter = parseInt(counterStr, 10);
+      if (!isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
