+
+test('overdueInvoices: handles multiple invoices across statuses', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-08-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv1.ok);
+  const inv1Issue = issueInvoice(inv1.value, []);
+  assert(inv1Issue.ok);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv2.ok);
+  const inv2Issue = issueInvoice(inv2.value, ['INV-2026-0001']);
+  assert(inv2Issue.ok);
+
+  const payment = recordPayment(inv2Issue.value, { amount: 30000, date: '2026-09-10' });
+  assert(payment.ok);
+
+  const result = overdueInvoices([inv1Issue.value, payment.value], '2026-10-20');
