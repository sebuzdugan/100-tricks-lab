+test('overdueInvoices: sorts by daysOverdue descending', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-08-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv1.ok);
+  const inv1Issue = issueInvoice(inv1.value, []);
+  assert(inv1Issue.ok);
+  assert.equal(inv1Issue.value.dueDate, '2026-08-15');
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv2.ok);
+  const inv2Issue = issueInvoice(inv2.value, ['INV-2026-0001']);
+  assert(inv2Issue.ok);
+  assert.equal(inv2Issue.value.dueDate, '2026-09-15');
+
+  const result = overdueInvoices([inv2Issue.value, inv1Issue.value], '2026-10-20');
+
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].daysOverdue, 66);
+  assert.equal(result[1].number, 'INV-2026-0002');
+  assert.equal(result[1].daysOverdue, 35);
+});
+
+test('overdueInvoices: calculates due correctly for partially paid', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const payment = recordPayment(invIssue.value, { amount: 30000, date: '2026-09-10' });
+  assert(payment.ok);
+
+  const total = invIssue.value.lines.reduce((sum, line) => {
+    const lineAmount = line.qty * line.unitPrice;
+    const lineDiscount = Math.round(lineAmount * (line.discountPercent || 0) / 100);
+    const amountAfterDiscount = lineAmount - lineDiscount;
+    const lineVAT = Math.round(amountAfterDiscount * line.vatRate / 100);
+    return sum + lineAmount - lineDiscount + lineVAT;
+  }, 0);
+
