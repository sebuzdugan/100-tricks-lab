+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices: returns empty array for no invoices', () => {
+  const result = overdueInvoices([], '2026-10-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv.ok);
+
+  const result = overdueInvoices([inv.value], '2026-10-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const total = invIssue.value.lines.reduce((sum, line) => {
+    const lineAmount = line.qty * line.unitPrice;
+    const lineDiscount = Math.round(lineAmount * (line.discountPercent || 0) / 100);
+    const amountAfterDiscount = lineAmount - lineDiscount;
+    const lineVAT = Math.round(amountAfterDiscount * line.vatRate / 100);
+    return sum + lineAmount - lineDiscount + lineVAT;
+  }, 0);
+
+  const payment = recordPayment(invIssue.value, { amount: total, date: '2026-09-10' });
+  assert(payment.ok);
+  assert.equal(payment.value.status, 'paid');
+
+  const result = overdueInvoices([payment.value], '2026-10-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: includes issued invoice past due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+  assert.equal(invIssue.value.dueDate, '2026-09-15');
+
+  const result = overdueInvoices([invIssue.value], '2026-10-20');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-09-15');
+  assert.equal(result[0].daysOverdue, 35);
+});
+
+test('overdueInvoices: includes partially_paid invoice past due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const payment = recordPayment(invIssue.value, { amount: 30000, date: '2026-09-10' });
+  assert(payment.ok);
+  assert.equal(payment.value.status, 'partially_paid');
+
+  const result = overdueInvoices([payment.value], '2026-10-20');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].status, undefined);
+});
+
