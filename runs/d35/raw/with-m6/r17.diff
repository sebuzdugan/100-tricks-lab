+test('vatSummary: returns empty array for no invoices', () => {
+  const result = vatSummary([]);
+  assert.deepEqual(result, []);
+});
+
+test('vatSummary: excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const result = vatSummary([inv.value]);
+  assert.deepEqual(result, []);
+});
+
+test('vatSummary: includes issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const result = vatSummary([invIssue.value]);
