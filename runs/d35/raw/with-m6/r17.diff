+++ b/src/reports.js
@@ -24,3 +24,42 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Generate a VAT summary report.
+ * @param {Array} invoices Array of invoice objects
+ * @returns {Array<{ rate: number, base: number, vat: number }>} VAT summary by rate, sorted high to low
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  for (const inv of invoices) {
+    if (inv.status !== 'issued' && inv.status !== 'partially_paid' && inv.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of inv.lines) {
+      const lineAmount = line.qty * line.unitPrice;
+      const lineDiscount = Math.round(lineAmount * (line.discountPercent || 0) / 100);
+      const lineBase = lineAmount - lineDiscount;
+      const lineVAT = Math.round(lineBase * line.vatRate / 100);
+
+      const rate = line.vatRate;
+      if (!vatMap[rate]) {
+        vatMap[rate] = { base: 0, vat: 0 };
+      }
+      vatMap[rate].base += lineBase;
+      vatMap[rate].vat += lineVAT;
+    }
+  }
+
+  const summary = Object.entries(vatMap)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseFloat(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return summary;
+}
