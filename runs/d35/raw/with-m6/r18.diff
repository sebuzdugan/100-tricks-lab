+/**
+ * Calculate late fee on an invoice.
+ * @param {{ dueDate: string, status: string, payments?: Array<{ amount: number }>, lines: Array, voucher?: any }} invoice
+ * @param {string} asOf Date in YYYY-MM-DD format to check against
+ * @returns {number} Late fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  const daysOverdue = Math.max(0, daysBetween(invoice.dueDate, asOf));
+
+  if (daysOverdue === 0) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  const fee = Math.round(due * 0.0004 * daysOverdue);
+  return fee;
+}
