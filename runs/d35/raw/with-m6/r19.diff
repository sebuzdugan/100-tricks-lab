+test('exportCsv: fully paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const total = invIssue.value.lines.reduce((sum, line) => {
+    const lineAmount = line.qty * line.unitPrice;
+    const lineDiscount = Math.round(lineAmount * (line.discountPercent || 0) / 100);
+    const amountAfterDiscount = lineAmount - lineDiscount;
+    const lineVAT = Math.round(amountAfterDiscount * line.vatRate / 100);
+    return sum + lineAmount - lineDiscount + lineVAT;
+  }, 0);
+
+  const payment = recordPayment(invIssue.value, { amount: total, date: '2026-10-10' });
+  assert(payment.ok);
+
+  const result = exportCsv([payment.value]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  const due = parseFloat(fields[9]);
+  assert.equal(due, 0.00);
+});
