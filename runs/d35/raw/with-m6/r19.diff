+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv: empty invoices array', () => {
+  const result = exportCsv([]);
+
+  assert(result.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+  const lines = result.split('\n');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv: single issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const result = exportCsv([invIssue.value]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[1].includes('2026-10-07'));
+  assert(lines[1].includes('issued'));
+});
+
