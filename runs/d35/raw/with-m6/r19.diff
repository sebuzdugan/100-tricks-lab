+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros string with 2 decimals and a dot.
+ * @param {number} cents Amount in cents
+ * @returns {string} Formatted as "1234.50"
+ */
+function formatEuros(cents) {
+  const euros = (cents / 100).toFixed(2);
+  return euros;
+}
+
+/**
+ * Escape a field for CSV output.
+ * If the field contains a comma or double quote, wrap in double quotes and escape double quotes.
+ * @param {string} field Field value
+ * @returns {string} CSV-escaped field
+ */
+function escapeCsvField(field) {
+  if (field.includes(',') || field.includes('"')) {
+    return '"' + field.replace(/"/g, '""') + '"';
+  }
+  return field;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices Array of invoice objects
+ * @returns {string} CSV format with header and data lines
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header line
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data lines
+  for (const inv of invoices) {
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const fields = [
+      inv.number || '',
+      escapeCsvField(customerName),
+      inv.issueDate,
+      inv.dueDate || '',
+      inv.status,
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    lines.push(fields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
