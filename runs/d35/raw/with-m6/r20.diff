diff --git a/src/money.js b/src/money.js
index fadf486..64345f6 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,43 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert cents (in euros) to another currency.
+ * @param {number} cents Amount in euro cents
+ * @param {string} currency Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const converted = roundCents(cents * rate);
+  return ok(converted);
+}
+
+/**
+ * Format cents in a specific currency for people.
+ * @param {number} cents Amount in that currency's cents
+ * @param {string} currency Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const major = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const minor = String(abs % 100).padStart(2, '0');
+
+  let symbol = '';
+  if (currency === 'USD') {
+    symbol = '$';
+  } else if (currency === 'GBP') {
+    symbol = '£';
+  } else if (currency === 'EUR') {
+    symbol = '€';
+  }
+
+  return `${sign}${symbol}${major}.${minor}`;
+}
