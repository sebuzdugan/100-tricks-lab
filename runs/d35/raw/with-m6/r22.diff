diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..c1e34d8
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,51 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single invoice line.
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount amount for a single invoice line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
+ * @returns {number} Discount amount in cents
+ */
+export function lineDiscount(line) {
+  if (!line.discountPercent) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const discount = roundCents(total * line.discountPercent / 100);
+  return Math.max(0, discount);
+}
+
+/**
+ * Calculate the VAT amount for a single invoice line (VAT is on the amount after discount).
+ * @param {{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }}
+ * @returns {number} VAT amount in cents
+ */
+export function lineVAT(line) {
+  const lineAmountTotal = lineTotal(line);
+  const discountAmount = lineDiscount(line);
+  const lineAmountAfterDiscount = Math.max(0, lineAmountTotal - discountAmount);
+  const vat = roundCents(lineAmountAfterDiscount * line.vatRate / 100);
+  return Math.max(0, vat);
+}
+
+/**
+ * Calculate subtotal, discount, VAT and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }>, voucher?: { amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} Amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = roundCents(invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
+  const discount = roundCents(invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0));
+  const vat = roundCents(invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0));
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, roundCents(subtotal - discount + vat - voucher));
+  return { subtotal, discount, vat, voucher, total };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
