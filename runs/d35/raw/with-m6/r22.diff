@@ -0,0 +1,236 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal: calculates qty times unitPrice', () => {
+  const line = { qty: 5, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 47500);
+});
+
+test('lineTotal: handles large quantities', () => {
+  const line = { qty: 1000, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 9500000);
+});
+
+test('lineTotal: returns integer cents', () => {
+  const line = { qty: 3, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 28500);
+  assert(Number.isInteger(lineTotal(line)));
+});
+
+test('lineDiscount: calculates discount correctly', () => {
+  const line = { qty: 5, unitPrice: 9500, discountPercent: 10 };
+  const total = 47500;
+  const expectedDiscount = Math.round(total * 0.1);
+  assert.equal(lineDiscount(line), expectedDiscount);
+});
+
+test('lineDiscount: with no discount', () => {
+  const line = { qty: 5, unitPrice: 9500 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount: with 0 percent discount', () => {
+  const line = { qty: 5, unitPrice: 9500, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount: with 100 percent discount', () => {
+  const line = { qty: 5, unitPrice: 9500, discountPercent: 100 };
+  assert.equal(lineDiscount(line), 47500);
+});
+
+test('lineDiscount: with decimal percentage', () => {
+  const line = { qty: 5, unitPrice: 9500, discountPercent: 12.5 };
+  const total = 47500;
+  const expectedDiscount = Math.round(total * 0.125);
+  assert.equal(lineDiscount(line), expectedDiscount);
+});
+
+test('lineVAT: calculates VAT on line total', () => {
+  const line = { qty: 5, unitPrice: 9500, vatRate: 21 };
+  const total = 47500;
+  const expectedVAT = Math.round(total * 0.21);
+  assert.equal(lineVAT(line), expectedVAT);
+});
+
+test('lineVAT: with 9% VAT rate', () => {
+  const line = { qty: 100, unitPrice: 37, vatRate: 9 };
+  const total = 3700;
+  const expectedVAT = Math.round(total * 0.09);
+  assert.equal(lineVAT(line), expectedVAT);
+});
+
+test('lineVAT: with 0% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 60000, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT: VAT is calculated on amount after discount', () => {
+  const line = { qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 10 };
+  const total = 47500;
+  const discount = Math.round(total * 0.1);
+  const amountAfterDiscount = total - discount;
+  const expectedVAT = Math.round(amountAfterDiscount * 0.21);
+  assert.equal(lineVAT(line), expectedVAT);
+});
+
+test('lineVAT: with 100% discount, VAT is zero', () => {
+  const line = { qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 100 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('invoiceTotals: single line invoice', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.subtotal > 0);
+  assert.equal(result.discount, 0);
+  assert(result.vat > 0);
+  assert.equal(result.voucher, 0);
+  assert(result.total > 0);
+});
+
+test('invoiceTotals: multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500, vatRate: 21 },
+      { qty: 3, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 5 * 9500 + 3 * 8500);
+});
+
+test('invoiceTotals: empty invoice', () => {
+  const invoice = { lines: [] };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 0);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals: returns integers', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert(Number.isInteger(result.subtotal));
+  assert(Number.isInteger(result.discount));
+  assert(Number.isInteger(result.vat));
+  assert(Number.isInteger(result.voucher));
+  assert(Number.isInteger(result.total));
+});
+
+test('invoiceTotals: without discounts', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 0);
+});
+
+test('invoiceTotals: with single line discount', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 10 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.discount > 0);
+});
+
+test('invoiceTotals: with multiple lines with different discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 10 },
+      { qty: 3, unitPrice: 8500, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.discount > 0);
+});
+
+test('invoiceTotals: with 100% discount on one line', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 100 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals: total never goes below zero', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 95, vatRate: 21, discountPercent: 100 }],
+    voucher: { amount: 1000000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.total >= 0);
+});
+
+test('invoiceTotals: includes voucher in calculation', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21 }],
+    voucher: { amount: 10000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 10000);
+  assert(result.total < 47500 + Math.round(47500 * 0.21));
+});
+
+test('invoiceTotals: voucher zero for invoice without voucher', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 0);
+});
+
+test('invoiceTotals: total never goes below zero with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 95, vatRate: 21 }],
+    voucher: { amount: 100000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.total >= 0);
+});
+
+test('invoiceTotals: multiple lines with different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500, vatRate: 21 },
+      { qty: 100, unitPrice: 37, vatRate: 9 },
+      { qty: 1, unitPrice: 60000, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.vat > 0);
+  assert(result.total > 0);
+});
+
+test('invoiceTotals: with tier discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  const lineAmount = 5 * 9500;
+  const discount = Math.round(lineAmount * 0.05);
+  const afterDiscount = lineAmount - discount;
+  const vat = Math.round(afterDiscount * 0.21);
+  assert.equal(result.subtotal, lineAmount);
+  assert.equal(result.discount, discount);
+  assert.equal(result.vat, vat);
+});
+
+test('invoiceTotals: VAT never goes below zero', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, vatRate: 21, discountPercent: 100 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.vat >= 0);
+});
