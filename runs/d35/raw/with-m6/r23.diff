--- a/src/totals.js
+++ b/src/totals.js
@@ -11,16 +11,27 @@ export function lineTotal(line) {
 
 /**
  * Calculate the discount amount for a single invoice line.
+ * Includes primary discount (line's own or tier) and bulk discount (2.5% if qty >= 10).
+ * Bulk discount is applied after primary discount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
  * @returns {number} Discount amount in cents
  */
 export function lineDiscount(line) {
-  if (!line.discountPercent) {
-    return 0;
-  }
   const total = lineTotal(line);
-  const discount = roundCents(total * line.discountPercent / 100);
-  return Math.max(0, discount);
+
+  // Primary discount (line's own or tier discount)
+  const primaryDiscountPercent = line.discountPercent ?? 0;
+  const primaryDiscount = roundCents(total * primaryDiscountPercent / 100);
+
+  // Bulk discount (2.5% if qty >= 10, applied to amount after primary discount)
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const amountAfterPrimaryDiscount = Math.max(0, total - primaryDiscount);
+    bulkDiscount = roundCents(amountAfterPrimaryDiscount * 2.5 / 100);
+  }
+
+  const totalDiscount = primaryDiscount + bulkDiscount;
+  return Math.max(0, totalDiscount);
 }
 
