+test('dashboard: outstanding excludes draft and paid', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(draft.ok);
+
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert(inv.ok);
+
+  const invIssue = issueInvoice(inv.value, []);
+  assert(invIssue.ok);
+
+  const total = invIssue.value.lines.reduce((sum, line) => {
+    const lineAmount = line.qty * line.unitPrice;
+    const lineDiscount = Math.round(lineAmount * (line.discountPercent || 0) / 100);
+    const amountAfterDiscount = lineAmount - lineDiscount;
+    let bulkDiscount = 0;
+    if (line.qty >= 10) {
+      bulkDiscount = Math.round(amountAfterDiscount * 0.025);
+    }
+    const amountAfterBulk = amountAfterDiscount - bulkDiscount;
+    const lineVAT = Math.round(amountAfterBulk * line.vatRate / 100);
+    return sum + lineAmount - lineDiscount - bulkDiscount + lineVAT;
+  }, 0);
+
+  const payment = recordPayment(invIssue.value, { amount: total, date: '2026-10-10' });
+  assert(payment.ok);
+
+  const result = dashboard([draft.value, payment.value], '2026-10-20');
+
+  assert.equal(result.outstanding, 0);
+});
