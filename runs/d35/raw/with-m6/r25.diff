+test('renderInvoiceText: fully paid invoice shows paid amount and correct status', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert(result.ok);
+  const issueResult = issueInvoice(result.value, []);
+  assert(issueResult.ok);
+
+  const total = issueResult.value.lines.reduce((sum, line) => {
+    const lineAmount = line.qty * line.unitPrice;
+    const lineDiscount = Math.round(lineAmount * (line.discountPercent || 0) / 100);
+    const amountAfterDiscount = lineAmount - lineDiscount;
+    let bulkDiscount = 0;
+    if (line.qty >= 10) {
+      bulkDiscount = Math.round(amountAfterDiscount * 0.025);
+    }
+    const amountAfterBulk = amountAfterDiscount - bulkDiscount;
+    const lineVAT = Math.round(amountAfterBulk * line.vatRate / 100);
+    return sum + lineAmount - lineDiscount - bulkDiscount + lineVAT;
+  }, 0);
+
+  const paymentResult = recordPayment(issueResult.value, { amount: total, date: '2026-10-10' });
+  assert(paymentResult.ok);
+  assert.equal(paymentResult.value.status, 'paid');
+
+  const text = renderInvoiceText(paymentResult.value);
+
+  // C-001 is gold (5% discount): 475 - 23.75 = 451.25, VAT 94.76, Total: 546.01
+  assert(text.includes('Paid: €546.01'));
+  assert(text.includes('Total: €546.01'));
+});
+
+test('renderInvoiceText: combined - line discount + voucher + due + paid', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }],
+    terms: 'NET14',
+  });
+
+  assert(result.ok);
+  const voucherResult = applyVoucher(result.value, { code: 'PROMO', amount: 2000 });
+  assert(voucherResult.ok);
+
+  const issueResult = issueInvoice(voucherResult.value, []);
+  assert(issueResult.ok);
+
+  const paymentResult = recordPayment(issueResult.value, { amount: 30000, date: '2026-10-10' });
+  assert(paymentResult.ok);
+
+  const text = renderInvoiceText(paymentResult.value);
+
+  // Should include all new features
+  assert(text.includes('Discount: -€47.50')); // per-line discount
+  assert(text.includes('Voucher: -€20.00')); // voucher
+  assert(text.includes('Due: 2026-10-21')); // due date
+  assert(text.includes('Paid: €300.00')); // paid amount
+
+  // Verify order: line discount before total, voucher before total, total before due, due before paid
+  const lines = text.split('\n');
+  const lineDiscountIdx = lines.findIndex((l) => l.includes('Discount: -€47.50'));
+  const voucherIdx = lines.findIndex((l) => l.includes('Voucher:'));
+  const totalIdx = lines.findIndex((l) => l.startsWith('Total:'));
+  const dueIdx = lines.findIndex((l) => l.startsWith('Due:'));
+  const paidIdx = lines.findIndex((l) => l.startsWith('Paid:'));
+
+  assert(lineDiscountIdx < totalIdx);
+  assert(voucherIdx < totalIdx);
+  assert(totalIdx < dueIdx);
+  assert(dueIdx < paidIdx);
+});
