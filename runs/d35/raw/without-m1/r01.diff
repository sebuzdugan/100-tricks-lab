+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with valid customer, date, and lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value, {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 2,
+        unitPrice: 8500,
+        vatRate: 21,
+      },
+    ],
+  });
+});
+
+test('createInvoice handles multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'ICON-SET', qty: 1 },
+      { sku: 'HOST-MONTH', qty: 12 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 3,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+  assert.deepEqual(result.value.lines[1], {
+    sku: 'ICON-SET',
+    name: 'Icon set (24 icons)',
+    qty: 1,
+    unitPrice: 980,
+    vatRate: 21,
+  });
+  assert.deepEqual(result.value.lines[2], {
+    sku: 'HOST-MONTH',
+    name: 'Website hosting (month)',
+    qty: 12,
+    unitPrice: 1500,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice returns DATE_INVALID for malformed date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '10/07/2026',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns DATE_INVALID for invalid date value', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns DATE_INVALID for missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createInvoice returns NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice returns NO_LINES for missing lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: undefined,
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice returns QTY_INVALID for zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice returns QTY_INVALID for negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice returns QTY_INVALID for fractional quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('createInvoice returns UNKNOWN_SKU for invalid SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice fails on first invalid line when multiple exist', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'UNKNOWN', qty: 1 },
+      { sku: 'HOST-MONTH', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice includes products with different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+  const originalLines = JSON.stringify(lines);
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+
+  assert.equal(JSON.stringify(lines), originalLines);
+});
