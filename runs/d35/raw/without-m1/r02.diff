+
+test('lineTotal multiplies qty by unitPrice', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 50 };
+  assert.equal(lineTotal(line), 50000);
+});
+
+test('invoiceTotals returns subtotal and total for single line', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 2, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(totals, {
+    subtotal: 17000,
+    total: 17000,
+  });
+});
+
+test('invoiceTotals sums multiple lines', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21 },
+      { sku: 'ICON-SET', qty: 2, unitPrice: 980, name: 'Icon set (24 icons)', vatRate: 21 },
+      { sku: 'HOST-MONTH', qty: 1, unitPrice: 1500, name: 'Website hosting (month)', vatRate: 21 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 3 * 8500 + 2 * 980 + 1500);
+  assert.equal(totals.total, totals.subtotal);
+});
+
