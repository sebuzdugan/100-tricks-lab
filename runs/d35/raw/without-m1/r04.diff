@@ -0,0 +1,66 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2026-0001'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber finds max counter with multiple numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0099', 'INV-2026-0001', 'INV-2027-0001'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003', 'INV-2026-0004', 'INV-2026-0005', 'INV-2026-0006', 'INV-2026-0007', 'INV-2026-0008', 'INV-2026-0009'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0010');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2026-9999'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2026-ABC', 'INV-2026-0001', 'INVALID', 'INV-2026'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber with different years in same call', () => {
+  const existing = ['INV-2025-0005', 'INV-2026-0003', 'INV-2027-0001'];
+  const result2025 = nextInvoiceNumber(existing, '2025-06-15');
+  const result2026 = nextInvoiceNumber(existing, '2026-06-15');
+  const result2027 = nextInvoiceNumber(existing, '2027-06-15');
+
+  assert.equal(result2025, 'INV-2025-0006');
+  assert.equal(result2026, 'INV-2026-0004');
+  assert.equal(result2027, 'INV-2027-0002');
+});
+
+test('nextInvoiceNumber extracts year correctly from issueDate', () => {
+  const existing = [];
+  const result1 = nextInvoiceNumber(existing, '2025-01-01');
+  const result2 = nextInvoiceNumber(existing, '2026-12-31');
+  const result3 = nextInvoiceNumber(existing, '2099-06-15');
+
+  assert.equal(result1, 'INV-2025-0001');
+  assert.equal(result2, 'INV-2026-0001');
+  assert.equal(result3, 'INV-2099-0001');
+});
