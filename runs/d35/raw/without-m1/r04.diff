new file mode 100644
index 0000000..ab3a338
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,14 @@
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const yearPrefix = `INV-${year}-`;
+
+  const yearNumbers = existingNumbers
+    .filter((num) => num.startsWith(yearPrefix))
+    .map((num) => parseInt(num.slice(yearPrefix.length), 10))
+    .filter((num) => !isNaN(num));
+
+  const maxCounter = yearNumbers.length > 0 ? Math.max(...yearNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${yearPrefix}${String(nextCounter).padStart(4, '0')}`;
+}
