index 0000000..d57b26b
--- /dev/null
+++ b/src/render.js
@@ -0,0 +1,24 @@
+import { formatEuros } from './money.js';
+import { invoiceTotals, lineTotal } from './invoices.js';
+
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  lines.push(invoice.number || 'DRAFT');
+
+  const customer = invoice.customerId;
+  lines.push(customer);
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const unitPriceFormatted = formatEuros(line.unitPrice);
+    const totalFormatted = formatEuros(total);
+    lines.push(`${line.qty} x ${line.name} @ ${unitPriceFormatted} = ${totalFormatted}`);
+  }
+
+  const { total } = invoiceTotals(invoice);
+  const totalFormatted = formatEuros(total);
+  lines.push(`Total: ${totalFormatted}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..ddbf31b
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,172 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const text = renderInvoiceText(issued);
+
+  assert(text.includes('INV-2026-0001'));
+  assert(!text.includes('DRAFT'));
+});
+
+test('renderInvoiceText includes customer ID', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('C-002'));
+});
+
+test('renderInvoiceText formats single line correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('2 x Design work (hour) @ €85.00 = €170.00'));
+});
+
+test('renderInvoiceText formats multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'HOST-MONTH', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('3 x Design work (hour) @ €85.00 = €255.00'));
+  assert(text.includes('2 x Icon set (24 icons) @ €9.80 = €19.60'));
+  assert(text.includes('1 x Website hosting (month) @ €15.00 = €15.00'));
+});
+
+test('renderInvoiceText calculates correct total for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'ICON-SET', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const expectedTotal = 2 * 8500 + 1 * 980;
+
+  assert(text.includes(`Total: €${(expectedTotal / 100).toFixed(2)}`));
+});
+
+test('renderInvoiceText shows correct line order', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 1 },
+      { sku: 'DES-HOUR', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'C-003');
+  assert(lines[2].includes('Icon set (24 icons)'));
+  assert(lines[3].includes('Design work (hour)'));
+  assert(lines[4].startsWith('Total:'));
+});
+
+test('renderInvoiceText with small quantities and prices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('100 x Sticker sheet @ €0.50 = €50.00'));
+  assert(text.includes('Total: €50.00'));
+});
+
+test('renderInvoiceText with high-value items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 2 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('2 x Brand guidelines document @ €2,450.00 = €4,900.00'));
+  assert(text.includes('1 x Logo package @ €1,200.00 = €1,200.00'));
+  assert(text.includes('Total: €6,100.00'));
+});
+
+test('renderInvoiceText returns a string with newlines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'ICON-SET', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert(typeof text === 'string');
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5);
+});
+
+test('renderInvoiceText issued invoice structure', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(draft, ['INV-2026-0001']).value;
+  const text = renderInvoiceText(issued);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0002');
+  assert.equal(lines[1], 'C-001');
+  assert(lines[2].includes('Design work (hour)'));
+  assert.equal(lines[3], 'Total: €85.00');
+});
