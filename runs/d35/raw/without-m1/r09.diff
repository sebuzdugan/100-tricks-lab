+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('  C-001  '), 'C-001');
+  assert.equal(normalizeId('\t C-001 \n'), 'C-001');
+  assert.equal(normalizeId('C-001'), 'C-001');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('C-001'), 'C-001');
+  assert.equal(normalizeId('c-007'), 'C-007');
+});
+
+test('normalizeId handles mixed case with spaces', () => {
+  assert.equal(normalizeId('  c-001  '), 'C-001');
+  assert.equal(normalizeId(' C-007 '), 'C-007');
+  assert.equal(normalizeId('\tc-001\t'), 'C-001');
+});
+
+test('getCustomer finds customer with lowercase ID', () => {
+  const result = getCustomer('c-001');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.id, 'C-001');
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer finds customer with spaces', () => {
+  const result = getCustomer('  c-003  ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.id, 'C-003');
+  assert.equal(result.value.name, 'Kite & Co');
+});
+
+test('getCustomer returns CUSTOMER_NOT_FOUND for invalid normalized ID', () => {
+  const result = getCustomer('  c-999  ');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
