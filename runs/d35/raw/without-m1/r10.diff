+export function isValidDate(text) {
+  const regex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!regex.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  return date instanceof Date && !isNaN(date) && date.toISOString().startsWith(text);
+}
+
+export function addDays(dateString, n) {
+  const date = new Date(dateString + 'T00:00:00Z');
+  date.setUTCDate(date.getUTCDate() + n);
+  return date.toISOString().split('T')[0];
+}
+
+export function daysBetween(aString, bString) {
+  const a = new Date(aString + 'T00:00:00Z');
+  const b = new Date(bString + 'T00:00:00Z');
+  const diffMs = b - a;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
