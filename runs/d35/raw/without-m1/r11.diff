new file mode 100644
index 0000000..0d048bf
--- /dev/null
+++ b/src/payments.js
@@ -0,0 +1,44 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+function isPositiveInteger(value) {
+  return Number.isInteger(value) && value > 0;
+}
+
+export function balanceDue(invoice) {
+  const { total } = invoiceTotals(invoice);
+  const paidAmount = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, total - paidAmount);
+}
+
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!isPositiveInteger(amount)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const balance = balanceDue(invoice);
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  const newPayments = [...(invoice.payments || [])];
+  newPayments.push({ amount, date });
+
+  const newBalance = balance - amount;
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
index 0000000..fcb63a7
--- /dev/null
+++ b/test/payments.test.js
@@ -0,0 +1,178 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+function createIssuedInvoice() {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  return issueInvoice(draft, []).value;
+}
+
+test('balanceDue returns total for issued invoice with no payments', () => {
+  const invoice = createIssuedInvoice();
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 20570);
+});
+
+test('balanceDue returns zero after full payment', () => {
+  const invoice = createIssuedInvoice();
+  const total = 20570;
+  const paidInvoice = recordPayment(invoice, { amount: total, date: '2026-10-08' }).value;
+  const balance = balanceDue(paidInvoice);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue returns remaining balance after partial payment', () => {
+  const invoice = createIssuedInvoice();
+  const paidInvoice = recordPayment(invoice, { amount: 10000, date: '2026-10-08' }).value;
+  const balance = balanceDue(paidInvoice);
+  assert.equal(balance, 10570);
+});
+
+test('recordPayment returns NOT_ISSUED for draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = recordPayment(draft, { amount: 1000, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment returns AMOUNT_INVALID for zero amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: 0, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment returns AMOUNT_INVALID for negative amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: -1000, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment returns AMOUNT_INVALID for decimal amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: 100.50, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment returns DATE_INVALID for invalid date', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: 1000, date: '10/08/2026' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('recordPayment returns OVERPAYMENT for amount exceeding balance', () => {
+  const invoice = createIssuedInvoice();
+  const balance = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: balance + 1, date: '2026-10-08' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment records payment successfully', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.payments, [{ amount: 5000, date: '2026-10-08' }]);
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = createIssuedInvoice();
+  assert(!('payments' in invoice));
+  const result = recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+  assert.equal(result.ok, true);
+  assert(Array.isArray(result.value.payments));
+});
+
+test('recordPayment sets status to partially_paid after payment', () => {
+  const invoice = createIssuedInvoice();
+  const balance = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: balance - 1000, date: '2026-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const invoice = createIssuedInvoice();
+  const balance = balanceDue(invoice);
+  const result = recordPayment(invoice, { amount: balance, date: '2026-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment allows payment on partially_paid invoice', () => {
+  const invoice = createIssuedInvoice();
+  const balance = balanceDue(invoice);
+  const partial = recordPayment(invoice, { amount: balance - 5000, date: '2026-10-08' }).value;
+  assert.equal(partial.status, 'partially_paid');
+
+  const result = recordPayment(partial, { amount: 5000, date: '2026-10-09' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment accumulates multiple payments', () => {
+  const invoice = createIssuedInvoice();
+  let current = invoice;
+
+  const dates = ['2026-10-08', '2026-10-09', '2026-10-10'];
+  for (let i = 0; i < 3; i++) {
+    const result = recordPayment(current, { amount: 5000, date: dates[i] });
+    assert.equal(result.ok, true);
+    current = result.value;
+  }
+
+  assert.equal(current.payments.length, 3);
+  assert.deepEqual(current.payments, [
+    { amount: 5000, date: '2026-10-08' },
+    { amount: 5000, date: '2026-10-09' },
+    { amount: 5000, date: '2026-10-10' },
+  ]);
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = createIssuedInvoice();
+  const originalStatus = invoice.status;
+  const originalHasPayments = 'payments' in invoice;
+
+  recordPayment(invoice, { amount: 5000, date: '2026-10-08' });
+
+  assert.equal(invoice.status, originalStatus);
+  assert.equal('payments' in invoice, originalHasPayments);
+});
+
+test('balanceDue accounts for multiple payments', () => {
+  const invoice = createIssuedInvoice();
+  const total = balanceDue(invoice);
+
+  let current = invoice;
+  current = recordPayment(current, { amount: 5000, date: '2026-10-08' }).value;
+  current = recordPayment(current, { amount: 5000, date: '2026-10-09' }).value;
+
+  const remaining = balanceDue(current);
+  assert.equal(remaining, total - 10000);
+});
+
+test('recordPayment respects exact balance on final payment', () => {
+  const invoice = createIssuedInvoice();
+  const balance = balanceDue(invoice);
+
+  const partial = recordPayment(invoice, { amount: balance - 1000, date: '2026-10-08' }).value;
+  const finalBalance = balanceDue(partial);
+
+  const result = recordPayment(partial, { amount: finalBalance, date: '2026-10-09' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
