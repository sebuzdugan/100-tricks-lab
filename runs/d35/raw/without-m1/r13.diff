+export function applyVoucher(invoice, { code, amount }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  if (!isPositiveInteger(amount)) return fail('AMOUNT_INVALID');
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
+
 function isPositiveInteger(value) {
   return Number.isInteger(value) && value > 0;
 }
