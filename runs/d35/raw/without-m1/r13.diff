+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 2, unitPrice: 8500, name: 'Design work (hour)', vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 1000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  const subtotal = 17000;
+  const vat = 17000 * 21 / 100;
+  const expected = subtotal + vat - 1000;
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.voucher, 1000);
+  assert.equal(totals.total, expected);
+});
+
