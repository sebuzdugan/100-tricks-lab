index 0000000..3e61089
--- /dev/null
+++ b/src/statements.js
@@ -0,0 +1,35 @@
+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+export function statement(customerId, invoices, asOf) {
+  const normalizedCustomerId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  const relevantInvoices = invoices
+    .filter((inv) => inv && inv.customerId === normalizedCustomerId)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate))
+    .map((inv) => {
+      const { total } = invoiceTotals(inv);
+      const due = balanceDue(inv);
+      return {
+        number: inv.number,
+        issueDate: inv.issueDate,
+        dueDate: inv.dueDate,
+        total,
+        due,
+      };
+    });
+
+  const totalDue = relevantInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: relevantInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
index 0000000..06673e8
--- /dev/null
+++ b/test/statements.test.js
@@ -0,0 +1,195 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoices() {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const inv1Issued = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const inv2Issued = issueInvoice(inv2, [inv1Issued.number]).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  }).value;
+  const inv3Issued = issueInvoice(inv3, [inv1Issued.number, inv2Issued.number]).value;
+
+  return [inv1Issued, inv2Issued, inv3Issued];
+}
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoices = createTestInvoices();
+  const result = statement('C-999', invoices, '2026-10-31');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement returns empty invoices for customer with no issued invoices', () => {
+  const invoices = createTestInvoices();
+  const result = statement('C-003', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement filters by customer', () => {
+  const invoices = createTestInvoices();
+  const result = statement('C-002', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0003');
+});
+
+test('statement normalizes customer ID', () => {
+  const invoices = createTestInvoices();
+  const result = statement('c-001', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement filters by issueDate', () => {
+  const invoices = createTestInvoices();
+  const result = statement('C-001', invoices, '2026-10-05');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement includes invoices on the asOf date', () => {
+  const invoices = createTestInvoices();
+  const result = statement('C-001', invoices, '2026-10-07');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = createTestInvoices();
+  const allInvoices = [draft, ...issued];
+
+  const result = statement('C-001', allInvoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoices = createTestInvoices();
+  const result = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-07');
+});
+
+test('statement includes invoice fields', () => {
+  const invoices = createTestInvoices();
+  const result = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  const invoice = result.value.invoices[0];
+  assert('number' in invoice);
+  assert('issueDate' in invoice);
+  assert('dueDate' in invoice);
+  assert('total' in invoice);
+  assert('due' in invoice);
+});
+
+test('statement calculates totalDue for unpaid invoices', () => {
+  const invoices = createTestInvoices();
+  const result = statement('C-001', invoices, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  const expectedTotalDue = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(result.value.totalDue, expectedTotalDue);
+});
+
+test('statement excludes fully paid invoices', () => {
+  const invoices = createTestInvoices();
+  const fullPayment = recordPayment(invoices[0], {
+    amount: 20570,
+    date: '2026-10-08',
+  }).value;
+
+  const mixed = [fullPayment, invoices[1], invoices[2]];
+  const result = statement('C-001', mixed, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement includes partially paid invoices', () => {
+  const invoices = createTestInvoices();
+  const partial = recordPayment(invoices[0], {
+    amount: 10000,
+    date: '2026-10-08',
+  }).value;
+
+  const mixed = [partial, invoices[1], invoices[2]];
+  const result = statement('C-001', mixed, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert(result.value.invoices[0].due > 0);
+  assert(result.value.invoices[0].due < result.value.invoices[0].total);
+});
+
+test('statement with multiple customers', () => {
+  const invoices = createTestInvoices();
+  const resultC001 = statement('C-001', invoices, '2026-10-31');
+  const resultC002 = statement('C-002', invoices, '2026-10-31');
+
+  assert.equal(resultC001.value.invoices.length, 2);
+  assert.equal(resultC002.value.invoices.length, 1);
+  assert.equal(resultC001.value.totalDue + resultC002.value.totalDue,
+    resultC001.value.totalDue + resultC002.value.totalDue);
+});
+
+test('statement with empty invoice list', () => {
+  const result = statement('C-001', [], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement respects due field from balanceDue', () => {
+  const invoices = createTestInvoices();
+  const partial = recordPayment(invoices[0], {
+    amount: 5000,
+    date: '2026-10-08',
+  }).value;
+
+  const mixed = [partial, invoices[1]];
+  const result = statement('C-001', mixed, '2026-10-31');
+
+  assert.equal(result.ok, true);
+  const firstInv = result.value.invoices[0];
+  assert(firstInv.due > 0);
+  assert(firstInv.due < firstInv.total);
+  assert.equal(firstInv.total - firstInv.due, 5000);
+});
