diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..1723fcc
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,154 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createIssuedInvoice() {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  return issueInvoice(draft, []).value;
+}
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Defective item', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Defective item');
+  assert.equal(result.value.date, '2026-10-08');
+});
+
+test('createCreditNote returns NOT_ISSUED for draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const result = createCreditNote(draft, { amount: 5000, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote works for partially_paid invoice', () => {
+  const invoice = createIssuedInvoice();
+  const partial = recordPayment(invoice, { amount: 5000, date: '2026-10-08' }).value;
+
+  const result = createCreditNote(partial, { amount: 3000, reason: 'Partial refund', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works for paid invoice', () => {
+  const invoice = createIssuedInvoice();
+  const total = 20570;
+  const paid = recordPayment(invoice, { amount: total, date: '2026-10-08' }).value;
+
+  const result = createCreditNote(paid, { amount: 5000, reason: 'Full refund', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote returns AMOUNT_INVALID for zero amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 0, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote returns AMOUNT_INVALID for negative amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: -1000, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote returns AMOUNT_INVALID for decimal amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 100.50, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote returns DATE_INVALID for invalid date', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '10/08/2026' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createCreditNote returns CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const invoice = createIssuedInvoice();
+  const total = 20570;
+  const result = createCreditNote(invoice, { amount: total + 1, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote allows credit note equal to invoice total', () => {
+  const invoice = createIssuedInvoice();
+  const total = 20570;
+  const result = createCreditNote(invoice, { amount: total, reason: 'Full refund', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, total);
+});
+
+test('createCreditNote generates unique numbers for same year', () => {
+  const invoice = createIssuedInvoice();
+  const result1 = createCreditNote(invoice, { amount: 5000, reason: 'Test 1', date: '2026-10-08' }, []);
+  const result2 = createCreditNote(invoice, { amount: 5000, reason: 'Test 2', date: '2026-10-09' }, [result1.value.number]);
+
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote restarts counter for different year', () => {
+  const invoice = createIssuedInvoice();
+  const existingNumbers = ['CN-2026-0001', 'CN-2026-0005'];
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2027-01-15' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote ignores invoice numbers in existingNumbers', () => {
+  const invoice = createIssuedInvoice();
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001'];
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2026-10-08' }, existingNumbers);
+
+  assert.equal(result.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote with various invoice totals', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'ICON-SET', qty: 10 },
+    ],
+  }).value;
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Partial refund', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 1000);
+});
+
+test('createCreditNote preserves customer ID from invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2026-10-08' }, []);
+  assert.equal(result.value.customerId, 'C-001');
+});
