diff --git a/src/credits.js b/src/credits.js
new file mode 100644
index 0000000..1e6d3a3
--- /dev/null
+++ b/src/credits.js
@@ -0,0 +1,52 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+function isPositiveInteger(value) {
+  return Number.isInteger(value) && value > 0;
+}
+
+function getNextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const cnPrefix = `CN-${year}-`;
+
+  const creditNoteNumbers = existingNumbers
+    .filter((num) => num.startsWith(cnPrefix))
+    .map((num) => parseInt(num.slice(cnPrefix.length), 10))
+    .filter((num) => !isNaN(num));
+
+  const maxCounter = creditNoteNumbers.length > 0 ? Math.max(...creditNoteNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${cnPrefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!isPositiveInteger(amount)) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const { total } = invoiceTotals(invoice);
+  if (amount > total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = getNextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
