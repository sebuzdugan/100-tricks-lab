new file mode 100644
index 0000000..31a2d38
--- /dev/null
+++ b/src/reports.js
@@ -0,0 +1,16 @@
+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.dueDate && inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
diff --git a/test/reports.test.js b/test/reports.test.js
new file mode 100644
index 0000000..83694eb
--- /dev/null
+++ b/test/reports.test.js
@@ -0,0 +1,184 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoices() {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const inv1Issued = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-15',
+    lines: [{ sku: 'ICON-SET', qty: 5 }],
+    terms: 'NET30',
+  }).value;
+  const inv2Issued = issueInvoice(inv2, [inv1Issued.number]).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'HOST-MONTH', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const inv3Issued = issueInvoice(inv3, [inv1Issued.number, inv2Issued.number]).value;
+
+  return [inv1Issued, inv2Issued, inv3Issued];
+}
+
+test('overdueInvoices returns empty array when no invoices are overdue', () => {
+  const invoices = createTestInvoices();
+  const result = overdueInvoices(invoices, '2026-09-10');
+
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes invoices past their due date', () => {
+  const invoices = createTestInvoices();
+  const result = overdueInvoices(invoices, '2026-09-20');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, invoices[0].number);
+});
+
+test('overdueInvoices excludes invoices on their due date', () => {
+  const invoices = createTestInvoices();
+  const result = overdueInvoices(invoices, '2026-09-15');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes all overdue invoices', () => {
+  const invoices = createTestInvoices();
+  const result = overdueInvoices(invoices, '2026-10-20');
+
+  assert.equal(result.length, 3);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const invoices = createTestInvoices();
+  const result = overdueInvoices(invoices, '2026-10-20');
+
+  assert.equal(result[0].daysOverdue > result[1].daysOverdue, true);
+  assert.equal(result[0].number, invoices[0].number);
+  assert.equal(result[1].number, invoices[1].number);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoices = createTestInvoices();
+  const result = overdueInvoices(invoices, '2026-09-30');
+
+  const overdue = result.find((r) => r.number === invoices[0].number);
+  assert.equal(overdue.daysOverdue, 15);
+});
+
+test('overdueInvoices includes invoice fields', () => {
+  const invoices = createTestInvoices();
+  const result = overdueInvoices(invoices, '2026-10-20');
+
+  const invoice = result[0];
+  assert('number' in invoice);
+  assert('customerId' in invoice);
+  assert('dueDate' in invoice);
+  assert('daysOverdue' in invoice);
+  assert('due' in invoice);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const invoices = [draft, ...createTestInvoices()];
+  const result = overdueInvoices(invoices, '2026-10-20');
+
+  assert.equal(result.length, 3);
+  assert(!result.some((r) => r.number === undefined));
+});
+
+test('overdueInvoices excludes fully paid invoices', () => {
+  const invoices = createTestInvoices();
+  const { total } = invoiceTotals(invoices[0]);
+  const paidResult = recordPayment(invoices[0], {
+    amount: total,
+    date: '2026-09-20',
+  });
+
+  if (!paidResult.ok) {
+    throw new Error(`Failed to record payment: ${paidResult.error}`);
+  }
+
+  const paid = paidResult.value;
+  const mixed = [paid, invoices[1], invoices[2]];
+  const result = overdueInvoices(mixed, '2026-10-20');
+
+  assert.equal(result.length, 2);
+});
+
+test('overdueInvoices includes partially paid invoices', () => {
+  const invoices = createTestInvoices();
+  const partial = recordPayment(invoices[0], {
+    amount: 10000,
+    date: '2026-09-20',
+  }).value;
+
+  const mixed = [partial, invoices[1], invoices[2]];
+  const result = overdueInvoices(mixed, '2026-10-20');
+
+  assert.equal(result.length, 3);
+  const partialInvoice = result.find((r) => r.number === partial.number);
+  assert(partialInvoice.due > 0);
+  const { total } = invoiceTotals(partial);
+  assert(partialInvoice.due < total);
+});
+
+test('overdueInvoices includes correct due amount', () => {
+  const invoices = createTestInvoices();
+  const paymentAmount = 5000;
+  const partial = recordPayment(invoices[0], {
+    amount: paymentAmount,
+    date: '2026-09-20',
+  }).value;
+
+  const result = overdueInvoices([partial, invoices[1], invoices[2]], '2026-10-20');
+
+  const { total } = invoiceTotals(partial);
+  const partialOverdue = result.find((r) => r.number === partial.number);
+  assert(partialOverdue.due > 0);
+  assert(partialOverdue.due < total);
+  assert.equal(partialOverdue.due, total - paymentAmount);
+});
+
+test('overdueInvoices with multiple customers', () => {
+  const invoices = createTestInvoices();
+  const result = overdueInvoices(invoices, '2026-10-20');
+
+  const customers = new Set(result.map((r) => r.customerId));
+  assert(customers.has('C-001'));
+  assert(customers.has('C-002'));
+});
+
+test('overdueInvoices with empty invoice list', () => {
+  const result = overdueInvoices([], '2026-10-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices preserves invoice details', () => {
+  const invoices = createTestInvoices();
+  const result = overdueInvoices(invoices, '2026-10-20');
+
+  result.forEach((overdue) => {
+    const original = invoices.find((inv) => inv.number === overdue.number);
+    assert.equal(overdue.customerId, original.customerId);
+    assert.equal(overdue.dueDate, original.dueDate);
+  });
+});
