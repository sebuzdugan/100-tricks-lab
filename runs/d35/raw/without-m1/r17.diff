+test('vatSummary calculates base correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = vatSummary([issued]);
+
+  const rate21 = result.find((r) => r.rate === 21);
+  assert.equal(rate21.base, 17000);
+});
