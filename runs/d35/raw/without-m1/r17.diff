+test('vatSummary groups by VAT rate', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = vatSummary([issued]);
+
+  assert.equal(result.length, 2);
+  const rate21 = result.find((r) => r.rate === 21);
+  const rate9 = result.find((r) => r.rate === 9);
+  assert(rate21);
+  assert(rate9);
+});
