+test('lateFee calculates 0.04% per day for overdue invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const { total } = invoiceTotals(issued);
+
+  const asOf = '2026-10-28';
+  const fee = lateFee(issued, asOf);
+  const daysOverdue = 7;
+  const expectedFee = Math.round(total * 0.0004 * daysOverdue);
+  assert.equal(fee, expectedFee);
+});
