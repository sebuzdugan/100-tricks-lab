+test('lateFee uses balanceDue for partially paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const { total } = invoiceTotals(issued);
+  const paymentAmount = 5000;
+  const partial = recordPayment(issued, { amount: paymentAmount, date: '2026-10-15' }).value;
+
+  const asOf = '2026-10-28';
+  const fee = lateFee(partial, asOf);
+  const daysOverdue = 7;
+  const balanceDue = total - paymentAmount;
+  const expectedFee = Math.round(balanceDue * 0.0004 * daysOverdue);
+  assert.equal(fee, expectedFee);
+});
