+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createIssuedInvoice(customerId = 'C-002', issueDate = '2026-10-07', lines = [{ sku: 'DES-HOUR', qty: 2 }]) {
+  const draft = createInvoice({
+    customerId,
+    issueDate,
+    lines,
+  }).value;
+  return issueInvoice(draft, []).value;
+}
+
+test('exportCsv includes header line', () => {
+  const invoices = [createIssuedInvoice()];
+  const csv = exportCsv(invoices);
+
+  assert(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv exports one invoice', () => {
+  const invoices = [createIssuedInvoice()];
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert.equal(lines.length, 3);
+  assert(lines[0].startsWith('number,customer'));
+  assert(lines[1].includes('INV-2026-0001'));
+  assert.equal(lines[2], '');
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const inv1 = issueInvoice(draft1, []).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'ICON-SET', qty: 5 }],
+  }).value;
+  const inv2 = issueInvoice(draft2, [inv1.number]).value;
+
+  const draft3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'HOST-MONTH', qty: 1 }],
+  }).value;
+  const inv3 = issueInvoice(draft3, [inv1.number, inv2.number]).value;
+
+  const invoices = [inv1, inv2, inv3];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert.equal(lines.length, 5);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+  assert(lines[3].includes('INV-2026-0003'));
+});
+
+test('exportCsv formats money as euros', () => {
+  const invoices = [createIssuedInvoice()];
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+
+  assert(dataLine.includes('.'));
+  const parts = dataLine.split(',');
+  const subtotal = parts[5];
+  assert(subtotal.includes('.'));
+  assert(!subtotal.includes('€'));
+});
+
+test('exportCsv includes customer name', () => {
+  const invoices = [createIssuedInvoice('C-001')];
+  const csv = exportCsv(invoices);
+
+  assert(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv includes invoice number', () => {
+  const invoices = [createIssuedInvoice()];
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+
+  assert(dataLine.includes('INV-2026-0001'));
+});
+
+test('exportCsv includes issueDate', () => {
+  const invoices = [createIssuedInvoice('C-002', '2026-10-15')];
+  const csv = exportCsv(invoices);
+
+  assert(csv.includes('2026-10-15'));
+});
+
+test('exportCsv includes dueDate', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(draft, []).value;
+  const csv = exportCsv([issued]);
+
+  assert(csv.includes('2026-10-21'));
+});
+
+test('exportCsv handles missing dueDate', () => {
+  const invoices = [createIssuedInvoice()];
+  invoices[0].dueDate = undefined;
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+
+  const parts = dataLine.split(',');
+  assert.equal(parts[3], '');
+});
+
+test('exportCsv includes status', () => {
+  const invoices = [createIssuedInvoice()];
+  const csv = exportCsv(invoices);
+
+  assert(csv.includes('issued'));
+});
+
+test('exportCsv includes subtotal', () => {
+  const invoices = [createIssuedInvoice()];
+  const { subtotal } = invoiceTotals(invoices[0]);
+  const csv = exportCsv(invoices);
+
+  assert(csv.includes((subtotal / 100).toFixed(2)));
+});
+
+test('exportCsv includes discount', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  }).value;
+  const issued = issueInvoice(draft, []).value;
+  const { discount } = invoiceTotals(issued);
+  const csv = exportCsv([issued]);
+
+  assert(csv.includes((discount / 100).toFixed(2)));
+});
+
+test('exportCsv includes VAT', () => {
+  const invoices = [createIssuedInvoice()];
+  const { vat } = invoiceTotals(invoices[0]);
+  const csv = exportCsv(invoices);
+
+  assert(csv.includes((vat / 100).toFixed(2)));
+});
+
+test('exportCsv includes total', () => {
+  const invoices = [createIssuedInvoice()];
+  const { total } = invoiceTotals(invoices[0]);
+  const csv = exportCsv(invoices);
+
+  assert(csv.includes((total / 100).toFixed(2)));
+});
+
+test('exportCsv includes due amount', () => {
+  const invoices = [createIssuedInvoice()];
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  assert(parts.length >= 10);
+  assert(parts[9].length > 0);
+});
+
+test('exportCsv with partially paid invoice shows remaining due', () => {
+  const invoice = createIssuedInvoice();
+  const paymentAmount = 5000;
+  const partial = recordPayment(invoice, { amount: paymentAmount, date: '2026-10-15' }).value;
+
+  const csv = exportCsv([partial]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const due = parseFloat(parts[9]);
+
+  const { total } = invoiceTotals(invoice);
+  const expectedDue = (total - paymentAmount) / 100;
+  assert.equal(due, expectedDue);
+});
+
+test('exportCsv with fully paid invoice shows 0 due', () => {
+  const invoice = createIssuedInvoice();
+  const { total } = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: total, date: '2026-10-15' }).value;
+
+  const csv = exportCsv([paid]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const due = parseFloat(parts[9]);
+
+  assert.equal(due, 0);
+});
+
+test('exportCsv escapes commas in customer name', () => {
+  const invoices = [createIssuedInvoice('C-004')];
+  const csv = exportCsv(invoices);
+
+  assert(csv.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes double quotes in fields', () => {
+  const invoices = [createIssuedInvoice('C-006')];
+  const csv = exportCsv(invoices);
+
+  assert(csv.includes('""'));
+});
+
+test('exportCsv returns header only for empty list', () => {
+  const csv = exportCsv([]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv ends lines with newline', () => {
+  const invoices = [createIssuedInvoice()];
+  const csv = exportCsv(invoices);
+
+  assert(csv.endsWith('\n'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const inv1 = issueInvoice(draft1, []).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'ICON-SET', qty: 1 }],
+  }).value;
+  const inv2 = issueInvoice(draft2, [inv1.number]).value;
+
+  const draft3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'HOST-MONTH', qty: 1 }],
+  }).value;
+  const inv3 = issueInvoice(draft3, [inv1.number, inv2.number]).value;
+
+  const csv = exportCsv([inv1, inv2, inv3]);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+  assert(lines[3].includes('INV-2026-0003'));
+});
+
+test('exportCsv money has exactly 2 decimals', () => {
+  const invoices = [createIssuedInvoice()];
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+
+  for (let i = 5; i <= 9; i++) {
+    const value = parts[i];
+    const dotIndex = value.indexOf('.');
+    if (dotIndex !== -1) {
+      const decimals = value.slice(dotIndex + 1);
+      assert.equal(decimals.length, 2, `Field ${i} has incorrect decimal places: ${value}`);
+    }
+  }
+});
+
+test('exportCsv handles draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const csv = exportCsv([draft]);
+  assert(csv.includes('draft'));
+});
