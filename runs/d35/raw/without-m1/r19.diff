+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function formatMoney(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map((inv) => {
+    const customer = getCustomer(inv.customerId);
+    const customerName = customer.ok ? customer.value.name : inv.customerId;
+    const { subtotal, discount, vat, total } = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    return (
+      [
+        inv.number,
+        customerName,
+        inv.issueDate,
+        inv.dueDate || '',
+        inv.status,
+        formatMoney(subtotal),
+        formatMoney(discount),
+        formatMoney(vat),
+        formatMoney(total),
+        formatMoney(due),
+      ]
+        .map(escapeCsvField)
+        .join(',') + '\n'
+    );
+  });
+
+  return header + lines.join('');
+}
