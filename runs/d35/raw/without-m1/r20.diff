diff --git a/src/money.js b/src/money.js
index fadf486..36f6306 100644
--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,32 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = { EUR: 1, USD: 1.085, GBP: 0.8425 };
+
+export function convert(cents, currency) {
+  if (!RATES.hasOwnProperty(currency)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const targetCents = roundCents(cents * RATES[currency]);
+  return ok(targetCents);
+}
+
+export function formatMoney(cents, currency) {
+  const symbols = { EUR: '€', USD: '$', GBP: '£' };
+
+  const convertResult = convert(cents, currency);
+  if (!convertResult.ok) {
+    return '';
+  }
+
+  const sign = convertResult.value < 0 ? '-' : '';
+  const abs = Math.abs(convertResult.value);
+  const amount = Math.floor(abs / 100)
+    .toString()
+    .replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const symbol = symbols[currency] || '';
+
+  return `${sign}${symbol}${amount}.${String(abs % 100).padStart(2, '0')}`;
+}
