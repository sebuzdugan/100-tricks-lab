+
+test('RATES includes EUR, USD, GBP', () => {
+  assert('EUR' in RATES);
+  assert('USD' in RATES);
+  assert('GBP' in RATES);
+});
+
+test('RATES has correct values', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(100, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 100);
+});
+
+test('convert EUR cents to USD cents', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, Math.round(10000 * 1.085));
+});
+
+test('convert EUR cents to GBP cents', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, Math.round(10000 * 0.8425));
+});
+
+test('convert returns UNKNOWN_CURRENCY for invalid currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with 0 cents', () => {
+  const result = convert(0, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert negative cents EUR to USD', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, Math.round(-10000 * 1.085));
+});
+
+test('convert produces integer cents', () => {
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  assert(Number.isInteger(result.value));
+});
+
+test('convert is deterministic', () => {
+  const result1 = convert(10000, 'USD');
+  const result2 = convert(10000, 'USD');
+  assert.equal(result1.value, result2.value);
+});
+
+test('convert case-sensitive currency', () => {
+  const result = convert(10000, 'usd');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
