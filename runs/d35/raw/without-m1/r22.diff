--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,267 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const line = { qty: 2, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 17000);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal with large qty', () => {
+  const line = { qty: 100, unitPrice: 500 };
+  assert.equal(lineTotal(line), 50000);
+});
+
+test('lineDiscount returns 0 when no discountPercent', () => {
+  const line = { qty: 2, unitPrice: 8500 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount returns 0 when discountPercent is 0', () => {
+  const line = { qty: 2, unitPrice: 8500, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount calculates correctly with 10% discount', () => {
+  const line = { qty: 2, unitPrice: 8500, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 1700);
+});
+
+test('lineDiscount with 50% discount', () => {
+  const line = { qty: 2, unitPrice: 8500, discountPercent: 50 };
+  assert.equal(lineDiscount(line), 8500);
+});
+
+test('lineDiscount with decimal discount', () => {
+  const line = { qty: 2, unitPrice: 8500, discountPercent: 5.5 };
+  const discount = lineDiscount(line);
+  assert(Number.isInteger(discount));
+  assert.equal(discount, 935);
+});
+
+test('lineDiscount rounds correctly', () => {
+  const line = { qty: 3, unitPrice: 1000, discountPercent: 33.33 };
+  const discount = lineDiscount(line);
+  assert(Number.isInteger(discount));
+});
+
+test('lineVat returns 0 for 0% VAT rate', () => {
+  const line = { qty: 2, unitPrice: 8500, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat calculates with 21% VAT', () => {
+  const line = { qty: 2, unitPrice: 8500, vatRate: 21 };
+  const vat = lineVat(line);
+  assert(Number.isInteger(vat));
+  assert.equal(vat, 3570);
+});
+
+test('lineVat with discount reduces VAT base', () => {
+  const line = { qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 };
+  const vat = lineVat(line);
+  const expectedBase = 17000 - 1700;
+  const expectedVat = Math.round((expectedBase * 21) / 100);
+  assert.equal(vat, expectedVat);
+});
+
+test('lineVat rounds to nearest cent', () => {
+  const line = { qty: 1, unitPrice: 1000, vatRate: 9 };
+  const vat = lineVat(line);
+  assert(Number.isInteger(vat));
+  assert.equal(vat, 90);
+});
+
+test('lineVat with 9% rate', () => {
+  const line = { qty: 100, unitPrice: 500, vatRate: 9 };
+  const vat = lineVat(line);
+  assert(Number.isInteger(vat));
+  assert.equal(vat, 4500);
+});
+
+test('invoiceTotals single line', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 17000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 3570);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 20570);
+});
+
+test('invoiceTotals multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, vatRate: 21 },
+      { qty: 5, unitPrice: 500, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert(totals.subtotal > 0);
+  assert(totals.vat > 0);
+  assert(totals.total > 0);
+});
+
+test('invoiceTotals with line discounts', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.discount, 1700);
+  assert(totals.total < 20570);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.voucher, 1000);
+  assert.equal(totals.total, 20570 - 1000);
+});
+
+test('invoiceTotals without voucher', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals never returns negative total', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    voucher: { code: 'BIG', amount: 50000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with multiple discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+      { qty: 5, unitPrice: 500, discountPercent: 5, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert(totals.discount > 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, vatRate: 21 },
+      { qty: 1, unitPrice: 1000, vatRate: 9 },
+      { qty: 1, unitPrice: 1000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert(totals.vat > 0);
+  assert.equal(totals.subtotal, 3000);
+});
+
+test('invoiceTotals structure has all fields', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert('subtotal' in totals);
+  assert('discount' in totals);
+  assert('vat' in totals);
+  assert('voucher' in totals);
+  assert('total' in totals);
+});
+
+test('invoiceTotals returns integers', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert(Number.isInteger(totals.subtotal));
+  assert(Number.isInteger(totals.discount));
+  assert(Number.isInteger(totals.vat));
+  assert(Number.isInteger(totals.voucher));
+  assert(Number.isInteger(totals.total));
+});
+
+test('invoiceTotals total = subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  const expected = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals preserves precision in calculations', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 999, vatRate: 21 },
+      { qty: 7, unitPrice: 1001, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert(totals.subtotal > 0);
+  assert(totals.vat > 0);
+});
+
+test('lineVat with high VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 21 };
+  const vat = lineVat(line);
+  assert.equal(vat, 2100);
+});
+
+test('lineVat with low VAT rate', () => {
+  const line = { qty: 1, unitPrice: 10000, vatRate: 0.1 };
+  const vat = lineVat(line);
+  assert(vat >= 0);
+});
+
+test('invoiceTotals order independence', () => {
+  const linesA = [
+    { qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+    { qty: 5, unitPrice: 500, discountPercent: 5, vatRate: 9 },
+  ];
+  const linesB = [
+    { qty: 5, unitPrice: 500, discountPercent: 5, vatRate: 9 },
+    { qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+  ];
+
+  const totalsA = invoiceTotals({ lines: linesA });
+  const totalsB = invoiceTotals({ lines: linesB });
+
+  assert.deepEqual(totalsA, totalsB);
+});
