--- a/src/totals.js
+++ b/src/totals.js
@@ -4,11 +4,22 @@ export function lineTotal(line) {
   return line.qty * line.unitPrice;
 }
 
-export function lineDiscount(line) {
+function lineFirstDiscount(line) {
   if (!line.discountPercent) return 0;
   return roundCents((lineTotal(line) * line.discountPercent) / 100);
 }
 
+export function bulkDiscount(line) {
+  if (line.qty < 10) return 0;
+  const firstDiscount = lineFirstDiscount(line);
+  const amountAfterFirstDiscount = lineTotal(line) - firstDiscount;
+  return roundCents((amountAfterFirstDiscount * 2.5) / 100);
+}
+
+export function lineDiscount(line) {
+  return lineFirstDiscount(line) + bulkDiscount(line);
+}
+
 export function lineVat(line) {
   const amountAfterDiscount = lineTotal(line) - lineDiscount(line);
   return roundCents(Math.max(0, amountAfterDiscount) * (line.vatRate / 100));
