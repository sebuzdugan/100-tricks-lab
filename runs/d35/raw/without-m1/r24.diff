@@ -52,3 +52,43 @@ export function lateFee(invoice, asOf) {
 
   return roundCents(fee);
 }
+
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  invoices.forEach((inv) => {
+    counts[inv.status] = (counts[inv.status] || 0) + 1;
+  });
+
+  const outstandingInvoices = invoices.filter(
+    (inv) => inv.status === 'issued' || inv.status === 'partially_paid'
+  );
+  const outstanding = outstandingInvoices.reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  const overdueList = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const customerDue = new Map();
+  outstandingInvoices.forEach((inv) => {
+    const due = balanceDue(inv);
+    if (due > 0) {
+      const current = customerDue.get(inv.customerId) || 0;
+      customerDue.set(inv.customerId, current + due);
+    }
+  });
+
+  const topCustomers = Array.from(customerDue.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return { counts, outstanding, overdue, topCustomers };
+}
