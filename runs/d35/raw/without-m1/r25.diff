@@ -14,13 +15,35 @@ export function renderInvoiceText(invoice) {
     const unitPriceFormatted = formatEuros(line.unitPrice);
     const totalFormatted = formatEuros(total);
     lines.push(`${line.qty} x ${line.name} @ ${unitPriceFormatted} = ${totalFormatted}`);
+
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      const discountFormatted = formatEuros(discount);
+      lines.push(`  Discount: ${discountFormatted}`);
+    }
   }
 
   const { vat, total } = invoiceTotals(invoice);
   const vatFormatted = formatEuros(vat);
   const totalFormatted = formatEuros(total);
+
+  if (invoice.voucher) {
+    const voucherFormatted = formatEuros(invoice.voucher.amount);
+    lines.push(`Voucher: ${voucherFormatted}`);
+  }
+
   lines.push(`VAT: ${vatFormatted}`);
   lines.push(`Total: ${totalFormatted}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const paidFormatted = formatEuros(totalPaid);
+    lines.push(`Paid: ${paidFormatted}`);
+  }
+
   return lines.join('\n');
 }
