+
+/**
+ * Add or update a line on an invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} param1
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty is a positive integer
+  if (!Number.isInteger(qty) || qty <= 0) {
+    return fail('QTY_INVALID');
+  }
+
+  // Get product from catalogue to validate SKU exists
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Create new lines array with either updated or added line
+  const existingLineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  let newLines;
+
+  if (existingLineIndex >= 0) {
+    // Update existing line
+    newLines = invoice.lines.map((line, idx) =>
+      idx === existingLineIndex ? { ...line, qty: line.qty + qty } : line
+    );
+  } else {
+    // Add new line at the end
+    newLines = [
+      ...invoice.lines,
+      {
+        sku,
+        name: product.name,
+        qty,
+        unitPrice: product.unitPrice,
+        vatRate: product.vatRate,
+      },
+    ];
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check line exists
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex < 0) return fail('LINE_NOT_FOUND');
+
+  // Check there's more than one line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new lines array without the line
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
