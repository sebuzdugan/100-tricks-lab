diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..190d38c
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates first number for a year', () => {
+  const number = nextInvoiceNumber([], '2025-10-15');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter for the same year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2025-10-20');
+  assert.equal(number, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber restarts counter for a new year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0050'];
+  const number = nextInvoiceNumber(existing, '2025-01-01');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0100', 'INV-2025-0005', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(number, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber handles unordered input', () => {
+  const existing = ['INV-2025-0010', 'INV-2025-0002', 'INV-2025-0050', 'INV-2025-0005'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0051');
+});
+
+test('nextInvoiceNumber finds max counter correctly', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0099', 'INV-2025-0050'];
+  const number = nextInvoiceNumber(existing, '2025-12-31');
+  assert.equal(number, 'INV-2025-0100');
+});
+
+test('nextInvoiceNumber zero-pads to 4 digits', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2025-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0010');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2025-9999'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2025-0001', 'INVALID', 'INV-2024-XXXX', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0004');
+});
