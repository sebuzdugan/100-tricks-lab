--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,33 @@
+/**
+ * Extract year and counter from an invoice number.
+ * @param {string} number e.g. "INV-2025-0042"
+ * @returns {{ year: number, counter: number } | null}
+ */
+function parseInvoiceNumber(number) {
+  const match = /^INV-(\d{4})-(\d{4})$/.exec(number);
+  if (!match) return null;
+  return { year: parseInt(match[1], 10), counter: parseInt(match[2], 10) };
+}
+
+/**
+ * Get the next invoice number for a given date.
+ * @param {string[]} existingNumbers array of invoice numbers already used, in any order
+ * @param {string} issueDate YYYY-MM-DD format
+ * @returns {string} next invoice number, e.g. "INV-2025-0001"
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = parseInt(issueDate.substring(0, 4), 10);
+
+  // Find the max counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const parsed = parseInvoiceNumber(num);
+    if (parsed && parsed.year === year) {
+      maxCounter = Math.max(maxCounter, parsed.counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const counterStr = String(nextCounter).padStart(4, '0');
+  return `INV-${year}-${counterStr}`;
+}
