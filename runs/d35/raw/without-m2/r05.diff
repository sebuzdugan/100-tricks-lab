+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals, lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to a customer.
+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }}
+ * @returns {string} plain-text invoice
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  // Build lines
+  const lines = [];
+
+  // Invoice number or DRAFT
+  const invoiceNumber = invoice.number ?? 'DRAFT';
+  lines.push(invoiceNumber);
+
+  // Customer name
+  lines.push(customerName);
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const qty = line.qty;
+    const name = line.name;
+    const unitPrice = formatEuros(line.unitPrice);
+    const lineTotal_formatted = formatEuros(total);
+
+    lines.push(`${qty} ${name} ${unitPrice} ${lineTotal_formatted}`);
+  }
+
+  // Total
+  const totals = invoiceTotals(invoice);
+  const totalFormatted = formatEuros(totals.total);
+  lines.push(`Total: ${totalFormatted}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..321c315
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,185 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  assert.match(text, /^INV-2025-0001\n/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Northwind Studio/);
+});
+
+test('renderInvoiceText formats single line correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5 Design work \(hour\) €85\.00 €425\.00/);
+});
+
+test('renderInvoiceText shows all lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /5 Design work/);
+  assert.match(text, /10 Development/);
+  assert.match(text, /2 Icon set/);
+});
+
+test('renderInvoiceText calculates correct line totals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 }, // 2 * €85.00 = €170.00
+      { sku: 'DEV-HOUR', qty: 3 }, // 3 * €95.00 = €285.00
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /2 Design work \(hour\) €85\.00 €170\.00/);
+  assert.match(text, /3 Development \(hour\) €95\.00 €285\.00/);
+});
+
+test('renderInvoiceText shows correct invoice total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 }, // €170.00
+      { sku: 'DEV-HOUR', qty: 3 }, // €285.00
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Total: €455\.00/);
+});
+
+test('renderInvoiceText formats multi-line output correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'ICON-SET', qty: 5 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.ok(lines[2].includes('Logo package'));
+  assert.ok(lines[3].includes('Icon set'));
+  assert.match(lines[4], /^Total:/);
+});
+
+test('renderInvoiceText handles different quantities and prices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 }, // 100 * €0.37 = €37.00
+      { sku: 'STICKER', qty: 1000 }, // 1000 * €0.50 = €500.00
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /100 Printed flyer/);
+  assert.match(text, /1000 Sticker/);
+  assert.match(text, /Total: €537\.00/);
+});
+
+test('renderInvoiceText uses formatEuros for all amounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }], // €9.96
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  // All amounts should have two decimal places and euro sign
+  assert.match(text, /€\d+\.\d{2}/);
+  const matches = text.match(/€\d+\.\d{2}/g);
+  assert.ok(matches.length >= 2); // At least unitPrice and line total
+});
+
+test('renderInvoiceText handles issued invoice with previous numbers', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+
+  const existing = ['INV-2025-0001', 'INV-2025-0002'];
+  const issued = issueInvoice(invoice2, existing).value;
+
+  const text = renderInvoiceText(issued);
+  assert.match(text, /^INV-2025-0003\n/);
+});
+
+test('renderInvoiceText shows different customer names', () => {
+  const c1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const c2 = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text1 = renderInvoiceText(c1);
+  const text2 = renderInvoiceText(c2);
+
+  assert.match(text1, /Northwind Studio/);
+  assert.match(text2, /Lumen Records/);
+});
