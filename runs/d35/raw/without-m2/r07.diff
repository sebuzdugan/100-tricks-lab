+    customerId: 'C-003', // Kite & Co, silver tier
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice does not add discountPercent for standard tier if it is 0', () => {
+  const result = createInvoice({
+    customerId: 'C-002', // Blue Fern Bakery, standard tier
+    issueDate: '2025-10-15',
