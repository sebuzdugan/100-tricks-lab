+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice explicit 0% discountPercent overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5% automatic)
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice applies tier discount to all lines without their own discount', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // Kite & Co, silver tier (2.5%)
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 }, // gets 2.5%
+      { sku: 'DEV-HOUR', qty: 3, discountPercent: 15 }, // overrides with 15%
+      { sku: 'COPY-HOUR', qty: 2 }, // gets 2.5%
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+  assert.equal(result.value.lines[1].discountPercent, 15);
+  assert.equal(result.value.lines[2].discountPercent, 2.5);
+});
+
+test('createInvoice tier discount affects invoiceTotals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }], // €850 - 5% = €807.50
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.total, 80750);
+});
+
+test('createInvoice explicit discount overrides tier in totals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }], // €850 - 10% = €765
+  }).value;
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 8500);
+  assert.equal(totals.total, 76500);
+});
