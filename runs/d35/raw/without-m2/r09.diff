+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId(' C-003 '), 'C-003');
+  assert.equal(normalizeId('C-003\n'), 'C-003');
+  assert.equal(normalizeId('\tC-003'), 'C-003');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-003'), 'C-003');
+  assert.equal(normalizeId('c-007 '), 'C-007');
+  assert.equal(normalizeId('C-003'), 'C-003');
+});
+
+test('normalizeId handles mixed case and whitespace', () => {
+  assert.equal(normalizeId('c-007 '), 'C-007');
+  assert.equal(normalizeId(' c-001\t'), 'C-001');
+  assert.equal(normalizeId('  C-012  '), 'C-012');
+});
+
+test('getCustomer accepts mixed case IDs', () => {
+  const result = getCustomer('c-003');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Kite & Co');
+});
+
+test('getCustomer accepts IDs with whitespace', () => {
+  const result = getCustomer('C-003 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Kite & Co');
+});
+
+test('getCustomer accepts mixed case with whitespace', () => {
+  const result = getCustomer(' c-007 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Halvorsen Architects');
+});
