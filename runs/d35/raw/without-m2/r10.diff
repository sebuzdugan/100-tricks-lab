+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates in YYYY-MM-DD format', () => {
+  assert.equal(isValidDate('2025-10-15'), true);
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+});
+
+test('isValidDate rejects invalid date format', () => {
+  assert.equal(isValidDate('15-10-2025'), false);
+  assert.equal(isValidDate('2025/10/15'), false);
+  assert.equal(isValidDate('2025-10'), false);
+  assert.equal(isValidDate('2025-10-15-01'), false);
+  assert.equal(isValidDate('25-10-15'), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+  assert.equal(isValidDate('2024-02-30'), false); // 2024 is leap year but Feb 30 doesn't exist
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2025-02-29'), false); // 2025 is not a leap year
+  assert.equal(isValidDate('2023-02-29'), false); // 2023 is not a leap year
+});
+
+test('isValidDate accepts leap year Feb 29', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // 2024 is a leap year
+  assert.equal(isValidDate('2000-02-29'), true); // 2000 is a leap year
+});
+
+test('isValidDate rejects whitespace or empty strings', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate(' 2025-10-15'), false);
+  assert.equal(isValidDate('2025-10-15 '), false);
+  assert.equal(isValidDate('2025-10-15\n'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-10-15', 1), '2025-10-16');
+  assert.equal(addDays('2025-10-15', 10), '2025-10-25');
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+});
+
+test('addDays subtracts with negative days', () => {
+  assert.equal(addDays('2025-10-15', -1), '2025-10-14');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+  assert.equal(addDays('2025-10-15', -10), '2025-10-05');
+});
+
+test('addDays with zero days', () => {
+  assert.equal(addDays('2025-10-15', 0), '2025-10-15');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-10-31', 1), '2025-11-01');
+  assert.equal(addDays('2025-11-30', 1), '2025-12-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2025-12-31', 365), '2026-12-31');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // 2024 is leap year
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01'); // 2025 is not leap year
+});
+
+test('daysBetween calculates days forward', () => {
+  assert.equal(daysBetween('2025-10-15', '2025-10-16'), 1);
+  assert.equal(daysBetween('2025-10-15', '2025-10-25'), 10);
+  assert.equal(daysBetween('2025-10-15', '2025-11-15'), 31);
+});
+
+test('daysBetween calculates days backward (negative)', () => {
+  assert.equal(daysBetween('2025-10-15', '2025-10-14'), -1);
+  assert.equal(daysBetween('2025-10-25', '2025-10-15'), -10);
+});
+
+test('daysBetween same day is zero', () => {
+  assert.equal(daysBetween('2025-10-15', '2025-10-15'), 0);
+});
+
+test('daysBetween across month boundaries', () => {
+  assert.equal(daysBetween('2025-10-31', '2025-11-01'), 1);
+  assert.equal(daysBetween('2025-10-15', '2025-12-15'), 61); // Oct has 31 days, Nov has 30
+});
+
+test('daysBetween across year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+});
+
+test('daysBetween across leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2); // leap year, counts 29th
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1); // non-leap year
+});
+
+test('daysBetween returns whole days', () => {
+  // All dates are treated as UTC start of day, so partial days are floor'd
+  assert.equal(daysBetween('2025-10-15', '2025-10-16'), 1);
+  assert.equal(daysBetween('2025-10-15', '2025-10-16'), 1);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const start = '2025-10-15';
+  const days = 42;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+});
+
+test('addDays and daysBetween with negative days', () => {
+  const start = '2025-10-15';
+  const days = -10;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+  assert.equal(daysBetween(end, start), -days);
+});
+
+test('isValidDate uses UTC (not local timezone)', () => {
+  // These tests verify that date parsing is in UTC
+  // If we parse '2025-02-29' and it's accepted, it means Feb 29, 2025 doesn't exist
+  assert.equal(isValidDate('2025-02-29'), false);
+  // If we parse '2024-02-29' and it's accepted, it's a valid leap year date
+  assert.equal(isValidDate('2024-02-29'), true);
+});
+
+test('addDays uses UTC (not local timezone)', () => {
+  // Adding days should work consistently regardless of local timezone
+  const date = '2025-10-15';
+  const next = addDays(date, 1);
+  assert.equal(next, '2025-10-16');
+});
+
+test('daysBetween uses UTC (not local timezone)', () => {
+  // Calculating days between should be consistent in UTC
+  const a = '2025-10-15';
+  const b = '2025-10-16';
+  assert.equal(daysBetween(a, b), 1);
+});
