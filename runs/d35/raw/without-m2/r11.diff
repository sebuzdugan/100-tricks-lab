@@ -0,0 +1,75 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }>, ...rest }} invoice
+ * @param {object} totals - from invoiceTotals(invoice)
+ * @returns {number} amount due in cents, clamped to >= 0
+ */
+function calculateBalanceDue(invoice, totals) {
+  const payments = invoice.payments ?? [];
+  const totalPaid = payments.reduce((sum, payment) => sum + payment.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
+
+/**
+ * Get the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }>, ...rest }} invoice
+ * @returns {number} amount due in cents
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  return calculateBalanceDue(invoice, totals);
+}
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, payments?: Array, ...rest }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check invoice is issued or partially paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const totals = invoiceTotals(invoice);
+  const currentBalance = calculateBalanceDue(invoice, totals);
+
+  // Check for overpayment
+  if (amount > currentBalance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array with the payment added
+  const newPayments = [...(invoice.payments ?? []), { amount, date }];
+  const newBalance = currentBalance - amount;
+
+  // Determine new status
+  let newStatus;
+  if (newBalance === 0) {
+    newStatus = 'paid';
+  } else {
+    newStatus = 'partially_paid';
+  }
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
index 0000000..21305c0
