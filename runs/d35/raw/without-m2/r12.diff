+/**
+ * Calculate the due date based on payment terms.
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} due date in YYYY-MM-DD format
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    // Last day of the month of the issue date
+    const [year, month] = issueDate.split('-');
+    const nextMonth = parseInt(month, 10) === 12 ? 1 : parseInt(month, 10) + 1;
+    const nextYear = parseInt(month, 10) === 12 ? parseInt(year, 10) + 1 : parseInt(year, 10);
+    const firstDayNextMonth = `${String(nextYear).padStart(4, '0')}-${String(nextMonth).padStart(2, '0')}-01`;
+    return addDays(firstDayNextMonth, -1);
+  }
+  return null;
+}
