index 0000000..fb2d849
--- /dev/null
+++ b/src/statements.js
@@ -0,0 +1,57 @@
+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { isValidDate, daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get a customer statement showing outstanding invoices.
+ * @param {string} customerId
+ * @param {Array} invoices - all invoices to filter
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize customer ID
+  const normalizedCustomerId = normalizeId(customerId);
+
+  // Validate customer exists
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Filter invoices for this customer
+  const customerInvoices = invoices.filter(
+    (invoice) => normalizeId(invoice.customerId) === normalizedCustomerId
+  );
+
+  // Filter by status and date
+  const dueInvoices = customerInvoices
+    .filter(
+      (invoice) =>
+        (invoice.status === 'issued' || invoice.status === 'partially_paid') &&
+        daysBetween(invoice.issueDate, asOf) >= 0
+    )
+    .map((invoice) => {
+      const totals = invoiceTotals(invoice);
+      return {
+        number: invoice.number,
+        issueDate: invoice.issueDate,
+        dueDate: invoice.dueDate,
+        total: totals.total,
+        due: balanceDue(invoice),
+      };
+    })
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = dueInvoices.reduce((sum, invoice) => sum + invoice.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: dueInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
index 0000000..4f67cda
