+++ b/test/statements.test.js
@@ -0,0 +1,291 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns empty list for customer with no invoices', () => {
+  const result = statement('C-001', [], '2025-10-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement filters by customer ID', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2025-10-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2025-0001');
+});
+
+test('statement filters by invoice status', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  // Create a draft invoice
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  // Create a paid invoice
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €425 + VAT €89.25 = €514.25
+  }).value;
+  let issued3 = issueInvoice(inv3, ['INV-2025-0001']).value;
+  issued3 = recordPayment(issued3, { amount: 51425, date: '2025-10-20' }).value;
+  assert.equal(issued3.status, 'paid');
+
+  const result = statement('C-002', [issued1, draft, issued3], '2025-10-15');
+
+  // Should include issued1 but not draft (status='draft') or issued3 (status='paid')
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2025-0001');
+});
+
+test('statement filters by date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued3 = issueInvoice(inv3, ['INV-2025-0001', 'INV-2025-0002']).value;
+
+  // Statement as of Oct 14 should exclude invoices issued on Oct 15 and later
+  let result = statement('C-001', [issued1, issued2, issued3], '2025-10-14');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2025-10-01');
+
+  // Statement as of Oct 15 should include invoices issued on Oct 15
+  result = statement('C-001', [issued1, issued2, issued3], '2025-10-15');
+  assert.equal(result.value.invoices.length, 2);
+
+  // Statement as of Oct 20 should include all
+  result = statement('C-001', [issued1, issued2, issued3], '2025-10-20');
+  assert.equal(result.value.invoices.length, 3);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued3 = issueInvoice(inv3, ['INV-2025-0001', 'INV-2025-0002']).value;
+
+  // Add in reverse order
+  const result = statement('C-001', [issued1, issued2, issued3], '2025-10-31');
+
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].issueDate, '2025-10-01');
+  assert.equal(result.value.invoices[1].issueDate, '2025-10-10');
+  assert.equal(result.value.invoices[2].issueDate, '2025-10-20');
+});
+
+test('statement includes invoice details', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }], // €1028.50
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = statement('C-002', [issued], '2025-10-31');
+
+  assert.equal(result.value.invoices.length, 1);
+  const line = result.value.invoices[0];
+  assert.equal(line.number, 'INV-2025-0001');
+  assert.equal(line.issueDate, '2025-10-15');
+  assert.equal(line.dueDate, '2025-10-29');
+  assert.equal(line.total, 102850);
+  assert.equal(line.due, 102850);
+});
+
+test('statement calculates due from balanceDue', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }], // €1028.50
+  }).value;
+  let issued = issueInvoice(inv, []).value;
+
+  // Make partial payment
+  issued = recordPayment(issued, { amount: 50000, date: '2025-10-20' }).value;
+
+  const result = statement('C-002', [issued], '2025-10-31');
+
+  assert.equal(result.value.invoices[0].total, 102850);
+  assert.equal(result.value.invoices[0].due, 52850);
+});
+
+test('statement calculates totalDue as sum of due amounts', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €425 + VAT €89.25 = €514.25
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }], // €475 + VAT €99.75 = €574.75
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const result = statement('C-002', [issued1, issued2], '2025-10-31');
+
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].due, 51425);
+  assert.equal(result.value.invoices[1].due, 57475);
+  assert.equal(result.value.totalDue, 108900);
+});
+
+test('statement includes partially paid invoices with correct due amount', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }], // €850 + VAT €178.50 = €1028.50
+  }).value;
+  let issued1 = issueInvoice(inv1, []).value;
+  issued1 = recordPayment(issued1, { amount: 50000, date: '2025-10-05' }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }], // €950 + VAT €199.50 = €1149.50
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const result = statement('C-002', [issued1, issued2], '2025-10-31');
+
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].due, 52850);
+  assert.equal(result.value.invoices[1].due, 114950);
+  assert.equal(result.value.totalDue, 167800);
+});
+
+test('statement normalizes customer ID', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  // Pass mixed case customer ID
+  let result = statement('c-001', [issued], '2025-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+
+  // Pass customer ID with whitespace
+  result = statement(' C-001 ', [issued], '2025-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement rejects unknown customer', () => {
+  const result = statement('C-999', [], '2025-10-31');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement rejects invalid date', () => {
+  assert.deepEqual(statement('C-001', [], '15-10-2025'), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+
+  assert.deepEqual(statement('C-001', [], '2025-10-35'), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+});
+
+test('statement handles mixed invoice statuses and amounts', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €514.25
+  }).value;
+  let issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }], // €1083.50
+  }).value;
+  let issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+  issued2 = recordPayment(issued2, { amount: 50000, date: '2025-10-10' }).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'COPY-HOUR', qty: 3 }], // €180 + VAT €37.80 = €217.80
+  }).value;
+  let issued3 = issueInvoice(inv3, ['INV-2025-0001', 'INV-2025-0002']).value;
+  issued3 = recordPayment(issued3, { amount: 21780, date: '2025-10-20' }).value;
+  assert.equal(issued3.status, 'paid');
+
+  const result = statement('C-002', [issued1, issued2, issued3], '2025-10-31');
+
+  // Should include issued1 (issued) and issued2 (partially_paid), but not issued3 (paid)
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, 'INV-2025-0001');
+  assert.equal(result.value.invoices[0].due, 51425);
+  assert.equal(result.value.invoices[1].number, 'INV-2025-0002');
+  assert.equal(result.value.invoices[1].due, 64950); // €950 + VAT €199.50 = €1149.50, minus €500 payment = €649.50
+  assert.equal(result.value.totalDue, 116375);
+});
