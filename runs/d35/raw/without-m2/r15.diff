+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Extract credit note number details from a credit note number.
+ * @param {string} number e.g. "CN-2025-0042"
+ * @returns {{ year: number, counter: number } | null}
+ */
+function parseCreditNoteNumber(number) {
+  const match = /^CN-(\d{4})-(\d{4})$/.exec(number);
+  if (!match) return null;
+  return { year: parseInt(match[1], 10), counter: parseInt(match[2], 10) };
+}
+
+/**
+ * Get the next credit note number for a given date.
+ * @param {string[]} existingNumbers array of all invoice and credit note numbers
+ * @param {string} date YYYY-MM-DD format
+ * @returns {string} next credit note number, e.g. "CN-2025-0001"
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = parseInt(date.substring(0, 4), 10);
+
+  // Find the max counter for credit notes in this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const parsed = parseCreditNoteNumber(num);
+    if (parsed && parsed.year === year) {
+      maxCounter = Math.max(maxCounter, parsed.counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const counterStr = String(nextCounter).padStart(4, '0');
+  return `CN-${year}-${counterStr}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {string[]} existingNumbers array of all invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is issued, partially_paid, or paid
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const totals = invoiceTotals(invoice);
+
+  // Check amount doesn't exceed invoice total
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
