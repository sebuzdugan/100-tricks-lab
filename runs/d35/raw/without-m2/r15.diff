diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..59df27b
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,229 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('nextCreditNoteNumber generates first number for a year', () => {
+  const number = nextCreditNoteNumber([], '2025-10-15');
+  assert.equal(number, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber increments counter for same year', () => {
+  const existing = ['CN-2025-0001', 'CN-2025-0002'];
+  const number = nextCreditNoteNumber(existing, '2025-10-20');
+  assert.equal(number, 'CN-2025-0003');
+});
+
+test('nextCreditNoteNumber restarts counter for new year', () => {
+  const existing = ['CN-2024-0001', 'CN-2024-0050', 'CN-2025-0001'];
+  const number = nextCreditNoteNumber(existing, '2026-01-01');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001'];
+  const number = nextCreditNoteNumber(existing, '2025-10-20');
+  assert.equal(number, 'CN-2025-0002');
+});
+
+test('nextCreditNoteNumber handles unordered input', () => {
+  const existing = ['CN-2025-0010', 'CN-2025-0002', 'CN-2025-0050', 'CN-2025-0005'];
+  const number = nextCreditNoteNumber(existing, '2025-10-15');
+  assert.equal(number, 'CN-2025-0051');
+});
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €514.25
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = createCreditNote(issued, { amount: 25000, reason: 'Customer complaint', date: '2025-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2025-0001');
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 25000);
+  assert.equal(result.value.reason, 'Customer complaint');
+  assert.equal(result.value.date, '2025-10-20');
+});
+
+test('createCreditNote works for partially_paid invoice', () => {
+  let invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  let issued = issueInvoice(invoice, []).value;
+  issued = recordPayment(issued, { amount: 25000, date: '2025-10-20' }).value;
+  assert.equal(issued.status, 'partially_paid');
+
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Partial refund', date: '2025-10-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote works for paid invoice', () => {
+  let invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €514.25
+  }).value;
+  let issued = issueInvoice(invoice, []).value;
+  issued = recordPayment(issued, { amount: 51425, date: '2025-10-20' }).value;
+  assert.equal(issued.status, 'paid');
+
+  const result = createCreditNote(issued, { amount: 25000, reason: 'Return', date: '2025-10-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  assert.deepEqual(createCreditNote(invoice, { amount: 25000, reason: 'Refund', date: '2025-10-20' }, []), {
+    ok: false,
+    error: 'NOT_ISSUED',
+  });
+});
+
+test('createCreditNote validates amount is positive integer', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(createCreditNote(issued, { amount: 0, reason: 'Refund', date: '2025-10-20' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: -1000, reason: 'Refund', date: '2025-10-20' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: 100.5, reason: 'Refund', date: '2025-10-20' }, []), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('createCreditNote validates date format', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(createCreditNote(issued, { amount: 25000, reason: 'Refund', date: '15-10-2025' }, []), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+
+  assert.deepEqual(createCreditNote(issued, { amount: 25000, reason: 'Refund', date: '2025-10-35' }, []), {
+    ok: false,
+    error: 'DATE_INVALID',
+  });
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €514.25
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  assert.deepEqual(createCreditNote(issued, { amount: 60000, reason: 'Refund', date: '2025-10-20' }, []), {
+    ok: false,
+    error: 'CREDIT_TOO_HIGH',
+  });
+});
+
+test('createCreditNote allows exact amount equal to invoice total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €514.25
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = createCreditNote(issued, { amount: 51425, reason: 'Full refund', date: '2025-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 51425);
+});
+
+test('createCreditNote numbers independently from invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(invoice, ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003']).value;
+
+  // Credit note counter should be independent
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Refund', date: '2025-10-20' }, [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2025-0003',
+    'CN-2025-0001',
+    'CN-2025-0002',
+  ]);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0003');
+});
+
+test('createCreditNote with multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const cn1 = createCreditNote(issued1, { amount: 25000, reason: 'Refund 1', date: '2025-10-15' }, ['INV-2025-0001', 'INV-2025-0002']).value;
+  const cn2 = createCreditNote(issued2, { amount: 50000, reason: 'Refund 2', date: '2025-10-20' }, ['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001']).value;
+
+  assert.equal(cn1.number, 'CN-2025-0001');
+  assert.equal(cn2.number, 'CN-2025-0002');
+  assert.equal(cn1.invoiceNumber, 'INV-2025-0001');
+  assert.equal(cn2.invoiceNumber, 'INV-2025-0002');
+});
+
+test('createCreditNote with discounts and VAT', () => {
+  let invoice = createInvoice({
+    customerId: 'C-001', // gold tier (5% discount)
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }], // €1200, discount 5% = €60, net €1140, VAT €239.40, total €1379.40
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = createCreditNote(issued, { amount: 137940, reason: 'Full refund', date: '2025-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+  assert.equal(result.value.amount, 137940);
+});
