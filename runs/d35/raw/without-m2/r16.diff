+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array for no invoices', () => {
+  const result = overdueInvoices([], '2025-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty array when no invoices are overdue', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €514.25
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  // Due date is 2025-10-29, check as of 2025-10-15 (before due date)
+
+  const result = overdueInvoices([issued], '2025-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes invoices due today', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  // Due date is 2025-10-29
+
+  const result = overdueInvoices([issued], '2025-10-29');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes invoices overdue by one day', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €514.25
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  // Due date is 2025-10-29
+
+  const result = overdueInvoices([issued], '2025-10-30');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2025-0001');
+  assert.equal(result[0].customerId, 'C-002');
+  assert.equal(result[0].dueDate, '2025-10-29');
+  assert.equal(result[0].daysOverdue, 1);
+  assert.equal(result[0].due, 51425);
+});
+
+test('overdueInvoices includes invoices overdue by multiple days', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  // Due date is 2025-10-29
+
+  const result = overdueInvoices([issued], '2025-11-05');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 7);
+});
+
+test('overdueInvoices includes issued invoices but excludes draft', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued1 = issueInvoice(issued, []).value;
+
+  const result = overdueInvoices([draft, issued1], '2025-11-05');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2025-0001');
+});
+
+test('overdueInvoices includes partially_paid but excludes paid', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €514.25
+    terms: 'NET14',
+  }).value;
+  let issued1 = issueInvoice(inv1, []).value;
+  issued1 = recordPayment(issued1, { amount: 25000, date: '2025-10-10' }).value;
+  assert.equal(issued1.status, 'partially_paid');
+
+  let inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  let issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+  issued2 = recordPayment(issued2, { amount: 51425, date: '2025-10-10' }).value;
+  assert.equal(issued2.status, 'paid');
+
+  const result = overdueInvoices([issued1, issued2], '2025-11-05');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].status, undefined); // status not included in output
+  assert.equal(result[0].number, 'INV-2025-0001');
+  assert.equal(result[0].due, 26425);
+});
+
+test('overdueInvoices sorts by daysOverdue, most overdue first', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14', // due 2025-10-15
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14', // due 2025-10-24
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14', // due 2025-10-19
+  }).value;
+  const issued3 = issueInvoice(inv3, ['INV-2025-0001', 'INV-2025-0002']).value;
+
+  const result = overdueInvoices([issued1, issued2, issued3], '2025-11-05');
+
+  assert.equal(result.length, 3);
+  // Most overdue first
+  assert.equal(result[0].number, 'INV-2025-0001'); // due 2025-10-15, 21 days overdue
+  assert.equal(result[0].daysOverdue, 21);
+  assert.equal(result[1].number, 'INV-2025-0003'); // due 2025-10-19, 17 days overdue
+  assert.equal(result[1].daysOverdue, 17);
+  assert.equal(result[2].number, 'INV-2025-0002'); // due 2025-10-24, 12 days overdue
+  assert.equal(result[2].daysOverdue, 12);
+});
+
+test('overdueInvoices calculates correct due for partially paid invoices', () => {
+  let invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }], // €950 + VAT €199.50 = €1149.50
+    terms: 'NET14',
+  }).value;
+  let issued = issueInvoice(invoice, []).value;
+  issued = recordPayment(issued, { amount: 60000, date: '2025-10-10' }).value;
+
+  const result = overdueInvoices([issued], '2025-11-05');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 54950); // 114950 - 60000
+});
+
+test('overdueInvoices handles multiple customers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const result = overdueInvoices([issued1, issued2], '2025-11-05');
+
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[1].customerId, 'C-002');
+});
+
+test('overdueInvoices with EOM terms', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'EOM', // due 2025-10-31
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2025-11-01');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2025-10-31');
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices with NET30 terms', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30', // due 2025-11-14
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2025-11-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2025-11-14');
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices with invoices having discounts and VAT', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }], // €1200, 5% discount = €60, net €1140, VAT €239.40, total €1379.40
+    terms: 'NET14', // due 2025-10-15
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const result = overdueInvoices([issued], '2025-10-20');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2025-10-15');
+  assert.equal(result[0].daysOverdue, 5);
+  assert.equal(result[0].due, 137940);
+});
+
+test('overdueInvoices with many overdue invoices', () => {
+  const invoices = [];
+
+  for (let i = 0; i < 10; i++) {
+    const inv = createInvoice({
+      customerId: 'C-002',
+      issueDate: `2025-09-${String(i + 1).padStart(2, '0')}`,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET14',
+    }).value;
+    const issued = issueInvoice(inv, invoices.map((_, idx) => `INV-2025-${String(idx + 1).padStart(4, '0')}`)).value;
+    invoices.push(issued);
+  }
+
+  const result = overdueInvoices(invoices, '2025-11-05');
+
+  assert.equal(result.length, 10);
+  // Check they're sorted most overdue first
+  for (let i = 1; i < result.length; i++) {
+    assert.ok(result[i - 1].daysOverdue >= result[i].daysOverdue);
+  }
+});
