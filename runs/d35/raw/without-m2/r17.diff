+
+/**
+ * Get a VAT summary across invoices.
+ * @param {Array} invoices
+ * @returns {Array} array of { rate, base, vat }, sorted by rate descending, one per VAT rate
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const lineTotal = line.qty * line.unitPrice;
+      const discountPercent = line.discountPercent ?? 0;
+      const lineDiscount = roundCents((lineTotal * discountPercent) / 100);
+      const base = lineTotal - lineDiscount;
+      const vat = roundCents((base * line.vatRate) / 100);
+
+      const rate = line.vatRate;
+      if (!vatMap[rate]) {
+        vatMap[rate] = { base: 0, vat: 0 };
+      }
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vat;
+    }
+  }
+
+  const result = Object.keys(vatMap)
+    .map((rate) => ({
+      rate: parseInt(rate, 10),
+      base: vatMap[rate].base,
+      vat: vatMap[rate].vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return result;
+}
