+/**
+ * Calculate late fee for an overdue invoice.
+ * @param {{ status: string, dueDate: string, payments?: Array }} invoice
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {number} late fee in cents, 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  // Only calculate for issued, partially_paid, or paid invoices
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // No late fee if not overdue
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  const fee = roundCents((due * daysOverdue * 0.04) / 100);
+
+  return Math.max(0, fee);
+}
