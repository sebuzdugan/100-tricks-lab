+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header and empty rows for empty invoices', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+  assert.equal(lines.length, 2);
+});
+
+test('exportCsv exports single issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }], // €514.25
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], 'INV-2025-0001,Blue Fern Bakery,2025-10-15,2025-10-29,issued,425.00,0.00,89.25,514.25,514.25');
+  assert.equal(lines[2], '');
+});
+
+test('exportCsv exports draft invoice with empty number', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    // Default terms is NET30, so dueDate is 2025-11-14
+  }).value;
+
+  const csv = exportCsv([draft]);
+  const lines = csv.split('\n');
+
+  // Draft invoice has empty number but has dueDate from default NET30 terms
+  assert.equal(lines[1], ',Blue Fern Bakery,2025-10-15,2025-11-14,draft,425.00,0.00,89.25,514.25,514.25');
+});
+
+test('exportCsv formats amounts correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }], // €85, VAT €17.85, total €102.85
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines[1], 'INV-2025-0001,Blue Fern Bakery,2025-10-15,2025-10-29,issued,85.00,0.00,17.85,102.85,102.85');
+});
+
