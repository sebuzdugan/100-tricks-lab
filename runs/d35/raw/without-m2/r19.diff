+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function formatEurosForCsv(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+function escapeCsvField(value) {
+  const str = String(value);
+  // If field contains comma, double quote, or newline, wrap in quotes and escape quotes
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    const escaped = str.replace(/"/g, '""');
+    return `"${escaped}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices
+ * @returns {string} CSV string with header and invoice rows
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data rows
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number ?? '',
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate ?? '',
+      invoice.status,
+      formatEurosForCsv(totals.subtotal),
+      formatEurosForCsv(totals.discount),
+      formatEurosForCsv(totals.vat),
+      formatEurosForCsv(totals.total),
+      formatEurosForCsv(due),
+    ];
+
+    const line = fields.map(escapeCsvField).join(',');
+    lines.push(line);
+  }
+
+  return lines.join('\n') + '\n';
+}
