+
+test('exportCsv preserves invoice order', () => {
+  const invoices = [];
+
+  for (let i = 0; i < 5; i++) {
+    const inv = createInvoice({
+      customerId: 'C-002',
+      issueDate: `2025-10-${String(i + 1).padStart(2, '0')}`,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET14',
+    }).value;
+    const issued = issueInvoice(inv, invoices.map((_, idx) => `INV-2025-${String(idx + 1).padStart(4, '0')}`)).value;
+    invoices.push(issued);
+  }
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert.equal(lines[1].startsWith('INV-2025-0001'), true);
+  assert.equal(lines[2].startsWith('INV-2025-0002'), true);
+  assert.equal(lines[3].startsWith('INV-2025-0003'), true);
+  assert.equal(lines[4].startsWith('INV-2025-0004'), true);
+  assert.equal(lines[5].startsWith('INV-2025-0005'), true);
+});
