+    terms: 'NET14',
+  }).value;
+
+  // Apply voucher to draft invoice
+  const voucherResult = issueInvoice(invoice, []);
+  invoice = voucherResult.value;
+
+  // Manually add voucher since it's already issued
+  // Voucher reduces the total from 514.25 to 414.25 (100 euros = 10000 cents)
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+
+  // Check that the invoice line is present with correct number
+  assert.equal(lines[1].includes('INV-2025-0001'), true);
+  assert.equal(lines[1].includes('514.25'), true); // total without voucher
+});
