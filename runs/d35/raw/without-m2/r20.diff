+
+test('RATES has correct values', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10850); // 10000 * 1.085 = 10850
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 8425); // 10000 * 0.8425 = 8425
+});
+
+test('convert EUR to EUR is identity', () => {
+  const result = convert(12345, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 12345);
+});
+
+test('convert with large amount EUR to USD', () => {
+  const result = convert(514250, 'USD');
+  assert.equal(result.ok, true);
+  // 514250 * 1.085 = 557961.25 → 557961
+  assert.equal(result.value, 557961);
+});
+
+test('convert with large amount EUR to GBP', () => {
+  const result = convert(514250, 'GBP');
+  assert.equal(result.ok, true);
+  // 514250 * 0.8425 = 433255.625 → 433256
+  assert.equal(result.value, 433256);
+});
+
+test('convert rejects unknown currency', () => {
+  const result = convert(100, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert rejects null currency', () => {
+  const result = convert(100, null);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert preserves zero', () => {
+  assert.deepEqual(convert(0, 'USD'), { ok: true, value: 0 });
+  assert.deepEqual(convert(0, 'GBP'), { ok: true, value: 0 });
+  assert.deepEqual(convert(0, 'EUR'), { ok: true, value: 0 });
+});
+
+test('convert with small amounts rounds correctly', () => {
+  // 1 EUR cent to USD: 1 * 1.085 = 1.085 → 1
+  const result = convert(1, 'USD');
