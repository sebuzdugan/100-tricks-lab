diff --git a/src/money.js b/src/money.js
index fadf486..e818e67 100644
--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,49 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert EUR cents to another currency.
+ * @param {number} cents - amount in EUR cents
+ * @param {string} currency - target currency code (EUR, USD, or GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const converted = roundCents(cents * rate);
+  return ok(converted);
+}
+
+/**
+ * Format cents in any supported currency.
+ * @param {number} cents - amount in that currency's cents
+ * @param {string} currency - currency code (EUR, USD, or GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const decimalCents = String(abs % 100).padStart(2, '0');
+  const formatted = `${units}.${decimalCents}`;
+
+  switch (currency) {
+    case 'USD':
+      return `${sign}$${formatted}`;
+    case 'GBP':
+      return `${sign}£${formatted}`;
+    case 'EUR':
+    default:
+      return `${sign}€${formatted}`;
+  }
+}
