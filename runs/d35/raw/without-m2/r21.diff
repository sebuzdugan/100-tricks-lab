+test('mergeCustomers merges two customers', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const allInvoices = [issued1, issued2];
+
+  const result = mergeCustomers(customers, allInvoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.some((c) => c.id === 'C-001'), false);
+  assert.equal(result.value.customers.some((c) => c.id === 'C-002'), true);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  assert.equal(result.value.invoices[1].customerId, 'C-002');
+});
