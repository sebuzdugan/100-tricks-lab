@@ -46,3 +46,42 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge two customers: delete fromId and reassign its invoices to intoId.
+ * @param {Array} customers
+ * @param {Array} invoices
+ * @param {string} fromId - customer to merge from (will be deleted)
+ * @param {string} intoId - customer to merge into
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  // Check if same customer
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  // Check if both customers exist
+  const fromCustomer = customers.find((c) => normalizeId(c.id) === normalizedFromId);
+  const intoCustomer = customers.find((c) => normalizeId(c.id) === normalizedIntoId);
+
+  if (!fromCustomer || !intoCustomer) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Remove fromCustomer from customers array (return new array)
+  const newCustomers = customers.filter((c) => normalizeId(c.id) !== normalizedFromId);
+
+  // Update invoices: reassign all invoices from fromId to intoId (return new array)
+  const newInvoices = invoices.map((invoice) => {
+    if (normalizeId(invoice.customerId) === normalizedFromId) {
+      return { ...invoice, customerId: normalizedIntoId };
+    }
+    return invoice;
+  });
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
