+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty * unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 100 }), 100);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 95 }), 950);
+});
+
+test('lineTotal with zero quantity', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 8500 }), 0);
+});
+
+test('lineTotal with zero unit price', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 0 }), 0);
+});
+
+test('lineDiscount calculates discount percentage', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 20 };
+  // 42500 * 20 / 100 = 8500
+  assert.equal(lineDiscount(line), 8500);
+});
+
+test('lineDiscount with no discount percent defaults to 0', () => {
+  const line = { qty: 5, unitPrice: 8500 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 0% discount', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with decimal percentage', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 5 };
+  // 85000 * 5 / 100 = 4250
+  assert.equal(lineDiscount(line), 4250);
+});
+
+test('lineDiscount with fractional result rounds', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 12.5 };
+  // 42500 * 12.5 / 100 = 5312.5 → 5312 or 5313 depending on rounding
+  const result = lineDiscount(line);
+  assert.ok(result === 5312 || result === 5313);
+});
+
+test('lineDiscount clamped to >= 0', () => {
+  // Discount should never be negative
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 20 };
+  assert.equal(lineDiscount(line) >= 0, true);
+});
+
+test('lineVAT calculates VAT on net amount', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 };
+  // lineTotal = 42500, discount = 0, net = 42500
+  // VAT = 42500 * 21 / 100 = 8925
+  assert.equal(lineVAT(line), 8925);
+});
+
+test('lineVAT with discount reduces base', () => {
+  const line = { qty: 10, unitPrice: 8500, discountPercent: 20, vatRate: 21 };
+  // lineTotal = 85000, discount = 17000, net = 68000
+  // VAT = 68000 * 21 / 100 = 14280
+  assert.equal(lineVAT(line), 14280);
+});
+
+test('lineVAT with 0% VAT rate', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT with 9% VAT rate', () => {
+  const line = { qty: 30, unitPrice: 37, discountPercent: 0, vatRate: 9 };
+  // lineTotal = 1110, discount = 0, net = 1110
+  // VAT = 1110 * 9 / 100 = 99.9 → 100
+  assert.equal(lineVAT(line), 100);
+});
+
+test('lineVAT clamped to >= 0', () => {
+  const line = { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 };
+  assert.equal(lineVAT(line) >= 0, true);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 8925);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 51425);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }, // 42500, 0, 8925
+      { qty: 30, unitPrice: 37, discountPercent: 0, vatRate: 9 }, // 1110, 0, 100
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 43610); // 42500 + 1110
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 9025); // 8925 + 100
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 52635); // 43610 + 9025
+});
+
+test('invoiceTotals with line discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 20, vatRate: 21 }, // 85000, 17000, 14280
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 17000);
+  assert.equal(totals.vat, 14280);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 82280); // 85000 - 17000 + 14280
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 8925);
+  assert.equal(totals.voucher, 10000);
+  assert.equal(totals.total, 41425); // 42500 + 8925 - 10000
+});
+
+test('invoiceTotals total clamped at 0', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'HEAVY', amount: 100000 }, // Voucher larger than total
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.vat, 8925);
+  assert.equal(totals.voucher, 100000);
+  assert.equal(totals.total, 0); // Clamped at 0
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }, // 42500, 0, 8925
+      { qty: 10, unitPrice: 8500, discountPercent: 20, vatRate: 21 }, // 85000, 17000, 14280
+      { qty: 30, unitPrice: 37, discountPercent: 0, vatRate: 9 }, // 1110, 0, 100
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 128610); // 42500 + 85000 + 1110
+  assert.equal(totals.discount, 17000);
+  assert.equal(totals.vat, 23305); // 8925 + 14280 + 100
+  assert.equal(totals.total, 134915); // 128610 - 17000 + 23305
+});
+
+test('invoiceTotals with tier discounts', () => {
+  // Tier discount is applied by createInvoice, so we test with discountPercent already set
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 }, // 85000, 4250, 16958
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 85000);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.vat, 16958); // (85000 - 4250) * 21 / 100 = 80750 * 21 / 100 = 16957.5 → 16958
+  assert.equal(totals.total, 97708); // 85000 - 4250 + 16958
+});
+
+test('invoiceTotals no lines', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals returns object with all required fields', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+
+  assert.ok(totals.hasOwnProperty('subtotal'));
+  assert.ok(totals.hasOwnProperty('discount'));
+  assert.ok(totals.hasOwnProperty('vat'));
+  assert.ok(totals.hasOwnProperty('voucher'));
+  assert.ok(totals.hasOwnProperty('total'));
+});
+
+test('lineDiscount uses correct precision', () => {
+  // Test that rounding is done correctly
+  const line = { qty: 3, unitPrice: 333, discountPercent: 33.33 };
+  // lineTotal = 999, discount = 999 * 33.33 / 100 = 332.6667 → rounds
+  const discount = lineDiscount(line);
+  assert.ok(discount >= 0);
+  assert.ok(Number.isInteger(discount));
+});
+
+test('lineVAT uses correct precision', () => {
+  // Test that VAT rounding is done per-line
+  const line = { qty: 3, unitPrice: 333, discountPercent: 0, vatRate: 9 };
+  // lineTotal = 999, discount = 0, net = 999
+  // VAT = 999 * 9 / 100 = 89.91 → rounds
+  const vat = lineVAT(line);
+  assert.ok(Number.isInteger(vat));
+});
+
+test('invoiceTotals preserves original invoice', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+  const original = JSON.stringify(invoice);
+
+  invoiceTotals(invoice);
+
+  assert.equal(JSON.stringify(invoice), original);
+});
