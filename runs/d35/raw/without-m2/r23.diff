 /**
- * Calculate the VAT for a single line: (lineTotal - lineDiscount) times vatRate / 100.
+ * Calculate the bulk discount for a single line: 2.5% off if qty >= 10, applied after line discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} bulk discount in cents, clamped to >= 0
+ */
+export function bulkDiscount(line) {
+  if (line.qty < 10) {
+    return 0;
+  }
+
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const netAfterLineDiscount = total - discount;
+  const bulk = roundCents((netAfterLineDiscount * 2.5) / 100);
+  return Math.max(0, bulk);
+}
+
+/**
+ * Calculate the VAT for a single line: (lineTotal - lineDiscount - bulkDiscount) times vatRate / 100.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
  * @returns {number} VAT in cents, clamped to >= 0
  */
 export function lineVAT(line) {
   const total = lineTotal(line);
   const discount = lineDiscount(line);
-  const netTotal = total - discount;
+  const bulk = bulkDiscount(line);
+  const netTotal = total - discount - bulk;
   const vat = roundCents((netTotal * line.vatRate) / 100);
   return Math.max(0, vat);
 }
