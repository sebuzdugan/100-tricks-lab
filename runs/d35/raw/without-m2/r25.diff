 import { formatEuros } from './money.js';
 import { getCustomer } from './customers.js';
 import { invoiceTotals, lineTotal, lineDiscount, lineVAT } from './invoices.js';
+import { balanceDue } from './payments.js';
 
 /**
  * Render an invoice as plain text for display to a customer.
@@ -55,7 +56,26 @@ export function renderInvoiceText(invoice) {
   if (totals.vat > 0) {
     lines.push(`VAT: ${vatFormatted}`);
   }
+
   lines.push(`Total: ${totalFormatted}`);
 
+  // Voucher
+  if (invoice.voucher) {
+    const voucherFormatted = formatEuros(invoice.voucher.amount);
+    lines.push(`Voucher (${invoice.voucher.code}): -${voucherFormatted}`);
+  }
+
+  // Due date (only for issued invoices)
+  if (invoice.number && invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const amountPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const amountPaidFormatted = formatEuros(amountPaid);
+    lines.push(`Paid: ${amountPaidFormatted}`);
+  }
+
   return lines.join('\n');
 }
