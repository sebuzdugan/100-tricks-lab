diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..d0413db
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,53 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create an invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} input
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issueDate is a real date in YYYY-MM-DD format
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) return fail('DATE_INVALID');
+  const date = new Date(issueDate + 'T00:00:00Z');
+  if (Number.isNaN(date.getTime())) return fail('DATE_INVALID');
+  const [year, month, day] = issueDate.split('-').map(Number);
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() + 1 !== month || date.getUTCDate() !== day) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines is not empty
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Get product details
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const { sku, name, unitPrice, vatRate } = productResult.value;
+    enrichedLines.push({
+      sku,
+      name,
+      qty: line.qty,
+      unitPrice,
+      vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..e5fc4a0
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,238 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates an invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2025-02-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+
+  const line1 = result.value.lines[0];
+  assert.equal(line1.sku, 'DEV-HOUR');
+  assert.equal(line1.name, 'Development (hour)');
+  assert.equal(line1.qty, 10);
+  assert.equal(line1.unitPrice, 9500);
+  assert.equal(line1.vatRate, 21);
+
+  const line2 = result.value.lines[1];
+  assert.equal(line2.sku, 'STICKER');
+  assert.equal(line2.name, 'Sticker sheet');
+  assert.equal(line2.qty, 5);
+  assert.equal(line2.unitPrice, 50);
+  assert.equal(line2.vatRate, 21);
+});
+
+test('createInvoice reports unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice validates date format', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: 'not-a-date',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025/02/15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '02-15-2025',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice rejects invalid dates', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-30',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-13-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice requires at least one line', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-15',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-15',
+      lines: null,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-15',
+      lines: undefined,
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice validates qty is a positive integer', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-15',
+      lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 1.5 }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 'ten' }],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
+
+test('createInvoice reports unknown SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-15',
+      lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  };
+  const inputCopy = JSON.parse(JSON.stringify(input));
+
+  createInvoice(input);
+
+  assert.deepEqual(input, inputCopy);
+});
+
+test('createInvoice handles products with different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 }, // 21% VAT
+      { sku: 'PRINT-A4', qty: 1 }, // 9% VAT
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0% VAT
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice with valid leap year date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.issueDate, '2024-02-29');
+});
+
+test('createInvoice rejects invalid leap year date', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-29',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice stops at first line error', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-15',
+      lines: [
+        { sku: 'DEV-HOUR', qty: 1 },
+        { sku: 'DEV-HOUR', qty: -1 }, // Invalid
+        { sku: 'UNKNOWN-SKU', qty: 1 }, // Also invalid, but we stop at the first one
+      ],
+    }),
+    { ok: false, error: 'QTY_INVALID' }
+  );
+});
