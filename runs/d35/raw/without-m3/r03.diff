+/**
+ * Add a line to an invoice, or increase qty if SKU already exists.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} input
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Validate status is 'draft'
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty is positive integer
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Get product
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const { name, unitPrice, vatRate } = productResult.value;
+
+  // Find existing line with this SKU
+  const existingLineIndex = invoice.lines.findIndex((l) => l.sku === sku);
+
+  let newLines;
+  if (existingLineIndex >= 0) {
+    // Update existing line's qty
+    newLines = invoice.lines.map((line, i) =>
+      i === existingLineIndex ? { ...line, qty: line.qty + qty } : line
+    );
+  } else {
+    // Add new line at the end
+    newLines = [...invoice.lines, { sku, name, qty, unitPrice, vatRate }];
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Validate status is 'draft'
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if line exists
+  const lineIndex = invoice.lines.findIndex((l) => l.sku === sku);
+  if (lineIndex < 0) return fail('LINE_NOT_FOUND');
+
+  // Check if it's the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new invoice without this line
+  const newLines = invoice.lines.filter((_, i) => i !== lineIndex);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
