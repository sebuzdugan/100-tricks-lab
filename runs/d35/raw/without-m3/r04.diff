+/**
+ * Calculate the next invoice number for a given year.
+ * Format: INV-<year>-<4-digit counter>, counter restarts each year.
+ * @param {string[]} existingNumbers - Array of invoice numbers like ["INV-2025-0001", "INV-2025-0003"]
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} The next invoice number like "INV-2025-0004"
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  // Extract year from issueDate
+  const year = issueDate.split('-')[0];
+
+  // Find the highest counter for this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const match = num.match(/^INV-(\d{4})-(\d{4})$/);
+    if (match && match[1] === year) {
+      const counter = parseInt(match[2], 10);
+      if (counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  // Generate the next number
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `INV-${year}-${paddedCounter}`;
+}
