@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber with no existing numbers', () => {
+  const result = nextInvoiceNumber([], '2025-02-15');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber with one existing number', () => {
+  const result = nextInvoiceNumber(['INV-2025-0001'], '2025-02-15');
+  assert.equal(result, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber with multiple existing numbers in same year', () => {
+  const result = nextInvoiceNumber(['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0005'], '2025-02-15');
+  assert.equal(result, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from different years', () => {
+  const result = nextInvoiceNumber(['INV-2024-0001', 'INV-2024-0999', 'INV-2025-0001'], '2025-02-15');
+  assert.equal(result, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber handles numbers in any order', () => {
+  const result = nextInvoiceNumber(['INV-2025-0005', 'INV-2025-0002', 'INV-2025-0008', 'INV-2025-0001'], '2025-02-15');
+  assert.equal(result, 'INV-2025-0009');
+});
+
+test('nextInvoiceNumber with different year in issueDate', () => {
+  const result = nextInvoiceNumber(['INV-2024-0050'], '2026-01-01');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber with large counter', () => {
+  const result = nextInvoiceNumber(['INV-2025-9999'], '2025-12-31');
+  assert.equal(result, 'INV-2025-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const result = nextInvoiceNumber(
+    ['INV-2025-0001', 'INVALID', 'INV-2025', 'INV-2025-ABC', 'INV-2025-0005'],
+    '2025-02-15'
+  );
+  assert.equal(result, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber with empty string in array', () => {
+  const result = nextInvoiceNumber(['INV-2025-0003', ''], '2025-02-15');
+  assert.equal(result, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const result = nextInvoiceNumber([], '2025-02-15');
+  assert.equal(result, 'INV-2025-0001');
+
+  const result2 = nextInvoiceNumber(['INV-2025-0009'], '2025-02-15');
+  assert.equal(result2, 'INV-2025-0010');
+
+  const result3 = nextInvoiceNumber(['INV-2025-0099'], '2025-02-15');
+  assert.equal(result3, 'INV-2025-0100');
+});
