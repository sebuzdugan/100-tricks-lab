@@ -0,0 +1,249 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+
+  assert.match(text, /^INV-2025-0001\n/);
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /^DRAFT\nKite & Co\n/);
+});
+
+test('renderInvoiceText formats line items with quantity, name, unit price and total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // Should contain: qty x name @ unitPrice = lineTotal
+  assert.match(text, /10 x Development \(hour\) @ €95\.00 = €950\.00/);
+});
+
+test('renderInvoiceText formats multiple lines correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /10 x Development \(hour\) @ €95\.00 = €950\.00/);
+  assert.match(text, /5 x Sticker sheet @ €0\.50 = €2\.50/);
+});
+
+test('renderInvoiceText includes total at the end', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert.match(text, /Total: €952\.50$/);
+});
+
+test('renderInvoiceText single line structure', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.equal(lines[2], '100 x Sticker sheet @ €0.50 = €50.00');
+  assert.equal(lines[3], 'Total: €50.00');
+});
+
+test('renderInvoiceText multiple lines structure', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'STICKER', qty: 10 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  // number, customer, 3 items, total = 6 lines
+  assert.equal(lines.length, 6);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText formats large amounts with thousand separators', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'BRAND-BOOK', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // BRAND-BOOK is 245000 cents = €2,450.00
+  // 10 * 245000 = 2450000 cents = €24,500.00
+  assert.match(text, /10 x Brand guidelines document @ €2,450\.00 = €24,500\.00/);
+  assert.match(text, /Total: €24,500\.00/);
+});
+
+test('renderInvoiceText preserves order of lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'STICKER', qty: 1 },
+      { sku: 'ICON-SET', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /Development/);
+  assert.match(lines[3], /Sticker/);
+  assert.match(lines[4], /Icon set/);
+});
+
+test('renderInvoiceText with issued invoice displays number and same content', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, ['INV-2025-0001']);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2025-0002');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /5 x Development \(hour\) @ €95\.00 = €475\.00/);
+  assert.match(lines[3], /Total: €475\.00/);
+});
+
+test('renderInvoiceText with different VAT rates shows same unitPrice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 }, // 21% VAT
+      { sku: 'PRINT-A4', qty: 100 }, // 9% VAT
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0% VAT
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // VAT is not shown in render (it's added later)
+  // Just checking unitPrices are displayed correctly
+  assert.match(text, /€95\.00/); // DEV-HOUR
+  assert.match(text, /€0\.37/); // PRINT-A4 (37 cents)
+  assert.match(text, /€600\.00/); // WORKSHOP-DAY
+});
+
+test('renderInvoiceText with customer that has special characters', () => {
+  const result = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // C-006 is "Marlow \"The Print Shop\"" with quotes
+  assert.match(text, /Marlow "The Print Shop"/);
+});
+
+test('renderInvoiceText output can be printed', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 50 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // Should be a string with newlines
+  assert.equal(typeof text, 'string');
+  assert.ok(text.includes('\n'));
+
+  // Should have 5 lines: number, customer, 2 items, total
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5);
+
+  // Each line should be non-empty
+  for (const line of lines) {
+    assert.ok(line.length > 0);
+  }
+});
