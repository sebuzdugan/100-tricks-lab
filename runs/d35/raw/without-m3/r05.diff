+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * Amounts are formatted using formatEuros().
+ * @param {{ number?: string, customerId: string, lines: Array }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // Get invoice number or "DRAFT"
+  const numberLine = invoice.number || 'DRAFT';
+
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : '[Unknown Customer]';
+
+  // Build lines
+  const lines = [numberLine, customerName];
+
+  // Add invoice lines
+  for (const line of invoice.lines) {
+    const lineTotalResult = lineTotal(line);
+    const lineTextParts = [
+      `${line.qty} x ${line.name}`,
+      `@ ${formatEuros(line.unitPrice)}`,
+    ];
+
+    if (lineTotalResult.ok) {
+      lineTextParts.push(`= ${formatEuros(lineTotalResult.value)}`);
+    }
+
+    lines.push(lineTextParts.join(' '));
+  }
+
+  // Add total
+  const totalsResult = invoiceTotals(invoice);
+  if (totalsResult.ok) {
+    lines.push(`Total: ${formatEuros(totalsResult.value.total)}`);
+  }
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
