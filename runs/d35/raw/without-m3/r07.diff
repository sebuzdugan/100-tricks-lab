diff --git a/tier_discount_tests.js b/tier_discount_tests.js
new file mode 100644
index 0000000..ea1865e
--- /dev/null
+++ b/tier_discount_tests.js
@@ -0,0 +1,160 @@
+
+test('createInvoice applies gold tier discount (5%)', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount (2.5%)', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // silver tier
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount (0%)', () => {
+  const result = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice with explicit discountPercent overrides tier', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 15 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 15);
+});
+
+test('createInvoice with explicit discountPercent: 0 overrides tier', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice with multiple lines applies tier to each', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // silver tier (2.5%)
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'STICKER', qty: 50 },
+      { sku: 'ICON-SET', qty: 3 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+  assert.equal(result.value.lines[1].discountPercent, 2.5);
+  assert.equal(result.value.lines[2].discountPercent, 2.5);
+});
+
+test('createInvoice with mixed explicit and tier discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 }, // should get 5%
+      { sku: 'STICKER', qty: 50, discountPercent: 10 }, // explicit 10%
+      { sku: 'ICON-SET', qty: 3, discountPercent: 0 }, // explicit 0%
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+  assert.equal(result.value.lines[1].discountPercent, 10);
+  assert.equal(result.value.lines[2].discountPercent, 0);
+});
+
+test('addLine to new SKU uses tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const updated = addLine(result.value, { sku: 'STICKER', qty: 10 });
+
+  assert.equal(updated.ok, true);
+  assert.equal(updated.value.lines[1].discountPercent, 5);
+});
+
+test('addLine with explicit discountPercent to new SKU uses explicit', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const updated = addLine(result.value, { sku: 'STICKER', qty: 10, discountPercent: 20 });
+
+  assert.equal(updated.ok, true);
+  assert.equal(updated.value.lines[1].discountPercent, 20);
+});
+
+test('invoiceTotals with tier discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const totalsResult = invoiceTotals(result.value);
+
+  assert.equal(totalsResult.ok, true);
+  // DEV-HOUR: 10 * 9500 = 95000
+  // Discount (5%): 95000 * 0.05 = 4750
+  // Total: 95000 - 4750 = 90250
+  assert.equal(totalsResult.value.subtotal, 95000);
+  assert.equal(totalsResult.value.discount, 4750);
+  assert.equal(totalsResult.value.total, 90250);
+});
+
+test('invoiceTotals with mixed tier and explicit discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // silver tier (2.5%)
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 }, // 2.5% tier
+      { sku: 'STICKER', qty: 100, discountPercent: 0 }, // explicit 0%
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const totalsResult = invoiceTotals(result.value);
+
+  assert.equal(totalsResult.ok, true);
+  // Line 1: 10 * 9500 = 95000, discount 2.5% = 2375
+  // Line 2: 100 * 50 = 5000, discount 0% = 0
+  // Subtotal: 100000
+  // Discount: 2375
+  // Total: 97625
+  assert.equal(totalsResult.value.subtotal, 100000);
+  assert.equal(totalsResult.value.discount, 2375);
+  assert.equal(totalsResult.value.total, 97625);
+});
