+  const result = createInvoice({ customerId: 'C-002', issueDate: '2025-02-15', lines: [{ sku: 'DEV-HOUR', qty: 10 }, { sku: 'PRINT-A4', qty: 100 }, { sku: 'WORKSHOP-DAY', qty: 1 }] });
