+  const result = createInvoice({ customerId: 'C-002', issueDate: '2025-02-15', lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 20 }] });
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.value.subtotal, 95000);
+  assert.equal(totals.value.discount, 19000);
+  assert.equal(totals.value.vat, 15960);
+  assert.equal(totals.value.total, 91960);
