+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.value.subtotal, 95000);
+  assert.equal(totals.value.discount, 0);
+  assert.equal(totals.value.vat, 19950);
+  assert.equal(totals.value.total, 114950);
