diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..68b75c7
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,98 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-02-15'), true);
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+});
+
+test('isValidDate rejects invalid date strings', () => {
+  assert.equal(isValidDate('2025-02-30'), false); // Feb has no 30th
+  assert.equal(isValidDate('2025-13-01'), false); // month 13
+  assert.equal(isValidDate('2025-00-01'), false); // month 0
+  assert.equal(isValidDate('2025-01-32'), false); // day 32
+  assert.equal(isValidDate('2025-01-00'), false); // day 0
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2025/02/15'), false);
+  assert.equal(isValidDate('02-15-2025'), false);
+  assert.equal(isValidDate('2025-2-15'), false);
+  assert.equal(isValidDate('2025-02-5'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('2025-02-15 '), false); // trailing space
+  assert.equal(isValidDate(' 2025-02-15'), false); // leading space
+});
+
+test('isValidDate rejects invalid leap years', () => {
+  assert.equal(isValidDate('2025-02-29'), false); // 2025 is not a leap year
+  assert.equal(isValidDate('2100-02-29'), false); // 2100 is not a leap year (divisible by 100 but not 400)
+});
+
+test('isValidDate accepts valid leap years', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // 2024 is a leap year
+  assert.equal(isValidDate('2000-02-29'), true); // 2000 is a leap year
+  assert.equal(isValidDate('2020-02-29'), true); // 2020 is a leap year
+});
+
+test('addDays adds days correctly', () => {
+  assert.equal(addDays('2025-02-15', 1), '2025-02-16');
+  assert.equal(addDays('2025-02-15', 10), '2025-02-25');
+  assert.equal(addDays('2025-02-15', 14), '2025-03-01'); // crosses month boundary
+});
+
+test('addDays subtracts days with negative n', () => {
+  assert.equal(addDays('2025-02-15', -1), '2025-02-14');
+  assert.equal(addDays('2025-02-15', -14), '2025-02-01');
+  assert.equal(addDays('2025-03-01', -1), '2025-02-28');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays works across leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-02-29', -1), '2024-02-28');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2025-02-15', 0), '2025-02-15');
+});
+
+test('daysBetween calculates difference correctly', () => {
+  assert.equal(daysBetween('2025-02-15', '2025-02-16'), 1);
+  assert.equal(daysBetween('2025-02-15', '2025-02-25'), 10);
+  assert.equal(daysBetween('2025-02-15', '2025-03-01'), 14);
+});
+
+test('daysBetween with negative difference', () => {
+  assert.equal(daysBetween('2025-02-16', '2025-02-15'), -1);
+  assert.equal(daysBetween('2025-02-25', '2025-02-15'), -10);
+  assert.equal(daysBetween('2025-03-01', '2025-02-15'), -14);
+});
+
+test('daysBetween with same date returns zero', () => {
+  assert.equal(daysBetween('2025-02-15', '2025-02-15'), 0);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+});
+
+test('daysBetween works across leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+});
+
+test('daysBetween with large differences', () => {
+  assert.equal(daysBetween('2025-01-01', '2025-12-31'), 364);
+  assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365); // leap year
+});
