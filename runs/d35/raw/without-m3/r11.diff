@@ -0,0 +1,59 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the balance due on an invoice (total minus payments).
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function balanceDue(invoice) {
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+
+  const total = totalsResult.value.total;
+  const payments = invoice.payments ?? [];
+  const paid = payments.reduce((sum, p) => sum + p.amount, 0);
+
+  return ok(Math.max(0, total - paid));
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: { status: string, payments: Array } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate status is 'issued' or 'partially_paid'
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  // Get current balance due
+  const balanceResult = balanceDue(invoice);
+  if (!balanceResult.ok) return balanceResult;
+
+  const balance = balanceResult.value;
+
+  // Check for overpayment
+  if (amount > balance) return fail('OVERPAYMENT');
+
+  // Add payment to the payments array
+  const existingPayments = invoice.payments ?? [];
+  const newPayments = [...existingPayments, { amount, date }];
+
+  // Calculate new balance
+  const newBalance = balance - amount;
+
+  // Determine new status
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
