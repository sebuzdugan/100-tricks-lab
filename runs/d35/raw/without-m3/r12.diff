+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice defaults to NET30 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(result.value.dueDate, '2025-03-17');
+});
+
+test('createInvoice accepts NET14 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET14');
+  assert.equal(result.value.dueDate, '2025-03-01');
+});
+
+test('createInvoice accepts NET30 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(result.value.dueDate, '2025-03-17');
+});
+
+test('createInvoice accepts EOM terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'EOM');
+  assert.equal(result.value.dueDate, '2025-02-28');
+});
+
+test('createInvoice rejects invalid terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET45',
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'TERMS_INVALID' });
+});
+
+test('createInvoice rejects empty string terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: '',
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'TERMS_INVALID' });
+});
+
+test('createInvoice rejects case-insensitive terms', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'net30',
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'TERMS_INVALID' });
+});
+
+test('NET14 terms work across month boundaries', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-25',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
