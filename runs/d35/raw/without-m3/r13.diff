@@ -0,0 +1,275 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, applyVoucher, invoiceTotals, issueInvoice } from '../src/invoices.js';
+
+test('applyVoucher adds a voucher to a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher.code, 'SAVE10');
+  assert.equal(result.value.voucher.amount, 1000);
+});
+
+test('applyVoucher fails on non-draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = applyVoucher(issued, { code: 'SAVE10', amount: 1000 });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_DRAFT' });
+});
+
+test('applyVoucher requires a positive integer amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const r1 = applyVoucher(invoice, { code: 'SAVE10', amount: 0 });
+  assert.deepEqual(r1, { ok: false, error: 'AMOUNT_INVALID' });
+
+  const r2 = applyVoucher(invoice, { code: 'SAVE10', amount: -1000 });
+  assert.deepEqual(r2, { ok: false, error: 'AMOUNT_INVALID' });
+
+  const r3 = applyVoucher(invoice, { code: 'SAVE10', amount: 100.5 });
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+
+  const r4 = applyVoucher(invoice, { code: 'SAVE10', amount: 'abc' });
+  assert.deepEqual(r4, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('applyVoucher prevents multiple vouchers', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 }).value;
+  const result = applyVoucher(withVoucher, { code: 'SAVE20', amount: 2000 });
+
+  assert.deepEqual(result, { ok: false, error: 'VOUCHER_EXISTS' });
+});
+
+test('applyVoucher does not mutate original invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const originalStatus = invoice.status;
+  const originalVoucher = invoice.voucher;
+
+  applyVoucher(invoice, { code: 'SAVE10', amount: 1000 });
+
+  assert.equal(invoice.status, originalStatus);
+  assert.equal(invoice.voucher, originalVoucher);
+});
+
+test('applyVoucher preserves other invoice properties', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 }).value;
+
+  assert.equal(withVoucher.customerId, invoice.customerId);
+  assert.equal(withVoucher.issueDate, invoice.issueDate);
+  assert.equal(withVoucher.status, invoice.status);
+  assert.deepEqual(withVoucher.lines, invoice.lines);
+});
+
+test('invoiceTotals includes voucher in calculation', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 }).value;
+  const result = invoiceTotals(withVoucher);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher, 1000);
+});
+
+test('invoiceTotals without voucher shows 0 voucher', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher, 0);
+});
+
+test('invoiceTotals total = subtotal - discount + vat - voucher', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'SAVE5', amount: 500 }).value;
+  const totals = invoiceTotals(withVoucher).value;
+
+  const expected = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals clamps negative total to 0', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'BIGSAVE', amount: 100000 }).value;
+  const totals = invoiceTotals(withVoucher).value;
+
+  assert.equal(totals.total, 0);
+  assert(totals.total >= 0);
+});
+
+test('invoiceTotals voucher reduces total by voucher amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const withoutVoucher = invoiceTotals(invoice).value;
+  const withVoucher = invoiceTotals(
+    applyVoucher(invoice, { code: 'SAVE50', amount: 5000 }).value
+  ).value;
+
+  assert.equal(withoutVoucher.total - withVoucher.total, 5000);
+});
+
+test('applyVoucher with various code formats', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const r1 = applyVoucher(invoice, { code: 'CODE123', amount: 100 });
+  assert.equal(r1.ok, true);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const r2 = applyVoucher(invoice2, { code: 'SPECIAL-OFFER-2025', amount: 250 });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.voucher.code, 'SPECIAL-OFFER-2025');
+});
+
+test('applyVoucher with large amounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+  }).value;
+
+  const result = applyVoucher(invoice, { code: 'MASSIVE', amount: 1000000 });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher.amount, 1000000);
+});
+
+test('invoiceTotals with voucher and tier discount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001', // gold tier: 5% discount
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 }).value;
+  const totals = invoiceTotals(withVoucher).value;
+
+  assert.equal(totals.ok, undefined); // No error
+  assert.equal(totals.discount, totals.discount); // Tier discount applied
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals with voucher and line discount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 20 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 }).value;
+  const totals = invoiceTotals(withVoucher).value;
+
+  assert(totals.discount > 0);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals with voucher and VAT', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 }).value;
+  const totals = invoiceTotals(withVoucher).value;
+
+  assert(totals.vat > 0);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('applyVoucher to invoice with multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  }).value;
+
+  const result = applyVoucher(invoice, { code: 'MULTI', amount: 5000 });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher.amount, 5000);
+});
+
+test('applyVoucher preserves voucher through operations', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'SAVE10', amount: 1000 }).value;
+
+  // Verify the voucher is preserved
+  assert.equal(withVoucher.voucher.code, 'SAVE10');
+  assert.equal(withVoucher.voucher.amount, 1000);
+
+  // Verify in invoiceTotals
+  const totals = invoiceTotals(withVoucher).value;
+  assert.equal(totals.voucher, 1000);
+});
