+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement showing outstanding invoices.
+ * @param {string} customerId
+ * @param {Array<{ number?: string, issueDate: string, dueDate: string, total: number, status: string, payments?: Array }>} invoices
+ * @param {string} asOf - Statement cutoff date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists
+  const normalizedId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices: must be issued/partially_paid and issueDate <= asOf
+  const relevantInvoices = invoices.filter(
+    (inv) =>
+      (inv.status === 'issued' || inv.status === 'partially_paid') &&
+      inv.issueDate <= asOf &&
+      inv.number // Only issued invoices have a number
+  );
+
+  // Build statement items with due amounts
+  const statementItems = relevantInvoices
+    .map((inv) => {
+      const totalsResult = invoiceTotals(inv);
+      if (!totalsResult.ok) return null;
+
+      const dueResult = balanceDue(inv);
+      if (!dueResult.ok) return null;
+
+      return {
+        number: inv.number,
+        issueDate: inv.issueDate,
+        dueDate: inv.dueDate,
+        total: totalsResult.value.total,
+        due: dueResult.value,
+      };
+    })
+    .filter(Boolean) // Remove nulls from any errors
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate)); // Sort by issueDate
+
+  // Calculate total due
+  const totalDue = statementItems.reduce((sum, item) => sum + item.due, 0);
+
+  return ok({
+    customerId: normalizedId,
+    invoices: statementItems,
+    totalDue,
+  });
+}
