+  );
+
+  // CN counter should be 0001, not 0004
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote preserves all credit note data', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(
+    issued,
+    { amount: 2500, reason: 'Quality issue', date: '2025-02-01' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.invoiceNumber, issued.number);
+  assert.equal(result.value.amount, 2500);
+  assert.equal(result.value.reason, 'Quality issue');
+  assert.equal(result.value.date, '2025-02-01');
+});
+
+test('createCreditNote with various reasons', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const reasons = [
+    'Customer requested refund',
+    'Product defect',
+    'Duplicate charge',
+    'Promotional discount',
+    '',
+  ];
+
+  for (const reason of reasons) {
+    const result = createCreditNote(
+      issued,
+      { amount: 100, reason, date: '2025-02-20' },
