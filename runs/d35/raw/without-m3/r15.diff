+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(
+    issued,
+    { amount: 1000, reason: 'Discount', date: '2025-02-20' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(typeof result.value.number, 'string');
+  assert(result.value.number.startsWith('CN-'));
+  assert.equal(result.value.invoiceNumber, issued.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 1000);
+  assert.equal(result.value.reason, 'Discount');
+  assert.equal(result.value.date, '2025-02-20');
+});
+
+test('createCreditNote fails on draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const result = createCreditNote(
+    draft,
+    { amount: 1000, reason: 'Discount', date: '2025-02-20' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote works on partially_paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+  const partial = recordPayment(issued, {
+    amount: Math.floor(totals.total / 2),
+    date: '2025-02-16',
+  }).value;
+
+  const result = createCreditNote(
+    partial,
+    { amount: 1000, reason: 'Partial refund', date: '2025-02-20' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, undefined); // Credit notes don't have status
+});
+
+test('createCreditNote works on paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+  const paid = recordPayment(issued, {
+    amount: totals.total,
+    date: '2025-02-16',
+  }).value;
+
+  const result = createCreditNote(
+    paid,
+    { amount: 500, reason: 'Courtesy credit', date: '2025-02-20' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 500);
+});
+
+test('createCreditNote requires positive integer amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const r1 = createCreditNote(
+    issued,
+    { amount: 0, reason: 'Discount', date: '2025-02-20' },
+    []
+  );
+  assert.deepEqual(r1, { ok: false, error: 'AMOUNT_INVALID' });
+
+  const r2 = createCreditNote(
+    issued,
+    { amount: -1000, reason: 'Discount', date: '2025-02-20' },
+    []
+  );
+  assert.deepEqual(r2, { ok: false, error: 'AMOUNT_INVALID' });
+
+  const r3 = createCreditNote(
+    issued,
+    { amount: 100.5, reason: 'Discount', date: '2025-02-20' },
+    []
+  );
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+
+  const r4 = createCreditNote(
+    issued,
+    { amount: 'abc', reason: 'Discount', date: '2025-02-20' },
+    []
+  );
+  assert.deepEqual(r4, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects credit amount higher than invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+
+  const result = createCreditNote(
+    issued,
+    { amount: totals.total + 1, reason: 'Excessive credit', date: '2025-02-20' },
+    []
+  );
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit up to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+
+  const result = createCreditNote(
+    issued,
+    { amount: totals.total, reason: 'Full refund', date: '2025-02-20' },
+    []
+  );
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote generates CN numbers with separate counter', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const r1 = createCreditNote(
+    issued,
+    { amount: 100, reason: 'Reason 1', date: '2025-02-20' },
+    ['INV-2025-0001', 'INV-2025-0002']
+  );
+
+  assert.equal(r1.value.number, 'CN-2025-0001');
+
+  const r2 = createCreditNote(
+    issued,
+    { amount: 100, reason: 'Reason 2', date: '2025-02-20' },
+    ['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001']
+  );
+
+  assert.equal(r2.value.number, 'CN-2025-0002');
+});
+
+test('createCreditNote CN counter restarts each year', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(
+    issued,
+    { amount: 100, reason: 'Reason', date: '2026-02-15' },
+    ['CN-2025-0001', 'CN-2025-0002']
+  );
+
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote ignores invoice numbers for CN counter', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(
+    issued,
+    { amount: 100, reason: 'Reason', date: '2025-02-20' },
