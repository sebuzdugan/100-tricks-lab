+    assert.equal(result.value.reason, reason);
+  }
+});
+
+test('createCreditNote with various amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+
+  const amounts = [1, 100, 1000, totals.total - 1, totals.total];
+
+  for (const amount of amounts) {
+    const result = createCreditNote(
+      issued,
+      { amount, reason: 'Test', date: '2025-02-20' },
+      []
