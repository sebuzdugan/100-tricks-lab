   const paddedCounter = String(nextCounter).padStart(4, '0');
   return `INV-${year}-${paddedCounter}`;
 }
+
+/**
+ * Calculate the next credit note number for a given year.
+ * Format: CN-<year>-<4-digit counter>, counter restarts each year.
+ * @param {string[]} existingNumbers - Array of numbers (both INV and CN) like ["CN-2025-0001"]
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} The next credit note number like "CN-2025-0002"
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  // Extract year from date
+  const year = date.split('-')[0];
+
+  // Find the highest counter for credit notes in this year
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    const match = num.match(/^CN-(\d{4})-(\d{4})$/);
+    if (match && match[1] === year) {
+      const counter = parseInt(match[2], 10);
+      if (counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  // Generate the next number
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `CN-${year}-${paddedCounter}`;
+}
