+
+test('overdueInvoices with mixed statuses', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv2, ['INV-2025-0001']).value;
+  const totals = invoiceTotals(issued).value;
+  const paid = recordPayment(issued, {
+    amount: totals.total,
+    date: '2025-02-20',
+  }).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued3 = issueInvoice(inv3, ['INV-2025-0001', 'INV-2025-0002']).value;
+
+  const result = overdueInvoices(
+    [draft, paid, issued3],
+    '2025-04-15'
+  );
+
+  // Only issued3 should be included
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices with multiple overdue invoices', () => {
+  const invoices = [];
+  const existingNumbers = [];
+  for (let i = 0; i < 5; i++) {
+    const inv = createInvoice({
