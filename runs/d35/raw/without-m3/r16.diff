+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2025-03-15');
+
+  assert.equal(Array.isArray(result), true);
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2025-03-16');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices due on asOf date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  // dueDate is 2025-03-17, asOf is 2025-03-17
+  const result = overdueInvoices([issued], '2025-03-17');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoices overdue by one day', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  // dueDate is 2025-03-17, asOf is 2025-03-18
+  const result = overdueInvoices([issued], '2025-03-18');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices calculates days overdue correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  // dueDate is 2025-01-29, asOf is 2025-02-15 (17 days overdue)
+  const result = overdueInvoices([issued], '2025-02-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 17);
+});
+
+test('overdueInvoices includes invoice fields', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2025-04-15');
+
+  assert.equal(result.length, 1);
+  const item = result[0];
+  assert.equal(typeof item.number, 'string');
+  assert.equal(typeof item.customerId, 'string');
+  assert.equal(typeof item.dueDate, 'string');
+  assert.equal(typeof item.daysOverdue, 'number');
+  assert.equal(typeof item.due, 'number');
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const result = overdueInvoices([draft], '2025-04-15');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+  const paid = recordPayment(issued, {
+    amount: totals.total,
+    date: '2025-02-20',
+  }).value;
+
+  const result = overdueInvoices([paid], '2025-04-15');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+  const partial = recordPayment(issued, {
+    amount: Math.floor(totals.total / 2),
+    date: '2025-02-20',
+  }).value;
+
+  const result = overdueInvoices([partial], '2025-04-15');
+
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices calculates due amount including partial payments', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+  const payment = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued, {
+    amount: payment,
+    date: '2025-02-20',
+  }).value;
+
+  const result = overdueInvoices([partial], '2025-04-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, totals.total - payment);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const invoices = [];
+  const existingNumbers = [];
+
+  const dates = ['2025-01-15', '2025-02-15', '2025-03-01'];
+  for (const date of dates) {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+      terms: 'NET14',
+    }).value;
+
+    const issued = issueInvoice(inv, existingNumbers).value;
+    existingNumbers.push(issued.number);
+    invoices.push(issued);
+  }
+
+  const result = overdueInvoices(invoices, '2025-03-20');
+
+  // All three should be overdue by 2025-03-20
+  assert.equal(result.length, 3);
+  // Verify sorted by daysOverdue descending
+  for (let i = 1; i < result.length; i++) {
+    assert(result[i - 1].daysOverdue >= result[i].daysOverdue);
+  }
+});
+
+test('overdueInvoices preserves invoice number and customer id', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = overdueInvoices([issued], '2025-04-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.number);
+  assert.equal(result[0].customerId, 'C-002');
