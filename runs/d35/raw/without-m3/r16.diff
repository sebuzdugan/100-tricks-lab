+import { daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Find invoices that are overdue as of a given date.
+ * @param {Array<{ status: string, dueDate: string, number: string, customerId: string, payments?: Array }>} invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  // Filter invoices: must be issued/partially_paid and dueDate before asOf
+  const overdue = invoices
+    .filter(
+      (inv) =>
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.dueDate < asOf &&
+        inv.number // Only issued invoices have a number
+    )
+    .map((inv) => {
+      const daysOverdue = daysBetween(inv.dueDate, asOf);
+      const dueResult = balanceDue(inv);
+      const due = dueResult.ok ? dueResult.value : 0;
+
+      return {
+        number: inv.number,
+        customerId: inv.customerId,
+        dueDate: inv.dueDate,
+        daysOverdue,
+        due,
+      };
+    })
+    .sort((a, b) => b.daysOverdue - a.daysOverdue); // Sort by daysOverdue descending
+
+  return overdue;
+}
