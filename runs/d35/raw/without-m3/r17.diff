+/**
+ * Generate a VAT summary across invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  // Map to track VAT by rate
+  const vatByRate = {};
+
+  // Filter invoices: must be issued, partially_paid, or paid
+  const relevantInvoices = invoices.filter(
+    (inv) =>
+      inv.status === 'issued' ||
+      inv.status === 'partially_paid' ||
+      inv.status === 'paid'
+  );
+
+  // Process each invoice and its lines
+  for (const invoice of relevantInvoices) {
+    if (!Array.isArray(invoice.lines)) continue;
+
+    for (const line of invoice.lines) {
+      const { qty, unitPrice, discountPercent = 0, vatRate = 0 } = line;
+
+      // Calculate line total and discount
+      const lineTotal = roundCents(qty * unitPrice);
+      const discount = roundCents(lineTotal * (discountPercent / 100));
+      const base = roundCents(lineTotal - discount);
+
+      // Calculate VAT
+      const vat = roundCents(base * (vatRate / 100));
+
+      // Add to summary by rate
+      if (!vatByRate[vatRate]) {
+        vatByRate[vatRate] = { base: 0, vat: 0 };
+      }
+      vatByRate[vatRate].base += base;
+      vatByRate[vatRate].vat += vat;
+    }
+  }
+
+  // Convert to array and round totals
+  const summary = Object.entries(vatByRate)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseFloat(rate),
+      base: roundCents(base),
+      vat: roundCents(vat),
+    }))
+    .sort((a, b) => b.rate - a.rate); // Sort by rate descending
+
+  return summary;
+}
