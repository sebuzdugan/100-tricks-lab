+/**
+ * Calculate late fee for an invoice: 0.04% per day overdue.
+ * @param {{ status: string, dueDate: string, payments?: Array, lines: Array }} invoice
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  // If invoice is not issued/partially_paid/paid, no fee (e.g., draft invoices)
+  if (
+    invoice.status !== 'issued' &&
+    invoice.status !== 'partially_paid' &&
+    invoice.status !== 'paid'
+  ) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // No fee if not overdue
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  // Get the amount still due
+  const dueResult = balanceDue(invoice);
+  if (!dueResult.ok) {
+    return 0;
+  }
+
+  const due = dueResult.value;
+
+  // Calculate late fee: 0.04% per day
+  // 0.04% = 0.0004
+  const fee = roundCents(due * 0.0004 * daysOverdue);
+
+  return Math.max(0, fee); // Ensure non-negative
+}
