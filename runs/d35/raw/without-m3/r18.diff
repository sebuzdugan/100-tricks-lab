+
+test('lateFee calculates 0.04% per day', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+
+  // dueDate is 2025-03-17 (NET30), check as of 2025-03-18 (1 day overdue)
+  const result = lateFee(issued, '2025-03-18');
+
+  // Fee = total × 0.0004 × 1 day
+  const expected = roundCents(totals.total * 0.0004 * 1);
+  assert.equal(result, expected);
+});
+
+test('lateFee increases with days overdue', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const fee1day = lateFee(issued, '2025-03-18');
+  const fee10days = lateFee(issued, '2025-03-27');
+  const fee30days = lateFee(issued, '2025-04-16');
+
+  assert(fee1day > 0);
+  assert(fee10days > fee1day);
+  assert(fee30days > fee10days);
