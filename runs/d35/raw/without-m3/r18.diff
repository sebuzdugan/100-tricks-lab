+
+test('lateFee on partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+
+  // Record partial payment
+  const payment = Math.floor(totals.total / 2);
+  const partial = recordPayment(issued, {
+    amount: payment,
+    date: '2025-02-20',
+  }).value;
+
+  // Calculate fee on remaining balance
+  const result = lateFee(partial, '2025-03-18');
+
+  // Fee = remaining_balance × 0.0004 × 1 day
+  const remaining = totals.total - payment;
+  const expected = roundCents(remaining * 0.0004 * 1);
+  assert.equal(result, expected);
+});
