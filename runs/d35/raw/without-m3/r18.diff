+// Late Fee tests
+
+test('lateFee returns 0 for draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = lateFee(draft, '2025-04-15');
+
+  assert.equal(result, 0);
+});
+
+test('lateFee returns 0 when invoice is not overdue', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  // dueDate is 2025-03-17 (NET30), check as of 2025-03-16 (not yet due)
+  const result = lateFee(issued, '2025-03-16');
+
+  assert.equal(result, 0);
+});
+
+test('lateFee returns 0 on due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
