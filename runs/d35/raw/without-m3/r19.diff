+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format an amount in cents as a euro string with 2 decimals.
+ * @param {number} cents - Amount in cents
+ * @returns {string} Formatted amount like "1234.50"
+ */
+function formatAmount(cents) {
+  if (typeof cents !== 'number') return '';
+  const euros = (cents / 100).toFixed(2);
+  return euros;
+}
+
+/**
+ * Escape a CSV field: quote if it contains comma or quote, and double any internal quotes.
+ * @param {string} field - The field value
+ * @returns {string} Escaped field
+ */
+function escapeCsvField(field) {
+  if (typeof field !== 'string') field = String(field ?? '');
+
+  // If field contains comma or quote, wrap in quotes and escape internal quotes
+  if (field.includes(',') || field.includes('"')) {
+    return `"${field.replace(/"/g, '""')}"`;
+  }
+
+  return field;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ number: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array }>} invoices
+ * @returns {string} CSV content with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map((invoice) => {
+    // Get customer name
+    let customerName = '';
+    const customerResult = getCustomer(invoice.customerId);
+    if (customerResult.ok) {
+      customerName = customerResult.value.name;
+    }
+
+    // Get totals
+    let subtotal = 0;
+    let discount = 0;
+    let vat = 0;
+    let total = 0;
+    const totalsResult = invoiceTotals(invoice);
+    if (totalsResult.ok) {
+      subtotal = totalsResult.value.subtotal;
+      discount = totalsResult.value.discount;
+      vat = totalsResult.value.vat;
+      total = totalsResult.value.total;
+    }
+
+    // Get due amount
+    let due = 0;
+    const dueResult = balanceDue(invoice);
+    if (dueResult.ok) {
+      due = dueResult.value;
+    }
+
+    // Build CSV line
+    const fields = [
+      invoice.number || '',
+      escapeCsvField(customerName),
+      invoice.issueDate || '',
+      invoice.dueDate || '',
+      invoice.status || '',
+      formatAmount(subtotal),
+      formatAmount(discount),
+      formatAmount(vat),
+      formatAmount(total),
+      formatAmount(due),
+    ];
+
+    return fields.join(',') + '\n';
+  });
+
+  return header + lines.join('');
+}
