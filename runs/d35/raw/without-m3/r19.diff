+test('exportCsv preserves invoice order', () => {
+  const invoices = [];
+  const existingNumbers = [];
+
+  for (let i = 1; i <= 3; i++) {
+    const inv = createInvoice({
+      customerId: `C-00${i}`,
+      issueDate: `2025-02-${10 + i}`,
+      lines: [{ sku: 'DEV-HOUR', qty: i }],
+    }).value;
+
+    const issued = issueInvoice(inv, existingNumbers).value;
+    existingNumbers.push(issued.number);
+    invoices.push(issued);
+  }
+
+  const result = exportCsv(invoices);
+
+  const lines = result.split('\n');
+  // Verify order is preserved by checking invoice numbers
+  assert(lines[1].includes(invoices[0].number));
+  assert(lines[2].includes(invoices[1].number));
+  assert(lines[3].includes(invoices[2].number));
+});
