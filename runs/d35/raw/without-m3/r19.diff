+test('exportCsv with partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+  const partial = recordPayment(issued, {
+    amount: Math.floor(totals.total / 2),
+    date: '2025-02-16',
+  }).value;
+
+  const result = exportCsv([partial]);
+
+  assert(result.includes('partially_paid'));
+  // Due should be half the total
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const due = parseFloat(parts[parts.length - 1]);
+  const total = parseFloat(parts[parts.length - 2]);
+  assert(due < total);
+  assert(due > 0);
+});
+
+test('exportCsv with paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued).value;
+  const paid = recordPayment(issued, {
+    amount: totals.total,
+    date: '2025-02-16',
+  }).value;
+
+  const result = exportCsv([paid]);
+
+  assert(result.includes('paid'));
+  // Due should be 0
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  const parts = dataLine.split(',');
+  const due = parseFloat(parts[parts.length - 1]);
+  assert.equal(due, 0);
+});
