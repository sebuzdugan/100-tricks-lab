+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv with empty invoice list', () => {
+  const result = exportCsv([]);
+
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines.length, 2); // Header + empty line at end
+});
+
+test('exportCsv includes header', () => {
+  const result = exportCsv([]);
+
+  assert(result.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv with single invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3); // Header + 1 invoice + empty line
+  assert(lines[1].includes(issued.number));
+  assert(lines[1].includes('Northwind Studio')); // C-001 is Northwind Studio
+});
+
+test('exportCsv includes invoice number', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = exportCsv([issued]);
+
+  assert(result.includes(issued.number));
+});
+
+test('exportCsv includes customer name', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = exportCsv([issued]);
+
+  assert(result.includes('Blue Fern Bakery')); // C-002 is Blue Fern Bakery
+});
+
