+
+test('formatMoney EUR', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+  assert.equal(formatMoney(5, 'EUR'), '€0.05');
+});
+
+test('formatMoney with negative amount', () => {
+  assert.equal(formatMoney(-123456, 'USD'), '-$1,234.56');
+  assert.equal(formatMoney(-5, 'GBP'), '-£0.05');
+});
+
+test('formatMoney with unknown currency', () => {
+  assert.equal(formatMoney(123456, 'JPY'), '');
+});
+
+test('formatMoney large amount', () => {
+  assert.equal(formatMoney(100000000, 'USD'), '$1,000,000.00');
+});
+
+test('formatMoney zero', () => {
+  assert.equal(formatMoney(0, 'USD'), '$0.00');
+});
+
+test('convert and format workflow', () => {
+  // Convert 100 EUR to USD and format
+  const convertResult = convert(10000, 'USD');
+  assert.equal(convertResult.ok, true);
+
+  const formatted = formatMoney(convertResult.value, 'USD');
+  assert(formatted.startsWith('$'));
+  assert(formatted.includes('.'));
+});
+
+test('convert maintains precision', () => {
+  const result = convert(12345, 'USD');
+
+  assert.equal(result.ok, true);
+  // 12345 * 1.085 = 13384.125, rounds to 13384
+  assert(result.value > 0);
+});
+
+test('formatMoney with thousands separators', () => {
+  assert(formatMoney(1000000, 'USD').includes(','));
+  assert(formatMoney(9999, 'USD').includes('.'));
+  assert(!formatMoney(999, 'USD').includes(','));
+});
+
+test('convert returns integer cents', () => {
+  const result = convert(100, 'GBP');
+
+  assert.equal(result.ok, true);
+  assert(Number.isInteger(result.value));
+});
+
+test('formatMoney padding', () => {
