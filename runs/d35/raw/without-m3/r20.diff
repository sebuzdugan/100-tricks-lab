+
+// Currency tests
+
+test('RATES has EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(10000, 'USD');
+
+  assert.equal(result.ok, true);
+  // 10000 EUR cents * 1.085 = 10850 USD cents
+  assert.equal(result.value, 10850);
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(10000, 'GBP');
+
+  assert.equal(result.ok, true);
+  // 10000 EUR cents * 0.8425 = 8425 GBP cents
+  assert.equal(result.value, 8425);
+});
+
+test('convert EUR to EUR', () => {
+  const result = convert(10000, 'EUR');
+
+  assert.equal(result.ok, true);
+  // 10000 EUR cents * 1 = 10000 EUR cents
+  assert.equal(result.value, 10000);
+});
+
+test('convert unknown currency', () => {
+  const result = convert(10000, 'JPY');
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('convert with rounding', () => {
+  const result = convert(100, 'USD');
+
+  // 100 * 1.085 = 108.5 -> 108 or 109 (banker's rounding)
+  assert.equal(result.ok, true);
+  assert(result.value === 108 || result.value === 109); // Banker's rounding
+});
+
+test('convert small amount', () => {
+  const result = convert(1, 'USD');
+
+  assert.equal(result.ok, true);
+  // 1 * 1.085 = 1.085, rounds to 1
+  assert.equal(result.value, 1);
+});
+
+test('convert large amount', () => {
+  const result = convert(1000000, 'USD');
+
+  assert.equal(result.ok, true);
+  // 1000000 * 1.085 = 1085000
+  assert.equal(result.value, 1085000);
+});
+
+test('formatMoney USD', () => {
+  assert.equal(formatMoney(123456, 'USD'), '$1,234.56');
+  assert.equal(formatMoney(5, 'USD'), '$0.05');
+  assert.equal(formatMoney(100, 'USD'), '$1.00');
+});
+
+test('formatMoney GBP', () => {
+  assert.equal(formatMoney(123456, 'GBP'), '£1,234.56');
+  assert.equal(formatMoney(5, 'GBP'), '£0.05');
+  assert.equal(formatMoney(100, 'GBP'), '£1.00');
