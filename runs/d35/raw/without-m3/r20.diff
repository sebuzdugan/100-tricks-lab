   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Exchange rates: units of each currency per euro.
+ * 1 EUR = 1.085 USD = 0.8425 GBP
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert an amount in EUR cents to another currency's cents.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const convertedCents = roundCents(cents * rate);
+
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents as money for a currency: 123456 USD -> "$1,234.56", 100 GBP -> "£1.00".
+ * @param {number} cents - Amount in cents of the target currency
+ * @param {string} currency - Currency (EUR, USD, GBP)
+ * @returns {string} Formatted amount or empty string if currency unknown
+ */
+export function formatMoney(cents, currency) {
+  const currencySymbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  if (!(currency in currencySymbols)) {
+    return '';
+  }
+
+  const symbol = currencySymbols[currency];
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+
+  return `${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
