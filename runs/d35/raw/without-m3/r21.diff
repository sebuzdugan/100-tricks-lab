+
+/**
+ * Merge a duplicate customer into another customer.
+ * @param {Array<{ id: string, name: string, email: string, tier: string }>} customers - List of all customers
+ * @param {Array<{ customerId: string, [key: string]: any }>} invoices - List of all invoices
+ * @param {string} fromId - Customer ID to merge from (will be deleted)
+ * @param {string} intoId - Customer ID to merge into (will retain all invoices)
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  // Normalize IDs
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  // Check they're different
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  // Check both customers exist
+  const fromExists = customers.some((c) => c.id === normalizedFromId);
+  const intoExists = customers.some((c) => c.id === normalizedIntoId);
+
+  if (!fromExists || !intoExists) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Remove fromId customer and update all its invoices to intoId
+  const mergedCustomers = customers.filter((c) => c.id !== normalizedFromId);
+  const mergedInvoices = invoices.map((inv) => ({
+    ...inv,
+    customerId: inv.customerId === normalizedFromId ? normalizedIntoId : inv.customerId,
+  }));
+
+  return ok({
+    customers: mergedCustomers,
+    invoices: mergedInvoices,
+  });
+}
