+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices.filter((inv) => inv.customerId === 'C-002').length, 3);
+  assert.equal(result.value.invoices.filter((inv) => inv.customerId === 'C-001').length, 0);
+});
