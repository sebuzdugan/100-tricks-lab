diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..c007c62
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,107 @@
+import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line: qty * unitPrice.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineTotal(line) {
+  if (!line || typeof line !== 'object') return fail('LINE_INVALID');
+  const { qty, unitPrice } = line;
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+  if (!Number.isInteger(unitPrice) || unitPrice < 0) return fail('LINE_INVALID');
+
+  return ok(roundCents(qty * unitPrice));
+}
+
+/**
+ * Calculate the discount for a single line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineDiscount(line) {
+  if (!line || typeof line !== 'object') return fail('LINE_INVALID');
+
+  // Validate discountPercent
+  const discountPercent = line.discountPercent ?? 0;
+  if (typeof discountPercent !== 'number' || discountPercent < 0 || discountPercent > 100) {
+    return fail('DISCOUNT_INVALID');
+  }
+
+  // Get line total
+  const lineTotalResult = lineTotal(line);
+  if (!lineTotalResult.ok) return lineTotalResult;
+
+  // Calculate discount
+  const discount = roundCents(lineTotalResult.value * (discountPercent / 100));
+  return ok(Math.max(0, discount)); // Clamp to 0
+}
+
+/**
+ * Calculate the VAT for a single line (on amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineVAT(line) {
+  if (!line || typeof line !== 'object') return fail('LINE_INVALID');
+
+  // Get line total
+  const lineTotalResult = lineTotal(line);
+  if (!lineTotalResult.ok) return lineTotalResult;
+
+  // Get line discount
+  const discountResult = lineDiscount(line);
+  if (!discountResult.ok) return discountResult;
+
+  // Calculate amount after discount
+  const amountAfterDiscount = lineTotalResult.value - discountResult.value;
+
+  // Get VAT rate
+  const vatRate = line.vatRate ?? 0;
+
+  // Calculate VAT
+  const vat = roundCents(amountAfterDiscount * (vatRate / 100));
+  return ok(Math.max(0, vat)); // Clamp to 0
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, voucher: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || typeof invoice !== 'object') return fail('INVOICE_INVALID');
+  if (!Array.isArray(invoice.lines) || invoice.lines.length === 0) return fail('NO_LINES');
+
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+  for (const line of invoice.lines) {
+    const lineResult = lineTotal(line);
+    if (!lineResult.ok) return lineResult;
+    subtotal += lineResult.value;
+
+    const discountResult = lineDiscount(line);
+    if (!discountResult.ok) return discountResult;
+    discount += discountResult.value;
+
+    const vatResult = lineVAT(line);
+    if (!vatResult.ok) return vatResult;
+    vat += vatResult.value;
+  }
+
+  subtotal = roundCents(subtotal);
+  discount = roundCents(discount);
+  vat = roundCents(vat);
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, roundCents(subtotal - discount + vat - voucher)); // Clamp to 0
+
+  return ok({
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  });
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..a77685b
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,244 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+// lineTotal tests
+
+test('lineTotal calculates qty * unitPrice', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  const result = lineTotal(line);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 95000);
+});
+
+test('lineTotal with qty of 1', () => {
+  const line = { qty: 1, unitPrice: 5000 };
+  const result = lineTotal(line);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 5000);
+});
+
+test('lineTotal with zero unitPrice', () => {
+  const line = { qty: 10, unitPrice: 0 };
+  const result = lineTotal(line);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('lineTotal requires positive quantity', () => {
+  const result = lineTotal({ qty: 0, unitPrice: 5000 });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('lineTotal requires non-negative integer unitPrice', () => {
+  const result = lineTotal({ qty: 10, unitPrice: -1000 });
+  assert.deepEqual(result, { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineTotal rejects non-object input', () => {
+  const result = lineTotal(null);
+  assert.deepEqual(result, { ok: false, error: 'LINE_INVALID' });
+});
+
+// lineDiscount tests
+
+test('lineDiscount calculates discount amount', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 10 };
+  const result = lineDiscount(line);
+
+  assert.equal(result.ok, true);
+  // 10 × 9500 = 95000, discount = 95000 × 10% = 9500
+  assert.equal(result.value, 9500);
+});
+
+test('lineDiscount with no discount', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  const result = lineDiscount(line);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('lineDiscount with decimal discountPercent', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 2.5 };
+  const result = lineDiscount(line);
+
+  assert.equal(result.ok, true);
+  // 95000 × 2.5% = 2375
+  assert.equal(result.value, 2375);
+});
+
+test('lineDiscount clamps to 0', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 10 };
+  const result = lineDiscount(line);
+
+  assert(result.value >= 0);
+});
+
+test('lineDiscount validates discountPercent', () => {
+  const result = lineDiscount({ qty: 10, unitPrice: 9500, discountPercent: 150 });
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+// lineVAT tests
+
+test('lineVAT calculates VAT on amount after discount', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 };
+  const result = lineVAT(line);
+
+  assert.equal(result.ok, true);
+  // 95000 - (95000 × 10%) = 85500
+  // VAT = 85500 × 21% = 17955
+  assert.equal(result.value, 17955);
+});
+
+test('lineVAT with zero VAT rate', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 0 };
+  const result = lineVAT(line);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('lineVAT without discount', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21 };
+  const result = lineVAT(line);
+
+  assert.equal(result.ok, true);
+  // VAT = 95000 × 21% = 19950
+  assert.equal(result.value, 19950);
+});
+
+test('lineVAT clamps to 0', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21 };
+  const result = lineVAT(line);
+
+  assert(result.value >= 0);
+});
+
+// invoiceTotals tests
+
+test('invoiceTotals calculates subtotal from all lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500 },
+      { qty: 100, unitPrice: 50 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  // 10 × 9500 + 100 × 50 = 95000 + 5000 = 100000
+  assert.equal(result.value.subtotal, 100000);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 95000);
+});
+
+test('invoiceTotals returns total = subtotal + vat when no discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.discount, 0);
+  // total = 95000 + (95000 × 21%) = 95000 + 19950 = 114950
+  assert.equal(result.value.total, 114950);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert(result.value.discount > 0);
+  assert(result.value.vat > 0);
+});
+
+test('invoiceTotals rejects non-object invoice', () => {
+  const result = invoiceTotals(null);
+  assert.deepEqual(result, { ok: false, error: 'INVOICE_INVALID' });
+});
+
+test('invoiceTotals requires non-empty lines', () => {
+  const result = invoiceTotals({ lines: [] });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('invoiceTotals reports invalid line', () => {
+  const invoice = {
+    lines: [{ qty: 0, unitPrice: 9500 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'QTY_INVALID');
+});
+
+test('invoiceTotals with large numbers', () => {
+  const invoice = {
+    lines: [{ qty: 1000000, unitPrice: 9500 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 9500000000);
+});
+
+test('invoiceTotals does not mutate the invoice', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500 }],
+  };
+  const originalLine = { ...invoice.lines[0] };
+
+  invoiceTotals(invoice);
+
+  assert.deepEqual(invoice.lines[0], originalLine);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 1000 },
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher, 1000);
+  // total = 95000 + 19950 - 1000 = 113950
+  assert.equal(result.value.total, 113950);
+});
+
+test('invoiceTotals without voucher shows 0 voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500 }],
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher, 0);
+});
+
+test('invoiceTotals clamps total to 0', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50 }],
+    voucher: { code: 'HUGE', amount: 100000 },
+  };
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.total, 0);
+});
