--- a/src/totals.js
+++ b/src/totals.js
@@ -16,7 +16,7 @@ export function lineTotal(line) {
 }
 
 /**
- * Calculate the discount for a single line.
+ * Calculate the discount for a single line (includes bulk discount if qty >= 10).
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {{ ok: true, value: number } | { ok: false, error: string }}
  */
@@ -33,9 +33,21 @@ export function lineDiscount(line) {
   const lineTotalResult = lineTotal(line);
   if (!lineTotalResult.ok) return lineTotalResult;
 
-  // Calculate discount
-  const discount = roundCents(lineTotalResult.value * (discountPercent / 100));
-  return ok(Math.max(0, discount)); // Clamp to 0
+  const lineAmount = lineTotalResult.value;
+
+  // Calculate first discount (explicit or tier discount)
+  const firstDiscount = roundCents(lineAmount * (discountPercent / 100));
+
+  // Calculate bulk discount (2.5% on what remains if qty >= 10)
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const amountAfterFirstDiscount = lineAmount - firstDiscount;
+    bulkDiscount = roundCents(amountAfterFirstDiscount * 0.025);
+  }
+
+  // Total discount is sum of both
+  const totalDiscount = roundCents(firstDiscount + bulkDiscount);
+  return ok(Math.max(0, totalDiscount)); // Clamp to 0
 }
 
