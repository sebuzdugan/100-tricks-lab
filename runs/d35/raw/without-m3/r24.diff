@@ -126,3 +126,72 @@ export function lateFee(invoice, asOf) {
 
   return Math.max(0, fee); // Ensure non-negative
 }
+
+/**
+ * Generate a dashboard summary of invoices.
+ * @param {Array<{ status: string, dueDate: string, number: string, customerId: string, payments?: Array, lines: Array }>} invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = {}; // Track due amount by customer
+
+  for (const invoice of invoices) {
+    const status = invoice.status || 'draft';
+    if (status in counts) {
+      counts[status]++;
+    }
+
+    // Calculate outstanding (issued or partially_paid invoices still owed)
+    if (status === 'issued' || status === 'partially_paid') {
+      const dueResult = balanceDue(invoice);
+      if (dueResult.ok) {
+        outstanding += dueResult.value;
+        // Track customer due amounts
+        const customerId = invoice.customerId;
+        if (!customerDue[customerId]) {
+          customerDue[customerId] = 0;
+        }
+        customerDue[customerId] += dueResult.value;
+      }
+    }
+  }
+
+  outstanding = roundCents(outstanding);
+
+  // Get overdue invoices and calculate overdue totals
+  const overdue = overdueInvoices(invoices, asOf);
+  let overdueAmount = 0;
+  for (const inv of overdue) {
+    overdueAmount += inv.due;
+  }
+  overdueAmount = roundCents(overdueAmount);
+
+  // Get top 3 customers by due amount
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({
+      customerId,
+      due: roundCents(due),
+    }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
