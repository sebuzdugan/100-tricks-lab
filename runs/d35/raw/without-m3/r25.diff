 export function renderInvoiceText(invoice) {
@@ -30,11 +30,10 @@ export function renderInvoiceText(invoice) {
     if (lineTotalResult.ok) {
       lineTextParts.push(`= ${formatEuros(lineTotalResult.value)}`);
 
-      // Add discount if present
-      const discountPercent = line.discountPercent ?? 0;
-      if (discountPercent > 0) {
-        const discountAmount = Math.max(0, Math.round(lineTotalResult.value * (discountPercent / 100)));
-        lineTextParts.push(`(${discountPercent}% off: −${formatEuros(discountAmount)})`);
+      // Add discount if present (includes bulk discount)
+      const discountResult = lineDiscount(line);
+      if (discountResult.ok && discountResult.value > 0) {
+        lineTextParts.push(`(−${formatEuros(discountResult.value)})`);
       }
     }
 
@@ -51,8 +50,22 @@ export function renderInvoiceText(invoice) {
     if (totalsResult.value.vat > 0) {
       lines.push(`VAT: ${formatEuros(totalsResult.value.vat)}`);
     }
+    if (totalsResult.value.voucher > 0) {
+      lines.push(`Voucher: −${formatEuros(totalsResult.value.voucher)}`);
+    }
     lines.push(`Total: ${formatEuros(totalsResult.value.total)}`);
   }
 
+  // Add due date if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Add paid amount if payments exist
+  if (Array.isArray(invoice.payments) && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
