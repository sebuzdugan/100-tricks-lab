 /**
  * Render an invoice as plain text.
  * Amounts are formatted using formatEuros().
- * @param {{ number?: string, customerId: string, lines: Array }} invoice
+ * @param {{ number?: string, customerId: string, issueDate?: string, dueDate?: string, lines: Array, voucher?: { code: string, amount: number }, payments?: Array }} invoice
  * @returns {string}
