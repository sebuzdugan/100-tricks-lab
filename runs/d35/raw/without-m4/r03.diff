+/**
+ * Add a line to a draft invoice, or increase qty if SKU already exists.
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {{ sku: string, qty: number }} line
+ * @returns {{ ok: true, value: { status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> } } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+  const existingLineIndex = newLines.findIndex((line) => line.sku === sku);
+
+  if (existingLineIndex !== -1) {
+    newLines[existingLineIndex].qty += qty;
+  } else {
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from a draft invoice by SKU.
+ * @param {{ status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: { status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> } } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
