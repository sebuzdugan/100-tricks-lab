diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..d861876
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,38 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates first number for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for existing year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2026-10-15');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0999', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-12-25');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0500'];
+  const number = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber handles unsorted existing numbers', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0100');
+});
