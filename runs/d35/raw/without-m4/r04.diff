--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,17 @@
+/**
+ * Get the next invoice number for a given issue date.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (e.g., ['INV-2026-0001', 'INV-2026-0005'])
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - Next invoice number (e.g., 'INV-2026-0006')
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const thisYearNumbers = existingNumbers.filter((num) => num.startsWith(prefix));
+  if (thisYearNumbers.length === 0) return `${prefix}0001`;
+
+  const counters = thisYearNumbers.map((num) => parseInt(num.substring(prefix.length), 10));
+  const maxCounter = Math.max(...counters);
+  return `${prefix}${String(maxCounter + 1).padStart(4, '0')}`;
+}
