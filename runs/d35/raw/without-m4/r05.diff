+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  lines.push(invoice.number ?? 'DRAFT');
+  lines.push(invoice.customerId);
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const unitPriceFormatted = formatEuros(line.unitPrice);
+    const totalFormatted = formatEuros(total);
+    lines.push(`${line.qty} × ${line.name} @ ${unitPriceFormatted} = ${totalFormatted}`);
+  }
+
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
