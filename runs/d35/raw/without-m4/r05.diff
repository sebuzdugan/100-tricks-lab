+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for invoice without number', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('DRAFT\n'));
+});
+
+test('renderInvoiceText shows invoice number when present', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('INV-2026-0001\n'));
+});
+
+test('renderInvoiceText shows customer ID on second line', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'C-001');
+});
+
+test('renderInvoiceText shows single line item with formatted amounts', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '5 × Design work (hour) @ €85.00 = €425.00');
+});
+
+test('renderInvoiceText shows multiple line items', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '5 × Design work (hour) @ €85.00 = €425.00');
+  assert.equal(lines[3], '10 × Development (hour) @ €95.00 = €950.00');
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[4], 'Total: €1,375.00');
+});
+
+test('renderInvoiceText formats unit prices correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'STICKER', name: 'Sticker sheet', qty: 100, unitPrice: 50, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '100 × Sticker sheet @ €0.50 = €50.00');
+});
+
+test('renderInvoiceText handles small amounts correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 1, unitPrice: 980, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '1 × Icon set (24 icons) @ €9.80 = €9.80');
+});
+
+test('renderInvoiceText handles large amounts correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'LOGO-PACK', name: 'Logo package', qty: 2, unitPrice: 120000, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '2 × Logo package @ €1,200.00 = €2,400.00');
+});
+
+test('renderInvoiceText output is readable as a table', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'PRINT-A4', name: 'Printed flyer A4 (each)', qty: 100, unitPrice: 37, vatRate: 9 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const expectedLines = [
+    'INV-2026-0001',
+    'C-003',
+    '5 × Design work (hour) @ €85.00 = €425.00',
+    '100 × Printed flyer A4 (each) @ €0.37 = €37.00',
+    'Total: €462.00',
+  ];
+  assert.equal(text, expectedLines.join('\n'));
+});
