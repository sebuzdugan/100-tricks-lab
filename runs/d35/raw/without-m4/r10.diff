+/**
+ * Validate a date string in YYYY-MM-DD format and ensure it's a real date.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  const parts = text.split('-');
+  return (
+    date instanceof Date &&
+    !isNaN(date) &&
+    date.getUTCFullYear() === parseInt(parts[0], 10) &&
+    date.getUTCMonth() === parseInt(parts[1], 10) - 1 &&
+    date.getUTCDate() === parseInt(parts[2], 10)
+  );
+}
+
+/**
+ * Add n days to a date, working in UTC.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - New date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  const year = d.getUTCFullYear();
+  const month = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate the number of whole days between two dates (b minus a), in UTC.
+ * @param {string} a - Earlier date in YYYY-MM-DD format
+ * @param {string} b - Later date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const ms = dateB.getTime() - dateA.getTime();
+  return Math.floor(ms / (24 * 60 * 60 * 1000));
+}
