@@ -0,0 +1,196 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue calculates amount still owed', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const owed = balanceDue(invoice);
+  assert.ok(owed > 0);
+});
+
+test('balanceDue with no payments returns full total', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const totals = invoice.lines.reduce((sum, line) => sum + line.qty * line.unitPrice, 0);
+  const owed = balanceDue(invoice);
+  assert.ok(owed > 0);
+});
+
+test('balanceDue with payments', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const invoice2 = recordPayment(invoice, { amount: 2000, date: '2026-10-10' }).value;
+  const owed = balanceDue(invoice2);
+  assert.ok(owed > 0);
+});
+
+test('recordPayment adds payment to invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const r2 = recordPayment(invoice, { amount: 1000, date: '2026-10-10' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.payments.length, 1);
+  assert.equal(r2.value.payments[0].amount, 1000);
+  assert.equal(r2.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment sets status to partially_paid', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const r2 = recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const owed = balanceDue(invoice);
+  const r2 = recordPayment(invoice, { amount: owed, date: '2026-10-10' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'paid');
+});
+
+test('recordPayment accumulates payments', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const r2 = recordPayment(invoice, { amount: 1500, date: '2026-10-10' }).value;
+  const owed = balanceDue(r2);
+  const r3 = recordPayment(r2, { amount: Math.min(1500, owed), date: '2026-10-15' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 2);
+});
+
+test('recordPayment rejects non-issued invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = r.value;
+  assert.deepEqual(recordPayment(invoice, { amount: 1000, date: '2026-10-10' }), {
+    ok: false,
+    error: 'NOT_ISSUED',
+  });
+});
+
+test('recordPayment rejects invalid amount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  assert.deepEqual(recordPayment(invoice, { amount: 0, date: '2026-10-10' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  assert.deepEqual(recordPayment(invoice, { amount: 99.99, date: '2026-10-10' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  assert.deepEqual(recordPayment(invoice, { amount: 999999999, date: '2026-10-10' }), {
+    ok: false,
+    error: 'OVERPAYMENT',
+  });
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const r2 = recordPayment(invoice, { amount: 1500, date: '2026-10-10' }).value;
+  assert.equal(r2.status, 'partially_paid');
+  const owed = balanceDue(r2);
+  const r3 = recordPayment(r2, { amount: owed, date: '2026-10-15' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'paid');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const originalPayments = invoice.payments ? [...invoice.payments] : [];
+  recordPayment(invoice, { amount: 1000, date: '2026-10-10' });
+  assert.deepEqual(invoice.payments ?? [], originalPayments);
+});
+
+test('recordPayment rejects negative amount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  assert.deepEqual(recordPayment(invoice, { amount: -1000, date: '2026-10-10' }), {
+    ok: false,
+    error: 'AMOUNT_INVALID',
+  });
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const invoice = issueInvoice(r.value, []).value;
+  const owed = balanceDue(invoice);
+  const r2 = recordPayment(invoice, { amount: owed, date: '2026-10-10' }).value;
+  assert.equal(balanceDue(r2), 0);
+});
