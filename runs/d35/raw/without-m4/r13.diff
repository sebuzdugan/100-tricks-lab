+test('applyVoucher adds voucher to draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = applyVoucher(r.value, { code: 'SUMMER2026', amount: 5000 });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.voucher.code, 'SUMMER2026');
+  assert.equal(r2.value.voucher.amount, 5000);
+});
+
