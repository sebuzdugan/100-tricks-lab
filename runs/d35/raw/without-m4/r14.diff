+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns empty for customer with no invoices', () => {
+  const r = statement('C-001', [], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes issued invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+  const r = statement('C-001', [issued], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+  const partial = recordPayment(issued, { amount: 1000, date: '2026-10-10' }).value;
+  const r = statement('C-001', [partial], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.ok(r.value.invoices[0].due > 0);
+});
+
+test('statement excludes draft invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const r = statement('C-001', [inv1.value], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+  const due = balanceDue(issued);
+  const paid = recordPayment(issued, { amount: due, date: '2026-10-10' }).value;
+  const r = statement('C-001', [paid], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+  const r = statement('C-001', [issued], '2026-12-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement includes invoices on asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-10',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+  const r = statement('C-001', [issued], '2026-12-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement filters by customerId', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+  const issued2 = issueInvoice(inv2.value, []).value;
+  const r = statement('C-001', [issued1, issued2], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement includes invoice number', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv1.value, ['INV-2026-0001']).value;
+  const r = statement('C-001', [issued], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0002');
+});
+
+test('statement calculates due correctly', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+  const r = statement('C-001', [issued], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].due, r.value.invoices[0].total);
+});
+
+test('statement calculates totalDue as sum of all due', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+  const issued2 = issueInvoice(inv2.value, []).value;
+  const r = statement('C-001', [issued1, issued2], '2026-12-31');
+  assert.equal(r.ok, true);
+  const expected = r.value.invoices[0].due + r.value.invoices[1].due;
+  assert.equal(r.value.totalDue, expected);
+});
+
+test('statement sorts by issueDate', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+  const issued2 = issueInvoice(inv2.value, []).value;
+  const r = statement('C-001', [issued1, issued2], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-15');
+});
+
+test('statement normalizes customer ID', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+  const r = statement('c-001', [issued], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement rejects unknown customer', () => {
+  assert.deepEqual(statement('C-999', [], '2026-12-31'), {
+    ok: false,
+    error: 'CUSTOMER_NOT_FOUND',
+  });
+});
+
+test('statement includes dueDate from invoice', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+  const r = statement('C-001', [issued], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].dueDate, '2026-10-21');
+});
+
+test('statement with partial payment reduces due', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv1.value, []).value;
+  const partial = recordPayment(issued, { amount: 2000, date: '2026-10-10' }).value;
+  const r = statement('C-001', [partial], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.ok(r.value.invoices[0].due < r.value.invoices[0].total);
+});
