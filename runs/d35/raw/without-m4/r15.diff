diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..d5ccbdd
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,186 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const r = createCreditNote(issued, { amount: 1000, reason: 'Defective product', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, issued.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 1000);
+  assert.equal(r.value.reason, 'Defective product');
+  assert.equal(r.value.date, '2026-10-15');
+});
+
+test('createCreditNote accepts partially_paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const partial = recordPayment(issued, { amount: 1000, date: '2026-10-10' }).value;
+  const r = createCreditNote(partial, { amount: 500, reason: 'Discount', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote accepts paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const due = balanceDue(issued);
+  const paid = recordPayment(issued, { amount: due, date: '2026-10-10' }).value;
+  const r = createCreditNote(paid, { amount: 500, reason: 'Discount', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  assert.deepEqual(
+    createCreditNote(inv.value, { amount: 500, reason: 'Discount', date: '2026-10-15' }, []),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('createCreditNote rejects invalid amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  assert.deepEqual(
+    createCreditNote(issued, { amount: 0, reason: 'Discount', date: '2026-10-15' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  assert.deepEqual(
+    createCreditNote(issued, { amount: 99.99, reason: 'Discount', date: '2026-10-15' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  assert.deepEqual(
+    createCreditNote(issued, { amount: 999999999, reason: 'Discount', date: '2026-10-15' }, []),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
+
+test('createCreditNote numbering separate from invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, ['INV-2026-0001']).value;
+  const r = createCreditNote(issued, { amount: 500, reason: 'Discount', date: '2026-10-15' }, ['INV-2026-0001']);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote increments credit note counter', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+  const cn1 = createCreditNote(issued1, { amount: 500, reason: 'Discount', date: '2026-10-15' }, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued2 = issueInvoice(inv2.value, []).value;
+  const cn2 = createCreditNote(issued2, { amount: 500, reason: 'Discount', date: '2026-10-15' }, [cn1.number]).value;
+
+  assert.equal(cn1.number, 'CN-2026-0001');
+  assert.equal(cn2.number, 'CN-2026-0002');
+});
+
+test('createCreditNote with different years separate counters', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+  const cn1 = createCreditNote(issued1, { amount: 500, reason: 'Discount', date: '2026-10-15' }, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-01-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued2 = issueInvoice(inv2.value, []).value;
+  const cn2 = createCreditNote(issued2, { amount: 500, reason: 'Discount', date: '2027-01-20' }, [cn1.number]).value;
+
+  assert.equal(cn1.number, 'CN-2026-0001');
+  assert.equal(cn2.number, 'CN-2027-0001');
+});
+
+test('createCreditNote allows amount equal to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const total = invoiceTotals(issued).total;
+  const r = createCreditNote(issued, { amount: total, reason: 'Full refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote preserves invoice number', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, ['INV-2026-0098']).value;
+  const r = createCreditNote(issued, { amount: 500, reason: 'Discount', date: '2026-10-15' }, ['INV-2026-0098']).value;
+  assert.equal(r.invoiceNumber, issued.number);
+});
+
+test('createCreditNote preserves customer ID', () => {
+  const inv = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const r = createCreditNote(issued, { amount: 500, reason: 'Discount', date: '2026-10-15' }, []).value;
+  assert.equal(r.customerId, 'C-005');
+});
