+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the next credit note number.
+ * @param {string[]} existingNumbers - Array of all numbers (both INV-... and CN-...)
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+  const prefix = `CN-${year}-`;
+
+  const thisCreditNotes = existingNumbers.filter((num) => num.startsWith(prefix));
+  if (thisCreditNotes.length === 0) return `${prefix}0001`;
+
+  const counters = thisCreditNotes.map((num) => parseInt(num.substring(prefix.length), 10));
+  const maxCounter = Math.max(...counters);
+  return `${prefix}${String(maxCounter + 1).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an invoice.
+ * @param {{ number: string, customerId: string, status: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {string[]} existingNumbers - Array of all existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status === 'draft') return fail('NOT_ISSUED');
+
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  const invoiceTotal = invoiceTotals(invoice).total;
+  if (amount > invoiceTotal) return fail('CREDIT_TOO_HIGH');
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
