+import { daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a list of overdue invoices.
+ * @param {Array<{ number: string, customerId: string, dueDate?: string, status: string, payments?: Array, lines: Array, voucher?: object }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format (report as of this date)
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = invoices
+    .filter((inv) => (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate && inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
diff --git a/test/reports.test.js b/test/reports.test.js
