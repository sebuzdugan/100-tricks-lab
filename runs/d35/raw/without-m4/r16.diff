+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns empty when no invoices', () => {
+  const result = overdueInvoices([], '2026-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty when no overdue invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const result = overdueInvoices([issued], '2026-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes invoice overdue by one day', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const result = overdueInvoices([issued], '2026-10-22');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices includes issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const result = overdueInvoices([issued], '2026-10-25');
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const partial = recordPayment(issued, { amount: 1000, date: '2026-10-10' }).value;
+  const result = overdueInvoices([partial], '2026-10-25');
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const result = overdueInvoices([inv.value], '2026-10-25');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const due = balanceDue(issued);
+  const paid = recordPayment(issued, { amount: due, date: '2026-10-10' }).value;
+  const result = overdueInvoices([paid], '2026-10-25');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes number', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const result = overdueInvoices([issued], '2026-10-25');
+  assert.equal(result[0].number, issued.number);
+});
+
+test('overdueInvoices includes customerId', () => {
+  const inv = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const result = overdueInvoices([issued], '2026-10-25');
+  assert.equal(result[0].customerId, 'C-005');
+});
+
+test('overdueInvoices includes dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const result = overdueInvoices([issued], '2026-10-25');
+  assert.equal(result[0].dueDate, '2026-10-21');
+});
+
+test('overdueInvoices includes due amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const result = overdueInvoices([issued], '2026-10-25');
+  assert.equal(result[0].due, balanceDue(issued));
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued2 = issueInvoice(inv2.value, []).value;
+
+  const result = overdueInvoices([issued2, issued1], '2026-10-25');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].daysOverdue, 10);
+  assert.equal(result[1].daysOverdue, 6);
+});
+
+test('overdueInvoices reduces due for partial payments', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2026-10-10' }).value;
+  const result = overdueInvoices([partial], '2026-10-25');
+  assert.equal(result[0].due, balanceDue(partial));
+  assert.ok(result[0].due < balanceDue(issued));
+});
+
+test('overdueInvoices on dueDate returns zero daysOverdue', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const result = overdueInvoices([issued], '2026-10-21');
+  assert.deepEqual(result, []);
+});
