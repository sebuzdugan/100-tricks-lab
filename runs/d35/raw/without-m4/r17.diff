 /**
  * Generate a list of overdue invoices.
@@ -21,3 +22,40 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Generate a VAT summary grouped by rate.
+ * @param {Array<{ status: string, lines: Array }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const included = invoices.filter(
+    (inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid'
+  );
+
+  const vatGroups = {};
+
+  for (const invoice of included) {
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      if (!vatGroups[rate]) {
+        vatGroups[rate] = { base: 0, vat: 0 };
+      }
+      const total = lineTotal(line);
+      const discount = lineDiscount(line);
+      const vat = lineVat(line);
+      vatGroups[rate].base += total - discount;
+      vatGroups[rate].vat += vat;
+    }
+  }
+
+  const result = Object.entries(vatGroups)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseInt(rate, 10),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return result;
+}
