+
+test('vatSummary returns empty for no invoices', () => {
+  const result = vatSummary([]);
+  assert.deepEqual(result, []);
+});
+
+test('vatSummary returns empty for draft invoices only', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const result = vatSummary([inv.value]);
+  assert.deepEqual(result, []);
+});
+
+test('vatSummary includes issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const result = vatSummary([issued]);
+  assert.equal(result.length, 1);
+  assert.equal(result[0].rate, 21);
+});
+
