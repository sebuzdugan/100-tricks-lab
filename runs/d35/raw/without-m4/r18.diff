+
+/**
+ * Calculate the late fee for an invoice.
+ * @param {{ dueDate?: string, status: string, payments?: Array, lines: Array, voucher?: object }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.status === 'draft') return 0;
+  if (!invoice.dueDate || invoice.dueDate >= asOf) return 0;
+
+  const due = balanceDue(invoice);
+  if (due <= 0) return 0;
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  return Math.max(0, roundCents((due * daysOverdue * 0.04) / 100));
+}
