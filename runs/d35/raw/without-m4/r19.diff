+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns header line', () => {
+  const csv = exportCsv([]);
+  assert.ok(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv returns empty for empty invoices', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes one invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].includes('INV-2026-0001'));
+});
+
+test('exportCsv includes customer name', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  assert.ok(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv includes issueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  assert.ok(csv.includes('2026-10-07'));
+});
+
+test('exportCsv includes dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  assert.ok(csv.includes('2026-10-21'));
+});
+
+test('exportCsv includes status', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  assert.ok(csv.includes('issued'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  const totals = invoiceTotals(issued);
+  const subtotal = (totals.subtotal / 100).toFixed(2);
+  assert.ok(csv.includes(subtotal));
+});
+
+test('exportCsv includes subtotal, discount, vat, total, due', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+  assert.equal(fields.length, 10);
+});
+
+test('exportCsv escapes fields with commas', () => {
+  const inv = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  assert.ok(csv.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes fields with quotes', () => {
+  const inv = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  assert.ok(csv.includes('Marlow ""The Print Shop""'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+  const issued2 = issueInvoice(inv2.value, [issued1.number]).value;
+
+  const csv = exportCsv([issued1, issued2]);
+  const lines = csv.split('\n');
+  assert.ok(lines[1].includes('INV-2026-0001'));
+  assert.ok(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv includes due after partial payment', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const partial = recordPayment(issued, { amount: 2000, date: '2026-10-10' }).value;
+  const csv = exportCsv([partial]);
+  const due = balanceDue(partial);
+  const dueStr = (due / 100).toFixed(2);
+  assert.ok(csv.includes(dueStr));
+});
+
+test('exportCsv ends each line with newline', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+  assert.equal(lines[lines.length - 1], '');
+});
+
+test('exportCsv with empty dueDate shows empty field', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const invoiceWithoutDueDate = { ...issued, dueDate: undefined };
+  const csv = exportCsv([invoiceWithoutDueDate]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[3], '');
+});
+
+test('exportCsv with draft status', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const csv = exportCsv([inv.value]);
+  assert.ok(csv.includes('draft'));
+});
+
+test('exportCsv with multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+  const issued2 = issueInvoice(inv2.value, [issued1.number]).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'PRINT-A4', qty: 200 }],
+  });
+  const issued3 = issueInvoice(inv3.value, [issued1.number, issued2.number]).value;
+
+  const csv = exportCsv([issued1, issued2, issued3]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 5);
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[2].includes('Blue Fern Bakery'));
+  assert.ok(lines[3].includes('Kite & Co'));
+});
+
+test('exportCsv with decimal amounts', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const issued = issueInvoice(inv.value, []).value;
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+  const fields = lines[1].split(',');
+  const subtotal = fields[5];
+  assert.ok(subtotal.includes('.'));
+});
