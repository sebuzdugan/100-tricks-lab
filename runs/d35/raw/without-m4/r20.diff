+
+test('RATES contains EUR, USD, GBP', () => {
+  assert.ok(RATES.EUR !== undefined);
+  assert.ok(RATES.USD !== undefined);
+  assert.ok(RATES.GBP !== undefined);
+  assert.equal(RATES.EUR, 1);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(12345, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 12345);
+});
+
+test('convert EUR to USD uses rate', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, roundCents(10000 * 1.085));
+});
+
+test('convert EUR to GBP uses rate', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, roundCents(10000 * 0.8425));
+});
+
+test('convert returns UNKNOWN_CURRENCY for invalid currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert returns integer cents', () => {
+  const result = convert(12345, 'USD');
+  assert.equal(Number.isInteger(result.value), true);
+});
+
+test('convert rounds correctly', () => {
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(Number.isInteger(result.value), true);
+});
+
