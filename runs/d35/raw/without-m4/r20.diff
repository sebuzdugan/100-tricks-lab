diff --git a/src/money.js b/src/money.js
index fadf486..4681bcd 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,29 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount from EUR cents to another currency's cents.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  const rate = RATES[currency];
+  if (rate === undefined) return fail('UNKNOWN_CURRENCY');
+  return ok(roundCents(cents * rate));
+}
+
+/**
+ * Format cents in a currency for people: 123456 USD -> "$1,234.56", 5 EUR -> "€0.05".
+ * @param {number} cents
+ * @param {string} currency
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const symbol = { EUR: '€', USD: '$', GBP: '£' }[currency] || currency;
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const amount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${amount}.${String(abs % 100).padStart(2, '0')}`;
+}
