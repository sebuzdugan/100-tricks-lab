+});
+
+test('formatMoney GBP shows pound sign', () => {
+  assert.equal(formatMoney(123456, 'GBP'), '£1,234.56');
+});
+
+test('formatMoney formats with thousands separators', () => {
+  assert.equal(formatMoney(1234567, 'USD'), '$12,345.67');
+});
+
+test('formatMoney handles small amounts', () => {
+  assert.equal(formatMoney(5, 'EUR'), '€0.05');
+  assert.equal(formatMoney(5, 'USD'), '$0.05');
+});
+
+test('formatMoney handles negative amounts', () => {
+  assert.equal(formatMoney(-250, 'EUR'), '-€2.50');
+  assert.equal(formatMoney(-250, 'USD'), '-$2.50');
