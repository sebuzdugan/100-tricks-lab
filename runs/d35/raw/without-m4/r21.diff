--- a/src/customers.js
+++ b/src/customers.js
@@ -43,3 +43,30 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge two customers: move all invoices from fromId to intoId, then remove fromId.
+ * @param {Array<{ id: string, name: string, email: string, country: string, tier: string }>} customers
+ * @param {Array<{ customerId: string }>} invoices
+ * @param {string} fromId
+ * @param {string} intoId
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  if (normalizedFromId === normalizedIntoId) return fail('SAME_CUSTOMER');
+
+  const fromExists = customers.some((c) => c.id === normalizedFromId);
+  const intoExists = customers.some((c) => c.id === normalizedIntoId);
+
+  if (!fromExists || !intoExists) return fail('CUSTOMER_NOT_FOUND');
+
+  const newCustomers = customers.filter((c) => c.id !== normalizedFromId);
+  const newInvoices = invoices.map((inv) =>
+    normalizeId(inv.customerId) === normalizedFromId ? { ...inv, customerId: normalizedIntoId } : { ...inv }
+  );
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
