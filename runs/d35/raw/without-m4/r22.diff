@@ -0,0 +1,200 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  const line = { qty: 100, unitPrice: 50 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with zero qty', () => {
+  const line = { qty: 0, unitPrice: 100 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with large numbers', () => {
+  const line = { qty: 10000, unitPrice: 12345 };
+  assert.equal(lineTotal(line), 123450000);
+});
+
+test('lineDiscount returns 0 without discountPercent', () => {
+  const line = { qty: 100, unitPrice: 50 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount calculates with discountPercent', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 500);
+});
+
+test('lineDiscount with 50% discount', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 50 };
+  assert.equal(lineDiscount(line), 2500);
+});
+
+test('lineDiscount is integer cents', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 12.5 };
+  assert.equal(Number.isInteger(lineDiscount(line)), true);
+});
+
+test('lineDiscount never negative', () => {
+  const line = { qty: 100, unitPrice: 50, discountPercent: 0 };
+  assert.ok(lineDiscount(line) >= 0);
+});
+
+test('lineVat calculates on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 10 };
+  const total = 5000;
+  const discount = 500;
+  const base = total - discount;
+  const expected = Math.round((base * 21) / 100);
+  assert.equal(lineVat(line), expected);
+});
+
+test('lineVat without discountPercent', () => {
+  const line = { qty: 100, unitPrice: 50, vatRate: 21 };
+  const total = 5000;
+  const expected = Math.round((total * 21) / 100);
+  assert.equal(lineVat(line), expected);
+});
+
+test('lineVat with zero vatRate', () => {
+  const line = { qty: 100, unitPrice: 50, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat is integer cents', () => {
+  const line = { qty: 100, unitPrice: 50, vatRate: 21 };
+  assert.equal(Number.isInteger(lineVat(line)), true);
+});
+
+test('lineVat never negative', () => {
+  const line = { qty: 100, unitPrice: 50, vatRate: 21 };
+  assert.ok(lineVat(line) >= 0);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 0);
+  assert.ok(totals.vat > 0);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, vatRate: 21 },
+      { qty: 50, unitPrice: 100, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+});
+
+test('invoiceTotals sums discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 10 },
+      { qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 1000);
+});
+
+test('invoiceTotals sums VATs', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, vatRate: 21 },
+      { qty: 100, unitPrice: 50, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.vat > 0);
+});
+
+test('invoiceTotals without voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 1000);
+});
+
+test('invoiceTotals calculates total correctly', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals total never negative', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 999999 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.total >= 0);
+});
+
+test('invoiceTotals all fields are integers', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 12.5 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(Number.isInteger(totals.subtotal), true);
+  assert.equal(Number.isInteger(totals.discount), true);
+  assert.equal(Number.isInteger(totals.vat), true);
+  assert.equal(Number.isInteger(totals.voucher), true);
+  assert.equal(Number.isInteger(totals.total), true);
+});
+
+test('invoiceTotals with multiple VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 50, vatRate: 21 },
+      { qty: 50, unitPrice: 100, vatRate: 9 },
+      { qty: 10, unitPrice: 1000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.subtotal > 0);
+  assert.ok(totals.vat > 0);
+  assert.ok(totals.total > 0);
+});
+
+test('invoiceTotals with discount and voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 10 }],
+    voucher: { code: 'TEST', amount: 100 },
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = 5000 - 500 + totals.vat - 100;
+  assert.equal(totals.total, Math.max(0, expected));
+});
+
+test('invoiceTotals empty lines', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
