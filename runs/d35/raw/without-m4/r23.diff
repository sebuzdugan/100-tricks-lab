+
+test('lineDiscount with qty < 10 no bulk discount', () => {
+  const line = { qty: 9, unitPrice: 100, vatRate: 21 };
+  const discount = lineDiscount(line);
+  assert.equal(discount, 0);
+});
+
+test('lineDiscount with qty = 10 applies bulk discount', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 21 };
+  const total = 1000;
+  const bulkDiscount = Math.round((total * 2.5) / 100);
+  const discount = lineDiscount(line);
+  assert.equal(discount, bulkDiscount);
+});
+
+test('lineDiscount with qty = 11 applies bulk discount', () => {
+  const line = { qty: 11, unitPrice: 100, vatRate: 21 };
+  const total = 1100;
+  const bulkDiscount = Math.round((total * 2.5) / 100);
+  const discount = lineDiscount(line);
+  assert.equal(discount, bulkDiscount);
+});
+
+test('lineDiscount with own discount and qty >= 10', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 21, discountPercent: 10 };
+  const total = 1000;
+  const firstDiscount = 100;
+  const amountAfterFirst = total - firstDiscount;
+  const bulkDiscount = 22;
+  const expectedTotal = firstDiscount + bulkDiscount;
+  const discount = lineDiscount(line);
+  assert.equal(discount, expectedTotal);
+});
+
+test('lineDiscount bulk applies after line discount', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 21, discountPercent: 10 };
+  const total = 1000;
+  const firstDiscount = 100;
+  const amountAfterFirst = total - firstDiscount;
+  const bulkDiscount = 22;
+  const totalDiscount = firstDiscount + bulkDiscount;
+  assert.equal(lineDiscount(line), totalDiscount);
+});
+
+test('lineVat uses amount after both discounts', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 21, discountPercent: 10 };
+  const total = 1000;
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  const vat = lineVat(line);
+  assert.ok(Number.isInteger(vat));
+  assert.ok(vat > 0);
+});
+
+test('lineDiscount exactly 10 units', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 21 };
+  assert.ok(lineDiscount(line) > 0);
+});
+
+test('lineDiscount exactly 9 units no bulk', () => {
+  const line = { qty: 9, unitPrice: 100, vatRate: 21 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount large quantity', () => {
+  const line = { qty: 1000, unitPrice: 100, vatRate: 21 };
+  const total = 100000;
+  const bulkDiscount = Math.round((total * 2.5) / 100);
+  assert.equal(lineDiscount(line), bulkDiscount);
+});
+
+test('invoiceTotals with bulk discount line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+});
+
+test('invoiceTotals mixed qty with and without bulk', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 100, vatRate: 21 },
+      { qty: 10, unitPrice: 100, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const line1Discount = lineDiscount(invoice.lines[0]);
+  const line2Discount = lineDiscount(invoice.lines[1]);
+  assert.equal(totals.discount, line1Discount + line2Discount);
+});
+
+test('lineDiscount with discountPercent=0 still gets bulk', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 21, discountPercent: 0 };
+  const total = 1000;
+  const bulkDiscount = Math.round((total * 2.5) / 100);
+  assert.equal(lineDiscount(line), bulkDiscount);
+});
+
+test('lineDiscount bulk is integer cents', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 21 };
+  assert.equal(Number.isInteger(lineDiscount(line)), true);
+});
+
+test('invoiceTotals bulk discount increases discount amount', () => {
+  const invoiceNoBulk = {
+    lines: [{ qty: 9, unitPrice: 100, vatRate: 21 }],
+  };
+  const invoiceWithBulk = {
+    lines: [{ qty: 10, unitPrice: 100, vatRate: 21 }],
+  };
+  const totalsNoBulk = invoiceTotals(invoiceNoBulk);
+  const totalsWithBulk = invoiceTotals(invoiceWithBulk);
+  assert.ok(totalsWithBulk.discount > totalsNoBulk.discount);
+});
+
+test('lineDiscount never negative with bulk', () => {
+  const line = { qty: 10, unitPrice: 100, vatRate: 21 };
+  assert.ok(lineDiscount(line) >= 0);
+});
