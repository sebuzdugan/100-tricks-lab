 }
 
 /**
- * Calculate the discount for a single invoice line.
+ * Calculate the discount for a single invoice line (including bulk discount).
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
-  if (!line.discountPercent) return 0;
-  return Math.max(0, roundCents(lineTotal(line) * line.discountPercent / 100));
+  const total = lineTotal(line);
+  const firstDiscount = !line.discountPercent ? 0 : roundCents(total * line.discountPercent / 100);
+  const amountAfterFirstDiscount = total - firstDiscount;
+  const bulkDiscount = line.qty >= 10 ? roundCents(amountAfterFirstDiscount * 2.5 / 100) : 0;
+  return Math.max(0, firstDiscount + bulkDiscount);
 }
 
