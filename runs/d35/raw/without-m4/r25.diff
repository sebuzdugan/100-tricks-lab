 import { formatEuros } from './money.js';
 import { lineTotal, lineDiscount, invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
 
 /**
  * Render an invoice as plain text.
- * @param {{ number?: string, customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }> }} invoice
+ * @param {{ number?: string, customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }>, dueDate?: string, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number, date: string }> }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -34,7 +35,19 @@ export function renderInvoiceText(invoice) {
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+  if (invoice.voucher) {
+    lines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const paid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return lines.join('\n');
 }
