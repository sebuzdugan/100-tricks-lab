+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with valid inputs', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const invoice = result.value;
+  assert.equal(invoice.customerId, 'C-001');
+  assert.equal(invoice.issueDate, '2026-10-07');
+  assert.equal(invoice.status, 'draft');
+  assert.equal(invoice.lines.length, 1);
+
+  const line = invoice.lines[0];
+  assert.equal(line.sku, 'DEV-HOUR');
+  assert.equal(line.name, 'Development (hour)');
+  assert.equal(line.qty, 5);
+  assert.equal(line.unitPrice, 9500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice handles multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const invoice = result.value;
+  assert.equal(invoice.lines.length, 3);
+  assert.equal(invoice.lines[0].name, 'Development (hour)');
+  assert.equal(invoice.lines[1].name, 'Design work (hour)');
+  assert.equal(invoice.lines[2].name, 'Logo package');
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for bad date format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '07-10-2026',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports DATE_INVALID for invalid dates', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-02-30',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' },
+  );
+
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-13-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'DATE_INVALID' },
+  );
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports NO_LINES if lines is missing', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: undefined,
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1.5 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports UNKNOWN_SKU for unknown product', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice validates the first invalid line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: -1 },
+    ],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice does not mutate input lines', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 5 }];
+  const linesCopy = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+
+  assert.deepEqual(lines, linesCopy);
+});
+
+test('createInvoice includes product info copied from catalogue', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const line = result.value.lines[0];
+  assert.equal(line.name, 'Logo package');
+  assert.equal(line.unitPrice, 120000);
+  assert.equal(line.vatRate, 21);
+});
