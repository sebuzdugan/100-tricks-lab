+test('addLine adds a new line to the invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 2,
+        unitPrice: 9500,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const result = addLine(invoice, { sku: 'DES-HOUR', qty: 3 });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[1].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[1].qty, 3);
+  assert.equal(result.value.lines[1].name, 'Design work (hour)');
+});
