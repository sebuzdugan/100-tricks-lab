diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..2ace56b
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 when no numbers exist', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-15');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber restarts at 0001 for a new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0050', 'INV-2025-0100', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber handles unsorted existing numbers', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-10000');
+});
+
+test('nextInvoiceNumber handles gaps in sequence', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores invalid formats', () => {
+  const existing = ['INV-2026-0001', 'INVALID', 'INV-2026-abc', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from different invoice type prefixes', () => {
+  const existing = ['QT-2026-0001', 'INV-2026-0001', 'PO-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
