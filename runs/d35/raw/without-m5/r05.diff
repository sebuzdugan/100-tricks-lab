+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 5,
+        unitPrice: 9500,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('DRAFT'));
+  assert(text.includes('Northwind Studio'));
+  assert(text.includes('5 Development (hour) €95.00 €475.00'));
+  assert(text.includes('Total: €475.00'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      {
+        sku: 'LOGO-PACK',
+        name: 'Logo package',
+        qty: 1,
+        unitPrice: 120000,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('INV-2026-0001'));
+  assert(!text.includes('DRAFT'));
+  assert(text.includes('Northwind Studio'));
+  assert(text.includes('1 Logo package €1,200.00 €1,200.00'));
+  assert(text.includes('Total: €1,200.00'));
+});
+
+test('renderInvoiceText renders multiple line items', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 10,
+        unitPrice: 9500,
+        vatRate: 21,
+      },
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 5,
+        unitPrice: 8500,
+        vatRate: 21,
+      },
+      {
+        sku: 'LOGO-PACK',
+        name: 'Logo package',
+        qty: 1,
+        unitPrice: 120000,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines[2], '10 Development (hour) €95.00 €950.00');
+  assert.equal(lines[3], '5 Design work (hour) €85.00 €425.00');
+  assert.equal(lines[4], '1 Logo package €1,200.00 €1,200.00');
+  assert.equal(lines[5], 'Total: €2,575.00');
+});
+
+test('renderInvoiceText formats amounts in euros', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'STICKER',
+        name: 'Sticker sheet',
+        qty: 100,
+        unitPrice: 50,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('€0.50'));
+  assert(text.includes('€50.00'));
+});
+
+test('renderInvoiceText uses customer name from database', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      {
+        sku: 'HOST-MONTH',
+        name: 'Website hosting (month)',
+        qty: 3,
+        unitPrice: 1500,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('Orchard Health'));
+  assert(!text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText output is a string with newlines', () => {
+  const invoice = {
+    number: 'INV-2026-0002',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 2,
+        unitPrice: 9500,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert(typeof text === 'string');
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4);
+});
+
+test('renderInvoiceText renders large quantities and amounts', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'ICON-SET',
+        name: 'Icon set (24 icons)',
+        qty: 999,
+        unitPrice: 980,
+        vatRate: 21,
+      },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert(text.includes('999 Icon set (24 icons) €9.80 €9,790.20'));
+  assert(text.includes('Total: €9,790.20'));
+});
