+  const line = {
+    sku: 'DEV-HOUR',
+    name: 'Development (hour)',
+    qty: 10,
+    unitPrice: 9500,
+    vatRate: 21,
+    discountPercent: 10,
+  };
+
+  const vat = lineVAT(line);
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amount = total - discount;
+  const expectedVAT = Math.round(amount * 21 / 100);
+
+  assert.equal(vat, expectedVAT);
+});
+
