diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..65c739d
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,104 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid date format', () => {
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('10/07/2026'), false);
+});
+
+test('isValidDate rejects invalid calendar dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate rejects non-date strings', () => {
+  assert.equal(isValidDate('not-a-date'), false);
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('2026-10-07 '), false);
+});
+
+test('addDays adds days to a date', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 30), '2026-11-06');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles leap year', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+  assert.equal(addDays('2026-01-05', -5), '2025-12-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween calculates days between two dates', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-11-06'), 30);
+});
+
+test('daysBetween returns negative when b is before a', () => {
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+  assert.equal(daysBetween('2026-11-06', '2026-10-07'), -30);
+});
+
+test('daysBetween returns 0 for same date', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+});
+
+test('daysBetween returns whole days only', () => {
+  const result = daysBetween('2026-01-01', '2026-01-08');
+  assert.equal(result, 7);
+  assert.equal(Number.isInteger(result), true);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
+
+test('daysBetween calculates correctly across leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+});
+
+test('addDays and daysBetween are inverse operations', () => {
+  const start = '2026-10-07';
+  const days = 42;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+});
+
+test('date arithmetic works over year boundaries', () => {
+  assert.equal(addDays('2025-12-25', 7), '2026-01-01');
+  assert.equal(daysBetween('2025-12-25', '2026-01-01'), 7);
+});
