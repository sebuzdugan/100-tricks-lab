+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue returns the full total for unpaid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 10,
+        unitPrice: 9500,
+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+  };
+
+  const balance = balanceDue(invoice);
+  assert(balance > 0);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'paid',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 10,
+        unitPrice: 9500,
+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+    payments: [{ amount: 114950, date: '2026-10-10' }],
+  };
+
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue accounts for partial payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'partially_paid',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 10,
+        unitPrice: 10000,
+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+    payments: [{ amount: 50000, date: '2026-10-10' }],
+  };
+
+  const balance = balanceDue(invoice);
+  assert(balance > 0);
+  assert(balance < 121000);
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 10,
+        unitPrice: 9500,
+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2026-10-10' });
+
+  assert.equal(result.ok, true);
+  assert(Array.isArray(result.value.payments));
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment adds to existing payments', () => {
