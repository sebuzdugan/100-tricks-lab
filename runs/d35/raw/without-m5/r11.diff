+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+    payments: [{ amount: 60000, date: '2026-10-10' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 61000, date: '2026-10-15' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 2);
+});
+
