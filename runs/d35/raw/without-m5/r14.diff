+      issueDate: '2026-01-15',
+      dueDate: '2026-02-14',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'DEV-HOUR',
+          name: 'Development (hour)',
+          qty: 10,
+          unitPrice: 9500,
+          vatRate: 21,
+          discountPercent: 0,
+        },
+      ],
+    },
+    {
+      number: 'INV-2026-0002',
+      customerId: 'C-001',
+      issueDate: '2026-02-15',
+      dueDate: '2026-03-16',
+      status: 'issued',
