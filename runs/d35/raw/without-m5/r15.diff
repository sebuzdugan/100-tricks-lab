+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+
+test('nextCreditNoteNumber returns 0001 when no credit notes exist', () => {
+  const number = nextCreditNoteNumber([], '2026-10-07');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber increments counter for same year', () => {
+  const existing = ['CN-2026-0001', 'CN-2026-0002'];
+  const number = nextCreditNoteNumber(existing, '2026-10-15');
+  assert.equal(number, 'CN-2026-0003');
+});
+
+test('nextCreditNoteNumber restarts at 0001 for a new year', () => {
+  const existing = ['CN-2025-0050'];
+  const number = nextCreditNoteNumber(existing, '2026-01-01');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0005'];
+  const number = nextCreditNoteNumber(existing, '2026-10-07');
+  assert.equal(number, 'CN-2026-0006');
+});
+
+test('nextCreditNoteNumber handles mixed numbers in any order', () => {
+  const existing = ['INV-2026-0001', 'CN-2026-0003', 'INV-2026-0002', 'CN-2026-0001'];
+  const number = nextCreditNoteNumber(existing, '2026-10-07');
+  assert.equal(number, 'CN-2026-0004');
+});
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    dueDate: '2026-11-06',
+    status: 'issued',
+    lines: [
+      {
+        sku: 'DEV-HOUR',
+        name: 'Development (hour)',
+        qty: 10,
+        unitPrice: 9500,
+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+  };
+
+  const result = createCreditNote(invoice, { amount: 50000, reason: 'Defect correction', date: '2026-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 50000);
+  assert.equal(result.value.reason, 'Defect correction');
+  assert.equal(result.value.date, '2026-10-20');
+});
+
