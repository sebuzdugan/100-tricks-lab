@@ -14,3 +16,27 @@ export function overdueInvoices(invoices, asOf) {
     }))
     .sort((a, b) => a.dueDate.localeCompare(b.dueDate));
 }
+
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  const relevantInvoices = invoices.filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid');
+
+  for (const invoice of relevantInvoices) {
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const base = Math.max(0, lineTotal(line) - lineDiscount(line));
+      const vat = lineVAT(line);
+
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { rate, base: 0, vat: 0 });
+      }
+
+      const entry = vatMap.get(rate);
+      entry.base = roundCents(entry.base + base);
+      entry.vat = roundCents(entry.vat + vat);
+    }
+  }
+
+  return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
+}
