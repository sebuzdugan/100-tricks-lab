+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns string with header line', () => {
+  const result = exportCsv([]);
+
+  assert(typeof result === 'string');
+  assert(result.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoices = [
+    {
+      number: 'INV-2026-0001',
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      dueDate: '2026-11-06',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'DEV-HOUR',
+          name: 'Development (hour)',
+          qty: 10,
+          unitPrice: 9500,
+          vatRate: 21,
+          discountPercent: 0,
+        },
+      ],
+    },
+  ];
+
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 3);
+  assert(lines[0].startsWith('number,customer,issueDate,dueDate,status'));
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert.equal(lines[2], '');
+});
+
+test('exportCsv includes customer name', () => {
+  const invoices = [
+    {
+      number: 'INV-2026-0001',
+      customerId: 'C-003',
+      issueDate: '2026-10-07',
+      dueDate: '2026-11-06',
+      status: 'issued',
+      lines: [
