+          qty: 1,
+          unitPrice: 9500,
+          vatRate: 21,
+          discountPercent: 0,
+        },
+      ],
+    },
+  ];
+
+  const result = exportCsv(invoices);
+
+  assert(result.includes('Kite & Co'));
+});
+
