+test('mergeCustomers moves invoices from one customer to another', () => {
+  const customers = listCustomers();
+  const invoices = [
+    {
+      number: 'INV-2026-0001',
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      dueDate: '2026-11-06',
+      status: 'issued',
+      lines: [{ sku: 'DEV-HOUR', qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+    },
+    {
+      number: 'INV-2026-0002',
+      customerId: 'C-002',
+      issueDate: '2026-10-10',
+      dueDate: '2026-11-09',
+      status: 'issued',
+      lines: [{ sku: 'DEV-HOUR', qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 0 }],
+    },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.find((c) => c.id === 'C-001'), undefined);
+  assert.equal(result.value.invoices.filter((inv) => inv.customerId === 'C-002').length, 2);
+  assert.equal(result.value.invoices.filter((inv) => inv.customerId === 'C-001').length, 0);
+});
