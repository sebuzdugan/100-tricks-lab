diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..84906e5
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,34 @@
+import { roundCents } from './money.js';
+
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+export function lineDiscount(line) {
+  const total = lineTotal(line);
+  const discount = roundCents(total * (line.discountPercent ?? 0) / 100);
+  return Math.max(0, discount);
+}
+
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amount = Math.max(0, total - discount);
+  const vat = roundCents(amount * (line.vatRate ?? 0) / 100);
+  return Math.max(0, vat);
+}
+
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const voucher = Math.max(0, invoice.voucher?.amount ?? 0);
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..7bfd3fc
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,279 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty * unitPrice', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 };
+  assert.equal(lineTotal(line), 95000);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { qty: 1, unitPrice: 1200, vatRate: 21, discountPercent: 0 };
+  assert.equal(lineTotal(line), 1200);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 9500, vatRate: 21, discountPercent: 0 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with large numbers', () => {
+  const line = { qty: 1000, unitPrice: 100000, vatRate: 21, discountPercent: 0 };
+  assert.equal(lineTotal(line), 100000000);
+});
+
+test('lineTotal applies rounding', () => {
+  const line = { qty: 3, unitPrice: 100, vatRate: 21, discountPercent: 0 };
+  const total = lineTotal(line);
+  assert.equal(total, 300);
+  assert.equal(Number.isInteger(total), true);
+});
+
+test('lineDiscount calculates discount as percent of line total', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 10 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  assert.equal(discount, Math.floor(total * 0.1));
+});
+
+test('lineDiscount with zero discount percent', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with missing discount percent defaults to 0', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 100% discount', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 100 };
+  const total = lineTotal(line);
+  assert.equal(lineDiscount(line), total);
+});
+
+test('lineDiscount is clamped at 0', () => {
+  const line = { qty: 0, unitPrice: 0, vatRate: 21, discountPercent: 50 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount applies rounding', () => {
+  const line = { qty: 10, unitPrice: 10000, vatRate: 21, discountPercent: 10 };
+  const discount = lineDiscount(line);
+  assert.equal(Number.isInteger(discount), true);
+});
+
+test('lineVAT calculates VAT on discounted amount', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 10 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const base = total - discount;
+  const expectedVat = Math.max(0, Math.round(base * 0.21));
+  assert.equal(lineVAT(line), expectedVat);
+});
+
+test('lineVAT with zero VAT rate', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 0, discountPercent: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT with missing VAT rate defaults to 0', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT with 9% VAT rate', () => {
+  const line = { qty: 10, unitPrice: 10000, vatRate: 9, discountPercent: 0 };
+  const total = lineTotal(line);
+  const vat = lineVAT(line);
+  assert.equal(vat, Math.max(0, Math.round(total * 0.09)));
+});
+
+test('lineVAT is clamped at 0', () => {
+  const line = { qty: 0, unitPrice: 0, vatRate: 21, discountPercent: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT with 100% discount results in 0 VAT', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 100 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 95000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat > 0, true);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+      { qty: 5, unitPrice: 12000, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.subtotal > 0);
+  assert(totals.discount > 0);
+  assert(totals.vat > 0);
+});
+
+test('invoiceTotals returns all required fields', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.hasOwnProperty('subtotal'));
+  assert(totals.hasOwnProperty('discount'));
+  assert(totals.hasOwnProperty('vat'));
+  assert(totals.hasOwnProperty('voucher'));
+  assert(totals.hasOwnProperty('total'));
+});
+
+test('invoiceTotals without voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    voucher: { code: 'SAVE10', amount: 10000 },
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 10000);
+});
+
+test('invoiceTotals formula: total = subtotal - discount + vat - voucher', () => {
+  const invoice = {
+    voucher: { code: 'SAVE10', amount: 5000 },
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const calculated = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, Math.max(0, calculated));
+});
+
+test('invoiceTotals is clamped at 0', () => {
+  const invoice = {
+    voucher: { code: 'SAVE', amount: 1000000 },
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 0, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, vatRate: 21, discountPercent: 0 },
+      { qty: 5, unitPrice: 5000, vatRate: 9, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert(totals.subtotal > 0);
+  assert(totals.vat > 0);
+});
+
+test('invoiceTotals with zero-VAT line', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, vatRate: 0, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 100000);
+});
+
+test('invoiceTotals with empty lines', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals preserves line data', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.deepEqual(invoice.lines[0], { qty: 10, unitPrice: 9500, vatRate: 21, discountPercent: 0 });
+});
+
+test('lineDiscount with 50% discount', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: 50 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  assert.equal(discount, total / 2);
+});
+
+test('lineVAT with 50% discount', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: 50 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const vatBase = total - discount;
+  const vat = lineVAT(line);
+  assert.equal(vat, Math.max(0, Math.round(vatBase * 0.21)));
+});
+
+test('invoiceTotals with discount on all lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, vatRate: 21, discountPercent: 10 },
+      { qty: 5, unitPrice: 10000, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 10000 + 5000);
+});
+
+test('invoiceTotals voucher with zero amount', () => {
+  const invoice = {
+    voucher: { code: 'ZERO', amount: 0 },
+    lines: [
+      { qty: 10, unitPrice: 10000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with three VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 10000, vatRate: 21, discountPercent: 0 },
+      { qty: 5, unitPrice: 10000, vatRate: 9, discountPercent: 0 },
+      { qty: 2, unitPrice: 10000, vatRate: 0, discountPercent: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 170000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, Math.round(100000 * 0.21) + Math.round(50000 * 0.09));
+});
