+  if (line.qty < 10) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const regularDiscount = lineDiscount(line);
+  const amountAfterDiscount = Math.max(0, total - regularDiscount);
+  const bulkDiscount = roundCents(amountAfterDiscount * 0.025);
+  return Math.max(0, bulkDiscount);
