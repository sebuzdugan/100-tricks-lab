@@ -0,0 +1,168 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a valid invoice with one line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2024-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 1);
+  assert.equal(result.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[0].qty, 10);
+  assert.equal(result.value.lines[0].unitPrice, 8500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice creates a valid invoice with multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-06-20',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 20 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[1].name, 'Development (hour)');
+  assert.equal(result.value.lines[2].name, 'Logo package');
+});
+
+test('createInvoice rejects an unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects an invalid date format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '01/15/2024',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects a malformed date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects a non-string date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: 20240115,
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects an empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [],
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects a non-array lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: null,
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects a non-integer quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5.5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects a zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects a negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects an unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice rejects the first invalid line in a multi-line request', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 0 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice handles products with different VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 1 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
+
+test('createInvoice does not mutate the input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  };
+  const originalLine = { ...input.lines[0] };
+  createInvoice(input);
+  assert.deepEqual(input.lines[0], originalLine);
+});
