+++ b/test/numbering.test.js
@@ -0,0 +1,58 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2024-06-20');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2023-0001', 'INV-2023-0099', 'INV-2024-0001'];
+  const number = nextInvoiceNumber(existing, '2024-06-20');
+  assert.equal(number, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber finds the max counter regardless of order', () => {
+  const existing = ['INV-2024-0005', 'INV-2024-0001', 'INV-2024-0010', 'INV-2024-0003'];
+  const number = nextInvoiceNumber(existing, '2024-06-20');
+  assert.equal(number, 'INV-2024-0011');
+});
+
+test('nextInvoiceNumber zero-pads the counter to 4 digits', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2024-06-20');
+  assert.equal(number, 'INV-2024-0010');
+});
+
+test('nextInvoiceNumber restarts counter for a new year', () => {
+  const existing = ['INV-2023-0099', 'INV-2023-0100'];
+  const number = nextInvoiceNumber(existing, '2024-01-01');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-XXXX', 'INV-2024-0002', 'NOT-A-NUMBER'];
+  const number = nextInvoiceNumber(existing, '2024-06-20');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber extracts year from issueDate', () => {
+  const existing = [];
+  const number1 = nextInvoiceNumber(existing, '2024-12-31');
+  const number2 = nextInvoiceNumber(existing, '2025-01-01');
+  assert.equal(number1, 'INV-2024-0001');
+  assert.equal(number2, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2024-06-20');
+  assert.equal(number, 'INV-2024-10000');
+});
