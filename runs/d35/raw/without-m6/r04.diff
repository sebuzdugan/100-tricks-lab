+/**
+ * Issue a draft invoice, assigning it a number and marking it as issued.
+ * @param {{ status: string, issueDate: string, lines: Array }} invoice
+ * @param {Array<string>} existingNumbers - Invoice numbers already used
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    ...invoice,
+    number,
+    status: 'issued',
+  });
+}
