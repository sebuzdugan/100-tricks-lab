+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for an invoice without a number', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Northwind Studio' };
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows the invoice number for issued invoices', () => {
+  const invoice = {
+    number: 'INV-2024-0001',
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Northwind Studio' };
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.startsWith('INV-2024-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Blue Fern Bakery' };
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('Customer: Blue Fern Bakery'));
+});
+
+test('renderInvoiceText shows all line items', () => {
+  const invoice = {
+    number: 'INV-2024-0001',
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 9500, vatRate: 21 },
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Northwind Studio' };
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('Design work (hour)'));
+  assert.ok(text.includes('Development (hour)'));
+  assert.ok(text.includes('Logo package'));
+});
+
+test('renderInvoiceText calculates line totals correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Northwind Studio' };
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('€85.00')); // unit price
+  assert.ok(text.includes('€850.00')); // line total (10 * 85)
+});
+
+test('renderInvoiceText formats amounts as euros', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 20, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Northwind Studio' };
+  const text = renderInvoiceText(invoice, customer);
+  // Total should be 5*8500 + 20*9500 = 42500 + 190000 = 232500 cents = €2,325.00
+  assert.ok(text.includes('Total: €2,325.00'));
+});
+
+test('renderInvoiceText has one line per invoice line', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'SKU1', name: 'Product 1', qty: 1, unitPrice: 1000, vatRate: 21 },
+      { sku: 'SKU2', name: 'Product 2', qty: 2, unitPrice: 2000, vatRate: 21 },
+      { sku: 'SKU3', name: 'Product 3', qty: 3, unitPrice: 3000, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Test Customer' };
+  const text = renderInvoiceText(invoice, customer);
+  const textLines = text.split('\n');
+  // DRAFT + Customer + 3 lines + Total = 6 lines
+  assert.equal(textLines.length, 6);
+});
+
+test('renderInvoiceText pads quantity with spaces', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'SKU1', name: 'Item 1', qty: 1, unitPrice: 1000, vatRate: 21 },
+      { sku: 'SKU2', name: 'Item 2', qty: 100, unitPrice: 1000, vatRate: 21 },
+      { sku: 'SKU3', name: 'Item 3', qty: 1000, unitPrice: 1000, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Test' };
+  const text = renderInvoiceText(invoice, customer);
+  const lines = text.split('\n');
+  // Check that quantities are aligned (padded to 3 chars)
+  assert.match(lines[2], /^\s*1x/);
+  assert.match(lines[3], /^\s*100x/);
+  assert.match(lines[4], /^\s*1000x/);
+});
+
+test('renderInvoiceText handles single product invoice', () => {
+  const invoice = {
+    number: 'INV-2024-0042',
+    customerId: 'C-003',
+    issueDate: '2024-06-20',
+    status: 'issued',
+    lines: [
+      { sku: 'BRAND-BOOK', name: 'Brand guidelines document', qty: 1, unitPrice: 245000, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-003', name: 'Kite & Co' };
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('INV-2024-0042'));
+  assert.ok(text.includes('Kite & Co'));
+  assert.ok(text.includes('Brand guidelines document'));
+  assert.ok(text.includes('€2,450.00'));
+  assert.ok(text.includes('Total: €2,450.00'));
+});
+
+test('renderInvoiceText preserves customer object', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Test', email: 'test@example.com', country: 'NL' };
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('Test'));
+  // Verify customer object wasn't mutated
+  assert.equal(customer.id, 'C-001');
+  assert.equal(customer.email, 'test@example.com');
+});
