+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ name: string, qty: number, unitPrice: number }> }} invoice
+ * @param {{ name: string }} customer - The customer object with at least a name property
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice, customer) {
+  const lines = [];
+
+  lines.push(invoice.number || 'DRAFT');
+  lines.push(`Customer: ${customer.name}`);
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const qtyStr = String(line.qty).padStart(3, ' ');
+    const unitPriceStr = formatEuros(line.unitPrice);
+    const totalStr = formatEuros(total);
+    lines.push(`${qtyStr}x ${line.name} @ ${unitPriceStr} = ${totalStr}`);
+  }
+
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
