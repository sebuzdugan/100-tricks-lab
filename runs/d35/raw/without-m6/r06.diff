+});
+
+test('renderInvoiceText shows subtotal and discount lines when there is a discount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 10, unitPrice: 8500, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+  const customer = { id: 'C-001', name: 'Test' };
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('Subtotal: €850.00'));
