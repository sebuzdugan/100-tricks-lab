new file mode 100644
index 0000000..a73e565
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,39 @@
+/**
+ * Check if a date string is valid in YYYY-MM-DD format.
+ * Date is parsed in UTC.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+  const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!dateRegex.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  return date instanceof Date && !isNaN(date.getTime()) && date.toISOString().startsWith(text);
+}
+
+/**
+ * Add days to a date string (YYYY-MM-DD), returning a date string in UTC.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - Date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a).
+ * Both dates are in YYYY-MM-DD format and parsed in UTC.
+ * @param {string} a - Start date in YYYY-MM-DD format
+ * @param {string} b - End date in YYYY-MM-DD format
+ * @returns {number} - Whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.round(diffMs / (1000 * 60 * 60 * 24));
+}
