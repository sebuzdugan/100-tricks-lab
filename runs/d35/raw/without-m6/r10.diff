diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..61f4c57
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,116 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2024-01-15'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('01/15/2024'), false);
+  assert.equal(isValidDate('2024-1-15'), false);
+  assert.equal(isValidDate('2024-01-5'), false);
+  assert.equal(isValidDate('2024-01'), false);
+  assert.equal(isValidDate('2024'), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2024-02-30'), false);
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('2024-13-01'), false);
+  assert.equal(isValidDate('2024-00-01'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(20240115), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate({ year: 2024, month: 1, day: 15 }), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid leap year dates', () => {
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2024-01-15', 1), '2024-01-16');
+  assert.equal(addDays('2024-01-15', 10), '2024-01-25');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2024-01-15', -1), '2024-01-14');
+  assert.equal(addDays('2024-01-15', -10), '2024-01-05');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2024-01-31', 1), '2024-02-01');
+  assert.equal(addDays('2024-02-01', -1), '2024-01-31');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2024-01-15', 0), '2024-01-15');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2024-01-15', '2024-01-16'), 1);
+  assert.equal(daysBetween('2024-01-15', '2024-01-25'), 10);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2024-01-16', '2024-01-15'), -1);
+  assert.equal(daysBetween('2024-01-25', '2024-01-15'), -10);
+});
+
+test('daysBetween handles zero difference', () => {
+  assert.equal(daysBetween('2024-01-15', '2024-01-15'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2024-01-31', '2024-02-01'), 1);
+  assert.equal(daysBetween('2024-02-01', '2024-01-31'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2024-12-31'), -1);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('daysBetween consistency with addDays', () => {
+  const start = '2024-01-15';
+  const end = addDays(start, 7);
+  assert.equal(daysBetween(start, end), 7);
+  assert.equal(daysBetween(end, start), -7);
+});
+
+test('dates use UTC, not local timezone', () => {
+  // These dates should be valid regardless of machine timezone
+  assert.equal(isValidDate('2024-01-15'), true);
+  const date1 = '2024-01-15';
+  const date2 = addDays(date1, 1);
+  assert.equal(date2, '2024-01-16');
+  // daysBetween should work consistently
+  assert.equal(daysBetween(date1, date2), 1);
+});
