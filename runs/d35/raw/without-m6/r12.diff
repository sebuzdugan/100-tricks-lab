+/**
+ * Calculate the due date based on the terms.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string|null} - Due date in YYYY-MM-DD format, or null if terms invalid
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-');
+    const nextMonthNum = parseInt(month) + 1;
+    let nextMonthDate;
+    if (nextMonthNum > 12) {
+      nextMonthDate = `${parseInt(year) + 1}-01-01`;
+    } else {
+      nextMonthDate = `${year}-${String(nextMonthNum).padStart(2, '0')}-01`;
+    }
+    return addDays(nextMonthDate, -1);
+  }
+  return null;
+}
 
