+test('invoiceTotals includes voucher in return value', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 500 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('voucher' in totals);
+  assert.equal(totals.voucher, 500);
+});
+
+test('invoiceTotals calculates voucher correctly', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totalsWithoutVoucher = invoiceTotals(invoice);
+
+  const invoiceWithVoucher = {
+    ...invoice,
+    voucher: { code: 'SAVE10', amount: 2000 },
+  };
+  const totalsWithVoucher = invoiceTotals(invoiceWithVoucher);
+
+  assert.equal(totalsWithVoucher.voucher, 2000);
+  assert.equal(totalsWithVoucher.total, totalsWithoutVoucher.total - 2000);
+});
+
+test('applyVoucher adds voucher to draft invoice', () => {
