+
+  const voucherResult = applyVoucher(result.value, { code: 'SAVE10', amount: 5000 });
+  assert.equal(voucherResult.ok, true);
+  assert.equal(voucherResult.value.voucher.code, 'SAVE10');
+  assert.equal(voucherResult.value.voucher.amount, 5000);
+});
+
