+++ b/test/statements.test.js
@@ -0,0 +1,246 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns empty list for customer with no issued invoices', () => {
+  const invoices = [];
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const invoices = [];
+  const result = statement('C-999', invoices, '2024-12-31');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement includes only issued and partially_paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+
+  const invoices = [issued1.value, inv2.value];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.ok(result.value.invoices[0].number);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued1 = issueInvoice(inv1.value, ['INV-2024-0001']);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2024-0002']);
+
+  const invoices = [issued1.value, issued2.value];
+
+  const result = statement('C-001', invoices, '2024-02-28');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+});
+
+test('statement includes invoice issued on asOf date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-28',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = statement('C-001', [issued.value], '2024-02-28');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued3 = issueInvoice(inv3.value, ['INV-2024-0003']);
+
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued1 = issueInvoice(inv1.value, ['INV-2024-0001']);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2024-0002']);
+
+  const invoices = [issued3.value, issued1.value, issued2.value];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+  assert.equal(result.value.invoices[1].issueDate, '2024-02-15');
+  assert.equal(result.value.invoices[2].issueDate, '2024-03-15');
+});
+
+test('statement calculates correct total and due for unpaid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = statement('C-001', [issued.value], '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+
+  const invStatement = result.value.invoices[0];
+  assert.equal(invStatement.total, invStatement.due);
+  assert.equal(result.value.totalDue, invStatement.due);
+});
+
+test('statement calculates correct due for partially paid invoice', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100, discountPercent: 0 }],
+  });
+  let issued = issueInvoice(inv.value, []);
+
+  const { total } = invoiceTotals(issued.value);
+  const halfPayment = Math.floor(total / 2);
+
+  const paymentResult = recordPayment(issued.value, { amount: halfPayment, date: '2024-02-15' });
+  const paidInvoice = paymentResult.value;
+
+  const result = statement('C-001', [paidInvoice], '2024-12-31');
+  assert.equal(result.ok, true);
+
+  const invStatement = result.value.invoices[0];
+  assert.ok(invStatement.due > 0);
+  assert.ok(invStatement.due < invStatement.total);
+});
+
+test('statement includes invoice fields', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET30',
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = statement('C-001', [issued.value], '2024-12-31');
+  assert.equal(result.ok, true);
+
+  const invStatement = result.value.invoices[0];
+  assert.ok(invStatement.number);
+  assert.ok(invStatement.issueDate);
+  assert.ok(invStatement.dueDate);
+  assert.ok(invStatement.total !== undefined);
+  assert.ok(invStatement.due !== undefined);
+});
+
+test('statement filters by customerId with normalized IDs', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued2 = issueInvoice(inv2.value, [issued1.value.number]);
+
+  const invoices = [issued1.value, issued2.value];
+
+  const result = statement('c-001', invoices, '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement calculates totalDue as sum of all due amounts', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  const issued2 = issueInvoice(inv2.value, []);
+
+  const invoices = [issued1.value, issued2.value];
+
+  const result = statement('C-001', invoices, '2024-12-31');
+  assert.equal(result.ok, true);
+
+  const sumOfDue = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+  assert.equal(result.value.totalDue, sumOfDue);
+});
+
+test('statement handles paid invoices (status paid)', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  let issued = issueInvoice(inv.value, []);
+
+  const { total } = invoiceTotals(issued.value);
+  const paymentResult = recordPayment(issued.value, { amount: total, date: '2024-02-15' });
+  const paidInvoice = paymentResult.value;
+
+  const result = statement('C-001', [paidInvoice], '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement normalizes customer ID', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = statement(' c-001 ', [issued.value], '2024-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
