diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..ba2d63e
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,203 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { nextCreditNoteNumber, createCreditNote } from '../src/credits.js';
+
+test('nextCreditNoteNumber starts at 0001 for a new year', () => {
+  const number = nextCreditNoteNumber([], '2024-01-15');
+  assert.equal(number, 'CN-2024-0001');
+});
+
+test('nextCreditNoteNumber increments the counter', () => {
+  const existing = ['CN-2024-0001', 'CN-2024-0002'];
+  const number = nextCreditNoteNumber(existing, '2024-06-20');
+  assert.equal(number, 'CN-2024-0003');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'CN-2024-0001'];
+  const number = nextCreditNoteNumber(existing, '2024-06-20');
+  assert.equal(number, 'CN-2024-0002');
+});
+
+test('nextCreditNoteNumber restarts counter for a new year', () => {
+  const existing = ['CN-2023-0099', 'CN-2023-0100'];
+  const number = nextCreditNoteNumber(existing, '2024-01-01');
+  assert.equal(number, 'CN-2024-0001');
+});
+
+test('nextCreditNoteNumber zero-pads the counter to 4 digits', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `CN-2024-${String(i + 1).padStart(4, '0')}`);
+  const number = nextCreditNoteNumber(existing, '2024-06-20');
+  assert.equal(number, 'CN-2024-0010');
+});
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+  const issueResult = issueInvoice(result.value, []);
+  assert.equal(issueResult.ok, true);
+  const invoice = issueResult.value;
+
+  const creditResult = createCreditNote(invoice, { amount: 50000, reason: 'Partial refund', date: '2024-02-15' }, []);
+  assert.equal(creditResult.ok, true);
+  assert.ok(creditResult.value.number.startsWith('CN-'));
+  assert.equal(creditResult.value.invoiceNumber, invoice.number);
+  assert.equal(creditResult.value.customerId, 'C-001');
+  assert.equal(creditResult.value.amount, 50000);
+  assert.equal(creditResult.value.reason, 'Partial refund');
+  assert.equal(creditResult.value.date, '2024-02-15');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  assert.equal(result.ok, true);
+
+  const creditResult = createCreditNote(result.value, { amount: 50000, reason: 'Refund', date: '2024-02-15' }, []);
+  assert.deepEqual(creditResult, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote works on partially paid invoices', () => {
+  let result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100, discountPercent: 0 }],
+  });
+  let invoice = issueInvoice(result.value, []).value;
+
+  const { total } = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: Math.floor(total / 2), date: '2024-02-15' });
+  invoice = paymentResult.value;
+
+  const creditResult = createCreditNote(invoice, { amount: 50000, reason: 'Partial refund', date: '2024-03-15' }, []);
+  assert.equal(creditResult.ok, true);
+});
+
+test('createCreditNote works on paid invoices', () => {
+  let result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  let invoice = issueInvoice(result.value, []).value;
+
+  const { total } = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: total, date: '2024-02-15' });
+  invoice = paymentResult.value;
+
+  assert.equal(invoice.status, 'paid');
+
+  const creditResult = createCreditNote(invoice, { amount: Math.floor(total / 2), reason: 'Partial refund', date: '2024-03-15' }, []);
+  assert.equal(creditResult.ok, true);
+});
+
+test('createCreditNote rejects invalid amount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = issueInvoice(result.value, []).value;
+
+  assert.deepEqual(
+    createCreditNote(invoice, { amount: 0, reason: 'Refund', date: '2024-02-15' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+  assert.deepEqual(
+    createCreditNote(invoice, { amount: -1000, reason: 'Refund', date: '2024-02-15' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+  assert.deepEqual(
+    createCreditNote(invoice, { amount: 1000.5, reason: 'Refund', date: '2024-02-15' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = issueInvoice(result.value, []).value;
+
+  assert.deepEqual(
+    createCreditNote(invoice, { amount: 50000, reason: 'Refund', date: '2024-13-01' }, []),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+  assert.deepEqual(
+    createCreditNote(invoice, { amount: 50000, reason: 'Refund', date: '2024/02/15' }, []),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createCreditNote rejects credit amount exceeding invoice total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  const invoice = issueInvoice(result.value, []).value;
+
+  const { total } = invoiceTotals(invoice);
+  assert.deepEqual(
+    createCreditNote(invoice, { amount: total + 1, reason: 'Refund', date: '2024-02-15' }, []),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
+
+test('createCreditNote allows credit up to invoice total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  const invoice = issueInvoice(result.value, []).value;
+
+  const { total } = invoiceTotals(invoice);
+  const creditResult = createCreditNote(invoice, { amount: total, reason: 'Full refund', date: '2024-02-15' }, []);
+  assert.equal(creditResult.ok, true);
+});
+
+test('createCreditNote with mixed invoice and credit note numbers', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const invoice = issueInvoice(result.value, []).value;
+
+  const existingNumbers = ['INV-2024-0001', 'CN-2024-0001', 'INV-2024-0002', 'CN-2024-0002'];
+  const creditResult = createCreditNote(invoice, { amount: 50000, reason: 'Refund', date: '2024-02-15' }, existingNumbers);
+  assert.equal(creditResult.ok, true);
+  assert.equal(creditResult.value.number, 'CN-2024-0003');
+});
+
+test('createCreditNote includes all required fields', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+  });
+  const invoice = issueInvoice(result.value, ['INV-2024-0001']).value;
+
+  const creditResult = createCreditNote(invoice, { amount: 60000, reason: 'Quality issue', date: '2024-04-15' }, ['INV-2024-0001']);
+  assert.equal(creditResult.ok, true);
+
+  const creditNote = creditResult.value;
+  assert.ok(creditNote.number);
+  assert.equal(creditNote.invoiceNumber, invoice.number);
+  assert.equal(creditNote.customerId, 'C-002');
+  assert.equal(creditNote.amount, 60000);
+  assert.equal(creditNote.reason, 'Quality issue');
+  assert.equal(creditNote.date, '2024-04-15');
+});
