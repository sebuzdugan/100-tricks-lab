+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Get the next free credit note number for a given issue date.
+ * Format: CN-<year>-<counter> where counter is 4 digits, zero-padded, restarting each year.
+ * @param {Array<string>} existingNumbers - Credit note numbers already used (can also include invoice numbers)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `CN-${year}-`;
+
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterStr = num.substring(prefix.length);
+      const counter = parseInt(counterStr, 10);
+      if (!isNaN(counter)) {
+        maxCounter = Math.max(maxCounter, counter);
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for a refund on an issued invoice.
+ * @param {{ status: string, number: string, customerId: string }} invoice
+ * @param {{ amount: number, reason: string, date: string }} input
+ * @param {Array<string>} existingNumbers - All existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const { total } = invoiceTotals(invoice);
+  if (amount > total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
