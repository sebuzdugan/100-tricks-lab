@@ -0,0 +1,222 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns empty array for no invoices', () => {
+  const result = overdueInvoices([], '2024-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+
+  const result = overdueInvoices([inv.value], '2024-02-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes issued invoices past due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = overdueInvoices([issued.value], '2024-02-01');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.value.number);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.ok(result[0].daysOverdue > 0);
+});
+
+test('overdueInvoices excludes invoices on due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = overdueInvoices([issued.value], issued.value.dueDate);
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes invoices before due date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = overdueInvoices([issued.value], '2024-01-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  let issued = issueInvoice(inv.value, []);
+
+  const { total } = invoiceTotals(issued.value);
+  const paymentResult = recordPayment(issued.value, { amount: Math.floor(total / 2), date: '2024-02-10' });
+  const partiallyPaid = paymentResult.value;
+
+  const result = overdueInvoices([partiallyPaid], '2024-02-01');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, Math.ceil(total / 2));
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  let issued = issueInvoice(inv.value, []);
+
+  const { total } = invoiceTotals(issued.value);
+  const paymentResult = recordPayment(issued.value, { amount: total, date: '2024-02-10' });
+  const paid = paymentResult.value;
+
+  const result = overdueInvoices([paid], '2024-03-01');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-10',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(inv1.value, ['INV-2024-0001']);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2024-0002']);
+
+  const result = overdueInvoices([issued2.value, issued1.value], '2024-02-10');
+  assert.equal(result.length, 2);
+  assert.ok(result[0].daysOverdue >= result[1].daysOverdue);
+});
+
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = overdueInvoices([issued.value], '2024-01-31');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 16);
+});
+
+test('overdueInvoices includes correct fields', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = overdueInvoices([issued.value], '2024-03-01');
+  assert.equal(result.length, 1);
+
+  const item = result[0];
+  assert.ok(item.number);
+  assert.equal(item.customerId, 'C-002');
+  assert.ok(item.dueDate);
+  assert.ok(Number.isInteger(item.daysOverdue));
+  assert.ok(item.due > 0);
+});
+
+test('overdueInvoices with multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued2 = issueInvoice(inv2.value, [issued1.value.number]);
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-01',
+    lines: [{ sku: 'LOGO-PACK', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued3 = issueInvoice(inv3.value, [issued1.value.number, issued2.value.number]);
+
+  const result = overdueInvoices([issued1.value, issued2.value, issued3.value], '2024-03-01');
+  assert.equal(result.length, 3);
+  assert.ok(result[0].number);
+  assert.ok(result[1].number);
+  assert.ok(result[2].number);
+});
+
+test('overdueInvoices due equals balance for unpaid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const { total } = invoiceTotals(issued.value);
+  const result = overdueInvoices([issued.value], '2024-02-01');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, total);
+});
+
+test('overdueInvoices due equals balance for partially paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  let issued = issueInvoice(inv.value, []);
+
+  const { total } = invoiceTotals(issued.value);
+  const payment = Math.floor(total / 3);
+  const paymentResult = recordPayment(issued.value, { amount: payment, date: '2024-02-10' });
+  const partiallyPaid = paymentResult.value;
+
+  const result = overdueInvoices([partiallyPaid], '2024-02-01');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, total - payment);
+});
