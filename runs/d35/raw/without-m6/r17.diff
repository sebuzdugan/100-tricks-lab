 /**
  * Generate an overdue report for invoices past their due date.
@@ -24,3 +25,35 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Generate a VAT summary across invoices.
+ * @param {Array} invoices - All invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      if (!vatMap[rate]) {
+        vatMap[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      const lineTotal = line.qty * line.unitPrice;
+      const lineDiscount = roundCents(lineTotal * line.discountPercent / 100);
+      const lineAmountAfterDiscount = lineTotal - lineDiscount;
+      const lineVat = roundCents(lineAmountAfterDiscount * rate / 100);
+
+      vatMap[rate].base += lineAmountAfterDiscount;
+      vatMap[rate].vat += lineVat;
+    }
+  }
+
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
