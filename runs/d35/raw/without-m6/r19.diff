+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns header for empty invoices', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv includes header line', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv exports draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].includes('draft'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+});
+
+test('exportCsv exports issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('INV-2024-0001'));
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv includes customer name', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  assert.ok(result.includes('Northwind Studio'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const lines = result.split('\n');
+  const { total } = invoiceTotals(inv.value);
+  const euros = (total / 100).toFixed(2);
+  assert.ok(lines[1].includes(euros));
+});
+
+test('exportCsv uses dot decimal separator', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  assert.ok(result.includes('.'));
+  assert.ok(!result.includes(',5'));
+});
+
+test('exportCsv does not include currency sign', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  assert.ok(!result.includes('€'));
+  assert.ok(!result.includes('EUR'));
+});
+
+test('exportCsv does not include thousands separator', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const amounts = result.match(/\d+\.\d+/g) || [];
+  for (const amount of amounts) {
+    assert.ok(!amount.includes(','));
+  }
+});
+
+test('exportCsv ends lines with newline', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  assert.equal(result[result.length - 1], '\n');
+});
+
+test('exportCsv quotes field with comma', () => {
+  const result = exportCsv([]);
+  assert.ok(result.includes('number,customer,issueDate'));
+});
+
+test('exportCsv escapes double quotes in field', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const lines = result.split('\n');
+  assert.ok(lines.length >= 2);
+});
+
+test('exportCsv multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  const issued2 = issueInvoice(inv2.value, [issued1.value.number]);
+
+  const result = exportCsv([issued1.value, issued2.value]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4);
+  assert.ok(lines[1].includes('INV-2024-0001'));
+  assert.ok(lines[2].includes('INV-2024-0002'));
+});
+
+test('exportCsv includes invoice details', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('2024-01-15'));
+  assert.ok(lines[1].includes('issued'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+});
+
+test('exportCsv includes due amount for unpaid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(inv.value, []);
+  const { total } = invoiceTotals(issued.value);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  const euros = (total / 100).toFixed(2);
+  assert.ok(lines[1].includes(euros));
+});
+
+test('exportCsv includes due amount for partially paid invoice', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100, discountPercent: 0 }],
+  });
+  let issued = issueInvoice(inv.value, []);
+
+  const { total } = invoiceTotals(issued.value);
+  const payment = Math.floor(total / 2);
+  const paymentResult = recordPayment(issued.value, { amount: payment, date: '2024-02-15' });
+  const partiallyPaid = paymentResult.value;
+
+  const result = exportCsv([partiallyPaid]);
+  const lines = result.split('\n');
+  const due = total - payment;
+  const euros = (due / 100).toFixed(2);
+  assert.ok(lines[1].includes(euros));
+});
+
+test('exportCsv includes due amount of 0 for paid invoice', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 100, discountPercent: 0 }],
+  });
+  let issued = issueInvoice(inv.value, []);
+
+  const { total } = invoiceTotals(issued.value);
+  const paymentResult = recordPayment(issued.value, { amount: total, date: '2024-02-10' });
+  const paid = paymentResult.value;
+
+  const result = exportCsv([paid]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('0.00'));
+});
+
+test('exportCsv includes discount amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const { discount } = invoiceTotals(inv.value);
+  const euros = (discount / 100).toFixed(2);
+  assert.ok(result.includes(euros));
+});
+
+test('exportCsv includes VAT amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const { vat } = invoiceTotals(inv.value);
+  const euros = (vat / 100).toFixed(2);
+  assert.ok(result.includes(euros));
+});
+
+test('exportCsv includes subtotal', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const { subtotal } = invoiceTotals(inv.value);
+  const euros = (subtotal / 100).toFixed(2);
+  assert.ok(result.includes(euros));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 0 }],
+  });
+  const issued2 = issueInvoice(inv2.value, [issued1.value.number]);
+
+  const result = exportCsv([issued1.value, issued2.value]);
+  const lines = result.split('\n');
+  const line1Qty = lines[1].split(',');
+  const line2Qty = lines[2].split(',');
+  assert.equal(line1Qty[0], 'INV-2024-0001');
+  assert.equal(line2Qty[0], 'INV-2024-0002');
+});
+
+test('exportCsv with unknown customer', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  inv.value.customerId = 'C-999';
+
+  const result = exportCsv([inv.value]);
+  const lines = result.split('\n');
+  assert.ok(lines[1]);
+});
+
+test('exportCsv amounts are not quoted unless needed', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  const subtotal = fields[5];
+  assert.ok(!subtotal.startsWith('"'));
+});
