+++ b/src/money.js
@@ -39,3 +39,45 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert an amount from EUR cents to another currency's cents.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const convertedCents = roundCents(cents * rate);
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents as money for a given currency: 123456 EUR -> "1234.56", 123456 USD -> "$1234.56"
+ * @param {number} cents - Amount in currency cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const amount = (abs / 100).toFixed(2);
+
+  if (currency === 'USD') {
+    return `${sign}$${amount}`;
+  } else if (currency === 'GBP') {
+    return `${sign}£${amount}`;
+  } else {
+    return `${sign}${amount}`;
+  }
+}
