--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,217 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineAmountAfterDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 10, unitPrice: 150 };
+  assert.equal(lineTotal(line), 1500);
+});
+
+test('lineTotal with zero qty', () => {
+  const line = { qty: 0, unitPrice: 150 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with large numbers', () => {
+  const line = { qty: 1000, unitPrice: 10000 };
+  assert.equal(lineTotal(line), 10000000);
+});
+
+test('lineDiscount calculates line total times discount percent', () => {
+  const line = { qty: 10, unitPrice: 150, discountPercent: 10 };
+  const total = lineTotal(line);
+  const expected = Math.round(total * 10 / 100);
+  assert.equal(lineDiscount(line), expected);
+});
+
+test('lineDiscount with no discount', () => {
+  const line = { qty: 10, unitPrice: 150 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with explicit 0 discount', () => {
+  const line = { qty: 10, unitPrice: 150, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount rounds to cents', () => {
+  const line = { qty: 3, unitPrice: 100, discountPercent: 33 };
+  const discount = lineDiscount(line);
+  assert.equal(Number.isInteger(discount), true);
+});
+
+test('lineAmountAfterDiscount with discount', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 10 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const expected = total - discount;
+  assert.equal(lineAmountAfterDiscount(line), expected);
+});
+
+test('lineAmountAfterDiscount without discount', () => {
+  const line = { qty: 100, unitPrice: 100 };
+  assert.equal(lineAmountAfterDiscount(line), lineTotal(line));
+});
+
+test('lineVat calculates amount after discount times VAT rate', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 21 };
+  const amountAfterDiscount = lineAmountAfterDiscount(line);
+  const expected = Math.round(amountAfterDiscount * 21 / 100);
+  assert.equal(lineVat(line), expected);
+});
+
+test('lineVat with no VAT rate', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat with explicit 0 VAT', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 0 };
+  assert.equal(lineVat(line), 0);
+});
+
+test('lineVat rounds to cents', () => {
+  const line = { qty: 3, unitPrice: 100, discountPercent: 0, vatRate: 21 };
+  const vat = lineVat(line);
+  assert.equal(Number.isInteger(vat), true);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 21 }
+    ]
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 1000);
+  assert.equal(totals.discount, 0);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.voucher, 0);
+  assert.ok(totals.total > 0);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 200, discountPercent: 0, vatRate: 9 }
+    ]
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 2000);
+  assert.equal(totals.discount, 0);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.voucher, 0);
+  assert.ok(totals.total > 0);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 50, vatRate: 0 }
+    ]
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.total < totals.subtotal);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 21 }
+    ],
+    voucher: { code: 'TEST', amount: 500 }
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 500);
+  assert.ok(totals.total < totals.subtotal + totals.vat);
+});
+
+test('invoiceTotals total calculation', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 21 }
+    ]
+  };
+  const totals = invoiceTotals(invoice);
+  const expected = totals.subtotal - totals.discount + totals.vat;
+  assert.equal(totals.total, expected);
+});
+
+test('invoiceTotals total is clamped at 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 0 }
+    ],
+    voucher: { code: 'TEST', amount: 50000 }
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with empty lines', () => {
+  const invoice = {
+    lines: []
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 9 },
+      { qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 0 }
+    ]
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 30000);
+  assert.ok(totals.vat > 0);
+  assert.ok(totals.vat < totals.subtotal);
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 21 }
+    ]
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.ok(totals.discount > 0);
+  const amountAfterDiscount = totals.subtotal - totals.discount;
+  const expectedVat = Math.round(amountAfterDiscount * 21 / 100);
+  assert.equal(totals.vat, expectedVat);
+});
+
+test('invoiceTotals return value has all fields', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 21 }]
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+  assert.equal(Object.keys(totals).length, 5);
+});
+
+test('invoiceTotals returns integers', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 21 }]
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(Number.isInteger(totals.subtotal), true);
+  assert.equal(Number.isInteger(totals.discount), true);
+  assert.equal(Number.isInteger(totals.vat), true);
+  assert.equal(Number.isInteger(totals.voucher), true);
+  assert.equal(Number.isInteger(totals.total), true);
+});
