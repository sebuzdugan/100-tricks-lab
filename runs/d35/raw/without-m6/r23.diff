 /**
- * Calculate the line amount after discount (lineTotal - lineDiscount, in cents).
+ * Calculate the bulk discount (2.5% off for qty >= 10, applied after first discount, in cents).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+function lineBulkDiscount(line) {
+  if (line.qty < 10) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const firstDiscount = lineFirstDiscount(line);
+  const amountAfterFirstDiscount = total - firstDiscount;
+  const bulkDiscount = amountAfterFirstDiscount * 2.5 / 100;
+  return roundCents(bulkDiscount);
+}
+
+/**
+ * Calculate the total discount for a single invoice line (first discount + bulk discount, in cents).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  return lineFirstDiscount(line) + lineBulkDiscount(line);
+}
