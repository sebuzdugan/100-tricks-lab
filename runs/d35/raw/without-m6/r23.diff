+
+test('bulk discount with large qty', () => {
+  const line = { qty: 1000, unitPrice: 100, discountPercent: 0, vatRate: 0 };
+  const discount = lineDiscount(line);
+  const lineTotal = 100000;
+  const expectedDiscount = Math.round(lineTotal * 2.5 / 100);
+  assert.equal(discount, expectedDiscount);
+});
+
+test('bulk discount rounded correctly', () => {
+  const line = { qty: 10, unitPrice: 123, discountPercent: 0, vatRate: 0 };
+  const discount = lineDiscount(line);
+  assert.equal(Number.isInteger(discount), true);
+});
+
+test('invoiceTotals discount combines line and bulk discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 100, discountPercent: 10, vatRate: 0 }
+    ]
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.discount > 100);
+  assert.ok(totals.discount < 150);
