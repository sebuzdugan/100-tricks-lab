+/**
+ * Generate a dashboard with high-level financial metrics.
+ * @param {Array} invoices - All invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ counts: object, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDueMap = {};
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] || 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDueMap[invoice.customerId]) {
+        customerDueMap[invoice.customerId] = 0;
+      }
+      customerDueMap[invoice.customerId] += due;
+    }
+  }
+
+  const overduList = overdueInvoices(invoices, asOf);
+  const overdueAmount = overduList.reduce((sum, item) => sum + item.due, 0);
+
+  const topCustomers = Object.entries(customerDueMap)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overduList.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
