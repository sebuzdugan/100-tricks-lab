 /**
  * Render an invoice as plain text.
- * @param {{ number?: string, customerId: string, lines: Array<{ name: string, qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }> }} invoice
+ * @param {{ number?: string, customerId: string, dueDate?: string, lines: Array<{ name: string, qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { code: string, amount: number }, payments?: Array<{ amount: number, date: string }> }} invoice
  * @param {{ name: string }} customer - The customer object with at least a name property
  * @returns {string}
  */
@@ -41,9 +41,22 @@ export function renderInvoiceText(invoice, customer) {
       const vatStr = formatEuros(totals.vat);
       lines.push(`VAT: ${vatStr}`);
     }
-    lines.push(`Total: ${formatEuros(totals.total)}`);
-  } else {
-    lines.push(`Total: ${formatEuros(totals.total)}`);
+  }
+
+  if (invoice.voucher) {
+    const voucherStr = formatEuros(invoice.voucher.amount);
+    lines.push(`Voucher (${invoice.voucher.code}): -${voucherStr}`);
+  }
+
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const amountPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(amountPaid)}`);
   }
 
   return lines.join('\n');
