new file mode 100644
index 0000000..aa5b787
--- /dev/null
+++ b/src/order-agent.js
@@ -0,0 +1,55 @@
+import { tool, generateText, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findOrder } from './data/orders.js';
+
+const executeGetOrderStatus = async ({ orderId }, { context }) => {
+  const order = findOrder(orderId);
+  if (!order || order.customerId !== context.customerId) {
+    return { orderId, error: 'not found' };
+  }
+  return { orderId, status: order.status, eta: order.eta };
+};
+
+export const getOrderStatus = tool({
+  description: 'Look up the status of an order',
+  inputSchema: z.object({
+    orderId: z.string(),
+  }),
+  contextSchema: z.object({
+    customerId: z.string(),
+  }),
+  execute: executeGetOrderStatus,
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  const lookedUp = [];
+
+  const wrappedTool = tool({
+    description: getOrderStatus.description,
+    inputSchema: getOrderStatus.inputSchema,
+    contextSchema: getOrderStatus.contextSchema,
+    execute: async (input, options) => {
+      lookedUp.push(input.orderId);
+      return executeGetOrderStatus(input, options);
+    },
+  });
+
+  const result = await generateText({
+    model,
+    tools: { getOrderStatus: wrappedTool },
+    toolsContext: {
+      getOrderStatus: { customerId },
+    },
+    system: "You are Acme's order-status assistant. Answer in one short sentence.",
+    prompt: question,
+    stopWhen: isStepCount(5),
+  });
+
+  const lastStep = result.steps[result.steps.length - 1];
+  return {
+    answer: result.text,
+    lookedUp,
+    inputTokens: lastStep.usage.inputTokens,
+    outputTokens: lastStep.usage.outputTokens,
+  };
+}
diff --git a/test/order-agent.test.js b/test/order-agent.test.js
new file mode 100644
