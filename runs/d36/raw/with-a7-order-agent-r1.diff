+++ b/test/order-agent.test.js
@@ -0,0 +1,102 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { getOrderStatus, answerOrderQuestion } from '../src/order-agent.js';
+import { scriptedModel } from './helpers/mock-model.js';
+
+test('getOrderStatus tool is defined', () => {
+  assert(getOrderStatus);
+  assert(getOrderStatus.inputSchema);
+  assert(getOrderStatus.contextSchema);
+});
+
+test('answerOrderQuestion with single tool call', async () => {
+  const model = scriptedModel([
+    {
+      toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'A100' } }],
+      usage: [100, 10],
+    },
+    {
+      text: 'Order A100 has shipped and will arrive by 2026-10-09.',
+      usage: [200, 20],
+    },
+  ]);
+
+  const result = await answerOrderQuestion(model, 'What is the status of order A100?', {
+    customerId: 'C1',
+  });
+
+  assert.equal(result.answer, 'Order A100 has shipped and will arrive by 2026-10-09.');
+  assert.deepEqual(result.lookedUp, ['A100']);
+  assert.equal(result.inputTokens, 200);
+  assert.equal(result.outputTokens, 20);
+});
+
+test('answerOrderQuestion with multiple tool calls', async () => {
+  const model = scriptedModel([
+    {
+      toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'A100' } }],
+      usage: [100, 10],
+    },
+    {
+      toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'A101' } }],
+      usage: [150, 12],
+    },
+    {
+      text: 'You have order A100 shipped and order A101 processing.',
+      usage: [250, 25],
+    },
+  ]);
+
+  const result = await answerOrderQuestion(
+    model,
+    'What are the statuses of my orders?',
+    {
+      customerId: 'C1',
+    }
+  );
+
+  assert.equal(result.answer, 'You have order A100 shipped and order A101 processing.');
+  assert.deepEqual(result.lookedUp, ['A100', 'A101']);
+  assert.equal(result.inputTokens, 250);
+  assert.equal(result.outputTokens, 25);
+});
+
+test('getOrderStatus returns error for unknown order', async () => {
+  const model = scriptedModel([
+    {
+      toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'Z999' } }],
+      usage: [100, 10],
+    },
+    {
+      text: 'I could not find that order.',
+      usage: [200, 15],
+    },
+  ]);
+
+  const result = await answerOrderQuestion(model, 'Where is order Z999?', {
+    customerId: 'C1',
+  });
+
+  assert.equal(result.answer, 'I could not find that order.');
+  assert.deepEqual(result.lookedUp, ['Z999']);
+});
+
+test('getOrderStatus returns error for order belonging to different customer', async () => {
+  const model = scriptedModel([
+    {
+      toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'B200' } }],
+      usage: [100, 10],
+    },
+    {
+      text: 'I could not find that order.',
+      usage: [200, 15],
+    },
+  ]);
+
+  const result = await answerOrderQuestion(model, 'Where is order B200?', {
+    customerId: 'C1',
+  });
+
+  assert.equal(result.answer, 'I could not find that order.');
+  assert.deepEqual(result.lookedUp, ['B200']);
+});
