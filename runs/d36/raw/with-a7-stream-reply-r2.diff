@@ -0,0 +1,27 @@
+import { streamText } from 'ai';
+
+export async function streamReply(model, history, { onText } = {}) {
+  const result = streamText({
+    model,
+    messages: history,
+    allowSystemInMessages: true,
+  });
+
+  let text = '';
+  for await (const chunk of result.textStream) {
+    text += chunk;
+    if (onText) onText(chunk);
+  }
+
+  const [finishReason, usage] = await Promise.all([
+    result.finishReason,
+    result.usage,
+  ]);
+
+  return {
+    text,
+    finishReason,
+    inputTokens: usage.inputTokens,
+    outputTokens: usage.outputTokens,
+  };
+}
diff --git a/test/stream-reply.test.js b/test/stream-reply.test.js
new file mode 100644
index 0000000..e36eca2
--- /dev/null
+++ b/test/stream-reply.test.js
@@ -0,0 +1,40 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { streamReply } from '../src/stream-reply.js';
+import { scriptedModel } from './helpers/mock-model.js';
+
+test('streamReply streams text and calls onText for each chunk', async () => {
+  const model = scriptedModel([
+    { text: 'Hello world', chunks: ['Hello', ' ', 'world'], usage: [10, 5] },
+  ]);
+
+  const chunks = [];
+  const result = await streamReply(model,
+    [
+      { role: 'system', content: 'You are helpful.' },
+      { role: 'user', content: 'Say hello' },
+    ],
+    { onText: (chunk) => chunks.push(chunk) }
+  );
+
+  assert.deepEqual(chunks, ['Hello', ' ', 'world']);
+  assert.equal(result.text, 'Hello world');
+  assert.equal(result.finishReason, 'stop');
+  assert.equal(result.inputTokens, 10);
+  assert.equal(result.outputTokens, 5);
+});
+
+test('streamReply works without onText callback', async () => {
+  const model = scriptedModel([
+    { text: 'Response', usage: [5, 3] },
+  ]);
+
+  const result = await streamReply(model,
+    [{ role: 'user', content: 'Hello' }]
+  );
+
+  assert.equal(result.text, 'Response');
+  assert.equal(result.finishReason, 'stop');
+  assert.equal(result.inputTokens, 5);
+  assert.equal(result.outputTokens, 3);
+});
