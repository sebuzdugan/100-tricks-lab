+import { generateText, tool, Output, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+export async function triageTicket(model, { customerId, text }) {
+  const result = await generateText({
+    model,
+    tools: {
+      getCustomer: tool({
+        description: 'Get customer information by ID',
+        inputSchema: z.object({ customerId: z.string() }),
+        execute: async ({ customerId }) => {
+          const customer = findCustomer(customerId);
+          return customer ?? { error: 'not found' };
+        },
+      }),
+    },
+    output: Output.object({
+      schema: triageSchema,
+    }),
+    stopWhen: isStepCount(4),
+    prompt: `You are a support ticket triage assistant. Analyze the following support ticket and provide structured triage information.
+
+Customer ID: ${customerId}
+Ticket text: ${text}
+
+First, look up the customer using the getCustomer tool to understand their account context. Then provide your triage assessment.`,
+  });
+
+  if (!result.output) {
+    throw new Error('Failed to generate valid triage result');
+  }
+
+  return result.output;
+}
