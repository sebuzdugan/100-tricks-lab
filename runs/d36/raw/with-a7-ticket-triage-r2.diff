--- /dev/null
+++ b/src/triage.js
@@ -0,0 +1,48 @@
+import { generateText, tool, Output, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']).describe('Category of the ticket'),
+  priority: z.enum(['low', 'normal', 'high']).describe('Priority level'),
+  reply: z.string().describe('Short first reply to the customer'),
+});
+
+export async function triageTicket(model, { customerId, text }) {
+  const result = await generateText({
+    model,
+    tools: {
+      getCustomer: tool({
+        description: 'Get customer information by ID',
+        inputSchema: z.object({
+          customerId: z.string().describe('The customer ID'),
+        }),
+        execute: async ({ customerId }) => {
+          const customer = findCustomer(customerId);
+          return customer ?? { error: 'not found' };
+        },
+      }),
+    },
+    output: Output.object({
+      schema: triageSchema,
+    }),
+    stopWhen: isStepCount(4),
+    prompt: `You are a support ticket triage assistant. Analyze the support ticket and categorize it.
+
+Customer ID: ${customerId}
+Ticket: ${text}
+
+First, use the getCustomer tool to get the customer's information. Then, analyze the ticket and provide a structured response with:
+- category: one of 'billing', 'shipping', 'bug', or 'other'
+- priority: one of 'low', 'normal', or 'high'
+- reply: a short first response to send to the customer
+
+Make your categorization and priority decision based on the ticket content and customer information.`,
+  });
+
+  if (!result.output) {
+    throw new Error('Model did not return valid structured output');
+  }
+
+  return result.output;
+}
