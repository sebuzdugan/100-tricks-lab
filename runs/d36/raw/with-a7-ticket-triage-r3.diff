+import { generateText, tool, Output, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+export async function triageTicket(model, { customerId, text }) {
+  const { output } = await generateText({
+    model,
+    tools: {
+      getCustomer: tool({
+        description: 'Retrieve customer information by customer ID',
+        inputSchema: z.object({
+          customerId: z.string().describe('The customer ID'),
+        }),
+        execute: async ({ customerId: id }) => {
+          const customer = findCustomer(id);
+          return customer || { error: 'not found' };
+        },
+      }),
+    },
+    output: Output.object({
+      schema: triageSchema,
+    }),
+    stopWhen: isStepCount(4),
+    system: 'You are a support ticket triage assistant. Use the getCustomer tool to look up the customer, then categorize the ticket and provide a brief reply.',
+    prompt: `Triage this support ticket for customer ${customerId}:\n\n${text}`,
+  });
+
+  if (!output) {
+    throw new Error('Failed to generate triage result');
+  }
+
+  return output;
+}
