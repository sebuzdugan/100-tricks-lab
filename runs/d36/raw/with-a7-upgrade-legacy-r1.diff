diff --git a/test/assistant.test.js b/test/assistant.test.js
new file mode 100644
index 0000000..5a6e1d5
--- /dev/null
+++ b/test/assistant.test.js
@@ -0,0 +1,63 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { summarizeThread, answerAboutOrders, classifyTicket, continueChat } from '../src/legacy/assistant.js';
+import { scriptedModel } from './helpers/mock-model.js';
+
+test('summarizeThread returns summary with token counts', async () => {
+  const model = scriptedModel([
+    { text: 'Customer needs replacement. Shipped wrong item.', usage: [100, 10] },
+  ]);
+
+  const thread = [
+    { from: 'customer', text: 'I received the wrong item' },
+    { from: 'agent', text: 'I apologize for that. Let me help you.' },
+  ];
+
+  const result = await summarizeThread(model, thread);
+  assert.equal(typeof result.summary, 'string');
+  assert.equal(result.inputTokens, 100);
+  assert.equal(result.cachedInputTokens, 0);
+});
+
+test('answerAboutOrders returns text and tools used', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [50, 5] },
+    { text: 'Your order A100 has been shipped.', usage: [60, 15] },
+  ]);
+
+  const result = await answerAboutOrders(model, 'What is the status of my order?', { customerId: 'C1' });
+  assert.equal(typeof result.text, 'string');
+  assert(Array.isArray(result.toolsUsed));
+  assert.equal(result.toolsUsed[0], 'orderLookup');
+});
+
+test('classifyTicket returns classification object', async () => {
+  const model = scriptedModel([
+    { text: '{"category":"billing","urgent":true}', usage: [40, 8] },
+  ]);
+
+  const ticket = 'My billing statement is incorrect and I need immediate help!';
+  const result = await classifyTicket(model, ticket);
+  assert.equal(result.category, 'billing');
+  assert.equal(result.urgent, true);
+});
+
+test('continueChat returns updated message history', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [80, 10] },
+    { text: 'Your order A100 status is shipped.', usage: [100, 20] },
+  ]);
+
+  const history = [
+    { role: 'user', content: 'Hi there' },
+    { role: 'assistant', content: [{ type: 'text', text: 'How can I help?' }] },
+  ];
+
+  const result = await continueChat(model, history, 'What is my order status?', { customerId: 'C1' });
+  assert(Array.isArray(result));
+  assert.equal(result[0].role, 'user');
+  assert.equal(result[1].role, 'assistant');
+  assert.equal(result[2].role, 'user');
+  assert.equal(result[2].content, 'What is my order status?');
+  assert.equal(result[3].role, 'assistant');
+});
