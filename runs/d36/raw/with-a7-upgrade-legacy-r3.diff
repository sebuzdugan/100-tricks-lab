diff --git a/test/assistant.test.js b/test/assistant.test.js
new file mode 100644
index 0000000..bcc9301
--- /dev/null
+++ b/test/assistant.test.js
@@ -0,0 +1,54 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { scriptedModel } from './helpers/mock-model.js';
+import { summarizeThread, answerAboutOrders, classifyTicket, continueChat } from '../src/legacy/assistant.js';
+
+test('summarizeThread returns summary with token usage', async () => {
+  const model = scriptedModel([
+    { text: 'Customer had billing issue, agent resolved.', usage: [100, 50] },
+  ]);
+  const thread = [
+    { from: 'customer', text: 'I was charged twice' },
+    { from: 'agent', text: 'Let me check your account' },
+  ];
+  const result = await summarizeThread(model, thread);
+  assert.equal(result.summary, 'Customer had billing issue, agent resolved.');
+  assert.equal(result.inputTokens, 100);
+  assert.equal(result.cachedInputTokens, 0);
+});
+
+test('answerAboutOrders calls tool and returns answer with tools used', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [100, 10] },
+    { text: 'Your order A100 is shipped.', usage: [150, 30] },
+  ]);
+  const result = await answerAboutOrders(model, 'What is my order status?', { customerId: 'C1' });
+  assert.equal(result.text, 'Your order A100 is shipped.');
+  assert.deepEqual(result.toolsUsed, ['orderLookup']);
+});
+
+test('classifyTicket returns validated structured output', async () => {
+  const model = scriptedModel([
+    { text: JSON.stringify({ category: 'billing', urgent: true }), usage: [100, 20] },
+  ]);
+  const result = await classifyTicket(model, 'I was overcharged!');
+  assert.equal(result.category, 'billing');
+  assert.equal(result.urgent, true);
+});
+
+test('continueChat maintains message history with model responses', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [100, 10] },
+    { text: 'Your order A100 has been shipped.', usage: [150, 30] },
+  ]);
+  const history = [
+    { role: 'user', content: 'Hi' },
+    { role: 'assistant', content: 'How can I help?' },
+  ];
+  const result = await continueChat(model, history, 'What is my order status?', { customerId: 'C1' });
+  assert.equal(result.length, 6); // original 2 + new user message + assistant tool call + tool result + assistant answer
+  assert.equal(result[0].role, 'user');
+  assert.equal(result[0].content, 'Hi');
+  assert.equal(result[2].role, 'user');
+  assert.equal(result[2].content, 'What is my order status?');
+});
