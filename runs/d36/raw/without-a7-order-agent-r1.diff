@@ -0,0 +1,45 @@
+import { tool, generateText, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findOrder } from './data/orders.js';
+
+export const getOrderStatus = tool({
+  description: "Look up a customer's order by id.",
+  parameters: z.object({ orderId: z.string() }),
+  execute: async (input, context) => {
+    const { customerId } = context;
+    const order = findOrder(input.orderId);
+    if (!order || order.customerId !== customerId) {
+      return { orderId: input.orderId, error: 'not found' };
+    }
+    return { orderId: order.orderId, status: order.status, eta: order.eta };
+  },
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  const contextualizedTool = {
+    ...getOrderStatus,
+    execute: (input) => getOrderStatus.execute(input, { customerId }),
+  };
+
+  const result = await generateText({
+    model,
+    system: "You are Acme's order-status assistant. Answer in one short sentence.",
+    tools: { getOrderStatus: contextualizedTool },
+    prompt: question,
+    stopWhen: isStepCount(5),
+  });
+
+  const lookedUp = result.steps
+    .flatMap(step => step.toolCalls || [])
+    .map(call => {
+      const input = typeof call.input === 'string' ? JSON.parse(call.input) : call.input;
+      return input.orderId;
+    });
+
+  return {
+    answer: result.text,
+    lookedUp,
+    inputTokens: result.usage.inputTokens,
+    outputTokens: result.usage.outputTokens,
+  };
+}
diff --git a/test/order-agent.test.js b/test/order-agent.test.js
new file mode 100644
index 0000000..709e030
--- /dev/null
+++ b/test/order-agent.test.js
@@ -0,0 +1,52 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { getOrderStatus, answerOrderQuestion } from '../src/order-agent.js';
+import { scriptedModel } from './helpers/mock-model.js';
+
+test('getOrderStatus is a tool', () => {
+  assert.equal(typeof getOrderStatus, 'object');
+  assert.equal(getOrderStatus.description, "Look up a customer's order by id.");
+});
+
+test('answerOrderQuestion with one tool call', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'A100' } }], usage: [100, 7] },
+    { text: 'Your order A100 is shipped and should arrive on 2026-10-09.', usage: [200, 9] },
+  ]);
+
+  const result = await answerOrderQuestion(model, 'Where is my order?', { customerId: 'C1' });
+
+  assert.equal(result.answer, 'Your order A100 is shipped and should arrive on 2026-10-09.');
+  assert.deepEqual(result.lookedUp, ['A100']);
+  assert.equal(result.inputTokens, 100 + 200);
+  assert.equal(result.outputTokens, 7 + 9);
+});
+
+test('answerOrderQuestion with multiple tool calls', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'A100' } }], usage: [100, 7] },
+    { toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'A101' } }], usage: [200, 8] },
+    { text: 'You have two orders: A100 is shipped and A101 is processing.', usage: [300, 10] },
+  ]);
+
+  const result = await answerOrderQuestion(model, 'What are my orders?', { customerId: 'C1' });
+
+  assert.equal(result.answer, 'You have two orders: A100 is shipped and A101 is processing.');
+  assert.deepEqual(result.lookedUp, ['A100', 'A101']);
+  assert.equal(result.inputTokens, 100 + 200 + 300);
+  assert.equal(result.outputTokens, 7 + 8 + 10);
+});
+
+test('answerOrderQuestion respects max 5 steps', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'A100' } }], usage: [100, 1] },
+    { toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'A101' } }], usage: [100, 1] },
+    { toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'B200' } }], usage: [100, 1] },
+    { toolCalls: [{ name: 'getOrderStatus', input: { orderId: 'B201' } }], usage: [100, 1] },
+    { text: 'Done.', usage: [100, 1] },
+  ]);
+
+  await answerOrderQuestion(model, 'Check all orders', { customerId: 'C1' });
+
+  assert.equal(model.calls.length, 5);
+});
