@@ -0,0 +1,55 @@
+import { tool, generateText } from 'ai';
+import { findOrder } from './data/orders.js';
+
+export const getOrderStatus = tool({
+  description: 'Get the status and ETA of a customer order',
+  parameters: {
+    type: 'object',
+    properties: {
+      orderId: {
+        type: 'string',
+        description: 'The order ID',
+      },
+    },
+    required: ['orderId'],
+  },
+  execute: async ({ orderId }, { customerId }) => {
+    const order = findOrder(orderId);
+    if (!order) {
+      return { orderId, error: 'not found' };
+    }
+    if (order.customerId !== customerId) {
+      return { orderId, error: 'not found' };
+    }
+    return { orderId, status: order.status, eta: order.eta };
+  },
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  const lookedUp = [];
+
+  const trackedGetOrderStatus = tool({
+    description: getOrderStatus.description,
+    parameters: getOrderStatus.parameters,
+    execute: async (input, context) => {
+      lookedUp.push(input.orderId);
+      return getOrderStatus.execute(input, context);
+    },
+  });
+
+  const result = await generateText({
+    model,
+    system: 'You are Acme\'s order-status assistant. Answer in one short sentence.',
+    prompt: question,
+    tools: [trackedGetOrderStatus],
+    toolContext: { customerId },
+    maxSteps: 5,
+  });
+
+  return {
+    answer: result.text,
+    lookedUp,
+    inputTokens: result.usage.inputTokens,
+    outputTokens: result.usage.outputTokens,
+  };
+}
