@@ -0,0 +1,38 @@
+import { generateText, Output, tool } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+const getCustomerTool = tool({
+  description: 'Get customer information by customer ID',
+  parameters: z.object({
+    customerId: z.string(),
+  }),
+  execute: async ({ customerId }) => {
+    const customer = findCustomer(customerId);
+    return customer ?? { error: 'not found' };
+  },
+});
+
+/**
+ * Triage a support ticket using an AI model.
+ * @param {import('ai').LanguageModel} model
+ * @param {{ customerId: string, text: string }} options
+ * @returns {Promise<{ category: 'billing' | 'shipping' | 'bug' | 'other', priority: 'low' | 'normal' | 'high', reply: string }>}
+ */
+export async function triageTicket(model, { customerId, text }) {
+  const result = await generateText({
+    model,
+    system: 'You are a support ticket triage assistant. Analyze the ticket and the customer information to categorize it, determine priority, and provide a brief first reply.',
+    tools: { getCustomer: getCustomerTool },
+    output: Output.object({ schema: triageSchema }),
+    prompt: `Customer ID: ${customerId}\n\nTicket text:\n${text}`,
+  });
+
+  return result.object;
+}
