+import { generateText, tool, stepCountIs } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+const getCustomer = tool({
+  description: 'Look up a customer by ID.',
+  inputSchema: z.object({ customerId: z.string() }),
+  execute: async ({ customerId }) => {
+    const customer = findCustomer(customerId);
+    if (!customer) return { error: 'not found' };
+    return customer;
+  },
+});
+
+/**
+ * Triages a support ticket using the model to determine category, priority, and draft a reply.
+ * @param {import('ai').LanguageModel} model
+ * @param {{ customerId: string, text: string }} ticket
+ * @returns {Promise<{ category: 'billing' | 'shipping' | 'bug' | 'other', priority: 'low' | 'normal' | 'high', reply: string }>}
+ */
+export async function triageTicket(model, { customerId, text }) {
+  const result = await generateText({
+    model,
+    tools: { getCustomer },
+    system: 'You are a support ticket triage assistant. Look up the customer, analyze their issue, and provide a structured response.',
+    prompt: `Triage this support ticket from customer ${customerId}:\n\n${text}`,
+    stopWhen: stepCountIs(4),
+    responseFormat: { type: 'json', schema: triageSchema },
+  });
+
+  if (!result.text) {
+    throw new Error('No response from model');
+  }
+
+  try {
+    const parsed = JSON.parse(result.text);
+    const validated = triageSchema.parse(parsed);
+    return validated;
+  } catch (error) {
+    throw new Error(`Invalid triage response: ${error.message}`);
+  }
+}
