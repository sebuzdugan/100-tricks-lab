+import { generateText, Output, stepCountIs, tool } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+/**
+ * Triages a support ticket using an AI model.
+ * @param {import('ai').LanguageModel} model
+ * @param {{ customerId: string, text: string }} params
+ * @returns {Promise<{ category: 'billing' | 'shipping' | 'bug' | 'other', priority: 'low' | 'normal' | 'high', reply: string }>}
+ */
+export async function triageTicket(model, { customerId, text }) {
+  const getCustomer = tool({
+    description: 'Look up the current customer record.',
+    inputSchema: z.object({ customerId: z.string() }),
+    execute: async ({ customerId: id }) => {
+      const customer = findCustomer(id);
+      return customer ?? { error: 'not found' };
+    },
+  });
+
+  const result = await generateText({
+    model,
+    tools: { getCustomer },
+    system: 'You are a support ticket triage agent. Analyze the customer ticket and classify it. You can look up customer information if needed.',
+    prompt: `Ticket from customer ${customerId}:\n\n${text}`,
+    experimental_output: Output.object({ schema: triageSchema }),
+    stopWhen: stepCountIs(4),
+  });
+
+  const output = result.experimental_output ?? JSON.parse(result.text);
+  return triageSchema.parse(output);
+}
