diff --git a/test/assistant.test.js b/test/assistant.test.js
new file mode 100644
index 0000000..589107b
--- /dev/null
+++ b/test/assistant.test.js
@@ -0,0 +1,87 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { scriptedModel } from './helpers/mock-model.js';
+import {
+  summarizeThread,
+  answerAboutOrders,
+  classifyTicket,
+  continueChat,
+} from '../src/legacy/assistant.js';
+
+test('summarizeThread returns summary with token counts', async () => {
+  const model = scriptedModel([{ text: 'Customer had billing issue, now resolved.' }]);
+  const thread = [
+    { from: 'customer', text: 'Why was I charged twice?' },
+    { from: 'agent', text: 'Let me investigate your account...' },
+    { from: 'agent', text: 'Fixed! You received a refund.' },
+  ];
+
+  const result = await summarizeThread(model, thread);
+  assert.equal(result.summary, 'Customer had billing issue, now resolved.');
+  assert.equal(result.inputTokens, 10);
+  assert.equal(result.cachedInputTokens, 0);
+});
+
+test('answerAboutOrders returns text and tool names used', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [100, 5] },
+    { text: 'Your order A100 has shipped and will arrive Friday.' },
+  ]);
+
+  const result = await answerAboutOrders(model, 'Where is my order?', { customerId: 'C1' });
+  assert.equal(result.text, 'Your order A100 has shipped and will arrive Friday.');
+  assert.deepEqual(result.toolsUsed, ['orderLookup']);
+});
+
+test('answerAboutOrders handles multiple tool calls', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [100, 5] },
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A101' } }], usage: [150, 7] },
+    { text: 'You have two orders.' },
+  ]);
+
+  const result = await answerAboutOrders(model, 'Show all my orders', { customerId: 'C1' });
+  assert.equal(result.text, 'You have two orders.');
+  assert.deepEqual(result.toolsUsed, ['orderLookup', 'orderLookup']);
+});
+
+test('classifyTicket returns validated object', async () => {
+  const model = scriptedModel([
+    { text: JSON.stringify({ category: 'billing', urgent: true }) },
+  ]);
+
+  const result = await classifyTicket(model, 'I was overcharged on my last order!');
+  assert.deepEqual(result, { category: 'billing', urgent: true });
+});
+
+test('continueChat reconstructs message history with tool calls', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [100, 5] },
+    { text: 'Order A100 has shipped!' },
+  ]);
+
+  const history = [
+    { role: 'user', content: 'What orders do I have?' },
+    { role: 'assistant', content: 'Let me check...' },
+  ];
+
+  const result = await continueChat(model, history, 'What about A100?', { customerId: 'C1' });
+
+  assert.equal(result.length, 6);
+  assert.deepEqual(result[0], history[0]);
+  assert.deepEqual(result[1], history[1]);
+  assert.deepEqual(result[2], { role: 'user', content: 'What about A100?' });
+
+  assert.equal(result[3].role, 'assistant');
+  assert.equal(Array.isArray(result[3].content), true);
+  assert.equal(result[3].content[0].type, 'tool-call');
+  assert.equal(result[3].content[0].toolName, 'orderLookup');
+
+  assert.equal(result[4].role, 'tool');
+  assert.equal(Array.isArray(result[4].content), true);
+
+  assert.equal(result[5].role, 'assistant');
+  assert.equal(Array.isArray(result[5].content), true);
+  assert.equal(result[5].content[0].type, 'text');
+  assert(result[5].content[0].text.includes('shipped'));
+});
