diff --git a/test/assistant.test.js b/test/assistant.test.js
new file mode 100644
index 0000000..ca31434
--- /dev/null
+++ b/test/assistant.test.js
@@ -0,0 +1,91 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { scriptedModel } from './helpers/mock-model.js';
+import { summarizeThread, answerAboutOrders, classifyTicket, continueChat } from '../src/legacy/assistant.js';
+
+test('summarizeThread returns summary with token usage', async () => {
+  const model = scriptedModel([
+    { text: 'Customer asked about order. Agent provided status.', usage: [100, 20] },
+  ]);
+
+  const result = await summarizeThread(model, [
+    { from: 'customer', text: 'Where is my order?' },
+    { from: 'agent', text: 'Your order is on the way.' },
+  ]);
+
+  assert.equal(result.summary, 'Customer asked about order. Agent provided status.');
+  assert.equal(result.inputTokens, 100);
+  assert.equal(result.cachedInputTokens, 0);
+});
+
+test('answerAboutOrders returns text and tools used', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [50, 10] },
+    { text: 'Your order A100 is shipped.', usage: [100, 15] },
+  ]);
+
+  const result = await answerAboutOrders(model, 'What is the status of order A100?', { customerId: 'C1' });
+
+  assert.equal(result.text, 'Your order A100 is shipped.');
+  assert.deepEqual(result.toolsUsed, ['orderLookup']);
+});
+
+test('answerAboutOrders with multiple tool calls', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [50, 10] },
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A101' } }], usage: [60, 10] },
+    { text: 'Both orders are shipped.', usage: [100, 15] },
+  ]);
+
+  const result = await answerAboutOrders(model, 'What is the status of orders A100 and A101?', { customerId: 'C1' });
+
+  assert.equal(result.text, 'Both orders are shipped.');
+  assert.deepEqual(result.toolsUsed, ['orderLookup', 'orderLookup']);
+});
+
+test('classifyTicket returns classified ticket', async () => {
+  const model = scriptedModel([
+    { text: '{"category":"billing","urgent":true}', usage: [50, 10] },
+  ]);
+
+  const result = await classifyTicket(model, 'I was charged twice for my order!');
+
+  assert.equal(result.category, 'billing');
+  assert.equal(result.urgent, true);
+});
+
+test('continueChat returns updated history with assistant response', async () => {
+  const model = scriptedModel([
+    { text: 'Your current orders are...', usage: [50, 10] },
+  ]);
+
+  const history = [
+    { role: 'user', content: 'What are my orders?' },
+    { role: 'assistant', content: 'Let me check.' },
+  ];
+
+  const result = await continueChat(model, history, 'Please list them.', { customerId: 'C1' });
+
+  assert.equal(result.length, 4); // 2 history + 1 new user + 1 assistant response
+  assert.equal(result[2].role, 'user');
+  assert.equal(result[2].content, 'Please list them.');
+  assert.equal(result[3].role, 'assistant');
+  assert.equal(result[3].content, 'Your current orders are...');
+});
+
+test('continueChat with tool use', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [50, 10] },
+    { text: 'Order A100 is shipped.', usage: [100, 15] },
+  ]);
+
+  const history = [{ role: 'user', content: 'What are my orders?' }];
+
+  const result = await continueChat(model, history, 'Show me order A100.', { customerId: 'C1' });
+
+  assert.ok(result.length > 2);
+  assert.equal(result[0].role, 'user');
+  assert.equal(result[0].content, 'What are my orders?');
+  assert.equal(result[1].role, 'user');
+  assert.equal(result[1].content, 'Show me order A100.');
+});
