@@ -0,0 +1,10 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+
+const nonRefunds = orders.filter(order => order.amount > 0);
+const total = nonRefunds.reduce((sum, order) => sum + order.amount, 0);
+const average = total / nonRefunds.length;
+
+log(`${average.toFixed(2)}€`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..dbfe63e
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,32 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(readFileSync('./data/orders.json', 'utf-8'));
+
+let problems = 0;
+
+for (let i = 0; i < data.length; i++) {
+  const order = data[i];
+
+  if (!order.id) {
+    log(`Order ${i}: missing id`);
+    problems++;
+  }
+
+  if (!order.customer) {
+    log(`Order ${i}: missing customer`);
+    problems++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: amount is not numeric (got ${typeof order.amount})`);
+    problems++;
+  }
+
+  if (typeof order.date !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(order.date)) {
+    log(`Order ${i}: date is not in YYYY-MM-DD format (got ${order.date})`);
+    problems++;
+  }
+}
+
+log(`${data.length} orders, ${problems} problems`);
