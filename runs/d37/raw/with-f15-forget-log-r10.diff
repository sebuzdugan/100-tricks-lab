+++ b/scripts/average-order.js
@@ -0,0 +1,11 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(fs.readFileSync('./data/orders.json', 'utf-8'));
+
+const orders = data.filter(order => order.amount > 0);
+const total = orders.reduce((sum, order) => sum + order.amount, 0);
+const average = total / orders.length;
+const euros = (average / 100).toFixed(2);
+
+log(`€${euros}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..cd52e4e
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,28 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(fs.readFileSync('./data/orders.json', 'utf-8'));
+
+let problems = 0;
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+
+data.forEach((order, index) => {
+  if (!order.id) {
+    log(`Order ${index}: missing id`);
+    problems++;
+  }
+  if (!order.customer) {
+    log(`Order ${index}: missing customer`);
+    problems++;
+  }
+  if (typeof order.amount !== 'number') {
+    log(`Order ${index}: amount is not numeric`);
+    problems++;
+  }
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${index}: invalid or missing date (expected YYYY-MM-DD)`);
+    problems++;
+  }
+});
+
+log(`${data.length} orders, ${problems} problems`);
