diff --git a/scripts/revenue-by-month.js b/scripts/revenue-by-month.js
new file mode 100644
index 0000000..3fbdc7a
--- /dev/null
+++ b/scripts/revenue-by-month.js
@@ -0,0 +1,20 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(readFileSync('data/orders.json', 'utf-8'));
+
+const monthlyRevenue = {};
+orders.forEach(order => {
+  const month = order.date.substring(0, 7);
+  if (!monthlyRevenue[month]) {
+    monthlyRevenue[month] = 0;
+  }
+  monthlyRevenue[month] += order.amount;
+});
+
+const sorted = Object.entries(monthlyRevenue).sort((a, b) => a[0].localeCompare(b[0]));
+
+sorted.forEach(([month, total]) => {
+  const euros = (total / 100).toFixed(2);
+  log(`${month}: €${euros}`);
+});
diff --git a/scripts/search.js b/scripts/search.js
new file mode 100644
index 0000000..4d44454
--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,21 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const searchText = process.argv[2];
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const orders = JSON.parse(readFileSync('data/orders.json', 'utf-8'));
+const matches = orders.filter(order =>
+  order.customer.toLowerCase().includes(searchText.toLowerCase())
+);
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  matches.forEach(order => {
+    log(`${order.id} - ${order.customer} - €${(order.amount / 100).toFixed(2)} - ${order.date}`);
+  });
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..4910220
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,15 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders('data/orders.json');
+}
+
+const end = performance.now();
+const totalMs = end - start;
+const avgMs = (totalMs / iterations).toFixed(4);
+
+log(`Average time per call: ${avgMs}ms (${iterations} iterations, ${totalMs.toFixed(2)}ms total)`);
