new file mode 100644
index 0000000..2d458f3
--- /dev/null
+++ b/scripts/export-csv.js
@@ -0,0 +1,15 @@
+import { readFileSync } from 'fs';
+
+const orders = JSON.parse(readFileSync('data/orders.json', 'utf-8'));
+
+const escapeCSV = (value) => {
+  if (typeof value === 'string' && (value.includes(',') || value.includes('"') || value.includes('\n'))) {
+    return '"' + value.replace(/"/g, '""') + '"';
+  }
+  return value;
+};
+
+console.log('id,customer,amount,date');
+orders.forEach(order => {
+  console.log(`${escapeCSV(order.id)},${escapeCSV(order.customer)},${order.amount},${order.date}`);
+});
