+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(readFileSync('data/orders.json', 'utf-8'));
+
+const validOrders = orders.filter(order => order.amount > 0);
+const total = validOrders.reduce((sum, order) => sum + order.amount, 0);
+const average = (total / validOrders.length / 100).toFixed(2);
+
+log(`€${average}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..22a35fe
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,27 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(readFileSync('data/orders.json', 'utf-8'));
+
+let problems = 0;
+
+orders.forEach((order, index) => {
+  if (!order.id) {
+    log(`Order ${index}: missing id`);
+    problems++;
+  }
+  if (!order.customer) {
+    log(`Order ${index}: missing customer`);
+    problems++;
+  }
+  if (typeof order.amount !== 'number') {
+    log(`Order ${index}: amount is not numeric`);
+    problems++;
+  }
+  if (!order.date || !/^\d{4}-\d{2}-\d{2}$/.test(order.date)) {
+    log(`Order ${index}: invalid date format`);
+    problems++;
+  }
+});
+
+log(`${orders.length} orders, ${problems} problems`);
