--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,33 @@
+import { log } from '../src/log.js';
+import fs from 'fs';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf8'));
+
+const problems = [];
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+
+for (let i = 0; i < orders.length; i++) {
+  const order = orders[i];
+
+  if (!order.id || typeof order.id !== 'string') {
+    problems.push(`Order ${i}: missing or invalid id`);
+  }
+
+  if (!order.customer || typeof order.customer !== 'string') {
+    problems.push(`Order ${i}: missing or invalid customer`);
+  }
+
+  if (typeof order.amount !== 'number') {
+    problems.push(`Order ${i}: missing or invalid amount`);
+  }
+
+  if (!order.date || !dateRegex.test(order.date)) {
+    problems.push(`Order ${i}: missing or invalid date (expected YYYY-MM-DD)`);
+  }
+}
+
+for (const problem of problems) {
+  log(problem);
+}
+
+log(`${orders.length} orders, ${problems.length} problems`);
