diff --git a/scripts/export-csv.js b/scripts/export-csv.js
new file mode 100644
index 0000000..39a4f4a
--- /dev/null
+++ b/scripts/export-csv.js
@@ -0,0 +1,19 @@
+import { log } from '../src/log.js';
+import fs from 'fs';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf8'));
+
+const escapeCSV = (value) => {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+};
+
+log('id,customer,amount,date');
+
+for (const order of orders) {
+  const row = [order.id, order.customer, order.amount, order.date].map(escapeCSV).join(',');
+  log(row);
+}
