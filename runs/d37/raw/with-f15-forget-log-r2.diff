+++ b/scripts/average-order.js
@@ -0,0 +1,10 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(fs.readFileSync('./data/orders.json', 'utf-8'));
+
+const orders = data.filter(order => order.amount > 0);
+const total = orders.reduce((sum, order) => sum + order.amount, 0);
+const average = total / orders.length;
+
+log(`€${average.toFixed(2)}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..774a1a8
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,32 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(fs.readFileSync('./data/orders.json', 'utf-8'));
+
+let problems = 0;
+
+for (let i = 0; i < data.length; i++) {
+  const order = data[i];
+
+  if (!order.id) {
+    log(`Order ${i}: missing id`);
+    problems++;
+  }
+
+  if (!order.customer) {
+    log(`Order ${i}: missing customer`);
+    problems++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: amount is not numeric`);
+    problems++;
+  }
+
+  if (!order.date || !/^\d{4}-\d{2}-\d{2}$/.test(order.date)) {
+    log(`Order ${i}: invalid date format (expected YYYY-MM-DD)`);
+    problems++;
+  }
+}
+
+log(`${data.length} orders, ${problems} problems`);
