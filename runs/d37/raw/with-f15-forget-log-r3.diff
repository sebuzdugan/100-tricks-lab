@@ -0,0 +1,13 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+const validOrders = orders.filter(order => order.amount > 0);
+
+if (validOrders.length === 0) {
+  log('No valid orders found');
+} else {
+  const total = validOrders.reduce((sum, order) => sum + order.amount, 0);
+  const average = total / validOrders.length / 100;
+  log(`€${average.toFixed(2)}`);
+}
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..06335fb
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,37 @@
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { log } from '../src/log.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const ordersPath = path.join(__dirname, '../data/orders.json');
+const orders = JSON.parse(fs.readFileSync(ordersPath, 'utf8'));
+
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+let problemCount = 0;
+
+for (let i = 0; i < orders.length; i++) {
+  const order = orders[i];
+
+  if (!order.id) {
+    log(`Order ${i}: missing id`);
+    problemCount++;
+  }
+
+  if (!order.customer) {
+    log(`Order ${i}: missing customer`);
+    problemCount++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: amount is not numeric (${typeof order.amount})`);
+    problemCount++;
+  }
+
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${i}: invalid date format (${order.date})`);
+    problemCount++;
+  }
+}
+
+log(`${orders.length} orders, ${problemCount} problems`);
