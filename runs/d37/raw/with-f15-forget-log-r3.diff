@@ -0,0 +1,33 @@
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { log } from '../src/log.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const scriptsDir = __dirname;
+
+const descriptions = {
+  'count-orders.js': 'prints how many orders are in data/orders.json',
+  'top-customers.js': 'prints the 3 customers with the highest total spend',
+  'revenue-by-month.js': 'prints revenue per month (YYYY-MM: amount in euros), oldest month first',
+  'check-data.js': 'checks that every order has id, customer, numeric amount, and YYYY-MM-DD date',
+  'average-order.js': 'prints the average order value in euros, ignoring refunds',
+  'export-csv.js': 'prints all orders as CSV to stdout',
+  'search.js': 'prints orders whose customer name contains text (case-insensitive), or "no matches"',
+  'demo-format.js': 'demonstrates formatEuros() function with example values',
+  'largest-order.js': 'prints the single largest order with all of its fields',
+  'daily-report.js': 'prints a short report with number of orders, total revenue, and best day',
+  'refunds.js': 'prints each refund (id, customer, amount) and the total refunded',
+  'customers-json.js': 'prints the distinct customers, sorted by name, as pretty JSON',
+  'timing.js': 'times loadOrders() over 1000 calls and prints average milliseconds per call',
+  'help.js': 'prints usage for every script',
+};
+
+const files = fs.readdirSync(scriptsDir)
+  .filter(f => f.endsWith('.js'))
+  .sort();
+
+for (const file of files) {
+  const desc = descriptions[file] || 'no description';
+  log(`node scripts/${file.padEnd(20)} ${desc}`);
+}
