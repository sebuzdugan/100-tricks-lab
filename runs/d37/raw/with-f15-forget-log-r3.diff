+import { loadOrders } from '../src/data.js';
+import { formatEuros } from '../src/format.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+const refunds = orders.filter(order => order.amount < 0);
+
+if (refunds.length === 0) {
+  log('No refunds');
+} else {
+  for (const refund of refunds) {
+    log(`${refund.id} ${refund.customer} ${formatEuros(refund.amount)}`);
+  }
+
+  const totalRefunded = refunds.reduce((sum, refund) => sum + refund.amount, 0);
+  log(`Total refunded: ${formatEuros(totalRefunded)}`);
+}
diff --git a/scripts/revenue-by-month.js b/scripts/revenue-by-month.js
new file mode 100644
index 0000000..0092fdd
--- /dev/null
+++ b/scripts/revenue-by-month.js
@@ -0,0 +1,26 @@
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { log } from '../src/log.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const ordersPath = path.join(__dirname, '../data/orders.json');
+const orders = JSON.parse(fs.readFileSync(ordersPath, 'utf8'));
+
+const monthlyRevenue = {};
+
+for (const order of orders) {
+  const month = order.date.slice(0, 7);
+  if (!monthlyRevenue[month]) {
+    monthlyRevenue[month] = 0;
+  }
+  monthlyRevenue[month] += order.amount;
+}
+
+const sorted = Object.entries(monthlyRevenue)
+  .sort((a, b) => a[0].localeCompare(b[0]));
+
+for (const [month, total] of sorted) {
+  const euros = (total / 100).toFixed(2);
+  log(`${month}: €${euros}`);
+}
diff --git a/scripts/search.js b/scripts/search.js
new file mode 100644
index 0000000..aa6328b
--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,22 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const searchText = process.argv[2];
+
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const orders = loadOrders();
+const matches = orders.filter(order =>
+  order.customer.toLowerCase().includes(searchText.toLowerCase())
+);
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  for (const order of matches) {
+    log(`${order.id} ${order.customer} €${(order.amount / 100).toFixed(2)} ${order.date}`);
+  }
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..476ad17
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,15 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders();
+}
+
+const end = performance.now();
+const totalMs = end - start;
+const avgMs = totalMs / iterations;
+
+log(`${iterations} calls: ${totalMs.toFixed(2)}ms total, ${avgMs.toFixed(4)}ms average`);
