@@ -0,0 +1,11 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+
+const validOrders = orders.filter(order => order.amount > 0);
+const total = validOrders.reduce((sum, order) => sum + order.amount, 0);
+const average = total / validOrders.length;
+const euros = (average / 100).toFixed(2);
+
+log(`€${euros}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..8f93886
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,35 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const ordersData = fs.readFileSync('data/orders.json', 'utf-8');
+const orders = JSON.parse(ordersData);
+
+let problemCount = 0;
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+
+orders.forEach((order, index) => {
+  const problems = [];
+
+  if (!order.id || typeof order.id !== 'string') {
+    problems.push('missing or invalid id');
+  }
+
+  if (!order.customer || typeof order.customer !== 'string') {
+    problems.push('missing or invalid customer');
+  }
+
+  if (typeof order.amount !== 'number') {
+    problems.push('missing or invalid numeric amount');
+  }
+
+  if (!order.date || typeof order.date !== 'string' || !dateRegex.test(order.date)) {
+    problems.push('missing or invalid YYYY-MM-DD date');
+  }
+
+  problems.forEach(problem => {
+    log(`Order ${index}: ${problem}`);
+    problemCount++;
+  });
+});
+
+log(`${orders.length} orders, ${problemCount} problems`);
