diff --git a/scripts/export-csv.js b/scripts/export-csv.js
new file mode 100644
index 0000000..ecfabc9
--- /dev/null
+++ b/scripts/export-csv.js
@@ -0,0 +1,22 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+
+const escapeCsv = (value) => {
+  if (value == null) return '';
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+};
+
+log('id,customer,amount,date');
+
+orders.forEach(order => {
+  const row = [order.id, order.customer, order.amount, order.date]
+    .map(escapeCsv)
+    .join(',');
+  log(row);
+});
