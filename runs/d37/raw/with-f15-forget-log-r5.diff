diff --git a/scripts/daily-report.js b/scripts/daily-report.js
new file mode 100644
index 0000000..11bd8d4
--- /dev/null
+++ b/scripts/daily-report.js
@@ -0,0 +1,21 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const totalOrders = data.length;
+const totalRevenue = data.reduce((sum, order) => sum + order.amount, 0);
+
+const dailyRevenue = {};
+for (const order of data) {
+  dailyRevenue[order.date] = (dailyRevenue[order.date] || 0) + order.amount;
+}
+
+const bestDay = Object.entries(dailyRevenue).reduce((max, [date, revenue]) =>
+  revenue > max[1] ? [date, revenue] : max
+);
+
+log('Daily Report');
+log(`Total orders: ${totalOrders}`);
+log(`Total revenue: €${totalRevenue}`);
+log(`Best day: ${bestDay[0]} (€${bestDay[1]})`);
