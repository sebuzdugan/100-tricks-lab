+++ b/scripts/help.js
@@ -0,0 +1,28 @@
+import fs from 'fs';
+import path from 'path';
+import { log } from '../src/log.js';
+
+const scriptsDir = new URL('.', import.meta.url).pathname;
+const files = fs.readdirSync(scriptsDir).filter(f => f.endsWith('.js')).sort();
+
+const descriptions = {
+  'count-orders.js': 'Print the number of orders in data/orders.json',
+  'top-customers.js': 'Print the 3 customers with the highest total spend',
+  'revenue-by-month.js': 'Print revenue per month (YYYY-MM format)',
+  'check-data.js': 'Validate that every order has required fields',
+  'average-order.js': 'Print the average order value (excluding refunds)',
+  'export-csv.js': 'Export all orders as CSV to stdout',
+  'search.js': 'Search for orders by customer name (case-insensitive)',
+  'demo-format.js': 'Demo the formatEuros function with example values',
+  'largest-order.js': 'Print the single largest order with all fields',
+  'daily-report.js': 'Print a report with orders, revenue, and best day',
+  'refunds.js': 'Print all refunds and the total refunded',
+  'customers-json.js': 'Print distinct customers sorted by name as JSON',
+  'timing.js': 'Benchmark loadOrders() over 1000 calls',
+  'help.js': 'Print this help message',
+};
+
+for (const file of files) {
+  const desc = descriptions[file] || 'Unknown';
+  log(`${file.padEnd(20)} ${desc}`);
+}
