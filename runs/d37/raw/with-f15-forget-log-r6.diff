 }
diff --git a/src/format.js b/src/format.js
new file mode 100644
index 0000000..959e293
--- /dev/null
+++ b/src/format.js
@@ -0,0 +1,6 @@
+export function formatEuros(cents) {
+  const euros = Math.abs(cents) / 100;
+  const sign = cents < 0 ? '-' : '';
+  const formatted = euros.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+  return `${sign}€${formatted}`;
+}
