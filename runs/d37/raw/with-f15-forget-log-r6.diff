+++ b/scripts/average-order.js
@@ -0,0 +1,13 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+const nonRefunds = orders.filter(order => order.amount > 0);
+
+if (nonRefunds.length === 0) {
+  log('No orders found');
+} else {
+  const total = nonRefunds.reduce((sum, order) => sum + order.amount, 0);
+  const average = total / nonRefunds.length / 100;
+  log(`€${average.toFixed(2)}`);
+}
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..7a053ac
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,37 @@
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { log } from '../src/log.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const ordersPath = path.join(__dirname, '../data/orders.json');
+const data = JSON.parse(fs.readFileSync(ordersPath, 'utf8'));
+
+let problems = 0;
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+
+for (let i = 0; i < data.length; i++) {
+  const order = data[i];
+
+  if (!order.id) {
+    log(`Order ${i}: missing id`);
+    problems++;
+  }
+
+  if (!order.customer) {
+    log(`Order ${i}: missing customer`);
+    problems++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: amount is not numeric`);
+    problems++;
+  }
+
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${i}: invalid date format (expected YYYY-MM-DD)`);
+    problems++;
+  }
+}
+
+log(`${data.length} orders, ${problems} problems`);
