+++ b/scripts/daily-report.js
@@ -0,0 +1,32 @@
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { log } from '../src/log.js';
+import { formatEuros } from '../src/format.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const ordersPath = path.join(__dirname, '../data/orders.json');
+const data = JSON.parse(fs.readFileSync(ordersPath, 'utf-8'));
+
+const dailyRevenue = {};
+
+for (const order of data) {
+  const date = order.date;
+  if (!dailyRevenue[date]) {
+    dailyRevenue[date] = 0;
+  }
+  dailyRevenue[date] += order.amount;
+}
+
+let bestDay = Object.entries(dailyRevenue)[0];
+for (const [date, revenue] of Object.entries(dailyRevenue)) {
+  if (revenue > bestDay[1]) {
+    bestDay = [date, revenue];
+  }
+}
+
+const totalRevenue = data.reduce((sum, order) => sum + order.amount, 0);
+
+log(`Orders: ${data.length}`);
+log(`Total Revenue: ${formatEuros(totalRevenue)}`);
+log(`Best Day: ${bestDay[0]} (${formatEuros(bestDay[1])})`);
