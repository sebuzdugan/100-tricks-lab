+++ b/scripts/top-customers.js
@@ -0,0 +1,17 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(readFileSync('data/orders.json', 'utf-8'));
+
+const customerTotals = {};
+for (const order of orders) {
+  customerTotals[order.customer] = (customerTotals[order.customer] || 0) + order.amount;
+}
+
+const sorted = Object.entries(customerTotals)
+  .sort((a, b) => b[1] - a[1])
+  .slice(0, 3);
+
+for (const [customer, total] of sorted) {
+  log(`${customer}: ${(total / 100).toFixed(2)} EUR`);
+}
