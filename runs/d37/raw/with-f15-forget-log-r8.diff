diff --git a/scripts/daily-report.js b/scripts/daily-report.js
new file mode 100644
index 0000000..6e2a4dc
--- /dev/null
+++ b/scripts/daily-report.js
@@ -0,0 +1,20 @@
+import { loadOrders } from '../src/data.js';
+import { formatEuros } from '../src/format.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+
+const totalRevenue = orders.reduce((sum, order) => sum + order.amount, 0);
+
+const dailyRevenue = {};
+for (const order of orders) {
+  dailyRevenue[order.date] = (dailyRevenue[order.date] || 0) + order.amount;
+}
+
+const bestDay = Object.entries(dailyRevenue).reduce((max, [date, revenue]) =>
+  revenue > max[1] ? [date, revenue] : max
+);
+
+log(`Orders: ${orders.length}`);
+log(`Total Revenue: ${formatEuros(totalRevenue)}`);
+log(`Best Day: ${bestDay[0]} (${formatEuros(bestDay[1])})`);
