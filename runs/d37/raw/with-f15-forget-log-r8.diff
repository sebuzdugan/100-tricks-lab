@@ -0,0 +1,16 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(readFileSync('data/orders.json', 'utf-8'));
+
+const monthlyRevenue = {};
+for (const order of orders) {
+  const month = order.date.substring(0, 7);
+  monthlyRevenue[month] = (monthlyRevenue[month] || 0) + order.amount;
+}
+
+const sorted = Object.entries(monthlyRevenue).sort();
+
+for (const [month, total] of sorted) {
+  log(`${month}: ${(total / 100).toFixed(2)} EUR`);
+}
diff --git a/scripts/search.js b/scripts/search.js
new file mode 100644
index 0000000..9e6849d
--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,22 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const searchText = process.argv[2];
+
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const orders = loadOrders();
+const matches = orders.filter(order =>
+  order.customer.toLowerCase().includes(searchText.toLowerCase())
+);
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  for (const order of matches) {
+    log(JSON.stringify(order));
+  }
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..460385f
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,15 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders();
+}
+
+const end = performance.now();
+const totalMs = end - start;
+const avgMs = totalMs / iterations;
+
+log(`Average time per loadOrders() call: ${avgMs.toFixed(3)} ms`);
