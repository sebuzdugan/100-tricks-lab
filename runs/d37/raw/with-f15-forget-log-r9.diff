diff --git a/scripts/daily-report.js b/scripts/daily-report.js
new file mode 100644
index 0000000..d22dc61
--- /dev/null
+++ b/scripts/daily-report.js
@@ -0,0 +1,31 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+import { formatEuros } from '../src/format.js';
+
+const ordersData = readFileSync('./data/orders.json', 'utf-8');
+const orders = JSON.parse(ordersData);
+
+const orderCount = orders.length;
+const totalRevenue = orders.reduce((sum, order) => sum + order.amount, 0);
+
+const dailyRevenue = {};
+for (const order of orders) {
+  if (!dailyRevenue[order.date]) {
+    dailyRevenue[order.date] = 0;
+  }
+  dailyRevenue[order.date] += order.amount;
+}
+
+let bestDay = null;
+let bestDayRevenue = -Infinity;
+for (const [date, revenue] of Object.entries(dailyRevenue)) {
+  if (revenue > bestDayRevenue) {
+    bestDay = date;
+    bestDayRevenue = revenue;
+  }
+}
+
+log('=== Daily Report ===');
+log(`Orders: ${orderCount}`);
+log(`Total Revenue: ${formatEuros(totalRevenue)}`);
+log(`Best Day: ${bestDay} (${formatEuros(bestDayRevenue)})`);
