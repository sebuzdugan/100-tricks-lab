diff --git a/scripts/export-csv.js b/scripts/export-csv.js
new file mode 100644
index 0000000..351ee50
--- /dev/null
+++ b/scripts/export-csv.js
@@ -0,0 +1,26 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const ordersData = readFileSync('./data/orders.json', 'utf-8');
+const orders = JSON.parse(ordersData);
+
+function escapeCSV(value) {
+  if (value === null || value === undefined) return '';
+  const stringValue = String(value);
+  if (stringValue.includes(',') || stringValue.includes('"') || stringValue.includes('\n')) {
+    return '"' + stringValue.replace(/"/g, '""') + '"';
+  }
+  return stringValue;
+}
+
+log('id,customer,amount,date');
+
+for (const order of orders) {
+  const row = [
+    escapeCSV(order.id),
+    escapeCSV(order.customer),
+    escapeCSV(order.amount),
+    escapeCSV(order.date)
+  ].join(',');
+  log(row);
+}
