@@ -0,0 +1,13 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const ordersData = readFileSync('./data/orders.json', 'utf-8');
+const orders = JSON.parse(ordersData);
+
+const nonRefundOrders = orders.filter(order => order.amount > 0);
+
+const totalAmount = nonRefundOrders.reduce((sum, order) => sum + order.amount, 0);
+const average = totalAmount / nonRefundOrders.length;
+const euros = (average / 100).toFixed(2);
+
+log(`€${euros}`);
