diff --git a/scripts/export-csv.js b/scripts/export-csv.js
new file mode 100644
index 0000000..12cd7ba
--- /dev/null
+++ b/scripts/export-csv.js
@@ -0,0 +1,17 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const quote = (value) => {
+  if (typeof value === 'string' && (value.includes(',') || value.includes('"') || value.includes('\n'))) {
+    return '"' + value.replace(/"/g, '""') + '"';
+  }
+  return value;
+};
+
+log('id,customer,amount,date');
+
+for (const order of orders) {
+  log(`${quote(order.id)},${quote(order.customer)},${order.amount},${order.date}`);
+}
