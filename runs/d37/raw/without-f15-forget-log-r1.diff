@@ -0,0 +1,10 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const salesOrders = orders.filter(order => order.amount > 0);
+const total = salesOrders.reduce((sum, order) => sum + order.amount, 0);
+const average = total / salesOrders.length;
+
+log(`€${(average / 100).toFixed(2)}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..7304e10
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,33 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+let problems = 0;
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+
+for (let i = 0; i < orders.length; i++) {
+  const order = orders[i];
+
+  if (!order.id) {
+    log(`Order ${i}: missing id`);
+    problems++;
+  }
+
+  if (!order.customer) {
+    log(`Order ${i}: missing customer`);
+    problems++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: amount is not numeric`);
+    problems++;
+  }
+
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${i}: invalid date format`);
+    problems++;
+  }
+}
+
+log(`${orders.length} orders, ${problems} problems`);
