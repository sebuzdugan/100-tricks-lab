+++ b/scripts/average-order.js
@@ -0,0 +1,9 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+const nonRefunds = orders.filter(order => order.amount > 0);
+const average = nonRefunds.reduce((sum, order) => sum + order.amount, 0) / nonRefunds.length;
+const euros = (average / 100).toFixed(2);
+
+log(`Average order value: €${euros}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..1ea740a
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,28 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(fs.readFileSync('./data/orders.json', 'utf8'));
+
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+let problemCount = 0;
+
+data.forEach((order, index) => {
+  if (!order.id) {
+    log(`Order ${index}: missing id`);
+    problemCount++;
+  }
+  if (!order.customer) {
+    log(`Order ${index}: missing customer`);
+    problemCount++;
+  }
+  if (typeof order.amount !== 'number') {
+    log(`Order ${index}: amount is not numeric`);
+    problemCount++;
+  }
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${index}: invalid date`);
+    problemCount++;
+  }
+});
+
+log(`${data.length} orders, ${problemCount} problems`);
