@@ -0,0 +1,30 @@
+import fs from 'fs';
+import path from 'path';
+import { log } from '../src/log.js';
+
+const scriptsDir = './scripts';
+const descriptions = {
+  'count-orders.js': 'Print the total number of orders',
+  'top-customers.js': 'Print the 3 customers with the highest total spend',
+  'revenue-by-month.js': 'Print revenue per month (YYYY-MM: amount in euros)',
+  'check-data.js': 'Validate that every order has required fields',
+  'average-order.js': 'Print the average order value in euros, ignoring refunds',
+  'export-csv.js': 'Export all orders as CSV to stdout',
+  'search.js': 'Search for orders by customer name (usage: node scripts/search.js <text>)',
+  'demo-format.js': 'Print example formatted euro values',
+  'largest-order.js': 'Print the single largest order with all fields',
+  'daily-report.js': 'Print a report with order count, total revenue, and best day',
+  'refunds.js': 'Print each refund and the total refunded',
+  'customers-json.js': 'Print distinct customers sorted by name as JSON',
+  'timing.js': 'Time loadOrders() over 1000 calls and print average milliseconds',
+  'help.js': 'Print this help message',
+};
+
+const files = fs.readdirSync(scriptsDir)
+  .filter(f => f.endsWith('.js'))
+  .sort();
+
+files.forEach(file => {
+  const desc = descriptions[file] || 'No description available';
+  log(`  node scripts/${file.padEnd(20)} ${desc}`);
+});
