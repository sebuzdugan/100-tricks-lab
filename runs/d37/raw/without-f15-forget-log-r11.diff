+
+log(`€${average.toFixed(2)}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..be41381
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,33 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(fs.readFileSync('data/orders.json', 'utf8'));
+
+let problemCount = 0;
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+
+for (let i = 0; i < data.length; i++) {
+  const order = data[i];
+
+  if (!order.id) {
+    log(`Order ${i}: missing id`);
+    problemCount++;
+  }
+
+  if (!order.customer) {
+    log(`Order ${i}: missing customer`);
+    problemCount++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: amount is not numeric`);
+    problemCount++;
+  }
+
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${i}: invalid date format`);
+    problemCount++;
+  }
+}
+
+log(`${data.length} orders, ${problemCount} problems`);
