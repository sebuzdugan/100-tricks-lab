diff --git a/scripts/daily-report.js b/scripts/daily-report.js
new file mode 100644
index 0000000..86f394e
--- /dev/null
+++ b/scripts/daily-report.js
@@ -0,0 +1,19 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(fs.readFileSync('data/orders.json', 'utf8'));
+
+const totalRevenue = data.reduce((sum, order) => sum + order.amount, 0);
+
+const dailyRevenue = {};
+for (const order of data) {
+  dailyRevenue[order.date] = (dailyRevenue[order.date] || 0) + order.amount;
+}
+
+const bestDay = Object.entries(dailyRevenue).reduce((max, [date, amount]) =>
+  amount > max[1] ? [date, amount] : max
+);
+
+log(`Orders: ${data.length}`);
+log(`Total Revenue: €${totalRevenue}`);
+log(`Best Day: ${bestDay[0]} (€${bestDay[1]})`);
