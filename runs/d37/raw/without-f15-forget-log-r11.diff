diff --git a/scripts/revenue-by-month.js b/scripts/revenue-by-month.js
new file mode 100644
index 0000000..fbb8149
--- /dev/null
+++ b/scripts/revenue-by-month.js
@@ -0,0 +1,16 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const data = JSON.parse(fs.readFileSync('data/orders.json', 'utf8'));
+
+const monthlyRevenue = {};
+for (const order of data) {
+  const month = order.date.slice(0, 7);
+  monthlyRevenue[month] = (monthlyRevenue[month] || 0) + order.amount;
+}
+
+const sorted = Object.entries(monthlyRevenue).sort((a, b) => a[0].localeCompare(b[0]));
+
+for (const [month, amount] of sorted) {
+  log(`${month}: €${amount}`);
+}
diff --git a/scripts/search.js b/scripts/search.js
new file mode 100644
index 0000000..8ae0360
--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,22 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const searchText = process.argv[2];
+
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const data = JSON.parse(fs.readFileSync('data/orders.json', 'utf8'));
+const matches = data.filter(order =>
+  order.customer.toLowerCase().includes(searchText.toLowerCase())
+);
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  for (const order of matches) {
+    log(`${order.id}: ${order.customer}, €${order.amount}, ${order.date}`);
+  }
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..702e80c
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,15 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders();
+}
+
+const end = performance.now();
+const totalMs = end - start;
+const averageMs = totalMs / iterations;
+
+log(`Average: ${averageMs.toFixed(3)}ms per call (${totalMs.toFixed(0)}ms for ${iterations} calls)`);
