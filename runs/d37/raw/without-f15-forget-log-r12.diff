diff --git a/scripts/help.js b/scripts/help.js
new file mode 100644
index 0000000..53ecc91
--- /dev/null
+++ b/scripts/help.js
@@ -0,0 +1,27 @@
+import fs from 'fs';
+import path from 'path';
+import { log } from '../src/log.js';
+
+const scriptsDir = path.dirname(new URL(import.meta.url).pathname);
+const files = fs.readdirSync(scriptsDir).filter(f => f.endsWith('.js') && f !== 'help.js').sort();
+
+const descriptions = {
+  'average-order.js': 'prints the average order value in euros, ignoring refunds',
+  'check-data.js': 'validates that all orders have required fields and formats',
+  'count-orders.js': 'prints how many orders are in data/orders.json',
+  'customers-json.js': 'prints distinct customers sorted by name as pretty JSON',
+  'daily-report.js': 'prints a report with order count, total revenue, and best day',
+  'demo-format.js': 'demonstrates the formatEuros function with example values',
+  'export-csv.js': 'prints all orders as CSV to stdout',
+  'largest-order.js': 'prints the single largest order with all its fields',
+  'refunds.js': 'prints each refund and the total refunded amount',
+  'revenue-by-month.js': 'prints revenue per month (YYYY-MM), oldest month first',
+  'search.js': 'prints every order whose customer name contains the search text',
+  'timing.js': 'times loadOrders() over 1000 calls and prints average milliseconds',
+  'top-customers.js': 'prints the 3 customers with the highest total spend',
+};
+
+files.forEach(file => {
+  const desc = descriptions[file] || 'no description';
+  log(`node scripts/${file} - ${desc}`);
+});
