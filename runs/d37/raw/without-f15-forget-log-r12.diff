@@ -0,0 +1,10 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const positiveOrders = orders.filter(order => order.amount > 0);
+const sum = positiveOrders.reduce((acc, order) => acc + order.amount, 0);
+const average = sum / positiveOrders.length;
+
+log(`€${average.toFixed(2)}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..f86bb77
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,28 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+let problemCount = 0;
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+
+orders.forEach((order, index) => {
+  if (!order.id) {
+    log(`Order ${index}: missing id`);
+    problemCount++;
+  }
+  if (!order.customer) {
+    log(`Order ${index}: missing customer`);
+    problemCount++;
+  }
+  if (typeof order.amount !== 'number') {
+    log(`Order ${index}: amount is not numeric`);
+    problemCount++;
+  }
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${index}: invalid date format`);
+    problemCount++;
+  }
+});
+
+log(`${orders.length} orders, ${problemCount} problems`);
