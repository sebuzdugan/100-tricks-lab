--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,23 @@
+import fs from 'fs';
+import path from 'path';
+import { log } from '../src/log.js';
+
+const searchText = process.argv[2];
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const ordersPath = path.join(import.meta.dirname, '../data/orders.json');
+const orders = JSON.parse(fs.readFileSync(ordersPath, 'utf-8'));
+
+const searchLower = searchText.toLowerCase();
+const matches = orders.filter(order => order.customer.toLowerCase().includes(searchLower));
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  for (const order of matches) {
+    log(JSON.stringify(order));
+  }
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..ea7a51c
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,15 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders();
+}
+
+const end = performance.now();
+const totalMs = end - start;
+const avgMs = (totalMs / iterations).toFixed(3);
+
+log(`Average: ${avgMs}ms per call`);
