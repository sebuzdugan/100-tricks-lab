--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,33 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const ordersData = readFileSync('data/orders.json', 'utf-8');
+const orders = JSON.parse(ordersData);
+
+let problemCount = 0;
+
+for (let i = 0; i < orders.length; i++) {
+  const order = orders[i];
+
+  if (!order.id) {
+    log(`Order ${i}: missing id`);
+    problemCount++;
+  }
+
+  if (!order.customer) {
+    log(`Order ${i}: missing customer`);
+    problemCount++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: amount is not numeric`);
+    problemCount++;
+  }
+
+  if (!order.date || !/^\d{4}-\d{2}-\d{2}$/.test(order.date)) {
+    log(`Order ${i}: invalid date format (expected YYYY-MM-DD)`);
+    problemCount++;
+  }
+}
+
+log(`${orders.length} orders, ${problemCount} problems`);
