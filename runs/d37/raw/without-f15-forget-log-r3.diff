diff --git a/scripts/revenue-by-month.js b/scripts/revenue-by-month.js
new file mode 100644
index 0000000..4aa3e8c
--- /dev/null
+++ b/scripts/revenue-by-month.js
@@ -0,0 +1,21 @@
+import { readFileSync } from 'fs';
+import { log } from '../src/log.js';
+
+const ordersData = readFileSync('data/orders.json', 'utf-8');
+const orders = JSON.parse(ordersData);
+
+const monthlyRevenue = {};
+for (const order of orders) {
+  const month = order.date.slice(0, 7);
+  if (!monthlyRevenue[month]) {
+    monthlyRevenue[month] = 0;
+  }
+  monthlyRevenue[month] += order.amount;
+}
+
+const sorted = Object.entries(monthlyRevenue).sort((a, b) => a[0].localeCompare(b[0]));
+
+for (const [month, total] of sorted) {
+  const euros = (total / 100).toFixed(2);
+  log(`${month}: €${euros}`);
+}
