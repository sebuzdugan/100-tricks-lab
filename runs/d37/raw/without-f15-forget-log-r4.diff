+++ b/scripts/help.js
@@ -0,0 +1,26 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const scripts = {
+  'average-order.js': 'prints the average order value in euros (ignoring refunds)',
+  'check-data.js': 'validates orders and prints any data problems found',
+  'count-orders.js': 'prints how many orders are in data/orders.json',
+  'customers-json.js': 'prints distinct customers sorted by name as JSON',
+  'daily-report.js': 'prints a report with orders count, total revenue, and best day',
+  'demo-format.js': 'demonstrates the formatEuros function with example values',
+  'export-csv.js': 'prints all orders as CSV (with header row)',
+  'largest-order.js': 'prints the single largest order with all fields',
+  'refunds.js': 'prints each refund and the total refunded amount',
+  'revenue-by-month.js': 'prints revenue per month (YYYY-MM format, oldest first)',
+  'search.js': 'search for orders by customer name (case-insensitive)',
+  'timing.js': 'times loadOrders() over 1000 calls and prints average ms per call',
+  'top-customers.js': 'prints the 3 customers with highest total spend',
+};
+
+log('Usage:');
+log('');
+
+const sortedScripts = Object.keys(scripts).sort();
+for (const script of sortedScripts) {
+  log(`  node scripts/${script.padEnd(20)} ${scripts[script]}`);
+}
