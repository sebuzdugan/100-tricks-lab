diff --git a/scripts/daily-report.js b/scripts/daily-report.js
new file mode 100644
index 0000000..042f9fc
--- /dev/null
+++ b/scripts/daily-report.js
@@ -0,0 +1,24 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+
+const totalRevenue = orders.reduce((sum, order) => sum + order.amount, 0);
+
+const revenueByDay = {};
+for (const order of orders) {
+  if (!revenueByDay[order.date]) {
+    revenueByDay[order.date] = 0;
+  }
+  revenueByDay[order.date] += order.amount;
+}
+
+const bestDay = Object.entries(revenueByDay).reduce((max, [date, revenue]) =>
+  revenue > max[1] ? [date, revenue] : max
+);
+
+log(`Daily Report`);
+log(`=============`);
+log(`Number of orders: ${orders.length}`);
+log(`Total revenue: €${totalRevenue}`);
+log(`Best day: ${bestDay[0]} (€${bestDay[1]})`);
