@@ -0,0 +1,9 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+const nonRefunds = orders.filter(order => order.amount > 0);
+const total = nonRefunds.reduce((sum, order) => sum + order.amount, 0);
+const average = total / nonRefunds.length;
+
+log(`€${average.toFixed(2)}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..fb023dd
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,33 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const problems = [];
+
+for (let i = 0; i < orders.length; i++) {
+  const order = orders[i];
+  const orderRef = order.id ? `(${order.id})` : `(index ${i})`;
+
+  if (!order.id) {
+    problems.push(`Order ${orderRef}: missing id`);
+  }
+
+  if (!order.customer) {
+    problems.push(`Order ${orderRef}: missing customer`);
+  }
+
+  if (typeof order.amount !== 'number') {
+    problems.push(`Order ${orderRef}: amount is not numeric`);
+  }
+
+  if (!order.date || !/^\d{4}-\d{2}-\d{2}$/.test(order.date)) {
+    problems.push(`Order ${orderRef}: date is not YYYY-MM-DD format`);
+  }
+}
+
+for (const problem of problems) {
+  log(problem);
+}
+
+log(`${orders.length} orders, ${problems.length} problems`);
