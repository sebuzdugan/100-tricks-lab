diff --git a/scripts/revenue-by-month.js b/scripts/revenue-by-month.js
new file mode 100644
index 0000000..4f0b36f
--- /dev/null
+++ b/scripts/revenue-by-month.js
@@ -0,0 +1,19 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const revenueByMonth = {};
+for (const order of orders) {
+  const month = order.date.slice(0, 7);
+  if (!revenueByMonth[month]) {
+    revenueByMonth[month] = 0;
+  }
+  revenueByMonth[month] += order.amount;
+}
+
+const sorted = Object.entries(revenueByMonth).sort((a, b) => a[0].localeCompare(b[0]));
+
+for (const [month, revenue] of sorted) {
+  log(`${month}: €${revenue}`);
+}
diff --git a/scripts/search.js b/scripts/search.js
new file mode 100644
index 0000000..17eea4b
--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,21 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const searchText = process.argv[2];
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const orders = loadOrders();
+const matches = orders.filter(order =>
+  order.customer.toLowerCase().includes(searchText.toLowerCase())
+);
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  for (const order of matches) {
+    log(`${order.id}: ${order.customer} - €${order.amount} (${order.date})`);
+  }
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..f3dc846
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,16 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders();
+}
+
+const end = performance.now();
+const totalMs = end - start;
+const averageMs = totalMs / iterations;
+
+log(`${iterations} calls to loadOrders() took ${totalMs.toFixed(2)}ms`);
+log(`Average: ${averageMs.toFixed(4)}ms per call`);
