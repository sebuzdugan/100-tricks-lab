new file mode 100644
index 0000000..52e8474
--- /dev/null
+++ b/scripts/average-order.js
@@ -0,0 +1,11 @@
+import { log } from '../src/log.js';
+import { readFileSync } from 'fs';
+
+const orders = JSON.parse(readFileSync('./data/orders.json', 'utf-8'));
+
+const nonRefunds = orders.filter(order => order.amount > 0);
+const total = nonRefunds.reduce((sum, order) => sum + order.amount, 0);
+const average = total / nonRefunds.length;
+
+const euros = (average / 100).toFixed(2).replace('.', ',');
+log(`${euros} €`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..7715b93
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,24 @@
+import { log } from '../src/log.js';
+import { readFileSync } from 'fs';
+
+const orders = JSON.parse(readFileSync('./data/orders.json', 'utf-8'));
+
+const problems = [];
+
+orders.forEach((order, index) => {
+  if (!order.id) {
+    problems.push(`Order ${index}: missing id`);
+  }
+  if (!order.customer) {
+    problems.push(`Order ${index}: missing customer`);
+  }
+  if (typeof order.amount !== 'number') {
+    problems.push(`Order ${index}: amount is not numeric`);
+  }
+  if (!order.date || !/^\d{4}-\d{2}-\d{2}$/.test(order.date)) {
+    problems.push(`Order ${index}: invalid date format (expected YYYY-MM-DD)`);
+  }
+});
+
+problems.forEach(problem => log(problem));
+log(`${orders.length} orders, ${problems.length} problems`);
