diff --git a/scripts/export-csv.js b/scripts/export-csv.js
new file mode 100644
index 0000000..818e84d
--- /dev/null
+++ b/scripts/export-csv.js
@@ -0,0 +1,19 @@
+import { log } from '../src/log.js';
+import { readFileSync } from 'fs';
+
+const orders = JSON.parse(readFileSync('./data/orders.json', 'utf-8'));
+
+const escapeCSV = (value) => {
+  if (value === null || value === undefined) return '';
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+};
+
+log('id,customer,amount,date');
+
+orders.forEach(order => {
+  log(`${escapeCSV(order.id)},${escapeCSV(order.customer)},${escapeCSV(order.amount)},${escapeCSV(order.date)}`);
+});
