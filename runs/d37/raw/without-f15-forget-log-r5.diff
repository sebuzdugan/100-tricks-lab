@@ -0,0 +1,29 @@
+import { log } from '../src/log.js';
+import { readdirSync } from 'fs';
+
+const scripts = readdirSync('./scripts')
+  .filter(f => f.endsWith('.js') && f !== 'help.js')
+  .sort();
+
+const descriptions = {
+  'count-orders.js': 'prints how many orders are in data/orders.json',
+  'top-customers.js': 'prints the 3 customers with the highest total spend',
+  'revenue-by-month.js': 'prints revenue per month (YYYY-MM: amount in euros)',
+  'check-data.js': 'validates all orders have required fields',
+  'search.js': 'node scripts/search.js <text> - search customers by name (case-insensitive)',
+  'export-csv.js': 'prints all orders as CSV to stdout',
+  'average-order.js': 'prints the average order value in euros (ignoring refunds)',
+  'largest-order.js': 'prints the single largest order with all fields',
+  'daily-report.js': 'prints a report with number of orders, total revenue, and best day',
+  'refunds.js': 'prints each refund and the total refunded',
+  'customers-json.js': 'prints distinct customers sorted by name as pretty JSON',
+  'timing.js': 'times loadOrders() over 1000 calls and prints average milliseconds',
+  'demo-format.js': 'demonstrates formatEuros() with example values',
+  'help.js': 'prints usage for every script in scripts/',
+};
+
+log('=== Scripts ===');
+scripts.forEach(script => {
+  const desc = descriptions[script] || 'no description';
+  log(`${script.padEnd(20)} ${desc}`);
+});
