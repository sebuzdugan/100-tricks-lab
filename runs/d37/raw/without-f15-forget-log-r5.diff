+import { log } from '../src/log.js';
+import { readFileSync } from 'fs';
+
+const orders = JSON.parse(readFileSync('./data/orders.json', 'utf-8'));
+
+const customerTotals = {};
+orders.forEach(order => {
+  if (!customerTotals[order.customer]) {
+    customerTotals[order.customer] = 0;
+  }
+  customerTotals[order.customer] += order.amount;
+});
+
+const sorted = Object.entries(customerTotals)
+  .sort(([, a], [, b]) => b - a)
+  .slice(0, 3);
+
+sorted.forEach(([customer, total]) => {
+  const euros = (total / 100).toFixed(2).replace('.', ',');
+  log(`${customer}: ${euros} €`);
+});
