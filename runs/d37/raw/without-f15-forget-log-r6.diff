+++ b/scripts/average-order.js
@@ -0,0 +1,10 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const validOrders = orders.filter(order => order.amount > 0);
+const total = validOrders.reduce((sum, order) => sum + order.amount, 0);
+const average = (total / validOrders.length / 100).toFixed(2);
+
+log(`Average order value: €${average}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..18a7f57
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,32 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+let problems = 0;
+
+for (let i = 0; i < orders.length; i++) {
+  const order = orders[i];
+
+  if (!order.id || typeof order.id !== 'string') {
+    log(`Order ${i}: missing or invalid id`);
+    problems++;
+  }
+
+  if (!order.customer || typeof order.customer !== 'string') {
+    log(`Order ${i}: missing or invalid customer`);
+    problems++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: missing or invalid amount (not numeric)`);
+    problems++;
+  }
+
+  if (!order.date || !/^\d{4}-\d{2}-\d{2}$/.test(order.date)) {
+    log(`Order ${i}: missing or invalid date (not YYYY-MM-DD format)`);
+    problems++;
+  }
+}
+
+log(`${orders.length} orders, ${problems} problems`);
