diff --git a/scripts/revenue-by-month.js b/scripts/revenue-by-month.js
new file mode 100644
index 0000000..56225f1
--- /dev/null
+++ b/scripts/revenue-by-month.js
@@ -0,0 +1,20 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const monthlyRevenue = {};
+for (const order of orders) {
+  const month = order.date.slice(0, 7);
+  if (!monthlyRevenue[month]) {
+    monthlyRevenue[month] = 0;
+  }
+  monthlyRevenue[month] += order.amount;
+}
+
+const sorted = Object.entries(monthlyRevenue).sort();
+
+for (const [month, revenue] of sorted) {
+  const euros = (revenue / 100).toFixed(2);
+  log(`${month}: €${euros}`);
+}
diff --git a/scripts/search.js b/scripts/search.js
new file mode 100644
index 0000000..45308e1
--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,23 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const searchText = process.argv[2];
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+const searchLower = searchText.toLowerCase();
+
+const matches = orders.filter(order =>
+  order.customer.toLowerCase().includes(searchLower)
+);
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  for (const order of matches) {
+    log(`${order.id} | ${order.customer} | €${(order.amount / 100).toFixed(2)} | ${order.date}`);
+  }
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..587fdf6
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,15 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders();
+}
+
+const elapsed = performance.now() - start;
+const averageMs = elapsed / iterations;
+
+log(`${iterations} calls in ${elapsed.toFixed(2)}ms`);
+log(`Average: ${averageMs.toFixed(3)}ms per call`);
diff --git a/scripts/top-customers.js b/scripts/top-customers.js
new file mode 100644
index 0000000..016cd8d
--- /dev/null
+++ b/scripts/top-customers.js
@@ -0,0 +1,21 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const customerTotals = {};
+for (const order of orders) {
+  if (!customerTotals[order.customer]) {
+    customerTotals[order.customer] = 0;
+  }
+  customerTotals[order.customer] += order.amount;
+}
+
+const sorted = Object.entries(customerTotals)
+  .sort((a, b) => b[1] - a[1])
+  .slice(0, 3);
+
+for (const [customer, total] of sorted) {
+  const euros = (total / 100).toFixed(2);
+  log(`${customer}: €${euros}`);
+}
