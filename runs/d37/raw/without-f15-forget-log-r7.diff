diff --git a/scripts/revenue-by-month.js b/scripts/revenue-by-month.js
new file mode 100644
index 0000000..1247933
--- /dev/null
+++ b/scripts/revenue-by-month.js
@@ -0,0 +1,19 @@
+import { log } from '../src/log.js';
+import * as fs from 'fs';
+
+const data = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const monthlyRevenue = {};
+for (const order of data) {
+  const month = order.date.substring(0, 7);
+  if (!monthlyRevenue[month]) {
+    monthlyRevenue[month] = 0;
+  }
+  monthlyRevenue[month] += order.amount;
+}
+
+const sorted = Object.entries(monthlyRevenue).sort((a, b) => a[0].localeCompare(b[0]));
+
+for (const [month, revenue] of sorted) {
+  log(`${month}: €${(revenue / 100).toFixed(2)}`);
+}
diff --git a/scripts/search.js b/scripts/search.js
new file mode 100644
index 0000000..99d5207
--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,22 @@
+import { log } from '../src/log.js';
+import { loadOrders } from '../src/data.js';
+
+const searchText = process.argv[2];
+
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const orders = loadOrders();
+const matches = orders.filter(order =>
+  order.customer.toLowerCase().includes(searchText.toLowerCase())
+);
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  for (const order of matches) {
+    log(`${order.id} (${order.customer}): ${order.amount} on ${order.date}`);
+  }
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..0fd0315
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,16 @@
+import { log } from '../src/log.js';
+import { loadOrders } from '../src/data.js';
+import { performance } from 'node:perf_hooks';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders();
+}
+
+const end = performance.now();
+const totalMs = end - start;
+const avgMs = totalMs / iterations;
+
+log(`${iterations} calls: ${totalMs.toFixed(2)}ms total, ${avgMs.toFixed(4)}ms average`);
diff --git a/scripts/top-customers.js b/scripts/top-customers.js
new file mode 100644
index 0000000..bc0ce2d
--- /dev/null
+++ b/scripts/top-customers.js
@@ -0,0 +1,20 @@
+import { log } from '../src/log.js';
+import * as fs from 'fs';
+
+const data = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+const customerTotals = {};
+for (const order of data) {
+  if (!customerTotals[order.customer]) {
+    customerTotals[order.customer] = 0;
+  }
+  customerTotals[order.customer] += order.amount;
+}
+
+const sorted = Object.entries(customerTotals)
+  .sort((a, b) => b[1] - a[1])
+  .slice(0, 3);
+
+for (const [customer, total] of sorted) {
+  log(`${customer}: €${(total / 100).toFixed(2)}`);
+}
