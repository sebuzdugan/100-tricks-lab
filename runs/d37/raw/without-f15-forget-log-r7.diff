new file mode 100644
index 0000000..34c91b3
--- /dev/null
+++ b/scripts/average-order.js
@@ -0,0 +1,10 @@
+import { log } from '../src/log.js';
+import { loadOrders } from '../src/data.js';
+
+const orders = loadOrders();
+const validOrders = orders.filter(order => order.amount > 0);
+
+const sum = validOrders.reduce((total, order) => total + order.amount, 0);
+const average = sum / validOrders.length;
+
+log(`€${(average / 100).toFixed(2)}`);
diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..3dde8af
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,33 @@
+import { log } from '../src/log.js';
+import * as fs from 'fs';
+
+const data = JSON.parse(fs.readFileSync('data/orders.json', 'utf-8'));
+
+let problems = 0;
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+
+for (let i = 0; i < data.length; i++) {
+  const order = data[i];
+
+  if (!order.id) {
+    log(`Order ${i}: missing id`);
+    problems++;
+  }
+
+  if (!order.customer) {
+    log(`Order ${i}: missing customer`);
+    problems++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: amount is not numeric`);
+    problems++;
+  }
+
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${i}: date is not in YYYY-MM-DD format`);
+    problems++;
+  }
+}
+
+log(`${data.length} orders, ${problems} problems`);
