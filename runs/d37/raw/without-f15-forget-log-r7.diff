+import { log } from '../src/log.js';
+
+const scripts = [
+  { name: 'count-orders.js', description: 'prints how many orders are in data/orders.json' },
+  { name: 'top-customers.js', description: 'print the 3 customers with the highest total spend' },
+  { name: 'revenue-by-month.js', description: 'prints revenue per month (YYYY-MM: €amount)' },
