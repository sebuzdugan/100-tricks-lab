+  { name: 'average-order.js', description: 'prints average order value in euros, ignoring refunds' },
+  { name: 'export-csv.js', description: 'prints all orders as CSV to stdout' },
+  { name: 'search.js <text>', description: 'prints orders whose customer name contains the text' },
