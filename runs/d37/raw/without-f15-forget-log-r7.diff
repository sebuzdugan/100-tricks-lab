+  { name: 'largest-order.js', description: 'prints the single largest order with all fields' },
+  { name: 'daily-report.js', description: 'prints a short report with orders, revenue, best day' },
+  { name: 'refunds.js', description: 'prints each refund and the total refunded' },
+  { name: 'customers-json.js', description: 'prints distinct customers sorted by name as JSON' },
+  { name: 'timing.js', description: 'times loadOrders() over 1000 calls and prints average ms' },
+  { name: 'help.js', description: 'prints usage for every script' },
+];
+
+for (const script of scripts) {
+  log(`node scripts/${script.name.padEnd(20)} - ${script.description}`);
