diff --git a/scripts/revenue-by-month.js b/scripts/revenue-by-month.js
new file mode 100644
index 0000000..5949b41
--- /dev/null
+++ b/scripts/revenue-by-month.js
@@ -0,0 +1,16 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync(new URL('../data/orders.json', import.meta.url), 'utf-8'));
+
+const totals = {};
+for (const order of orders) {
+  const month = order.date.slice(0, 7);
+  totals[month] = (totals[month] || 0) + order.amount;
+}
+
+const sorted = Object.entries(totals).sort((a, b) => a[0].localeCompare(b[0]));
+
+for (const [month, total] of sorted) {
+  log(`${month}: €${total}`);
+}
diff --git a/scripts/search.js b/scripts/search.js
new file mode 100644
index 0000000..593878c
--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,22 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const searchText = process.argv[2];
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const orders = JSON.parse(fs.readFileSync(new URL('../data/orders.json', import.meta.url), 'utf-8'));
+
+const matches = orders.filter(order =>
+  order.customer.toLowerCase().includes(searchText.toLowerCase())
+);
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  for (const order of matches) {
+    log(`${order.id}: ${order.customer} - €${order.amount} (${order.date})`);
+  }
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..d3b56c3
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,15 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders();
+}
+
+const end = performance.now();
+const totalMs = end - start;
+const avgMs = totalMs / iterations;
+
+log(`Average: ${avgMs.toFixed(4)}ms per call (${totalMs.toFixed(2)}ms total)`);
