diff --git a/scripts/help.js b/scripts/help.js
new file mode 100644
index 0000000..3dd45c1
--- /dev/null
+++ b/scripts/help.js
@@ -0,0 +1,26 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const scriptsDir = new URL('.', import.meta.url);
+const files = fs.readdirSync(scriptsDir).filter(f => f.endsWith('.js') && f !== 'help.js').sort();
+
+const descriptions = {
+  'average-order.js': 'Print average order value excluding refunds',
+  'check-data.js': 'Validate all orders have required fields',
+  'count-orders.js': 'Print total number of orders',
+  'customers-json.js': 'Print distinct customers as JSON, sorted by name',
+  'daily-report.js': 'Print daily report with order count, revenue, best day',
+  'demo-format.js': 'Demo the formatEuros function with example values',
+  'export-csv.js': 'Export all orders as CSV to stdout',
+  'largest-order.js': 'Print the single largest order with all fields',
+  'refunds.js': 'List all refunds and total refunded amount',
+  'revenue-by-month.js': 'Print revenue per month (YYYY-MM format)',
+  'search.js': 'Search orders by customer name (case-insensitive)',
+  'timing.js': 'Time loadOrders() over 1000 calls',
+  'top-customers.js': 'Print top 3 customers by total spend',
+};
+
+for (const file of files) {
+  const desc = descriptions[file] || 'No description';
+  log(`node scripts/${file.padEnd(20)} ${desc}`);
+}
