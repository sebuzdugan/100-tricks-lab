diff --git a/scripts/daily-report.js b/scripts/daily-report.js
new file mode 100644
index 0000000..d7bc158
--- /dev/null
+++ b/scripts/daily-report.js
@@ -0,0 +1,21 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync(new URL('../data/orders.json', import.meta.url), 'utf-8'));
+
+const totalOrders = orders.length;
+const totalRevenue = orders.reduce((sum, order) => sum + order.amount, 0);
+
+const byDay = {};
+for (const order of orders) {
+  byDay[order.date] = (byDay[order.date] || 0) + order.amount;
+}
+
+const bestDay = Object.entries(byDay).reduce((max, [date, amount]) =>
+  amount > max[1] ? [date, amount] : max
+);
+
+log('=== Daily Report ===');
+log(`Total orders: ${totalOrders}`);
+log(`Total revenue: €${totalRevenue}`);
+log(`Best day: ${bestDay[0]} (€${bestDay[1]})`);
