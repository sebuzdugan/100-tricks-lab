diff --git a/scripts/check-data.js b/scripts/check-data.js
new file mode 100644
index 0000000..d7cdc3f
--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,33 @@
+import fs from 'fs';
+import { log } from '../src/log.js';
+
+const orders = JSON.parse(fs.readFileSync(new URL('../data/orders.json', import.meta.url), 'utf-8'));
+
+let problemCount = 0;
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+
+for (let i = 0; i < orders.length; i++) {
+  const order = orders[i];
+
+  if (!order.id) {
+    log(`Order ${i}: missing id`);
+    problemCount++;
+  }
+
+  if (!order.customer) {
+    log(`Order ${i}: missing customer`);
+    problemCount++;
+  }
+
+  if (typeof order.amount !== 'number') {
+    log(`Order ${i}: amount is not numeric`);
+    problemCount++;
+  }
+
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${i}: date is not in YYYY-MM-DD format`);
+    problemCount++;
+  }
+}
+
+log(`${orders.length} orders, ${problemCount} problems`);
