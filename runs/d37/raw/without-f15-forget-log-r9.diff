--- /dev/null
+++ b/scripts/check-data.js
@@ -0,0 +1,32 @@
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { log } from '../src/log.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const ordersPath = path.join(__dirname, '../data/orders.json');
+
+const orders = JSON.parse(fs.readFileSync(ordersPath, 'utf8'));
+const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+let problemCount = 0;
+
+orders.forEach((order, index) => {
+  if (!order.id) {
+    log(`Order ${index}: missing id`);
+    problemCount++;
+  }
+  if (!order.customer) {
+    log(`Order ${index}: missing customer`);
+    problemCount++;
+  }
+  if (typeof order.amount !== 'number') {
+    log(`Order ${index}: amount is not numeric`);
+    problemCount++;
+  }
+  if (!order.date || !dateRegex.test(order.date)) {
+    log(`Order ${index}: invalid date (expected YYYY-MM-DD)`);
+    problemCount++;
+  }
+});
+
+log(`${orders.length} orders, ${problemCount} problems`);
