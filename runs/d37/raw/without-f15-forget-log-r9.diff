+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { log } from '../src/log.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const scriptsDir = __dirname;
+
+const descriptions = {
+  'count-orders.js': 'Print how many orders are in data/orders.json',
+  'top-customers.js': 'Print the 3 customers with the highest total spend in euros',
+  'revenue-by-month.js': 'Print revenue per month (YYYY-MM: amount in euros)',
+  'check-data.js': 'Validate that all orders have required fields',
+  'average-order.js': 'Print the average order value in euros, ignoring refunds',
+  'export-csv.js': 'Print all orders as CSV to stdout',
+  'search.js': 'node scripts/search.js <text> - find orders by customer name (case-insensitive)',
+  'demo-format.js': 'Demo of the formatEuros function with example values',
+  'largest-order.js': 'Print the single largest order with all fields',
+  'daily-report.js': 'Print a report with orders count, total revenue, and best day',
+  'refunds.js': 'Print each refund and the total refunded',
+  'customers-json.js': 'Print distinct customers sorted by name as JSON',
+  'timing.js': 'Time loadOrders() over 1000 calls and print average milliseconds per call',
+  'help.js': 'Print this help message'
+};
+
+const files = fs.readdirSync(scriptsDir)
+  .filter(f => f.endsWith('.js'))
+  .sort();
+
+files.forEach(file => {
+  const desc = descriptions[file] || 'No description available';
+  log(`${file.padEnd(20)} - ${desc}`);
+});
