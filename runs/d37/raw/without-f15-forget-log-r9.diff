+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { log } from '../src/log.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const ordersPath = path.join(__dirname, '../data/orders.json');
+
+const orders = JSON.parse(fs.readFileSync(ordersPath, 'utf8'));
+
+const monthlyRevenue = {};
+orders.forEach(order => {
+  const month = order.date.slice(0, 7);
+  if (!monthlyRevenue[month]) {
+    monthlyRevenue[month] = 0;
+  }
+  monthlyRevenue[month] += order.amount;
+});
+
+const sorted = Object.entries(monthlyRevenue).sort((a, b) => a[0].localeCompare(b[0]));
+
+sorted.forEach(([month, total]) => {
+  const formatted = new Intl.NumberFormat('de-DE', {
+    style: 'currency',
+    currency: 'EUR'
+  }).format(total);
+  log(`${month}: ${formatted}`);
+});
diff --git a/scripts/search.js b/scripts/search.js
new file mode 100644
index 0000000..66f5626
--- /dev/null
+++ b/scripts/search.js
@@ -0,0 +1,22 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const searchText = process.argv[2];
+
+if (!searchText) {
+  log('Usage: node scripts/search.js <text>');
+  process.exit(1);
+}
+
+const orders = loadOrders();
+const matches = orders.filter(order =>
+  order.customer.toLowerCase().includes(searchText.toLowerCase())
+);
+
+if (matches.length === 0) {
+  log('no matches');
+} else {
+  matches.forEach(order => {
+    log(`${order.id}: ${order.customer} - ${order.amount} (${order.date})`);
+  });
+}
diff --git a/scripts/timing.js b/scripts/timing.js
new file mode 100644
index 0000000..53202b3
--- /dev/null
+++ b/scripts/timing.js
@@ -0,0 +1,15 @@
+import { loadOrders } from '../src/data.js';
+import { log } from '../src/log.js';
+
+const iterations = 1000;
+const start = performance.now();
+
+for (let i = 0; i < iterations; i++) {
+  loadOrders();
+}
+
+const end = performance.now();
+const totalMs = end - start;
+const avgMs = totalMs / iterations;
+
+log(`Average time per loadOrders() call: ${avgMs.toFixed(3)}ms`);
