diff --git a/scripts/export-csv.js b/scripts/export-csv.js
new file mode 100644
index 0000000..0e16e03
--- /dev/null
+++ b/scripts/export-csv.js
@@ -0,0 +1,21 @@
+import { loadOrders } from '../src/data.js';
+
+const orders = loadOrders();
+
+const escapeCsv = (value) => {
+  if (value === null || value === undefined) return '';
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+};
+
+console.log('id,customer,amount,date');
+
+orders.forEach(order => {
+  const line = [order.id, order.customer, order.amount, order.date]
+    .map(escapeCsv)
+    .join(',');
+  console.log(line);
+});
