diff --git a/scripts/daily-report.js b/scripts/daily-report.js
new file mode 100644
index 0000000..4055e04
--- /dev/null
+++ b/scripts/daily-report.js
@@ -0,0 +1,24 @@
+import { loadOrders } from '../src/data.js';
+import { formatEuros } from '../src/format.js';
+import { log } from '../src/log.js';
+
+const orders = loadOrders();
+
+const totalOrders = orders.length;
+const totalRevenue = orders.reduce((sum, order) => sum + order.amount, 0);
+
+const dailyRevenue = {};
+orders.forEach(order => {
+  if (!dailyRevenue[order.date]) {
+    dailyRevenue[order.date] = 0;
+  }
+  dailyRevenue[order.date] += order.amount;
+});
+
+const bestDay = Object.entries(dailyRevenue).reduce((best, [date, revenue]) =>
+  revenue > best[1] ? [date, revenue] : best
+);
+
+log(`Orders: ${totalOrders}`);
+log(`Total revenue: ${formatEuros(totalRevenue * 100)}`);
+log(`Best day: ${bestDay[0]} (${formatEuros(bestDay[1] * 100)})`);
