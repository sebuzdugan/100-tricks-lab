@@ -0,0 +1,49 @@
+import { generateText, tool, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findOrder } from './data/orders.js';
+
+export const getOrderStatus = tool({
+  description: 'Get the status of an order for the current customer',
+  inputSchema: z.object({
+    orderId: z.string().describe('The order ID to look up'),
+  }),
+  contextSchema: z.object({
+    customerId: z.string(),
+  }),
+  execute: async ({ orderId }, { context }) => {
+    const order = findOrder(orderId);
+
+    if (!order || order.customerId !== context.customerId) {
+      return { orderId, error: 'not found' };
+    }
+
+    return { orderId, status: order.status, eta: order.eta };
+  },
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  const result = await generateText({
+    model,
+    instructions: "You are Acme's order-status assistant. Answer in one short sentence.",
+    tools: { getOrderStatus },
+    toolsContext: { getOrderStatus: { customerId } },
+    prompt: question,
+    stopWhen: isStepCount(5),
+  });
+
+  const lookedUp = [];
+  for (const step of result.steps) {
+    for (const toolCall of step.toolCalls) {
+      if (toolCall.toolName === 'getOrderStatus') {
+        lookedUp.push(toolCall.input.orderId);
+      }
+    }
+  }
+
+  return {
+    answer: result.text,
+    lookedUp,
+    inputTokens: result.usage.inputTokens,
+    outputTokens: result.usage.outputTokens,
+  };
+}
