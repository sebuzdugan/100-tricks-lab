+import { streamText } from 'ai';
+
+export async function streamReply(model, history, { onText } = {}) {
+  // Extract system message if present at the start of history
+  let instructions;
+  let messages = history;
+
+  if (history.length > 0 && history[0].role === 'system') {
+    instructions = history[0].content;
+    messages = history.slice(1);
+  }
+
+  const result = streamText({
+    model,
+    ...(instructions ? { instructions } : {}),
+    messages,
+  });
+
+  // Stream text chunks and invoke callback
+  for await (const chunk of result.textStream) {
+    if (onText) {
+      onText(chunk);
+    }
+  }
+
+  // Collect final results from promises
+  const text = await result.text;
+  const finishReason = await result.finishReason;
+  const usage = await result.usage;
+
+  return {
+    text,
+    finishReason,
+    inputTokens: usage.inputTokens,
+    outputTokens: usage.outputTokens,
+  };
+}
