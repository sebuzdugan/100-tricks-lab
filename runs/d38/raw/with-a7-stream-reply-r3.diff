+import { streamText } from 'ai';
+
+export async function streamReply(model, history, { onText } = {}) {
+  // Extract system message if it's the first message
+  let instructions;
+  let messages = history;
+
+  if (history.length > 0 && history[0].role === 'system') {
+    instructions = history[0].content;
+    messages = history.slice(1);
+  }
+
+  const streamOptions = {
+    model,
+    messages,
+  };
+
+  if (instructions) {
+    streamOptions.instructions = instructions;
+  }
+
+  const result = streamText(streamOptions);
+
+  for await (const textPart of result.textStream) {
+    if (onText) {
+      onText(textPart);
+    }
+  }
+
+  const { text, finishReason, usage } = await result;
+
+  return {
+    text,
+    finishReason,
+    inputTokens: usage?.inputTokens,
+    outputTokens: usage?.outputTokens,
+  };
+}
