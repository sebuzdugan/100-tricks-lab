@@ -0,0 +1,37 @@
+import { generateText, Output, tool, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+export async function triageTicket(model, { customerId, text }) {
+  const { output } = await generateText({
+    model,
+    tools: {
+      getCustomer: tool({
+        description: 'Get customer information by customer ID',
+        inputSchema: z.object({ customerId: z.string() }),
+        execute: async ({ customerId: id }) => {
+          const customer = findCustomer(id);
+          return customer || { error: 'not found' };
+        },
+      }),
+    },
+    output: Output.object({
+      schema: triageSchema,
+    }),
+    stopWhen: isStepCount(4),
+    prompt: `You are a support ticket triage system. Analyze the customer support ticket and provide a structured response.
+
+Customer ID: ${customerId}
+Ticket text: ${text}
+
+First, use the getCustomer tool to look up the customer information. Then analyze the ticket and provide a triage response.`,
+  });
+
+  return output;
+}
