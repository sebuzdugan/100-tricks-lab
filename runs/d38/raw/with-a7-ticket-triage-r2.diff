+import { generateText, Output, tool, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+export async function triageTicket(model, { customerId, text }) {
+  const { output } = await generateText({
+    model,
+    tools: {
+      getCustomer: tool({
+        description: 'Get customer information by ID',
+        inputSchema: z.object({ customerId: z.string() }),
+        execute: async ({ customerId }) => {
+          const customer = findCustomer(customerId);
+          return customer ? customer : { error: 'not found' };
+        },
+      }),
+    },
+    output: Output.object({
+      schema: z.object({
+        category: z.enum(['billing', 'shipping', 'bug', 'other']),
+        priority: z.enum(['low', 'normal', 'high']),
+        reply: z.string(),
+      }),
+    }),
+    stopWhen: isStepCount(4),
+    prompt: `You are a support agent triaging customer tickets. Use the getCustomer tool to look up the customer, then analyze their ticket and provide a structured response.
+
+Customer ID: ${customerId}
+Ticket: ${text}
+
+Determine the category, priority level, and provide a brief reply to the customer.`,
+  });
+
+  return output;
+}
