+import { generateText, Output, tool, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+export async function triageTicket(model, { customerId, text }) {
+  const result = await generateText({
+    model,
+    tools: {
+      getCustomer: tool({
+        description: 'Get customer information',
+        inputSchema: z.object({ customerId: z.string() }),
+        execute: async ({ customerId }) => {
+          const customer = findCustomer(customerId);
+          if (!customer) {
+            return { error: 'not found' };
+          }
+          return customer;
+        },
+      }),
+    },
+    output: Output.object({
+      schema: triageSchema,
+    }),
+    stopWhen: isStepCount(4),
+    prompt: `You are a support ticket triage agent. Analyze the following support ticket and categorize it.
+
+Customer ID: ${customerId}
+Ticket text: ${text}
+
+First, use the getCustomer tool to look up the customer information. Then, based on the customer's plan and the ticket content, determine:
+1. Category (billing, shipping, bug, or other)
+2. Priority (low, normal, or high)
+3. A brief, professional reply to send to the customer
+
+Respond with the structured data.`,
+  });
+
+  return result.output;
+}
