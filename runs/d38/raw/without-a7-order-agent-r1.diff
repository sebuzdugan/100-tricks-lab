+++ b/src/order-agent.js
@@ -0,0 +1,46 @@
+import { tool, generateText, stepCountIs } from 'ai';
+import { z } from 'zod';
+import { findOrder } from './data/orders.js';
+
+export const getOrderStatus = tool({
+  description: "Look up one of the customer's orders by id.",
+  parameters: z.object({
+    orderId: z.string(),
+  }),
+  execute: async (input, context) => {
+    const { customerId } = context;
+    const order = findOrder(input.orderId);
+    if (!order || order.customerId !== customerId) {
+      return { orderId: input.orderId, error: 'not found' };
+    }
+    return { orderId: order.orderId, status: order.status, eta: order.eta };
+  },
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  const result = await generateText({
+    model,
+    system: "You are Acme's order-status assistant. Answer in one short sentence.",
+    prompt: question,
+    tools: { getOrderStatus },
+    toolsContext: { getOrderStatus: { customerId } },
+    stopWhen: stepCountIs(5),
+  });
+
+  const lookedUp = [];
+  for (const step of result.steps ?? []) {
+    for (const call of step.toolCalls ?? []) {
+      if (call.toolName === 'getOrderStatus') {
+        const input = typeof call.input === 'string' ? JSON.parse(call.input) : call.input;
+        lookedUp.push(input.orderId);
+      }
+    }
+  }
+
+  return {
+    answer: result.text,
+    lookedUp,
+    inputTokens: result.usage.inputTokens,
+    outputTokens: result.usage.outputTokens,
+  };
+}
