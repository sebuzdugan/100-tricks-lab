@@ -0,0 +1,37 @@
+import { tool, generateText, stepCountIs } from 'ai';
+import { z } from 'zod';
+import { findOrder } from './data/orders.js';
+
+export const getOrderStatus = tool({
+  description: 'Get the status of an order',
+  parameters: z.object({
+    orderId: z.string().describe('The order ID to look up'),
+  }),
+  execute: async ({ orderId }, { customerId }) => {
+    const order = findOrder(orderId);
+    if (!order || order.customerId !== customerId) {
+      return { orderId, error: 'not found' };
+    }
+    return { orderId, status: order.status, eta: order.eta };
+  },
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  const result = await generateText({
+    model,
+    tools: { getOrderStatus },
+    toolsContext: { customerId },
+    prompt: question,
+    system: 'You are Acme\'s order-status assistant. Answer in one short sentence.',
+    stopWhen: stepCountIs(5),
+  });
+
+  const lookedUp = result.toolCalls.map(tc => tc.input.orderId);
+
+  return {
+    answer: result.text,
+    lookedUp,
+    inputTokens: result.usage.inputTokens ?? 0,
+    outputTokens: result.usage.outputTokens ?? 0,
+  };
+}
