+++ b/src/order-agent.js
@@ -0,0 +1,49 @@
+import { tool, generateText, isStepCount } from 'ai';
+import { z } from 'zod';
+import { findOrder } from './data/orders.js';
+
+export const getOrderStatus = tool({
+  description: 'Get the status of an order for the current customer',
+  parameters: z.object({
+    orderId: z.string(),
+  }),
+  execute: async ({ orderId }, { experimental_context }) => {
+    const { customerId } = experimental_context;
+    const order = findOrder(orderId);
+    if (!order || order.customerId !== customerId) {
+      return { orderId, error: 'not found' };
+    }
+    return { orderId: order.orderId, status: order.status, eta: order.eta };
+  },
+});
+
+export async function answerOrderQuestion(model, question, { customerId }) {
+  const lookedUp = [];
+
+  const result = await generateText({
+    model,
+    system: "You are Acme's order-status assistant. Answer in one short sentence.",
+    prompt: question,
+    tools: { getOrderStatus },
+    stopWhen: isStepCount(5),
+    experimental_context: { customerId },
+  });
+
+  // Extract order IDs from tool calls in the steps
+  if (result.steps) {
+    for (const step of result.steps) {
+      for (const item of step.content) {
+        if (item.type === 'tool-call' && item.toolName === 'getOrderStatus') {
+          lookedUp.push(item.input.orderId);
+        }
+      }
+    }
+  }
+
+  return {
+    answer: result.text,
+    lookedUp,
+    inputTokens: result.usage.inputTokens,
+    outputTokens: result.usage.outputTokens,
+  };
+}
