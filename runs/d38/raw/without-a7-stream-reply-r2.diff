+import { streamText } from 'ai';
+
+/**
+ * Streams a model's reply to a chat history, calling a callback for each text chunk.
+ * @param {import('ai').LanguageModel} model
+ * @param {{ role: 'system' | 'user' | 'assistant', content: string }[]} history messages oldest first
+ * @param {{ onText?: (chunk: string) => void }} options
+ * @returns {Promise<{ text: string, finishReason: string, inputTokens: number, outputTokens: number }>}
+ */
+export async function streamReply(model, history, { onText } = {}) {
+  const options = { model };
+
+  // Extract system message if present; AI SDK 7 requires it separately
+  if (history.length > 0 && history[0].role === 'system') {
+    options.system = history[0].content;
+    options.messages = history.slice(1);
+  } else {
+    options.messages = history;
+  }
+
+  const result = streamText(options);
+
+  for await (const part of result.stream) {
+    if (part.type === 'text-delta' && onText) {
+      onText(part.text);
+    }
+  }
+
+  const text = await result.text;
+  const usage = await result.usage;
+  const finishReason = await result.finishReason;
+
+  return {
+    text,
+    finishReason,
+    inputTokens: usage.inputTokens,
+    outputTokens: usage.outputTokens,
+  };
+}
