new file mode 100644
index 0000000..9079cde
--- /dev/null
+++ b/src/stream-reply.js
@@ -0,0 +1,35 @@
+import { streamText } from 'ai';
+
+export async function streamReply(model, history, { onText } = {}) {
+  let fullText = '';
+
+  // Separate system messages from the rest
+  let instructions = undefined;
+  let messages = history;
+
+  if (history.length > 0 && history[0].role === 'system') {
+    instructions = history[0].content;
+    messages = history.slice(1);
+  }
+
+  const { textStream, finishReason, usage } = await streamText({
+    model,
+    instructions,
+    messages,
+  });
+
+  // Collect all text deltas
+  for await (const chunk of textStream) {
+    fullText += chunk;
+    if (onText) {
+      onText(chunk);
+    }
+  }
+
+  return {
+    text: fullText,
+    finishReason: await finishReason,
+    inputTokens: (await usage).inputTokens,
+    outputTokens: (await usage).outputTokens,
+  };
+}
diff --git a/test/stream-reply.test.js b/test/stream-reply.test.js
new file mode 100644
index 0000000..8818271
--- /dev/null
+++ b/test/stream-reply.test.js
@@ -0,0 +1,37 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { streamReply } from '../src/stream-reply.js';
+import { scriptedModel } from './helpers/mock-model.js';
+
+test('streamReply streams text and calls onText callback', async () => {
+  const model = scriptedModel([
+    { text: 'Hello world', usage: [10, 5], chunks: ['Hello', ' ', 'world'] },
+  ]);
+
+  const chunks = [];
+  const result = await streamReply(model, [{ role: 'user', content: 'Hi' }], {
+    onText: (chunk) => chunks.push(chunk),
+  });
+
+  assert.equal(result.text, 'Hello world');
+  assert.equal(result.finishReason, 'stop');
+  assert.equal(result.inputTokens, 10);
+  assert.equal(result.outputTokens, 5);
+  assert.deepEqual(chunks, ['Hello', ' ', 'world']);
+});
+
+test('streamReply works without onText callback', async () => {
+  const model = scriptedModel([
+    { text: 'Response', usage: [20, 8] },
+  ]);
+
+  const result = await streamReply(model, [
+    { role: 'system', content: 'You are helpful' },
+    { role: 'user', content: 'Test' },
+  ]);
+
+  assert.equal(result.text, 'Response');
+  assert.equal(result.finishReason, 'stop');
+  assert.equal(result.inputTokens, 20);
+  assert.equal(result.outputTokens, 8);
+});
