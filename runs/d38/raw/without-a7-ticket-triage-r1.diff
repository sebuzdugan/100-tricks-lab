+import { generateText } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+export async function triageTicket(model, { customerId, text }) {
+  const result = await generateText({
+    model,
+    messages: [
+      {
+        role: 'user',
+        content: `You are a support ticket triage agent. Analyze this customer support ticket and provide a structured triage decision.
+
+Customer ID: ${customerId}
+Customer Message: ${text}
+
+First, use the getCustomer tool to retrieve the customer's account information. Then provide a triage response with:
+- category: one of 'billing', 'shipping', 'bug', or 'other'
+- priority: one of 'low', 'normal', or 'high'
+- reply: a short, helpful first response to the customer`,
+      },
+    ],
+    tools: {
+      getCustomer: {
+        description: 'Retrieve customer account information by customer ID',
+        parameters: z.object({
+          customerId: z.string(),
+        }),
+        execute: async ({ customerId }) => {
+          const customer = findCustomer(customerId);
+          return customer ?? { error: 'not found' };
+        },
+      },
+    },
+    responseFormat: {
+      type: 'json',
+      schema: triageSchema,
+    },
+  });
+
+  const parsed = triageSchema.parse(JSON.parse(result.text));
+  return parsed;
+}
