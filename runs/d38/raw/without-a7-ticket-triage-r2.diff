@@ -0,0 +1,41 @@
+import { generateText, stepCountIs } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './index.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+export async function triageTicket(model, { customerId, text }) {
+  const { text: responseText } = await generateText({
+    model,
+    prompt: `You are a support ticket triage agent. A customer has submitted a support ticket. Your job is to:
+1. Look up the customer's account using the getCustomer tool.
+2. Categorize the ticket (billing, shipping, bug, or other).
+3. Assign a priority level (low, normal, or high).
+4. Write a brief, friendly first reply.
+
+Respond with a JSON object with the keys: category, priority, reply.
+
+Customer ID: ${customerId}
+Ticket text: ${text}`,
+    tools: {
+      getCustomer: {
+        description: 'Look up a customer by their ID',
+        parameters: z.object({
+          customerId: z.string(),
+        }),
+        execute: async ({ customerId: id }) => {
+          const customer = findCustomer(id);
+          return customer || { error: 'not found' };
+        },
+      },
+    },
+    stopWhen: stepCountIs(4),
+  });
+
+  const parsed = JSON.parse(responseText);
+  return triageSchema.parse(parsed);
+}
