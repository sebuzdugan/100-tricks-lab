+++ b/src/triage.js
@@ -0,0 +1,36 @@
+import { generateText, Output, stepCountIs } from 'ai';
+import { z } from 'zod';
+import { findCustomer } from './data/customers.js';
+
+const triageSchema = z.object({
+  category: z.enum(['billing', 'shipping', 'bug', 'other']),
+  priority: z.enum(['low', 'normal', 'high']),
+  reply: z.string(),
+});
+
+export async function triageTicket(model, { customerId, text }) {
+  const result = await generateText({
+    model,
+    system: 'You are a support desk triage agent. Categorize support tickets, assign priorities, and write brief responses to customers.',
+    prompt: `Customer ID: ${customerId}
+Ticket: ${text}
+
+Use the getCustomer tool to look up the customer's details. Then categorize the issue, assign a priority, and write a response to the customer.`,
+    tools: {
+      getCustomer: {
+        description: 'Look up a customer by their ID',
+        parameters: z.object({
+          customerId: z.string(),
+        }),
+        execute: async ({ customerId: id }) => {
+          const customer = findCustomer(id);
+          return customer ?? { error: 'not found' };
+        },
+      },
+    },
+    output: Output.object({ schema: triageSchema }),
+    stopWhen: stepCountIs(4),
+  });
+
+  return result._output;
+}
diff --git a/test/triage.test.js b/test/triage.test.js
new file mode 100644
index 0000000..d7d7a94
--- /dev/null
+++ b/test/triage.test.js
@@ -0,0 +1,42 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { triageTicket } from '../src/triage.js';
+import { scriptedModel } from './helpers/mock-model.js';
+
+test('triageTicket uses getCustomer tool and returns valid triage data', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'getCustomer', input: { customerId: 'C1' } }], usage: [100, 50] },
+    { text: JSON.stringify({ category: 'billing', priority: 'high', reply: 'Thank you for contacting us.' }), usage: [200, 75] },
+  ]);
+
+  const result = await triageTicket(model, { customerId: 'C1', text: 'I was charged twice for my order' });
+
+  assert.equal(result.category, 'billing');
+  assert.equal(result.priority, 'high');
+  assert.equal(result.reply, 'Thank you for contacting us.');
+  assert.equal(model.calls.length, 2);
+});
+
+test('triageTicket handles customer not found', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'getCustomer', input: { customerId: 'UNKNOWN' } }], usage: [100, 50] },
+    { text: JSON.stringify({ category: 'other', priority: 'normal', reply: 'We could not find your account.' }), usage: [200, 75] },
+  ]);
+
+  const result = await triageTicket(model, { customerId: 'UNKNOWN', text: 'Help me with my account' });
+
+  assert.equal(result.category, 'other');
+  assert.equal(result.priority, 'normal');
+});
+
+test('triageTicket rejects if schema does not match', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'getCustomer', input: { customerId: 'C1' } }], usage: [100, 50] },
+    { text: JSON.stringify({ invalid: 'response' }), usage: [200, 75] },
+  ]);
+
+  await assert.rejects(
+    () => triageTicket(model, { customerId: 'C1', text: 'Test ticket' }),
+    /No object generated/,
+  );
+});
