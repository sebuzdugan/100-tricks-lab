diff --git a/test/assistant.test.js b/test/assistant.test.js
new file mode 100644
index 0000000..ba80165
--- /dev/null
+++ b/test/assistant.test.js
@@ -0,0 +1,67 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { scriptedModel } from './helpers/mock-model.js';
+import { summarizeThread, answerAboutOrders, classifyTicket, continueChat } from '../src/legacy/assistant.js';
+
+test('summarizeThread', async () => {
+  const model = scriptedModel([{ text: 'Customer had issue, resolved it.' }]);
+  const thread = [
+    { from: 'customer', text: 'My order is broken' },
+    { from: 'agent', text: 'Let me help you with that' },
+  ];
+  const result = await summarizeThread(model, thread);
+  assert.strictEqual(result.summary, 'Customer had issue, resolved it.');
+  assert.strictEqual(result.inputTokens, 10);
+  assert.strictEqual(result.cachedInputTokens, 0);
+});
+
+test('answerAboutOrders without tools', async () => {
+  const model = scriptedModel([{ text: 'Your order should arrive soon.' }]);
+  const result = await answerAboutOrders(model, 'When will my order arrive?', { customerId: 'cust1' });
+  assert.strictEqual(result.text, 'Your order should arrive soon.');
+  assert.deepStrictEqual(result.toolsUsed, []);
+});
+
+test('answerAboutOrders with tool use', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: '123' } }] },
+    { text: 'Your order 123 is shipped.' },
+  ]);
+  const result = await answerAboutOrders(model, 'What about order 123?', { customerId: 'cust1' });
+  assert.strictEqual(result.text, 'Your order 123 is shipped.');
+  assert.deepStrictEqual(result.toolsUsed, ['orderLookup']);
+});
+
+test('classifyTicket', async () => {
+  const model = scriptedModel([{ text: '{"category":"billing","urgent":true}' }]);
+  const result = await classifyTicket(model, 'I was overcharged!');
+  assert.strictEqual(result.category, 'billing');
+  assert.strictEqual(result.urgent, true);
+});
+
+test('continueChat without tools', async () => {
+  const model = scriptedModel([{ text: 'Order is on the way.' }]);
+  const history = [{ role: 'user', content: 'Hi' }, { role: 'assistant', content: 'Hi there!' }];
+  const result = await continueChat(model, history, 'How is my order?', { customerId: 'cust1' });
+  assert.strictEqual(result.length, 4);
+  assert.strictEqual(result[0].role, 'user');
+  assert.strictEqual(result[0].content, 'Hi');
+  assert.strictEqual(result[2].role, 'user');
+  assert.strictEqual(result[2].content, 'How is my order?');
+  assert.strictEqual(result[3].role, 'assistant');
+  assert(Array.isArray(result[3].content));
+  assert.strictEqual(result[3].content[0].type, 'text');
+  assert.strictEqual(result[3].content[0].text, 'Order is on the way.');
+});
+
+test('continueChat with tool use', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'O1' } }] },
+    { text: 'Order O1 is on the way.' },
+  ]);
+  const history = [{ role: 'user', content: 'Hi' }, { role: 'assistant', content: 'Hi there!' }];
+  const result = await continueChat(model, history, 'How is O1?', { customerId: 'cust1' });
+  assert(result.length > 3);
+  assert.strictEqual(result[0].role, 'user');
+  assert.strictEqual(result[0].content, 'Hi');
+});
