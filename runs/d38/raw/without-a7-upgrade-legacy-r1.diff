diff --git a/test-tool-context.mjs b/test-tool-context.mjs
new file mode 100644
index 0000000..bbcf773
--- /dev/null
+++ b/test-tool-context.mjs
@@ -0,0 +1,33 @@
+import { generateText, tool } from 'ai';
+import { z } from 'zod';
+import { scriptedModel } from './test/helpers/mock-model.js';
+
+const testTool = tool({
+  description: 'Test tool with context',
+  inputSchema: z.object({ id: z.string() }),
+  contextSchema: z.object({ userId: z.string() }),
+  execute: async (input, context) => {
+    console.log('Input:', input);
+    console.log('Context:', context);
+    console.log('Context type:', typeof context);
+    console.log('Context keys:', Object.keys(context || {}));
+    return { received: { input, context } };
+  },
+});
+
+const model = scriptedModel([
+  { toolCalls: [{ name: 'testTool', input: { id: 'x' } }] },
+  { text: 'done' }
+]);
+
+try {
+  const result = await generateText({
+    model,
+    tools: { testTool },
+    toolsContext: { userId: 'user123' },
+    prompt: 'call the tool',
+  });
+  console.log('Result:', result.text);
+} catch (e) {
+  console.error('Error:', e.message);
+}
