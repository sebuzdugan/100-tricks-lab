+import { generateText, tool } from 'ai';
+import { z } from 'zod';
+import { scriptedModel } from './test/helpers/mock-model.js';
+
+const testTool = tool({
+  description: 'Test tool with context',
+  inputSchema: z.object({ id: z.string() }),
+  contextSchema: z.object({ userId: z.string() }),
+  execute: async (input, context) => {
+    console.log('Tool executed with:', { input, context });
+    return { ok: true };
+  },
+});
+
+const model = scriptedModel([
+  { text: 'No tools for now' }
+]);
+
+const result = await generateText({
+  model,
+  tools: { testTool },
+  toolsContext: { userId: 'user123' },
+  prompt: 'just answer',
+});
+
+console.log('Model was called with:');
+model.calls.forEach((call, i) => {
+  console.log(`Call ${i}:`, {
+    hasTools: !!call.tools,
+    hasToolsContext: !!call.toolsContext,
+    toolsContext: call.toolsContext,
+  });
+});
