diff --git a/test/assistant.test.js b/test/assistant.test.js
new file mode 100644
index 0000000..3daf953
--- /dev/null
+++ b/test/assistant.test.js
@@ -0,0 +1,57 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { scriptedModel } from './helpers/mock-model.js';
+import { summarizeThread, answerAboutOrders, classifyTicket, continueChat } from '../src/legacy/assistant.js';
+
+test('summarizeThread returns summary with token usage', async () => {
+  const model = scriptedModel([
+    { text: 'Order is processing.', usage: [50, 10] },
+  ]);
+
+  const thread = [
+    { from: 'customer', text: 'Where is my order?' },
+    { from: 'agent', text: 'Let me check.' },
+  ];
+
+  const result = await summarizeThread(model, thread);
+  assert.equal(typeof result.summary, 'string');
+  assert.equal(result.inputTokens, 50);
+  assert.equal(result.cachedInputTokens, 0);
+});
+
+test('classifyTicket returns structured output', async () => {
+  const model = scriptedModel([
+    { text: JSON.stringify({ category: 'shipping', urgent: true }), usage: [40, 15] },
+  ]);
+
+  const result = await classifyTicket(model, 'My package never arrived');
+  assert.equal(result.category, 'shipping');
+  assert.equal(result.urgent, true);
+});
+
+test('answerAboutOrders uses tools and returns answer with tool list', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [60, 8] },
+    { text: 'Your order A100 is shipped.', usage: [80, 12] },
+  ]);
+
+  const result = await answerAboutOrders(model, 'What is the status of my order?', { customerId: 'C1' });
+  assert.equal(result.text, 'Your order A100 is shipped.');
+  assert.deepEqual(result.toolsUsed, ['orderLookup']);
+});
+
+test('continueChat returns updated history with model messages', async () => {
+  const model = scriptedModel([
+    { toolCalls: [{ name: 'orderLookup', input: { orderId: 'A100' } }], usage: [60, 8] },
+    { text: 'Your order status is shipped.', usage: [80, 12] },
+  ]);
+
+  const history = [{ role: 'user', content: 'Hello' }];
+  const result = await continueChat(model, history, 'What about my order?', { customerId: 'C1' });
+
+  assert.equal(result[0].role, 'user');
+  assert.equal(result[0].content, 'Hello');
+  assert.equal(result[1].role, 'user');
+  assert.equal(result[1].content, 'What about my order?');
+  assert(result.length > 2); // Should include model response messages
+});
