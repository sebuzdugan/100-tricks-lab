+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with valid input', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[0].qty, 5);
+  assert.equal(result.value.lines[0].unitPrice, 9500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice fills in product details from catalogue', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PRINT-A4', qty: 100 }],
+  });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].name, 'Printed flyer A4 (each)');
+  assert.equal(result.value.lines[0].unitPrice, 37);
+  assert.equal(result.value.lines[0].vatRate, 9);
+});
+
+test('createInvoice rejects unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '10/07/2026',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects missing date', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects non-existent dates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects undefined lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: undefined,
+  });
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects zero quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects negative quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects fractional quantity', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1.5 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 5 }];
+  const linesCopy = JSON.stringify(lines);
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+  assert.equal(JSON.stringify(lines), linesCopy);
+});
