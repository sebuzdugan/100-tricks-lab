+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(dateStr);
+  if (!match) return false;
+  const d = new Date(dateStr + 'T00:00:00Z');
+  return d instanceof Date && !isNaN(d) && d.toISOString().slice(0, 10) === dateStr;
+}
+
+/**
+ * Create an invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate date format
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  // Validate lines array
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Build invoice lines
+  const invoiceLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Get product
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
