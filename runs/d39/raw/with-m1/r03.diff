   return { subtotal, total: subtotal };
 }
+
+/**
+ * Add or update a line on a draft invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {{ sku: string, qty: number }} params
+ * @returns {{ ok: true, value: typeof invoice } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Get product
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+  const newLine = { sku, name: product.name, qty, unitPrice: product.unitPrice, vatRate: product.vatRate };
+
+  // Check if line with this SKU already exists
+  const existingLineIndex = invoice.lines.findIndex((l) => l.sku === sku);
+
+  let newLines;
+  if (existingLineIndex >= 0) {
+    // Update existing line's qty
+    newLines = invoice.lines.map((line, i) => (i === existingLineIndex ? { ...line, qty: line.qty + qty } : line));
+  } else {
+    // Add new line
+    newLines = [...invoice.lines, newLine];
+  }
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: typeof invoice } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Find line with this SKU
+  const lineIndex = invoice.lines.findIndex((l) => l.sku === sku);
+  if (lineIndex < 0) return fail('LINE_NOT_FOUND');
+
+  // Check if removing it would leave no lines
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new lines array without this line
+  const newLines = invoice.lines.filter((line, i) => i !== lineIndex);
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: newLines,
+  });
+}
