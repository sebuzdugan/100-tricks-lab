+/**
+ * Issue a draft invoice, assigning it a number and marking it as issued.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @param {string[]} existingNumbers
+ * @returns {{ ok: true, value: typeof invoice & { number: string } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Get next invoice number
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    number,
+    status: 'issued',
+    lines: invoice.lines,
+  });
+}
