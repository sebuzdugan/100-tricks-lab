+/**
+ * Calculate the next invoice number for a given year.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {string[]} existingNumbers
+ * @param {string} issueDate
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Extract counters from numbers that match this year
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(`INV-${year}-`))
+    .map((num) => {
+      const parts = num.split('-');
+      return parseInt(parts[2], 10);
+    })
+    .filter((n) => !isNaN(n));
+
+  // Find the highest counter and return next
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
