+++ b/src/render.js
@@ -0,0 +1,32 @@
+import { formatEuros } from './money.js';
+
+/**
+ * Render a plain-text invoice.
+ * @param {{ number?: string, customerId: string, customerName: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // Invoice number or DRAFT
+  const invoiceNumber = invoice.number ?? 'DRAFT';
+  lines.push(invoiceNumber);
+
+  // Customer name
+  lines.push(invoice.customerName);
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const lineAmount = line.qty * line.unitPrice;
+    const qtyStr = String(line.qty);
+    const priceStr = formatEuros(line.unitPrice);
+    const totalStr = formatEuros(lineAmount);
+    lines.push(`${qtyStr}x ${line.name} @ ${priceStr} = ${totalStr}`);
+  }
+
+  // Total line
+  const total = invoice.lines.reduce((sum, line) => sum + line.qty * line.unitPrice, 0);
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return lines.join('\n');
+}
