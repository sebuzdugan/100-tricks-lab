@@ -0,0 +1,142 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText shows DRAFT for unsigned invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    customerName: 'Northwind Studio',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('DRAFT\n'));
+});
+
+test('renderInvoiceText shows invoice number when present', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-001',
+    customerName: 'Northwind Studio',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.startsWith('INV-2026-0001\n'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = {
+    customerId: 'C-001',
+    customerName: 'Northwind Studio',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows each line item', () => {
+  const invoice = {
+    customerId: 'C-001',
+    customerName: 'Northwind Studio',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 },
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // number, customer, 2 items, total
+  assert.ok(lines[2].includes('5x Development (hour)'));
+  assert.ok(lines[2].includes('€95.00')); // 9500 cents = €95.00
+  assert.ok(lines[2].includes('€475.00')); // 5 * 9500 = 47500 cents = €475.00
+});
+
+test('renderInvoiceText formats currency correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    customerName: 'Test Customer',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'PRINT-A4', name: 'Printed flyer A4 (each)', qty: 100, unitPrice: 37, vatRate: 9 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  // 100 * 37 cents = 3700 cents = €37.00
+  assert.ok(text.includes('€0.37')); // unit price
+  assert.ok(text.includes('€37.00')); // line total
+});
+
+test('renderInvoiceText totals all line items', () => {
+  const invoice = {
+    customerId: 'C-001',
+    customerName: 'Northwind Studio',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 },
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 3, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  const lastLine = lines[lines.length - 1];
+  // 5*9500 + 3*8500 = 47500 + 25500 = 73000 cents = €730.00
+  assert.ok(lastLine.startsWith('Total: €730.00'));
+});
+
+test('renderInvoiceText with empty lines array', () => {
+  const invoice = {
+    customerId: 'C-001',
+    customerName: 'Northwind Studio',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[lines.length - 1], 'Total: €0.00');
+});
+
+test('renderInvoiceText preserves line breaks', () => {
+  const invoice = {
+    customerId: 'C-001',
+    customerName: 'Northwind Studio',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 5, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4); // number, customer, 1 item, total
+});
+
+test('renderInvoiceText shows quantity and product name for each line', () => {
+  const invoice = {
+    customerId: 'C-001',
+    customerName: 'Blue Fern Bakery',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 2, unitPrice: 980, vatRate: 21 },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('2x Icon set (24 icons)'));
+});
