+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(dateStr);
+  if (!match) return false;
+  const d = new Date(dateStr + 'T00:00:00Z');
+  return d instanceof Date && !isNaN(d) && d.toISOString().slice(0, 10) === dateStr;
+}
+
+/**
+ * Add days to a date string. Works in UTC.
+ * @param {string} date - A date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (negative to subtract)
+ * @returns {string} - A date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  const year = d.getUTCFullYear();
+  const month = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate the number of days between two dates (b minus a), in whole days, using UTC.
+ * @param {string} a - A date in YYYY-MM-DD format
+ * @param {string} b - A date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days from a to b
+ */
+export function daysBetween(a, b) {
+  const da = new Date(a + 'T00:00:00Z');
+  const db = new Date(b + 'T00:00:00Z');
+  const diffMs = db - da;
+  return Math.floor(diffMs / (24 * 60 * 60 * 1000));
+}
