+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('10/07/2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('26-10-07'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+});
+
+test('isValidDate rejects invalid leap years', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2026-02-29'), false);
+});
+
+test('isValidDate accepts valid leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+});
+
+test('addDays adds positive number of days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+});
+
+test('addDays subtracts negative number of days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+});
+
+test('addDays handles month transitions', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-10-01', -1), '2026-09-30');
+});
+
+test('addDays handles year transitions', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+});
+
+test('daysBetween with same date returns zero', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween across months', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-09-30', '2026-10-31'), 31);
+});
+
+test('daysBetween across years', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+});
+
+test('daysBetween works in whole days regardless of time', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-09'), 2);
+  assert.equal(daysBetween('2026-10-07', '2026-10-10'), 3);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const start = '2026-10-07';
+  const end = addDays(start, 7);
+  assert.equal(daysBetween(start, end), 7);
+});
+
+test('daysBetween with leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
