+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('recordPayment adds payment to issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment = recordPayment(issued.value, { amount: 500000, date: '2026-10-15' });
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.payments.length, 1);
+  assert.equal(payment.value.payments[0].amount, 500000);
+  assert.equal(payment.value.payments[0].date, '2026-10-15');
+});
+
+test('recordPayment sets status to partially_paid when not fully paid', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment = recordPayment(issued.value, { amount: 500000, date: '2026-10-15' });
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  // Total for this invoice: 100*9500=950000, discount 10%=95000, amount after discount=855000, VAT 21%=179550, total=1034550
+  const payment = recordPayment(issued.value, { amount: 1034550, date: '2026-10-15' });
+  assert.equal(payment.ok, true);
+  assert.equal(payment.value.status, 'paid');
+});
+
+test('recordPayment allows multiple payments', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment1 = recordPayment(issued.value, { amount: 500000, date: '2026-10-15' });
+  const payment2 = recordPayment(payment1.value, { amount: 534550, date: '2026-10-20' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.payments.length, 2);
+  assert.equal(payment2.value.status, 'paid');
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const payment = recordPayment(result.value, { amount: 100000, date: '2026-10-15' });
+  assert.deepEqual(payment, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects invalid amount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment = recordPayment(issued.value, { amount: 0, date: '2026-10-15' });
+  assert.deepEqual(payment, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects negative amount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment = recordPayment(issued.value, { amount: -100000, date: '2026-10-15' });
+  assert.deepEqual(payment, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects fractional amount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment = recordPayment(issued.value, { amount: 100000.5, date: '2026-10-15' });
+  assert.deepEqual(payment, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  // Total is 1034550, try to pay 1034551
+  const payment = recordPayment(issued.value, { amount: 1034551, date: '2026-10-15' });
+  assert.deepEqual(payment, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('balanceDue returns full total for issued invoice with no payments', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const balance = balanceDue(issued.value);
+  assert.equal(balance, 1034550);
+});
+
+test('balanceDue returns remaining balance after partial payment', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment = recordPayment(issued.value, { amount: 500000, date: '2026-10-15' });
+  const balance = balanceDue(payment.value);
+  assert.equal(balance, 534550);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment = recordPayment(issued.value, { amount: 1034550, date: '2026-10-15' });
+  const balance = balanceDue(payment.value);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue with multiple payments', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment1 = recordPayment(issued.value, { amount: 300000, date: '2026-10-15' });
+  const payment2 = recordPayment(payment1.value, { amount: 200000, date: '2026-10-20' });
+  const balance = balanceDue(payment2.value);
+  assert.equal(balance, 534550);
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const original = JSON.stringify(issued.value);
+  recordPayment(issued.value, { amount: 500000, date: '2026-10-15' });
+  assert.equal(JSON.stringify(issued.value), original);
+});
+
+test('recordPayment preserves other invoice fields', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment = recordPayment(issued.value, { amount: 500000, date: '2026-10-15' });
+  assert.equal(payment.value.customerId, issued.value.customerId);
+  assert.equal(payment.value.customerName, issued.value.customerName);
+  assert.equal(payment.value.issueDate, issued.value.issueDate);
+  assert.equal(payment.value.number, issued.value.number);
+  assert.equal(payment.value.lines.length, issued.value.lines.length);
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment1 = recordPayment(issued.value, { amount: 500000, date: '2026-10-15' });
+  assert.equal(payment1.value.status, 'partially_paid');
+  const payment2 = recordPayment(payment1.value, { amount: 100000, date: '2026-10-20' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.status, 'partially_paid');
+});
+
+test('recordPayment rejects payment on paid invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(result.value, []);
+  const payment = recordPayment(issued.value, { amount: 1034550, date: '2026-10-15' });
+  assert.equal(payment.value.status, 'paid');
+  const anotherPayment = recordPayment(payment.value, { amount: 100000, date: '2026-10-20' });
+  assert.deepEqual(anotherPayment, { ok: false, error: 'NOT_ISSUED' });
+});
