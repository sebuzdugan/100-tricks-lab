+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ customerId: string, customerName: string, issueDate: string, number?: string, status: string, lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} params
+ * @returns {{ ok: true, value: typeof invoice } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check invoice is issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check for overpayment
+  const balance = balanceDue(invoice);
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array with the payment
+  const payments = [...(invoice.payments ?? []), { amount, date }];
+
+  // Calculate new status
+  const totals = invoiceTotals(invoice);
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  let status;
+  if (totalPaid >= totals.total) {
+    status = 'paid';
+  } else {
+    status = 'partially_paid';
+  }
+
+  // Return new invoice with updated payments and status
+  return ok({
+    customerId: invoice.customerId,
+    customerName: invoice.customerName,
+    issueDate: invoice.issueDate,
+    number: invoice.number,
+    status,
+    lines: invoice.lines,
+    payments,
+  });
+}
+
+/**
+ * Calculate the balance due on an invoice (total minus payments).
+ * @param {{ lines: Array, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
