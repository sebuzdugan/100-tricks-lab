diff --git a/src/dates.js b/src/dates.js
index 8f792b9..7087325 100644
--- a/src/dates.js
+++ b/src/dates.js
@@ -37,3 +37,32 @@ export function daysBetween(a, b) {
   const diffMs = db - da;
   return Math.floor(diffMs / (24 * 60 * 60 * 1000));
 }
+
+/**
+ * Calculate the due date for an invoice based on payment terms.
+ * @param {string} issueDate - A date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string|null} - Due date in YYYY-MM-DD format, or null if terms are invalid
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    // Get the last day of the issue date's month
+    const d = new Date(issueDate + 'T00:00:00Z');
+    const year = d.getUTCFullYear();
+    const month = d.getUTCMonth();
+    // Get the first day of next month, then subtract 1 day to get last day of current month
+    const firstOfNextMonth = new Date(Date.UTC(year, month + 1, 1));
+    firstOfNextMonth.setUTCDate(firstOfNextMonth.getUTCDate() - 1);
+    const lastYear = firstOfNextMonth.getUTCFullYear();
+    const lastMonth = String(firstOfNextMonth.getUTCMonth() + 1).padStart(2, '0');
+    const lastDate = String(firstOfNextMonth.getUTCDate()).padStart(2, '0');
+    return `${lastYear}-${lastMonth}-${lastDate}`;
+  }
+  return null;
+}
