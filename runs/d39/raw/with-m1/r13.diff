+/**
+ * Apply a voucher to a draft invoice, reducing the total after VAT.
+ * @param {{ customerId: string, customerName: string, issueDate: string, status: string, lines: Array, terms: string, dueDate: string, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ code: string, amount: number }} params
+ * @returns {{ ok: true, value: typeof invoice } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check no existing voucher
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  // Create new invoice with voucher
+  return ok({
+    customerId: invoice.customerId,
+    customerName: invoice.customerName,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: invoice.lines,
+    terms: invoice.terms,
+    dueDate: invoice.dueDate,
+    voucher: { code, amount },
+  });
+}
