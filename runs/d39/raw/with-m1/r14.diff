+import { ok, fail } from './result.js';
+import { normalizeId, getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
+import { isValidDate } from './dates.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement showing invoices due and amount owed.
+ * @param {string} customerId
+ * @param {Array} invoices
+ * @param {string} asOf - A date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize customer ID
+  const normalizedId = normalizeId(customerId);
+
+  // Validate customer exists
+  const customerResult = getCustomer(normalizedId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Filter invoices for this customer with matching status and date
+  const customerInvoices = invoices
+    .filter(
+      (inv) =>
+        normalizeId(inv.customerId) === normalizedId &&
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.issueDate <= asOf,
+    )
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = customerInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedId,
+    invoices: customerInvoices,
+    totalDue,
+  });
+}
