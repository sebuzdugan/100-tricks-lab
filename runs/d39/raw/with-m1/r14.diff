+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement shows customer invoices', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+  const result = statement('C-001', [issued1.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement filters by customer', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+  const result = statement('C-001', [issued1.value, issued2.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement filters by status', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const draft = invoice1.value;
+  const issued1 = issueInvoice(invoice1.value, []);
+  const result = statement('C-001', [draft, issued1.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement filters by date', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+  const invoice2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-11-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+  const result = statement('C-001', [issued1.value, issued2.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement includes date boundary', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-31',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const result = statement('C-001', [issued.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement excludes future invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-11-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
