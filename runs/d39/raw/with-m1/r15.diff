+  assert.deepEqual(credit, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects fractional amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
