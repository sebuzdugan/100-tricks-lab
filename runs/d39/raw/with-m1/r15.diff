+
+/**
+ * Calculate the next credit note number for a given year.
+ * Format: CN-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {string[]} existingNumbers
+ * @param {string} issueDate
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Extract counters from numbers that match this year
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(`CN-${year}-`))
+    .map((num) => {
+      const parts = num.split('-');
+      return parseInt(parts[2], 10);
+    })
+    .filter((n) => !isNaN(n));
+
+  // Find the highest counter and return next
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
