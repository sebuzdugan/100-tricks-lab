+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const credit = createCreditNote(issued.value, { amount: 100000, reason: 'Discount', date: '2026-10-15' }, []);
+  assert.equal(credit.ok, true);
+  assert.equal(credit.value.number, 'CN-2026-0001');
+  assert.equal(credit.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(credit.value.customerId, 'C-001');
+  assert.equal(credit.value.amount, 100000);
+  assert.equal(credit.value.reason, 'Discount');
+  assert.equal(credit.value.date, '2026-10-15');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const credit = createCreditNote(invoice.value, { amount: 100000, reason: 'Discount', date: '2026-10-15' }, []);
+  assert.deepEqual(credit, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote accepts partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const payment = recordPayment(issued.value, { amount: 500000, date: '2026-10-15' });
+  const credit = createCreditNote(payment.value, { amount: 100000, reason: 'Discount', date: '2026-10-20' }, []);
+  assert.equal(credit.ok, true);
+  assert.equal(credit.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote accepts paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const payment = recordPayment(issued.value, { amount: 1034550, date: '2026-10-15' });
+  const credit = createCreditNote(payment.value, { amount: 100000, reason: 'Adjustment', date: '2026-10-20' }, []);
+  assert.equal(credit.ok, true);
+});
+
+test('createCreditNote rejects invalid amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const credit = createCreditNote(issued.value, { amount: 0, reason: 'Discount', date: '2026-10-15' }, []);
+  assert.deepEqual(credit, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
