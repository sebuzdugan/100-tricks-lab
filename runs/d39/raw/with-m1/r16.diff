+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array for no overdue invoices', () => {
+  const result = overdueInvoices([], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value, []);
+});
+
+test('overdueInvoices finds overdue issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  // Due date: 2026-10-21, check as of 2026-10-31 = 10 days overdue
+  const result = overdueInvoices([issued.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].number, 'INV-2026-0001');
+  assert.equal(result.value[0].dueDate, '2026-10-21');
+  assert.equal(result.value[0].daysOverdue, 10);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const result = overdueInvoices([invoice.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes invoices due in future', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  // Due date: 2026-11-06, check as of 2026-10-31 (still in future)
+  const result = overdueInvoices([issued.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes invoices due today', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  // Due date: 2026-10-21, check as of 2026-10-21 (due today, not overdue)
+  const result = overdueInvoices([issued.value], '2026-10-21');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  // Invoice total: 100*9500=950000, discount 5%=47500, after discount=902500, VAT 21%=189525, total=1092025
+  const payment = recordPayment(issued.value, { amount: 500000, date: '2026-10-15' });
+  assert.equal(payment.ok, true);
+  // Due date: 2026-10-21, check as of 2026-10-31
+  const result = overdueInvoices([payment.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 100 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  // Invoice total: 1092025
+  const payment = recordPayment(issued.value, { amount: 1092025, date: '2026-10-15' });
+  assert.equal(payment.ok, true);
+  // Invoice is now paid, should not appear in overdue
+  const result = overdueInvoices([payment.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices calculates days overdue correctly', () => {
