+import { ok, fail } from './result.js';
+import { daysBetween, isValidDate } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a report of overdue invoices as of a specific date.
+ * @param {Array} invoices
+ * @param {string} asOf - A date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }> } | { ok: false, error: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Filter overdue invoices (status issued or partially_paid, dueDate before asOf)
+  const overdue = invoices
+    .filter(
+      (inv) =>
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.dueDate < asOf,
+    )
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue); // Most overdue first
+
+  return ok(overdue);
+}
