+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+  // Invoice 1 due 2026-10-15, Invoice 2 due 2026-10-24
+  // As of 2026-10-31: Invoice 1 is 16 days overdue, Invoice 2 is 7 days overdue
+  const result = overdueInvoices([issued1.value, issued2.value], '2026-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 2);
+  assert.equal(result.value[0].number, 'INV-2026-0001'); // Most overdue first
