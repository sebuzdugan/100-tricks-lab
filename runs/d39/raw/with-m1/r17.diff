+/**
+ * Generate a VAT summary from invoices.
+ * @param {Array} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const byRate = {}; // Map of rate -> {base, vat}
+
+  invoices
+    .filter(
+      (inv) =>
+        inv.status === 'issued' ||
+        inv.status === 'partially_paid' ||
+        inv.status === 'paid',
+    )
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+
+        // Calculate line total and discount
+        const lineTotal = line.qty * line.unitPrice;
+        const discount = roundCents(
+          lineTotal * (line.discountPercent || 0) / 100,
+        );
+        const base = lineTotal - discount;
+        const vat = roundCents((base * rate) / 100);
+
+        // Add to accumulator
+        if (!byRate[rate]) {
+          byRate[rate] = { base: 0, vat: 0 };
+        }
+        byRate[rate].base += base;
+        byRate[rate].vat += vat;
+      });
+    });
+
+  // Convert to sorted array, high to low
+  return Object.entries(byRate)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseFloat(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
