+/**
+ * Calculate late fee for an invoice.
+ * @param {{ dueDate: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - A date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  // Check if invoice is overdue
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  // Calculate days overdue and amount due
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const amountDue = balanceDue(invoice);
+
+  // Late fee: 0.04% per day of the amount due
+  return roundCents((amountDue * 0.04 * daysOverdue) / 100);
+}
