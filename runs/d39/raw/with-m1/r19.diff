+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as plain euros with 2 decimals and a dot (no sign, no thousands separator).
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEurosPlain(cents) {
+  const euros = Math.floor(cents / 100);
+  const centsPart = cents % 100;
+  return `${euros}.${String(centsPart).padStart(2, '0')}`;
+}
+
+/**
+ * Escape a CSV field: wrap in quotes if it contains comma or quote, and double any quotes.
+ * @param {string} value
+ * @returns {string}
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map((inv) => {
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    return [
+      escapeCsvField(inv.number || ''),
+      escapeCsvField(inv.customerName || ''),
+      escapeCsvField(inv.issueDate || ''),
+      escapeCsvField(inv.dueDate || ''),
+      escapeCsvField(inv.status || ''),
+      formatEurosPlain(totals.subtotal),
+      formatEurosPlain(totals.discount),
+      formatEurosPlain(totals.vat),
+      formatEurosPlain(totals.total),
+      formatEurosPlain(due),
+    ].join(',');
+  });
+
+  return header + lines.join('\n') + (lines.length > 0 ? '\n' : '');
+}
