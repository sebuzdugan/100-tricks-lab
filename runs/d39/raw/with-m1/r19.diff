+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header for empty invoices', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  // Totals: subtotal=95000, discount=4750, vat=18952, total=109202
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  assert.equal(lines[1], 'INV-2026-0001,Northwind Studio,2026-10-07,2026-10-21,issued,950.00,47.50,189.52,1092.02,1092.02');
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+  const result = exportCsv([issued1.value, issued2.value]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4); // header + 2 invoices + final newline
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv formats amounts as plain euros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const result = exportCsv([issued.value]);
+  assert(result.includes('950.00')); // 95000 cents = 950.00 euros
+  assert(result.includes('47.50')); // 4750 cents = 47.50 euros
+  assert(result.includes('189.52')); // 18952 cents = 189.52 euros
+  assert(!result.includes('€'));
+  assert(!result.includes(',000'));
+});
+
+test('exportCsv includes customer name not ID', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const result = exportCsv([issued.value]);
+  assert(result.includes('Northwind Studio'));
+  assert(!result.includes('C-001'));
+});
+
+test('exportCsv quotes field with comma', () => {
+  const invoice = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  // C-006 is "Marlow \"The Print Shop\"" - has quotes but CSV export should escape properly
+  const result = exportCsv([issued.value]);
+  // Customer name should be quoted because it has special characters
+  assert(result.includes('"Marlow'));
+});
+
+test('exportCsv quotes field with double quote', () => {
+  const invoice = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const result = exportCsv([issued.value]);
+  // Customer name has quotes, should be doubled in CSV
+  assert(result.includes('""'));
+});
+
+test('exportCsv handles draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const result = exportCsv([invoice.value]);
+  assert(result.includes(',draft,'));
+});
+
+test('exportCsv includes due amount from balance', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  // Issued invoice with no payments: due = total
+  const result = exportCsv([issued.value]);
+  assert(result.includes('1092.02,1092.02')); // total and due are same
+});
+
+test('exportCsv reduces due for partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const payment = recordPayment(issued.value, { amount: 50000, date: '2026-10-15' });
+  // Total: 109202, Paid: 50000, Due: 109202 - 50000 = 59202
+  const result = exportCsv([payment.value]);
+  assert(result.includes(',1092.02,'));
+  assert(result.includes(',592.02')); // due after partial payment
+});
+
+test('exportCsv ends with newline', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const result = exportCsv([issued.value]);
+  assert(result.endsWith('\n'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const issued1 = issueInvoice(inv1.value, []);
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  const issued2 = issueInvoice(inv2.value, ['INV-2026-0001']);
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-09',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  });
+  const issued3 = issueInvoice(inv3.value, ['INV-2026-0001', 'INV-2026-0002']);
+  const result = exportCsv([issued1.value, issued2.value, issued3.value]);
+  const lines = result.split('\n');
+  assert.equal(lines[1], lines[1]); // Just checking it exists
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+  assert(lines[3].includes('INV-2026-0003'));
+});
+
+test('exportCsv with different VAT rates', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PRINT-A4', qty: 100 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const result = exportCsv([issued.value]);
+  // PRINT-A4: price 37, qty 100, tier discount 5%, VAT 9%
+  // lineTotal = 3700, discount = 185, base = 3515, vat = 316.35 → 316
+  // total = 3515 + 316 = 3831
+  assert(result.includes('37.00')); // subtotal per unit... wait, let me recalculate
+  // subtotal is sum of line totals = 3700
+  // discount = 185
+  // vat = 316
+  // total = 3831
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[5], '37.00'); // subtotal
+  assert.equal(fields[6], '1.85'); // discount
+  assert.equal(fields[7], '3.16'); // vat
+  assert.equal(fields[8], '38.31'); // total
+});
+
+test('exportCsv with invoice with multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'COPY-HOUR', qty: 5 },
+    ],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const result = exportCsv([issued.value]);
+  // DEV-HOUR: 10 * 9500 = 95000, discount 4750, base 90250, vat 18952
+  // COPY-HOUR: 5 * 6000 = 30000, discount 1500, base 28500, vat 5985
+  // Total: subtotal 125000, discount 6250, vat 24937, total 143687
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  assert.equal(fields[5], '1250.00'); // subtotal
+  assert.equal(fields[6], '62.50'); // discount
+  assert.equal(fields[7], '249.37'); // vat
+  assert.equal(fields[8], '1436.87'); // total
+});
+
+test('exportCsv with paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const paid = recordPayment(issued.value, { amount: 109202, date: '2026-10-15' });
+  const result = exportCsv([paid.value]);
+  assert(result.includes(',paid,'));
+  assert(result.includes(',0.00')); // due is 0
+});
