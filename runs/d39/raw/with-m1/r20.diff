diff --git a/src/money.js b/src/money.js
index fadf486..b71106a 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,12 @@
 import { ok, fail } from './result.js';
 
+/** Exchange rates: units of that currency per euro. */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +46,31 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert euro cents to another currency's cents.
+ * @param {number} euroCents
+ * @param {string} currency - 'EUR', 'USD', or 'GBP'
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(euroCents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const rate = RATES[currency];
+  return ok(roundCents(euroCents * rate));
+}
+
+/**
+ * Format cents as currency with sign, thousands separators, and 2 decimals.
+ * @param {number} cents
+ * @param {string} currency - 'EUR', 'USD', or 'GBP'
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const currencySign = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+  return `${sign}${currencySign}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
