+
+/**
+ * Merge a duplicate customer into another, updating all invoices.
+ * @param {Array} customers
+ * @param {Array} invoices
+ * @param {string} fromId - customer ID to merge from
+ * @param {string} intoId - customer ID to merge into
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const fromNorm = normalizeId(fromId);
+  const intoNorm = normalizeId(intoId);
+
+  // Check for same customer
+  if (fromNorm === intoNorm) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  // Check that both customers exist
+  const fromCustomer = customers.find((c) => c.id === fromNorm);
+  const intoCustomer = customers.find((c) => c.id === intoNorm);
+
+  if (!fromCustomer) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+  if (!intoCustomer) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Create new customers array without fromId
+  const newCustomers = customers.filter((c) => c.id !== fromNorm).map((c) => ({ ...c }));
+
+  // Create new invoices array with customerId changed
+  const newInvoices = invoices.map((inv) => ({
+    ...inv,
+    customerId: inv.customerId === fromNorm ? intoNorm : inv.customerId,
+    // Also update lines array to preserve immutability
+    lines: inv.lines ? inv.lines.map((line) => ({ ...line })) : inv.lines,
+  }));
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
