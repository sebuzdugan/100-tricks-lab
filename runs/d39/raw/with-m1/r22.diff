+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 95000);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { qty: 1, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 1000);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with large amounts', () => {
+  const line = { qty: 1000, unitPrice: 500000 };
+  assert.equal(lineTotal(line), 500000000);
+});
+
+test('invoiceTotals sums line totals for subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 6000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 125000); // 95000 + 30000
+});
+
+test('invoiceTotals calculates discount correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 9500); // 95000 * 10 / 100
+});
+
+test('invoiceTotals calculates VAT on discounted amount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // lineTotal = 95000, discount = 4750, base = 90250, vat = 18952.5 → 18952
+  assert.equal(totals.vat, 18952);
+});
+
+test('invoiceTotals with 0% VAT has no VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 37, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: base = 95000, vat = 19950
+  // Line 2: base = 3700, vat = 333
+  // Total vat = 20283
+  assert.equal(totals.vat, 20283);
+});
+
+test('invoiceTotals with multiple lines and discounts and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+      { qty: 5, unitPrice: 6000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line 1: lineTotal = 95000, discount = 4750, base = 90250, vat = 18952
+  // Line 2: lineTotal = 30000, discount = 3000, base = 27000, vat = 5670
+  // subtotal = 125000, discount = 7750, vat = 24622, total = 141872
+  assert.equal(totals.subtotal, 125000);
+  assert.equal(totals.discount, 7750);
+  assert.equal(totals.vat, 24622);
+  assert.equal(totals.total, 141872);
+});
+
+test('invoiceTotals clamps negative total to 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 0 },
+    ],
+    voucher: { code: 'TEST', amount: 100000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes voucher in calculation', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 10000 },
+  };
+  const totals = invoiceTotals(invoice);
+  // base total without voucher = 109202, minus voucher = 99202
+  assert.equal(totals.voucher, 10000);
+  assert.equal(totals.total, 99202);
+});
+
+test('invoiceTotals without voucher has voucher = 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 1000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 210);
+  assert.equal(totals.total, 1210);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with large amounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1000, unitPrice: 500000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 500000000);
+  assert.equal(totals.total, 605000000);
+});
+
+test('invoiceTotals returns correct structure', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+  assert.equal(Object.keys(totals).length, 5);
+});
