+
+/**
+ * Generate a dashboard summary from invoices.
+ * @param {Array} invoices
+ * @param {string} asOf - A date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const inv of invoices) {
+    counts[inv.status]++;
+  }
+
+  // Calculate outstanding (total due on issued and partially_paid)
+  let outstanding = 0;
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      outstanding += balanceDue(inv);
+    }
+  }
+
+  // Calculate overdue
+  const overdueResult = overdueInvoices(invoices, asOf);
+  let overdue = { count: 0, amount: 0 };
+  if (overdueResult.ok) {
+    overdue.count = overdueResult.value.length;
+    overdue.amount = overdueResult.value.reduce((sum, inv) => sum + inv.due, 0);
+  }
+
+  // Calculate top 3 customers by due amount
+  const customerDue = {};
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      if (!customerDue[inv.customerId]) {
+        customerDue[inv.customerId] = 0;
+      }
+      customerDue[inv.customerId] += balanceDue(inv);
+    }
+  }
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return { counts, outstanding, overdue, topCustomers };
+}
