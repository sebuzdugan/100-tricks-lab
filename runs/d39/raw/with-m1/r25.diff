   }
 
   // Calculate totals
@@ -33,8 +39,24 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  // Show voucher if present
+  if (invoice.voucher && invoice.voucher.amount > 0) {
+    lines.push(`Voucher (${invoice.voucher.code}): -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   // Total line
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Show due date if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Show paid amount if there are payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
