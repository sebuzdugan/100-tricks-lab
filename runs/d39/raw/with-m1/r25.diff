 export function renderInvoiceText(invoice) {
@@ -16,13 +16,19 @@ export function renderInvoiceText(invoice) {
   // Customer name
   lines.push(invoice.customerName);
 
-  // Invoice lines
+  // Invoice lines with discounts
   for (const line of invoice.lines) {
     const lineAmount = line.qty * line.unitPrice;
     const qtyStr = String(line.qty);
     const priceStr = formatEuros(line.unitPrice);
     const totalStr = formatEuros(lineAmount);
     lines.push(`${qtyStr}x ${line.name} @ ${priceStr} = ${totalStr}`);
+
+    // Show line discount if present
+    if (line.discountPercent && line.discountPercent > 0) {
+      const discountAmount = Math.round(lineAmount * line.discountPercent / 100);
+      lines.push(`  (discount: -${formatEuros(discountAmount)})`);
