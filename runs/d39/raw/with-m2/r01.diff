+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice returns draft invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2026-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+  assert.equal(result.value.lines[0].sku, 'DEV-HOUR');
+  assert.equal(result.value.lines[0].name, 'Development (hour)');
+  assert.equal(result.value.lines[0].qty, 5);
+  assert.equal(result.value.lines[0].unitPrice, 9500);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].sku, 'STICKER');
+  assert.equal(result.value.lines[1].qty, 100);
+});
+
+test('createInvoice fails with CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'UNKNOWN',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice fails with DATE_INVALID for invalid date format', () => {
+  assert.equal(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026/10/07',
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    }).error,
+    'DATE_INVALID'
+  );
+
+  assert.equal(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '10-07-2026',
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    }).error,
+    'DATE_INVALID'
+  );
+
+  assert.equal(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-13-01',
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    }).error,
+    'DATE_INVALID'
+  );
+
+  assert.equal(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: 'not-a-date',
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    }).error,
+    'DATE_INVALID'
+  );
+});
+
+test('createInvoice fails with NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice fails with NO_LINES for missing lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: undefined,
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice fails with QTY_INVALID for non-integer qty', () => {
+  assert.equal(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 5.5 }],
+    }).error,
+    'QTY_INVALID'
+  );
+
+  assert.equal(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: '5' }],
+    }).error,
+    'QTY_INVALID'
+  );
+
+  assert.equal(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: null }],
+    }).error,
+    'QTY_INVALID'
+  );
+});
+
+test('createInvoice fails with QTY_INVALID for zero or negative qty', () => {
+  assert.equal(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+    }).error,
+    'QTY_INVALID'
+  );
+
+  assert.equal(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+    }).error,
+    'QTY_INVALID'
+  );
+});
+
+test('createInvoice fails with UNKNOWN_SKU for unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 5 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice fails on first invalid line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'UNKNOWN-SKU', qty: 3 },
+    ],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  };
+  const inputLines = input.lines;
+
+  createInvoice(input);
+
+  assert.equal(input.customerId, 'C-001');
+  assert.equal(input.issueDate, '2026-10-07');
+  assert.strictEqual(input.lines, inputLines);
+  assert.equal(input.lines[0].sku, 'DEV-HOUR');
+  assert.equal(input.lines[0].qty, 5);
+  assert.equal(Object.keys(input.lines[0]).length, 2);
+});
+
+test('createInvoice with various SKUs from catalogue', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'PRINT-A4', qty: 500 },
+      { sku: 'WORKSHOP-DAY', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].name, 'Logo package');
+  assert.equal(result.value.lines[0].unitPrice, 120000);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].name, 'Printed flyer A4 (each)');
+  assert.equal(result.value.lines[1].unitPrice, 37);
+  assert.equal(result.value.lines[1].vatRate, 9);
+  assert.equal(result.value.lines[2].name, 'Brand workshop (day, VAT exempt)');
+  assert.equal(result.value.lines[2].unitPrice, 60000);
+  assert.equal(result.value.lines[2].vatRate, 0);
+});
