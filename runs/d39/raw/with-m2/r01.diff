+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(dateStr);
+  if (!match) return false;
+  const date = new Date(dateStr + 'T00:00:00Z');
+  return date instanceof Date && !isNaN(date.getTime());
+}
+
+/**
+ * Create a draft invoice with the given customer and line items.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: unknown }> }} input
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  if (!isValidDate(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+
+  const customer = getCustomer(customerId);
+  if (!customer.ok) {
+    return customer;
+  }
+
+  if (!lines || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  const invoiceLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    const product = getProduct(line.sku);
+    if (!product.ok) {
+      return product;
+    }
+
+    invoiceLines.push({
+      sku: line.sku,
+      name: product.value.name,
+      qty: line.qty,
+      unitPrice: product.value.unitPrice,
+      vatRate: product.value.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: invoiceLines,
+  });
+}
