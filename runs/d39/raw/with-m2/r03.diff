+/**
+ * Add or update a line on a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: unknown }} input
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  if (!Number.isInteger(qty) || qty <= 0) {
+    return fail('QTY_INVALID');
+  }
+
+  const product = getProduct(sku);
+  if (!product.ok) {
+    return product;
+  }
+
+  const existingLineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+
+  let newLines;
+  if (existingLineIndex >= 0) {
+    newLines = invoice.lines.map((line, index) => {
+      if (index === existingLineIndex) {
+        return { ...line, qty: line.qty + qty };
+      }
+      return { ...line };
+    });
+  } else {
+    newLines = [
+      ...invoice.lines.map((line) => ({ ...line })),
+      {
+        sku,
+        name: product.value.name,
+        qty,
+        unitPrice: product.value.unitPrice,
+        vatRate: product.value.vatRate,
+      },
+    ];
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+
+  if (lineIndex < 0) {
+    return fail('LINE_NOT_FOUND');
+  }
+
+  if (invoice.lines.length === 1) {
+    return fail('NO_LINES');
+  }
+
+  const newLines = invoice.lines.filter((line) => line.sku !== sku).map((line) => ({ ...line }));
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
