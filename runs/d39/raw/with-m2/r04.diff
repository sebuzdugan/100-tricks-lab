@@ -0,0 +1,86 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for empty list', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2026-0001'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0003', 'INV-2025-0001'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber finds max counter in current year', () => {
+  const existing = [
+    'INV-2026-0001',
+    'INV-2026-0003',
+    'INV-2026-0002',
+  ];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = [
+    'INV-2025-0010',
+    'INV-2026-0001',
+    'INV-2024-0099',
+  ];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber zero-pads to 4 digits', () => {
+  const existing = ['INV-2026-0999'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-1000');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2026-9998'];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-9999');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = [
+    'INV-2026-ABC',
+    'INV-2026-0001',
+    'INVOICE-2026-0002',
+  ];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber with mixed valid and invalid numbers', () => {
+  const existing = [
+    'INV-2026-0001',
+    'INVALID',
+    'INV-2026',
+    'INV-2026-0003',
+  ];
+  const result = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(result, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber works with different years in same batch', () => {
+  const existing = [
+    'INV-2024-0001',
+    'INV-2025-0005',
+    'INV-2026-0002',
+    'INV-2027-0001',
+  ];
+  const result2025 = nextInvoiceNumber(existing, '2025-06-15');
+  const result2026 = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(result2025, 'INV-2025-0006');
+  assert.equal(result2026, 'INV-2026-0003');
+});
