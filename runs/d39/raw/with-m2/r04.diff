+/**
+ * Issue a draft invoice, assigning it a number and changing status to 'issued'.
+ * @param {{ status: string, issueDate: string, lines: Array }} invoice
+ * @param {string[]} existingNumbers
+ * @returns {{ ok: true, value: { status: string, number: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    ...invoice,
+    number,
+    status: 'issued',
+  });
+}
