+/**
+ * Generate the next invoice number based on existing numbers and issue date.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded, restarting each year.
+ * @param {string[]} existingNumbers
+ * @param {string} issueDate in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterStr = num.substring(prefix.length);
+      const counter = parseInt(counterStr, 10);
+      if (!isNaN(counter)) {
+        maxCounter = Math.max(maxCounter, counter);
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
