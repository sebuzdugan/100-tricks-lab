+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.includes('DRAFT'));
+  assert(text.includes('Northwind Studio'));
+  assert(text.includes('5 × Development (hour)'));
+  assert(text.includes('€95.00'));
+  assert(text.includes('Total: €475.00'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+
+  assert(text.includes('INV-2026-0001'));
+  assert(text.includes('Blue Fern Bakery'));
+  assert(text.includes('100 × Sticker sheet'));
+  assert(text.includes('€0.50'));
+  assert(text.includes('€50.00'));
+  assert(text.includes('Total: €50.00'));
+});
+
+test('renderInvoiceText with multiple line items', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'PRINT-A4', qty: 500 },
+      { sku: 'STICKER', qty: 25 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.includes('DRAFT'));
+  assert(text.includes('Kite & Co'));
+  assert(text.includes('1 × Logo package'));
+  assert(text.includes('€1,200.00'));
+  assert(text.includes('500 × Printed flyer A4 (each)'));
+  assert(text.includes('€0.37'));
+  assert(text.includes('25 × Sticker sheet'));
+  assert(text.includes('€0.50'));
+  assert(text.includes('€12.50'));
+});
+
+test('renderInvoiceText calculates correct totals', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // 3 × €95.00 = €285.00
+  // 2 × €60.00 = €120.00
+  // Total = €405.00
+  assert(text.includes('€405.00'));
+});
+
+test('renderInvoiceText shows invoice with various VAT rates', () => {
+  const result = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 1 },
+      { sku: 'PRINT-A3', qty: 2 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  assert(text.includes('Brand guidelines document'));
+  assert(text.includes('€2,450.00'));
+  assert(text.includes('Printed poster A3 (each)'));
+  assert(text.includes('€2.49'));
+  assert(text.includes('Brand workshop (day, VAT exempt)'));
+  assert(text.includes('€600.00'));
+});
+
+test('renderInvoiceText format has correct structure', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'STICKER', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 5);
+  assert(lines[0].includes('DRAFT'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[2].includes('1 × Development (hour)'));
+  assert(lines[3].includes('1 × Sticker sheet'));
+  assert(lines[4].startsWith('Total: '));
+});
+
+test('renderInvoiceText with issued invoice from different year', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, ['INV-2025-0001']);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+
+  assert(text.includes('INV-2025-0002'));
+  assert(text.includes('Development (hour)'));
+});
+
+test('renderInvoiceText formats large amounts correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // 5 × €2,450.00 = €12,250.00
+  assert(text.includes('€2,450.00'));
+  assert(text.includes('€12,250.00'));
+});
+
+test('renderInvoiceText includes all line details', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // Should have: qty × name @ unitPrice = lineTotal
+  assert(text.includes('5 ×'));
+  assert(text.includes('Development (hour)'));
+  assert(text.includes('@'));
+  assert(text.includes('€95.00'));
+  assert(text.includes('='));
+  assert(text.includes('€475.00'));
+});
+
+test('renderInvoiceText with very small quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  // €9.80 for Icon set (24 icons)
+  assert(text.includes('€9.80'));
+  assert(text.includes('Icon set (24 icons)'));
+});
