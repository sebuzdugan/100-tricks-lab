@@ -27,24 +27,31 @@ export function lineTotal(line) {
 
 /**
  * Calculate totals for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }} all in cents
+ * VAT is calculated per line on the amount after discount, then rounded per line.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }} all in cents
  */
 export function invoiceTotals(invoice) {
   let subtotal = 0;
   let totalDiscount = 0;
+  let totalVat = 0;
 
   for (const line of invoice.lines) {
-    const total = lineTotal(line);
-    const lineDiscount = roundCents(total * ((line.discountPercent || 0) / 100));
-    subtotal += total;
+    const lineTotal = line.qty * line.unitPrice;
+    const lineDiscount = roundCents(lineTotal * ((line.discountPercent || 0) / 100));
+    const lineAmountAfterDiscount = lineTotal - lineDiscount;
+    const lineVat = roundCents(lineAmountAfterDiscount * (line.vatRate / 100));
+
+    subtotal += lineTotal;
     totalDiscount += lineDiscount;
+    totalVat += lineVat;
   }
 
   const discount = Math.max(0, totalDiscount);
-  const total = Math.max(0, subtotal - discount);
+  const vat = Math.max(0, totalVat);
+  const total = Math.max(0, subtotal - discount + vat);
 
-  return { subtotal, discount, total };
+  return { subtotal, discount, vat, total };
 }
 
