@@ -12,6 +12,15 @@ export const TIER_DISCOUNTS = {
   standard: 0,
 };
 
+/**
+ * Normalize a customer ID: trim whitespace and convert to uppercase.
+ * @param {string} id
+ * @returns {string}
+ */
+export function normalizeId(id) {
+  return String(id).trim().toUpperCase();
+}
+
 /**
  * All customers: { id, name, email, country, tier }.
  */
@@ -24,7 +33,8 @@ export function listCustomers() {
  * @param {string} id
  */
 export function getCustomer(id) {
-  const c = CUSTOMERS.find((x) => x.id === id);
+  const normalizedId = normalizeId(id);
+  const c = CUSTOMERS.find((x) => x.id === normalizedId);
   return c ? ok({ ...c }) : fail('CUSTOMER_NOT_FOUND');
 }
 
