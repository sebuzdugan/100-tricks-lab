+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('  C-001  '), 'C-001');
+  assert.equal(normalizeId('C-001 '), 'C-001');
+  assert.equal(normalizeId(' C-001'), 'C-001');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('c-007'), 'C-007');
+  assert.equal(normalizeId('C-001'), 'C-001');
+});
+
+test('normalizeId trims and uppercases', () => {
+  assert.equal(normalizeId('  c-001  '), 'C-001');
+  assert.equal(normalizeId(' C-007 '), 'C-007');
+  assert.equal(normalizeId('  c-007  '), 'C-007');
+});
+
+test('normalizeId handles mixed case with spaces', () => {
+  assert.equal(normalizeId('c-001 '), 'C-001');
+  assert.equal(normalizeId(' C-001'), 'C-001');
+  assert.equal(normalizeId('c-007 '), 'C-007');
+});
+
+test('getCustomer normalizes ID before lookup', () => {
+  const result = getCustomer('c-001');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.id, 'C-001');
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer normalizes ID with spaces', () => {
+  const result = getCustomer('  c-001  ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.id, 'C-001');
+});
+
+test('getCustomer normalizes uppercase ID with spaces', () => {
+  const result = getCustomer(' C-007 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.id, 'C-007');
+  assert.equal(result.value.name, 'Halvorsen Architects');
+});
+
+test('getCustomer still returns CUSTOMER_NOT_FOUND for invalid IDs', () => {
+  const result = getCustomer('c-999');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('getCustomer returns CUSTOMER_NOT_FOUND even with spaces and case', () => {
+  const result = getCustomer('  c-999  ');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
