+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * Uses UTC to avoid timezone issues.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const match = /^\d{4}-\d{2}-\d{2}$/.test(text);
+  if (!match) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  if (!(date instanceof Date && !isNaN(date.getTime()))) {
+    return false;
+  }
+  // Verify the parsed date matches the input (catches invalid dates like Feb 30)
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  const formatted = `${year}-${month}-${day}`;
+  return formatted === text;
+}
+
+/**
+ * Parse a YYYY-MM-DD date string into a Date object in UTC.
+ * @param {string} dateStr
+ * @returns {Date}
+ */
+function parseDate(dateStr) {
+  return new Date(dateStr + 'T00:00:00Z');
+}
+
+/**
+ * Format a Date object as YYYY-MM-DD string (UTC).
+ * @param {Date} date
+ * @returns {string}
+ */
+function formatDate(date) {
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Add days to a date in YYYY-MM-DD format (UTC).
+ * @param {string} date
+ * @param {number} n
+ * @returns {string}
+ */
+export function addDays(date, n) {
+  const d = parseDate(date);
+  d.setUTCDate(d.getUTCDate() + n);
+  return formatDate(d);
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a, in UTC).
+ * @param {string} a
+ * @param {string} b
+ * @returns {number}
+ */
+export function daysBetween(a, b) {
+  const dateA = parseDate(a);
+  const dateB = parseDate(b);
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB - dateA) / msPerDay);
+}
