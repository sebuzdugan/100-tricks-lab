+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('balanceDue for issued invoice with no payments', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const balance = balanceDue(issued.value);
+  // 1 × €95.00 + 21% VAT = €114.95
+  assert.equal(balance, 11495);
+});
+
+test('balanceDue with payments', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const invoice = {
+    ...issued.value,
+    payments: [
+      { amount: 5000, date: '2026-10-08' },
+      { amount: 3000, date: '2026-10-09' },
+    ],
+  };
+
+  const balance = balanceDue(invoice);
+  // Total: €114.95, Paid: €80.00, Due: €34.95
+  assert.equal(balance, 3495);
+});
+
+test('balanceDue for fully paid invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const invoice = {
+    ...issued.value,
+    payments: [{ amount: 6050, date: '2026-10-08' }],
+  };
+
+  const balance = balanceDue(invoice);
+  // 100 × €0.50 + 21% VAT = €60.50
+  assert.equal(balance, 0);
+});
+
+test('recordPayment on issued invoice', () => {
