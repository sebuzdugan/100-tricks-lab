+/**
+ * Calculate the due date based on payment terms and issue date.
+ * @param {string} issueDate in YYYY-MM-DD format
+ * @param {string} terms 'NET14', 'NET30', or 'EOM'
+ * @returns {string|null} due date in YYYY-MM-DD format, or null if terms invalid
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    // Get the last day of the month
+    const date = new Date(issueDate + 'T00:00:00Z');
+    const year = date.getUTCFullYear();
+    const month = date.getUTCMonth();
+
+    // Create date for first day of next month
+    const nextMonth = new Date(Date.UTC(year, month + 1, 1));
+    // Subtract one day to get last day of current month
+    nextMonth.setUTCDate(nextMonth.getUTCDate() - 1);
+
+    const day = String(nextMonth.getUTCDate()).padStart(2, '0');
+    const monthStr = String(nextMonth.getUTCMonth() + 1).padStart(2, '0');
+    const yearStr = nextMonth.getUTCFullYear();
+
+    return `${yearStr}-${monthStr}-${day}`;
+  } else {
+    return null;
+  }
+}
