+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: { code: string } }} invoice
+ * @param {{ code: string, amount: unknown }} input
+ * @returns {{ ok: true, value: { status: string, voucher: { code: string, amount: number } } } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  if (invoice.voucher) {
+    return fail('VOUCHER_EXISTS');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
+
