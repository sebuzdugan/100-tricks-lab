+
+test('statement includes number, issueDate, dueDate, total, and due for each invoice', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+      terms: 'NET30',
+    }).value,
+    [],
