+
+test('statement calculates totalDue as sum of all dues', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv2 = recordPayment(
+    issueInvoice(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: '2026-10-02',
+        lines: [{ sku: 'STICKER', qty: 3 }],
+      }).value,
+      [],
+    ).value,
+    { amount: 50, date: '2026-10-03' },
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2], '2026-10-07');
+  assert.equal(result.ok, true);
+  const expectedTotalDue = result.value.invoices[0].due + result.value.invoices[1].due;
+  assert.equal(result.value.totalDue, expectedTotalDue);
