+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns customer not found for unknown customer', () => {
+  const result = statement('UNKNOWN_CUSTOMER', [], '2026-10-07');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement with no invoices returns empty list and zero total due', () => {
+  const result = statement('C-001', [], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('statement includes only issued and partially_paid invoices', () => {
+  const draftInv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 5 }],
+  }).value;
+
+  const issuedInv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-02',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const partiallyPaidInv = recordPayment(
+    issueInvoice(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: '2026-10-03',
+        lines: [{ sku: 'STICKER', qty: 5 }],
+      }).value,
+      [],
+    ).value,
+    { amount: 100, date: '2026-10-04' },
+  ).value;
+
+  const paidInv = recordPayment(
+    recordPayment(
+      issueInvoice(
+        createInvoice({
+          customerId: 'C-001',
+          issueDate: '2026-10-04',
+          lines: [{ sku: 'STICKER', qty: 5 }],
+        }).value,
+        [],
+      ).value,
+      { amount: 100, date: '2026-10-05' },
+    ).value,
+    { amount: 188, date: '2026-10-06' },
+  ).value;
+
+  const result = statement('C-001', [draftInv, issuedInv, partiallyPaidInv, paidInv], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, issuedInv.number);
+  assert.equal(result.value.invoices[1].number, partiallyPaidInv.number);
+});
+
+test('statement includes only invoices for the specified customer', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-02',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, inv1.number);
+});
+
+test('statement includes only invoices with issueDate on or before asOf', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv2 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-05',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const inv3 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-10',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv1, inv2, inv3], '2026-10-05');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(result.value.invoices[1].issueDate, '2026-10-05');
