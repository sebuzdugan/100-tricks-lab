+
+test('statement normalizes customer ID', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'c-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
