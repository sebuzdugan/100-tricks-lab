+  assert.equal(stmtInv.issueDate, '2026-10-01');
+  assert.equal(stmtInv.dueDate, '2026-10-31');
+  assert.ok(typeof stmtInv.total === 'number');
+  assert.ok(typeof stmtInv.due === 'number');
