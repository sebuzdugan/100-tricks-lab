+
+test('statement calculates due correctly for fully issued invoice', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].due, result.value.invoices[0].total);
+});
+
+test('statement calculates due correctly for partially paid invoice', () => {
+  const inv = recordPayment(
+    issueInvoice(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        lines: [{ sku: 'STICKER', qty: 5 }],
+      }).value,
+      [],
+    ).value,
+    { amount: 100, date: '2026-10-02' },
+  ).value;
+
+  const result = statement('C-001', [inv], '2026-10-07');
+  assert.equal(result.ok, true);
+  const stmtInv = result.value.invoices[0];
+  const expectedDue = stmtInv.total - 100;
+  assert.equal(stmtInv.due, expectedDue);
