+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement listing open invoices as of a given date.
+ * @param {string} customerId
+ * @param {Array} invoices all invoices in the system
+ * @param {string} asOf statement date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Verify customer exists
+  const customer = getCustomer(customerId);
+  if (!customer.ok) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  // Filter invoices for this customer with status 'issued' or 'partially_paid' and issueDate <= asOf
+  const statementInvoices = invoices
+    .filter(
+      (inv) =>
+        inv.customerId === customerId &&
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.issueDate <= asOf,
+    )
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
