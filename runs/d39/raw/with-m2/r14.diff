+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-05',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
