+
+  assert.equal(inv.customerId, 'C-001');
+
+  const result = statement('C-001', [inv], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement with no matching invoices for customer returns empty statement', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.invoices, []);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement returns correct structure', () => {
+  const inv = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = statement('C-001', [inv], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.ok(result.value.customerId);
+  assert.ok(Array.isArray(result.value.invoices));
+  assert.ok(typeof result.value.totalDue === 'number');
+});
