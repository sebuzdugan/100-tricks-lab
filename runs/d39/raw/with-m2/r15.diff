+      ).value,
+      { amount: 300, date: '2026-10-02' },
+    ).value,
+    { amount: 275, date: '2026-10-03' },
+  ).value;
+
+  assert.equal(invoice.status, 'paid');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 50, reason: 'Partial refund', date: '2026-10-04' },
+    [],
+  );
+
+  assert.equal(result.ok, true);
+});
