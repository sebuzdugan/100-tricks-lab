+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote returns credit note for issued invoice', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 10 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 100, reason: 'Defective product', date: '2026-10-02' },
+    [],
+  );
+
+  assert.equal(result.ok, true);
+  assert.ok(result.value.number);
+  assert.equal(result.value.invoiceNumber, invoice.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 100);
+  assert.equal(result.value.reason, 'Defective product');
+  assert.equal(result.value.date, '2026-10-02');
+});
+
+test('createCreditNote fails with NOT_ISSUED for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 10 }],
+  }).value;
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 100, reason: 'Test', date: '2026-10-02' },
+    [],
+  );
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote works on paid invoice', () => {
+  const invoice = recordPayment(
