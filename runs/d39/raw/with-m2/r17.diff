+/**
+ * Summarize VAT by rate across invoices.
+ * Returns one entry per VAT rate found, sorted by rate descending.
+ * @param {Array} invoices all invoices in the system
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const lineTotal = line.qty * line.unitPrice;
+      const lineDiscount = roundCents(lineTotal * ((line.discountPercent || 0) / 100));
+      const lineAmountAfterDiscount = lineTotal - lineDiscount;
+      const lineVat = roundCents(lineAmountAfterDiscount * (line.vatRate / 100));
+
+      const rate = line.vatRate;
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { base: 0, vat: 0 };
+      }
+      vatByRate[rate].base += lineAmountAfterDiscount;
+      vatByRate[rate].vat += lineVat;
+    }
+  }
+
+  return Object.entries(vatByRate)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseInt(rate, 10),
+      base: Math.max(0, base),
+      vat: Math.max(0, vat),
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
