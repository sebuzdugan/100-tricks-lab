+/**
+ * Calculate late fee for an invoice.
+ * 0.04% per day of amount still due, from dueDate to asOf.
+ * Returns 0 if invoice is not overdue.
+ * @param {{ dueDate: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf date in YYYY-MM-DD format
+ * @returns {number} late fee in cents, rounded
+ */
+export function lateFee(invoice, asOf) {
+  if (!invoice.dueDate || invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const amountDue = balanceDue(invoice);
+
+  if (daysOverdue <= 0 || amountDue <= 0) {
+    return 0;
+  }
+
+  return Math.max(0, roundCents(amountDue * 0.0004 * daysOverdue));
+}
