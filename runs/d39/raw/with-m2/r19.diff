+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns CSV string with header', () => {
+  const result = exportCsv([]);
+  assert.ok(result.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv header ends with newline', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.ok(lines.length >= 2);
+});
+
+test('exportCsv with empty invoice list returns only header', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv includes draft invoice with empty number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 5 }],
+  }).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].includes('draft'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = exportCsv([invoice]);
+  assert.ok(result.includes('.'));
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  for (let i = 5; i < 10; i++) {
+    const field = fields[i];
+    const lastDotIndex = field.lastIndexOf('.');
+    if (lastDotIndex !== -1) {
+      const decimals = field.substring(lastDotIndex + 1);
+      assert.equal(decimals.length, 2, `Field ${i} (${field}) should have exactly 2 decimals`);
+    }
+  }
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
+    }).value,
+    [],
+  ).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  assert.ok(lines[1].includes('Northwind Studio'));
+});
+
+test('exportCsv escapes commas in customer names', () => {
+  const invoice = issueInvoice(
+    createInvoice({
+      customerId: 'C-004',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'STICKER', qty: 5 }],
