+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format an amount in cents as euros with 2 decimal places.
+ * @param {number} cents
+ * @returns {string} e.g., "1234.50"
+ */
+function formatEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field value.
+ * If it contains a comma or double quote, wrap in quotes and escape internal quotes.
+ * @param {string} value
+ * @returns {string}
+ */
+function escapeCsvField(value) {
+  if (value.includes(',') || value.includes('"')) {
+    return '"' + value.replace(/"/g, '""') + '"';
+  }
+  return value;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices
+ * @returns {string} CSV content with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due';
+
+  const lines = [header];
+
+  for (const invoice of invoices) {
+    const customer = getCustomer(invoice.customerId);
+    const customerName = customer.ok ? customer.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number || '',
+      escapeCsvField(customerName),
+      invoice.issueDate || '',
+      invoice.dueDate || '',
+      invoice.status || '',
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    lines.push(fields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
