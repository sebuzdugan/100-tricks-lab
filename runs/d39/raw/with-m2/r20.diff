 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +48,45 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount in EUR cents to another currency in that currency's cents.
+ * @param {number} eurCents amount in cents
+ * @param {string} currency currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(eurCents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const currencyCents = eurCents * RATES[currency];
+  return ok(roundCents(currencyCents));
+}
+
+/**
+ * Format cents in a given currency for people.
+ * @param {number} cents amount in that currency's cents
+ * @param {string} currency currency code (EUR, USD, GBP)
+ * @returns {string} formatted amount with currency sign
+ */
+export function formatMoney(cents, currency) {
+  if (!RATES[currency]) {
+    return formatEuros(cents);
+  }
+
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const amount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const decimals = String(abs % 100).padStart(2, '0');
+
+  switch (currency) {
+    case 'USD':
+      return `${sign}$${amount}.${decimals}`;
+    case 'GBP':
+      return `${sign}£${amount}.${decimals}`;
+    case 'EUR':
+    default:
+      return `${sign}€${amount}.${decimals}`;
+  }
+}
