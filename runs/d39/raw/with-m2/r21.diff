+- **Request 21**: Add customer merge functionality
+  - Added mergeCustomers(customers, invoices, fromId, intoId) to src/customers.js
+  - Returns ok({ customers, invoices }) where:
+    - fromId customer is removed from customers array
+    - All invoices with fromId are reassigned to intoId
+    - All other invoice fields preserved
+  - Normalizes both IDs before checking/processing
+  - Errors:
+    - CUSTOMER_NOT_FOUND if either ID doesn't exist
+    - SAME_CUSTOMER if both IDs are the same customer
+  - Never mutates input arrays or objects
+  - Added error code: SAME_CUSTOMER
+  - Added 14 comprehensive tests for merge functionality
+  - All 304 tests passing (290 existing + 14 new)
+
 ## Constraints
 - Money is always integer cents (use roundCents())
 - Never throw; return fail(CODE) with codes in ERRORS
diff --git a/src/customers.js b/src/customers.js
index 4aa8fa6..8094415 100644
--- a/src/customers.js
+++ b/src/customers.js
@@ -46,3 +46,41 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge duplicate customers: move all invoices from fromId to intoId and remove fromId.
+ * @param {Array} customers
+ * @param {Array} invoices
+ * @param {string} fromId customer id to merge from (will be deleted)
+ * @param {string} intoId customer id to merge into (will keep all invoices)
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  const fromCustomer = customers.find((c) => c.id === normalizedFromId);
+  const intoCustomer = customers.find((c) => c.id === normalizedIntoId);
+
+  if (!fromCustomer || !intoCustomer) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const newCustomers = customers.filter((c) => c.id !== normalizedFromId).map((c) => ({ ...c }));
+
+  const newInvoices = invoices.map((inv) => {
+    if (inv.customerId === normalizedFromId) {
+      return { ...inv, customerId: normalizedIntoId };
+    }
+    return { ...inv };
+  });
+
+  return ok({
+    customers: newCustomers,
+    invoices: newInvoices,
+  });
+}
