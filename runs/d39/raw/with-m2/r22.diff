@@ -0,0 +1,195 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal returns qty times unitPrice', () => {
+  const result = lineTotal({ qty: 5, unitPrice: 100 });
+  assert.equal(result, 500);
+});
+
+test('lineTotal with zero quantity', () => {
+  const result = lineTotal({ qty: 0, unitPrice: 100 });
+  assert.equal(result, 0);
+});
+
+test('lineTotal with large values', () => {
+  const result = lineTotal({ qty: 1000, unitPrice: 50000 });
+  assert.equal(result, 50000000);
+});
+
+test('invoiceTotals with single line no discount', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 100, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 500);
+  assert.equal(result.discount, 0);
+  assert.ok(result.vat > 0);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, discountPercent: 10, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 1000);
+  assert.equal(result.discount, 100);
+  assert.equal(result.total, 900);
+});
+
+test('invoiceTotals with VAT', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 100, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.vat, 2100);
+  assert.equal(result.total, 12100);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 100, discountPercent: 0, vatRate: 21 },
+      { qty: 3, unitPrice: 200, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 1100);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'TEST', amount: 200 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 1000);
+  assert.equal(result.voucher, 200);
+  assert.equal(result.total, 800);
+});
+
+test('invoiceTotals without voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 0);
+});
+
+test('invoiceTotals returns all fields', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 100, discountPercent: 5, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.ok(result.subtotal >= 0);
+  assert.ok(result.discount >= 0);
+  assert.ok(result.vat >= 0);
+  assert.ok(result.voucher >= 0);
+  assert.ok(result.total >= 0);
+});
+
+test('invoiceTotals with zero VAT rate', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.vat, 0);
+  assert.equal(result.total, 1000);
+});
+
+test('invoiceTotals with no discount specified defaults to 0', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 100, vatRate: 0 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 0);
+});
+
+test('invoiceTotals clamps negative values to 0', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 2000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.ok(result.total >= 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 100, discountPercent: 0, vatRate: 21 },
+      { qty: 3, unitPrice: 100, discountPercent: 0, vatRate: 9 },
+      { qty: 2, unitPrice: 100, discountPercent: 0, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 1000);
+  assert.ok(result.vat > 0);
+});
+
+test('invoiceTotals with complex scenario', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 5, unitPrice: 500, discountPercent: 5, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.ok(result.subtotal > 0);
+  assert.ok(result.discount > 0);
+  assert.ok(result.vat > 0);
+  assert.ok(result.total > 0);
+});
+
+test('invoiceTotals with large quantities', () => {
+  const invoice = {
+    lines: [{ qty: 10000, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 100000000);
+});
+
+test('invoiceTotals discount calculation per line', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 0 },
+      { qty: 50, unitPrice: 100, discountPercent: 20, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  const expectedDiscount = 1000 + 1000;
+  assert.equal(result.discount, expectedDiscount);
+});
+
+test('lineTotal does not modify input', () => {
+  const line = { qty: 5, unitPrice: 100 };
+  const lineCopy = JSON.stringify(line);
+  lineTotal(line);
+  assert.equal(JSON.stringify(line), lineCopy);
+});
+
+test('invoiceTotals does not modify input', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 100, discountPercent: 0, vatRate: 21 }],
+  };
+  const invoiceCopy = JSON.stringify(invoice);
+  invoiceTotals(invoice);
+  assert.equal(JSON.stringify(invoice), invoiceCopy);
+});
+
+test('invoiceTotals with voucher has amount field', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'TEST', amount: 0 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 0);
+});
+
+test('lineTotal consistency across multiple calls', () => {
+  const line = { qty: 7, unitPrice: 143 };
+  const result1 = lineTotal(line);
+  const result2 = lineTotal(line);
+  assert.equal(result1, result2);
+});
