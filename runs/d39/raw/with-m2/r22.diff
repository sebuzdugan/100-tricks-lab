+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total amount for a single line item.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number} qty × unitPrice in cents
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate totals for an invoice.
+ * VAT is calculated per line on the amount after discount, then rounded per line.
+ * Voucher is applied after VAT.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} all in cents
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let totalDiscount = 0;
+  let totalVat = 0;
+
+  for (const line of invoice.lines) {
+    const lineTotal = line.qty * line.unitPrice;
+    const lineDiscount = roundCents(lineTotal * ((line.discountPercent || 0) / 100));
+    const lineAmountAfterDiscount = lineTotal - lineDiscount;
+    const lineVat = roundCents(lineAmountAfterDiscount * (line.vatRate / 100));
+
+    subtotal += lineTotal;
+    totalDiscount += lineDiscount;
+    totalVat += lineVat;
+  }
+
+  const discount = Math.max(0, totalDiscount);
+  const vat = Math.max(0, totalVat);
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+
+  return { subtotal, discount, vat, voucher, total };
+}
