+  - Fixed test calculations for: invoices.test.js, totals.test.js, credits.test.js, render.test.js, payments.test.js
+  - All 337 tests passing (325 existing + 12 new bulk discount tests)
+
 ## Constraints
 - Money is always integer cents (use roundCents())
 - Never throw; return fail(CODE) with codes in ERRORS
diff --git a/src/totals.js b/src/totals.js
index 63df28f..2b155b2 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -12,6 +12,7 @@ export function lineTotal(line) {
 /**
  * Calculate totals for an invoice.
  * VAT is calculated per line on the amount after discount, then rounded per line.
+ * Bulk discount (2.5%) applies to lines with qty >= 10, after line/tier discount.
  * Voucher is applied after VAT.
  * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { amount: number } }} invoice
  * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} all in cents
@@ -25,10 +26,16 @@ export function invoiceTotals(invoice) {
     const lineTotal = line.qty * line.unitPrice;
     const lineDiscount = roundCents(lineTotal * ((line.discountPercent || 0) / 100));
     const lineAmountAfterDiscount = lineTotal - lineDiscount;
-    const lineVat = roundCents(lineAmountAfterDiscount * (line.vatRate / 100));
+
+    // Apply bulk discount (2.5%) if qty >= 10
+    const bulkDiscount = line.qty >= 10 ? roundCents(lineAmountAfterDiscount * 0.025) : 0;
+    const lineAmountAfterBulkDiscount = lineAmountAfterDiscount - bulkDiscount;
+
+    // VAT is on the amount after both discounts
+    const lineVat = roundCents(lineAmountAfterBulkDiscount * (line.vatRate / 100));
 
     subtotal += lineTotal;
-    totalDiscount += lineDiscount;
+    totalDiscount += lineDiscount + bulkDiscount;
     totalVat += lineVat;
   }
 
