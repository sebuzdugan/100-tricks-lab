 import { getCustomer } from './customers.js';
 import { lineTotal, invoiceTotals } from './invoices.js';
 import { formatEuros } from './money.js';
+import { balanceDue } from './payments.js';
 
 /**
  * Render an invoice as plain text.
  * First line: invoice number or DRAFT
  * Second line: customer name
  * One line per invoice line: qty × name @ unitPrice = lineTotal
- * Last line: Total: <total>
- * @param {{ number?: string, customerId: string, lines: Array }} invoice
+ * Additional line per line with discount: Discount: -amount
+ * Voucher line (if any): Voucher: -amount
+ * VAT line (if > 0): VAT: amount
+ * Total line: Total: amount
+ * Due date line (if present): Due: date
+ * Paid line (if has payments): Paid: amount
+ * @param {{ number?: string, customerId: string, lines: Array, dueDate?: string, payments?: Array, voucher?: { amount: number } }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -24,19 +30,43 @@ export function renderInvoiceText(invoice) {
   // Second line: customer name
   lines.push(customerName);
 
-  // Line items
+  // Line items with optional discount
   for (const line of invoice.lines) {
     const total = lineTotal(line);
     const lineText = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
     lines.push(lineText);
+
+    // Show line discount if present
+    if (line.discountPercent > 0) {
+      const discountAmount = Math.round(total * (line.discountPercent / 100));
+      lines.push(`  Discount: -${formatEuros(discountAmount)}`);
+    }
   }
 
-  // VAT and total lines
+  // VAT line
   const totals = invoiceTotals(invoice);
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+
+  // Voucher line (if any)
+  if (invoice.voucher) {
+    lines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
+
+  // Total line
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date line (if invoice is issued and has due date)
+  if (invoice.number && invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid line (if has payments)
+  if (invoice.payments && invoice.payments.length > 0) {
+    const amountPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(amountPaid)}`);
+  }
+
   return lines.join('\n');
 }
