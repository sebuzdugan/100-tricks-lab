+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<counter> where counter is 4 digits zero-padded.
+ * @param {Array<string>} existingNumbers - Array of existing invoice numbers (e.g., ["INV-2024-0001"])
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(`INV-${year}-`))
+    .map((num) => {
+      const counter = num.split('-')[2];
+      return Number(counter);
+    });
+
+  const maxCounter = thisYearNumbers.length > 0 ? Math.max(...thisYearNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
