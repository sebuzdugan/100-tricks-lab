diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..bc60277
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,47 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003'];
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existing = ['INV-2024-0003', 'INV-2024-0001', 'INV-2024-0005', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(number, 'INV-2024-0006');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2023-0001', 'INV-2023-0100', 'INV-2024-0001', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const existing = ['INV-2023-0001', 'INV-2023-0002', 'INV-2024-0001'];
+  const number = nextInvoiceNumber(existing, '2025-01-01');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0100');
+});
+
+test('nextInvoiceNumber does not mutate existing numbers', () => {
+  const existing = ['INV-2024-0001'];
+  const originalExisting = JSON.parse(JSON.stringify(existing));
+
+  nextInvoiceNumber(existing, '2024-06-15');
+
+  assert.deepEqual(existing, originalExisting);
+});
