+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders draft invoice with correct format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert(lines[2].includes('10x Development (hour)'));
+  assert(lines[2].includes('€95.00'));
+  assert(lines[2].includes('€950.00'));
+  assert(lines[3].includes('1x Logo package'));
+  assert(lines[3].includes('€1,200.00'));
+  assert(lines[4].startsWith('Total: €'));
+});
+
+test('renderInvoiceText renders issued invoice with number', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-20',
+    lines: [{ sku: 'COPY-HOUR', qty: 5 }],
+  });
+
+  assert.equal(r1.ok, true);
+  const r2 = issueInvoice(r1.value, []);
+  assert.equal(r2.ok, true);
+
+  const text = renderInvoiceText(r2.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2024-0001');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert(lines[2].includes('5x Copywriting (hour)'));
+  assert(lines[2].includes('€60.00'));
+});
+
+test('renderInvoiceText calculates line totals correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-03-10',
+    lines: [{ sku: 'PRINT-A4', qty: 100 }],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+
+  assert(text.includes('100x Printed flyer A4 (each)'));
+  assert(text.includes('€0.37'));
+  assert(text.includes('€37.00'));
+  assert(text.includes('Total: €37.00'));
+});
+
+test('renderInvoiceText formats euros correctly with thousands separator', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+
+  assert(text.includes('€2,450.00'));
+  assert(text.includes('Total: €2,450.00'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'HOST-MONTH', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+
+  assert(text.includes('Orchard Health'));
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'COPY-HOUR', qty: 4 },
+      { sku: 'SUPPORT-HOUR', qty: 2 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 6); // DRAFT, Customer, 3 items, Total
+  assert(lines[2].includes('8x Development'));
+  assert(lines[3].includes('4x Copywriting'));
+  assert(lines[4].includes('2x Support'));
+});
+
+test('renderInvoiceText has correct total for multi-line invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 }, // €950.00
+      { sku: 'LOGO-PACK', qty: 1 }, // €1,200.00
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+
+  assert(text.includes('Total: €2,150.00'));
+});
+
+test('renderInvoiceText preserves item order', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 1 },
+      { sku: 'SUPPORT-HOUR', qty: 1 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert(lines[2].includes('Development'));
+  assert(lines[3].includes('Copywriting'));
+  assert(lines[4].includes('Support'));
+});
+
+test('renderInvoiceText formats with 2 decimal places', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'PHOTO-LIC', qty: 1 }], // €9.96
+  });
+
+  assert.equal(r.ok, true);
+  const text = renderInvoiceText(r.value);
+
+  assert(text.includes('€9.96'));
+  assert(text.includes('Total: €9.96'));
+});
+
+test('renderInvoiceText does not mutate invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(r.ok, true);
+  const originalInvoice = JSON.parse(JSON.stringify(r.value));
+
+  renderInvoiceText(r.value);
+
+  assert.deepEqual(r.value, originalInvoice);
+});
