@@ -115,6 +115,23 @@ Build invoicing functionality into the repo over a series of requests.
 - Added 11 new tier discount tests
 - All 92 tests pass (83 existing + 9 new tier discount tests)
 
+## Request 8: VAT Calculations (Completed)
+- Added `lineVAT(line)` function:
+  - Calculates VAT on line amount after discount
+  - Formula: (lineTotal - lineDiscount) × vatRate / 100
+  - Rounded with roundCents(), clamped to 0
+- Updated `invoiceTotals()` to return { subtotal, discount, vat, total }:
+  - vat = sum of all line VATs
+  - total = subtotal - discount + vat (clamped to 0)
+- Updated `renderInvoiceText()`:
+  - Shows VAT line when vat > 0
+  - Shows Subtotal/Discount/VAT lines when discount > 0 OR vat > 0
+  - All amounts formatted with formatEuros()
+- Decision: VAT is computed per line and rounded per line, invoice VAT is sum of line VATs
+- Added 10 new VAT tests (6 in invoices, 7 in render)
+- Updated 9 existing tests to account for VAT in totals
+- All 105 tests pass (92 existing + 13 new VAT tests)
+
 ## Constraints Followed
 - Money stored as integer cents
 - Never throw; use fail() for errors
diff --git a/src/invoices.js b/src/invoices.js
index 9685034..5b94749 100644
--- a/src/invoices.js
+++ b/src/invoices.js
@@ -91,18 +91,32 @@ export function lineDiscount(line) {
   return Math.max(0, discount);
 }
 
+/**
+ * Calculate the VAT for a single line.
+ * VAT is calculated on the line amount after discount.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const baseAmount = lineTotal(line) - lineDiscount(line);
+  const vat = roundCents(baseAmount * line.vatRate / 100);
+  return Math.max(0, vat);
+}
+
 /**
  * Calculate totals for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }}
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
-  const total = Math.max(0, subtotal - discount);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const total = Math.max(0, subtotal - discount + vat);
   return {
     subtotal,
     discount,
+    vat,
     total,
   };
 }
