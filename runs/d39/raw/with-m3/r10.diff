diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..9dfce72
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,97 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2024-01-15'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('1999-01-01'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('01-15-2024'), false); // wrong order
+  assert.equal(isValidDate('2024-1-15'), false); // missing leading zero
+  assert.equal(isValidDate('2024-01-5'), false); // missing leading zero
+  assert.equal(isValidDate('2024/01/15'), false); // wrong separator
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('not-a-date'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2024-02-30'), false); // Feb has 28/29 days
+  assert.equal(isValidDate('2024-04-31'), false); // April has 30 days
+  assert.equal(isValidDate('2023-02-29'), false); // 2023 is not a leap year
+  assert.equal(isValidDate('2024-13-01'), false); // month 13
+  assert.equal(isValidDate('2024-00-01'), false); // month 0
+  assert.equal(isValidDate('2024-01-00'), false); // day 0
+  assert.equal(isValidDate('2024-01-32'), false); // day 32
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2024-01-15', 0), '2024-01-15');
+  assert.equal(addDays('2024-01-15', 1), '2024-01-16');
+  assert.equal(addDays('2024-01-15', 10), '2024-01-25');
+  assert.equal(addDays('2024-01-31', 1), '2024-02-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2024-01-15', -1), '2024-01-14');
+  assert.equal(addDays('2024-01-15', -10), '2024-01-05');
+  assert.equal(addDays('2024-02-01', -1), '2024-01-31');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-03-01', -1), '2024-02-29');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+});
+
+test('addDays works across months', () => {
+  assert.equal(addDays('2024-01-31', 3), '2024-02-03');
+  assert.equal(addDays('2024-11-28', 5), '2024-12-03');
+});
+
+test('daysBetween calculates correct difference', () => {
+  assert.equal(daysBetween('2024-01-15', '2024-01-15'), 0);
+  assert.equal(daysBetween('2024-01-15', '2024-01-16'), 1);
+  assert.equal(daysBetween('2024-01-15', '2024-01-25'), 10);
+  assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365); // 2024 is a leap year, 366 days, so 365 day difference
+});
+
+test('daysBetween handles negative differences', () => {
+  assert.equal(daysBetween('2024-01-16', '2024-01-15'), -1);
+  assert.equal(daysBetween('2024-01-25', '2024-01-15'), -10);
+  assert.equal(daysBetween('2024-12-31', '2024-01-01'), -365);
+});
+
+test('daysBetween across years', () => {
+  assert.equal(daysBetween('2023-12-31', '2024-01-01'), 1);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is a leap year
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+});
+
+test('daysBetween works across months', () => {
+  assert.equal(daysBetween('2024-01-31', '2024-02-03'), 3);
+  assert.equal(daysBetween('2024-11-28', '2024-12-03'), 5);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const date = '2024-01-15';
+  for (let n = -100; n <= 100; n += 10) {
+    const newDate = addDays(date, n);
+    const days = daysBetween(date, newDate);
+    assert.equal(days, n);
+  }
+});
+
+test('date functions use UTC and ignore local timezone', () => {
+  // These tests verify consistent UTC behavior
+  assert.equal(isValidDate('2024-01-15'), true);
+  assert.equal(addDays('2024-01-15', 1), '2024-01-16');
+  // daysBetween should be consistent regardless of when the test runs
+  assert.equal(daysBetween('2024-01-15', '2024-01-16'), 1);
+});
