+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('balanceDue returns full total when no payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const balance = balanceDue(issued.value);
+  const expectedTotal = 10 * 9500 + (10 * 9500 * 0.21); // 95000 + 19950 = 114950
+  assert.equal(balance, 114950);
+});
+
+test('balanceDue subtracts payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const invoice = {
+    ...issued.value,
+    payments: [
+      { amount: 50000, date: '2024-01-20' },
+      { amount: 30000, date: '2024-01-25' },
+    ],
+  };
+
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 114950 - 80000); // 34950
+});
+
+test('balanceDue returns 0 when fully paid', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const invoice = {
+    ...issued.value,
+    payments: [{ amount: 114950, date: '2024-01-20' }],
+  };
+
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 0);
+});
+
+test('recordPayment requires issued or partially_paid status', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0, name: 'Dev', unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 10000, date: '2024-01-20' });
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment validates amount is positive integer', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  assert.deepEqual(recordPayment(issued.value, { amount: 0, date: '2024-01-20' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(recordPayment(issued.value, { amount: -1000, date: '2024-01-20' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(recordPayment(issued.value, { amount: 1000.5, date: '2024-01-20' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  // Balance is 114950, try to pay 150000
+  const result = recordPayment(issued.value, { amount: 150000, date: '2024-01-20' });
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = recordPayment(issued.value, { amount: 50000, date: '2024-01-20' });
+  assert.equal(result.ok, true);
+  assert.equal(Array.isArray(result.value.payments), true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2024-01-20');
+});
+
+test('recordPayment sets status to partially_paid when balance remains', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+  assert.equal(issued.value.status, 'issued');
+
+  const result = recordPayment(issued.value, { amount: 50000, date: '2024-01-20' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = recordPayment(issued.value, { amount: 114950, date: '2024-01-20' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment can be called on partially_paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const r1 = recordPayment(issued.value, { amount: 50000, date: '2024-01-20' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.status, 'partially_paid');
+
+  const r2 = recordPayment(r1.value, { amount: 64950, date: '2024-01-25' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'paid');
+  assert.equal(r2.value.payments.length, 2);
+});
+
+test('recordPayment does not mutate input invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const originalInvoice = JSON.parse(JSON.stringify(issued.value));
+  recordPayment(issued.value, { amount: 50000, date: '2024-01-20' });
+
+  assert.deepEqual(issued.value, originalInvoice);
+});
+
+test('recordPayment with multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  let invoice = issued.value;
+  invoice = recordPayment(invoice, { amount: 30000, date: '2024-01-20' }).value;
+  invoice = recordPayment(invoice, { amount: 40000, date: '2024-01-25' }).value;
+  invoice = recordPayment(invoice, { amount: 44950, date: '2024-01-30' }).value;
+
+  assert.equal(invoice.status, 'paid');
+  assert.equal(invoice.payments.length, 3);
+  assert.equal(balanceDue(invoice), 0);
+});
