@@ -3,14 +3,36 @@ import { getCustomer, TIER_DISCOUNTS, normalizeId } from './customers.js';
 import { getProduct } from './catalogue.js';
 import { nextInvoiceNumber } from './numbering.js';
 import { roundCents } from './money.js';
-import { isValidDate } from './dates.js';
+import { isValidDate, addDays } from './dates.js';
+
+/**
+ * Calculate due date based on payment terms.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string} - Due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    // Last day of the month
+    const [year, month] = issueDate.split('-').map(Number);
+    const nextMonth = new Date(Date.UTC(year, month, 1)); // 1st of next month
+    nextMonth.setUTCDate(0); // Go back to last day of current month
+    const lastDay = String(nextMonth.getUTCDate()).padStart(2, '0');
+    return `${year}-${String(month).padStart(2, '0')}-${lastDay}`;
+  }
+  return null;
+}
 
