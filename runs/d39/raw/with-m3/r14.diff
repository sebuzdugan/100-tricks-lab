+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns empty invoices list for customer with no invoices', () => {
+  const r = statement('C-001', [], '2024-01-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.deepEqual(r.value.invoices, []);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = statement('UNKNOWN', [], '2024-01-31');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement normalizes customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued = issueInvoice(r1.value, []);
+  assert.equal(issued.ok, true);
+
+  // Statement with mixed case and spaces
+  const r = statement('c-001 ', [issued.value], '2024-01-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+});
+
+test('statement filters issued invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued = issueInvoice(r1.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = statement('C-001', [issued.value], '2024-01-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, issued.value.number);
+});
+
+test('statement excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  // Keep as draft, don't issue
+  const r = statement('C-001', [r1.value], '2024-01-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued = issueInvoice(r1.value, []);
+  assert.equal(issued.ok, true);
+
+  const partial = recordPayment(issued.value, { amount: 50000, date: '2024-01-20' });
+  assert.equal(partial.ok, true);
+  assert.equal(partial.value.status, 'partially_paid');
+
+  const r = statement('C-001', [partial.value], '2024-01-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement excludes paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued = issueInvoice(r1.value, []);
+  assert.equal(issued.ok, true);
+
+  const paid = recordPayment(issued.value, { amount: 114950, date: '2024-01-20' });
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.status, 'paid');
+
+  const r = statement('C-001', [paid.value], '2024-01-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
+test('statement filters by asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued = issueInvoice(r1.value, []);
+  assert.equal(issued.ok, true);
+
+  // Statement before issue date
+  const r = statement('C-001', [issued.value], '2024-01-14');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+
+  // Statement on issue date
+  const r2 = statement('C-001', [issued.value], '2024-01-15');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices.length, 1);
+
+  // Statement after issue date
+  const r3 = statement('C-001', [issued.value], '2024-01-31');
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.invoices.length, 1);
+});
+
+test('statement includes invoice details', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued = issueInvoice(r1.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = statement('C-001', [issued.value], '2024-01-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+
+  const inv = r.value.invoices[0];
+  assert.equal(inv.number, issued.value.number);
+  assert.equal(inv.issueDate, '2024-01-15');
+  assert.equal(inv.dueDate, '2024-02-14'); // NET30 default
+  assert.equal(inv.total, 114950); // 10 * 9500 + 21% VAT
+  assert.equal(inv.due, 114950); // No payment yet
+});
+
+test('statement calculates due amount correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued = issueInvoice(r1.value, []);
+  assert.equal(issued.ok, true);
+
+  const partial = recordPayment(issued.value, { amount: 50000, date: '2024-01-20' });
+  assert.equal(partial.ok, true);
+
+  const r = statement('C-001', [partial.value], '2024-01-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+
+  const inv = r.value.invoices[0];
+  assert.equal(inv.total, 114950);
+  assert.equal(inv.due, 64950); // 114950 - 50000
+});
+
+test('statement sums totalDue across multiple invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued1 = issueInvoice(r1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  assert.equal(r2.ok, true);
+
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']);
+  assert.equal(issued2.ok, true);
+
+  const r = statement('C-001', [issued1.value, issued2.value], '2024-02-28');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+
+  // First invoice: 10 * 9500 + VAT = 114950
+  // Second invoice: 5 * 9500 + VAT = 57475
+  const expected = 114950 + 57475;
+  assert.equal(r.value.totalDue, expected);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued1 = issueInvoice(r1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r2.ok, true);
+
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']);
+  assert.equal(issued2.ok, true);
+
+  // Pass in reverse chronological order to verify sorting
+  const r = statement('C-001', [issued1.value, issued2.value], '2024-02-28');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].issueDate, '2024-01-10');
+  assert.equal(r.value.invoices[1].issueDate, '2024-01-20');
+});
+
+test('statement excludes other customers invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  const issued1 = issueInvoice(r1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  assert.equal(r2.ok, true);
+
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']);
+  assert.equal(issued2.ok, true);
+
+  const r = statement('C-001', [issued1.value, issued2.value], '2024-02-28');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, issued1.value.number);
+});
+
+test('statement with multiple partial payments', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(r1.ok, true);
+
+  let issued = issueInvoice(r1.value, []);
+  assert.equal(issued.ok, true);
+
+  let paid = recordPayment(issued.value, { amount: 40000, date: '2024-01-20' });
+  assert.equal(paid.ok, true);
+
+  paid = recordPayment(paid.value, { amount: 30000, date: '2024-01-25' });
+  assert.equal(paid.ok, true);
+
+  const r = statement('C-001', [paid.value], '2024-02-28');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].due, 44950); // 114950 - 40000 - 30000
+  assert.equal(r.value.totalDue, 44950);
+});
