+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { nextNumber } from './numbering.js';
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, invoiceTotal?: number }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {Array<string>} existingNumbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice is issued, partially_paid, or paid
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  // Calculate invoice total for comparison
+  const invoiceTotal = invoiceTotals(invoice).total;
+
+  // Validate credit amount doesn't exceed invoice total
+  if (amount > invoiceTotal) return fail('CREDIT_TOO_HIGH');
+
+  // Generate credit note number
+  const number = nextNumber(existingNumbers, 'CN', date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
