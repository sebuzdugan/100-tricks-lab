+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote requires invoice to be issued', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  // Keep as draft, don't issue
+
+  const result = createCreditNote(r.value, { amount: 10000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote accepts issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 10000);
+  assert.equal(result.value.reason, 'Refund');
+});
+
+test('createCreditNote accepts partially_paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const partial = recordPayment(issued.value, { amount: 50000, date: '2024-01-20' });
+  assert.equal(partial.ok, true);
+  assert.equal(partial.value.status, 'partially_paid');
+
+  const result = createCreditNote(partial.value, { amount: 10000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote accepts paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const paid = recordPayment(issued.value, { amount: 114950, date: '2024-01-20' });
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.status, 'paid');
+
+  const result = createCreditNote(paid.value, { amount: 10000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote validates amount is positive integer', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  assert.deepEqual(createCreditNote(issued.value, { amount: 0, reason: 'Refund', date: '2024-01-20' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(createCreditNote(issued.value, { amount: -1000, reason: 'Refund', date: '2024-01-20' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(createCreditNote(issued.value, { amount: 1000.5, reason: 'Refund', date: '2024-01-20' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice total is 114950, try to credit 150000
+  const result = createCreditNote(issued.value, { amount: 150000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit up to invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice total is 114950, credit exactly that amount
+  const result = createCreditNote(issued.value, { amount: 114950, reason: 'Full refund', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 114950);
+});
+
+test('createCreditNote includes invoice number', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, issued.value.number);
+});
+
+test('createCreditNote includes customer ID', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createCreditNote generates CN numbers', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote increments CN counter per year', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const r1 = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.number, 'CN-2024-0001');
+
+  const r2 = createCreditNote(issued.value, { amount: 5000, reason: 'Partial', date: '2024-01-25' }, ['CN-2024-0001']);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  // Mix of invoice and credit note numbers
+  const existingNumbers = ['INV-2024-0001', 'INV-2024-0002', 'CN-2024-0001'];
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2024-01-20' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote resets counter for different year', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  // Existing credit note from 2024
+  const existingNumbers = ['CN-2024-0005'];
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Refund', date: '2025-01-20' }, existingNumbers);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote includes all required fields', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Damaged goods', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+
+  const cn = result.value;
+  assert.equal(typeof cn.number, 'string');
+  assert(cn.number.startsWith('CN-2024-'));
+  assert.equal(cn.invoiceNumber, issued.value.number);
+  assert.equal(cn.customerId, 'C-001');
+  assert.equal(cn.amount, 10000);
+  assert.equal(cn.reason, 'Damaged goods');
+  assert.equal(cn.date, '2024-01-20');
+});
+
+test('createCreditNote with discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice total with 10% discount and VAT
+  // subtotal: 95000, discount: 9500, vat: 17955, total: 103455
+  const result = createCreditNote(issued.value, { amount: 103455, reason: 'Full refund', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 103455);
+
+  // Credit more than total should fail
+  const result2 = createCreditNote(issued.value, { amount: 103456, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.deepEqual(result2, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote with voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  let invoice = r.value;
+
+  // Add a voucher
+  const r2 = applyVoucher(invoice, { code: 'SAVE50', amount: 10000 });
+  assert.equal(r2.ok, true);
+  invoice = r2.value;
+
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice total: 95000 + 19950 - 10000 = 104950
+  const result = createCreditNote(issued.value, { amount: 104950, reason: 'Full refund', date: '2024-01-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 104950);
+});
