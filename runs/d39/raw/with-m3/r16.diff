+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2024-02-01');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice due date is 2024-02-14 (NET30 default)
+  // Report date is 2024-02-14, so not overdue
+  const result = overdueInvoices([issued.value], '2024-02-14');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes invoice when dueDate is before asOf', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice due date is 2024-02-14, report date is 2024-02-15
+  const result = overdueInvoices([issued.value], '2024-02-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, issued.value.number);
+});
+
+test('overdueInvoices includes required fields', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = overdueInvoices([issued.value], '2024-02-20');
+  assert.equal(result.length, 1);
+
+  const inv = result[0];
+  assert.equal(typeof inv.number, 'string');
+  assert.equal(inv.customerId, 'C-001');
+  assert.equal(inv.dueDate, '2024-02-14');
+  assert.equal(typeof inv.daysOverdue, 'number');
+  assert(inv.daysOverdue > 0);
+  assert.equal(typeof inv.due, 'number');
+  assert(inv.due > 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice due date is 2024-02-14
+  // Report date is 2024-02-24 (10 days later)
+  const result = overdueInvoices([issued.value], '2024-02-24');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 10);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  // Keep as draft, don't issue
+
+  const result = overdueInvoices([r.value], '2024-02-20');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
