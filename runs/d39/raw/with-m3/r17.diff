 }
+
+/**
+ * Get VAT summary across invoices.
+ * @param {Array<object>} invoices - All invoices to summarize
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  // Accumulate by VAT rate
+  const vatByRate = {};
+
+  invoices
+    .filter((inv) => ['issued', 'partially_paid', 'paid'].includes(inv.status))
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVAT(line);
+
+        if (!vatByRate[rate]) {
+          vatByRate[rate] = { rate, base: 0, vat: 0 };
+        }
+        vatByRate[rate].base += base;
+        vatByRate[rate].vat += vat;
+      });
+    });
+
+  // Convert to array and sort by rate descending
+  return Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
+}
