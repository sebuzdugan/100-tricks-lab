 /**
  * Get invoices that are overdue as of a given date.
@@ -50,3 +51,23 @@ export function vatSummary(invoices) {
   // Convert to array and sort by rate descending
   return Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fee for an invoice.
+ * Fee is 0.04% of the amount due for each day overdue.
+ * @param {object} invoice - Invoice to calculate fee for
+ * @param {string} asOf - Date in YYYY-MM-DD format (report date)
+ * @returns {number} Late fee in cents, rounded and clamped to 0
+ */
+export function lateFee(invoice, asOf) {
+  // Check if invoice is overdue
+  if (invoice.dueDate >= asOf) return 0;
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const amountDue = balanceDue(invoice);
+
+  // Fee = amount due * 0.04% * days overdue
+  // 0.04% = 0.0004
+  const fee = roundCents(amountDue * 0.0004 * daysOverdue);
+  return Math.max(0, fee);
+}
