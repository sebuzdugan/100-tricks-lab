+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv exports empty array as header only', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv includes invoice data', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3); // header + data + trailing newline
+  assert(lines[1].includes('INV-2024-0001'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[1].includes('2024-01-15'));
+  assert(lines[1].includes('2024-02-14'));
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv formats amounts correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // subtotal: 95000 = 950.00
+  // discount: 0 = 0.00
+  // vat: 19950 = 199.50
+  // total: 114950 = 1149.50
+  // due: 114950 = 1149.50
+  assert.equal(fields[5], '950.00');
+  assert.equal(fields[6], '0.00');
+  assert.equal(fields[7], '199.50');
+  assert.equal(fields[8], '1149.50');
+  assert.equal(fields[9], '1149.50');
+});
+
+test('exportCsv with discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // subtotal: 95000 = 950.00
+  // discount: 9500 = 95.00
+  // vat: 17955 = 179.55
+  // total: 103455 = 1034.55
+  assert.equal(fields[5], '950.00');
+  assert.equal(fields[6], '95.00');
+  assert.equal(fields[7], '179.55');
+  assert.equal(fields[8], '1034.55');
+});
+
+test('exportCsv with partial payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const partial = recordPayment(issued.value, { amount: 50000, date: '2024-01-20' });
+  assert.equal(partial.ok, true);
+
+  const result = exportCsv([partial.value]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // total: 114950 = 1149.50
+  // due: 64950 = 649.50
+  assert.equal(fields[8], '1149.50');
+  assert.equal(fields[9], '649.50');
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const r = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  // C-004 is "Smith, Jones & Partners" which contains a comma
+  // Should be escaped as "Smith, Jones & Partners"
+  assert(lines[1].includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer name with quote', () => {
+  const r = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  // C-006 is "Marlow \"The Print Shop\"" which contains quotes
+  // Should be escaped as "Marlow ""The Print Shop"""
+  assert(lines[1].includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv multiple invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r1.ok, true);
+  const issued1 = issueInvoice(r1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  assert.equal(r2.ok, true);
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']);
+  assert.equal(issued2.ok, true);
+
+  const result = exportCsv([issued1.value, issued2.value]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4); // header + 2 data + trailing newline
+  assert(lines[1].includes('INV-2024-0001'));
+  assert(lines[2].includes('INV-2024-0002'));
+});
+
+test('exportCsv ends with newline', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  assert(result.endsWith('\n'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invoices = [];
+
+  for (let i = 0; i < 3; i++) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: `2024-01-${15 + i}`,
+      lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }],
+    });
+
+    assert.equal(r.ok, true);
+    const issued = issueInvoice(r.value, invoices.map((inv) => inv.number));
+    assert.equal(issued.ok, true);
+    invoices.push(issued.value);
+  }
+
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+
+  assert(lines[1].includes('INV-2024-0001'));
+  assert(lines[2].includes('INV-2024-0002'));
+  assert(lines[3].includes('INV-2024-0003'));
+});
+
+test('exportCsv with draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  // Don't issue, keep as draft
+
+  const result = exportCsv([r.value]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // Draft invoices don't have a number (field will be undefined or empty string)
+  assert(fields[0] === '' || fields[0] === 'undefined');
+  assert.equal(fields[4], 'draft');
+});
+
+test('exportCsv calculates correct due for paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const paid = recordPayment(issued.value, { amount: 114950, date: '2024-01-20' });
+  assert.equal(paid.ok, true);
+
+  const result = exportCsv([paid.value]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // total: 114950 = 1149.50
+  // due: 0 = 0.00
+  assert.equal(fields[8], '1149.50');
+  assert.equal(fields[9], '0.00');
+});
+
+test('exportCsv formats small amounts correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'STICKER', qty: 1, discountPercent: 0 }], // 50 cents * 1.21 = 60.5 cents
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // Should have proper decimal formatting
+  assert(fields[5].includes('.'));
+  assert(fields[8].includes('.'));
+});
+
+test('exportCsv does not include comma in number field', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+  const issued = issueInvoice(r.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = exportCsv([issued.value]);
+  const lines = result.split('\n');
+
+  // Split by comma but the invoice number should not be quoted
+  const fields = lines[1].split(',');
+  assert.equal(fields[0], 'INV-2024-0001');
+  assert(!fields[0].includes('"'));
+});
