+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { getCustomer } from './customers.js';
+
+/**
+ * Format amount in cents as euros with 2 decimals.
+ * @param {number} cents - Amount in cents
+ * @returns {string} Formatted amount (e.g., "1234.50")
+ */
+function formatAmount(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Escape a value for CSV: quote if it contains comma or quote, and double any quotes.
+ * @param {string} value - Value to escape
+ * @returns {string} Escaped value
+ */
+function escapeCsvField(value) {
+  const stringValue = String(value);
+  if (stringValue.includes(',') || stringValue.includes('"')) {
+    return `"${stringValue.replace(/"/g, '""')}"`;
+  }
+  return stringValue;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<object>} invoices - Invoices to export
+ * @returns {string} CSV data
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data rows
+  invoices.forEach((inv) => {
+    const customer = getCustomer(inv.customerId);
+    const customerName = customer.ok ? customer.value.name : '';
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const fields = [
+      escapeCsvField(inv.number),
+      escapeCsvField(customerName),
+      inv.issueDate,
+      inv.dueDate,
+      inv.status,
+      formatAmount(totals.subtotal),
+      formatAmount(totals.discount),
+      formatAmount(totals.vat),
+      formatAmount(totals.total),
+      formatAmount(due),
+    ];
+
+    lines.push(fields.join(','));
+  });
+
+  return lines.join('\n') + '\n';
+}
