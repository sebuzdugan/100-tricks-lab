+test('mergeCustomers preserves intoId customer', () => {
+  const customers = listCustomers();
+  const intoCustomer = customers.find((c) => c.id === 'C-002');
+  const result = mergeCustomers(customers, [], 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  const mergedCustomer = result.value.customers.find((c) => c.id === 'C-002');
+  assert.deepEqual(mergedCustomer, intoCustomer);
+});
+
+test('mergeCustomers updates invoices from fromId to intoId', () => {
+  const customers = listCustomers();
+
+  // Create invoices for both customers
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+
+  const invoices = [
+    issueInvoice(r1.value, []).value,
+    issueInvoice(r2.value, ['INV-2024-0001']).value,
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  // First invoice should now belong to C-002
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  // Second invoice should still belong to C-002
+  assert.equal(result.value.invoices[1].customerId, 'C-002');
+});
