+## Request 21: Duplicate Customer Merge (Completed)
+- Added `mergeCustomers(customers, invoices, fromId, intoId)` to src/customers.js:
+  - Merges duplicate customer records
+  - Removes fromId customer from customers array
+  - Updates all invoices with customerId = fromId to customerId = intoId
+  - Returns ok({ customers, invoices }) with merged data
+  - Normalizes customer IDs before comparison
+  - Validates:
+    - Both customers exist (error: CUSTOMER_NOT_FOUND)
+    - Customers are different (error: SAME_CUSTOMER)
+  - Never mutates input arguments
+- Added error code:
+  - SAME_CUSTOMER: "Cannot merge a customer with itself."
+- Added 13 new customer merge tests covering:
+  - Unknown fromId and intoId rejection
+  - Same customer rejection
+  - Customer removal from array
+  - Customer preservation
+  - Invoice customerId update
+  - Empty invoice list
+  - Input immutability (no mutation of customers or invoices)
+  - ID normalization with mixed case and whitespace
+  - All other customers preserved
+  - Multiple invoices for merged customer
+- All 263 tests pass (250 existing + 13 new customer merge tests)
+
 ## Constraints Followed
 - Money stored as integer cents
 - Never throw; use fail() for errors
diff --git a/src/customers.js b/src/customers.js
index 28f7df1..7a12a7d 100644
--- a/src/customers.js
+++ b/src/customers.js
@@ -44,3 +44,37 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge a duplicate customer into another.
+ * @param {Array<object>} customers - All customers
+ * @param {Array<object>} invoices - All invoices
+ * @param {string} fromId - Customer to remove
+ * @param {string} intoId - Customer to keep (will receive fromId's invoices)
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  // Check both customers exist
+  const fromCustomer = customers.find((c) => c.id === normalizedFromId);
+  if (!fromCustomer) return fail('CUSTOMER_NOT_FOUND');
+
+  const intoCustomer = customers.find((c) => c.id === normalizedIntoId);
+  if (!intoCustomer) return fail('CUSTOMER_NOT_FOUND');
+
+  // Check they are different
+  if (normalizedFromId === normalizedIntoId) return fail('SAME_CUSTOMER');
+
+  // Remove fromId customer and update invoices
+  const newCustomers = customers.filter((c) => c.id !== normalizedFromId);
+  const newInvoices = invoices.map((inv) =>
+    inv.customerId === normalizedFromId ? { ...inv, customerId: normalizedIntoId } : inv
+  );
+
+  return ok({
+    customers: newCustomers,
+    invoices: newInvoices,
+  });
+}
