+test('mergeCustomers with multiple invoices for merged customer', () => {
+  const customers = listCustomers();
+
+  // Create multiple invoices for C-001
+  const invoices = [];
+  for (let i = 0; i < 3; i++) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: `2024-01-${15 + i}`,
