+
+test('mergeCustomers rejects unknown fromId', () => {
+  const customers = listCustomers();
+  const result = mergeCustomers(customers, [], 'C-999', 'C-001');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('mergeCustomers rejects unknown intoId', () => {
+  const customers = listCustomers();
+  const result = mergeCustomers(customers, [], 'C-001', 'C-999');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('mergeCustomers rejects same customer', () => {
+  const customers = listCustomers();
+  const result = mergeCustomers(customers, [], 'C-001', 'C-001');
+  assert.deepEqual(result, { ok: false, error: 'SAME_CUSTOMER' });
+});
+
+test('mergeCustomers removes fromId customer', () => {
+  const customers = listCustomers();
+  const originalCount = customers.length;
+  const result = mergeCustomers(customers, [], 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, originalCount - 1);
+  assert(!result.value.customers.find((c) => c.id === 'C-001'));
+  assert(result.value.customers.find((c) => c.id === 'C-002'));
