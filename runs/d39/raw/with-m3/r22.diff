+++ b/test/totals.test.js
@@ -0,0 +1,183 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 10, unitPrice: 9500 }), 95000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 50 }), 50);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 2000 }), 200000);
+});
+
+test('lineDiscount calculates percent of lineTotal', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 9500, discountPercent: 10 }), 9500);
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 9500, discountPercent: 0 }), 0);
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 9500 }), 0); // no discountPercent
+});
+
+test('lineDiscount rounds correctly', () => {
+  // 10 * 1000 * 0.333 / 100 = 33.3, should round to 33
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 1000, discountPercent: 0.333 }), 33);
+});
+
+test('lineDiscount clamps to 0', () => {
+  assert.equal(lineDiscount({ qty: 10, unitPrice: 9500, discountPercent: -10 }), 0);
+});
+
+test('lineVAT calculates on amount after discount', () => {
+  // lineTotal: 95000, discount: 9500, base: 85500, VAT at 21% = 17955
+  assert.equal(
+    lineVAT({ qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 }),
+    17955
+  );
+});
+
+test('lineVAT without discount', () => {
+  // lineTotal: 95000, no discount, VAT at 21% = 19950
+  assert.equal(
+    lineVAT({ qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 }),
+    19950
+  );
+});
+
+test('lineVAT with 0% VAT', () => {
+  assert.equal(
+    lineVAT({ qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 0 }),
+    0
+  );
+});
+
+test('lineVAT with 9% VAT rate', () => {
+  // lineTotal: 20000, no discount, VAT at 9% = 1800
+  assert.equal(
+    lineVAT({ qty: 10, unitPrice: 2000, discountPercent: 0, vatRate: 9 }),
+    1800
+  );
+});
+
+test('lineVAT clamps to 0', () => {
+  // VAT should never be negative
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: -10 };
+  const vat = lineVAT(line);
+  assert(vat >= 0);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 95000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 19950);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 114950);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 }],
+  };
+
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 95000);
+  assert.equal(result.discount, 9500);
+  assert.equal(result.vat, 17955);
+  assert.equal(result.total, 103455);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 }],
+    voucher: { amount: 10000 },
+  };
+
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 95000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 19950);
+  assert.equal(result.voucher, 10000);
+  assert.equal(result.total, 104950);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 },
+      { qty: 5, unitPrice: 2000, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+  // Line 1: 95000, VAT 19950
+  // Line 2: 10000, VAT 900
+  // Total: 105000 + 20850 = 125850
+  assert.equal(result.subtotal, 105000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 20850);
+  assert.equal(result.total, 125850);
+});
+
+test('invoiceTotals with multiple lines and discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+      { qty: 5, unitPrice: 2000, discountPercent: 5, vatRate: 9 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+  // Line 1: subtotal 95000, discount 9500, VAT on 85500 = 17955
+  // Line 2: subtotal 10000, discount 500, VAT on 9500 = 855
+  // Total: 105000 - 10000 + 18810 = 113810
+  assert.equal(result.subtotal, 105000);
+  assert.equal(result.discount, 10000);
+  assert.equal(result.vat, 18810);
+  assert.equal(result.total, 113810);
+});
+
+test('invoiceTotals total is clamped to 0', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    voucher: { amount: 10000 }, // voucher larger than invoice total
+  };
+
+  const result = invoiceTotals(invoice);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals without voucher field', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 114950);
+});
+
+test('invoiceTotals with empty lines', () => {
+  const invoice = {
+    lines: [],
+  };
+
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 0);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals returns new object', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const result1 = invoiceTotals(invoice);
+  const result2 = invoiceTotals(invoice);
+
+  // Different objects but same values
+  assert.notStrictEqual(result1, result2);
+  assert.deepEqual(result1, result2);
+});
