@@ -19,14 +19,31 @@ export function lineDiscount(line) {
   return Math.max(0, discount);
 }
 
+/**
+ * Calculate bulk discount for a single line (2.5% off for 10+ units).
+ * Applied after the line's own discount to what remains.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function bulkDiscount(line) {
+  if (line.qty < 10) return 0;
+
+  const firstDiscount = lineDiscount(line);
+  const amountAfterFirstDiscount = lineTotal(line) - firstDiscount;
+  const bulk = roundCents(amountAfterFirstDiscount * 0.025);
+  return Math.max(0, bulk);
+}
+
 /**
  * Calculate the VAT for a single line.
- * VAT is calculated on the line amount after discount.
+ * VAT is calculated on the line amount after both discounts.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
  * @returns {number}
  */
 export function lineVAT(line) {
-  const baseAmount = lineTotal(line) - lineDiscount(line);
+  const firstDiscount = lineDiscount(line);
+  const bulk = bulkDiscount(line);
+  const baseAmount = lineTotal(line) - firstDiscount - bulk;
   const vat = roundCents(baseAmount * line.vatRate / 100);
   return Math.max(0, vat);
 }
@@ -38,7 +55,10 @@ export function lineVAT(line) {
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
-  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const discount = invoice.lines.reduce(
+    (sum, line) => sum + lineDiscount(line) + bulkDiscount(line),
+    0
+  );
   const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
   const voucher = invoice.voucher?.amount ?? 0;
   const total = Math.max(0, subtotal - discount + vat - voucher);
