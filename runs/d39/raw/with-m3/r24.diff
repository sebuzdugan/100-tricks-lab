+test('dashboard with empty invoices', () => {
+  const result = dashboard([], '2024-02-01');
+
+  assert.deepEqual(result.counts, { draft: 0, issued: 0, partially_paid: 0, paid: 0 });
+  assert.equal(result.outstanding, 0);
+  assert.deepEqual(result.overdue, { count: 0, amount: 0 });
+  assert.deepEqual(result.topCustomers, []);
+});
+
+test('dashboard counts invoices by status', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+
+  const issued = issueInvoice(r1.value, []);
+  assert.equal(issued.ok, true);
+
+  const partial = recordPayment(issued.value, { amount: 50000, date: '2024-01-20' });
+  assert.equal(partial.ok, true);
+
+  const invoices = [r2.value, issued.value, partial.value];
+
+  const result = dashboard(invoices, '2024-02-01');
+
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.partially_paid, 1);
+  assert.equal(result.counts.paid, 0);
+});
+
