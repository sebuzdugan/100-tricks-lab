+test('dashboard returns top 3 customers by due amount', () => {
+  const invoices = [];
+
+  // Create invoices for multiple customers
+  for (let i = 1; i <= 5; i++) {
+    const r = createInvoice({
+      customerId: `C-00${i}`,
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DEV-HOUR', qty: i, discountPercent: 0 }],
+    });
+
+    assert.equal(r.ok, true);
+    const issued = issueInvoice(r.value, invoices.map((inv) => inv.number));
+    assert.equal(issued.ok, true);
+    invoices.push(issued.value);
+  }
+
+  const result = dashboard(invoices, '2024-02-01');
