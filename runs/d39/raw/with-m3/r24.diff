+  assert.equal(result.topCustomers.length, 3);
+  // Should be sorted highest to lowest
+  for (let i = 1; i < result.topCustomers.length; i++) {
+    assert(result.topCustomers[i - 1].due >= result.topCustomers[i].due);
+  }
+});
