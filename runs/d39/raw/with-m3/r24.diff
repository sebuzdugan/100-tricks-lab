   const fee = roundCents(amountDue * 0.0004 * daysOverdue);
   return Math.max(0, fee);
 }
+
+/**
+ * Get dashboard metrics for invoices.
+ * @param {Array<object>} invoices - All invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format (report date)
+ * @returns {object} Dashboard with counts, outstanding, overdue, and topCustomers
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  invoices.forEach((inv) => {
+    counts[inv.status]++;
+  });
+
+  // Calculate outstanding (issued and partially_paid)
+  const outstanding = invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  // Get overdue invoices
+  const overdue_invoices = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_invoices.length,
+    amount: overdue_invoices.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Calculate customer totals due
+  const customerDue = {};
+  invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .forEach((inv) => {
+      const due = balanceDue(inv);
+      if (!customerDue[inv.customerId]) {
+        customerDue[inv.customerId] = 0;
+      }
+      customerDue[inv.customerId] += due;
+    });
+
+  // Get top 3 customers
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
