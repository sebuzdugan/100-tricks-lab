diff --git a/src/render.js b/src/render.js
index 2b46f13..d91832c 100644
--- a/src/render.js
+++ b/src/render.js
@@ -4,7 +4,7 @@ import { formatEuros } from './money.js';
 
 /**
  * Render an invoice as plain text for display to customers.
- * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @param {{ customerId: string, number?: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number }, dueDate?: string, payments?: Array<{ amount: number, date: string }> }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -32,7 +32,21 @@ export function renderInvoiceText(invoice) {
       lines.push(`VAT: ${formatEuros(totals.vat)}`);
     }
   }
+
+  if (invoice.voucher) {
+    lines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const paid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return lines.join('\n');
 }
