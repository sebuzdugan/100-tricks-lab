+test('renderInvoiceText shows voucher before total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  assert.equal(r.ok, true);
+
+  const voucherResult = applyVoucher(r.value, { code: 'SUMMER2024', amount: 10000 });
+  assert.equal(voucherResult.ok, true);
+
+  const text = renderInvoiceText(voucherResult.value);
+  const lines = text.split('\n');
+
+  // Should show voucher line before Total
+  const voucherLineIdx = lines.findIndex((line) => line.includes('Voucher:'));
+  const totalLineIdx = lines.findIndex((line) => line.startsWith('Total:'));
+  assert(voucherLineIdx > -1, 'Voucher line not found');
+  assert(voucherLineIdx < totalLineIdx, 'Voucher line should be before Total');
+  assert(lines[voucherLineIdx].includes('-€100.00'));
+});
