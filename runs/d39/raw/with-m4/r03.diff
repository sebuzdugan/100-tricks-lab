+/**
+ * Add a line to an invoice. If the SKU already exists, increase its qty.
+ * @param {Object} invoice
+ * @param {{ sku: string, qty: number }} input
+ * @returns {{ ok: true, value: Object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Validate and get product
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Create new lines array
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+
+  // Find existing line with this SKU
+  const existingLine = newLines.find((line) => line.sku === sku);
+
+  if (existingLine) {
+    // Increase qty on existing line
+    existingLine.qty += qty;
+  } else {
+    // Add new line
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  // Create new invoice with updated lines
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {Object} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: Object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check line exists
+  const lineExists = invoice.lines.some((line) => line.sku === sku);
+  if (!lineExists) return fail('LINE_NOT_FOUND');
+
+  // Check we won't remove the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new lines array without this SKU
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  // Create new invoice with updated lines
+  const newInvoice = {
+    ...invoice,
+    lines: newLines,
+  };
+
+  return ok(newInvoice);
+}
