diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..6511b0c
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number for a year when no numbers exist', () => {
+  const result = nextInvoiceNumber([], '2024-10-15');
+  assert.equal(result, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments counter within a year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002'];
+  const result = nextInvoiceNumber(existing, '2024-10-15');
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber restarts counter for a new year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003'];
+  const result = nextInvoiceNumber(existing, '2025-01-01');
+  assert.equal(result, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2023-0001', 'INV-2023-0999', 'INV-2024-0001', 'INV-2024-0002'];
+  const result = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(result, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber handles out-of-order existing numbers', () => {
+  const existing = ['INV-2024-0003', 'INV-2024-0001', 'INV-2024-0002'];
+  const result = nextInvoiceNumber(existing, '2024-10-15');
+  assert.equal(result, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber handles gaps in numbering', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0003'];
+  const result = nextInvoiceNumber(existing, '2024-10-15');
+  assert.equal(result, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 99 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const result = nextInvoiceNumber(existing, '2024-10-15');
+  assert.equal(result, 'INV-2024-0100');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2024-9999'];
+  const result = nextInvoiceNumber(existing, '2024-10-15');
+  assert.equal(result, 'INV-2024-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2024-NOPE', 'INV-2024-0001', 'invalid-format'];
+  const result = nextInvoiceNumber(existing, '2024-10-15');
+  assert.equal(result, 'INV-2024-0002');
+});
