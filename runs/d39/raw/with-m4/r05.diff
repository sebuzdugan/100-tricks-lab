+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+
+  const customer = { id: 'C-001', name: 'Acme Corp', email: 'hello@acme.example' };
+
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Acme Corp'));
+  assert.ok(text.includes('5 × Design work (hour)'));
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€425.00'));
+  assert.ok(text.includes('Total: €425.00'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = {
+    number: 'INV-2024-0001',
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+
+  const customer = { id: 'C-001', name: 'Acme Corp', email: 'hello@acme.example' };
+
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('INV-2024-0001'));
+  assert.ok(!text.includes('DRAFT'));
+  assert.ok(text.includes('Acme Corp'));
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const invoice = {
+    number: 'INV-2024-0001',
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 10, unitPrice: 9500, vatRate: 21 },
+      { sku: 'COPY-HOUR', name: 'Copywriting (hour)', qty: 3, unitPrice: 6000, vatRate: 21 },
+    ],
+  };
+
+  const customer = { id: 'C-001', name: 'Acme Corp', email: 'hello@acme.example' };
+
+  const text = renderInvoiceText(invoice, customer);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2024-0001');
+  assert.equal(lines[1], 'Acme Corp');
+  assert.ok(lines[2].includes('5 × Design work (hour)'));
+  assert.ok(lines[3].includes('10 × Development (hour)'));
+  assert.ok(lines[4].includes('3 × Copywriting (hour)'));
+  assert.ok(lines[5].startsWith('Total:'));
+  assert.equal(lines.length, 6);
+});
+
+test('renderInvoiceText formats amounts in euros', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 },
+      { sku: 'STICKER', name: 'Sticker sheet', qty: 100, unitPrice: 50, vatRate: 21 },
+    ],
+  };
+
+  const customer = { id: 'C-001', name: 'Acme Corp', email: 'hello@acme.example' };
+
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€0.50'));
+  assert.ok(text.includes('€50.00'));
+  assert.ok(text.includes('€135.00')); // 85 + 50
+});
+
+test('renderInvoiceText handles large amounts with thousands separators', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'draft',
+    lines: [
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 5, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+
+  const customer = { id: 'C-001', name: 'Acme Corp', email: 'hello@acme.example' };
+
+  const text = renderInvoiceText(invoice, customer);
+  assert.ok(text.includes('€1,200.00'));
+  assert.ok(text.includes('€6,000.00'));
+  assert.ok(text.includes('Total: €6,000.00'));
+});
+
+test('renderInvoiceText includes all lines in correct order', () => {
+  const invoice = {
+    number: 'INV-2025-0042',
+    customerId: 'C-003',
+    issueDate: '2025-01-15',
+    status: 'issued',
+    lines: [
+      { sku: 'WORKSHOP-DAY', name: 'Brand workshop (day, VAT exempt)', qty: 2, unitPrice: 60000, vatRate: 0 },
+    ],
+  };
+
+  const customer = { id: 'C-003', name: 'Kite & Co', email: 'finance@kite.example' };
+
+  const text = renderInvoiceText(invoice, customer);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2025-0042', 'First line should be invoice number');
+  assert.equal(lines[1], 'Kite & Co', 'Second line should be customer name');
+  assert.ok(lines[2].includes('2 × Brand workshop'), 'Third line should be first invoice line');
+  assert.ok(lines[3].startsWith('Total:'), 'Last line should be total');
+});
+
+test('renderInvoiceText returns a string', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+
+  const customer = { id: 'C-001', name: 'Acme Corp', email: 'hello@acme.example' };
+
+  const text = renderInvoiceText(invoice, customer);
+  assert.equal(typeof text, 'string');
+  assert.ok(text.length > 0);
+});
+
+test('renderInvoiceText does not mutate invoice or customer', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+
+  const customer = { id: 'C-001', name: 'Acme Corp', email: 'hello@acme.example' };
+
+  const invoiceOriginal = JSON.stringify(invoice);
+  const customerOriginal = JSON.stringify(customer);
+
+  renderInvoiceText(invoice, customer);
+
+  assert.equal(JSON.stringify(invoice), invoiceOriginal);
+  assert.equal(JSON.stringify(customer), customerOriginal);
+});
+
+test('renderInvoiceText renders single line with correct formatting', () => {
+  const invoice = {
+    number: 'INV-2024-0123',
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+    ],
+  };
+
+  const customer = { id: 'C-001', name: 'Acme Corp', email: 'hello@acme.example' };
+
+  const text = renderInvoiceText(invoice, customer);
+  const expected = [
+    'INV-2024-0123',
+    'Acme Corp',
+    '5 × Design work (hour) €85.00 €425.00',
+    'Total: €425.00',
+  ].join('\n');
+
+  assert.equal(text, expected);
+});
