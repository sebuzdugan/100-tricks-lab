+import { formatEuros } from './money.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * All amounts are formatted using formatEuros().
+ * @param {Object} invoice
+ * @param {Object} customer - Customer object with at least a 'name' property
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice, customer) {
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  lines.push(invoice.number || 'DRAFT');
+
+  // Customer name
+  lines.push(customer.name);
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const unitPriceFormatted = formatEuros(line.unitPrice);
+    const totalFormatted = formatEuros(total);
+    lines.push(`${line.qty} × ${line.name} ${unitPriceFormatted} ${totalFormatted}`);
+  }
+
+  // Total line
+  const totals = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const totalFormatted = formatEuros(totals);
+  lines.push(`Total: ${totalFormatted}`);
+
+  return lines.join('\n');
+}
