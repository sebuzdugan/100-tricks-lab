+  assert.equal(result.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount when no discountPercent provided', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // Kite & Co is silver
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, TIER_DISCOUNTS.silver);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount when no discountPercent provided', () => {
+  const result = createInvoice({
+    customerId: 'C-002', // Blue Fern Bakery is standard
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, undefined);
+});
+
+test('createInvoice explicit discountPercent overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // Northwind Studio is gold (5% tier)
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice explicit discountPercent of 0 overrides tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // Northwind Studio is gold (5% tier)
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice applies tier discount to multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003', // Kite & Co is silver
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 2.5);
+  assert.equal(result.value.lines[1].discountPercent, 2.5);
+});
+
+test('createInvoice mixes tier discount with explicit discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // Northwind Studio is gold (5% tier)
+    issueDate: '2024-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 }, // gets 5% tier
+      { sku: 'DEV-HOUR', qty: 10, discountPercent: 15 }, // explicit 15%
+      { sku: 'COPY-HOUR', qty: 3, discountPercent: 0 }, // explicit 0% (no discount)
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 5);
+  assert.equal(result.value.lines[1].discountPercent, 15);
+  assert.equal(result.value.lines[2].discountPercent, 0);
+});
+
+test('invoiceTotals accounts for tier discounts in calculation', () => {
+  const result = createInvoice({
+    customerId: 'C-001', // gold tier (5% discount)
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // 100 * 8500 = 850000 cents
+  });
+
+  assert.equal(result.ok, true);
+  const totals = invoiceTotals(result.value);
+  assert.equal(totals.subtotal, 850000);
+  assert.equal(totals.discount, 42500); // 850000 * 5 / 100
+  assert.equal(totals.total, 807500); // 850000 - 42500
+});
