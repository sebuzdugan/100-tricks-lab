+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId(' C-001 '), 'C-001');
+  assert.equal(normalizeId('C-001\t'), 'C-001');
+  assert.equal(normalizeId('\nC-001\n'), 'C-001');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('C-001'), 'C-001');
+  assert.equal(normalizeId('c-001'), 'C-001');
+});
+
+test('normalizeId handles mixed case and spaces', () => {
+  assert.equal(normalizeId(' c-007 '), 'C-007');
+  assert.equal(normalizeId('  C-003  '), 'C-003');
+  assert.equal(normalizeId('c-010'), 'C-010');
+});
+
+test('getCustomer finds customer with normalized ID', () => {
+  const result = getCustomer('c-001');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Northwind Studio');
+});
+
+test('getCustomer finds customer with spaces', () => {
+  const result = getCustomer(' C-003 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Kite & Co');
+});
+
+test('getCustomer finds customer with lowercase and spaces', () => {
+  const result = getCustomer('  c-002  ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.name, 'Blue Fern Bakery');
+});
