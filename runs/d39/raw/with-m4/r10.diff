@@ -0,0 +1,125 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2024-01-01'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('2000-01-01'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2024/01/01'), false);
+  assert.equal(isValidDate('01-01-2024'), false);
+  assert.equal(isValidDate('2024-1-1'), false);
+  assert.equal(isValidDate('2024-01'), false);
+  assert.equal(isValidDate('2024'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2024-02-30'), false);
+  assert.equal(isValidDate('2024-13-01'), false);
+  assert.equal(isValidDate('2024-00-01'), false);
+  assert.equal(isValidDate('2023-02-29'), false); // not a leap year
+});
+
+test('isValidDate handles leap years correctly', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('2023-02-29'), false); // not a leap year
+  assert.equal(isValidDate('2000-02-29'), true); // leap year (divisible by 400)
+  assert.equal(isValidDate('1900-02-29'), false); // not a leap year (divisible by 100 but not 400)
+});
+
+test('isValidDate rejects whitespace', () => {
+  assert.equal(isValidDate(' 2024-01-01'), false);
+  assert.equal(isValidDate('2024-01-01 '), false);
+  assert.equal(isValidDate(' 2024-01-01 '), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2024-01-01', 1), '2024-01-02');
+  assert.equal(addDays('2024-01-01', 10), '2024-01-11');
+  assert.equal(addDays('2024-01-01', 31), '2024-02-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2024-01-10', -1), '2024-01-09');
+  assert.equal(addDays('2024-01-10', -10), '2023-12-31');
+  assert.equal(addDays('2024-02-01', -1), '2024-01-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2024-01-01', 0), '2024-01-01');
+});
+
+test('addDays handles month and year boundaries', () => {
+  assert.equal(addDays('2024-01-31', 1), '2024-02-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01'); // leap year
+});
+
+test('addDays handles large day counts', () => {
+  assert.equal(addDays('2024-01-01', 365), '2024-12-31'); // 2024 is a leap year (366 days), so 365 days gets to Dec 31
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01'); // 366 days reaches next year
+});
+
+test('daysBetween calculates days forward', () => {
+  assert.equal(daysBetween('2024-01-01', '2024-01-02'), 1);
+  assert.equal(daysBetween('2024-01-01', '2024-01-11'), 10);
+  assert.equal(daysBetween('2024-01-01', '2024-02-01'), 31);
+});
+
+test('daysBetween calculates days backward', () => {
+  assert.equal(daysBetween('2024-01-10', '2024-01-01'), -9);
+  assert.equal(daysBetween('2024-02-01', '2024-01-01'), -31);
+});
+
+test('daysBetween returns zero for same date', () => {
+  assert.equal(daysBetween('2024-01-01', '2024-01-01'), 0);
+});
+
+test('daysBetween handles month and year boundaries', () => {
+  assert.equal(daysBetween('2024-01-31', '2024-02-01'), 1);
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1); // leap year
+});
+
+test('daysBetween handles large date ranges', () => {
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is a leap year
+  assert.equal(daysBetween('2023-01-01', '2025-01-01'), 731); // 365 (2023) + 366 (2024)
+});
+
+test('daysBetween is consistent with addDays', () => {
+  const start = '2024-01-01';
+  const end = addDays(start, 42);
+  assert.equal(daysBetween(start, end), 42);
+});
+
+test('dates use UTC, not local timezone', () => {
+  // These tests verify UTC behavior by checking against known dates
+  // The key is that T00:00:00Z in the Date constructor always uses UTC
+  const result1 = addDays('2024-01-01', 1);
+  assert.equal(result1, '2024-01-02');
+
+  const result2 = daysBetween('2024-01-01', '2024-01-02');
+  assert.equal(result2, 1);
+});
+
+test('isValidDate and addDays are compatible', () => {
+  const date = '2024-06-15';
+  assert.equal(isValidDate(date), true);
+
+  const nextDay = addDays(date, 1);
+  assert.equal(isValidDate(nextDay), true);
+  assert.equal(nextDay, '2024-06-16');
+});
+
+test('daysBetween with isValidDate', () => {
+  const dateA = '2024-06-15';
+  const dateB = '2024-06-20';
+  assert.equal(isValidDate(dateA), true);
+  assert.equal(isValidDate(dateB), true);
+  assert.equal(daysBetween(dateA, dateB), 5);
+});
