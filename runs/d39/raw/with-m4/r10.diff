+/**
+ * Check if a string is a valid date in YYYY-MM-DD format and represents a real date.
+ * All date validation is done in UTC.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  const parts = text.split('-');
+  return date instanceof Date && !isNaN(date.getTime()) &&
+         date.getUTCFullYear() === Number(parts[0]) &&
+         date.getUTCMonth() === Number(parts[1]) - 1 &&
+         date.getUTCDate() === Number(parts[2]);
+}
+
+/**
+ * Add days to a date string.
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @param {number} days - Number of days to add (can be negative)
+ * @returns {string} - New date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, days) {
+  const date = new Date(dateStr + 'T00:00:00Z');
+  date.setUTCDate(date.getUTCDate() + days);
+  return date.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of days between two dates (b - a) in whole days.
+ * Uses UTC, not local time zone.
+ * @param {string} a - Start date in YYYY-MM-DD format
+ * @param {string} b - End date in YYYY-MM-DD format
+ * @returns {number} - Number of days (b - a), can be negative
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.round(diffMs / (1000 * 60 * 60 * 24));
+}
