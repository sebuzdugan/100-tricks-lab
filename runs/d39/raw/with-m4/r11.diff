+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('balanceDue returns total for unpaid invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // 100 * 8500 = 850000, VAT 21% = 178500, total = 1028500
+  });
+
+  assert.equal(result.ok, true);
+  const invoice = result.value;
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+
+  const due = balanceDue(issued.value);
+  // Total = 850000 + 178500 = 1028500
+  assert.equal(due, 1028500);
+});
+
+test('balanceDue returns zero for paid invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }], // 60000, 0% VAT, total = 60000
+  });
+
+  assert.equal(result.ok, true);
+  let invoice = result.value;
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+  invoice = issued.value;
+
+  const paid = recordPayment(invoice, { amount: 60000, date: '2024-10-20' });
+  assert.equal(paid.ok, true);
+  const due = balanceDue(paid.value);
+  assert.equal(due, 0);
+});
+
+test('balanceDue with partial payment', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // total = 1028500
+  });
+
+  assert.equal(result.ok, true);
+  let invoice = result.value;
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+  invoice = issued.value;
+
+  const paid = recordPayment(invoice, { amount: 500000, date: '2024-10-20' });
+  assert.equal(paid.ok, true);
+  const due = balanceDue(paid.value);
+  assert.equal(due, 528500); // 1028500 - 500000
+});
+
+test('recordPayment creates payments array', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }], // 50 * 100 = 5000, VAT 21% = 1050, total = 6050
+  });
+
+  assert.equal(result.ok, true);
+  let invoice = result.value;
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+  invoice = issued.value;
+  assert.equal(invoice.payments, undefined);
+
+  const paid = recordPayment(invoice, { amount: 6050, date: '2024-10-20' });
+  assert.equal(paid.ok, true);
+  assert.ok(Array.isArray(paid.value.payments));
+  assert.equal(paid.value.payments.length, 1);
+  assert.equal(paid.value.payments[0].amount, 6050);
+  assert.equal(paid.value.payments[0].date, '2024-10-20');
+});
+
+test('recordPayment appends to existing payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'partially_paid',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+    payments: [{ amount: 50000, date: '2024-10-16' }],
+  };
+
+  const paid = recordPayment(invoice, { amount: 50000, date: '2024-10-20' });
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.payments.length, 2);
+  assert.equal(paid.value.payments[0].amount, 50000);
+  assert.equal(paid.value.payments[1].amount, 50000);
+});
+
+test('recordPayment sets status to paid', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }], // total = 6050
+  });
+
+  assert.equal(result.ok, true);
+  let invoice = result.value;
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+  invoice = issued.value;
+  assert.equal(invoice.status, 'issued');
+
+  const paid = recordPayment(invoice, { amount: 6050, date: '2024-10-20' });
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.status, 'paid');
+});
+
+test('recordPayment sets status to partially_paid', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // total = 1028500
+  });
+
+  assert.equal(result.ok, true);
+  let invoice = result.value;
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+  invoice = issued.value;
+
+  const paid = recordPayment(invoice, { amount: 500000, date: '2024-10-20' });
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.status, 'partially_paid');
+});
+
+test('recordPayment returns NOT_ISSUED for draft invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'draft',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2024-10-20' });
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment returns NOT_ISSUED for paid invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'paid',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+    payments: [{ amount: 100000, date: '2024-10-20' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 10000, date: '2024-10-21' });
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment returns AMOUNT_INVALID for non-integer amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000.5, date: '2024-10-20' });
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment returns AMOUNT_INVALID for zero amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 0, date: '2024-10-20' });
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment returns AMOUNT_INVALID for negative amount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: -50000, date: '2024-10-20' });
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment returns DATE_INVALID for bad date format', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000, date: '10/20/2024' });
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('recordPayment returns OVERPAYMENT if payment exceeds balance', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 150000, date: '2024-10-20' });
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment allows payment exactly equal to balance', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+
+  const result = recordPayment(invoice, { amount: 100000, date: '2024-10-20' });
+  assert.equal(result.ok, true);
+});
+
+test('recordPayment accepts partially_paid status', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'partially_paid',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+    payments: [{ amount: 50000, date: '2024-10-16' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2024-10-20' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+
+  const original = JSON.stringify(invoice);
+  recordPayment(invoice, { amount: 50000, date: '2024-10-20' });
+  assert.equal(JSON.stringify(invoice), original);
+});
+
+test('multiple payments reduce balance correctly', () => {
+  let invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    status: 'issued',
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+  };
+
+  let result = recordPayment(invoice, { amount: 30000, date: '2024-10-16' });
+  assert.equal(result.ok, true);
+  invoice = result.value;
+  assert.equal(balanceDue(invoice), 70000);
+
+  result = recordPayment(invoice, { amount: 40000, date: '2024-10-17' });
+  assert.equal(result.ok, true);
+  invoice = result.value;
+  assert.equal(balanceDue(invoice), 30000);
+
+  result = recordPayment(invoice, { amount: 30000, date: '2024-10-18' });
+  assert.equal(result.ok, true);
+  invoice = result.value;
+  assert.equal(balanceDue(invoice), 0);
+  assert.equal(invoice.status, 'paid');
+});
