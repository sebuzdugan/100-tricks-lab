+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = statement('C-999', [], '2024-10-31');
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement returns DATE_INVALID for invalid date', () => {
+  const result = statement('C-001', [], '10/31/2024');
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('statement returns empty invoice list for customer with no invoices', () => {
+  const result = statement('C-001', [], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement filters by customer', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv1 = issueInvoice(inv1.value, []).value;
+
+  let inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-16',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv2 = issueInvoice(inv2.value, []).value;
+
+  const result = statement('C-001', [inv1, inv2], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-10-15');
+});
+
+test('statement filters by status', () => {
+  let draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  draft = draft.value;
+
+  let issued = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-16',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  issued = issueInvoice(issued.value, []).value;
+
+  const result = statement('C-001', [draft, issued], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-10-16');
+});
+
+test('statement filters by asOf date', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv1 = issueInvoice(inv1.value, []).value;
+
+  let inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-20',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv2 = issueInvoice(inv2.value, []).value;
+
+  const result = statement('C-001', [inv1, inv2], '2024-10-17');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-10-15');
+});
+
+test('statement includes partially_paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // total = 1028500
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 500000, date: '2024-10-20' });
+  inv = paid.value;
+
+  const result = statement('C-001', [inv], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].status, undefined); // statement doesn't include status
+});
+
+test('statement does not include paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }], // total = 6050
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 6050, date: '2024-10-20' });
+  inv = paid.value;
+
+  const result = statement('C-002', [inv], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement includes invoice fields correctly', () => {
+  let inv = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }], // total = 6050
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = statement('C-002', [inv], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+
+  const lineItem = result.value.invoices[0];
+  assert.ok(lineItem.number);
+  assert.equal(lineItem.issueDate, '2024-10-15');
+  assert.equal(lineItem.dueDate, '2024-10-29');
+  assert.equal(lineItem.total, 6050);
+  assert.equal(lineItem.due, 6050);
+});
+
+test('statement calculates due correctly for unpaid invoice', () => {
+  let inv = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // total = 1028500
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = statement('C-002', [inv], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].due, 1028500);
+  assert.equal(result.value.totalDue, 1028500);
+});
+
+test('statement calculates due correctly for partially paid invoice', () => {
+  let inv = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }], // total = 1028500 (no discount)
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 500000, date: '2024-10-20' });
+  inv = paid.value;
+
+  const result = statement('C-002', [inv], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].due, 528500); // 1028500 - 500000
+  assert.equal(result.value.totalDue, 528500);
+});
+
+test('statement sorts by issueDate', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-20',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv1 = issueInvoice(inv1.value, []).value;
+
+  let inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv2 = issueInvoice(inv2.value, []).value;
+
+  let inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-25',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv3 = issueInvoice(inv3.value, []).value;
+
+  const result = statement('C-001', [inv1, inv2, inv3], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].issueDate, '2024-10-15');
+  assert.equal(result.value.invoices[1].issueDate, '2024-10-20');
+  assert.equal(result.value.invoices[2].issueDate, '2024-10-25');
+});
+
+test('statement sums all due amounts', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }], // total = 6050
+  });
+  inv1 = issueInvoice(inv1.value, []).value;
+
+  let inv2 = createInvoice({
+    customerId: 'C-002', // standard tier, 0% discount
+    issueDate: '2024-10-16',
+    lines: [{ sku: 'STICKER', qty: 100 }], // total = 6050
+  });
+  inv2 = issueInvoice(inv2.value, []).value;
+
+  const paid = recordPayment(inv2, { amount: 3000, date: '2024-10-20' });
+  inv2 = paid.value;
+
+  const result = statement('C-002', [inv1, inv2], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.totalDue, 6050 + 3050); // full first + partial second
+});
+
+test('statement normalizes customer ID', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = statement('c-001', [inv], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement normalizes customer ID with spaces', () => {
+  let inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = statement('  c-001  ', [inv], '2024-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
