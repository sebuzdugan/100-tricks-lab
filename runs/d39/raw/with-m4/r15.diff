+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Generate the next credit note number for a given date.
+ * Format: CN-<year>-<counter>, where counter is 4 digits zero-padded.
+ * Counter resets to 0001 for each year.
+ * @param {Array<string>} existingNumbers - Array of all numbers (both INV-* and CN-*)
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Find all credit note counters used in this year
+  const prefix = `CN-${year}-`;
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counterStr = num.substring(prefix.length);
+      return Number(counterStr);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  // Find the highest counter used so far
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+
+  // Next counter is max + 1, starting at 1 if none exist
+  const nextCounter = maxCounter + 1;
+
+  // Format with 4-digit zero-padding
+  const counterStr = String(nextCounter).padStart(4, '0');
+  return `${prefix}${counterStr}`;
+}
+
+/**
+ * Create a credit note for an invoice.
+ * @param {Object} invoice - The invoice to create a credit note for
+ * @param {{ amount: number, reason: string, date: string }} creditData - amount in cents, date in YYYY-MM-DD
+ * @param {Array<string>} existingNumbers - Array of existing invoice/credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is issued, partially_paid, or paid (not draft)
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate credit note amount doesn't exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  const creditNote = {
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
