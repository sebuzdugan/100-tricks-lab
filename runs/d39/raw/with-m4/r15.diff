+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 3000, reason: 'Damaged goods', date: '2024-10-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+  assert.equal(result.value.invoiceNumber, inv.number);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 3000);
+  assert.equal(result.value.reason, 'Damaged goods');
+  assert.equal(result.value.date, '2024-10-20');
+});
+
+test('createCreditNote returns NOT_ISSUED for draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  const result = createCreditNote(inv.value, { amount: 3000, reason: 'Damaged goods', date: '2024-10-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote accepts partially_paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 500000, date: '2024-10-20' });
+  inv = paid.value;
+
+  const result = createCreditNote(inv, { amount: 100000, reason: 'Discount', date: '2024-10-25' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote accepts paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 6050, date: '2024-10-20' });
+  inv = paid.value;
+
+  const result = createCreditNote(inv, { amount: 1000, reason: 'Overpayment refund', date: '2024-10-25' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote returns AMOUNT_INVALID for non-integer amount', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 3000.5, reason: 'Damaged goods', date: '2024-10-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns AMOUNT_INVALID for zero amount', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 0, reason: 'Damaged goods', date: '2024-10-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns AMOUNT_INVALID for negative amount', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: -1000, reason: 'Damaged goods', date: '2024-10-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote returns DATE_INVALID for invalid date', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 3000, reason: 'Damaged goods', date: '10/20/2024' }, []);
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote returns CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 10000, reason: 'Damaged goods', date: '2024-10-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit note equal to invoice total', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 6050, reason: 'Full refund', date: '2024-10-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 6050);
+});
+
+test('createCreditNote numbers restart each year', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv1 = issueInvoice(inv1.value, []).value;
+
+  let inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv2 = issueInvoice(inv2.value, []).value;
+
+  const cn1 = createCreditNote(inv1, { amount: 1000, reason: 'Refund', date: '2024-10-20' }, []);
+  assert.equal(cn1.value.number, 'CN-2024-0001');
+
+  const cn2 = createCreditNote(inv2, { amount: 1000, reason: 'Refund', date: '2025-01-20' }, ['CN-2024-0001']);
+  assert.equal(cn2.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote increments counter within same year', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv1 = issueInvoice(inv1.value, []).value;
+
+  let inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-20',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv2 = issueInvoice(inv2.value, []).value;
+
+  const cn1 = createCreditNote(inv1, { amount: 1000, reason: 'Refund', date: '2024-10-21' }, []);
+  assert.equal(cn1.value.number, 'CN-2024-0001');
+
+  const cn2 = createCreditNote(inv2, { amount: 1000, reason: 'Refund', date: '2024-10-22' }, ['CN-2024-0001']);
+  assert.equal(cn2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, ['INV-2024-0001']).value;
+
+  const result = createCreditNote(inv, { amount: 1000, reason: 'Refund', date: '2024-10-20' }, ['INV-2024-0001', 'CN-2024-0001', 'INV-2024-0002']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote ignores invoices from other years when numbering', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 1000, reason: 'Refund', date: '2024-10-20' }, ['CN-2023-0001', 'CN-2023-0002', 'CN-2023-0003']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote with large amount still validates against total', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const totals = invoiceTotals(inv);
+  const result = createCreditNote(inv, { amount: totals.total + 1, reason: 'Refund', date: '2024-10-20' }, []);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote preserves invoice number in credit note', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 1000, reason: 'Refund', date: '2024-10-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, inv.number);
+});
