+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array when no invoices are overdue', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET30',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = overdueInvoices([inv], '2024-11-10');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoice whose dueDate has passed', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = overdueInvoices([inv], '2024-10-30');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, inv.number);
+  assert.equal(result[0].dueDate, '2024-10-29');
+});
+
+test('overdueInvoices returns correct daysOverdue', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = overdueInvoices([inv], '2024-11-05');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 7); // from 10/29 to 11/05
+});
+
+test('overdueInvoices returns correct due amount', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = overdueInvoices([inv], '2024-11-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 1028500); // full amount, unpaid
+});
+
+test('overdueInvoices returns remaining due for partially paid invoice', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 500000, date: '2024-10-20' });
+  inv = paid.value;
+
+  const result = overdueInvoices([inv], '2024-10-30');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 528500); // 1028500 - 500000
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  const result = overdueInvoices([inv.value], '2024-11-20');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 6050, date: '2024-10-20' });
+  inv = paid.value;
+
+  const result = overdueInvoices([inv], '2024-11-20');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-01',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv1 = issueInvoice(inv1.value, []).value;
+
+  let inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv2 = issueInvoice(inv2.value, []).value;
+
+  let inv3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-10',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv3 = issueInvoice(inv3.value, []).value;
+
+  const result = overdueInvoices([inv1, inv2, inv3], '2024-11-01');
+  assert.equal(result.length, 3);
+  assert.ok(result[0].daysOverdue >= result[1].daysOverdue);
+  assert.ok(result[1].daysOverdue >= result[2].daysOverdue);
+  assert.equal(result[0].dueDate, '2024-10-15'); // most overdue
+  assert.equal(result[2].dueDate, '2024-10-29'); // least overdue
+});
+
+test('overdueInvoices returns empty array for invalid asOf date', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = overdueInvoices([inv], '10/20/2024');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoices with dueDate exactly at asOf boundary', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  // dueDate is 2024-10-29, asOf is 2024-10-29
+  const result = overdueInvoices([inv], '2024-10-29');
+  assert.equal(result.length, 0); // not overdue yet, same day
+});
+
+test('overdueInvoices includes invoice one day after due', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  // dueDate is 2024-10-29, asOf is 2024-10-30
+  const result = overdueInvoices([inv], '2024-10-30');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 1);
+});
+
+test('overdueInvoices returns correct fields', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = overdueInvoices([inv], '2024-11-05');
+  assert.equal(result.length, 1);
+
+  const item = result[0];
+  assert.ok(item.number);
+  assert.equal(item.customerId, 'C-002');
+  assert.equal(item.dueDate, '2024-10-29');
+  assert.ok(typeof item.daysOverdue === 'number');
+  assert.ok(typeof item.due === 'number');
+});
+
+test('overdueInvoices with mixed statuses', () => {
+  let draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-01',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  let issued = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-05',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  issued = issueInvoice(issued.value, []).value;
+
+  let paid = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-10',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  paid = issueInvoice(paid.value, []).value;
+  paid = recordPayment(paid, { amount: 6050, date: '2024-10-20' }).value;
+
+  const result = overdueInvoices([draft.value, issued, paid], '2024-11-01');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].dueDate, '2024-10-19');
+});
+
+test('overdueInvoices with empty invoice list', () => {
+  const result = overdueInvoices([], '2024-11-01');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices handles invoices spanning multiple years', () => {
+  let inv2024 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-12-20',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv2024 = issueInvoice(inv2024.value, []).value;
+
+  let inv2025 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv2025 = issueInvoice(inv2025.value, []).value;
+
+  const result = overdueInvoices([inv2024, inv2025], '2025-02-01');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].daysOverdue, 29); // 2024-12-20 + 14 = 2025-01-03, to 2025-02-01 = 29 days
+  assert.ok(result[0].daysOverdue > result[1].daysOverdue);
+});
+
+test('overdueInvoices with partially_paid status', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 500000, date: '2024-10-20' });
+  inv = paid.value;
+  assert.equal(inv.status, 'partially_paid');
+
+  const result = overdueInvoices([inv], '2024-10-30');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].status, undefined); // status not included in output
+});
