+import { isValidDate, daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Get all overdue invoices as of a given date.
+ * @param {Array<Object>} invoices - All invoices to check
+ * @param {string} asOf - Report date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  // If asOf is not a valid date, return empty array (invalid input)
+  if (!isValidDate(asOf)) return [];
+
+  // Filter and map to overdue invoices
+  const overdue = invoices
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .filter((inv) => inv.dueDate < asOf)
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue); // Most overdue first
+
+  return overdue;
+}
