 import { isValidDate, daysBetween } from './dates.js';
 import { balanceDue } from './payments.js';
+import { lineTotal, lineDiscount, lineVAT } from './invoices.js';
 
 /**
  * Get all overdue invoices as of a given date.
@@ -26,3 +27,31 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  invoices.forEach((inv) => {
+    // Only include issued, partially_paid, or paid invoices
+    if (!['issued', 'partially_paid', 'paid'].includes(inv.status)) {
+      return;
+    }
+
+    // Process each line
+    inv.lines.forEach((line) => {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVAT(line);
+
+      if (!vatMap[rate]) {
+        vatMap[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vat;
+    });
+  });
+
+  // Convert to array and sort by rate descending (high to low)
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
