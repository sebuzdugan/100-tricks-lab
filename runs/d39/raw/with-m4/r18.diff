 /**
  * Get all overdue invoices as of a given date.
@@ -55,3 +56,38 @@ export function vatSummary(invoices) {
   // Convert to array and sort by rate descending (high to low)
   return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
 }
+
+export function lateFee(invoice, asOf) {
+  // Invalid date
+  if (!isValidDate(asOf)) {
+    return 0;
+  }
+
+  // Only issued or partially_paid invoices can have late fees
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return 0;
+  }
+
+  // No dueDate means can't calculate late fee
+  if (!invoice.dueDate) {
+    return 0;
+  }
+
+  // If not overdue, no fee
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // Calculate due amount
+  const due = balanceDue(invoice);
+
+  // Late fee: 0.04% per day
+  const feeRate = 0.04;
+  const lateFeeAmount = (due * feeRate / 100) * daysOverdue;
+
+  // Round to cents
+  return roundCents(lateFeeAmount);
+}
