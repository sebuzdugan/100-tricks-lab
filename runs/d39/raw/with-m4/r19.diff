+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  let issued = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-20',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  issued = issueInvoice(issued.value, []).value;
+
+  const result = exportCsv([draft.value, issued]);
+  const lines = result.split('\n');
+
+  assert.ok(lines[1].startsWith('DRAFT,'));
+  assert.ok(!lines[2].startsWith('DRAFT,'));
+});
+
+test('exportCsv with paid invoice shows zero due', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 6050, date: '2024-10-20' });
+  inv = paid.value;
+
+  const result = exportCsv([inv]);
+  // Due should be 0.00
+  assert.ok(result.includes('0.00'));
+});
+
+test('exportCsv with voucher shows reduced total', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  // Add voucher manually since applyVoucher only works on draft
+  inv = {
+    ...inv,
+    voucher: { code: 'PROMO', amount: 1000 },
+  };
+
+  const result = exportCsv([inv]);
+  // Total should be reduced by voucher
+  assert.ok(result);
+});
