+
+test('exportCsv with multiple invoices', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv1 = issueInvoice(inv1.value, []).value;
+
+  let inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-20',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+  inv2 = issueInvoice(inv2.value, []).value;
+
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4); // header + 2 invoices + empty line
+
+  assert.ok(lines[1].includes(inv1.number));
+  assert.ok(lines[2].includes(inv2.number));
+});
+
+test('exportCsv preserves invoice order', () => {
+  let inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv1 = issueInvoice(inv1.value, []).value;
+
+  let inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-20',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+  inv2 = issueInvoice(inv2.value, []).value;
+
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n');
+
+  const line1 = lines[1];
+  const line2 = lines[2];
+
+  assert.ok(line1.includes(inv1.number));
+  assert.ok(line2.includes(inv2.number));
+});
+
+test('exportCsv with partially paid invoice shows remaining due', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const paid = recordPayment(inv, { amount: 3000, date: '2024-10-20' });
+  inv = paid.value;
+
+  const result = exportCsv([inv]);
+  // Total is 6050, paid 3000, remaining 3050
+  assert.ok(result.includes('30.50'));
+});
+
+test('exportCsv escapes field with comma', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  // Customer name might have comma, check for proper escaping
+  // If not, at least verify CSV parsing would work
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  // Should be parseable as CSV
+  assert.ok(dataLine.includes(','));
+});
+
+test('exportCsv escapes double quotes', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  // Should escape any double quotes in customer name
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  // Count quotes - they should come in pairs (escaped as "")
+  const quoteCount = (dataLine.match(/"/g) || []).length;
+  // Should be even (0, 2, 4, etc.) if properly escaped
+  assert.equal(quoteCount % 2, 0);
+});
+
+test('exportCsv with discount shows discount amount', () => {
+  let inv = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  // STICKER 50 cents * 100 = 5000 cents = 50.00
+  // With 5% discount = 2.50
+  assert.ok(result.includes('2.50'));
+});
+
+test('exportCsv with VAT shows VAT amount', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  // STICKER 50 cents * 100 = 5000 cents subtotal
+  // With 21% VAT on base = 1050 cents = 10.50
+  assert.ok(result.includes('10.50'));
+});
+
+test('exportCsv amounts use dot as decimal separator', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  // Should use dot, not comma
+  assert.ok(result.includes('.'));
+  // Should not have euro symbol
+  assert.ok(!result.includes('€'));
+  // Should not have thousands separator
+  assert.ok(!result.includes(',00,'));
+});
+
+test('exportCsv amounts have exactly 2 decimal places', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  // All amounts should have .XX format
+  const decimalMatches = result.match(/\d+\.\d{2}/g);
+  assert.ok(decimalMatches && decimalMatches.length > 0);
+  // All matched amounts should have exactly 2 decimals
+  decimalMatches.forEach(match => {
+    assert.equal(match.split('.')[1].length, 2);
+  });
+});
+
