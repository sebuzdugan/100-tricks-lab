+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  // Should have 10 fields: number, customer, issueDate, dueDate, status, subtotal, discount, vat, total, due
+  const parts = dataLine.split(',');
+  assert.equal(parts.length, 10);
