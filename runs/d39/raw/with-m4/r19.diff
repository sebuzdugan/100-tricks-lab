+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function formatEuro(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+function escapeCsv(field) {
+  const str = String(field);
+
+  // If field contains comma, newline, or double quote, wrap in quotes and escape internal quotes
+  if (str.includes(',') || str.includes('\n') || str.includes('"')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+
+  return str;
+}
+
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header line
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data lines
+  invoices.forEach((inv) => {
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    // Get customer name
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const fields = [
+      inv.number || 'DRAFT',
+      customerName,
+      inv.issueDate,
+      inv.dueDate || '',
+      inv.status,
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ];
+
+    const line = fields.map(escapeCsv).join(',');
+    lines.push(line);
+  });
+
+  // Join with \n and end with \n
+  return lines.join('\n') + '\n';
+}
