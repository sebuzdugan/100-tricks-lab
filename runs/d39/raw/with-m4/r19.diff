+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns a string', () => {
+  const result = exportCsv([]);
+  assert.equal(typeof result, 'string');
+});
+
+test('exportCsv includes header line', () => {
+  const result = exportCsv([]);
+  assert.ok(result.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv ends with newline', () => {
+  const result = exportCsv([]);
+  assert.ok(result.endsWith('\n'));
+});
+
+test('exportCsv with empty invoice list returns header only', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 2); // header + empty line at end
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv includes invoice number for issued invoice', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  assert.ok(result.includes(inv.number));
+});
+
+test('exportCsv shows DRAFT for draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  assert.ok(dataLine.startsWith('DRAFT,'));
+});
+
+test('exportCsv includes customer name', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  // C-002 is Blue Fern Bakery
+  assert.ok(result.includes('Blue Fern Bakery'));
+});
+
+test('exportCsv includes issueDate', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('2024-10-15'));
+});
+
+test('exportCsv includes dueDate for issued invoice', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET14',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('2024-10-29'));
+});
+
+test('exportCsv with draft invoice includes calculated dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    terms: 'NET30',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+
+  const result = exportCsv([inv.value]);
+  // Draft invoice with NET30 terms should have dueDate calculated
+  assert.ok(result.includes('2024-11-14'));
+});
+
+test('exportCsv includes status', () => {
+  let inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  inv = issueInvoice(inv.value, []).value;
+
+  const result = exportCsv([inv]);
+  assert.ok(result.includes('issued'));
