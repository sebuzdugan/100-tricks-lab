 }
+
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert an amount from euro cents to another currency's cents.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code: EUR, USD, or GBP
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const convertedCents = roundCents(cents * rate);
+
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents as money in the given currency.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code: EUR, USD, or GBP
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  if (!RATES[currency]) {
+    return '';
+  }
+
+  const rate = RATES[currency];
+  const amountInCurrency = (cents * rate) / 100;
+  const sign = amountInCurrency < 0 ? '-' : '';
+  const abs = Math.abs(amountInCurrency);
+  const major = Math.floor(abs).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const symbol = symbols[currency] || '';
+
+  return `${sign}${symbol}${major}.${String(Math.round(abs * 100) % 100).padStart(2, '0')}`;
+}
