@@ -0,0 +1,308 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  const line = { qty: 10, unitPrice: 500 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with large quantities', () => {
+  const line = { qty: 1000, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 8500000);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { qty: 1, unitPrice: 1234 };
+  assert.equal(lineTotal(line), 1234);
+});
+
+test('lineDiscount returns 0 for line without discountPercent', () => {
+  const line = { qty: 10, unitPrice: 500 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount calculates discount correctly', () => {
+  const line = { qty: 100, unitPrice: 500, discountPercent: 10 };
+  // lineTotal = 50000, discount = 50000 * 10 / 100 = 5000
+  assert.equal(lineDiscount(line), 5000);
+});
+
+test('lineDiscount with 5% tier discount', () => {
+  const line = { qty: 100, unitPrice: 500, discountPercent: 5 };
+  // lineTotal = 50000, discount = 50000 * 5 / 100 = 2500
+  assert.equal(lineDiscount(line), 2500);
+});
+
+test('lineDiscount with 2.5% tier discount', () => {
+  const line = { qty: 100, unitPrice: 500, discountPercent: 2.5 };
+  // lineTotal = 50000, discount = 50000 * 2.5 / 100 = 1250
+  assert.equal(lineDiscount(line), 1250);
+});
+
+test('lineDiscount never exceeds lineTotal', () => {
+  const line = { qty: 100, unitPrice: 500, discountPercent: 100 };
+  const discount = lineDiscount(line);
+  const total = lineTotal(line);
+  assert.ok(discount <= total);
+});
+
+test('lineDiscount is never negative', () => {
+  const line = { qty: 100, unitPrice: 500, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineVAT calculates VAT on taxable amount (after discount)', () => {
+  const line = { qty: 100, unitPrice: 500, vatRate: 21 };
+  // lineTotal = 50000, no discount, VAT = 50000 * 21 / 100 = 10500
+  assert.equal(lineVAT(line), 10500);
+});
+
+test('lineVAT with discount reduces VAT base', () => {
+  const line = { qty: 100, unitPrice: 500, discountPercent: 10, vatRate: 21 };
+  // lineTotal = 50000, discount = 5000, taxable = 45000
+  // VAT = 45000 * 21 / 100 = 9450
+  assert.equal(lineVAT(line), 9450);
+});
+
+test('lineVAT with 9% rate', () => {
+  const line = { qty: 50, unitPrice: 1000, vatRate: 9 };
+  // lineTotal = 50000, VAT = 50000 * 9 / 100 = 4500
+  assert.equal(lineVAT(line), 4500);
+});
+
+test('lineVAT with 0% rate', () => {
+  const line = { qty: 100, unitPrice: 500, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT is rounded to nearest cent', () => {
+  const line = { qty: 333, unitPrice: 1, vatRate: 21 };
+  // lineTotal = 333, VAT = 333 * 21 / 100 = 69.93, rounded = 70
+  assert.equal(lineVAT(line), 70);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 500, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 50000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 10500);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 60500);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 500, vatRate: 21 },
+      { qty: 50, unitPrice: 1000, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.total, 121000);
+});
+
+test('invoiceTotals with discount on single line', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 500, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal = 50000, discount = 5000, taxable = 45000, VAT = 9450
+  assert.equal(totals.subtotal, 50000);
+  assert.equal(totals.discount, 5000);
+  assert.equal(totals.vat, 9450);
+  assert.equal(totals.total, 54450);
+});
+
+test('invoiceTotals with discount on multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 500, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 1000, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  // discount1 = 5000, discount2 = 2500
+  assert.equal(totals.discount, 7500);
+  assert.ok(totals.vat > 0);
+});
+
+test('invoiceTotals with different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 500, vatRate: 21 },
+      { qty: 50, unitPrice: 1000, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  // VAT1 = 10500, VAT2 = 4500
+  assert.equal(totals.vat, 15000);
+});
+
+test('invoiceTotals with zero VAT rate', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 500, vatRate: 21 },
+      { qty: 50, unitPrice: 1000, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  // Only line 1 has VAT
+  assert.equal(totals.vat, 10500);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 500, vatRate: 21 }],
+    voucher: { code: 'PROMO', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  // subtotal = 50000, VAT = 10500, total = 60500 - 5000 = 55500
+  assert.equal(totals.subtotal, 50000);
+  assert.equal(totals.vat, 10500);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 55500);
+});
+
+test('invoiceTotals voucher never makes total negative', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 500, vatRate: 21 }],
+    voucher: { code: 'PROMO', amount: 100000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals without voucher shows zero voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 500, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals returns correct structure', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 500, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
+
+test('invoiceTotals all amounts are integers', () => {
+  const invoice = {
+    lines: [{ qty: 333, unitPrice: 1, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(Number.isInteger(totals.subtotal));
+  assert.ok(Number.isInteger(totals.discount));
+  assert.ok(Number.isInteger(totals.vat));
+  assert.ok(Number.isInteger(totals.voucher));
+  assert.ok(Number.isInteger(totals.total));
+});
+
+test('invoiceTotals all amounts are non-negative', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 500, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.subtotal >= 0);
+  assert.ok(totals.discount >= 0);
+  assert.ok(totals.vat >= 0);
+  assert.ok(totals.voucher >= 0);
+  assert.ok(totals.total >= 0);
+});
+
+test('invoiceTotals with large amounts', () => {
+  const invoice = {
+    lines: [{ qty: 10000, unitPrice: 100000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 1000000000);
+  assert.equal(totals.vat, 210000000);
+});
+
+test('invoiceTotals formula: total = subtotal - discount + vat - voucher (clamped)', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 500, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 1000, discountPercent: 5, vatRate: 21 },
+    ],
+    voucher: { code: 'PROMO', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  const expectedTotal = Math.max(
+    0,
+    totals.subtotal - totals.discount + totals.vat - totals.voucher
+  );
+  assert.equal(totals.total, expectedTotal);
+});
+
+test('lineTotal, lineDiscount, lineVAT consistency', () => {
+  const line = { qty: 100, unitPrice: 500, discountPercent: 10, vatRate: 21 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const vat = lineVAT(line);
+
+  // VAT should be calculated on taxable amount
+  const taxableAmount = total - discount;
+  const expectedVat = Math.round(taxableAmount * 21 / 100);
+  assert.equal(vat, expectedVat);
+});
+
+test('invoiceTotals composition: sum of individual amounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 500, discountPercent: 10, vatRate: 21 },
+      { qty: 50, unitPrice: 1000, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+
+  const line1Total = lineTotal(invoice.lines[0]);
+  const line2Total = lineTotal(invoice.lines[1]);
+  const line1Discount = lineDiscount(invoice.lines[0]);
+  const line2Discount = lineDiscount(invoice.lines[1]);
+  const line1Vat = lineVAT(invoice.lines[0]);
+  const line2Vat = lineVAT(invoice.lines[1]);
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, line1Total + line2Total);
+  assert.equal(totals.discount, line1Discount + line2Discount);
+  assert.equal(totals.vat, line1Vat + line2Vat);
+});
+
+test('invoiceTotals empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('lineTotal and lineDiscount are used by lineVAT', () => {
+  const line = { qty: 100, unitPrice: 500, discountPercent: 10, vatRate: 21 };
+  const lt = lineTotal(line);
+  const ld = lineDiscount(line);
+  const lv = lineVAT(line);
+
+  // lineVAT should use lineTotal and lineDiscount
+  const expectedVat = Math.round((lt - ld) * 21 / 100);
+  assert.equal(lv, expectedVat);
+});
