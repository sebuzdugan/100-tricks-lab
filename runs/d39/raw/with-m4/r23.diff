index 9174ec3..0d2b2be 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -11,15 +11,26 @@ export function lineTotal(line) {
 
 /**
  * Calculate the discount for a single invoice line.
- * Discount is lineTotal × discountPercent / 100, clamped to [0, lineTotal], rounded to cents.
+ * Discount includes: explicit/tier discount + 2.5% bulk discount (if qty >= 10, applied after first discount).
+ * Bulk discount is applied to the amount remaining after the first discount.
+ * Result is rounded to cents and clamped to [0, lineTotal].
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
-  if (!line.discountPercent) return 0;
   const total = lineTotal(line);
-  const discount = roundCents((total * line.discountPercent) / 100);
-  return Math.max(0, Math.min(discount, total));
+
+  // Calculate first discount (explicit or tier)
+  const firstDiscountAmount = line.discountPercent ? (total * line.discountPercent) / 100 : 0;
+  const roundedFirstDiscount = roundCents(firstDiscountAmount);
+  const remainingAfterFirst = total - roundedFirstDiscount;
+
+  // Calculate bulk discount (2.5% if qty >= 10)
+  const bulkDiscountAmount = line.qty >= 10 ? (remainingAfterFirst * 2.5) / 100 : 0;
+  const roundedBulkDiscount = roundCents(bulkDiscountAmount);
+
+  const totalDiscount = roundedFirstDiscount + roundedBulkDiscount;
+  return Math.max(0, Math.min(totalDiscount, total));
 }
 
