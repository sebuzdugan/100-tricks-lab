   // Round to cents
   return roundCents(lateFeeAmount);
 }
+
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  invoices.forEach((inv) => {
+    if (counts[inv.status] !== undefined) {
+      counts[inv.status]++;
+    }
+  });
+
+  // Calculate outstanding (issued + partially_paid invoices)
+  let outstanding = 0;
+  invoices.forEach((inv) => {
+    if (['issued', 'partially_paid'].includes(inv.status)) {
+      outstanding += balanceDue(inv);
+    }
+  });
+
+  // Get overdue invoices and calculate totals
+  const overdue_list = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_list.length,
+    amount: overdue_list.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Calculate top 3 customers by amount due
+  const customerDue = {};
+  invoices.forEach((inv) => {
+    if (['issued', 'partially_paid'].includes(inv.status)) {
+      const due = balanceDue(inv);
+      if (due > 0) {
+        if (!customerDue[inv.customerId]) {
+          customerDue[inv.customerId] = 0;
+        }
+        customerDue[inv.customerId] += due;
+      }
+    }
+  });
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
