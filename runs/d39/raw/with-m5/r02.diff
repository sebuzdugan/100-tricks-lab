@@ -49,3 +49,34 @@ export function createInvoice({ customerId, issueDate, lines }) {
     lines: invoiceLines,
   });
 }
+
+/**
+ * Calculate the total for a line item (qty times unitPrice).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the invoice totals.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number }> }} invoice
+ * @returns {{ ok: true, value: { subtotal: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || typeof invoice !== 'object' || !Array.isArray(invoice.lines)) {
+    return fail('INVALID_INVOICE');
+  }
+
+  let subtotal = 0;
+  for (const line of invoice.lines) {
+    if (!line || typeof line !== 'object' || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number') {
+      return fail('INVALID_LINE');
+    }
+    subtotal += lineTotal(line);
+  }
+
+  const total = subtotal;
+  return ok({ subtotal, total });
+}
