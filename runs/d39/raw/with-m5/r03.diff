   const total = subtotal;
   return ok({ subtotal, total });
 }
+
+/**
+ * Add a line to an invoice. If the SKU already exists, increase its quantity.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {{ sku: string, qty: number }} param1
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty is a positive integer
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Get product by SKU
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Create new lines array
+  const newLines = [];
+  let found = false;
+
+  for (const line of invoice.lines) {
+    if (line.sku === sku) {
+      newLines.push({
+        ...line,
+        qty: line.qty + qty,
+      });
+      found = true;
+    } else {
+      newLines.push({ ...line });
+    }
+  }
+
+  // If SKU not found, add new line
+  if (!found) {
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {{ status: string, lines: Array }} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: { status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Find the line
+  const lineIndex = invoice.lines.findIndex((l) => l.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  // Check if it would remove the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new lines array without that line
+  const newLines = invoice.lines.filter((_, i) => i !== lineIndex);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
