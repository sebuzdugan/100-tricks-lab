diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..8f96f0e
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number for empty list', () => {
+  const r = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const r = nextInvoiceNumber(['INV-2026-0001'], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber skips missing numbers', () => {
+  const r = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0003'], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const r = nextInvoiceNumber(['INV-2025-9999', 'INV-2026-0001'], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const r = nextInvoiceNumber(['INV-2025-0001', 'INV-2025-0002'], '2026-01-01');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existingNumbers = Array.from({ length: 100 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0101');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const r = nextInvoiceNumber(['INV-2026-XXXX', 'INV-2026-0001', 'invalid-number'], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber rejects invalid date format', () => {
+  const r = nextInvoiceNumber([], '2026/10/07');
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('nextInvoiceNumber rejects invalid date (Feb 30)', () => {
+  const r = nextInvoiceNumber([], '2026-02-30');
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('nextInvoiceNumber handles unsorted existing numbers', () => {
+  const r = nextInvoiceNumber(['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0004');
+});
