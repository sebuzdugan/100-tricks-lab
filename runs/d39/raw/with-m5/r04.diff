@@ -0,0 +1,40 @@
+import { ok, fail } from './result.js';
+
+/**
+ * Get the next free invoice number for a given issue date.
+ * Number format: INV-YYYY-NNNN where NNNN is 4-digit zero-padded counter starting at 0001.
+ * Counter resets each year.
+ * @param {Array<string>} existingNumbers - Array of invoice numbers already in use
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  // Validate issueDate is a real date in YYYY-MM-DD format
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) return fail('DATE_INVALID');
+  const date = new Date(issueDate + 'T00:00:00Z');
+  if (isNaN(date.getTime()) || date.toISOString().slice(0, 10) !== issueDate) {
+    return fail('DATE_INVALID');
+  }
+
+  // Extract year from issueDate
+  const year = issueDate.slice(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Extract counters from this year's numbers
+  const counters = [];
+  for (const num of existingNumbers) {
+    if (!num.startsWith(prefix)) continue;
+    const match = num.match(/^INV-\d{4}-(\d{4})$/);
+    if (match) {
+      counters.push(parseInt(match[1], 10));
+    }
+  }
+
+  // Find max counter (or 0 if none)
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  // Format as 4-digit zero-padded number
+  const formatted = String(nextCounter).padStart(4, '0');
+  return ok(`INV-${year}-${formatted}`);
+}
