+/**
+ * Issue a draft invoice, assigning it a number and changing status to 'issued'.
+ * @param {{ status: string, issueDate: string }} invoice
+ * @param {Array<string>} existingNumbers - Array of invoice numbers already in use
+ * @returns {{ ok: true, value: { number: string, status: string } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Get next invoice number
+  const numberResult = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+  if (!numberResult.ok) return numberResult;
+
+  const number = numberResult.value;
+
+  // Create new invoice with number and status 'issued'
+  return ok({
+    ...invoice,
+    number,
+    status: 'issued',
+  });
+}
