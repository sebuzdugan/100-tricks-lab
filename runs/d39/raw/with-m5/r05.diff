+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  assert.match(r.value, /^DRAFT$/m);
+  assert.match(r.value, /^Kite & Co$/m);
+  assert.match(r.value, /^5 x Design work \(hour\) @ €85\.00 = €425\.00$/m);
+  assert.match(r.value, /^Total: €425\.00$/m);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = renderInvoiceText(issued.value);
+  assert.equal(r.ok, true);
+  assert.match(r.value, /^INV-2026-0001$/m);
+  assert.match(r.value, /^Kite & Co$/m);
+});
+
+test('renderInvoiceText renders multiple line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  });
+  assert.equal(invoice.ok, true);
+
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  assert.match(r.value, /5 x Design work \(hour\) @ €85\.00 = €425\.00/);
+  assert.match(r.value, /10 x Development \(hour\) @ €95\.00 = €950\.00/);
+  assert.match(r.value, /^Total: €1,375\.00$/m);
+});
+
+test('renderInvoiceText formats amounts using formatEuros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(invoice.ok, true);
+
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  // Logo package is €1,200.00 per unit, so 2 = €2,400.00
+  assert.match(r.value, /1 x Logo package @ €1,200\.00 = €1,200\.00/);
+  assert.match(r.value, /^Total: €2,400\.00$/m);
+});
+
+test('renderInvoiceText rejects unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 5, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const r = renderInvoiceText(invoice);
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const lines = r.value.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText shows correct line count', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+  assert.equal(invoice.ok, true);
+
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const lines = r.value.split('\n');
+  // Number line + customer name + 3 items + total = 6 lines
+  assert.equal(lines.length, 6);
+});
+
+test('renderInvoiceText works with items having different VAT rates', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  });
+  assert.equal(invoice.ok, true);
+
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  // DES-HOUR is 21% VAT, PRINT-A4 is 9% VAT - but our calculation doesn't include VAT yet
+  // So the prices shown are just unit prices, not including tax
+  assert.match(r.value, /Design work \(hour\) @ €85\.00 = €85\.00/);
+  assert.match(r.value, /Printed flyer A4 \(each\) @ €0\.37 = €37\.00/);
+  assert.match(r.value, /^Total: €122\.00$/m);
+});
+
+test('renderInvoiceText produces valid text output', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  assert.equal(invoice.ok, true);
+
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  assert.equal(typeof r.value, 'string');
+  assert.ok(r.value.includes('DRAFT'));
+  assert.ok(r.value.includes('Kite & Co'));
+  assert.ok(r.value.includes('Total:'));
+});
