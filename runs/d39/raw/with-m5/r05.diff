+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { ok, fail } from './result.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, number?: string, lines: Array }} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  // Look up customer
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const customer = customerResult.value;
+
+  // Get invoice number (or DRAFT)
+  const numberLine = invoice.number ? invoice.number : 'DRAFT';
+
+  // Build output lines
+  const lines = [numberLine, customer.name];
+
+  // Add each line item
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const formattedUnitPrice = formatEuros(line.unitPrice);
+    const formattedTotal = formatEuros(total);
+    lines.push(`${line.qty} x ${line.name} @ ${formattedUnitPrice} = ${formattedTotal}`);
+  }
+
+  // Add total
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+
+  const formattedTotal = formatEuros(totalsResult.value.total);
+  lines.push(`Total: ${formattedTotal}`);
+
+  return ok(lines.join('\n'));
+}
