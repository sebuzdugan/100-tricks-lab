+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: { status: string, payments: Array } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, payment) {
+  // Check status is issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  const { amount, date } = payment;
+
+  // Validate amount is positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get total from invoiceTotals
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+
+  const total = totalsResult.value.total;
+
+  // Calculate current balance due
+  const currentPaid = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  const balanceOwed = total - currentPaid;
+
+  // Check for overpayment
+  if (amount > balanceOwed) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array
+  const newPayments = [...(invoice.payments || []), { amount, date }];
+
+  // Calculate new balance
+  const newPaid = currentPaid + amount;
+  const newBalance = total - newPaid;
+
+  // Determine new status
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function balanceDue(invoice) {
+  // Get total from invoiceTotals
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+
+  const total = totalsResult.value.total;
+
+  // Sum payments
+  const paid = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+
+  return ok(total - paid);
+}
