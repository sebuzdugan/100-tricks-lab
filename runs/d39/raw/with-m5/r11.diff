+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('recordPayment records a payment on an issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = recordPayment(issued.value, { amount: 50000, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 50000);
+  assert.equal(r.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const r = recordPayment(invoice, { amount: 5000, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+});
+
+test('recordPayment updates status to partially_paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice total: 10 * 8500 = 85000, VAT 21% = 17850, total = 102850
+  const r = recordPayment(issued.value, { amount: 50000, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment updates status to paid when fully paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice total: 8500 + VAT (1785) = 10285
+  const r = recordPayment(issued.value, { amount: 10285, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment accepts multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment1 = recordPayment(issued.value, { amount: 50000, date: '2026-10-10' });
+  assert.equal(payment1.ok, true);
+
+  const payment2 = recordPayment(payment1.value, { amount: 52850, date: '2026-10-15' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.payments.length, 2);
+  assert.equal(payment2.value.status, 'paid');
+});
+
+test('recordPayment rejects draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const r = recordPayment(invoice.value, { amount: 10000, date: '2026-10-10' });
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects non-integer amount', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const r = recordPayment(invoice, { amount: 100.5, date: '2026-10-10' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects zero amount', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const r = recordPayment(invoice, { amount: 0, date: '2026-10-10' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects negative amount', () => {
+  const invoice = {
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const r = recordPayment(invoice, { amount: -100, date: '2026-10-10' });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+
+  // Invoice total: 8500 + 1785 = 10285
+  const r = recordPayment(issued.value, { amount: 10286, date: '2026-10-10' });
+  assert.deepEqual(r, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate the input invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  const original = issued.value;
+  const originalStatus = original.status;
+
+  recordPayment(original, { amount: 5000, date: '2026-10-10' });
+
+  assert.equal(original.status, originalStatus);
+  assert.equal(original.payments, undefined);
+});
+
+test('balanceDue returns full amount when no payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = balanceDue(issued.value);
+  assert.equal(r.ok, true);
+  // 5 * 8500 = 42500, VAT 21% = 8925, total = 51425
+  assert.equal(r.value, 51425);
+});
+
+test('balanceDue returns remaining amount after partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  const withPayment = recordPayment(issued.value, { amount: 25000, date: '2026-10-10' });
+  assert.equal(withPayment.ok, true);
+
+  const r = balanceDue(withPayment.value);
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 51425 - 25000);
+});
+
+test('balanceDue returns zero when fully paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  const withPayment = recordPayment(issued.value, { amount: 10285, date: '2026-10-10' });
+  assert.equal(withPayment.ok, true);
+
+  const r = balanceDue(withPayment.value);
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 0);
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  const partial = recordPayment(issued.value, { amount: 50000, date: '2026-10-10' });
+  assert.equal(partial.ok, true);
+  assert.equal(partial.value.status, 'partially_paid');
+
+  // Record another payment on the partially_paid invoice
+  const final = recordPayment(partial.value, { amount: 52850, date: '2026-10-15' });
+  assert.equal(final.ok, true);
+  assert.equal(final.value.status, 'paid');
+});
