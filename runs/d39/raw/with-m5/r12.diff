   // Validate issueDate is a real date in YYYY-MM-DD format
   if (!isValidDate(issueDate)) return fail('DATE_INVALID');
 
+  // Determine and validate terms (default NET30)
+  const finalTerms = terms ?? 'NET30';
+  if (!['NET14', 'NET30', 'EOM'].includes(finalTerms)) {
+    return fail('TERMS_INVALID');
+  }
+
+  // Calculate due date
+  let dueDate;
+  if (finalTerms === 'NET14') {
+    dueDate = addDays(issueDate, 14);
+  } else if (finalTerms === 'NET30') {
+    dueDate = addDays(issueDate, 30);
+  } else if (finalTerms === 'EOM') {
+    // Last day of the issue date's month
+    const d = new Date(issueDate + 'T00:00:00Z');
+    d.setUTCMonth(d.getUTCMonth() + 1, 0);
+    dueDate = d.toISOString().slice(0, 10);
+  }
