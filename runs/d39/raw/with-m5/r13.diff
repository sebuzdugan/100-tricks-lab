+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: { code: string, amount: number } }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: { voucher: { code: string, amount: number } } } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, voucher) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check voucher doesn't already exist
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Validate amount is positive integer
+  const { code, amount } = voucher;
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Create new invoice with voucher
+  return ok({
+    ...invoice,
+    voucher: { code, amount },
+  });
+}
