+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement showing unpaid and partially paid invoices.
+ * @param {string} customerId
+ * @param {Array} invoices - All invoices to filter from
+ * @param {string} asOf - Date in YYYY-MM-DD format; only includes invoices with issueDate <= asOf
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer that are unpaid and within the date range
+  const customerInvoices = (invoices || []).filter(inv =>
+    inv.customerId === customerId &&
+    (inv.status === 'issued' || inv.status === 'partially_paid') &&
+    inv.issueDate <= asOf
+  );
+
+  // Map to statement format
+  const statementInvoices = customerInvoices.map(inv => {
+    const totalsResult = invoiceTotals(inv);
+    const total = totalsResult.ok ? totalsResult.value.total : 0;
+
+    const dueResult = balanceDue(inv);
+    const due = dueResult.ok ? dueResult.value : 0;
+
+    return {
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total,
+      due,
+    };
+  }).sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Sum the due amounts
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
