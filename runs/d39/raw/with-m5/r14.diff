+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns empty list for customer with no unpaid invoices', () => {
+  const r = statement('C-003', [], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes issued invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = statement('C-003', [issued.value], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[0].dueDate, '2026-11-06');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  const partial = recordPayment(issued.value, { amount: 20000, date: '2026-10-10' });
+  assert.equal(partial.ok, true);
+  assert.equal(partial.value.status, 'partially_paid');
+
+  const r = statement('C-003', [partial.value], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].due, 51425 - 20000);
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(draft.ok, true);
+
+  const r = statement('C-003', [draft.value], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  const paid = recordPayment(issued.value, { amount: 10285, date: '2026-10-10' });
+  assert.equal(paid.ok, true);
+  assert.equal(paid.value.status, 'paid');
+
+  const r = statement('C-003', [paid.value], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement filters by asOf date', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-11-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const r = statement('C-003', [issued1.value, issued2.value], '2026-11-01');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-11-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const r = statement('C-003', [issued1.value, issued2.value], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[1].issueDate, '2026-11-15');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 0 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+  const partial = recordPayment(issued2.value, { amount: 5000, date: '2026-10-20' });
+
+  const r = statement('C-003', [issued1.value, partial.value], '2026-12-31');
+  assert.equal(r.ok, true);
+  // Invoice 1: 10285 due
+  // Invoice 2: (2 * 8500 = 17000, + 3570 VAT = 20570) - 5000 = 15570 due
+  // Total: 10285 + 15570 = 25855
+  assert.equal(r.value.totalDue, 10285 + 15570);
+});
+
+test('statement filters by customer', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const r = statement('C-003', [issued1.value, issued2.value], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0002');
+});
+
+test('statement rejects unknown customer', () => {
+  const r = statement('C-999', [], '2026-12-31');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement works with empty invoices array', () => {
+  const r = statement('C-003', [], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement works with null invoices array', () => {
+  const r = statement('C-003', null, '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes issued date and due date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  assert.equal(invoice.ok, true);
+
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+
+  const r = statement('C-003', [issued.value], '2026-12-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(r.value.invoices[0].dueDate, '2026-10-21');
+});
