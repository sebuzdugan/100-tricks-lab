+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote on issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(issued.value, { amount: 5000, reason: 'Partial refund', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r.value.customerId, 'C-003');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Partial refund');
+  assert.equal(r.value.date, '2026-10-08');
+});
+
+test('createCreditNote on partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const partial = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+
+  const r = createCreditNote(partial.value, { amount: 5000, reason: 'Adjustment', date: '2026-10-09' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote on paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const paid = recordPayment(issued.value, { amount: 20570, date: '2026-10-08' });
+
+  const r = createCreditNote(paid.value, { amount: 1000, reason: 'Late fee waiver', date: '2026-10-09' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoice (NOT_ISSUED)', () => {
+  const draft = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+
+  const r = createCreditNote(draft.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects invalid amount (not integer)', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(issued.value, { amount: 1000.5, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(issued.value, { amount: 0, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(issued.value, { amount: -5000, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects credit exceeding invoice total (CREDIT_TOO_HIGH)', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  // Invoice total is 10285 (8500 + 1785 VAT)
+  const r = createCreditNote(issued.value, { amount: 20000, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.deepEqual(r, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote with exact invoice total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(issued.value, { amount: 10285, reason: 'Full refund', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, 10285);
+});
+
+test('createCreditNote increments counter separately from invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(
+    issued.value,
+    { amount: 1000, reason: 'Refund', date: '2026-10-08' },
+    ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003']
+  );
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote increments credit note counter', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(
+    issued.value,
+    { amount: 1000, reason: 'Refund', date: '2026-10-08' },
+    ['CN-2026-0001', 'CN-2026-0002']
+  );
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote resets counter per year', () => {
+  const invoice2025 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-12-31',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued2025 = issueInvoice(invoice2025.value, []);
+
+  const r = createCreditNote(
+    issued2025.value,
+    { amount: 1000, reason: 'Refund', date: '2025-12-31' },
+    ['CN-2025-0001', 'CN-2025-0002']
+  );
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2025-0003');
+
+  const invoice2026 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued2026 = issueInvoice(invoice2026.value, ['INV-2025-0001']);
+
+  const r2026 = createCreditNote(
+    issued2026.value,
+    { amount: 1000, reason: 'Refund', date: '2026-01-01' },
+    ['CN-2025-0001', 'CN-2025-0002', 'CN-2025-0003']
+  );
+  assert.equal(r2026.ok, true);
+  assert.equal(r2026.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects invalid date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-13-01' }, []);
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote with empty existingNumbers', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote with null existingNumbers', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = createCreditNote(issued.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, null);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
