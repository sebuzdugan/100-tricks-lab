+import { ok, fail } from './result.js';
+import { isValidDate } from './dates.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Create a credit note for a refund on an issued invoice.
+ * @param {{ status: string, number: string, customerId: string }} invoice
+ * @param {{ amount: number, reason: string, date: string }} param1
+ * @param {Array<string>} existingNumbers - Array of all invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is not draft
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate status is one of the allowed values
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date is a real date in YYYY-MM-DD format
+  if (!isValidDate(date)) return fail('DATE_INVALID');
+
+  // Validate amount is positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+
+  const invoiceTotal = totalsResult.value.total;
+
+  // Check credit amount doesn't exceed invoice total
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Find the next credit note number
+  const year = date.slice(0, 4);
+  const prefix = `CN-${year}-`;
+  const existingCreditNotes = (existingNumbers || []).filter((n) => n.startsWith(prefix));
+
+  // Extract counters from existing credit notes
+  const counters = existingCreditNotes.map((n) => {
+    const match = n.match(/^CN-\d{4}-(\d{4})$/);
+    return match ? parseInt(match[1], 10) : 0;
+  });
+
+  // Find max counter and increment
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+  const formatted = String(nextCounter).padStart(4, '0');
+  const number = `CN-${year}-${formatted}`;
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
