+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty list when no invoices', () => {
+  const r = overdueInvoices([], '2026-10-15');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices returns empty list when invoices is null', () => {
+  const r = overdueInvoices(null, '2026-10-15');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices excludes invoices not yet due', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  // Due date is 2026-10-21, asOf is 2026-10-20 (not yet due)
+  const r = overdueInvoices([issued.value], '2026-10-20');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices excludes invoices due on asOf date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  // Due date is 2026-10-21, asOf is 2026-10-21 (exactly due, not overdue)
+  const r = overdueInvoices([issued.value], '2026-10-21');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices includes invoices overdue by 1 day', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  // Due date is 2026-10-21, asOf is 2026-10-22 (1 day overdue)
+  const r = overdueInvoices([issued.value], '2026-10-22');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].number, 'INV-2026-0001');
+  assert.equal(r[0].daysOverdue, 1);
+});
+
+test('overdueInvoices includes issued invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = overdueInvoices([issued.value], '2026-10-30');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const partial = recordPayment(issued.value, { amount: 5000, date: '2026-10-10' });
+
+  const r = overdueInvoices([partial.value], '2026-10-30');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].number, 'INV-2026-0001');
+  assert.equal(r[0].status, undefined); // status field not in output
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+
+  const r = overdueInvoices([draft.value], '2026-10-30');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const paid = recordPayment(issued.value, { amount: 10285, date: '2026-10-10' });
+
+  const r = overdueInvoices([paid.value], '2026-10-30');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  // Due date 2026-10-21, asOf 2026-10-28 = 7 days overdue
+  const r = overdueInvoices([issued.value], '2026-10-28');
+  assert.equal(r[0].daysOverdue, 7);
+});
+
+test('overdueInvoices calculates due for unpaid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = overdueInvoices([issued.value], '2026-10-30');
+  assert.equal(r[0].due, 10285); // full amount owed
+});
+
+test('overdueInvoices calculates due for partially paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const partial = recordPayment(issued.value, { amount: 5000, date: '2026-10-10' });
+
+  const r = overdueInvoices([partial.value], '2026-10-30');
+  assert.equal(r[0].due, 20570 - 5000); // remaining balance (17000 + 3570 VAT - 5000)
+});
+
+test('overdueInvoices sorts by daysOverdue descending (most overdue first)', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const r = overdueInvoices([issued1.value, issued2.value], '2026-10-30');
+  assert.equal(r.length, 2);
+  assert.equal(r[0].number, 'INV-2026-0001'); // due 2026-10-15 (15 days overdue)
+  assert.equal(r[1].number, 'INV-2026-0002'); // due 2026-10-19 (11 days overdue)
+  assert.equal(r[0].daysOverdue, 15);
+  assert.equal(r[1].daysOverdue, 11);
+});
+
+test('overdueInvoices includes correct fields', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = overdueInvoices([issued.value], '2026-10-30');
+  assert.equal(r[0].number, 'INV-2026-0001');
+  assert.equal(r[0].customerId, 'C-003');
+  assert.equal(r[0].dueDate, '2026-10-21');
+  assert.equal(r[0].daysOverdue, 9);
+  assert.equal(r[0].due, 10285);
+  assert.equal(Object.keys(r[0]).length, 5); // exactly 5 fields
+});
+
+test('overdueInvoices with multiple overdue invoices of same customer', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const r = overdueInvoices([issued1.value, issued2.value], '2026-10-30');
+  assert.equal(r.length, 2);
+  assert.equal(r[0].number, 'INV-2026-0001'); // older, more overdue
+  assert.equal(r[1].number, 'INV-2026-0002');
+  assert.equal(r[0].customerId, 'C-003');
+  assert.equal(r[1].customerId, 'C-003');
+});
+
+test('overdueInvoices with mixed customer overdue invoices', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const r = overdueInvoices([issued1.value, issued2.value], '2026-10-30');
+  assert.equal(r.length, 2);
+  assert.equal(r[0].customerId, 'C-001'); // more overdue
+  assert.equal(r[1].customerId, 'C-003');
+});
