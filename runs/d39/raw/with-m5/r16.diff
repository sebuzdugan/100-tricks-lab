+import { daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a report of overdue invoices.
+ * @param {Array} invoices - All invoices to check
+ * @param {string} asOf - Date in YYYY-MM-DD format; invoices with dueDate < asOf are overdue
+ * @returns {Array} Array of { number, customerId, dueDate, daysOverdue, due }, sorted by daysOverdue descending
+ */
+export function overdueInvoices(invoices, asOf) {
+  // Filter for overdue invoices (issued or partially_paid, with dueDate before asOf)
+  const overdue = (invoices || []).filter((inv) =>
+    (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate < asOf
+  );
+
+  // Map to report format
+  const result = overdue
+    .map((inv) => {
+      const dueResult = balanceDue(inv);
+      const due = dueResult.ok ? dueResult.value : 0;
+      const daysOverdue = daysBetween(inv.dueDate, asOf);
+
+      return {
+        number: inv.number,
+        customerId: inv.customerId,
+        dueDate: inv.dueDate,
+        daysOverdue,
+        due,
+      };
+    })
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return result;
+}
