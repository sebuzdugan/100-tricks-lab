+/**
+ * Generate a VAT summary by rate for issued/partially_paid/paid invoices.
+ * @param {Array} invoices - All invoices to summarize
+ * @returns {Array} Array of { rate, base, vat }, sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = {}; // rate -> { base, vat }
+
+  (invoices || []).forEach((inv) => {
+    if (!['issued', 'partially_paid', 'paid'].includes(inv.status)) return;
+
+    inv.lines?.forEach((line) => {
+      const rate = line.vatRate;
+      const lineTotal = line.qty * line.unitPrice;
+      const discount = roundCents(lineTotal * (line.discountPercent || 0) / 100);
+      const base = lineTotal - discount;
+      const vatAmount = roundCents(base * rate / 100);
+
+      if (!vatMap[rate]) {
+        vatMap[rate] = { base: 0, vat: 0 };
+      }
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vatAmount;
+    });
+  });
+
+  // Convert to array and sort by rate descending
+  return Object.entries(vatMap)
+    .map(([rate, { base, vat }]) => ({
+      rate: Number(rate),
+      base,
+      vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
