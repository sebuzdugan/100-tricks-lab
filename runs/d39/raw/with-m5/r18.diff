+/**
+ * Calculate late fee for an invoice.
+ * @param {{ dueDate: string, status: string }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents (0.04% per day overdue), 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  // Check if invoice is overdue
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  // Get balance due
+  const dueResult = balanceDue(invoice);
+  const due = dueResult.ok ? dueResult.value : 0;
+
+  // If nothing is due, no fee
+  if (due <= 0) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // Late fee = due × daysOverdue × 0.04% = due × daysOverdue × 0.0004
+  const fee = due * daysOverdue * 0.0004;
+
+  return roundCents(fee);
+}
