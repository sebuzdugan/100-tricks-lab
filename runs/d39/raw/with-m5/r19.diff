+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Escape a field for CSV export.
+ * @param {string} value
+ * @returns {string}
+ */
+function escapeCSVField(value) {
+  if (typeof value !== 'string') {
+    value = String(value);
+  }
+
+  if (value.includes(',') || value.includes('"')) {
+    value = value.replace(/"/g, '""');
+    return `"${value}"`;
+  }
+
+  return value;
+}
+
+/**
+ * Format cents as euros with 2 decimals and a dot.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuro(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices - All invoices to export
+ * @returns {string} CSV string with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const lines = ['number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'];
+
+  (invoices || []).forEach((inv) => {
+    // Get customer name
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    // Get invoice totals
+    const totalsResult = invoiceTotals(inv);
+    const { subtotal, discount, vat, total } = totalsResult.ok
+      ? totalsResult.value
+      : { subtotal: 0, discount: 0, vat: 0, total: 0 };
+
+    // Get balance due
+    const dueResult = balanceDue(inv);
+    const due = dueResult.ok ? dueResult.value : 0;
+
+    // Build row
+    const row = [
+      escapeCSVField(inv.number || 'DRAFT'),
+      escapeCSVField(customerName),
+      inv.issueDate,
+      inv.dueDate || '',
+      inv.status,
+      formatEuro(subtotal),
+      formatEuro(discount),
+      formatEuro(vat),
+      formatEuro(total),
+      formatEuro(due),
+    ];
+
+    lines.push(row.join(','));
+  });
+
+  return lines.join('\n') + '\n';
+}
