+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header for empty invoices', () => {
+  const r = exportCsv([]);
+  assert.equal(r, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv returns header for null invoices', () => {
+  const r = exportCsv(null);
+  assert.equal(r, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv exports single issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  assert.equal(lines.length, 3); // header + 1 invoice + empty (from trailing \n)
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.match(lines[1], /^INV-2026-0001/);
+});
+
+test('exportCsv exports draft invoice with DRAFT as number', () => {
+  const draft = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+
+  const r = exportCsv([draft.value]);
+  const lines = r.split('\n');
+  assert.match(lines[1], /^DRAFT,/);
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  const fields = lines[1].split(',');
+  // C-003 is "Kite & Co"
+  assert.equal(fields[1], 'Kite & Co');
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  const fields = lines[1].split(',');
+  // subtotal = 8500 cents = 85.00
+  assert.equal(fields[5], '85.00');
+  // vat = 1785 cents = 17.85
+  assert.equal(fields[7], '17.85');
+  // total = 10285 cents = 102.85
+  assert.equal(fields[8], '102.85');
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const invoice = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  // C-004 is "Smith, Jones & Partners" which has a comma
+  assert.match(lines[1], /"Smith, Jones & Partners"/);
+});
+
+test('exportCsv escapes customer name with double quote', () => {
+  const invoice = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  // C-006 is "Marlow \"The Print Shop\"" which has quotes
+  assert.match(lines[1], /"Marlow ""The Print Shop"""/);
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
