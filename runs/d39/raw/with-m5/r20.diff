+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { RATES, convert, formatMoney } from '../src/money.js';
+
+// RATES tests
+test('RATES has EUR at 1', () => {
+  assert.equal(RATES.EUR, 1);
+});
+
+test('RATES has USD at 1.085', () => {
+  assert.equal(RATES.USD, 1.085);
+});
+
+test('RATES has GBP at 0.8425', () => {
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+// convert tests
+test('convert EUR to EUR returns same amount', () => {
+  const r = convert(10000, 'EUR');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 10000);
+});
+
+test('convert EUR to USD calculates correctly', () => {
+  const r = convert(10000, 'USD');
+  assert.equal(r.ok, true);
+  // 10000 * 1.085 = 10850
+  assert.equal(r.value, 10850);
+});
+
+test('convert EUR to GBP calculates correctly', () => {
+  const r = convert(10000, 'GBP');
+  assert.equal(r.ok, true);
+  // 10000 * 0.8425 = 8425
+  assert.equal(r.value, 8425);
+});
+
+test('convert with unknown currency returns error', () => {
+  const r = convert(10000, 'JPY');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with empty currency returns error', () => {
+  const r = convert(10000, '');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert zero cents', () => {
+  const r = convert(0, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 0);
+});
+
+test('convert rounding example 1', () => {
+  // 1 cent EUR = 1.085 cents USD (rounds to 1)
+  const r = convert(1, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 1);
+});
+
+test('convert rounding example 2', () => {
+  // 100 EUR cents = 108.5 USD cents (rounds to 108 with banker's rounding)
+  const r = convert(100, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 108);
+});
+
+test('convert rounding example 3', () => {
+  // 3 EUR cents = 3.255 USD cents (rounds to 3)
+  const r = convert(3, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 3);
+});
+
+test('convert large amount', () => {
+  // 1000000 EUR = 1085000 USD
+  const r = convert(1000000, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 1085000);
+});
+
+// formatMoney tests
+test('formatMoney EUR shows € symbol', () => {
+  const r = formatMoney(12345, 'EUR');
+  assert.match(r, /€/);
+  assert.equal(r, '€123.45');
+});
+
+test('formatMoney USD shows $ symbol', () => {
+  const r = formatMoney(12345, 'USD');
+  assert.match(r, /\$/);
+  assert.equal(r, '$123.45');
+});
+
+test('formatMoney GBP shows £ symbol', () => {
+  const r = formatMoney(12345, 'GBP');
+  assert.match(r, /£/);
+  assert.equal(r, '£123.45');
+});
+
+test('formatMoney with thousands separator', () => {
+  const r = formatMoney(1234567, 'EUR');
+  assert.equal(r, '€12,345.67');
+});
+
+test('formatMoney with thousands separator USD', () => {
+  const r = formatMoney(1234567, 'USD');
+  assert.equal(r, '$12,345.67');
+});
+
+test('formatMoney with thousands separator GBP', () => {
+  const r = formatMoney(1234567, 'GBP');
+  assert.equal(r, '£12,345.67');
+});
+
+test('formatMoney zero cents', () => {
+  const r = formatMoney(0, 'EUR');
+  assert.equal(r, '€0.00');
+});
+
+test('formatMoney single cent', () => {
+  const r = formatMoney(1, 'EUR');
+  assert.equal(r, '€0.01');
+});
+
+test('formatMoney negative amount EUR', () => {
+  const r = formatMoney(-12345, 'EUR');
+  assert.equal(r, '-€123.45');
+});
+
+test('formatMoney negative amount USD', () => {
+  const r = formatMoney(-12345, 'USD');
+  assert.equal(r, '-$123.45');
+});
+
+test('formatMoney negative amount GBP', () => {
+  const r = formatMoney(-12345, 'GBP');
+  assert.equal(r, '-£123.45');
+});
+
+test('formatMoney unknown currency', () => {
+  const r = formatMoney(12345, 'JPY');
+  assert.equal(r, '?');
+});
+
+test('formatMoney with large amount', () => {
+  const r = formatMoney(123456789, 'EUR');
+  assert.equal(r, '€1,234,567.89');
+});
+
+test('convert then formatMoney EUR', () => {
+  const converted = convert(10000, 'EUR');
+  const formatted = formatMoney(converted.value, 'EUR');
+  assert.equal(formatted, '€100.00');
+});
+
+test('convert then formatMoney USD', () => {
+  const converted = convert(10000, 'USD');
+  const formatted = formatMoney(converted.value, 'USD');
+  assert.equal(formatted, '$108.50');
+});
+
+test('convert then formatMoney GBP', () => {
+  const converted = convert(10000, 'GBP');
+  const formatted = formatMoney(converted.value, 'GBP');
+  assert.equal(formatted, '£84.25');
+});
+
+test('formatMoney padding cents', () => {
+  const r = formatMoney(100, 'EUR');
+  assert.equal(r, '€1.00');
+});
+
+test('formatMoney padding single digit cents', () => {
+  const r = formatMoney(105, 'EUR');
+  assert.equal(r, '€1.05');
+});
+
+test('convert negative amount', () => {
+  const r = convert(-10000, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, -10850);
+});
+
+test('formatMoney consistent decimal places', () => {
+  const amounts = [1, 10, 99, 100, 1000, 10000, 123456];
+  amounts.forEach(cents => {
+    const formatted = formatMoney(cents, 'EUR');
+    assert.match(formatted, /\.\d{2}$/);
+  });
+});
