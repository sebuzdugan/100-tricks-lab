 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of that currency per euro.
+ * 1 EUR = 1.085 USD, 1 EUR = 0.8425 GBP.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +49,43 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert euro cents to another currency's cents.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  const rate = RATES[currency];
+  if (!rate) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  if (currency === 'EUR') {
+    return ok(cents);
+  }
+
+  const converted = roundCents(cents * rate);
+  return ok(converted);
+}
+
+/**
+ * Format cents in a currency for display: 123456 EUR -> "€1,234.56", 123456 USD -> "$1,234.56".
+ * @param {number} cents - Amount in that currency's cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const rate = RATES[currency];
+  if (!rate) {
+    return '?';
+  }
+
+  const currencySymbol = { EUR: '€', USD: '$', GBP: '£' }[currency] || '?';
+
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const whole = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${currencySymbol}${whole}.${String(abs % 100).padStart(2, '0')}`;
+}
