+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mergeCustomers } from '../src/customers.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('mergeCustomers merges invoices from one customer to another', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'info@acme.example', tier: 'gold' },
+    { id: 'C-002', name: 'Beta', email: 'info@beta.example', tier: 'standard' },
+  ];
+
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const r = mergeCustomers(customers, [issued1.value, issued2.value], 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  // Customer C-001 should be gone
+  assert.equal(r.value.customers.length, 1);
+  assert.equal(r.value.customers[0].id, 'C-002');
+  // Both invoices should now belong to C-002
+  assert.equal(r.value.invoices.length, 2);
+  assert.equal(r.value.invoices[0].customerId, 'C-002');
+  assert.equal(r.value.invoices[1].customerId, 'C-002');
+});
+
+test('mergeCustomers rejects same customer', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'info@acme.example', tier: 'gold' },
+  ];
+
+  const r = mergeCustomers(customers, [], 'C-001', 'C-001');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'SAME_CUSTOMER');
+});
+
+test('mergeCustomers rejects unknown from customer', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'info@acme.example', tier: 'gold' },
+    { id: 'C-002', name: 'Beta', email: 'info@beta.example', tier: 'standard' },
+  ];
+
+  const r = mergeCustomers(customers, [], 'C-999', 'C-002');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('mergeCustomers rejects unknown into customer', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'info@acme.example', tier: 'gold' },
+    { id: 'C-002', name: 'Beta', email: 'info@beta.example', tier: 'standard' },
+  ];
+
+  const r = mergeCustomers(customers, [], 'C-001', 'C-999');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('mergeCustomers handles normalized customer IDs', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'info@acme.example', tier: 'gold' },
+    { id: 'C-002', name: 'Beta', email: 'info@beta.example', tier: 'standard' },
