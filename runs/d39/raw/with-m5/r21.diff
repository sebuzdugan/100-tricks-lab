+test('mergeCustomers with draft invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'info@acme.example', tier: 'gold' },
+    { id: 'C-002', name: 'Beta', email: 'info@beta.example', tier: 'standard' },
