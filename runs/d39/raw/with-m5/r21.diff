+
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const partial = recordPayment(issued.value, { amount: 5000, date: '2026-10-10' });
+
+  const r = mergeCustomers(customers, [partial.value], 'C-001', 'C-002');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices[0].status, 'partially_paid');
+  assert.equal(r.value.invoices[0].customerId, 'C-002');
