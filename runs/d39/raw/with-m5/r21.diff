+    { id: 'C-001', name: 'Acme Corp', email: 'info@acme.example', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Beta Ltd', email: 'info@beta.example', country: 'UK', tier: 'standard' },
