@@ -0,0 +1,48 @@
+import { fail, ok } from './result.js';
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a line item (qty times unitPrice).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the invoice totals.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, voucher: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || typeof invoice !== 'object' || !Array.isArray(invoice.lines)) {
+    return fail('INVALID_INVOICE');
+  }
+
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
+    if (!line || typeof line !== 'object' || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number') {
+      return fail('INVALID_LINE');
+    }
+
+    const lineamt = lineTotal(line);
+    subtotal += lineamt;
+
+    const discountPercent = line.discountPercent ?? 0;
+    const lineDiscount = roundCents(lineamt * discountPercent / 100);
+    discount += lineDiscount;
+
+    const lineAmountAfterDiscount = lineamt - lineDiscount;
+    const vatRate = line.vatRate ?? 0;
+    const lineVAT = roundCents(lineAmountAfterDiscount * vatRate / 100);
+    vat += lineVAT;
+  }
+
+  const voucherAmount = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucherAmount);
+  return ok({ subtotal, discount, vat, voucher: voucherAmount, total });
+}
