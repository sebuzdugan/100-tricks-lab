+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+// lineTotal tests
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 5, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 42500);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { qty: 1, unitPrice: 1234 };
+  assert.equal(lineTotal(line), 1234);
+});
+
+test('lineTotal with large qty', () => {
+  const line = { qty: 100, unitPrice: 50000 };
+  assert.equal(lineTotal(line), 5000000);
+});
+
+test('lineTotal with zero unitPrice', () => {
+  const line = { qty: 10, unitPrice: 0 };
+  assert.equal(lineTotal(line), 0);
+});
+
+// invoiceTotals tests
+test('invoiceTotals calculates the sum of line totals', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 2500, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 11000);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 8500);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 1785);
+  assert.equal(r.value.voucher, 0);
+  assert.equal(r.value.total, 10285);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 10, vatRate: 21 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 8500);
+  assert.equal(r.value.discount, 850);
+  // VAT on (8500 - 850) = 7650 * 0.21 = 1606.5 -> 1606
+  assert.equal(r.value.vat, 1606);
+  assert.equal(r.value.total, 9256);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'PROMO', amount: 2000 },
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher, 2000);
+  assert.equal(r.value.total, 8285);
+});
+
+test('invoiceTotals clamps total at 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'PROMO', amount: 10000 },
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.total, 0);
+});
+
+test('invoiceTotals with multiple lines and different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 2500, discountPercent: 0, vatRate: 9 },
+    ],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 11000);
+  // VAT: 8500*0.21 = 1785, 2500*0.09 = 225
+  assert.equal(r.value.vat, 2010);
+  assert.equal(r.value.total, 13010);
+});
+
+test('invoiceTotals rejects invalid invoice (not object)', () => {
+  const r = invoiceTotals(null);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'INVALID_INVOICE');
+});
+
+test('invoiceTotals rejects invalid invoice (missing lines)', () => {
+  const r = invoiceTotals({});
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'INVALID_INVOICE');
+});
+
+test('invoiceTotals rejects invalid invoice (lines not array)', () => {
+  const r = invoiceTotals({ lines: 'not an array' });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'INVALID_INVOICE');
+});
+
+test('invoiceTotals rejects invalid line (not object)', () => {
+  const invoice = { lines: [null] };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'INVALID_LINE');
+});
+
+test('invoiceTotals rejects invalid line (missing qty)', () => {
+  const invoice = { lines: [{ unitPrice: 100, discountPercent: 0, vatRate: 0 }] };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'INVALID_LINE');
+});
+
+test('invoiceTotals rejects invalid line (missing unitPrice)', () => {
+  const invoice = { lines: [{ qty: 1, discountPercent: 0, vatRate: 0 }] };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'INVALID_LINE');
+});
+
+test('invoiceTotals with no discount percent specified', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.discount, 0);
+});
+
+test('invoiceTotals with no VAT rate specified', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.vat, 0);
+});
+
+test('invoiceTotals with no voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher, 0);
+});
+
+test('invoiceTotals uses lineTotal function', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 5000);
+});
+
+test('invoiceTotals with decimal discounts', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 12.5, vatRate: 21 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 8500 * 0.125 = 1062.5 -> 1062 (banker's rounding)
+  assert.equal(r.value.discount, 1062);
+});
+
+test('invoiceTotals with zero discount percent', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.discount, 0);
+});
+
+test('invoiceTotals with 100 percent discount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 100, vatRate: 21 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.discount, 8500);
+  assert.equal(r.value.vat, 0); // VAT on 0 base
+  assert.equal(r.value.total, 0);
+});
+
+test('invoiceTotals with zero VAT rate', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 0 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.vat, 0);
+});
+
+test('invoiceTotals round-trip: lineTotal consistency', () => {
+  const line = { qty: 3, unitPrice: 2500, discountPercent: 0, vatRate: 0 };
+  const lineTot = lineTotal(line);
+  const invoice = { lines: [line] };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, lineTot);
+});
+
+test('invoiceTotals with large numbers', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 100000, discountPercent: 5, vatRate: 21 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 10000000);
+  assert.equal(r.value.discount, 500000);
+  // VAT: (10000000 - 500000) * 0.21 = 1995000
+  assert.equal(r.value.vat, 1995000);
+});
