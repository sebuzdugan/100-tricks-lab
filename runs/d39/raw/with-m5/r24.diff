--- a/src/reports.js
+++ b/src/reports.js
@@ -99,3 +99,69 @@ export function lateFee(invoice, asOf) {
 
   return roundCents(fee);
 }
+
+/**
+ * Generate a dashboard summary of invoice metrics.
+ * @param {Array} invoices - All invoices to analyze
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ counts, outstanding, overdue, topCustomers }}
+ *   - counts: { draft, issued, partially_paid, paid } count of invoices per status
+ *   - outstanding: total amount still due on issued/partially_paid invoices
+ *   - overdue: { count, amount } from overdueInvoices
+ *   - topCustomers: top 3 customers by amount due, as [{ customerId, due }], highest first
+ */
+export function dashboard(invoices, asOf) {
+  const invoiceList = invoices || [];
+
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  invoiceList.forEach((inv) => {
+    if (counts[inv.status] !== undefined) {
+      counts[inv.status]++;
+    }
+  });
+
+  // Calculate outstanding (issued/partially_paid invoices)
+  let outstanding = 0;
+  invoiceList.forEach((inv) => {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const dueResult = balanceDue(inv);
+      if (dueResult.ok) {
+        outstanding += dueResult.value;
+      }
+    }
+  });
+
+  // Get overdue metrics
+  const overdueList = overdueInvoices(invoiceList, asOf);
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, item) => sum + item.due, 0),
+  };
+
+  // Calculate topCustomers: aggregate due by customerId
+  const customerDue = {};
+  invoiceList.forEach((inv) => {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const dueResult = balanceDue(inv);
+      if (dueResult.ok) {
+        const customerId = inv.customerId;
+        customerDue[customerId] = (customerDue[customerId] || 0) + dueResult.value;
+      }
+    }
+  });
+
+  // Convert to array and sort by due descending, take top 3
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return { counts, outstanding, overdue, topCustomers };
+}
