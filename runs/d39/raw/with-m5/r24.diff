+test('dashboard with mix of all statuses and overdue', () => {
+  // draft
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+
+  // issued and overdue
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice2.value, []);
+
+  // partially_paid
+  const invoice3 = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 0 }],
+  });
+  const issued3 = issueInvoice(invoice3.value, ['INV-2026-0001']);
+  const partial = recordPayment(issued3.value, { amount: 10000, date: '2026-10-10' });
+
+  // paid
+  const invoice4 = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  const issued4 = issueInvoice(invoice4.value, ['INV-2026-0001', 'INV-2026-0002']);
+  const paid = recordPayment(issued4.value, { amount: 10285, date: '2026-10-10' });
+
+  // asOf is 2026-10-30 (inv2 is overdue on 2026-10-15)
+  const r = dashboard([draft.value, issued.value, partial.value, paid.value], '2026-10-30');
+
+  assert.equal(r.counts.draft, 1);
+  assert.equal(r.counts.issued, 1);
+  assert.equal(r.counts.partially_paid, 1);
+  assert.equal(r.counts.paid, 1);
+  // outstanding: issued (10285) + partially_paid (20570 - 10000 = 10570) = 20855
+  assert.equal(r.outstanding, 20855);
+  // overdue: just inv2 (10285)
+  assert.equal(r.overdue.count, 1);
+  assert.equal(r.overdue.amount, 10285);
+  // topCustomers: C-004 (10570), C-003 (10285)
+  assert.equal(r.topCustomers.length, 2);
+  assert.equal(r.topCustomers[0].customerId, 'C-004');
+  assert.equal(r.topCustomers[0].due, 10570);
+});
