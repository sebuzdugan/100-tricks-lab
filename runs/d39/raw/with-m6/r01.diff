+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice returns a draft invoice with line details from the catalogue', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.customerId, 'C-001');
+  assert.equal(invoice.issueDate, '2025-10-15');
+  assert.equal(invoice.status, 'draft');
+  assert.equal(invoice.lines.length, 1);
+  assert.equal(invoice.lines[0].sku, 'DES-HOUR');
+  assert.equal(invoice.lines[0].name, 'Design work (hour)');
+  assert.equal(invoice.lines[0].qty, 5);
+  assert.equal(invoice.lines[0].unitPrice, 8500);
+  assert.equal(invoice.lines[0].vatRate, 21);
+});
+
+test('createInvoice handles multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-12-25',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.lines.length, 3);
+  assert.equal(invoice.lines[0].name, 'Design work (hour)');
+  assert.equal(invoice.lines[1].name, 'Development (hour)');
+  assert.equal(invoice.lines[2].name, 'Sticker sheet');
+});
+
+test('createInvoice rejects an unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects an invalid date format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025/10/15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects a non-existent date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects a missing date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice rejects an empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects a non-array lines parameter', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: null,
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects a zero quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects a negative quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects a fractional quantity', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice rejects an unknown SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'NOPE-SKU', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate the input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const linesCopy = JSON.stringify(lines);
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines,
+  });
+  assert.equal(JSON.stringify(lines), linesCopy);
+});
