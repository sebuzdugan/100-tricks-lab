+/**
+ * Get the next available invoice number for a given year.
+ * Format: INV-<year>-<4-digit counter>
+ * Counter resets every year starting at 0001.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (any order)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} The next invoice number
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `INV-${year}-`;
+
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counterStr = num.slice(prefix.length);
+      return parseInt(counterStr, 10);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
