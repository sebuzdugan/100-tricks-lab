+++ b/test/numbering.test.js
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2025-10-15');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber resets counter each year', () => {
+  const existing = ['INV-2024-9999', 'INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = ['INV-2025-0009'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0010');
+});
+
+test('nextInvoiceNumber works with unsorted input', () => {
+  const existing = ['INV-2025-0003', 'INV-2025-0001', 'INV-2025-0005', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber handles large numbers', () => {
+  const existing = ['INV-2025-9998', 'INV-2025-9999'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-10000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2025-XXXX', 'INV-NOPE-0001', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0002');
+});
