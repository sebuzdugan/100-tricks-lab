+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for an unnumbered invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows the invoice number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2025-0001');
+});
+
+test('renderInvoiceText shows the customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows a single line item', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // Line should be: qty x name at €unit_price = €total
+  assert.equal(lines[2], '5 x Design work (hour) at €85.00 = €425.00');
+});
+
+test('renderInvoiceText shows multiple line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[2], '2 x Design work (hour) at €85.00 = €170.00');
+  assert.equal(lines[3], '10 x Development (hour) at €95.00 = €950.00');
+  assert.equal(lines[4], '100 x Sticker sheet at €0.50 = €50.00');
+});
+
+test('renderInvoiceText shows the correct total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 10 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // Total should be: 2*8500 + 10*9500 = 17000 + 95000 = 112000 cents = €1120.00
+  assert.equal(lines[lines.length - 1], 'Total: €1,120.00');
+});
+
+test('renderInvoiceText formats numbers with thousands separator', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'BRAND-BOOK', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // LOGO-PACK: 120000 cents = €1,200.00
+  // BRAND-BOOK: 245000 cents = €2,450.00
+  // Total: 365000 cents = €3,650.00
+  assert.equal(lines[2], '1 x Logo package at €1,200.00 = €1,200.00');
+  assert.equal(lines[3], '1 x Brand guidelines document at €2,450.00 = €2,450.00');
+  assert.equal(lines[lines.length - 1], 'Total: €3,650.00');
+});
+
+test('renderInvoiceText handles different customers', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text1 = renderInvoiceText(invoice1);
+  const text2 = renderInvoiceText(invoice2);
+
+  assert.equal(text1.split('\n')[1], 'Northwind Studio');
+  assert.equal(text2.split('\n')[1], 'Kite & Co');
+});
+
+test('renderInvoiceText shows correct structure with multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-005',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Should have: invoice number, customer, 2 line items, total = 5 lines
+  assert.equal(lines.length, 5);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Orchard Health');
+  assert.ok(lines[2].includes('Design work'));
+  assert.ok(lines[3].includes('Development'));
+  assert.ok(lines[4].includes('Total:'));
+});
+
+test('renderInvoiceText works with issued invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, ['INV-2025-0001', 'INV-2025-0002']).value;
+  const text = renderInvoiceText(issued);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2025-0003');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[lines.length - 1], 'Total: €425.00');
+});
