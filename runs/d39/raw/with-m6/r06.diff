+/**
+ * Validate and normalize a discount percentage.
+ * @param {unknown} discountPercent
+ * @returns {{ ok: true } | { ok: false, error: string }}
+ */
+function validateDiscount(discountPercent) {
+  if (discountPercent === undefined || discountPercent === null) return { ok: true };
+  if (typeof discountPercent !== 'number' || discountPercent < 0 || discountPercent > 100) {
+    return { ok: false, error: 'DISCOUNT_INVALID' };
+  }
+  return { ok: true };
+}
+
+/**
+ * Calculate the discount amount for a line (in cents, rounded).
+ * @param {number} lineTotal - Total before discount (in cents)
+ * @param {number} discountPercent - Discount percentage (0-100)
+ * @returns {number} Discount amount in cents
+ */
+function calculateLineDiscount(lineTotal, discountPercent) {
+  if (!discountPercent) return 0;
+  return roundCents((lineTotal * discountPercent) / 100);
+}
