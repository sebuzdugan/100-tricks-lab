+
+test('createInvoice mixes tier and explicit discounts', () => {
+  // C-001 is gold (5%)
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 }, // No explicit, uses tier (5%)
+      { sku: 'DEV-HOUR', qty: 1, discountPercent: 0 }, // Explicit 0%
+      { sku: 'STICKER', qty: 1, discountPercent: 10 }, // Explicit 10%
+    ],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.lines[0].discountPercent, 5);
+  assert.equal(invoice.lines[1].discountPercent, 0);
+  assert.equal(invoice.lines[2].discountPercent, 10);
+});
+
+test('invoiceTotals correctly calculates with tier discount', () => {
+  // C-001 is gold (5%)
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 20 }],
+  });
+  // Line total: 20 * 8500 = 170000 cents
+  // Discount (5%): 170000 * 5 / 100 = 8500 cents
+  // Total: 170000 - 8500 = 161500 cents
+
+  const invoice = r.value;
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 170000);
+  assert.equal(totals.discount, 8500);
+  assert.equal(totals.total, 161500);
+});
