+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.lines[0].discountPercent, 10);
+});
+
+test('createInvoice uses explicit discount lower than tier discount', () => {
+  // C-001 is gold (5%), but line has explicit 2%
+  const r = createInvoice({
+    customerId: 'C-001',
