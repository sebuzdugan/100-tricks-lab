+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 2 }],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.lines[0].discountPercent, 2);
+});
+
+test('createInvoice applies tier discounts to multiple lines', () => {
+  // C-001 is gold (5%)
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.lines[0].discountPercent, 5);
+  assert.equal(invoice.lines[1].discountPercent, 5);
