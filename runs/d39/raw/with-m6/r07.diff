+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  const invoice = r.value;
+  assert.equal(invoice.lines[0].discountPercent, 0);
+});
+
+test('createInvoice uses explicit discount higher than tier discount', () => {
