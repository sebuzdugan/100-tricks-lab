@@ -0,0 +1,124 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-10-15'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('2025/10/15'), false);
+  assert.equal(isValidDate('10-15-2025'), false);
+  assert.equal(isValidDate('2025-10-15T00:00:00'), false);
+  assert.equal(isValidDate('2025-10-15 '), false);
+  assert.equal(isValidDate(' 2025-10-15'), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-04-31'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects leap year dates on non-leap years', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate(20251015), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-10-15', 1), '2025-10-16');
+  assert.equal(addDays('2025-10-15', 5), '2025-10-20');
+  assert.equal(addDays('2025-10-15', 10), '2025-10-25');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2025-10-15', -1), '2025-10-14');
+  assert.equal(addDays('2025-10-15', -5), '2025-10-10');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-10-31', 1), '2025-11-01');
+  assert.equal(addDays('2025-11-01', -1), '2025-10-31');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2025-10-15', 0), '2025-10-15');
+});
+
+test('addDays throws on invalid date format', () => {
+  assert.throws(() => addDays('2025/10/15', 1));
+  assert.throws(() => addDays('invalid', 1));
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2025-10-15', '2025-10-16'), 1);
+  assert.equal(daysBetween('2025-10-15', '2025-10-20'), 5);
+  assert.equal(daysBetween('2025-10-15', '2025-10-25'), 10);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2025-10-20', '2025-10-15'), -5);
+  assert.equal(daysBetween('2025-10-25', '2025-10-15'), -10);
+});
+
+test('daysBetween handles same date', () => {
+  assert.equal(daysBetween('2025-10-15', '2025-10-15'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2025-10-31', '2025-11-01'), 1);
+  assert.equal(daysBetween('2025-11-01', '2025-10-31'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2024-12-31'), -1);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('daysBetween handles large differences', () => {
+  assert.equal(daysBetween('2025-01-01', '2025-12-31'), 364);
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+});
+
+test('daysBetween throws on invalid date format', () => {
+  assert.throws(() => daysBetween('2025/10/15', '2025-10-16'));
+  assert.throws(() => daysBetween('2025-10-15', '2025/10/16'));
+  assert.throws(() => daysBetween('invalid', '2025-10-15'));
+});
+
+test('isValidDate and addDays work together', () => {
+  const date = '2025-10-15';
+  assert.equal(isValidDate(date), true);
+  const newDate = addDays(date, 5);
+  assert.equal(isValidDate(newDate), true);
+  assert.equal(daysBetween(date, newDate), 5);
+});
