+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ total?: number, payments?: Array }} invoice
+ * @returns {number} Amount due in cents (>= 0)
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments || []).reduce((sum, payment) => sum + payment.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
+
+/**
+ * Record a payment against an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, payments?: Array }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: invoice } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate invoice is issued or partially paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check for overpayment
+  const due = balanceDue(invoice);
+  if (amount > due) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new invoice with payment added
+  const newPayments = [...(invoice.payments || [])];
+  newPayments.push({ amount, date });
+
+  // Determine new status
+  const newBalance = due - amount;
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    customerId: invoice.customerId,
+    number: invoice.number,
+    issueDate: invoice.issueDate,
+    status: newStatus,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    payments: newPayments,
+  });
+}
