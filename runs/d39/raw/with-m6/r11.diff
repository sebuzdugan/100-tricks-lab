+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('balanceDue returns total when no payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const due = balanceDue(invoice);
+  assert.ok(due > 0);
+});
+
+test('balanceDue returns zero when no balance', () => {
+  const invoice = {
+    customerId: 'C-001',
+    number: 'INV-2025-0001',
+    issueDate: '2025-10-15',
+    status: 'paid',
+    lines: [
+      {
+        sku: 'STICKER',
+        name: 'Sticker sheet',
+        qty: 1,
+        unitPrice: 50,
+        vatRate: 21,
+        discountPercent: 0,
+      },
+    ],
+    payments: [{ amount: 1000, date: '2025-10-20' }],
+  };
+
+  const due = balanceDue(invoice);
+  assert.equal(due, 0);
+});
+
+test('recordPayment adds payment to issued invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+  // STICKER: 50 cents base, gold tier 5% discount = 47.5 -> 48 cents
+  // VAT 21% = 10 cents
+  // Total: 58 cents
+
+  const invoice = issueInvoice(draft, []).value;
+  const r = recordPayment(invoice, { amount: 58, date: '2025-10-20' });
+
+  assert.equal(r.ok, true);
+  const updated = r.value;
+  assert.equal(updated.status, 'paid');
+  assert.equal(updated.payments.length, 1);
+  assert.equal(updated.payments[0].amount, 58);
+  assert.equal(updated.payments[0].date, '2025-10-20');
+});
+
+test('recordPayment marks invoice as partially_paid', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  // Total with VAT: around 102850 cents
+
+  const invoice = issueInvoice(draft, []).value;
+  const r = recordPayment(invoice, { amount: 50000, date: '2025-10-20' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment adds multiple payments', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  const total = balanceDue(invoice);
+
+  const r1 = recordPayment(invoice, { amount: Math.floor(total / 2), date: '2025-10-20' });
+  assert.equal(r1.ok, true);
+  invoice = r1.value;
+
+  const r2 = recordPayment(invoice, { amount: balanceDue(invoice), date: '2025-10-25' });
+  assert.equal(r2.ok, true);
+  invoice = r2.value;
+
+  assert.equal(invoice.status, 'paid');
+  assert.equal(invoice.payments.length, 2);
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const r = recordPayment(invoice, { amount: 50, date: '2025-10-20' });
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects zero amount', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  const r = recordPayment(invoice, { amount: 0, date: '2025-10-20' });
+
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects negative amount', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  const r = recordPayment(invoice, { amount: -50, date: '2025-10-20' });
+
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects fractional amount', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  const r = recordPayment(invoice, { amount: 50.5, date: '2025-10-20' });
+
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  const due = balanceDue(invoice);
+  const r = recordPayment(invoice, { amount: due + 1, date: '2025-10-20' });
+
+  assert.deepEqual(r, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment works on partially_paid invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  const total = balanceDue(invoice);
+
+  const r1 = recordPayment(invoice, { amount: Math.floor(total / 2), date: '2025-10-20' });
+  invoice = r1.value;
+
+  assert.equal(invoice.status, 'partially_paid');
+
+  const r2 = recordPayment(invoice, { amount: 1, date: '2025-10-25' });
+  assert.equal(r2.ok, true);
+});
+
+test('recordPayment rejects payment on paid invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  const due = balanceDue(invoice);
+
+  const r1 = recordPayment(invoice, { amount: due, date: '2025-10-20' });
+  invoice = r1.value;
+
+  assert.equal(invoice.status, 'paid');
+
+  const r2 = recordPayment(invoice, { amount: 1, date: '2025-10-25' });
+  assert.deepEqual(r2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  const invoiceCopy = JSON.stringify(invoice);
+
+  recordPayment(invoice, { amount: 50, date: '2025-10-20' });
+
+  assert.equal(JSON.stringify(invoice), invoiceCopy);
+});
+
+test('balanceDue decreases with payments', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  const initialDue = balanceDue(invoice);
+
+  const r = recordPayment(invoice, { amount: 50000, date: '2025-10-20' });
+  const newDue = balanceDue(r.value);
+
+  assert.equal(newDue, initialDue - 50000);
+});
