+/**
+ * Calculate due date based on payment terms.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - Payment terms: 'NET14', 'NET30', or 'EOM'
+ * @returns {string} Due date in YYYY-MM-DD format
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    // Parse the issue date
+    const [yearStr, monthStr] = issueDate.split('-');
+    const year = parseInt(yearStr, 10);
+    const month = parseInt(monthStr, 10);
+
+    // Calculate last day of the month
+    const nextMonth = month === 12 ? 1 : month + 1;
+    const nextYear = month === 12 ? year + 1 : year;
+    const lastDay = new Date(Date.UTC(nextYear, nextMonth - 1, 0));
+    const day = lastDay.getUTCDate();
+
+    const dayStr = String(day).padStart(2, '0');
+    return `${yearStr}-${monthStr}-${dayStr}`;
+  }
+
+  return null;
+}
