+      },
+    ],
+    voucher: { code: 'PROMO10', amount: 5 },
+  };
+  // Subtotal: 50 cents
+  // Discount: 0
+  // VAT (21%): 50 * 21 / 100 = 10.5, rounded to 10 (banker's rounding)
+  // Voucher: 5 cents
+  // Total: 50 - 0 + 10 - 5 = 55 cents
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 50);
+  assert.equal(totals.vat, 10);
+  assert.equal(totals.voucher, 5);
+  assert.equal(totals.total, 55);
