+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns empty list for customer with no invoices', () => {
+  const invoices = [];
+  const r = statement('C-001', invoices, '2025-12-31');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes issued invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(draft, []).value;
+  const invoices = [issued];
+
+  const r = statement('C-001', invoices, '2025-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2025-0001');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  let issued = issueInvoice(draft, []).value;
+  const due = 102850; // Approximate total
+  const r1 = recordPayment(issued, { amount: 50000, date: '2025-10-20' });
+  const partiallyPaid = r1.value;
+
+  const invoices = [partiallyPaid];
+
+  const r = statement('C-001', invoices, '2025-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2025-0001');
+});
+
+test('statement excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const invoices = [draft];
+
+  const r = statement('C-001', invoices, '2025-10-15');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement excludes paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
