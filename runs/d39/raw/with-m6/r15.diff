+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('nextCreditNoteNumber starts at 0001 for a new year', () => {
+  const number = nextCreditNoteNumber([], '2025-10-15');
+  assert.equal(number, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber increments the counter', () => {
+  const existing = ['CN-2025-0001', 'CN-2025-0002'];
+  const number = nextCreditNoteNumber(existing, '2025-10-15');
+  assert.equal(number, 'CN-2025-0003');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001'];
+  const number = nextCreditNoteNumber(existing, '2025-10-15');
+  assert.equal(number, 'CN-2025-0002');
+});
+
+test('nextCreditNoteNumber resets counter each year', () => {
+  const existing = ['CN-2024-9999', 'CN-2025-0001', 'CN-2025-0002'];
+  const number = nextCreditNoteNumber(existing, '2026-01-01');
+  assert.equal(number, 'CN-2026-0001');
+});
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const r = createCreditNote(
+    invoice,
+    { amount: 50000, reason: 'Partial refund', date: '2025-10-20' },
+    ['INV-2025-0001']
+  );
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2025-0001');
+  assert.equal(r.value.invoiceNumber, 'INV-2025-0001');
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 50000);
+  assert.equal(r.value.reason, 'Partial refund');
+  assert.equal(r.value.date, '2025-10-20');
+});
+
+test('createCreditNote works for partially_paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  assert.equal(invoice.status, 'issued');
+
+  const r = createCreditNote(
+    invoice,
+    { amount: 10000, reason: 'Quality issue', date: '2025-10-20' },
+    ['INV-2025-0001']
+  );
+
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote works for paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  assert.equal(invoice.status, 'issued');
+
+  const r = createCreditNote(
+    invoice,
+    { amount: 2000, reason: 'Customer request', date: '2025-10-20' },
+    ['INV-2025-0001']
+  );
+
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const r = createCreditNote(
+    draft,
+    { amount: 2000, reason: 'Bad reason', date: '2025-10-20' },
+    ['INV-2025-0001']
+  );
+
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const r = createCreditNote(invoice, { amount: 0, reason: 'Bad', date: '2025-10-20' }, [
+    'INV-2025-0001',
+  ]);
+
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const r = createCreditNote(invoice, { amount: -1000, reason: 'Bad', date: '2025-10-20' }, [
+    'INV-2025-0001',
+  ]);
+
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects fractional amount', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const r = createCreditNote(invoice, { amount: 1000.5, reason: 'Bad', date: '2025-10-20' }, [
+    'INV-2025-0001',
+  ]);
+
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects credit amount exceeding invoice total', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  // Total is around 50-60 cents with VAT
+
+  const r = createCreditNote(
+    invoice,
+    { amount: 10000, reason: 'Too much', date: '2025-10-20' },
+    ['INV-2025-0001']
+  );
+
+  assert.deepEqual(r, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  const total = 58; // Approximately 50 + VAT
+
+  const r = createCreditNote(invoice, { amount: total, reason: 'Full refund', date: '2025-10-20' }, [
+    'INV-2025-0001',
+  ]);
+
+  assert.equal(r.ok, true);
+});
+
+test('createCreditNote numbers increment separately from invoices', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-20',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const inv1 = issueInvoice(draft1, []).value;
+  const inv2 = issueInvoice(draft2, ['INV-2025-0001']).value;
+
+  // Create credit notes
+  const r1 = createCreditNote(inv1, { amount: 2000, reason: 'Refund', date: '2025-10-20' }, [
+    'INV-2025-0001',
+    'INV-2025-0002',
+  ]);
+
+  const r2 = createCreditNote(
+    inv2,
+    { amount: 2000, reason: 'Refund', date: '2025-10-21' },
+    ['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001']
+  );
+
+  assert.equal(r1.value.number, 'CN-2025-0001');
+  assert.equal(r2.value.number, 'CN-2025-0002');
+});
