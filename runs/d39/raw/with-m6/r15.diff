+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next available credit note number for a given year.
+ * Format: CN-<year>-<4-digit counter>
+ * Counter resets every year starting at 0001.
+ * @param {string[]} existingNumbers - Array of all invoice and credit note numbers
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string} The next credit note number
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.slice(0, 4);
+  const prefix = `CN-${year}-`;
+
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counterStr = num.slice(prefix.length);
+      return parseInt(counterStr, 10);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ number: string, customerId: string, status: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditData
+ * @param {string[]} existingNumbers - Array of all existing invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice is issued (not draft)
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate amount does not exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
