+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Get a list of overdue invoices.
+ * @param {Array} invoices - All invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {Array} Overdue invoices sorted by daysOverdue (most overdue first)
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter(
+      (inv) =>
+        inv &&
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.dueDate &&
+        inv.dueDate < asOf
+    )
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
