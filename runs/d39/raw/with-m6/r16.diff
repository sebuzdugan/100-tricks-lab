+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty array when no invoices are overdue', () => {
+  const invoices = [];
+  const result = overdueInvoices(invoices, '2025-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes invoices with dueDate before asOf', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  // dueDate: 2025-10-15, asOf: 2025-10-20 (5 days overdue)
+
+  const invoices = [invoice];
+  const result = overdueInvoices(invoices, '2025-10-20');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2025-0001');
+  assert.equal(result[0].daysOverdue, 5);
+});
+
+test('overdueInvoices excludes invoices with dueDate equal to asOf', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  // dueDate: 2025-10-15, asOf: 2025-10-15 (not overdue)
+
+  const invoices = [invoice];
+  const result = overdueInvoices(invoices, '2025-10-15');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes invoices with dueDate after asOf', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  // dueDate: 2025-10-15, asOf: 2025-10-10 (not yet due)
+
+  const invoices = [invoice];
+  const result = overdueInvoices(invoices, '2025-10-10');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const invoices = [draft];
+  const result = overdueInvoices(invoices, '2025-10-20');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  const due = 5850;
+  const r = recordPayment(invoice, { amount: due, date: '2025-10-20' });
+  const paid = r.value;
+
+  const invoices = [paid];
+  const result = overdueInvoices(invoices, '2025-10-20');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  const r = recordPayment(invoice, { amount: 50000, date: '2025-10-20' });
+  const partial = r.value;
+
+  const invoices = [partial];
+  const result = overdueInvoices(invoices, '2025-10-20');
+
+  assert.equal(result.length, 1);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+  // dueDate: 2025-10-15
+
+  const invoices = [invoice];
+  const result = overdueInvoices(invoices, '2025-10-22');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 7);
+});
+
+test('overdueInvoices sorts by daysOverdue most overdue first', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-10',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const draft3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const inv1 = issueInvoice(draft1, []).value;
+  const inv2 = issueInvoice(draft2, ['INV-2025-0001']).value;
+  const inv3 = issueInvoice(draft3, ['INV-2025-0001', 'INV-2025-0002']).value;
+
+  // dueDate for inv1: 2025-10-15 (7 days overdue on 2025-10-22)
+  // dueDate for inv2: 2025-10-24 (not overdue on 2025-10-22)
+  // dueDate for inv3: 2025-10-19 (3 days overdue on 2025-10-22)
+
+  const invoices = [inv1, inv2, inv3];
+  const result = overdueInvoices(invoices, '2025-10-22');
+
+  assert.equal(result.length, 2);
+  assert.equal(result[0].daysOverdue, 7); // inv1, most overdue
+  assert.equal(result[1].daysOverdue, 3); // inv3, less overdue
+});
+
+test('overdueInvoices includes due amount from balanceDue', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  const r = recordPayment(invoice, { amount: 2000, date: '2025-10-20' });
+  const partial = r.value;
+
+  const invoices = [partial];
+  const result = overdueInvoices(invoices, '2025-10-20');
+
+  assert.equal(result.length, 1);
+  assert.ok(result[0].due > 0);
+  assert.ok(result[0].due < 5850); // Less than full amount due to payment
+});
+
+test('overdueInvoices includes all relevant fields', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const invoices = [invoice];
+  const result = overdueInvoices(invoices, '2025-10-20');
+
+  assert.equal(result.length, 1);
+  const inv = result[0];
+  assert.ok(inv.number);
+  assert.ok(inv.customerId);
+  assert.ok(inv.dueDate);
+  assert.ok(typeof inv.daysOverdue === 'number');
+  assert.ok(typeof inv.due === 'number');
+});
+
+test('overdueInvoices handles multiple customers', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const inv1 = issueInvoice(draft1, []).value;
+  const inv2 = issueInvoice(draft2, ['INV-2025-0001']).value;
+
+  const invoices = [inv1, inv2];
+  const result = overdueInvoices(invoices, '2025-10-20');
+
+  assert.equal(result.length, 2);
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[1].customerId, 'C-002');
+});
