+/**
+ * Get a VAT summary across invoices.
+ * @param {Array} invoices - All invoices
+ * @returns {Array} VAT summary by rate: [{ rate, base, vat }], sorted by rate high to low
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  // Collect VAT data from each invoice
+  for (const inv of invoices) {
+    if (!inv || !['issued', 'partially_paid', 'paid'].includes(inv.status) || !inv.lines) {
+      continue;
+    }
+
+    for (const line of inv.lines) {
+      const lineTotal = line.qty * line.unitPrice;
+      const discount = roundCents((lineTotal * (line.discountPercent || 0)) / 100);
+      const base = lineTotal - discount;
+      const vat = roundCents((base * (line.vatRate || 0)) / 100);
+      const rate = line.vatRate || 0;
+
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { rate, base: 0, vat: 0 });
+      }
+
+      const entry = vatMap.get(rate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  // Convert to array and sort by rate descending
+  return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
+}
