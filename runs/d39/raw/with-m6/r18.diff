   // Convert to array and sort by rate descending
   return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fee for an invoice.
+ * 0.04% of the amount due for every day overdue.
+ * @param {Object} invoice - Invoice object
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (!invoice || !['issued', 'partially_paid'].includes(invoice.status) || !invoice.dueDate) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  const amountDue = balanceDue(invoice);
+  const fee = roundCents((amountDue * 0.04 * daysOverdue) / 100);
+  return Math.max(0, fee);
+}
