+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv with empty invoices array', () => {
+  const result = exportCsv([]);
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines.length, 2); // Header + empty line
+});
+
+test('exportCsv with single draft invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const result = exportCsv([draft]);
+  const lines = result.split('\n');
+
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.ok(lines[1].startsWith('DRAFT,Northwind Studio,2025-10-01,2025-10-31,draft'));
+  assert.ok(lines[1].includes('50.00')); // subtotal
+  assert.ok(lines[1].includes('2.50')); // discount (5% tier for gold)
+});
+
+test('exportCsv with issued invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+    terms: 'NET14',
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+
+  assert.ok(lines[1].startsWith('INV-2025-0001,Northwind Studio,2025-10-01,2025-10-15,issued'));
+});
+
+test('exportCsv includes due amount', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  assert.equal(fields[9], '57.48'); // due amount
+});
+
+test('exportCsv calculates due correctly after payment', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  const r = recordPayment(invoice, { amount: 2000, date: '2025-10-20' });
+  const partial = r.value;
+
+  const result = exportCsv([partial]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  assert.ok(parseFloat(fields[9]) < 57.48); // due is less after payment
+});
+
+test('exportCsv with multiple invoices', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  }).value;
+
+  const inv1 = issueInvoice(draft1, []).value;
+  const inv2 = issueInvoice(draft2, ['INV-2025-0001']).value;
+
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 4); // header + 2 invoices + trailing newline
+  assert.ok(lines[1].includes('INV-2025-0001'));
+  assert.ok(lines[2].includes('INV-2025-0002'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[2].includes('Blue Fern Bakery'));
+});
+
+test('exportCsv escapes customer names with commas', () => {
+  const draft = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+
+  // C-003 is "Kite & Co" - has & but no comma, check format is correct
+  assert.ok(lines[1].includes('Kite & Co'));
+});
+
+test('exportCsv escapes fields with double quotes', () => {
+  // Create an invoice and check escaping is applied
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = exportCsv([invoice]);
+  // Just verify the CSV is valid and can be parsed
+  const lines = result.split('\n');
+  assert.ok(lines.length >= 2);
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+
+  // Check that amounts have exactly 2 decimals
+  assert.ok(lines[1].includes('.00') || lines[1].includes('.50') || lines[1].includes('.48'));
+});
+
+test('exportCsv uses dot as decimal separator', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = exportCsv([invoice]);
+  // Should use dots, not commas
+  assert.ok(!result.includes('50,00'));
+  assert.ok(result.includes('50.00'));
+});
+
+test('exportCsv ends lines with newline', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = exportCsv([invoice]);
+  assert.ok(result.endsWith('\n'));
+});
+
+test('exportCsv shows DRAFT for unnumbered invoice', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const result = exportCsv([draft]);
+  const lines = result.split('\n');
+
+  assert.ok(lines[1].startsWith('DRAFT,'));
+});
+
+test('exportCsv includes dueDate for draft invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const result = exportCsv([draft]);
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+
+  // dueDate is the 4th field (index 3)
+  // Draft with default NET30 term has dueDate set to EOM (2025-10-31)
+  assert.equal(fields[3], '2025-10-31');
+});
+
+test('exportCsv with different statuses', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  let invoice = issueInvoice(draft, []).value;
+  const r = recordPayment(invoice, { amount: 5748, date: '2025-10-20' });
+  const paid = r.value;
+
+  const invoices = [draft, invoice, paid];
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+
+  assert.ok(lines[1].includes('draft'));
+  assert.ok(lines[2].includes('issued'));
+  assert.ok(lines[3].includes('paid'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const draft1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const draft2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-05',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  }).value;
+
+  const inv1 = issueInvoice(draft1, []).value;
+  const inv2 = issueInvoice(draft2, ['INV-2025-0001']).value;
+
+  const result = exportCsv([inv2, inv1]); // Reverse order
+  const lines = result.split('\n');
+
+  assert.ok(lines[1].includes('INV-2025-0002'));
+  assert.ok(lines[2].includes('INV-2025-0001'));
+});
+
+test('exportCsv handles large amounts correctly', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 100 }],
+  }).value;
+
+  const invoice = issueInvoice(draft, []).value;
+
+  const result = exportCsv([invoice]);
+  const lines = result.split('\n');
+
+  // Should have no thousands separator
+  assert.ok(!lines[1].includes('1,000'));
+  // Should have proper decimal formatting
+  assert.ok(/\d+\.\d{2}/.test(lines[1]));
+});
