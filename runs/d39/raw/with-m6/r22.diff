@@ -0,0 +1,228 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  lineTotal,
+  calculateLineDiscount,
+  lineAmountAfterDiscount,
+  calculateLineVat,
+  invoiceTotals,
+} from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { sku: 'STICKER', name: 'Sticker sheet', qty: 100, unitPrice: 50, vatRate: 21 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { sku: 'STICKER', name: 'Sticker sheet', qty: 1, unitPrice: 50, vatRate: 21 };
+  assert.equal(lineTotal(line), 50);
+});
+
+test('lineTotal with large qty', () => {
+  const line = { sku: 'STICKER', name: 'Sticker sheet', qty: 10000, unitPrice: 50, vatRate: 21 };
+  assert.equal(lineTotal(line), 500000);
+});
+
+test('calculateLineDiscount with no discount', () => {
+  assert.equal(calculateLineDiscount(5000, 0), 0);
+  assert.equal(calculateLineDiscount(5000, undefined), 0);
+  assert.equal(calculateLineDiscount(5000, null), 0);
+});
+
+test('calculateLineDiscount with percentage', () => {
+  assert.equal(calculateLineDiscount(5000, 10), 500);
+  assert.equal(calculateLineDiscount(5000, 5), 250);
+});
+
+test('calculateLineDiscount with decimal percentage', () => {
+  assert.equal(calculateLineDiscount(5000, 2.5), 125);
+  assert.equal(calculateLineDiscount(5000, 0.5), 25);
+});
+
+test('calculateLineDiscount with rounding', () => {
+  // 10000 * 33% = 3300, exactly
+  assert.equal(calculateLineDiscount(10000, 33), 3300);
+  // 10001 * 33% = 3300.33 -> 3300 (banker's rounding)
+  assert.equal(calculateLineDiscount(10001, 33), 3300);
+});
+
+test('lineAmountAfterDiscount calculates correctly', () => {
+  assert.equal(lineAmountAfterDiscount(5000, 10), 4500);
+  assert.equal(lineAmountAfterDiscount(5000, 0), 5000);
+  assert.equal(lineAmountAfterDiscount(5000, 5), 4750);
+});
+
+test('calculateLineVat with 0% rate', () => {
+  assert.equal(calculateLineVat(5000, 0), 0);
+  assert.equal(calculateLineVat(5000, undefined), 0);
+  assert.equal(calculateLineVat(5000, null), 0);
+});
+
+test('calculateLineVat with 9% rate', () => {
+  // 5000 * 9 / 100 = 450
+  assert.equal(calculateLineVat(5000, 9), 450);
+});
+
+test('calculateLineVat with 21% rate', () => {
+  // 5000 * 21 / 100 = 1050
+  assert.equal(calculateLineVat(5000, 21), 1050);
+});
+
+test('calculateLineVat with rounding', () => {
+  // 4750 * 21 / 100 = 997.5 -> 998 (banker's rounding)
+  assert.equal(calculateLineVat(4750, 21), 998);
+  // 9025 * 21 / 100 = 1895.25 -> 1895 (banker's rounding, half to even)
+  assert.equal(calculateLineVat(9025, 21), 1895);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { sku: 'STICKER', name: 'Sticker', qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 250);
+  assert.equal(totals.vat, 998);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 5748);
+});
+
+test('invoiceTotals with no discount', () => {
+  const invoice = {
+    lines: [
+      { sku: 'STICKER', name: 'Sticker', qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 1050);
+  assert.equal(totals.total, 6050);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { sku: 'STICKER', name: 'Sticker', qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 5 },
+      { sku: 'DES-HOUR', name: 'Design', qty: 1, unitPrice: 8500, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 13500);
+  assert.equal(totals.discount, 675); // 250 + 425
+  assert.equal(totals.vat, 2694); // 998 + 1696
+  assert.equal(totals.total, 15519);
+});
+
+test('invoiceTotals with different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { sku: 'STICKER', name: 'Sticker', qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 5 },
+      { sku: 'PRINT', name: 'Print', qty: 10, unitPrice: 100, vatRate: 9, discountPercent: 5 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 6000);
+  assert.equal(totals.discount, 300); // 250 + 50
+  assert.equal(totals.vat, 1084); // 998 + 86
+  assert.equal(totals.total, 6784); // 6000 - 300 + 1084
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { sku: 'STICKER', name: 'Sticker', qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 5 },
+    ],
+    voucher: { code: 'PROMO', amount: 500 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 250);
+  assert.equal(totals.vat, 998);
+  assert.equal(totals.voucher, 500);
+  assert.equal(totals.total, 5248);
+});
+
+test('invoiceTotals clamps negative total to 0', () => {
+  const invoice = {
+    lines: [
+      { sku: 'STICKER', name: 'Sticker', qty: 1, unitPrice: 50, vatRate: 21, discountPercent: 100 },
+    ],
+    voucher: { code: 'PROMO', amount: 100 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with no lines', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with undefined discountPercent', () => {
+  const invoice = {
+    lines: [
+      { sku: 'STICKER', name: 'Sticker', qty: 100, unitPrice: 50, vatRate: 21, discountPercent: undefined },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 1050);
+});
+
+test('invoiceTotals with zero VAT rate', () => {
+  const invoice = {
+    lines: [
+      { sku: 'WORKSHOP', name: 'Workshop', qty: 1, unitPrice: 10000, vatRate: 0, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 10000);
+});
+
+test('invoiceTotals calculation is correct for complex invoice', () => {
+  const invoice = {
+    lines: [
+      { sku: 'A', name: 'Item A', qty: 5, unitPrice: 1000, vatRate: 21, discountPercent: 10 },
+      { sku: 'B', name: 'Item B', qty: 3, unitPrice: 2000, vatRate: 9, discountPercent: 0 },
+      { sku: 'C', name: 'Item C', qty: 2, unitPrice: 500, vatRate: 0, discountPercent: 20 },
+    ],
+    voucher: { code: 'TEST', amount: 100 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.subtotal > 0);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.voucher, 100);
+  assert.ok(totals.total > 0);
+});
+
+test('invoiceTotals without voucher property', () => {
+  const invoice = {
+    lines: [
+      { sku: 'STICKER', name: 'Sticker', qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 5748);
+});
