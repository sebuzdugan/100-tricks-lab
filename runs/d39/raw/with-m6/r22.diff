diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..16f8ccb
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,71 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total price of a line item (qty × unitPrice).
+ * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }}
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount amount for a line (in cents, rounded).
+ * @param {number} lineTotal - Total before discount (in cents)
+ * @param {number} discountPercent - Discount percentage (0-100)
+ * @returns {number} Discount amount in cents
+ */
+export function calculateLineDiscount(lineTotal, discountPercent) {
+  if (!discountPercent) return 0;
+  return roundCents((lineTotal * discountPercent) / 100);
+}
+
+/**
+ * Calculate the amount of a line after its discount.
+ * @param {number} lineTot - Total before discount
+ * @param {number} discountPercent - Discount percentage
+ * @returns {number} Amount after discount in cents
+ */
+export function lineAmountAfterDiscount(lineTot, discountPercent) {
+  const discount = calculateLineDiscount(lineTot, discountPercent);
+  return lineTot - discount;
+}
+
+/**
+ * Calculate the VAT for a line (on the amount after discount).
+ * @param {number} amountAfterDiscount - Amount after discount
+ * @param {number} vatRate - VAT rate in percent (0, 9, or 21)
+ * @returns {number} VAT amount in cents (rounded)
+ */
+export function calculateLineVat(amountAfterDiscount, vatRate) {
+  if (!vatRate || vatRate === 0) return 0;
+  return roundCents((amountAfterDiscount * vatRate) / 100);
+}
+
+/**
+ * Calculate the totals for an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, voucher?: { code: string, amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} Amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => {
+    const lineTot = lineTotal(line);
+    return sum + calculateLineDiscount(lineTot, line.discountPercent || 0);
+  }, 0);
+  const vat = invoice.lines.reduce((sum, line) => {
+    const lineTot = lineTotal(line);
+    const amountAfterDiscount = lineAmountAfterDiscount(lineTot, line.discountPercent || 0);
+    return sum + calculateLineVat(amountAfterDiscount, line.vatRate);
+  }, 0);
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
