@@ -31,6 +31,31 @@ export function lineAmountAfterDiscount(lineTot, discountPercent) {
   return lineTot - discount;
 }
 
+/**
+ * Calculate bulk discount (2.5% for lines with 10+ units, applied after regular discount).
+ * @param {number} amountAfterRegularDiscount - Amount after regular discount
+ * @param {number} qty - Quantity
+ * @returns {number} Bulk discount amount in cents
+ */
+export function calculateBulkDiscount(amountAfterRegularDiscount, qty) {
+  if (qty < 10) return 0;
+  return roundCents((amountAfterRegularDiscount * 2.5) / 100);
+}
+
+/**
+ * Calculate the total discount for a line (regular + bulk).
+ * @param {number} lineTot - Total before any discount
+ * @param {number} discountPercent - Regular discount percentage
+ * @param {number} qty - Quantity
+ * @returns {number} Total discount in cents
+ */
+export function calculateTotalLineDiscount(lineTot, discountPercent, qty) {
+  const regularDiscount = calculateLineDiscount(lineTot, discountPercent);
+  const amountAfterRegular = lineTot - regularDiscount;
+  const bulkDiscount = calculateBulkDiscount(amountAfterRegular, qty);
+  return regularDiscount + bulkDiscount;
+}
+
