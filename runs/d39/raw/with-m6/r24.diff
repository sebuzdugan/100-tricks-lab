+/**
+ * Generate a dashboard with key metrics across invoices.
+ * @param {Array} invoices - All invoices
+ * @param {string} asOf - Cutoff date in YYYY-MM-DD format
+ * @returns {{ counts: Object, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customersDue = new Map();
+
+  for (const inv of invoices) {
+    if (!inv) continue;
+
+    counts[inv.status] = (counts[inv.status] || 0) + 1;
+
+    // Calculate outstanding (issued and partially_paid only)
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const due = balanceDue(inv);
+      outstanding += due;
+
+      // Track by customer
+      if (!customersDue.has(inv.customerId)) {
+        customersDue.set(inv.customerId, 0);
+      }
+      customersDue.set(inv.customerId, customersDue.get(inv.customerId) + due);
+    }
+  }
+
+  // Get overdue information
+  const overdueList = overdueInvoices(invoices, asOf);
+  let overdueAmount = 0;
+  for (const inv of overdueList) {
+    overdueAmount += inv.due;
+  }
+
+  // Get top 3 customers by amount due
+  const topCustomers = Array.from(customersDue.entries())
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, 3)
+    .map(([customerId, due]) => ({ customerId, due }));
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdueList.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
