diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..cfe0f53
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,73 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a new draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate issueDate is in YYYY-MM-DD format
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  // Validate lines is not empty
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Process lines and validate each
+  const processedLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Get product
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    processedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: processedLines
+  });
+}
+
+/**
+ * Check if a date string is in valid YYYY-MM-DD format
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+function isValidDate(dateStr) {
+  if (typeof dateStr !== 'string') return false;
+
+  // Check format
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return false;
+
+  // Parse and validate
+  const date = new Date(dateStr + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+
+  // Make sure it's the same date we parsed (no day wrapping)
+  const parts = dateStr.split('-');
+  const year = parseInt(parts[0], 10);
+  const month = parseInt(parts[1], 10);
+  const day = parseInt(parts[2], 10);
+
+  return date.getUTCFullYear() === year &&
+         date.getUTCMonth() + 1 === month &&
+         date.getUTCDate() === day;
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..b410dba
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,166 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with valid data', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'STICKER', qty: 100 }
+    ]
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2024-01-15');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 2);
+
+  // First line
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 8500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+
+  // Second line
+  assert.equal(r.value.lines[1].sku, 'STICKER');
+  assert.equal(r.value.lines[1].name, 'Sticker sheet');
+  assert.equal(r.value.lines[1].qty, 100);
+  assert.equal(r.value.lines[1].unitPrice, 50);
+  assert.equal(r.value.lines[1].vatRate, 21);
+});
+
+test('createInvoice returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }]
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice returns DATE_INVALID for non-date issueDate', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: 'not-a-date',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }]
+    }),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('createInvoice returns DATE_INVALID for invalid dates', () => {
+  const invalidDates = [
+    '2024-02-30',  // February doesn't have 30 days
+    '2024-13-01',  // No month 13
+    '2024-01-32',  // January doesn't have 32 days
+    '2024/01/15',  // Wrong separator
+    '01-15-2024',  // Wrong order
+    '2024-1-15',   // Missing leading zero on month
+    ''
+  ];
+
+  for (const date of invalidDates) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }]
+    });
+    assert.equal(r.ok, false, `Should reject date: ${date}`);
+    assert.equal(r.error, 'DATE_INVALID', `Should be DATE_INVALID for: ${date}`);
+  }
+});
+
+test('createInvoice accepts valid leap year dates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }]
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.issueDate, '2024-02-29');
+});
+
+test('createInvoice returns NO_LINES for empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: []
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice returns NO_LINES for missing lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15'
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice returns QTY_INVALID for non-integer qty', () => {
+  const invalidQtys = [0, -1, 1.5, 'hello', null, undefined];
+
+  for (const qty of invalidQtys) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DES-HOUR', qty }]
+    });
+    assert.equal(r.ok, false, `Should reject qty: ${qty}`);
+    assert.equal(r.error, 'QTY_INVALID', `Should be QTY_INVALID for: ${qty}`);
+  }
+});
+
+test('createInvoice returns UNKNOWN_SKU for unknown SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }]
+  });
+
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const originalLine = { ...lines[0] };
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines
+  });
+
+  assert.deepEqual(lines[0], originalLine);
+  assert.equal(lines[0].name, undefined);
+  assert.equal(lines[0].unitPrice, undefined);
+});
+
+test('createInvoice returns different line objects than catalogue', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  // Modify the returned line
+  r.value.lines[0].qty = 999;
+
+  // Create another invoice and verify it's not affected
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  assert.equal(r2.value.lines[0].qty, 5);
+});
