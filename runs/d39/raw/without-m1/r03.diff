+/**
+ * Add a line to an invoice, or increase qty if the SKU already exists.
+ * @param {{ status: string, lines: Array<{ sku: string, qty: number, name: string, unitPrice: number, vatRate: number }> }}, { sku: string, qty: number }}
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check invoice is in draft status
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty is a positive integer
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Get product and validate SKU exists
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+  const newLines = invoice.lines.map((line) => ({ ...line }));
+
+  // Check if SKU already exists
+  const existingIndex = newLines.findIndex((line) => line.sku === sku);
+
+  if (existingIndex !== -1) {
+    // Increase qty on existing line
+    newLines[existingIndex].qty += qty;
+  } else {
+    // Add new line at the end
+    newLines.push({
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate
+    });
+  }
+
+  return ok({
+    ...invoice,
+    lines: newLines
+  });
+}
+
+/**
+ * Remove a line from an invoice by SKU.
+ * @param {{ status: string, lines: Array<{ sku: string }> }}, string
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Check invoice is in draft status
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check SKU exists on invoice
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  // Check it's not the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Create new invoice without that line
+  const newLines = invoice.lines.filter((line) => line.sku !== sku);
+
+  return ok({
+    ...invoice,
+    lines: newLines
+  });
+}
