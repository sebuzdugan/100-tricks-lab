@@ -0,0 +1,75 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for an empty list', () => {
+  const number = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber returns 0001 for a different year', () => {
+  const existing = ['INV-2023-0001', 'INV-2023-0002'];
+  const number = nextInvoiceNumber(existing, '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber returns the next counter for the same year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2024-0003'];
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber finds max counter with unordered list', () => {
+  const existing = ['INV-2024-0003', 'INV-2024-0001', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2024-01-15');
+  assert.equal(number, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber ignores invoices from other years', () => {
+  const existing = [
+    'INV-2023-0010',
+    'INV-2024-0001',
+    'INV-2024-0002',
+    'INV-2025-0001'
+  ];
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = ['INV-2024-9999'];
+  const number = nextInvoiceNumber(existing, '2024-01-15');
+  assert.equal(number, 'INV-2024-10000');
+});
+
+test('nextInvoiceNumber zero-pads the counter', () => {
+  const existing = [];
+  const number = nextInvoiceNumber(existing, '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber zero-pads correctly for double digits', () => {
+  const existing = Array.from({ length: 9 }, (_, i) => `INV-2024-000${i + 1}`);
+  const number = nextInvoiceNumber(existing, '2024-01-15');
+  assert.equal(number, 'INV-2024-0010');
+});
+
+test('nextInvoiceNumber ignores malformed invoice numbers', () => {
+  const existing = [
+    'INV-2024-0001',
+    'INVALID',
+    'INV-2024-abc',
+    'INV-2024-0002'
+  ];
+  const number = nextInvoiceNumber(existing, '2024-01-15');
+  assert.equal(number, 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber respects year in issueDate', () => {
+  const existing = ['INV-2023-0001', 'INV-2023-0002'];
+  const number2024 = nextInvoiceNumber(existing, '2024-01-15');
+  const number2025 = nextInvoiceNumber(existing, '2025-12-31');
+
+  assert.equal(number2024, 'INV-2024-0001');
+  assert.equal(number2025, 'INV-2025-0001');
+});
