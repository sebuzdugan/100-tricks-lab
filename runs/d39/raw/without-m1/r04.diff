+/**
+ * Generate the next invoice number for a given year.
+ * @param {Array<string>} existingNumbers - Array of invoice numbers already used (e.g., ['INV-2024-0001', 'INV-2024-0002'])
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Filter to numbers from this year and extract counters
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(`INV-${year}-`))
+    .map((num) => parseInt(num.substring(`INV-${year}-`.length), 10))
+    .filter((c) => !isNaN(c));
+
+  // Find max counter, default to 0 if none
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  // Format with 4-digit zero padding
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `INV-${year}-${paddedCounter}`;
+}
