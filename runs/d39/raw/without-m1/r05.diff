+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('DRAFT'), 'Should show DRAFT for draft invoice');
+  assert.ok(text.includes('Northwind Studio'), 'Should show customer name');
+  assert.ok(text.includes('Design work (hour)'), 'Should show product name');
+  assert.ok(text.includes('€85.00'), 'Should show unit price in euros');
+  assert.ok(text.includes('€425.00'), 'Should show line total in euros');
+  assert.ok(text.includes('Total: €425.00'), 'Should show total in euros');
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-06-15',
+    lines: [{ sku: 'STICKER', qty: 100 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const text = renderInvoiceText(issued);
+
+  assert.ok(text.startsWith('INV-2024-0001'), 'Should show invoice number');
+  assert.ok(text.includes('Blue Fern Bakery'), 'Should show customer name');
+  assert.ok(text.includes('€50.00'), 'Should show line total in euros');
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'STICKER', qty: 100 }
+    ]
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  // Line 1: DRAFT
+  assert.equal(lines[0], 'DRAFT');
+  // Line 2: Customer name
+  assert.equal(lines[1], 'Northwind Studio');
+  // Line 3: Empty line
+  assert.equal(lines[2], '');
+  // Lines with invoice items
+  assert.ok(lines[3].includes('Design work (hour)'), 'First item');
+  assert.ok(lines[4].includes('Development (hour)'), 'Second item');
+  assert.ok(lines[5].includes('Sticker sheet'), 'Third item');
+});
+
+test('renderInvoiceText formats amounts through formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'ICON-SET', qty: 5 }
+    ]
+  });
+
+  const text = renderInvoiceText(r.value);
+
+  // DES-HOUR: unitPrice 8500 cents = €85.00
+  assert.ok(text.includes('€85.00'), 'DES-HOUR unit price');
+  // ICON-SET: unitPrice 980 cents = €9.80
+  assert.ok(text.includes('€9.80'), 'ICON-SET unit price');
+  // DES-HOUR line total: 1 * 8500 = 8500 cents = €85.00
+  // ICON-SET line total: 5 * 980 = 4900 cents = €49.00
+  // Total: 85.00 + 49.00 = 134.00
+  assert.ok(text.includes('Total: €134.00'), 'Invoice total');
+});
+
+test('renderInvoiceText shows quantities correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'STICKER', qty: 100 }
+    ]
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.ok(lines[3].includes('1 '), 'First qty is 1');
+  assert.ok(lines[4].includes('10 '), 'Second qty is 10');
+  assert.ok(lines[5].includes('100 '), 'Third qty is 100');
+});
+
+test('renderInvoiceText has consistent line structure', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'STICKER', qty: 100 }
+    ]
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  // Check structure:
+  // Line 0: DRAFT
+  assert.equal(lines[0], 'DRAFT');
+  // Line 1: Customer name
+  assert.equal(lines[1], 'Northwind Studio');
+  // Line 2: Empty line
+  assert.equal(lines[2], '');
+  // Lines 3-4: Invoice items
+  assert.ok(lines[3].length > 0, 'First item line not empty');
+  assert.ok(lines[4].length > 0, 'Second item line not empty');
+  // Line 5: Empty line before total
+  assert.equal(lines[5], '');
+  // Line 6: Total
+  assert.ok(lines[6].startsWith('Total: '), 'Total line format');
+});
+
+test('renderInvoiceText handles single line', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }]
+  });
+
+  const text = renderInvoiceText(r.value);
+
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Kite & Co'));
+  assert.ok(text.includes('Logo package'));
+  assert.ok(text.includes('€1,200.00'), 'LOGO-PACK: 120000 cents = €1,200.00');
+  assert.ok(text.includes('Total: €1,200.00'));
+});
+
+test('renderInvoiceText shows issued invoice number', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const text = renderInvoiceText(issued);
+
+  assert.ok(text.startsWith('INV-2024-0001'));
+  assert.equal(text.includes('DRAFT'), false, 'Should not show DRAFT for issued invoice');
+});
+
+test('renderInvoiceText with multiple issues from same year', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const issued1 = issueInvoice(r.value, []).value;
+  const issued2 = issueInvoice(r.value, ['INV-2024-0001']).value;
+
+  const text1 = renderInvoiceText(issued1);
+  const text2 = renderInvoiceText(issued2);
+
+  assert.ok(text1.startsWith('INV-2024-0001'));
+  assert.ok(text2.startsWith('INV-2024-0002'));
+});
+
+test('renderInvoiceText handles unknown customer gracefully', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: 5,
+        unitPrice: 8500,
+        vatRate: 21
+      }
+    ]
+  };
+
+  const text = renderInvoiceText(invoice);
+
+  assert.ok(text.includes('Unknown'), 'Should show Unknown for unknown customer');
+  assert.ok(text.includes('Design work (hour)'), 'Should still show line items');
+});
+
+test('renderInvoiceText formatting with large amounts', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 10 }
+    ]
+  });
+
+  const text = renderInvoiceText(r.value);
+
+  // BRAND-BOOK: 245000 cents = €2,450.00 per unit
+  // Total: 10 * €2,450.00 = €24,500.00
+  assert.ok(text.includes('€2,450.00'), 'Unit price with thousands separator');
+  assert.ok(text.includes('Total: €24,500.00'), 'Total with thousands separator');
+});
