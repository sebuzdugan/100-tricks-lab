+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown';
+
+  const invoiceNumber = invoice.number || 'DRAFT';
+
+  let text = `${invoiceNumber}\n`;
+  text += `${customerName}\n`;
+  text += '\n';
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const qtyStr = String(line.qty).padStart(3, ' ');
+    const nameStr = line.name.padEnd(35, ' ');
+    const unitPriceStr = formatEuros(line.unitPrice).padStart(10, ' ');
+    const totalStr = formatEuros(total).padStart(10, ' ');
+    text += `${qtyStr}  ${nameStr}${unitPriceStr}  ${totalStr}\n`;
+  }
+
+  const totals = invoiceTotals(invoice);
+  text += `\nTotal: ${formatEuros(totals.total)}`;
+
+  return text;
+}
diff --git a/test/render.test.js b/test/render.test.js
