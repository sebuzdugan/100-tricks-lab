diff --git a/test/customers.test.js b/test/customers.test.js
index 8219003..2baff7c 100644
--- a/test/customers.test.js
+++ b/test/customers.test.js
@@ -1,6 +1,6 @@
 import test from 'node:test';
 import assert from 'node:assert/strict';
-import { getCustomer, listCustomers, validateCustomer, TIER_DISCOUNTS } from '../src/customers.js';
+import { getCustomer, listCustomers, validateCustomer, TIER_DISCOUNTS, normalizeId } from '../src/customers.js';
 
 test('getCustomer finds a customer by id', () => {
   const r = getCustomer('C-003');
@@ -26,3 +26,43 @@ test('TIER_DISCOUNTS has all three tiers', () => {
   assert.equal(TIER_DISCOUNTS.silver, 2.5);
   assert.equal(TIER_DISCOUNTS.standard, 0);
 });
+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('  c-001  '), 'C-001');
+  assert.equal(normalizeId('c-001 '), 'C-001');
+  assert.equal(normalizeId(' c-001'), 'C-001');
+});
+
+test('normalizeId converts to uppercase', () => {
+  assert.equal(normalizeId('c-001'), 'C-001');
+  assert.equal(normalizeId('C-001'), 'C-001');
+  assert.equal(normalizeId('c-007 '), 'C-007');
+});
+
+test('normalizeId handles mixed case', () => {
+  assert.equal(normalizeId('c-FoO'), 'C-FOO');
+  assert.equal(normalizeId('  C-bAr  '), 'C-BAR');
+});
+
+test('getCustomer finds customer with normalized ID', () => {
+  const r1 = getCustomer('c-001');
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.name, 'Northwind Studio');
+
+  const r2 = getCustomer('C-001');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.name, 'Northwind Studio');
+
+  const r3 = getCustomer('  c-001  ');
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.name, 'Northwind Studio');
+});
+
+test('getCustomer with normalized IDs returns same result', () => {
+  const r1 = getCustomer('c-003');
+  const r2 = getCustomer('C-003');
+  const r3 = getCustomer('  c-003  ');
+
+  assert.deepEqual(r1, r2);
+  assert.deepEqual(r2, r3);
+});
diff --git a/test/invoices.test.js b/test/invoices.test.js
index c14a414..245428a 100644
--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -1009,3 +1009,67 @@ test('invoiceTotals clamps total at 0', () => {
   assert.equal(totals.total, 0);
   assert.ok(totals.total >= 0, 'total should never be negative');
 });
+
+test('createInvoice normalizes customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const r3 = createInvoice({
+    customerId: '  c-001  ',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  assert.equal(r1.ok, true);
+  assert.equal(r2.ok, true);
+  assert.equal(r3.ok, true);
+  assert.equal(r1.value.customerId, 'C-001');
+  assert.equal(r2.value.customerId, 'C-001');
+  assert.equal(r3.value.customerId, 'C-001');
+});
+
+test('createInvoice with lowercase customer ID uses correct tier discount', () => {
+  // C-001 is gold tier (5% discount)
+  const r = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice with spaced customer ID uses correct tier discount', () => {
+  // C-003 is silver tier (2.5% discount)
+  const r = createInvoice({
+    customerId: '  c-003  ',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 2.5);
+});
+
+test('addLine normalizes customer ID for tier discount lookup', () => {
+  const r = createInvoice({
+    customerId: '  c-001  ',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  // Add a line without explicit discount - should use tier discount
+  const r2 = addLine(r.value, { sku: 'STICKER', qty: 100 });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.lines[1].discountPercent, 5);
+});
