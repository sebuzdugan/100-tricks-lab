new file mode 100644
index 0000000..a4bfe28
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,72 @@
+/**
+ * Check if a date string is in valid YYYY-MM-DD format (UTC only).
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') return false;
+
+  // Check format
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+
+  // Parse and validate in UTC
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+
+  // Make sure it's the same date we parsed (no day wrapping)
+  const parts = text.split('-');
+  const year = parseInt(parts[0], 10);
+  const month = parseInt(parts[1], 10);
+  const day = parseInt(parts[2], 10);
+
+  return date.getUTCFullYear() === year &&
+         date.getUTCMonth() + 1 === month &&
+         date.getUTCDate() === day;
+}
+
+/**
+ * Parse a date string (YYYY-MM-DD) into a UTC Date object.
+ * @param {string} dateStr
+ * @returns {Date}
+ */
+function parseUtcDate(dateStr) {
+  return new Date(dateStr + 'T00:00:00Z');
+}
+
+/**
+ * Format a Date object as YYYY-MM-DD string (UTC).
+ * @param {Date} date
+ * @returns {string}
+ */
+function formatUtcDate(date) {
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Add n days to a date string (YYYY-MM-DD), using UTC.
+ * @param {string} dateStr
+ * @param {number} n
+ * @returns {string}
+ */
+export function addDays(dateStr, n) {
+  const date = parseUtcDate(dateStr);
+  const msPerDay = 24 * 60 * 60 * 1000;
+  const newDate = new Date(date.getTime() + n * msPerDay);
+  return formatUtcDate(newDate);
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a), using UTC.
+ * @param {string} a
+ * @param {string} b
+ * @returns {number}
+ */
+export function daysBetween(a, b) {
+  const dateA = parseUtcDate(a);
+  const dateB = parseUtcDate(b);
+  const msPerDay = 24 * 60 * 60 * 1000;
+  return Math.floor((dateB.getTime() - dateA.getTime()) / msPerDay);
+}
