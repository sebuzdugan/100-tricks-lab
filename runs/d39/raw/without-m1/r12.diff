   const msPerDay = 24 * 60 * 60 * 1000;
   return Math.floor((dateB.getTime() - dateA.getTime()) / msPerDay);
 }
+
+/**
+ * Get the last day of the month for a given date, as YYYY-MM-DD string (UTC).
+ * @param {string} dateStr
+ * @returns {string}
+ */
+export function getLastDayOfMonth(dateStr) {
+  const parts = dateStr.split('-');
+  const year = parseInt(parts[0], 10);
+  const month = parseInt(parts[1], 10);
+  // Create a date for the first day of the next month
+  const firstOfNextMonth = new Date(Date.UTC(year, month, 1));
+  // Subtract 1 day to get the last day of the current month
+  const lastDayMs = firstOfNextMonth.getTime() - (24 * 60 * 60 * 1000);
+  const lastDay = new Date(lastDayMs);
+  return formatUtcDate(lastDay);
+}
