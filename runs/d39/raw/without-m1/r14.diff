+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns customer not found for unknown customer', () => {
+  const r = statement('C-999', [], '2024-02-01');
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement returns date invalid for invalid asOf date', () => {
+  const r = statement('C-001', [], 'invalid-date');
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('statement returns empty list for customer with no invoices', () => {
+  const r = statement('C-001', [], '2024-02-01');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes issued invoices with issueDate on or before asOf', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  const invoices = [issued];
+
+  const r2 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices.length, 1);
+  assert.equal(r2.value.invoices[0].number, 'INV-2024-0001');
+  assert.equal(r2.value.invoices[0].issueDate, '2024-01-15');
+});
+
+test('statement excludes invoices with issueDate after asOf', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  const invoices = [issued];
+
+  const r2 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices.length, 0);
+  assert.equal(r2.value.totalDue, 0);
+});
+
+test('statement includes invoices with issueDate exactly on asOf', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  const invoices = [issued];
+
+  const r2 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices.length, 1);
+});
+
+test('statement excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const invoices = [r1.value];
+
+  const r2 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices.length, 0);
+});
+
+test('statement includes partially_paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  const partial = recordPayment(issued, { amount: 10000, date: '2024-01-20' }).value;
+  const invoices = [partial];
+
+  const r2 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices.length, 1);
+  assert.equal(r2.value.invoices[0].number, 'INV-2024-0001');
+});
+
+test('statement calculates due amount from balanceDue', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  // Total: 51425
+  const partial = recordPayment(issued, { amount: 20000, date: '2024-01-20' }).value;
+  // Due: 51425 - 20000 = 31425
+  const invoices = [partial];
+
+  const r2 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices[0].due, 31425);
+});
+
+test('statement includes dueDate in invoice details', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14'
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  const invoices = [issued];
+
+  const r2 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.invoices[0].dueDate, '2024-01-29');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const issued1 = issueInvoice(r1.value, ['INV-2024-0001']).value;
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']).value;
+  const issued3 = issueInvoice(r3.value, ['INV-2024-0001', 'INV-2024-0002']).value;
+
+  const invoices = [issued1, issued2, issued3];
+
+  const r4 = statement('C-001', invoices, '2024-04-01');
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.invoices.length, 3);
+  assert.equal(r4.value.invoices[0].issueDate, '2024-01-15');
+  assert.equal(r4.value.invoices[1].issueDate, '2024-02-15');
+  assert.equal(r4.value.invoices[2].issueDate, '2024-03-15');
+});
+
+test('statement calculates totalDue correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 10, discountPercent: 0 }]
+  });
+
+  const issued1 = issueInvoice(r1.value, []).value;
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']).value;
+
+  // Total for first: 51425
+  // Total for second: 102850
+  // Total due: 51425 + 102850 = 154275
+
+  const invoices = [issued1, issued2];
+
+  const r3 = statement('C-001', invoices, '2024-03-01');
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.totalDue, 154275);
+});
+
+test('statement filters by customer', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const issued1 = issueInvoice(r1.value, []).value;
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']).value;
+
+  const invoices = [issued1, issued2];
+
+  const r3 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.invoices.length, 1);
+  assert.equal(r3.value.invoices[0].number, 'INV-2024-0001');
+
+  const r4 = statement('C-002', invoices, '2024-02-01');
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.invoices.length, 1);
+  assert.equal(r4.value.invoices[0].number, 'INV-2024-0002');
+});
+
+test('statement normalizes customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  const invoices = [issued];
+
+  const r2 = statement('  C-001  ', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.customerId, 'C-001');
+  assert.equal(r2.value.invoices.length, 1);
+});
+
+test('statement includes invoice total in statement', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  const invoices = [issued];
+
+  const r2 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  // Total: 51425
+  assert.equal(r2.value.invoices[0].total, 51425);
+});
+
+test('statement with paid invoice shows due of 0', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  const paid = recordPayment(issued, { amount: 51425, date: '2024-01-20' }).value;
+  const invoices = [paid];
+
+  const r2 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r2.ok, true);
+  // Status is 'paid', so it should NOT be included (only 'issued' or 'partially_paid')
+  // Actually, let me reconsider - the spec says "issued or partially_paid"
+  // So paid invoices should be excluded
+  assert.equal(r2.value.invoices.length, 0);
+  assert.equal(r2.value.totalDue, 0);
+});
+
+test('statement with multiple invoices calculates correct totalDue', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 3, discountPercent: 0 }]
+  });
+
+  const issued1 = issueInvoice(r1.value, []).value;
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']).value;
+
+  const partial1 = recordPayment(issued1, { amount: 10000, date: '2024-01-20' }).value;
+  const partial2 = recordPayment(issued2, { amount: 5000, date: '2024-02-20' }).value;
+
+  // First: total 51425, paid 10000, due 41425
+  // Second: total 30855, paid 5000, due 25855
+  // Total due: 41425 + 25855 = 67280
+
+  const invoices = [partial1, partial2];
+
+  const r3 = statement('C-001', invoices, '2024-03-01');
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.invoices.length, 2);
+  assert.equal(r3.value.invoices[0].due, 41425);
+  assert.equal(r3.value.invoices[1].due, 25855);
+  assert.equal(r3.value.totalDue, 67280);
+});
+
+test('statement handles invoices from different years', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }]
+  });
+
+  const issued1 = issueInvoice(r1.value, []).value;
+  const issued2 = issueInvoice(r2.value, ['INV-2023-0001']).value;
+
+  const invoices = [issued1, issued2];
+
+  // Statement as of end of 2023
+  const r3 = statement('C-001', invoices, '2023-12-31');
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.invoices.length, 1);
+  assert.equal(r3.value.invoices[0].issueDate, '2023-12-15');
+
+  // Statement as of 2024
+  const r4 = statement('C-001', invoices, '2024-02-01');
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.invoices.length, 2);
+  assert.equal(r4.value.invoices[0].issueDate, '2023-12-15');
+  assert.equal(r4.value.invoices[1].issueDate, '2024-01-15');
+});
