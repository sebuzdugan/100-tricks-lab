+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { isValidDate } from './dates.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement listing invoices and amounts due.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, status: string, lines: Array, dueDate?: string, payments?: Array }>} invoices
+ * @param {string} asOf date string in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize customer ID
+  const normalizedCustomerId = normalizeId(customerId);
+
+  // Validate customer exists
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Filter invoices for this customer with status 'issued' or 'partially_paid' and issueDate <= asOf
+  const statementInvoices = invoices
+    .filter((inv) => normalizeId(inv.customerId) === normalizedCustomerId)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf && inv.number) // Must be issued (has number) and date is on/before asOf
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate || '',
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv)
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: statementInvoices,
+    totalDue
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
