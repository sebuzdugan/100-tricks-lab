+    'INV-2024-0003',
+    'INV-2024-0004',
+    'INV-2024-0005'
+  ];
+
+  const r2 = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2024-01-20' }, existingNumbers);
+  assert.equal(r2.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote preserves invoice number', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const r2 = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2024-01-20' }, []);
+
+  assert.equal(r2.value.invoiceNumber, 'INV-2024-0001');
+});
+
+test('createCreditNote zero-pads counter to 4 digits', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+
+  // Create 100 credit notes to get to a 4-digit number
+  const existingNumbers = Array.from({ length: 100 }, (_, i) => `CN-2024-${String(i + 1).padStart(4, '0')}`);
+
+  const r2 = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2024-12-20' }, existingNumbers);
+  assert.equal(r2.value.number, 'CN-2024-0101');
+});
+
+test('createCreditNote with invoice that has discount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  // Subtotal: 42500, Discount: 4250, VAT: 8032, Total: 46282
+
+  const r2 = createCreditNote(issued, { amount: 46282, reason: 'Full refund', date: '2024-01-20' }, []);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.amount, 46282);
+});
+
+test('createCreditNote with invoice that has voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'SAVE10', amount: 5000 });
+  const issued = issueInvoice(r2.value, []).value;
+  // Total without voucher: 51425, with voucher: 46425
+
+  const r3 = createCreditNote(issued, { amount: 46425, reason: 'Full refund', date: '2024-01-20' }, []);
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.amount, 46425);
+});
+
+test('createCreditNote credit note amount can exceed invoice total should fail', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  // Total for 1 design hour: 8500 + 1785 (VAT) = 10285
+
+  const r2 = createCreditNote(issued, { amount: 10286, reason: 'Refund', date: '2024-01-20' }, []);
+  assert.deepEqual(r2, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
