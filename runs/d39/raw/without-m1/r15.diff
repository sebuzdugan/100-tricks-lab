+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates credit note for issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const r2 = createCreditNote(issued, { amount: 5000, reason: 'Partial refund', date: '2024-01-20' }, []);
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.number, 'CN-2024-0001');
+  assert.equal(r2.value.invoiceNumber, 'INV-2024-0001');
+  assert.equal(r2.value.customerId, 'C-002');
+  assert.equal(r2.value.amount, 5000);
+  assert.equal(r2.value.reason, 'Partial refund');
+  assert.equal(r2.value.date, '2024-01-20');
+});
+
+test('createCreditNote works for partially_paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const partial = recordPayment(issued, { amount: 10000, date: '2024-01-20' }).value;
+  const r2 = createCreditNote(partial, { amount: 5000, reason: 'Partial refund', date: '2024-01-25' }, []);
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, undefined);
+  assert.equal(r2.value.amount, 5000);
+});
+
+test('createCreditNote works for paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const paid = recordPayment(issued, { amount: 51425, date: '2024-01-20' }).value;
+  const r2 = createCreditNote(paid, { amount: 10000, reason: 'Full refund', date: '2024-01-25' }, []);
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.amount, 10000);
+});
+
+test('createCreditNote returns NOT_ISSUED for draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const r2 = createCreditNote(r.value, { amount: 5000, reason: 'Partial refund', date: '2024-01-20' }, []);
+  assert.deepEqual(r2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote returns DATE_INVALID for invalid date', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const r2 = createCreditNote(issued, { amount: 5000, reason: 'Partial refund', date: 'invalid-date' }, []);
+  assert.deepEqual(r2, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote returns AMOUNT_INVALID for zero amount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
