+
+  const issued = issueInvoice(r.value, []).value;
+  // Total: 51425
+  const r2 = createCreditNote(issued, { amount: 51425, reason: 'Full refund', date: '2024-01-20' }, []);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.amount, 51425);
+});
+
+test('createCreditNote numbers sequentially within a year', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+
+  const r2 = createCreditNote(issued, { amount: 5000, reason: 'First refund', date: '2024-01-20' }, []);
+  assert.equal(r2.value.number, 'CN-2024-0001');
+
+  const r3 = createCreditNote(issued, { amount: 5000, reason: 'Second refund', date: '2024-01-25' }, ['CN-2024-0001']);
+  assert.equal(r3.value.number, 'CN-2024-0002');
+
+  const r4 = createCreditNote(issued, { amount: 5000, reason: 'Third refund', date: '2024-02-01' }, ['CN-2024-0001', 'CN-2024-0002']);
+  assert.equal(r4.value.number, 'CN-2024-0003');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+
+  // 2024 credit notes
+  const r2 = createCreditNote(issued, { amount: 5000, reason: 'Refund', date: '2024-12-20' }, []);
+  assert.equal(r2.value.number, 'CN-2024-0001');
+
+  // 2025 credit notes should reset to 0001
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued3 = issueInvoice(r3.value, ['INV-2025-0001']).value;
+  const r4 = createCreditNote(issued3, { amount: 5000, reason: 'Refund', date: '2025-01-20' }, ['CN-2024-0001', 'INV-2025-0001']);
+  assert.equal(r4.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote ignores invoice numbers when counting', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+
+  // Even with many invoice numbers, credit notes start at 0001
+  const existingNumbers = [
+    'INV-2024-0001',
