+import { ok, fail } from './result.js';
+import { isValidDate } from './dates.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next credit note number for a given date.
+ * @param {Array<string>} existingNumbers numbers already used (both INV and CN formats)
+ * @param {string} date issue date in YYYY-MM-DD format
+ * @returns {string} next credit note number in CN-YYYY-COUNTER format
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+
+  // Filter to get only CN numbers for this year
+  const creditNotesThisYear = existingNumbers
+    .filter((num) => num.startsWith('CN-'))
+    .filter((num) => num.startsWith(`CN-${year}-`))
+    .map((num) => {
+      const parts = num.split('-');
+      return parseInt(parts[2], 10);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  const maxCounter = creditNotesThisYear.length > 0 ? Math.max(...creditNotesThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+
+  return `CN-${year}-${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ number: string, customerId: string, status: string, lines: Array, voucher?: { amount: number }, payments?: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNoteData
+ * @param {Array<string>} existingNumbers numbers already used
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice has been issued (status must be 'issued', 'partially_paid', or 'paid')
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date is valid
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const invoiceTotal = invoiceTotals(invoice).total;
+
+  // Check credit note amount doesn't exceed invoice total
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date
+  });
+}
