+  const issued = issueInvoice(r.value, []).value;
+  // WORKSHOP-DAY: 60000 cents, no VAT, total = 60000
+
+  const r2 = createCreditNote(issued, { amount: 60000, reason: 'Full refund', date: '2024-01-20' }, []);
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.amount, 60000);
