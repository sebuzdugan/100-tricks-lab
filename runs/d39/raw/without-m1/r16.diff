+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  // dueDate: 2024-01-29
+
+  const result = overdueInvoices([issued], '2024-01-29');
+  assert.equal(result.length, 0);
+
+  const result2 = overdueInvoices([issued], '2024-01-30');
+  assert.equal(result2.length, 1);
+});
