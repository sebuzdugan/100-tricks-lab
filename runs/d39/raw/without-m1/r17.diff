+/**
+ * Get a VAT summary across invoices.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  // Map of VAT rate to { base, vat }
+  const vatMap = {};
+
+  // Process invoices with status 'issued', 'partially_paid', or 'paid'
+  invoices
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach((inv) => {
+      inv.lines.forEach((line) => {
+        const rate = line.vatRate;
+        const base = lineTotal(line) - lineDiscount(line);
+        const vat = lineVAT(line);
+
+        if (!vatMap[rate]) {
+          vatMap[rate] = { base: 0, vat: 0 };
+        }
+
+        vatMap[rate].base += base;
+        vatMap[rate].vat += vat;
+      });
+    });
+
+  // Convert to array and sort by rate descending
+  return Object.entries(vatMap)
+    .map(([rate, { base, vat }]) => ({
+      rate: parseInt(rate, 10),
+      base,
+      vat
+    }))
+    .sort((a, b) => b.rate - a.rate);
+}
