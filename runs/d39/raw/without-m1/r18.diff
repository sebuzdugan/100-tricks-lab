+/**
+ * Calculate the late fee for an invoice.
+ * Late fee is 0.04% of the amount still due for every day the invoice is overdue.
+ * @param {{ dueDate?: string, lines: Array, status?: string, payments?: Array }} invoice
+ * @param {string} asOf date string in YYYY-MM-DD format
+ * @returns {number} late fee in cents
+ */
+export function lateFee(invoice, asOf) {
+  // Must have a due date
+  if (!invoice.dueDate) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // No fee if not overdue
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  // Get amount still due
+  const due = balanceDue(invoice);
+
+  // Calculate late fee: 0.04% per day
+  const fee = due * 0.0004 * daysOverdue;
+
+  return roundCents(fee);
+}
