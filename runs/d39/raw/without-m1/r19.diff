+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header line', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv ends with newline', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv[csv.length - 1], '\n');
+});
+
+test('exportCsv with single invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3); // header + invoice + final empty line
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Check invoice line
+  const parts = lines[1].split(',');
+  assert.equal(parts[0], 'INV-2024-0001');
+  assert.equal(parts[1], 'Northwind Studio'); // C-001 is Northwind Studio
+  assert.equal(parts[2], '2024-01-15');
+  assert.equal(parts[3], '2024-01-29');
+  assert.equal(parts[4], 'issued');
+});
+
+test('exportCsv with multiple invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 3, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const issued1 = issueInvoice(r1.value, []).value;
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']).value;
+
+  const csv = exportCsv([issued1, issued2]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 4); // header + 2 invoices + final empty line
+  assert.equal(lines[1].startsWith('INV-2024-0001'), true);
+  assert.equal(lines[2].startsWith('INV-2024-0002'), true);
+});
+
+test('exportCsv formats amounts as euros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  const parts = lines[1].split(',');
+
+  // Subtotal: 42500 cents = 425.00
+  assert.equal(parts[5], '425.00');
+  // Discount: 0 = 0.00
+  assert.equal(parts[6], '0.00');
+  // VAT: 8925 cents = 89.25
+  assert.equal(parts[7], '89.25');
+  // Total: 51425 cents = 514.25
+  assert.equal(parts[8], '514.25');
+  // Due: 51425 cents = 514.25
+  assert.equal(parts[9], '514.25');
+});
+
+test('exportCsv with discount', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+    terms: 'NET14'
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  const parts = lines[1].split(',');
+
+  // Subtotal: 42500 cents = 425.00
+  assert.equal(parts[5], '425.00');
+  // Discount: 4250 cents = 42.50
+  assert.equal(parts[6], '42.50');
+  // VAT: 8032 cents = 80.32
+  assert.equal(parts[7], '80.32');
+  // Total: 46282 cents = 462.82
+  assert.equal(parts[8], '462.82');
+});
+
+test('exportCsv with partial payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const partial = recordPayment(issued, { amount: 20000, date: '2024-01-20' }).value;
+
+  const csv = exportCsv([partial]);
+  const lines = csv.split('\n');
+  const parts = lines[1].split(',');
+
+  // Due: 51425 - 20000 = 31425 cents = 314.25
+  assert.equal(parts[9], '314.25');
+});
+
+test('exportCsv with customer name containing comma', () => {
+  const r = createInvoice({
+    customerId: 'C-004',
