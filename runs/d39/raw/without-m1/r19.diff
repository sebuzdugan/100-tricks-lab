+    terms: 'NET14'
+  });
+
+  const issued = issueInvoice(r.value, []).value;
+  const csv = exportCsv([issued]);
+
+  // C-004 is "Smith, Jones & Partners" which contains a comma
+  // It should be quoted in the CSV
+  assert.ok(csv.includes('"Smith, Jones & Partners"'));
+});
+
