+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Format cents as euros with 2 decimals and a dot, no currency sign or thousands separator.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEurosForCsv(cents) {
+  const euros = Math.abs(Math.floor(cents / 100));
+  const remainder = Math.abs(cents % 100);
+  return `${euros}.${String(remainder).padStart(2, '0')}`;
+}
+
+/**
+ * Escape a CSV field: wrap in double quotes if it contains comma, quote, or newline,
+ * and double any double quotes inside it.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  const str = String(field);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ number?: string, customerId: string, issueDate: string, dueDate?: string, status: string, lines: Array, payments?: Array }>} invoices
+ * @returns {string} CSV formatted string with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Add header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Add invoice lines
+  invoices.forEach((invoice) => {
+    const normalizedCustomerId = normalizeId(invoice.customerId);
+    const customerResult = getCustomer(normalizedCustomerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number || '',
+      escapeCsvField(customerName),
+      invoice.issueDate || '',
+      invoice.dueDate || '',
+      invoice.status || '',
+      formatEurosForCsv(totals.subtotal),
+      formatEurosForCsv(totals.discount),
+      formatEurosForCsv(totals.vat),
+      formatEurosForCsv(totals.total),
+      formatEurosForCsv(due)
+    ];
+
+    lines.push(fields.join(','));
+  });
+
+  return lines.join('\n') + '\n';
+}
