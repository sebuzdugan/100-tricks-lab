+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const csv = exportCsv([r.value]);
+  const lines = csv.split('\n');
+  const parts = lines[1].split(',');
+
+  // Draft invoice has no number
+  assert.equal(parts[0], '');
+  // Status is draft
+  assert.equal(parts[4], 'draft');
+  // Draft invoices have a dueDate (default NET30)
+  assert.equal(parts[3], '2024-02-14');
+});
+
+test('exportCsv CSV field escaping with comma', () => {
+  // This test uses data that would generate a CSV field with comma
+  // For now, we'll test the escaping logic with a mock scenario
