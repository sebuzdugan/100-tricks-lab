+
+test('exportCsv preserves invoice order', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 3, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const r3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-10',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const issued1 = issueInvoice(r1.value, []).value;
+  const issued2 = issueInvoice(r2.value, ['INV-2024-0001']).value;
+  const issued3 = issueInvoice(r3.value, ['INV-2024-0001', 'INV-2024-0002']).value;
+
+  const csv = exportCsv([issued1, issued2, issued3]);
+  const lines = csv.split('\n');
+
+  // Check order is preserved
+  assert.equal(lines[1].startsWith('INV-2024-0001'), true);
+  assert.equal(lines[2].startsWith('INV-2024-0002'), true);
+  assert.equal(lines[3].startsWith('INV-2024-0003'), true);
+});
+
+test('exportCsv with fully paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
