diff --git a/src/money.js b/src/money.js
index fadf486..42f9bf9 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,14 @@
 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +48,42 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount from euros to another currency.
+ * @param {number} cents amount in euro cents
+ * @param {string} currency target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const amountInTargetCurrency = cents * RATES[currency];
+  return ok(Math.round(amountInTargetCurrency));
+}
+
+/**
+ * Format an amount in a specific currency, with currency sign.
+ * @param {number} cents amount in that currency's cents
+ * @param {string} currency (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  if (!RATES[currency]) {
+    return 'unknown currency';
+  }
+
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const euros = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const remainder = String(abs % 100).padStart(2, '0');
+
+  const currencySymbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£'
+  };
+
+  return `${sign}${currencySymbols[currency]}${euros}.${remainder}`;
+}
