+
+test('RATES object contains EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to USD', () => {
+  // 100 EUR cents = 1 euro
+  // 1 euro * 1.085 USD/euro = 1.085 USD = 108.5 cents
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 109); // 108.5 rounds to 109
+});
+
+test('convert EUR to GBP', () => {
+  // 100 EUR cents = 1 euro
+  // 1 euro * 0.8425 GBP/euro = 0.8425 GBP = 84.25 cents
+  const result = convert(100, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 84);
+});
+
+test('convert EUR to EUR (no change)', () => {
+  const result = convert(12345, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 12345);
+});
+
+test('convert zero euros', () => {
+  const result = convert(0, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert large amount', () => {
+  // 1,000,000 EUR cents = 10,000 euros
+  // 10,000 * 1.085 = 10,850 USD
+  const result = convert(1000000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1085000);
+});
+
+test('convert returns UNKNOWN_CURRENCY for invalid currency', () => {
+  const result = convert(100, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert handles negative amounts', () => {
+  const result = convert(-100, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -108); // -108.5 rounds to -108
+});
+
+test('formatMoney formats EUR', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+  assert.equal(formatMoney(5, 'EUR'), '€0.05');
+  assert.equal(formatMoney(-250, 'EUR'), '-€2.50');
+});
+
+test('formatMoney formats USD', () => {
+  assert.equal(formatMoney(123456, 'USD'), '$1,234.56');
+  assert.equal(formatMoney(5, 'USD'), '$0.05');
+  assert.equal(formatMoney(-250, 'USD'), '-$2.50');
+});
+
+test('formatMoney formats GBP', () => {
+  assert.equal(formatMoney(123456, 'GBP'), '£1,234.56');
+  assert.equal(formatMoney(5, 'GBP'), '£0.05');
+  assert.equal(formatMoney(-250, 'GBP'), '-£2.50');
+});
+
+test('formatMoney with zero', () => {
+  assert.equal(formatMoney(0, 'EUR'), '€0.00');
+  assert.equal(formatMoney(0, 'USD'), '$0.00');
+  assert.equal(formatMoney(0, 'GBP'), '£0.00');
+});
+
+test('formatMoney with large amounts', () => {
+  assert.equal(formatMoney(100000000, 'EUR'), '€1,000,000.00');
+  assert.equal(formatMoney(100000000, 'USD'), '$1,000,000.00');
+  assert.equal(formatMoney(100000000, 'GBP'), '£1,000,000.00');
+});
+
+test('formatMoney with unknown currency returns message', () => {
+  const result = formatMoney(100, 'JPY');
+  assert.equal(result, 'unknown currency');
+});
+
+test('convert and formatMoney work together', () => {
+  // Convert 100 EUR cents to USD
+  const convertResult = convert(100, 'USD');
+  assert.equal(convertResult.ok, true);
+  // Format the result in USD
+  const formatted = formatMoney(convertResult.value, 'USD');
+  assert.equal(formatted.startsWith('$'), true);
