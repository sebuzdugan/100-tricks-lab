+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mergeCustomers } from '../src/customers.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('mergeCustomers removes from customer and updates invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 3, discountPercent: 0 }]
+  });
+
+  const invoices = [r1.value, r2.value];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.customers[0].id, 'C-002');
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  assert.equal(result.value.invoices[1].customerId, 'C-002');
+});
+
+test('mergeCustomers returns CUSTOMER_NOT_FOUND if fromId missing', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  const result = mergeCustomers(customers, [], 'C-999', 'C-002');
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('mergeCustomers returns CUSTOMER_NOT_FOUND if intoId missing', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  const result = mergeCustomers(customers, [], 'C-001', 'C-999');
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('mergeCustomers returns SAME_CUSTOMER if both ids are same', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  const result = mergeCustomers(customers, [], 'C-001', 'C-001');
+
+  assert.deepEqual(result, { ok: false, error: 'SAME_CUSTOMER' });
+});
+
+test('mergeCustomers with case-insensitive customer IDs', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  const r1 = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const invoices = [r1.value];
+
+  const result = mergeCustomers(customers, invoices, 'c-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
