+
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const invoices = [r1.value];
+  const originalCustomerCount = customers.length;
+  const originalInvoiceCount = invoices.length;
+
+  mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(customers.length, originalCustomerCount);
+  assert.equal(invoices.length, originalInvoiceCount);
+  assert.equal(invoices[0].customerId, 'C-001');
+});
+
+test('mergeCustomers with multiple invoices from fromId', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }]
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 3, discountPercent: 0 }]
+  });
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }]
+  });
+
+  const invoices = [r1.value, r2.value, r3.value];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  assert.equal(result.value.invoices[1].customerId, 'C-002');
+  assert.equal(result.value.invoices[2].customerId, 'C-002');
+});
+
+test('mergeCustomers with no invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  const result = mergeCustomers(customers, [], 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('mergeCustomers preserves other customers', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' },
+    { id: 'C-003', name: 'Charlie Corp', email: 'charlie@example.com', country: 'DE', tier: 'silver' }
+  ];
+
+  const result = mergeCustomers(customers, [], 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 2);
+  const ids = result.value.customers.map((c) => c.id);
+  assert.ok(ids.includes('C-002'));
+  assert.ok(ids.includes('C-003'));
+});
+
+test('mergeCustomers preserves invoice data', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14'
+  });
+
+  const issued = issueInvoice(r1.value, []).value;
+  const invoices = [issued];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  const mergedInvoice = result.value.invoices[0];
+  assert.equal(mergedInvoice.customerId, 'C-002');
+  assert.equal(mergedInvoice.number, 'INV-2024-0001');
+  assert.equal(mergedInvoice.issueDate, '2024-01-15');
+  assert.equal(mergedInvoice.terms, 'NET14');
+  assert.equal(mergedInvoice.status, 'issued');
+});
+
+test('mergeCustomers with mixed case and spaces', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  // Test with mixed case and spaces
+  const result = mergeCustomers(customers, [], '  c-001  ', '  C-002  ');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  const ids = result.value.customers.map((c) => c.id);
+  assert.ok(ids.includes('C-002'));
+  assert.ok(!ids.includes('C-001'));
+});
+
+test('mergeCustomers SAME_CUSTOMER with case variations', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  // Same customer with different case
+  const result = mergeCustomers(customers, [], 'c-001', 'C-001');
+
+  assert.deepEqual(result, { ok: false, error: 'SAME_CUSTOMER' });
+});
+
+test('mergeCustomers returns copied objects', () => {
+  const customers = [
+    { id: 'C-001', name: 'Acme', email: 'acme@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Baker Inc', email: 'baker@example.com', country: 'UK', tier: 'standard' }
+  ];
+
+  const result = mergeCustomers(customers, [], 'C-001', 'C-002');
+
+  // Verify objects are copies, not references
+  result.value.customers[0].name = 'Modified';
+  assert.equal(customers[1].name, 'Baker Inc');
+});
