+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty * unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 50 }), 50);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 1000 }), 100000);
+});
+
+test('lineTotal with zero quantity', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 8500 }), 0);
+});
+
+test('lineDiscount calculates discount amount', () => {
+  // 42500 * 10% = 4250
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 8500, discountPercent: 10 }), 4250);
+  // 42500 * 0% = 0
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 8500, discountPercent: 0 }), 0);
+  // 42500 * 100% = 42500
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 8500, discountPercent: 100 }), 42500);
+});
+
+test('lineDiscount defaults to 0 if no discountPercent', () => {
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 8500 }), 0);
+});
+
+test('lineDiscount clamps at 0', () => {
+  // Even with rounding errors, should not be negative
+  const result = lineDiscount({ qty: 5, unitPrice: 8500, discountPercent: 0.0001 });
+  assert.ok(result >= 0);
+});
+
+test('lineDiscount with decimal discount percent', () => {
+  // 5000 * 12.5% = 625
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 50, discountPercent: 12.5 }), 625);
+});
+
+test('lineVAT calculates VAT on amount after discount', () => {
+  // 42500 - 0 = 42500, 42500 * 21% = 8925
+  assert.equal(lineVAT({ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }), 8925);
+  // 42500 - 4250 = 38250, 38250 * 21% = 8032.5 -> 8032
+  assert.equal(lineVAT({ qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 }), 8032);
+});
+
+test('lineVAT for VAT-exempt item', () => {
+  // VAT rate 0
+  assert.equal(lineVAT({ qty: 1, unitPrice: 60000, discountPercent: 0, vatRate: 0 }), 0);
+});
+
+test('lineVAT clamps at 0', () => {
+  const result = lineVAT({ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 0 });
+  assert.ok(result >= 0);
+});
+
+test('lineVAT defaults to 0 if no discountPercent', () => {
+  assert.equal(lineVAT({ qty: 5, unitPrice: 8500, vatRate: 21 }), 8925);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }]
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 8925);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 51425);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 }
+    ]
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 47500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 9975);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 57475);
+});
+
+test('invoiceTotals with discount', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 }]
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.vat, 8032);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 46282);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+    voucher: { code: 'SAVE', amount: 5000 }
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 8925);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 46425);
+});
+
+test('invoiceTotals without voucher defaults to 0', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }]
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals clamps total at 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    voucher: { code: 'BIG', amount: 10000 }
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 60000, discountPercent: 0, vatRate: 0 }
+    ]
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 102500);
+  assert.equal(totals.vat, 8925); // Only on first line
+  assert.equal(totals.total, 111425);
+});
+
+test('invoiceTotals with all line features', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+      { qty: 100, unitPrice: 50, discountPercent: 5, vatRate: 21 }
+    ],
+    voucher: { code: 'SAVE10', amount: 1000 }
+  };
+
+  const totals = invoiceTotals(invoice);
+  // First line: 42500 - 4250 = 38250, VAT: 8032
+  // Second line: 5000 - 250 = 4750, VAT: 997.5 -> 998
+  // Subtotal: 47500, Discount: 4500, VAT: 9030, Voucher: 1000
+  // Total: 47500 - 4500 + 9030 - 1000 = 51030
+  assert.equal(totals.subtotal, 47500);
+  assert.equal(totals.discount, 4500);
+  assert.equal(totals.vat, 9030);
+  assert.equal(totals.voucher, 1000);
+  assert.equal(totals.total, 51030);
+});
+
+test('lineTotal uses qty and unitPrice', () => {
+  const line = { qty: 10, unitPrice: 1500 };
+  assert.equal(lineTotal(line), 15000);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = { lines: [] };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals calculation order', () => {
+  // Verify: total = subtotal - discount + vat - voucher
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+    voucher: { code: 'X', amount: 500 }
+  };
+
+  const totals = invoiceTotals(invoice);
+  const calculated = totals.subtotal - totals.discount + totals.vat - totals.voucher;
+  assert.equal(totals.total, calculated);
+});
