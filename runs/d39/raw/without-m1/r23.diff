 }
 
 /**
- * Calculate the discount amount for a line item (lineTotal × discountPercent / 100, clamped at 0).
+ * Calculate the discount amount for a line item (lineTotal × discountPercent / 100 + bulk discount if qty >= 10, clamped at 0).
+ * Bulk discount of 2.5% is applied after the line discount to the remaining amount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
  * @returns {number}
  */
 export function lineDiscount(line) {
   const discountPercent = line.discountPercent ?? 0;
-  const discount = roundCents(lineTotal(line) * discountPercent / 100);
-  return Math.max(0, discount);
+  const total = lineTotal(line);
+  const lineDiscountAmount = roundCents(total * discountPercent / 100);
+
+  // Apply bulk discount (2.5%) to what remains after line discount
+  let totalDiscount = lineDiscountAmount;
+  if (line.qty >= 10) {
+    const remainingAfterLineDiscount = total - lineDiscountAmount;
+    const bulkDiscountAmount = roundCents(remainingAfterLineDiscount * 2.5 / 100);
+    totalDiscount = lineDiscountAmount + bulkDiscountAmount;
+  }
+
+  return Math.max(0, totalDiscount);
 }
 
