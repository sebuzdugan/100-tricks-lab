+/**
+ * Get a dashboard summary of invoicing metrics.
+ * @param {Array<{ status: string, customerId: string, number?: string, dueDate?: string, lines: Array, payments?: Array }>} invoices
+ * @param {string} asOf date string in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0
+  };
+
+  let outstanding = 0;
+  const customerDue = {};
+
+  invoices.forEach((inv) => {
+    if (inv.status in counts) {
+      counts[inv.status]++;
+    }
+
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const due = balanceDue(inv);
+      outstanding += due;
+
+      if (!customerDue[inv.customerId]) {
+        customerDue[inv.customerId] = 0;
+      }
+      customerDue[inv.customerId] += due;
+    }
+  });
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue.reduce((sum, inv) => sum + inv.due, 0);
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount
+    },
+    topCustomers
+  };
+}
