+test('renderInvoiceText line order: discount, voucher, VAT, total, due, paid', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+    terms: 'NET14'
+  });
+
+  const withVoucher = applyVoucher(r.value, { code: 'SAVE10', amount: 3000 });
+  const issued = issueInvoice(withVoucher.value, []).value;
+  const paid = recordPayment(issued, { amount: 20000, date: '2024-01-20' }).value;
+  const text = renderInvoiceText(paid);
+
+  const lines = text.split('\n');
+  const discountIdx = lines.findIndex((l) => l.startsWith('Discount:'));
+  const voucherIdx = lines.findIndex((l) => l.startsWith('Voucher:'));
+  const vatIdx = lines.findIndex((l) => l.startsWith('VAT:'));
+  const totalIdx = lines.findIndex((l) => l.startsWith('Total:'));
+  const dueIdx = lines.findIndex((l) => l.startsWith('Due:'));
+  const paidIdx = lines.findIndex((l) => l.startsWith('Paid:'));
+
+  // All should exist
+  assert.ok(discountIdx >= 0, 'Discount line exists');
+  assert.ok(voucherIdx >= 0, 'Voucher line exists');
+  assert.ok(vatIdx >= 0, 'VAT line exists');
+  assert.ok(totalIdx >= 0, 'Total line exists');
+  assert.ok(dueIdx >= 0, 'Due line exists');
+  assert.ok(paidIdx >= 0, 'Paid line exists');
+
+  // Order: discount < voucher < VAT < total < due < paid
+  assert.ok(discountIdx < voucherIdx, 'Discount before voucher');
+  assert.ok(voucherIdx < vatIdx, 'Voucher before VAT');
+  assert.ok(vatIdx < totalIdx, 'VAT before total');
+  assert.ok(totalIdx < dueIdx, 'Total before due');
+  assert.ok(dueIdx < paidIdx, 'Due before paid');
+});
