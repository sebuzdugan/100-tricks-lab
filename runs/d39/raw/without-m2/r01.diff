@@ -0,0 +1,170 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice returns a draft invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2025-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+
+  // Check first line
+  assert.deepEqual(result.value.lines[0], {
+    sku: 'DEV-HOUR',
+    name: 'Development (hour)',
+    qty: 5,
+    unitPrice: 9500,
+    vatRate: 21,
+  });
+
+  // Check second line
+  assert.deepEqual(result.value.lines[1], {
+    sku: 'LOGO-PACK',
+    name: 'Logo package',
+    qty: 1,
+    unitPrice: 120000,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice fails with CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice fails with DATE_INVALID for malformed dates', () => {
+  const badDates = [
+    '2025-1-15',
+    '2025-01-5',
+    '25-01-15',
+    '2025/01/15',
+    '01-15-2025',
+    'invalid',
+    '',
+  ];
+
+  for (const date of badDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, false, `date "${date}" should be invalid`);
+    assert.equal(result.error, 'DATE_INVALID', `date "${date}" should fail with DATE_INVALID`);
+  }
+});
+
+test('createInvoice fails with DATE_INVALID for impossible dates', () => {
+  const impossibleDates = [
+    '2025-02-30',
+    '2025-04-31',
+    '2025-13-01',
+    '2025-00-15',
+  ];
+
+  for (const date of impossibleDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, false, `date "${date}" should be impossible`);
+    assert.equal(result.error, 'DATE_INVALID', `date "${date}" should fail with DATE_INVALID`);
+  }
+});
+
+test('createInvoice fails with NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice fails with NO_LINES for undefined lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: undefined,
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NO_LINES');
+});
+
+test('createInvoice fails with QTY_INVALID for invalid quantities', () => {
+  const badQtys = [0, -1, -100, 1.5, NaN, Infinity];
+
+  for (const qty of badQtys) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      lines: [{ sku: 'DEV-HOUR', qty }],
+    });
+    assert.equal(result.ok, false, `qty ${qty} should be invalid`);
+    assert.equal(result.error, 'QTY_INVALID', `qty ${qty} should fail with QTY_INVALID`);
+  }
+});
+
+test('createInvoice fails with UNKNOWN_SKU for unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice fails on first error only', () => {
+  // Test that it fails on customer first, before checking lines
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: 'invalid',
+    lines: [],
+  });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice works with various SKUs and quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-12-01',
+    lines: [
+      { sku: 'ICON-SET', qty: 2 },
+      { sku: 'WORKSHOP-DAY', qty: 3 },
+      { sku: 'PRINT-A4', qty: 100 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].qty, 2);
+  assert.equal(result.value.lines[1].qty, 3);
+  assert.equal(result.value.lines[2].qty, 100);
+  assert.equal(result.value.lines[0].vatRate, 21);
+  assert.equal(result.value.lines[1].vatRate, 0);
+  assert.equal(result.value.lines[2].vatRate, 9);
+});
