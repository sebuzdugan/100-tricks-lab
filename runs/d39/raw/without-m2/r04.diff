diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..f67bca2
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2025-01-15');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments the counter', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(existing, '2025-06-10');
+  assert.equal(number, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = ['INV-2025-0009'];
+  const number = nextInvoiceNumber(existing, '2025-03-20');
+  assert.equal(number, 'INV-2025-0010');
+});
+
+test('nextInvoiceNumber handles counter > 9999', () => {
+  const existing = Array.from({ length: 10001 }, (_, i) =>
+    `INV-2025-${String(i + 1).padStart(4, '0')}`
+  );
+  const number = nextInvoiceNumber(existing, '2025-12-31');
+  assert.equal(number, 'INV-2025-10002');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-9999', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber resets counter each year', () => {
+  const existing = [
+    'INV-2024-0001',
+    'INV-2024-0002',
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2025-0003',
+  ];
+  const number2025 = nextInvoiceNumber(existing, '2025-12-31');
+  const number2026 = nextInvoiceNumber(existing, '2026-01-01');
+
+  assert.equal(number2025, 'INV-2025-0004');
+  assert.equal(number2026, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber handles unsorted existing numbers', () => {
+  const existing = ['INV-2025-0003', 'INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(number, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber ignores invalid numbers', () => {
+  const existing = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INVALID',
+    'INV-2025-ABC',
+    'INV-other-0003',
+  ];
+  const number = nextInvoiceNumber(existing, '2025-06-15');
+  assert.equal(number, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber works with year boundaries', () => {
+  const existing = ['INV-2024-9999', 'INV-2025-0001', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2025-12-31');
+  assert.equal(number, 'INV-2025-0002');
+});
