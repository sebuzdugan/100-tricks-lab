+import { getCustomer } from './customers.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+import { formatEuros } from './money.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  lines.push(invoice.number ?? 'DRAFT');
+
+  // Customer name
+  const customerResult = getCustomer(invoice.customerId);
+  if (customerResult.ok) {
+    lines.push(customerResult.value.name);
+  }
+
+  // Item lines
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Total line
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..8e5bbf4
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,221 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issueResult = issueInvoice(result.value, []);
+  assert.equal(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2025-0001');
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows items with qty, name, unit price, and total', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  // Line with the item
+  assert.match(lines[2], /^5 Development \(hour\)/);
+  assert.match(lines[2], /€95\.00/); // unit price
+  assert.match(lines[2], /€475\.00/); // line total
+});
+
+test('renderInvoiceText formats prices with formatEuros', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  // LOGO-PACK is 120000 cents = €1,200.00
+  assert.match(lines[2], /€1,200\.00/);
+});
+
+test('renderInvoiceText shows total line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 }, // 5 * 9500 = 47500
+      { sku: 'LOGO-PACK', qty: 1 }, // 1 * 120000 = 120000
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  const totalLine = lines[lines.length - 1];
+  assert.match(totalLine, /^Total: €/);
+  // Total should be 47500 + 120000 = 167500 = €1,675.00
+  assert.match(totalLine, /€1,675\.00/);
+});
+
+test('renderInvoiceText with single item', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'SUPPORT-HOUR', qty: 3 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.match(lines[2], /^3 Support \(hour\)/);
+  assert.match(lines[3], /^Total: €/);
+});
+
+test('renderInvoiceText with multiple items', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-02-20',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 4 },
+      { sku: 'ICON-SET', qty: 3 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Kite & Co');
+  assert.equal(lines.length, 6); // DRAFT, customer, 3 items, total
+  assert.match(lines[2], /^2 Development \(hour\)/);
+  assert.match(lines[3], /^4 Copywriting \(hour\)/);
+  assert.match(lines[4], /^3 Icon set/);
+  assert.match(lines[5], /^Total: €/);
+});
+
+test('renderInvoiceText preserves line breaks structure', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // DRAFT, customer, 2 items, total
+  assert(lines[0]); // invoice number
+  assert(lines[1]); // customer
+  assert(lines[2]); // first item
+  assert(lines[3]); // second item
+  assert(lines[4]); // total
+});
+
+test('renderInvoiceText with issued invoice and full data', () => {
+  const createResult = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2025-03-10',
+    lines: [
+      { sku: 'PRINT-A4', qty: 500 },
+      { sku: 'PRINT-A3', qty: 100 },
+    ],
+  });
+
+  assert.equal(createResult.ok, true);
+  const issueResult = issueInvoice(createResult.value, ['INV-2025-0001']);
+  assert.equal(issueResult.ok, true);
+
+  const text = renderInvoiceText(issueResult.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2025-0002'); // next number
+  assert.equal(lines[1], 'Lumen Records');
+  assert.match(lines[2], /^500 Printed flyer A4/);
+  assert.match(lines[3], /^100 Printed poster A3/);
+  assert.match(lines[4], /^Total: €/);
+});
+
+test('renderInvoiceText formats small amounts correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  // STICKER is 50 cents = €0.50
+  assert.match(lines[2], /€0\.50/);
+  assert.match(lines[3], /€0\.50/);
+});
+
+test('renderInvoiceText with high-value items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'BRAND-BOOK', qty: 2 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
+  // BRAND-BOOK is 245000 cents = €2,450.00
+  assert.match(lines[2], /€2,450\.00/);
+  // Total is 2 * €2,450.00 = €4,900.00
+  assert.match(lines[3], /€4,900\.00/);
+});
