+
+test('renderInvoiceText shows discount on line items', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
+  const lines = text.split('\n');
