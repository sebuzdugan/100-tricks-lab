+
+test('renderInvoiceText shows subtotal and discount in total line when discounts present', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1, discountPercent: 20 },
+      { sku: 'LOGO-PACK', qty: 1, discountPercent: 10 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+
