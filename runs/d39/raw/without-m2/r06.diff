+  const totalLine = lines[lines.length - 1];
+
+  // Should show subtotal, discount, and total
+  assert.match(totalLine, /Subtotal:/);
+  assert.match(totalLine, /Discount:/);
+  assert.match(totalLine, /Total:/);
+  // Subtotal should be 95 + 1200 = 1295
+  assert.match(totalLine, /€1,295\.00/);
+  // Discount should be 19 + 120 = 139
+  assert.match(totalLine, /-€139\.00/);
+  // Total should be 1295 - 139 = 1156
+  assert.match(totalLine, /€1,156\.00/);
+});
+
