+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * All dates are interpreted in UTC.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  // Check format YYYY-MM-DD
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+
+  // Parse as UTC date
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+
+  // Check that the date string matches what we'd get back (e.g., reject 2023-02-30)
+  if (date.toISOString().split('T')[0] !== text) return false;
+
+  return true;
+}
+
+/**
+ * Add n days to a date string and return the result.
+ * Dates are in UTC.
+ * @param {string} date in YYYY-MM-DD format
+ * @param {number} n number of days to add (can be negative)
+ * @returns {string} new date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of whole days between two dates (b minus a).
+ * Dates are in UTC. Results are rounded towards zero.
+ * @param {string} a start date in YYYY-MM-DD format
+ * @param {string} b end date in YYYY-MM-DD format
+ * @returns {number} number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
