diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..b6b72bc
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,121 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-01-15'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2025-1-15'), false); // missing leading zero
+  assert.equal(isValidDate('2025-01-5'), false); // missing leading zero
+  assert.equal(isValidDate('25-01-15'), false); // 2-digit year
+  assert.equal(isValidDate('2025/01/15'), false); // wrong separator
+  assert.equal(isValidDate('01-15-2025'), false); // wrong order
+  assert.equal(isValidDate(''), false); // empty string
+  assert.equal(isValidDate('2025-01-15T12:00:00'), false); // includes time
+});
+
+test('isValidDate rejects impossible dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false); // no Feb 30
+  assert.equal(isValidDate('2025-04-31'), false); // no April 31
+  assert.equal(isValidDate('2025-13-01'), false); // month 13
+  assert.equal(isValidDate('2025-00-15'), false); // month 0
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate accepts leap year Feb 29', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-01-15', 1), '2025-01-16');
+  assert.equal(addDays('2025-01-15', 5), '2025-01-20');
+  assert.equal(addDays('2025-01-15', 30), '2025-02-14');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // leap year
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays with negative days', () => {
+  assert.equal(addDays('2025-01-15', -1), '2025-01-14');
+  assert.equal(addDays('2025-01-15', -5), '2025-01-10');
+  assert.equal(addDays('2025-02-14', -30), '2025-01-15');
+});
+
+test('addDays with negative days crossing boundaries', () => {
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+  assert.equal(addDays('2025-03-01', -1), '2025-02-28');
+  assert.equal(addDays('2024-03-01', -1), '2024-02-29'); // leap year
+});
+
+test('addDays with zero days', () => {
+  assert.equal(addDays('2025-01-15', 0), '2025-01-15');
+});
+
+test('daysBetween calculates forward days', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-16'), 1);
+  assert.equal(daysBetween('2025-01-15', '2025-01-20'), 5);
+  assert.equal(daysBetween('2025-01-15', '2025-02-14'), 30);
+});
+
+test('daysBetween calculates backward days', () => {
+  assert.equal(daysBetween('2025-01-16', '2025-01-15'), -1);
+  assert.equal(daysBetween('2025-01-20', '2025-01-15'), -5);
+  assert.equal(daysBetween('2025-02-14', '2025-01-15'), -30);
+});
+
+test('daysBetween with same date', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-15'), 0);
+});
+
+test('daysBetween crossing month boundaries', () => {
+  assert.equal(daysBetween('2025-01-31', '2025-02-01'), 1);
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1);
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2); // leap year
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('daysBetween crossing year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2024-12-31'), -1);
+});
+
+test('daysBetween with large gaps', () => {
+  assert.equal(daysBetween('2025-01-01', '2025-12-31'), 364); // 365 days in year, -1 for same day offset
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // leap year 2024 has 366 days
+  assert.equal(daysBetween('2025-01-01', '2030-01-01'), 365 * 5 + 1); // 1 leap year (2028)
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const start = '2025-01-15';
+  const days = 100;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+});
+
+test('addDays and daysBetween with negative days', () => {
+  const start = '2025-06-15';
+  const days = -50;
+  const end = addDays(start, days);
+  assert.equal(daysBetween(start, end), days);
+  assert.equal(daysBetween(end, start), -days);
+});
