+import { isValidDate, addDays, daysBetween, calculateDueDate } from '../src/dates.js';
 
 test('isValidDate accepts valid dates', () => {
   assert.equal(isValidDate('2025-01-15'), true);
@@ -119,3 +119,27 @@ test('addDays and daysBetween with negative days', () => {
   assert.equal(daysBetween(start, end), days);
   assert.equal(daysBetween(end, start), -days);
 });
+
+test('calculateDueDate with NET14 terms', () => {
+  assert.equal(calculateDueDate('2025-01-15', 'NET14'), '2025-01-29');
+  assert.equal(calculateDueDate('2025-12-20', 'NET14'), '2026-01-03');
+});
+
+test('calculateDueDate with NET30 terms', () => {
+  assert.equal(calculateDueDate('2025-01-15', 'NET30'), '2025-02-14');
+  assert.equal(calculateDueDate('2025-12-05', 'NET30'), '2026-01-04');
+});
+
+test('calculateDueDate with EOM terms', () => {
+  assert.equal(calculateDueDate('2025-01-15', 'EOM'), '2025-01-31');
+  assert.equal(calculateDueDate('2025-02-15', 'EOM'), '2025-02-28');
+  assert.equal(calculateDueDate('2024-02-15', 'EOM'), '2024-02-29'); // leap year
+  assert.equal(calculateDueDate('2025-04-10', 'EOM'), '2025-04-30');
+  assert.equal(calculateDueDate('2025-12-25', 'EOM'), '2025-12-31');
+});
+
+test('calculateDueDate with invalid terms', () => {
+  assert.equal(calculateDueDate('2025-01-15', 'INVALID'), null);
+  assert.equal(calculateDueDate('2025-01-15', 'NET60'), null);
+  assert.equal(calculateDueDate('2025-01-15', ''), null);
+});
