--- a/src/dates.js
+++ b/src/dates.js
@@ -44,3 +44,29 @@ export function daysBetween(a, b) {
   const diffMs = dateB.getTime() - dateA.getTime();
   return Math.floor(diffMs / (1000 * 60 * 60 * 24));
 }
+
+/**
+ * Calculate the due date based on payment terms.
+ * Terms: 'NET14' (14 days), 'NET30' (30 days), 'EOM' (end of month)
+ * @param {string} issueDate in YYYY-MM-DD format
+ * @param {string} terms 'NET14', 'NET30', or 'EOM'
+ * @returns {string | null} due date in YYYY-MM-DD format, or null if terms is invalid
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    // Get the last day of the issue month
+    const [year, month] = issueDate.split('-');
+    // Create a date for the 1st of next month, then subtract 1 day
+    const nextMonth = new Date(`${year}-${month}-01T00:00:00Z`);
+    nextMonth.setUTCMonth(nextMonth.getUTCMonth() + 1);
+    const lastDay = new Date(nextMonth.getTime() - 24 * 60 * 60 * 1000);
+    return lastDay.toISOString().split('T')[0];
+  }
+  return null;
+}
