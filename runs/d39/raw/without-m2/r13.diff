+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * @param {{ lines: Array, voucher?: { amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
   const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
-  const total = Math.max(0, subtotal - discount + vat);
-  return { subtotal, discount, vat, total };
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return { subtotal, discount, vat, voucher, total };
 }
 
 /**
@@ -258,3 +259,33 @@ export function issueInvoice(invoice, existingNumbers) {
     lines: invoice.lines.map((line) => ({ ...line })),
   });
 }
+
+/**
+ * Apply a voucher to a draft invoice.
+ * @param {{ status: string, voucher?: any, customerId: string, issueDate: string, lines: Array }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check if invoice is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if voucher already exists
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Apply voucher
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    terms: invoice.terms,
+    dueDate: invoice.dueDate,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    voucher: { code, amount },
+  });
+}
