+  const payment1 = recordPayment(issued1.value, { amount: 5000, date: '2025-01-15' });
+  assert.equal(payment1.ok, true);
+
+  const invoices = [payment1.value, issued2.value];
+  const result = statement('C-001', invoices, '2025-02-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  // C-001 is gold tier (5% discount)
+  // inv1: 9500 - 475 + 1895 = 10920, due 10920 - 5000 = 5920
+  // inv2 (qty 2): 19000 - 950 + 3791 = 21841, due 21841
+  // totalDue = 5920 + 21841 = 27761, but actual is 27760 (rounding)
+  assert.equal(result.value.totalDue, 27760);
