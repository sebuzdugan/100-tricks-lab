+  assert.equal(issued.ok, true);
+
+  const existingNumbers = ['CN-2025-9999', 'CN-2025-10000'];
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Refund', date: '2025-01-20' }, existingNumbers);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-10001');
+});
+
+test('createCreditNote includes all required fields', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
