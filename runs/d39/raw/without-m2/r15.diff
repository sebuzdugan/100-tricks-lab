+});
+
+test('createCreditNote numbers start at 0001 for a new year', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
