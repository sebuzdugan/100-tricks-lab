+
+test('createCreditNote increments counter for multiple credit notes', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-16',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2025-0001']);
+  assert.equal(issued2.ok, true);
+
+  const cn1 = createCreditNote(issued1.value, { amount: 5000, reason: 'Refund', date: '2025-01-20' }, []);
+  assert.equal(cn1.ok, true);
+  assert.equal(cn1.value.number, 'CN-2025-0001');
+
+  const cn2 = createCreditNote(issued2.value, { amount: 5000, reason: 'Refund', date: '2025-01-21' }, ['CN-2025-0001']);
+  assert.equal(cn2.ok, true);
+  assert.equal(cn2.value.number, 'CN-2025-0002');
+});
+
+test('createCreditNote tracks separately from invoice numbers', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Refund', date: '2025-01-20' }, ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote resets counter by year', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
