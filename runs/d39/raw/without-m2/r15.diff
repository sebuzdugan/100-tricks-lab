+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Partial refund', date: '2025-01-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+  assert.equal(result.value.invoiceNumber, issued.value.number);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Partial refund');
+  assert.equal(result.value.date, '2025-01-20');
+});
+
+test('createCreditNote works for partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment = recordPayment(issued.value, { amount: 5000, date: '2025-01-20' });
+  assert.equal(payment.ok, true);
+
+  const result = createCreditNote(payment.value, { amount: 2000, reason: 'Adjustment', date: '2025-01-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote works for paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment = recordPayment(issued.value, { amount: 10920, date: '2025-01-20' });
+  assert.equal(payment.ok, true);
+
+  const result = createCreditNote(payment.value, { amount: 5000, reason: 'Overpayment refund', date: '2025-01-25' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote fails for draft invoices (NOT_ISSUED)', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+
+  const result = createCreditNote(inv.value, { amount: 5000, reason: 'Refund', date: '2025-01-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote fails with AMOUNT_INVALID for non-positive amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const badAmounts = [0, -1000, 1.5, NaN, Infinity];
+
+  for (const amount of badAmounts) {
+    const result = createCreditNote(issued.value, { amount, reason: 'Refund', date: '2025-01-20' }, []);
+    assert.equal(result.ok, false, `amount ${amount} should be invalid`);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  }
+});
+
+test('createCreditNote fails with CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const invoiceTotal = invoiceTotals(issued.value).total;
+  const result = createCreditNote(issued.value, { amount: invoiceTotal + 1, reason: 'Refund', date: '2025-01-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote validates date format (DATE_INVALID)', () => {
+  const inv = createInvoice({
