+
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Refund', date: '2025-1-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DATE_INVALID');
+});
+
+test('createCreditNote allows amount equal to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const invoiceTotal = invoiceTotals(issued.value).total;
+  const result = createCreditNote(issued.value, { amount: invoiceTotal, reason: 'Full refund', date: '2025-01-20' }, []);
+
+  assert.equal(result.ok, true);
