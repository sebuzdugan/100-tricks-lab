+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Get the next credit note number for a given date.
+ * Format: CN-<year>-<4-digit-counter>
+ * @param {string[]} existingNumbers
+ * @param {string} date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  // Find all credit note numbers for this year
+  const yearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length), 10))
+    .filter((num) => !isNaN(num));
+
+  // Get the highest counter for this year
+  const maxCounter = yearNumbers.length > 0 ? Math.max(...yearNumbers) : 0;
+
+  // Return the next number
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, total: number }} invoice
+ * @param {{ amount: number, reason: string, date: string }} opts
+ * @param {string[]} existingNumbers
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check if invoice is issued, partially_paid, or paid
+  if (invoice.status === 'draft') return fail('NOT_ISSUED');
+
+  // Validate date format
+  if (!isValidDate(date)) return fail('DATE_INVALID');
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice total
+  const invoiceTotal = invoiceTotals(invoice).total;
+
+  // Validate amount is not more than invoice total
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
