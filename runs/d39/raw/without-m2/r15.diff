+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const invoiceTotal = invoiceTotals(issued.value).total;
+  const testAmounts = [1, 100, 1000, invoiceTotal - 1];
+
+  for (const amount of testAmounts) {
+    const result = createCreditNote(issued.value, { amount, reason: 'Refund', date: '2025-01-20' }, []);
+    assert.equal(result.ok, true, `amount ${amount} should be valid`);
+    assert.equal(result.value.amount, amount);
+  }
+});
