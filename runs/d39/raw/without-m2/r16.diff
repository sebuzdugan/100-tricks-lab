+test('overdueInvoices with many invoices maintains sort order', () => {
+  const issuedInvoices = [];
+  const dates = ['2025-01-05', '2025-01-10', '2025-01-15', '2025-01-20', '2025-01-25'];
+
+  // Create 5 invoices with different due dates
+  for (let i = 0; i < 5; i++) {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: dates[i],
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+      terms: 'NET14',
+    });
+
+    assert.equal(inv.ok, true);
+    const existingNumbers = issuedInvoices.length > 0 ? [`INV-2025-${String(i).padStart(4, '0')}`] : [];
+    const issued = issueInvoice(inv.value, existingNumbers);
+    assert.equal(issued.ok, true);
+    issuedInvoices.push(issued.value);
+  }
+
+  // Shuffle the order before passing
+  const shuffled = [issuedInvoices[2], issuedInvoices[0], issuedInvoices[4], issuedInvoices[1], issuedInvoices[3]];
+
+  const result = overdueInvoices(shuffled, '2025-03-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 5);
+  // Should be sorted by daysOverdue descending
+  for (let i = 0; i < result.value.length - 1; i++) {
+    assert(result.value[i].daysOverdue >= result.value[i + 1].daysOverdue);
+  }
+});
