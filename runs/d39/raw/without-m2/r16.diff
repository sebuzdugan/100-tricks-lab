+import { fail } from './result.js';
+import { balanceDue } from './payments.js';
+import { daysBetween, isValidDate } from './dates.js';
+
+/**
+ * Get overdue invoices as of a given date.
+ * @param {Array} invoices list of invoices to filter
+ * @param {string} asOf date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: Array } | { ok: false, error: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Filter for issued or partially_paid invoices with dueDate before asOf
+  const overdue = invoices
+    .filter(
+      (inv) =>
+        (inv.status === 'issued' || inv.status === 'partially_paid') &&
+        inv.dueDate &&
+        daysBetween(inv.dueDate, asOf) > 0,
+    )
+    .map((inv) => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return { ok: true, value: overdue };
+}
