+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns invoices with dueDate before asOf', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+  // dueDate is 2025-01-29
+
+  const result = overdueInvoices([issued.value], '2025-02-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].number, issued.value.number);
+  assert.equal(result.value[0].customerId, 'C-001');
+  assert.equal(result.value[0].dueDate, '2025-01-29');
+  assert.equal(result.value[0].daysOverdue, 17); // Feb 15 - Jan 29
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+
+  const result = overdueInvoices([inv.value], '2025-02-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
