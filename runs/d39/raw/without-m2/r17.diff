+test('vatSummary returns VAT summary for issued invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const result = vatSummary([issued.value]);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].rate, 21);
+  // DEV-HOUR: 9500, gold tier discount 5%: base = 9500 - 475 = 9025, vat = 21% of 9025 = 1895
+  assert.equal(result.value[0].base, 9025);
+  assert.equal(result.value[0].vat, 1895);
+});
