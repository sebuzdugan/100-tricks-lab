+
+/**
+ * Get VAT summary for invoices, grouped by VAT rate.
+ * @param {Array} invoices list of invoices to summarize
+ * @returns {{ ok: true, value: Array }}
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  // Filter for issued, partially_paid, or paid invoices
+  const relevantInvoices = invoices.filter(
+    (inv) => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid',
+  );
+
+  // Process each line in each invoice
+  for (const invoice of relevantInvoices) {
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVat(line);
+
+      if (!vatMap[rate]) {
+        vatMap[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vat;
+    }
+  }
+
+  // Convert to array and sort by rate descending
+  const summary = Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+
+  return { ok: true, value: summary };
+}
