   return { ok: true, value: summary };
 }
+
+/**
+ * Calculate late fee for an invoice based on days overdue.
+ * Late fee is 0.04% per day of the amount still due.
+ * @param {{ dueDate: string, status: string }} invoice
+ * @param {string} asOf date in YYYY-MM-DD format
+ * @returns {number} late fee in cents
+ */
+export function lateFee(invoice, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) return 0;
+
+  // Only calculate late fee for issued, partially_paid, or paid invoices
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return 0;
+  }
+
+  // Check if invoice has a dueDate
+  if (!invoice.dueDate) return 0;
+
+  // Calculate days overdue
+  const daysOverdue = Math.max(0, daysBetween(invoice.dueDate, asOf));
+
+  // If not overdue, no late fee
+  if (daysOverdue === 0) return 0;
+
+  // Calculate late fee: 0.04% per day of the amount due
+  const due = balanceDue(invoice);
+  const fee = roundCents((due * 0.04 * daysOverdue) / 100);
+
+  return Math.max(0, fee);
+}
