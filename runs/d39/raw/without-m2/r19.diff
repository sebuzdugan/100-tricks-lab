+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns CSV string with header', () => {
+  const result = exportCsv([]);
+
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv exports a single issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+
+  assert(csv.includes('Northwind Studio'));
+  assert(csv.includes('INV-2025-0001'));
+  assert(csv.includes('2025-01-15'));
+  assert(csv.includes('issued'));
+  assert(csv.includes('95.00')); // subtotal before discount (9500 cents = 95.00 euros)
+  assert(csv.includes('109.20')); // total (10920 cents = 109.20 euros)
+});
+
+test('exportCsv formats amounts as plain euros with 2 decimals', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  const dataLine = lines[1];
+
+  // Check that amounts use dot decimal separator and have 2 decimals
+  assert(dataLine.match(/\d+\.\d{2}/)); // e.g., 9025.00
+  // Check no currency signs
+  assert(!dataLine.includes('€'));
+  assert(!dataLine.includes('$'));
+});
+
+test('exportCsv includes dueDate', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+
+  assert(csv.includes('2025-01-29')); // due date for NET14
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const inv = createInvoice({
+    customerId: 'C-004', // Smith, Jones & Partners
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const csv = exportCsv([issued.value]);
+
+  // Customer name contains a comma, should be quoted
+  assert(csv.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer name with double quote', () => {
+  const inv = createInvoice({
+    customerId: 'C-006', // Marlow "The Print Shop"
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
