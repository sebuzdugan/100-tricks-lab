+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format amount in cents as euros with 2 decimals and a dot.
+ * @param {number} cents amount in cents
+ * @returns {string} formatted as "1234.50"
+ */
+function formatEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: add double quotes if it contains comma or quote,
+ * and double any quotes inside it.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  // Convert to string if needed
+  const str = String(field);
+
+  // If field contains comma or double quote, wrap in quotes and escape quotes
+  if (str.includes(',') || str.includes('"')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices list of invoices to export
+ * @returns {string} CSV data with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Process each invoice
+  for (const invoice of invoices) {
+    // Get customer name
+    let customerName = '';
+    const customerResult = getCustomer(invoice.customerId);
+    if (customerResult.ok) {
+      customerName = customerResult.value.name;
+    }
+
+    // Get totals
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    // Format amounts
+    const subtotal = formatEuros(totals.subtotal);
+    const discount = formatEuros(totals.discount);
+    const vat = formatEuros(totals.vat);
+    const total = formatEuros(totals.total);
+    const dueAmount = formatEuros(due);
+
+    // Build CSV line
+    const fields = [
+      invoice.number || '',
+      customerName,
+      invoice.issueDate || '',
+      invoice.dueDate || '',
+      invoice.status || '',
+      subtotal,
+      discount,
+      vat,
+      total,
+      dueAmount,
+    ];
+
+    const line = fields.map(escapeCsvField).join(',');
+    lines.push(line);
+  }
+
+  // Join with newlines and end with newline
+  return lines.join('\n') + '\n';
+}
