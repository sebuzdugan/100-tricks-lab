+test('exportCsv calculates due correctly for partially paid invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv.ok, true);
+  const issued = issueInvoice(inv.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment = recordPayment(issued.value, { amount: 5000, date: '2025-01-20' });
+  assert.equal(payment.ok, true);
+
+  const csv = exportCsv([payment.value]);
+
+  // Total is 10920 cents = 109.20 euros, paid 5000 cents = 50.00 euros, due is 5920 cents = 59.20 euros
+  assert(csv.includes('59.20'));
+});
+
+test('exportCsv handles multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-16',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2025-0001']);
+  assert.equal(issued2.ok, true);
+
+  const csv = exportCsv([issued1.value, issued2.value]);
