+  // Header + 2 data lines + empty line at end
+  assert.equal(lines.length, 4);
+  assert(lines[1].includes('INV-2025-0001'));
+  assert(lines[2].includes('INV-2025-0002'));
+});
+
+test('exportCsv maintains invoice order', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv1.ok, true);
+  const issued1 = issueInvoice(inv1.value, []);
+  assert.equal(issued1.ok, true);
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv2.ok, true);
+  const issued2 = issueInvoice(inv2.value, ['INV-2025-0001']);
+  assert.equal(issued2.ok, true);
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-03',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(inv3.ok, true);
+  const issued3 = issueInvoice(inv3.value, ['INV-2025-0001', 'INV-2025-0002']);
+  assert.equal(issued3.ok, true);
+
+  const csv = exportCsv([issued2.value, issued3.value, issued1.value]);
+  const lines = csv.split('\n');
+
+  assert.equal(lines[1].split(',')[0], 'INV-2025-0002');
+  assert.equal(lines[2].split(',')[0], 'INV-2025-0003');
+  assert.equal(lines[3].split(',')[0], 'INV-2025-0001');
+});
+
+test('exportCsv CSV lines end with newline', () => {
