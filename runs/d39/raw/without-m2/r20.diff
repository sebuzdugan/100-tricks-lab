index fadf486..dc04132 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,14 @@
 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +48,49 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount from euros (cents) to another currency.
+ * @param {number} cents amount in euros (cents)
+ * @param {string} currency target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const converted = roundCents(cents * rate);
+  return ok(converted);
+}
+
+/**
+ * Format cents as money in the specified currency.
+ * @param {number} cents amount in the currency's cents
+ * @param {string} currency EUR, USD, or GBP
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const whole = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const frac = String(abs % 100).padStart(2, '0');
+
+  let symbol;
+  switch (currency) {
+    case 'EUR':
+      symbol = '€';
+      break;
+    case 'USD':
+      symbol = '$';
+      break;
+    case 'GBP':
+      symbol = '£';
+      break;
+    default:
+      symbol = currency;
+  }
+
+  return `${sign}${symbol}${whole}.${frac}`;
+}
