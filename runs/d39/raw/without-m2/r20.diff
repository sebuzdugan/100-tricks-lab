+
+test('RATES defined for EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(1000, 'USD');
+  assert.equal(result.ok, true);
+  // 1000 EUR cents = 10 EUR, 10 EUR * 1.085 = 10.85 USD = 1085 USD cents
+  assert.equal(result.value, 1085);
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(1000, 'GBP');
+  assert.equal(result.ok, true);
+  // 1000 EUR cents = 10 EUR, 10 EUR * 0.8425 = 8.425 GBP = 842.5 GBP cents, rounds to 842 (banker's rounding)
+  assert.equal(result.value, 842);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(1000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1000);
+});
+
+test('convert unknown currency returns error', () => {
+  const result = convert(1000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with large amount', () => {
+  const result = convert(123456, 'USD');
+  assert.equal(result.ok, true);
+  // 123456 * 1.085 = 133949.76, rounds to 133950
+  assert.equal(result.value, 133950);
+});
+
+test('convert with small amount', () => {
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  // 1 EUR cent = 0.01 EUR, 0.01 EUR * 1.085 = 0.01085 USD = 1.085 USD cents ≈ 1
+  assert.equal(result.value, 1);
+});
+
+test('convert negative amount', () => {
+  const result = convert(-1000, 'USD');
+  assert.equal(result.ok, true);
+  // -1000 EUR cents * 1.085 = -1085 USD cents
+  assert.equal(result.value, -1085);
+});
