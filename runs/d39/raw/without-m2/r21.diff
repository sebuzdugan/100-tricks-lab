+test('mergeCustomers removes fromId and reassigns invoices', () => {
+  const customers = listCustomers();
+  const invoices = [
+    { customerId: 'C-001', number: 'INV-2025-0001', total: 1000 },
+    { customerId: 'C-002', number: 'INV-2025-0002', total: 2000 },
+    { customerId: 'C-001', number: 'INV-2025-0003', total: 3000 },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, customers.length - 1);
+  assert(!result.value.customers.find((c) => c.id === 'C-001'));
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  assert.equal(result.value.invoices[2].customerId, 'C-002');
+});
