diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..42008f7
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,63 @@
+import { roundCents } from './money.js';
+
+/**
+ * Validate a discount percent value.
+ * @param {unknown} discountPercent
+ * @returns {boolean}
+ */
+export function isValidDiscountPercent(discountPercent) {
+  return (
+    typeof discountPercent === 'number' &&
+    !Number.isNaN(discountPercent) &&
+    discountPercent >= 0 &&
+    discountPercent <= 100
+  );
+}
+
+/**
+ * Calculate the total for a single line (quantity times unit price).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount for a single line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  if (!line.discountPercent) return 0;
+  const total = lineTotal(line);
+  const discount = roundCents((total * line.discountPercent) / 100);
+  return Math.max(0, discount);
+}
+
+/**
+ * Calculate VAT for a single line (on the amount after discount).
+ * @param {{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineVat(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = Math.max(0, total - discount);
+  const vat = roundCents((amountAfterDiscount * line.vatRate) / 100);
+  return Math.max(0, vat);
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * @param {{ lines: Array, voucher?: { amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return { subtotal, discount, vat, voucher, total };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
