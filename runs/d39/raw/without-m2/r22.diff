+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals, isValidDiscountPercent } from '../src/totals.js';
+
+test('lineTotal returns qty * unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 9500 }), 47500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 120000 }), 120000);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 1000 }), 10000);
+});
+
+test('lineTotal with zero quantity', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 9500 }), 0);
+});
+
+test('lineTotal ignores other line properties', () => {
+  assert.equal(
+    lineTotal({
+      qty: 5,
+      unitPrice: 9500,
+      name: 'Development (hour)',
+      sku: 'DEV-HOUR',
+      vatRate: 21,
+      discountPercent: 5,
+    }),
+    47500
+  );
+});
+
+test('lineDiscount returns 0 for no discount', () => {
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 9500 }), 0);
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 9500, discountPercent: 0 }), 0);
+});
+
+test('lineDiscount calculates percentage discount and rounds', () => {
+  // 5 * 9500 = 47500, discount 5% = 2375
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 9500, discountPercent: 5 }), 2375);
+  // 1 * 120000 = 120000, discount 5% = 6000
+  assert.equal(lineDiscount({ qty: 1, unitPrice: 120000, discountPercent: 5 }), 6000);
+});
+
+test('lineDiscount with decimal discount percent', () => {
+  // 5 * 9500 = 47500, discount 2.5% = 1187.5 rounds to 1188
+  assert.equal(lineDiscount({ qty: 5, unitPrice: 9500, discountPercent: 2.5 }), 1188);
+});
+
+test('lineDiscount never negative', () => {
+  const line = { qty: 5, unitPrice: 9500, discountPercent: 5 };
+  assert(lineDiscount(line) >= 0);
+});
+
+test('lineVat returns 0 for no VAT rate', () => {
+  assert.equal(lineVat({ qty: 5, unitPrice: 9500, vatRate: 0 }), 0);
+});
+
+test('lineVat calculates on amount after discount', () => {
+  // 5 * 9500 = 47500, no discount, VAT 21% = 9975
+  const result1 = lineVat({ qty: 5, unitPrice: 9500, vatRate: 21 });
+  assert.equal(result1, 9975);
+
+  // 5 * 9500 = 47500, discount 5% = 2375, amount after discount = 45125
+  // VAT 21% of 45125 = 9476.25 rounds to 9476
+  const result2 = lineVat({ qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 5 });
+  assert.equal(result2, 9476);
+});
+
+test('lineVat with different VAT rates', () => {
+  const line = { qty: 10, unitPrice: 10000, vatRate: 6 };
+  // 10 * 10000 = 100000, VAT 6% = 6000
+  assert.equal(lineVat(line), 6000);
+});
+
+test('lineVat never negative', () => {
+  const line = { qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 100 };
+  assert(lineVat(line) >= 0);
+});
+
+test('invoiceTotals with single line, no discount, no voucher', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.deepEqual(result, {
+    subtotal: 47500,
+    discount: 0,
+    vat: 9975,
+    voucher: 0,
+    total: 57475,
+  });
+});
+
+test('invoiceTotals with single line, with discount', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 5 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.deepEqual(result, {
+    subtotal: 47500,
+    discount: 2375,
+    vat: 9476,
+    voucher: 0,
+    total: 54601,
+  });
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 5 },
+      { qty: 1, unitPrice: 120000, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  // Line 1: total 47500, discount 2375, VAT 9476
+  // Line 2: total 120000, discount 6000, VAT 23940
+  assert.deepEqual(result, {
+    subtotal: 167500,
+    discount: 8375,
+    vat: 33416,
+    voucher: 0,
+    total: 192541,
+  });
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 5000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.deepEqual(result, {
+    subtotal: 47500,
+    discount: 0,
+    vat: 9975,
+    voucher: 5000,
+    total: 52475,
+  });
+});
+
+test('invoiceTotals total never negative', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21 }],
+    voucher: { code: 'BIG', amount: 10000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert(result.total >= 0);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = { lines: [] };
+  const result = invoiceTotals(invoice);
+  assert.deepEqual(result, {
+    subtotal: 0,
+    discount: 0,
+    vat: 0,
+    voucher: 0,
+    total: 0,
+  });
+});
+
+test('invoiceTotals with no voucher property', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 0);
+});
+
+test('invoiceTotals does not mutate invoice', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 5 }],
+    voucher: { code: 'SAVE', amount: 1000 },
+  };
+  const original = JSON.stringify(invoice);
+  invoiceTotals(invoice);
+  assert.equal(JSON.stringify(invoice), original);
+});
+
+test('isValidDiscountPercent validates range', () => {
+  assert.equal(isValidDiscountPercent(0), true);
+  assert.equal(isValidDiscountPercent(50), true);
+  assert.equal(isValidDiscountPercent(100), true);
+  assert.equal(isValidDiscountPercent(12.5), true);
+});
+
+test('isValidDiscountPercent rejects out of range', () => {
+  assert.equal(isValidDiscountPercent(-0.1), false);
+  assert.equal(isValidDiscountPercent(100.1), false);
+  assert.equal(isValidDiscountPercent(150), false);
+});
+
+test('isValidDiscountPercent rejects non-numbers', () => {
+  assert.equal(isValidDiscountPercent('50'), false);
+  assert.equal(isValidDiscountPercent(null), false);
+  assert.equal(isValidDiscountPercent(undefined), false);
+});
+
+test('isValidDiscountPercent rejects NaN', () => {
+  assert.equal(isValidDiscountPercent(NaN), false);
+});
