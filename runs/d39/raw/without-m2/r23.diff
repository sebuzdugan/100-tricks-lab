 /**
- * Calculate the discount for a single line.
+ * Calculate the discount for a single line (line discount + bulk discount if qty >= 10).
+ * Bulk discount is 2.5% applied to the amount after the first discount.
  * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
  * @returns {number}
  */
 export function lineDiscount(line) {
-  if (!line.discountPercent) return 0;
   const total = lineTotal(line);
-  const discount = roundCents((total * line.discountPercent) / 100);
-  return Math.max(0, discount);
+
+  // Apply first discount (line-specific or tier discount, default 0)
+  const firstDiscountPercent = line.discountPercent ?? 0;
+  const firstDiscount = roundCents((total * firstDiscountPercent) / 100);
+
+  // Apply bulk discount if qty >= 10
+  let bulkDiscount = 0;
+  if (line.qty >= 10) {
+    const afterFirstDiscount = Math.max(0, total - firstDiscount);
+    bulkDiscount = roundCents((afterFirstDiscount * 2.5) / 100);
+  }
+
+  return Math.max(0, firstDiscount + bulkDiscount);
 }
 
