+/**
+ * Get a dashboard summary of invoices.
+ * @param {Array} invoices list of invoices
+ * @param {string} asOf date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { counts, outstanding, overdue, topCustomers } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) return fail('DATE_INVALID');
+
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = {};
+
+  for (const invoice of invoices) {
+    // Count by status
+    if (invoice.status in counts) {
+      counts[invoice.status]++;
+    }
+
+    // Calculate outstanding
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDue[invoice.customerId]) {
+        customerDue[invoice.customerId] = 0;
+      }
+      customerDue[invoice.customerId] += due;
+    }
+  }
+
+  // Get overdue information
+  const overdueResult = overdueInvoices(invoices, asOf);
+  if (!overdueResult.ok) return overdueResult;
+
+  const overdueList = overdueResult.value;
+  const overdueAmount = overdueList.reduce((sum, inv) => sum + inv.due, 0);
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueAmount,
+  };
+
+  // Get top 3 customers by due amount
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({ counts, outstanding, overdue, topCustomers });
+}
