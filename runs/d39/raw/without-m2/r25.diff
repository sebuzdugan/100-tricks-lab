+
+test('renderInvoiceText shows voucher when applied', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const withVoucher = applyVoucher(result.value, { code: 'SAVE10', amount: 1000 });
+  assert.equal(withVoucher.ok, true);
+
+  const text = renderInvoiceText(withVoucher.value);
+  const lines = text.split('\n');
+
+  // Should show voucher line
+  const voucherLine = lines.find((l) => l.startsWith('Voucher:'));
+  assert(voucherLine);
+  assert.match(voucherLine, /€10\.00/);
+});
+
+test('renderInvoiceText shows due date for issued invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+  const lines = text.split('\n');
+
+  // Should show due date line
+  const dueLine = lines.find((l) => l.startsWith('Due:'));
+  assert(dueLine);
+  assert.match(dueLine, /2025-01-29/);
+});
+
+test('renderInvoiceText does not show due date for draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const text = renderInvoiceText(result.value);
+  const lines = text.split('\n');
+
+  // Should not show due date line
+  const dueLine = lines.find((l) => l.startsWith('Due:'));
+  assert(!dueLine);
+});
+
+test('renderInvoiceText shows paid amount when payment recorded', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const paid = recordPayment(issued.value, { amount: 5000, date: '2025-01-20' });
+  assert.equal(paid.ok, true);
+
+  const text = renderInvoiceText(paid.value);
+  const lines = text.split('\n');
+
+  // Should show paid line
+  const paidLine = lines.find((l) => l.startsWith('Paid:'));
+  assert(paidLine);
+  assert.match(paidLine, /€50\.00/);
+});
+
+test('renderInvoiceText shows total paid for multiple payments', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const payment1 = recordPayment(issued.value, { amount: 3000, date: '2025-01-20' });
+  assert.equal(payment1.ok, true);
+
+  const payment2 = recordPayment(payment1.value, { amount: 2000, date: '2025-01-25' });
+  assert.equal(payment2.ok, true);
+
+  const text = renderInvoiceText(payment2.value);
+  const lines = text.split('\n');
+
+  // Should show total paid (3000 + 2000 = 5000 cents = €50.00)
+  const paidLine = lines.find((l) => l.startsWith('Paid:'));
+  assert(paidLine);
+  assert.match(paidLine, /€50\.00/);
+});
+
+test('renderInvoiceText does not show paid line when no payments', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  const issued = issueInvoice(result.value, []);
+  assert.equal(issued.ok, true);
+
+  const text = renderInvoiceText(issued.value);
+  const lines = text.split('\n');
+
+  // Should not show paid line
+  const paidLine = lines.find((l) => l.startsWith('Paid:'));
+  assert(!paidLine);
+});
+
+test('renderInvoiceText shows all features together', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(result.ok, true);
+  let invoice = result.value;
+
+  // Apply voucher
+  const withVoucher = applyVoucher(invoice, { code: 'SAVE', amount: 1000 });
+  assert.equal(withVoucher.ok, true);
+  invoice = withVoucher.value;
+
+  // Issue
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.ok, true);
+  invoice = issued.value;
+
+  // Record payment
+  const paid = recordPayment(invoice, { amount: 5000, date: '2025-01-20' });
+  assert.equal(paid.ok, true);
+  invoice = paid.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Should contain all components
+  const voucherLine = lines.find((l) => l.startsWith('Voucher:'));
+  const dueLine = lines.find((l) => l.startsWith('Due:'));
+  const paidLine = lines.find((l) => l.startsWith('Paid:'));
+
+  assert(voucherLine, 'Should show voucher');
+  assert(dueLine, 'Should show due date');
+  assert(paidLine, 'Should show paid amount');
+
+  // Verify order: voucher before total, due date after total, paid after due
+  const voucherIdx = lines.findIndex((l) => l.startsWith('Voucher:'));
+  const totalIdx = lines.findIndex((l) => l.startsWith('Total:'));
+  const dueIdx = lines.findIndex((l) => l.startsWith('Due:'));
+  const paidIdx = lines.findIndex((l) => l.startsWith('Paid:'));
+
+  assert(voucherIdx < totalIdx, 'Voucher should come before Total');
+  assert(totalIdx < dueIdx, 'Total should come before Due');
+  assert(dueIdx < paidIdx, 'Due should come before Paid');
+});
