diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..7e6d875
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,64 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create an invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} invoice
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Validate date format and reality
+  const dateRegex = /^(\d{4})-(\d{2})-(\d{2})$/;
+  const match = dateRegex.exec(issueDate);
+  if (!match) return fail('DATE_INVALID');
+  const [, year, month, day] = match;
+  const date = new Date(issueDate + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return fail('DATE_INVALID');
+  // Validate that the date components match (to catch invalid dates like 2026-02-30)
+  if (
+    date.getUTCFullYear() !== Number(year) ||
+    date.getUTCMonth() + 1 !== Number(month) ||
+    date.getUTCDate() !== Number(day)
+  ) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines array
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Process lines
+  const processedLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Get product
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    processedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  const invoice = {
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: processedLines,
+  };
+
+  return ok(invoice);
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..0beeaad
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,116 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with the customer, date and lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'DES-HOUR', qty: 4 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 2);
+});
+
+test('createInvoice copies product details into each line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  const line = r.value.lines[0];
+  assert.equal(line.sku, 'DEV-HOUR');
+  assert.equal(line.name, 'Development (hour)');
+  assert.equal(line.qty, 5);
+  assert.equal(line.unitPrice, 9500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice does not mutate input lines', () => {
+  const inputLines = [{ sku: 'DEV-HOUR', qty: 3 }];
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: inputLines,
+  });
+  assert.deepEqual(inputLines, [{ sku: 'DEV-HOUR', qty: 3 }]);
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for wrong format', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026/10/07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports DATE_INVALID for fake dates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-30',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer qty', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 3.5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for zero qty', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 0 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for negative qty', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: -5 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports UNKNOWN_SKU', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'FAKE-SKU', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
