diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..944f442
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,47 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns first number for empty array', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber continues counter for same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0005'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0099', 'INV-2025-0001'];
+  const num = nextInvoiceNumber(existing, '2027-10-07');
+  assert.equal(num, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber handles mixed years', () => {
+  const existing = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'INV-2026-0001',
+    'INV-2026-0003',
+  ];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = [
+    'INV-2025-9999',
+    'INV-2026-0001',
+    'INV-2027-0005',
+  ];
+  const num = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber zero-pads counter to 4 digits', () => {
+  const existing = ['INV-2026-0999'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-1000');
+});
