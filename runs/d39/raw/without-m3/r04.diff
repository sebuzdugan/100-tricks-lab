index 0000000..d24182a
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,24 @@
+/**
+ * Generate the next invoice number for a given issue date.
+ * Format: INV-<year>-<counter> where counter is 4 digits zero-padded.
+ * Counter resets every year starting at 0001.
+ * @param {string[]} existingNumbers - Array of existing invoice numbers (any order)
+ * @param {string} issueDate - Invoice issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(`INV-${year}-`))
+    .map((num) => {
+      const parts = num.split('-');
+      return Number(parts[2]);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
