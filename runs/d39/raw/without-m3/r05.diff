+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // First line: invoice number or DRAFT
+  const header = invoice.number ? invoice.number : 'DRAFT';
+
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+  // Build lines array
+  const lines = [header, customerName];
+
+  // Add line items
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Add total
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..55d3de7
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,86 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const text = renderInvoiceText(r2.value);
+  assert.ok(text.startsWith('INV-2026-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText formats amounts as euros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('€95.00')); // unitPrice for DEV-HOUR is 9500 cents = €95.00
+  assert.ok(text.includes('€190.00')); // line total: 2 * 9500 = 19000 cents = €190.00
+  assert.ok(text.includes('Total: €190.00'));
+});
+
+test('renderInvoiceText includes all line details', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('5')); // qty
+  assert.ok(text.includes('Development (hour)')); // product name
+  assert.ok(text.includes('€95.00')); // unit price
+});
+
+test('renderInvoiceText handles multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // header + customer + 2 items + total
+  assert.ok(text.includes('Development (hour)'));
+  assert.ok(text.includes('Design work (hour)'));
+});
+
+test('renderInvoiceText shows customer ID if customer not found', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 }],
+  };
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('C-999'));
+});
