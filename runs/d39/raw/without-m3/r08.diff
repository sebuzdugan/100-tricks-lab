+    ],
+  });
+  const totals = invoiceTotals(r.value);
+  const line1Total = 10 * 9500;
+  const line2Total = 100 * 37;
+  const subtotal = line1Total + line2Total;
+  const vat1 = Math.round((line1Total * 21) / 100);
+  const vat2 = Math.round((line2Total * 9) / 100);
+  const totalVat = vat1 + vat2;
+  assert.equal(totals.subtotal, subtotal);
