 /**
- * Calculate subtotal, discount and total for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }}
+ * Calculate subtotal, discount, VAT and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   let subtotal = 0;
   let totalDiscount = 0;
+  let totalVat = 0;
 
   for (const line of invoice.lines) {
     const lineAmount = lineTotal(line);
     subtotal += lineAmount;
 
+    // Calculate discount
+    let lineDiscount = 0;
     if (line.discountPercent) {
-      const lineDiscount = roundCents((lineAmount * line.discountPercent) / 100);
+      lineDiscount = roundCents((lineAmount * line.discountPercent) / 100);
       totalDiscount += lineDiscount;
     }
+
+    // Calculate VAT on amount after discount
+    const lineAmountAfterDiscount = lineAmount - lineDiscount;
+    const lineVat = roundCents((lineAmountAfterDiscount * line.vatRate) / 100);
+    totalVat += lineVat;
   }
 
-  const total = Math.max(0, subtotal - totalDiscount);
-  return { subtotal, discount: totalDiscount, total };
+  const total = Math.max(0, subtotal - totalDiscount + totalVat);
+  return { subtotal, discount: totalDiscount, vat: totalVat, total };
 }
 
