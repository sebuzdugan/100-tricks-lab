@@ -0,0 +1,175 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('recordPayment records a payment on an issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: 10000, date: '2026-10-10' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 1);
+  assert.equal(r3.value.payments[0].amount, 10000);
+  assert.equal(r3.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const totals = r2.value;
+  const invoice = r2.value;
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+
+  const r3 = recordPayment(invoice, { amount: total, date: '2026-10-10' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'paid');
+});
+
+test('recordPayment sets status to partially_paid when partially paid', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'partially_paid');
+});
+
+test('recordPayment records multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+  assert.equal(r3.ok, true);
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+  const remaining = total - 50000;
+
+  const r4 = recordPayment(r3.value, { amount: remaining, date: '2026-10-20' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.payments.length, 2);
+  assert.equal(r4.value.status, 'paid');
+});
+
+test('recordPayment rejects draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = recordPayment(r.value, { amount: 10000, date: '2026-10-10' });
+  assert.deepEqual(r2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment rejects invalid amount (zero)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: 0, date: '2026-10-10' });
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects invalid amount (negative)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: -1000, date: '2026-10-10' });
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects invalid amount (non-integer)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: 1000.5, date: '2026-10-10' });
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment rejects overpayment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+
+  const r3 = recordPayment(r2.value, { amount: total + 1, date: '2026-10-10' });
+  assert.deepEqual(r3, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const original = r2.value;
+  recordPayment(original, { amount: 50000, date: '2026-10-10' });
+  assert.equal(original.payments, undefined);
+  assert.equal(original.status, 'issued');
+});
+
+test('balanceDue equals total for new issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const expected = subtotal + vat;
+  assert.equal(balanceDue(r2.value), expected);
+});
+
+test('balanceDue decreases after payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+  assert.equal(balanceDue(r3.value), balanceDue(r2.value) - 50000);
+});
+
+test('balanceDue is zero after full payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const due = balanceDue(r2.value);
+  const r3 = recordPayment(r2.value, { amount: due, date: '2026-10-10' });
+  assert.equal(balanceDue(r3.value), 0);
+});
