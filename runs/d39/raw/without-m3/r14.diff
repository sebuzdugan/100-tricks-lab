+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement lists issued invoices for a customer', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-001', [r2.value], '2026-10-10');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.customerId, 'C-001');
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement filters by customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const stmt = statement('C-001', [r2.value, r4.value], '2026-10-10');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement filters by issueDate (asOf)', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const stmt = statement('C-001', [r2.value, r4.value], '2026-10-10');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].issueDate, '2026-10-07');
+});
+
+test('statement includes invoices on the exact asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-001', [r2.value], '2026-10-07');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+});
+
+test('statement calculates due from balanceDue', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+
+  const stmt = statement('C-001', [r3.value], '2026-10-10');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices[0].due, stmt.value.invoices[0].total - 50000);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const stmt = statement('C-001', [r2.value, r4.value], '2026-10-20');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 2);
+  assert.equal(stmt.value.invoices[0].issueDate, '2026-10-07');
+  assert.equal(stmt.value.invoices[1].issueDate, '2026-10-15');
+});
+
+test('statement calculates totalDue as sum of due', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const stmt = statement('C-001', [r2.value, r4.value], '2026-10-20');
+  assert.equal(stmt.ok, true);
+  const sum = stmt.value.invoices.reduce((acc, inv) => acc + inv.due, 0);
+  assert.equal(stmt.value.totalDue, sum);
+});
+
+test('statement rejects unknown customer', () => {
+  const stmt = statement('C-999', [], '2026-10-10');
+  assert.deepEqual(stmt, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r3 = issueInvoice(r2.value, []);
+
+  const stmt = statement('C-001', [r1.value, r3.value], '2026-10-10');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].issueDate, '2026-10-08');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+
+  const stmt = statement('C-001', [r3.value], '2026-10-10');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].due > 0, true);
+});
+
+test('statement normalizes customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const stmt = statement('c-001', [r2.value], '2026-10-10');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.customerId, 'C-001');
+  assert.equal(stmt.value.invoices.length, 1);
+});
+
+test('statement returns empty invoice list for customer with no invoices', () => {
+  const stmt = statement('C-001', [], '2026-10-10');
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 0);
+  assert.equal(stmt.value.totalDue, 0);
+});
