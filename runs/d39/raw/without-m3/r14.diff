+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement showing invoices and total amount due.
+ * @param {string} customerId - customer ID
+ * @param {Array} invoices - array of all invoices
+ * @param {string} asOf - date in YYYY-MM-DD format; only invoices issued on or before this date are included
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize and validate customer
+  const normalizedCustomerId = normalizeId(customerId);
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer with the right status and date
+  const relevantInvoices = invoices.filter(
+    (inv) =>
+      inv.customerId === normalizedCustomerId &&
+      (inv.status === 'issued' || inv.status === 'partially_paid') &&
+      inv.issueDate <= asOf
+  );
+
+  // Map to statement format and sort by issueDate
+  const statementInvoices = relevantInvoices
+    .map((inv) => ({
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: invoiceTotals(inv).total,
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
