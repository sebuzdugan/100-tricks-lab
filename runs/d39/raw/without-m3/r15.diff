@@ -22,3 +22,28 @@ export function nextInvoiceNumber(existingNumbers, issueDate) {
 
   return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
 }
+
+/**
+ * Generate the next credit note number for a given issue date.
+ * Format: CN-<year>-<counter> where counter is 4 digits zero-padded.
+ * Counter resets every year starting at 0001 and is independent from invoices.
+ * @param {string[]} existingNumbers - Array of existing numbers (invoices and credit notes)
+ * @param {string} issueDate - Credit note issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(`CN-${year}-`))
+    .map((num) => {
+      const parts = num.split('-');
+      return Number(parts[2]);
+    })
+    .filter((counter) => !isNaN(counter));
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..5386893
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,183 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 10000, reason: 'Discount', date: '2026-10-10' }, []);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0001');
+  assert.equal(r3.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r3.value.customerId, 'C-001');
+  assert.equal(r3.value.amount, 10000);
+  assert.equal(r3.value.reason, 'Discount');
+  assert.equal(r3.value.date, '2026-10-10');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = createCreditNote(r1.value, { amount: 10000, reason: 'Discount', date: '2026-10-10' }, []);
+
+  assert.deepEqual(r2, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects zero amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 0, reason: 'Discount', date: '2026-10-10' }, []);
+
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects negative amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createCreditNote(r2.value, { amount: -5000, reason: 'Discount', date: '2026-10-10' }, []);
+
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects non-integer amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 5000.5, reason: 'Discount', date: '2026-10-10' }, []);
+
+  assert.deepEqual(r3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects credit too high', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+
+  const r3 = createCreditNote(r2.value, { amount: total + 1, reason: 'Discount', date: '2026-10-10' }, []);
+
+  assert.deepEqual(r3, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+
+  const r3 = createCreditNote(r2.value, { amount: total, reason: 'Full refund', date: '2026-10-10' }, []);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.amount, total);
+});
+
+test('createCreditNote numbers correctly with separate counter from invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002'];
+
+  const r5 = createCreditNote(r2.value, { amount: 10000, reason: 'Discount', date: '2026-10-10' }, existingNumbers);
+  const r6 = createCreditNote(r4.value, { amount: 5000, reason: 'Discount', date: '2026-10-11' }, [...existingNumbers, r5.value.number]);
+
+  assert.equal(r5.ok, true);
+  assert.equal(r5.value.number, 'CN-2026-0001');
+  assert.equal(r6.ok, true);
+  assert.equal(r6.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote uses credit note number in different year', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createCreditNote(r2.value, { amount: 10000, reason: 'Discount', date: '2027-01-15' }, ['CN-2026-0005']);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote resets counter for new year', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const existingNumbers = ['CN-2026-0001', 'CN-2026-0002', 'CN-2026-0003'];
+  const r3 = createCreditNote(r2.value, { amount: 10000, reason: 'Discount', date: '2027-01-15' }, existingNumbers);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote works for partially_paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createCreditNote(r2.value, { amount: 10000, reason: 'Discount', date: '2026-10-10' }, []);
+
+  assert.equal(r3.ok, true);
+});
+
+test('createCreditNote works for paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createCreditNote(r2.value, { amount: 10000, reason: 'Discount', date: '2026-10-10' }, []);
+
+  assert.equal(r3.ok, true);
+});
