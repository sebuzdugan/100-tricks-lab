+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns overdue invoice with daysOverdue and due', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const report = overdueInvoices([r2.value], '2026-10-20');
+
+  assert.equal(report.length, 1);
+  assert.equal(report[0].number, 'INV-2026-0001');
+  assert.equal(report[0].customerId, 'C-001');
+  assert.equal(report[0].dueDate, '2026-10-15');
+  assert.equal(report[0].daysOverdue, 5);
+  assert.equal(report[0].due > 0, true);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+
+  const report = overdueInvoices([r1.value], '2026-10-20');
+
+  assert.equal(report.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+  const r3 = recordPayment(r2.value, { amount: total, date: '2026-10-16' });
+
+  const report = overdueInvoices([r3.value], '2026-10-20');
+
+  assert.equal(report.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-16' });
+
+  const report = overdueInvoices([r3.value], '2026-10-20');
+
+  assert.equal(report.length, 1);
+  assert.equal(report[0].status, undefined);
+  assert.equal(report[0].due > 0, true);
+});
+
+test('overdueInvoices excludes invoices with dueDate on or after asOf', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const report = overdueInvoices([r2.value], '2026-10-15');
+
+  assert.equal(report.length, 0);
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const report = overdueInvoices([r2.value, r4.value], '2026-10-25');
+
+  assert.equal(report.length, 2);
+  assert.equal(report[0].number, 'INV-2026-0001');
+  assert.equal(report[0].daysOverdue, 10);
+  assert.equal(report[1].number, 'INV-2026-0002');
+  assert.equal(report[1].daysOverdue, 6);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const report = overdueInvoices([r2.value], '2026-10-20');
+
+  assert.equal(report.length, 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const report = overdueInvoices([r2.value], '2026-10-30');
+
+  assert.equal(report.length, 1);
+  assert.equal(report[0].daysOverdue, 15);
+});
+
+test('overdueInvoices includes due from balanceDue', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 30000, date: '2026-10-16' });
+
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+  const expectedDue = total - 30000;
+
+  const report = overdueInvoices([r3.value], '2026-10-20');
+
+  assert.equal(report.length, 1);
+  assert.equal(report[0].due, expectedDue);
+});
+
+test('overdueInvoices handles mixed invoice statuses', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+
+  const r4 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-03',
+    lines: [{ sku: 'DEV-HOUR', qty: 3, discountPercent: 0 }],
+    terms: 'NET14',
+  });
+  const r5 = issueInvoice(r4.value, ['INV-2026-0001']);
+  const subtotal = 3 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+  const r6 = recordPayment(r5.value, { amount: total, date: '2026-10-18' });
+
+  const report = overdueInvoices([r2.value, r3.value, r6.value], '2026-10-25');
+
+  assert.equal(report.length, 1);
+  assert.equal(report[0].number, 'INV-2026-0001');
+});
+
+test('overdueInvoices with empty invoices array', () => {
+  const report = overdueInvoices([], '2026-10-20');
+
+  assert.equal(report.length, 0);
+});
