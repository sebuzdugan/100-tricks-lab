+test('vatSummary returns entries for each VAT rate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const report = vatSummary([r2.value]);
+
+  assert.equal(report.length, 1);
+  assert.equal(report[0].rate, 21);
+  assert.equal(report[0].base, 10 * 9500);
+  assert.equal(report[0].vat, Math.round(10 * 9500 * 0.21));
+});
