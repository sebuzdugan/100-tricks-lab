@@ -21,3 +22,36 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Get VAT summary report.
+ * @param {Array} invoices - Array of invoice objects
+ * @returns {Array} Array of { rate, base, vat } sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const lineAmount = line.qty * line.unitPrice;
+      const discount = line.discountPercent ?? 0;
+      const lineBase = roundCents(lineAmount * (1 - discount / 100));
+      const vatRateDecimal = line.vatRate / 100;
+      const lineVat = roundCents(lineBase * vatRateDecimal);
+
+      const rate = line.vatRate;
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { rate, base: 0, vat: 0 });
+      }
+      const entry = vatMap.get(rate);
+      entry.base += lineBase;
+      entry.vat += lineVat;
+    }
+  }
+
+  return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
+}
