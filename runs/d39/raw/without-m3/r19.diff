+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Escape a CSV field: quote if it contains comma, quote, or newline, and double any quotes.
+ * @param {string} value
+ * @returns {string}
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Format amount in cents as euros with 2 decimals: 123456 -> "1234.56"
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatAmount(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array} invoices - Array of invoice objects
+ * @returns {string} CSV string with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const lines = ['number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'];
+
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number || 'DRAFT',
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatAmount(totals.subtotal),
+      formatAmount(totals.discount),
+      formatAmount(totals.vat),
+      formatAmount(totals.total),
+      formatAmount(due),
+    ];
+
+    const line = fields.map(escapeCsvField).join(',');
+    lines.push(line);
+  }
+
+  return lines.join('\n') + '\n';
+}
