+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns CSV with header', () => {
+  const csv = exportCsv([]);
+
+  assert(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv exports single issued invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[1].includes('2026-10-07'));
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv uses DRAFT for draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+
+  const csv = exportCsv([r1.value]);
+
+  const lines = csv.split('\n');
+  assert(lines[1].includes('DRAFT'));
+  assert(lines[1].includes('draft'));
+});
+
+test('exportCsv formats amounts correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  const lines = csv.split('\n');
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+
+  assert(lines[1].includes((subtotal / 100).toFixed(2)));
+  assert(lines[1].includes((vat / 100).toFixed(2)));
+  assert(lines[1].includes((total / 100).toFixed(2)));
+});
+
+test('exportCsv exports customer name', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  assert(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv handles multiple invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const csv = exportCsv([r2.value, r4.value]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 4);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv includes due amount', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+  const due = total;
+
+  const lines = csv.split('\n');
+  assert(lines[1].includes((due / 100).toFixed(2)));
+});
+
+test('exportCsv includes partial payment due', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+  const r3 = recordPayment(r2.value, { amount: 50000, date: '2026-10-10' });
+
+  const csv = exportCsv([r3.value]);
+
+  const subtotal = 10 * 9500;
+  const vat = Math.round(subtotal * 0.21);
+  const total = subtotal + vat;
+  const due = total - 50000;
+
+  const lines = csv.split('\n');
+  assert(lines[1].includes((due / 100).toFixed(2)));
+});
+
+test('exportCsv escapes fields with commas', () => {
+  const r1 = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  assert(csv.includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes fields with quotes', () => {
+  const r1 = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  assert(csv.includes('Marlow ""The Print Shop""'));
+});
+
+test('exportCsv ends with newline', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  assert(csv.endsWith('\n'));
+});
+
+test('exportCsv handles empty invoices array', () => {
+  const csv = exportCsv([]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv includes all columns in correct order', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  const lines = csv.split('\n');
+  const headers = lines[0].split(',');
+  assert.equal(headers[0], 'number');
+  assert.equal(headers[1], 'customer');
+  assert.equal(headers[2], 'issueDate');
+  assert.equal(headers[3], 'dueDate');
+  assert.equal(headers[4], 'status');
+  assert.equal(headers[5], 'subtotal');
+  assert.equal(headers[6], 'discount');
+  assert.equal(headers[7], 'vat');
+  assert.equal(headers[8], 'total');
+  assert.equal(headers[9], 'due');
+});
+
+test('exportCsv formats decimals as dots not commas', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  assert(!csv.includes(',00'));
+  assert(csv.includes('.'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const r1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const csv = exportCsv([r2.value, r4.value]);
+
+  const lines = csv.split('\n');
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('Blue Fern Bakery'));
+  assert(lines[2].includes('INV-2026-0002'));
+  assert(lines[2].includes('Northwind Studio'));
+});
