index fadf486..a0127f1 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,12 @@
 import { ok, fail } from './result.js';
 
+/** Exchange rates: units of currency per euro. */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +46,37 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount from euros to another currency.
+ * @param {number} eurocents - Amount in euro cents
+ * @param {string} currency - Target currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(eurocents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const rate = RATES[currency];
+  const foreignCents = roundCents(eurocents * rate);
+  return ok(foreignCents);
+}
+
+/**
+ * Format amount in cents with currency symbol: 123456 -> "$1,234.56", -5 -> "-£0.05".
+ * @param {number} cents - Amount in cents of the target currency
+ * @param {string} currency - Currency (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+  const symbol = symbols[currency] ?? currency;
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
