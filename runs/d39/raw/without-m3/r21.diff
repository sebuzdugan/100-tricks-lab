+test('mergeCustomers merges invoices from one customer to another', () => {
+  const customers = listCustomers();
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r1.value, []);
+
+  const r3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r4 = issueInvoice(r3.value, ['INV-2026-0001']);
+
+  const invoices = [r2.value, r4.value];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.some((c) => c.id === 'C-001'), false);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  assert.equal(result.value.invoices[1].customerId, 'C-002');
+});
+
+test('mergeCustomers removes the fromId customer', () => {
