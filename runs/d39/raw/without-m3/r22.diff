@@ -0,0 +1,201 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 95000);
+});
+
+test('lineTotal handles single unit', () => {
+  const line = { qty: 1, unitPrice: 100 };
+  assert.equal(lineTotal(line), 100);
+});
+
+test('lineTotal handles zero quantity', () => {
+  const line = { qty: 0, unitPrice: 100 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('invoiceTotals calculates subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 95000);
+});
+
+test('invoiceTotals calculates discount correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const lineAmount = 95000;
+  const expectedDiscount = Math.round(lineAmount * 0.1);
+  assert.equal(totals.discount, expectedDiscount);
+});
+
+test('invoiceTotals calculates VAT correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const lineAmount = 95000;
+  const expectedVat = Math.round(lineAmount * 0.21);
+  assert.equal(totals.vat, expectedVat);
+});
+
+test('invoiceTotals calculates VAT after discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const lineAmount = 95000;
+  const discount = Math.round(lineAmount * 0.1);
+  const afterDiscount = lineAmount - discount;
+  const expectedVat = Math.round(afterDiscount * 0.21);
+  assert.equal(totals.vat, expectedVat);
+});
+
+test('invoiceTotals calculates total correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 95000;
+  const vat = Math.round(subtotal * 0.21);
+  const expectedTotal = subtotal + vat;
+  assert.equal(totals.total, expectedTotal);
+});
+
+test('invoiceTotals with zero VAT rate', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 100, vatRate: 0 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 1000);
+});
+
+test('invoiceTotals sums VAT from multiple lines with different rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+      { qty: 5, unitPrice: 100, vatRate: 9 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const vat1 = Math.round(95000 * 0.21);
+  const vat2 = Math.round(500 * 0.09);
+  assert.equal(totals.vat, vat1 + vat2);
+});
+
+test('invoiceTotals handles multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+      { qty: 5, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 95000 + 47500);
+});
+
+test('invoiceTotals includes voucher in total', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+    voucher: { code: 'SUMMER', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 95000;
+  const vat = Math.round(subtotal * 0.21);
+  const expectedTotal = subtotal + vat - 5000;
+  assert.equal(totals.total, expectedTotal);
+  assert.equal(totals.voucher, 5000);
+});
+
+test('invoiceTotals clamps total at zero', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 21 },
+    ],
+    voucher: { code: 'HUGE', amount: 200 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with no voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals handles decimal discountPercent', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 2.5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const lineAmount = 95000;
+  const expectedDiscount = Math.round(lineAmount * 0.025);
+  assert.equal(totals.discount, expectedDiscount);
+});
+
+test('invoiceTotals returns all fields', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+    ],
+    voucher: { code: 'CODE', amount: 1000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
+
+test('invoiceTotals with empty lines (edge case)', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with multiple discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+      { qty: 5, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const discount1 = Math.round(95000 * 0.05);
+  const discount2 = Math.round(47500 * 0.1);
+  assert.equal(totals.discount, discount1 + discount2);
+});
