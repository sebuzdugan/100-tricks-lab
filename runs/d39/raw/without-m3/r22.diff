+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total amount for a single invoice line.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let totalDiscount = 0;
+  let totalVat = 0;
+
+  for (const line of invoice.lines) {
+    const lineAmount = lineTotal(line);
+    subtotal += lineAmount;
+
+    // Calculate discount
+    let lineDiscount = 0;
+    if (line.discountPercent) {
+      lineDiscount = roundCents((lineAmount * line.discountPercent) / 100);
+      totalDiscount += lineDiscount;
+    }
+
+    // Calculate VAT on amount after discount
+    const lineAmountAfterDiscount = lineAmount - lineDiscount;
+    const lineVat = roundCents((lineAmountAfterDiscount * line.vatRate) / 100);
+    totalVat += lineVat;
+  }
+
+  const voucherAmount = invoice.voucher?.amount || 0;
+  const total = Math.max(0, subtotal - totalDiscount + totalVat - voucherAmount);
+  return { subtotal, discount: totalDiscount, vat: totalVat, voucher: voucherAmount, total };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
