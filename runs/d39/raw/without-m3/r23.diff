diff --git a/src/totals.js b/src/totals.js
index 265798c..1f4bcb4 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -23,16 +23,24 @@ export function invoiceTotals(invoice) {
     const lineAmount = lineTotal(line);
     subtotal += lineAmount;
 
-    // Calculate discount
+    // Calculate first discount (line's own or tier discount)
     let lineDiscount = 0;
     if (line.discountPercent) {
       lineDiscount = roundCents((lineAmount * line.discountPercent) / 100);
-      totalDiscount += lineDiscount;
     }
+    const baseAfterFirstDiscount = lineAmount - lineDiscount;
 
-    // Calculate VAT on amount after discount
-    const lineAmountAfterDiscount = lineAmount - lineDiscount;
-    const lineVat = roundCents((lineAmountAfterDiscount * line.vatRate) / 100);
+    // Apply bulk discount if qty >= 10
+    let bulkDiscount = 0;
+    if (line.qty >= 10) {
+      bulkDiscount = roundCents((baseAfterFirstDiscount * 2.5) / 100);
+    }
+    const baseAfterBothDiscounts = baseAfterFirstDiscount - bulkDiscount;
+
+    totalDiscount += lineDiscount + bulkDiscount;
+
+    // Calculate VAT on amount after both discounts
+    const lineVat = roundCents((baseAfterBothDiscounts * line.vatRate) / 100);
     totalVat += lineVat;
   }
 
