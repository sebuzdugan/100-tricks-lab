+/**
+ * Get dashboard summary of invoicing data.
+ * @param {Array} invoices - Array of invoice objects
+ * @param {string} asOf - Report date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    if (invoice.status in counts) {
+      counts[invoice.status]++;
+    }
+  }
+
+  // Calculate outstanding (due on issued/partially_paid invoices)
+  let outstanding = 0;
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      outstanding += balanceDue(invoice);
+    }
+  }
+
+  // Get overdue information
+  const overdue_list = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_list.length,
+    amount: overdue_list.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Find top 3 customers by most due
+  const customerDue = new Map();
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const customerId = invoice.customerId;
+      const due = balanceDue(invoice);
+      if (!customerDue.has(customerId)) {
+        customerDue.set(customerId, 0);
+      }
+      customerDue.set(customerId, customerDue.get(customerId) + due);
+    }
+  }
+
+  const topCustomers = Array.from(customerDue.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return { counts, outstanding, overdue, topCustomers };
+}
