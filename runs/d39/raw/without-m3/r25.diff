 export function renderInvoiceText(invoice) {
@@ -18,11 +19,16 @@ export function renderInvoiceText(invoice) {
   // Build lines array
   const lines = [header, customerName];
 
-  // Add line items
+  // Add line items with per-line discounts
   for (const line of invoice.lines) {
     const total = lineTotal(line);
     const lineText = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
     lines.push(lineText);
+
+    if (line.discountPercent) {
+      const discount = Math.round(total * (line.discountPercent / 100));
+      lines.push(`  Discount (${line.discountPercent}%): -${formatEuros(discount)}`);
+    }
   }
 
   // Add totals
@@ -37,7 +43,22 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  if (invoice.voucher) {
+    lines.push(`Voucher: -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Add due date if invoice is issued and has a due date
+  if (invoice.dueDate && invoice.status !== 'draft') {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Add paid amount if there are payments
+  const paid = invoice.paid ? invoice.paid.reduce((sum, p) => sum + p.amount, 0) : 0;
