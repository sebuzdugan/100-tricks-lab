diff --git a/test/render.test.js b/test/render.test.js
index 4765887..c305000 100644
--- a/test/render.test.js
+++ b/test/render.test.js
@@ -151,3 +151,125 @@ test('renderInvoiceText VAT is shown before total', () => {
   assert.ok(vatIndex >= 0);
   assert.ok(totalIndex > vatIndex);
 });
+
+test('renderInvoiceText shows line-level discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('Discount (10%)'));
+});
+
+test('renderInvoiceText shows voucher before total', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r2 = r1.value;
+  r2.voucher = { code: 'SUMMER', amount: 5000 };
+  const text = renderInvoiceText(r2);
+  const lines = text.split('\n');
+  const voucherIndex = lines.findIndex((line) => line.startsWith('Voucher:'));
+  const totalIndex = lines.findIndex((line) => line.startsWith('Total:'));
+  assert.ok(voucherIndex >= 0);
+  assert.ok(totalIndex > voucherIndex);
+  assert.ok(text.includes('Voucher: -€50.00'));
+});
+
+test('renderInvoiceText shows due date when present', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+  const r2 = issueInvoice(r.value, []);
+  const text = renderInvoiceText(r2.value);
+  assert.ok(text.includes('Due: 2026-11-06'));
+});
+
+test('renderInvoiceText shows paid amount when there are payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const invoice = r2.value;
+  invoice.paid = [{ amount: 30000 }, { amount: 20000 }];
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Paid: €500.00'));
+});
+
+test('renderInvoiceText does not show due date when not present', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(!text.includes('Due:'));
+});
+
+test('renderInvoiceText does not show paid when no payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(!text.includes('Paid:'));
+});
+
+test('renderInvoiceText does not show voucher when not present', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(!text.includes('Voucher:'));
+});
+
+test('renderInvoiceText with multiple lines shows discount for each', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5, discountPercent: 10 },
+      { sku: 'DES-HOUR', qty: 3, discountPercent: 5 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.includes('Discount (10%)'));
+  assert.ok(text.includes('Discount (5%)'));
+});
+
+test('renderInvoiceText order: subtotal, discount, vat, voucher, total, due, paid', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 0 }],
+    terms: 'NET30',
+  });
+  const r2 = issueInvoice(r.value, []);
+  const invoice = r2.value;
+  invoice.voucher = { code: 'TEST', amount: 5000 };
+  invoice.paid = [{ amount: 20000 }];
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  const subtotalIndex = lines.findIndex((l) => l.startsWith('Subtotal:'));
+  const vatIndex = lines.findIndex((l) => l.startsWith('VAT:'));
+  const voucherIndex = lines.findIndex((l) => l.startsWith('Voucher:'));
+  const totalIndex = lines.findIndex((l) => l.startsWith('Total:'));
+  const dueIndex = lines.findIndex((l) => l.startsWith('Due:'));
+  const paidIndex = lines.findIndex((l) => l.startsWith('Paid:'));
+  assert.ok(subtotalIndex < vatIndex);
+  assert.ok(vatIndex < voucherIndex);
+  assert.ok(voucherIndex < totalIndex);
+  assert.ok(totalIndex < dueIndex);
+  assert.ok(dueIndex < paidIndex);
+});
