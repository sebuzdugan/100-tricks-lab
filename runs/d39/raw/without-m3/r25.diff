+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number }>, dueDate?: string, paid?: Array<{ amount: number }>, voucher?: { amount: number } }} invoice
  * @returns {string}
