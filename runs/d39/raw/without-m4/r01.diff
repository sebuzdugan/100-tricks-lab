+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: 'draft', lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }> } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const dateResult = validateDate(issueDate);
+  if (!dateResult.ok) return dateResult;
+
+  if (!lines || !Array.isArray(lines) || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  const enrichedLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
+
+function validateDate(dateStr) {
+  const dateRegex = /^(\d{4})-(\d{2})-(\d{2})$/;
+  const match = dateRegex.exec(String(dateStr || ''));
+
+  if (!match) return fail('DATE_INVALID');
+
+  const year = parseInt(match[1], 10);
+  const month = parseInt(match[2], 10);
+  const day = parseInt(match[3], 10);
+
+  if (!isValidDate(year, month, day)) {
+    return fail('DATE_INVALID');
+  }
+
+  return ok(true);
+}
+
+function isValidDate(year, month, day) {
+  if (month < 1 || month > 12) return false;
+  if (day < 1) return false;
+
+  const daysInMonth = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+  if (month === 2 && ((year % 4 === 0 && year % 100 !== 0) || year % 400 === 0)) {
+    return day <= 29;
+  }
+
+  return day <= daysInMonth[month - 1];
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..525acc0
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,176 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'HOST-MONTH', qty: 1 },
+    ],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 2);
+
+  assert.deepEqual(r.value.lines[0], {
+    sku: 'DES-HOUR',
+    name: 'Design work (hour)',
+    qty: 2,
+    unitPrice: 8500,
+    vatRate: 21,
+  });
+
+  assert.deepEqual(r.value.lines[1], {
+    sku: 'HOST-MONTH',
+    name: 'Website hosting (month)',
+    qty: 1,
+    unitPrice: 1500,
+    vatRate: 21,
+  });
+});
+
+test('createInvoice reports unknown customer', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice rejects invalid date formats', () => {
+  const testCases = [
+    '2026/10/07',
+    '10-07-2026',
+    '2026-10-7',
+    '2026-1-07',
+    '2026-10',
+    '2026',
+    'not a date',
+    '2026-13-01',
+    '2026-00-01',
+    '2026-02-30',
+    '2026-02-29',
+    null,
+    undefined,
+  ];
+
+  for (const dateStr of testCases) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: dateStr,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(r.ok, false, `Should reject: ${dateStr}`);
+    assert.equal(r.error, 'DATE_INVALID', `Should be DATE_INVALID for: ${dateStr}`);
+  }
+});
+
+test('createInvoice accepts valid leap year dates', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-29',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.issueDate, '2024-02-29');
+});
+
+test('createInvoice rejects lines array that is empty', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects lines that is null or undefined', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  }), { ok: false, error: 'NO_LINES' });
+
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: undefined,
+  }), { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice validates qty is a positive integer', () => {
+  const invalidQtys = [0, -1, 1.5, 'abc', null, undefined];
+
+  for (const qty of invalidQtys) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    });
+    assert.equal(r.ok, false, `Should reject qty: ${qty}`);
+    assert.equal(r.error, 'QTY_INVALID', `Should be QTY_INVALID for qty: ${qty}`);
+  }
+});
+
+test('createInvoice reports unknown SKU', () => {
+  assert.deepEqual(createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  }), { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+    ],
+  };
+  const inputCopy = JSON.parse(JSON.stringify(input));
+
+  createInvoice(input);
+
+  assert.deepEqual(input, inputCopy);
+});
+
+test('createInvoice returns copies of catalogue data', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  r.value.lines[0].name = 'Modified';
+  r.value.lines[0].unitPrice = 999;
+  r.value.lines[0].vatRate = 0;
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(r2.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r2.value.lines[0].unitPrice, 8500);
+  assert.equal(r2.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice validates first invalid line and stops', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'NOPE', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'UNKNOWN_SKU');
+});
