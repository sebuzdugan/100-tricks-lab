+import { ok, fail } from './result.js';
+
+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<counter>, where counter is 0001-9999.
+ * @param {string[]} existingNumbers - Previously used invoice numbers
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const yearMatch = /^(\d{4})-\d{2}-\d{2}$/.exec(String(issueDate || ''));
+  if (!yearMatch) return fail('DATE_INVALID');
+
+  const year = yearMatch[1];
+  const yearRegex = new RegExp(`^INV-${year}-(\\d{4})$`);
+  let maxCounter = 0;
+
+  for (const num of existingNumbers || []) {
+    const match = yearRegex.exec(String(num || ''));
+    if (match) {
+      const counter = parseInt(match[1], 10);
+      maxCounter = Math.max(maxCounter, counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+
+  if (nextCounter > 9999) {
+    return fail('COUNTER_OVERFLOW');
+  }
+
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  const invoiceNumber = `INV-${year}-${paddedCounter}`;
+
+  return ok(invoiceNumber);
+}
