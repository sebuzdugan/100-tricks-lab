+/**
+ * Issue a draft invoice, assigning it a number and changing status to 'issued'.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, number?: string }} invoice
+ * @param {string[]} existingNumbers - Previously used invoice numbers
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: 'issued', lines: Array, number: string } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  if (invoice.status !== 'draft') {
+    return fail('NOT_DRAFT');
+  }
+
+  const numberResult = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+  if (!numberResult.ok) return numberResult;
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: 'issued',
+    number: numberResult.value,
+    lines: invoice.lines.map((line) => ({ ...line })),
+  });
+}
