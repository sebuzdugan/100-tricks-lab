diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..0008f5e
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates first invoice of the year', () => {
+  const r = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const r = nextInvoiceNumber(['INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const r = nextInvoiceNumber(['INV-2025-9999', 'INV-2026-0001', 'INV-2027-0005'], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = Array.from({ length: 42 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0043');
+});
+
+test('nextInvoiceNumber handles high counter values', () => {
+  const existing = Array.from({ length: 9998 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-9999');
+});
+
+test('nextInvoiceNumber returns COUNTER_OVERFLOW when limit exceeded', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'COUNTER_OVERFLOW');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const r = nextInvoiceNumber(['INV-2025-9999'], '2026-01-01');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber reports invalid date format', () => {
+  const testCases = ['not-a-date', '2026/10/07', '2026-10', null, undefined];
+
+  for (const dateStr of testCases) {
+    const r = nextInvoiceNumber([], dateStr);
+    assert.equal(r.ok, false, `Should reject: ${dateStr}`);
+    assert.equal(r.error, 'DATE_INVALID');
+  }
+});
+
+test('nextInvoiceNumber handles empty existing numbers', () => {
+  const r = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber handles null existing numbers', () => {
+  const r = nextInvoiceNumber(null, '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores malformed numbers in existing list', () => {
+  const r = nextInvoiceNumber(['INV-2026-0001', 'invalid', 'INV-2026-xyz', 'INV-2026-0002'], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber does not mutate existing numbers', () => {
+  const existing = ['INV-2026-0001'];
+  const existing_copy = JSON.parse(JSON.stringify(existing));
+
+  nextInvoiceNumber(existing, '2026-10-07');
+
+  assert.deepEqual(existing, existing_copy);
+});
