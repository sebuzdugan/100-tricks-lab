+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const text = renderInvoiceText(r2.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0001');
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText formats line items with qty, name, unitPrice, and total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '2× Design work (hour) @ €85.00 = €170.00');
+});
+
+test('renderInvoiceText shows total with formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'HOST-MONTH', qty: 3 },
+    ],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  const lastLine = lines[lines.length - 1];
+  assert.ok(lastLine.startsWith('Total: €'));
+  assert.equal(lastLine, 'Total: €215.00');
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'HOST-MONTH', qty: 5 },
+    ],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '2× Design work (hour) @ €85.00 = €170.00');
+  assert.equal(lines[3], '1× Development (hour) @ €95.00 = €95.00');
+  assert.equal(lines[4], '5× Website hosting (month) @ €15.00 = €75.00');
+  assert.equal(lines[5], 'Total: €340.00');
+});
+
+test('renderInvoiceText formats amounts with cents correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'PRINT-A4', qty: 100 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '100× Printed flyer A4 (each) @ €0.37 = €37.00');
+  assert.equal(lines[3], 'Total: €37.00');
+});
+
+test('renderInvoiceText handles VAT-exempt items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '1× Brand workshop (day, VAT exempt) @ €600.00 = €600.00');
+  assert.equal(lines[3], 'Total: €600.00');
+});
+
+test('renderInvoiceText shows issued invoice with multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  });
+
+  const r2 = issueInvoice(r.value, ['INV-2026-0001']);
+  const text = renderInvoiceText(r2.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2026-0002');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.equal(lines[2], '1× Logo package @ €1,200.00 = €1,200.00');
+  assert.equal(lines[3], '2× Icon set (24 icons) @ €9.80 = €19.60');
+  assert.equal(lines[4], 'Total: €1,219.60');
+});
+
+test('renderInvoiceText handles single unit quantities', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DOMAIN-YEAR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '1× Domain name (year) @ €12.99 = €12.99');
+  assert.equal(lines[3], 'Total: €12.99');
+});
