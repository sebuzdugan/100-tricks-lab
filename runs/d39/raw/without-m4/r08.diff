 /**
- * Calculate subtotal, discount, and total for an invoice.
+ * Calculate VAT for a single line (computed on the amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number} VAT in cents
+ */
+export function lineVAT(line) {
+  if (!line.vatRate || line.vatRate === 0) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  return roundCents(amountAfterDiscount * line.vatRate / 100);
+}
+
+/**
+ * Calculate subtotal, discount, VAT, and total for an invoice.
  * @param {{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }} Amounts in cents
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }} Amounts in cents
  */
 export function invoiceTotals(invoice) {
   let subtotal = 0;
   let discount = 0;
+  let vat = 0;
 
   for (const line of invoice.lines) {
     subtotal += lineTotal(line);
     discount += lineDiscount(line);
+    vat += lineVAT(line);
   }
 
-  const total = Math.max(0, subtotal - discount);
+  const total = Math.max(0, subtotal - discount + vat);
 
-  return { subtotal: Math.max(0, subtotal), discount: Math.max(0, discount), total };
+  return {
+    subtotal: Math.max(0, subtotal),
+    discount: Math.max(0, discount),
+    vat: Math.max(0, vat),
+    total,
+  };
 }
 
