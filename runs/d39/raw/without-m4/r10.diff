+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(text || ''));
+  if (!match) return false;
+
+  const year = parseInt(match[1], 10);
+  const month = parseInt(match[2], 10);
+  const day = parseInt(match[3], 10);
+
+  if (month < 1 || month > 12) return false;
+  if (day < 1) return false;
+
+  const daysInMonth = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+  if (month === 2 && ((year % 4 === 0 && year % 100 !== 0) || year % 400 === 0)) {
+    return day <= 29;
+  }
+
+  return day <= daysInMonth[month - 1];
+}
+
+/**
+ * Add a number of days to a date, in UTC. Returns new date in YYYY-MM-DD format.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add
+ * @returns {string} New date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  if (!isValidDate(date)) throw new Error(`Invalid date: ${date}`);
+
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(date));
+  const year = parseInt(match[1], 10);
+  const month = parseInt(match[2], 10);
+  const day = parseInt(match[3], 10);
+
+  const utcDate = new Date(Date.UTC(year, month - 1, day));
+  utcDate.setUTCDate(utcDate.getUTCDate() + n);
+
+  const newYear = utcDate.getUTCFullYear();
+  const newMonth = String(utcDate.getUTCMonth() + 1).padStart(2, '0');
+  const newDay = String(utcDate.getUTCDate()).padStart(2, '0');
+
+  return `${newYear}-${newMonth}-${newDay}`;
+}
+
+/**
+ * Calculate the number of days between two dates in UTC.
+ * @param {string} a - Start date in YYYY-MM-DD format
+ * @param {string} b - End date in YYYY-MM-DD format
+ * @returns {number} Number of whole days from a to b (b minus a)
+ */
+export function daysBetween(a, b) {
+  if (!isValidDate(a) || !isValidDate(b)) throw new Error(`Invalid date: ${a} or ${b}`);
+
+  const matchA = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(a));
+  const matchB = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(b));
+
+  const yearA = parseInt(matchA[1], 10);
+  const monthA = parseInt(matchA[2], 10);
+  const dayA = parseInt(matchA[3], 10);
+
+  const yearB = parseInt(matchB[1], 10);
+  const monthB = parseInt(matchB[2], 10);
+  const dayB = parseInt(matchB[3], 10);
+
+  const dateA = new Date(Date.UTC(yearA, monthA - 1, dayA));
+  const dateB = new Date(Date.UTC(yearB, monthB - 1, dayB));
+
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
