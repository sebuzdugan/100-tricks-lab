diff --git a/test/terms.test.js b/test/terms.test.js
new file mode 100644
index 0000000..1310fa6
--- /dev/null
+++ b/test/terms.test.js
@@ -0,0 +1,182 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, addLine, removeLine } from '../src/invoices.js';
+
+test('createInvoice defaults to NET30 terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'NET30');
+  assert.equal(r.value.dueDate, '2026-11-06');
+});
+
+test('createInvoice accepts NET14 terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'NET14');
+  assert.equal(r.value.dueDate, '2026-10-21');
+});
+
+test('createInvoice accepts EOM terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'EOM');
+  assert.equal(r.value.dueDate, '2026-10-31');
+});
+
+test('createInvoice rejects invalid terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET45',
+  });
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'TERMS_INVALID');
+});
+
+test('createInvoice with EOM at month end', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-31',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.dueDate, '2026-10-31');
+});
+
+test('createInvoice with EOM in leap year February', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.dueDate, '2024-02-29');
+});
+
+test('createInvoice with EOM in non-leap year February', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-02-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.dueDate, '2026-02-28');
+});
+
+test('issueInvoice preserves terms and dueDate', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.terms, 'NET14');
+  assert.equal(r2.value.dueDate, '2026-10-21');
+});
+
+test('addLine preserves terms and dueDate', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+
+  const r2 = addLine(r.value, { sku: 'DEV-HOUR', qty: 1 });
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.terms, 'EOM');
+  assert.equal(r2.value.dueDate, '2026-10-31');
+});
+
+test('removeLine preserves terms and dueDate', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+    terms: 'NET14',
+  });
+
+  const r2 = removeLine(r.value, 'DEV-HOUR');
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.terms, 'NET14');
+  assert.equal(r2.value.dueDate, '2026-10-21');
+});
+
+test('NET14 and NET30 cross month boundaries', () => {
+  const r14 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-25',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const r30 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-25',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(r14.value.dueDate, '2026-11-08');
+  assert.equal(r30.value.dueDate, '2026-11-24');
+});
+
+test('createInvoice does not mutate input', () => {
+  const input = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  };
+  const copy = JSON.parse(JSON.stringify(input));
+
+  createInvoice(input);
+
+  assert.deepEqual(input, copy);
+});
+
+test('terms validation case sensitive', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'net14',
+  });
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'TERMS_INVALID');
+});
