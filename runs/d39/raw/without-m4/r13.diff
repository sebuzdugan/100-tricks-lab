diff --git a/test/vouchers.test.js b/test/vouchers.test.js
new file mode 100644
index 0000000..eb9b073
--- /dev/null
+++ b/test/vouchers.test.js
@@ -0,0 +1,271 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, applyVoucher, invoiceTotals, issueInvoice, addLine, removeLine } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('applyVoucher applies a fixed voucher to a draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.voucher.code, 'WELCOME10');
+  assert.equal(r2.value.voucher.amount, 1000);
+});
+
+test('invoiceTotals includes voucher deduction', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  const totals = invoiceTotals(r2.value);
+
+  assert.equal(totals.voucher, 1000);
+  const totalWithoutVoucher = totals.subtotal - totals.discount + totals.vat;
+  assert.equal(totals.total, totalWithoutVoucher - 1000);
+});
+
+test('applyVoucher requires draft status', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const r3 = applyVoucher(r2.value, { code: 'WELCOME10', amount: 1000 });
+
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'NOT_DRAFT');
+});
+
+test('applyVoucher rejects existing voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  const r3 = applyVoucher(r2.value, { code: 'WELCOME20', amount: 2000 });
+
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'VOUCHER_EXISTS');
+});
+
+test('applyVoucher validates amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const testCases = [0, -1000, 1.5, 'invalid'];
+
+  for (const amount of testCases) {
+    const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount });
+    assert.equal(r2.ok, false, `Should reject amount: ${amount}`);
+    assert.equal(r2.error, 'AMOUNT_INVALID');
+  }
+});
+
+test('applyVoucher with large amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'BULK50K', amount: 50000 });
+
+  assert.equal(r2.ok, true);
+  const totals = invoiceTotals(r2.value);
+  assert(totals.total >= 0);
+});
+
+test('addLine preserves voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  const r3 = addLine(r2.value, { sku: 'DEV-HOUR', qty: 1 });
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.voucher.code, 'WELCOME10');
+  assert.equal(r3.value.voucher.amount, 1000);
+});
+
+test('removeLine preserves voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  const r3 = removeLine(r2.value, 'DEV-HOUR');
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.voucher.code, 'WELCOME10');
+  assert.equal(r3.value.voucher.amount, 1000);
+});
+
+test('issueInvoice preserves voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  const r3 = issueInvoice(r2.value, []);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.voucher.code, 'WELCOME10');
+  assert.equal(r3.value.voucher.amount, 1000);
+});
+
+test('recordPayment preserves voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  const r3 = issueInvoice(r2.value, []);
+  const totals = invoiceTotals(r3.value);
+  const r4 = recordPayment(r3.value, { amount: totals.total, date: '2026-10-08' });
+
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.voucher.code, 'WELCOME10');
+  assert.equal(r4.value.voucher.amount, 1000);
+});
+
+test('balanceDue respects voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  const r3 = issueInvoice(r2.value, []);
+  const totals = invoiceTotals(r3.value);
+
+  const due = balanceDue(r3.value);
+  assert.equal(due, totals.total);
+});
+
+test('renderInvoiceText shows voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  const r3 = issueInvoice(r2.value, []);
+  const text = renderInvoiceText(r3.value);
+
+  assert(text.includes('Voucher: €10.00'));
+});
+
+test('renderInvoiceText omits zero voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const text = renderInvoiceText(r2.value);
+
+  assert(!text.includes('Voucher'));
+});
+
+test('voucher reduces balance due correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  const r3 = issueInvoice(r2.value, []);
+  const totals = invoiceTotals(r3.value);
+
+  const due1 = balanceDue(r3.value);
+  assert.equal(due1, totals.total);
+
+  const r4 = recordPayment(r3.value, { amount: 500, date: '2026-10-08' });
+  const due2 = balanceDue(r4.value);
+  assert.equal(due2, totals.total - 500);
+});
+
+test('invoiceTotals without voucher returns 0 for voucher', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const totals = invoiceTotals(r.value);
+
+  assert.equal(totals.voucher, 0);
+});
+
+test('applyVoucher does not mutate original invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const invoiceCopy = JSON.parse(JSON.stringify(r.value));
+
+  applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+
+  assert.deepEqual(r.value, invoiceCopy);
+});
+
+test('multiple vouchers cannot be applied', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'WELCOME10', amount: 1000 });
+  assert.equal(r2.ok, true);
+
+  const r3 = applyVoucher(r2.value, { code: 'WELCOME20', amount: 2000 });
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'VOUCHER_EXISTS');
+});
+
+test('voucher code is preserved', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = applyVoucher(r.value, { code: 'SPECIAL_OFFER_2026', amount: 500 });
+
+  assert.equal(r2.value.voucher.code, 'SPECIAL_OFFER_2026');
+});
