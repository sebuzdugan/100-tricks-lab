+  });
+
+  const r1i = issueInvoice(r1.value, []);
+  const r2i = issueInvoice(r2.value, []);
+
+  const stmt = statement('C-001', [r1i.value, r2i.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  const expectedTotalDue = stmt.value.invoices[0].due + stmt.value.invoices[1].due;
+  assert.equal(stmt.value.totalDue, expectedTotalDue);
+});
+
+test('statement returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-999', [r1i.value], '2026-10-31');
+
+  assert.equal(stmt.ok, false);
+  assert.equal(stmt.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('statement normalizes customer ID', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+
+  const stmt = statement('c-001 ', [r1i.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.customerId, 'C-001');
+  assert.equal(stmt.value.invoices.length, 1);
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  const r3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'COPY-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+  const r2i = issueInvoice(r2.value, []);
+  const r3i = issueInvoice(r3.value, []);
+
+  const stmt = statement('C-001', [r1i.value, r2i.value, r3i.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 3);
+  assert.equal(stmt.value.invoices[0].issueDate, '2026-10-05');
+  assert.equal(stmt.value.invoices[1].issueDate, '2026-10-10');
