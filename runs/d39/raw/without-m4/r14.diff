+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement generates a customer statement', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-001', [r2.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.customerId, 'C-001');
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].number, r2.value.number);
+});
+
+test('statement filters by customer', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+  const r2i = issueInvoice(r2.value, []);
+
+  const stmt = statement('C-001', [r1i.value, r2i.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].number, r1i.value.number);
+});
+
+test('statement excludes draft invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-001', [r1.value, r1i.value, r2.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].status, undefined);
+});
+
+test('statement filters by asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+  const r2i = issueInvoice(r2.value, []);
+
+  const stmt = statement('C-001', [r1i.value, r2i.value], '2026-10-10');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert.equal(stmt.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement includes paid invoices that are in status paid', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-001', [r1i.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+});
+
+test('statement shows due amount for unpaid invoices', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
