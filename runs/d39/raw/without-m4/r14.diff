+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1v = applyVoucher(r1.value, { code: 'WELCOME10', amount: 500 });
+  const r1i = issueInvoice(r1v.value, []);
+
+  const stmt = statement('C-001', [r1i.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 1);
+  assert(stmt.value.invoices[0].total > 0);
+});
