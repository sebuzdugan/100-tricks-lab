+  const payment = recordPayment(r1i.value, { amount: totals.total, date: '2026-10-08' });
+
+  const stmt = statement('C-001', [payment.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 0);
+});
+
