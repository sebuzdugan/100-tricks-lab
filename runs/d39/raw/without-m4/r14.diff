+
+test('statement includes dueDate for each invoice', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+
+  const stmt = statement('C-001', [r1i.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices[0].dueDate, '2026-10-15');
+});
+
+test('statement with multiple invoices with one partially paid', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+  const r2i = issueInvoice(r2.value, []);
+  const t1 = invoiceTotals(r1i.value);
+  const p1 = recordPayment(r1i.value, { amount: 1000, date: '2026-10-08' });
+
+  const stmt = statement('C-001', [p1.value, r2i.value], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 2);
+  assert.equal(stmt.value.invoices[0].due, t1.total - 1000);
+  assert(stmt.value.invoices[1].due > 0);
+  const expectedTotalDue = (t1.total - 1000) + stmt.value.invoices[1].due;
+  assert.equal(stmt.value.totalDue, expectedTotalDue);
+});
+
+test('statement with empty invoice list', () => {
+  const stmt = statement('C-001', [], '2026-10-31');
+
+  assert.equal(stmt.ok, true);
+  assert.equal(stmt.value.invoices.length, 0);
+  assert.equal(stmt.value.totalDue, 0);
+});
+
