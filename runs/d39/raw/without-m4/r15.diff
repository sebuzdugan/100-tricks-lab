@@ -0,0 +1,296 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('nextCreditNoteNumber generates first credit note of the year', () => {
+  const r = nextCreditNoteNumber([], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber increments counter for same year', () => {
+  const r1 = nextCreditNoteNumber(['CN-2026-0001'], '2026-10-07');
+  const r2 = nextCreditNoteNumber(['CN-2026-0001', 'CN-2026-0002'], '2026-10-08');
+
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value, 'CN-2026-0002');
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value, 'CN-2026-0003');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const r = nextCreditNoteNumber(['INV-2026-0001', 'INV-2026-0002'], '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber resets counter for new year', () => {
+  const r = nextCreditNoteNumber(['CN-2025-0099', 'CN-2026-0005'], '2027-01-01');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'CN-2027-0001');
+});
+
+test('nextCreditNoteNumber pads counter with zeros', () => {
+  const existing = Array.from({ length: 42 }, (_, i) => `CN-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = nextCreditNoteNumber(existing, '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'CN-2026-0043');
+});
+
+test('nextCreditNoteNumber handles mixed number formats', () => {
+  const existing = [
+    'INV-2026-0001',
+    'CN-2026-0002',
+    'INV-2026-0003',
+    'CN-2026-0004',
+  ];
+  const r = nextCreditNoteNumber(existing, '2026-10-07');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'CN-2026-0005');
+});
+
+test('nextCreditNoteNumber reports invalid date format', () => {
+  const r = nextCreditNoteNumber([], 'invalid-date');
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'DATE_INVALID');
+});
+
+test('nextCreditNoteNumber returns COUNTER_OVERFLOW when limit exceeded', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `CN-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = nextCreditNoteNumber(existing, '2026-10-07');
+
+  assert.equal(r.ok, false);
+  assert.equal(r.error, 'COUNTER_OVERFLOW');
+});
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 1000, reason: 'Adjustment', date: '2026-10-08' }, []);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0001');
+  assert.equal(r3.value.invoiceNumber, r2.value.number);
+  assert.equal(r3.value.customerId, 'C-001');
+  assert.equal(r3.value.amount, 1000);
+  assert.equal(r3.value.reason, 'Adjustment');
+  assert.equal(r3.value.date, '2026-10-08');
+});
+
+test('createCreditNote works on partially_paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const r3 = recordPayment(r2.value, { amount: 1000, date: '2026-10-08' });
+  const r4 = createCreditNote(r3.value, { amount: 500, reason: 'Partial refund', date: '2026-10-09' }, []);
+
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.amount, 500);
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = recordPayment(r2.value, { amount: totals.total, date: '2026-10-08' });
+  const r4 = createCreditNote(r3.value, { amount: 1000, reason: 'Refund', date: '2026-10-09' }, []);
+
+  assert.equal(r4.ok, true);
+});
+
+test('createCreditNote refuses draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = createCreditNote(r.value, { amount: 1000, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.equal(r2.ok, false);
+  assert.equal(r2.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote validates amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  const testCases = [0, -1000, 1.5, 'invalid'];
+
+  for (const amount of testCases) {
+    const r3 = createCreditNote(r2.value, { amount, reason: 'Test', date: '2026-10-08' }, []);
+    assert.equal(r3.ok, false, `Should reject amount: ${amount}`);
+    assert.equal(r3.error, 'AMOUNT_INVALID');
+  }
+});
+
+test('createCreditNote validates date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 1000, reason: 'Test', date: 'invalid' }, []);
+
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'DATE_INVALID');
+});
+
+test('createCreditNote rejects amount exceeding invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = createCreditNote(r2.value, { amount: totals.total + 1000, reason: 'Too much', date: '2026-10-08' }, []);
+
+  assert.equal(r3.ok, false);
+  assert.equal(r3.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote accepts amount equal to invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = createCreditNote(r2.value, { amount: totals.total, reason: 'Full refund', date: '2026-10-08' }, []);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.amount, totals.total);
+});
+
+test('createCreditNote increments number across existing invoices and credits', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const existing = ['INV-2026-0001', 'CN-2026-0001', 'INV-2026-0002', 'CN-2026-0002'];
+  const r3 = createCreditNote(r2.value, { amount: 1000, reason: 'Test', date: '2026-10-08' }, existing);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote with voucher on invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1v = applyVoucher(r.value, { code: 'WELCOME10', amount: 500 });
+  const r2 = issueInvoice(r1v.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = createCreditNote(r2.value, { amount: totals.total - 100, reason: 'Partial refund', date: '2026-10-08' }, []);
+
+  assert.equal(r3.ok, true);
+  assert(r3.value.amount > 0);
+});
+
+test('createCreditNote reason is preserved', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const r3 = createCreditNote(r2.value, { amount: 1000, reason: 'Customer dissatisfaction', date: '2026-10-08' }, []);
+
+  assert.equal(r3.value.reason, 'Customer dissatisfaction');
+});
+
+test('createCreditNote for large invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = createCreditNote(r2.value, { amount: Math.floor(totals.total / 2), reason: 'Partial refund', date: '2026-10-08' }, []);
+
+  assert.equal(r3.ok, true);
+  assert(r3.value.amount > 0);
+});
+
+test('createCreditNote different years use separate counters', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+  const r2i = issueInvoice(r2.value, []);
+  const existing = ['CN-2026-0005'];
+
+  const r1c = createCreditNote(r1i.value, { amount: 1000, reason: 'Test', date: '2026-10-08' }, existing);
+  const r2c = createCreditNote(r2i.value, { amount: 1000, reason: 'Test', date: '2027-01-16' }, existing);
+
+  assert.equal(r1c.ok, true);
+  assert.equal(r1c.value.number, 'CN-2026-0006');
+  assert.equal(r2c.ok, true);
+  assert.equal(r2c.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote on invoice with partial discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 10 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+  const r3 = createCreditNote(r2.value, { amount: totals.total, reason: 'Full refund', date: '2026-10-08' }, []);
+
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.amount, totals.total);
+});
