+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+/**
+ * Get the next credit note number for a given date.
+ * @param {string[]} existingNumbers - Previously used invoice and credit note numbers
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function nextCreditNoteNumber(existingNumbers, date) {
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const year = date.substring(0, 4);
+  const creditNotePrefix = `CN-${year}-`;
+
+  let counter = 0;
+  for (const num of existingNumbers || []) {
+    if (num && num.startsWith(creditNotePrefix)) {
+      const parts = num.split('-');
+      if (parts.length === 3) {
+        const c = parseInt(parts[2], 10);
+        if (!Number.isNaN(c) && c > counter) {
+          counter = c;
+        }
+      }
+    }
+  }
+
+  counter += 1;
+
+  if (counter > 9999) {
+    return fail('COUNTER_OVERFLOW');
+  }
+
+  const paddedCounter = String(counter).padStart(4, '0');
+  return ok(`CN-${year}-${paddedCounter}`);
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ customerId: string, status: string, number: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} params
+ * @param {string[]} existingNumbers - Previously used invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status === 'draft') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  const numberResult = nextCreditNoteNumber(existingNumbers, date);
+  if (!numberResult.ok) return numberResult;
+
+  return ok({
+    number: numberResult.value,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
