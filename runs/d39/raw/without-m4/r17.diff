@@ -35,3 +36,41 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Get VAT summary by rate for invoices.
+ * @param {Array<{ status: string, lines: Array }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate || 0;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVAT(line);
+
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { base: 0, vat: 0 };
+      }
+
+      vatByRate[rate].base += base;
+      vatByRate[rate].vat += vat;
+    }
+  }
+
+  const summary = Object.entries(vatByRate).map(([rate, totals]) => ({
+    rate: parseInt(rate, 10),
+    base: totals.base,
+    vat: totals.vat,
+  }));
+
+  summary.sort((a, b) => b.rate - a.rate);
+
+  return summary;
+}
