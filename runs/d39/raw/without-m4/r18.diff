 import { balanceDue } from './payments.js';
 import { daysBetween } from './dates.js';
 import { lineTotal, lineDiscount, lineVAT } from './invoices.js';
+import { roundCents } from './money.js';
 
 /**
  * Get overdue invoices as of a given date.
@@ -74,3 +75,21 @@ export function vatSummary(invoices) {
 
   return summary;
 }
+
+/**
+ * Calculate late fee for an invoice.
+ * @param {{ dueDate: string }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents (0.04% per day of amount due)
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+
+  const fee = due * 0.0004 * daysOverdue;
+  return roundCents(fee);
+}
