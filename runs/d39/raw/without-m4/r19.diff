+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv includes header line', () => {
+  const csv = exportCsv([]);
+
+  assert(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv ends with newline', () => {
+  const csv = exportCsv([]);
+
+  assert(csv.endsWith('\n'));
+});
+
+test('exportCsv with single invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  assert(csv.includes('Northwind Studio'));
+  assert(csv.includes('2026-10-07'));
+  assert(csv.includes('issued'));
+});
+
+test('exportCsv includes invoice number', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  assert(csv.includes(r2.value.number));
+});
+
+test('exportCsv formats amounts with 2 decimals', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const totals = invoiceTotals(r2.value);
+
+  const csv = exportCsv([r2.value]);
+
+  const euros = (totals.subtotal / 100).toFixed(2);
+  assert(csv.includes(euros));
+});
+
+test('exportCsv uses dot as decimal separator', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  assert(csv.match(/\d+\.\d{2}/));
+});
+
+test('exportCsv without currency sign', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+
+  const csv = exportCsv([r2.value]);
+
+  assert(!csv.includes('€'));
