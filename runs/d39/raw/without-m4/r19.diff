+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format a value for CSV export.
+ * @param {*} value
+ * @returns {string}
+ */
+function csvEscape(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Format an amount in euros for CSV.
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEurosPlain(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {Array<{ number: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array }>} invoices
+ * @returns {string} CSV string
+ */
+export function exportCsv(invoices) {
+  const lines = [
+    'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due',
+  ];
+
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : 'Unknown';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const row = [
+      csvEscape(invoice.number),
+      csvEscape(customerName),
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatEurosPlain(totals.subtotal),
+      formatEurosPlain(totals.discount),
+      formatEurosPlain(totals.vat),
+      formatEurosPlain(totals.total),
+      formatEurosPlain(due),
+    ];
+
+    lines.push(row.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
