@@ -0,0 +1,214 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { RATES, convert, formatMoney, roundCents } from '../src/money.js';
+
+test('RATES contains EUR, USD, GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR', () => {
+  const result = convert(10000, 'EUR');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(10000, 'USD');
+
+  assert.equal(result.ok, true);
+  const expectedUsd = Math.round(10000 * 1.085);
+  assert.equal(result.value, expectedUsd);
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(10000, 'GBP');
+
+  assert.equal(result.ok, true);
+  const expectedGbp = Math.round(10000 * 0.8425);
+  assert.equal(result.value, expectedGbp);
+});
+
+test('convert rejects unknown currency', () => {
+  const result = convert(10000, 'JPY');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with zero amount', () => {
+  const result = convert(0, 'USD');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert with negative amount', () => {
+  const result = convert(-10000, 'USD');
+
+  assert.equal(result.ok, true);
+  assert(result.value < 0);
+});
+
+test('convert uses banker\'s rounding', () => {
+  const result = convert(1, 'USD');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1);
+});
+
+test('formatMoney EUR', () => {
+  const formatted = formatMoney(10000, 'EUR');
+
+  assert.equal(formatted, '€100.00');
+});
+
+test('formatMoney USD', () => {
+  const formatted = formatMoney(10000, 'USD');
+
+  assert(formatted.startsWith('$'));
+  assert(formatted.includes('.'));
+});
+
+test('formatMoney GBP', () => {
+  const formatted = formatMoney(10000, 'GBP');
+
+  assert(formatted.startsWith('£'));
+  assert(formatted.includes('.'));
+});
+
+test('formatMoney with thousands separator', () => {
+  const formatted = formatMoney(1234567, 'EUR');
+
+  assert(formatted.includes(','));
+  assert.equal(formatted, '€12,345.67');
+});
+
+test('formatMoney with negative amount', () => {
+  const formatted = formatMoney(-10000, 'EUR');
+
+  assert(formatted.startsWith('-'));
+});
+
+test('formatMoney formats cents correctly', () => {
+  const formatted = formatMoney(1, 'EUR');
+
+  assert.equal(formatted, '€0.01');
+});
+
+test('formatMoney with 100 cents', () => {
+  const formatted = formatMoney(100, 'EUR');
+
+  assert.equal(formatted, '€1.00');
+});
+
+test('formatMoney with unknown currency', () => {
+  const formatted = formatMoney(10000, 'JPY');
+
+  assert.equal(formatted, 'Invalid');
+});
+
+test('convert large amount USD', () => {
+  const result = convert(100000000, 'USD');
+
+  assert.equal(result.ok, true);
+  assert(result.value > 100000000);
+});
+
+test('formatMoney large amount USD', () => {
+  const formatted = formatMoney(100000000, 'USD');
+
+  assert(formatted.startsWith('$'));
+  assert(!formatted.includes('Invalid'));
+});
+
+test('convert one cent EUR', () => {
+  const result = convert(1, 'EUR');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 1);
+});
+
+test('convert one cent USD', () => {
+  const result = convert(1, 'USD');
+
+  assert.equal(result.ok, true);
+  assert(result.value > 0);
+});
+
+test('convert one cent GBP', () => {
+  const result = convert(1, 'GBP');
+
+  assert.equal(result.ok, true);
+  assert(result.value > 0);
+});
+
+test('formatMoney USD with cents', () => {
+  const formatted = formatMoney(12345, 'USD');
+
+  assert(formatted.includes('.'));
+  assert(formatted.includes('€') === false);
+  const lastThree = formatted.slice(-3);
+  assert(lastThree.match(/\.\d{2}/));
+});
+
+test('formatMoney GBP with cents', () => {
+  const formatted = formatMoney(9876, 'GBP');
+
+  assert(formatted.includes('.'));
+  assert(formatted.includes('£'));
+  const lastThree = formatted.slice(-3);
+  assert(lastThree.match(/\.\d{2}/));
+});
+
+test('convert preserves precision with rounding', () => {
+  const result = convert(333, 'USD');
+
+  assert.equal(result.ok, true);
+  assert(Number.isInteger(result.value));
+});
+
+test('convert multiple times consistent', () => {
+  const result1 = convert(10000, 'USD');
+  const result2 = convert(10000, 'USD');
+
+  assert.equal(result1.value, result2.value);
+});
+
+test('formatMoney EUR formatting standard', () => {
+  const formatted = formatMoney(500000, 'EUR');
+
+  assert.equal(formatted, '€5,000.00');
+});
+
+test('formatMoney currency symbols correct', () => {
+  const eur = formatMoney(10000, 'EUR');
+  const usd = formatMoney(10000, 'USD');
+  const gbp = formatMoney(10000, 'GBP');
+
+  assert(eur.includes('€'));
+  assert(usd.includes('$'));
+  assert(gbp.includes('£'));
+});
+
+test('convert GBP is lower than EUR', () => {
+  const eurResult = convert(10000, 'EUR');
+  const gbpResult = convert(10000, 'GBP');
+
+  assert(gbpResult.value < eurResult.value);
+});
+
+test('convert USD is higher than EUR', () => {
+  const eurResult = convert(10000, 'EUR');
+  const usdResult = convert(10000, 'USD');
+
+  assert(usdResult.value > eurResult.value);
+});
+
+test('formatMoney with zero', () => {
+  const formatted = formatMoney(0, 'USD');
+
+  assert.equal(formatted, '$0.00');
+});
