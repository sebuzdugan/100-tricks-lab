   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert an amount in euro cents to another currency's cents.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const converted = cents * rate;
+  return ok(roundCents(converted));
+}
+
+/**
+ * Format cents in a given currency for people.
+ * @param {number} cents - Amount in cents (EUR)
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const converted = convert(cents, currency);
+  if (!converted.ok) {
+    return 'Invalid';
+  }
+
+  const amount = converted.value;
+  const sign = amount < 0 ? '-' : '';
+  const abs = Math.abs(amount);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const symbol = { EUR: '€', USD: '$', GBP: '£' }[currency];
+
+  return `${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
