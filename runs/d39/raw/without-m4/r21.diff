+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mergeCustomers, listCustomers } from '../src/customers.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('mergeCustomers removes fromId customer', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert(!result.value.customers.find((c) => c.id === 'C-001'));
+});
+
+test('mergeCustomers keeps intoId customer', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert(result.value.customers.find((c) => c.id === 'C-002'));
+});
+
+test('mergeCustomers updates invoice customer IDs', () => {
+  const customers = listCustomers();
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const invoices = [r2.value];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+});
+
+test('mergeCustomers rejects same customer ID', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-001');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'SAME_CUSTOMER');
+});
+
+test('mergeCustomers rejects unknown fromId', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-999', 'C-002');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('mergeCustomers rejects unknown intoId', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-999');
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('mergeCustomers normalizes IDs', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'c-001 ', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert(!result.value.customers.find((c) => c.id === 'C-001'));
+});
+
+test('mergeCustomers with multiple invoices from same customer', () => {
+  const customers = listCustomers();
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+  const r2i = issueInvoice(r2.value, []);
+  const invoices = [r1i.value, r2i.value];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.filter((i) => i.customerId === 'C-002').length, 2);
+});
+
+test('mergeCustomers with mixed customer invoices', () => {
+  const customers = listCustomers();
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r1i = issueInvoice(r1.value, []);
+  const r2i = issueInvoice(r2.value, []);
+  const invoices = [r1i.value, r2i.value];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.filter((i) => i.customerId === 'C-001').length, 0);
+  assert.equal(result.value.invoices.filter((i) => i.customerId === 'C-002').length, 2);
+});
+
+test('mergeCustomers does not mutate input customers', () => {
+  const customers = listCustomers();
+  const invoices = [];
+  const customersCopy = JSON.parse(JSON.stringify(customers));
+
+  mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.deepEqual(customers, customersCopy);
+});
+
+test('mergeCustomers does not mutate input invoices', () => {
+  const customers = listCustomers();
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const invoices = [r2.value];
+  const invoicesCopy = JSON.parse(JSON.stringify(invoices));
+
+  mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.deepEqual(invoices, invoicesCopy);
+});
+
+test('mergeCustomers with empty invoice list', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('mergeCustomers reduces customer count', () => {
+  const customers = listCustomers();
+  const invoices = [];
+  const originalCount = customers.length;
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.value.customers.length, originalCount - 1);
+});
+
+test('mergeCustomers preserves invoice data except customerId', () => {
+  const customers = listCustomers();
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const r2 = issueInvoice(r.value, []);
+  const invoices = [r2.value];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  const movedInvoice = result.value.invoices[0];
+  assert.equal(movedInvoice.number, r2.value.number);
+  assert.equal(movedInvoice.issueDate, r2.value.issueDate);
+  assert.equal(movedInvoice.status, r2.value.status);
+});
+
+test('mergeCustomers case insensitive ID matching', () => {
+  const customers = listCustomers();
+  const invoices = [];
+
+  const result = mergeCustomers(customers, invoices, 'c-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert(!result.value.customers.find((c) => c.id === 'C-001'));
+});
+
+test('mergeCustomers with single customer and multiple invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'Customer One', email: 'one@example.com', country: 'US', tier: 'standard' },
+    { id: 'C-002', name: 'Customer Two', email: 'two@example.com', country: 'US', tier: 'standard' },
+  ];
+
+  const invoices = [
+    { customerId: 'C-001', issueDate: '2026-10-01', number: 'INV-2026-0001', status: 'issued', lines: [] },
+    { customerId: 'C-001', issueDate: '2026-10-02', number: 'INV-2026-0002', status: 'issued', lines: [] },
+    { customerId: 'C-001', issueDate: '2026-10-03', number: 'INV-2026-0003', status: 'issued', lines: [] },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.invoices.length, 3);
+  assert(result.value.invoices.every((i) => i.customerId === 'C-002'));
+});
+
+test('mergeCustomers preserves other customers', () => {
+  const customers = listCustomers();
+  const initialOtherCount = customers.filter((c) => c.id !== 'C-001').length;
+
+  const result = mergeCustomers(customers, [], 'C-001', 'C-002');
+
+  const resultOtherCount = result.value.customers.filter((c) => c.id !== 'C-001').length;
+  assert.equal(resultOtherCount, initialOtherCount);
+});
