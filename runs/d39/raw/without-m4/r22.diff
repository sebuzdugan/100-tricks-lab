diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..377f938
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,84 @@
+import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line (qty × unitPrice).
+ * @param {{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number }} line
+ * @returns {number} Total in cents
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount for a single line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number} Discount in cents
+ */
+export function lineDiscount(line) {
+  if (!line.discountPercent || line.discountPercent === 0) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  return roundCents(total * line.discountPercent / 100);
+}
+
+/**
+ * Calculate VAT for a single line (computed on the amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }} line
+ * @returns {number} VAT in cents
+ */
+export function lineVAT(line) {
+  if (!line.vatRate || line.vatRate === 0) {
+    return 0;
+  }
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  return roundCents(amountAfterDiscount * line.vatRate / 100);
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher, and total for an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array<{ sku: string, name: string, qty: number, unitPrice: number, vatRate: number, discountPercent?: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }} Amounts in cents
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
+    subtotal += lineTotal(line);
+    discount += lineDiscount(line);
+    vat += lineVAT(line);
+  }
+
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+
+  return {
+    subtotal: Math.max(0, subtotal),
+    discount: Math.max(0, discount),
+    vat: Math.max(0, vat),
+    voucher: Math.max(0, voucher),
+    total,
+  };
+}
+
+/**
+ * Validate a discount percentage.
+ * @param {number} discountPercent
+ * @returns {{ ok: true } | { ok: false, error: string }}
+ */
+export function validateDiscount(discountPercent) {
+  if (discountPercent === undefined || discountPercent === null) {
+    return ok(true);
+  }
+
+  if (typeof discountPercent !== 'number' || Number.isNaN(discountPercent) || discountPercent < 0 || discountPercent > 100) {
+    return fail('DISCOUNT_INVALID');
+  }
+
+  return ok(true);
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..b48be7d
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,178 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals, validateDiscount } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  const line = { qty: 5, unitPrice: 1000, sku: 'TEST', name: 'Test', vatRate: 21 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with single unit', () => {
+  const line = { qty: 1, unitPrice: 8500, sku: 'TEST', name: 'Test', vatRate: 21 };
+  assert.equal(lineTotal(line), 8500);
+});
+
+test('lineTotal handles large quantities', () => {
+  const line = { qty: 1000, unitPrice: 10000, sku: 'TEST', name: 'Test', vatRate: 21 };
+  assert.equal(lineTotal(line), 10000000);
+});
+
+test('lineDiscount returns 0 for no discount', () => {
+  const line = { qty: 1, unitPrice: 1000, sku: 'TEST', name: 'Test', vatRate: 21 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount calculates discount correctly', () => {
+  const line = { qty: 1, unitPrice: 1000, discountPercent: 10, sku: 'TEST', name: 'Test', vatRate: 21 };
+  assert.equal(lineDiscount(line), 100);
+});
+
+test('lineDiscount handles decimal discount percentages', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 2.5, sku: 'TEST', name: 'Test', vatRate: 21 };
+  assert.equal(lineDiscount(line), 2500);
+});
+
+test('lineVAT returns 0 for 0% VAT rate', () => {
+  const line = { qty: 1, unitPrice: 1000, sku: 'TEST', name: 'Test', vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT calculates VAT on amount after discount', () => {
+  const line = { qty: 1, unitPrice: 10000, discountPercent: 10, sku: 'TEST', name: 'Test', vatRate: 21 };
+  const vat = lineVAT(line);
+  const expectedBase = 10000 - 1000;
+  const expectedVat = Math.round(expectedBase * 0.21);
+  assert.equal(vat, expectedVat);
+});
+
+test('lineVAT handles different VAT rates', () => {
+  const line21 = { qty: 1, unitPrice: 10000, sku: 'TEST', name: 'Test', vatRate: 21 };
+  const line9 = { qty: 1, unitPrice: 10000, sku: 'TEST', name: 'Test', vatRate: 9 };
+  const line0 = { qty: 1, unitPrice: 10000, sku: 'TEST', name: 'Test', vatRate: 0 };
+
+  const vat21 = lineVAT(line21);
+  const vat9 = lineVAT(line9);
+  const vat0 = lineVAT(line0);
+
+  assert(vat21 > vat9);
+  assert(vat9 > vat0);
+  assert.equal(vat0, 0);
+});
+
+test('invoiceTotals calculates subtotal, discount, vat and total for single line', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ qty: 1, unitPrice: 8500, sku: 'DES-HOUR', name: 'Design', vatRate: 21, discountPercent: 5 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert(totals.subtotal > 0);
+  assert(totals.discount > 0);
+  assert(totals.vat > 0);
+  assert(totals.total > 0);
+});
+
+test('invoiceTotals calculates subtotal, discount, vat and total for multiple lines', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { qty: 1, unitPrice: 8500, sku: 'DES-HOUR', name: 'Design', vatRate: 21, discountPercent: 5 },
+      { qty: 10, unitPrice: 37, sku: 'PRINT-A4', name: 'Print', vatRate: 9, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert(totals.subtotal > 0);
+  assert(totals.vat > 0);
+  assert(totals.total > 0);
+});
+
+test('invoiceTotals handles different VAT rates', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { qty: 1, unitPrice: 10000, sku: 'SKU1', name: 'Item', vatRate: 21 },
+      { qty: 1, unitPrice: 10000, sku: 'SKU2', name: 'Item', vatRate: 9 },
+      { qty: 1, unitPrice: 10000, sku: 'SKU3', name: 'Item', vatRate: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert(totals.vat > 0);
+});
+
+test('invoiceTotals does not mutate invoice', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ qty: 1, unitPrice: 8500, sku: 'DES-HOUR', name: 'Design', vatRate: 21 }],
+  };
+
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+
+  invoiceTotals(invoice);
+
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('invoiceTotals includes voucher in total', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ qty: 1, unitPrice: 10000, sku: 'TEST', name: 'Test', vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 1000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.voucher, 1000);
+});
+
+test('validateDiscount accepts valid discount', () => {
+  const result = validateDiscount(10);
+  assert.equal(result.ok, true);
+});
+
+test('validateDiscount rejects invalid discount', () => {
+  const result = validateDiscount(-5);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'DISCOUNT_INVALID');
+});
+
+test('validateDiscount accepts undefined', () => {
+  const result = validateDiscount(undefined);
+  assert.equal(result.ok, true);
+});
+
+test('validateDiscount accepts decimal discount', () => {
+  const result = validateDiscount(2.5);
+  assert.equal(result.ok, true);
+});
+
+test('invoiceTotals with tier discounts', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [
+      { qty: 1, unitPrice: 8500, sku: 'DES-HOUR', name: 'Design', vatRate: 21, discountPercent: 5 },
+      { qty: 1, unitPrice: 9500, sku: 'DEV-HOUR', name: 'Dev', vatRate: 21, discountPercent: 5 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert(totals.discount > 0);
+  assert.equal(totals.discount, Math.round((8500 + 9500) * 0.05));
+});
