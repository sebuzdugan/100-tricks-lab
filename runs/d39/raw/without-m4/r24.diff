 }
+
+/**
+ * Generate a dashboard summary for invoices.
+ * @param {Array<{ status: string, customerId: string, dueDate: string, number: string }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = {};
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] || 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (!customerDue[invoice.customerId]) {
+        customerDue[invoice.customerId] = 0;
+      }
+      customerDue[invoice.customerId] += due;
+    }
+  }
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const totalOverdueAmount = overdue.reduce((sum, inv) => sum + inv.due, 0);
+
+  const topCustomersArray = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: totalOverdueAmount,
+    },
+    topCustomers: topCustomersArray,
+  };
+}
