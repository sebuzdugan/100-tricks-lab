+import { formatEuros } from './money.js';
+import { invoiceTotals } from './invoices.js';
+import { getCustomer } from './customers.js';
+
+/**
+ * Render an invoice as plain text.
+ * First line: invoice number or 'DRAFT'
+ * Second line: customer name
+ * Following lines: one per invoice line item
+ * Last line: total
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // First line: number or DRAFT
+  const numberLine = invoice.number ? invoice.number : 'DRAFT';
+
+  // Get customer name (fallback to customerId if not found)
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+  // Get totals
+  const totalsResult = invoiceTotals(invoice);
+  const total = totalsResult.ok ? totalsResult.value.total : 0;
+
+  // Build lines
+  const lines = [];
+  lines.push(numberLine);
+  lines.push(customerName);
+
+  for (const line of invoice.lines) {
+    const lineTotal = line.qty * line.unitPrice;
+    const lineStr = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lineTotal)}`;
+    lines.push(lineStr);
+  }
+
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..707eaa3
