+++ b/test/render.test.js
@@ -0,0 +1,223 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /Northwind Studio\n/);
+  assert.match(text, /5 x Development \(hour\) @ €95\.00 = €475\.00\n/);
+  assert.match(text, /Total: €475\.00$/);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+
+  assert.match(text, /^INV-2026-0001\n/);
+  assert.match(text, /Kite & Co\n/);
+  assert.match(text, /1 x Logo package @ €1,200\.00 = €1,200\.00\n/);
+  assert.match(text, /Total: €1,200\.00$/);
+});
+
+test('renderInvoiceText formats amounts with formatEuros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 10 },
+      { sku: 'PHOTO-LIC', qty: 5 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  // ICON-SET: 10 * 980 = 9800 cents = €98.00
+  assert.match(text, /10 x Icon set \(24 icons\) @ €9\.80 = €98\.00/);
+  // PHOTO-LIC: 5 * 996 = 4980 cents = €49.80
+  assert.match(text, /5 x Stock photo licence @ €9\.96 = €49\.80/);
+  // Total: 98.00 + 49.80 = 147.80
+  assert.match(text, /Total: €147\.80$/);
+});
+
+test('renderInvoiceText renders multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /5 x Development \(hour\)/);
+  assert.match(text, /3 x Design work \(hour\)/);
+  assert.match(text, /2 x Copywriting \(hour\)/);
+
+  const lines = text.split('\n');
+  assert.equal(lines.length, 6); // number, customer, 3 items, total
+});
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /^DRAFT/);
+  assert.equal(invoice.number, undefined);
+});
+
+test('renderInvoiceText shows number for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, ['INV-2026-0001']).value;
+  const text = renderInvoiceText(issued);
+
+  assert.match(text, /^INV-2026-0002/);
+});
+
+test('renderInvoiceText includes customer name from catalogue', () => {
+  const invoice = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /Lumen Records/);
+});
+
+test('renderInvoiceText renders items with different VAT rates', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 }, // 21% VAT
+      { sku: 'PRINT-A4', qty: 100 }, // 9% VAT
+      { sku: 'WORKSHOP-DAY', qty: 1 }, // 0% VAT
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.match(text, /1 x Development \(hour\) @ €95\.00 = €95\.00/);
+  assert.match(text, /100 x Printed flyer A4 \(each\) @ €0\.37 = €37\.00/);
+  assert.match(text, /1 x Brand workshop \(day, VAT exempt\) @ €600\.00 = €600\.00/);
+  assert.match(text, /Total: €732\.00$/);
+});
+
+test('renderInvoiceText formats line structure correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Check structure: [number/DRAFT, customer, items..., total]
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.match(lines[2], /2 x Brand guidelines document @ €2,450\.00 = €4,900\.00/);
+  assert.equal(lines[3], 'Total: €4,900.00');
+});
+
+test('renderInvoiceText handles large amounts with thousands separators', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 10 },
+      { sku: 'BRAND-BOOK', qty: 5 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  // LOGO-PACK: 10 * 120000 = 1200000 cents = €12,000.00
+  assert.match(text, /10 x Logo package @ €1,200\.00 = €12,000\.00/);
+  // BRAND-BOOK: 5 * 245000 = 1225000 cents = €12,250.00
+  assert.match(text, /5 x Brand guidelines document @ €2,450\.00 = €12,250\.00/);
+  // Total: 12000 + 12250 = 24250
+  assert.match(text, /Total: €24,250\.00$/);
+});
+
+test('renderInvoiceText works with single line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1000 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4); // number, customer, item, total
+  assert.match(text, /1000 x Sticker sheet @ €0\.50 = €500\.00/);
+});
+
+test('renderInvoiceText preserves order of line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  const devIndex = text.indexOf('Development (hour)');
+  const desIndex = text.indexOf('Design work (hour)');
+  const copyIndex = text.indexOf('Copywriting (hour)');
+
+  assert(devIndex < desIndex && desIndex < copyIndex, 'Items should be in order');
+});
+
+test('renderInvoiceText returns a single string with newlines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  assert.equal(typeof text, 'string');
+  assert(text.includes('\n'));
+  const lines = text.split('\n');
+  assert(lines.length > 0);
+});
