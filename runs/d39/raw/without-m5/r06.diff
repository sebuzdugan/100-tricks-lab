+
+test('invoiceTotals returns subtotal, discount, and total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  }).value;
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 95000); // 10 * 9500
+  assert.equal(result.value.discount, 9500); // 95000 * 10 / 100
+  assert.equal(result.value.total, 85500); // 95000 - 9500
+});
+
+test('invoiceTotals calculates multiple line discounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10, discountPercent: 10 },
+      { sku: 'DES-HOUR', qty: 10, discountPercent: 20 },
+    ],
+  }).value;
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  // DEV-HOUR: 10 * 9500 = 95000, discount 10% = 9500
+  // DES-HOUR: 10 * 8500 = 85000, discount 20% = 17000
+  // Subtotal: 180000, Discount: 26500, Total: 153500
+  assert.equal(result.value.subtotal, 180000);
+  assert.equal(result.value.discount, 26500);
+  assert.equal(result.value.total, 153500);
+});
+
+test('invoiceTotals handles decimal discounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, discountPercent: 12.5 }],
+  }).value;
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 9500);
+  assert.equal(result.value.discount, 1188); // 9500 * 12.5 / 100 = 1187.5, rounded to 1188
+  assert.equal(result.value.total, 8312); // 9500 - 1188
+});
+
+test('invoiceTotals handles 100% discount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 100 }],
+  }).value;
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 47500);
+  assert.equal(result.value.discount, 47500);
+  assert.equal(result.value.total, 0); // Clamped at 0
+});
+
+test('invoiceTotals clamps negative totals at 0', () => {
+  // This shouldn't happen with valid input, but testing clamping
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, name: 'Dev', unitPrice: 1000, vatRate: 21, discountPercent: 50 }],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 5000);
+  assert.equal(result.value.discount, 2500);
+  assert.equal(result.value.total, 2500);
+  assert(result.value.total >= 0, 'Total should never be negative');
+});
