+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+  assert.equal(result.value.lines[1].discountPercent, 20.5);
+});
+
+test('createInvoice defaults discountPercent to 0', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice rejects negative discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: -10 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('createInvoice rejects discountPercent over 100', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: 101 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('createInvoice rejects non-numeric discountPercent', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5, discountPercent: '10' }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('addLine accepts discountPercent', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const result = addLine(invoice, { sku: 'DES-HOUR', qty: 3, discountPercent: 15 });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 15);
+});
+
+test('addLine defaults discountPercent to 0', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const result = addLine(invoice, { sku: 'DES-HOUR', qty: 3 });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 0);
+});
+
+test('addLine rejects invalid discountPercent', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
