+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2026-10-7'), false); // missing leading zero
+  assert.equal(isValidDate('2026-1-07'), false); // missing leading zero
+  assert.equal(isValidDate('26-10-07'), false); // 2-digit year
+  assert.equal(isValidDate('2026/10/07'), false); // wrong separator
+  assert.equal(isValidDate('10-07-2026'), false); // wrong order
+  assert.equal(isValidDate(''), false); // empty string
+  assert.equal(isValidDate('2026-10-07T00:00:00Z'), false); // ISO format with time
+});
+
+test('isValidDate rejects impossible dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false); // Feb 30
+  assert.equal(isValidDate('2026-04-31'), false); // Apr 31
+  assert.equal(isValidDate('2026-13-01'), false); // month 13
+  assert.equal(isValidDate('2026-00-01'), false); // month 0
+  assert.equal(isValidDate('2026-10-00'), false); // day 0
+});
+
+test('isValidDate rejects Feb 29 on non-leap years', () => {
+  assert.equal(isValidDate('2025-02-29'), false); // 2025 is not a leap year
+  assert.equal(isValidDate('2026-02-29'), false); // 2026 is not a leap year
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 365), '2027-10-07');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  assert.equal(addDays('2026-10-01', -1), '2026-09-30');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // 2024 is a leap year
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01'); // 2025 is not a leap year
+});
+
+test('addDays with zero days returns same date', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween calculates positive differences', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2027-10-07'), 365);
+});
+
+test('daysBetween calculates negative differences', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+});
+
+test('daysBetween returns 0 for same date', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+  assert.equal(daysBetween('2026-10-01', '2026-09-30'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1); // leap year
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  assert.equal(daysBetween('2025-02-28', '2025-03-01'), 1); // non-leap year
+});
+
+test('daysBetween uses UTC (no timezone issues)', () => {
+  // These tests verify UTC is used, not local timezone
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const start = '2026-10-07';
+  const end = addDays(start, 100);
+  assert.equal(daysBetween(start, end), 100);
+
+  const start2 = '2026-06-15';
+  const end2 = addDays(start2, -50);
+  assert.equal(daysBetween(start2, end2), -50);
+  assert.equal(daysBetween(end2, start2), 50);
+});
