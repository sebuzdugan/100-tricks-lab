+/**
+ * Calculate the last day of the month for a given date.
+ * @param {string} date in YYYY-MM-DD format
+ * @returns {string} last day of that month in YYYY-MM-DD format
+ */
+function getEndOfMonth(date) {
+  const [year, month] = date.split('-').map(Number);
+  const nextMonth = month === 12 ? 1 : month + 1;
+  const nextYear = month === 12 ? year + 1 : year;
+  const firstOfNextMonth = `${nextYear}-${String(nextMonth).padStart(2, '0')}-01`;
+  return addDays(firstOfNextMonth, -1);
+}
+
+/**
+ * Calculate the due date based on payment terms.
+ * @param {string} issueDate in YYYY-MM-DD format
+ * @param {string} terms NET14, NET30, or EOM
+ * @returns {string} due date in YYYY-MM-DD format or null if invalid
+ */
+function calculateDueDate(issueDate, terms) {
+  switch (terms) {
+    case 'NET14':
+      return addDays(issueDate, 14);
+    case 'NET30':
+      return addDays(issueDate, 30);
+    case 'EOM':
+      return getEndOfMonth(issueDate);
+    default:
+      return null;
+  }
+}
