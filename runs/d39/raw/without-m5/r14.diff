+import { ok, fail } from './result.js';
+import { getCustomer, normalizeId } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate, daysBetween } from './dates.js';
+
+/**
+ * Generate a customer statement listing outstanding invoices.
+ * @param {string} customerId
+ * @param {Array} invoices array of all invoices
+ * @param {string} asOf date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize customerId for comparison
+  const normalizedCustomerId = normalizeId(customerId);
+
+  // Validate customer
+  const customerResult = getCustomer(normalizedCustomerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Validate asOf date
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Filter and map invoices
+  const statementInvoices = [];
+  let totalDue = 0;
+
+  for (const invoice of invoices || []) {
+    if (!invoice) continue;
+
+    // Skip if not issued or partially_paid
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+      continue;
+    }
+
+    // Skip if customer doesn't match
+    if (invoice.customerId !== normalizedCustomerId) {
+      continue;
+    }
+
+    // Skip if issueDate is after asOf
+    if (daysBetween(invoice.issueDate, asOf) < 0) {
+      continue;
+    }
+
+    // Calculate due amount
+    const due = balanceDue(invoice);
+    totalDue += due;
+
+    // Get invoice total
+    const totalsResult = invoiceTotals(invoice);
+    const total = totalsResult.ok ? totalsResult.value.total : 0;
+
+    statementInvoices.push({
+      number: invoice.number,
+      issueDate: invoice.issueDate,
+      dueDate: invoice.dueDate,
+      total,
+      due,
+    });
+  }
+
+  // Sort by issueDate
+  statementInvoices.sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: statementInvoices,
+    totalDue: Math.max(0, totalDue),
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
new file mode 100644
