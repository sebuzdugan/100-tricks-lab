+++ b/src/numbering.js
@@ -23,3 +23,29 @@ export function nextInvoiceNumber(existingNumbers, issueDate) {
   const paddedCounter = String(nextCounter).padStart(4, '0');
   return `${prefix}${paddedCounter}`;
 }
+
+/**
+ * Calculate the next credit note number for a given issue date.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate in YYYY-MM-DD format
+ * @returns {string} the next credit note number in CN-<year>-<counter> format
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `CN-${year}-`;
+
+  let maxCounter = 0;
+  for (const num of existingNumbers) {
+    if (num.startsWith(prefix)) {
+      const counterStr = num.slice(prefix.length);
+      const counter = Number(counterStr);
+      if (!Number.isNaN(counter) && counter > maxCounter) {
+        maxCounter = counter;
+      }
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `${prefix}${paddedCounter}`;
+}
