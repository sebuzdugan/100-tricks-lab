+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Discount');
+  assert.equal(result.value.date, '2026-10-08');
+});
+
+test('createCreditNote works on partially_paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const paid = recordPayment(issued, { amount: 10000, date: '2026-10-08' }).value;
+  const result = createCreditNote(paid, { amount: 5000, reason: 'Partial refund', date: '2026-10-09' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const total = 6050; // 5000 + 1050 VAT
+  const paid = recordPayment(issued, { amount: total, date: '2026-10-08' }).value;
+  const result = createCreditNote(paid, { amount: 2000, reason: 'Refund', date: '2026-10-09' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const result = createCreditNote(inv1, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects invalid amount (zero)', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const result = createCreditNote(issued, { amount: 0, reason: 'Discount', date: '2026-10-08' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects invalid amount (negative)', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const result = createCreditNote(issued, { amount: -1000, reason: 'Discount', date: '2026-10-08' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects invalid amount (non-integer)', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const result = createCreditNote(issued, { amount: 1000.5, reason: 'Discount', date: '2026-10-08' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote rejects invalid date format', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Discount', date: 'invalid' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote rejects impossible date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2026-02-30' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote rejects credit amount exceeding invoice total', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  // Invoice total is 11495
+  const result = createCreditNote(issued, { amount: 11496, reason: 'Discount', date: '2026-10-08' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows credit equal to invoice total', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  // Invoice total is 11495
+  const result = createCreditNote(issued, { amount: 11495, reason: 'Full refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 11495);
+});
+
+test('createCreditNote increments counter from existing numbers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const existingNumbers = ['CN-2026-0001', 'CN-2026-0002', 'CN-2026-0005'];
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, existingNumbers);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0006');
+});
+
+test('createCreditNote respects year in credit note numbering', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2027-01-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, ['CN-2026-0005']).value;
+
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2027-01-08' }, ['CN-2026-0005']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote with mixed invoice and credit note numbers', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001', 'CN-2026-0002'];
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, existingNumbers);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote with invoice that has voucher', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+
+  const withVoucher = applyVoucher(inv1, { code: 'SAVE10', amount: 5000 }).value;
+  const issued = issueInvoice(withVoucher, []).value;
+
+  // Total: 22990 - 5000 = 17990
+  const result = createCreditNote(issued, { amount: 8000, reason: 'Partial refund', date: '2026-10-08' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 8000);
+});
+
+test('createCreditNote rejects credit exceeding voucher-reduced total', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+
+  const withVoucher = applyVoucher(inv1, { code: 'SAVE10', amount: 5000 }).value;
+  const issued = issueInvoice(withVoucher, []).value;
+
+  // Total: 22990 - 5000 = 17990
+  const result = createCreditNote(issued, { amount: 17991, reason: 'Refund', date: '2026-10-08' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote does not mutate input invoice', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const originalNumber = issued.number;
+  const originalStatus = issued.status;
+
+  createCreditNote(issued, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+
+  assert.equal(issued.number, originalNumber);
+  assert.equal(issued.status, originalStatus);
+});
+
+test('createCreditNote with multiple credit notes on same invoice', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result1 = createCreditNote(issued, { amount: 5000, reason: 'First refund', date: '2026-10-08' }, []);
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.number, 'CN-2026-0001');
+
+  const result2 = createCreditNote(issued, { amount: 3000, reason: 'Second refund', date: '2026-10-09' }, [result1.value.number]);
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.number, 'CN-2026-0002');
+});
