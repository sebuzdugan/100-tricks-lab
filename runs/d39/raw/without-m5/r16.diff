+import { ok, fail } from './result.js';
+import { balanceDue } from './payments.js';
+import { isValidDate, daysBetween } from './dates.js';
+
+/**
+ * Get a list of overdue invoices.
+ * @param {Array} invoices
+ * @param {string} asOf date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }> } | { ok: false, error: string }}
+ */
+export function overdueInvoices(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  const overdue = [];
+
+  for (const invoice of invoices || []) {
+    if (!invoice) continue;
+
+    // Skip if not issued or partially_paid
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+      continue;
+    }
+
+    // Skip if dueDate is not before asOf
+    if (daysBetween(invoice.dueDate, asOf) <= 0) {
+      continue;
+    }
+
+    // Calculate days overdue
+    const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+    // Calculate due amount
+    const due = balanceDue(invoice);
+
+    overdue.push({
+      number: invoice.number,
+      customerId: invoice.customerId,
+      dueDate: invoice.dueDate,
+      daysOverdue,
+      due,
+    });
+  }
+
+  // Sort by daysOverdue descending (most overdue first)
+  overdue.sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return ok(overdue);
+}
