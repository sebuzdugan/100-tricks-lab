+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty list for no invoices', () => {
+  const result = overdueInvoices([], '2026-10-15');
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value, []);
+});
+
+test('overdueInvoices rejects invalid asOf date', () => {
+  const result = overdueInvoices([], 'invalid');
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('overdueInvoices rejects impossible asOf date', () => {
+  const result = overdueInvoices([], '2026-02-30');
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('overdueInvoices includes invoice with dueDate before asOf', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  // dueDate is 2026-10-19
+
+  const result = overdueInvoices([issued], '2026-10-25');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].number, 'INV-2026-0001');
+  assert.equal(result.value[0].daysOverdue, 6); // 2026-10-25 - 2026-10-19
+});
+
+test('overdueInvoices excludes invoice with dueDate on asOf', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  // dueDate is 2026-10-19
+
+  const result = overdueInvoices([issued], '2026-10-19');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices excludes invoice with dueDate after asOf', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  // dueDate is 2026-10-19
+
+  const result = overdueInvoices([issued], '2026-10-15');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 0);
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const paid = recordPayment(issued, { amount: 5000, date: '2026-10-20' }).value;
+
+  const result = overdueInvoices([paid], '2026-10-25');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.length, 1);
+  assert.equal(result.value[0].due, 6495); // 11495 - 5000
+});
+
