+/**
+ * Get a VAT summary across all invoices.
+ * @param {Array} invoices
+ * @returns {{ ok: true, value: Array<{ rate: number, base: number, vat: number }> } | { ok: false, error: string }}
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices || []) {
+    if (!invoice) continue;
+
+    // Skip if not issued, partially_paid, or paid
+    if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+      continue;
+    }
+
+    // Process each line
+    for (const line of invoice.lines || []) {
+      // Calculate line total (gross amount)
+      const gross = Math.round(line.qty * line.unitPrice);
+
+      // Calculate discount
+      const discount = line.discountPercent ? roundCents((gross * line.discountPercent) / 100) : 0;
+
+      // Calculate base (amount VAT is calculated on)
+      const base = gross - discount;
+
+      // Calculate VAT for this line
+      const lineVat = roundCents((base * line.vatRate) / 100);
+
+      // Track by rate
+      const rate = line.vatRate;
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      vatByRate[rate].base += base;
+      vatByRate[rate].vat += lineVat;
+    }
+  }
+
+  // Convert to array and sort by rate descending
+  const summary = Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
+
+  return ok(summary);
+}
