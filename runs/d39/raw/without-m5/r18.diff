+/**
+ * Calculate late fee for an invoice.
+ * @param {{ status: string, dueDate: string, lines: Array }} invoice
+ * @param {string} asOf date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lateFee(invoice, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Invoice must have issued status or later
+  if (!invoice || (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid')) {
+    return ok(0);
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // If not overdue, return 0
+  if (daysOverdue <= 0) {
+    return ok(0);
+  }
+
+  // Calculate amount due
+  const due = balanceDue(invoice);
+
+  // Calculate fee: 0.04% per day
+  // 0.04% = 0.0004
+  const fee = roundCents(due * daysOverdue * 0.0004);
+
+  return ok(fee);
+}
