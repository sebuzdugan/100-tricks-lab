+
+test('exportCsv with zero discount', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002', // standard tier with 0% discount
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // discount should be 0.00
+  assert.equal(fields[6], '0.00');
+});
+
+test('exportCsv with multiple line items', () => {
+  const inv1 = {
+    status: 'issued',
+    number: 'INV-2026-0001',
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    dueDate: '2026-11-04',
+    lines: [
+      { sku: 'DEV-HOUR', name: 'Dev Hour', qty: 2, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+      { sku: 'STICKER', name: 'Sticker', qty: 100, unitPrice: 50, vatRate: 9, discountPercent: 0 },
+    ],
+  };
+
+  const result = exportCsv([inv1]);
+
+  const lines = result.split('\n');
+  // subtotal: 19000 + 5000 = 24000 (240.00)
+  // vat: 3990 + 450 = 4440 (44.40)
+  assert(lines[1].includes('240.00'));
+  assert(lines[1].includes('44.40'));
+});
+
+test('exportCsv handles undefined invoices gracefully', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const result = exportCsv([issued1, undefined, null]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3); // header + 1 data + empty line
+});
+
+test('exportCsv CSV is valid format', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-004', // has comma in name
+    issueDate: '2026-10-06',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, [issued1.number]).value;
+
+  const result = exportCsv([issued1, issued2]);
+
+  // Parse the CSV to verify it's valid
+  const lines = result.split('\n').filter(l => l.length > 0);
+  assert(lines[0].includes('number,customer'));
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+  assert(lines[2].includes('"Smith, Jones & Partners"'));
+});
