+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header for empty invoices', () => {
+  const result = exportCsv([]);
+
+  const lines = result.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], '');
+});
+
+test('exportCsv exports single invoice', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3); // header + data + empty line
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[1].includes('Blue Fern Bakery'));
+  assert(lines[1].includes('2026-10-05'));
+  assert(lines[1].includes('issued'));
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // subtotal should be 95.00
+  assert(fields[5].includes('95.00'));
+  // vat should be 19.95
+  assert(fields[7].includes('19.95'));
+});
+
+test('exportCsv with multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-06',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, [issued1.number]).value;
+
+  const result = exportCsv([issued1, issued2]);
+
+  const lines = result.split('\n').filter(l => l.length > 0);
+  assert.equal(lines.length, 3); // header + 2 data
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+});
+
+test('exportCsv escapes customer names with commas', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-004', // Smith, Jones & Partners
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  assert(lines[1].includes('"Smith, Jones & Partners"'));
+});
+
+test('exportCsv escapes customer names with quotes', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-006', // Marlow "The Print Shop"
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  // Should escape quotes by doubling them
+  assert(lines[1].includes('"Marlow ""The Print Shop"""'));
+});
+
+test('exportCsv with draft invoices excluded', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const result = exportCsv([inv1]);
+
+  const lines = result.split('\n').filter(l => l.length > 0);
+  assert.equal(lines.length, 1); // header only (draft not included)
+});
+
+test('exportCsv with partially_paid invoice', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const paid = recordPayment(issued, { amount: 5000, date: '2026-10-08' }).value;
+
+  const result = exportCsv([paid]);
+
+  const lines = result.split('\n');
+  assert(lines[1].includes('partially_paid'));
+  // due should be 114.95 - 50.00 = 64.95
+  assert(lines[1].includes('64.95'));
+});
+
+test('exportCsv with paid invoice', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const paid = recordPayment(issued, { amount: 11495, date: '2026-10-08' }).value;
+
+  const result = exportCsv([paid]);
+
+  const lines = result.split('\n');
+  assert(lines[1].includes('paid'));
+  // due should be 0.00
+  const fields = lines[1].split(',');
+  assert.equal(fields[fields.length - 1], '0.00');
+});
+
+test('exportCsv with invoice containing discount', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001', // gold tier with 5% discount
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // subtotal: 95.00, discount: 4.75, vat: 18.95
+  assert(fields[5].includes('95.00'));
+  assert(fields[6].includes('4.75'));
+});
+
+test('exportCsv with voucher', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+
+  const withVoucher = applyVoucher(inv1, { code: 'SAVE10', amount: 5000 }).value;
+  const issued = issueInvoice(withVoucher, []).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  // total: 229.90 - 50.00 = 179.90
+  assert(lines[1].includes('179.90'));
+});
+
+test('exportCsv with different payment terms', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  assert(lines[1].includes('2026-10-19')); // NET14 due date
+});
+
+test('exportCsv lines end with newline', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const result = exportCsv([issued]);
+
+  assert(result.endsWith('\n'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-06',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, [issued1.number]).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+  const issued3 = issueInvoice(inv3, [issued1.number, issued2.number]).value;
+
+  const result = exportCsv([issued1, issued2, issued3]);
+
+  const lines = result.split('\n').filter(l => l.length > 0);
+  assert(lines[1].includes('INV-2026-0001'));
+  assert(lines[2].includes('INV-2026-0002'));
+  assert(lines[3].includes('INV-2026-0003'));
+});
+
+test('exportCsv with mixed invoice statuses', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-06',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
