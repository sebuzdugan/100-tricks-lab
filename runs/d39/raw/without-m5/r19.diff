+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format an amount in cents as euros with 2 decimals.
+ * @param {number} cents
+ * @returns {string} formatted amount (e.g., "1234.50")
+ */
+function formatEuro(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Escape a CSV field value.
+ * @param {string} value
+ * @returns {string} escaped value
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array} invoices
+ * @returns {string} CSV content
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Add header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Process each invoice
+  for (const invoice of invoices || []) {
+    if (!invoice) continue;
+
+    // Skip draft invoices
+    if (invoice.status === 'draft') {
+      continue;
+    }
+
+    // Get customer name
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : 'Unknown';
+
+    // Get totals
+    const totalsResult = invoiceTotals(invoice);
+    const totals = totalsResult.ok ? totalsResult.value : { subtotal: 0, discount: 0, vat: 0, total: 0 };
+
+    // Get due amount
+    const due = balanceDue(invoice);
+
+    // Build CSV row
+    const fields = [
+      invoice.number || '',
+      customerName,
+      invoice.issueDate || '',
+      invoice.dueDate || '',
+      invoice.status || '',
+      formatEuro(totals.subtotal),
+      formatEuro(totals.discount),
+      formatEuro(totals.vat),
+      formatEuro(totals.total),
+      formatEuro(due),
+    ];
+
+    // Escape and join fields
+    const escapedFields = fields.map(escapeCsvField);
+    lines.push(escapedFields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
