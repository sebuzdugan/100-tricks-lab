   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = { EUR: 1, USD: 1.085, GBP: 0.8425 };
+
+/**
+ * Convert euro cents to another currency.
+ * @param {number} cents amount in euro cents
+ * @param {string} currency EUR, USD, or GBP
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  if (!Number.isInteger(cents) || cents < 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const rate = RATES[currency];
+  const converted = roundCents(cents * rate);
+  return ok(converted);
+}
+
+/**
+ * Format cents in a specified currency for people: 123456 in USD -> "$1,340.29".
+ * @param {number} cents amount in euro cents
+ * @param {string} currency EUR, USD, or GBP
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function formatMoney(cents, currency) {
+  const conversionResult = convert(cents, currency);
+  if (!conversionResult.ok) {
+    return conversionResult;
+  }
+
+  const convertedCents = conversionResult.value;
+  const symbols = { EUR: '€', USD: '$', GBP: '£' };
+  const symbol = symbols[currency] || currency;
+
+  const sign = convertedCents < 0 ? '-' : '';
+  const abs = Math.abs(convertedCents);
+  const wholeAmount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const decimalPart = String(abs % 100).padStart(2, '0');
+
+  return ok(`${sign}${symbol}${wholeAmount}.${decimalPart}`);
+}
