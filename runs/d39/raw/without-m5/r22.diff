+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  const result = lineTotal(line);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 95000);
+});
+
+test('lineTotal works with different amounts', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 2000 }).value, 10000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 100 }).value, 100);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 50 }).value, 5000);
+});
+
+test('lineTotal reports AMOUNT_INVALID for missing fields', () => {
+  const result1 = lineTotal({});
+  const result2 = lineTotal({ qty: 10 });
+  const result3 = lineTotal({ unitPrice: 100 });
+
+  assert.deepEqual(result1, { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(result2, { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(result3, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('lineTotal reports AMOUNT_INVALID for non-number values', () => {
+  assert.deepEqual(lineTotal({ qty: '10', unitPrice: 100 }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(lineTotal({ qty: 10, unitPrice: '100' }), { ok: false, error: 'AMOUNT_INVALID' });
+  assert.deepEqual(lineTotal({ qty: null, unitPrice: 100 }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('invoiceTotals calculates subtotal and total', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 9500);
+  assert.equal(result.value.total, 11495);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 9500);
+  assert.equal(result.value.discount, 0);
+  assert.equal(result.value.vat, 1995);
+  assert.equal(result.value.voucher, 0);
+  assert.equal(result.value.total, 11495);
+});
+
+test('invoiceTotals with many lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+      { qty: 100, unitPrice: 50, vatRate: 9, discountPercent: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 24000); // 19000 + 5000
+});
+
+test('invoiceTotals reports NO_LINES for empty lines', () => {
+  const result = invoiceTotals({ lines: [] });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('invoiceTotals reports NO_LINES for missing lines', () => {
+  const result1 = invoiceTotals({});
+  const result2 = invoiceTotals({ lines: null });
+
+  assert.deepEqual(result1, { ok: false, error: 'NO_LINES' });
+  assert.deepEqual(result2, { ok: false, error: 'NO_LINES' });
+});
+
+test('invoiceTotals propagates lineTotal errors', () => {
+  const invoice = {
+    lines: [
+      { qty: 'invalid', unitPrice: 100, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('invoiceTotals with line discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 9500, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 9500);
+  assert.equal(result.value.discount, 950); // 10% of 9500
+  assert.equal(result.value.vat, 1796); // 21% of 8550 = 1795.5 → 1796
+  assert.equal(result.value.total, 10346);
+});
+
+test('invoiceTotals with multiple line discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 10000, vatRate: 21, discountPercent: 10 },
+      { qty: 1, unitPrice: 5000, vatRate: 9, discountPercent: 20 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  // Line 1: 10000 - 1000 = 9000, VAT = 1890
+  // Line 2: 5000 - 1000 = 4000, VAT = 360
+  assert.equal(result.value.subtotal, 15000);
+  assert.equal(result.value.discount, 2000);
+  assert.equal(result.value.vat, 2250);
+});
+
+test('invoiceTotals handles decimal discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 9500, vatRate: 21, discountPercent: 12.5 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.discount, 1188); // 12.5% of 9500 = 1187.5 → 1188
+});
+
+test('invoiceTotals handles 100% discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 9500, vatRate: 21, discountPercent: 100 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.subtotal, 9500);
+  assert.equal(result.value.discount, 9500);
+  assert.equal(result.value.vat, 0); // No VAT on zero net amount
+  assert.equal(result.value.total, 0);
+});
+
+test('invoiceTotals clamps negative totals at 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert(result.value.total >= 0);
+});
+
+test('invoiceTotals with different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+      { qty: 100, unitPrice: 50, vatRate: 9, discountPercent: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  // Line 1: VAT = 19000 * 0.21 = 3990
+  // Line 2: VAT = 5000 * 0.09 = 450
+  assert.equal(result.value.vat, 4440);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  // subtotal = 19000, vat = 3990, total = 22990 - 5000 = 17990
+  assert.equal(result.value.subtotal, 19000);
+  assert.equal(result.value.vat, 3990);
+  assert.equal(result.value.voucher, 5000);
+  assert.equal(result.value.total, 17990);
+});
+
+test('invoiceTotals without voucher shows zero voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.voucher, 0);
+});
+
+test('invoiceTotals with VAT rounding per line', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 333, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  // 333 * 0.21 = 69.93 → 70
+  assert.equal(result.value.vat, 70);
+});
+
+test('invoiceTotals with multiple lines and mixed discounts/VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 9500, vatRate: 21, discountPercent: 5 },
+      { qty: 100, unitPrice: 50, vatRate: 9, discountPercent: 10 },
+    ],
+  };
+
+  const result = invoiceTotals(invoice);
+
+  assert.equal(result.ok, true);
+  // Line 1: 47500 - 2375 (5%) = 45125, VAT = 9476
+  // Line 2: 5000 - 500 (10%) = 4500, VAT = 405
+  assert.equal(result.value.subtotal, 52500);
+  assert.equal(result.value.discount, 2875);
+  assert.equal(result.value.vat, 9881);
+});
