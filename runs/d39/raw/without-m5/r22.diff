@@ -0,0 +1,55 @@
+import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line: qty times unitPrice.
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineTotal(line) {
+  if (!line || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number') {
+    return fail('AMOUNT_INVALID');
+  }
+  const total = Math.round(line.qty * line.unitPrice);
+  return ok(total);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { amount: number } }}
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, voucher: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines) || invoice.lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  let subtotal = 0;
+  let totalDiscount = 0;
+  let totalVAT = 0;
+
+  for (const line of invoice.lines) {
+    const lineResult = lineTotal(line);
+    if (!lineResult.ok) return lineResult;
+    const gross = lineResult.value;
+
+    subtotal += gross;
+
+    // Calculate discount for this line
+    const lineDiscount = line.discountPercent ? roundCents((gross * line.discountPercent) / 100) : 0;
+    totalDiscount += lineDiscount;
+
+    // Calculate VAT for this line (on the amount after discount)
+    const net = gross - lineDiscount;
+    const lineVAT = roundCents((net * line.vatRate) / 100);
+    totalVAT += lineVAT;
+  }
+
+  subtotal = Math.max(0, subtotal);
+  totalDiscount = Math.max(0, totalDiscount);
+  totalVAT = Math.max(0, totalVAT);
+  const voucherAmount = invoice.voucher ? Math.max(0, invoice.voucher.amount) : 0;
+  const total = Math.max(0, subtotal - totalDiscount + totalVAT - voucherAmount);
+
+  return ok({ subtotal, discount: totalDiscount, vat: totalVAT, voucher: voucherAmount, total });
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
