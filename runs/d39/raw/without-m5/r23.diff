diff --git a/src/totals.js b/src/totals.js
index e2e9d5d..8db920c 100644
--- a/src/totals.js
+++ b/src/totals.js
@@ -37,10 +37,16 @@ export function invoiceTotals(invoice) {
 
     // Calculate discount for this line
     const lineDiscount = line.discountPercent ? roundCents((gross * line.discountPercent) / 100) : 0;
-    totalDiscount += lineDiscount;
 
-    // Calculate VAT for this line (on the amount after discount)
-    const net = gross - lineDiscount;
+    // Calculate bulk discount (2.5% if qty >= 10, applied after line discount)
+    const netAfterLineDiscount = gross - lineDiscount;
+    const bulkDiscount = line.qty >= 10 ? roundCents((netAfterLineDiscount * 2.5) / 100) : 0;
+
+    const totalLineDiscount = lineDiscount + bulkDiscount;
+    totalDiscount += totalLineDiscount;
+
+    // Calculate VAT for this line (on the amount after both discounts)
+    const net = gross - totalLineDiscount;
     const lineVAT = roundCents((net * line.vatRate) / 100);
     totalVAT += lineVAT;
   }
