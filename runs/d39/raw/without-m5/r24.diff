+/**
+ * Generate a dashboard summary of invoice status.
+ * @param {Array} invoices
+ * @param {string} asOf date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { counts: object, outstanding: number, overdue: object, topCustomers: Array } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  // Validate asOf date
+  if (!isValidDate(asOf)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  // Track due amounts by customer
+  const customerDue = {};
+
+  // Calculate outstanding and track customer dues
+  let outstanding = 0;
+
+  for (const invoice of invoices || []) {
+    if (!invoice) continue;
+
+    // Count by status
+    if (counts.hasOwnProperty(invoice.status)) {
+      counts[invoice.status]++;
+    }
+
+    // Calculate outstanding for issued and partially_paid
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      // Track by customer
+      if (!customerDue[invoice.customerId]) {
+        customerDue[invoice.customerId] = 0;
+      }
+      customerDue[invoice.customerId] += due;
+    }
+  }
+
+  // Get overdue invoices
+  const overdueResult = overdueInvoices(invoices, asOf);
+  const overdueList = overdueResult.ok ? overdueResult.value : [];
+
+  // Calculate overdue totals
+  let overdueCount = 0;
+  let overdueAmount = 0;
+  for (const overdue of overdueList) {
+    overdueCount++;
+    overdueAmount += overdue.due;
+  }
+
+  // Find top 3 customers by due amount
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({
+    counts,
+    outstanding,
+    overdue: { count: overdueCount, amount: overdueAmount },
+    topCustomers,
+  });
+}
