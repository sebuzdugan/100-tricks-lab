+  const result = dashboard([], '2026-10-15');
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.value.counts, {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  });
+  assert.equal(result.value.outstanding, 0);
+  assert.deepEqual(result.value.overdue, { count: 0, amount: 0 });
