@@ -6,10 +6,13 @@ import { getCustomer } from './customers.js';
  * Render an invoice as plain text.
  * First line: invoice number or 'DRAFT'
  * Second line: customer name
- * Following lines: one per invoice line item
+ * Following lines: one per invoice line item (with discount shown if applicable)
+ * Voucher line: shown if voucher exists
  * VAT line: shown just above total
- * Last line: total
- * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * Total line: total amount due
+ * Due date line: shown if invoice has a dueDate
+ * Paid line: shown if invoice has payments
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number }>, dueDate?: string, voucher?: object, payments?: Array }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -24,6 +27,8 @@ export function renderInvoiceText(invoice) {
   const totalsResult = invoiceTotals(invoice);
   const vat = totalsResult.ok ? totalsResult.value.vat : 0;
   const total = totalsResult.ok ? totalsResult.value.total : 0;
+  const voucher = totalsResult.ok ? totalsResult.value.voucher : 0;
+  const discount = totalsResult.ok ? totalsResult.value.discount : 0;
 
   // Build lines
   const lines = [];
@@ -34,6 +39,18 @@ export function renderInvoiceText(invoice) {
     const lineTotal = line.qty * line.unitPrice;
     const lineStr = `${line.qty} x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(lineTotal)}`;
     lines.push(lineStr);
+
+    // Add line discount if it exists
+    if (line.discountPercent && line.discountPercent > 0) {
+      const lineDiscount = Math.round(lineTotal * line.discountPercent / 100);
+      lines.push(`  Discount: ${formatEuros(lineDiscount)}`);
+    }
+  }
+
+  // Add voucher if it exists
+  if (voucher > 0) {
+    const voucherCode = invoice.voucher?.code ? ` (${invoice.voucher.code})` : '';
+    lines.push(`Voucher${voucherCode}: -${formatEuros(voucher)}`);
   }
 
   if (vat > 0) {
@@ -42,5 +59,16 @@ export function renderInvoiceText(invoice) {
 
   lines.push(`Total: ${formatEuros(total)}`);
 
+  // Add due date if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Add paid amount if there are payments
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
