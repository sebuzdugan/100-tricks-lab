diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..ec75d82
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,51 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} input
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customer = getCustomer(customerId);
+  if (!customer.ok) return customer;
+
+  // Validate issue date format YYYY-MM-DD
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate)) return fail('DATE_INVALID');
+  const [year, month, day] = issueDate.split('-').map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() + 1 !== month || date.getUTCDate() !== day) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines is not empty
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Validate each line and enrich with catalogue data
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Get product from catalogue
+    const product = getProduct(line.sku);
+    if (!product.ok) return product;
+
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.value.name,
+      qty: line.qty,
+      unitPrice: product.value.unitPrice,
+      vatRate: product.value.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..1991328
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,135 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a valid draft invoice', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'ICON-SET', qty: 2 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2024-01-15');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+});
+
+test('createInvoice enriches lines with catalogue data', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  });
+
+  assert.equal(result.ok, true);
+  const line = result.value.lines[0];
+  assert.equal(line.sku, 'DEV-HOUR');
+  assert.equal(line.name, 'Development (hour)');
+  assert.equal(line.qty, 5);
+  assert.equal(line.unitPrice, 9500);
+  assert.equal(line.vatRate, 21);
+});
+
+test('createInvoice fails with CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice fails with DATE_INVALID for bad date format', () => {
+  const cases = [
+    '2024-1-15',
+    '2024/01/15',
+    '01-15-2024',
+    'invalid',
+    '',
+    '2024-13-01',
+    '2024-02-30',
+    '2024-00-01',
+    '2024-01-00',
+  ];
+
+  for (const issueDate of cases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate,
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    });
+    assert.equal(result.ok, false, `Should fail for ${issueDate}`);
+    assert.equal(result.error, 'DATE_INVALID', `Should fail with DATE_INVALID for ${issueDate}`);
+  }
+});
+
+test('createInvoice fails with NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice fails with QTY_INVALID for invalid quantities', () => {
+  const cases = [0, -1, -10, 1.5, 10.5, NaN, Infinity, null, undefined, '5'];
+
+  for (const qty of cases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DEV-HOUR', qty }],
+    });
+    assert.equal(result.ok, false, `Should fail for qty ${qty}`);
+    assert.equal(result.error, 'QTY_INVALID', `Should fail with QTY_INVALID for qty ${qty}`);
+  }
+});
+
+test('createInvoice fails with UNKNOWN_SKU for unknown product', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'UNKNOWN-PRODUCT', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice handles multiple lines', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-06-20',
+    lines: [
+      { sku: 'DES-HOUR', qty: 8 },
+      { sku: 'DEV-HOUR', qty: 16 },
+      { sku: 'PRINT-A4', qty: 500 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines.length, 3);
+  assert.equal(result.value.lines[0].name, 'Design work (hour)');
+  assert.equal(result.value.lines[1].name, 'Development (hour)');
+  assert.equal(result.value.lines[2].name, 'Printed flyer A4 (each)');
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DEV-HOUR', qty: 1 }];
+  const originalLines = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines,
+  });
+
+  assert.deepEqual(lines, originalLines);
+});
