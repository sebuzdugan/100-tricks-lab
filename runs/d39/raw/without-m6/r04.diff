+/**
+ * Issue an invoice by assigning it a number and changing status to issued.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, number?: string }} invoice
+ * @param {string[]} existingNumbers
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array, number: string } } | { ok: false, error: string }}
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: 'issued',
+    lines: invoice.lines.map((line) => ({ ...line })),
+    number,
+  });
+}
