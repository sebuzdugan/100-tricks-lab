diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..90497ad
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,59 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for first invoice of the year', () => {
+  const number = nextInvoiceNumber([], '2024-01-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2024-0001'];
+  const number = nextInvoiceNumber(existing, '2024-06-20');
+  assert.equal(number, 'INV-2024-0002');
+});
+
+test('nextInvoiceNumber finds highest counter in same year', () => {
+  const existing = ['INV-2024-0001', 'INV-2024-0003', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2024-12-31');
+  assert.equal(number, 'INV-2024-0004');
+});
+
+test('nextInvoiceNumber resets counter for new year', () => {
+  const existing = ['INV-2024-0005', 'INV-2024-0003', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2025-01-01');
+  assert.equal(number, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber ignores invoices from other years', () => {
+  const existing = ['INV-2023-0010', 'INV-2025-0005'];
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber handles unsorted input', () => {
+  const existing = ['INV-2024-0005', 'INV-2024-0001', 'INV-2024-0009', 'INV-2024-0003'];
+  const number = nextInvoiceNumber(existing, '2024-07-01');
+  assert.equal(number, 'INV-2024-0010');
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existing = [];
+  const n1 = nextInvoiceNumber(existing, '2024-01-01');
+  assert.equal(n1, 'INV-2024-0001');
+
+  const n10 = nextInvoiceNumber(['INV-2024-0009'], '2024-01-01');
+  assert.equal(n10, 'INV-2024-0010');
+
+  const n100 = nextInvoiceNumber(['INV-2024-0099'], '2024-01-01');
+  assert.equal(n100, 'INV-2024-0100');
+
+  const n1000 = nextInvoiceNumber(['INV-2024-0999'], '2024-01-01');
+  assert.equal(n1000, 'INV-2024-1000');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2024-XXXX', 'INV-2024-0001', 'INV-invalid-0001'];
+  const number = nextInvoiceNumber(existing, '2024-06-15');
+  assert.equal(number, 'INV-2024-0002');
+});
