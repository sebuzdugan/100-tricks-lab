--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,21 @@
+/**
+ * Calculate the next free invoice number for a given issue date.
+ * Format: INV-<year>-<counter> where counter is 4 digits zero-padded, restarting each year.
+ * @param {string[]} existingNumbers - array of invoice numbers already used
+ * @param {string} issueDate - date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.slice(prefix.length), 10))
+    .filter((counter) => !isNaN(counter));
+
+  const maxCounter = thisYearNumbers.length > 0 ? Math.max(...thisYearNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
