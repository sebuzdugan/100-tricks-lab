+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { invoiceTotals, lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, number?: string }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : `Unknown Customer (${invoice.customerId})`;
+
+  const invoiceNumber = invoice.number || 'DRAFT';
+  const lines = [invoiceNumber, customerName];
+
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const itemLine = `${line.qty} × ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(itemLine);
+  }
+
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..4a0028f
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,178 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+});
+
+test('renderInvoiceText shows invoice number when issued', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2024-0001');
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows customer name for different customers', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-010',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  assert.equal(renderInvoiceText(invoice1).split('\n')[1], 'Kite & Co');
+  assert.equal(renderInvoiceText(invoice2).split('\n')[1], 'Tidewater Museum');
+});
+
+test('renderInvoiceText includes line details', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.match(lines[2], /10 × Development \(hour\)/);
+  assert.match(lines[2], /€95\.00/);
+  assert.match(lines[2], /€950\.00/);
+});
+
+test('renderInvoiceText shows all line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'ICON-SET', qty: 100 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 6); // invoice# + customer + 3 items + total
+  assert.match(lines[2], /Development \(hour\)/);
+  assert.match(lines[3], /Design work \(hour\)/);
+  assert.match(lines[4], /Icon set \(24 icons\)/);
+});
+
+test('renderInvoiceText calculates line totals correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'PRINT-A4', qty: 500 },
+      { sku: 'LOGO-PACK', qty: 2 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // 500 × €0.37 = €185.00
+  assert.match(lines[2], /500 × Printed flyer A4 \(each\) @ €0\.37 = €185\.00/);
+  // 2 × €1,200.00 = €2,400.00
+  assert.match(lines[3], /2 × Logo package @ €1,200\.00 = €2,400\.00/);
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lastLine = text.split('\n').pop();
+
+  // 10 × 95 + 5 × 85 = 950 + 425 = 1375 = €13.75
+  assert.equal(lastLine, 'Total: €1,375.00');
+});
+
+test('renderInvoiceText handles unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [{ sku: 'DEV-HOUR', qty: 1, name: 'Development (hour)', unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.match(lines[1], /Unknown Customer \(C-999\)/);
+});
+
+test('renderInvoiceText formats currency with thousands separator', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'BRAND-BOOK', qty: 10 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+
+  // 10 × 2,450.00 = 24,500.00
+  assert.match(text, /€2,450\.00/);
+  assert.match(text, /€24,500\.00/);
+});
+
+test('renderInvoiceText produces multiline plain text', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-06-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 8 },
+      { sku: 'DES-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 5); // invoice# + customer + 2 items + total
+  assert.equal(typeof text, 'string');
+  assert.ok(text.includes('\n'));
+});
