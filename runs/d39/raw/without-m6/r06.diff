+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 20);
+});
+
+test('addLine rejects invalid discountPercent', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const result = addLine(invoice, { sku: 'DES-HOUR', qty: 1, discountPercent: 150 });
+
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('invoiceTotals calculates discount correctly', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  });
+
+  const totals = invoiceTotals(result.value);
+
+  // 10 × 9500 = 95000
+  // 10% discount = 9500
+  // total = 95000 - 9500 = 85500
+  assert.equal(totals.subtotal, 95000);
+  assert.equal(totals.discount, 9500);
+  assert.equal(totals.total, 85500);
+});
+
+test('invoiceTotals sums multiple line discounts', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10, discountPercent: 10 },
+      { sku: 'DES-HOUR', qty: 10, discountPercent: 20 },
+    ],
+  });
+
+  const totals = invoiceTotals(result.value);
+
+  // Line 1: 10 × 9500 = 95000, 10% = 9500
+  // Line 2: 10 × 8500 = 85000, 20% = 17000
+  // Subtotal = 180000, Discount = 26500, Total = 153500
+  assert.equal(totals.subtotal, 180000);
+  assert.equal(totals.discount, 26500);
+  assert.equal(totals.total, 153500);
+});
+
+test('invoiceTotals clamps total at zero', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'draft',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 1, name: 'Development (hour)', unitPrice: 100, vatRate: 21, discountPercent: 150 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  // Even though discount would be more than subtotal, total is clamped at 0
+  assert.equal(totals.subtotal, 100);
+  assert.equal(totals.discount, 150);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with mixed discount and non-discount lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'DES-HOUR', qty: 5, discountPercent: 50 },
+    ],
+  });
+
+  const totals = invoiceTotals(result.value);
+
+  // Line 1: 5 × 9500 = 47500, 0% = 0
+  // Line 2: 5 × 8500 = 42500, 50% = 21250
+  // Subtotal = 90000, Discount = 21250, Total = 68750
+  assert.equal(totals.subtotal, 90000);
+  assert.equal(totals.discount, 21250);
+  assert.equal(totals.total, 68750);
+});
