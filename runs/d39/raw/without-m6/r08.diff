@@ -84,21 +84,43 @@ export function lineTotal(line) {
   return roundCents(line.qty * line.unitPrice);
 }
 
+/**
+ * Calculate the discount amount for a line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const total = lineTotal(line);
+  const discountPercent = line.discountPercent ?? 0;
+  return roundCents(total * discountPercent / 100);
+}
+
+/**
+ * Calculate the VAT amount for a line (after discount).
+ * @param {{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  return roundCents(amountAfterDiscount * line.vatRate / 100);
+}
+
 /**
  * Calculate totals for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }}
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
-  const discount = invoice.lines.reduce((sum, line) => {
-    const lineDiscount = lineTotal(line) * (line.discountPercent ?? 0) / 100;
-    return sum + roundCents(lineDiscount);
-  }, 0);
-  const total = Math.max(0, subtotal - discount);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const total = Math.max(0, subtotal - discount + vat);
   return {
     subtotal,
     discount,
+    vat,
     total,
   };
 }
