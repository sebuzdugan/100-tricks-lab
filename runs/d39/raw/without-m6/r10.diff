diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..56b40ce
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,109 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2024-01-15'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2025-02-28'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2024-1-15'), false);
+  assert.equal(isValidDate('2024/01/15'), false);
+  assert.equal(isValidDate('01-15-2024'), false);
+  assert.equal(isValidDate('2024-01-15 '), false);
+  assert.equal(isValidDate(' 2024-01-15'), false);
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('invalid'), false);
+});
+
+test('isValidDate rejects impossible dates', () => {
+  assert.equal(isValidDate('2024-13-01'), false); // month 13
+  assert.equal(isValidDate('2024-00-01'), false); // month 0
+  assert.equal(isValidDate('2024-02-30'), false); // Feb 30
+  assert.equal(isValidDate('2023-02-29'), false); // Feb 29 in non-leap year
+  assert.equal(isValidDate('2024-04-31'), false); // April 31
+});
+
+test('isValidDate accepts leap year dates', () => {
+  assert.equal(isValidDate('2024-02-29'), true); // 2024 is a leap year
+  assert.equal(isValidDate('2000-02-29'), true); // 2000 is a leap year
+  assert.equal(isValidDate('2100-02-29'), false); // 2100 is not a leap year
+});
+
+test('addDays adds days to a date', () => {
+  assert.equal(addDays('2024-01-15', 0), '2024-01-15');
+  assert.equal(addDays('2024-01-15', 1), '2024-01-16');
+  assert.equal(addDays('2024-01-15', 10), '2024-01-25');
+  assert.equal(addDays('2024-01-15', -5), '2024-01-10');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2024-01-31', 1), '2024-02-01');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01'); // leap year
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2024-02-01', -1), '2024-01-31');
+  assert.equal(addDays('2024-01-01', -1), '2023-12-31');
+  assert.equal(addDays('2024-03-01', -30), '2024-01-31'); // March 1 - 30 days = Jan 31
+});
+
+test('addDays handles large day additions', () => {
+  assert.equal(addDays('2024-01-01', 365), '2024-12-31'); // 2024 is leap year (366 days)
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01'); // 2024 is leap year
+  assert.equal(addDays('2024-01-01', 1000), '2026-09-27');
+});
+
+test('daysBetween calculates days between dates', () => {
+  assert.equal(daysBetween('2024-01-15', '2024-01-15'), 0);
+  assert.equal(daysBetween('2024-01-15', '2024-01-16'), 1);
+  assert.equal(daysBetween('2024-01-15', '2024-01-25'), 10);
+  assert.equal(daysBetween('2024-01-25', '2024-01-15'), -10);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2024-01-31', '2024-02-01'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1); // leap year
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366); // 2024 is leap year
+  assert.equal(daysBetween('2023-01-01', '2024-01-01'), 365);
+});
+
+test('daysBetween handles large date ranges', () => {
+  assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365); // 2024 is leap year with 366 days
+  assert.equal(daysBetween('2020-01-01', '2025-01-01'), 1827); // includes leap years
+});
+
+test('daysBetween is symmetric', () => {
+  const a = '2024-01-15';
+  const b = '2024-03-20';
+  assert.equal(daysBetween(a, b), -daysBetween(b, a));
+});
+
+test('isValidDate works in UTC (no timezone issues)', () => {
+  // These should all work regardless of local timezone
+  assert.equal(isValidDate('2024-01-01'), true);
+  assert.equal(isValidDate('2024-06-15'), true);
+  assert.equal(isValidDate('2024-12-31'), true);
+});
+
+test('addDays works in UTC (no timezone issues)', () => {
+  // Dates should be calculated in UTC
+  const date = '2024-01-15';
+  const result = addDays(date, 1);
+  assert.equal(result, '2024-01-16');
+});
+
+test('daysBetween works in UTC (no timezone issues)', () => {
+  // Calculations should be in UTC
+  const days = daysBetween('2024-01-01', '2024-01-02');
+  assert.equal(days, 1);
+});
