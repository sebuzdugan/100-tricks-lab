--- /dev/null
+++ b/src/payments.js
@@ -0,0 +1,54 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, payments?: Array, number?: string }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array, payments: Array, number?: string } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check status is issued or partially_paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new payments array with the new payment
+  const payments = [...(invoice.payments ?? []), { amount, date }];
+
+  // Calculate new balance
+  const newBalance = balance - amount;
+
+  // Determine new status
+  const newStatus = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments,
+    status: newStatus,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ lines: Array, payments?: Array }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const paid = (invoice.payments ?? []).reduce((sum, payment) => sum + payment.amount, 0);
+  return Math.max(0, totals.total - paid);
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
