@@ -0,0 +1,259 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('recordPayment adds a payment to an issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = recordPayment(issued, { amount: 50000, date: '2024-01-20' });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 50000);
+  assert.equal(result.value.payments[0].date, '2024-01-20');
+});
+
+test('recordPayment sets status to partially_paid with partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = recordPayment(issued, { amount: 50000, date: '2024-01-20' });
+
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 95000 + 19950 VAT = 114950
+  const result = recordPayment(issued, { amount: 114950, date: '2024-01-20' });
+
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment allows multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950
+  let result = recordPayment(issued, { amount: 50000, date: '2024-01-20' });
+  assert.equal(result.value.status, 'partially_paid');
+  assert.equal(result.value.payments.length, 1);
+
+  result = recordPayment(result.value, { amount: 64950, date: '2024-01-25' });
+  assert.equal(result.value.status, 'paid');
+  assert.equal(result.value.payments.length, 2);
+});
+
+test('recordPayment fails with NOT_ISSUED on draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = recordPayment(invoice, { amount: 50000, date: '2024-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment fails with NOT_ISSUED on paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950
+  let result = recordPayment(issued, { amount: 114950, date: '2024-01-20' });
+  assert.equal(result.value.status, 'paid');
+
+  result = recordPayment(result.value, { amount: 1000, date: '2024-01-25' });
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment fails with AMOUNT_INVALID for zero amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = recordPayment(issued, { amount: 0, date: '2024-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment fails with AMOUNT_INVALID for negative amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = recordPayment(issued, { amount: -1000, date: '2024-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment fails with AMOUNT_INVALID for non-integer amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const cases = [1000.5, 'invalid', null, undefined];
+
+  for (const amount of cases) {
+    const result = recordPayment(issued, { amount, date: '2024-01-20' });
+    assert.equal(result.ok, false, `Should fail for amount ${amount}`);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  }
+});
+
+test('recordPayment fails with OVERPAYMENT if payment exceeds balance', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950
+  const result = recordPayment(issued, { amount: 200000, date: '2024-01-20' });
+
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment fails with OVERPAYMENT on partial payment overpayment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950
+  let result = recordPayment(issued, { amount: 50000, date: '2024-01-20' });
+  assert.equal(result.value.status, 'partially_paid');
+
+  // Remaining balance is 64950, try to pay 70000
+  result = recordPayment(result.value, { amount: 70000, date: '2024-01-25' });
+  assert.deepEqual(result, { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const originalStatus = issued.status;
+
+  recordPayment(issued, { amount: 50000, date: '2024-01-20' });
+
+  assert.equal(issued.status, originalStatus);
+  assert.equal(issued.payments, undefined);
+});
+
+test('balanceDue returns total for unissued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const due = balanceDue(invoice);
+
+  // Total is 95000 + 19950 VAT = 114950
+  assert.equal(due, 114950);
+});
+
+test('balanceDue returns remaining after partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950
+  const result = recordPayment(issued, { amount: 50000, date: '2024-01-20' });
+
+  const due = balanceDue(result.value);
+
+  assert.equal(due, 64950);
+});
+
+test('balanceDue returns zero for fully paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950
+  const result = recordPayment(issued, { amount: 114950, date: '2024-01-20' });
+
+  const due = balanceDue(result.value);
+
+  assert.equal(due, 0);
+});
+
+test('balanceDue accounts for multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950
+  let result = recordPayment(issued, { amount: 30000, date: '2024-01-20' });
+  result = recordPayment(result.value, { amount: 40000, date: '2024-01-25' });
+
+  const due = balanceDue(result.value);
+
+  assert.equal(due, 44950); // 114950 - 30000 - 40000
+});
+
+test('balanceDue with invoice with discounts and VAT', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Subtotal: 95000, Discount: 4750, VAT: 18952, Total: 109202
+  const due = balanceDue(issued);
+
+  assert.equal(due, 109202);
+});
