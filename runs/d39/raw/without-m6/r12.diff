+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(result.value.dueDate, '2024-02-14');
+});
+
+test('createInvoice accepts NET14 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET14');
+  assert.equal(result.value.dueDate, '2024-01-29');
+});
+
+test('createInvoice accepts NET30 terms', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'NET30',
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'NET30');
+  assert.equal(result.value.dueDate, '2024-02-14');
+});
+
+test('createInvoice accepts EOM terms', () => {
+  const result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.terms, 'EOM');
+  assert.equal(result.value.dueDate, '2024-01-31');
+});
+
+test('createInvoice calculates EOM for different months', () => {
+  const feb = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    terms: 'EOM',
+  });
+
+  assert.equal(feb.value.dueDate, '2024-02-29'); // leap year
+
+  const dec = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-12-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
