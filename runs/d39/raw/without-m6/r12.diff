+  assert.equal(removed.value.dueDate, '2024-01-29');
+
+  // Issue the invoice
+  const issued = issueInvoice(invoice, []);
+  assert.equal(issued.value.terms, 'NET14');
+  assert.equal(issued.value.dueDate, '2024-01-29');
+});
