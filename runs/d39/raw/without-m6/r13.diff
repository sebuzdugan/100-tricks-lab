+/**
+ * Apply a voucher to an invoice.
+ * @param {{ customerId: string, issueDate: string, status: string, lines: Array, voucher?: { code: string, amount: number }, terms?: string, dueDate?: string, number?: string }} invoice
+ * @param {{ code: string, amount: number }} voucher
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array, voucher: { code: string, amount: number }, terms?: string, dueDate?: string, number?: string } } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if invoice already has a voucher
+  if (invoice.voucher !== undefined) return fail('VOUCHER_EXISTS');
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  return ok({
+    customerId: invoice.customerId,
+    issueDate: invoice.issueDate,
+    status: invoice.status,
+    lines: invoice.lines.map((line) => ({ ...line })),
+    voucher: { code, amount },
+    terms: invoice.terms,
+    dueDate: invoice.dueDate,
+  });
+}
