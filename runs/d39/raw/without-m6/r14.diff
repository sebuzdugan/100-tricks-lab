+import { ok, fail } from './result.js';
+import { normalizeId } from './customers.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, status: string, lines: Array, dueDate?: string, payments?: Array }>} invoices
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Normalize and validate customer
+  const normalized = normalizeId(customerId);
+  const customer = getCustomer(normalized);
+  if (!customer.ok) return customer;
+
+  // Filter invoices for this customer with issued/partially_paid status and issueDate <= asOf
+  const customerInvoices = invoices
+    .filter((inv) => normalizeId(inv.customerId) === normalized)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Map to statement format and calculate totals
+  const statementInvoices = customerInvoices.map((inv) => {
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    return {
+      number: inv.number || 'DRAFT',
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate || 'N/A',
+      total: totals.total,
+      due,
+    };
+  });
+
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalized,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
