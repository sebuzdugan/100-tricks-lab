+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns empty invoices for customer with no issued invoices', () => {
+  const invoices = [];
+  const result = statement('C-001', invoices, '2024-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement returns issued invoices for customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-10',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].number, 'INV-2024-0001');
+  assert.equal(result.value.invoices[1].number, 'INV-2024-0002');
+});
+
+test('statement filters by customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2024-0001');
+});
+
+test('statement filters by status (only issued and partially_paid)', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+  const partial = recordPayment(issueInvoice(inv2, ['INV-2024-0001']).value, { amount: 50000, date: '2024-01-20' }).value;
+
+  const result = statement('C-001', [inv1, issued, partial], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2); // only issued and partially_paid
+});
+
+test('statement filters by date (issueDate <= asOf)', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-06-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const result = statement('C-001', [issued1, issued2], '2024-03-01');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+});
+
+test('statement sorts invoices by issueDate', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-03-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+  const issued3 = issueInvoice(inv3, ['INV-2024-0001', 'INV-2024-0002']).value;
+
+  const result = statement('C-001', [issued1, issued2, issued3], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].issueDate, '2024-01-15');
+  assert.equal(result.value.invoices[1].issueDate, '2024-02-15');
+  assert.equal(result.value.invoices[2].issueDate, '2024-03-15');
+});
+
+test('statement includes invoice details', () => {
+  const inv = createInvoice({
+    customerId: 'C-002', // standard tier, no discount
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const result = statement('C-002', [issued], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  const inv1 = result.value.invoices[0];
+  assert.equal(inv1.number, 'INV-2024-0001');
+  assert.equal(inv1.issueDate, '2024-01-15');
+  assert.equal(inv1.dueDate, '2024-02-14'); // NET30
+  assert.equal(inv1.total, 114950); // subtotal + VAT (95000 + 19950)
+  assert.equal(inv1.due, 114950); // no payments
+});
+
+test('statement calculates due amount with payments', () => {
+  const inv = createInvoice({
+    customerId: 'C-002', // standard tier, no discount
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 50000, date: '2024-01-20' }).value;
+
+  const result = statement('C-002', [partial], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  const inv1 = result.value.invoices[0];
+  assert.equal(inv1.total, 114950);
+  assert.equal(inv1.due, 64950); // 114950 - 50000
+});
+
+test('statement calculates totalDue', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const result = statement('C-002', [issued1, issued2], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  // inv1: 114950 (95000 + 19950), inv2: 57475 (47500 + 9975)
+  assert.equal(result.value.totalDue, 114950 + 57475);
+});
+
+test('statement with partially paid invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+
+  const partial2 = recordPayment(issued2, { amount: 50000, date: '2024-02-20' }).value;
+
+  const result = statement('C-002', [issued1, partial2], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+  assert.equal(result.value.invoices[0].due, 114950); // fully unpaid
+  assert.equal(result.value.invoices[1].due, 64950); // 114950 - 50000
+  assert.equal(result.value.totalDue, 114950 + 64950);
+});
+
+test('statement fails with unknown customer', () => {
+  const result = statement('C-999', [], '2024-12-31');
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('statement normalizes customer ID', () => {
+  const inv = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const result = statement(' c-001 ', [issued], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement with invoice without number shows DRAFT', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  // Invoice without number (not issued)
+  const result = statement('C-001', [inv], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  // Draft invoices shouldn't be included (status check filters them out)
+  assert.equal(result.value.invoices.length, 0);
+});
+
+test('statement with no dueDate shows N/A', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  // Create invoice without terms (shouldn't have dueDate)
+  const issued = issueInvoice(inv, []).value;
+
+  // Remove the dueDate to simulate an invoice without it
+  const noDueDate = { ...issued, dueDate: undefined };
+
+  const result = statement('C-001', [noDueDate], '2024-12-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices[0].dueDate, 'N/A');
+});
