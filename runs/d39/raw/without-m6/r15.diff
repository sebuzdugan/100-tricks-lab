@@ -0,0 +1,242 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Discount', date: '2024-01-20' }, ['INV-2024-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2024-0001');
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.amount, 10000);
+  assert.equal(result.value.reason, 'Discount');
+  assert.equal(result.value.date, '2024-01-20');
+});
+
+test('createCreditNote works for partially_paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const partial = recordPayment(issued, { amount: 50000, date: '2024-01-20' }).value;
+
+  const result = createCreditNote(partial, { amount: 10000, reason: 'Adjustment', date: '2024-01-25' }, ['INV-2024-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote works for paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const paid = recordPayment(issued, { amount: 114950, date: '2024-01-20' }).value;
+
+  const result = createCreditNote(paid, { amount: 10000, reason: 'Overpayment refund', date: '2024-01-25' }, ['INV-2024-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote fails with NOT_ISSUED for draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = createCreditNote(invoice, { amount: 10000, reason: 'Discount', date: '2024-01-20' }, []);
+
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote fails with AMOUNT_INVALID for zero amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = createCreditNote(issued, { amount: 0, reason: 'Discount', date: '2024-01-20' }, ['INV-2024-0001']);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote fails with AMOUNT_INVALID for negative amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = createCreditNote(issued, { amount: -10000, reason: 'Discount', date: '2024-01-20' }, ['INV-2024-0001']);
+
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote fails with AMOUNT_INVALID for non-integer amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const cases = [10000.5, 'invalid', null, undefined];
+
+  for (const amount of cases) {
+    const result = createCreditNote(issued, { amount, reason: 'Discount', date: '2024-01-20' }, ['INV-2024-0001']);
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  }
+});
+
+test('createCreditNote fails with CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950
+  const result = createCreditNote(issued, { amount: 200000, reason: 'Large discount', date: '2024-01-20' }, ['INV-2024-0001']);
+
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote generates sequential credit note numbers', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(invoice1, []).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2024-0001']).value;
+
+  const result1 = createCreditNote(issued1, { amount: 10000, reason: 'Discount', date: '2024-01-25' }, ['INV-2024-0001']);
+  const existing = ['INV-2024-0001', result1.value.number];
+  const result2 = createCreditNote(issued2, { amount: 10000, reason: 'Discount', date: '2024-01-26' }, existing);
+
+  assert.equal(result1.value.number, 'CN-2024-0001');
+  assert.equal(result2.value.number, 'CN-2024-0002');
+});
+
+test('createCreditNote separates credit note numbers by year', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued1 = issueInvoice(invoice1, []).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2024-0001']).value;
+
+  const result1 = createCreditNote(issued1, { amount: 10000, reason: 'Discount', date: '2024-01-25' }, ['INV-2024-0001', 'CN-2024-0001', 'CN-2024-0002']);
+  const existing = ['INV-2024-0001', 'CN-2024-0001', 'CN-2024-0002', result1.value.number];
+  const result2 = createCreditNote(issued2, { amount: 10000, reason: 'Discount', date: '2025-01-25' }, existing);
+
+  assert.equal(result1.value.number, 'CN-2024-0003');
+  assert.equal(result2.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote with mixed invoice and credit note numbers', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+
+  const existing = [
+    'INV-2024-0001',
+    'INV-2024-0002',
+    'CN-2024-0001',
+    'INV-2024-0003',
+    'CN-2024-0002',
+  ];
+
+  const result = createCreditNote(issued, { amount: 10000, reason: 'Discount', date: '2024-01-20' }, existing);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0003');
+});
+
+test('createCreditNote for invoice without number shows DRAFT', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  // Manually set status to issued without issuing (to simulate edge case)
+  const fakeIssued = { ...invoice, status: 'issued' };
+
+  const result = createCreditNote(fakeIssued, { amount: 10000, reason: 'Discount', date: '2024-01-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoiceNumber, 'DRAFT');
+});
+
+test('createCreditNote with partial credit on invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950, create credit for half
+  const result = createCreditNote(issued, { amount: 57475, reason: 'Partial refund', date: '2024-01-20' }, ['INV-2024-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 57475);
+});
+
+test('createCreditNote with full credit on invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total is 114950
+  const result = createCreditNote(issued, { amount: 114950, reason: 'Full refund', date: '2024-01-20' }, ['INV-2024-0001']);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 114950);
+});
