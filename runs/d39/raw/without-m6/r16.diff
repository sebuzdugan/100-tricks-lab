+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('overdueInvoices returns empty for no invoices', () => {
+  const result = overdueInvoices([], '2024-12-31');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty when no invoices are overdue', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-12-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Due date: 2025-01-19, as of 2024-12-31 is not overdue
+  const result = overdueInvoices([issued], '2024-12-31');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices includes overdue issued invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Due date: 2024-02-14, as of 2024-12-31 is overdue
+  const result = overdueInvoices([issued], '2024-12-31');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2024-0001');
+  assert.equal(result[0].customerId, 'C-002');
+  assert.equal(result[0].dueDate, '2024-02-14');
+});
+
+test('overdueInvoices includes partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const partial = recordPayment(issued, { amount: 50000, date: '2024-01-20' }).value;
+  // Due date: 2024-01-29, as of 2024-12-31 is overdue
+  const result = overdueInvoices([partial], '2024-12-31');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2024-0001');
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const paid = recordPayment(issued, { amount: 114950, date: '2024-01-20' }).value;
+
+  const result = overdueInvoices([paid], '2024-12-31');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = overdueInvoices([invoice], '2024-12-31');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices calculates daysOverdue correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Due date: 2024-02-14, as of 2024-03-15 is 30 days overdue
+  const result = overdueInvoices([issued], '2024-03-15');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].daysOverdue, 30);
+});
+
+test('overdueInvoices calculates due amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const partial = recordPayment(issued, { amount: 50000, date: '2024-01-20' }).value;
+
+  const result = overdueInvoices([partial], '2024-12-31');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 64950); // 114950 - 50000
+});
+
+test('overdueInvoices sorts by daysOverdue descending', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-02-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const invoice3 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-03-01',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET14',
+  }).value;
+
+  const issued1 = issueInvoice(invoice1, []).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2024-0001']).value;
+  const issued3 = issueInvoice(invoice3, ['INV-2024-0001', 'INV-2024-0002']).value;
+
+  // Due dates: 2024-01-15, 2024-02-15, 2024-03-15
+  // As of 2024-12-31: 351 days, 320 days, 291 days overdue
+  const result = overdueInvoices([issued1, issued2, issued3], '2024-12-31');
+
+  assert.equal(result.length, 3);
+  assert.equal(result[0].daysOverdue, 351); // Most overdue
+  assert.equal(result[1].daysOverdue, 320);
+  assert.equal(result[2].daysOverdue, 291); // Least overdue
+});
+
+test('overdueInvoices with mixed overdue and current invoices', () => {
+  const overdue = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const current = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-12-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued1 = issueInvoice(overdue, []).value;
+  const issued2 = issueInvoice(current, ['INV-2024-0001']).value;
+
+  // First due 2024-02-14, second due 2025-01-19
+  const result = overdueInvoices([issued1, issued2], '2024-12-31');
+
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2024-0001');
+});
+
+test('overdueInvoices excludes invoices with no dueDate', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    // No terms, so no dueDate
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Remove dueDate to test edge case
+  const noDueDate = { ...issued, dueDate: undefined };
+
+  const result = overdueInvoices([noDueDate], '2024-12-31');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices with large portfolio', () => {
+  const invoices = [];
+
+  for (let i = 1; i <= 50; i++) {
+    const invoice = createInvoice({
+      customerId: `C-${String(Math.ceil(i / 5)).padStart(3, '0')}`,
+      issueDate: `2024-${String(Math.ceil(i / 5)).padStart(2, '0')}-01`,
+      lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+      terms: 'NET30',
+    }).value;
+
+    const issued = issueInvoice(invoice, invoices.map((inv) => inv.number || 'DRAFT')).value;
+    invoices.push(issued);
+  }
+
+  const result = overdueInvoices(invoices, '2024-12-31');
+
+  // All invoices from Jan-Oct are overdue as of Dec 31
+  assert.ok(result.length > 0);
+  // Most overdue should be January invoices
+  assert.ok(result[0].daysOverdue > result[result.length - 1].daysOverdue);
+});
+
+test('overdueInvoices on exact dueDate is not overdue', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Due date: 2024-02-14, as of 2024-02-14 should NOT be overdue
+  const result = overdueInvoices([issued], '2024-02-14');
+
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices with invoice due tomorrow is not overdue', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-12-29',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Due date: 2025-01-28, as of 2025-01-27 should NOT be overdue
+  const result = overdueInvoices([issued], '2025-01-27');
+
+  assert.equal(result.length, 0);
+});
