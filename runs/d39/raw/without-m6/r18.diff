@@ -56,3 +57,21 @@ export function vatSummary(invoices) {
 
   return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fee for an invoice: 0.04% per day of the amount due.
+ * @param {{ status: string, dueDate?: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {number} late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (!invoice.dueDate || invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = due * 0.0004 * daysOverdue;
+
+  return roundCents(fee);
+}
