+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header only for empty list', () => {
+  const result = exportCsv([]);
+  const expected = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+  assert.equal(result, expected);
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3); // header + data + trailing newline
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.match(lines[1], /INV-2024-0001,Blue Fern Bakery,2024-01-15,2024-02-14,issued,950.00,0.00,199.50,1149.50,1149.50/);
+});
+
+test('exportCsv formats amounts without currency or thousands separator', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+    terms: 'NET30',
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+  // LOGO-PACK: 120000 cents = 1200.00 euros, VAT = 25200 cents = 252.00 euros
+  assert.match(dataLine, /1200\.00/);
+  assert.match(dataLine, /252\.00/);
+  assert.match(dataLine, /1452\.00/);
+});
+
+test('exportCsv shows DRAFT for unnumbered invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const result = exportCsv([invoice]);
+
+  const lines = result.split('\n');
+  assert.match(lines[1], /^DRAFT,/);
+});
+
+test('exportCsv shows N/A for missing dueDate', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  // Manually remove dueDate to test edge case
+  const issued = issueInvoice(invoice, []).value;
+  const noDueDate = { ...issued, dueDate: undefined };
+  const result = exportCsv([noDueDate]);
+
+  const lines = result.split('\n');
+  assert.match(lines[1], /INV-2024-0001,Blue Fern Bakery,2024-01-15,N\/A,/);
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  // C-004: "Smith, Jones & Partners"
+  const invoice = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  // Should be quoted because it contains a comma
+  assert.match(lines[1], /"Smith, Jones & Partners"/);
+});
+
+test('exportCsv escapes double quotes in customer name', () => {
+  // C-006: Marlow "The Print Shop"
+  const invoice = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  // Double quotes should be doubled and field should be quoted
+  assert.match(lines[1], /"Marlow ""The Print Shop"""/);
+});
+
+test('exportCsv exports multiple invoices', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const invoice2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+
+  const issued1 = issueInvoice(invoice1, []).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2024-0001']).value;
+  const result = exportCsv([issued1, issued2]);
+
+  const lines = result.split('\n');
+  assert.equal(lines.length, 4); // header + 2 data + trailing newline
+  assert.match(lines[1], /INV-2024-0001,Blue Fern Bakery/);
+  assert.match(lines[2], /INV-2024-0002,Kite & Co/);
+});
+
+test('exportCsv calculates due correctly with partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const partial = recordPayment(issued, { amount: 50000, date: '2024-01-20' }).value;
+  const result = exportCsv([partial]);
+
+  const lines = result.split('\n');
+  // Total: 1149.50, payment: 500, due: 649.50
+  assert.match(lines[1], /,649\.50$/);
+});
+
+test('exportCsv shows zero due for paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const paid = recordPayment(issued, { amount: 114950, date: '2024-01-20' }).value;
+  const result = exportCsv([paid]);
+
+  const lines = result.split('\n');
+  // Due should be 0.00
+  assert.match(lines[1], /,0\.00$/);
+});
+
+test('exportCsv includes discount in output', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10, discountPercent: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // subtotal, discount, vat, total
+  assert.equal(fields[5], '950.00'); // subtotal
+  assert.equal(fields[6], '95.00'); // discount
+  assert.equal(fields[7], '179.55'); // vat
+  assert.equal(fields[8], '1034.55'); // total
+});
+
+test('exportCsv calculates invoice totals correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // subtotal: 950, discount: 0, vat: 199.50, total: 1149.50
+  assert.equal(fields[5], '950.00'); // subtotal
+  assert.equal(fields[6], '0.00'); // discount
+  assert.equal(fields[7], '199.50'); // vat
+  assert.equal(fields[8], '1149.50'); // total
+});
+
+test('exportCsv with tier discount', () => {
+  // C-001 is gold tier
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // With 5% tier discount: subtotal 950, discount 47.50, vat 189.52, total 1092.02
+  // (10 * 9500 = 95000, discount 5% = 4750, base = 90250, vat = 18952, total = 109202)
+  assert.equal(fields[5], '950.00'); // subtotal (before discount)
+  assert.equal(fields[6], '47.50'); // tier discount
+  assert.equal(fields[8], '1092.02'); // total
+});
+
+test('exportCsv header line ends with newline', () => {
+  const result = exportCsv([]);
+  assert.match(result, /^number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n$/);
+});
+
+test('exportCsv each data line ends with newline', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  // Should have lines separated by newline and final newline
+  const lines = result.split('\n');
+  assert.ok(result.endsWith('\n'));
+  assert.ok(lines[lines.length - 1] === ''); // last element is empty after final newline
+});
+
+test('exportCsv handles empty discount correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // Standard tier (no discount)
+  assert.equal(fields[6], '0.00'); // discount
+});
+
+test('exportCsv with multiple VAT rates', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'MAGAZINE', qty: 10 },
+    ],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const result = exportCsv([issued]);
+
+  const lines = result.split('\n');
+  const fields = lines[1].split(',');
+  // subtotal: 950 + 125 = 1075
+  // vat: 199.50 + 11.25 = 210.75
+  // total: 1285.75
+  assert.equal(fields[5], '1075.00');
+  assert.equal(fields[7], '210.75');
+  assert.equal(fields[8], '1285.75');
+});
