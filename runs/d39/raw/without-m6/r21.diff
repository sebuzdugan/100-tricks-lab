--- a/src/customers.js
+++ b/src/customers.js
@@ -43,3 +43,38 @@ export function validateCustomer(c) {
   if (!c || !c.id || !c.name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c.email ?? '')) return fail('CUSTOMER_INVALID');
   return ok({ ...c });
 }
+
+/**
+ * Merge a duplicate customer into another.
+ * @param {Array} customers
+ * @param {Array} invoices
+ * @param {string} fromId - customer to remove
+ * @param {string} intoId - customer to merge into
+ * @returns {{ ok: true, value: { customers: Array, invoices: Array } } | { ok: false, error: string }}
+ */
+export function mergeCustomers(customers, invoices, fromId, intoId) {
+  const normalizedFromId = normalizeId(fromId);
+  const normalizedIntoId = normalizeId(intoId);
+
+  if (normalizedFromId === normalizedIntoId) {
+    return fail('SAME_CUSTOMER');
+  }
+
+  const fromCustomerIndex = customers.findIndex((c) => normalizeId(c.id) === normalizedFromId);
+  const intoCustomerIndex = customers.findIndex((c) => normalizeId(c.id) === normalizedIntoId);
+
+  if (fromCustomerIndex === -1 || intoCustomerIndex === -1) {
+    return fail('CUSTOMER_NOT_FOUND');
+  }
+
+  const newCustomers = customers.filter((_, i) => i !== fromCustomerIndex);
+
+  const newInvoices = invoices.map((inv) => {
+    if (normalizeId(inv.customerId) === normalizedFromId) {
+      return { ...inv, customerId: normalizedIntoId };
+    }
+    return inv;
+  });
+
+  return ok({ customers: newCustomers, invoices: newInvoices });
+}
