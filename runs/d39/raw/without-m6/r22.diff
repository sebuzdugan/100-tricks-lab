index 0000000..7a1692f
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,53 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total amount for a line.
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount amount for a line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const total = lineTotal(line);
+  const discountPercent = line.discountPercent ?? 0;
+  return roundCents(total * discountPercent / 100);
+}
+
+/**
+ * Calculate the VAT amount for a line (after discount).
+ * @param {{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  return roundCents(amountAfterDiscount * line.vatRate / 100);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, vatRate: number, discountPercent?: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..00f9695
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,158 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  assert.equal(lineTotal(line), 95000);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { qty: 1, unitPrice: 5000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal rounds result', () => {
+  const line = { qty: 3, unitPrice: 3333 };
+  assert.equal(lineTotal(line), 9999);
+});
+
+test('lineDiscount calculates discount on line total', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 10 };
+  const total = lineTotal(line);
+  const expected = Math.round(total * 0.1);
+  assert.equal(lineDiscount(line), expected);
+});
+
+test('lineDiscount with no discountPercent', () => {
+  const line = { qty: 10, unitPrice: 9500 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with 0 discountPercent', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 0 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount with decimal percentage', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 12.5 };
+  assert.equal(lineDiscount(line), 11875);
+});
+
+test('lineVAT calculates VAT on amount after discount', () => {
+  const line = { qty: 10, unitPrice: 9500, vatRate: 21 };
+  const total = lineTotal(line);
+  const vat = Math.round(total * 0.21);
+  assert.equal(lineVAT(line), vat);
+});
+
+test('lineVAT with discount', () => {
+  const line = { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const base = total - discount;
+  const vat = Math.round(base * 0.21);
+  assert.equal(lineVAT(line), vat);
+});
+
+test('lineVAT with 9 percent rate', () => {
+  const line = { qty: 10, unitPrice: 1250, vatRate: 9 };
+  const total = lineTotal(line);
+  const vat = Math.round(total * 0.09);
+  assert.equal(lineVAT(line), vat);
+});
+
+test('lineVAT with 0 percent rate', () => {
+  const line = { qty: 10, unitPrice: 35000, vatRate: 0 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 95000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 19950);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 114950);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+      { qty: 10, unitPrice: 1250, vatRate: 9 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 107500);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 21075);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 128575);
+});
+
+test('invoiceTotals with line discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 95000);
+  assert.equal(result.discount, 9500);
+  assert.equal(result.vat, 17955);
+  assert.equal(result.total, 103455);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+    ],
+    voucher: { code: 'TEST', amount: 10000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 95000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 19950);
+  assert.equal(result.voucher, 10000);
+  assert.equal(result.total, 104950);
+});
+
+test('invoiceTotals clamped at zero', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 21 },
+    ],
+    voucher: { code: 'BIG', amount: 1000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals with multiple VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 9500, vatRate: 21 },
+      { qty: 10, unitPrice: 1250, vatRate: 9 },
+      { qty: 10, unitPrice: 2500, vatRate: 0 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 132500);
+  assert.equal(result.vat, 21075);
+});
+
+test('invoiceTotals no undefined voucher in response', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 9500, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 0);
+  assert.equal(typeof result.voucher, 'number');
+});
