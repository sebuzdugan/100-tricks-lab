+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { dashboard } from '../src/reports.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('dashboard with empty invoices', () => {
+  const result = dashboard([], '2024-12-31');
+  assert.deepEqual(result.counts, { draft: 0, issued: 0, partially_paid: 0, paid: 0 });
+  assert.equal(result.outstanding, 0);
+  assert.equal(result.overdue.count, 0);
+  assert.equal(result.overdue.amount, 0);
+  assert.deepEqual(result.topCustomers, []);
+});
+
+test('dashboard counts invoices by status', () => {
+  const draft = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(draft, []).value;
+  const paid = recordPayment(issued, { amount: 114950, date: '2024-01-20' }).value;
+  const result = dashboard([draft, issued, paid], '2024-12-31');
+  assert.equal(result.counts.draft, 1);
+  assert.equal(result.counts.issued, 1);
+  assert.equal(result.counts.paid, 1);
+});
+
+test('dashboard calculates outstanding', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(invoice1, []).value;
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+  const issued2 = issueInvoice(invoice2, ['INV-2024-0001']).value;
+  const partial = recordPayment(issued2, { amount: 50000, date: '2024-01-25' }).value;
+  const result = dashboard([issued1, partial], '2024-12-31');
+  const expected = 114950 + 64950;
+  assert.equal(result.outstanding, expected);
+});
+
+test('dashboard excludes paid invoices from outstanding', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(invoice, []).value;
+  const paid = recordPayment(issued, { amount: 114950, date: '2024-01-20' }).value;
+  const result = dashboard([paid], '2024-12-31');
+  assert.equal(result.outstanding, 0);
+});
+
+test('dashboard top customers by due amount', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+  const inv2 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+  const result = dashboard([issued1, issued2], '2024-12-31');
+  assert.equal(result.topCustomers.length, 2);
+  assert.equal(result.topCustomers[0].customerId, 'C-002');
+});
+
+test('dashboard returns only top 3 customers', () => {
+  const invoices = [];
+  for (let i = 0; i < 5; i++) {
+    const inv = createInvoice({
+      customerId: `C-${String(i + 1).padStart(3, '0')}`,
+      issueDate: '2024-01-15',
+      lines: [{ sku: 'DEV-HOUR', qty: i + 1 }],
+    }).value;
+    invoices.push(issueInvoice(inv, invoices.map(i => i.number || 'DRAFT')).value);
+  }
+  const result = dashboard(invoices, '2024-12-31');
+  assert.equal(result.topCustomers.length, 3);
+});
+
+test('dashboard aggregates multiple invoices per customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2024-01-20',
+    lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2024-0001']).value;
+  const result = dashboard([issued1, issued2], '2024-12-31');
+  const customer = result.topCustomers.find(c => c.customerId === 'C-002');
+  assert.ok(customer);
+  assert.equal(customer.due, 114950 * 2);
+});
