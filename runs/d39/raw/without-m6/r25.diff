+
+test('renderInvoiceText shows voucher before total', () => {
+  let invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  invoice = applyVoucher(invoice, { code: 'SUMMER20', amount: 1000 }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  const voucherLineIndex = lines.findIndex((l) => l.startsWith('Voucher'));
+  const totalLineIndex = lines.findIndex((l) => l.startsWith('Total:'));
+
+  assert.ok(voucherLineIndex >= 0, 'should have voucher line');
+  assert.ok(totalLineIndex > voucherLineIndex, 'voucher should come before total');
+  assert.match(lines[voucherLineIndex], /Voucher \(SUMMER20\): -€10\.00/);
+});
+
+test('renderInvoiceText does not show voucher when none applied', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(!text.includes('Voucher'));
+});
+
+test('renderInvoiceText shows due date when present', () => {
