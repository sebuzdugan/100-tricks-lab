+
+test('renderInvoiceText shows paid amount when payments exist', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'partially_paid',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 }],
+    payments: [
+      { date: '2024-01-20', amount: 5000 },
+      { date: '2024-01-25', amount: 3000 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /Paid: €80\.00/);
+});
+
+test('renderInvoiceText does not show paid when no payments', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    lines: [{ sku: 'DEV-HOUR', name: 'Development (hour)', qty: 1, unitPrice: 9500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(!text.includes('Paid:'));
+});
+
+test('renderInvoiceText with voucher, due date, and payments', () => {
+  let invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-01-15',
+    terms: 'NET14',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  invoice = applyVoucher(invoice, { code: 'SAVE50', amount: 2000 }).value;
+  invoice = { ...invoice, status: 'partially_paid', payments: [{ date: '2024-01-20', amount: 4000 }] };
