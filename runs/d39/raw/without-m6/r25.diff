@@ -4,7 +4,7 @@ import { invoiceTotals, lineTotal, lineDiscount } from './invoices.js';
 
 /**
  * Render an invoice as plain text.
- * @param {{ customerId: string, issueDate: string, status: string, lines: Array, number?: string }} invoice
+ * @param {{ customerId: string, issueDate: string, status: string, dueDate?: string, lines: Array, number?: string, voucher?: { code: string, amount: number }, payments?: Array }} invoice
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -35,7 +35,21 @@ export function renderInvoiceText(invoice) {
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+
+  if (invoice.voucher) {
+    lines.push(`Voucher (${invoice.voucher.code}): -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return lines.join('\n');
 }
