diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..8e792f8
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,63 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns 0001 for the first invoice of a year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for subsequent invoices', () => {
+  const existing = ['INV-2026-0001'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles multiple existing numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0003', 'INV-2026-0002'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 100 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0101');
+});
+
+test('nextInvoiceNumber restarts counter for different years', () => {
+  const existing = ['INV-2025-0005', 'INV-2026-0003', 'INV-2026-0001'];
+  const number2026 = nextInvoiceNumber(existing, '2026-10-07');
+  const number2027 = nextInvoiceNumber(existing, '2027-01-01');
+  assert.equal(number2026, 'INV-2026-0004');
+  assert.equal(number2027, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-0010', 'INV-2026-0005', 'INV-2024-0002'];
+  const number = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber handles malformed numbers gracefully', () => {
+  const existing = ['INV-2026-0001', 'INVALID', 'INV-2026-ABC', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber is order-independent', () => {
+  const set1 = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'];
+  const set2 = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003'];
+  const number1 = nextInvoiceNumber(set1, '2026-10-07');
+  const number2 = nextInvoiceNumber(set2, '2026-10-07');
+  assert.equal(number1, number2);
+  assert.equal(number1, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber works with different dates in same year', () => {
+  const existing = ['INV-2026-0005'];
+  const number1 = nextInvoiceNumber(existing, '2026-01-01');
+  const number2 = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(number1, 'INV-2026-0006');
+  assert.equal(number2, 'INV-2026-0006');
+});
