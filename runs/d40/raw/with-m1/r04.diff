new file mode 100644
index 0000000..3b6733b
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,21 @@
+/**
+ * Calculate the next free invoice number for a given year.
+ * Numbers have format INV-<year>-<counter> where counter is 4 digits, zero-padded.
+ * @param {Array<string>} existingNumbers - Invoice numbers already used, in any order
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const countersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.slice(prefix.length), 10))
+    .filter((counter) => !isNaN(counter));
+
+  const maxCounter = countersThisYear.length > 0 ? Math.max(...countersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
