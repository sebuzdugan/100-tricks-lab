+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * Format: invoice number (or DRAFT), customer name, line items, and total.
+ * All amounts are formatted as euros using formatEuros().
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const number = invoice.number ?? 'DRAFT';
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown';
+
+  const lines = [];
+  lines.push(number);
+  lines.push(customerName);
+
+  for (const line of invoice.lines) {
+    const lineTotal = line.qty * line.unitPrice;
+    const formattedUnitPrice = formatEuros(line.unitPrice);
+    const formattedLineTotal = formatEuros(lineTotal);
+    lines.push(`${line.qty} × ${line.name} @ ${formattedUnitPrice} = ${formattedLineTotal}`);
+  }
+
+  const totalsResult = invoiceTotals(invoice);
+  const totalAmount = totalsResult.ok ? totalsResult.value.total : 0;
+  const formattedTotal = formatEuros(totalAmount);
+  lines.push(`Total: ${formattedTotal}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..ec33ac9
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,195 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText shows customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows line items with qty, name, unit price, and total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // DES-HOUR: 2 × Design work (hour) @ €85.00 = €170.00
+  assert.match(lines[2], /^2 × Design work \(hour\) @ €85\.00 = €170\.00$/);
+});
+
+test('renderInvoiceText shows multiple line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.match(lines[2], /^2 × Design work \(hour\) @ €85\.00 = €170\.00$/);
+  assert.match(lines[3], /^3 × Development \(hour\) @ €95\.00 = €285\.00$/);
+});
+
+test('renderInvoiceText calculates and shows total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // Total should be 2*8500 + 3*9500 = 17000 + 28500 = 45500 cents = €455.00
+  assert.equal(lines[lines.length - 1], 'Total: €455.00');
+});
+
+test('renderInvoiceText shows single line item', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines.length, 4); // invoice number, customer, 1 line item, total
+  assert.match(lines[2], /^1 × Logo package @ €1,200\.00 = €1,200\.00$/);
+  assert.equal(lines[3], 'Total: €1,200.00');
+});
+
+test('renderInvoiceText formats large amounts with thousands separators', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  // BRAND-BOOK: 2 × €2450.00 = €4900.00
+  assert.match(text, /€2,450\.00/);
+  assert.match(text, /€4,900\.00/);
+});
+
+test('renderInvoiceText handles customer not found', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Unknown');
+});
+
+test('renderInvoiceText shows structure correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.match(lines[2], /^1 × Design work/);
+  assert.match(lines[3], /^2 × Copywriting/);
+  assert.match(lines[4], /^Total:/);
+});
+
+test('renderInvoiceText with various quantities and prices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'ICON-SET', qty: 100 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // DES-HOUR: 5 × €85.00 = €425.00
+  // ICON-SET: 100 × €9.80 = €980.00
+  // Total: €1,405.00
+  assert.match(lines[2], /^5 × Design work \(hour\) @ €85\.00 = €425\.00$/);
+  assert.match(lines[3], /^100 × Icon set \(24 icons\) @ €9\.80 = €980\.00$/);
+  assert.equal(lines[4], 'Total: €1,405.00');
+});
+
+test('renderInvoiceText issued invoice has correct number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-03-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const existing = ['INV-2026-0005', 'INV-2025-0010'];
+  const issued = issueInvoice(invoice, existing).value;
+  const text = renderInvoiceText(issued);
+  assert.match(text, /^INV-2026-0006\n/);
+});
+
+test('renderInvoiceText preserves product VAT rate (shown in name/data)', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'PRINT-A4', qty: 50 }, // VAT 9%, unitPrice 37 cents
+      { sku: 'DES-HOUR', qty: 1 },  // VAT 21%, unitPrice 8500 cents
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  assert.match(lines[2], /^50 × Printed flyer A4/);
+  assert.match(lines[3], /^1 × Design work \(hour\)/);
+  // Should calculate correctly regardless of VAT rate (VAT applied later)
+  assert.match(lines[2], /€18\.50/); // 50 * 37 cents = 1850 cents = €18.50
+  assert.match(lines[3], /€85\.00/); // 1 * 8500 cents = 8500 cents = €85.00
+});
