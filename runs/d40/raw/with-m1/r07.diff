+
+test('createInvoice applies gold tier discount (5%) to lines without explicit discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001', // Northwind Studio, gold tier
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5);
+});
+
+test('createInvoice applies silver tier discount (2.5%) to lines without explicit discount', () => {
+  const r = createInvoice({
+    customerId: 'C-003', // Kite & Co, silver tier
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 2.5);
+});
+
+test('createInvoice applies standard tier discount (0%) to lines without explicit discount', () => {
+  const r = createInvoice({
+    customerId: 'C-002', // Blue Fern Bakery, standard tier
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, undefined);
+});
+
+test('createInvoice explicit discountPercent overrides tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001', // gold tier (5%), but explicit 10%
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 10 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice explicit 0% discount overrides gold tier discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001', // gold tier (5%), but explicit 0%
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, undefined);
+});
+
+test('createInvoice applies different tier discounts to different lines without explicit discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1, discountPercent: 10 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 5); // tier discount
+  assert.equal(r.value.lines[1].discountPercent, 10); // explicit
+  assert.equal(r.value.lines[2].discountPercent, 5); // tier discount
+});
+
+test('invoiceTotals with tier discount (gold 5%)', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001', // gold tier
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // DES-HOUR: 2 * 8500 = 17000
+  // Discount: 17000 * 5% = 850
+  // Total: 17000 - 850 = 16150
+  assert.equal(r.value.subtotal, 17000);
+  assert.equal(r.value.discount, 850);
+  assert.equal(r.value.total, 16150);
+});
+
+test('invoiceTotals with tier discount (silver 2.5%)', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003', // silver tier
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // DES-HOUR: 2 * 8500 = 17000
+  // Discount: 17000 * 2.5% = 425
+  // Total: 17000 - 425 = 16575
+  assert.equal(r.value.subtotal, 17000);
+  assert.equal(r.value.discount, 425);
+  assert.equal(r.value.total, 16575);
+});
+
+test('invoiceTotals with tier discount (standard 0%)', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002', // standard tier
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // DES-HOUR: 2 * 8500 = 17000
+  // Discount: 0 (no tier discount)
+  // Total: 17000
+  assert.equal(r.value.subtotal, 17000);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.total, 17000);
+});
+
+test('invoiceTotals mixes tier discounts with explicit discounts', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001', // gold tier (5%)
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 }, // gets 5% from tier
+      { sku: 'DEV-HOUR', qty: 1, discountPercent: 15 }, // explicit 15%
+    ],
+  }).value;
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // DES-HOUR: 8500, discount: 425 (5%)
+  // DEV-HOUR: 9500, discount: 1425 (15%)
+  // Subtotal: 18000, Discount: 1850, Total: 16150
+  assert.equal(r.value.subtotal, 18000);
+  assert.equal(r.value.discount, 1850);
+  assert.equal(r.value.total, 16150);
+});
