-import { getCustomer, listCustomers, validateCustomer } from '../src/customers.js';
+import { getCustomer, listCustomers, validateCustomer, normalizeId } from '../src/customers.js';
 
 test('getCustomer finds a customer by id', () => {
   const r = getCustomer('C-003');
@@ -20,3 +20,49 @@ test('validateCustomer needs an id, a name and an email', () => {
   assert.equal(validateCustomer({ id: 'C-100', name: 'X', email: 'x@y.example' }).ok, true);
   assert.deepEqual(validateCustomer({ id: 'C-100', name: 'X', email: 'nope' }), { ok: false, error: 'CUSTOMER_INVALID' });
 });
+
+test('normalizeId uppercases lowercase ids', () => {
+  assert.equal(normalizeId('c-003'), 'C-003');
+  assert.equal(normalizeId('c-001'), 'C-001');
+});
+
+test('normalizeId trims whitespace', () => {
+  assert.equal(normalizeId('C-003 '), 'C-003');
+  assert.equal(normalizeId(' C-003'), 'C-003');
+  assert.equal(normalizeId('  c-007  '), 'C-007');
+});
+
+test('normalizeId handles mixed case and whitespace together', () => {
+  assert.equal(normalizeId('c-003 '), 'C-003');
+  assert.equal(normalizeId(' C-001 '), 'C-001');
+  assert.equal(normalizeId('  c-007  '), 'C-007');
+});
+
+test('normalizeId handles edge cases', () => {
+  assert.equal(normalizeId(''), '');
+  assert.equal(normalizeId('   '), '');
+  assert.equal(normalizeId('C-001'), 'C-001');
+});
+
+test('getCustomer finds customer by lowercase id', () => {
+  const r = getCustomer('c-003');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Kite & Co');
+});
+
+test('getCustomer finds customer by id with whitespace', () => {
+  const r = getCustomer('C-003 ');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Kite & Co');
+});
+
+test('getCustomer finds customer by mixed case and whitespace id', () => {
+  const r = getCustomer(' c-007 ');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.name, 'Halvorsen Architects');
+});
+
+test('getCustomer still reports unknown id for non-existent normalized ids', () => {
+  assert.deepEqual(getCustomer('c-999'), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+  assert.deepEqual(getCustomer(' C-999 '), { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
