diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..6374d94
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,132 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10/07/2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate('2026-10'), false);
+  assert.equal(isValidDate('2026'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false); // Feb 30 doesn't exist
+  assert.equal(isValidDate('2023-02-29'), false); // not a leap year
+  assert.equal(isValidDate('2026-13-01'), false); // month 13
+  assert.equal(isValidDate('2026-00-01'), false); // month 0
+  assert.equal(isValidDate('2026-01-32'), false); // day 32
+  assert.equal(isValidDate('2026-01-00'), false); // day 0
+  assert.equal(isValidDate('2026-04-31'), false); // April has 30 days
+});
+
+test('isValidDate handles leap years correctly', () => {
+  assert.equal(isValidDate('2024-02-29'), true);  // leap year
+  assert.equal(isValidDate('2023-02-29'), false); // not leap year
+  assert.equal(isValidDate('2000-02-29'), true);  // 2000 is leap year (divisible by 400)
+  assert.equal(isValidDate('1900-02-29'), false); // 1900 is not leap year (divisible by 100 but not 400)
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-07', 365), '2027-10-07');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-10-30', 2), '2026-11-01');
+  assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+  assert.equal(addDays('2026-12-25', 7), '2027-01-01');
+});
+
+test('addDays handles leap year boundaries', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29'); // leap year
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2023-02-28', 1), '2023-03-01'); // non-leap year
+});
+
+test('addDays subtracts days with negative numbers', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+  assert.equal(addDays('2026-10-07', -365), '2025-10-07');
+});
+
+test('addDays handles negative days across month boundaries', () => {
+  assert.equal(addDays('2026-11-01', -1), '2026-10-31');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  assert.equal(addDays('2026-03-01', -1), '2026-02-28');
+  assert.equal(addDays('2024-03-01', -1), '2024-02-29'); // leap year
+});
+
+test('addDays with zero returns same date', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2027-10-07'), 365);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+  assert.equal(daysBetween('2027-10-07', '2026-10-07'), -365);
+});
+
+test('daysBetween with same dates returns 0', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+  assert.equal(daysBetween('2026-10-30', '2026-11-01'), 2);
+  assert.equal(daysBetween('2026-09-30', '2026-10-01'), 1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2026-12-25', '2027-01-01'), 7);
+});
+
+test('daysBetween handles leap year', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365); // 2024 is leap year (366 days total)
+  assert.equal(daysBetween('2023-01-01', '2023-12-31'), 364); // 2023 is not leap year (365 days total)
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const date = '2026-10-07';
+  const days = 45;
+  const futureDate = addDays(date, days);
+  assert.equal(daysBetween(date, futureDate), days);
+  assert.equal(addDays(date, daysBetween(date, futureDate)), futureDate);
+});
+
+test('daysBetween calculates correctly for large differences', () => {
+  assert.equal(daysBetween('2000-01-01', '2026-10-07'), 9776); // 26 years + 279 days
+});
+
+test('isValidDate formats are always YYYY-MM-DD with zero padding', () => {
+  assert.equal(isValidDate('2026-01-05'), true);
+  assert.equal(isValidDate('2026-1-5'), false);
+  assert.equal(isValidDate('2026-01-5'), false);
+  assert.equal(isValidDate('2026-1-05'), false);
+});
