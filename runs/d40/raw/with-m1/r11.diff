+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment records a payment on an issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r = recordPayment(issued, { amount: 5000, date: '2026-10-10' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, 5000);
+  assert.equal(r.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment marks invoice as paid when balance reaches zero', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // DES-HOUR: 8500, VAT: 8500 * 21% = 1785, Total: 10285
+  const r = recordPayment(issued, { amount: 10285, date: '2026-10-10' });
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+  assert.equal(r.value.payments[0].amount, 10285);
+});
+
+test('recordPayment records multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total: 20570
+  const r1 = recordPayment(issued, { amount: 5000, date: '2026-10-10' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.status, 'partially_paid');
+
+  const r2 = recordPayment(r1.value, { amount: 8000, date: '2026-10-15' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'partially_paid');
+  assert.equal(r2.value.payments.length, 2);
+  assert.equal(r2.value.payments[0].amount, 5000);
+  assert.equal(r2.value.payments[1].amount, 8000);
+});
+
+test('recordPayment transitions from partially_paid to paid', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  // Total: 10285
+  const r1 = recordPayment(issued, { amount: 5000, date: '2026-10-10' });
+  assert.equal(r1.value.status, 'partially_paid');
+
+  const r2 = recordPayment(r1.value, { amount: 5285, date: '2026-10-15' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'paid');
+  assert.equal(r2.value.payments.length, 2);
+});
+
+test('recordPayment reports NOT_ISSUED for draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
