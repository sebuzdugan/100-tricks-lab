+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Record a payment against an issued or partially paid invoice.
+ * @param {{ status: string, payments?: Array<{ amount: number, date: string }> }} invoice
+ * @param {{ amount: number, date: string }}
+ * @returns {{ ok: true, value: any } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (!invoice || !['issued', 'partially_paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return totalsResult;
+
+  const currentBalance = balanceDue(invoice);
+
+  if (amount > currentBalance) {
+    return fail('OVERPAYMENT');
+  }
+
+  const payments = (invoice.payments ?? []).map((p) => ({ ...p }));
+  payments.push({ amount, date });
+
+  const newBalance = currentBalance - amount;
+  const status = newBalance === 0 ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    status,
+    payments,
+  });
+}
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ lines: Array, payments?: Array<{ amount: number }> }}
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totalsResult = invoiceTotals(invoice);
+  if (!totalsResult.ok) return 0;
+
+  const invoiceTotal = totalsResult.value.total;
+  const paid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+
+  return Math.max(0, invoiceTotal - paid);
+}
