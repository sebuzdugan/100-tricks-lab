+  assert.equal(r.value.dueDate, '2027-01-08');
+});
+
+test('NET30 due date is 30 days after issue date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(r.value.dueDate, '2026-02-14');
