+});
+
+test('issueInvoice preserves dueDate', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  }).value;
+
+  const r = issueInvoice(invoice, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.dueDate, '2026-10-31');
+});
+
+test('addLine preserves terms and dueDate', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  }).value;
+
+  const r = addLine(invoice, { sku: 'DEV-HOUR', qty: 2 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'NET30');
+  assert.equal(r.value.dueDate, '2026-11-06');
+});
+
+test('removeLine preserves terms and dueDate', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 2 },
+    ],
+    terms: 'NET14',
+  }).value;
+
+  const r = removeLine(invoice, 'DES-HOUR');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'NET14');
+  assert.equal(r.value.dueDate, '2026-10-21');
+});
+
+test('NET14 calculates correctly for all months with 30 days', () => {
+  const months30 = ['04', '06', '09', '11'];
+  const start = '2026';
+
+  for (const month of months30) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: `${start}-${month}-20`,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET14',
+    });
+    assert.equal(r.ok, true);
+    // 20 + 14 = 34, which is 4 days into next month
+    const nextMonth = String(parseInt(month) + 1).padStart(2, '0');
+    const nextYear = parseInt(month) === 12 ? String(parseInt(start) + 1) : start;
+    assert.equal(r.value.dueDate, `${nextYear}-${nextMonth}-04`);
+  }
+});
+
+test('EOM for all 30-day months', () => {
+  const months30 = ['04', '06', '09', '11'];
+  const start = '2026';
+
+  for (const month of months30) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: `${start}-${month}-15`,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'EOM',
+    });
+    assert.equal(r.ok, true);
+    assert.equal(r.value.dueDate, `${start}-${month}-30`);
+  }
+});
+
+test('EOM for all 31-day months', () => {
+  const months31 = ['01', '03', '05', '07', '08', '10', '12'];
+  const start = '2026';
+
+  for (const month of months31) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: `${start}-${month}-15`,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'EOM',
+    });
+    assert.equal(r.ok, true);
+    assert.equal(r.value.dueDate, `${start}-${month}-31`);
+  }
+});
+
