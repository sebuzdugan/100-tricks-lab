+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-');
+    const nextMonth = parseInt(month) + 1;
+    let nextMonthStr = String(nextMonth).padStart(2, '0');
+    let nextYearStr = year;
