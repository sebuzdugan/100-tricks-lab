+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(r.value.dueDate, '2026-10-31');
+});
+
+test('EOM due date from end of month stays same month', () => {
