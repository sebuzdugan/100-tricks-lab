+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, addLine, removeLine } from '../src/invoices.js';
+
+test('createInvoice defaults to NET30 terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'NET30');
+  assert.equal(r.value.dueDate, '2026-11-06');
+});
+
+test('createInvoice accepts NET14 terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'NET14');
+  assert.equal(r.value.dueDate, '2026-10-21');
+});
+
+test('createInvoice accepts NET30 terms explicitly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'NET30');
+  assert.equal(r.value.dueDate, '2026-11-06');
+});
+
+test('createInvoice accepts EOM terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.terms, 'EOM');
+  assert.equal(r.value.dueDate, '2026-10-31');
+});
+
+test('createInvoice reports TERMS_INVALID for unknown terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET60',
+  });
+  assert.deepEqual(r, { ok: false, error: 'TERMS_INVALID' });
+});
+
+test('createInvoice reports TERMS_INVALID for empty string terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: '',
+  });
+  assert.deepEqual(r, { ok: false, error: 'TERMS_INVALID' });
+});
+
+test('createInvoice reports TERMS_INVALID for case-sensitive terms', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'net30',
+  });
+  assert.deepEqual(r, { ok: false, error: 'TERMS_INVALID' });
+});
+
+test('NET14 due date is 14 days after issue date', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  assert.equal(r.value.dueDate, '2026-01-29');
+});
+
+test('NET14 handles month boundaries', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-20',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
+  });
+  assert.equal(r.value.dueDate, '2026-02-03');
+});
+
+test('NET14 handles year boundaries', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-25',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET14',
