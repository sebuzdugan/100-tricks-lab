+
+test('EOM due date for January (31 days)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-01-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(r.value.dueDate, '2026-01-31');
+});
+
+test('EOM due date for April (30 days)', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-04-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(r.value.dueDate, '2026-04-30');
+});
+
+test('EOM due date at year boundary', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'EOM',
+  });
+  assert.equal(r.value.dueDate, '2026-12-31');
+});
+
+test('issueInvoice preserves terms', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
