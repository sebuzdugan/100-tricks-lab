+
+test('removeLine preserves voucher', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'TEST', amount: 500 }).value;
+  const r = removeLine(withVoucher, 'DES-HOUR');
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher.code, 'TEST');
+  assert.equal(r.value.voucher.amount, 500);
+});
+
+test('applyVoucher with various code names', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const codes = ['WELCOME10', 'EARLY-BIRD', 'X2024', 'code_123', ''];
+
+  for (const code of codes) {
+    const r = applyVoucher(invoice, { code, amount: 1000 });
+    assert.equal(r.ok, true);
+    assert.equal(r.value.voucher.code, code);
+  }
+});
+
+test('voucher amount preserved exactly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const amounts = [1, 100, 1000, 10000, 999999];
+
+  for (const amount of amounts) {
+    const r = applyVoucher(invoice, { code: 'TEST', amount });
+    assert.equal(r.ok, true);
+    assert.equal(r.value.voucher.amount, amount);
+  }
+});
+
