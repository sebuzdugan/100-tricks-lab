+  const r = invoiceTotals(withVoucher);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 17000);
+  assert.equal(r.value.discount, 850);
+  assert.equal(r.value.vat, 3392);
+  assert.equal(r.value.voucher, 1500);
+  assert.equal(r.value.total, 18042);
+});
+
+test('invoiceTotals with VAT-exempt items and voucher', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  }).value;
+
+  // WORKSHOP-DAY: 60000, VAT: 0, Total: 60000
+  const withVoucher = applyVoucher(invoice, { code: 'WORKSHOP', amount: 5000 }).value;
+  const r = invoiceTotals(withVoucher);
