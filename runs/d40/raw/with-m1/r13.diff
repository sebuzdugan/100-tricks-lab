+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  }).value;
+
+  // LOGO-PACK: 120000, VAT: 25200, Total: 145200
+  const percentages = [10, 25, 50, 75, 90];
+
+  for (const pct of percentages) {
+    const amount = Math.round(145200 * (pct / 100));
+    const withVoucher = applyVoucher(invoice, { code: `PCT${pct}`, amount }).value;
+    const r = invoiceTotals(withVoucher);
