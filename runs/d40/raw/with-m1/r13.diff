+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher, addLine, removeLine } from '../src/invoices.js';
+
+test('applyVoucher applies a voucher to a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const r = applyVoucher(invoice, { code: 'WELCOME10', amount: 1000 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher.code, 'WELCOME10');
+  assert.equal(r.value.voucher.amount, 1000);
+});
+
+test('invoiceTotals includes voucher in calculation', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'WELCOME10', amount: 1000 }).value;
+  const r = invoiceTotals(withVoucher);
+
+  assert.equal(r.ok, true);
+  // DES-HOUR: 17000, VAT: 3570, Total without voucher: 20570
+  // With voucher of 1000: 20570 - 1000 = 19570
+  assert.equal(r.value.subtotal, 17000);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 3570);
+  assert.equal(r.value.voucher, 1000);
+  assert.equal(r.value.total, 19570);
+});
+
+test('applyVoucher reports NOT_DRAFT for issued invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const r = applyVoucher(issued, { code: 'WELCOME10', amount: 1000 });
+
+  assert.deepEqual(r, { ok: false, error: 'NOT_DRAFT' });
+});
+
+test('applyVoucher reports NOT_DRAFT for null invoice', () => {
+  const r = applyVoucher(null, { code: 'WELCOME10', amount: 1000 });
+  assert.deepEqual(r, { ok: false, error: 'NOT_DRAFT' });
+});
+
+test('applyVoucher reports VOUCHER_EXISTS when voucher already applied', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const withVoucher = applyVoucher(invoice, { code: 'FIRST', amount: 500 }).value;
+  const r = applyVoucher(withVoucher, { code: 'SECOND', amount: 600 });
+
+  assert.deepEqual(r, { ok: false, error: 'VOUCHER_EXISTS' });
+});
+
+test('applyVoucher reports AMOUNT_INVALID for zero amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = applyVoucher(invoice, { code: 'INVALID', amount: 0 });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('applyVoucher reports AMOUNT_INVALID for negative amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = applyVoucher(invoice, { code: 'INVALID', amount: -500 });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('applyVoucher reports AMOUNT_INVALID for fractional amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = applyVoucher(invoice, { code: 'INVALID', amount: 500.5 });
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('applyVoucher does not mutate original invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+  applyVoucher(invoice, { code: 'WELCOME10', amount: 1000 });
+
+  assert.deepEqual(invoice, invoiceCopy);
+});
+
+test('invoiceTotals with voucher larger than total clamps to 0', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  // DES-HOUR: 8500, VAT: 1785, Total: 10285
+  const withVoucher = applyVoucher(invoice, { code: 'BIG', amount: 50000 }).value;
+  const r = invoiceTotals(withVoucher);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.total, 0);
+  assert.equal(r.value.voucher, 50000);
+});
+
+test('invoiceTotals without voucher returns 0 for voucher', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher, 0);
+});
+
+test('applyVoucher with small amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
