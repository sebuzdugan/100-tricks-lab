+
+test('invoiceTotals with multiple lines and voucher', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  // Subtotal: 45500, VAT: 9555, Total without voucher: 55055
+  const withVoucher = applyVoucher(invoice, { code: 'MULTI', amount: 5000 }).value;
