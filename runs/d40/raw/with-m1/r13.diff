+});
+
+test('invoiceTotals with discount and voucher', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  }).value;
+
+  // DES-HOUR: 17000, discount: 1700, amount after discount: 15300, VAT: 3213, Total: 18513
+  const withVoucher = applyVoucher(invoice, { code: 'VOUCHER', amount: 2000 }).value;
+  const r = invoiceTotals(withVoucher);
+
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 17000);
+  assert.equal(r.value.discount, 1700);
