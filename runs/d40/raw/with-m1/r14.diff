+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns customer statement with issued invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(inv1, []).value;
+
+  const r = statement('C-001', [issued], '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-07');
+  // C-001 is gold tier: 17000 - 850 (5% discount) + 3392 (VAT) = 19542
+  assert.equal(r.value.invoices[0].total, 19542);
+  assert.equal(r.value.invoices[0].due, 19542);
+  assert.equal(r.value.totalDue, 19542);
+});
+
+test('statement filters invoices before asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
