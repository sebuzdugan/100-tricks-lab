+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement showing invoices and amount due.
+ * @param {string} customerId
+ * @param {Array<{ number: string, customerId: string, status: string, issueDate: string, dueDate: string, lines: Array, payments?: Array, voucher?: any }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const statementInvoices = [];
+  let totalDue = 0;
+
+  for (const invoice of invoices) {
+    if (!invoice || invoice.customerId !== customerResult.value.id) continue;
+    if (!['issued', 'partially_paid'].includes(invoice.status)) continue;
+    if (invoice.issueDate > asOf) continue;
+
+    const totalsResult = invoiceTotals(invoice);
+    if (!totalsResult.ok) continue;
+
+    const total = totalsResult.value.total;
+    const due = balanceDue(invoice);
+
+    statementInvoices.push({
+      number: invoice.number,
+      issueDate: invoice.issueDate,
+      dueDate: invoice.dueDate,
+      total,
+      due,
+    });
+    totalDue += due;
+  }
+
+  statementInvoices.sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  return ok({
+    customerId: customerResult.value.id,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
