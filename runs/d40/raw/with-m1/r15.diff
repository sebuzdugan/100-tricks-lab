+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  // Total: 20570
+
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Overpaid', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(r.value.customerId, 'C-002');
+  assert.equal(r.value.amount, 5000);
+  assert.equal(r.value.reason, 'Overpaid');
+  assert.equal(r.value.date, '2026-10-10');
+});
+
+test('createCreditNote works with partially paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 5000, date: '2026-10-08' }).value;
+
+  const r = createCreditNote(partial, { amount: 2000, reason: 'Adjustment', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, undefined);
+  assert.equal(r.value.amount, 2000);
+});
