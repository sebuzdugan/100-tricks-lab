+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Get all invoices that are overdue as of a given date.
+ * Returns invoices with status 'issued' or 'partially_paid' whose dueDate is before asOf.
+ * @param {Array<{ number: string, customerId: string, status: string, dueDate: string, lines: Array, payments?: Array, voucher?: any }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = [];
+
+  for (const invoice of invoices) {
+    if (!invoice || !['issued', 'partially_paid'].includes(invoice.status)) continue;
+    if (invoice.dueDate >= asOf) continue;
+
+    const daysOverdue = daysBetween(invoice.dueDate, asOf);
+    const due = balanceDue(invoice);
+
+    overdue.push({
+      number: invoice.number,
+      customerId: invoice.customerId,
+      dueDate: invoice.dueDate,
+      daysOverdue,
+      due,
+    });
+  }
+
+  overdue.sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
