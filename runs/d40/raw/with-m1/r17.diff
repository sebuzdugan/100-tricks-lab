+/**
+ * Get a summary of VAT collected by VAT rate.
+ * Includes invoices with status 'issued', 'partially_paid', or 'paid'.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    if (!invoice || !['issued', 'partially_paid', 'paid'].includes(invoice.status)) continue;
+
+    for (const line of invoice.lines) {
+      const lineTotal = line.qty * line.unitPrice;
+      let lineDiscount = 0;
+      if (line.discountPercent && line.discountPercent > 0) {
+        lineDiscount = Math.round(lineTotal * (line.discountPercent / 100));
+      }
+      const base = lineTotal - lineDiscount;
+
+      const vatRate = line.vatRate || 0;
+      const lineVat = vatRate > 0 ? roundCents(base * (vatRate / 100)) : 0;
+
+      if (!vatByRate[vatRate]) {
+        vatByRate[vatRate] = { base: 0, vat: 0 };
+      }
+      vatByRate[vatRate].base += base;
+      vatByRate[vatRate].vat += lineVat;
+    }
+  }
+
+  const result = Object.keys(vatByRate)
+    .map(rate => ({
+      rate: parseFloat(rate),
+      base: vatByRate[rate].base,
+      vat: vatByRate[rate].vat,
+    }))
+    .sort((a, b) => b.rate - a.rate);
+
+  return result;
+}
