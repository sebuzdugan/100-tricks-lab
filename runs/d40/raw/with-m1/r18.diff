+/**
+ * Calculate late fee on an invoice: 0.04% of amount due per day overdue.
+ * @param {{ status: string, dueDate: string, lines: Array, payments?: Array, voucher?: any }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (!invoice || !['issued', 'partially_paid'].includes(invoice.status)) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  const fee = roundCents(due * (daysOverdue * 0.04 / 100));
+
+  return Math.max(0, fee);
+}
