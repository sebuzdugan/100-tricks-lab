+
+test('exportCsv multiple invoices in order', () => {
+  const invoices = [];
+  const numbers = [];
+
+  for (let i = 1; i <= 3; i++) {
+    const inv = createInvoice({
+      customerId: 'C-002',
+      issueDate: `2026-10-0${i}`,
+      lines: [{ sku: 'DES-HOUR', qty: i }],
