+import { invoiceTotals } from './invoices.js';
+import { getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
+
+function escapeCsvField(value) {
+  if (value === null || value === undefined) return '';
+  const str = String(value);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+function formatEuro(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<{ number?: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array, voucher?: any }>} invoices
+ * @returns {string} - CSV formatted string with header and one line per invoice
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  for (const invoice of invoices) {
+    if (!invoice) continue;
+
+    const totals = invoiceTotals(invoice);
+    const subtotal = totals.ok ? totals.value.subtotal : 0;
+    const discount = totals.ok ? totals.value.discount : 0;
+    const vat = totals.ok ? totals.value.vat : 0;
+    const total = totals.ok ? totals.value.total : 0;
+    const due = balanceDue(invoice);
+
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const fields = [
+      invoice.number || '',
+      customerName,
+      invoice.issueDate || '',
+      invoice.dueDate || '',
+      invoice.status || '',
+      formatEuro(subtotal),
+      formatEuro(discount),
+      formatEuro(vat),
+      formatEuro(total),
+      formatEuro(due),
+    ];
+
+    lines.push(fields.map(escapeCsvField).join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
