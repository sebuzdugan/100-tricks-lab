+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('exportCsv returns header and newline for empty list', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv with single invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3); // header, invoice, empty line at end
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.match(lines[1], /INV-2026-0001,Blue Fern Bakery,2026-10-07,2026-11-06,issued,85.00,0.00,17.85,102.85,102.85/);
+});
+
+test('exportCsv skips null invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const csv = exportCsv([null, issued, undefined]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3); // header, invoice, empty line
+});
+
+test('exportCsv with multiple invoices', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+
+  const issued1 = issueInvoice(inv1, []).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const csv = exportCsv([issued1, issued2]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 4); // header, 2 invoices, empty line
+  assert.match(lines[1], /INV-2026-0001/);
+  assert.match(lines[2], /INV-2026-0002/);
+});
+
+test('exportCsv with draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+
+  const csv = exportCsv([invoice]);
+
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3); // header, draft invoice, empty line
+  // Draft invoices have no number but do have a calculated dueDate
+  assert.match(lines[1], /^,Blue Fern Bakery,2026-10-07,2026-11-06,draft,/);
+});
+
+test('exportCsv formats euros with 2 decimals', () => {
+  const invoice = {
+    number: 'INV-2026-0001',
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    dueDate: '2026-11-06',
+    status: 'issued',
+    lines: [{ qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const csv = exportCsv([invoice]);
+  const lines = csv.split('\n');
+
+  assert.match(lines[1], /85\.00,0\.00,17\.85,102\.85,102\.85/);
+});
+
+test('exportCsv with discount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const csv = exportCsv([issued]);
+
+  const lines = csv.split('\n');
+  // 17000 - 1700 + 3213 = 18513
+  assert.match(lines[1], /170\.00,17\.00,32\.13,185\.13,185\.13/);
+});
+
