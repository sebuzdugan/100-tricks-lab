+
+test('invoiceTotals with discount and voucher', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 }],
+    voucher: { code: 'VOUCHER', amount: 2000 },
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 17000 - 1700 + 3213 = 18513 - 2000 = 16513
+  assert.equal(r.value.subtotal, 17000);
+  assert.equal(r.value.discount, 1700);
+  assert.equal(r.value.vat, 3213);
+  assert.equal(r.value.voucher, 2000);
+  assert.equal(r.value.total, 16513);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 0);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 0);
+  assert.equal(r.value.voucher, 0);
+  assert.equal(r.value.total, 0);
+});
+
+test('invoiceTotals with very small amounts', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1, vatRate: 21 }],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 1 cent, VAT: 0.21 -> 0
+  assert.equal(r.value.subtotal, 1);
+  assert.equal(r.value.vat, 0);
+  assert.equal(r.value.total, 1);
+});
+
+test('invoiceTotals with very large amounts', () => {
+  const invoice = {
+    lines: [{ qty: 1000000, unitPrice: 5000000, vatRate: 21 }],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 5 trillion cents
+  assert.equal(r.value.subtotal, 5000000000000);
+  assert.ok(r.value.vat > 0);
+});
+
+test('invoiceTotals does not mutate input', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+  const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+
+  invoiceTotals(invoice);
+
+  assert.deepEqual(invoice, invoiceCopy);
+});
