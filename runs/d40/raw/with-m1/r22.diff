+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+// lineTotal tests
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 5, unitPrice: 8500 };
+  const r = lineTotal(line);
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 42500);
+});
+
+test('lineTotal handles zero and large quantities', () => {
+  const r1 = lineTotal({ qty: 0, unitPrice: 1000 });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value, 0);
+
+  const r2 = lineTotal({ qty: 1000000, unitPrice: 5000000 });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value, 5000000000000);
+});
+
+test('lineTotal reports LINE_INVALID for missing fields', () => {
+  assert.deepEqual(lineTotal({ qty: 5 }), { ok: false, error: 'LINE_INVALID' });
+  assert.deepEqual(lineTotal({ unitPrice: 8500 }), { ok: false, error: 'LINE_INVALID' });
+  assert.deepEqual(lineTotal({}), { ok: false, error: 'LINE_INVALID' });
+  assert.deepEqual(lineTotal(null), { ok: false, error: 'LINE_INVALID' });
+});
+
+test('lineTotal reports LINE_INVALID for non-numeric values', () => {
+  assert.deepEqual(lineTotal({ qty: '5', unitPrice: 8500 }), { ok: false, error: 'LINE_INVALID' });
+  assert.deepEqual(lineTotal({ qty: 5, unitPrice: '8500' }), { ok: false, error: 'LINE_INVALID' });
+});
+
+// invoiceTotals tests
+test('invoiceTotals calculates subtotal and total from lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, vatRate: 21 },
+      { qty: 2, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 5 * 8500 = 42500, VAT: 42500 * 21% = 8925
+  // 2 * 9500 = 19000, VAT: 19000 * 21% = 3990
+  // Subtotal: 61500, VAT: 12915, Total: 74415
+  assert.equal(r.value.subtotal, 61500);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 12915);
+  assert.equal(r.value.total, 74415);
+});
+
+test('invoiceTotals handles single line item', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 120000, VAT: 120000 * 21% = 25200
+  // Total: 120000 + 25200 = 145200
+  assert.equal(r.value.subtotal, 120000);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 25200);
+  assert.equal(r.value.total, 145200);
+});
+
+test('invoiceTotals handles multiple line items with various quantities', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, vatRate: 21 },
+      { qty: 15, unitPrice: 9500, vatRate: 21 },
+      { qty: 8, unitPrice: 6000, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 10 * 8500 = 85000, VAT: 17850
+  // 15 * 9500 = 142500, VAT: 29925
+  // 8 * 6000 = 48000, VAT: 10080
+  // Subtotal: 275500, VAT: 57855, Total: 333355
+  assert.equal(r.value.subtotal, 275500);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 57855);
+  assert.equal(r.value.total, 333355);
+});
+
+test('invoiceTotals reports INVOICE_INVALID for missing lines', () => {
+  assert.deepEqual(invoiceTotals({ customerId: 'C-001' }), { ok: false, error: 'INVOICE_INVALID' });
+  assert.deepEqual(invoiceTotals(null), { ok: false, error: 'INVOICE_INVALID' });
+  assert.deepEqual(invoiceTotals({}), { ok: false, error: 'INVOICE_INVALID' });
+});
+
+test('invoiceTotals reports INVOICE_INVALID for non-array lines', () => {
+  assert.deepEqual(invoiceTotals({ lines: 'not an array' }), { ok: false, error: 'INVOICE_INVALID' });
+  assert.deepEqual(invoiceTotals({ lines: null }), { ok: false, error: 'INVOICE_INVALID' });
+});
+
+test('invoiceTotals propagates LINE_INVALID from lineTotal', () => {
+  const invoice = {
+    lines: [{ qty: 5 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.deepEqual(r, { ok: false, error: 'LINE_INVALID' });
+});
+
+test('invoiceTotals returns new object', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const r1 = invoiceTotals(invoice);
+  const r2 = invoiceTotals(invoice);
+  assert.notStrictEqual(r1.value, r2.value);
+  assert.deepEqual(r1.value, r2.value);
+});
+
+test('invoiceTotals calculates VAT on single line at 21%', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 8500 (no discount), VAT: 8500 * 21% = 1785
+  // Total: 8500 + 1785 = 10285
+  assert.equal(r.value.subtotal, 8500);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 1785);
+  assert.equal(r.value.total, 10285);
+});
+
+test('invoiceTotals calculates VAT on multiple lines with different rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, vatRate: 21 },
+      { qty: 1, unitPrice: 37, vatRate: 9 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 8500, VAT: 1785
+  // 37, VAT: 37 * 9% = 3.33 -> 3 (rounded)
+  // Subtotal: 8537, VAT: 1788, Total: 10325
+  assert.equal(r.value.subtotal, 8537);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 1788);
+  assert.equal(r.value.total, 10325);
+});
+
+test('invoiceTotals calculates VAT on amount after discount', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, discountPercent: 10, vatRate: 21 }],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // Line: 8500
+  // Discount: 8500 * 10% = 850
+  // Amount after discount: 8500 - 850 = 7650
+  // VAT: 7650 * 21% = 1606.5 -> 1606 (banker's rounding, 1606 is even)
+  // Total: 8500 - 850 + 1606 = 9256
+  assert.equal(r.value.subtotal, 8500);
+  assert.equal(r.value.discount, 850);
+  assert.equal(r.value.vat, 1606);
+  assert.equal(r.value.total, 9256);
+});
+
+test('invoiceTotals handles VAT-exempt products (0% VAT rate)', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 60000, vatRate: 0 }],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // VAT exempt
+  // VAT: 0
+  // Total: 60000 + 0 = 60000
+  assert.equal(r.value.subtotal, 60000);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 0);
+  assert.equal(r.value.total, 60000);
+});
+
+test('invoiceTotals with mixed VAT-exempt and taxed items', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, vatRate: 21 },
+      { qty: 1, unitPrice: 60000, vatRate: 0 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 8500, VAT: 1785
+  // 60000, VAT: 0
+  // Subtotal: 68500, VAT: 1785, Total: 70285
+  assert.equal(r.value.subtotal, 68500);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 1785);
+  assert.equal(r.value.total, 70285);
+});
+
+test('invoiceTotals with discount and VAT together', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 15, vatRate: 21 },
+      { qty: 50, unitPrice: 37, vatRate: 9 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // Line 1: 2 * 8500 = 17000
+  // Discount: 17000 * 15% = 2550
+  // Amount after discount: 14450
+  // VAT: 14450 * 21% = 3034.5 -> 3034 (banker's rounding, 3034 is even)
+  // Line 2: 50 * 37 = 1850
+  // VAT: 1850 * 9% = 166.5 -> 166 (banker's rounding, 166 is even)
+  // Subtotal: 18850, Discount: 2550, VAT: 3200, Total: 19500
+  assert.equal(r.value.subtotal, 18850);
+  assert.equal(r.value.discount, 2550);
+  assert.equal(r.value.vat, 3200);
+  assert.equal(r.value.total, 19500);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, vatRate: 21 }],
+    voucher: { code: 'DISCOUNT', amount: 1000 },
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 17000 + 3570 = 20570, with voucher: 20570 - 1000 = 19570
+  assert.equal(r.value.subtotal, 17000);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 3570);
+  assert.equal(r.value.voucher, 1000);
+  assert.equal(r.value.total, 19570);
+});
+
+test('invoiceTotals with voucher larger than total clamps to 0', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, vatRate: 21 }],
+    voucher: { code: 'BIG', amount: 50000 },
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 8500 + 1785 = 10285, with voucher of 50000 -> clamped to 0
+  assert.equal(r.value.subtotal, 8500);
+  assert.equal(r.value.vat, 1785);
+  assert.equal(r.value.voucher, 50000);
+  assert.equal(r.value.total, 0);
+});
+
+test('invoiceTotals without voucher returns 0 for voucher', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher, 0);
+});
+
+test('invoiceTotals returns correct structure', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21 }],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(typeof r.value.subtotal, 'number');
+  assert.equal(typeof r.value.discount, 'number');
+  assert.equal(typeof r.value.vat, 'number');
+  assert.equal(typeof r.value.voucher, 'number');
+  assert.equal(typeof r.value.total, 'number');
+  assert.equal(Object.keys(r.value).length, 5);
+});
+
+test('invoiceTotals sums discounts from multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+      { qty: 2, unitPrice: 9500, discountPercent: 20, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 17000, discount: 1700, amount after discount: 15300, VAT: 3213
+  // 19000, discount: 3800, amount after discount: 15200, VAT: 3192
+  // Subtotal: 36000, Discount: 5500, VAT: 6405, Total: 36905
+  assert.equal(r.value.subtotal, 36000);
+  assert.equal(r.value.discount, 5500);
+  assert.equal(r.value.vat, 6405);
+  assert.equal(r.value.total, 36905);
+});
+
+test('invoiceTotals handles mixed lines with and without discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+      { qty: 1, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // 8500, discount: 850, amount after discount: 7650, VAT: 1606
+  // 9500, discount: 0, amount after discount: 9500, VAT: 1995
+  // Subtotal: 18000, Discount: 850, VAT: 3601, Total: 20751
+  assert.equal(r.value.subtotal, 18000);
+  assert.equal(r.value.discount, 850);
+  assert.equal(r.value.vat, 3601);
+  assert.equal(r.value.total, 20751);
+});
+
+test('invoiceTotals clamps negative total to 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, discountPercent: 100, vatRate: 0 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 10000);
+  assert.equal(r.value.discount, 10000);
+  assert.equal(r.value.total, 0);
+});
+
+test('invoiceTotals with 0% discount shows no discount', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  // With 0% discount, base should equal line total
+  assert.equal(r.value.subtotal, 17000);
+  assert.equal(r.value.discount, 0);
+  assert.equal(r.value.vat, 3570);
+  assert.equal(r.value.total, 20570);
+});
+
+test('invoiceTotals VAT calculation with rounding', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 100, vatRate: 21 },
+      { qty: 1, unitPrice: 50, vatRate: 21 },
+    ],
+  };
+
+  const r = invoiceTotals(invoice);
+  // Base: 100 + 50 = 150
+  // VAT per line: 100 * 0.21 = 21, 50 * 0.21 = 10.5 -> 10 (banker's rounding)
+  // Total VAT: 21 + 10 = 31
+  assert.equal(r.value.base === undefined ? r.value.subtotal : r.value.base, 150);
+  assert.equal(r.value.vat, 31);
