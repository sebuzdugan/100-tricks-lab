diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..582a2da
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,61 @@
+import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line item: qty times unitPrice (in cents).
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineTotal(line) {
+  if (!line || typeof line.qty !== 'number' || typeof line.unitPrice !== 'number') {
+    return fail('LINE_INVALID');
+  }
+  return ok(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate totals for an invoice: subtotal, discount, VAT, voucher, and total.
+ * VAT is calculated per line on the amount after discount, rounded per line.
+ * Voucher is applied after VAT.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { code: string, amount: number } }}
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, voucher: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines)) {
+    return fail('INVOICE_INVALID');
+  }
+
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
+    const result = lineTotal(line);
+    if (!result.ok) return result;
+    const amount = result.value;
+    subtotal += amount;
+
+    let lineDiscount = 0;
+    if (line.discountPercent && line.discountPercent > 0) {
+      lineDiscount = Math.round(amount * (line.discountPercent / 100));
+      discount += lineDiscount;
+    }
+
+    const amountAfterDiscount = amount - lineDiscount;
+    if (line.vatRate && line.vatRate > 0) {
+      const lineVAT = roundCents(amountAfterDiscount * (line.vatRate / 100));
+      vat += lineVAT;
+    }
+  }
+
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+
+  return ok({
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  });
+}
