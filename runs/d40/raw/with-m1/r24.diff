+test('dashboard with complex invoice mix', () => {
+  const invoices = [];
+  const numbers = [];
+
+  // Create invoices with different statuses and customers
+  for (let i = 1; i <= 10; i++) {
+    const customerId = `C-${((i - 1) % 3) + 1}`;
+    let invoice = {
+      number: `INV-2026-000${i}`,
+      status: ['draft', 'issued', 'partially_paid', 'paid'][i % 4],
+      customerId,
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      lines: [{ qty: i, unitPrice: 5000, vatRate: 21 }],
+    };
+
+    if (invoice.status === 'partially_paid') {
+      invoice.payments = [{ amount: i * 2000, date: '2026-10-15' }];
+    } else if (invoice.status === 'paid') {
+      invoice.payments = [{ amount: i * 5000 + 1050 * i, date: '2026-10-15' }];
+    }
+
+    invoices.push(invoice);
+  }
+
+  const r = dashboard(invoices, '2026-11-15');
+
+  // Check counts (status cycle by i%4: [draft, issued, partially_paid, paid])
+  assert.equal(r.counts.draft, 2); // invoices 4, 8
+  assert.equal(r.counts.issued, 3); // invoices 1, 5, 9
+  assert.equal(r.counts.partially_paid, 3); // invoices 2, 6, 10
+  assert.equal(r.counts.paid, 2); // invoices 3, 7
+
+  // Check that top customers are populated
+  assert.ok(r.topCustomers.length > 0);
+  assert.ok(r.topCustomers.length <= 3);
+
+  // Check overdue (all issued and partially_paid as of 2026-11-15)
+  assert.ok(r.overdue.count >= 0);
+  assert.ok(r.overdue.amount >= 0);
+});
