 /**
  * Render an invoice as plain text.
- * Format: invoice number (or DRAFT), customer name, line items, subtotal, discount (if any), VAT (if any), and total.
+ * Format: invoice number (or DRAFT), customer name, line items, subtotal, discount (if any), VAT (if any), voucher (if any), total, due date (if any), and paid amount (if any).
  * All amounts are formatted as euros using formatEuros().
- * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate?: number }> }}
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate?: number }>, dueDate?: string, voucher?: { amount: number }, payments?: Array<{ amount: number }> }}
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -44,11 +44,25 @@ export function renderInvoiceText(invoice) {
       const formattedVAT = formatEuros(vat);
       lines.push(`VAT: +${formattedVAT}`);
     }
+    if (invoice.voucher && invoice.voucher.amount > 0) {
+      const formattedVoucher = formatEuros(invoice.voucher.amount);
+      lines.push(`Voucher: -${formattedVoucher}`);
+    }
     const formattedTotal = formatEuros(total);
     lines.push(`Total: ${formattedTotal}`);
   } else {
     lines.push('Total: Unable to calculate');
   }
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const formattedPaid = formatEuros(totalPaid);
+    lines.push(`Paid: ${formattedPaid}`);
+  }
+
   return lines.join('\n');
 }
