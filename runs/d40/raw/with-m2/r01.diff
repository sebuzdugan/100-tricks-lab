@@ -0,0 +1,125 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.issueDate, '2025-10-07');
+  assert.equal(result.value.status, 'draft');
+  assert.equal(result.value.lines.length, 2);
+
+  const line1 = result.value.lines[0];
+  assert.equal(line1.sku, 'DES-HOUR');
+  assert.equal(line1.name, 'Design work (hour)');
+  assert.equal(line1.qty, 5);
+  assert.equal(line1.unitPrice, 8500);
+  assert.equal(line1.vatRate, 21);
+
+  const line2 = result.value.lines[1];
+  assert.equal(line2.sku, 'DEV-HOUR');
+  assert.equal(line2.name, 'Development (hour)');
+  assert.equal(line2.qty, 3);
+});
+
+test('createInvoice reports CUSTOMER_NOT_FOUND for unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice reports DATE_INVALID for invalid date format', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '10/07/2025',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports DATE_INVALID for impossible dates', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-02-30',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createInvoice reports NO_LINES for empty lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice reports QTY_INVALID for zero quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 0 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for negative quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: -5 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports QTY_INVALID for non-integer quantities', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'QTY_INVALID' });
+});
+
+test('createInvoice reports UNKNOWN_SKU for unknown product', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'NOPE-SKU', qty: 1 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate the input lines', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 5 }];
+  const originalLine = { ...lines[0] };
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines,
+  });
+
+  assert.deepEqual(lines[0], originalLine);
+});
