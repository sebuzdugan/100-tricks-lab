@@ -0,0 +1,25 @@
+/**
+ * Calculate the next invoice number for a given year.
+ * Format: INV-<year>-<counter> where counter is 4 digits, zero-padded, starting at 0001.
+ * @param {Array<string>} existingNumbers - Invoice numbers already used (e.g., 'INV-2025-0001')
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string} - The next invoice number (e.g., 'INV-2025-0002')
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+
+  // Find the maximum counter for this year
+  const pattern = new RegExp(`^INV-${year}-(\\d{4})$`);
+  let maxCounter = 0;
+
+  for (const num of existingNumbers) {
+    const match = pattern.exec(num);
+    if (match) {
+      const counter = parseInt(match[1], 10);
+      maxCounter = Math.max(maxCounter, counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
