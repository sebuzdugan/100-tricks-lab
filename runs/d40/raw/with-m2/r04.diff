diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..713c3c2
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,53 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns the first number for a year with no existing numbers', () => {
+  const number = nextInvoiceNumber([], '2025-10-07');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber returns the next number when some exist for that year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0100', 'INV-2024-0200', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2025-10-07');
+  assert.equal(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber works with multiple years independently', () => {
+  const existing = [
+    'INV-2024-0050',
+    'INV-2025-0010',
+    'INV-2026-0005',
+  ];
+
+  const num2024 = nextInvoiceNumber(existing, '2024-12-31');
+  const num2025 = nextInvoiceNumber(existing, '2025-06-15');
+  const num2026 = nextInvoiceNumber(existing, '2026-01-01');
+
+  assert.equal(num2024, 'INV-2024-0051');
+  assert.equal(num2025, 'INV-2025-0011');
+  assert.equal(num2026, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits with zeros', () => {
+  const existing = ['INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2025-10-07');
+  assert.equal(number, 'INV-2025-0002');
+
+  // Test larger numbers still pad correctly
+  const existing2 = Array.from({ length: 9998 }, (_, i) => `INV-2025-${String(i + 1).padStart(4, '0')}`);
+  const number2 = nextInvoiceNumber(existing2, '2025-10-07');
+  assert.equal(number2, 'INV-2025-9999');
+});
+
+test('nextInvoiceNumber works with unordered existing numbers', () => {
+  const existing = ['INV-2025-0005', 'INV-2025-0001', 'INV-2025-0003', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2025-10-07');
+  assert.equal(number, 'INV-2025-0006');
+});
