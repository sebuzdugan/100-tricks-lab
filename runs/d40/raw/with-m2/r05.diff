diff --git a/src/render.js b/src/render.js
new file mode 100644
index 0000000..0c9caef
--- /dev/null
+++ b/src/render.js
@@ -0,0 +1,33 @@
+import { formatEuros } from './money.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {object} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // Invoice number or DRAFT
+  const invoiceNumber = invoice.number || 'DRAFT';
+  lines.push(invoiceNumber);
+
+  // Customer name
+  lines.push(invoice.customerName);
+
+  // Line items
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const unitPriceStr = formatEuros(line.unitPrice);
+    const totalStr = formatEuros(total);
+    lines.push(`${line.qty}x ${line.name} ${unitPriceStr} = ${totalStr}`);
+  }
+
+  // Total
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const totalStr = formatEuros(subtotal);
+  lines.push(`Total: ${totalStr}`);
+
+  return lines.join('\n');
+}
