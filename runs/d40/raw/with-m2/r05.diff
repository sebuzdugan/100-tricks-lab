+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice with all fields', () => {
+  const invoice = {
+    status: 'draft',
+    customerName: 'Northwind Studio',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 },
+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 3, unitPrice: 9500, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.equal(lines[2], '5x Design work (hour) €85.00 = €425.00');
+  assert.equal(lines[3], '3x Development (hour) €95.00 = €285.00');
+  assert.equal(lines[4], 'Total: €710.00');
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = {
+    number: 'INV-2025-0001',
+    status: 'issued',
+    customerName: 'Blue Fern Bakery',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'STICKER', name: 'Sticker sheet', qty: 100, unitPrice: 50, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'INV-2025-0001');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.equal(lines[2], '100x Sticker sheet €0.50 = €50.00');
+  assert.equal(lines[3], 'Total: €50.00');
+});
+
+test('renderInvoiceText formats currency correctly with thousands separators', () => {
+  const invoice = {
+    status: 'draft',
+    customerName: 'Large Corp',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 10, unitPrice: 120000, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '10x Logo package €1,200.00 = €12,000.00');
+  assert.equal(lines[3], 'Total: €12,000.00');
+});
+
+test('renderInvoiceText handles a single line item', () => {
+  const invoice = {
+    status: 'draft',
+    customerName: 'Smith & Co',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 4);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Smith & Co');
+  assert.equal(lines[2], '1x Design work (hour) €85.00 = €85.00');
+  assert.equal(lines[3], 'Total: €85.00');
+});
+
+test('renderInvoiceText formats small amounts correctly', () => {
+  const invoice = {
+    status: 'draft',
+    customerName: 'Test Customer',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'ICON-SET', name: 'Icon set (24 icons)', qty: 2, unitPrice: 980, vatRate: 21 },
+      { sku: 'PHOTO-LIC', name: 'Stock photo licence', qty: 1, unitPrice: 996, vatRate: 21 },
+    ],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[2], '2x Icon set (24 icons) €9.80 = €19.60');
+  assert.equal(lines[3], '1x Stock photo licence €9.96 = €9.96');
+  assert.equal(lines[4], 'Total: €29.56');
+});
