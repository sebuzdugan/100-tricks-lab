diff --git a/test/invoices.test.js b/test/invoices.test.js
index 0e35379..5ecf763 100644
--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -396,3 +396,186 @@ test('issueInvoice does not mutate the input invoice', () => {
   assert.equal(invoice.status, originalStatus);
   assert.equal(invoice.number, undefined);
 });
+
+test('createInvoice defaults discountPercent to 0 when not provided', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice accepts decimal discount percentages', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 12.5 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 12.5);
+});
+
+test('createInvoice accepts boundary discount values', () => {
+  const result0 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 0 }],
+  });
+  assert.equal(result0.ok, true);
+
+  const result100 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 100 }],
+  });
+  assert.equal(result100.ok, true);
+});
+
+test('createInvoice reports DISCOUNT_INVALID for negative discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: -5 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('createInvoice reports DISCOUNT_INVALID for discount > 100', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 105 }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('createInvoice reports DISCOUNT_INVALID for non-numeric discount', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1, discountPercent: 'twenty' }],
+  });
+
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+});
+
+test('invoiceTotals calculates discount correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 10 },
+      { qty: 5, unitPrice: 2000, discountPercent: 20 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10 * 1000 + 5 * 2000);
+  assert.equal(totals.subtotal, 20000);
+  assert.equal(totals.discount, (10 * 1000 * 10 / 100) + (5 * 2000 * 20 / 100));
+  assert.equal(totals.discount, 3000);
+  assert.equal(totals.total, 17000);
+});
+
+test('invoiceTotals includes discount field when discountPercent is 0', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1000, discountPercent: 0 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 5000);
+});
+
+test('invoiceTotals handles 100% discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 100 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals clamps negative totals to 0', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 150 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals handles mixed discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 10 },
+      { qty: 3, unitPrice: 9500, discountPercent: 5 },
+      { qty: 2, unitPrice: 6000, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  const line1Total = 5 * 8500;
+  const line2Total = 3 * 9500;
+  const line3Total = 2 * 6000;
+  const expectedSubtotal = line1Total + line2Total + line3Total;
+  const expectedDiscount = (line1Total * 10 / 100) + (line2Total * 5 / 100) + (line3Total * 0 / 100);
+  const expectedTotal = expectedSubtotal - expectedDiscount;
+
+  assert.equal(totals.subtotal, expectedSubtotal);
+  assert.equal(totals.discount, expectedDiscount);
+  assert.equal(totals.total, expectedTotal);
+});
+
+test('addLine accepts discountPercent', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const result = addLine(invoice, { sku: 'DEV-HOUR', qty: 3, discountPercent: 15 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 15);
+});
+
+test('addLine defaults discountPercent to 0', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = invoiceResult.value;
+
+  const result = addLine(invoice, { sku: 'DEV-HOUR', qty: 3 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 0);
+});
+
+test('addLine reports DISCOUNT_INVALID for invalid discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = invoiceResult.value;
+
+  let result = addLine(invoice, { sku: 'DEV-HOUR', qty: 3, discountPercent: -10 });
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+
+  result = addLine(invoice, { sku: 'DEV-HOUR', qty: 3, discountPercent: 101 });
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+
+  result = addLine(invoice, { sku: 'DEV-HOUR', qty: 3, discountPercent: 'invalid' });
+  assert.deepEqual(result, { ok: false, error: 'DISCOUNT_INVALID' });
+});
