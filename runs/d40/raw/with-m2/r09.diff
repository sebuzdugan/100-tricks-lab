 });
+
+test('createInvoice normalizes customer ID to uppercase', () => {
+  const result = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createInvoice normalizes customer ID with whitespace', () => {
+  const result = createInvoice({
+    customerId: ' C-001 ',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createInvoice normalizes customer ID with mixed case and spaces', () => {
+  const result = createInvoice({
+    customerId: ' c-003 ',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-003');
+  assert.equal(result.value.customerName, 'Kite & Co');
