diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..264b263
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,106 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-01-15'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1999-01-01'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('2025-1-15'), false);
+  assert.equal(isValidDate('25-01-15'), false);
+  assert.equal(isValidDate('2025/01/15'), false);
+  assert.equal(isValidDate('01-15-2025'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+});
+
+test('isValidDate rejects impossible dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-04-31'), false);
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('2100-02-29'), false);
+});
+
+test('isValidDate handles leap years correctly', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2025-01-15', 1), '2025-01-16');
+  assert.equal(addDays('2025-01-15', 10), '2025-01-25');
+  assert.equal(addDays('2025-01-15', 365), '2026-01-15');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+  assert.equal(addDays('2025-02-28', 1), '2025-03-01');
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2025-12-31', 365), '2026-12-31');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2025-01-15', -1), '2025-01-14');
+  assert.equal(addDays('2025-01-15', -10), '2025-01-05');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays with zero days', () => {
+  assert.equal(addDays('2025-01-15', 0), '2025-01-15');
+});
+
+test('daysBetween returns positive days for future dates', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-16'), 1);
+  assert.equal(daysBetween('2025-01-15', '2025-01-25'), 10);
+  assert.equal(daysBetween('2025-01-15', '2026-01-15'), 365);
+});
+
+test('daysBetween returns negative days for past dates', () => {
+  assert.equal(daysBetween('2025-01-16', '2025-01-15'), -1);
+  assert.equal(daysBetween('2025-01-25', '2025-01-15'), -10);
+  assert.equal(daysBetween('2026-01-15', '2025-01-15'), -365);
+});
+
+test('daysBetween returns 0 for same dates', () => {
+  assert.equal(daysBetween('2025-01-15', '2025-01-15'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2025-01-31', '2025-02-01'), 1);
+  assert.equal(daysBetween('2025-02-01', '2025-01-31'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+});
+
+test('daysBetween handles leap years correctly', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+});
+
+test('daysBetween calculates large date differences', () => {
+  assert.equal(daysBetween('2020-01-01', '2025-01-01'), 1827);
+  assert.equal(daysBetween('2000-01-01', '2025-01-01'), 9132);
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const date = '2025-01-15';
+  const n = 42;
+
+  const newDate = addDays(date, n);
+  assert.equal(daysBetween(date, newDate), n);
+  assert.equal(daysBetween(newDate, date), -n);
+  assert.equal(addDays(newDate, -n), date);
+});
