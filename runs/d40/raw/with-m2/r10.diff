new file mode 100644
index 0000000..fa2aa17
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,53 @@
+/**
+ * Check if a date string is valid in YYYY-MM-DD format.
+ * @param {string} dateString
+ * @returns {boolean}
+ */
+export function isValidDate(dateString) {
+  // Check format is YYYY-MM-DD
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateString)) return false;
+
+  // Check it's a valid date in UTC
+  const date = new Date(`${dateString}T00:00:00Z`);
+  const [year, month, day] = dateString.split('-').map(Number);
+
+  return (
+    date.getUTCFullYear() === year &&
+    date.getUTCMonth() + 1 === month &&
+    date.getUTCDate() === day
+  );
+}
+
+/**
+ * Add n days to a date string, returning a new date string in YYYY-MM-DD format.
+ * All arithmetic is done in UTC.
+ * @param {string} dateString - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} - New date in YYYY-MM-DD format
+ */
+export function addDays(dateString, n) {
+  const date = new Date(`${dateString}T00:00:00Z`);
+  date.setUTCDate(date.getUTCDate() + n);
+
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a) in UTC.
+ * @param {string} a - Date in YYYY-MM-DD format (start)
+ * @param {string} b - Date in YYYY-MM-DD format (end)
+ * @returns {number} - Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(`${a}T00:00:00Z`);
+  const dateB = new Date(`${b}T00:00:00Z`);
+
+  const diffMs = dateB.getTime() - dateA.getTime();
+  const diffDays = diffMs / (1000 * 60 * 60 * 24);
+
+  return Math.floor(diffDays);
+}
