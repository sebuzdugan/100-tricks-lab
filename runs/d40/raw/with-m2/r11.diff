+  const invoiceTotal = invoiceTotals(issuedInvoice).total;
+
+  const result1 = recordPayment(issuedInvoice, { amount: 5000, date: '2025-10-08' });
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.status, 'partially_paid');
+
+  const result2 = recordPayment(result1.value, { amount: invoiceTotal - 5000, date: '2025-10-09' });
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.status, 'paid');
+  assert.equal(result2.value.payments.length, 2);
+});
