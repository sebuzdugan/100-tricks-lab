+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, invoiceTotals, issueInvoice } from '../src/invoices.js';
+
+test('recordPayment adds a payment to an issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+
+  const result = recordPayment(issuedInvoice, { amount: 5000, date: '2025-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 5000);
+  assert.equal(result.value.payments[0].date, '2025-10-08');
+});
+
+test('recordPayment sets status to partially_paid when balance remains', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+  const invoiceTotal = invoiceTotals(issuedInvoice).total;
+
+  const result = recordPayment(issuedInvoice, { amount: invoiceTotal - 1000, date: '2025-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when balance is zero', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = invoiceResult.value;
+  const issuedResult = issueInvoice(invoice, []);
+  const issuedInvoice = issuedResult.value;
+  const invoiceTotal = invoiceTotals(issuedInvoice).total;
+
+  const result = recordPayment(issuedInvoice, { amount: invoiceTotal, date: '2025-10-08' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment adds payments to partially_paid invoices', () => {
