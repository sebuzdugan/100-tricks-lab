+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, addLine } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+test('statement returns invoices for a valid customer', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const result = statement('C-001', [issued1], '2025-10-10');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+});
+
+test('statement includes invoice number and dates', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    terms: 'NET30',
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const result = statement('C-001', [issued1], '2025-10-10');
+  const invoice = result.value.invoices[0];
+
+  assert.equal(invoice.number, issued1.number);
+  assert.equal(invoice.issueDate, '2025-10-07');
+  assert.equal(invoice.dueDate, '2025-11-06');
+});
+
+test('statement includes total and due amounts', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const result = statement('C-001', [issued1], '2025-10-10');
+  const invoice = result.value.invoices[0];
+  const expectedTotal = invoiceTotals(issued1).total;
+  const expectedDue = balanceDue(issued1);
+
+  assert.equal(invoice.total, expectedTotal);
+  assert.equal(invoice.due, expectedDue);
+});
+
