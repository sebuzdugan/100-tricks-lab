+  for (let i = 0; i < 20; i++) {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: `2025-01-${String(i + 1).padStart(2, '0')}`,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+    const issued = issueInvoice(inv, allInvoices.map((x) => x.number).filter((n) => n)).value;
+    allInvoices.push(issued);
+  }
+
+  const result = statement('C-001', allInvoices, '2025-01-15');
+  assert.equal(result.value.invoices.length, 15);
+  const dueDates = result.value.invoices.map((inv) => inv.issueDate);
+  for (let i = 0; i < dueDates.length - 1; i++) {
+    assert.ok(dueDates[i] <= dueDates[i + 1]);
