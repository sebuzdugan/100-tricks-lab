+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 1000.5, reason: 'Test', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote reports CREDIT_TOO_HIGH when amount exceeds invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: totals.total + 1, reason: 'Too much', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.deepEqual(result, { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote allows amount equal to invoice total', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: totals.total, reason: 'Full refund', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote assigns next CN number for the year', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-08',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2025-0001']).value;
+
+  const existing = ['INV-2025-0001', 'CN-2025-0001', 'INV-2025-0002'];
+  const result1 = createCreditNote(issued1, { amount: 1000, reason: 'Test', date: '2025-10-10' }, existing);
+  const result2 = createCreditNote(issued2, { amount: 1000, reason: 'Test', date: '2025-10-10' }, existing.concat([result1.value.number]));
+
+  assert.equal(result1.value.number, 'CN-2025-0002');
+  assert.equal(result2.value.number, 'CN-2025-0003');
+});
+
+test('createCreditNote uses separate counters for invoices and credit notes', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const existing = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003', 'CN-2025-0001', 'CN-2025-0002'];
+  const result = createCreditNote(issued, { amount: 1000, reason: 'Test', date: '2025-10-10' }, existing);
+
+  assert.equal(result.value.number, 'CN-2025-0003');
+});
+
+test('createCreditNote handles multiple years independently', () => {
+  const inv2024 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2024-12-31',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2024 = issueInvoice(inv2024, []).value;
+
+  const inv2025 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-01-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued2025 = issueInvoice(inv2025, ['INV-2024-0001']).value;
+
+  const existing = ['CN-2024-0005', 'CN-2024-0010'];
+  const result2024 = createCreditNote(issued2024, { amount: 1000, reason: 'Test', date: '2024-12-31' }, existing);
+  const result2025 = createCreditNote(issued2025, { amount: 1000, reason: 'Test', date: '2025-01-02' }, existing.concat([result2024.value.number]));
+
+  assert.equal(result2024.value.number, 'CN-2024-0011');
+  assert.equal(result2025.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote pads counter to 4 digits', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 1000, reason: 'Test', date: '2025-10-10' }, []);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote with large counter', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const existing = Array.from({ length: 9998 }, (_, i) => `CN-2025-${String(i + 1).padStart(4, '0')}`);
+  const result = createCreditNote(issued, { amount: 1000, reason: 'Test', date: '2025-10-10' }, existing);
+  assert.equal(result.value.number, 'CN-2025-9999');
+});
+
+test('createCreditNote reports DATE_INVALID for invalid date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 1000, reason: 'Test', date: '10/07/2025' }, ['INV-2025-0001']);
+  assert.deepEqual(result, { ok: false, error: 'DATE_INVALID' });
+});
+
+test('createCreditNote with small amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 1, reason: 'Penny credit', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, 1);
+});
+
+test('createCreditNote with large amount (but less than invoice total)', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'BRAND-BOOK', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const result = createCreditNote(issued, { amount: totals.total - 1, reason: 'Partial refund', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total - 1);
+});
+
+test('createCreditNote with various reasons', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const reasons = ['Quality issue', 'Damaged in shipping', 'Customer request', 'Discount applied', 'Correction'];
+  for (const reason of reasons) {
+    const result = createCreditNote(issued, { amount: 1000, reason, date: '2025-10-10' }, ['INV-2025-0001']);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.reason, reason);
+  }
+});
+
+test('createCreditNote with different invoice dates', () => {
+  const dates = ['2025-01-15', '2025-06-30', '2025-12-01'];
+  for (const invoiceDate of dates) {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: invoiceDate,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+    const issued = issueInvoice(inv, []).value;
+    const creditDate = invoiceDate.split('-').slice(0, 2).join('-') + '-15';
+
+    const result = createCreditNote(issued, { amount: 1000, reason: 'Test', date: creditDate }, [issued.number]);
+    assert.equal(result.ok, true);
+  }
+});
+
+test('createCreditNote preserves invoice reference', () => {
+  const inv = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 3 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 2000, reason: 'Partial refund', date: '2025-10-10' }, ['INV-2025-0001']);
+  const creditNote = result.value;
+
+  assert.equal(creditNote.invoiceNumber, issued.number);
+  assert.equal(creditNote.customerId, 'C-002');
+});
+
+test('createCreditNote with multiple credit notes per invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+
+  const existing = ['INV-2025-0001'];
+  const result1 = createCreditNote(issued, { amount: 2000, reason: 'First credit', date: '2025-10-10' }, existing);
+  assert.equal(result1.ok, true);
+  assert.equal(result1.value.number, 'CN-2025-0001');
+
+  existing.push(result1.value.number);
+  const result2 = createCreditNote(issued, { amount: 3000, reason: 'Second credit', date: '2025-10-12' }, existing);
+  assert.equal(result2.ok, true);
+  assert.equal(result2.value.number, 'CN-2025-0002');
+
+  existing.push(result2.value.number);
+  const result3 = createCreditNote(issued, { amount: totals.total - 5000, reason: 'Final credit', date: '2025-10-15' }, existing);
+  assert.equal(result3.ok, true);
+  assert.equal(result3.value.number, 'CN-2025-0003');
+});
