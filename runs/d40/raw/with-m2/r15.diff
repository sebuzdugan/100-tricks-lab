+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 1000, reason: 'Quality issue', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote includes correct fields', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 5000, reason: 'Partial refund', date: '2025-10-15' }, ['INV-2025-0001']);
+  const creditNote = result.value;
+
+  assert.equal(creditNote.number, 'CN-2025-0001');
+  assert.equal(creditNote.invoiceNumber, issued.number);
+  assert.equal(creditNote.customerId, 'C-001');
+  assert.equal(creditNote.amount, 5000);
+  assert.equal(creditNote.reason, 'Partial refund');
+  assert.equal(creditNote.date, '2025-10-15');
+});
+
+test('createCreditNote works on partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const partialPaid = recordPayment(issued, { amount: 2000, date: '2025-10-08' }).value;
+
+  const result = createCreditNote(partialPaid, { amount: 1000, reason: 'Adjustment', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2025-0001');
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const totals = invoiceTotals(issued);
+  const paid = recordPayment(issued, { amount: totals.total, date: '2025-10-08' }).value;
+
+  const result = createCreditNote(paid, { amount: 5000, reason: 'Return', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.equal(result.ok, true);
+});
+
+test('createCreditNote reports NOT_ISSUED for draft invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = createCreditNote(inv, { amount: 1000, reason: 'Test', date: '2025-10-10' }, []);
+  assert.deepEqual(result, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for zero amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: 0, reason: 'Test', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for negative amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = createCreditNote(issued, { amount: -1000, reason: 'Test', date: '2025-10-10' }, ['INV-2025-0001']);
+  assert.deepEqual(result, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for non-integer amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
