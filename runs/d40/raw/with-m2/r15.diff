+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.slice(0, 4);
+
+  // Find the maximum counter for this year
+  const pattern = new RegExp(`^CN-${year}-(\\d{4})$`);
+  let maxCounter = 0;
+
+  for (const num of existingNumbers) {
+    const match = pattern.exec(num);
+    if (match) {
+      const counter = parseInt(match[1], 10);
+      maxCounter = Math.max(maxCounter, counter);
+    }
+  }
+
+  const nextCounter = maxCounter + 1;
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note (refund) for an issued invoice.
+ * @param {object} invoice
+ * @param {{ amount: number, reason: string, date: string }}
+ * @param {Array<string>} existingNumbers - Both invoice and credit note numbers already used
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is issued, partially_paid, or paid
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate date
+  if (!isValidDate(date)) return fail('DATE_INVALID');
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  // Check amount is not more than invoice total
+  const invoiceTotal = invoiceTotals(invoice).total;
+  if (amount > invoiceTotal) return fail('CREDIT_TOO_HIGH');
+
+  // Get next credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
