+/**
+ * VAT summary across invoices: base amounts and VAT by rate.
+ * @param {Array<object>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const summary = {};
+
+  for (const inv of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(inv.status)) continue;
+
+    for (const line of inv.lines) {
+      const rate = line.vatRate ?? 0;
+      const total = lineTotal(line);
+      const discount = total * (line.discountPercent ?? 0) / 100;
+      const base = total - discount;
+      const vat = lineVat(line);
+
+      if (!summary[rate]) {
+        summary[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      summary[rate].base += base;
+      summary[rate].vat += vat;
+    }
+  }
+
+  return Object.values(summary).sort((a, b) => b.rate - a.rate);
+}
