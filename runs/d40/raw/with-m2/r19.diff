+  assert.ok(/^\d+\.\d{2}$/.test(fields[6]));
+  assert.ok(/^\d+\.\d{2}$/.test(fields[7]));
+  assert.ok(/^\d+\.\d{2}$/.test(fields[8]));
+  assert.ok(/^\d+\.\d{2}$/.test(fields[9]));
