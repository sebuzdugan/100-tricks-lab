+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('exportCsv returns header and ends with newline', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv includes header', () => {
+  const result = exportCsv([]);
+  assert.ok(result.includes('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'));
+});
+
+test('exportCsv exports single invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  assert.equal(lines.length, 3);
+  assert.ok(lines[1].includes('INV-2025-0001'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+});
+
+test('exportCsv includes all required fields', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const result = exportCsv([issued]);
+  const lines = result.split('\n');
+  const dataLine = lines[1];
+
+  const fields = dataLine.split(',');
+  assert.equal(fields.length, 10);
+  assert.equal(fields[0], 'INV-2025-0001');
+  assert.equal(fields[1], 'Northwind Studio');
+  assert.equal(fields[2], '2025-10-07');
+  assert.equal(fields[3], '2025-11-06');
+  assert.equal(fields[4], 'issued');
+});
+
