+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros string: 123456 -> "1234.56"
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEurosPlain(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a field for CSV: wrap in quotes if needed, double internal quotes.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  if (field.includes(',') || field.includes('"')) {
+    return '"' + field.replace(/"/g, '""') + '"';
+  }
+  return field;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<object>} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data rows
+  for (const inv of invoices) {
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const fields = [
+      inv.number || '',
+      escapeCsvField(inv.customerName || ''),
+      inv.issueDate || '',
+      inv.dueDate || '',
+      inv.status || '',
+      formatEurosPlain(totals.subtotal),
+      formatEurosPlain(totals.discount),
+      formatEurosPlain(totals.vat),
+      formatEurosPlain(totals.total),
+      formatEurosPlain(due),
+    ];
+
+    lines.push(fields.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
