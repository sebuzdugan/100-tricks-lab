--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,48 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert euros to another currency.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const amountInCurrency = (cents / 100) * rate;
+  const centsInCurrency = Math.round(amountInCurrency * 100);
+
+  return ok(centsInCurrency);
+}
+
+/**
+ * Format cents in a specific currency for people: 123456, "USD" -> "$1,234.56", -5, "GBP" -> "-£0.05".
+ * @param {number} cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const symbols = {
+    EUR: '€',
+    USD: '$',
+    GBP: '£',
+  };
+
+  const symbol = symbols[currency] ?? currency;
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const amount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+
+  return `${sign}${symbol}${amount}.${String(abs % 100).padStart(2, '0')}`;
+}
