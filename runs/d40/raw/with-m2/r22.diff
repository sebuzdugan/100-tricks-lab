+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 1250 }), 1250);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 50 }), 5000);
+});
+
+test('lineTotal with zero qty', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 8500 }), 0);
+});
+
+test('lineTotal with large numbers', () => {
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 1000000 }), 1000000000);
+});
+
+test('lineVat calculates VAT on line total', () => {
+  assert.equal(lineVat({ qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 }), 2100);
+  assert.equal(lineVat({ qty: 100, unitPrice: 100, vatRate: 9, discountPercent: 0 }), 900);
+  assert.equal(lineVat({ qty: 5, unitPrice: 2000, vatRate: 0, discountPercent: 0 }), 0);
+});
+
+test('lineVat applies discount before VAT calculation', () => {
+  const line = { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 10 };
+  const lineAmount = 10000;
+  const discountedAmount = lineAmount * 0.9;
+  const expectedVat = Math.round(discountedAmount * 0.21 * 100) / 100;
+  assert.equal(lineVat(line), expectedVat);
+});
+
+test('lineVat rounds per line', () => {
+  const line = { qty: 3, unitPrice: 333, vatRate: 21, discountPercent: 0 };
+  const lineAmount = 999;
+  const vat = lineAmount * 0.21;
+  assert.equal(vat, 209.79);
+  assert.equal(lineVat(line), 210);
+});
+
+test('lineVat with discount and VAT', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: 20 };
+  const lineAmount = 100000;
+  const discountedAmount = 80000;
+  const vat = discountedAmount * 0.21;
+  assert.equal(vat, 16800);
+  assert.equal(lineVat(line), 16800);
+});
+
+test('lineVat with zero VAT rate', () => {
+  assert.equal(lineVat({ qty: 10, unitPrice: 1000, vatRate: 0, discountPercent: 0 }), 0);
+});
+
+test('lineVat with missing discountPercent defaults to 0', () => {
+  assert.equal(lineVat({ qty: 10, unitPrice: 1000, vatRate: 21 }), 2100);
+});
+
+test('lineVat with missing vatRate defaults to 0', () => {
+  assert.equal(lineVat({ qty: 10, unitPrice: 1000 }), 0);
+});
+
+test('lineVat with 100% discount', () => {
+  assert.equal(lineVat({ qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 100 }), 0);
+});
+
+test('invoiceTotals sums line totals and sets total equal to subtotal', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500 },
+      { qty: 3, unitPrice: 9500 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5 * 8500 + 3 * 9500);
+  assert.equal(totals.subtotal, 71000);
+  assert.equal(totals.total, 71000);
+});
+
+test('invoiceTotals works with a single line', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 6000 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 12000);
+  assert.equal(totals.total, 12000);
+});
+
+test('invoiceTotals works with an empty lines array', () => {
+  const invoice = { lines: [] };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals includes vat field', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.total, 12100);
+});
+
+test('invoiceTotals with discount and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 10000);
+  const discountedAmount = 90000;
+  const expectedVat = Math.round(discountedAmount * 0.21 * 100) / 100;
+  assert.equal(totals.vat, expectedVat);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat);
+});
+
+test('invoiceTotals with multiple VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+      { qty: 100, unitPrice: 100, vatRate: 9, discountPercent: 0 },
+      { qty: 5, unitPrice: 2000, vatRate: 0, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000 + 10000 + 10000);
+  assert.equal(totals.subtotal, 30000);
+  assert.equal(totals.vat, 2100 + 900 + 0);
+  assert.equal(totals.vat, 3000);
+  assert.equal(totals.total, 33000);
+});
+
+test('invoiceTotals sums per-line VAT correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 3, unitPrice: 333, vatRate: 21, discountPercent: 0 },
+      { qty: 3, unitPrice: 333, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  const line1Vat = lineVat(invoice.lines[0]);
+  const line2Vat = lineVat(invoice.lines[1]);
+  assert.equal(totals.vat, line1Vat + line2Vat);
+});
+
+test('invoiceTotals with discount and mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 10 },
+      { qty: 5, unitPrice: 1000, vatRate: 9, discountPercent: 5 },
+      { qty: 2, unitPrice: 1000, vatRate: 0, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  const line1Vat = lineVat(invoice.lines[0]);
+  const line2Vat = lineVat(invoice.lines[1]);
+  const line3Vat = lineVat(invoice.lines[2]);
+  assert.equal(totals.vat, line1Vat + line2Vat + line3Vat);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat);
+});
+
+test('invoiceTotals clamps negative total to 0', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 100, vatRate: 0, discountPercent: 100 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals calculates discount correctly', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 10 },
+      { qty: 5, unitPrice: 2000, discountPercent: 20 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10 * 1000 + 5 * 2000);
+  assert.equal(totals.subtotal, 20000);
+  assert.equal(totals.discount, (10 * 1000 * 10 / 100) + (5 * 2000 * 20 / 100));
+  assert.equal(totals.discount, 3000);
+  assert.equal(totals.total, 17000);
+});
+
+test('invoiceTotals includes discount field when discountPercent is 0', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 1000, discountPercent: 0 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 5000);
+});
+
+test('invoiceTotals handles 100% discount', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 100 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 10000);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals handles mixed discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 10 },
+      { qty: 3, unitPrice: 9500, discountPercent: 5 },
+      { qty: 2, unitPrice: 6000, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  const line1Total = 5 * 8500;
+  const line2Total = 3 * 9500;
+  const line3Total = 2 * 6000;
+  const expectedSubtotal = line1Total + line2Total + line3Total;
+  const expectedDiscount = (line1Total * 10 / 100) + (line2Total * 5 / 100) + (line3Total * 0 / 100);
+  const expectedTotal = expectedSubtotal - expectedDiscount;
+
+  assert.equal(totals.subtotal, expectedSubtotal);
+  assert.equal(totals.discount, expectedDiscount);
+  assert.equal(totals.total, expectedTotal);
+});
+
+test('invoiceTotals includes voucher field', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals subtracts voucher from total', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 5 }],
+    voucher: { code: 'PROMO10', amount: 1000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  const withoutVoucher = invoiceTotals({ lines: invoice.lines });
+  assert.equal(totals.voucher, 1000);
+  assert.equal(totals.total, withoutVoucher.total - 1000);
+});
+
+test('invoiceTotals clamps negative total to 0 with large voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 50, vatRate: 21, discountPercent: 0 }],
+    voucher: { code: 'MEGA', amount: 10000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with voucher and discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 5 }],
+    voucher: { code: 'PROMO', amount: 1000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 1000);
+  const expectedTotal = totals.subtotal - totals.discount + totals.vat - 1000;
+  assert.equal(totals.total, Math.max(0, expectedTotal));
+});
+
+test('invoiceTotals with multiple line items and voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 5 },
+      { qty: 3, unitPrice: 9500, vatRate: 21, discountPercent: 0 },
+      { qty: 2, unitPrice: 6000, vatRate: 21, discountPercent: 0 },
+    ],
+    voucher: { code: 'THANKS', amount: 5000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 5000);
+  const expectedSubtotal = (5 * 8500) + (3 * 9500) + (2 * 6000);
+  assert.equal(totals.subtotal, expectedSubtotal);
+});
+
+test('invoiceTotals returns correct structure', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 }],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.ok(totals.hasOwnProperty('subtotal'));
+  assert.ok(totals.hasOwnProperty('discount'));
+  assert.ok(totals.hasOwnProperty('vat'));
+  assert.ok(totals.hasOwnProperty('voucher'));
+  assert.ok(totals.hasOwnProperty('total'));
+
+  assert.equal(typeof totals.subtotal, 'number');
+  assert.equal(typeof totals.discount, 'number');
+  assert.equal(typeof totals.vat, 'number');
+  assert.equal(typeof totals.voucher, 'number');
+  assert.equal(typeof totals.total, 'number');
+});
+
+test('invoiceTotals does not mutate input invoice', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 }],
+  };
+  const originalLines = invoice.lines;
+
+  invoiceTotals(invoice);
+
+  assert.equal(invoice.lines, originalLines);
+});
+
+test('invoiceTotals with large numbers', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000000);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.total, totals.subtotal + totals.vat);
+});
+
+test('invoiceTotals with small amounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 5, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 50);
+  assert.ok(totals.vat > 0);
+});
+
+test('lineVat uses roundCents for rounding', () => {
+  const line = { qty: 3, unitPrice: 100, vatRate: 21, discountPercent: 0 };
+  const vat = lineVat(line);
+  assert.ok(Number.isInteger(vat));
+});
+
+test('lineTotal with decimal calculation precision', () => {
+  const line = { qty: 7, unitPrice: 3, vatRate: 0, discountPercent: 0 };
+  assert.equal(lineTotal(line), 21);
+});
+
+test('invoiceTotals preserves all fields in order', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 10 },
+    ],
+    voucher: { code: 'TEST', amount: 500 },
+  };
+
+  const totals = invoiceTotals(invoice);
+  const keys = Object.keys(totals);
+  assert.ok(keys.indexOf('subtotal') < keys.indexOf('discount'));
+  assert.ok(keys.indexOf('discount') < keys.indexOf('vat'));
+  assert.ok(keys.indexOf('vat') < keys.indexOf('voucher'));
+  assert.ok(keys.indexOf('voucher') < keys.indexOf('total'));
+});
+
+test('lineVat handles fractional discount percentages', () => {
+  const line = { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 12.5 };
+  const result = lineVat(line);
+  assert.ok(Number.isInteger(result));
+  assert.ok(result > 0);
+});
+
+test('invoiceTotals with zero-VAT lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 6000, vatRate: 0, discountPercent: 0 },
+      { qty: 10, unitPrice: 1000, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.vat, 2100);
+  assert.equal(totals.total, 30000 + 10000 + 2100);
+});
