 /**
  * Calculate invoice totals: subtotal, discount, vat, voucher, and total.
+ * Discount includes line/tier discount plus 2.5% bulk discount for qty >= 10.
  * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { code: string, amount: number } }}
  * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
-  const discount = invoice.lines.reduce((sum, line) => {
+  const discount = roundCents(invoice.lines.reduce((sum, line) => {
     const lineTotalAmount = lineTotal(line);
     const lineDiscount = lineTotalAmount * (line.discountPercent ?? 0) / 100;
-    return sum + lineDiscount;
-  }, 0);
+    const bulkDiscount = line.qty >= 10 ? (lineTotalAmount - lineDiscount) * 0.025 : 0;
+    return sum + lineDiscount + bulkDiscount;
+  }, 0));
   const vat = invoice.lines.reduce((sum, line) => sum + lineVat(line), 0);
   const voucher = invoice.voucher?.amount ?? 0;
   const total = Math.max(0, subtotal - discount + vat - voucher);
