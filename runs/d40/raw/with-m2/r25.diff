+test('renderInvoiceText shows order: invoice, customer, lines, VAT, voucher, total, due, paid', () => {
+  const invoice = {
+    number: 'INV-2025-0001',
+    status: 'partially_paid',
+    customerName: 'Customer',
+    issueDate: '2025-10-07',
+    dueDate: '2025-11-06',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21, discountPercent: 0 },
+    ],
+    voucher: { code: 'PROMO', amount: 100 },
+    payments: [{ amount: 1000, date: '2025-10-08' }],
+  };
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  const invoiceIndex = 0;
+  const customerIndex = 1;
+  const lineIndex = 2;
+  const vatIndex = lines.findIndex(l => l.startsWith('VAT:'));
+  const voucherIndex = lines.findIndex(l => l.startsWith('Voucher:'));
+  const totalIndex = lines.findIndex(l => l.startsWith('Total:'));
+  const dueIndex = lines.findIndex(l => l.startsWith('Due:'));
+  const paidIndex = lines.findIndex(l => l.startsWith('Paid:'));
+
+  assert.ok(invoiceIndex < customerIndex);
+  assert.ok(customerIndex < lineIndex);
+  assert.ok(lineIndex < vatIndex);
+  assert.ok(vatIndex < voucherIndex);
+  assert.ok(voucherIndex < totalIndex);
+  assert.ok(totalIndex < dueIndex);
+  assert.ok(dueIndex < paidIndex);
+});
