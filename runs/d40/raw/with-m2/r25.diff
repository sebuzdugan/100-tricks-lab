 /**
  * Render an invoice as plain text.
@@ -16,12 +17,20 @@ export function renderInvoiceText(invoice) {
   // Customer name
   lines.push(invoice.customerName);
 
-  // Line items
+  // Line items with discounts
   for (const line of invoice.lines) {
     const total = lineTotal(line);
     const unitPriceStr = formatEuros(line.unitPrice);
     const totalStr = formatEuros(total);
-    lines.push(`${line.qty}x ${line.name} ${unitPriceStr} = ${totalStr}`);
+    let lineStr = `${line.qty}x ${line.name} ${unitPriceStr} = ${totalStr}`;
+
+    if (line.discountPercent > 0) {
+      const discount = total * (line.discountPercent / 100);
+      const discountStr = formatEuros(discount);
+      lineStr += ` (${line.discountPercent}% off: ${discountStr})`;
+    }
+
+    lines.push(lineStr);
   }
 
   // Calculate totals
@@ -33,9 +42,27 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${vatStr}`);
   }
 
+  // Voucher line (if any)
+  if (totals.voucher > 0) {
+    const voucherStr = formatEuros(totals.voucher);
+    lines.push(`Voucher: ${voucherStr}`);
+  }
+
   // Total
   const totalStr = formatEuros(totals.total);
   lines.push(`Total: ${totalStr}`);
 
+  // Due date (if invoice has one)
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid amount (if there are payments)
+  if (invoice.payments && invoice.payments.length > 0) {
+    const paid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const paidStr = formatEuros(paid);
+    lines.push(`Paid: ${paidStr}`);
+  }
+
   return lines.join('\n');
 }
