+++ b/src/invoices.js
@@ -0,0 +1,53 @@
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Create a new draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customer = getCustomer(customerId);
+  if (!customer.ok) return customer;
+
+  // Validate issueDate is in YYYY-MM-DD format and is a real date
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate ?? '')) return fail('DATE_INVALID');
+  const [year, month, day] = issueDate.split('-').map(Number);
+  const date = new Date(year, month - 1, day);
+  if (date.getFullYear() !== year || date.getMonth() + 1 !== month || date.getDate() !== day) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines is a non-empty array
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Validate and enrich each line
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Get product and enrich line
+    const product = getProduct(line.sku);
+    if (!product.ok) return product;
+
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.value.name,
+      qty: line.qty,
+      unitPrice: product.value.unitPrice,
+      vatRate: product.value.vatRate,
+    });
+  }
+
+  const invoice = {
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  };
+
+  return ok(invoice);
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..173451a
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,146 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.issueDate, '2026-10-07');
+  assert.equal(r.value.status, 'draft');
+  assert.equal(r.value.lines.length, 1);
+  assert.equal(r.value.lines[0].sku, 'DES-HOUR');
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[0].qty, 5);
+  assert.equal(r.value.lines[0].unitPrice, 8500);
+  assert.equal(r.value.lines[0].vatRate, 21);
+});
+
+test('createInvoice enriches multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[0].name, 'Design work (hour)');
+  assert.equal(r.value.lines[1].name, 'Logo package');
+});
+
+test('createInvoice rejects an unknown customer', () => {
+  const r = createInvoice({
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('createInvoice validates date format', () => {
+  const cases = [
+    '2026-13-01', // invalid month
+    '2026-02-30', // invalid day
+    '2026-2-01', // missing leading zero
+    'not-a-date',
+    '2026/10/07',
+    undefined,
+  ];
+  for (const issueDate of cases) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' }, `should reject ${issueDate}`);
+  }
+});
+
+test('createInvoice accepts valid dates', () => {
+  const cases = ['2026-01-01', '2026-12-31', '2000-02-29'];
+  for (const issueDate of cases) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+    assert.equal(r.ok, true, `should accept ${issueDate}`);
+  }
+});
+
+test('createInvoice rejects an empty lines array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [],
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice rejects non-array lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: null,
+  });
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('createInvoice validates line quantities', () => {
+  const cases = [
+    { qty: 0 },
+    { qty: -1 },
+    { qty: 1.5 },
+    { qty: '5' },
+    { qty: null },
+  ];
+  for (const line of cases) {
+    const r = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', ...line }],
+    });
+    assert.deepEqual(r, { ok: false, error: 'QTY_INVALID' }, `should reject qty=${line.qty}`);
+  }
+});
+
+test('createInvoice rejects unknown SKUs', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'NOPE', qty: 1 }],
+  });
+  assert.deepEqual(r, { ok: false, error: 'UNKNOWN_SKU' });
+});
+
+test('createInvoice does not mutate input lines', () => {
+  const input = [{ sku: 'DES-HOUR', qty: 1 }];
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: input,
+  });
+  assert.deepEqual(input, [{ sku: 'DES-HOUR', qty: 1 }]);
+});
+
+test('createInvoice returns a new object', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.notStrictEqual(r1.value, r2.value);
+  assert.notStrictEqual(r1.value.lines, r2.value.lines);
+});
