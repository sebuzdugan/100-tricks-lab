+/**
+ * Add or increment a line on a draft invoice.
+ * @param {object} invoice
+ * @param {{ sku: string, qty: number }}
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Validate invoice is draft
+  if (!invoice || invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Get product
+  const product = getProduct(sku);
+  if (!product.ok) return product;
+
+  // Check if line with this SKU already exists
+  const existingLine = invoice.lines.find((l) => l.sku === sku);
+  const newLines = existingLine
+    ? invoice.lines.map((l) =>
+        l.sku === sku
+          ? {
+              ...l,
+              qty: l.qty + qty,
+            }
+          : l
+      )
+    : [
+        ...invoice.lines,
+        {
+          sku,
+          name: product.value.name,
+          qty,
+          unitPrice: product.value.unitPrice,
+          vatRate: product.value.vatRate,
+        },
+      ];
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
+
+/**
+ * Remove a line from a draft invoice.
+ * @param {object} invoice
+ * @param {string} sku
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function removeLine(invoice, sku) {
+  // Validate invoice is draft
+  if (!invoice || invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Find the line
+  const lineIndex = invoice.lines.findIndex((l) => l.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  // Check if this is the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Remove the line
+  const newLines = invoice.lines.filter((l) => l.sku !== sku);
+
+  return ok({
+    ...invoice,
+    lines: newLines,
+  });
+}
