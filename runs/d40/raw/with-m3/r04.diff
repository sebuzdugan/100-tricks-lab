@@ -0,0 +1,37 @@
+import { ok, fail } from './result.js';
+
+/**
+ * Calculate the next invoice number for a given date.
+ * Format: INV-<year>-<counter> where counter is 4 digits, restarting each year.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  // Validate date format and reality
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(issueDate ?? '')) return fail('DATE_INVALID');
+  const [year, month, day] = issueDate.split('-').map(Number);
+  const date = new Date(year, month - 1, day);
+  if (date.getFullYear() !== year || date.getMonth() + 1 !== month || date.getDate() !== day) {
+    return fail('DATE_INVALID');
+  }
+
+  // Find all numbers for this year
+  const pattern = new RegExp(`^INV-${year}-(\\d{4})$`);
+  const yearCounters = existingNumbers
+    .filter((num) => pattern.test(num))
+    .map((num) => {
+      const match = pattern.exec(num);
+      return parseInt(match[1], 10);
+    });
+
+  // Find the next counter
+  const maxCounter = yearCounters.length === 0 ? 0 : Math.max(...yearCounters);
+  const nextCounter = maxCounter + 1;
+
+  // Validate counter doesn't exceed 9999
+  if (nextCounter > 9999) return fail('TOO_MANY_INVOICES');
+
+  const number = `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+  return ok(number);
+}
