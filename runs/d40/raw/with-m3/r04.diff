diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..9164c0c
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,84 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber returns the first invoice of a year', () => {
+  const r = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter for subsequent invoices', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const r = nextInvoiceNumber(existing, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existing = ['INV-2026-0003', 'INV-2026-0001', 'INV-2026-0002'];
+  const r = nextInvoiceNumber(existing, '2026-11-01');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber restarts counter for a new year', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0099'];
+  const r = nextInvoiceNumber(existing, '2027-01-01');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber handles multiple years correctly', () => {
+  const existing = [
+    'INV-2025-0010',
+    'INV-2026-0005',
+    'INV-2026-0003',
+    'INV-2027-0001',
+  ];
+  const r = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = ['INV-2026-0001'];
+  const r = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles large counters', () => {
+  const existing = Array.from({ length: 500 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0501');
+});
+
+test('nextInvoiceNumber validates date format', () => {
+  const cases = ['2026-13-01', '2026-02-30', '2026/10/07', 'not-a-date', undefined];
+  for (const date of cases) {
+    const r = nextInvoiceNumber([], date);
+    assert.deepEqual(r, { ok: false, error: 'DATE_INVALID' }, `should reject ${date}`);
+  }
+});
+
+test('nextInvoiceNumber rejects when counter exceeds 9999', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `INV-2026-${String(i + 1).padStart(4, '0')}`);
+  const r = nextInvoiceNumber(existing, '2026-12-31');
+  assert.deepEqual(r, { ok: false, error: 'TOO_MANY_INVOICES' });
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-9999', 'INV-2026-0001', 'INV-2027-0001'];
+  const r = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2026-0001', 'INVALID', 'INV-2026-ABC', 'INV-2026'];
+  const r = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 'INV-2026-0002');
+});
