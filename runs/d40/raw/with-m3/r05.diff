@@ -0,0 +1,203 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice with DRAFT label', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.ok(text.startsWith('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+  assert.ok(text.includes('Design work (hour)'));
+  assert.ok(text.includes('Total:'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+  const r = renderInvoiceText(issued.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.ok(text.startsWith('INV-2026-0001'));
+});
+
+test('renderInvoiceText shows invoice number first line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(invoice.ok, true);
+  const issued = issueInvoice(invoice.value, ['INV-2026-0001']);
+  assert.equal(issued.ok, true);
+  const r = renderInvoiceText(issued.value);
+  assert.equal(r.ok, true);
+  const lines = r.value.split('\n');
+  assert.equal(lines[0], 'INV-2026-0002');
+});
+
+test('renderInvoiceText shows customer name on second line', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.equal(invoice.ok, true);
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const lines = r.value.split('\n');
+  assert.equal(lines[1], 'Kite & Co');
+});
+
+test('renderInvoiceText formats amounts with formatEuros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  assert.ok(text.includes('€85.00')); // unitPrice 8500 cents
+  assert.ok(text.includes('€425.00')); // 5 * 8500 = 42500 cents
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'ICON-SET', qty: 5 },
+    ],
+  });
+  assert.equal(invoice.ok, true);
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const lines = r.value.split('\n');
+  // Line 0: DRAFT, Line 1: customer, Lines 2-4: items, Line 5: Total
+  assert.equal(lines.length, 6);
+  assert.ok(lines[2].includes('Design work (hour)'));
+  assert.ok(lines[3].includes('Logo package'));
+  assert.ok(lines[4].includes('Icon set (24 icons)'));
+});
+
+test('renderInvoiceText shows qty, name, unit price and line total per item', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const lines = r.value.split('\n');
+  const itemLine = lines[2]; // After DRAFT and customer name
+  assert.ok(itemLine.includes('5x')); // quantity
+  assert.ok(itemLine.includes('Design work (hour)')); // product name
+  assert.ok(itemLine.includes('€85.00')); // unit price
+  assert.ok(itemLine.includes('€425.00')); // line total
+});
+
+test('renderInvoiceText shows correct total', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  assert.equal(invoice.ok, true);
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  // 3 * 8500 + 1 * 120000 = 25500 + 120000 = 145500 cents = €1,455.00
+  assert.ok(text.includes('Total: €1,455.00'));
+});
+
+test('renderInvoiceText rejects null invoice', () => {
+  const r = renderInvoiceText(null);
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('renderInvoiceText rejects invoice with missing customerId', () => {
+  const invoice = {
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+  const r = renderInvoiceText(invoice);
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('renderInvoiceText rejects invoice with unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+  const r = renderInvoiceText(invoice);
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('renderInvoiceText propagates invoiceTotals errors', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [],
+  };
+  const r = renderInvoiceText(invoice);
+  assert.deepEqual(r, { ok: false, error: 'NO_LINES' });
+});
+
+test('renderInvoiceText formats small amounts correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 3 }],
+  });
+  assert.equal(invoice.ok, true);
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const text = r.value;
+  // unitPrice 50 cents = €0.50, total 150 = €1.50
+  assert.ok(text.includes('€0.50'));
+  assert.ok(text.includes('€1.50'));
+});
+
+test('renderInvoiceText preserves line structure across different products', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 10 },
+      { sku: 'FONT-LIC', qty: 2 },
+    ],
+  });
+  assert.equal(invoice.ok, true);
+  const r = renderInvoiceText(invoice.value);
+  assert.equal(r.ok, true);
+  const lines = r.value.split('\n');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.ok(lines[2].includes('Development (hour)'));
+  assert.ok(lines[3].includes('Font licence'));
+  assert.ok(lines[4].startsWith('Total:'));
+});
