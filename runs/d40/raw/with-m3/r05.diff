+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { formatEuros } from './money.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Render an invoice as plain text for display to customers.
+ * @param {object} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  // Validate invoice
+  if (!invoice || !invoice.customerId) return fail('CUSTOMER_NOT_FOUND');
+
+  // Get customer
+  const customer = getCustomer(invoice.customerId);
+  if (!customer.ok) return customer;
+
+  // Calculate totals
+  const totals = invoiceTotals(invoice);
+  if (!totals.ok) return totals;
+
+  // Build invoice text
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  lines.push(invoice.number ? invoice.number : 'DRAFT');
+
+  // Customer name
+  lines.push(customer.value.name);
+
+  // Line items
+  for (const line of invoice.lines) {
+    const total = line.qty * line.unitPrice;
+    lines.push(
+      `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`
+    );
+  }
+
+  // Total
+  lines.push(`Total: ${formatEuros(totals.value.total)}`);
+
+  return ok(lines.join('\n'));
+}
diff --git a/test/render.test.js b/test/render.test.js
