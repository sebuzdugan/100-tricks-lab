+ * Calculate subtotal, discount, VAT and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }}
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, total: number } } | { ok: false, error: string }}
  */
 export function invoiceTotals(invoice) {
   if (!invoice || !Array.isArray(invoice.lines) || invoice.lines.length === 0) return fail('NO_LINES');
 
   let subtotal = 0;
   let totalDiscount = 0;
+  let totalVat = 0;
 
   for (const line of invoice.lines) {
     const lt = lineTotal(line);
     if (!lt.ok) return lt;
     subtotal += lt.value;
 
+    let lineDiscount = 0;
     if (line.discountPercent !== undefined && line.discountPercent !== null) {
-      const lineDiscount = Math.max(0, line.discountPercent / 100 * lt.value);
+      lineDiscount = Math.max(0, line.discountPercent / 100 * lt.value);
       totalDiscount += lineDiscount;
     }
+
+    const discountedAmount = Math.max(0, lt.value - lineDiscount);
+    if (line.vatRate && line.vatRate > 0) {
+      const lineVat = roundCents(discountedAmount * (line.vatRate / 100));
+      totalVat += Math.max(0, lineVat);
+    }
   }
 
-  const total = Math.max(0, subtotal - totalDiscount);
-  return ok({ subtotal, discount: Math.max(0, totalDiscount), total });
+  const total = Math.max(0, subtotal - totalDiscount + totalVat);
+  return ok({ subtotal, discount: Math.max(0, totalDiscount), vat: Math.max(0, totalVat), total });
 }
 
