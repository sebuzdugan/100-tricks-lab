+import { invoiceTotals } from './invoices.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Calculate the amount still owed on an invoice after payments.
+ * @param {object} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  if (!invoice) return 0;
+
+  const totals = invoiceTotals(invoice);
+  if (!totals.ok) return 0;
+
+  const totalAmount = totals.value.total;
+  const payments = invoice.payments || [];
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+
+  return Math.max(0, totalAmount - totalPaid);
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {object} invoice
+ * @param {{ amount: number, date: string }}
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate invoice is issued or partially_paid
+  if (!invoice || (invoice.status !== 'issued' && invoice.status !== 'partially_paid')) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Get invoice totals
+  const totals = invoiceTotals(invoice);
+  if (!totals.ok) return totals;
+
+  const totalAmount = totals.value.total;
+  const payments = invoice.payments || [];
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  const balance = totalAmount - totalPaid;
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Create new invoice with payment added
+  const newTotalPaid = totalPaid + amount;
+  const newStatus = newTotalPaid >= totalAmount ? 'paid' : 'partially_paid';
+
+  const newInvoice = {
+    ...invoice,
+    payments: [...payments, { amount, date }],
+    status: newStatus,
+  };
+
+  return ok(newInvoice);
+}
