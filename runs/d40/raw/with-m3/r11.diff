+  const payment2 = Math.floor(totals.value.total * 0.4);
+  const r1 = recordPayment(issued.value, { amount: payment1, date: '2026-10-10' });
+  assert.equal(r1.ok, true);
+  const r2 = recordPayment(r1.value, { amount: payment2, date: '2026-10-15' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.payments.length, 2);
+  assert.equal(r2.value.payments[0].amount, payment1);
+  assert.equal(r2.value.payments[1].amount, payment2);
