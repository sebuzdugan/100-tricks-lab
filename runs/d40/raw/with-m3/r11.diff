+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('recordPayment records a payment on an issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+  const totals = invoiceTotals(issued.value);
+  assert.equal(totals.ok, true);
+  const payment = Math.floor(totals.value.total * 0.5);
+  const r = recordPayment(issued.value, { amount: payment, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+  assert.equal(r.value.payments[0].amount, payment);
+  assert.equal(r.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment sets status to partially_paid when balance remains', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+  const totals = invoiceTotals(issued.value);
+  assert.equal(totals.ok, true);
+  const payment = Math.floor(totals.value.total * 0.5);
+  const r = recordPayment(issued.value, { amount: payment, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when payment covers full amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  assert.equal(invoice.ok, true);
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+  const totals = invoiceTotals(issued.value);
+  assert.equal(totals.ok, true);
+  const r = recordPayment(issued.value, { amount: totals.value.total, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.status, 'paid');
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    lines: [{ sku: 'DES-HOUR', qty: 1, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+  const r = recordPayment(invoice, { amount: 5000, date: '2026-10-10' });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.payments.length, 1);
+});
+
+test('recordPayment adds payments without mutating original', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+  const issued = issueInvoice(invoice.value, []);
+  assert.equal(issued.ok, true);
+  const original = JSON.parse(JSON.stringify(issued.value));
+  recordPayment(issued.value, { amount: 50000, date: '2026-10-10' });
+  assert.deepEqual(issued.value, original);
+});
+
+test('recordPayment accepts multiple payments', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
