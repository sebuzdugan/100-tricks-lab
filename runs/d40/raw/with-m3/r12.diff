@@ -40,3 +40,22 @@ export function daysBetween(a, b) {
   const diffMs = dateB - dateA;
   return Math.floor(diffMs / (1000 * 60 * 60 * 24));
 }
+
+/**
+ * Calculate the due date for an invoice based on terms.
+ * @param {string} issueDate (YYYY-MM-DD format)
+ * @param {string} terms ('NET14', 'NET30', or 'EOM')
+ * @returns {string} due date (YYYY-MM-DD format)
+ */
+export function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') return addDays(issueDate, 14);
+  if (terms === 'NET30') return addDays(issueDate, 30);
+  if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-').map(Number);
+    const nextMonth = month === 12 ? 1 : month + 1;
+    const nextYear = month === 12 ? year + 1 : year;
+    const firstDayOfNextMonth = `${nextYear}-${String(nextMonth).padStart(2, '0')}-01`;
+    return addDays(firstDayOfNextMonth, -1);
+  }
+  return null;
+}
