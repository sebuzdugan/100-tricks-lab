+/**
+ * Apply a voucher to a draft invoice.
+ * @param {object} invoice
+ * @param {{ code: string, amount: number }}
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Validate invoice is draft
+  if (!invoice || invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate voucher doesn't already exist
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  const newInvoice = {
+    ...invoice,
+    voucher: { code, amount },
+  };
+
+  return ok(newInvoice);
+}
