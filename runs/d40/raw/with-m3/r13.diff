+test('applyVoucher applies a voucher to a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+  const r = applyVoucher(invoice.value, { code: 'SAVE10', amount: 1000 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.voucher.code, 'SAVE10');
+  assert.equal(r.value.voucher.amount, 1000);
+});
+
+test('applyVoucher does not mutate the original invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(invoice.ok, true);
+  const original = JSON.parse(JSON.stringify(invoice.value));
+  applyVoucher(invoice.value, { code: 'SAVE10', amount: 1000 });
+  assert.deepEqual(invoice.value, original);
+});
