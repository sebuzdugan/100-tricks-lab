+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Generate a customer statement for a given date.
+ * @param {string} customerId
+ * @param {Array<object>} invoices
+ * @param {string} asOf (YYYY-MM-DD format)
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists
+  const customer = getCustomer(customerId);
+  if (!customer.ok) return customer;
+
+  // Filter invoices for this customer with appropriate statuses and dates
+  const relevantInvoices = (invoices || [])
+    .filter((inv) => inv.customerId === customer.value.id)
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .filter((inv) => inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Build statement invoices with calculated due amounts
+  const statementInvoices = relevantInvoices.map((inv) => {
+    const totals = invoiceTotals(inv);
+    const due = totals.ok ? balanceDue(inv) : 0;
+    return {
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: totals.ok ? totals.value.total : 0,
+      due,
+    };
+  });
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: customer.value.id,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
