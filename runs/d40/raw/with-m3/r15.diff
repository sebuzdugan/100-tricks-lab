+import { invoiceTotals } from './invoices.js';
+import { isValidDate } from './dates.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Calculate the next credit note number for a given date.
+ * Format: CN-<year>-<counter> where counter is 4 digits, restarting each year.
+ * @param {Array<string>} existingNumbers
+ * @param {string} issueDate
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  // Validate date format and reality
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  const year = parseInt(issueDate.split('-')[0], 10);
+
+  // Find all credit note numbers for this year
+  const pattern = new RegExp(`^CN-${year}-(\\d{4})$`);
+  const yearCounters = (existingNumbers || [])
+    .filter((num) => pattern.test(num))
+    .map((num) => {
+      const match = pattern.exec(num);
+      return parseInt(match[1], 10);
+    });
+
+  // Find the next counter
+  const maxCounter = yearCounters.length === 0 ? 0 : Math.max(...yearCounters);
+  const nextCounter = maxCounter + 1;
+
+  // Validate counter doesn't exceed 9999
+  if (nextCounter > 9999) return fail('TOO_MANY_INVOICES');
+
+  const number = `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+  return ok(number);
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {object} invoice
+ * @param {{ amount: number, reason: string, date: string }}
+ * @param {Array<string>} existingNumbers
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice is issued, partially_paid, or paid
+  if (!invoice || !['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Validate date format
+  if (!isValidDate(date)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Get invoice total to validate credit amount
+  const totals = invoiceTotals(invoice);
+  if (!totals.ok) return totals;
+
+  // Validate credit amount doesn't exceed invoice total
+  if (amount > totals.value.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Get next credit note number
+  const numberResult = nextCreditNoteNumber(existingNumbers, date);
+  if (!numberResult.ok) return numberResult;
+
+  const creditNote = {
+    number: numberResult.value,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  };
+
+  return ok(creditNote);
+}
