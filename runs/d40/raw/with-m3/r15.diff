+  });
+  const issued = issueInvoice(invoice.value, []);
+  const totals = invoiceTotals(issued.value);
+  const partialCredit = Math.floor(totals.value.total / 2);
+  const r = createCreditNote(issued.value, { amount: partialCredit, reason: 'Partial refund', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.amount, partialCredit);
+  assert.ok(r.value.amount < totals.value.total);
