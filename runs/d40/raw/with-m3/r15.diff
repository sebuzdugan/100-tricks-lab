+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = createCreditNote(issued.value, { amount: 50, reason: 'Damaged goods', date: '2026-10-10' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+  assert.equal(r.value.invoiceNumber, issued.value.number);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.amount, 50);
+  assert.equal(r.value.reason, 'Damaged goods');
+  assert.equal(r.value.date, '2026-10-10');
+});
+
+test('createCreditNote works on partially_paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 5 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const partial = recordPayment(issued.value, { amount: 30, date: '2026-10-10' });
+  const r = createCreditNote(partial.value, { amount: 50, reason: 'Partial refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.value.total, date: '2026-10-10' });
+  const r = createCreditNote(paid.value, { amount: 50, reason: 'Overpayment refund', date: '2026-10-15' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const r = createCreditNote(invoice.value, { amount: 50, reason: 'Refund', date: '2026-10-10' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects null/invalid invoice', () => {
+  const r = createCreditNote(null, { amount: 50, reason: 'Refund', date: '2026-10-10' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote rejects zero amount', () => {
