+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Invoices overdue as of a date, sorted by days overdue (most first).
+ * @param {Array<object>} invoices
+ * @param {string} asOf (YYYY-MM-DD format)
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = (invoices || [])
+    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .filter((inv) => inv.dueDate < asOf)
+    .map((inv) => {
+      const due = balanceDue(inv);
+      const daysOverdue = daysBetween(inv.dueDate, asOf);
+      return {
+        number: inv.number,
+        customerId: inv.customerId,
+        dueDate: inv.dueDate,
+        daysOverdue,
+        due,
+      };
+    })
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
