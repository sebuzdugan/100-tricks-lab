+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices returns empty array for null invoices', () => {
+  const r = overdueInvoices(null, '2026-10-31');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices returns empty array for empty invoices', () => {
+  const r = overdueInvoices([], '2026-10-31');
+  assert.deepEqual(r, []);
+});
+
+test('overdueInvoices excludes draft invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+    terms: 'NET14',
+  });
+  const r = overdueInvoices([invoice.value], '2026-11-01');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices excludes paid invoices', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.value.total, date: '2026-10-10' });
+  const r = overdueInvoices([paid.value], '2026-11-01');
+  assert.equal(r.length, 0);
+});
+
+test('overdueInvoices includes issued invoices past due date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = overdueInvoices([issued.value], '2026-10-22');
+  assert.equal(r.length, 1);
+  assert.equal(r[0].number, issued.value.number);
+  assert.equal(r[0].customerId, 'C-001');
+  assert.equal(r[0].dueDate, '2026-10-21');
+});
+
