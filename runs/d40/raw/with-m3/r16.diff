+      customerId: `C-${String(i % 5).padStart(3, '0')}`,
+      issueDate: `2026-10-${String(day).padStart(2, '0')}`,
+      lines: [{ sku: 'STICKER', qty: 1 }],
+      terms: 'NET14',
+    });
+    return issueInvoice(invoice.value, []);
+  }).filter((inv) => inv.ok).map((inv) => inv.value);
+  const r = overdueInvoices(invoices, '2026-11-30');
+  assert.ok(r.length > 0);
+  for (let i = 1; i < r.length; i++) {
+    assert.ok(r[i - 1].daysOverdue >= r[i].daysOverdue);
+  }
+});
