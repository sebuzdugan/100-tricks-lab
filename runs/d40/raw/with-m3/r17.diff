@@ -26,3 +27,39 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * VAT summary across invoices, grouped by rate.
+ * @param {Array<object>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  for (const invoice of (invoices || [])) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) continue;
+    if (!invoice.lines) continue;
+
+    for (const line of invoice.lines) {
+      const lineTotal = line.qty * line.unitPrice;
+      let lineDiscount = 0;
+      if (line.discountPercent !== undefined && line.discountPercent !== null) {
+        lineDiscount = Math.max(0, (line.discountPercent / 100) * lineTotal);
+      }
+      const discountedAmount = Math.max(0, lineTotal - lineDiscount);
+      const rate = line.vatRate || 0;
+      const lineVat = rate > 0 ? roundCents(discountedAmount * (rate / 100)) : 0;
+
+      if (!vatMap[rate]) {
+        vatMap[rate] = { rate, base: 0, vat: 0 };
+      }
+      vatMap[rate].base += discountedAmount;
+      vatMap[rate].vat += lineVat;
+    }
+  }
+
+  const result = Object.values(vatMap)
+    .map((item) => ({ ...item, base: roundCents(item.base) }))
+    .sort((a, b) => b.rate - a.rate);
+  return result;
+}
