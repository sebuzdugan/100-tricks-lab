+/**
+ * Late fee on an invoice: 0.04% per day overdue.
+ * @param {object} invoice
+ * @param {string} asOf (YYYY-MM-DD format)
+ * @returns {number} late fee in cents
+ */
+export function lateFee(invoice, asOf) {
+  if (!invoice || !invoice.dueDate) return 0;
+
+  // Check if overdue
+  if (invoice.dueDate >= asOf) return 0;
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) return 0;
+
+  // Get amount due
+  const due = balanceDue(invoice);
+  if (due <= 0) return 0;
+
+  // Calculate late fee: 0.04% per day
+  const fee = due * 0.0004 * daysOverdue;
+  return roundCents(fee);
+}
