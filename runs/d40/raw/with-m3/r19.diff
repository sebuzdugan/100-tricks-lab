+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns header line', () => {
+  const r = exportCsv([]);
+  assert.ok(r.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv with empty invoices', () => {
+  const r = exportCsv([]);
+  assert.equal(r, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv with null invoices', () => {
+  const r = exportCsv(null);
+  assert.equal(r, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv with single draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const r = exportCsv([invoice.value]);
+  const lines = r.split('\n');
+  assert.equal(lines.length, 3); // header + data + empty line at end
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[1].includes('draft'));
+});
+
+test('exportCsv with issued invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  assert.ok(lines[1].startsWith('INV-2026-0001'));
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv formats amounts with 2 decimal places', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  // STICKER: 2 × 50 = 100, subtotal = 100, vat = 21, total = 121
+  assert.ok(lines[1].includes('1.00')); // subtotal
+  assert.ok(lines[1].includes('0.00')); // discount
+  assert.ok(lines[1].includes('0.21')); // vat
+  assert.ok(lines[1].includes('1.21')); // total
+});
+
+test('exportCsv formats large amounts correctly', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  // DES-HOUR: 10 × 8500 = 85000, vat = 17850, total = 102850
+  assert.ok(lines[1].includes('850.00')); // subtotal
+  assert.ok(lines[1].includes('1028.50')); // total
+});
+
+test('exportCsv includes customer name', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  assert.ok(lines[1].includes('Kite & Co'));
+});
+
+test('exportCsv escapes customer names with commas', () => {
+  const invoice = createInvoice({
+    customerId: 'C-006',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  // Marlow "The Print Shop" has quotes, should be escaped
+  assert.ok(lines[1].includes('"'));
+});
+
+test('exportCsv with multiple invoices', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'STICKER', qty: 3 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const r = exportCsv([issued1.value, issued2.value]);
+  const lines = r.split('\n');
+  assert.equal(lines.length, 4); // header + 2 data + empty line
+  assert.ok(lines[1].startsWith('INV-2026-0001'));
+  assert.ok(lines[2].startsWith('INV-2026-0002'));
+});
+
+test('exportCsv includes issued date and due date', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+    terms: 'NET14',
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  assert.ok(lines[1].includes('2026-10-07'));
+  assert.ok(lines[1].includes('2026-10-21'));
+});
+
+test('exportCsv includes status', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  assert.ok(lines[1].includes('issued'));
+});
+
+test('exportCsv includes discount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001', // gold tier, 5% discount
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  assert.ok(lines[1].includes('42.50')); // 850 × 0.05
+});
+
+test('exportCsv calculates due amount', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  // All due since no payments
+  const expectedDue = (totals.value.total / 100).toFixed(2);
+  assert.ok(lines[1].endsWith(expectedDue));
+});
+
+test('exportCsv with partial payment', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const totals = invoiceTotals(issued.value);
+  const partial = recordPayment(issued.value, { amount: 50, date: '2026-10-10' });
+  const r = exportCsv([partial.value]);
+  const lines = r.split('\n');
+  // Due should be total - 50 cents = total - 0.50
+  const expectedDue = totals.value.total - 50;
+  const expectedDueStr = (expectedDue / 100).toFixed(2);
+  assert.ok(lines[1].endsWith(expectedDueStr));
+});
+
+test('exportCsv with paid invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.value.total, date: '2026-10-10' });
+  const r = exportCsv([paid.value]);
+  const lines = r.split('\n');
+  assert.ok(lines[1].includes('paid'));
+  assert.ok(lines[1].endsWith('0.00'));
+});
+
+test('exportCsv escapes quotes in customer names', () => {
+  const invoice = createInvoice({
+    customerId: 'C-006', // Marlow "The Print Shop"
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  // The quote should be escaped as ""
+  assert.ok(r.includes('""'));
+});
+
+test('exportCsv ends with newline', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  assert.ok(r.endsWith('\n'));
+});
+
+test('exportCsv lines separated by newlines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.ok(lines[1].length > 0);
+  assert.equal(lines[2], '');
+});
+
+test('exportCsv handles unknown customer gracefully', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    dueDate: '2026-11-06',
+    lines: [{ sku: 'STICKER', qty: 2, name: 'Sticker sheet', unitPrice: 50, vatRate: 21 }],
+  };
+  const r = exportCsv([invoice]);
+  const lines = r.split('\n');
+  // Customer name should be empty
+  assert.ok(lines[1].includes('INV-2026-0001,,'));
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const invoice3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued3 = issueInvoice(invoice3.value, ['INV-2026-0001', 'INV-2026-0002']);
+
+  const r = exportCsv([issued1.value, issued2.value, issued3.value]);
+  const lines = r.split('\n');
+  assert.ok(lines[1].startsWith('INV-2026-0001'));
+  assert.ok(lines[2].startsWith('INV-2026-0002'));
+  assert.ok(lines[3].startsWith('INV-2026-0003'));
+});
+
+test('exportCsv with zero amounts', () => {
+  const invoice = {
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    dueDate: '2026-11-06',
+    lines: [],
+  };
+  // This invoice is invalid (no lines), but we should handle it gracefully
+  const r = exportCsv([invoice]);
+  const lines = r.split('\n');
+  assert.ok(lines[1].includes('0.00'));
+});
+
+test('exportCsv does not include header for each invoice', () => {
+  const invoice1 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued1 = issueInvoice(invoice1.value, []);
+
+  const invoice2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+  const issued2 = issueInvoice(invoice2.value, ['INV-2026-0001']);
+
+  const r = exportCsv([issued1.value, issued2.value]);
+  const headerCount = (r.match(/number,customer,issueDate/g) || []).length;
+  assert.equal(headerCount, 1);
+});
+
+test('exportCsv with draft invoice shows empty number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 2 }],
+  });
+  const r = exportCsv([invoice.value]);
+  const lines = r.split('\n');
+  assert.ok(lines[1].startsWith(','));
+});
+
+test('exportCsv correctly formats currency', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 10 }],
+  });
+  const issued = issueInvoice(invoice.value, []);
+  const r = exportCsv([issued.value]);
+  const lines = r.split('\n');
+  // DES-HOUR: 10 × 8500 = 85000 cents = 850.00 euros
+  assert.ok(lines[1].includes('850.00'));
+  // No currency signs
+  assert.ok(!lines[1].includes('€'));
+  // Extract currency fields and verify format (dot separator, 2 decimals)
+  const fields = lines[1].split(',');
+  // Subtotal (field 5), discount (6), vat (7), total (8), due (9)
+  for (let i = 5; i <= 9; i++) {
+    assert.match(fields[i], /^\d+\.\d{2}$/);
+  }
+});
+
+test('exportCsv with large dataset', () => {
+  const invoices = Array.from({ length: 100 }, (_, i) => {
+    const invoice = createInvoice({
+      customerId: 'C-002',
+      issueDate: `2026-10-${String((i % 20) + 1).padStart(2, '0')}`,
+      lines: [{ sku: 'STICKER', qty: i + 1 }],
+    });
+    return issueInvoice(invoice.value, []);
+  })
+    .filter((inv) => inv.ok)
+    .map((inv) => inv.value);
+
+  const r = exportCsv(invoices);
+  const lines = r.split('\n');
+  assert.equal(lines.length, invoices.length + 2); // header + data + empty line
+});
