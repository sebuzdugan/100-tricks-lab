@@ -1,5 +1,14 @@
 import { ok, fail } from './result.js';
 
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +48,40 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert cents from euros to another currency.
+ * @param {number} cents (in euros)
+ * @param {string} currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) return fail('UNKNOWN_CURRENCY');
+
+  if (currency === 'EUR') return ok(cents);
+
+  const euros = cents / 100;
+  const converted = euros * RATES[currency];
+  const convertedCents = roundCents(converted * 100);
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents in a given currency: 123456 cents EUR -> "$1,339.02 USD" (after conversion and formatting).
+ * @param {number} cents (in euros)
+ * @param {string} currency (EUR, USD, GBP)
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function formatMoney(cents, currency) {
+  const convertResult = convert(cents, currency);
+  if (!convertResult.ok) return convertResult;
+
+  const targetCents = convertResult.value;
+  const sign = targetCents < 0 ? '-' : '';
+  const abs = Math.abs(targetCents);
+  const amount = Math.floor(abs / 100)
+    .toString()
+    .replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const currencySign = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+  return ok(`${sign}${currencySign}${amount}.${String(abs % 100).padStart(2, '0')}`);
+}
