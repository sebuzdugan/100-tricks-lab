+test('mergeCustomers merges one customer into another', () => {
+  const customers = listCustomers();
+  const invoices = [
+    { number: 'INV-2026-0001', customerId: 'C-012', issueDate: '2026-10-07', status: 'issued', lines: [] },
+    { number: 'INV-2026-0002', customerId: 'C-001', issueDate: '2026-10-10', status: 'issued', lines: [] },
+  ];
+  const r = mergeCustomers(customers, invoices, 'C-012', 'C-001');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customers.length, customers.length - 1);
+  assert.ok(!r.value.customers.find((c) => c.id === 'C-012'));
+  assert.ok(r.value.invoices[0].customerId, 'C-001');
+  assert.equal(r.value.invoices[1].customerId, 'C-001');
+});
+
