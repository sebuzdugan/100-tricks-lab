diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..2f43814
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,48 @@
+import { ok, fail } from './result.js';
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total amount for a line (qty × unitPrice).
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function lineTotal(line) {
+  if (!line || !Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+  if (!Number.isInteger(line.unitPrice) || line.unitPrice < 0) return fail('AMOUNT_INVALID');
+  return ok(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher and total for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }}
+ * @returns {{ ok: true, value: { subtotal: number, discount: number, vat: number, voucher: number, total: number } } | { ok: false, error: string }}
+ */
+export function invoiceTotals(invoice) {
+  if (!invoice || !Array.isArray(invoice.lines) || invoice.lines.length === 0) return fail('NO_LINES');
+
+  let subtotal = 0;
+  let totalDiscount = 0;
+  let totalVat = 0;
+
+  for (const line of invoice.lines) {
+    const lt = lineTotal(line);
+    if (!lt.ok) return lt;
+    subtotal += lt.value;
+
+    let lineDiscount = 0;
+    if (line.discountPercent !== undefined && line.discountPercent !== null) {
+      lineDiscount = Math.max(0, line.discountPercent / 100 * lt.value);
+      totalDiscount += lineDiscount;
+    }
+
+    const discountedAmount = Math.max(0, lt.value - lineDiscount);
+    if (line.vatRate && line.vatRate > 0) {
+      const lineVat = roundCents(discountedAmount * (line.vatRate / 100));
+      totalVat += Math.max(0, lineVat);
+    }
+  }
+
+  const voucherAmount = invoice.voucher ? Math.max(0, invoice.voucher.amount) : 0;
+  const total = Math.max(0, subtotal - totalDiscount + totalVat - voucherAmount);
+  return ok({ subtotal, discount: Math.max(0, totalDiscount), vat: Math.max(0, totalVat), voucher: voucherAmount, total });
+}
