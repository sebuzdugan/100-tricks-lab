+test('invoiceTotals bulk discount: 10+ units get 2.5% off', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 21 }],
+  };
+  const r = invoiceTotals(invoice);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.subtotal, 10000);
+  const bulkDiscount = 10000 * 0.025;
+  assert.equal(r.value.discount, bulkDiscount);
+  const discountedAmount = 10000 - bulkDiscount;
+  const expectedVat = Math.round(discountedAmount * 0.21);
+  const expectedTotal = 10000 - bulkDiscount + expectedVat;
+  assert.equal(r.value.vat, expectedVat);
+  assert.equal(r.value.total, expectedTotal);
+});
+
+test('invoiceTotals bulk discount not applied for 9 units', () => {
