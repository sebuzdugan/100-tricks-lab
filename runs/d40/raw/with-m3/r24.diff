 import { balanceDue } from './payments.js';
 import { daysBetween } from './dates.js';
 import { roundCents } from './money.js';
+import { ok, fail } from './result.js';
 
 /**
  * Invoices overdue as of a date, sorted by days overdue (most first).
@@ -10,7 +11,7 @@ import { roundCents } from './money.js';
  */
 export function overdueInvoices(invoices, asOf) {
   const overdue = (invoices || [])
-    .filter((inv) => ['issued', 'partially_paid'].includes(inv.status))
+    .filter((inv) => inv && ['issued', 'partially_paid'].includes(inv.status))
     .filter((inv) => inv.dueDate < asOf)
     .map((inv) => {
       const due = balanceDue(inv);
@@ -88,3 +89,50 @@ export function lateFee(invoice, asOf) {
   const fee = due * 0.0004 * daysOverdue;
   return roundCents(fee);
 }
+
+/**
+ * Dashboard summary of invoicing activity and status.
+ * @param {Array<object>} invoices
+ * @param {string} asOf (YYYY-MM-DD format)
+ * @returns {{ ok: true, value: { counts, outstanding, overdue, topCustomers } } | { ok: false, error: string }}
+ */
+export function dashboard(invoices, asOf) {
+  if (!invoices || !Array.isArray(invoices)) return fail('NO_INVOICES');
+  if (!asOf || typeof asOf !== 'string') return fail('INVALID_DATE');
+
+  const counts = { draft: 0, issued: 0, partially_paid: 0, paid: 0 };
+  const customerDues = {};
+  let outstanding = 0;
+
+  for (const invoice of invoices) {
+    if (!invoice) continue;
+
+    const status = invoice.status || 'draft';
+    counts[status] = (counts[status] || 0) + 1;
+
+    if (['issued', 'partially_paid'].includes(status)) {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      const customerId = invoice.customerId;
+      if (customerId) {
+        customerDues[customerId] = (customerDues[customerId] || 0) + due;
+      }
+    }
+  }
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue.reduce((sum, inv) => sum + inv.due, 0);
+
+  const topCustomers = Object.entries(customerDues)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return ok({
+    counts,
+    outstanding,
+    overdue: { count: overdue.length, amount: overdueAmount },
+    topCustomers,
+  });
+}
