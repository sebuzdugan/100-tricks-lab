+  // Voucher
+  if (totals.value.voucher > 0) {
+    lines.push(`Voucher: ${formatEuros(totals.value.voucher)}`);
+  }
+
+  // Total
   lines.push(`Total: ${formatEuros(totals.value.total)}`);
 
+  // Due date
