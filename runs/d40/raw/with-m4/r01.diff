@@ -0,0 +1,59 @@
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Create a draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }} params
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate lines array is not empty
+  if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
+
+  // Validate issueDate format and value
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return fail('CUSTOMER_NOT_FOUND');
+
+  // Validate and enrich lines
+  const enrichedLines = [];
+  for (const line of lines) {
+    // Validate quantity is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    // Validate SKU exists and get product details
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return fail('UNKNOWN_SKU');
+
+    const product = productResult.value;
+    enrichedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: enrichedLines,
+  });
+}
+
+function isValidDate(dateStr) {
+  // Check format YYYY-MM-DD
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return false;
+
+  // Parse and validate
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const [year, month, day] = dateStr.split('-').map(Number);
+
+  return date.getUTCFullYear() === year &&
+         date.getUTCMonth() + 1 === month &&
+         date.getUTCDate() === day;
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..bdb9bc3
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,115 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice creates a draft invoice with enriched lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  const invoice = result.value;
+  assert.equal(invoice.customerId, 'C-001');
+  assert.equal(invoice.issueDate, '2026-10-07');
+  assert.equal(invoice.status, 'draft');
+  assert.equal(invoice.lines.length, 2);
+
+  assert.equal(invoice.lines[0].sku, 'DES-HOUR');
+  assert.equal(invoice.lines[0].name, 'Design work (hour)');
+  assert.equal(invoice.lines[0].qty, 5);
+  assert.equal(invoice.lines[0].unitPrice, 8500);
+  assert.equal(invoice.lines[0].vatRate, 21);
+
+  assert.equal(invoice.lines[1].sku, 'LOGO-PACK');
+  assert.equal(invoice.lines[1].name, 'Logo package');
+  assert.equal(invoice.lines[1].qty, 1);
+  assert.equal(invoice.lines[1].unitPrice, 120000);
+  assert.equal(invoice.lines[1].vatRate, 21);
+});
+
+test('createInvoice reports an unknown customer', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-999',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }),
+    { ok: false, error: 'CUSTOMER_NOT_FOUND' }
+  );
+});
+
+test('createInvoice reports an invalid date', () => {
+  const invalidDates = ['2026-13-01', '2026-02-30', '26-10-07', '2026/10/07', '2026-10-7', ''];
+
+  for (const date of invalidDates) {
+    assert.deepEqual(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: date,
+        lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      }),
+      { ok: false, error: 'DATE_INVALID' },
+      `should reject "${date}"`
+    );
+  }
+});
+
+test('createInvoice reports no lines', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [],
+    }),
+    { ok: false, error: 'NO_LINES' }
+  );
+});
+
+test('createInvoice reports invalid quantity', () => {
+  const cases = [
+    { qty: 0, desc: 'zero' },
+    { qty: -1, desc: 'negative' },
+    { qty: 1.5, desc: 'fractional' },
+    { qty: NaN, desc: 'NaN' },
+  ];
+
+  for (const { qty, desc } of cases) {
+    assert.deepEqual(
+      createInvoice({
+        customerId: 'C-001',
+        issueDate: '2026-10-07',
+        lines: [{ sku: 'DES-HOUR', qty }],
+      }),
+      { ok: false, error: 'QTY_INVALID' },
+      `should reject ${desc}`
+    );
+  }
+});
+
+test('createInvoice reports an unknown SKU', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'NOPE', qty: 1 }],
+    }),
+    { ok: false, error: 'UNKNOWN_SKU' }
+  );
+});
+
+test('createInvoice returns a copy of the lines', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines,
+  });
+
+  result.value.lines[0].qty = 99;
+  assert.equal(lines[0].qty, 1);
+});
