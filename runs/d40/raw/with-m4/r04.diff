diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..ea4e011
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,50 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const result = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter', () => {
+  const existingNumbers = ['INV-2026-0001', 'INV-2026-0003'];
+  const result = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 'INV-2026-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existingNumbers = ['INV-2025-9999', 'INV-2026-0001'];
+  const result = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles unordered numbers', () => {
+  const existingNumbers = ['INV-2026-0005', 'INV-2026-0002', 'INV-2026-0010'];
+  const result = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existingNumbers = ['INV-2026-NOPE', 'INV-2026-0001', 'INV-2026-'];
+  const result = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber reports invalid date', () => {
+  assert.deepEqual(
+    nextInvoiceNumber([], '2026/10/07'),
+    { ok: false, error: 'DATE_INVALID' }
+  );
+});
+
+test('nextInvoiceNumber pads counter with zeros', () => {
+  const existingNumbers = ['INV-2026-0099'];
+  const result = nextInvoiceNumber(existingNumbers, '2026-10-07');
+  assert.equal(result.value, 'INV-2026-0100');
+});
