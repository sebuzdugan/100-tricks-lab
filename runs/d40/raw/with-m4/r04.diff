index 0000000..d62d099
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,32 @@
+import { ok, fail } from './result.js';
+
+/**
+ * Calculate the next invoice number for a given issue date.
+ * @param {Array<string>} existingNumbers - Array of invoice numbers already used
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  // Extract year from issueDate
+  const yearMatch = /^(\d{4})-/.exec(issueDate);
+  if (!yearMatch) return fail('DATE_INVALID');
+  const year = yearMatch[1];
+
+  // Filter numbers for this year and extract counters
+  const prefix = `INV-${year}-`;
+  const counters = existingNumbers
+    .filter(num => num.startsWith(prefix))
+    .map(num => {
+      const counter = num.slice(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter(counter => !isNaN(counter));
+
+  // Find max counter, or start at 0
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  // Format with 4 digits, zero-padded
+  const numberString = `${prefix}${String(nextCounter).padStart(4, '0')}`;
+  return ok(numberString);
+}
