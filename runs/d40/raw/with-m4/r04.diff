+/**
+ * Issue an invoice: assign a number and change status to 'issued'.
+ * @param {object} invoice
+ * @param {Array<string>} existingNumbers
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check invoice status is draft
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Get next invoice number
+  const numberResult = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+  if (!numberResult.ok) return fail(numberResult.error);
+
+  return ok({
+    ...invoice,
+    number: numberResult.value,
+    status: 'issued',
+  });
+}
