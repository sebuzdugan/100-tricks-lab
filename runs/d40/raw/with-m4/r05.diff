+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { invoiceTotals } from './invoices.js';
+import { fail } from './result.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {object} invoice
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer info
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return fail('CUSTOMER_NOT_FOUND');
+
+  const customer = customerResult.value;
+  const totals = invoiceTotals(invoice);
+
+  // Build the invoice text
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  const numberLine = invoice.number || 'DRAFT';
+  lines.push(numberLine);
+
+  // Second line: customer name
+  lines.push(customer.name);
+
+  // Blank line
+  lines.push('');
+
+  // Line items
+  for (const line of invoice.lines) {
+    const total = line.qty * line.unitPrice;
+    const itemLine = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
+    lines.push(itemLine);
+  }
+
+  // Blank line
+  lines.push('');
+
+  // Total line
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return { ok: true, value: lines.join('\n') };
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..79b9768
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,147 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { renderInvoiceText } from '../src/render.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  const result = renderInvoiceText(invoiceResult.value);
+  assert.equal(result.ok, true);
+
+  const text = result.value;
+  assert.match(text, /^DRAFT\n/);
+  assert.match(text, /^DRAFT\nNorthwind Studio\n/);
+  assert.match(text, /5 Design work \(hour\) €85\.00 €425\.00/);
+  assert.match(text, /1 Logo package €1,200\.00 €1,200\.00/);
+  assert.match(text, /Total: €1,625\.00$/);
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  const issueResult = issueInvoice(invoiceResult.value, []);
+  const result = renderInvoiceText(issueResult.value);
+
+  assert.equal(result.ok, true);
+  const text = result.value;
+  assert.match(text, /^INV-2026-0001\n/);
+  assert.match(text, /Total: €170\.00$/);
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 3 },
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 1 },
+    ],
+  });
+
+  const result = renderInvoiceText(invoiceResult.value);
+  assert.equal(result.ok, true);
+
+  const text = result.value;
+  assert.match(text, /Blue Fern Bakery/);
+  assert.match(text, /3 Design work \(hour\) €85\.00 €255\.00/);
+  assert.match(text, /2 Development \(hour\) €95\.00 €190\.00/);
+  assert.match(text, /1 Copywriting \(hour\) €60\.00 €60\.00/);
+  // Total: 255 + 190 + 60 = 505 euros
+  assert.match(text, /Total: €505\.00$/);
+});
+
+test('renderInvoiceText formats amounts with euro currency', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 100 }],
+  });
+
+  const result = renderInvoiceText(invoiceResult.value);
+  const text = result.value;
+
+  // ICON-SET is 980 cents = €9.80
+  // 100 × €9.80 = €980.00
+  assert.match(text, /€9\.80/);
+  assert.match(text, /€980\.00/);
+});
+
+test('renderInvoiceText uses customer name from database', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-007',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const result = renderInvoiceText(invoiceResult.value);
+  const text = result.value;
+  assert.match(text, /Halvorsen Architects/);
+});
+
+test('renderInvoiceText reports unknown customer', () => {
+  const invoice = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', name: 'Design work (hour)', qty: 1, unitPrice: 8500, vatRate: 21 }],
+  };
+
+  assert.deepEqual(
+    renderInvoiceText(invoice),
+    { ok: false, error: 'CUSTOMER_NOT_FOUND' }
+  );
+});
+
+test('renderInvoiceText includes blank lines for readability', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const result = renderInvoiceText(invoiceResult.value);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  // Should have: number, customer, blank, item, blank, total = 6 lines minimum
+  assert.ok(lines.length >= 6);
+  assert.equal(lines[2], ''); // Blank line after customer
+});
+
+test('renderInvoiceText with large quantities and prices', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 3 },
+      { sku: 'WORKSHOP-DAY', qty: 2 },
+    ],
+  });
+
+  const result = renderInvoiceText(invoiceResult.value);
+  const text = result.value;
+
+  // BRAND-BOOK: 245000 cents = €2,450.00 each
+  // 3 × €2,450.00 = €7,350.00
+  // WORKSHOP-DAY: 60000 cents = €600.00 each
+  // 2 × €600.00 = €1,200.00
+  // Total: €8,550.00
+  assert.match(text, /€2,450\.00/);
+  assert.match(text, /€7,350\.00/);
+  assert.match(text, /€600\.00/);
+  assert.match(text, /€1,200\.00/);
+  assert.match(text, /Total: €8,550\.00$/);
+});
