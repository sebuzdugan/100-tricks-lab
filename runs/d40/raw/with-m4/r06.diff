diff --git a/test/invoices.test.js b/test/invoices.test.js
index 0b73d28..41089fb 100644
--- a/test/invoices.test.js
+++ b/test/invoices.test.js
@@ -387,3 +387,185 @@ test('issueInvoice preserves invoice properties', () => {
   assert.equal(result.value.lines.length, 1);
   assert.equal(result.value.lines[0].sku, 'LOGO-PACK');
 });
+
+test('createInvoice accepts discountPercent on a line', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5, discountPercent: 10 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice defaults discountPercent to 0 if not provided', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice accepts decimal discount values', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5, discountPercent: 12.5 },
+    ],
+  });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[0].discountPercent, 12.5);
+});
+
+test('createInvoice rejects negative discount', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: -5 }],
+    }),
+    { ok: false, error: 'DISCOUNT_INVALID' }
+  );
+});
+
+test('createInvoice rejects discount over 100', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 101 }],
+    }),
+    { ok: false, error: 'DISCOUNT_INVALID' }
+  );
+});
+
+test('createInvoice rejects non-numeric discount', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 'ten' }],
+    }),
+    { ok: false, error: 'DISCOUNT_INVALID' }
+  );
+});
+
+test('invoiceTotals calculates discount on a single line', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 10 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // Line total: 5 * 8500 = 42500
+  // Discount: 42500 * 10 / 100 = 4250
+  // Total: 42500 - 4250 = 38250
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.total, 38250);
+});
+
+test('invoiceTotals calculates discount on multiple lines', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 10 },
+      { sku: 'LOGO-PACK', name: 'Logo package', qty: 1, unitPrice: 120000, vatRate: 21, discountPercent: 5 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  // Line 1: 5 * 8500 = 42500, discount = 4250
+  // Line 2: 1 * 120000 = 120000, discount = 6000
+  // Subtotal: 162500
+  // Total discount: 10250
+  // Total: 152250
+  assert.equal(totals.subtotal, 162500);
+  assert.equal(totals.discount, 10250);
+  assert.equal(totals.total, 152250);
+});
+
+test('invoiceTotals with no discount returns zero discount', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 42500);
+});
+
+test('invoiceTotals clamps total to zero if discount exceeds subtotal', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 100 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 42500);
+  assert.equal(totals.total, 0);
+});
+
+test('addLine with discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = addLine(invoiceResult.value, { sku: 'LOGO-PACK', qty: 1, discountPercent: 15 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 15);
+});
+
+test('addLine rejects invalid discount', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.deepEqual(
+    addLine(invoiceResult.value, { sku: 'LOGO-PACK', qty: 1, discountPercent: 150 }),
+    { ok: false, error: 'DISCOUNT_INVALID' }
+  );
+});
+
+test('addLine defaults discount to 0 if not provided', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = addLine(invoiceResult.value, { sku: 'LOGO-PACK', qty: 1 });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.lines[1].discountPercent, 0);
+});
