+    customerId: 'C-001', // Gold tier (5%)
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 }, // Uses tier discount: 5%
+    ],
+  });
+
+  const totals = invoiceTotals(result.value);
+  // Line total: 5 * 8500 = 42500
+  // Discount: 42500 * 5 / 100 = 2125
+  // Total: 42500 - 2125 = 40375
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 2125);
+  assert.equal(totals.total, 40375);
+});
