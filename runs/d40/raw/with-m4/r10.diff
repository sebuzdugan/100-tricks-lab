diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..859431b
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,120 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('26-10-07'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('2026-10-7'), false);
+  assert.equal(isValidDate('2026-1-07'), false);
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('not-a-date'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-13-01'), false); // month > 12
+  assert.equal(isValidDate('2026-02-30'), false); // Feb doesn't have 30 days
+  assert.equal(isValidDate('2026-04-31'), false); // April doesn't have 31 days
+  assert.equal(isValidDate('2001-02-29'), false); // not a leap year
+  assert.equal(isValidDate('2026-00-01'), false); // month = 0
+  assert.equal(isValidDate('2026-01-00'), false); // day = 0
+});
+
+test('isValidDate handles leap years correctly', () => {
+  assert.equal(isValidDate('2000-02-29'), true); // leap year
+  assert.equal(isValidDate('2024-02-29'), true); // leap year
+  assert.equal(isValidDate('2023-02-29'), false); // not a leap year
+  assert.equal(isValidDate('2025-02-29'), false); // not a leap year
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  assert.equal(addDays('2026-10-25', 7), '2026-11-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays adds zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-03-31', 1), '2026-04-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.equal(addDays('2026-12-30', 2), '2027-01-01');
+  assert.equal(addDays('2026-12-31', 365), '2027-12-31');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2024-12-31', 1), '2025-01-01');
+});
+
+test('daysBetween calculates days difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+  assert.equal(daysBetween('2026-10-07', '2026-11-07'), 31);
+});
+
+test('daysBetween returns zero for same date', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween returns negative for earlier end date', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-02-01', '2026-03-01'), 28); // 2026 is not a leap year
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2025-12-31', '2026-12-31'), 365);
+  assert.equal(daysBetween('2024-12-31', '2025-12-31'), 365);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2); // 2024 is a leap year
+  assert.equal(daysBetween('2023-02-28', '2023-03-01'), 1); // 2023 is not a leap year
+});
+
+test('daysBetween works with large date ranges', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-12-31'), 364); // 365 days - 1
+  assert.equal(daysBetween('2000-01-01', '2000-12-31'), 365); // leap year
+});
+
+test('addDays and daysBetween are inverses', () => {
+  const start = '2026-10-07';
+  const n = 100;
+  const end = addDays(start, n);
+  assert.equal(daysBetween(start, end), n);
+});
+
+test('addDays and daysBetween work with negative values', () => {
+  const start = '2026-10-07';
+  const end = '2026-09-07';
+  const diff = daysBetween(end, start); // 30 days
+  assert.equal(diff, 30);
+  assert.equal(addDays(end, diff), start);
+});
