+/**
+ * Check if a string is a valid date in YYYY-MM-DD format.
+ * @param {string} dateStr
+ * @returns {boolean}
+ */
+export function isValidDate(dateStr) {
+  // Check format YYYY-MM-DD
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return false;
+
+  // Parse and validate in UTC
+  const date = new Date(dateStr + 'T00:00:00Z');
+  const [year, month, day] = dateStr.split('-').map(Number);
+
+  return date.getUTCFullYear() === year &&
+         date.getUTCMonth() + 1 === month &&
+         date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date string (YYYY-MM-DD), returning a new date string.
+ * All operations are done in UTC.
+ * @param {string} date - Date string in YYYY-MM-DD format
+ * @param {number} n - Number of days to add (can be negative)
+ * @returns {string} New date string in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + n);
+
+  const year = d.getUTCFullYear();
+  const month = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(d.getUTCDate()).padStart(2, '0');
+
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate the number of days between two dates (b - a), in whole days.
+ * All operations are done in UTC.
+ * @param {string} a - Start date string in YYYY-MM-DD format
+ * @param {string} b - End date string in YYYY-MM-DD format
+ * @returns {number} Number of whole days (b - a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+
+  const diffMs = dateB - dateA;
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
