+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+test('recordPayment adds a payment to an issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const paymentResult = recordPayment(issuedResult.value, { amount: 25000, date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.payments.length, 1);
+  assert.equal(paymentResult.value.payments[0].amount, 25000);
+  assert.equal(paymentResult.value.payments[0].date, '2026-10-10');
+});
+
+test('recordPayment changes status to partially_paid for partial payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const paymentResult = recordPayment(invoice, { amount: Math.floor(totals.total / 2), date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'partially_paid');
+});
+
+test('recordPayment changes status to paid for full payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'paid');
+});
+
+test('recordPayment rejects payment on draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  assert.deepEqual(
+    recordPayment(invoiceResult.value, { amount: 10000, date: '2026-10-10' }),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('recordPayment rejects invalid amount (zero)', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+
+  assert.deepEqual(
+    recordPayment(issuedResult.value, { amount: 0, date: '2026-10-10' }),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('recordPayment rejects invalid amount (negative)', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+
+  assert.deepEqual(
+    recordPayment(issuedResult.value, { amount: -5000, date: '2026-10-10' }),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('recordPayment rejects invalid amount (fractional)', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+
+  assert.deepEqual(
+    recordPayment(issuedResult.value, { amount: 10000.5, date: '2026-10-10' }),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('recordPayment rejects overpayment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  assert.deepEqual(
+    recordPayment(invoice, { amount: totals.total + 1, date: '2026-10-10' }),
+    { ok: false, error: 'OVERPAYMENT' }
+  );
+});
+
+test('recordPayment allows multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const payment1 = recordPayment(invoice, { amount: Math.floor(totals.total / 3), date: '2026-10-10' });
+  assert.equal(payment1.ok, true);
+
+  const payment2 = recordPayment(payment1.value, { amount: Math.floor(totals.total / 3), date: '2026-10-15' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.payments.length, 2);
+
+  const payment3 = recordPayment(payment2.value, { amount: totals.total - Math.floor(totals.total / 3) * 2, date: '2026-10-20' });
+  assert.equal(payment3.ok, true);
+  assert.equal(payment3.value.status, 'paid');
+  assert.equal(payment3.value.payments.length, 3);
+});
+
+test('balanceDue returns total for unpaid issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(balanceDue(invoice), totals.total);
+});
+
+test('balanceDue returns remaining balance after partial payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const payment = recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+
+  assert.equal(balanceDue(payment.value), totals.total - 10000);
+});
+
+test('balanceDue returns zero for paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+
+  assert.equal(balanceDue(payment.value), 0);
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const original = issuedResult.value;
+
+  recordPayment(original, { amount: 10000, date: '2026-10-10' });
+
+  assert.equal(original.payments, undefined);
+  assert.equal(original.status, 'issued');
+});
+
+test('recordPayment on partially_paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const payment1 = recordPayment(invoice, { amount: Math.floor(totals.total / 2), date: '2026-10-10' });
+  assert.equal(payment1.ok, true);
+  assert.equal(payment1.value.status, 'partially_paid');
+
+  const payment2 = recordPayment(payment1.value, { amount: totals.total - Math.floor(totals.total / 2), date: '2026-10-15' });
+  assert.equal(payment2.ok, true);
+  assert.equal(payment2.value.status, 'paid');
+});
+
+test('recordPayment rejects payment on paid invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const payment = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+  assert.equal(payment.value.status, 'paid');
+
+  assert.deepEqual(
+    recordPayment(payment.value, { amount: 1000, date: '2026-10-15' }),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('balanceDue with multiple payments', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 0 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const payment1 = recordPayment(invoice, { amount: 10000, date: '2026-10-10' });
+  assert.equal(balanceDue(payment1.value), totals.total - 10000);
+
+  const payment2 = recordPayment(payment1.value, { amount: 20000, date: '2026-10-15' });
+  assert.equal(balanceDue(payment2.value), totals.total - 30000);
+});
+
+test('recordPayment with large invoice and payment', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-008',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 5, discountPercent: 0 },
+      { sku: 'WORKSHOP-DAY', qty: 2, discountPercent: 0 },
+    ],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const invoice = issuedResult.value;
+  const totals = invoiceTotals(invoice);
+
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2026-10-10' });
+
+  assert.equal(paymentResult.ok, true);
+  assert.equal(paymentResult.value.status, 'paid');
+  assert.equal(balanceDue(paymentResult.value), 0);
+});
