+    { input: '2026-03-15', expected: '2026-03-31' }, // 31 days
+    { input: '2026-04-15', expected: '2026-04-30' }, // 30 days
+    { input: '2026-05-15', expected: '2026-05-31' }, // 31 days
+    { input: '2026-06-15', expected: '2026-06-30' }, // 30 days
