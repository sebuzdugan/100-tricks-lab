+    { input: '2026-10-15', expected: '2026-10-31' }, // 31 days
+    { input: '2026-11-15', expected: '2026-11-30' }, // 30 days
+    { input: '2026-12-15', expected: '2026-12-31' }, // 31 days
+  ];
+
+  for (const { input, expected } of cases) {
