--- a/src/dates.js
+++ b/src/dates.js
@@ -48,3 +48,14 @@ export function daysBetween(a, b) {
   const diffMs = dateB - dateA;
   return Math.floor(diffMs / (1000 * 60 * 60 * 24));
 }
+
+/**
+ * Get the last day of the month for a given date (YYYY-MM-DD).
+ * @param {string} dateStr - Date string in YYYY-MM-DD format
+ * @returns {string} Last day of the month in YYYY-MM-DD format
+ */
+export function getLastDayOfMonth(dateStr) {
+  const [year, month] = dateStr.split('-').map(Number);
+  const lastDayNum = new Date(Date.UTC(year, month, 0)).getUTCDate();
+  return `${year}-${String(month).padStart(2, '0')}-${String(lastDayNum).padStart(2, '0')}`;
+}
