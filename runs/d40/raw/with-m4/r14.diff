+
+test('statement calculates totalDue as sum of individual dues', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+
+  const inv1 = issueInvoice(inv1Result.value, []).value;
