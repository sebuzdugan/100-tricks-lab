+
+test('statement excludes paid invoices from statement', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv1Issued = issueInvoice(invResult.value, []);
+  assert.equal(inv1Issued.ok, true);
+
+  const invPaid = recordPayment(inv1Issued.value, { amount: 48854, date: '2026-10-10' });
+  assert.equal(invPaid.ok, true);
+
+  const result = statement('C-001', [invPaid.value], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
