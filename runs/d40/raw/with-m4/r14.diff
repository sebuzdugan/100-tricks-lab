+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { statement } from '../src/statements.js';
+
+test('statement returns invoices for a customer', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+
+  const result = statement('C-001', [inv1], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement filters invoices by customer', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+  const inv2 = issueInvoice(inv2Result.value, []).value;
+
+  const result = statement('C-001', [inv1, inv2], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement filters by status (issued only)', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv2 = inv1Result.value; // Still draft
+
+  const inv3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv3 = issueInvoice(inv3Result.value, []).value; // Issued
+
+  const result = statement('C-001', [inv2, inv3], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement filters by status (partially_paid included)', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv1Issued = issueInvoice(inv1Result.value, []).value;
+  const inv1Partial = recordPayment(inv1Issued, { amount: 10000, date: '2026-10-10' }).value;
+
+  const result = statement('C-001', [inv1Partial], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  // C-001 is gold tier (5% discount): 42500 - 2125 + 8479 = 48854; 48854 - 10000 = 38854
+  assert.equal(result.value.invoices[0].due, 38854);
+});
+
+test('statement filters by asOf date', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
