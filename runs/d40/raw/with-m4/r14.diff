+test('statement with multiple invoices and mixed payment status', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv3Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv1Issued = issueInvoice(inv1Result.value, []);
+  const inv1Paid = recordPayment(inv1Issued.value, { amount: 48854, date: '2026-10-02' });
+
+  const inv2Issued = issueInvoice(inv2Result.value, ['INV-2026-0001']);
+  const inv2Partial = recordPayment(inv2Issued.value, { amount: 20000, date: '2026-10-06' });
+
+  const inv3 = issueInvoice(inv3Result.value, ['INV-2026-0001', 'INV-2026-0002']);
+
+  const result = statement('C-001', [inv1Paid.value, inv2Partial.value, inv3.value], '2026-10-31');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2); // Only partial and unpaid (paid is excluded)
+  assert.ok(result.value.invoices[0].due > 0); // Partially paid
+  assert.ok(result.value.invoices[1].due > 0); // Unpaid
+  assert.equal(result.value.totalDue, result.value.invoices[0].due + result.value.invoices[1].due);
+});
+
+test('statement handles invoices with different terms and discounts', () => {
