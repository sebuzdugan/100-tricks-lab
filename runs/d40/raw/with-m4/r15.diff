@@ -0,0 +1,66 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next credit note number for a given year.
+ * @param {Array<string>} existingNumbers - Array of all issued numbers (invoices and credit notes)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: string } | { ok: false, error: string }}
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const yearMatch = /^(\d{4})-/.exec(issueDate);
+  if (!yearMatch) return fail('DATE_INVALID');
+  const year = yearMatch[1];
+
+  const prefix = `CN-${year}-`;
+  const counters = existingNumbers
+    .filter(num => num.startsWith(prefix))
+    .map(num => {
+      const counter = num.slice(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter(counter => !isNaN(counter));
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return ok(`${prefix}${String(nextCounter).padStart(4, '0')}`);
+}
+
+/**
+ * Create a credit note for an issued invoice (refund).
+ * @param {object} invoice - An issued, partially paid, or paid invoice
+ * @param {{ amount: number, reason: string, date: string }} params
+ * @param {Array<string>} existingNumbers - Array of all issued invoice and credit note numbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice status is issued, partially_paid, or paid
+  if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check credit amount doesn't exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Get next credit note number
+  const numberResult = nextCreditNoteNumber(existingNumbers, date);
+  if (!numberResult.ok) return fail(numberResult.error);
+
+  return ok({
+    number: numberResult.value,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
