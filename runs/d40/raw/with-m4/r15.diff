diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..a8df6c7
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,308 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { createCreditNote } from '../src/credits.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+
+  const result = createCreditNote(inv, { amount: 10000, reason: 'Discount applied', date: '2026-10-10' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 10000);
+  assert.equal(result.value.reason, 'Discount applied');
+  assert.equal(result.value.date, '2026-10-10');
+});
+
+test('createCreditNote creates a credit note for a partially paid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invIssued = issueInvoice(invResult.value, []).value;
+  const invPartial = recordPayment(invIssued, { amount: 20000, date: '2026-10-10' }).value;
+
+  const result = createCreditNote(invPartial, { amount: 5000, reason: 'Partial refund', date: '2026-10-11' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.amount, 5000);
+});
+
+test('createCreditNote creates a credit note for a paid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invIssued = issueInvoice(invResult.value, []).value;
+  const totals = invoiceTotals(invIssued);
+  const invPaid = recordPayment(invIssued, { amount: totals.total, date: '2026-10-10' }).value;
+
+  const result = createCreditNote(invPaid, { amount: 5000, reason: 'Refund', date: '2026-10-11' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote rejects draft invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  assert.deepEqual(
+    createCreditNote(invResult.value, { amount: 10000, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'NOT_ISSUED' }
+  );
+});
+
+test('createCreditNote rejects invalid amount (zero)', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+
+  assert.deepEqual(
+    createCreditNote(inv, { amount: 0, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects invalid amount (negative)', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+
+  assert.deepEqual(
+    createCreditNote(inv, { amount: -5000, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects invalid amount (fractional)', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+
+  assert.deepEqual(
+    createCreditNote(inv, { amount: 10000.5, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'AMOUNT_INVALID' }
+  );
+});
+
+test('createCreditNote rejects credit amount exceeding invoice total', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const totals = invoiceTotals(inv);
+
+  assert.deepEqual(
+    createCreditNote(inv, { amount: totals.total + 1, reason: 'Refund', date: '2026-10-10' }, []),
+    { ok: false, error: 'CREDIT_TOO_HIGH' }
+  );
+});
+
+test('createCreditNote allows credit amount equal to invoice total', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const totals = invoiceTotals(inv);
+
+  const result = createCreditNote(inv, { amount: totals.total, reason: 'Full refund', date: '2026-10-10' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote increments credit note counter separately from invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+
+  // Create first credit note
+  const cn1 = createCreditNote(inv, { amount: 10000, reason: 'Refund 1', date: '2026-10-10' }, ['INV-2026-0001']).value;
+  assert.equal(cn1.number, 'CN-2026-0001');
+
+  // Create second credit note
+  const cn2 = createCreditNote(inv, { amount: 5000, reason: 'Refund 2', date: '2026-10-11' }, ['INV-2026-0001', 'CN-2026-0001']).value;
+  assert.equal(cn2.number, 'CN-2026-0002');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+
+  const existingNumbers = [
+    'INV-2026-0001',
+    'INV-2026-0002',
+    'CN-2026-0001',
+    'INV-2026-0003',
+    'CN-2026-0002',
+  ];
+
+  const cn = createCreditNote(inv, { amount: 10000, reason: 'Refund', date: '2026-10-10' }, existingNumbers).value;
+
+  assert.equal(cn.number, 'CN-2026-0003');
+});
+
+test('createCreditNote uses year from date for numbering', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+
+  // Create credit note in next year
+  const cn = createCreditNote(inv, { amount: 10000, reason: 'Refund', date: '2027-01-05' }, []).value;
+
+  assert.equal(cn.number, 'CN-2027-0001');
+});
+
+test('createCreditNote with discount on invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const totals = invoiceTotals(inv);
+
+  // Credit amount should not exceed the discounted total
+  const cn = createCreditNote(inv, { amount: totals.total, reason: 'Full refund', date: '2026-10-10' }, []);
+
+  assert.equal(cn.ok, true);
+  assert.equal(cn.value.amount, totals.total);
+});
+
+test('createCreditNote with voucher on invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const totals = invoiceTotals(inv);
+
+  // Even with voucher, credit amount limited by invoice total
+  const cn = createCreditNote(inv, { amount: totals.total, reason: 'Full refund', date: '2026-10-10' }, []);
+
+  assert.equal(cn.ok, true);
+});
+
+test('createCreditNote with different reasons', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+
+  const reasons = [
+    'Customer complaint',
+    'Damaged goods',
+    'Wrong item shipped',
+    'Service not delivered',
+    'Price adjustment',
+  ];
+
+  for (const reason of reasons) {
+    const cn = createCreditNote(inv, { amount: 5000, reason, date: '2026-10-10' }, []);
+    assert.equal(cn.ok, true);
+    assert.equal(cn.value.reason, reason);
+  }
+});
+
+test('createCreditNote separates credit notes by year counter', () => {
+  const inv2026Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv2027Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-01-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv2026 = issueInvoice(inv2026Result.value, []).value;
+  const inv2027 = issueInvoice(inv2027Result.value, ['INV-2026-0001']).value;
+
+  const cn2026_1 = createCreditNote(inv2026, { amount: 10000, reason: 'Refund', date: '2026-10-10' }, []).value;
+  const cn2026_2 = createCreditNote(inv2026, { amount: 5000, reason: 'Refund', date: '2026-10-15' }, ['CN-2026-0001']).value;
+  const cn2027_1 = createCreditNote(inv2027, { amount: 10000, reason: 'Refund', date: '2027-01-10' }, ['CN-2026-0001', 'CN-2026-0002']).value;
+
+  assert.equal(cn2026_1.number, 'CN-2026-0001');
+  assert.equal(cn2026_2.number, 'CN-2026-0002');
+  assert.equal(cn2027_1.number, 'CN-2027-0001');
+});
+
+test('createCreditNote includes all required fields', () => {
+  const invResult = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+
+  const cn = createCreditNote(inv, { amount: 50000, reason: 'Partial refund', date: '2026-10-12' }, ['INV-2026-0005']).value;
+
+  assert.ok(cn.number);
+  assert.ok(cn.invoiceNumber);
+  assert.ok(cn.customerId);
+  assert.ok(cn.amount);
+  assert.ok(cn.reason);
+  assert.ok(cn.date);
+  assert.equal(cn.number, 'CN-2026-0001');
+  assert.equal(cn.invoiceNumber, 'INV-2026-0001');
+  assert.equal(cn.customerId, 'C-003');
+});
