+test('overdueInvoices with large number of invoices', () => {
+  const invoices = [];
+  const issuedNumbers = [];
+  const customerIds = ['C-001', 'C-002', 'C-003', 'C-004', 'C-005', 'C-006', 'C-007', 'C-008', 'C-009', 'C-010'];
+
+  for (let i = 0; i < 10; i++) {
+    const invResult = createInvoice({
+      customerId: customerIds[i],
+      issueDate: `2026-09-${String(i + 1).padStart(2, '0')}`,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET14',
+    });
+    assert.equal(invResult.ok, true);
+    const issuedResult = issueInvoice(invResult.value, issuedNumbers);
+    assert.equal(issuedResult.ok, true);
+    invoices.push(issuedResult.value);
+    issuedNumbers.push(issuedResult.value.number);
+  }
+
+  const result = overdueInvoices(invoices, '2026-10-20');
+  assert.equal(result.length, 10);
+  // All should be overdue, sorted by most overdue first
+  for (let i = 0; i < result.length - 1; i++) {
+    assert.ok(result[i].daysOverdue >= result[i + 1].daysOverdue);
+  }
+});
