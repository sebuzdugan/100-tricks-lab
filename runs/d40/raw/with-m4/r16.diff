+
+test('overdueInvoices returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2026-10-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices returns empty array when no overdue invoices', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  // Due date is 2026-11-09
+
+  const result = overdueInvoices([inv], '2026-11-08');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices includes issued invoice past due date', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  // Due date is 2026-10-15
+
+  const result = overdueInvoices([inv], '2026-10-20');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, 'INV-2026-0001');
+  assert.equal(result[0].customerId, 'C-001');
+  assert.equal(result[0].dueDate, '2026-10-15');
+  assert.equal(result[0].daysOverdue, 5);
+});
