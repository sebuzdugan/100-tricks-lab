 /**
  * Get overdue invoices as of a given date.
@@ -22,3 +23,38 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Get VAT summary over invoices.
+ * @param {Array<object>} invoices - Array of invoice objects
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatMap = {};
+
+  for (const invoice of invoices) {
+    // Only include issued, partially_paid, or paid invoices
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    // Process each line in the invoice
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const lineTotal = line.qty * line.unitPrice;
+      const discount = lineTotal * (line.discountPercent ?? 0) / 100;
+      const base = lineTotal - discount;
+      const vat = roundCents(base * rate / 100);
+
+      if (!vatMap[rate]) {
+        vatMap[rate] = { rate, base: 0, vat: 0 };
+      }
+
+      vatMap[rate].base += base;
+      vatMap[rate].vat += vat;
+    }
+  }
+
+  // Convert map to array and sort by rate descending
+  return Object.values(vatMap).sort((a, b) => b.rate - a.rate);
+}
