+/**
+ * Calculate late fee for an invoice.
+ * @param {object} invoice - An invoice object
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number}
+ */
+export function lateFee(invoice, asOf) {
+  // Return 0 if invoice is not issued or partially_paid
+  if (!['issued', 'partially_paid'].includes(invoice.status)) {
+    return 0;
+  }
+
+  // Return 0 if not overdue (dueDate is on or after asOf)
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  // Calculate days overdue
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+
+  // Calculate amount due
+  const due = balanceDue(invoice);
+
+  // Calculate late fee: 0.04% per day = 0.0004
+  const fee = roundCents(due * 0.0004 * daysOverdue);
+
+  return fee;
+}
