+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format euros (cents) as a plain decimal string: 123456 -> "1234.56".
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEurosPlain(cents) {
+  const euros = Math.floor(cents / 100);
+  const centsPart = cents % 100;
+  return `${euros}.${String(centsPart).padStart(2, '0')}`;
+}
+
+/**
+ * Escape a CSV field: wrap in double quotes if it contains comma or quote, double any quotes.
+ * @param {string} value
+ * @returns {string}
+ */
+function escapeCsvField(value) {
+  const str = String(value);
+  if (str.includes(',') || str.includes('"')) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<object>} invoices - Array of invoice objects
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+
+  // Header line
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Data lines
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number || '', // number might not exist for draft invoices
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate || '',
+      invoice.status,
+      formatEurosPlain(totals.subtotal),
+      formatEurosPlain(totals.discount),
+      formatEurosPlain(totals.vat),
+      formatEurosPlain(totals.total),
+      formatEurosPlain(due),
+    ];
+
+    const line = fields.map(escapeCsvField).join(',');
+    lines.push(line);
+  }
+
+  return lines.join('\n') + '\n';
+}
