+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns header for empty array', () => {
+  const result = exportCsv([]);
+  assert.equal(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv with single draft invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const result = exportCsv([invResult.value]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 3); // header + data + trailing newline
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  // Check data line (draft invoice has no number, but does have dueDate calculated)
+  // Amounts are in euros: 42500 cents = 425.00, etc.
+  assert.match(lines[1], /^,Northwind Studio,2026-10-07,2026-11-06,draft,425\.00,21\.25,84\.79,488\.54,488\.54$/);
+});
+
+test('exportCsv with single issued invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 3);
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  // Amounts are in euros: 42500 cents = 425.00, 2125 cents = 21.25, etc.
+  assert.equal(lines[1], 'INV-2026-0001,Northwind Studio,2026-10-07,2026-11-06,issued,425.00,21.25,84.79,488.54,488.54');
+});
+
+test('exportCsv with multiple invoices', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  });
+
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2026-0001']).value;
+
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n');
+
+  assert.equal(lines.length, 4); // header + 2 data + trailing newline
+  assert.match(lines[1], /^INV-2026-0001,Northwind Studio/);
+  assert.match(lines[2], /^INV-2026-0002,Blue Fern Bakery/);
+});
+
+test('exportCsv escapes customer name with comma', () => {
+  const invResult = createInvoice({
+    customerId: 'C-006', // Marlow "The Print Shop" (has quotes)
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // Customer name is: Marlow "The Print Shop"
+  // Should be escaped: "Marlow ""The Print Shop"""
+  assert.match(lines[1], /,"Marlow ""The Print Shop""",/);
+});
+
+test('exportCsv with partially paid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invIssued = issueInvoice(invResult.value, []).value;
+  const invPartial = recordPayment(invIssued, { amount: 10000, date: '2026-10-10' }).value;
+
+  const result = exportCsv([invPartial]);
+  const lines = result.split('\n');
+
+  // Due should be 48854 - 10000 = 38854 cents = 388.54 euros
+  assert.match(lines[1], /partially_paid,.*,388\.54$/);
+});
+
+test('exportCsv with paid invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const invIssued = issueInvoice(invResult.value, []).value;
+  const invPaid = recordPayment(invIssued, { amount: 48854, date: '2026-10-10' }).value;
+
+  const result = exportCsv([invPaid]);
+  const lines = result.split('\n');
+
+  // Due should be 0
+  assert.match(lines[1], /paid,.*,0\.00$/);
+});
+
+test('exportCsv formats amounts with dot and 2 decimals', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // All amounts should have format like 1234.56
+  assert.match(lines[1], /\d+\.\d{2},\d+\.\d{2},\d+\.\d{2},\d+\.\d{2},\d+\.\d{2}$/);
+});
+
+test('exportCsv with invoice with discount', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // Subtotal: 42500 cents = 425.00 euros, Discount: 4250 cents = 42.50 euros, VAT: 8032 cents = 80.32 euros
+  assert.match(lines[1], /425\.00,42\.50,80\.32/);
+});
+
+test('exportCsv with invoice with no discount', () => {
+  const invResult = createInvoice({
+    customerId: 'C-002', // Standard tier, 0% discount
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // Subtotal: 42500 cents = 425.00 euros, Discount: 0
+  assert.match(lines[1], /425\.00,0\.00/);
+});
+
+test('exportCsv with 0% VAT product', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // Subtotal: 60000 cents = 600.00 euros, Discount: 3000 cents = 30.00 euros, VAT: 0
+  assert.match(lines[1], /600\.00,30\.00,0\.00/);
+});
+
+test('exportCsv preserves invoice order', () => {
+  const invResults = [];
+  const invoices = [];
+
+  for (let i = 0; i < 5; i++) {
+    const invResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: `2026-10-0${i + 1}`,
+      lines: [{ sku: 'DES-HOUR', qty: i + 1 }],
+    });
+    invResults.push(invResult);
+    invoices.push(issueInvoice(invResult.value, invoices.map(inv => inv.number).filter(Boolean)).value);
+  }
+
+  const result = exportCsv(invoices);
+  const lines = result.split('\n');
+
+  for (let i = 0; i < invoices.length; i++) {
+    assert.match(lines[i + 1], new RegExp(`^INV-2026-000${i + 1},`));
+  }
+});
+
+test('exportCsv handles customer lookup failure gracefully', () => {
+  const inv = {
+    customerId: 'C-999', // Non-existent customer
+    number: 'INV-2026-0001',
+    issueDate: '2026-10-07',
+    dueDate: '2026-11-06',
+    status: 'issued',
+    lines: [
+      { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21, discountPercent: 0 },
+    ],
+  };
+
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // Customer name should be empty
+  assert.match(lines[1], /^INV-2026-0001,,2026-10-07/);
+});
+
+test('exportCsv with small amounts', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 1 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // STICKER: 50 cents, should show as 0.50
+  assert.match(lines[1], /0\.50/);
+});
+
+test('exportCsv with large amounts', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'BRAND-BOOK', qty: 10 },
+      { sku: 'WORKSHOP-DAY', qty: 5 },
+    ],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // Should have large amounts without thousands separator
+  assert.match(lines[1], /\d+\.\d{2}/);
+  // Make sure no commas in numbers (only field separators)
+  const fields = lines[1].split(',');
+  for (const field of fields.slice(5)) { // Skip first 5 fields (number, customer, dates, status)
+    assert.ok(!field.match(/\d,\d/)); // No comma within number
+  }
+});
+
+test('exportCsv with mixed invoice statuses', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv3Result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-03',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv1Draft = inv1Result.value;
+  const inv2Issued = issueInvoice(inv2Result.value, []).value;
+  const inv3Issued = issueInvoice(inv3Result.value, ['INV-2026-0001']).value;
+  const inv3Partial = recordPayment(inv3Issued, { amount: 5000, date: '2026-10-10' }).value;
+
+  const result = exportCsv([inv1Draft, inv2Issued, inv3Partial]);
+  const lines = result.split('\n');
+
+  assert.match(lines[1], /draft/);
+  assert.match(lines[2], /issued/);
+  assert.match(lines[3], /partially_paid/);
+});
+
+test('exportCsv ends with newline', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+
+  assert.ok(result.endsWith('\n'));
+});
+
+test('exportCsv lines separated by newline', () => {
+  const inv1Result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv2Result = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-02',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv1 = issueInvoice(inv1Result.value, []).value;
+  const inv2 = issueInvoice(inv2Result.value, ['INV-2026-0001']).value;
+
+  const result = exportCsv([inv1, inv2]);
+  const lines = result.split('\n');
+
+  // Should have: header, data1, data2, empty (from trailing \n)
+  assert.equal(lines.length, 4);
+  assert.equal(lines[3], ''); // Empty line from trailing newline
+});
+
+test('exportCsv with multiple lines per invoice', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+  const lines = result.split('\n');
+
+  // Should have: header, one data line (aggregated), empty
+  assert.equal(lines.length, 3);
+  // Totals should include all lines
+  assert.match(lines[1], /\d+\.\d{2}/);
+});
+
+test('exportCsv CSV escaping with quoted customer name', () => {
+  const invResult = createInvoice({
+    customerId: 'C-006', // Marlow "The Print Shop"
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
+  const result = exportCsv([inv]);
+
+  // Should contain properly escaped quotes
+  assert.ok(result.includes('""'));
+});
+
+test('exportCsv with all fields populated', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  });
+
+  const invIssued = issueInvoice(invResult.value, []).value;
+  const invPartial = recordPayment(invIssued, { amount: 10000, date: '2026-10-10' }).value;
+
+  const result = exportCsv([invPartial]);
+  const lines = result.split('\n');
+
+  // Parse the data line
+  const dataLine = lines[1];
+  const fields = dataLine.split(',');
+
+  // Should have all 10 fields
+  // Note: Simple split won't work if any field is quoted, but we know none are in this case
+  assert.ok(fields[0]); // number
+  assert.ok(fields[1]); // customer
+  assert.ok(fields[2]); // issueDate
+  assert.ok(fields[3]); // dueDate
+  assert.ok(fields[4]); // status
+  assert.ok(fields[5]); // subtotal
+  assert.ok(fields[6]); // discount
+  assert.ok(fields[7]); // vat
+  assert.ok(fields[8]); // total
+  assert.ok(fields[9]); // due
+});
+
+test('exportCsv does not mutate input array', () => {
+  const invResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+
+  const inv = issueInvoice(invResult.value, []).value;
