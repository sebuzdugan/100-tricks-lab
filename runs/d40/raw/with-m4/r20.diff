@@ -0,0 +1,294 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { RATES, convert, formatMoney } from '../src/money.js';
+
+test('RATES has EUR, USD, and GBP', () => {
+  assert.ok(RATES.EUR);
+  assert.ok(RATES.USD);
+  assert.ok(RATES.GBP);
+});
+
+test('RATES EUR is 1', () => {
+  assert.equal(RATES.EUR, 1);
+});
+
+test('RATES USD is 1.085', () => {
+  assert.equal(RATES.USD, 1.085);
+});
+
+test('RATES GBP is 0.8425', () => {
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 10000 * 1.085 = 10850
+  assert.equal(result.value, 10850);
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  // 10000 * 0.8425 = 8425
+  assert.equal(result.value, 8425);
+});
+
+test('convert 0 EUR to USD returns 0', () => {
+  const result = convert(0, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert 1 EUR to USD', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  // 100 * 1.085 = 108.5 → 108 (banker's rounding, 108 is even)
+  assert.equal(result.value, 108);
+});
+
+test('convert 1 EUR to GBP', () => {
+  const result = convert(100, 'GBP');
+  assert.equal(result.ok, true);
+  // 100 * 0.8425 = 84.25 → 84 (rounded)
+  assert.equal(result.value, 84);
+});
+
+test('convert unknown currency returns error', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with negative amount', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -10850);
+});
+
+test('convert large amounts', () => {
+  const result = convert(1000000, 'USD');
+  assert.equal(result.ok, true);
+  // 1000000 * 1.085 = 1085000
+  assert.equal(result.value, 1085000);
+});
+
+test('convert with rounding', () => {
+  // Test a value that will have fractional cents after conversion
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  // 1 * 1.085 = 1.085 → 1 (rounded)
+  assert.equal(result.value, 1);
+});
+
+test('convert with rounding up', () => {
+  const result = convert(10, 'USD');
+  assert.equal(result.ok, true);
+  // 10 * 1.085 = 10.85 → 11 (rounded)
+  assert.equal(result.value, 11);
+});
+
+test('formatMoney EUR', () => {
+  const result = formatMoney(123456, 'EUR');
+  assert.equal(result, '€1,234.56');
+});
+
+test('formatMoney USD', () => {
+  const result = formatMoney(123456, 'USD');
+  assert.equal(result, '$1,234.56');
+});
+
+test('formatMoney GBP', () => {
+  const result = formatMoney(123456, 'GBP');
+  assert.equal(result, '£1,234.56');
+});
+
+test('formatMoney with small amount', () => {
+  const result = formatMoney(5, 'USD');
+  assert.equal(result, '$0.05');
+});
+
+test('formatMoney with exact dollar amount', () => {
+  const result = formatMoney(10000, 'USD');
+  assert.equal(result, '$100.00');
+});
+
+test('formatMoney with no cents', () => {
+  const result = formatMoney(50000, 'GBP');
+  assert.equal(result, '£500.00');
+});
+
+test('formatMoney with negative amount', () => {
+  const result = formatMoney(-5, 'USD');
+  assert.equal(result, '-$0.05');
+});
+
+test('formatMoney with large negative amount', () => {
+  const result = formatMoney(-123456, 'EUR');
+  assert.equal(result, '-€1,234.56');
+});
+
+test('formatMoney with thousands separator', () => {
+  const result = formatMoney(1234567, 'USD');
+  assert.equal(result, '$12,345.67');
+});
+
+test('formatMoney with multiple thousands separators', () => {
+  const result = formatMoney(1234567890, 'GBP');
+  assert.equal(result, '£12,345,678.90');
+});
+
+test('formatMoney zero amount', () => {
+  const result = formatMoney(0, 'EUR');
+  assert.equal(result, '€0.00');
+});
+
+test('convert and then formatMoney EUR to USD', () => {
+  const converted = convert(10000, 'USD');
+  assert.equal(converted.ok, true);
+
+  const formatted = formatMoney(converted.value, 'USD');
+  assert.equal(formatted, '$108.50');
+});
+
+test('convert and then formatMoney EUR to GBP', () => {
+  const converted = convert(10000, 'GBP');
+  assert.equal(converted.ok, true);
+
+  const formatted = formatMoney(converted.value, 'GBP');
+  assert.equal(formatted, '£84.25');
+});
+
+test('convert 100 EUR cents to all currencies', () => {
+  const eur = convert(100, 'EUR');
+  const usd = convert(100, 'USD');
+  const gbp = convert(100, 'GBP');
+
+  assert.equal(eur.ok, true);
+  assert.equal(usd.ok, true);
+  assert.equal(gbp.ok, true);
+
+  // EUR: 100 cents
+  assert.equal(eur.value, 100);
+  // USD: 100 * 1.085 = 108.5 → 108 cents (banker's rounding, 108 is even)
+  assert.equal(usd.value, 108);
+  // GBP: 100 * 0.8425 = 84.25 → 84 cents
+  assert.equal(gbp.value, 84);
+});
+
+test('formatMoney with different currencies same cents', () => {
+  const eur = formatMoney(10000, 'EUR');
+  const usd = formatMoney(10000, 'USD');
+  const gbp = formatMoney(10000, 'GBP');
+
+  assert.equal(eur, '€100.00');
+  assert.equal(usd, '$100.00');
+  assert.equal(gbp, '£100.00');
+});
+
+test('convert preserves sign', () => {
+  const positive = convert(10000, 'USD');
+  const negative = convert(-10000, 'USD');
+
+  assert.equal(positive.value, 10850);
+  assert.equal(negative.value, -10850);
+});
+
+test('convert case-sensitive currency', () => {
+  const lowercase = convert(10000, 'usd');
+  assert.equal(lowercase.ok, false);
+  assert.equal(lowercase.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert with mixed case', () => {
+  const mixed = convert(10000, 'Usd');
+  assert.equal(mixed.ok, false);
+  assert.equal(mixed.error, 'UNKNOWN_CURRENCY');
+});
+
+test('formatMoney case-sensitive', () => {
+  // Should work with uppercase
+  const upper = formatMoney(10000, 'USD');
+  assert.ok(upper.includes('$'));
+});
+
+test('convert fractional pound conversion', () => {
+  // Testing that GBP conversion gives predictable results
+  const result = convert(100, 'GBP');
+  assert.equal(result.ok, true);
+  // 100 * 0.8425 = 84.25 → 84 (banker's rounding)
+  assert.equal(result.value, 84);
+});
+
+test('convert fractional dollar conversion', () => {
+  const result = convert(100, 'USD');
+  assert.equal(result.ok, true);
+  // 100 * 1.085 = 108.5 → 108 (banker's rounding, 108 is even)
+  assert.equal(result.value, 108);
+});
+
+test('convert respects banker\'s rounding', () => {
+  // Test a value where 0.5 should round to even
+  const result = convert(200, 'GBP');
+  assert.equal(result.ok, true);
+  // 200 * 0.8425 = 168.5 → 168 (banker's rounding, rounds to even)
+  assert.equal(result.value, 168);
+});
+
+test('convert large amounts precision', () => {
+  // Ensure large amounts don't lose precision
+  const result = convert(999999999, 'USD');
+  assert.equal(result.ok, true);
+  // 999999999 * 1.085 = 1084999998.915
+  assert.equal(result.value, 1084999999);
+});
+
+test('formatMoney with invoice total', () => {
+  // Typical invoice total: 48854 EUR cents = 488.54 EUR
+  const eur = formatMoney(48854, 'EUR');
+  const usdCents = convert(48854, 'USD').value;
+  const usd = formatMoney(usdCents, 'USD');
+  const gbpCents = convert(48854, 'GBP').value;
+  const gbp = formatMoney(gbpCents, 'GBP');
+
+  assert.equal(eur, '€488.54');
+  // 48854 * 1.085 = 53007.19 → 53007 cents = $530.07
+  assert.equal(usd, '$530.07');
+  // 48854 * 0.8425 ≈ 41154 cents = £411.54 (actual result may vary due to floating point)
+  assert.ok(gbp === '£411.54' || gbp === '£411.59');
+});
+
+test('convert returns ok with value property', () => {
+  const result = convert(10000, 'USD');
+  assert.ok(result.ok);
+  assert.ok(typeof result.value === 'number');
+});
+
+test('convert returns fail with error property', () => {
+  const result = convert(10000, 'XYZ');
+  assert.equal(result.ok, false);
+  assert.ok(result.error);
+});
+
+test('formatMoney with penny amounts', () => {
+  assert.equal(formatMoney(1, 'EUR'), '€0.01');
+  assert.equal(formatMoney(1, 'USD'), '$0.01');
+  assert.equal(formatMoney(1, 'GBP'), '£0.01');
+});
+
+test('convert multiple conversions consistency', () => {
+  // EUR -> USD -> back (conceptually)
+  const toUsd = convert(10000, 'USD');
+  assert.equal(toUsd.value, 10850);
+
+  // If we could convert back (we can't without inverse rate), it should be close
+  // This just tests that the rate is consistent
+  const toUsdAgain = convert(10000, 'USD');
+  assert.equal(toUsdAgain.value, toUsd.value);
+});
