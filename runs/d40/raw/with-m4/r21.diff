+  ];
+
+  const invoices = [
+    { customerId: 'C-001', number: 'INV-2026-0001', issueDate: '2026-10-01', status: 'issued', lines: [] },
+    { customerId: 'C-012', number: 'INV-2026-0002', issueDate: '2026-10-02', status: 'issued', lines: [] },
+    { customerId: 'C-012', number: 'INV-2026-0003', issueDate: '2026-10-03', status: 'draft', lines: [] },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-012', 'C-001');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.customers[0].id, 'C-001');
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].customerId, 'C-001');
+  assert.equal(result.value.invoices[1].customerId, 'C-001');
+  assert.equal(result.value.invoices[2].customerId, 'C-001');
+});
