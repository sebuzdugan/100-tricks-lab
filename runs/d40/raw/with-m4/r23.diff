-    return sum + Math.max(0, lineDiscount);
-  }, 0);
-  const vat = invoice.lines.reduce((sum, line) => {
+
+  let discount = 0;
+  let vat = 0;
+
+  for (const line of invoice.lines) {
     const lineTotal$ = lineTotal(line);
-    const lineDiscount = lineTotal$ * (line.discountPercent ?? 0) / 100;
-    const amountAfterDiscount = Math.max(0, lineTotal$ - lineDiscount);
-    const lineVat = amountAfterDiscount * (line.vatRate ?? 0) / 100;
-    return sum + roundCents(lineVat);
-  }, 0);
+
+    // Calculate first discount (explicit or tier-based)
+    const firstDiscount = lineTotal$ * (line.discountPercent ?? 0) / 100;
+    const amountAfterFirstDiscount = Math.max(0, lineTotal$ - firstDiscount);
+
+    // Bulk discount: 2.5% additional discount for quantities >= 10, applied after first discount
+    let bulkDiscount = 0;
+    if (line.qty >= 10) {
+      bulkDiscount = amountAfterFirstDiscount * 0.025;
+    }
+
+    // Total discount for this line
+    discount += firstDiscount + bulkDiscount;
+
+    // Amount after all discounts
+    const amountAfterAllDiscounts = Math.max(0, amountAfterFirstDiscount - bulkDiscount);
+
+    // VAT calculation on amount after both discounts
+    const lineVat = amountAfterAllDiscounts * (line.vatRate ?? 0) / 100;
+    vat += roundCents(lineVat);
+  }
+
   const voucher = invoice.voucher?.amount ?? 0;
   const total = Math.max(0, subtotal - discount + vat - voucher);
   return {
