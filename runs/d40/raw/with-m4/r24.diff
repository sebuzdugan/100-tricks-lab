+/**
+ * Generate a dashboard summary of invoice metrics.
+ * @param {Array<object>} invoices - Array of invoice objects
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    if (counts[invoice.status] !== undefined) {
+      counts[invoice.status]++;
+    }
+  }
+
+  // Calculate outstanding amount (issued and partially_paid invoices)
+  let outstanding = 0;
+  for (const invoice of invoices) {
+    if (['issued', 'partially_paid'].includes(invoice.status)) {
+      outstanding += balanceDue(invoice);
+    }
+  }
+
+  // Get overdue summary
+  const overdueList = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Calculate top customers by amount due
+  const customerDueMap = {};
+  for (const invoice of invoices) {
+    if (['issued', 'partially_paid'].includes(invoice.status)) {
+      const customerId = invoice.customerId;
+      const due = balanceDue(invoice);
+      if (!customerDueMap[customerId]) {
+        customerDueMap[customerId] = 0;
+      }
+      customerDueMap[customerId] += due;
+    }
+  }
+
+  const topCustomers = Object.entries(customerDueMap)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
