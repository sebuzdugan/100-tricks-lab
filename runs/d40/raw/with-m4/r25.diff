+test('renderInvoiceText orders lines correctly', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5, discountPercent: 10 },
+    ],
+    terms: 'NET14',
+  });
+
+  let invoice = applyVoucher(invoiceResult.value, {
+    code: 'TEST',
+    amount: 5000,
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const paid = recordPayment(issued, { amount: 10000, date: '2026-10-10' }).value;
+
+  const result = renderInvoiceText(paid);
+  const text = result.value;
+  const lines = text.split('\n');
+
+  // Order should be: number, customer, blank, items (with discounts), blank, voucher, VAT, total, due, paid
+  const textParts = {
+    invoiceNumber: lines.findIndex(l => l === 'INV-2026-0001'),
+    customer: lines.findIndex(l => l === 'Northwind Studio'),
+    discount: lines.findIndex(l => l.includes('Discount')),
+    voucher: lines.findIndex(l => l.includes('Voucher')),
+    vat: lines.findIndex(l => l.includes('VAT')),
+    total: lines.findIndex(l => l.includes('Total:')),
+    due: lines.findIndex(l => l.includes('Due:')),
+    paid: lines.findIndex(l => l.includes('Paid:')),
+  };
+
+  // Verify order
+  assert.ok(textParts.invoiceNumber < textParts.customer);
+  assert.ok(textParts.customer < textParts.discount);
+  assert.ok(textParts.discount < textParts.voucher);
+  assert.ok(textParts.voucher < textParts.vat);
+  assert.ok(textParts.vat < textParts.total);
+  assert.ok(textParts.total < textParts.due);
+  assert.ok(textParts.due < textParts.paid);
+});
