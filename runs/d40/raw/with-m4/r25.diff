diff --git a/src/render.js b/src/render.js
index 9f13deb..b717ba8 100644
--- a/src/render.js
+++ b/src/render.js
@@ -29,21 +29,43 @@ export function renderInvoiceText(invoice) {
   // Blank line
   lines.push('');
 
-  // Line items
+  // Line items with discount details
   for (const line of invoice.lines) {
-    const total = line.qty * line.unitPrice;
-    const itemLine = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`;
+    const lineSubtotal = line.qty * line.unitPrice;
+    const itemLine = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(lineSubtotal)}`;
     lines.push(itemLine);
+
+    // Show discount if present
+    if (line.discountPercent > 0) {
+      const discount = lineSubtotal * (line.discountPercent / 100);
+      lines.push(`  Discount (${line.discountPercent}%): -${formatEuros(discount)}`);
+    }
   }
 
   // Blank line
   lines.push('');
 
+  // Voucher line (if present, before VAT/Total)
+  if (invoice.voucher) {
+    lines.push(`Voucher (${invoice.voucher.code}): -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   // VAT line
   lines.push(`VAT: ${formatEuros(totals.vat)}`);
 
   // Total line
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Due date line (if invoice has one)
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid line (if invoice has payments)
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(totalPaid)}`);
+  }
+
   return { ok: true, value: lines.join('\n') };
 }
