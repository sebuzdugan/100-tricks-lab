@@ -69,3 +69,62 @@ export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   return { subtotal, total: subtotal };
 }
+
+/**
+ * Add a line to an invoice draft, or increase qty if that SKU already exists.
+ * @param {{ status: string, lines: Array<any> }, { sku: string, qty: number }}
+ */
+export function addLine(invoice, { sku, qty }) {
+  // Check status
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Validate qty
+  if (!Number.isInteger(qty) || qty <= 0) return fail('QTY_INVALID');
+
+  // Get product
+  const productResult = getProduct(sku);
+  if (!productResult.ok) return productResult;
+
+  const product = productResult.value;
+
+  // Check if line already exists
+  const existingLineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+
+  if (existingLineIndex !== -1) {
+    // Line exists, increase qty
+    const newLines = invoice.lines.map((line, i) =>
+      i === existingLineIndex ? { ...line, qty: line.qty + qty } : line
+    );
+    return ok({ ...invoice, lines: newLines });
+  } else {
+    // New line
+    const newLine = {
+      sku,
+      name: product.name,
+      qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    };
+    return ok({ ...invoice, lines: [...invoice.lines, newLine] });
+  }
+}
+
+/**
+ * Remove a line from an invoice draft.
+ * @param {{ status: string, lines: Array<{ sku: string }> }, string }
+ */
+export function removeLine(invoice, sku) {
+  // Check status
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if line exists
+  const lineIndex = invoice.lines.findIndex((line) => line.sku === sku);
+  if (lineIndex === -1) return fail('LINE_NOT_FOUND');
+
+  // Check if it's the last line
+  if (invoice.lines.length === 1) return fail('NO_LINES');
+
+  // Remove the line
+  const newLines = invoice.lines.filter((_, i) => i !== lineIndex);
+  return ok({ ...invoice, lines: newLines });
+}
