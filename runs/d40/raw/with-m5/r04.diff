index 0000000..dc52938
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,22 @@
+/**
+ * Get the next free invoice number for a given issue date.
+ * Format: INV-YYYY-NNNN where NNNN restarts at 0001 each year.
+ * @param {Array<string>} existingNumbers - Invoice numbers already used, in any order
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Filter numbers for this year
+  const thisYearPattern = new RegExp(`^INV-${year}-\\d{4}$`);
+  const thisYearNumbers = existingNumbers.filter((n) => thisYearPattern.test(n));
+
+  // Extract counters and find max
+  const counters = thisYearNumbers.map((n) => parseInt(n.substring(n.lastIndexOf('-') + 1), 10));
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+
+  // Return next counter
+  const nextCounter = maxCounter + 1;
+  return `INV-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
