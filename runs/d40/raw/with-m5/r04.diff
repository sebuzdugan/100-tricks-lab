+/**
+ * Issue an invoice draft, assigning it a number and changing status to 'issued'.
+ * @param {{ status: string, issueDate: string }, Array<string> }
+ */
+export function issueInvoice(invoice, existingNumbers) {
+  // Check status
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Get next invoice number
+  const number = nextInvoiceNumber(existingNumbers, invoice.issueDate);
+
+  // Return issued invoice
+  return ok({ ...invoice, status: 'issued', number });
+}
