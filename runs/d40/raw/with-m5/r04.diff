diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..3ed3e10
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,42 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments counter within the same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0005'];
+  const number = nextInvoiceNumber(existing, '2026-12-31');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber restarts counter for new year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-9999'];
+  const number = nextInvoiceNumber(existing, '2026-01-01');
+  assert.equal(number, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2025-9999', 'INV-2026-0001', 'INV-2027-0001'];
+  const number = nextInvoiceNumber(existing, '2026-06-15');
+  assert.equal(number, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber finds max counter correctly with unordered input', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'];
+  const number = nextInvoiceNumber(existing, '2026-11-20');
+  assert.equal(number, 'INV-2026-0006');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = ['INV-2026-0099'];
+  const number = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(number, 'INV-2026-0100');
+
+  const existing2 = ['INV-2026-9999'];
+  const number2 = nextInvoiceNumber(existing2, '2026-10-07');
+  assert.equal(number2, 'INV-2026-10000');
+});
