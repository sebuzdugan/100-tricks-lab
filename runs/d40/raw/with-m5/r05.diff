+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { ok, fail } from './result.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text: number/DRAFT, customer, line items, total.
+ * All amounts are formatted with formatEuros().
+ * @param {{ customerId: string, number?: string, lines: Array<any> }}
+ */
+export function renderInvoiceText(invoice) {
+  // Look up customer
+  const customerResult = getCustomer(invoice.customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const customer = customerResult.value;
+
+  // Build lines
+  const lines = [];
+
+  // Invoice number or DRAFT
+  lines.push(invoice.number ?? 'DRAFT');
+
+  // Customer name
+  lines.push(customer.name);
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    lines.push(`${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(total)}`);
+  }
+
+  // Total
+  const total = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return ok(lines.join('\n'));
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..1f636e4
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,135 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const inv = r.value;
+
+  const r2 = renderInvoiceText(inv);
+  assert.equal(r2.ok, true);
+  const text = r2.value;
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+  assert.ok(text.includes('5 Design work (hour)'));
+  assert.ok(text.includes('€85.00'));
+  assert.ok(text.includes('€425.00'));
+  assert.ok(text.includes('Total: €425.00'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const inv = r.value;
+
+  const r2 = issueInvoice(inv, []);
+  const issued = r2.value;
+
+  const r3 = renderInvoiceText(issued);
+  assert.equal(r3.ok, true);
+  const text = r3.value;
+  assert.ok(text.includes('INV-2026-0001'));
+  assert.ok(text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText renders multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  });
+  const inv = r.value;
+
+  const r2 = renderInvoiceText(inv);
+  assert.equal(r2.ok, true);
+  const text = r2.value;
+  const lines = text.split('\n');
+  assert.equal(lines.length, 5); // DRAFT + customer + 2 lines + total
+  assert.ok(text.includes('5 Design work (hour)'));
+  assert.ok(text.includes('3 Development (hour)'));
+  assert.ok(text.includes('Total: €710.00'));
+});
+
+test('renderInvoiceText shows line totals correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+  });
+  const inv = r.value;
+
+  const r2 = renderInvoiceText(inv);
+  const text = r2.value;
+  // LOGO-PACK: €1,200.00 each, 2 × = €2,400.00
+  assert.ok(text.includes('2 Logo package €1,200.00 €2,400.00'));
+});
+
+test('renderInvoiceText formats all amounts with formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'ICON-SET', qty: 10 },
+      { sku: 'STICKER', qty: 1000 },
+    ],
+  });
+  const inv = r.value;
+
+  const r2 = renderInvoiceText(inv);
+  const text = r2.value;
+  // ICON-SET: €9.80 each, 10 × = €98.00
+  // STICKER: €0.50 each, 1000 × = €500.00
+  // Total: €598.00
+  assert.ok(text.includes('€9.80'));
+  assert.ok(text.includes('€98.00'));
+  assert.ok(text.includes('€0.50'));
+  assert.ok(text.includes('€500.00'));
+  assert.ok(text.includes('Total: €598.00'));
+});
+
+test('renderInvoiceText reports CUSTOMER_NOT_FOUND', () => {
+  const inv = {
+    customerId: 'C-999',
+    issueDate: '2026-10-07',
+    status: 'draft',
+    lines: [{ sku: 'DES-HOUR', qty: 5, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+  };
+
+  const r = renderInvoiceText(inv);
+  assert.deepEqual(r, { ok: false, error: 'CUSTOMER_NOT_FOUND' });
+});
+
+test('renderInvoiceText produces multi-line text', () => {
+  const r = createInvoice({
+    customerId: 'C-004',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  const inv = r.value;
+
+  const r2 = issueInvoice(inv, []);
+  const issued = r2.value;
+
+  const r3 = renderInvoiceText(issued);
+  const text = r3.value;
+  const lines = text.split('\n');
+  assert.equal(lines[0], 'INV-2026-0001');
+  assert.equal(lines[1], 'Smith, Jones & Partners');
+  assert.ok(lines[2].includes('10 Design work (hour)'));
+  assert.ok(lines[3].includes('5 Development (hour)'));
+  assert.equal(lines[4], 'Total: €1,325.00');
+});
