@@ -84,8 +86,15 @@ export function invoiceTotals(invoice) {
     const lineDiscount = lineTotal(line) * (line.discountPercent ?? 0) / 100;
     return sum + lineDiscount;
   }, 0);
-  const total = Math.max(0, subtotal - discount);
-  return { subtotal, discount, total };
+  const vat = invoice.lines.reduce((sum, line) => {
+    const lineAmount = lineTotal(line);
+    const lineDiscount = lineAmount * (line.discountPercent ?? 0) / 100;
+    const amountAfterDiscount = lineAmount - lineDiscount;
+    const lineVat = roundCents(amountAfterDiscount * (line.vatRate ?? 0) / 100);
+    return sum + lineVat;
+  }, 0);
+  const total = Math.max(0, subtotal - discount + vat);
+  return { subtotal, discount, vat, total };
 }
 
