+ * Calculate subtotal, discount, VAT and total for an invoice. Subtotal is the sum of line totals.
+ * Discount is the sum of line discounts. VAT is computed per line on the amount after discount, then rounded and summed.
+ * Total = subtotal - discount + vat, clamped at 0.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }> }}
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
  */
 export function invoiceTotals(invoice) {
