+/**
+ * Check if text is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(String(text))) return false;
+
+  const parts = String(text).split('-').map(Number);
+  const [year, month, day] = parts;
+
+  // Create date in UTC and verify it matches the input
+  const date = new Date(Date.UTC(year, month - 1, day));
+  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
+}
+
+/**
+ * Add n days to a date string. Works in UTC.
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add
+ * @returns {string} - Date in YYYY-MM-DD format
+ */
+export function addDays(date, n) {
+  const parts = date.split('-').map(Number);
+  const [year, month, day] = parts;
+
+  const d = new Date(Date.UTC(year, month - 1, day));
+  d.setUTCDate(d.getUTCDate() + n);
+
+  const y = d.getUTCFullYear();
+  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const resultDay = String(d.getUTCDate()).padStart(2, '0');
+
+  return `${y}-${m}-${resultDay}`;
+}
+
+/**
+ * Calculate days between two dates. Works in UTC.
+ * @param {string} a - First date in YYYY-MM-DD format
+ * @param {string} b - Second date in YYYY-MM-DD format
+ * @returns {number} - Number of days (b - a), positive if b is later, negative if earlier
+ */
+export function daysBetween(a, b) {
+  const partsA = a.split('-').map(Number);
+  const partsB = b.split('-').map(Number);
+
+  const date1 = new Date(Date.UTC(partsA[0], partsA[1] - 1, partsA[2]));
+  const date2 = new Date(Date.UTC(partsB[0], partsB[1] - 1, partsB[2]));
+
+  const diff = date2 - date1;
+  return Math.floor(diff / (1000 * 60 * 60 * 24));
+}
