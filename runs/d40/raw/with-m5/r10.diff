diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..bb31e58
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,151 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+// isValidDate tests
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2026-02-28'), true);
+  assert.equal(isValidDate('2024-02-29'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('01-01-2026'), false);
+  assert.equal(isValidDate('2026/01/01'), false);
+  assert.equal(isValidDate('2026-1-1'), false);
+  assert.equal(isValidDate('2026-01-1'), false);
+  assert.equal(isValidDate('2026-1-01'), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-01-32'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate handles leap years correctly', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2026-02-29'), false);
+  assert.equal(isValidDate('2027-02-29'), false);
+  assert.equal(isValidDate('2028-02-29'), true);
+});
+
+test('isValidDate rejects empty/invalid inputs', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate('not a date'), false);
+  assert.equal(isValidDate('2026'), false);
+});
+
+test('isValidDate works with various valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2000-01-01'), true);
+  assert.equal(isValidDate('2099-12-31'), true);
+});
+
+// addDays tests
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-01-01', 1), '2026-01-02');
+  assert.equal(addDays('2026-01-01', 30), '2026-01-31');
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+});
+
+test('addDays handles month boundaries', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+  assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+});
+
+test('addDays handles leap year boundaries', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2026-01-02', -1), '2026-01-01');
+  assert.equal(addDays('2026-02-01', -1), '2026-01-31');
+  assert.equal(addDays('2027-01-01', -1), '2026-12-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2026-01-01', 0), '2026-01-01');
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays handles large day counts', () => {
+  assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+  assert.equal(addDays('2024-01-01', 366), '2025-01-01');
+});
+
+// daysBetween tests
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+  assert.equal(daysBetween('2026-01-01', '2026-01-31'), 30);
+  assert.equal(daysBetween('2026-01-01', '2026-02-01'), 31);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-01-02', '2026-01-01'), -1);
+  assert.equal(daysBetween('2026-02-01', '2026-01-01'), -31);
+});
+
+test('daysBetween handles same dates', () => {
+  assert.equal(daysBetween('2026-01-01', '2026-01-01'), 0);
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles month boundaries', () => {
+  assert.equal(daysBetween('2026-01-31', '2026-02-01'), 1);
+  assert.equal(daysBetween('2026-02-01', '2026-01-31'), -1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.equal(daysBetween('2026-12-31', '2027-01-01'), 1);
+  assert.equal(daysBetween('2027-01-01', '2026-12-31'), -1);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('daysBetween handles large date ranges', () => {
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween works correctly across years', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-14'), 7);
+  assert.equal(daysBetween('2026-10-07', '2027-10-07'), 365);
+  assert.equal(daysBetween('2025-10-07', '2026-10-07'), 365);
+});
+
+// Combined functionality tests
+test('addDays and daysBetween are inverses', () => {
+  const start = '2026-01-15';
+  const n = 42;
+  const end = addDays(start, n);
+  assert.equal(daysBetween(start, end), n);
+});
+
+test('roundtrip: add days then calculate difference', () => {
+  const date1 = '2026-03-15';
+  const date2 = addDays(date1, 100);
+  const date3 = addDays(date2, -50);
+  assert.equal(daysBetween(date1, date3), 50);
+});
+
+test('date operations work in UTC (consistent across time zones)', () => {
+  // These tests verify that dates are handled in UTC
+  const date1 = '2026-01-01';
+  const date2 = '2026-01-02';
+  // The difference should always be 1 day regardless of local timezone
+  assert.equal(daysBetween(date1, date2), 1);
+
+  const date3 = addDays(date1, 1);
+  assert.equal(date3, date2);
+});
