+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+// balanceDue tests
+test('balanceDue equals total for unpaid issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const inv = r.value;
+  const r2 = issueInvoice(inv, []);
+  const issued = r2.value;
+
+  // Total should be 48854 (42500 - 2125 discount + 8479 VAT)
+  const balance = balanceDue(issued);
+  assert.equal(balance, 48854);
+});
+
+test('balanceDue decreases after a payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const inv = r.value;
+  const r2 = issueInvoice(inv, []);
+  const issued = r2.value;
+
+  const r3 = recordPayment(issued, { amount: 10000, date: '2026-10-15' });
+  assert.equal(r3.ok, true);
+  const afterPayment = r3.value;
+
+  const balance = balanceDue(afterPayment);
+  assert.equal(balance, 38854);
+});
+
+test('balanceDue is zero for fully paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const inv = r.value;
+  const r2 = issueInvoice(inv, []);
+  const issued = r2.value;
+
+  const r3 = recordPayment(issued, { amount: 48854, date: '2026-10-15' });
+  assert.equal(r3.ok, true);
+  const afterPayment = r3.value;
+
+  const balance = balanceDue(afterPayment);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue on invoice without payments array', () => {
+  const inv = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [{ sku: 'DES-HOUR', qty: 5, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21, discountPercent: 5 }],
+  };
+
+  const balance = balanceDue(inv);
+  assert.equal(balance, 48854);
+});
+
+// recordPayment tests
+test('recordPayment records a single payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const inv = r.value;
+  const r2 = issueInvoice(inv, []);
+  const issued = r2.value;
+
+  const r3 = recordPayment(issued, { amount: 10000, date: '2026-10-15' });
+  assert.equal(r3.ok, true);
+  const afterPayment = r3.value;
+  assert.equal(afterPayment.payments.length, 1);
+  assert.equal(afterPayment.payments[0].amount, 10000);
+  assert.equal(afterPayment.payments[0].date, '2026-10-15');
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const inv = {
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
