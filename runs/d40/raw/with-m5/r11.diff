+test('recordPayment works with complex invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'LOGO-PACK', qty: 1 },
+    ],
+  });
+  const inv = r.value;
+  const r2 = issueInvoice(inv, []);
+  const issued = r2.value;
+
+  // Make a partial payment
+  const r3 = recordPayment(issued, { amount: 50000, date: '2026-10-15' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'partially_paid');
+
+  // Make another partial payment
+  const r4 = recordPayment(r3.value, { amount: 50000, date: '2026-10-20' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.status, 'partially_paid');
+
+  // Final payment
+  const balance = balanceDue(r4.value);
+  const r5 = recordPayment(r4.value, { amount: balance, date: '2026-10-25' });
+  assert.equal(r5.ok, true);
+  assert.equal(r5.value.status, 'paid');
+  assert.equal(r5.value.payments.length, 3);
+});
