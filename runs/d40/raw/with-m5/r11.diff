+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the balance due on an invoice (total minus payments made).
+ * @param {{ lines: Array<any>, payments?: Array<{ amount: number }> }}
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return totals.total - totalPaid;
+}
+
+/**
+ * Record a payment against an issued or partially_paid invoice.
+ * Updates status to 'paid' when fully paid, 'partially_paid' otherwise.
+ * @param {{ status: string, lines: Array<any>, payments?: Array<any> }, { amount: number, date: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Check status
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check for overpayment
+  const balance = balanceDue(invoice);
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Add payment
+  const payments = [...(invoice.payments ?? []), { amount, date }];
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  const totals = invoiceTotals(invoice);
+
+  // Determine new status
+  const newStatus = totalPaid >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({ ...invoice, payments, status: newStatus });
+}
