@@ -3,13 +3,36 @@ import { getProduct } from './catalogue.js';
 import { ok, fail } from './result.js';
 import { nextInvoiceNumber } from './numbering.js';
 import { roundCents } from './money.js';
-import { isValidDate } from './dates.js';
+import { isValidDate, addDays } from './dates.js';
+
+/**
+ * Calculate the due date based on payment terms.
+ * NET14: 14 days from issue date, NET30: 30 days, EOM: last day of issue month.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - 'NET14', 'NET30', or 'EOM'
+ * @returns {string | null} - Due date in YYYY-MM-DD format, or null if terms invalid
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-');
+    const nextMonth = String(parseInt(month) + 1).padStart(2, '0');
+    const nextYear = nextMonth === '13' ? String(parseInt(year) + 1) : year;
+    const nextMonthFixed = nextMonth === '13' ? '01' : nextMonth;
+    const lastDayOfMonth = addDays(`${nextYear}-${nextMonthFixed}-01`, -1);
+    return lastDayOfMonth;
+  }
+  return null;
+}
 
 /**
  * Create a new invoice draft.
- * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }>, terms?: string }}
  */
-export function createInvoice({ customerId, issueDate, lines }) {
+export function createInvoice({ customerId, issueDate, lines, terms = 'NET30' }) {
   // Normalize and validate customer
   const normalizedCustomerId = normalizeId(customerId);
   const customerResult = getCustomer(normalizedCustomerId);
@@ -19,6 +42,10 @@ export function createInvoice({ customerId, issueDate, lines }) {
   // Validate date format and check if it's a real date
   if (!isValidDate(issueDate)) return fail('DATE_INVALID');
 
+  // Validate and calculate due date
+  const dueDate = calculateDueDate(issueDate, terms);
+  if (!dueDate) return fail('TERMS_INVALID');
+
   // Validate lines
   if (!Array.isArray(lines) || lines.length === 0) return fail('NO_LINES');
 
@@ -56,6 +83,8 @@ export function createInvoice({ customerId, issueDate, lines }) {
     customerId: normalizedCustomerId,
