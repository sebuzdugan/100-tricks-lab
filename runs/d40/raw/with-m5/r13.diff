 /**
- * Calculate subtotal, discount, VAT and total for an invoice. Subtotal is the sum of line totals.
+ * Calculate subtotal, discount, VAT, voucher and total for an invoice. Subtotal is the sum of line totals.
  * Discount is the sum of line discounts. VAT is computed per line on the amount after discount, then rounded and summed.
- * Total = subtotal - discount + vat, clamped at 0.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }> }}
- * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
+ * Voucher is a fixed amount off (applied after VAT).
+ * Total = subtotal - discount + vat - voucher, clamped at 0.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
@@ -118,8 +119,9 @@ export function invoiceTotals(invoice) {
     const lineVat = roundCents(amountAfterDiscount * (line.vatRate ?? 0) / 100);
     return sum + lineVat;
   }, 0);
-  const total = Math.max(0, subtotal - discount + vat);
-  return { subtotal, discount, vat, total };
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return { subtotal, discount, vat, voucher, total };
 }
 
 /**
@@ -207,3 +209,22 @@ export function issueInvoice(invoice, existingNumbers) {
   // Return issued invoice
   return ok({ ...invoice, status: 'issued', number });
 }
+
+/**
+ * Apply a voucher to a draft invoice. The voucher is a fixed amount off, applied after VAT.
+ * @param {{ status: string, voucher?: any }, { code: string, amount: number }}
+ */
+export function applyVoucher(invoice, { code, amount }) {
+  // Check status
+  if (invoice.status !== 'draft') return fail('NOT_DRAFT');
+
+  // Check if voucher already exists
+  if (invoice.voucher) return fail('VOUCHER_EXISTS');
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  return ok({ ...invoice, voucher: { code, amount } });
+}
