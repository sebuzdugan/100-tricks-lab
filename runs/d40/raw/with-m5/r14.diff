+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const partial1 = recordPayment(issued, { amount: 20000, date: '2026-10-10' }).value;
+  const partial2 = recordPayment(partial1, { amount: 15000, date: '2026-10-15' }).value;
