+
+test('statement sorts invoices by issueDate', () => {
+  const inv3 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  }).value;
+  const issued3 = issueInvoice(inv3, []).value;
+
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, ['INV-2026-0001']).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001', 'INV-2026-0002']).value;
+
+  const invoices = [issued3, issued1, issued2];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 3);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+  assert.equal(r.value.invoices[1].issueDate, '2026-10-10');
+  assert.equal(r.value.invoices[2].issueDate, '2026-10-15');
+});
+
+test('statement calculates totalDue', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const invoices = [issued1, issued2];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  // Both invoices are for gold tier customer (5% discount)
+  // inv1: 42500 - 2125 + 8479 = 48854
+  // inv2: 25500 - 1275 + 5087 = 29312
+  // total: 78166
+  assert.equal(r.value.totalDue, 78166);
+});
+
+test('statement calculates totalDue with partial payments', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+  const paid1 = recordPayment(issued1, { amount: 20000, date: '2026-10-15' }).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-10',
+    lines: [{ sku: 'DES-HOUR', qty: 3 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+  const paid2 = recordPayment(issued2, { amount: 10000, date: '2026-10-20' }).value;
+
+  const invoices = [paid1, paid2];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  // inv1 due: 48854 - 20000 = 28854
+  // inv2 due: 29312 - 10000 = 19312
+  // total due: 48166
+  assert.equal(r.value.totalDue, 48166);
+});
+
+test('statement includes issueDate, dueDate, and total in invoice records', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET14',
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const invoices = [issued];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  const inv_stmt = r.value.invoices[0];
+  assert.equal(inv_stmt.number, 'INV-2026-0001');
+  assert.equal(inv_stmt.issueDate, '2026-10-01');
+  assert.equal(inv_stmt.dueDate, '2026-10-15');
+  assert.equal(inv_stmt.total, 48854);
+  assert.equal(inv_stmt.due, 48854);
+});
+
