+test('statement handles complex invoices with discounts and vouchers', () => {
+  const inv = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-01',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'DEV-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const withVoucher = applyVoucher(inv, { code: 'PROMO', amount: 5000 }).value;
+  const issued = issueInvoice(withVoucher, []).value;
+  const paid = recordPayment(issued, { amount: 30000, date: '2026-10-15' }).value;
+
+  const invoices = [paid];
+  const r = statement('C-003', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  // C-003 is silver tier (2.5% discount)
+  // 42500 + 28500 = 71000
+  // discount line 1 = 1062.5, discount line 2 = 712.5, total = 1775
+  // VAT line 1 = 8702, VAT line 2 = 5835, total = 14537
+  // total = 71000 - 1775 + 14537 - 5000 = 78762
+  // due = 78762 - 30000 = 48762
+  const inv_stmt = r.value.invoices[0];
+  assert.equal(inv_stmt.total, 78762);
+  assert.equal(inv_stmt.due, 48762);
+});
