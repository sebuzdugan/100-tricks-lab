+import { getCustomer } from './customers.js';
+import { ok } from './result.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement: list of outstanding invoices with balances due.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate: string, lines: Array<any>, status: string, payments?: Array<any>, voucher?: any }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Verify customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer with eligible statuses and dates
+  const eligibleInvoices = invoices.filter((inv) => {
+    const isCustomer = inv.customerId === customerResult.value.id;
+    const hasNumber = inv.number !== undefined;
+    const isEligibleStatus = inv.status === 'issued' || inv.status === 'partially_paid';
+    const isEligibleDate = inv.issueDate <= asOf;
+    return isCustomer && hasNumber && isEligibleStatus && isEligibleDate;
+  });
+
+  // Calculate due amounts and build statement lines
+  const statementInvoices = eligibleInvoices.map((inv) => {
+    const due = balanceDue(inv);
+    const totals = invoiceTotals(inv);
+    return {
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: totals.total,
+      due,
+    };
+  });
+
+  // Sort by issueDate
+  statementInvoices.sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: customerResult.value.id,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
