+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement returns empty list for customer with no issued invoices', () => {
+  const invoices = [];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.customerId, 'C-001');
+  assert.equal(r.value.invoices.length, 0);
+  assert.equal(r.value.totalDue, 0);
+});
+
+test('statement includes only issued invoices', () => {
+  const draft = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-05',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issuedWithNumber = issueInvoice(issued, []).value;
+
+  const invoices = [draft, issuedWithNumber];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].number, 'INV-2026-0001');
+});
+
+test('statement includes partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+  const withPayment = recordPayment(issued, { amount: 10000, date: '2026-10-15' }).value;
+
+  const invoices = [withPayment];
+  const r = statement('C-001', invoices, '2026-10-31');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].due, 38854); // 48854 - 10000
+});
+
+test('statement filters by asOf date', () => {
+  const inv1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const invoices = [issued1, issued2];
+  const r = statement('C-001', invoices, '2026-10-10');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+  assert.equal(r.value.invoices[0].issueDate, '2026-10-01');
+});
+
+test('statement includes invoices issued on asOf date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const invoices = [issued];
+  const r = statement('C-001', invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 1);
+});
+
+test('statement excludes invoices after asOf date', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-16',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const invoices = [issued];
+  const r = statement('C-001', invoices, '2026-10-15');
+  assert.equal(r.ok, true);
+  assert.equal(r.value.invoices.length, 0);
+});
+
