+  assert.equal(r2025.value.number, 'CN-2025-0001');
+
+  const r2026 = createCreditNote(issued2026, { amount: 3000, reason: 'Refund', date: '2026-01-20' }, ['CN-2025-0001']);
+  assert.equal(r2026.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote handles mixed invoice and credit note numbers', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const existingNumbers = [
+    'INV-2026-0001',
+    'INV-2026-0002',
+    'CN-2026-0001',
+    'INV-2026-0003',
+    'CN-2026-0002',
