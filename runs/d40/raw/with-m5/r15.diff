+
+  const r = createCreditNote(issued, { amount: 5000.5, reason: 'Discount applied', date: '2026-10-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for zero amount', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
