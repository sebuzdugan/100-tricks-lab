+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for an issued invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+
+  const r = createCreditNote(issued, { amount: 5000, reason: 'Discount applied', date: '2026-10-20' }, []);
+  assert.equal(r.ok, true);
+  const cn = r.value;
+  assert.equal(cn.number, 'CN-2026-0001');
+  assert.equal(cn.invoiceNumber, 'INV-2026-0001');
+  assert.equal(cn.customerId, 'C-001');
+  assert.equal(cn.amount, 5000);
+  assert.equal(cn.reason, 'Discount applied');
+  assert.equal(cn.date, '2026-10-20');
+});
+
+test('createCreditNote works on partially_paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const partial = recordPayment(issued, { amount: 10000, date: '2026-10-15' }).value;
+
+  const r = createCreditNote(partial, { amount: 5000, reason: 'Partial refund', date: '2026-10-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works on paid invoices', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+  const issued = issueInvoice(inv, []).value;
+  const paid = recordPayment(issued, { amount: 48854, date: '2026-10-15' }).value;
+
+  const r = createCreditNote(paid, { amount: 5000, reason: 'Refund requested', date: '2026-10-20' }, []);
+  assert.equal(r.ok, true);
+  assert.equal(r.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote reports NOT_ISSUED for draft invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const r = createCreditNote(inv, { amount: 5000, reason: 'Discount applied', date: '2026-10-20' }, []);
+  assert.deepEqual(r, { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for non-integer amount', () => {
