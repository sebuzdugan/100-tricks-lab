+  assert.equal(r1.value.number, 'CN-2026-0001');
+
+  const r2 = createCreditNote(issued2, { amount: 3000, reason: 'Refund', date: '2026-10-25' }, ['CN-2026-0001']);
+  assert.equal(r2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote restarts counter for new year', () => {
+  const inv2025 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
