+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Get the next free credit note number for a given issue date.
+ * Format: CN-YYYY-NNNN where NNNN restarts at 0001 each year.
+ * @param {Array<string>} existingNumbers - Invoice and credit note numbers, in any order
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+
+  // Filter credit note numbers for this year
+  const thisYearPattern = new RegExp(`^CN-${year}-\\d{4}$`);
+  const thisYearNumbers = existingNumbers.filter((n) => thisYearPattern.test(n));
+
+  // Extract counters and find max
+  const counters = thisYearNumbers.map((n) => parseInt(n.substring(n.lastIndexOf('-') + 1), 10));
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+
+  // Return next counter
+  const nextCounter = maxCounter + 1;
+  return `CN-${year}-${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array<any> }, { amount: number, reason: string, date: string }, Array<string> }
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check status
+  if (invoice.status === 'draft') return fail('NOT_ISSUED');
+
+  // Validate amount
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check credit amount doesn't exceed invoice total
+  const invoiceTotal = invoiceTotals(invoice).total;
+  if (amount > invoiceTotal) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Get next credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
