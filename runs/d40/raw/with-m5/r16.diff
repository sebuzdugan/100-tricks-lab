+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Find overdue invoices: those issued or partially_paid with dueDate before asOf.
+ * Sorted by most overdue first (highest daysOverdue).
+ * @param {Array<{ number?: string, customerId: string, status: string, dueDate: string, lines: Array<any>, payments?: Array<any> }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  const overdue = invoices
+    .filter(inv => (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate < asOf && inv.number)
+    .map(inv => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+
+  return overdue;
+}
