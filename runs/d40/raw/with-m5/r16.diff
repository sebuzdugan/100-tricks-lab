+  const issued1 = issueInvoice(inv1, []).value;
+
+  const inv2 = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-09-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'NET30',
+  }).value;
+  const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+  const inv3 = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-09-25',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    terms: 'EOM',
+  }).value;
+  const issued3 = issueInvoice(inv3, ['INV-2026-0001', 'INV-2026-0002']).value;
+
+  const invoices = [issued1, issued2, issued3];
+  const r = overdueInvoices(invoices, '2026-10-31');
+  // NET14: 2026-09-15 + 14 = 2026-09-29 (32 days overdue)
+  // NET30: 2026-09-20 + 30 = 2026-10-20 (11 days overdue)
+  // EOM: 2026-09-25, end of month = 2026-09-30 (31 days overdue)
+  assert.equal(r.length, 3);
+  assert.equal(r[0].daysOverdue, 32); // Most overdue
+  assert.equal(r[1].daysOverdue, 31);
+  assert.equal(r[2].daysOverdue, 11); // Least overdue
+});
