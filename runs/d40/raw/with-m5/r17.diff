+/**
+ * Summarize VAT by rate for invoices with status issued, partially_paid, or paid.
+ * Base is the line amount after discount. VAT is calculated per line at that rate, then rounded and summed.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate descending (high to low)
+ */
+export function vatSummary(invoices) {
+  const summary = {};
+
+  for (const inv of invoices) {
+    if (inv.status !== 'issued' && inv.status !== 'partially_paid' && inv.status !== 'paid') continue;
+
+    for (const line of inv.lines) {
+      const lineAmount = line.qty * line.unitPrice;
+      const lineDiscount = lineAmount * (line.discountPercent ?? 0) / 100;
+      const baseAmount = lineAmount - lineDiscount;
+      const lineVat = roundCents(baseAmount * (line.vatRate ?? 0) / 100);
+
+      const rate = line.vatRate ?? 0;
+      if (!summary[rate]) {
+        summary[rate] = { rate, base: 0, vat: 0 };
+      }
+      summary[rate].base += baseAmount;
+      summary[rate].vat += lineVat;
+    }
+  }
+
+  return Object.values(summary)
+    .sort((a, b) => b.rate - a.rate);
+}
