+/**
+ * Calculate late fee on an invoice: 0.04% of amount due for each day overdue, or 0 if not overdue.
+ * @param {{ dueDate: string, status: string, lines: Array<any>, payments?: Array<any> }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents, rounded to whole cents
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const amountDue = balanceDue(invoice);
+
+  return roundCents(amountDue * 0.0004 * daysOverdue);
+}
+
