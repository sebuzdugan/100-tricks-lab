+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as euros with 2 decimals and a dot (no currency sign, no thousands separator).
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEurosPlain(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: wrap in double quotes if it contains comma or double quote,
+ * and double any double quotes inside it.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  const str = String(field);
+  if (str.includes(',') || str.includes('"')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Export invoices to CSV format.
+ * Header: number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due
+ * One line per invoice. Amounts in plain euros with 2 decimals and dot.
+ * Lines end with \n.
+ * @param {Array<{ number?: string, customerId: string, issueDate: string, dueDate: string, status: string, lines: Array<any>, payments?: Array<any> }>} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const rows = invoices.map(inv => {
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const number = inv.number ?? '';
+    const fields = [
+      number,
+      customerName,
+      inv.issueDate,
+      inv.dueDate,
+      inv.status,
+      formatEurosPlain(totals.subtotal),
+      formatEurosPlain(totals.discount),
+      formatEurosPlain(totals.vat),
+      formatEurosPlain(totals.total),
+      formatEurosPlain(due),
+    ];
+
+    return fields.map(escapeCsvField).join(',') + '\n';
+  });
+
+  return header + rows.join('');
+}
