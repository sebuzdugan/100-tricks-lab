+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv exports single invoice', () => {
+  const inv = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-09-01',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const issued = issueInvoice(inv, []).value;
+
+  const csv = exportCsv([issued]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3); // header + 1 invoice + empty trailing
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.ok(lines[1].includes('INV-2026-0001'));
+  assert.ok(lines[1].includes('Northwind Studio'));
+  assert.ok(lines[1].includes('2026-09-01'));
+  assert.ok(lines[1].includes('2026-10-01'));
+  assert.ok(lines[1].includes('issued'));
+});
