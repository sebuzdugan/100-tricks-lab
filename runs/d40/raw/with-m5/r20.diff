@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,36 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount from EUR cents to another currency.
+ * @param {number} eurCents - Amount in EUR cents
+ * @param {string} currency - Target currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }} Amount in target currency cents
+ */
+export function convert(eurCents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const euros = eurCents / 100;
+  const amount = euros * RATES[currency];
+  const cents = roundCents(amount * 100);
+
+  return ok(cents);
+}
+
+/**
+ * Format currency amount with appropriate sign for USD, GBP, or EUR.
+ * Similar to formatEuros but for any supported currency: $1,234.56, £1,234.56, €1,234.56.
+ * @param {number} cents - Amount in the target currency's cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const currencySign = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+  const amount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${currencySign}${amount}.${String(abs % 100).padStart(2, '0')}`;
+}
