+// Currency conversion tests
+test('RATES has correct values', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to EUR returns same amount', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  // 100 EUR = 100 * 1.085 = 108.5 USD = 10850 cents
+  assert.equal(result.value, 10850);
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  // 100 EUR = 100 * 0.8425 = 84.25 GBP = 8425 cents
+  assert.equal(result.value, 8425);
+});
+
+test('convert with rounding', () => {
+  const result = convert(1, 'USD');
+  assert.equal(result.ok, true);
+  // 0.01 EUR = 0.01 * 1.085 = 0.01085 USD ≈ 1.085 cents → 1 cent (rounded)
+  assert.equal(result.value, 1);
+});
+
+test('convert with fractional cents rounds correctly', () => {
+  const result = convert(1000, 'GBP');
+  assert.equal(result.ok, true);
+  // 10 EUR = 10 * 0.8425 = 8.425 GBP = 842.5 cents → 842 or 843 (banker's rounding)
+  // 842.5 rounds to 842 (even)
+  assert.equal(result.value, 842);
+});
