+      { sku: 'DEV-HOUR', name: 'Development (hour)', qty: 3, unitPrice: 9500, vatRate: 21, discountPercent: 20 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const expectedSubtotal = 42500 + 28500;
+  const expectedDiscount = 4250 + 5700;
+  const expectedVat = 8032 + 4788;
+  assert.deepEqual(totals, { subtotal: expectedSubtotal, discount: expectedDiscount, vat: expectedVat, voucher: 0, total: expectedSubtotal - expectedDiscount + expectedVat });
+});
+
