+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { sku: 'DES-HOUR', name: 'Design work (hour)', qty: 5, unitPrice: 8500, vatRate: 21 };
+  assert.equal(lineTotal(line), 42500);
+});
+
+test('lineTotal handles various quantities', () => {
+  const line1 = { sku: 'ICON-SET', qty: 10, unitPrice: 980, vatRate: 21 };
+  assert.equal(lineTotal(line1), 9800);
+
+  const line2 = { sku: 'STICKER', qty: 1000, unitPrice: 50, vatRate: 21 };
+  assert.equal(lineTotal(line2), 50000);
+});
+
+test('lineTotal with zero quantity', () => {
+  const line = { qty: 0, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with zero unit price', () => {
+  const line = { qty: 5, unitPrice: 0 };
+  assert.equal(lineTotal(line), 0);
+});
+
+test('lineTotal with large numbers', () => {
+  const line = { qty: 1000, unitPrice: 1000000 };
+  assert.equal(lineTotal(line), 1000000000);
+});
+
+test('lineTotal with decimal quantities (edge case)', () => {
+  // This tests the behavior when qty is not an integer (though the system should prevent this)
+  const line = { qty: 5.5, unitPrice: 8500 };
+  assert.equal(lineTotal(line), 46750);
+});
+
+test('invoiceTotals calculates discount for single line', () => {
