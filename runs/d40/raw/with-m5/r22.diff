@@ -0,0 +1,36 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line: qty times unitPrice.
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher and total for an invoice. Subtotal is the sum of line totals.
+ * Discount is the sum of line discounts. VAT is computed per line on the amount after discount, then rounded and summed.
+ * Voucher is a fixed amount off (applied after VAT).
+ * Total = subtotal - discount + vat - voucher, clamped at 0.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => {
+    const lineDiscount = lineTotal(line) * (line.discountPercent ?? 0) / 100;
+    return sum + lineDiscount;
+  }, 0);
+  const vat = invoice.lines.reduce((sum, line) => {
+    const lineAmount = lineTotal(line);
+    const lineDiscount = lineAmount * (line.discountPercent ?? 0) / 100;
+    const amountAfterDiscount = lineAmount - lineDiscount;
+    const lineVat = roundCents(amountAfterDiscount * (line.vatRate ?? 0) / 100);
+    return sum + lineVat;
+  }, 0);
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return { subtotal, discount, vat, voucher, total };
+}
