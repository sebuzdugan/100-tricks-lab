+  // amount after line discount: 3230.1
+  // bulk discount: 3230.1 * 2.5% = 80.7525
+  // total discount: 180.6525
+  // vat on 3149.3475: 3149.3475 * 21% = 661.36... → 661
+  // total: 3330 - 180.6525 + 661 = 3810.3475
+  assert.equal(totals.subtotal, 3330);
+  assert.equal(totals.discount, 180.6525);
+  assert.equal(totals.vat, 661);
+});
