+/**
+ * Generate a dashboard summary of invoice metrics.
+ * @param {Array<{ status: string, customerId: string, dueDate: string, lines: Array<any>, payments?: Array<any> }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const inv of invoices) {
+    if (inv.status in counts) {
+      counts[inv.status]++;
+    }
+  }
+
+  // Calculate outstanding amount (due on issued or partially_paid invoices)
+  const outstanding = invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid')
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  // Get overdue invoices
+  const overdueList = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdueList.length,
+    amount: overdueList.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Find top 3 customers by outstanding due
+  const customerDues = {};
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const customerId = inv.customerId;
+      const due = balanceDue(inv);
+      if (!customerDues[customerId]) {
+        customerDues[customerId] = 0;
+      }
+      customerDues[customerId] += due;
+    }
+  }
+
+  const topCustomers = Object.entries(customerDues)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
+
