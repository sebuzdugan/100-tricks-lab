@@ -53,3 +53,28 @@ export function createInvoice({ customerId, issueDate, lines }) {
     lines: enrichedLines,
   });
 }
+
+/**
+ * Calculate the total amount for a line item (qty × unitPrice in cents).
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate subtotal and total for an invoice (in cents).
+ * @param {{ lines: Array<{ qty: number, unitPrice: number }> }}
+ * @returns {{ subtotal: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  for (const line of invoice.lines) {
+    subtotal += lineTotal(line);
+  }
+  return {
+    subtotal,
+    total: subtotal,
+  };
+}
