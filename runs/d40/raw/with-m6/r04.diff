new file mode 100644
index 0000000..b955212
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,24 @@
+/**
+ * Calculate the next invoice number for a given issue date.
+ * Existing numbers can be in any order or format; invalid ones are ignored.
+ * @param {string[]} existingNumbers
+ * @param {string} issueDate - YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.slice(0, 4);
+  const prefix = `INV-${year}-`;
+
+  const countersForYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.slice(prefix.length);
+      return parseInt(counter, 10);
+    })
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = countersForYear.length > 0 ? Math.max(...countersForYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
