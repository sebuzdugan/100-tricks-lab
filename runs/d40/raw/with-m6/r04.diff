diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..aa477ff
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 when no invoices exist', () => {
+  const num = nextInvoiceNumber([], '2026-10-07');
+  assert.equal(num, 'INV-2026-0001');
+});
+
+test('nextInvoiceNumber increments the counter for the same year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0003');
+});
+
+test('nextInvoiceNumber restarts at 0001 for a new year', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-0002'];
+  const num = nextInvoiceNumber(existing, '2027-01-15');
+  assert.equal(num, 'INV-2027-0001');
+});
+
+test('nextInvoiceNumber ignores invoices from other years', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0100', 'INV-2026-0001'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber finds max counter in any order', () => {
+  const existing = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0010', 'INV-2026-0003'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0011');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const existing = ['INV-2026-0001', 'INV-2026-XXXX', 'INV-2026-'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-0002');
+});
+
+test('nextInvoiceNumber handles very high counters', () => {
+  const existing = ['INV-2026-9999'];
+  const num = nextInvoiceNumber(existing, '2026-10-07');
+  assert.equal(num, 'INV-2026-10000');
+});
