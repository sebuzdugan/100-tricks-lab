+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const number = invoice.number ?? 'DRAFT';
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : invoice.customerId;
+
+  const lines = [number, customerName];
+
+  let total = 0;
+  for (const line of invoice.lines) {
+    const lineAmount = line.qty * line.unitPrice;
+    lines.push(
+      `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(lineAmount)}`
+    );
+    total += lineAmount;
+  }
+
+  lines.push(`Total: ${formatEuros(total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..0c97ac0
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,95 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /^DRAFT\n/);
+});
+
+test('renderInvoiceText shows invoice number for issued invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const text = renderInvoiceText(r2.value);
+  assert.match(text, /^INV-2026-0001\n/);
+});
+
+test('renderInvoiceText shows customer name on second line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText shows line item with qty, name, unitPrice and total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /2 Design work \(hour\) €85\.00 €170\.00/);
+});
+
+test('renderInvoiceText shows multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /2 Design work \(hour\)/);
+  assert.match(text, /1 Development \(hour\)/);
+});
+
+test('renderInvoiceText calculates total correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Total: €265\.00/);
+});
+
+test('renderInvoiceText formats all amounts through formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'LOGO-PACK', qty: 1 }],
+  });
+  const text = renderInvoiceText(r.value);
+  // LOGO-PACK: 120000 cents = €1,200.00
+  assert.match(text, /€1,200\.00.*€1,200\.00/);
+  assert.match(text, /Total: €1,200\.00/);
+});
+
+test('renderInvoiceText uses customer name from lookup', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'STICKER', qty: 50 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.match(text, /Kite & Co/);
+});
