+
+test('invoiceTotals sums discounts for multiple lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2, discountPercent: 10 },
+      { sku: 'DEV-HOUR', qty: 3, discountPercent: 20 },
+    ],
+  });
+  const totals = invoiceTotals(r.value);
+  const sub1 = 2 * 8500;
+  const sub2 = 3 * 9500;
+  const disc1 = sub1 * 10 / 100;
+  const disc2 = sub2 * 20 / 100;
+  assert.equal(totals.subtotal, sub1 + sub2);
+  assert.equal(totals.discount, disc1 + disc2);
+  assert.equal(totals.total, (sub1 + sub2) - (disc1 + disc2));
+});
