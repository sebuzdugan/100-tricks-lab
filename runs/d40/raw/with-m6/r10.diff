+/**
+ * Check if a date string is valid (YYYY-MM-DD format, real date in UTC).
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const dateRegex = /^(\d{4})-(\d{2})-(\d{2})$/;
+  const match = dateRegex.exec(text);
+  if (!match) return false;
+
+  const [, year, month, day] = match;
+  const date = new Date(Date.UTC(Number(year), Number(month) - 1, Number(day)));
+  return date.toISOString().slice(0, 10) === text;
+}
+
+/**
+ * Add days to a date (UTC arithmetic).
+ * @param {string} date - YYYY-MM-DD format
+ * @param {number} days
+ * @returns {string} - YYYY-MM-DD format
+ */
+export function addDays(date, days) {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
+  if (!match) throw new Error('Invalid date format');
+
+  const [, year, month, day] = match;
+  const d = new Date(Date.UTC(Number(year), Number(month) - 1, Number(day)));
+  d.setUTCDate(d.getUTCDate() + days);
+
+  const y = d.getUTCFullYear();
+  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
+  const dy = String(d.getUTCDate()).padStart(2, '0');
+  return `${y}-${m}-${dy}`;
+}
+
+/**
+ * Calculate days between two dates (b - a, in whole days, UTC arithmetic).
+ * @param {string} a - YYYY-MM-DD format
+ * @param {string} b - YYYY-MM-DD format
+ * @returns {number}
+ */
+export function daysBetween(a, b) {
+  const matchA = /^(\d{4})-(\d{2})-(\d{2})$/.exec(a);
+  const matchB = /^(\d{4})-(\d{2})-(\d{2})$/.exec(b);
+  if (!matchA || !matchB) throw new Error('Invalid date format');
+
+  const [, yearA, monthA, dayA] = matchA;
+  const [, yearB, monthB, dayB] = matchB;
+
+  const dateA = new Date(Date.UTC(Number(yearA), Number(monthA) - 1, Number(dayA)));
+  const dateB = new Date(Date.UTC(Number(yearB), Number(monthB) - 1, Number(dayB)));
+
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / 86400000);
+}
