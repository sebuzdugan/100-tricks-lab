diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..f53d081
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,105 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2026-10-07'), true);
+  assert.equal(isValidDate('2026-01-01'), true);
+  assert.equal(isValidDate('2026-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid formats', () => {
+  assert.equal(isValidDate('10-07-2026'), false);
+  assert.equal(isValidDate('2026/10/07'), false);
+  assert.equal(isValidDate('2026.10.07'), false);
+  assert.equal(isValidDate('07-10-2026'), false);
+  assert.equal(isValidDate('2026-1-7'), false);
+  assert.equal(isValidDate('2026-01'), false);
+  assert.equal(isValidDate('2026'), false);
+  assert.equal(isValidDate(''), false);
+});
+
+test('isValidDate rejects invalid dates', () => {
+  assert.equal(isValidDate('2026-02-30'), false);
+  assert.equal(isValidDate('2026-13-01'), false);
+  assert.equal(isValidDate('2026-00-01'), false);
+  assert.equal(isValidDate('2026-04-31'), false);
+  assert.equal(isValidDate('2025-02-29'), false);
+});
+
+test('isValidDate accepts leap year Feb 29', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects non-leap year Feb 29', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2026-02-29'), false);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+  assert.equal(addDays('2026-10-07', 5), '2026-10-12');
+  assert.equal(addDays('2026-10-07', 100), '2027-01-15');
+});
+
+test('addDays adds negative days', () => {
+  assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+  assert.equal(addDays('2026-10-07', -5), '2026-10-02');
+  assert.equal(addDays('2026-10-07', -100), '2026-06-29');
+});
+
+test('addDays adds zero days', () => {
+  assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+});
+
+test('addDays rolls over month boundaries forward', () => {
+  assert.equal(addDays('2026-01-31', 1), '2026-02-01');
+  assert.equal(addDays('2026-02-28', 1), '2026-03-01');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+});
+
+test('addDays rolls over month boundaries backward', () => {
+  assert.equal(addDays('2026-03-01', -1), '2026-02-28');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+});
+
+test('addDays rolls over year boundaries', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  assert.equal(addDays('2025-12-31', 365), '2026-12-31');
+});
+
+test('daysBetween calculates positive difference', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+  assert.equal(daysBetween('2026-10-07', '2026-10-12'), 5);
+  assert.equal(daysBetween('2026-10-07', '2026-11-07'), 31);
+});
+
+test('daysBetween calculates negative difference', () => {
+  assert.equal(daysBetween('2026-10-08', '2026-10-07'), -1);
+  assert.equal(daysBetween('2026-10-12', '2026-10-07'), -5);
+  assert.equal(daysBetween('2026-11-07', '2026-10-07'), -31);
+});
+
+test('daysBetween returns zero when dates are equal', () => {
+  assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+});
+
+test('daysBetween handles month and year boundaries', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+  assert.equal(daysBetween('2026-02-28', '2026-03-01'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+});
+
+test('daysBetween handles large differences', () => {
+  assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween works with dates far apart', () => {
+  assert.equal(daysBetween('2000-01-01', '2026-10-07'), 9776);
+});
