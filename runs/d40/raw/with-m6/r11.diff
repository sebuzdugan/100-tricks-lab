+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment records a payment on an issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const r2 = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.payments.length, 1);
+  assert.equal(r2.value.payments[0].amount, 10000);
+  assert.equal(r2.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment sets status to partially_paid when partial payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r2 = recordPayment(issued.value, { amount: totals.total - 1000, date: '2026-10-08' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'partially_paid');
+});
+
+test('recordPayment sets status to paid when fully paid', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r2 = recordPayment(issued.value, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'paid');
+});
+
+test('recordPayment reports NOT_ISSUED for draft invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.deepEqual(recordPayment(r.value, { amount: 10000, date: '2026-10-08' }), { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment reports NOT_ISSUED for invoices with other statuses', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const invoice = { ...r.value, status: 'sent' };
+  assert.deepEqual(recordPayment(invoice, { amount: 10000, date: '2026-10-08' }), { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('recordPayment reports AMOUNT_INVALID for non-integer amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  assert.deepEqual(recordPayment(issued.value, { amount: 100.5, date: '2026-10-08' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment reports AMOUNT_INVALID for zero amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  assert.deepEqual(recordPayment(issued.value, { amount: 0, date: '2026-10-08' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment reports AMOUNT_INVALID for negative amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  assert.deepEqual(recordPayment(issued.value, { amount: -1000, date: '2026-10-08' }), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('recordPayment reports OVERPAYMENT when payment exceeds amount owed', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  assert.deepEqual(recordPayment(issued.value, { amount: totals.total + 1, date: '2026-10-08' }), { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('recordPayment does not mutate the original invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.equal(issued.value.payments, undefined);
+  assert.equal(issued.value.status, 'issued');
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const r2 = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.ok(Array.isArray(r2.value.payments));
+  assert.equal(r2.value.payments.length, 1);
+});
+
+test('recordPayment adds to existing payments array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const half = Math.floor(totals.total / 2);
+  const r2 = recordPayment(issued.value, { amount: half, date: '2026-10-08' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'partially_paid');
+  const r3 = recordPayment(r2.value, { amount: half, date: '2026-10-09' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.payments.length, 2);
+  assert.equal(r3.value.status, 'paid');
+});
+
+test('recordPayment on partially_paid invoice works', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r2 = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r2.value.status, 'partially_paid');
+  const remaining = totals.total - 10000;
+  const r3 = recordPayment(r2.value, { amount: remaining, date: '2026-10-09' });
+  assert.equal(r3.ok, true);
+  assert.equal(r3.value.status, 'paid');
+});
+
+test('recordPayment reports OVERPAYMENT when exceeding remaining balance', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const r2 = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.equal(r2.ok, true);
+  const totals = invoiceTotals(issued.value);
+  const remaining = totals.total - 10000;
+  assert.deepEqual(recordPayment(r2.value, { amount: remaining + 1, date: '2026-10-09' }), { ok: false, error: 'OVERPAYMENT' });
+});
+
+test('balanceDue returns full total when no payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  assert.equal(balanceDue(issued.value), totals.total);
+});
+
+test('balanceDue returns remaining balance after partial payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r2 = recordPayment(issued.value, { amount: 10000, date: '2026-10-08' });
+  assert.equal(balanceDue(r2.value), totals.total - 10000);
+});
+
+test('balanceDue returns 0 when fully paid', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r2 = recordPayment(issued.value, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(balanceDue(r2.value), 0);
+});
+
+test('balanceDue returns 0 when no payments array', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  assert.equal(balanceDue(issued.value), totals.total);
+});
+
+test('balanceDue with multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r2 = recordPayment(issued.value, { amount: 5000, date: '2026-10-08' });
+  const r3 = recordPayment(r2.value, { amount: 5000, date: '2026-10-09' });
+  assert.equal(balanceDue(r3.value), totals.total - 10000);
+});
+
+test('balanceDue clamps to 0', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  assert.ok(balanceDue(issued.value) >= 0);
+});
+
+test('recordPayment can receive multiple payments totaling invoice amount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const third = Math.floor(totals.total / 3);
+  const r2 = recordPayment(issued.value, { amount: third, date: '2026-10-08' });
+  const r3 = recordPayment(r2.value, { amount: third, date: '2026-10-09' });
+  const remaining = totals.total - third - third;
+  const r4 = recordPayment(r3.value, { amount: remaining, date: '2026-10-10' });
+  assert.equal(r4.ok, true);
+  assert.equal(r4.value.status, 'paid');
+  assert.equal(r4.value.payments.length, 3);
+});
+
+test('recordPayment includes date in payment record', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const r2 = recordPayment(issued.value, { amount: 5000, date: '2026-10-08' });
+  assert.equal(r2.value.payments[0].date, '2026-10-08');
+});
+
+test('recordPayment preserves other invoice properties', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const r2 = recordPayment(issued.value, { amount: 5000, date: '2026-10-08' });
+  assert.equal(r2.value.customerId, issued.value.customerId);
+  assert.equal(r2.value.issueDate, issued.value.issueDate);
+  assert.equal(r2.value.number, issued.value.number);
+  assert.deepEqual(r2.value.lines, issued.value.lines);
+});
+
+test('recordPayment with discount and VAT', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const r2 = recordPayment(issued.value, { amount: totals.total, date: '2026-10-08' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'paid');
+  assert.equal(balanceDue(r2.value), 0);
+});
