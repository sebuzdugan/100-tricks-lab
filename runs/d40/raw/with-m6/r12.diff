 import { nextInvoiceNumber } from './numbering.js';
 import { roundCents } from './money.js';
-import { isValidDate } from './dates.js';
+import { isValidDate, addDays } from './dates.js';
 
 /**
  * Create a draft invoice.
- * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number, discountPercent?: number }> }}
- * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: 'draft', lines: Array } } | { ok: false, error: string }}
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number, discountPercent?: number }>, terms?: string }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, dueDate: string, terms: string, status: 'draft', lines: Array } } | { ok: false, error: string }}
