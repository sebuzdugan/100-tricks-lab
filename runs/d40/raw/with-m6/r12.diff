-export function createInvoice({ customerId, issueDate, lines }) {
+export function createInvoice({ customerId, issueDate, lines, terms = 'NET30' }) {
   // Normalize customer ID
   const normalizedCustomerId = normalizeId(customerId);
 
   // Validate date format and value
   if (!isValidDate(issueDate)) return fail('DATE_INVALID');
 
+  // Validate and calculate dueDate based on terms
+  let dueDate;
+  if (terms === 'NET14') {
+    dueDate = addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    dueDate = addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const [, year, month] = /^(\d{4})-(\d{2})-(\d{2})$/.exec(issueDate);
+    const y = parseInt(year);
+    const m = parseInt(month);
+    let nextM = m + 1;
+    let nextY = y;
+    if (nextM > 12) {
+      nextM = 1;
+      nextY = y + 1;
+    }
+    const firstOfNextMonth = `${nextY}-${String(nextM).padStart(2, '0')}-01`;
+    dueDate = addDays(firstOfNextMonth, -1);
+  } else {
+    return fail('TERMS_INVALID');
+  }
+
   // Validate customer exists
   const customerResult = getCustomer(normalizedCustomerId);
   if (!customerResult.ok) return fail('CUSTOMER_NOT_FOUND');
