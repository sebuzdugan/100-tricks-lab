@@ -0,0 +1,275 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote creates a credit note for issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Discount');
+  assert.equal(result.value.date, '2026-10-08');
+});
+
+test('createCreditNote reports NOT_ISSUED for draft', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  assert.deepEqual(createCreditNote(r.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []), { ok: false, error: 'NOT_ISSUED' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for non-integer', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  assert.deepEqual(createCreditNote(issued.value, { amount: 5000.5, reason: 'Discount', date: '2026-10-08' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for zero', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  assert.deepEqual(createCreditNote(issued.value, { amount: 0, reason: 'Discount', date: '2026-10-08' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote reports AMOUNT_INVALID for negative', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  assert.deepEqual(createCreditNote(issued.value, { amount: -5000, reason: 'Discount', date: '2026-10-08' }, []), { ok: false, error: 'AMOUNT_INVALID' });
+});
+
+test('createCreditNote reports CREDIT_TOO_HIGH', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  assert.deepEqual(createCreditNote(issued.value, { amount: totals.total + 1, reason: 'Discount', date: '2026-10-08' }, []), { ok: false, error: 'CREDIT_TOO_HIGH' });
+});
+
+test('createCreditNote credit amount equal to invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const result = createCreditNote(issued.value, { amount: totals.total, reason: 'Full refund', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote increments counter for same year', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result1 = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  const result2 = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-09' }, ['CN-2026-0001']);
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote restarts counter for new year', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2027-10-08' }, ['CN-2026-0001', 'CN-2026-0002']);
+  assert.equal(result.value.number, 'CN-2027-0001');
+});
+
+test('createCreditNote handles mixed invoice and credit numbers', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, ['INV-2026-0001', 'CN-2026-0001', 'INV-2026-0002', 'CN-2026-0002']);
+  assert.equal(result.value.number, 'CN-2026-0003');
+});
+
+test('createCreditNote works with partially_paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const withPayment = recordPayment(issued.value, { amount: 5000, date: '2026-10-08' });
+  const result = createCreditNote(withPayment.value, { amount: 5000, reason: 'Discount', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote works with paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2026-10-08' });
+  const result = createCreditNote(paid.value, { amount: 5000, reason: 'Discount', date: '2026-10-09' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote includes customerId', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.equal(result.value.customerId, 'C-001');
+});
+
+test('createCreditNote handles multiple in same year', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const existing = ['CN-2026-0001', 'CN-2026-0005', 'CN-2026-0003'];
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, existing);
+  assert.equal(result.value.number, 'CN-2026-0006');
+});
+
+test('createCreditNote ignores malformed numbers', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const existing = ['CN-2026-0001', 'CN-2026-XXXX', 'CN-2026-'];
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, existing);
+  assert.equal(result.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote number format is correct', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.match(result.value.number, /^CN-\d{4}-\d{4}$/);
+});
+
+test('createCreditNote has separate counter from invoices', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const existing = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003', 'CN-2026-0001'];
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, existing);
+  assert.equal(result.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote with reason', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Customer complaint', date: '2026-10-08' }, []);
+  assert.equal(result.value.reason, 'Customer complaint');
+});
+
+test('createCreditNote date is preserved', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-11-15' }, []);
+  assert.equal(result.value.date, '2026-11-15');
+});
+
+test('createCreditNote with discount on invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Discount', date: '2026-10-08' }, []);
+  assert.equal(result.ok, true);
+  assert.ok(result.value.amount <= totals.total);
+});
+
+test('createCreditNote multiple credit notes same invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const result1 = createCreditNote(issued.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  const result2 = createCreditNote(issued.value, { amount: totals.total - 5000, reason: 'Discount', date: '2026-10-09' }, ['CN-2026-0001']);
+  assert.equal(result1.ok, true);
+  assert.equal(result2.ok, true);
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2026-0002');
+});
+
+test('createCreditNote across year boundary', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2027-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued1 = issueInvoice(r1.value, []);
+  const issued2 = issueInvoice(r2.value, ['INV-2027-0001']);
+  const result1 = createCreditNote(issued1.value, { amount: 5000, reason: 'Discount', date: '2026-10-08' }, []);
+  const result2 = createCreditNote(issued2.value, { amount: 5000, reason: 'Discount', date: '2027-10-08' }, ['CN-2026-0001']);
+  assert.equal(result1.value.number, 'CN-2026-0001');
+  assert.equal(result2.value.number, 'CN-2027-0001');
+});
