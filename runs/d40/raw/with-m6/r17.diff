     })
     .sort((a, b) => b.daysOverdue - a.daysOverdue);
 }
+
+/**
+ * VAT summary for invoices: one entry per VAT rate with base and VAT amounts.
+ * @param {Array} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const summary = {};
+
+  const validStatuses = new Set(['issued', 'partially_paid', 'paid']);
+  const filtered = invoices.filter((inv) => validStatuses.has(inv.status));
+
+  for (const inv of filtered) {
+    for (const line of inv.lines) {
+      const lineSubtotal = line.qty * line.unitPrice;
+      const lineDiscount = lineSubtotal * (line.discountPercent ?? 0) / 100;
+      const lineBase = lineSubtotal - lineDiscount;
+      const lineVat = roundCents(lineBase * (line.vatRate ?? 0) / 100);
+
+      const rate = line.vatRate ?? 0;
+      if (!summary[rate]) {
+        summary[rate] = { rate, base: 0, vat: 0 };
+      }
+      summary[rate].base += lineBase;
+      summary[rate].vat += lineVat;
+    }
+  }
+
+  return Object.values(summary).sort((a, b) => b.rate - a.rate);
+}
