   return Object.values(summary).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Late fee on an invoice: 0.04% of amount due per day overdue, 0 if not overdue.
+ * @param {{ dueDate: string, status: string, payments?: Array<{ amount: number }>, lines: Array }} invoice
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {number}
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const due = balanceDue(invoice);
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const fee = due * 0.0004 * daysOverdue;
+
+  return roundCents(fee);
+}
