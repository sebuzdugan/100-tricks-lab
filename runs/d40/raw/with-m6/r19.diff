+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+import { roundCents } from './money.js';
+
+/**
+ * Format cents as euros with 2 decimals (e.g., 123456 -> "1234.56").
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEurosPlain(cents) {
+  const euros = Math.floor(cents / 100);
+  const centsPart = cents % 100;
+  return `${euros}.${String(centsPart).padStart(2, '0')}`;
+}
+
+/**
+ * Escape a CSV field: quote if it contains comma, quote, or newline; double any quotes inside.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  if (field.includes(',') || field.includes('"') || field.includes('\n')) {
+    return `"${field.replace(/"/g, '""')}"`;
+  }
+  return field;
+}
+
+/**
+ * Export invoices as CSV: header + one line per invoice.
+ * @param {Array} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const header = 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n';
+
+  const lines = invoices.map((inv) => {
+    const customerResult = getCustomer(inv.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const fields = [
+      escapeCsvField(inv.number ?? ''),
+      escapeCsvField(customerName),
+      inv.issueDate,
+      inv.dueDate,
+      inv.status,
+      formatEurosPlain(roundCents(totals.subtotal)),
+      formatEurosPlain(roundCents(totals.discount)),
+      formatEurosPlain(roundCents(totals.vat)),
+      formatEurosPlain(roundCents(totals.total)),
+      formatEurosPlain(roundCents(due)),
+    ];
+
+    return fields.join(',');
+  });
+
+  return header + lines.join('\n') + (lines.length > 0 ? '\n' : '');
+}
