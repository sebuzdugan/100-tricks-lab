+
+test('exportCsv returns header for empty array', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv returns header line', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv exports single issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const csv = exportCsv([issued.value]);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3);
+  assert.match(lines[1], /^INV-2026-0001,Northwind Studio,2026-10-07,2026-11-06,issued/);
+});
+
+test('exportCsv includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2026-10-07',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
