--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,35 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert an amount in cents from EUR to another currency.
+ * @param {number} cents - amount in EUR cents
+ * @param {string} currency - target currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!(currency in RATES)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const rate = RATES[currency];
+  const converted = roundCents(cents * rate);
+  return ok(converted);
+}
+
+/**
+ * Format cents as money with currency symbol: 123456 EUR -> "$1,234.56", etc.
+ * @param {number} cents
+ * @param {string} currency - EUR, USD, or GBP
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  if (!(currency in RATES)) {
+    return '';
+  }
+  const symbol = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const major = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${major}.${String(abs % 100).padStart(2, '0')}`;
+}
