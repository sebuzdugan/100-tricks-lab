diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..4c3ba49
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,39 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total amount for a line item (qty × unitPrice in cents).
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate subtotal, discount, VAT, voucher and total for an invoice (in cents).
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  let subtotal = 0;
+  let discount = 0;
+  let vat = 0;
+  for (const line of invoice.lines) {
+    const lineSubtotal = lineTotal(line);
+    subtotal += lineSubtotal;
+    const lineDiscount = lineSubtotal * (line.discountPercent ?? 0) / 100;
+    discount += lineDiscount;
+    const lineAmountAfterDiscount = lineSubtotal - lineDiscount;
+    const lineVAT = lineAmountAfterDiscount * (line.vatRate ?? 0) / 100;
+    const roundedLineVAT = roundCents(lineVAT);
+    vat += roundedLineVAT;
+  }
+  const voucher = invoice.voucher?.amount ?? 0;
+  return {
+    subtotal: Math.max(0, subtotal),
+    discount: Math.max(0, discount),
+    vat: Math.max(0, vat),
+    voucher: Math.max(0, voucher),
+    total: Math.max(0, subtotal - discount + vat - voucher),
+  };
+}
