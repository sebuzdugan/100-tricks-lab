+
+test('invoiceTotals sums VAT for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 37, discountPercent: 0, vatRate: 9 },
