+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+import { roundCents } from '../src/money.js';
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  assert.equal(lineTotal({ qty: 2, unitPrice: 8500 }), 17000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 1250 }), 1250);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 100 }), 1000);
+});
+
+test('lineTotal with zero quantity', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 8500 }), 0);
+});
+
+test('lineTotal with large quantities', () => {
+  assert.equal(lineTotal({ qty: 1000, unitPrice: 10000 }), 10000000);
+});
+
+test('lineTotal with single unit', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 5000 }), 5000);
+});
+
+test('invoiceTotals sums line totals for a single line', () => {
+  const invoice = {
+    lines: [{ qty: 3, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 3 * 8500;
+  const discount = subtotal * 5 / 100;
+  const amountAfterDiscount = subtotal - discount;
+  const vat = Math.round(amountAfterDiscount * 21 / 100);
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.total, subtotal - discount + vat);
+});
+
+test('invoiceTotals sums line totals for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+      { qty: 3, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = (2 * 8500) + (3 * 9500);
+  const discount = subtotal * 5 / 100;
+  const l1 = 2 * 8500;
+  const v1 = roundCents((l1 - l1 * 5 / 100) * 21 / 100);
+  const l2 = 3 * 9500;
+  const v2 = roundCents((l2 - l2 * 5 / 100) * 21 / 100);
+  const vat = v1 + v2;
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.total, subtotal - discount + vat);
+});
+
+test('invoiceTotals calculates correctly with multiple varied items', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 2.5, vatRate: 21 },
+      { qty: 1, unitPrice: 120000, discountPercent: 2.5, vatRate: 21 },
+      { qty: 100, unitPrice: 50, discountPercent: 2.5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = (5 * 8500) + (1 * 120000) + (100 * 50);
+  const discount = subtotal * 2.5 / 100;
+  const l1 = 5 * 8500;
+  const d1 = l1 * 2.5 / 100;
+  const v1 = roundCents((l1 - d1) * 21 / 100);
+  const l2 = 1 * 120000;
+  const d2 = l2 * 2.5 / 100;
+  const v2 = roundCents((l2 - d2) * 21 / 100);
+  const l3 = 100 * 50;
+  const d3 = l3 * 2.5 / 100;
+  const v3 = roundCents((l3 - d3) * 21 / 100);
+  const vat = v1 + v2 + v3;
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.total, subtotal - discount + vat);
+});
+
+test('invoiceTotals calculates discount correctly for a single line', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 2 * 8500;
+  const discount = subtotal * 10 / 100;
+  const amountAfterDiscount = subtotal - discount;
+  const vat = roundCents(amountAfterDiscount * 21 / 100);
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.discount, discount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, subtotal - discount + vat);
+});
+
+test('invoiceTotals sums discounts for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+      { qty: 3, unitPrice: 9500, discountPercent: 20, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  const sub1 = 2 * 8500;
+  const sub2 = 3 * 9500;
+  const disc1 = sub1 * 10 / 100;
+  const disc2 = sub2 * 20 / 100;
+  const vat1 = roundCents((sub1 - disc1) * 21 / 100);
+  const vat2 = roundCents((sub2 - disc2) * 21 / 100);
+  assert.equal(totals.subtotal, sub1 + sub2);
+  assert.equal(totals.discount, disc1 + disc2);
+  assert.equal(totals.vat, vat1 + vat2);
+  assert.equal(totals.total, (sub1 + sub2) - (disc1 + disc2) + (vat1 + vat2));
+});
+
+test('invoiceTotals returns 0 discount when no discount', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 0);
+  const vat = roundCents(totals.subtotal * 21 / 100);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, totals.subtotal + vat);
+});
+
+test('invoiceTotals with 100% discount reduces total to 0', () => {
+  const invoice = {
+    lines: [{ qty: 2, unitPrice: 8500, discountPercent: 100, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.discount, 2 * 8500);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals clamps amounts at 0', () => {
