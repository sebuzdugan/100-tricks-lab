+  assert.equal(totals.subtotal, sub1 + sub2);
+  assert.equal(totals.vat, vat1 + vat2);
+});
+
+test('invoiceTotals with VAT-exempt products (vatRate 0)', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 60000, discountPercent: 0, vatRate: 0 },
