+test('invoiceTotals with bulk discount (10+ units)', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  const subtotal = 10 * 8500;
+  const bulkDiscount = subtotal * 2.5 / 100;
+  const baseAfterDiscount = subtotal - bulkDiscount;
+  const vat = roundCents(baseAfterDiscount * 21 / 100);
+  assert.equal(totals.subtotal, subtotal);
+  assert.equal(totals.discount, bulkDiscount);
+  assert.equal(totals.vat, vat);
+  assert.equal(totals.total, subtotal - bulkDiscount + vat);
+});
+
