--- a/src/totals.js
+++ b/src/totals.js
@@ -22,8 +22,16 @@ export function invoiceTotals(invoice) {
     const lineSubtotal = lineTotal(line);
     subtotal += lineSubtotal;
     const lineDiscount = lineSubtotal * (line.discountPercent ?? 0) / 100;
-    discount += lineDiscount;
-    const lineAmountAfterDiscount = lineSubtotal - lineDiscount;
+    let lineAmountAfterDiscount = lineSubtotal - lineDiscount;
+    let lineTotalDiscount = lineDiscount;
+
+    if (line.qty >= 10) {
+      const bulkDiscount = lineAmountAfterDiscount * 2.5 / 100;
+      lineAmountAfterDiscount -= bulkDiscount;
+      lineTotalDiscount += bulkDiscount;
+    }
+
+    discount += lineTotalDiscount;
     const lineVAT = lineAmountAfterDiscount * (line.vatRate ?? 0) / 100;
     const roundedLineVAT = roundCents(lineVAT);
     vat += roundedLineVAT;
