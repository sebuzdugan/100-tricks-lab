 import { getCustomer } from './customers.js';
 import { formatEuros } from './money.js';
 import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
 
 /**
  * Render an invoice as plain text.
- * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate?: number }> }}
+ * @param {{ number?: string, customerId: string, dueDate?: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate?: number }>, payments?: Array, voucher?: { code: string, amount: number } }}
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -16,9 +17,11 @@ export function renderInvoiceText(invoice) {
 
   for (const line of invoice.lines) {
     const lineAmount = line.qty * line.unitPrice;
-    lines.push(
-      `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(lineAmount)}`
-    );
+    let lineStr = `${line.qty} ${line.name} ${formatEuros(line.unitPrice)} ${formatEuros(lineAmount)}`;
+    if (line.discountPercent && line.discountPercent > 0) {
+      lineStr += ` (-${line.discountPercent}%)`;
+    }
+    lines.push(lineStr);
   }
 
   const totals = invoiceTotals(invoice);
@@ -29,7 +32,19 @@ export function renderInvoiceText(invoice) {
   if (totals.vat > 0) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+  if (totals.voucher > 0) {
+    lines.push(`Voucher: -${formatEuros(totals.voucher)}`);
+  }
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const paid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return lines.join('\n');
 }
