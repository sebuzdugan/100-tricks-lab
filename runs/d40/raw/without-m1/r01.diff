diff --git a/src/invoices.js b/src/invoices.js
new file mode 100644
index 0000000..37545d3
--- /dev/null
+++ b/src/invoices.js
@@ -0,0 +1,48 @@
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+import { ok, fail } from './result.js';
+
+function isValidDate(dateString) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateString)) return false;
+  const date = new Date(dateString + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+  return date.toISOString().split('T')[0] === dateString;
+}
+
+/**
+ * Create a new draft invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  if (!isValidDate(issueDate)) return fail('DATE_INVALID');
+
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  const processedLines = [];
+  for (const line of lines) {
+    if (!Number.isInteger(line.qty) || line.qty <= 0) return fail('QTY_INVALID');
+
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return productResult;
+
+    const product = productResult.value;
+    processedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: processedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..ec5f84d
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,153 @@
+import assert from 'node:assert';
+import { describe, it } from 'node:test';
+import { createInvoice } from '../src/invoices.js';
+
+describe('createInvoice', () => {
+  it('creates a draft invoice with valid input', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [
+        { sku: 'DES-HOUR', qty: 5 },
+        { sku: 'DEV-HOUR', qty: 3 },
+      ],
+    });
+
+    assert(result.ok);
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.issueDate, '2025-12-15');
+    assert.equal(result.value.status, 'draft');
+    assert.equal(result.value.lines.length, 2);
+    assert.equal(result.value.lines[0].sku, 'DES-HOUR');
+    assert.equal(result.value.lines[0].name, 'Design work (hour)');
+    assert.equal(result.value.lines[0].qty, 5);
+    assert.equal(result.value.lines[0].unitPrice, 8500);
+    assert.equal(result.value.lines[0].vatRate, 21);
+    assert.equal(result.value.lines[1].sku, 'DEV-HOUR');
+    assert.equal(result.value.lines[1].name, 'Development (hour)');
+    assert.equal(result.value.lines[1].qty, 3);
+  });
+
+  it('returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+    const result = createInvoice({
+      customerId: 'unknown-cust',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+  });
+
+  it('returns DATE_INVALID for invalid date format', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '15-12-2025',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'DATE_INVALID');
+  });
+
+  it('returns DATE_INVALID for non-existent date', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-02-30',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'DATE_INVALID');
+  });
+
+  it('returns DATE_INVALID for invalid format without dashes', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '20251215',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'DATE_INVALID');
+  });
+
+  it('returns NO_LINES for empty lines array', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [],
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'NO_LINES');
+  });
+
+  it('returns NO_LINES for missing lines', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: undefined,
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'NO_LINES');
+  });
+
+  it('returns QTY_INVALID for zero quantity', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 0 }],
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'QTY_INVALID');
+  });
+
+  it('returns QTY_INVALID for negative quantity', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: -5 }],
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'QTY_INVALID');
+  });
+
+  it('returns QTY_INVALID for fractional quantity', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 2.5 }],
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'QTY_INVALID');
+  });
+
+  it('returns UNKNOWN_SKU for invalid SKU', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'INVALID', qty: 1 }],
+    });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'UNKNOWN_SKU');
+  });
+
+  it('does not mutate input lines', () => {
+    const inputLines = [{ sku: 'DES-HOUR', qty: 5 }];
+    const linesCopy = JSON.parse(JSON.stringify(inputLines));
+
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: inputLines,
+    });
+
+    assert.deepEqual(inputLines, linesCopy);
+  });
+});
