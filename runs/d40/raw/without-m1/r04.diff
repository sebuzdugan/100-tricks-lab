+describe('issueInvoice', () => {
+  it('issues a draft invoice with a number and status "issued"', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const issueResult = issueInvoice(invoiceResult.value, []);
+
+    assert(issueResult.ok);
+    assert.equal(issueResult.value.number, 'INV-2025-0001');
+    assert.equal(issueResult.value.status, 'issued');
+    assert.equal(issueResult.value.customerId, 'C-001');
+    assert.equal(issueResult.value.issueDate, '2025-12-15');
+    assert.equal(issueResult.value.lines.length, 1);
+  });
+
+  it('assigns the next number when numbers already exist', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+    const issueResult = issueInvoice(invoiceResult.value, existingNumbers);
+
+    assert(issueResult.ok);
+    assert.equal(issueResult.value.number, 'INV-2025-0003');
+  });
+
+  it('assigns number from different year when issuing in new year', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-01-10',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+    const issueResult = issueInvoice(invoiceResult.value, existingNumbers);
+
+    assert(issueResult.ok);
+    assert.equal(issueResult.value.number, 'INV-2026-0001');
+  });
+
+  it('returns NOT_DRAFT for non-draft invoice', () => {
+    const invoice = {
+      number: 'INV-2025-0001',
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      status: 'issued',
+      lines: [{ sku: 'DES-HOUR', qty: 5, name: 'Design work (hour)', unitPrice: 8500, vatRate: 21 }],
+    };
+
+    const issueResult = issueInvoice(invoice, []);
+
+    assert(!issueResult.ok);
+    assert.equal(issueResult.error, 'NOT_DRAFT');
+  });
+
+  it('preserves line items', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [
+        { sku: 'DES-HOUR', qty: 5 },
+        { sku: 'DEV-HOUR', qty: 3 },
+      ],
+    });
+
+    assert(invoiceResult.ok);
+    const issueResult = issueInvoice(invoiceResult.value, []);
+
+    assert(issueResult.ok);
+    assert.equal(issueResult.value.lines.length, 2);
+    assert.equal(issueResult.value.lines[0].sku, 'DES-HOUR');
+    assert.equal(issueResult.value.lines[0].qty, 5);
+    assert.equal(issueResult.value.lines[1].sku, 'DEV-HOUR');
+    assert.equal(issueResult.value.lines[1].qty, 3);
+  });
+
+  it('does not mutate the original invoice', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const originalStatus = invoiceResult.value.status;
+    const originalLines = invoiceResult.value.lines.length;
+    const issueResult = issueInvoice(invoiceResult.value, []);
+
+    assert(issueResult.ok);
+    assert.equal(invoiceResult.value.status, originalStatus);
+    assert.equal(invoiceResult.value.lines.length, originalLines);
+    assert(!invoiceResult.value.number);
+  });
+});
diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..466d7ff
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,52 @@
+import assert from 'node:assert';
+import { describe, it } from 'node:test';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+describe('nextInvoiceNumber', () => {
+  it('returns INV-2025-0001 when no numbers exist', () => {
+    const number = nextInvoiceNumber([], '2025-12-15');
+    assert.equal(number, 'INV-2025-0001');
+  });
+
+  it('returns the next number in sequence', () => {
+    const existing = ['INV-2025-0001', 'INV-2025-0002'];
+    const number = nextInvoiceNumber(existing, '2025-12-15');
+    assert.equal(number, 'INV-2025-0003');
+  });
+
+  it('ignores numbers from other years', () => {
+    const existing = ['INV-2024-0001', 'INV-2024-0002', 'INV-2025-0001'];
+    const number = nextInvoiceNumber(existing, '2025-12-15');
+    assert.equal(number, 'INV-2025-0002');
+  });
+
+  it('finds the next number regardless of input order', () => {
+    const existing = ['INV-2025-0003', 'INV-2025-0001', 'INV-2025-0002'];
+    const number = nextInvoiceNumber(existing, '2025-12-15');
+    assert.equal(number, 'INV-2025-0004');
+  });
+
+  it('handles gaps in the sequence', () => {
+    const existing = ['INV-2025-0001', 'INV-2025-0003'];
+    const number = nextInvoiceNumber(existing, '2025-12-15');
+    assert.equal(number, 'INV-2025-0004');
+  });
+
+  it('zero-pads the counter to 4 digits', () => {
+    const existing = Array.from({ length: 10 }, (_, i) => `INV-2025-${String(i + 1).padStart(4, '0')}`);
+    const number = nextInvoiceNumber(existing, '2025-12-15');
+    assert.equal(number, 'INV-2025-0011');
+  });
+
+  it('restarts counter for new year', () => {
+    const existing = ['INV-2024-9999', 'INV-2025-0001'];
+    const number = nextInvoiceNumber(existing, '2026-01-01');
+    assert.equal(number, 'INV-2026-0001');
+  });
+
+  it('ignores malformed numbers', () => {
+    const existing = ['INV-2025-XXXX', 'INV-2025-0001', 'invalid-number'];
+    const number = nextInvoiceNumber(existing, '2025-12-15');
+    assert.equal(number, 'INV-2025-0002');
+  });
+});
