+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to the customer.
+ * @param {{ number?: string, customerId: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : '(Unknown customer)';
+
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  const number = invoice.number || 'DRAFT';
+  lines.push(number);
+
+  // Second line: customer name
+  lines.push(customerName);
+
+  // Line items
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Total line
+  const totals = invoiceTotals(invoice);
+  lines.push(`Total: ${formatEuros(totals.total)}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..9024a79
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,176 @@
+import assert from 'node:assert';
+import { describe, it } from 'node:test';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+
+describe('renderInvoiceText', () => {
+  it('renders a draft invoice', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const text = renderInvoiceText(invoiceResult.value);
+
+    assert(text.includes('DRAFT'));
+    assert(text.includes('Northwind Studio'));
+    assert(text.includes('5x Design work (hour) @ €85.00 = €425.00'));
+    assert(text.includes('Total: €425.00'));
+  });
+
+  it('renders an issued invoice with number', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const issueResult = issueInvoice(invoiceResult.value, []);
+
+    assert(issueResult.ok);
+    const text = renderInvoiceText(issueResult.value);
+
+    assert(text.includes('INV-2025-0001'));
+    assert(!text.includes('DRAFT'));
+    assert(text.includes('Northwind Studio'));
+    assert(text.includes('5x Design work (hour) @ €85.00 = €425.00'));
+    assert(text.includes('Total: €425.00'));
+  });
+
+  it('renders multiple line items', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [
+        { sku: 'DES-HOUR', qty: 5 },
+        { sku: 'DEV-HOUR', qty: 3 },
+      ],
+    });
+
+    assert(invoiceResult.ok);
+    const text = renderInvoiceText(invoiceResult.value);
+
+    assert(text.includes('DRAFT'));
+    assert(text.includes('Northwind Studio'));
+    assert(text.includes('5x Design work (hour) @ €85.00 = €425.00'));
+    assert(text.includes('3x Development (hour) @ €95.00 = €285.00'));
+    assert(text.includes('Total: €710.00'));
+  });
+
+  it('formats amounts correctly with thousands separator', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'LOGO-PACK', qty: 2 }],
+    });
+
+    assert(invoiceResult.ok);
+    const text = renderInvoiceText(invoiceResult.value);
+
+    // LOGO-PACK is 120000 cents = €1,200.00
+    assert(text.includes('2x Logo package @ €1,200.00 = €2,400.00'));
+    assert(text.includes('Total: €2,400.00'));
+  });
+
+  it('formats line items with different VAT rates', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [
+        { sku: 'PRINT-A4', qty: 100 }, // 37 cents, 9% VAT
+        { sku: 'DEV-HOUR', qty: 2 },   // 9500 cents, 21% VAT
+      ],
+    });
+
+    assert(invoiceResult.ok);
+    const text = renderInvoiceText(invoiceResult.value);
+
+    assert(text.includes('100x Printed flyer A4 (each) @ €0.37 = €37.00'));
+    assert(text.includes('2x Development (hour) @ €95.00 = €190.00'));
+    assert(text.includes('Total: €227.00'));
+  });
+
+  it('renders output as multiple lines', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const text = renderInvoiceText(invoiceResult.value);
+    const outputLines = text.split('\n');
+
+    assert.equal(outputLines.length, 4);
+    assert.equal(outputLines[0], 'DRAFT');
+    assert.equal(outputLines[1], 'Northwind Studio');
+    assert(outputLines[2].includes('5x Design work (hour)'));
+    assert(outputLines[3].startsWith('Total:'));
+  });
+
+  it('uses customer name from lookup', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-002',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert(invoiceResult.ok);
+    const text = renderInvoiceText(invoiceResult.value);
+
+    assert(text.includes('Blue Fern Bakery'));
+  });
+
+  it('handles different quantities correctly', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert(invoiceResult.ok);
+    const text = renderInvoiceText(invoiceResult.value);
+
+    assert(text.includes('1x Design work (hour) @ €85.00 = €85.00'));
+  });
+
+  it('calculates correct totals for multiple lines', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [
+        { sku: 'DES-HOUR', qty: 3 },   // 3 * 8500 = 25500
+        { sku: 'DEV-HOUR', qty: 2 },   // 2 * 9500 = 19000
+        { sku: 'COPY-HOUR', qty: 4 },  // 4 * 6000 = 24000
+      ],
+    });
+
+    assert(invoiceResult.ok);
+    const text = renderInvoiceText(invoiceResult.value);
+
+    // 25500 + 19000 + 24000 = 68500 = €685.00
+    assert(text.includes('Total: €685.00'));
+  });
+
+  it('renders with invoice number for issued invoices', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+    const issueResult = issueInvoice(invoiceResult.value, existingNumbers);
+
+    assert(issueResult.ok);
+    const text = renderInvoiceText(issueResult.value);
+
+    assert(text.includes('INV-2025-0003'));
+    assert(!text.includes('DRAFT'));
+  });
+});
