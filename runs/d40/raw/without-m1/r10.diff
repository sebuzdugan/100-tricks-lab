+/**
+ * Validate a date string in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) return false;
+  return date.toISOString().split('T')[0] === text;
+}
+
+/**
+ * Add n days to a date string, returning YYYY-MM-DD in UTC.
+ * @param {string} dateStr - YYYY-MM-DD format
+ * @param {number} n - number of days to add
+ * @returns {string} - YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const date = new Date(dateStr + 'T00:00:00Z');
+  date.setUTCDate(date.getUTCDate() + n);
+  return date.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of whole days between two dates (b - a) in UTC.
+ * @param {string} a - YYYY-MM-DD format
+ * @param {string} b - YYYY-MM-DD format
+ * @returns {number} - number of whole days
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (24 * 60 * 60 * 1000));
+}
