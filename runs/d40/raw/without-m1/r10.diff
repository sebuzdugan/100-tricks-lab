diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..ad5048a
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,136 @@
+import assert from 'node:assert';
+import { describe, it } from 'node:test';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+describe('isValidDate', () => {
+  it('accepts valid date in YYYY-MM-DD format', () => {
+    assert(isValidDate('2025-12-15'));
+  });
+
+  it('accepts leap year date', () => {
+    assert(isValidDate('2024-02-29'));
+  });
+
+  it('rejects invalid month', () => {
+    assert(!isValidDate('2025-13-01'));
+  });
+
+  it('rejects invalid day', () => {
+    assert(!isValidDate('2025-02-30'));
+  });
+
+  it('rejects non-leap year Feb 29', () => {
+    assert(!isValidDate('2025-02-29'));
+  });
+
+  it('rejects wrong format with slashes', () => {
+    assert(!isValidDate('2025/12/15'));
+  });
+
+  it('rejects wrong format without dashes', () => {
+    assert(!isValidDate('20251215'));
+  });
+
+  it('rejects empty string', () => {
+    assert(!isValidDate(''));
+  });
+
+  it('rejects single digit month/day', () => {
+    assert(!isValidDate('2025-1-15'));
+  });
+
+  it('rejects dates with spaces', () => {
+    assert(!isValidDate('2025-12-15 '));
+  });
+
+  it('accepts reasonable year boundaries', () => {
+    assert(isValidDate('1900-01-01'));
+    assert(isValidDate('2000-01-01'));
+    assert(isValidDate('9999-12-31'));
+  });
+});
+
+describe('addDays', () => {
+  it('adds zero days', () => {
+    assert.equal(addDays('2025-12-15', 0), '2025-12-15');
+  });
+
+  it('adds positive days', () => {
+    assert.equal(addDays('2025-12-15', 5), '2025-12-20');
+  });
+
+  it('adds days across month boundary', () => {
+    assert.equal(addDays('2025-12-28', 5), '2026-01-02');
+  });
+
+  it('adds days across year boundary', () => {
+    assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  });
+
+  it('subtracts days with negative number', () => {
+    assert.equal(addDays('2025-12-15', -5), '2025-12-10');
+  });
+
+  it('subtracts days across month boundary', () => {
+    assert.equal(addDays('2025-01-05', -5), '2024-12-31');
+  });
+
+  it('subtracts days across year boundary', () => {
+    assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  });
+
+  it('handles leap year correctly', () => {
+    assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+    assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  });
+
+  it('handles large day additions', () => {
+    assert.equal(addDays('2025-01-01', 365), '2026-01-01');
+  });
+
+  it('handles large day subtractions', () => {
+    assert.equal(addDays('2025-12-31', -365), '2024-12-31');
+  });
+});
+
+describe('daysBetween', () => {
+  it('calculates zero days for same date', () => {
+    assert.equal(daysBetween('2025-12-15', '2025-12-15'), 0);
+  });
+
+  it('calculates positive days forward', () => {
+    assert.equal(daysBetween('2025-12-15', '2025-12-20'), 5);
+  });
+
+  it('calculates negative days backward', () => {
+    assert.equal(daysBetween('2025-12-20', '2025-12-15'), -5);
+  });
+
+  it('calculates days across month boundary', () => {
+    assert.equal(daysBetween('2025-12-28', '2026-01-02'), 5);
+  });
+
+  it('calculates days across year boundary', () => {
+    assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  });
+
+  it('calculates days in leap year', () => {
+    assert.equal(daysBetween('2024-01-01', '2024-12-31'), 365);
+  });
+
+  it('calculates days in non-leap year', () => {
+    assert.equal(daysBetween('2025-01-01', '2025-12-31'), 364);
+  });
+
+  it('calculates days across leap year', () => {
+    assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  });
+
+  it('calculates large day spans', () => {
+    assert.equal(daysBetween('2020-01-01', '2025-01-01'), 1827);
+  });
+
+  it('returns negative for dates in reverse order', () => {
+    assert.equal(daysBetween('2025-12-25', '2025-12-15'), -10);
+  });
+});
