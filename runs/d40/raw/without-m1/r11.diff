diff --git a/src/payments.js b/src/payments.js
new file mode 100644
index 0000000..b5b1ad7
--- /dev/null
+++ b/src/payments.js
@@ -0,0 +1,47 @@
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the total amount still owed on an invoice.
+ * @param {{ payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const totals = invoiceTotals(invoice);
+  const totalPaid = (invoice.payments ?? []).reduce((sum, p) => sum + p.amount, 0);
+  return Math.max(0, totals.total - totalPaid);
+}
+
+/**
+ * Record a payment on an invoice.
+ * @param {{ status: string, customerId: string, issueDate: string, lines: Array, payments?: Array }} invoice
+ * @param {{ amount: number, date: string }} params
+ * @returns {{ ok: true, value: object } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const currentBalance = balanceDue(invoice);
+  if (amount > currentBalance) {
+    return fail('OVERPAYMENT');
+  }
+
+  const payments = invoice.payments ? [...invoice.payments] : [];
+  payments.push({ amount, date });
+
+  const totals = invoiceTotals(invoice);
+  const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
+  const newStatus = totalPaid >= totals.total ? 'paid' : 'partially_paid';
+
+  return ok({
+    ...invoice,
+    payments,
+    status: newStatus,
+  });
+}
diff --git a/test/payments.test.js b/test/payments.test.js
new file mode 100644
index 0000000..5a2bd00
--- /dev/null
+++ b/test/payments.test.js
@@ -0,0 +1,198 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+function createIssuedInvoice() {
+  return {
+    customerId: 'C001',
+    issueDate: '2024-01-15',
+    status: 'issued',
+    number: 'INV-2024-0001',
+    lines: [
+      {
+        sku: 'WIDGET',
+        name: 'Widget',
+        qty: 2,
+        unitPrice: 1000,
+        vatRate: 20,
+        discountPercent: 0,
+      },
+    ],
+  };
+}
+
+test('recordPayment: records a payment on issued invoice', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: 500, date: '2024-01-20' });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 500);
+  assert.equal(result.value.payments[0].date, '2024-01-20');
+});
+
+test('recordPayment: sets status to partially_paid after partial payment', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = recordPayment(invoice, { amount: totals.total - 100, date: '2024-01-20' });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment: sets status to paid when payments cover total', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = recordPayment(invoice, { amount: totals.total, date: '2024-01-20' });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment: returns NOT_ISSUED for draft invoices', () => {
+  const invoice = { ...createIssuedInvoice(), status: 'draft' };
+  const result = recordPayment(invoice, { amount: 1000, date: '2024-01-20' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment: returns NOT_ISSUED for paid invoices', () => {
+  const invoice = { ...createIssuedInvoice(), status: 'paid', payments: [] };
+  const result = recordPayment(invoice, { amount: 1000, date: '2024-01-20' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment: returns AMOUNT_INVALID for zero amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: 0, date: '2024-01-20' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: returns AMOUNT_INVALID for negative amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: -100, date: '2024-01-20' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: returns AMOUNT_INVALID for non-integer amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: 123.45, date: '2024-01-20' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment: returns OVERPAYMENT if payment exceeds balance due', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = recordPayment(invoice, { amount: totals.total + 1, date: '2024-01-20' });
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment: allows multiple payments accumulating to total', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const half = Math.floor(totals.total / 2);
+
+  const result1 = recordPayment(invoice, { amount: half, date: '2024-01-20' });
+  assert.ok(result1.ok);
+  assert.equal(result1.value.status, 'partially_paid');
+  assert.equal(result1.value.payments.length, 1);
+
+  const result2 = recordPayment(result1.value, { amount: totals.total - half, date: '2024-01-25' });
+  assert.ok(result2.ok);
+  assert.equal(result2.value.status, 'paid');
+  assert.equal(result2.value.payments.length, 2);
+});
+
+test('recordPayment: accepts payment on partially_paid invoice', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const quarter = Math.floor(totals.total / 4);
+
+  const result1 = recordPayment(invoice, { amount: quarter, date: '2024-01-20' });
+  assert.ok(result1.ok);
+
+  const result2 = recordPayment(result1.value, { amount: quarter, date: '2024-01-25' });
+  assert.ok(result2.ok);
+  assert.equal(result2.value.status, 'partially_paid');
+});
+
+test('recordPayment: preserves invoice properties after payment', () => {
+  const invoice = createIssuedInvoice();
+  const result = recordPayment(invoice, { amount: 500, date: '2024-01-20' });
+
+  assert.ok(result.ok);
+  assert.equal(result.value.customerId, invoice.customerId);
+  assert.equal(result.value.issueDate, invoice.issueDate);
+  assert.equal(result.value.number, invoice.number);
+  assert.deepEqual(result.value.lines, invoice.lines);
+});
+
+test('balanceDue: returns total for unpaid issued invoice', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const balance = balanceDue(invoice);
+
+  assert.equal(balance, totals.total);
+});
+
+test('balanceDue: returns reduced balance after partial payment', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const payment = Math.floor(totals.total / 2);
+
+  const paid = recordPayment(invoice, { amount: payment, date: '2024-01-20' });
+  assert.ok(paid.ok);
+
+  const balance = balanceDue(paid.value);
+  assert.equal(balance, totals.total - payment);
+});
+
+test('balanceDue: returns 0 for fully paid invoice', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2024-01-20' });
+  assert.ok(paid.ok);
+
+  const balance = balanceDue(paid.value);
+  assert.equal(balance, 0);
+});
+
+test('balanceDue: handles invoices with no payments array', () => {
+  const invoice = createIssuedInvoice();
+  delete invoice.payments;
+
+  const totals = invoiceTotals(invoice);
+  const balance = balanceDue(invoice);
+
+  assert.equal(balance, totals.total);
+});
+
+test('balanceDue: accumulates multiple payments correctly', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const quarter = Math.floor(totals.total / 4);
+
+  let current = invoice;
+  for (let i = 0; i < 3; i++) {
+    const result = recordPayment(current, { amount: quarter, date: `2024-01-${20 + i}` });
+    assert.ok(result.ok);
+    current = result.value;
+  }
+
+  const balance = balanceDue(current);
+  const expected = totals.total - quarter * 3;
+  assert.equal(balance, expected);
+});
