+describe('lastDayOfMonth', () => {
+  it('returns last day of January', () => {
+    assert.equal(lastDayOfMonth('2025-01-15'), '2025-01-31');
+  });
+
+  it('returns last day of February in non-leap year', () => {
+    assert.equal(lastDayOfMonth('2025-02-15'), '2025-02-28');
+  });
+
+  it('returns last day of February in leap year', () => {
+    assert.equal(lastDayOfMonth('2024-02-15'), '2024-02-29');
+  });
+
+  it('returns last day of April (30 days)', () => {
+    assert.equal(lastDayOfMonth('2025-04-15'), '2025-04-30');
+  });
+
+  it('returns last day when already on last day', () => {
+    assert.equal(lastDayOfMonth('2025-01-31'), '2025-01-31');
+  });
+
+  it('returns last day of December', () => {
+    assert.equal(lastDayOfMonth('2025-12-15'), '2025-12-31');
+  });
+
+  it('handles first day of month', () => {
+    assert.equal(lastDayOfMonth('2025-06-01'), '2025-06-30');
+  });
+
+  it('handles leap year February 29', () => {
+    assert.equal(lastDayOfMonth('2024-02-29'), '2024-02-29');
