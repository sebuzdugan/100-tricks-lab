+
+describe('applyVoucher', () => {
+  function createDraftInvoice() {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+    return result.value;
+  }
+
+  it('applies a voucher to a draft invoice', () => {
+    const invoice = createDraftInvoice();
+    const result = applyVoucher(invoice, { code: 'WELCOME10', amount: 1000 });
+
+    assert(result.ok);
+    assert.equal(result.value.voucher.code, 'WELCOME10');
+    assert.equal(result.value.voucher.amount, 1000);
+  });
+
+  it('preserves invoice properties when applying voucher', () => {
+    const invoice = createDraftInvoice();
+    const result = applyVoucher(invoice, { code: 'WELCOME10', amount: 1000 });
+
+    assert(result.ok);
+    assert.equal(result.value.customerId, invoice.customerId);
+    assert.equal(result.value.issueDate, invoice.issueDate);
+    assert.equal(result.value.status, invoice.status);
+    assert.equal(result.value.lines.length, invoice.lines.length);
+  });
+
+  it('returns NOT_DRAFT when applying voucher to issued invoice', () => {
+    const draftResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+    const issuedInvoice = {
+      ...draftResult.value,
+      status: 'issued',
+      number: 'INV-2025-0001',
+    };
+
+    const voucherResult = applyVoucher(issuedInvoice, { code: 'WELCOME10', amount: 1000 });
+
+    assert(!voucherResult.ok);
+    assert.equal(voucherResult.error, 'NOT_DRAFT');
+  });
+
+  it('returns VOUCHER_EXISTS when invoice already has a voucher', () => {
+    const invoice = createDraftInvoice();
+    const result1 = applyVoucher(invoice, { code: 'WELCOME10', amount: 1000 });
+    assert(result1.ok);
+
+    const result2 = applyVoucher(result1.value, { code: 'EXTRA20', amount: 2000 });
+
+    assert(!result2.ok);
+    assert.equal(result2.error, 'VOUCHER_EXISTS');
+  });
+
+  it('returns AMOUNT_INVALID for zero amount', () => {
+    const invoice = createDraftInvoice();
+    const result = applyVoucher(invoice, { code: 'INVALID', amount: 0 });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('returns AMOUNT_INVALID for negative amount', () => {
+    const invoice = createDraftInvoice();
+    const result = applyVoucher(invoice, { code: 'INVALID', amount: -500 });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('returns AMOUNT_INVALID for non-integer amount', () => {
+    const invoice = createDraftInvoice();
+    const result = applyVoucher(invoice, { code: 'INVALID', amount: 123.45 });
+
+    assert(!result.ok);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('does not mutate the original invoice', () => {
+    const invoice = createDraftInvoice();
+    const originalLines = invoice.lines.length;
+
+    const result = applyVoucher(invoice, { code: 'WELCOME10', amount: 1000 });
+
+    assert(result.ok);
+    assert(!invoice.voucher);
+    assert.equal(invoice.lines.length, originalLines);
+  });
+});
+
+describe('invoiceTotals with vouchers', () => {
+  it('includes voucher in total calculation', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const totalsWithoutVoucher = invoiceTotals(invoiceResult.value);
+
+    const voucherResult = applyVoucher(invoiceResult.value, { code: 'WELCOME10', amount: 1000 });
+    assert(voucherResult.ok);
+
+    const totalsWithVoucher = invoiceTotals(voucherResult.value);
+
+    assert.equal(totalsWithVoucher.voucher, 1000);
+    assert.equal(totalsWithVoucher.total, totalsWithoutVoucher.total - 1000);
+  });
+
+  it('returns 0 voucher for invoice without voucher', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5 }],
+    });
+
+    assert(invoiceResult.ok);
+    const totals = invoiceTotals(invoiceResult.value);
+
+    assert.equal(totals.voucher, 0);
+  });
+
+  it('clamps total at 0 when voucher exceeds subtotal + vat', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert(invoiceResult.ok);
+    const totalsWithoutVoucher = invoiceTotals(invoiceResult.value);
+    const largeVoucher = totalsWithoutVoucher.total + 10000;
+
+    const voucherResult = applyVoucher(invoiceResult.value, { code: 'HUGE', amount: largeVoucher });
+    assert(voucherResult.ok);
+
+    const totals = invoiceTotals(voucherResult.value);
+    assert.equal(totals.total, 0);
+  });
+
+  it('calculates correct total with voucher applied', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    });
+
+    assert(invoiceResult.ok);
+    const totalsBase = invoiceTotals(invoiceResult.value);
+
+    const voucherResult = applyVoucher(invoiceResult.value, { code: 'SAVE50', amount: 5000 });
+    assert(voucherResult.ok);
+
+    const totalsWithVoucher = invoiceTotals(voucherResult.value);
+    const expectedTotal = Math.max(0, totalsBase.subtotal - totalsBase.discount + totalsBase.vat - 5000);
+
+    assert.equal(totalsWithVoucher.total, expectedTotal);
+  });
+});
