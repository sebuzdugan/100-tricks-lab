+import { getCustomer } from './customers.js';
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement with outstanding invoices.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate?: string, status: string, lines: Array, voucher?: object, payments?: Array }>} invoices
+ * @param {string} asOf - date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  const normalizeId = (id) => String(id).trim().toUpperCase();
+  const normalizedCustomerId = normalizeId(customerId);
+
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  const relevantInvoices = invoices
+    .filter((invoice) => {
+      const sameCustomer = normalizeId(invoice.customerId) === normalizedCustomerId;
+      const isOutstanding = invoice.status === 'issued' || invoice.status === 'partially_paid';
+      const isOnTime = invoice.issueDate <= asOf;
+      return sameCustomer && isOutstanding && isOnTime;
+    })
+    .map((invoice) => {
+      const totals = invoiceTotals(invoice);
+      const due = balanceDue(invoice);
+      return {
+        number: invoice.number,
+        issueDate: invoice.issueDate,
+        dueDate: invoice.dueDate ?? null,
+        total: totals.total,
+        due,
+      };
+    })
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  const totalDue = relevantInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: normalizedCustomerId,
+    invoices: relevantInvoices,
+    totalDue,
+  });
+}
