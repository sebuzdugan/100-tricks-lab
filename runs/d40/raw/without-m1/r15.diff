+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the next available credit note number for a given year.
+ * Format: CN-YYYY-NNNN where NNNN is a 4-digit zero-padded counter per year.
+ * @param {Array<string>} existingNumbers - Credit note and invoice numbers already in use
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  const thisYearNumbers = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length), 10))
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = thisYearNumbers.length > 0 ? Math.max(...thisYearNumbers) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ customerId: string, number?: string, status: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} params
+ * @param {Array<string>} existingNumbers - Credit note and invoice numbers already in use
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status === 'draft') return fail('NOT_ISSUED');
+
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) return fail('CREDIT_TOO_HIGH');
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
