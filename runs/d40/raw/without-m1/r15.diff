diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..948ab7c
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,279 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createIssuedInvoice(customerId = 'C-001', issueDate = '2025-12-15', number = 'INV-2025-0001') {
+  const draftResult = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  return {
+    ...draftResult.value,
+    status: 'issued',
+    number,
+  };
+}
+
+test('nextCreditNoteNumber: returns CN-2025-0001 when no numbers exist', () => {
+  const number = nextCreditNoteNumber([], '2025-12-15');
+  assert.equal(number, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber: returns the next credit note number in sequence', () => {
+  const existingNumbers = ['CN-2025-0001'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'CN-2025-0002');
+});
+
+test('nextCreditNoteNumber: ignores invoice numbers', () => {
+  const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber: ignores credit notes from other years', () => {
+  const existingNumbers = ['CN-2024-0001', 'CN-2024-0002'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber: finds the next number regardless of input order', () => {
+  const existingNumbers = ['CN-2025-0003', 'CN-2025-0001', 'CN-2025-0002'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'CN-2025-0004');
+});
+
+test('nextCreditNoteNumber: handles gaps in the sequence', () => {
+  const existingNumbers = ['CN-2025-0001', 'CN-2025-0003'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'CN-2025-0004');
+});
+
+test('nextCreditNoteNumber: zero-pads the counter to 4 digits', () => {
+  const existingNumbers = ['CN-2025-0099'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'CN-2025-0100');
+});
+
+test('nextCreditNoteNumber: restarts counter for new year', () => {
+  const existingNumbers = ['CN-2024-0999', 'CN-2024-1000'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-01-01');
+  assert.equal(number, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber: ignores malformed numbers', () => {
+  const existingNumbers = ['CN-2025-XXXX', 'CN-2025-0001'];
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.equal(number, 'CN-2025-0002');
+});
+
+test('createCreditNote: creates a credit note for an issued invoice', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Product defect', date: '2025-12-20' }, []);
+
+  assert(result.ok);
+  assert.equal(result.value.number, 'CN-2025-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2025-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 5000);
+  assert.equal(result.value.reason, 'Product defect');
+  assert.equal(result.value.date, '2025-12-20');
+});
+
+test('createCreditNote: works for partially_paid invoices', () => {
+  const invoice = createIssuedInvoice();
+  const paymentResult = recordPayment(invoice, { amount: 10000, date: '2025-12-18' });
+  assert(paymentResult.ok);
+
+  const result = createCreditNote(paymentResult.value, { amount: 5000, reason: 'Partial refund', date: '2025-12-20' }, []);
+
+  assert(result.ok);
+  assert.equal(result.value.amount, 5000);
+});
+
+test('createCreditNote: works for paid invoices', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const paymentResult = recordPayment(invoice, { amount: totals.total, date: '2025-12-18' });
+  assert(paymentResult.ok);
+
+  const result = createCreditNote(paymentResult.value, { amount: 5000, reason: 'Full refund', date: '2025-12-20' }, []);
+
+  assert(result.ok);
+  assert.equal(result.value.amount, 5000);
+});
+
+test('createCreditNote: returns NOT_ISSUED for draft invoices', () => {
+  const draftInvoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const result = createCreditNote(draftInvoice, { amount: 5000, reason: 'Test', date: '2025-12-20' }, []);
+
+  assert(!result.ok);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote: returns AMOUNT_INVALID for zero amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 0, reason: 'Test', date: '2025-12-20' }, []);
+
+  assert(!result.ok);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: returns AMOUNT_INVALID for negative amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: -5000, reason: 'Test', date: '2025-12-20' }, []);
+
+  assert(!result.ok);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: returns AMOUNT_INVALID for non-integer amount', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 5000.50, reason: 'Test', date: '2025-12-20' }, []);
+
+  assert(!result.ok);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: returns CREDIT_TOO_HIGH if amount exceeds invoice total', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: totals.total + 1, reason: 'Test', date: '2025-12-20' }, []);
+
+  assert(!result.ok);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote: allows credit note equal to invoice total', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2025-12-20' }, []);
+
+  assert(result.ok);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote: uses correct year from issue date', () => {
+  const invoice = createIssuedInvoice('C-001', '2026-01-15', 'INV-2026-0001');
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2026-01-20' }, ['CN-2025-0001']);
+
+  assert(result.ok);
+  assert.equal(result.value.number, 'CN-2026-0001');
+});
+
+test('createCreditNote: increments counter for same year', () => {
+  const invoice = createIssuedInvoice();
+  const existingNumbers = ['CN-2025-0005'];
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2025-12-20' }, existingNumbers);
+
+  assert(result.ok);
+  assert.equal(result.value.number, 'CN-2025-0006');
+});
+
+test('createCreditNote: handles mixed invoice and credit note numbers', () => {
+  const invoice = createIssuedInvoice();
+  const existingNumbers = ['INV-2025-0001', 'CN-2025-0001', 'INV-2025-0002', 'CN-2025-0002'];
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2025-12-20' }, existingNumbers);
+
+  assert(result.ok);
+  assert.equal(result.value.number, 'CN-2025-0003');
+});
+
+test('createCreditNote: preserves customer ID', () => {
+  const invoice = createIssuedInvoice('C-003', '2025-12-15', 'INV-2025-0001');
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Test', date: '2025-12-20' }, []);
+
+  assert(result.ok);
+  assert.equal(result.value.customerId, 'C-003');
+});
+
+test('createCreditNote: accepts various reasons', () => {
+  const invoice = createIssuedInvoice();
+  const reasons = ['Product defect', 'Customer complaint', 'Overcharge', 'Return', ''];
+
+  for (const reason of reasons) {
+    const result = createCreditNote(invoice, { amount: 5000, reason, date: '2025-12-20' }, []);
+    assert(result.ok);
+    assert.equal(result.value.reason, reason);
+  }
+});
+
+test('createCreditNote: credit note date can be different from invoice date', () => {
+  const invoice = createIssuedInvoice('C-001', '2025-12-15', 'INV-2025-0001');
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2026-01-15' }, []);
+
+  assert(result.ok);
+  assert.equal(result.value.date, '2026-01-15');
+});
+
+test('createCreditNote: number uses credit note date year, not invoice year', () => {
+  const invoice = createIssuedInvoice('C-001', '2025-12-15', 'INV-2025-0001');
+  const result = createCreditNote(invoice, { amount: 5000, reason: 'Refund', date: '2026-02-01' }, []);
+
+  assert(result.ok);
+  assert(result.value.number.startsWith('CN-2026-'));
+});
+
+test('createCreditNote: works with vouchers included in invoice total', () => {
+  const draftInvoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  }).value;
+
+  const voucherResult = applyVoucher(draftInvoice, { code: 'SAVE', amount: 5000 });
+  assert(voucherResult.ok);
+
+  const issuedWithVoucher = {
+    ...voucherResult.value,
+    status: 'issued',
+    number: 'INV-2025-0001',
+  };
+
+  const totals = invoiceTotals(issuedWithVoucher);
+  const result = createCreditNote(issuedWithVoucher, { amount: totals.total, reason: 'Refund', date: '2025-12-20' }, []);
+
+  assert(result.ok);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('createCreditNote: handles very large credit note amounts', () => {
+  const invoice = createIssuedInvoice();
+  const totals = invoiceTotals(invoice);
+  const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2025-12-20' }, []);
+
+  assert(result.ok);
+  assert(result.value.amount > 0);
+});
+
+test('createCreditNote: handles small credit note amounts', () => {
+  const invoice = createIssuedInvoice();
+  const result = createCreditNote(invoice, { amount: 1, reason: 'Minimal refund', date: '2025-12-20' }, []);
+
+  assert(result.ok);
+  assert.equal(result.value.amount, 1);
+});
+
+test('createCreditNote: multiple credit notes for same invoice', () => {
+  const invoice = createIssuedInvoice();
+  const existing = [];
+
+  const result1 = createCreditNote(invoice, { amount: 5000, reason: 'First refund', date: '2025-12-20' }, existing);
+  assert(result1.ok);
+  existing.push(result1.value.number);
+
+  const result2 = createCreditNote(invoice, { amount: 3000, reason: 'Second refund', date: '2025-12-22' }, existing);
+  assert(result2.ok);
+
+  assert.equal(result1.value.number, 'CN-2025-0001');
+  assert.equal(result2.value.number, 'CN-2025-0002');
+  assert.equal(result1.value.invoiceNumber, result2.value.invoiceNumber);
+});
