+/**
+ * Calculate VAT summary by rate.
+ * @param {Array<{ status: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }> }>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) continue;
+
+    for (const line of invoice.lines) {
+      const lineAmount = lineTotal(line);
+      const discount = lineAmount * (line.discountPercent ?? 0) / 100;
+      const base = Math.max(0, lineAmount - discount);
+      const vatAmount = roundCents(base * (line.vatRate ?? 0) / 100);
+      const rate = line.vatRate ?? 0;
+
+      if (!vatMap.has(rate)) {
+        vatMap.set(rate, { base: 0, vat: 0 });
+      }
+      const entry = vatMap.get(rate);
+      entry.base += base;
+      entry.vat += Math.max(0, vatAmount);
+    }
+  }
+
+  return Array.from(vatMap)
+    .map(([rate, { base, vat }]) => ({ rate, base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+}
