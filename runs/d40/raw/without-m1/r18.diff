     .map(([rate, { base, vat }]) => ({ rate, base, vat }))
     .sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fee for an invoice: 0.04% of amount due per day overdue.
+ * @param {{ dueDate: string, status: string, payments?: Array, lines: Array }} invoice
+ * @param {string} asOf - YYYY-MM-DD format
+ * @returns {number}
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const amountDue = balanceDue(invoice);
+  if (amountDue <= 0) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const fee = roundCents(amountDue * 0.0004 * daysOverdue);
+  return Math.max(0, fee);
+}
