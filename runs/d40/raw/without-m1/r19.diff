+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv returns CSV string with header', () => {
+  const csv = exportCsv([]);
+  assert.ok(csv.startsWith('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n'));
+});
+
+test('exportCsv returns empty array as just header', () => {
+  const csv = exportCsv([]);
+  assert.equal(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoices = [
+    {
+      number: 'INV-2026-0001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+  assert.equal(lines.length, 3); // header, data, empty line at end
+  assert.equal(lines[1], 'INV-2026-0001,Northwind Studio,2026-10-01,2026-10-31,issued,10.00,0.00,0.00,10.00,10.00');
+});
+
+test('exportCsv includes customer name from lookup', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const csv = exportCsv(invoices);
+  assert.ok(csv.includes('Northwind Studio'));
+});
+
+test('exportCsv quotes customer name with comma', () => {
