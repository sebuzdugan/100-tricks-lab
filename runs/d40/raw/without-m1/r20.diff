+
+test('RATES has correct values', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert returns EUR unchanged', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert to USD applies correct rate', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10850);
+});
+
+test('convert to GBP applies correct rate', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 8425);
+});
+
+test('convert returns error for unknown currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert handles fractional results with rounding', () => {
+  const result = convert(333, 'USD');
+  assert.equal(result.ok, true);
+  // 333 * 1.085 = 361.155, rounds to 361
+  assert.equal(result.value, 361);
+});
