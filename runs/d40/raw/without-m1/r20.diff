diff --git a/src/money.js b/src/money.js
index fadf486..e67bce9 100644
--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,36 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = { EUR: 1, USD: 1.085, GBP: 0.8425 };
+
+/**
+ * Convert cents from euros to another currency.
+ * @param {number} cents - Amount in euro cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES.hasOwnProperty(currency)) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const converted = roundCents(cents * RATES[currency]);
+  return ok(converted);
+}
+
+/**
+ * Format cents as money for a given currency: 123456 USD -> "$1,234.56", -5 GBP -> "-£0.05".
+ * @param {number} cents
+ * @param {string} currency - Currency code (EUR, USD, GBP, or unknown)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const symbolMap = { EUR: '€', USD: '$', GBP: '£' };
+  const symbol = symbolMap[currency] ?? currency;
+
+  const sign = cents < 0 ? '-' : '';
+  const abs = Math.abs(cents);
+  const majorUnits = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const minorUnits = String(abs % 100).padStart(2, '0');
+  return `${sign}${symbol}${majorUnits}.${minorUnits}`;
+}
