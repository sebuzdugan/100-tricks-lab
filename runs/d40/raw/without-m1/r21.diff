+
+test('mergeCustomers removes fromId and reassigns invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', country: 'DE', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', country: 'FR', tier: 'silver' },
+  ];
+  const invoices = [
+    { customerId: 'C-001', number: 'INV-001', status: 'issued' },
+    { customerId: 'C-001', number: 'INV-002', status: 'draft' },
+    { customerId: 'C-002', number: 'INV-003', status: 'issued' },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.deepEqual(result.value.customers[0].id, 'C-002');
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+  assert.equal(result.value.invoices[1].customerId, 'C-002');
+  assert.equal(result.value.invoices[2].customerId, 'C-002');
+});
+
+test('mergeCustomers normalizes IDs', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', country: 'DE', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', country: 'FR', tier: 'silver' },
+  ];
+  const invoices = [{ customerId: 'C-001', number: 'INV-001', status: 'issued' }];
+
+  const result = mergeCustomers(customers, invoices, ' c-001 ', ' C-002 ');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.invoices[0].customerId, 'C-002');
+});
+
+test('mergeCustomers reports SAME_CUSTOMER when fromId equals intoId', () => {
