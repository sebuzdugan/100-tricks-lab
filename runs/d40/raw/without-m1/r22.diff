+import assert from 'node:assert';
+import { describe, it } from 'node:test';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+import { createInvoice, addLine, applyVoucher } from '../src/invoices.js';
+import { roundCents } from '../src/money.js';
+
+describe('lineTotal', () => {
+  it('calculates qty times unitPrice', () => {
+    const line = { qty: 5, unitPrice: 8500 };
+    assert.equal(lineTotal(line), 42500);
+  });
+
+  it('handles single unit', () => {
+    const line = { qty: 1, unitPrice: 1000 };
+    assert.equal(lineTotal(line), 1000);
+  });
+
+  it('handles large quantities', () => {
+    const line = { qty: 100, unitPrice: 5000 };
+    assert.equal(lineTotal(line), 500000);
+  });
+});
+
+describe('invoiceTotals', () => {
+  it('calculates subtotal and total for a single line', () => {
+    const invoice = {
+      lines: [{ qty: 5, unitPrice: 8500, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 42500);
+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 42500);
+  });
+
+  it('calculates subtotal and total for multiple lines', () => {
+    const invoice = {
+      lines: [
+        { qty: 5, unitPrice: 8500, vatRate: 0 },
+        { qty: 3, unitPrice: 9500, vatRate: 0 },
+      ],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 42500 + 28500);
+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 42500 + 28500);
+  });
+
+  it('handles empty invoice', () => {
+    const invoice = { lines: [] };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 0);
+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 0);
+  });
+
+  it('works with invoice from createInvoice', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-002',
+      issueDate: '2025-12-15',
+      lines: [
+        { sku: 'DES-HOUR', qty: 5 },
+        { sku: 'DEV-HOUR', qty: 3 },
+      ],
+    });
+
+    assert(invoiceResult.ok);
+    const totals = invoiceTotals(invoiceResult.value);
+    const expectedSubtotal = 5 * 8500 + 3 * 9500;
+    const expectedVat = roundCents(5 * 8500 * 0.21) + roundCents(3 * 9500 * 0.21);
+    assert.equal(totals.subtotal, expectedSubtotal);
+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, expectedVat);
+    assert.equal(totals.total, expectedSubtotal + expectedVat);
+  });
+
+  it('calculates discount for a single line with 10% discount', () => {
+    const invoice = {
+      lines: [{ qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 42500);
+    assert.equal(totals.discount, 4250);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 38250);
+  });
+
+  it('calculates discount with decimal percentage', () => {
+    const invoice = {
+      lines: [{ qty: 5, unitPrice: 8500, discountPercent: 12.5, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 42500);
+    assert.equal(totals.discount, 5312.5);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 37187.5);
+  });
+
+  it('calculates total discount across multiple lines', () => {
+    const invoice = {
+      lines: [
+        { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 0 },
+        { qty: 3, unitPrice: 9500, discountPercent: 20, vatRate: 0 },
+      ],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 42500 + 28500);
+    assert.equal(totals.discount, 4250 + 5700);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 42500 + 28500 - 4250 - 5700);
+  });
+
+  it('clamps total at 0 when discount exceeds subtotal', () => {
+    const invoice = {
+      lines: [{ qty: 5, unitPrice: 8500, discountPercent: 100, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 42500);
+    assert.equal(totals.discount, 42500);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 0);
+  });
+
+  it('handles mixed discounted and non-discounted lines', () => {
+    const invoice = {
+      lines: [
+        { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 },
+        { qty: 5, unitPrice: 2000, discountPercent: 50, vatRate: 0 },
+      ],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 10000 + 10000);
+    assert.equal(totals.discount, 5000);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 15000);
+  });
+
+  it('works with invoice from createInvoice with discounts', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [
+        { sku: 'DES-HOUR', qty: 5, discountPercent: 10 },
+        { sku: 'DEV-HOUR', qty: 3, discountPercent: 5 },
+      ],
+    });
+
+    assert(invoiceResult.ok);
+    const totals = invoiceTotals(invoiceResult.value);
+    const subtotal = 5 * 8500 + 3 * 9500;
+    const discount = (5 * 8500) * 0.1 + (3 * 9500) * 0.05;
+    const vat1 = roundCents((5 * 8500 - (5 * 8500) * 0.1) * 0.21);
+    const vat2 = roundCents((3 * 9500 - (3 * 9500) * 0.05) * 0.21);
+    const vat = vat1 + vat2;
+    assert.equal(totals.subtotal, subtotal);
+    assert.equal(totals.discount, discount);
+    assert.equal(totals.vat, vat);
+    assert.equal(totals.total, subtotal - discount + vat);
+  });
+
+  it('calculates totals with tier discounts applied', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [
+        { sku: 'DES-HOUR', qty: 5 },
+        { sku: 'DEV-HOUR', qty: 3 },
+      ],
+    });
+
+    assert(invoiceResult.ok);
+    const totals = invoiceTotals(invoiceResult.value);
+    const subtotal = 5 * 8500 + 3 * 9500;
+    const discount = (5 * 8500) * 0.05 + (3 * 9500) * 0.05;
+    const afterDiscount1 = 5 * 8500 - (5 * 8500) * 0.05;
+    const afterDiscount2 = 3 * 9500 - (3 * 9500) * 0.05;
+    const vat = roundCents(afterDiscount1 * 0.21) + roundCents(afterDiscount2 * 0.21);
+    assert.equal(totals.subtotal, subtotal);
+    assert.equal(totals.discount, discount);
+    assert.equal(totals.vat, vat);
+    assert.equal(totals.total, subtotal - discount + vat);
+  });
+
+  it('applies correct discount when mixing tier and explicit discounts', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-003',
+      issueDate: '2025-12-15',
+      lines: [
+        { sku: 'DES-HOUR', qty: 10 },
+        { sku: 'DEV-HOUR', qty: 5, discountPercent: 0 },
+      ],
+    });
+
+    assert(invoiceResult.ok);
+    const totals = invoiceTotals(invoiceResult.value);
+    const subtotal = 10 * 8500 + 5 * 9500;
+    const tierDiscount = (10 * 8500) * 0.025;
+    const explicitDiscount = 0;
+    const discount = tierDiscount + explicitDiscount;
+    assert.equal(totals.subtotal, subtotal);
+    assert.equal(totals.discount, discount);
+  });
+
+  it('calculates VAT on line after discount', () => {
+    const invoice = {
+      lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+    };
+    const totals = invoiceTotals(invoice);
+    const subtotal = 100000;
+    const discount = 10000;
+    const afterDiscount = 90000;
+    const vat = roundCents(90000 * 0.21);
+    assert.equal(totals.subtotal, subtotal);
+    assert.equal(totals.discount, discount);
+    assert.equal(totals.vat, vat);
+    assert.equal(totals.total, subtotal - discount + vat);
+  });
+
+  it('calculates VAT with 21% rate', () => {
+    const invoice = {
+      lines: [{ qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+    };
+    const totals = invoiceTotals(invoice);
+    const subtotal = 10000;
+    const vat = roundCents(10000 * 0.21);
+    assert.equal(totals.subtotal, subtotal);
+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, vat);
+    assert.equal(totals.total, subtotal + vat);
