+    assert(invoiceResult.ok);
+    const totals = invoiceTotals(invoiceResult.value);
+    const subtotal = 100 * 8500;
+    const tierDiscount = subtotal * 0.05;
+    const afterDiscount = subtotal - tierDiscount;
+    const vat = roundCents(afterDiscount * 0.21);
+    assert.equal(totals.subtotal, subtotal);
+    assert.equal(totals.discount, tierDiscount);
+    assert.equal(totals.vat, vat);
