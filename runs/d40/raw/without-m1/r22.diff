+    const totalVat = vat1 + vat2;
+    assert.equal(totals.subtotal, subtotal);
+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, totalVat);
+    assert.equal(totals.total, subtotal + totalVat);
+  });
+
+  it('rounds VAT per line before summing', () => {
+    const invoice = {
+      lines: [
+        { qty: 3, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+        { qty: 3, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+      ],
+    };
+    const totals = invoiceTotals(invoice);
+    const vat1 = roundCents(3000 * 0.21);
+    const vat2 = roundCents(3000 * 0.21);
+    const expectedVat = vat1 + vat2;
+    assert.equal(totals.vat, expectedVat);
+  });
+
+  it('calculates VAT on amount after discount and tier discount', () => {
+    const invoiceResult = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
