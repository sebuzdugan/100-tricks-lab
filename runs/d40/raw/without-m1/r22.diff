+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, vat);
+    assert.equal(totals.total, subtotal + vat);
+  });
+
+  it('calculates VAT with 0% rate', () => {
+    const invoice = {
+      lines: [{ qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 10000);
+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 10000);
+  });
+
+  it('sums VAT across multiple lines', () => {
+    const invoice = {
+      lines: [
+        { qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+        { qty: 5, unitPrice: 2000, discountPercent: 0, vatRate: 9 },
