+import { describe, it } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { createInvoice } from '../src/invoices.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+
+describe('createInvoice', () => {
+  it('creates a valid invoice with one line', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const sku = products[0].sku;
+    const customerId = customers[0].id;
+
+    const result = createInvoice({
+      customerId,
+      issueDate: '2025-01-15',
+      lines: [{ sku, qty: 2 }],
+    });
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, customerId);
+    assert.equal(result.value.issueDate, '2025-01-15');
+    assert.equal(result.value.status, 'draft');
+    assert.equal(result.value.lines.length, 1);
+    assert.equal(result.value.lines[0].sku, sku);
+    assert.equal(result.value.lines[0].name, products[0].name);
+    assert.equal(result.value.lines[0].qty, 2);
+    assert.equal(result.value.lines[0].unitPrice, products[0].unitPrice);
+    assert.equal(result.value.lines[0].vatRate, products[0].vatRate);
+  });
+
+  it('creates a valid invoice with multiple lines', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer = customers[0];
+    const product1 = products[0];
+    const product2 = products[1];
+
+    const result = createInvoice({
+      customerId: customer.id,
+      issueDate: '2025-02-20',
+      lines: [
+        { sku: product1.sku, qty: 3 },
+        { sku: product2.sku, qty: 5 },
+      ],
+    });
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.lines.length, 2);
+    assert.equal(result.value.lines[0].sku, product1.sku);
+    assert.equal(result.value.lines[0].qty, 3);
+    assert.equal(result.value.lines[1].sku, product2.sku);
+    assert.equal(result.value.lines[1].qty, 5);
+  });
+
+  it('does not mutate the input lines array', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const lines = [{ sku: products[0].sku, qty: 1 }];
+    const linesCopy = JSON.parse(JSON.stringify(lines));
+
+    createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines,
+    });
+
+    assert.deepEqual(lines, linesCopy);
+  });
+
+  describe('customer validation', () => {
+    it('returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+      const products = listProducts();
+      const result = createInvoice({
+        customerId: 'unknown-customer-id',
+        issueDate: '2025-01-15',
+        lines: [{ sku: products[0].sku, qty: 1 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+    });
+  });
+
+  describe('date validation', () => {
+    it('returns DATE_INVALID for wrong format (DD/MM/YYYY)', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '15/01/2025',
+        lines: [{ sku: products[0].sku, qty: 1 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'DATE_INVALID');
+    });
+
+    it('returns DATE_INVALID for wrong format (no hyphens)', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '20250115',
+        lines: [{ sku: products[0].sku, qty: 1 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'DATE_INVALID');
+    });
+
+    it('returns DATE_INVALID for impossible date (Feb 30)', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-02-30',
+        lines: [{ sku: products[0].sku, qty: 1 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'DATE_INVALID');
+    });
+
+    it('returns DATE_INVALID for impossible date (month 13)', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-13-01',
+        lines: [{ sku: products[0].sku, qty: 1 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'DATE_INVALID');
+    });
+
+    it('accepts valid leap year date', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2024-02-29',
+        lines: [{ sku: products[0].sku, qty: 1 }],
+      });
+
+      assert.equal(result.ok, true);
+    });
+
+    it('returns DATE_INVALID for non-leap year Feb 29', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-02-29',
+        lines: [{ sku: products[0].sku, qty: 1 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'DATE_INVALID');
+    });
+  });
+
+  describe('lines validation', () => {
+    it('returns NO_LINES for empty lines array', () => {
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'NO_LINES');
+    });
+
+    it('returns NO_LINES when lines is not an array', () => {
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: null,
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'NO_LINES');
+    });
+  });
+
+  describe('quantity validation', () => {
+    it('returns QTY_INVALID for non-integer quantity', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [{ sku: products[0].sku, qty: 1.5 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'QTY_INVALID');
+    });
+
+    it('returns QTY_INVALID for zero quantity', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [{ sku: products[0].sku, qty: 0 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'QTY_INVALID');
+    });
+
+    it('returns QTY_INVALID for negative quantity', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [{ sku: products[0].sku, qty: -5 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'QTY_INVALID');
+    });
+
+    it('returns QTY_INVALID for string quantity', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [{ sku: products[0].sku, qty: '5' }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'QTY_INVALID');
+    });
+
+    it('accepts large positive integer quantities', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [{ sku: products[0].sku, qty: 999999 }],
+      });
+
+      assert.equal(result.ok, true);
+      assert.equal(result.value.lines[0].qty, 999999);
+    });
+  });
+
+  describe('SKU validation', () => {
+    it('returns UNKNOWN_SKU for unknown product', () => {
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [{ sku: 'UNKNOWN-SKU-12345', qty: 1 }],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'UNKNOWN_SKU');
+    });
+
+    it('returns UNKNOWN_SKU when first line has unknown SKU', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [
+          { sku: 'UNKNOWN-SKU', qty: 1 },
+          { sku: products[0].sku, qty: 1 },
+        ],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'UNKNOWN_SKU');
+    });
+
+    it('returns UNKNOWN_SKU when second line has unknown SKU', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [
+          { sku: products[0].sku, qty: 1 },
+          { sku: 'UNKNOWN-SKU', qty: 1 },
+        ],
+      });
+
+      assert.equal(result.ok, false);
+      assert.equal(result.error, 'UNKNOWN_SKU');
+    });
+  });
+
+  describe('error priority', () => {
+    it('validates customer before date', () => {
+      const products = listProducts();
+      const result = createInvoice({
+        customerId: 'unknown',
+        issueDate: 'invalid-date',
+        lines: [{ sku: products[0].sku, qty: 1 }],
+      });
+
+      assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+    });
+
+    it('validates date before lines', () => {
+      const products = listProducts();
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: 'invalid-date',
+        lines: [],
+      });
+
+      assert.equal(result.error, 'DATE_INVALID');
+    });
+
+    it('validates lines array before line contents', () => {
+      const customers = listCustomers();
+      const result = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [],
+      });
+
+      assert.equal(result.error, 'NO_LINES');
+    });
+  });
+});
