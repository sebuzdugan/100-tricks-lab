+describe('lineTotal', () => {
+  it('calculates qty times unitPrice', () => {
+    const total = lineTotal({ qty: 3, unitPrice: 500 });
+    assert.equal(total, 1500);
+  });
+
+  it('returns a whole number of cents', () => {
+    const total = lineTotal({ qty: 3, unitPrice: 500 });
+    assert.equal(Number.isInteger(total), true);
+  });
+
+  it('handles qty of 1', () => {
+    const total = lineTotal({ qty: 1, unitPrice: 999 });
+    assert.equal(total, 999);
+  });
+
+  it('handles large quantities', () => {
+    const total = lineTotal({ qty: 1000000, unitPrice: 50 });
+    assert.equal(total, 50000000);
+  });
+
+  it('rounds fractional cents to nearest even (banker\'s rounding)', () => {
+    const total1 = lineTotal({ qty: 3, unitPrice: 100.5 });
+    assert.equal(total1, 302);
+
+    const total2 = lineTotal({ qty: 3, unitPrice: 100.4 });
+    assert.equal(total2, 301);
+  });
+
+  it('handles products with low unit prices', () => {
+    const total = lineTotal({ qty: 3, unitPrice: 1 });
+    assert.equal(total, 3);
+  });
+
+  it('does not mutate the input', () => {
+    const line = { qty: 5, unitPrice: 200 };
+    const lineCopy = JSON.parse(JSON.stringify(line));
+    lineTotal(line);
+    assert.deepEqual(line, lineCopy);
+  });
+});
