+describe('nextInvoiceNumber', () => {
+  it('starts at 0001 for a new year with no existing numbers', () => {
+    const number = nextInvoiceNumber([], '2025-01-15');
+    assert.equal(number, 'INV-2025-0001');
+  });
+
+  it('returns 0001 when existing numbers are from previous year', () => {
+    const existingNumbers = ['INV-2024-0001', 'INV-2024-0002'];
+    const number = nextInvoiceNumber(existingNumbers, '2025-01-15');
+    assert.equal(number, 'INV-2025-0001');
+  });
+
+  it('increments counter for same year', () => {
+    const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+    const number = nextInvoiceNumber(existingNumbers, '2025-06-01');
+    assert.equal(number, 'INV-2025-0003');
+  });
+
+  it('handles unsorted existing numbers', () => {
+    const existingNumbers = ['INV-2025-0005', 'INV-2025-0001', 'INV-2025-0003'];
+    const number = nextInvoiceNumber(existingNumbers, '2025-12-31');
+    assert.equal(number, 'INV-2025-0006');
+  });
+
+  it('pads counter to 4 digits', () => {
+    const existingNumbers = Array.from({ length: 100 }, (_, i) => `INV-2025-${String(i + 1).padStart(4, '0')}`);
+    const number = nextInvoiceNumber(existingNumbers, '2025-06-15');
+    assert.equal(number, 'INV-2025-0101');
+  });
+
+  it('ignores numbers from other years', () => {
+    const existingNumbers = ['INV-2023-9999', 'INV-2024-0050', 'INV-2025-0002', 'INV-2026-0001'];
+    const number = nextInvoiceNumber(existingNumbers, '2025-03-15');
+    assert.equal(number, 'INV-2025-0003');
+  });
+
+  it('handles large counters', () => {
+    const existingNumbers = ['INV-2025-9998'];
+    const number = nextInvoiceNumber(existingNumbers, '2025-12-31');
+    assert.equal(number, 'INV-2025-9999');
+  });
+
+  it('extracts year correctly from date', () => {
+    const number1 = nextInvoiceNumber([], '2024-01-01');
+    assert.equal(number1, 'INV-2024-0001');
+
+    const number2 = nextInvoiceNumber([], '2099-12-31');
+    assert.equal(number2, 'INV-2099-0001');
+  });
+
+  it('works with any date in the year', () => {
+    const existingNumbers = ['INV-2025-0001'];
+    const number1 = nextInvoiceNumber(existingNumbers, '2025-01-01');
+    const number2 = nextInvoiceNumber(existingNumbers, '2025-06-15');
+    const number3 = nextInvoiceNumber(existingNumbers, '2025-12-31');
+
+    assert.equal(number1, 'INV-2025-0002');
+    assert.equal(number2, 'INV-2025-0002');
+    assert.equal(number3, 'INV-2025-0002');
+  });
+});
+
+describe('issueInvoice', () => {
+  it('issues a draft invoice with a number and changed status', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    });
+
+    const result = issueInvoice(invoiceResult.value, []);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.status, 'issued');
+    assert.equal(result.value.number, 'INV-2025-0001');
+  });
+
+  it('assigns the next available number', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-02-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    });
+
+    const existingNumbers = ['INV-2025-0001', 'INV-2025-0002'];
+    const result = issueInvoice(invoiceResult.value, existingNumbers);
+
+    assert.equal(result.value.number, 'INV-2025-0003');
+  });
+
+  it('uses the invoice\'s issue date for numbering', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2024-12-31',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    });
+
+    const result = issueInvoice(invoiceResult.value, []);
+
+    assert.equal(result.value.number, 'INV-2024-0001');
+  });
+
+  it('does not mutate the original invoice', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    });
+
+    const invoice = invoiceResult.value;
+    const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+
+    issueInvoice(invoice, []);
+
+    assert.deepEqual(invoice, invoiceCopy);
+  });
+
+  it('returns NOT_DRAFT for non-draft invoice', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    });
+
+    const invoice = invoiceResult.value;
+    invoice.status = 'issued';
+
+    const result = issueInvoice(invoice, []);
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NOT_DRAFT');
+  });
+
+  it('preserves all other invoice properties', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer = customers[0];
+    const sku = products[0].sku;
+    const invoiceResult = createInvoice({
+      customerId: customer.id,
+      issueDate: '2025-03-15',
+      lines: [{ sku, qty: 5 }],
+    });
+
+    const result = issueInvoice(invoiceResult.value, []);
+
+    assert.equal(result.value.customerId, customer.id);
+    assert.equal(result.value.issueDate, '2025-03-15');
+    assert.equal(result.value.lines.length, 1);
+    assert.equal(result.value.lines[0].sku, sku);
+    assert.equal(result.value.lines[0].qty, 5);
+  });
+
+  it('can issue multiple invoices from the same year', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const existingNumbers = [];
+
+    for (let i = 0; i < 3; i++) {
+      const invoiceResult = createInvoice({
+        customerId: customers[0].id,
+        issueDate: '2025-01-15',
+        lines: [{ sku: products[i % products.length].sku, qty: 1 }],
+      });
+
+      const result = issueInvoice(invoiceResult.value, existingNumbers);
+      assert.equal(result.ok, true);
+      existingNumbers.push(result.value.number);
+    }
+
+    assert.deepEqual(existingNumbers, ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003']);
+  });
+
+  it('resets counter for new year', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const existingNumbers = ['INV-2024-0050'];
+
+    const invoice2024 = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2024-12-31',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    }).value;
+
+    const invoice2025 = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-01',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    }).value;
+
+    const result2024 = issueInvoice(invoice2024, existingNumbers);
+    existingNumbers.push(result2024.value.number);
+
+    const result2025 = issueInvoice(invoice2025, existingNumbers);
+
+    assert.equal(result2024.value.number, 'INV-2024-0051');
+    assert.equal(result2025.value.number, 'INV-2025-0001');
+  });
+});
