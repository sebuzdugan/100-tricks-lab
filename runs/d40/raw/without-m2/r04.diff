index 0000000..2796c81
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,28 @@
+/**
+ * Generate the next invoice number for a given year.
+ * Format: INV-<year>-<4-digit counter starting at 0001>.
+ * @param {Array<string>} existingNumbers - Already-used invoice numbers (any order)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+
+  // Find all existing numbers for this year and extract counters
+  const thisYearCounters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const match = num.match(/^INV-\d{4}-(\d{4})$/);
+      return match ? parseInt(match[1], 10) : 0;
+    });
+
+  // Find the highest counter, default to 0
+  const maxCounter = thisYearCounters.length === 0 ? 0 : Math.max(...thisYearCounters);
+  const nextCounter = maxCounter + 1;
+
+  // Pad counter to 4 digits
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+
+  return `${prefix}${paddedCounter}`;
+}
