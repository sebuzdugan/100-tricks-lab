+import { describe, it } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+
+describe('renderInvoiceText', () => {
+  it('renders a draft invoice', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+    const lines = text.split('\n');
+
+    assert.equal(lines[0], 'DRAFT');
+    assert.equal(lines[1], customers[0].name);
+  });
+
+  it('renders an issued invoice with number', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    });
+
+    const issuedResult = issueInvoice(invoiceResult.value, []);
+    const text = renderInvoiceText(issuedResult.value);
+    const lines = text.split('\n');
+
+    assert.equal(lines[0], 'INV-2025-0001');
+  });
+
+  it('includes customer name on second line', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+    const lines = text.split('\n');
+
+    assert.equal(lines[1], customers[0].name);
+  });
+
+  it('renders a single line item', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const product = products[0];
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: product.sku, qty: 3 }],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+    const lines = text.split('\n');
+
+    // Line format: qty x name @ €unitPrice = €total
+    assert(lines[2].includes(`3x ${product.name} @`));
+    assert(lines[2].includes('='));
+  });
+
+  it('renders multiple line items', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [
+        { sku: products[0].sku, qty: 2 },
+        { sku: products[1].sku, qty: 3 },
+      ],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+    const lines = text.split('\n');
+
+    assert.equal(lines.length, 5); // DRAFT + name + 2 items + total
+    assert(lines[2].includes(`2x ${products[0].name}`));
+    assert(lines[3].includes(`3x ${products[1].name}`));
+  });
+
+  it('formats amounts as euros', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+
+    assert(text.includes('€'));
+  });
+
+  it('includes total line at the end', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+    const lines = text.split('\n');
+
+    assert(lines[lines.length - 1].startsWith('Total:'));
+  });
+
+  it('calculates correct total for multiple items', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [
+        { sku: products[0].sku, qty: 2 },
+        { sku: products[1].sku, qty: 1 },
+      ],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+    const lines = text.split('\n');
+    const totalLine = lines[lines.length - 1];
+
+    // Total line should have two € signs (total prefix and amount)
+    assert.equal((totalLine.match(/€/g) || []).length, 1);
+    assert(totalLine.startsWith('Total: €'));
+  });
+
+  it('shows DRAFT for invoices without a number', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    });
+
+    assert.equal(invoiceResult.value.number, undefined);
+
+    const text = renderInvoiceText(invoiceResult.value);
+    const lines = text.split('\n');
+
+    assert.equal(lines[0], 'DRAFT');
+  });
+
+  it('shows invoice number when present', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-06-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    });
+
+    const issuedResult = issueInvoice(invoiceResult.value, ['INV-2025-0001']);
+    const text = renderInvoiceText(issuedResult.value);
+    const lines = text.split('\n');
+
+    assert.equal(lines[0], 'INV-2025-0002');
+  });
+
+  it('renders with different customers', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+
+    for (let i = 0; i < Math.min(2, customers.length); i++) {
+      const invoiceResult = createInvoice({
+        customerId: customers[i].id,
+        issueDate: '2025-01-15',
+        lines: [{ sku: products[0].sku, qty: 1 }],
+      });
+
+      const text = renderInvoiceText(invoiceResult.value);
+      const lines = text.split('\n');
+
+      assert.equal(lines[1], customers[i].name);
+    }
+  });
+
+  it('renders correctly with large quantities', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 1000 }],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+
+    assert(text.includes('1000x'));
+  });
+
+  it('handles zero-padded invoice numbers', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    });
+
+    const issuedResult = issueInvoice(invoiceResult.value, []);
+    const text = renderInvoiceText(issuedResult.value);
+    const lines = text.split('\n');
+
+    // First issued invoice should be 0001 with leading zeros
+    assert.equal(lines[0], 'INV-2025-0001');
+  });
+
+  it('renders an invoice with all properties', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-03-20',
+      lines: [
+        { sku: products[0].sku, qty: 5 },
+        { sku: products[1].sku, qty: 3 },
+      ],
+    });
+
+    const issuedResult = issueInvoice(invoiceResult.value, []);
+    const text = renderInvoiceText(issuedResult.value);
+
+    // Verify structure: number, customer, lines, total
+    assert(text.includes('INV-'));
+    assert(text.includes(customers[0].name));
+    assert(text.includes('5x'));
+    assert(text.includes('3x'));
+    assert(text.includes('Total:'));
+  });
+
+  it('returns string with newlines', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+
+    assert.equal(typeof text, 'string');
+    assert(text.includes('\n'));
+  });
+
+  it('formats line items with consistent format', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const invoiceResult = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2025-01-15',
+      lines: [
+        { sku: products[0].sku, qty: 2 },
+        { sku: products[1].sku, qty: 3 },
+      ],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+    const lines = text.split('\n');
+
+    // Each line item should follow pattern: qty x name @ price = total
+    const lineItem1 = lines[2];
+    const lineItem2 = lines[3];
+
+    assert(lineItem1.match(/^\d+x .* @ €[\d,.]+ = €[\d,.]+$/));
+    assert(lineItem2.match(/^\d+x .* @ €[\d,.]+ = €[\d,.]+$/));
+  });
+});
