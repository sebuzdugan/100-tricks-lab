+import { formatEuros } from './money.js';
+import { lineTotal } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ number?: string, customerName: string, lines: Array<{ qty: number, name: string, unitPrice: number }> }}
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const lines = [];
+
+  // First line: invoice number or DRAFT
+  const numberLine = invoice.number ?? 'DRAFT';
+  lines.push(numberLine);
+
+  // Second line: customer name
+  lines.push(invoice.customerName);
+
+  // Invoice lines
+  for (const line of invoice.lines) {
+    const total = lineTotal(line);
+    const lineText = `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    lines.push(lineText);
+  }
+
+  // Total line
+  const invoiceTotals = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  lines.push(`Total: ${formatEuros(invoiceTotals)}`);
+
+  return lines.join('\n');
+}
