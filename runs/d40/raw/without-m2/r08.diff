+ * Calculate the VAT for a single line: (lineTotal - lineDiscount) × (vatRate / 100), rounded per line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }}
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  const vatRate = line.vatRate ?? 0;
+  const vat = roundCents(amountAfterDiscount * (vatRate / 100));
+  return Math.max(0, vat);
+}
+
+/**
+ * Calculate the totals for an invoice: subtotal, discount, vat, and total.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }> }}
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
   const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
-  const total = Math.max(0, subtotal - discount);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const total = Math.max(0, subtotal - discount + vat);
   return {
     subtotal,
     discount,
+    vat,
     total,
   };
 }
