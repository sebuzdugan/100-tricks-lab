diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..39b1a66
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,171 @@
+import { describe, it } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+describe('isValidDate', () => {
+  it('accepts valid dates in YYYY-MM-DD format', () => {
+    assert.equal(isValidDate('2025-01-15'), true);
+    assert.equal(isValidDate('2024-12-31'), true);
+    assert.equal(isValidDate('2025-06-01'), true);
+  });
+
+  it('rejects invalid format (no hyphens)', () => {
+    assert.equal(isValidDate('20250115'), false);
+  });
+
+  it('rejects invalid format (slashes)', () => {
+    assert.equal(isValidDate('2025/01/15'), false);
+  });
+
+  it('rejects invalid format (DD/MM/YYYY)', () => {
+    assert.equal(isValidDate('15/01/2025'), false);
+  });
+
+  it('rejects impossible date (Feb 30)', () => {
+    assert.equal(isValidDate('2025-02-30'), false);
+  });
+
+  it('rejects impossible date (month 13)', () => {
+    assert.equal(isValidDate('2025-13-01'), false);
+  });
+
+  it('accepts valid leap year date', () => {
+    assert.equal(isValidDate('2024-02-29'), true);
+  });
+
+  it('rejects non-leap year Feb 29', () => {
+    assert.equal(isValidDate('2025-02-29'), false);
+  });
+
+  it('rejects null', () => {
+    assert.equal(isValidDate(null), false);
+  });
+
+  it('rejects undefined', () => {
+    assert.equal(isValidDate(undefined), false);
+  });
+
+  it('rejects empty string', () => {
+    assert.equal(isValidDate(''), false);
+  });
+
+  it('rejects date with extra characters', () => {
+    assert.equal(isValidDate('2025-01-15 '), false);
+    assert.equal(isValidDate(' 2025-01-15'), false);
+  });
+
+  it('rejects date with time component', () => {
+    assert.equal(isValidDate('2025-01-15T00:00:00Z'), false);
+  });
+
+  it('rejects month 00', () => {
+    assert.equal(isValidDate('2025-00-15'), false);
+  });
+
+  it('rejects day 00', () => {
+    assert.equal(isValidDate('2025-01-00'), false);
+  });
+});
+
+describe('addDays', () => {
+  it('adds positive number of days', () => {
+    assert.equal(addDays('2025-01-15', 1), '2025-01-16');
+    assert.equal(addDays('2025-01-15', 10), '2025-01-25');
+  });
+
+  it('adds zero days', () => {
+    assert.equal(addDays('2025-01-15', 0), '2025-01-15');
+  });
+
+  it('subtracts with negative days', () => {
+    assert.equal(addDays('2025-01-15', -1), '2025-01-14');
+    assert.equal(addDays('2025-01-15', -10), '2025-01-05');
+  });
+
+  it('handles month boundaries', () => {
+    assert.equal(addDays('2025-01-31', 1), '2025-02-01');
+    assert.equal(addDays('2025-02-01', -1), '2025-01-31');
+  });
+
+  it('handles year boundaries', () => {
+    assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+    assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  });
+
+  it('handles leap year', () => {
+    assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+    assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  });
+
+  it('handles large number of days', () => {
+    assert.equal(addDays('2025-01-01', 365), '2026-01-01');
+    assert.equal(addDays('2025-01-01', 730), '2027-01-01');
+  });
+
+  it('works in UTC', () => {
+    const result = addDays('2025-06-15', 5);
+    assert.equal(result, '2025-06-20');
+  });
+
+  it('returns date in YYYY-MM-DD format', () => {
+    const result = addDays('2025-01-15', 5);
+    assert.equal(/^\d{4}-\d{2}-\d{2}$/.test(result), true);
+  });
+});
+
+describe('daysBetween', () => {
+  it('calculates positive difference', () => {
+    assert.equal(daysBetween('2025-01-15', '2025-01-20'), 5);
+  });
+
+  it('calculates negative difference', () => {
+    assert.equal(daysBetween('2025-01-20', '2025-01-15'), -5);
+  });
+
+  it('returns zero for same date', () => {
+    assert.equal(daysBetween('2025-01-15', '2025-01-15'), 0);
+  });
+
+  it('handles one day difference', () => {
+    assert.equal(daysBetween('2025-01-15', '2025-01-16'), 1);
+    assert.equal(daysBetween('2025-01-16', '2025-01-15'), -1);
+  });
+
+  it('handles month boundaries', () => {
+    assert.equal(daysBetween('2025-01-31', '2025-02-01'), 1);
+    assert.equal(daysBetween('2025-02-01', '2025-01-31'), -1);
+  });
+
+  it('handles year boundaries', () => {
+    assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+    assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+  });
+
+  it('handles leap year', () => {
+    assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+  });
+
+  it('handles large date differences', () => {
+    assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+    assert.equal(daysBetween('2024-01-01', '2026-01-01'), 731);
+  });
+
+  it('calculates whole days only', () => {
+    assert.equal(daysBetween('2025-01-01', '2025-01-02'), 1);
+    assert.equal(daysBetween('2025-01-01', '2025-01-03'), 2);
+  });
+
+  it('works with non-consecutive dates', () => {
+    assert.equal(daysBetween('2025-01-15', '2025-02-28'), 44);
+  });
+
+  it('works in UTC', () => {
+    const days = daysBetween('2025-06-01', '2025-06-11');
+    assert.equal(days, 10);
+  });
+
+  it('returns integer', () => {
+    const result = daysBetween('2025-01-15', '2025-01-20');
+    assert.equal(Number.isInteger(result), true);
+  });
+});
