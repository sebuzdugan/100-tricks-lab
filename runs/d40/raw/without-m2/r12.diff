+import { isValidDate, addDays } from './dates.js';
+
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
+    const year = parseInt(issueDate.substring(0, 4), 10);
+    const month = parseInt(issueDate.substring(5, 7), 10);
+    const nextMonth = month === 12 ? 1 : month + 1;
+    const nextYear = month === 12 ? year + 1 : year;
+    const firstOfNext = `${String(nextYear).padStart(4, '0')}-${String(nextMonth).padStart(2, '0')}-01`;
+    return addDays(firstOfNext, -1);
+  }
+  return null;
+}
 
