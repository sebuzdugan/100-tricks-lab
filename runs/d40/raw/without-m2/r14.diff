+import { describe, it } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+
+describe('statement', () => {
+  function createTestInvoices() {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer = customers[0];
+
+    const inv1 = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    }).value;
+    const issuedInv1 = issueInvoice(inv1, []).value;
+
+    const inv2 = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-02-20',
+      lines: [{ sku: products[1].sku, qty: 3 }],
+    }).value;
+    const issuedInv2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+    const inv3 = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-03-10',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    }).value;
+
+    return {
+      customerId: customer.id,
+      invoices: [issuedInv1, issuedInv2, inv3],
+      customer,
+    };
+  }
+
+  it('returns invoices for a customer up to asOf date', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-02-28');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 2);
+    assert.equal(result.value.invoices[0].issueDate, '2026-01-15');
+    assert.equal(result.value.invoices[1].issueDate, '2026-02-20');
+  });
+
+  it('excludes draft invoices', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-03-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 2);
+    assert.equal(result.value.invoices[0].issueDate, '2026-01-15');
+    assert.equal(result.value.invoices[1].issueDate, '2026-02-20');
+  });
+
+  it('includes invoices with exact asOf date', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-01-15');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].issueDate, '2026-01-15');
+  });
+
+  it('excludes invoices after asOf date', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-02-15');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].issueDate, '2026-01-15');
+  });
+
+  it('returns empty list when no invoices match', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-01-01');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 0);
+    assert.equal(result.value.totalDue, 0);
+  });
+
+  it('sorts invoices by issueDate', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer = customers[1];
+
+    const inv1 = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-03-10',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    }).value;
+    const issuedInv1 = issueInvoice(inv1, []).value;
+
+    const inv2 = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-01-05',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    }).value;
+    const issuedInv2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+    const inv3 = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-02-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    }).value;
+    const issuedInv3 = issueInvoice(inv3, ['INV-2026-0001', 'INV-2026-0002']).value;
+
+    const result = statement(customer.id, [issuedInv1, issuedInv2, issuedInv3], '2026-12-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 3);
+    assert.equal(result.value.invoices[0].issueDate, '2026-01-05');
+    assert.equal(result.value.invoices[1].issueDate, '2026-02-15');
+    assert.equal(result.value.invoices[2].issueDate, '2026-03-10');
+  });
+
+  it('calculates total due across multiple invoices', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-02-28');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.totalDue > 0, true);
+    const sumDue = result.value.invoices.reduce((sum, inv) => sum + inv.due, 0);
+    assert.equal(result.value.totalDue, sumDue);
+  });
+
+  it('includes due amount for each invoice', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-02-28');
+
+    assert.equal(result.ok, true);
+    assert.ok(result.value.invoices.length > 0);
+    for (const inv of result.value.invoices) {
+      assert.equal(typeof inv.due, 'number');
+      assert.equal(inv.due >= 0, true);
+    }
+  });
+
+  it('returns invoice with number, issueDate, dueDate, total, and due', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-02-28');
+
+    assert.equal(result.ok, true);
+    const inv = result.value.invoices[0];
+    assert.ok(inv.number);
+    assert.ok(inv.issueDate);
+    assert.ok(inv.dueDate);
+    assert.equal(typeof inv.total, 'number');
+    assert.equal(typeof inv.due, 'number');
+  });
+
+  it('includes partially paid invoices', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer = customers[2];
+
+    const inv = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 5 }],
+    }).value;
+    const issuedInv = issueInvoice(inv, []).value;
+
+    const partiallyPaidInv = recordPayment(issuedInv, { amount: 10000, date: '2026-01-20' }).value;
+
+    const result = statement(customer.id, [partiallyPaidInv], '2026-02-28');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].due < result.value.invoices[0].total, true);
+  });
+
+  it('excludes paid invoices', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer = customers[3];
+
+    const inv = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    }).value;
+    const issuedInv = issueInvoice(inv, []).value;
+
+    const totals = invoiceTotals(issuedInv);
+    const paidInv = recordPayment(issuedInv, { amount: totals.total, date: '2026-01-20' }).value;
+
+    const result = statement(customer.id, [paidInv], '2026-02-28');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 0);
+  });
+
+  it('returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+    const products = listProducts();
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    }).value;
+    const issuedInv = issueInvoice(inv, []).value;
+
+    const result = statement('UNKNOWN-CUSTOMER', [issuedInv], '2026-02-28');
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+  });
+
+  it('returns customer id from the validated customer', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-12-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, customerId);
+  });
+
+  it('handles invoices with vouchers', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer = customers[4];
+
+    const inv = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 3 }],
+    }).value;
+    const withVoucher = applyVoucher(inv, { code: 'SAVE10', amount: 500 }).value;
+    const issuedInv = issueInvoice(withVoucher, []).value;
+
+    const result = statement(customer.id, [issuedInv], '2026-02-28');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+  });
+
+  it('filters by customer id correctly when multiple customers exist', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer1 = customers[0];
+    const customer2 = customers[1];
+
+    const inv1 = createInvoice({
+      customerId: customer1.id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 1 }],
+    }).value;
+    const issuedInv1 = issueInvoice(inv1, []).value;
+
+    const inv2 = createInvoice({
+      customerId: customer2.id,
+      issueDate: '2026-01-20',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    }).value;
+    const issuedInv2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+    const result = statement(customer1.id, [issuedInv1, issuedInv2], '2026-12-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].issueDate, '2026-01-15');
+  });
+
+  it('calculates total due correctly with payments', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer = customers[5];
+
+    const inv1 = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    }).value;
+    const issuedInv1 = issueInvoice(inv1, []).value;
+
+    const inv2 = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-02-15',
+      lines: [{ sku: products[0].sku, qty: 3 }],
+    }).value;
+    const issuedInv2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+    const partialPayment = recordPayment(issuedInv1, { amount: 5000, date: '2026-01-25' }).value;
+
+    const result = statement(customer.id, [partialPayment, issuedInv2], '2026-12-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.totalDue, result.value.invoices[0].due + result.value.invoices[1].due);
+  });
+
+  it('returns correct format with multiple invoices', () => {
+    const { customerId, invoices } = createTestInvoices();
+
+    const result = statement(customerId, invoices, '2026-12-31');
+
+    assert.equal(result.ok, true);
+    assert.ok(Array.isArray(result.value.invoices));
+    assert.equal(typeof result.value.customerId, 'string');
+    assert.equal(typeof result.value.totalDue, 'number');
+    for (const inv of result.value.invoices) {
+      assert.equal(typeof inv.number, 'string');
+      assert.equal(typeof inv.issueDate, 'string');
+      assert.equal(typeof inv.dueDate, 'string');
+      assert.equal(typeof inv.total, 'number');
+      assert.equal(typeof inv.due, 'number');
+    }
+  });
+});
