+import { getCustomer } from './customers.js';
+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Generate a customer statement showing outstanding invoices.
+ * @param {string} customerId
+ * @param {Array<{ customerId: string, number?: string, issueDate: string, dueDate: string, status: string, lines: Array, payments?: Array, voucher?: object }>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ ok: true, value: { customerId: string, invoices: Array<{ number: string, issueDate: string, dueDate: string, total: number, due: number }>, totalDue: number } } | { ok: false, error: string }}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return customerResult;
+
+  // Filter invoices for this customer with issued/partially_paid status and issueDate <= asOf
+  const relevantInvoices = invoices.filter(
+    (inv) =>
+      inv.customerId === customerResult.value.id &&
+      (inv.status === 'issued' || inv.status === 'partially_paid') &&
+      inv.issueDate <= asOf
+  );
+
+  // Map invoices to statement format and calculate due amounts
+  const statementInvoices = relevantInvoices.map((inv) => {
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+    return {
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: totals.total,
+      due,
+    };
+  });
+
+  // Sort by issueDate
+  statementInvoices.sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId: customerResult.value.id,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
