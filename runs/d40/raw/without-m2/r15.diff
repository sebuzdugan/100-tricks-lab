+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate the next credit note number for a given year.
+ * Format: CN-<year>-<4-digit counter starting at 0001>.
+ * @param {Array<string>} existingNumbers - Already-used numbers (INV and CN, any order)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `CN-${year}-`;
+
+  // Find all existing credit note numbers for this year and extract counters
+  const thisYearCounters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const match = num.match(/^CN-\d{4}-(\d{4})$/);
+      return match ? parseInt(match[1], 10) : 0;
+    });
+
+  // Find the highest counter, default to 0
+  const maxCounter = thisYearCounters.length === 0 ? 0 : Math.max(...thisYearCounters);
+  const nextCounter = maxCounter + 1;
+
+  // Pad counter to 4 digits
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+
+  return `${prefix}${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for a refund on an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: object, payments?: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNoteData
+ * @param {Array<string>} existingNumbers
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Check invoice is issued, partially_paid, or paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid' && invoice.status !== 'paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Check amount doesn't exceed invoice total
+  const totals = invoiceTotals(invoice);
+  if (amount > totals.total) {
+    return fail('CREDIT_TOO_HIGH');
+  }
+
+  // Generate credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
