diff --git a/test/credits.test.js b/test/credits.test.js
new file mode 100644
index 0000000..a0ad2df
--- /dev/null
+++ b/test/credits.test.js
@@ -0,0 +1,271 @@
+import { describe, it } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals, applyVoucher } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+import { listCustomers } from '../src/customers.js';
+import { listProducts } from '../src/catalogue.js';
+
+describe('nextCreditNoteNumber', () => {
+  it('starts at 0001 for a new year with no existing numbers', () => {
+    const number = nextCreditNoteNumber([], '2026-01-15');
+    assert.equal(number, 'CN-2026-0001');
+  });
+
+  it('returns 0001 when existing numbers are from different year', () => {
+    const existingNumbers = ['CN-2025-0001', 'CN-2025-0002', 'INV-2026-0001'];
+    const number = nextCreditNoteNumber(existingNumbers, '2026-01-15');
+    assert.equal(number, 'CN-2026-0001');
+  });
+
+  it('increments counter for same year', () => {
+    const existingNumbers = ['CN-2026-0001', 'CN-2026-0002'];
+    const number = nextCreditNoteNumber(existingNumbers, '2026-06-01');
+    assert.equal(number, 'CN-2026-0003');
+  });
+
+  it('ignores invoice numbers when counting credit notes', () => {
+    const existingNumbers = ['INV-2026-0001', 'INV-2026-0002', 'INV-2026-0003', 'CN-2026-0001'];
+    const number = nextCreditNoteNumber(existingNumbers, '2026-06-01');
+    assert.equal(number, 'CN-2026-0002');
+  });
+
+  it('handles unsorted existing numbers', () => {
+    const existingNumbers = ['CN-2026-0003', 'CN-2026-0001', 'CN-2026-0002'];
+    const number = nextCreditNoteNumber(existingNumbers, '2026-06-01');
+    assert.equal(number, 'CN-2026-0004');
+  });
+
+  it('pads counter to 4 digits', () => {
+    const existingNumbers = Array.from({ length: 999 }, (_, i) => `CN-2026-${String(i + 1).padStart(4, '0')}`);
+    const number = nextCreditNoteNumber(existingNumbers, '2026-06-01');
+    assert.equal(number, 'CN-2026-1000');
+  });
+
+  it('extracts year correctly from date', () => {
+    const number1 = nextCreditNoteNumber([], '2024-01-01');
+    assert.equal(number1, 'CN-2024-0001');
+
+    const number2 = nextCreditNoteNumber([], '2099-12-31');
+    assert.equal(number2, 'CN-2099-0001');
+  });
+});
+
+describe('createCreditNote', () => {
+  function createTestInvoice() {
+    const products = listProducts();
+    const customers = listCustomers();
+    const inv = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    }).value;
+    return issueInvoice(inv, []).value;
+  }
+
+  it('creates a credit note for an issued invoice', () => {
+    const invoice = createTestInvoice();
+    const result = createCreditNote(invoice, { amount: 1000, reason: 'Damaged goods', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0001');
+    assert.equal(result.value.invoiceNumber, invoice.number);
+    assert.equal(result.value.customerId, invoice.customerId);
+    assert.equal(result.value.amount, 1000);
+    assert.equal(result.value.reason, 'Damaged goods');
+    assert.equal(result.value.date, '2026-01-20');
+  });
+
+  it('creates a credit note for a partially paid invoice', () => {
+    const invoice = createTestInvoice();
+    const totals = invoiceTotals(invoice);
+    const partiallyPaid = recordPayment(invoice, { amount: totals.total / 2, date: '2026-01-18' }).value;
+
+    const result = createCreditNote(partiallyPaid, { amount: 500, reason: 'Discount', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0001');
+  });
+
+  it('creates a credit note for a paid invoice', () => {
+    const invoice = createTestInvoice();
+    const totals = invoiceTotals(invoice);
+    const paid = recordPayment(invoice, { amount: totals.total, date: '2026-01-18' }).value;
+
+    const result = createCreditNote(paid, { amount: 500, reason: 'Overpayment refund', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0001');
+  });
+
+  it('rejects credit note on draft invoice', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const draft = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    }).value;
+
+    const result = createCreditNote(draft, { amount: 1000, reason: 'Test', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NOT_ISSUED');
+  });
+
+  it('rejects non-integer amount', () => {
+    const invoice = createTestInvoice();
+
+    const result = createCreditNote(invoice, { amount: 1000.5, reason: 'Test', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects zero amount', () => {
+    const invoice = createTestInvoice();
+
+    const result = createCreditNote(invoice, { amount: 0, reason: 'Test', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects negative amount', () => {
+    const invoice = createTestInvoice();
+
+    const result = createCreditNote(invoice, { amount: -500, reason: 'Test', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects credit note amount exceeding invoice total', () => {
+    const invoice = createTestInvoice();
+    const totals = invoiceTotals(invoice);
+
+    const result = createCreditNote(invoice, { amount: totals.total + 1, reason: 'Too much', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'CREDIT_TOO_HIGH');
+  });
+
+  it('accepts credit note for full invoice amount', () => {
+    const invoice = createTestInvoice();
+    const totals = invoiceTotals(invoice);
+
+    const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.amount, totals.total);
+  });
+
+  it('assigns next credit note number when existing numbers present', () => {
+    const invoice = createTestInvoice();
+    const existingNumbers = ['CN-2026-0001', 'CN-2026-0002', 'INV-2026-0001'];
+
+    const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2026-01-20' }, existingNumbers);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0003');
+  });
+
+  it('uses date for year in credit note numbering', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const inv = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    }).value;
+    const invoice = issueInvoice(inv, []).value;
+
+    const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2027-01-20' }, []);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2027-0001');
+  });
+
+  it('returns correct structure', () => {
+    const invoice = createTestInvoice();
+
+    const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, true);
+    const cn = result.value;
+    assert.equal(typeof cn.number, 'string');
+    assert.equal(typeof cn.invoiceNumber, 'string');
+    assert.equal(typeof cn.customerId, 'string');
+    assert.equal(typeof cn.amount, 'number');
+    assert.equal(typeof cn.reason, 'string');
+    assert.equal(typeof cn.date, 'string');
+  });
+
+  it('preserves customer id from invoice', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+    const customer = customers[1];
+    const inv = createInvoice({
+      customerId: customer.id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    }).value;
+    const invoice = issueInvoice(inv, []).value;
+
+    const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, customer.id);
+  });
+
+  it('allows multiple credit notes for same invoice', () => {
+    const invoice = createTestInvoice();
+    const totals = invoiceTotals(invoice);
+
+    const result1 = createCreditNote(invoice, { amount: 5000, reason: 'First credit', date: '2026-01-20' }, []);
+    assert.equal(result1.ok, true);
+
+    const result2 = createCreditNote(invoice, { amount: 3000, reason: 'Second credit', date: '2026-01-25' }, ['CN-2026-0001']);
+    assert.equal(result2.ok, true);
+    assert.equal(result2.value.number, 'CN-2026-0002');
+  });
+
+  it('handles large credit note amounts', () => {
+    const invoice = createTestInvoice();
+    const totals = invoiceTotals(invoice);
+
+    const result = createCreditNote(invoice, { amount: totals.total, reason: 'Full refund', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.amount, totals.total);
+  });
+
+  it('rejects credit note with reason over invoice total', () => {
+    const invoice = createTestInvoice();
+    const totals = invoiceTotals(invoice);
+
+    const result = createCreditNote(invoice, { amount: totals.total * 2, reason: 'Too much', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'CREDIT_TOO_HIGH');
+  });
+
+  it('works with invoices that have vouchers', () => {
+    const products = listProducts();
+    const customers = listCustomers();
+
+    const inv = createInvoice({
+      customerId: customers[0].id,
+      issueDate: '2026-01-15',
+      lines: [{ sku: products[0].sku, qty: 2 }],
+    }).value;
+    const withVoucher = applyVoucher(inv, { code: 'SAVE10', amount: 500 }).value;
+    const invoice = issueInvoice(withVoucher, []).value;
+    const totals = invoiceTotals(invoice);
+
+    const result = createCreditNote(invoice, { amount: 1000, reason: 'Test', date: '2026-01-20' }, []);
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.amount <= totals.total, true);
+  });
+});
