+++ b/src/reports.js
@@ -0,0 +1,22 @@
+import { daysBetween } from './dates.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Find all overdue invoices (issued or partially_paid with dueDate before asOf).
+ * Returns [{ number, customerId, dueDate, daysOverdue, due }], most overdue first.
+ * @param {Array} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter(inv => (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate < asOf)
+    .map(inv => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
diff --git a/test/reports.test.js b/test/reports.test.js
new file mode 100644
index 0000000..c848791
--- /dev/null
+++ b/test/reports.test.js
@@ -0,0 +1,116 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { overdueInvoices } from '../src/reports.js';
+
+test('filters by status and date', () => {
+  const invoices = [
+    { number: '001', customerId: 'C1', status: 'issued', dueDate: '2026-10-01', lines: [], payments: [] },
+    { number: '002', customerId: 'C2', status: 'paid', dueDate: '2026-10-02', lines: [], payments: [] },
+    { number: '003', customerId: 'C3', status: 'partially_paid', dueDate: '2026-10-03', lines: [], payments: [] },
+    { number: '004', customerId: 'C4', status: 'draft', dueDate: '2026-10-04', lines: [], payments: [] },
+    { number: '005', customerId: 'C5', status: 'issued', dueDate: '2026-10-10', lines: [], payments: [] },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-05');
+
+  assert.strictEqual(result.length, 2);
+  assert.strictEqual(result[0].number, '001');
+  assert.strictEqual(result[1].number, '003');
+});
+
+test('calculates daysOverdue correctly', () => {
+  const invoices = [
+    { number: '001', customerId: 'C1', status: 'issued', dueDate: '2026-10-01', lines: [], payments: [] },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-05');
+
+  assert.strictEqual(result[0].daysOverdue, 4);
+});
+
+test('calculates due amount correctly', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerId: 'C1',
+      status: 'issued',
+      dueDate: '2026-10-01',
+      lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+      payments: [{ amount: 30 }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-05');
+
+  assert.strictEqual(result[0].due, 70);
+});
+
+test('returns empty array when no invoices are overdue', () => {
+  const invoices = [
+    { number: '001', customerId: 'C1', status: 'issued', dueDate: '2026-10-10', lines: [], payments: [] },
+    { number: '002', customerId: 'C2', status: 'paid', dueDate: '2026-10-05', lines: [], payments: [] },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-05');
+
+  assert.strictEqual(result.length, 0);
+});
+
+test('sorts by daysOverdue descending (most overdue first)', () => {
+  const invoices = [
+    { number: '001', customerId: 'C1', status: 'issued', dueDate: '2026-10-01', lines: [], payments: [] },
+    { number: '002', customerId: 'C2', status: 'issued', dueDate: '2026-10-03', lines: [], payments: [] },
+    { number: '003', customerId: 'C3', status: 'issued', dueDate: '2026-10-02', lines: [], payments: [] },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-05');
+
+  assert.strictEqual(result[0].number, '001');
+  assert.strictEqual(result[0].daysOverdue, 4);
+  assert.strictEqual(result[1].number, '003');
+  assert.strictEqual(result[1].daysOverdue, 3);
+  assert.strictEqual(result[2].number, '002');
+  assert.strictEqual(result[2].daysOverdue, 2);
+});
+
+test('includes both issued and partially_paid invoices', () => {
+  const invoices = [
+    { number: '001', customerId: 'C1', status: 'issued', dueDate: '2026-10-01', lines: [], payments: [] },
+    { number: '002', customerId: 'C2', status: 'partially_paid', dueDate: '2026-10-02', lines: [], payments: [{ amount: 50 }] },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-05');
+
+  assert.strictEqual(result.length, 2);
+});
+
+test('excludes paid and draft invoices', () => {
+  const invoices = [
+    { number: '001', customerId: 'C1', status: 'paid', dueDate: '2026-10-01', lines: [], payments: [] },
+    { number: '002', customerId: 'C2', status: 'draft', dueDate: '2026-10-02', lines: [], payments: [] },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-05');
+
+  assert.strictEqual(result.length, 0);
+});
+
+test('includes invoices exactly at asOf date when dueDate is before', () => {
+  const invoices = [
+    { number: '001', customerId: 'C1', status: 'issued', dueDate: '2026-10-04', lines: [], payments: [] },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-05');
+
+  assert.strictEqual(result.length, 1);
+});
+
+test('excludes invoices when dueDate equals asOf', () => {
+  const invoices = [
+    { number: '001', customerId: 'C1', status: 'issued', dueDate: '2026-10-05', lines: [], payments: [] },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-05');
+
+  assert.strictEqual(result.length, 0);
+});
