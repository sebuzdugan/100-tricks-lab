+/**
+ * Summarize VAT across invoices by rate.
+ * Only includes invoices with status 'issued', 'partially_paid', or 'paid'.
+ * Returns [{ rate, base, vat }] sorted by rate from high to low.
+ * @param {Array} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const rateMap = new Map();
+
+  // Filter for issued, partially_paid, or paid invoices
+  const filtered = invoices.filter(
+    inv => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid'
+  );
+
+  // Group by VAT rate
+  for (const invoice of filtered) {
+    for (const line of invoice.lines) {
+      const rate = line.vatRate;
+      const total = lineTotal(line);
+      const discount = lineDiscount(line);
+      const base = total - discount;
+      const vat = lineVAT(line);
+
+      if (!rateMap.has(rate)) {
+        rateMap.set(rate, { rate, base: 0, vat: 0 });
+      }
+
+      const entry = rateMap.get(rate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  // Convert to array and sort by rate descending
+  return Array.from(rateMap.values()).sort((a, b) => b.rate - a.rate);
+}
