   // Convert to array and sort by rate descending
   return Array.from(rateMap.values()).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fee on an invoice: 0.04% of amount due per day overdue.
+ * Returns 0 if the invoice is not yet overdue (dueDate >= asOf).
+ * @param {{ dueDate: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, rounded to nearest cent
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = roundCents(due * daysOverdue * 0.0004);
+  return Math.max(0, fee);
+}
