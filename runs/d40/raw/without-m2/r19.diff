+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+function quoteCsvField(field) {
+  const str = String(field);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+function formatEuros(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Export invoices as CSV: number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due
+ * Amounts in euros with 2 decimals, no currency sign or thousands separator.
+ * @param {Array} invoices
+ * @returns {string} - CSV with header and data rows, each line ending with \n
+ */
+export function exportCsv(invoices) {
+  const lines = ['number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due'];
+
+  for (const invoice of invoices) {
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const row = [
+      quoteCsvField(invoice.number || ''),
+      quoteCsvField(invoice.customerName || ''),
+      quoteCsvField(invoice.issueDate),
+      quoteCsvField(invoice.dueDate),
+      quoteCsvField(invoice.status),
+      quoteCsvField(formatEuros(totals.subtotal)),
+      quoteCsvField(formatEuros(totals.discount)),
+      quoteCsvField(formatEuros(totals.vat)),
+      quoteCsvField(formatEuros(totals.total)),
+      quoteCsvField(formatEuros(due)),
+    ];
+
+    lines.push(row.join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
