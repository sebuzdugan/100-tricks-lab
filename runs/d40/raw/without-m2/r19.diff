+import test from 'node:test';
+import assert from 'node:assert';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv includes header line', () => {
+  const invoices = [];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert.strictEqual(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+});
+
+test('exportCsv exports single invoice', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'ACME Corp',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert.strictEqual(lines.length, 3); // header + 1 invoice + trailing newline
+  assert.strictEqual(
+    lines[1],
+    '001,ACME Corp,2026-10-01,2026-10-31,issued,1.00,0.00,0.00,1.00,1.00'
+  );
+});
+
+test('exportCsv formats amounts as euros with 2 decimals', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'ACME',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 12345, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert.strictEqual(lines[1], '001,ACME,2026-10-01,2026-10-31,issued,123.45,0.00,0.00,123.45,123.45');
+});
+
+test('exportCsv quotes fields with commas', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'Smith, John',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('"Smith, John"'));
+});
+
+test('exportCsv escapes quotes by doubling them', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'John "Johnny" Doe',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('"John ""Johnny"" Doe"'));
+});
+
+test('exportCsv handles multiple invoices in order', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'ACME',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    },
+    {
+      number: '002',
+      customerName: 'Widget Inc',
+      issueDate: '2026-10-05',
+      dueDate: '2026-11-05',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 200, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert.strictEqual(lines.length, 4); // header + 2 invoices + trailing newline
+  assert(lines[1].startsWith('001,'));
+  assert(lines[2].startsWith('002,'));
+});
+
+test('exportCsv includes discount from invoiceTotals', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'ACME',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 10, unitPrice: 100, discountPercent: 10, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  // 10 * 100 = 1000, discount 10% = 100
+  assert(lines[1].includes('10.00')); // subtotal
+  assert(lines[1].includes('1.00')); // discount
+});
+
+test('exportCsv includes VAT from invoiceTotals', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'ACME',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, vatRate: 20 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  // 100 base, 20% VAT = 20
+  assert(lines[1].includes('1.00,0.00,0.20,1.20,1.20'));
+});
+
+test('exportCsv calculates due amount with payments', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'ACME',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'partially_paid',
+      lines: [{ qty: 1, unitPrice: 10000, vatRate: 0 }],
+      payments: [{ amount: 3000 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  // total 100, paid 30, due 70
+  assert(lines[1].endsWith('100.00,70.00'));
+});
+
+test('exportCsv ends lines with newline', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'ACME',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+
+  assert(csv.endsWith('\n'));
+});
+
+test('exportCsv handles draft invoice (no number)', () => {
+  const invoices = [
+    {
+      customerName: 'ACME',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'draft',
+      lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert(lines[1].startsWith(',ACME'));
+});
+
+test('exportCsv returns header only for empty invoices', () => {
+  const invoices = [];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert.strictEqual(lines.length, 2); // header + trailing newline
+  assert.strictEqual(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.strictEqual(lines[1], '');
+});
+
+test('exportCsv with commas and quotes in same field', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'Smith, "J." Inc',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 100, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  assert(lines[1].includes('"Smith, ""J."" Inc"'));
+});
+
+test('exportCsv with complex invoice totals', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerName: 'ACME',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [
+        { qty: 5, unitPrice: 1000, discountPercent: 15, vatRate: 20 },
+        { qty: 3, unitPrice: 500, discountPercent: 5, vatRate: 10 },
+      ],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+
+  // Line 1: 5 * 1000 = 5000, discount 15% = 750, after discount 4250, VAT 20% = 850
+  // Line 2: 3 * 500 = 1500, discount 5% = 75, after discount 1425, VAT 10% = 142.50
+  // Subtotal: 6500, Discount: 825, VAT: 992.50, Total: 6667.50
+  assert(lines[1].includes('65.00')); // subtotal
+  assert(lines[1].includes('8.25')); // discount
+});
