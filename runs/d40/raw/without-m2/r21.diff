+
+test('mergeCustomers removes fromId and updates invoices', () => {
+  const customers = [
+    { id: 'CUST1', name: 'Alice', email: 'alice@example.com', country: 'US', tier: 'gold' },
+    { id: 'CUST2', name: 'Bob', email: 'bob@example.com', country: 'UK', tier: 'silver' },
+  ];
+
+  const invoices = [
+    { customerId: 'CUST1', number: 'INV001', status: 'issued', lines: [] },
+    { customerId: 'CUST2', number: 'INV002', status: 'issued', lines: [] },
+    { customerId: 'CUST1', number: 'INV003', status: 'draft', lines: [] },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'CUST1', 'CUST2');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.equal(result.value.customers[0].id, 'CUST2');
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].customerId, 'CUST2');
+  assert.equal(result.value.invoices[1].customerId, 'CUST2');
+  assert.equal(result.value.invoices[2].customerId, 'CUST2');
+});
