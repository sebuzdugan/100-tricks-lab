+import { describe, it } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+describe('lineTotal', () => {
+  it('calculates qty times unitPrice', () => {
+    const total = lineTotal({ qty: 3, unitPrice: 500 });
+    assert.equal(total, 1500);
+  });
+
+  it('returns a whole number of cents', () => {
+    const total = lineTotal({ qty: 3, unitPrice: 500 });
+    assert.equal(Number.isInteger(total), true);
+  });
+
+  it('handles qty of 1', () => {
+    const total = lineTotal({ qty: 1, unitPrice: 999 });
+    assert.equal(total, 999);
+  });
+
+  it('handles large quantities', () => {
+    const total = lineTotal({ qty: 1000000, unitPrice: 50 });
+    assert.equal(total, 50000000);
+  });
+
+  it('rounds fractional cents to nearest even (banker\'s rounding)', () => {
+    const total1 = lineTotal({ qty: 3, unitPrice: 100.5 });
+    assert.equal(total1, 302);
+
+    const total2 = lineTotal({ qty: 3, unitPrice: 100.4 });
+    assert.equal(total2, 301);
+  });
+
+  it('handles products with low unit prices', () => {
+    const total = lineTotal({ qty: 3, unitPrice: 1 });
+    assert.equal(total, 3);
+  });
+
+  it('does not mutate the input', () => {
+    const line = { qty: 5, unitPrice: 200 };
+    const lineCopy = JSON.parse(JSON.stringify(line));
+    lineTotal(line);
+    assert.deepEqual(line, lineCopy);
+  });
+});
+
+describe('lineDiscount', () => {
+  it('calculates discount as lineTotal * (discountPercent / 100)', () => {
+    const discount = lineDiscount({ qty: 10, unitPrice: 100, discountPercent: 10 });
+    assert.equal(discount, 100);
+  });
+
+  it('returns 0 for 0% discount', () => {
+    const discount = lineDiscount({ qty: 10, unitPrice: 100, discountPercent: 0 });
+    assert.equal(discount, 0);
+  });
+
+  it('returns full line total for 100% discount', () => {
+    const discount = lineDiscount({ qty: 10, unitPrice: 100, discountPercent: 100 });
+    assert.equal(discount, 1000);
+  });
+
+  it('handles decimal discounts like 12.5%', () => {
+    const discount = lineDiscount({ qty: 8, unitPrice: 100, discountPercent: 12.5 });
+    assert.equal(discount, 100);
+  });
+
+  it('defaults discountPercent to 0 when not provided', () => {
+    const discount = lineDiscount({ qty: 10, unitPrice: 100 });
+    assert.equal(discount, 0);
+  });
+
+  it('rounds discount to nearest cent', () => {
+    const discount = lineDiscount({ qty: 3, unitPrice: 100.5, discountPercent: 33.33 });
+    assert.equal(Number.isInteger(discount), true);
+  });
+
+  it('clamps negative discount at 0', () => {
+    const discount = lineDiscount({ qty: 1, unitPrice: -100, discountPercent: 10 });
+    assert.equal(discount, 0);
+  });
+
+  it('does not mutate the input', () => {
+    const line = { qty: 5, unitPrice: 200, discountPercent: 10 };
+    const lineCopy = JSON.parse(JSON.stringify(line));
+    lineDiscount(line);
+    assert.deepEqual(line, lineCopy);
+  });
+});
+
+describe('lineVAT', () => {
+  it('calculates VAT as (lineTotal - lineDiscount) * (vatRate / 100)', () => {
+    const vat = lineVAT({ qty: 10, unitPrice: 100, vatRate: 21 });
+    assert.equal(vat, 210);
+  });
+
+  it('returns 0 for 0% VAT rate', () => {
+    const vat = lineVAT({ qty: 10, unitPrice: 100, vatRate: 0 });
+    assert.equal(vat, 0);
+  });
+
+  it('calculates VAT on amount after discount', () => {
+    const vat = lineVAT({ qty: 10, unitPrice: 100, discountPercent: 10, vatRate: 21 });
+    const lineTotal1 = 1000;
+    const discount = 100;
+    const amountAfterDiscount = lineTotal1 - discount;
+    const expectedVAT = Math.round(amountAfterDiscount * 0.21);
+    assert.equal(vat, expectedVAT);
+  });
+
+  it('handles 9% VAT', () => {
+    const vat = lineVAT({ qty: 100, unitPrice: 100, vatRate: 9 });
+    assert.equal(vat, 900);
+  });
+
+  it('rounds VAT to nearest cent', () => {
+    const vat = lineVAT({ qty: 3, unitPrice: 100.5, vatRate: 21 });
+    assert.equal(Number.isInteger(vat), true);
+  });
+
+  it('clamps negative VAT at 0', () => {
+    const vat = lineVAT({ qty: 1, unitPrice: -100, vatRate: 21 });
+    assert.equal(vat, 0);
+  });
+
+  it('does not mutate the input', () => {
+    const line = { qty: 5, unitPrice: 200, discountPercent: 10, vatRate: 21 };
+    const lineCopy = JSON.parse(JSON.stringify(line));
+    lineVAT(line);
+    assert.deepEqual(line, lineCopy);
+  });
+});
+
+describe('invoiceTotals', () => {
+  it('calculates subtotal for single line', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 1000);
+  });
+
+  it('includes discount in totals', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, discountPercent: 10, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.discount, 100);
+  });
+
+  it('includes VAT in totals', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, vatRate: 21 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.vat, 210);
+  });
+
+  it('calculates total as subtotal minus discount plus VAT', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, discountPercent: 10, vatRate: 21 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 1000);
+    assert.equal(totals.discount, 100);
+    assert.equal(totals.vat, 189);
+    assert.equal(totals.total, 1089);
+  });
+
+  it('total equals subtotal when no discount or VAT', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.total, totals.subtotal);
+  });
+
+  it('calculates subtotal for multiple lines', () => {
+    const invoice = {
+      lines: [
+        { qty: 2, unitPrice: 500, vatRate: 0 },
+        { qty: 3, unitPrice: 200, vatRate: 0 },
+      ],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 1600);
+  });
+
+  it('sums discounts and VAT across multiple lines', () => {
+    const invoice = {
+      lines: [
+        { qty: 2, unitPrice: 500, discountPercent: 10, vatRate: 21 },
+        { qty: 3, unitPrice: 200, discountPercent: 5, vatRate: 9 },
+      ],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 1600);
+    assert.equal(totals.discount, 130);
+    const line1VAT = lineVAT({ qty: 2, unitPrice: 500, discountPercent: 10, vatRate: 21 });
+    const line2VAT = lineVAT({ qty: 3, unitPrice: 200, discountPercent: 5, vatRate: 9 });
+    assert.equal(totals.vat, line1VAT + line2VAT);
+    assert.equal(totals.total, 1600 - 130 + (line1VAT + line2VAT));
+  });
+
+  it('clamps total at 0 when discount exceeds subtotal', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, discountPercent: 110, vatRate: 21 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 1000);
+    assert.equal(totals.discount, 1100);
+    assert.equal(totals.total, 0);
+  });
+
+  it('handles empty lines', () => {
+    const invoice = { lines: [] };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.subtotal, 0);
+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, 0);
+    assert.equal(totals.total, 0);
+  });
+
+  it('returns whole number of cents', () => {
+    const invoice = {
+      lines: [
+        { qty: 3, unitPrice: 100, vatRate: 0 },
+        { qty: 2, unitPrice: 250, vatRate: 0 },
+      ],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(Number.isInteger(totals.subtotal), true);
+    assert.equal(Number.isInteger(totals.vat), true);
+    assert.equal(Number.isInteger(totals.total), true);
+  });
+
+  it('rounds each line individually then sums', () => {
+    const invoice = {
+      lines: [
+        { qty: 3, unitPrice: 100.5, vatRate: 0 },
+        { qty: 2, unitPrice: 150.5, vatRate: 0 },
+      ],
+    };
+    const totals = invoiceTotals(invoice);
+    const line1Total = lineTotal(invoice.lines[0]);
+    const line2Total = lineTotal(invoice.lines[1]);
+    assert.equal(totals.subtotal, line1Total + line2Total);
+  });
+
+  it('includes voucher amount in totals', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, vatRate: 0 }],
+      voucher: { code: 'SAVE10', amount: 100 },
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.voucher, 100);
+    assert.equal(totals.total, 900);
+  });
+
+  it('handles multiple lines with voucher', () => {
+    const invoice = {
+      lines: [
+        { qty: 2, unitPrice: 500, discountPercent: 10, vatRate: 21 },
+        { qty: 3, unitPrice: 200, discountPercent: 5, vatRate: 9 },
+      ],
+      voucher: { code: 'SAVE20', amount: 50 },
+    };
+    const totals = invoiceTotals(invoice);
+    const line1VAT = lineVAT({ qty: 2, unitPrice: 500, discountPercent: 10, vatRate: 21 });
+    const line2VAT = lineVAT({ qty: 3, unitPrice: 200, discountPercent: 5, vatRate: 9 });
+    const expected = 1600 - 130 + (line1VAT + line2VAT) - 50;
+    assert.equal(totals.total, expected);
+  });
+
+  it('returns 0 for discount and VAT fields when not applicable', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.discount, 0);
+    assert.equal(totals.vat, 0);
+  });
+
+  it('does not mutate the input', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, vatRate: 21 }],
+    };
+    const invoiceCopy = JSON.parse(JSON.stringify(invoice));
+    invoiceTotals(invoice);
+    assert.deepEqual(invoice, invoiceCopy);
+  });
+
+  it('returns new object on each call', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, vatRate: 21 }],
+    };
+    const totals1 = invoiceTotals(invoice);
+    const totals2 = invoiceTotals(invoice);
+    assert.notEqual(totals1, totals2);
+    assert.deepEqual(totals1, totals2);
+  });
+
+  it('handles large invoices', () => {
+    const invoice = {
+      lines: Array.from({ length: 100 }, (_, i) => ({
+        qty: i + 1,
+        unitPrice: 100,
+        vatRate: 21,
+      })),
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(Number.isInteger(totals.subtotal), true);
+    assert.equal(Number.isInteger(totals.vat), true);
+    const expected = Array.from({ length: 100 }, (_, i) => (i + 1) * 100).reduce((a, b) => a + b);
+    assert.equal(totals.subtotal, expected);
+  });
+
+  it('returns all required fields', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.ok(totals.hasOwnProperty('subtotal'));
+    assert.ok(totals.hasOwnProperty('discount'));
+    assert.ok(totals.hasOwnProperty('vat'));
+    assert.ok(totals.hasOwnProperty('voucher'));
+    assert.ok(totals.hasOwnProperty('total'));
+  });
+
+  it('returns 0 for voucher when not present', () => {
+    const invoice = {
+      lines: [{ qty: 2, unitPrice: 500, vatRate: 0 }],
+    };
+    const totals = invoiceTotals(invoice);
+    assert.equal(totals.voucher, 0);
+  });
+});
