@@ -0,0 +1,56 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total for a single line: qty × unitPrice, rounded to the nearest cent.
+ * @param {{ qty: number, unitPrice: number }}
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return roundCents(line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount for a single line: lineTotal × (discountPercent / 100), clamped at 0.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const discountPercent = line.discountPercent ?? 0;
+  const total = lineTotal(line);
+  const discount = roundCents(total * (discountPercent / 100));
+  return Math.max(0, discount);
+}
+
+/**
+ * Calculate the VAT for a single line: (lineTotal - lineDiscount) × (vatRate / 100), rounded per line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }}
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  const vatRate = line.vatRate ?? 0;
+  const vat = roundCents(amountAfterDiscount * (vatRate / 100));
+  return Math.max(0, vat);
+}
+
+/**
+ * Calculate the totals for an invoice: subtotal, discount, vat, voucher, and total.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate: number }>, voucher?: { code: string, amount: number } }}
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
