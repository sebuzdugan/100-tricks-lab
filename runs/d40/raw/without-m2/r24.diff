+/**
+ * Generate a dashboard summary of invoices.
+ * @param {Array} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {{ counts: Object, outstanding: number, overdue: Object, topCustomers: Array }}
+ */
+export function dashboard(invoices, asOf) {
+  // Count invoices by status
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const invoice of invoices) {
+    if (invoice.status in counts) {
+      counts[invoice.status]++;
+    }
+  }
+
+  // Calculate outstanding (total due on issued or partially_paid invoices)
+  const outstanding = invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid')
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  // Get overdue invoices
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueInfo = {
+    count: overdue.length,
+    amount: overdue.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  // Find top 3 customers by most due
+  const customerDue = new Map();
+  for (const invoice of invoices) {
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      const customerId = invoice.customerId;
+      const currentDue = customerDue.get(customerId) || 0;
+      customerDue.set(customerId, currentDue + due);
+    }
+  }
+
+  const topCustomers = Array.from(customerDue.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: overdueInfo,
+    topCustomers,
+  };
+}
