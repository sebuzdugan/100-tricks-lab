@@ -3,7 +3,7 @@ import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from './invoices.js';
 
 /**
  * Render an invoice as plain text.
- * @param {{ number?: string, customerName: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate: number }> }}
+ * @param {{ number?: string, customerName: string, lines: Array<{ qty: number, name: string, unitPrice: number, discountPercent?: number, vatRate: number }>, dueDate?: string, payments?: Array<{ amount: number }>, voucher?: { code: string, amount: number } }}
  * @returns {string}
  */
 export function renderInvoiceText(invoice) {
@@ -16,10 +16,17 @@ export function renderInvoiceText(invoice) {
   // Second line: customer name
   lines.push(invoice.customerName);
 
-  // Invoice lines
+  // Invoice lines with individual discounts
   for (const line of invoice.lines) {
     const total = lineTotal(line);
-    const lineText = `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+    let lineText = `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+
+    // Add line discount if line has a discount percent
+    if (line.discountPercent && line.discountPercent > 0) {
+      const discount = lineDiscount(line);
+      lineText += ` (${line.discountPercent}% off: -${formatEuros(discount)})`;
+    }
+
     lines.push(lineText);
   }
 
@@ -41,8 +48,24 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
 
+  // Show voucher if any (before total)
+  if (invoice.voucher) {
+    lines.push(`Voucher (${invoice.voucher.code}): -${formatEuros(invoice.voucher.amount)}`);
+  }
+
   // Total line
   lines.push(`Total: ${formatEuros(totals.total)}`);
 
+  // Show due date if present
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Show paid amount if payments exist
+  if (invoice.payments && invoice.payments.length > 0) {
+    const paid = invoice.payments.reduce((sum, payment) => sum + payment.amount, 0);
+    lines.push(`Paid: ${formatEuros(paid)}`);
+  }
+
   return lines.join('\n');
 }
