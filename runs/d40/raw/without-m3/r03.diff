+
+test('addLine adds a new line to the end', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+
+  const r = addLine(invoice, { sku: 'COPY-HOUR', qty: 3 });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines.length, 2);
+  assert.equal(r.value.lines[1].sku, 'COPY-HOUR');
+  assert.equal(r.value.lines[1].qty, 3);
+  assert.equal(r.value.lines[1].name, 'Copywriting (hour)');
+});
+
