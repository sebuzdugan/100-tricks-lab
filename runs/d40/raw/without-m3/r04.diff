+/**
+ * Issue an invoice (assign a number and change status to 'issued').
+ * @param {{ status: string, issueDate: string }} invoice
+ * @param {Array<string>} existingNumbers - Invoice numbers already issued
+ * @returns {{ ok: true, value: { status: string, number: string } } | { ok: false, error: string }}
