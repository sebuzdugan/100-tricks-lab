index 0000000..eaf2407
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,25 @@
+/**
+ * Calculate the next invoice number for a given year.
+ * Format: INV-YYYY-CCCC (C = counter, zero-padded to 4 digits, resets per year).
+ * @param {Array<string>} existingNumbers - Invoice numbers already issued
+ * @param {string} issueDate - Issue date in 'YYYY-MM-DD' format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.substring(0, 4);
+  const prefix = `INV-${year}-`;
+  const yearNumbers = existingNumbers.filter((num) => num.startsWith(prefix));
+
+  if (yearNumbers.length === 0) {
+    return `${prefix}0001`;
+  }
+
+  const counters = yearNumbers.map((num) => {
+    const counter = num.substring(prefix.length);
+    return parseInt(counter, 10);
+  });
+
+  const maxCounter = Math.max(...counters);
+  const nextCounter = maxCounter + 1;
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
