diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..9fd51f9
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,38 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber starts at 0001 for a new year', () => {
+  const number = nextInvoiceNumber([], '2025-10-07');
+  assert.equal(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber increments counter for same year', () => {
+  const existing = ['INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0003');
+});
+
+test('nextInvoiceNumber handles high counters with padding', () => {
+  const existing = ['INV-2025-0099'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0100');
+});
+
+test('nextInvoiceNumber resets counter per year', () => {
+  const existing = ['INV-2024-9999', 'INV-2025-0001'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2024-0050', 'INV-2025-0001', 'INV-2026-0100'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber handles unordered numbers', () => {
+  const existing = ['INV-2025-0003', 'INV-2025-0001', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(existing, '2025-10-15');
+  assert.equal(number, 'INV-2025-0004');
+});
