+++ b/test/render.test.js
@@ -0,0 +1,104 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText renders a draft invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 2 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('DRAFT'));
+  assert.ok(text.includes('Northwind Studio'));
+  assert.ok(text.includes('2 × Development (hour)'));
+  assert.ok(text.includes('€95.00'));
+  assert.ok(text.includes('Total:'));
+});
+
+test('renderInvoiceText renders an issued invoice with number', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+  }).value;
+
+  const issued = issueInvoice(invoice, []).value;
+  const text = renderInvoiceText(issued);
+
+  assert.ok(text.includes('INV-2025-0001'));
+  assert.ok(text.includes('Northwind Studio'));
+  assert.ok(text.includes('1 × Development (hour)'));
+});
+
+test('renderInvoiceText with multiple lines', () => {
+  const invoice = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Blue Fern Bakery');
+  assert.ok(lines[2].includes('5 × Development (hour)'));
+  assert.ok(lines[2].includes('€95.00'));
+  assert.ok(lines[2].includes('€475.00'));
+  assert.ok(lines[3].includes('3 × Copywriting (hour)'));
+  assert.ok(lines[3].includes('€60.00'));
+  assert.ok(lines[3].includes('€180.00'));
+  assert.ok(lines[4].startsWith('Total:'));
+  assert.ok(lines[4].includes('€655.00'));
+});
+
+test('renderInvoiceText formats all amounts in euros', () => {
+  const invoice = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'ICON-SET', qty: 10 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('€9.80'));
+  assert.ok(text.includes('€98.00'));
+  assert.ok(text.includes('Total: €98.00'));
+});
+
+test('renderInvoiceText uses customer name from invoice', () => {
+  const invoice = createInvoice({
+    customerId: 'C-010',
+    issueDate: '2025-10-07',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  assert.ok(text.includes('Tidewater Museum'));
+});
+
+test('renderInvoiceText structure is correct', () => {
+  const invoice = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-10-07',
+    lines: [
+      { sku: 'DEV-HOUR', qty: 2 },
+      { sku: 'COPY-HOUR', qty: 1 },
+    ],
+  }).value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  assert.equal(lines.length, 5); // status/number, customer, 2 product lines, total
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.ok(lines[2].match(/^\d+ × .+ @ €.+ = €.+$/)); // line format
+  assert.ok(lines[3].match(/^\d+ × .+ @ €.+ = €.+$/)); // line format
+  assert.ok(lines[4].startsWith('Total: €'));
+});
