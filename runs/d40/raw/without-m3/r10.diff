diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..5585bbb
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,149 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2025-10-07'), true);
+  assert.equal(isValidDate('2025-01-01'), true);
+  assert.equal(isValidDate('2025-12-31'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10-07-2025'), false);
+  assert.equal(isValidDate('2025/10/07'), false);
+  assert.equal(isValidDate('2025-10-7'), false);
+  assert.equal(isValidDate('2025-1-07'), false);
+  assert.equal(isValidDate('25-10-07'), false);
+});
+
+test('isValidDate rejects non-existent dates', () => {
+  assert.equal(isValidDate('2025-02-30'), false);
+  assert.equal(isValidDate('2025-04-31'), false);
+  assert.equal(isValidDate('2025-13-01'), false);
+  assert.equal(isValidDate('2025-00-01'), false);
+});
+
+test('isValidDate rejects leap day in non-leap year', () => {
+  assert.equal(isValidDate('2025-02-29'), false);
+  assert.equal(isValidDate('2100-02-29'), false);
+});
+
+test('isValidDate accepts leap day in leap year', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('2020-02-29'), true);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(20251007), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+  assert.equal(isValidDate({}), false);
+});
+
+test('isValidDate rejects empty string', () => {
+  assert.equal(isValidDate(''), false);
+});
+
+test('addDays adds days correctly', () => {
+  assert.equal(addDays('2025-10-07', 1), '2025-10-08');
+  assert.equal(addDays('2025-10-07', 10), '2025-10-17');
+  assert.equal(addDays('2025-10-07', 30), '2025-11-06');
+});
+
+test('addDays handles month boundary', () => {
+  assert.equal(addDays('2025-10-31', 1), '2025-11-01');
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+});
+
+test('addDays handles year boundary', () => {
+  assert.equal(addDays('2025-12-31', 1), '2026-01-01');
+  assert.equal(addDays('2025-12-30', 2), '2026-01-01');
+});
+
+test('addDays handles negative days', () => {
+  assert.equal(addDays('2025-10-07', -1), '2025-10-06');
+  assert.equal(addDays('2025-10-07', -7), '2025-09-30');
+  assert.equal(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays handles zero days', () => {
+  assert.equal(addDays('2025-10-07', 0), '2025-10-07');
+});
+
+test('addDays handles large day counts', () => {
+  assert.equal(addDays('2025-10-07', 365), '2026-10-07');
+  assert.equal(addDays('2025-10-07', 1000), '2028-07-03');
+});
+
+test('addDays pads with leading zeros', () => {
+  assert.equal(addDays('2025-12-28', 4), '2026-01-01');
+  const result = addDays('2025-12-28', 4);
+  assert.ok(result.match(/^\d{4}-\d{2}-\d{2}$/));
+});
+
+test('daysBetween calculates difference correctly', () => {
+  assert.equal(daysBetween('2025-10-07', '2025-10-08'), 1);
+  assert.equal(daysBetween('2025-10-07', '2025-10-17'), 10);
+  assert.equal(daysBetween('2025-10-07', '2025-11-06'), 30);
+});
+
+test('daysBetween with same date', () => {
+  assert.equal(daysBetween('2025-10-07', '2025-10-07'), 0);
+});
+
+test('daysBetween with negative result', () => {
+  assert.equal(daysBetween('2025-10-08', '2025-10-07'), -1);
+  assert.equal(daysBetween('2025-10-17', '2025-10-07'), -10);
+});
+
+test('daysBetween across month boundary', () => {
+  assert.equal(daysBetween('2025-10-31', '2025-11-01'), 1);
+  assert.equal(daysBetween('2025-10-01', '2025-11-01'), 31);
+});
+
+test('daysBetween across year boundary', () => {
+  assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+});
+
+test('daysBetween over large periods', () => {
+  assert.equal(daysBetween('2025-01-01', '2026-01-01'), 365);
+  assert.equal(daysBetween('2020-01-01', '2025-01-01'), 1827);
+});
+
+test('daysBetween in UTC (not local timezone)', () => {
+  const a = '2025-10-07';
+  const b = '2025-10-08';
+  const days = daysBetween(a, b);
+  assert.equal(days, 1);
+});
+
+test('addDays in UTC (not local timezone)', () => {
+  const date = '2025-10-07';
+  const result = addDays(date, 1);
+  assert.equal(result, '2025-10-08');
+});
+
+test('date utilities work together', () => {
+  const start = '2025-01-01';
+  const daysToAdd = 30;
+  const end = addDays(start, daysToAdd);
+  assert.equal(end, '2025-01-31');
+  assert.equal(daysBetween(start, end), daysToAdd);
+});
+
+test('date utilities with leap year', () => {
+  const start = '2024-02-28';
+  const end = addDays(start, 1);
+  assert.equal(end, '2024-02-29');
+  assert.equal(daysBetween(start, end), 1);
+});
+
+test('daysBetween returns whole days', () => {
+  const diff = daysBetween('2025-10-07', '2025-10-08');
+  assert.equal(diff, 1);
+  assert.equal(Number.isInteger(diff), true);
+});
