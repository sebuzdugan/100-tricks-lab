+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { recordPayment, balanceDue } from '../src/payments.js';
+
+describe('balanceDue', () => {
+  it('returns total when no payments yet', () => {
+    const invoice = {
+      lines: [
+        { qty: 2, unitPrice: 1000, discountPercent: 0, vatRate: 20 },
+      ],
+    };
+    assert.equal(balanceDue(invoice), 2400);
+  });
+
+  it('returns remaining balance after partial payment', () => {
+    const invoice = {
+      lines: [
+        { qty: 2, unitPrice: 1000, discountPercent: 0, vatRate: 20 },
+      ],
+      payments: [
+        { amount: 1000, date: '2026-01-01' },
+      ],
+    };
+    assert.equal(balanceDue(invoice), 1400);
+  });
+
+  it('returns 0 when fully paid', () => {
+    const invoice = {
+      lines: [
+        { qty: 2, unitPrice: 1000, discountPercent: 0, vatRate: 20 },
+      ],
+      payments: [
+        { amount: 2400, date: '2026-01-01' },
+      ],
+    };
+    assert.equal(balanceDue(invoice), 0);
+  });
+
+  it('handles multiple partial payments', () => {
+    const invoice = {
+      lines: [
+        { qty: 2, unitPrice: 1000, discountPercent: 0, vatRate: 20 },
+      ],
+      payments: [
+        { amount: 1000, date: '2026-01-01' },
+        { amount: 800, date: '2026-01-05' },
+      ],
+    };
+    assert.equal(balanceDue(invoice), 600);
+  });
+});
+
+describe('recordPayment', () => {
+  const issuedInvoice = {
+    customerId: 'C001',
+    issueDate: '2026-01-01',
+    status: 'issued',
+    number: 'INV-2026-0001',
+    lines: [
+      { sku: 'P001', name: 'Product', qty: 2, unitPrice: 1000, vatRate: 20, discountPercent: 0 },
+    ],
+  };
+
+  it('rejects payment on draft invoice', () => {
+    const draft = { ...issuedInvoice, status: 'draft' };
+    const result = recordPayment(draft, { amount: 1000, date: '2026-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NOT_ISSUED');
+  });
+
+  it('rejects payment on paid invoice', () => {
+    const paid = { ...issuedInvoice, status: 'paid', payments: [{ amount: 2400, date: '2026-01-05' }] };
+    const result = recordPayment(paid, { amount: 100, date: '2026-01-10' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NOT_ISSUED');
+  });
+
+  it('rejects zero amount', () => {
+    const result = recordPayment(issuedInvoice, { amount: 0, date: '2026-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects negative amount', () => {
+    const result = recordPayment(issuedInvoice, { amount: -100, date: '2026-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects non-integer amount', () => {
+    const result = recordPayment(issuedInvoice, { amount: 100.5, date: '2026-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects overpayment', () => {
+    const result = recordPayment(issuedInvoice, { amount: 2500, date: '2026-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'OVERPAYMENT');
+  });
+
+  it('records partial payment and sets status to partially_paid', () => {
+    const result = recordPayment(issuedInvoice, { amount: 1000, date: '2026-01-05' });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.status, 'partially_paid');
+    assert.equal(result.value.payments.length, 1);
+    assert.equal(result.value.payments[0].amount, 1000);
+    assert.equal(result.value.payments[0].date, '2026-01-05');
+  });
+
+  it('records full payment and sets status to paid', () => {
+    const result = recordPayment(issuedInvoice, { amount: 2400, date: '2026-01-05' });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.status, 'paid');
+    assert.equal(result.value.payments.length, 1);
+  });
+
+  it('allows payment on partially_paid invoice', () => {
+    const partial = {
+      ...issuedInvoice,
+      status: 'partially_paid',
+      payments: [{ amount: 1000, date: '2026-01-05' }],
+    };
+    const result = recordPayment(partial, { amount: 1400, date: '2026-01-10' });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.status, 'paid');
+    assert.equal(result.value.payments.length, 2);
+  });
+
+  it('handles multiple partial payments until paid', () => {
+    const payment1 = recordPayment(issuedInvoice, { amount: 800, date: '2026-01-05' });
+    assert.equal(payment1.ok, true);
+    assert.equal(payment1.value.status, 'partially_paid');
+
+    const payment2 = recordPayment(payment1.value, { amount: 800, date: '2026-01-10' });
+    assert.equal(payment2.ok, true);
+    assert.equal(payment2.value.status, 'partially_paid');
+
+    const payment3 = recordPayment(payment2.value, { amount: 800, date: '2026-01-15' });
+    assert.equal(payment3.ok, true);
+    assert.equal(payment3.value.status, 'paid');
+    assert.equal(payment3.value.payments.length, 3);
+  });
+
+  it('rejects overpayment on partially_paid invoice', () => {
+    const partial = {
+      ...issuedInvoice,
+      status: 'partially_paid',
+      payments: [{ amount: 1000, date: '2026-01-05' }],
+    };
+    const result = recordPayment(partial, { amount: 1500, date: '2026-01-10' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'OVERPAYMENT');
+  });
+});
