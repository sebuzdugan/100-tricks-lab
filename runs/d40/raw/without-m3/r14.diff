+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { statement } from '../src/statements.js';
+
+describe('statement', () => {
+  const issuedInvoice = {
+    customerId: 'C-001',
+    number: 'INV-2025-0001',
+    issueDate: '2025-01-15',
+    dueDate: '2025-02-14',
+    status: 'issued',
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const partiallyPaidInvoice = {
+    customerId: 'C-001',
+    number: 'INV-2025-0002',
+    issueDate: '2025-02-10',
+    dueDate: '2025-03-12',
+    status: 'partially_paid',
+    lines: [
+      { qty: 2, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+    payments: [
+      { amount: 5000, date: '2025-02-28' },
+    ],
+  };
+
+  const paidInvoice = {
+    customerId: 'C-001',
+    number: 'INV-2025-0003',
+    issueDate: '2025-03-01',
+    dueDate: '2025-04-01',
+    status: 'paid',
+    lines: [
+      { qty: 1, unitPrice: 8000, discountPercent: 0, vatRate: 21 },
+    ],
+    payments: [
+      { amount: 9680, date: '2025-03-20' },
+    ],
+  };
+
+  const draftInvoice = {
+    customerId: 'C-001',
+    issueDate: '2025-03-15',
+    dueDate: '2025-04-14',
+    status: 'draft',
+    lines: [
+      { qty: 1, unitPrice: 3000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const futureInvoice = {
+    customerId: 'C-001',
+    number: 'INV-2025-0004',
+    issueDate: '2025-05-01',
+    dueDate: '2025-06-01',
+    status: 'issued',
+    lines: [
+      { qty: 1, unitPrice: 2000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const otherCustomerInvoice = {
+    customerId: 'C-002',
+    number: 'INV-2025-0001',
+    issueDate: '2025-01-20',
+    dueDate: '2025-02-20',
+    status: 'issued',
+    lines: [
+      { qty: 1, unitPrice: 15000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  it('returns customer statement with issued invoices', () => {
+    const result = statement('C-001', [issuedInvoice], '2025-03-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].number, 'INV-2025-0001');
+    assert.equal(result.value.invoices[0].issueDate, '2025-01-15');
+    assert.equal(result.value.invoices[0].dueDate, '2025-02-14');
+    assert.equal(result.value.invoices[0].total, 12100);
+    assert.equal(result.value.invoices[0].due, 12100);
+    assert.equal(result.value.totalDue, 12100);
+  });
+
+  it('includes partially paid invoices with correct due amount', () => {
+    const result = statement('C-001', [partiallyPaidInvoice], '2025-03-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].number, 'INV-2025-0002');
+    assert.equal(result.value.invoices[0].total, 12100);
+    assert.equal(result.value.invoices[0].due, 7100);
+    assert.equal(result.value.totalDue, 7100);
+  });
+
+  it('excludes paid invoices', () => {
+    const result = statement('C-001', [paidInvoice], '2025-04-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 0);
+    assert.equal(result.value.totalDue, 0);
+  });
+
+  it('excludes draft invoices', () => {
+    const result = statement('C-001', [draftInvoice], '2025-04-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 0);
+    assert.equal(result.value.totalDue, 0);
+  });
+
+  it('excludes invoices after asOf date', () => {
+    const result = statement('C-001', [futureInvoice], '2025-04-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 0);
+    assert.equal(result.value.totalDue, 0);
+  });
+
+  it('includes invoices on asOf date', () => {
+    const result = statement('C-001', [issuedInvoice], '2025-01-15');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+  });
+
+  it('filters by customer ID', () => {
+    const result = statement('C-001', [issuedInvoice, otherCustomerInvoice], '2025-03-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].number, 'INV-2025-0001');
+  });
+
+  it('normalizes customer ID', () => {
+    const result = statement('c-001 ', [issuedInvoice], '2025-03-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.invoices.length, 1);
+  });
+
+  it('sorts invoices by issueDate', () => {
+    const invoices = [
+      {
+        customerId: 'C-001',
+        number: 'INV-2025-0003',
+        issueDate: '2025-03-01',
+        dueDate: '2025-04-01',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+      },
+      {
+        customerId: 'C-001',
+        number: 'INV-2025-0001',
+        issueDate: '2025-01-15',
+        dueDate: '2025-02-14',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+      },
+      {
+        customerId: 'C-001',
+        number: 'INV-2025-0002',
+        issueDate: '2025-02-10',
+        dueDate: '2025-03-12',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+      },
+    ];
+
+    const result = statement('C-001', invoices, '2025-04-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices[0].number, 'INV-2025-0001');
+    assert.equal(result.value.invoices[1].number, 'INV-2025-0002');
+    assert.equal(result.value.invoices[2].number, 'INV-2025-0003');
+  });
+
+  it('calculates totalDue as sum of all dues', () => {
+    const invoices = [
+      {
+        customerId: 'C-001',
+        number: 'INV-2025-0001',
+        issueDate: '2025-01-15',
+        dueDate: '2025-02-14',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 }],
+      },
+      {
+        customerId: 'C-001',
+        number: 'INV-2025-0002',
+        issueDate: '2025-02-10',
+        dueDate: '2025-03-12',
+        status: 'partially_paid',
+        lines: [{ qty: 2, unitPrice: 5000, discountPercent: 0, vatRate: 21 }],
+        payments: [{ amount: 5000, date: '2025-02-28' }],
+      },
+    ];
+
+    const result = statement('C-001', invoices, '2025-04-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 2);
+    const inv1Due = result.value.invoices[0].due;
+    const inv2Due = result.value.invoices[1].due;
+    assert.equal(result.value.totalDue, inv1Due + inv2Due);
+  });
+
+  it('returns CUSTOMER_NOT_FOUND for unknown customer', () => {
+    const result = statement('C-999', [issuedInvoice], '2025-03-01');
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+  });
+
+  it('returns empty invoice list for known customer with no qualifying invoices', () => {
+    const result = statement('C-001', [], '2025-03-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.invoices.length, 0);
+    assert.equal(result.value.totalDue, 0);
+  });
+
+  it('handles invoices with discounts', () => {
+    const invoice = {
+      customerId: 'C-001',
+      number: 'INV-2025-0001',
+      issueDate: '2025-01-15',
+      dueDate: '2025-02-14',
+      status: 'issued',
+      lines: [
+        { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+      ],
+    };
+
+    const result = statement('C-001', [invoice], '2025-03-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    const subtotal = 10000;
+    const discount = 1000;
+    const discountedAmount = 9000;
+    const vat = Math.round(discountedAmount * 21 / 100);
+    const expectedTotal = subtotal - discount + vat;
+    assert.equal(result.value.invoices[0].total, expectedTotal);
+    assert.equal(result.value.invoices[0].due, expectedTotal);
+  });
+
+  it('handles invoices with vouchers', () => {
+    const invoice = {
+      customerId: 'C-001',
+      number: 'INV-2025-0001',
+      issueDate: '2025-01-15',
+      dueDate: '2025-02-14',
+      status: 'issued',
+      lines: [
+        { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+      ],
+      voucher: { code: 'SAVE5', amount: 500 },
+    };
+
+    const result = statement('C-001', [invoice], '2025-03-01');
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    const subtotal = 10000;
+    const vat = Math.round(subtotal * 21 / 100);
+    const expectedTotal = subtotal + vat - 500;
+    assert.equal(result.value.invoices[0].total, expectedTotal);
+    assert.equal(result.value.invoices[0].due, expectedTotal);
+  });
+});
