+++ b/test/credits.test.js
@@ -0,0 +1,261 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+
+describe('nextCreditNoteNumber', () => {
+  it('starts at 0001 for a new year', () => {
+    const result = nextCreditNoteNumber([], '2025-03-15');
+    assert.equal(result, 'CN-2025-0001');
+  });
+
+  it('increments counter for same year', () => {
+    const result = nextCreditNoteNumber(['CN-2025-0001', 'CN-2025-0002'], '2025-06-20');
+    assert.equal(result, 'CN-2025-0003');
+  });
+
+  it('resets counter for new year', () => {
+    const result = nextCreditNoteNumber(['CN-2025-0010', 'CN-2026-0001'], '2026-01-15');
+    assert.equal(result, 'CN-2026-0002');
+  });
+
+  it('ignores invoice numbers in existingNumbers', () => {
+    const result = nextCreditNoteNumber(['INV-2025-0001', 'INV-2025-0002', 'CN-2025-0001'], '2025-06-20');
+    assert.equal(result, 'CN-2025-0002');
+  });
+
+  it('handles mixed invoice and credit note numbers', () => {
+    const numbers = [
+      'INV-2025-0001',
+      'CN-2025-0001',
+      'INV-2025-0002',
+      'CN-2025-0002',
+      'INV-2025-0003',
+    ];
+    const result = nextCreditNoteNumber(numbers, '2025-06-20');
+    assert.equal(result, 'CN-2025-0003');
+  });
+
+  it('handles high counters with padding', () => {
+    const numbers = Array.from({ length: 9999 }, (_, i) => `CN-2025-${String(i + 1).padStart(4, '0')}`);
+    const result = nextCreditNoteNumber(numbers, '2025-12-31');
+    assert.equal(result, 'CN-2025-10000');
+  });
+
+  it('handles unordered numbers', () => {
+    const result = nextCreditNoteNumber(['CN-2025-0003', 'CN-2025-0001', 'CN-2025-0002'], '2025-06-20');
+    assert.equal(result, 'CN-2025-0004');
+  });
+});
+
+describe('createCreditNote', () => {
+  const issuedInvoice = {
+    status: 'issued',
+    number: 'INV-2025-0001',
+    customerId: 'C-001',
+    issueDate: '2025-01-15',
+    dueDate: '2025-02-14',
+    lines: [
+      { qty: 2, unitPrice: 5000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  const partiallyPaidInvoice = {
+    status: 'partially_paid',
+    number: 'INV-2025-0002',
+    customerId: 'C-001',
+    issueDate: '2025-02-10',
+    dueDate: '2025-03-12',
+    lines: [
+      { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+    ],
+    payments: [
+      { amount: 5000, date: '2025-02-28' },
+    ],
+  };
+
+  const paidInvoice = {
+    status: 'paid',
+    number: 'INV-2025-0003',
+    customerId: 'C-001',
+    issueDate: '2025-03-01',
+    dueDate: '2025-04-01',
+    lines: [
+      { qty: 1, unitPrice: 8000, discountPercent: 0, vatRate: 21 },
+    ],
+    payments: [
+      { amount: 9680, date: '2025-03-20' },
+    ],
+  };
+
+  const draftInvoice = {
+    status: 'draft',
+    number: 'INV-2025-0004',
+    customerId: 'C-001',
+    issueDate: '2025-03-15',
+    dueDate: '2025-04-14',
+    lines: [
+      { qty: 1, unitPrice: 3000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+
+  it('creates credit note for issued invoice', () => {
+    const result = createCreditNote(issuedInvoice, { amount: 5000, reason: 'Defective product', date: '2025-03-01' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2025-0001');
+    assert.equal(result.value.invoiceNumber, 'INV-2025-0001');
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.amount, 5000);
+    assert.equal(result.value.reason, 'Defective product');
+    assert.equal(result.value.date, '2025-03-01');
+  });
+
+  it('creates credit note for partially paid invoice', () => {
+    const result = createCreditNote(partiallyPaidInvoice, { amount: 2121, reason: 'Partial refund', date: '2025-03-05' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2025-0001');
+    assert.equal(result.value.invoiceNumber, 'INV-2025-0002');
+  });
+
+  it('creates credit note for paid invoice', () => {
+    const result = createCreditNote(paidInvoice, { amount: 1000, reason: 'Goodwill adjustment', date: '2025-03-10' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2025-0001');
+    assert.equal(result.value.invoiceNumber, 'INV-2025-0003');
+  });
+
+  it('rejects credit note for draft invoice', () => {
+    const result = createCreditNote(draftInvoice, { amount: 1000, reason: 'Test', date: '2025-03-20' }, []);
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NOT_ISSUED');
+  });
+
+  it('rejects zero amount', () => {
+    const result = createCreditNote(issuedInvoice, { amount: 0, reason: 'Test', date: '2025-03-01' }, []);
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects negative amount', () => {
+    const result = createCreditNote(issuedInvoice, { amount: -1000, reason: 'Test', date: '2025-03-01' }, []);
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects non-integer amount', () => {
+    const result = createCreditNote(issuedInvoice, { amount: 1000.5, reason: 'Test', date: '2025-03-01' }, []);
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects credit note amount exceeding invoice total', () => {
+    const result = createCreditNote(issuedInvoice, { amount: 13000, reason: 'Too much', date: '2025-03-01' }, []);
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'CREDIT_TOO_HIGH');
+  });
+
+  it('allows credit note equal to invoice total', () => {
+    const result = createCreditNote(issuedInvoice, { amount: 12100, reason: 'Full refund', date: '2025-03-01' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.amount, 12100);
+  });
+
+  it('increments credit note counter', () => {
+    const r1 = createCreditNote(issuedInvoice, { amount: 5000, reason: 'First', date: '2025-03-01' }, ['CN-2025-0001', 'CN-2025-0002']);
+    const r2 = createCreditNote(issuedInvoice, { amount: 5000, reason: 'Second', date: '2025-03-05' }, ['CN-2025-0001', 'CN-2025-0002']);
+    assert.equal(r1.value.number, 'CN-2025-0003');
+    assert.equal(r2.value.number, 'CN-2025-0003');
+  });
+
+  it('keeps separate counter for invoices and credit notes', () => {
+    const existingNumbers = [
+      'INV-2025-0001',
+      'CN-2025-0001',
+      'INV-2025-0002',
+      'CN-2025-0002',
+      'INV-2025-0003',
+    ];
+    const result = createCreditNote(issuedInvoice, { amount: 5000, reason: 'Test', date: '2025-03-01' }, existingNumbers);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2025-0003');
+  });
+
+  it('resets counter for new year', () => {
+    const result = createCreditNote(issuedInvoice, { amount: 5000, reason: 'Test', date: '2026-01-15' }, ['CN-2025-0010', 'CN-2026-0001']);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0002');
+  });
+
+  it('handles invoice with discount', () => {
+    const invoice = {
+      status: 'issued',
+      number: 'INV-2025-0001',
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      dueDate: '2025-02-14',
+      lines: [
+        { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+      ],
+    };
+    const subtotal = 10000;
+    const discount = 1000;
+    const discountedAmount = 9000;
+    const vat = Math.round(discountedAmount * 21 / 100);
+    const total = subtotal - discount + vat;
+
+    const result = createCreditNote(invoice, { amount: total, reason: 'Full refund', date: '2025-03-01' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.amount, total);
+  });
+
+  it('rejects credit note exceeding invoice with discount', () => {
+    const invoice = {
+      status: 'issued',
+      number: 'INV-2025-0001',
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      dueDate: '2025-02-14',
+      lines: [
+        { qty: 1, unitPrice: 10000, discountPercent: 10, vatRate: 21 },
+      ],
+    };
+    const result = createCreditNote(invoice, { amount: 11000, reason: 'Too much', date: '2025-03-01' }, []);
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'CREDIT_TOO_HIGH');
+  });
+
+  it('handles invoice with voucher', () => {
+    const invoice = {
+      status: 'issued',
+      number: 'INV-2025-0001',
+      customerId: 'C-001',
+      issueDate: '2025-01-15',
+      dueDate: '2025-02-14',
+      lines: [
+        { qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 21 },
+      ],
+      voucher: { code: 'SAVE5', amount: 500 },
+    };
+    const subtotal = 10000;
+    const vat = Math.round(subtotal * 21 / 100);
+    const total = subtotal + vat - 500;
+
+    const result = createCreditNote(invoice, { amount: total, reason: 'Full refund', date: '2025-03-01' }, []);
+    assert.equal(result.ok, true);
+    assert.equal(result.value.amount, total);
+  });
+
+  it('preserves all credit note fields', () => {
+    const result = createCreditNote(
+      issuedInvoice,
+      { amount: 5000, reason: 'Quality issue - defective unit', date: '2025-03-15' },
+      ['CN-2025-0001']
+    );
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2025-0002');
+    assert.equal(result.value.invoiceNumber, 'INV-2025-0001');
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.amount, 5000);
+    assert.equal(result.value.reason, 'Quality issue - defective unit');
+    assert.equal(result.value.date, '2025-03-15');
+  });
+});
