new file mode 100644
index 0000000..2cb5b69
--- /dev/null
+++ b/src/reports.js
@@ -0,0 +1,21 @@
+import { balanceDue } from './payments.js';
+import { daysBetween } from './dates.js';
+
+/**
+ * Get overdue invoices: issued or partially paid invoices whose due date has passed.
+ * @param {Array} invoices
+ * @param {string} asOf - Current date in YYYY-MM-DD format
+ * @returns {Array<{ number: string, customerId: string, dueDate: string, daysOverdue: number, due: number }>}
+ */
+export function overdueInvoices(invoices, asOf) {
+  return invoices
+    .filter(inv => (inv.status === 'issued' || inv.status === 'partially_paid') && inv.dueDate < asOf)
+    .map(inv => ({
+      number: inv.number,
+      customerId: inv.customerId,
+      dueDate: inv.dueDate,
+      daysOverdue: daysBetween(inv.dueDate, asOf),
+      due: balanceDue(inv),
+    }))
+    .sort((a, b) => b.daysOverdue - a.daysOverdue);
+}
diff --git a/test/reports.test.js b/test/reports.test.js
new file mode 100644
index 0000000..77281b6
--- /dev/null
+++ b/test/reports.test.js
@@ -0,0 +1,138 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices', async (t) => {
+  await t.test('returns empty array when no invoices', () => {
+    const result = overdueInvoices([], '2026-10-07');
+    assert.deepStrictEqual(result, []);
+  });
+
+  await t.test('filters out draft invoices', () => {
+    const invoices = [
+      { number: 'INV-1', customerId: 'CUST1', dueDate: '2026-09-01', status: 'draft', lines: [] },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result.length, 0);
+  });
+
+  await t.test('filters out paid invoices', () => {
+    const invoices = [
+      { number: 'INV-1', customerId: 'CUST1', dueDate: '2026-09-01', status: 'paid', lines: [] },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result.length, 0);
+  });
+
+  await t.test('filters out invoices with future due dates', () => {
+    const invoices = [
+      { number: 'INV-1', customerId: 'CUST1', dueDate: '2026-10-15', status: 'issued', lines: [] },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result.length, 0);
+  });
+
+  await t.test('includes issued invoices with past due dates', () => {
+    const invoices = [
+      { number: 'INV-1', customerId: 'CUST1', dueDate: '2026-09-01', status: 'issued', lines: [] },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result.length, 1);
+    assert.strictEqual(result[0].number, 'INV-1');
+  });
+
+  await t.test('includes partially_paid invoices with past due dates', () => {
+    const invoices = [
+      { number: 'INV-1', customerId: 'CUST1', dueDate: '2026-09-01', status: 'partially_paid', lines: [] },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result.length, 1);
+    assert.strictEqual(result[0].number, 'INV-1');
+  });
+
+  await t.test('sorts by most overdue first (highest daysOverdue)', () => {
+    const invoices = [
+      { number: 'INV-1', customerId: 'CUST1', dueDate: '2026-08-01', status: 'issued', lines: [] },
+      { number: 'INV-2', customerId: 'CUST2', dueDate: '2026-09-15', status: 'issued', lines: [] },
+      { number: 'INV-3', customerId: 'CUST3', dueDate: '2026-09-01', status: 'issued', lines: [] },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result.length, 3);
+    assert.strictEqual(result[0].number, 'INV-1'); // 67 days overdue
+    assert.strictEqual(result[1].number, 'INV-3'); // 36 days overdue
+    assert.strictEqual(result[2].number, 'INV-2'); // 22 days overdue
+  });
+
+  await t.test('calculates daysOverdue correctly', () => {
+    const invoices = [
+      { number: 'INV-1', customerId: 'CUST1', dueDate: '2026-10-05', status: 'issued', lines: [] },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result[0].daysOverdue, 2);
+  });
+
+  await t.test('includes due amount for fully unpaid issued invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-1',
+        customerId: 'CUST1',
+        dueDate: '2026-09-01',
+        status: 'issued',
+        lines: [{ qty: 10, unitPrice: 5000, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result[0].due, 50000);
+  });
+
+  await t.test('includes remaining due amount for partially_paid invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-1',
+        customerId: 'CUST1',
+        dueDate: '2026-09-01',
+        status: 'partially_paid',
+        lines: [{ qty: 10, unitPrice: 5000, discountPercent: 0, vatRate: 0 }],
+        payments: [{ amount: 20000, date: '2026-09-15' }],
+      },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result[0].due, 30000);
+  });
+
+  await t.test('returns correct shape with all required fields', () => {
+    const invoices = [
+      {
+        number: 'INV-42',
+        customerId: 'MYCUST',
+        dueDate: '2026-09-01',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    const inv = result[0];
+    assert.strictEqual(inv.number, 'INV-42');
+    assert.strictEqual(inv.customerId, 'MYCUST');
+    assert.strictEqual(inv.dueDate, '2026-09-01');
+    assert.strictEqual(typeof inv.daysOverdue, 'number');
+    assert.strictEqual(typeof inv.due, 'number');
+  });
+
+  await t.test('handles invoices with discounts and VAT', () => {
+    const invoices = [
+      {
+        number: 'INV-1',
+        customerId: 'CUST1',
+        dueDate: '2026-09-01',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 20 }],
+      },
+    ];
+    const result = overdueInvoices(invoices, '2026-10-07');
+    assert.strictEqual(result.length, 1);
+    const due = result[0].due;
+    assert.strictEqual(typeof due, 'number');
+    assert(due > 0);
+  });
+});
