+/**
+ * Summarize VAT by rate across invoices.
+ * @param {Array} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate descending
+ */
+export function vatSummary(invoices) {
+  const rates = new Map();
+
+  for (const inv of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(inv.status)) {
+      continue;
+    }
+
+    for (const line of inv.lines ?? []) {
+      const rate = line.vatRate ?? 0;
+      const base = lineTotal(line) - lineDiscount(line);
+      const vat = lineVAT(line);
+
+      if (!rates.has(rate)) {
+        rates.set(rate, { base: 0, vat: 0 });
+      }
+      const entry = rates.get(rate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  return Array.from(rates.entries())
+    .map(([rate, { base, vat }]) => ({ rate, base, vat }))
+    .sort((a, b) => b.rate - a.rate);
+}
