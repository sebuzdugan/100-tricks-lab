+/**
+ * Calculate the late fee for an invoice: 0.04% per day overdue.
+ * @param {{ dueDate: string, status?: string, payments?: Array, lines: Array }} invoice
+ * @param {string} asOf - Current date in YYYY-MM-DD format
+ * @returns {number} Late fee in cents
+ */
+export function lateFee(invoice, asOf) {
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  if (daysOverdue <= 0) {
+    return 0;
+  }
+  const due = balanceDue(invoice);
+  const fee = due * 0.0004 * daysOverdue;
+  return Math.round(fee);
+}
