+import test from 'node:test';
+import assert from 'node:assert';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv', async (t) => {
+  await t.test('returns header and newline when no invoices', () => {
+    const result = exportCsv([]);
+    assert.strictEqual(result, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+  });
+
+  await t.test('returns header plus one data line for single invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    assert.strictEqual(lines.length, 3); // header + 1 data + empty (trailing newline)
+    assert.strictEqual(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+    assert.match(lines[1], /^INV-001,Northwind Studio,2026-10-01,2026-10-31,issued,1000\.00,0\.00,0\.00,1000\.00,1000\.00$/);
+  });
+
+  await t.test('looks up customer name from customerId', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    assert.match(lines[1], /Northwind Studio/);
+  });
+
+  await t.test('quotes field with comma in customer name', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-004',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    // C-004 is "Smith, Jones & Partners" - should be quoted due to comma
+    assert.match(lines[1], /^INV-001,"Smith, Jones & Partners"/);
+  });
+
+  await t.test('escapes double quotes in customer name', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-006',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    // C-006 is 'Marlow "The Print Shop"' - should be quoted and inner quotes doubled
+    assert.match(lines[1], /^INV-001,"Marlow ""The Print Shop"""/);
+  });
+
+  await t.test('formats amounts with 2 decimal places and dot separator', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    // All amounts formatted as euros with dot separator: 1000.00, 0.00, etc.
+    assert.match(lines[1], /1000\.00,0\.00,0\.00,1000\.00,1000\.00/);
+  });
+
+  await t.test('handles invoice with discount', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    // subtotal=100000 (100*1000), discount=10000 (100000*10%), vat=0, total=90000
+    // When formatted as euros: subtotal=1000.00, discount=100.00, vat=0.00, total=900.00
+    assert.match(lines[1], /1000\.00.*100\.00.*0\.00.*900\.00/);
+  });
+
+  await t.test('handles invoice with VAT', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 20 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    // subtotal=100000, discount=0, vat=20000, total=120000
+    // When formatted as euros: subtotal=1000.00, discount=0.00, vat=200.00, total=1200.00
+    assert.match(lines[1], /1000\.00.*0\.00.*200\.00.*1200\.00/);
+  });
+
+  await t.test('handles partially paid invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'partially_paid',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [{ amount: 40000, date: '2026-10-15' }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    // total=100000 (in cents), due=60000 (in cents)
+    // When formatted as euros: total=1000.00, due=600.00
+    assert.match(lines[1], /1000\.00,600\.00$/);
+  });
+
+  await t.test('maintains invoice order', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+      {
+        number: 'INV-002',
+        customerId: 'C-001',
+        issueDate: '2026-10-02',
+        dueDate: '2026-11-01',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 200, discountPercent: 0, vatRate: 0 }],
+      },
+      {
+        number: 'INV-003',
+        customerId: 'C-001',
+        issueDate: '2026-10-03',
+        dueDate: '2026-11-02',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 300, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    assert.match(lines[1], /^INV-001/);
+    assert.match(lines[2], /^INV-002/);
+    assert.match(lines[3], /^INV-003/);
+  });
+
+  await t.test('handles different invoice statuses', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'draft',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+      {
+        number: 'INV-002',
+        customerId: 'C-001',
+        issueDate: '2026-10-02',
+        dueDate: '2026-11-01',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+      {
+        number: 'INV-003',
+        customerId: 'C-001',
+        issueDate: '2026-10-03',
+        dueDate: '2026-11-02',
+        status: 'paid',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    assert.match(lines[1], /draft/);
+    assert.match(lines[2], /issued/);
+    assert.match(lines[3], /paid/);
+  });
+
+  await t.test('ends with newline', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    assert.strictEqual(result.endsWith('\n'), true);
+  });
+
+  await t.test('has proper CSV header', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    assert.strictEqual(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  });
+
+  await t.test('handles zero amounts', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'paid',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [{ amount: 100000, date: '2026-10-15' }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    // due should be 0.00 for paid invoice
+    assert.match(lines[1], /0\.00$/);
+  });
+
+  await t.test('handles very small amounts', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 1, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    assert.match(lines[1], /0\.01/);
+  });
+
+  await t.test('quotes field with comma', () => {
+    // The number field could have a comma if we test with a proper example
+    const invoices = [
+      {
+        number: 'INV-001,A',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    assert.match(lines[1], /^"INV-001,A"/);
+  });
+
+  await t.test('escapes double quotes in fields', () => {
+    const invoices = [
+      {
+        number: 'INV-"001"',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    assert.match(lines[1], /^"INV-""001"""/);
+  });
+
+  await t.test('handles multiple lines per invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [
+          { qty: 50, unitPrice: 1000, discountPercent: 0, vatRate: 20 },
+          { qty: 50, unitPrice: 1000, discountPercent: 10, vatRate: 20 },
+        ],
+      },
+    ];
+    const result = exportCsv(invoices);
+    const lines = result.split('\n');
+    // subtotal = 50*1000 + 50*1000 = 100000 cents = 1000.00 euros
+    // discount = 0 + 50*1000*0.1 = 5000 cents = 50.00 euros
+    // vat = 50*1000*0.2 + (50*1000-5000)*0.2 = 10000 + 9000 = 19000 cents = 190.00 euros
+    // total = 100000 - 5000 + 19000 = 114000 cents = 1140.00 euros
+    assert.match(lines[1], /1000\.00.*50\.00.*190\.00.*1140\.00/);
+  });
+
+  await t.test('can be parsed back as CSV', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.trim().split('\n');
+    assert.strictEqual(lines.length, 2);
+    const [header, dataLine] = lines;
+    const headers = header.split(',');
+    assert.strictEqual(headers.length, 10);
+  });
+});
