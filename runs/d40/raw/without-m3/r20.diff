diff --git a/src/money.js b/src/money.js
index fadf486..32a30cb 100644
--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,44 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert EUR cents to another currency's cents.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  const rate = RATES[currency];
+  if (rate === undefined) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+  const converted = cents * rate;
+  return ok(Math.round(converted));
+}
+
+/**
+ * Format cents in a given currency for display.
+ * @param {number} cents - Amount in EUR cents
+ * @param {string} currency - Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const convertResult = convert(cents, currency);
+  if (!convertResult.ok) {
+    return 'Unknown currency';
+  }
+
+  const currencyCents = convertResult.value;
+  const sign = currencyCents < 0 ? '-' : '';
+  const abs = Math.abs(currencyCents);
+  const symbol = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+  const major = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  return `${sign}${symbol}${major}.${String(abs % 100).padStart(2, '0')}`;
+}
