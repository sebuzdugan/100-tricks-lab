+
+test('RATES defines currency exchange rates per euro', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR cents to other currencies', () => {
+  assert.deepEqual(convert(10000, 'EUR'), { ok: true, value: 10000 });
+  assert.deepEqual(convert(10000, 'USD'), { ok: true, value: 10850 });
+  assert.deepEqual(convert(10000, 'GBP'), { ok: true, value: 8425 });
+  assert.deepEqual(convert(10000, 'JPY'), { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('convert rounds to nearest cent', () => {
+  assert.deepEqual(convert(1, 'USD'), { ok: true, value: 1 });
+  assert.deepEqual(convert(923, 'GBP'), { ok: true, value: 778 });
+  assert.deepEqual(convert(100, 'GBP'), { ok: true, value: 84 });
+});
+
+test('convert handles zero and negative amounts', () => {
+  assert.deepEqual(convert(0, 'USD'), { ok: true, value: 0 });
+  assert.deepEqual(convert(-10000, 'USD'), { ok: true, value: -10850 });
+});
+
+test('convert is case-sensitive for currency codes', () => {
+  assert.deepEqual(convert(10000, 'usd'), { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('formatMoney formats amounts in different currencies', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+  assert.equal(formatMoney(10000, 'USD'), '$108.50');
+  assert.equal(formatMoney(10000, 'GBP'), '£84.25');
+});
+
+test('formatMoney handles negative amounts', () => {
+  assert.equal(formatMoney(-10000, 'EUR'), '-€100.00');
+  assert.equal(formatMoney(-10000, 'USD'), '-$108.50');
+  assert.equal(formatMoney(-10000, 'GBP'), '-£84.25');
+});
+
+test('formatMoney handles zero', () => {
+  assert.equal(formatMoney(0, 'EUR'), '€0.00');
+  assert.equal(formatMoney(0, 'USD'), '$0.00');
+  assert.equal(formatMoney(0, 'GBP'), '£0.00');
+});
+
+test('formatMoney uses correct symbol for each currency', () => {
+  assert.match(formatMoney(10000, 'EUR'), /^€/);
+  assert.match(formatMoney(10000, 'USD'), /^\$/);
+  assert.match(formatMoney(10000, 'GBP'), /^£/);
+});
+
+test('formatMoney handles thousands separators', () => {
+  assert.equal(formatMoney(123456789, 'EUR'), '€1,234,567.89');
+  assert.equal(formatMoney(123456789, 'USD'), '$1,339,506.16');
+});
+
+test('formatMoney handles small amounts', () => {
+  assert.equal(formatMoney(1, 'EUR'), '€0.01');
+  assert.equal(formatMoney(1, 'USD'), '$0.01');
+  assert.equal(formatMoney(1, 'GBP'), '£0.01');
+});
+
+test('formatMoney returns error message for unknown currency', () => {
+  assert.equal(formatMoney(10000, 'JPY'), 'Unknown currency');
+});
