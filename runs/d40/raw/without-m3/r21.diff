+
+test('mergeCustomers moves invoices from one customer to another', () => {
+  const customers = [
+    { id: 'CUST1', name: 'Customer One', email: 'cust1@example.com', tier: 'gold' },
+    { id: 'CUST2', name: 'Customer Two', email: 'cust2@example.com', tier: 'silver' },
+  ];
+  const invoices = [
+    { customerId: 'CUST1', number: 'INV001', status: 'issued' },
+    { customerId: 'CUST1', number: 'INV002', status: 'issued' },
+    { customerId: 'CUST2', number: 'INV003', status: 'issued' },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'CUST1', 'CUST2');
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 1);
+  assert.deepEqual(result.value.customers[0].id, 'CUST2');
+  assert.equal(result.value.invoices.length, 3);
+  assert.equal(result.value.invoices[0].customerId, 'CUST2');
+  assert.equal(result.value.invoices[1].customerId, 'CUST2');
+  assert.equal(result.value.invoices[2].customerId, 'CUST2');
+});
+
