+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  assert.equal(lineTotal({ qty: 2, unitPrice: 1000 }), 2000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 500 }), 500);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 100 }), 1000);
+});
+
+test('lineTotal with zero qty', () => {
+  assert.equal(lineTotal({ qty: 0, unitPrice: 1000 }), 0);
+});
+
+test('lineDiscount calculates percent of lineTotal', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 10 }), 10000);
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 5 }), 5000);
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 0 }), 0);
+});
+
+test('lineDiscount defaults to 0% if not specified', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000 }), 0);
+});
+
+test('lineDiscount is never negative', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: -10 }), 0);
+});
+
+test('lineDiscount with fractional result', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 2.5 }), 2500);
+  assert.equal(lineDiscount({ qty: 33, unitPrice: 100, discountPercent: 10 }), 330);
+});
+
+test('lineVAT calculates VAT on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 21 };
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const discountedAmount = total - discount;
+  const expectedVAT = Math.round(discountedAmount * 21 / 100);
+  assert.equal(lineVAT(line), expectedVAT);
+});
+
+test('lineVAT with no discount', () => {
+  const line = { qty: 100, unitPrice: 1000, vatRate: 21 };
+  const total = lineTotal(line);
+  const expectedVAT = Math.round(total * 21 / 100);
+  assert.equal(lineVAT(line), expectedVAT);
+});
+
+test('lineVAT defaults to 0% if not specified', () => {
+  assert.equal(lineVAT({ qty: 100, unitPrice: 1000 }), 0);
+});
+
+test('lineVAT with zero discount percent', () => {
+  const line = { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 };
+  const expectedVAT = Math.round(100000 * 21 / 100);
+  assert.equal(lineVAT(line), expectedVAT);
+});
+
+test('lineVAT with rounding', () => {
+  assert.equal(lineVAT({ qty: 1, unitPrice: 100, vatRate: 21 }), 21);
+  assert.equal(lineVAT({ qty: 1, unitPrice: 1, vatRate: 21 }), 0);
+});
+
+test('lineVAT never negative', () => {
+  assert.equal(lineVAT({ qty: 100, unitPrice: 1000, discountPercent: 200, vatRate: 21 }), 0);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1000);
+  assert.equal(totals.vat, 1890);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 10890);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 21 },
+      { qty: 5, unitPrice: 2000, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 20000);
+  assert.equal(totals.discount, 1500);
+  assert.equal(totals.vat, 3885);
+  assert.equal(totals.total, 22385);
+});
+
+test('invoiceTotals with no discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.total, 121000);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 21 }],
+    voucher: { code: 'TEST', amount: 5000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 100000);
+  assert.equal(totals.vat, 21000);
+  assert.equal(totals.voucher, 5000);
+  assert.equal(totals.total, 116000);
+});
+
+test('invoiceTotals with no voucher defaults to 0', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals total never negative', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 0 }],
+    voucher: { code: 'BIG', amount: 200000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with mixed VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, vatRate: 21 },
+      { qty: 100, unitPrice: 1000, vatRate: 6 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 200000);
+  assert.equal(totals.vat, 27000);
+  assert.equal(totals.total, 227000);
+});
+
+test('invoiceTotals with complex scenario', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 2000, discountPercent: 10, vatRate: 21 },
+      { qty: 20, unitPrice: 500, discountPercent: 5, vatRate: 6 },
+      { qty: 1, unitPrice: 50000, discountPercent: 0, vatRate: 21 },
+    ],
+    voucher: { code: 'SAVE', amount: 2000 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 70000);
+  assert.equal(totals.discount, 1500);
+  assert.equal(totals.vat, 12960);
+  assert.equal(totals.voucher, 2000);
+  assert.equal(totals.total, 79460);
+});
+
+test('invoiceTotals returns all properties', () => {
+  const invoice = {
+    lines: [{ qty: 1, unitPrice: 1000, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(Object.keys(totals).length, 5);
+  assert.ok('subtotal' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('vat' in totals);
+  assert.ok('voucher' in totals);
+  assert.ok('total' in totals);
+});
