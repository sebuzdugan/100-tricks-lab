 /**
- * Calculate the VAT amount for a line (on amount after discount).
+ * Calculate the bulk discount for a line (2.5% extra off for qty >= 10, applied after line discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }}
+ * @returns {number}
+ */
+export function bulkDiscount(line) {
+  if (line.qty < 10) return 0;
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const afterFirstDiscount = total - discount;
+  const bulk = afterFirstDiscount * 2.5 / 100;
+  return Math.max(0, bulk);
+}
+
+/**
+ * Calculate the VAT amount for a line (on amount after both line and bulk discounts).
  * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }}
  * @returns {number}
  */
 export function lineVAT(line) {
   const total = lineTotal(line);
   const discount = lineDiscount(line);
-  const discountedAmount = Math.max(0, total - discount);
+  const bulk = bulkDiscount(line);
+  const discountedAmount = Math.max(0, total - discount - bulk);
   const rate = line.vatRate ?? 0;
   const vat = discountedAmount * rate / 100;
   return Math.round(vat);
