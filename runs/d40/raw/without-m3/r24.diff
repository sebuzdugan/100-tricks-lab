+/**
+ * Get dashboard summary of invoices.
+ * @param {Array} invoices
+ * @param {string} asOf - Current date in YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  for (const inv of invoices) {
+    if (inv.status in counts) {
+      counts[inv.status]++;
+    }
+  }
+
+  let outstanding = 0;
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      outstanding += balanceDue(inv);
+    }
+  }
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueInfo = {
+    count: overdue.length,
+    amount: overdue.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const customerDueMap = new Map();
+  for (const inv of invoices) {
+    if (inv.status === 'issued' || inv.status === 'partially_paid') {
+      const due = balanceDue(inv);
+      if (due > 0) {
+        const current = customerDueMap.get(inv.customerId) || 0;
+        customerDueMap.set(inv.customerId, current + due);
+      }
+    }
+  }
+
+  const topCustomers = Array.from(customerDueMap.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: overdueInfo,
+    topCustomers,
+  };
+}
