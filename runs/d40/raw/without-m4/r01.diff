+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { createInvoice } from '../src/invoices.js';
+
+describe('createInvoice', () => {
+  test('creates a valid invoice with correct structure', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    });
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.issueDate, '2026-10-07');
+    assert.equal(result.value.status, 'draft');
+    assert.equal(result.value.lines.length, 1);
+
+    const line = result.value.lines[0];
+    assert.equal(line.sku, 'DES-HOUR');
+    assert.equal(line.qty, 2);
+    assert.equal(typeof line.name, 'string');
+    assert.equal(typeof line.unitPrice, 'number');
+    assert.equal(typeof line.vatRate, 'number');
+  });
+
+  test('includes catalogue data in lines', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert.equal(result.ok, true);
+    const line = result.value.lines[0];
+    assert.equal(line.name, 'Design work (hour)');
+    assert.equal(line.unitPrice, 8500);
+    assert.equal(line.vatRate, 21);
+  });
+
+  test('supports multiple lines', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [
+        { sku: 'DES-HOUR', qty: 2 },
+        { sku: 'DEV-HOUR', qty: 3 },
+      ],
+    });
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.lines.length, 2);
+  });
+
+  test('rejects unknown customer', () => {
+    const result = createInvoice({
+      customerId: 'UNKNOWN',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+  });
+
+  test('rejects malformed date', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '10/07/2026',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'DATE_INVALID');
+  });
+
+  test('rejects invalid date (Feb 30)', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-02-30',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'DATE_INVALID');
+  });
+
+  test('rejects invalid date (month 13)', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-13-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'DATE_INVALID');
+  });
+
+  test('rejects empty lines array', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NO_LINES');
+  });
+
+  test('rejects null lines', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: null,
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NO_LINES');
+  });
+
+  test('rejects non-integer quantity', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1.5 }],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'QTY_INVALID');
+  });
+
+  test('rejects zero quantity', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 0 }],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'QTY_INVALID');
+  });
+
+  test('rejects negative quantity', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: -1 }],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'QTY_INVALID');
+  });
+
+  test('rejects unknown SKU', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'NONEXISTENT', qty: 1 }],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'UNKNOWN_SKU');
+  });
+
+  test('stops validation at first SKU error', () => {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [
+        { sku: 'DES-HOUR', qty: 1 },
+        { sku: 'NONEXISTENT', qty: 1 },
+      ],
+    });
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'UNKNOWN_SKU');
+  });
+
+  test('does not mutate input', () => {
+    const lines = [{ sku: 'DES-HOUR', qty: 1 }];
+    const input = { customerId: 'C-001', issueDate: '2026-10-07', lines };
+
+    createInvoice(input);
+
+    assert.deepEqual(lines, [{ sku: 'DES-HOUR', qty: 1 }]);
+  });
+});
