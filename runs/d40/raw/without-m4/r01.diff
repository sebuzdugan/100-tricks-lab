+++ b/src/invoices.js
@@ -0,0 +1,64 @@
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+import { ok, fail } from './result.js';
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {{ ok: true, value: { customerId: string, issueDate: string, status: string, lines: Array } } | { ok: false, error: string }}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) return fail('CUSTOMER_NOT_FOUND');
+
+  // Validate issueDate format and validity
+  const dateRegex = /^(\d{4})-(\d{2})-(\d{2})$/;
+  const dateMatch = dateRegex.exec(issueDate);
+  if (!dateMatch) return fail('DATE_INVALID');
+
+  const [, year, month, day] = dateMatch;
+  const date = new Date(`${year}-${month}-${day}T00:00:00Z`);
+  if (isNaN(date.getTime())) return fail('DATE_INVALID');
+
+  // Verify date components match input (catches invalid dates like Feb 30)
+  if (
+    date.getUTCFullYear() !== Number(year) ||
+    date.getUTCMonth() + 1 !== Number(month) ||
+    date.getUTCDate() !== Number(day)
+  ) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines array is not empty
+  if (!lines || lines.length === 0) return fail('NO_LINES');
+
+  // Process and validate each line
+  const processedLines = [];
+  for (const line of lines) {
+    // Validate qty is a positive integer
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Validate SKU exists in catalogue
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) return fail('UNKNOWN_SKU');
+
+    const product = productResult.value;
+    processedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: processedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
