+describe('addLine', () => {
+  test('adds a new line to an invoice', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const result = addLine(invoice, { sku: 'DEV-HOUR', qty: 2 });
