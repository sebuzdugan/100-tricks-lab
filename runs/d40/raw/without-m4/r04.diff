+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+    invoice.status = 'issued';
+
+    const result = issueInvoice(invoice, []);
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NOT_DRAFT');
+  });
+
