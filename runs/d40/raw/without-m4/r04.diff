new file mode 100644
index 0000000..7e4abb0
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,24 @@
+/**
+ * Determine the next invoice number for a given issue date.
+ * Format: INV-<year>-<4-digit counter>
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (any order)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  const numbersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.slice(prefix.length);
+      return Number(counter);
+    })
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = numbersThisYear.length > 0 ? Math.max(...numbersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
