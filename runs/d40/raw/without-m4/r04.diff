diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..b9ae16b
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,54 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+describe('nextInvoiceNumber', () => {
+  test('generates first number for a year', () => {
+    const number = nextInvoiceNumber([], '2026-10-07');
+    assert.equal(number, 'INV-2026-0001');
+  });
+
+  test('increments counter when numbers exist', () => {
+    const existingNumbers = ['INV-2026-0001', 'INV-2026-0002'];
+    const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+    assert.equal(number, 'INV-2026-0003');
+  });
+
+  test('ignores numbers from other years', () => {
+    const existingNumbers = ['INV-2025-0001', 'INV-2025-0099', 'INV-2026-0001'];
+    const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+    assert.equal(number, 'INV-2026-0002');
+  });
+
+  test('finds max counter regardless of order', () => {
+    const existingNumbers = ['INV-2026-0005', 'INV-2026-0001', 'INV-2026-0003'];
+    const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+    assert.equal(number, 'INV-2026-0006');
+  });
+
+  test('pads counter to 4 digits', () => {
+    const existingNumbers = [];
+    const number = nextInvoiceNumber(existingNumbers, '2025-03-15');
+    assert.equal(number, 'INV-2025-0001');
+  });
+
+  test('handles 9999 counter', () => {
+    const existingNumbers = ['INV-2026-9999'];
+    const number = nextInvoiceNumber(existingNumbers, '2026-12-31');
+    assert.equal(number, 'INV-2026-10000');
+  });
+
+  test('extracts year correctly from date', () => {
+    const existingNumbers = [];
+    const number1 = nextInvoiceNumber(existingNumbers, '2025-01-01');
+    const number2 = nextInvoiceNumber(existingNumbers, '2027-12-31');
+    assert.equal(number1, 'INV-2025-0001');
+    assert.equal(number2, 'INV-2027-0001');
+  });
+
+  test('ignores invalid numbers in existingNumbers', () => {
+    const existingNumbers = ['INV-2026-0001', 'INVALID', 'INV-2026-ABC', 'INV-2026-0003'];
+    const number = nextInvoiceNumber(existingNumbers, '2026-10-07');
+    assert.equal(number, 'INV-2026-0004');
+  });
+});
