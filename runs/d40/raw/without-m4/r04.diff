+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-06-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const existingNumbers = ['INV-2025-0005'];
+    const result = issueInvoice(invoice, existingNumbers);
