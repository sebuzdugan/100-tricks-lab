+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+describe('renderInvoiceText', () => {
+  test('renders draft invoice with DRAFT label', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    assert.equal(lines[0], 'DRAFT');
+  });
+
+  test('renders issued invoice with invoice number', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(invoice, []).value;
+    const text = renderInvoiceText(issued);
+    const lines = text.split('\n');
+
+    assert.equal(lines[0], 'INV-2026-0001');
+  });
+
+  test('includes customer name', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    assert.equal(lines[1], 'Northwind Studio');
+  });
+
+  test('formats single line with qty, name, unit price and total', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    }).value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    // Second line after number and customer
+    assert.equal(lines[2], '2x Design work (hour) @ €85.00 = €170.00');
+  });
+
+  test('formats multiple lines', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [
+        { sku: 'DES-HOUR', qty: 1 },
+        { sku: 'DEV-HOUR', qty: 2 },
+      ],
+    }).value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    assert.equal(lines[2], '1x Design work (hour) @ €85.00 = €85.00');
+    assert.equal(lines[3], '2x Development (hour) @ €95.00 = €190.00');
+  });
+
+  test('includes total line', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 2 }],
+    }).value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    assert.equal(lines[lines.length - 1], 'Total: €170.00');
+  });
+
+  test('calculates correct total for multiple lines', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [
+        { sku: 'DES-HOUR', qty: 2 },
+        { sku: 'DEV-HOUR', qty: 1 },
+      ],
+    }).value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    assert.equal(lines[lines.length - 1], 'Total: €265.00');
+  });
+
+  test('has correct line count', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [
+        { sku: 'DES-HOUR', qty: 1 },
+        { sku: 'DEV-HOUR', qty: 1 },
+        { sku: 'COPY-HOUR', qty: 1 },
+      ],
+    }).value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    // number + customer + 3 lines + total = 6 lines
+    assert.equal(lines.length, 6);
+  });
+
+  test('handles large quantities', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 100 }],
+    }).value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    assert.equal(lines[2], '100x Design work (hour) @ €85.00 = €8,500.00');
+  });
+
+  test('handles expensive items with VAT-exempt prices', () => {
+    const invoice = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'WORKSHOP-DAY', qty: 1 }],
+    }).value;
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    assert.equal(lines[2], '1x Brand workshop (day, VAT exempt) @ €600.00 = €600.00');
+    assert.equal(lines[lines.length - 1], 'Total: €600.00');
+  });
+
+  test('renders issued invoice with all data preserved', () => {
+    const invoice = createInvoice({
+      customerId: 'C-002',
+      issueDate: '2025-03-15',
+      lines: [{ sku: 'DEV-HOUR', qty: 5 }],
+    }).value;
+
+    const issued = issueInvoice(invoice, ['INV-2025-0001']).value;
+    const text = renderInvoiceText(issued);
+    const lines = text.split('\n');
+
+    assert.equal(lines[0], 'INV-2025-0002');
+    assert.equal(lines[1], 'Blue Fern Bakery');
+    assert.equal(lines[2], '5x Development (hour) @ €95.00 = €475.00');
+    assert.equal(lines[3], 'Total: €475.00');
+  });
+
+  test('handles unknown customer gracefully', () => {
+    const invoice = {
+      customerId: 'UNKNOWN-CUSTOMER',
+      issueDate: '2026-10-07',
+      status: 'draft',
+      lines: [
+        {
+          sku: 'DES-HOUR',
+          name: 'Design work (hour)',
+          qty: 1,
+          unitPrice: 8500,
+          vatRate: 21,
+        },
+      ],
+    };
+
+    const text = renderInvoiceText(invoice);
+    const lines = text.split('\n');
+
+    assert.equal(lines[1], 'Unknown Customer');
+  });
+});
