+import { getCustomer } from './customers.js';
+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text for display to customers.
+ * @param {object} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  const numberLine = invoice.number ? invoice.number : 'DRAFT';
+  const customerLine = customerName;
+
+  const lineTexts = invoice.lines.map((line) => {
+    const total = lineTotal(line);
+    return `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
+  });
+
+  const totals = invoiceTotals(invoice);
+  const totalLine = `Total: ${formatEuros(totals.total)}`;
+
+  const allLines = [numberLine, customerLine, ...lineTexts, totalLine];
+  return allLines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
