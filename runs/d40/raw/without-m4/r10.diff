diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..f46eb3f
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,138 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+describe('isValidDate', () => {
+  test('accepts valid dates', () => {
+    assert.equal(isValidDate('2026-10-07'), true);
+    assert.equal(isValidDate('2026-01-01'), true);
+    assert.equal(isValidDate('2026-12-31'), true);
+  });
+
+  test('rejects malformed dates', () => {
+    assert.equal(isValidDate('10/07/2026'), false);
+    assert.equal(isValidDate('2026/10/07'), false);
+    assert.equal(isValidDate('2026-10-7'), false);
+    assert.equal(isValidDate('2026-1-07'), false);
+    assert.equal(isValidDate('not-a-date'), false);
+  });
+
+  test('rejects invalid month (13)', () => {
+    assert.equal(isValidDate('2026-13-01'), false);
+  });
+
+  test('rejects invalid day (32)', () => {
+    assert.equal(isValidDate('2026-01-32'), false);
+  });
+
+  test('rejects Feb 30', () => {
+    assert.equal(isValidDate('2026-02-30'), false);
+  });
+
+  test('accepts leap day in leap year', () => {
+    assert.equal(isValidDate('2024-02-29'), true);
+  });
+
+  test('rejects Feb 29 in non-leap year', () => {
+    assert.equal(isValidDate('2026-02-29'), false);
+  });
+
+  test('rejects empty string', () => {
+    assert.equal(isValidDate(''), false);
+  });
+
+  test('rejects null-like strings', () => {
+    assert.equal(isValidDate('null'), false);
+  });
+});
+
+describe('addDays', () => {
+  test('adds positive days', () => {
+    assert.equal(addDays('2026-10-07', 1), '2026-10-08');
+    assert.equal(addDays('2026-10-07', 10), '2026-10-17');
+  });
+
+  test('adds zero days', () => {
+    assert.equal(addDays('2026-10-07', 0), '2026-10-07');
+  });
+
+  test('subtracts days with negative number', () => {
+    assert.equal(addDays('2026-10-07', -1), '2026-10-06');
+    assert.equal(addDays('2026-10-07', -10), '2026-09-27');
+  });
+
+  test('handles month boundaries', () => {
+    assert.equal(addDays('2026-10-31', 1), '2026-11-01');
+    assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  });
+
+  test('handles year boundaries', () => {
+    assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+    assert.equal(addDays('2026-01-01', -1), '2025-12-31');
+  });
+
+  test('handles leap year correctly', () => {
+    assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+    assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  });
+
+  test('formats output with zero padding', () => {
+    assert.equal(addDays('2026-10-07', 100).length, 10);
+    assert.equal(addDays('2026-01-01', 1), '2026-01-02');
+  });
+
+  test('handles large day additions', () => {
+    assert.equal(addDays('2026-01-01', 365), '2027-01-01');
+  });
+});
+
+describe('daysBetween', () => {
+  test('calculates days between same date as zero', () => {
+    assert.equal(daysBetween('2026-10-07', '2026-10-07'), 0);
+  });
+
+  test('calculates days between consecutive dates', () => {
+    assert.equal(daysBetween('2026-10-07', '2026-10-08'), 1);
+    assert.equal(daysBetween('2026-10-07', '2026-10-06'), -1);
+  });
+
+  test('calculates days between dates in same month', () => {
+    assert.equal(daysBetween('2026-10-07', '2026-10-17'), 10);
+    assert.equal(daysBetween('2026-10-17', '2026-10-07'), -10);
+  });
+
+  test('calculates days between dates in different months', () => {
+    assert.equal(daysBetween('2026-10-31', '2026-11-01'), 1);
+    assert.equal(daysBetween('2026-11-01', '2026-10-31'), -1);
+  });
+
+  test('calculates days between dates in different years', () => {
+    assert.equal(daysBetween('2025-12-31', '2026-01-01'), 1);
+    assert.equal(daysBetween('2026-01-01', '2025-12-31'), -1);
+  });
+
+  test('calculates large day differences', () => {
+    assert.equal(daysBetween('2026-01-01', '2027-01-01'), 365);
+    assert.equal(daysBetween('2026-01-01', '2026-12-31'), 364);
+  });
+
+  test('calculates days across leap day', () => {
+    assert.equal(daysBetween('2024-02-28', '2024-03-01'), 2);
+    assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  });
+
+  test('returns whole days (floors)', () => {
+    // daysBetween should always return whole days
+    assert.equal(daysBetween('2026-01-01', '2026-01-02'), 1);
+    assert.equal(daysBetween('2026-01-01', '2026-01-03'), 2);
+  });
+
+  test('is the inverse of addDays', () => {
+    const base = '2026-10-07';
+    const future = addDays(base, 15);
+    assert.equal(daysBetween(base, future), 15);
+
+    const past = addDays(base, -20);
+    assert.equal(daysBetween(base, past), -20);
+  });
+});
