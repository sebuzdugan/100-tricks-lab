+/**
+ * Check if text is a valid date in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  const dateRegex = /^(\d{4})-(\d{2})-(\d{2})$/;
+  const match = dateRegex.exec(text);
+  if (!match) return false;
+
+  const [, year, month, day] = match;
+  const date = new Date(`${year}-${month}-${day}T00:00:00Z`);
+  if (isNaN(date.getTime())) return false;
+
+  // Verify date components match input (catches invalid dates like Feb 30)
+  if (
+    date.getUTCFullYear() !== Number(year) ||
+    date.getUTCMonth() + 1 !== Number(month) ||
+    date.getUTCDate() !== Number(day)
+  ) {
+    return false;
+  }
+
+  return true;
+}
+
+/**
+ * Add n days to a date string, returning YYYY-MM-DD in UTC.
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @param {number} n - Number of days to add
+ * @returns {string} - Date in YYYY-MM-DD format
+ */
+export function addDays(dateStr, n) {
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  date.setUTCDate(date.getUTCDate() + n);
+
+  const year = date.getUTCFullYear();
+  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
+  const day = String(date.getUTCDate()).padStart(2, '0');
+  return `${year}-${month}-${day}`;
+}
+
+/**
+ * Calculate days between two dates (b - a) as whole days in UTC.
+ * @param {string} dateA - Date in YYYY-MM-DD format
+ * @param {string} dateB - Date in YYYY-MM-DD format
+ * @returns {number} - Number of whole days (dateB - dateA)
+ */
+export function daysBetween(dateA, dateB) {
+  const a = new Date(`${dateA}T00:00:00Z`);
+  const b = new Date(`${dateB}T00:00:00Z`);
+  const diffMs = b.getTime() - a.getTime();
+  const diffDays = diffMs / (1000 * 60 * 60 * 24);
+  return Math.floor(diffDays);
+}
