+import { strict as assert } from 'node:assert';
+import { describe, it } from 'node:test';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { invoiceTotals } from '../src/invoices.js';
+
+describe('balanceDue', () => {
+  it('returns the full total when no payments recorded', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+    };
+    const { total } = invoiceTotals(invoice);
+    assert.equal(balanceDue(invoice), total);
+  });
+
+  it('returns 0 when invoice is fully paid', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'paid',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+      payments: [
+        { amount: 2400, date: '2024-01-05' },
+      ],
+    };
+    assert.equal(balanceDue(invoice), 0);
+  });
+
+  it('returns the remaining balance after partial payment', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'partially_paid',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+      payments: [
+        { amount: 1000, date: '2024-01-05' },
+      ],
+    };
+    const { total } = invoiceTotals(invoice);
+    assert.equal(balanceDue(invoice), total - 1000);
+  });
+});
+
+describe('recordPayment', () => {
+  it('records a payment on an issued invoice', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+    };
+    const result = recordPayment(invoice, { amount: 1000, date: '2024-01-05' });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.payments.length, 1);
+    assert.equal(result.value.payments[0].amount, 1000);
+    assert.equal(result.value.payments[0].date, '2024-01-05');
+    assert.equal(result.value.status, 'partially_paid');
+  });
+
+  it('marks invoice as paid when payment covers the total', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+    };
+    const { total } = invoiceTotals(invoice);
+    const result = recordPayment(invoice, { amount: total, date: '2024-01-05' });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.status, 'paid');
+  });
+
+  it('records multiple payments', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+    };
+    const { total } = invoiceTotals(invoice);
+
+    let result = recordPayment(invoice, { amount: 1000, date: '2024-01-05' });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.status, 'partially_paid');
+
+    result = recordPayment(result.value, { amount: total - 1000, date: '2024-01-06' });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.payments.length, 2);
+    assert.equal(result.value.status, 'paid');
+  });
+
+  it('rejects payment on draft invoice', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'draft',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+    };
+    const result = recordPayment(invoice, { amount: 1000, date: '2024-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NOT_ISSUED');
+  });
+
+  it('rejects non-integer amount', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+    };
+    const result = recordPayment(invoice, { amount: 1000.5, date: '2024-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects zero or negative amount', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+    };
+
+    let result = recordPayment(invoice, { amount: 0, date: '2024-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+
+    result = recordPayment(invoice, { amount: -100, date: '2024-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects overpayment', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+    };
+    const { total } = invoiceTotals(invoice);
+    const result = recordPayment(invoice, { amount: total + 1, date: '2024-01-05' });
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'OVERPAYMENT');
+  });
+
+  it('accepts payment on partially_paid invoice', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'partially_paid',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 2,
+          unitPrice: 1000,
+          vatRate: 20,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+      payments: [{ amount: 1000, date: '2024-01-05' }],
+    };
+    const { total } = invoiceTotals(invoice);
+    const remaining = total - 1000;
+    const result = recordPayment(invoice, { amount: remaining, date: '2024-01-06' });
+    assert.equal(result.ok, true);
+    assert.equal(result.value.status, 'paid');
+  });
+
+  it('creates payments array if missing', () => {
+    const invoice = {
+      customerId: 'CUST1',
+      issueDate: '2024-01-01',
+      status: 'issued',
+      lines: [
+        {
+          sku: 'WIDGET',
+          name: 'Widget',
+          qty: 1,
+          unitPrice: 1000,
+          vatRate: 0,
+          discountPercent: 0,
+        },
+      ],
+      number: 'INV-2024-0001',
+    };
+    const result = recordPayment(invoice, { amount: 500, date: '2024-01-05' });
+    assert.equal(result.ok, true);
+    assert(Array.isArray(result.value.payments));
+    assert.equal(result.value.payments.length, 1);
+  });
+});
