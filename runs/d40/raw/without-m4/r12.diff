+/**
+ * Calculate the last day of the month for a given date, returning YYYY-MM-DD in UTC.
+ * @param {string} dateStr - Date in YYYY-MM-DD format
+ * @returns {string} - Last day of month in YYYY-MM-DD format
+ */
+export function endOfMonth(dateStr) {
+  const date = new Date(`${dateStr}T00:00:00Z`);
+  const year = date.getUTCFullYear();
+  const month = date.getUTCMonth();
+
+  const lastDay = new Date(Date.UTC(year, month + 1, 0));
+
+  const yearStr = lastDay.getUTCFullYear();
+  const monthStr = String(lastDay.getUTCMonth() + 1).padStart(2, '0');
+  const dayStr = String(lastDay.getUTCDate()).padStart(2, '0');
+  return `${yearStr}-${monthStr}-${dayStr}`;
+}
