+import { strict as assert } from 'node:assert';
+import { describe, it } from 'node:test';
+import { statement } from '../src/statements.js';
+import { createInvoice, invoiceTotals } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+describe('statement', () => {
+  it('returns customer statement with issued invoices', () => {
+    const inv1 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued1 = issueInvoice(inv1, []).value;
+
+    const result = statement('C-001', [issued1], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+    assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+  });
+
+  it('includes invoice due amount from balanceDue', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = statement('C-001', [issued], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    const invoice = result.value.invoices[0];
+    assert.equal(typeof invoice.total, 'number');
+    assert.equal(typeof invoice.due, 'number');
+    assert.equal(invoice.due, invoice.total);
+  });
+
+  it('shows reduced due after payment', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    let issued = issueInvoice(inv, []).value;
+    const { total } = invoiceTotals(issued);
+
+    const paymentResult = recordPayment(issued, {
+      amount: 5000,
+      date: '2026-10-10',
+    });
+    issued = paymentResult.value;
+
+    const result = statement('C-001', [issued], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    const invoice = result.value.invoices[0];
+    assert.equal(invoice.total, total);
+    assert.equal(invoice.due, total - 5000);
+  });
+
+  it('filters by issueDate cutoff (asOf)', () => {
+    const inv1 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const inv2 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-11-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued1 = issueInvoice(inv1, []).value;
+    const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+    const result = statement('C-001', [issued1, issued2], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  });
+
+  it('includes invoices on the exact asOf date', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = statement('C-001', [issued], '2026-10-15');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+  });
+
+  it('excludes invoices after the asOf date', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-16',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = statement('C-001', [issued], '2026-10-15');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 0);
+  });
+
+  it('excludes draft invoices', () => {
+    const draft = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const result = statement('C-001', [draft], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 0);
+  });
+
+  it('includes partially_paid invoices', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    let issued = issueInvoice(inv, []).value;
+    const partial = recordPayment(issued, {
+      amount: 5000,
+      date: '2026-10-10',
+    }).value;
+
+    const result = statement('C-001', [partial], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+  });
+
+  it('excludes paid invoices', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    let issued = issueInvoice(inv, []).value;
+    const { total } = invoiceTotals(issued);
+
+    const paid = recordPayment(issued, {
+      amount: total,
+      date: '2026-10-10',
+    }).value;
+
+    const result = statement('C-001', [paid], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 0);
+  });
+
+  it('sorts invoices by issueDate', () => {
+    const inv3 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-03',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const inv1 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const inv2 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-02',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued1 = issueInvoice(inv1, []).value;
+    const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+    const issued3 = issueInvoice(inv3, ['INV-2026-0001', 'INV-2026-0002']).value;
+
+    const result = statement('C-001', [issued3, issued1, issued2], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 3);
+    assert.equal(result.value.invoices[0].issueDate, '2026-10-01');
+    assert.equal(result.value.invoices[1].issueDate, '2026-10-02');
+    assert.equal(result.value.invoices[2].issueDate, '2026-10-03');
+  });
+
+  it('calculates total due as sum of all due amounts', () => {
+    const inv1 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const inv2 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-02',
+      lines: [{ sku: 'DEV-HOUR', qty: 1 }],
+    }).value;
+
+    let issued1 = issueInvoice(inv1, []).value;
+    let issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+    issued1 = recordPayment(issued1, { amount: 4000, date: '2026-10-05' }).value;
+
+    const result = statement('C-001', [issued1, issued2], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    const due1 = result.value.invoices[0].due;
+    const due2 = result.value.invoices[1].due;
+    assert.equal(result.value.totalDue, due1 + due2);
+  });
+
+  it('normalizes customer ID', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = statement(' c-001 ', [issued], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.invoices.length, 1);
+  });
+
+  it('rejects unknown customer', () => {
+    const result = statement('UNKNOWN', [], '2026-10-31');
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'CUSTOMER_NOT_FOUND');
+  });
+
+  it('returns empty invoices for customer with no matching invoices', () => {
+    const result = statement('C-001', [], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 0);
+    assert.equal(result.value.totalDue, 0);
+  });
+
+  it('includes dueDate in invoice data', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+      terms: 'NET14',
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = statement('C-001', [issued], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices[0].dueDate, '2026-10-15');
+  });
+
+  it('filters by customer, ignoring other customers invoices', () => {
+    const inv1 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const inv2 = createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-01',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued1 = issueInvoice(inv1, []).value;
+    const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+    const result = statement('C-001', [issued1, issued2], '2026-10-31');
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoices.length, 1);
+    assert.equal(result.value.invoices[0].number, 'INV-2026-0001');
+  });
+});
