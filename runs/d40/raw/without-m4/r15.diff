+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Determine the next credit note number for a given date.
+ * Format: CN-<year>-<4-digit counter>
+ * @param {string[]} existingNumbers - Array of invoice and credit note numbers already used (any order)
+ * @param {string} date - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+function nextCreditNoteNumber(existingNumbers, date) {
+  const year = date.split('-')[0];
+  const prefix = `CN-${year}-`;
+
+  const numbersThisYear = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => {
+      const counter = num.slice(prefix.length);
+      return Number(counter);
+    })
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = numbersThisYear.length > 0 ? Math.max(...numbersThisYear) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
+
+/**
+ * Create a credit note for an invoice.
+ * @param {object} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNoteData
+ * @param {string[]} existingNumbers - Array of invoice and credit note numbers already used
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  if (invoice.status === 'draft') return fail('NOT_ISSUED');
+
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  const { total } = invoiceTotals(invoice);
+  if (amount > total) return fail('CREDIT_TOO_HIGH');
+
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
