@@ -0,0 +1,352 @@
+import { strict as assert } from 'node:assert';
+import { describe, it } from 'node:test';
+import { createCreditNote } from '../src/credits.js';
+import { createInvoice, invoiceTotals } from '../src/invoices.js';
+import { issueInvoice } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+describe('createCreditNote', () => {
+  it('creates a credit note for an issued invoice', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+    const { total } = invoiceTotals(issued);
+
+    const result = createCreditNote(
+      issued,
+      { amount: 1000, reason: 'Partial refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0001');
+    assert.equal(result.value.invoiceNumber, 'INV-2026-0001');
+    assert.equal(result.value.customerId, 'C-001');
+    assert.equal(result.value.amount, 1000);
+    assert.equal(result.value.reason, 'Partial refund');
+    assert.equal(result.value.date, '2026-10-15');
+  });
+
+  it('rejects credit note on draft invoice', () => {
+    const draft = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const result = createCreditNote(
+      draft,
+      { amount: 1000, reason: 'Refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'NOT_ISSUED');
+  });
+
+  it('accepts credit note on partially_paid invoice', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    let issued = issueInvoice(inv, []).value;
+    const partial = recordPayment(issued, {
+      amount: 5000,
+      date: '2026-10-10',
+    }).value;
+
+    const result = createCreditNote(
+      partial,
+      { amount: 1000, reason: 'Refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0001');
+  });
+
+  it('accepts credit note on paid invoice', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    let issued = issueInvoice(inv, []).value;
+    const { total } = invoiceTotals(issued);
+    const paid = recordPayment(issued, {
+      amount: total,
+      date: '2026-10-10',
+    }).value;
+
+    const result = createCreditNote(
+      paid,
+      { amount: 1000, reason: 'Refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0001');
+  });
+
+  it('rejects non-integer amount', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = createCreditNote(
+      issued,
+      { amount: 1000.5, reason: 'Refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects zero amount', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = createCreditNote(
+      issued,
+      { amount: 0, reason: 'Refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects negative amount', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = createCreditNote(
+      issued,
+      { amount: -1000, reason: 'Refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'AMOUNT_INVALID');
+  });
+
+  it('rejects credit amount exceeding invoice total', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+    const { total } = invoiceTotals(issued);
+
+    const result = createCreditNote(
+      issued,
+      { amount: total + 1, reason: 'Refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, false);
+    assert.equal(result.error, 'CREDIT_TOO_HIGH');
+  });
+
+  it('accepts credit note equal to invoice total', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+    const { total } = invoiceTotals(issued);
+
+    const result = createCreditNote(
+      issued,
+      { amount: total, reason: 'Full refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, true);
+  });
+
+  it('uses separate numbering from invoices', () => {
+    const inv1 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const inv2 = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-08',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued1 = issueInvoice(inv1, []).value;
+    const issued2 = issueInvoice(inv2, ['INV-2026-0001']).value;
+
+    const creditResult1 = createCreditNote(
+      issued1,
+      { amount: 1000, reason: 'Refund', date: '2026-10-15' },
+      ['INV-2026-0001', 'INV-2026-0002']
+    );
+
+    const creditResult2 = createCreditNote(
+      issued2,
+      { amount: 1000, reason: 'Refund', date: '2026-10-15' },
+      ['INV-2026-0001', 'INV-2026-0002', 'CN-2026-0001']
+    );
+
+    assert.equal(creditResult1.ok, true);
+    assert.equal(creditResult1.value.number, 'CN-2026-0001');
+    assert.equal(creditResult2.ok, true);
+    assert.equal(creditResult2.value.number, 'CN-2026-0002');
+  });
+
+  it('handles multiple credit notes in same year', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = createCreditNote(
+      issued,
+      { amount: 1000, reason: 'Refund', date: '2026-10-15' },
+      ['CN-2026-0001', 'CN-2026-0002', 'CN-2026-0005']
+    );
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0006');
+  });
+
+  it('uses year from credit note date, not invoice date', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = createCreditNote(
+      issued,
+      { amount: 1000, reason: 'Refund', date: '2027-02-15' },
+      []
+    );
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2027-0001');
+  });
+
+  it('handles mixed invoice and credit note numbers', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+
+    const result = createCreditNote(
+      issued,
+      { amount: 1000, reason: 'Refund', date: '2026-10-15' },
+      ['INV-2026-0001', 'CN-2026-0001', 'INV-2026-0002', 'CN-2026-0002']
+    );
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.number, 'CN-2026-0003');
+  });
+
+  it('preserves invoice data in credit note', () => {
+    const inv = createInvoice({
+      customerId: 'C-002',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, ['INV-2026-0001']).value;
+
+    const result = createCreditNote(
+      issued,
+      { amount: 5000, reason: 'Service issue', date: '2026-10-20' },
+      ['INV-2026-0001', 'INV-2026-0002']
+    );
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.invoiceNumber, 'INV-2026-0002');
+    assert.equal(result.value.customerId, 'C-002');
+  });
+
+  it('accepts credit note on invoice with discount and VAT', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [
+        {
+          sku: 'DES-HOUR',
+          qty: 2,
+          discountPercent: 10,
+        },
+      ],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+    const { total } = invoiceTotals(issued);
+
+    const creditAmount = Math.floor(total * 0.5);
+    const result = createCreditNote(
+      issued,
+      { amount: creditAmount, reason: 'Partial refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(result.ok, true);
+    assert.equal(result.value.amount, creditAmount);
+  });
+
+  it('does not mutate the input invoice', () => {
+    const inv = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2026-10-07',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    }).value;
+
+    const issued = issueInvoice(inv, []).value;
+    const originalStatus = issued.status;
+    const originalNumber = issued.number;
+
+    createCreditNote(
+      issued,
+      { amount: 1000, reason: 'Refund', date: '2026-10-15' },
+      []
+    );
+
+    assert.equal(issued.status, originalStatus);
+    assert.equal(issued.number, originalNumber);
+  });
+});
