+++ b/test/reports.test.js
@@ -0,0 +1,170 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices: returns empty array when no invoices', () => {
+  const result = overdueInvoices([], '2025-01-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: excludes draft invoices', () => {
+  const invoices = [
+    { number: '001', customerId: 'CUST1', dueDate: '2025-01-01', status: 'draft', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: excludes paid invoices', () => {
+  const invoices = [
+    { number: '001', customerId: 'CUST1', dueDate: '2025-01-01', status: 'paid', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.deepEqual(result, []);
+});
+
+test('overdueInvoices: includes issued invoices with due date before asOf', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerId: 'CUST1',
+      dueDate: '2025-01-01',
+      status: 'issued',
+      lines: [],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, '001');
+  assert.equal(result[0].daysOverdue, 14);
+});
+
+test('overdueInvoices: includes partially_paid invoices with due date before asOf', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerId: 'CUST1',
+      dueDate: '2025-01-01',
+      status: 'partially_paid',
+      lines: [],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].number, '001');
+});
+
+test('overdueInvoices: excludes invoices with due date on or after asOf', () => {
+  const invoices = [
+    { number: '001', customerId: 'CUST1', dueDate: '2025-01-15', status: 'issued', lines: [] },
+    { number: '002', customerId: 'CUST1', dueDate: '2025-01-16', status: 'issued', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices: sorts by most overdue first', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerId: 'CUST1',
+      dueDate: '2025-01-01',
+      status: 'issued',
+      lines: [],
+    },
+    {
+      number: '002',
+      customerId: 'CUST1',
+      dueDate: '2025-01-10',
+      status: 'issued',
+      lines: [],
+    },
+    {
+      number: '003',
+      customerId: 'CUST1',
+      dueDate: '2025-01-05',
+      status: 'issued',
+      lines: [],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.equal(result.length, 3);
+  assert.equal(result[0].number, '001');
+  assert.equal(result[0].daysOverdue, 14);
+  assert.equal(result[1].number, '003');
+  assert.equal(result[1].daysOverdue, 10);
+  assert.equal(result[2].number, '002');
+  assert.equal(result[2].daysOverdue, 5);
+});
+
+test('overdueInvoices: calculates due amount using balanceDue', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerId: 'CUST1',
+      dueDate: '2025-01-01',
+      status: 'issued',
+      lines: [{ qty: 2, unitPrice: 5000, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 10000); // 2 * 5000, no payments
+});
+
+test('overdueInvoices: calculates due amount correctly for partially_paid invoices', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerId: 'CUST1',
+      dueDate: '2025-01-01',
+      status: 'partially_paid',
+      lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+      payments: [{ amount: 3000, date: '2025-01-10' }],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.equal(result.length, 1);
+  assert.equal(result[0].due, 7000); // 10000 - 3000 paid
+});
+
+test('overdueInvoices: includes customerId in result', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerId: 'ABC123',
+      dueDate: '2025-01-01',
+      status: 'issued',
+      lines: [],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.equal(result[0].customerId, 'ABC123');
+});
+
+test('overdueInvoices: includes dueDate in result', () => {
+  const invoices = [
+    {
+      number: '001',
+      customerId: 'CUST1',
+      dueDate: '2025-01-05',
+      status: 'issued',
+      lines: [],
+    },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.equal(result[0].dueDate, '2025-01-05');
+});
+
+test('overdueInvoices: handles mixed statuses correctly', () => {
+  const invoices = [
+    { number: '001', customerId: 'CUST1', dueDate: '2025-01-01', status: 'draft', lines: [] },
+    { number: '002', customerId: 'CUST1', dueDate: '2025-01-01', status: 'issued', lines: [] },
+    { number: '003', customerId: 'CUST1', dueDate: '2025-01-01', status: 'partially_paid', lines: [] },
+    { number: '004', customerId: 'CUST1', dueDate: '2025-01-01', status: 'paid', lines: [] },
+  ];
+  const result = overdueInvoices(invoices, '2025-01-15');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, '002');
+  assert.equal(result[1].number, '003');
+});
