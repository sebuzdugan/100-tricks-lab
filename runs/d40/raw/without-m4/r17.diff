+/**
+ * Get a summary of VAT by rate for invoices with status issued, partially_paid, or paid.
+ * @param {Array<object>} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>}
+ */
+export function vatSummary(invoices) {
+  const vatMap = new Map();
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const vatRate = line.vatRate ?? 0;
+      const total = line.qty * line.unitPrice;
+      const discount = lineDiscount(line);
+      const base = total - discount;
+      const vat = lineVAT(line);
+
+      if (!vatMap.has(vatRate)) {
+        vatMap.set(vatRate, { rate: vatRate, base: 0, vat: 0 });
+      }
+
+      const entry = vatMap.get(vatRate);
+      entry.base += base;
+      entry.vat += vat;
+    }
+  }
+
+  return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
+}
