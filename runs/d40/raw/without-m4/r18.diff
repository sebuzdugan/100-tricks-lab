 import { lineDiscount, lineVAT } from './invoices.js';
+import { roundCents } from './money.js';
 
 /**
  * Get all overdue invoices (issued or partially_paid with dueDate before asOf).
@@ -53,3 +54,20 @@ export function vatSummary(invoices) {
 
   return Array.from(vatMap.values()).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fee for an overdue invoice: 0.04% per day of the amount still due.
+ * @param {object} invoice
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {number} - Late fee in cents, or 0 if not overdue
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const due = balanceDue(invoice);
+  const fee = due * 0.0004 * daysOverdue;
+  return roundCents(fee);
+}
