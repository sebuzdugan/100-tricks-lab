+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Escape a CSV field: wrap in quotes if it contains comma or quote, and double any quotes inside.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  const fieldStr = String(field);
+  if (fieldStr.includes(',') || fieldStr.includes('"')) {
+    return `"${fieldStr.replace(/"/g, '""')}"`;
+  }
+  return fieldStr;
+}
+
+/**
+ * Format cents as euros: 1234 -> "12.34"
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuros(cents) {
+  return (cents / 100).toFixed(2);
+}
+
+/**
+ * Export invoices as CSV.
+ * @param {Array<object>} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  for (const invoice of invoices) {
+    const customerResult = getCustomer(invoice.customerId);
+    const customerName = customerResult.ok ? customerResult.value.name : '';
+
+    const totals = invoiceTotals(invoice);
+    const due = balanceDue(invoice);
+
+    const fields = [
+      invoice.number,
+      customerName,
+      invoice.issueDate,
+      invoice.dueDate,
+      invoice.status,
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    lines.push(fields.map(escapeCsvField).join(','));
+  }
+
+  return lines.join('\n') + '\n';
+}
