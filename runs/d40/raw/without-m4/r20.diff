+
+test('RATES has correct values', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert: EUR to USD (10000 EUR cents * 1.085)', () => {
+  const result = convert(10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10850);
+});
+
+test('convert: EUR to GBP (10000 EUR cents * 0.8425)', () => {
+  const result = convert(10000, 'GBP');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 8425);
+});
+
+test('convert: EUR to EUR (identity)', () => {
+  const result = convert(10000, 'EUR');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10000);
+});
+
+test('convert: returns error for unknown currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'UNKNOWN_CURRENCY');
+});
+
+test('convert: zero amount', () => {
+  const result = convert(0, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 0);
+});
+
+test('convert: negative amounts', () => {
+  const result = convert(-10000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, -10850);
+});
+
+test('convert: rounds to nearest cent', () => {
+  // 1 cent * 1.085 = 1.085 cents -> rounds to 1
+  const result1 = convert(1, 'USD');
+  assert.equal(result1.value, 1);
+  // 3 cents * 1.085 = 3.255 -> rounds to 3
+  const result2 = convert(3, 'USD');
+  assert.equal(result2.value, 3);
+  // 5 cents * 0.8425 = 4.2125 -> rounds to 4
+  const result3 = convert(5, 'GBP');
+  assert.equal(result3.value, 4);
+});
+
+test('convert: large amounts', () => {
+  // 100,000 EUR to USD
+  const result = convert(10000000, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 10850000);
+});
+
+test('convert: case-sensitive currency codes', () => {
+  const result = convert(10000, 'usd');
+  assert.equal(result.ok, false);
+});
+
+test('formatMoney: USD with $ symbol', () => {
+  assert.equal(formatMoney(123456, 'USD'), '$1,234.56');
+  assert.equal(formatMoney(5, 'USD'), '$0.05');
+  assert.equal(formatMoney(0, 'USD'), '$0.00');
+});
+
+test('formatMoney: GBP with £ symbol', () => {
+  assert.equal(formatMoney(123456, 'GBP'), '£1,234.56');
+  assert.equal(formatMoney(5, 'GBP'), '£0.05');
+});
+
+test('formatMoney: EUR with € symbol', () => {
+  assert.equal(formatMoney(123456, 'EUR'), '€1,234.56');
+});
+
+test('formatMoney: negative amounts', () => {
+  assert.equal(formatMoney(-5000, 'USD'), '-$50.00');
+  assert.equal(formatMoney(-5000, 'GBP'), '-£50.00');
+  assert.equal(formatMoney(-5000, 'EUR'), '-€50.00');
+});
+
+test('formatMoney: thousands separators', () => {
+  assert.equal(formatMoney(1000000, 'USD'), '$10,000.00');
+  assert.equal(formatMoney(100000000, 'USD'), '$1,000,000.00');
+});
+
+test('formatMoney: unknown currency', () => {
+  assert.equal(formatMoney(123456, 'JPY'), '?1,234.56');
+});
+
+test('convert and formatMoney: round-trip conversions', () => {
+  const usd = convert(10000, 'USD');
+  assert.equal(formatMoney(usd.value, 'USD'), '$108.50');
+  const gbp = convert(10000, 'GBP');
+  assert.equal(formatMoney(gbp.value, 'GBP'), '£84.25');
+});
