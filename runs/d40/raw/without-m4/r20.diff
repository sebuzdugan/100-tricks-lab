 test('roundCents rounds half to even', () => {
   assert.equal(roundCents(124.5), 124);
@@ -29,3 +29,106 @@ test('parseEuros reads what people type', () => {
   assert.deepEqual(parseEuros('12.345'), { ok: false, error: 'AMOUNT_INVALID' });
