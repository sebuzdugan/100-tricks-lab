+
+test('mergeCustomers removes fromId and reassigns invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', tier: 'standard' },
+    { id: 'C-003', name: 'Charlie', email: 'charlie@example.com', tier: 'silver' },
+  ];
+
+  const invoices = [
+    { id: 1, customerId: 'C-001', status: 'issued' },
+    { id: 2, customerId: 'C-002', status: 'draft' },
+    { id: 3, customerId: 'C-002', status: 'issued' },
+    { id: 4, customerId: 'C-003', status: 'paid' },
+  ];
+
+  const r = mergeCustomers(customers, invoices, 'C-002', 'C-001');
+  assert.equal(r.ok, true);
+
+  assert.equal(r.value.customers.length, 2);
+  assert.equal(r.value.customers.find((c) => c.id === 'C-002'), undefined);
+
+  assert.equal(r.value.invoices.length, 4);
+  assert.equal(r.value.invoices[1].customerId, 'C-001');
+  assert.equal(r.value.invoices[2].customerId, 'C-001');
+  assert.equal(r.value.invoices[0].customerId, 'C-001');
+  assert.equal(r.value.invoices[3].customerId, 'C-003');
+});
+
