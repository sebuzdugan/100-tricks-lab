diff --git a/src/totals.js b/src/totals.js
new file mode 100644
index 0000000..d63b632
--- /dev/null
+++ b/src/totals.js
@@ -0,0 +1,56 @@
+import { roundCents } from './money.js';
+
+/**
+ * Calculate the total amount for a line (qty × unitPrice in cents).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return line.qty * line.unitPrice;
+}
+
+/**
+ * Calculate the discount amount for a line.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const total = lineTotal(line);
+  const discountPercent = line.discountPercent ?? 0;
+  const discount = total * (discountPercent / 100);
+  return Math.max(0, discount);
+}
+
+/**
+ * Calculate VAT for a line (on amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }} line
+ * @returns {number}
+ */
+export function lineVAT(line) {
+  const total = lineTotal(line);
+  const discount = lineDiscount(line);
+  const amountAfterDiscount = total - discount;
+  const vatRate = line.vatRate ?? 0;
+  const vat = amountAfterDiscount * (vatRate / 100);
+  return roundCents(vat);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0);
+  const discount = invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0);
+  const vat = invoice.lines.reduce((sum, line) => sum + lineVAT(line), 0);
+  const voucher = invoice.voucher?.amount ?? 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
diff --git a/test/totals.test.js b/test/totals.test.js
new file mode 100644
index 0000000..da6cbf1
--- /dev/null
+++ b/test/totals.test.js
@@ -0,0 +1,158 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVAT, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty × unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 1000 }), 5000);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 100 }), 100);
+  assert.equal(lineTotal({ qty: 10, unitPrice: 5000 }), 50000);
+});
+
+test('lineDiscount calculates discount amount', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 10 };
+  assert.equal(lineDiscount(line), 1000);
+});
+
+test('lineDiscount defaults to 0% if not specified', () => {
+  const line = { qty: 100, unitPrice: 100 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount returns 0 if result is negative (clamped)', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: -5 };
+  assert.equal(lineDiscount(line), 0);
+});
+
+test('lineDiscount handles various percentages', () => {
+  const line = { qty: 200, unitPrice: 500 };
+  assert.equal(lineDiscount({ ...line, discountPercent: 0 }), 0);
+  assert.equal(lineDiscount({ ...line, discountPercent: 50 }), 50000);
+  assert.equal(lineDiscount({ ...line, discountPercent: 100 }), 100000);
+});
+
+test('lineVAT calculates VAT on amount after discount', () => {
+  const line = { qty: 100, unitPrice: 100, discountPercent: 10, vatRate: 20 };
+  const total = 10000;
+  const discount = 1000;
+  const base = total - discount;
+  const expectedVat = Math.round(base * 0.2 * 1e6) / 1e6;
+  assert.equal(lineVAT(line), expectedVat);
+});
+
+test('lineVAT defaults to 0% if not specified', () => {
+  const line = { qty: 100, unitPrice: 100 };
+  assert.equal(lineVAT(line), 0);
+});
+
+test('lineVAT rounds to nearest cent using banker\'s rounding', () => {
+  const line = { qty: 3, unitPrice: 100, vatRate: 23 };
+  const vat = lineVAT(line);
+  assert.equal(vat, Math.round(300 * 0.23 * 1e6) / 1e6);
+});
+
+test('lineVAT with discount and VAT', () => {
+  const line = { qty: 10, unitPrice: 1000, discountPercent: 15, vatRate: 19 };
+  const vat = lineVAT(line);
+  const expectedBase = 10000 - 1500;
+  const expectedVat = Math.round(expectedBase * 0.19 * 1e6) / 1e6;
+  assert.equal(vat, expectedVat);
+});
+
+test('invoiceTotals sums up line totals, discounts, and VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 20 },
+      { qty: 5, unitPrice: 2000, discountPercent: 5, vatRate: 20 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 20000);
+  assert.ok(totals.discount > 0);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.voucher, 0);
+  assert.ok(totals.total > 0);
+});
+
+test('invoiceTotals with no discounts or VAT', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 1000 },
+      { qty: 3, unitPrice: 2000 },
+    ],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 11000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 11000);
+});
+
+test('invoiceTotals with voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000 },
+    ],
+    voucher: { code: 'SAVE10', amount: 1000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 1000);
+  assert.equal(totals.total, 9000);
+});
+
+test('invoiceTotals with multiple lines, discount, VAT, and voucher', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 20 },
+      { qty: 5, unitPrice: 2000, discountPercent: 0, vatRate: 10 },
+    ],
+    voucher: { code: 'SAVE', amount: 500 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 20000);
+  assert.equal(totals.discount, 1000);
+  assert.ok(totals.vat > 0);
+  assert.equal(totals.voucher, 500);
+  assert.ok(totals.total > 0);
+  // total = subtotal - discount + vat - voucher = 20000 - 1000 + vat - 500
+  const expectedTotal = Math.max(0, 20000 - 1000 + totals.vat - 500);
+  assert.equal(totals.total, expectedTotal);
+});
+
+test('invoiceTotals clamps total to 0 if voucher exceeds amount due', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 100 },
+    ],
+    voucher: { code: 'BIG', amount: 10000 },
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = {
+    lines: [],
+  };
+
+  const totals = invoiceTotals(invoice);
+
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
