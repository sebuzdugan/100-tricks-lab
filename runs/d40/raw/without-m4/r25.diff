@@ -28,8 +35,19 @@ export function renderInvoiceText(invoice) {
   if (totals.vat > 0) {
     summaryLines.push(`VAT: ${formatEuros(totals.vat)}`);
   }
+  if (invoice.voucher) {
+    summaryLines.push(`Voucher (${invoice.voucher.code}): -${formatEuros(invoice.voucher.amount)}`);
+  }
   summaryLines.push(`Total: ${formatEuros(totals.total)}`);
 
+  if (invoice.dueDate) {
