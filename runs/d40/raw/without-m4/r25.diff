+  const lineTexts = [];
+  for (const line of invoice.lines) {
     const total = lineTotal(line);
-    return `${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`;
-  });
+    lineTexts.push(`${line.qty}x ${line.name} @ ${formatEuros(line.unitPrice)} = ${formatEuros(total)}`);
+
+    const discount = lineDiscount(line);
