@@ -0,0 +1,64 @@
+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { getProduct } from './catalogue.js';
+
+/**
+ * Create a new invoice.
+ * @param {{ customerId: string, issueDate: string, lines: Array<{ sku: string, qty: number }> }}
+ * @returns {import('./result.js').Result}
+ */
+export function createInvoice({ customerId, issueDate, lines }) {
+  // Validate date format YYYY-MM-DD
+  const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!dateRegex.test(issueDate)) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate it's a real date
+  const date = new Date(issueDate + 'T00:00:00Z');
+  if (isNaN(date.getTime()) || date.toISOString().split('T')[0] !== issueDate) {
+    return fail('DATE_INVALID');
+  }
+
+  // Validate lines array is not empty
+  if (!lines || lines.length === 0) {
+    return fail('NO_LINES');
+  }
+
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Process lines
+  const processedLines = [];
+  for (const line of lines) {
+    // Validate qty
+    if (!Number.isInteger(line.qty) || line.qty <= 0) {
+      return fail('QTY_INVALID');
+    }
+
+    // Validate SKU exists
+    const productResult = getProduct(line.sku);
+    if (!productResult.ok) {
+      return productResult;
+    }
+
+    const product = productResult.value;
+    processedLines.push({
+      sku: line.sku,
+      name: product.name,
+      qty: line.qty,
+      unitPrice: product.unitPrice,
+      vatRate: product.vatRate,
+    });
+  }
+
+  return ok({
+    customerId,
+    issueDate,
+    status: 'draft',
+    lines: processedLines,
+  });
+}
diff --git a/test/invoices.test.js b/test/invoices.test.js
new file mode 100644
index 0000000..487a93b
--- /dev/null
+++ b/test/invoices.test.js
@@ -0,0 +1,156 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { createInvoice } from '../src/invoices.js';
+
+test('createInvoice with valid inputs', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+    ],
+  });
+
+  assert.strictEqual(result.ok, true);
+  assert.strictEqual(result.value.customerId, 'C-001');
+  assert.strictEqual(result.value.issueDate, '2025-12-15');
+  assert.strictEqual(result.value.status, 'draft');
+  assert.strictEqual(result.value.lines.length, 2);
+
+  assert.strictEqual(result.value.lines[0].sku, 'DES-HOUR');
+  assert.strictEqual(result.value.lines[0].qty, 2);
+  assert.strictEqual(result.value.lines[0].name, 'Design work (hour)');
+  assert.strictEqual(result.value.lines[0].unitPrice, 8500);
+  assert.strictEqual(result.value.lines[0].vatRate, 21);
+
+  assert.strictEqual(result.value.lines[1].sku, 'DEV-HOUR');
+  assert.strictEqual(result.value.lines[1].qty, 1);
+  assert.strictEqual(result.value.lines[1].name, 'Development (hour)');
+  assert.strictEqual(result.value.lines[1].unitPrice, 9500);
+  assert.strictEqual(result.value.lines[1].vatRate, 21);
+});
+
+test('createInvoice with unknown customer', () => {
+  const result = createInvoice({
+    customerId: 'unknown-id',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'SKU-A', qty: 1 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'CUSTOMER_NOT_FOUND');
+});
+
+test('createInvoice with invalid date format', () => {
+  const cases = [
+    '2025-13-15',  // invalid month
+    '2025-12-32',  // invalid day
+    '2025-02-30',  // Feb 30th
+    '12/15/2025',  // wrong format
+    '2025/12/15',  // wrong format
+    '15-12-2025',  // wrong format
+    '2025-1-15',   // missing leading zero
+    '2025-12-5',   // missing leading zero
+    '',            // empty
+    '2025',        // incomplete
+  ];
+
+  for (const date of cases) {
+    const result = createInvoice({
+      customerId: '1',
+      issueDate: date,
+      lines: [{ sku: 'SKU-A', qty: 1 }],
+    });
+
+    assert.strictEqual(result.ok, false, `Should fail for date: ${date}`);
+    assert.strictEqual(result.error, 'DATE_INVALID', `Should return DATE_INVALID for: ${date}`);
+  }
+});
+
+test('createInvoice with no lines', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'NO_LINES');
+});
+
+test('createInvoice with no lines array', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: null,
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'NO_LINES');
+});
+
+test('createInvoice with invalid quantities', () => {
+  const cases = [
+    { qty: 0, reason: 'zero' },
+    { qty: -1, reason: 'negative' },
+    { qty: 1.5, reason: 'decimal' },
+    { qty: -0.5, reason: 'negative decimal' },
+    { qty: Infinity, reason: 'infinity' },
+  ];
+
+  for (const { qty, reason } of cases) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty }],
+    });
+
+    assert.strictEqual(result.ok, false, `Should fail for qty: ${reason}`);
+    assert.strictEqual(result.error, 'QTY_INVALID', `Should return QTY_INVALID for: ${reason}`);
+  }
+});
+
+test('createInvoice with unknown SKU', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'UNKNOWN-SKU', qty: 1 }],
+  });
+
+  assert.strictEqual(result.ok, false);
+  assert.strictEqual(result.error, 'UNKNOWN_SKU');
+});
+
+test('createInvoice does not mutate input', () => {
+  const lines = [{ sku: 'DES-HOUR', qty: 2 }];
+  const linesCopy = JSON.parse(JSON.stringify(lines));
+
+  createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines,
+  });
+
+  assert.deepStrictEqual(lines, linesCopy);
+});
+
+test('createInvoice with valid edge case dates', () => {
+  const validDates = [
+    '2025-01-01',
+    '2025-12-31',
+    '2000-02-29',  // leap year
+    '1900-01-01',
+    '9999-12-31',
+  ];
+
+  for (const date of validDates) {
+    const result = createInvoice({
+      customerId: 'C-001',
+      issueDate: date,
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    assert.strictEqual(result.ok, true, `Should succeed for valid date: ${date}`);
+  }
+});
