+  const result = invoiceTotals(invoice);
+  assert.strictEqual(result.subtotal, 17000);
+  assert.strictEqual(result.total, 17000);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 2, unitPrice: 8500 },
+      { qty: 1, unitPrice: 9500 },
+      { qty: 3, unitPrice: 1000 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  // 2*8500 + 1*9500 + 3*1000 = 17000 + 9500 + 3000 = 29500
+  assert.strictEqual(result.subtotal, 29500);
