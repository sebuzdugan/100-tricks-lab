+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 5, unitPrice: 2000 };
+  assert.strictEqual(lineTotal(line), 10000);
+});
+
+test('lineTotal with qty 1', () => {
+  const line = { qty: 1, unitPrice: 8500 };
+  assert.strictEqual(lineTotal(line), 8500);
+});
+
+test('lineTotal with large qty and price', () => {
+  const line = { qty: 100, unitPrice: 120000 };
+  assert.strictEqual(lineTotal(line), 12000000);
+});
+
+test('lineTotal with single cent price', () => {
+  const line = { qty: 3, unitPrice: 50 };
+  assert.strictEqual(lineTotal(line), 150);
