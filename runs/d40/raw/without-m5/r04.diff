diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..ab81d13
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,66 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber with empty existing numbers', () => {
+  const number = nextInvoiceNumber([], '2025-12-15');
+  assert.strictEqual(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber with one existing number', () => {
+  const number = nextInvoiceNumber(['INV-2025-0001'], '2025-12-15');
+  assert.strictEqual(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber with multiple numbers in sequence', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-0002', 'INV-2025-0003'];
+  const number = nextInvoiceNumber(numbers, '2025-12-15');
+  assert.strictEqual(number, 'INV-2025-0004');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const numbers = ['INV-2024-0001', 'INV-2024-0002', 'INV-2026-0001'];
+  const number = nextInvoiceNumber(numbers, '2025-12-15');
+  assert.strictEqual(number, 'INV-2025-0001');
+});
+
+test('nextInvoiceNumber handles unsorted numbers', () => {
+  const numbers = ['INV-2025-0003', 'INV-2025-0001', 'INV-2025-0005', 'INV-2025-0002'];
+  const number = nextInvoiceNumber(numbers, '2025-12-15');
+  assert.strictEqual(number, 'INV-2025-0006');
+});
+
+test('nextInvoiceNumber ignores malformed numbers', () => {
+  const numbers = ['INV-2025-0001', 'INV-2025-XXXX', 'INV-2025-', 'NOT-A-NUMBER'];
+  const number = nextInvoiceNumber(numbers, '2025-12-15');
+  assert.strictEqual(number, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const numbers = Array.from({ length: 99 }, (_, i) => `INV-2025-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(numbers, '2025-12-15');
+  assert.strictEqual(number, 'INV-2025-0100');
+});
+
+test('nextInvoiceNumber with large counter', () => {
+  const numbers = ['INV-2025-9998', 'INV-2025-9999'];
+  const number = nextInvoiceNumber(numbers, '2025-12-15');
+  assert.strictEqual(number, 'INV-2025-10000');
+});
+
+test('nextInvoiceNumber extracts year from different dates in same year', () => {
+  const numbers = ['INV-2025-0001'];
+  const number1 = nextInvoiceNumber(numbers, '2025-01-01');
+  const number2 = nextInvoiceNumber(numbers, '2025-06-15');
+  const number3 = nextInvoiceNumber(numbers, '2025-12-31');
+
+  assert.strictEqual(number1, 'INV-2025-0002');
+  assert.strictEqual(number2, 'INV-2025-0002');
+  assert.strictEqual(number3, 'INV-2025-0002');
+});
+
+test('nextInvoiceNumber resets for new year', () => {
+  const numbers2024 = Array.from({ length: 50 }, (_, i) => `INV-2024-${String(i + 1).padStart(4, '0')}`);
+  const number = nextInvoiceNumber(numbers2024, '2025-01-01');
+  assert.strictEqual(number, 'INV-2025-0001');
+});
