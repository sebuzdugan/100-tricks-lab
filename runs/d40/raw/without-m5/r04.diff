new file mode 100644
index 0000000..8ab72fc
--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,22 @@
+/**
+ * Calculate the next invoice number for a given year.
+ * Format: INV-<year>-<counter>, where counter is 0001-9999, zero-padded.
+ * @param {string[]} existingNumbers - Array of invoice numbers already used (in any order)
+ * @param {string} issueDate - Issue date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  const year = issueDate.split('-')[0];
+  const prefix = `INV-${year}-`;
+
+  // Filter numbers from this year and extract counters
+  const counters = existingNumbers
+    .filter((num) => num.startsWith(prefix))
+    .map((num) => parseInt(num.substring(prefix.length), 10))
+    .filter((n) => !isNaN(n));
+
+  const maxCounter = counters.length > 0 ? Math.max(...counters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  return `${prefix}${String(nextCounter).padStart(4, '0')}`;
+}
