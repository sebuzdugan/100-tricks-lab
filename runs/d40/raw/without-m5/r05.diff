+++ b/test/render.test.js
@@ -0,0 +1,239 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText with draft invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  assert(text.includes('DRAFT'));
+  assert(text.includes('Northwind Studio'));
+  assert(text.includes('2x Design work (hour)'));
+  assert(text.includes('€85.00'));
+  assert(text.includes('€170.00'));
+  assert(text.includes('Total:'));
+});
+
+test('renderInvoiceText with issued invoice', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  const issuedResult = issueInvoice(invoiceResult.value, []);
+  const text = renderInvoiceText(issuedResult.value);
+
+  assert(text.includes('INV-2025-0001'));
+  assert(text.includes('Northwind Studio'));
+  assert(text.includes('Total:'));
+});
+
+test('renderInvoiceText formats amounts with formatEuros', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'LOGO-PACK', qty: 1 },
+      { sku: 'STICKER', qty: 100 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  // LOGO-PACK: 120000 cents = €1,200.00
+  // STICKER: 50 cents * 100 = 5000 cents = €50.00
+  // Total: €1,250.00
+  assert(text.includes('€1,200.00'));
+  assert(text.includes('€50.00'));
+  assert(text.includes('€1,250.00'));
+});
+
+test('renderInvoiceText includes all invoice lines', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 3 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  // DRAFT, Customer name, 3 invoice lines, Total
+  assert.strictEqual(lines.length, 6);
+  assert(lines[2].includes('Design work'));
+  assert(lines[3].includes('Development'));
+  assert(lines[4].includes('Copywriting'));
+});
+
+test('renderInvoiceText with single line', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const lines = text.split('\n');
+
+  // DRAFT, Customer name, 1 invoice line, Total
+  assert.strictEqual(lines.length, 4);
+  assert(lines[0].includes('DRAFT'));
+  assert(lines[1].includes('Northwind Studio'));
+  assert(lines[2].includes('1x Design work'));
+  assert(lines[3].startsWith('Total:'));
+});
+
+test('renderInvoiceText line format includes qty, name, unit price, and total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  // Should contain: 2x Design work (hour) @ €85.00 = €170.00
+  assert(text.includes('2x'));
+  assert(text.includes('Design work (hour)'));
+  assert(text.includes('@'));
+  assert(text.includes('€85.00'));
+  assert(text.includes('='));
+  assert(text.includes('€170.00'));
+});
+
+test('renderInvoiceText with high VAT rate products', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'PRINT-A4', qty: 100 },
+      { sku: 'WORKSHOP-DAY', qty: 1 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  // PRINT-A4: 37 cents * 100 = 3700 cents = €37.00 (9% VAT)
+  // WORKSHOP-DAY: 60000 cents = €600.00 (0% VAT)
+  // Total: €637.00
+  assert(text.includes('€37.00'));
+  assert(text.includes('€600.00'));
+  assert(text.includes('€637.00'));
+});
+
+test('renderInvoiceText with different customers', () => {
+  const customerIds = ['C-002', 'C-003', 'C-004'];
+  const expectedNames = ['Blue Fern Bakery', 'Kite & Co', 'Smith, Jones & Partners'];
+
+  for (let i = 0; i < customerIds.length; i++) {
+    const invoiceResult = createInvoice({
+      customerId: customerIds[i],
+      issueDate: '2025-12-15',
+      lines: [{ sku: 'DES-HOUR', qty: 1 }],
+    });
+
+    const text = renderInvoiceText(invoiceResult.value);
+    assert(text.includes(expectedNames[i]));
+  }
+});
+
+test('renderInvoiceText preserves line order', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'STICKER', qty: 1 },
+      { sku: 'ICON-SET', qty: 1 },
+      { sku: 'PHOTO-LIC', qty: 1 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+  const sticker = text.indexOf('Sticker sheet');
+  const icon = text.indexOf('Icon set');
+  const photo = text.indexOf('Stock photo');
+
+  assert(sticker < icon);
+  assert(icon < photo);
+});
+
+test('renderInvoiceText total matches sum of line totals', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+      { sku: 'DEV-HOUR', qty: 3 },
+      { sku: 'COPY-HOUR', qty: 1 },
+    ],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  // DES-HOUR: 2 * 8500 = 17000 = €170.00
+  // DEV-HOUR: 3 * 9500 = 28500 = €285.00
+  // COPY-HOUR: 1 * 6000 = 6000 = €60.00
+  // Total: €515.00
+  assert(text.includes('Total: €515.00'));
+});
+
+test('renderInvoiceText with large quantities', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'STICKER', qty: 1000 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  // 1000 * 50 = 50000 = €500.00
+  assert(text.includes('1000x Sticker sheet'));
+  assert(text.includes('€500.00'));
+});
+
+test('renderInvoiceText with invoice enriched with customer info', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const enrichedInvoice = {
+    ...invoiceResult.value,
+    customer: { name: 'Custom Name' },
+  };
+
+  const text = renderInvoiceText(enrichedInvoice);
+
+  // Should use the enriched customer name
+  assert(text.includes('Custom Name'));
+  assert(!text.includes('Northwind Studio'));
+});
+
+test('renderInvoiceText output is valid text', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  const text = renderInvoiceText(invoiceResult.value);
+
+  // Should be a string
+  assert(typeof text === 'string');
+  // Should contain newlines
+  assert(text.includes('\n'));
+  // Should end without trailing newline
+  assert(!text.endsWith('\n'));
+});
