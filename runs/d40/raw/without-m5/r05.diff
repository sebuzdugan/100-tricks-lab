+import { formatEuros } from './money.js';
+import { lineTotal, invoiceTotals } from './invoices.js';
+import { getCustomer } from './customers.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {any} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  const invoiceNumber = invoice.number || 'DRAFT';
+  const lines = [];
+
+  lines.push(invoiceNumber);
+
+  // Get customer name
+  let customerName;
+  if (invoice.customer?.name) {
+    customerName = invoice.customer.name;
+  } else {
+    const customerResult = getCustomer(invoice.customerId);
+    if (customerResult.ok) {
+      customerName = customerResult.value.name;
+    } else {
+      customerName = invoice.customerId;
+    }
+  }
+
+  lines.push(customerName);
+
+  for (const line of invoice.lines) {
+    const qty = line.qty;
+    const name = line.name;
+    const unitPrice = formatEuros(line.unitPrice);
+    const total = formatEuros(lineTotal(line));
+    lines.push(`${qty}x ${name} @ ${unitPrice} = ${total}`);
+  }
+
+  const totals = invoiceTotals(invoice);
+  const totalFormatted = formatEuros(totals.total);
+  lines.push(`Total: ${totalFormatted}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..4a325ba
