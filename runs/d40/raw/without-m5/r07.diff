+    ],
+  });
+
+  const invoice = result.value;
+  const totals = invoiceTotals(invoice);
+
+  // DES-HOUR is 8500 per hour, qty 2 = 17000 subtotal
+  // 5% discount = 850
+  assert.strictEqual(totals.subtotal, 17000);
+  assert.strictEqual(totals.discount, 850);
+  assert.strictEqual(totals.total, 16150);
+});
+
+test('invoiceTotals with silver tier discount', () => {
+  const result = createInvoice({
+    customerId: 'C-003',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2 },
+    ],
+  });
+
+  const invoice = result.value;
+  const totals = invoiceTotals(invoice);
+
+  // DES-HOUR is 8500 per hour, qty 2 = 17000 subtotal
+  // 2.5% discount = 425
+  assert.strictEqual(totals.subtotal, 17000);
+  assert.strictEqual(totals.discount, 425);
+  assert.strictEqual(totals.total, 16575);
+});
+
+test('invoiceTotals with explicit discount overriding tier', () => {
+  const result = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 2, discountPercent: 0 },
+    ],
+  });
+
+  const invoice = result.value;
+  const totals = invoiceTotals(invoice);
+
+  assert.strictEqual(totals.subtotal, 17000);
+  assert.strictEqual(totals.discount, 0);
+  assert.strictEqual(totals.total, 17000);
+});
