index 62d6d20..a5fe5db 100644
--- a/src/invoices.js
+++ b/src/invoices.js
@@ -104,18 +104,31 @@ export function lineDiscount(line) {
   return Math.max(0, discount);
 }
 
+/**
+ * Calculate the VAT amount for a line item (VAT is calculated on the amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }} line
+ * @returns {number}
+ */
+export function lineVat(line) {
+  const amountAfterDiscount = Math.max(0, lineTotal(line) - lineDiscount(line));
+  const vat = amountAfterDiscount * ((line.vatRate ?? 0) / 100);
+  return Math.round(vat);
+}
+
 /**
  * Calculate totals for an invoice.
- * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number }> }} invoice
- * @returns {{ subtotal: number, discount: number, total: number }}
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }> }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, total: number }}
  */
 export function invoiceTotals(invoice) {
   const subtotal = Math.max(0, invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
   const discount = Math.max(0, invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0));
-  const total = Math.max(0, subtotal - discount);
+  const vat = Math.max(0, invoice.lines.reduce((sum, line) => sum + lineVat(line), 0));
+  const total = Math.max(0, subtotal - discount + vat);
   return {
     subtotal,
     discount,
+    vat,
     total,
   };
 }
