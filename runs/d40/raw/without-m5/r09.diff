+    customerId: '  C-001  ',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  assert.ok(result.ok);
+  assert.strictEqual(result.value.customerId, 'C-001');
+});
+
+test('createInvoice normalizes mixed case and whitespace customer id', () => {
+  const result = createInvoice({
+    customerId: '  c-001  ',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+
+  assert.ok(result.ok);
+  assert.strictEqual(result.value.customerId, 'C-001');
+});
+
+test('createInvoice finds customer with normalized id', () => {
+  const result = createInvoice({
+    customerId: 'c-001',
+    issueDate: '2025-12-15',
