diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..618e338
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,129 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.strictEqual(isValidDate('2025-01-01'), true);
+  assert.strictEqual(isValidDate('2025-12-31'), true);
+  assert.strictEqual(isValidDate('2000-02-29'), true); // leap year
+  assert.strictEqual(isValidDate('1900-01-01'), true);
+  assert.strictEqual(isValidDate('9999-12-31'), true);
+});
+
+test('isValidDate rejects invalid date formats', () => {
+  assert.strictEqual(isValidDate('2025-13-15'), false); // invalid month
+  assert.strictEqual(isValidDate('2025-12-32'), false); // invalid day
+  assert.strictEqual(isValidDate('2025-02-30'), false); // Feb 30th
+  assert.strictEqual(isValidDate('12/15/2025'), false); // wrong format
+  assert.strictEqual(isValidDate('2025/12/15'), false); // wrong format
+  assert.strictEqual(isValidDate('15-12-2025'), false); // wrong format
+  assert.strictEqual(isValidDate('2025-1-15'), false); // missing leading zero
+  assert.strictEqual(isValidDate('2025-12-5'), false); // missing leading zero
+  assert.strictEqual(isValidDate(''), false); // empty
+  assert.strictEqual(isValidDate('2025'), false); // incomplete
+});
+
+test('isValidDate rejects non-string inputs', () => {
+  assert.strictEqual(isValidDate(null), false);
+  assert.strictEqual(isValidDate(undefined), false);
+  assert.strictEqual(isValidDate(123), false);
+  assert.strictEqual(isValidDate({}), false);
+  assert.strictEqual(isValidDate([]), false);
+});
+
+test('isValidDate rejects invalid leap year dates', () => {
+  assert.strictEqual(isValidDate('1900-02-29'), false); // 1900 is not a leap year
+  assert.strictEqual(isValidDate('2100-02-29'), false); // 2100 is not a leap year
+});
+
+test('addDays adds positive days', () => {
+  assert.strictEqual(addDays('2025-01-01', 1), '2025-01-02');
+  assert.strictEqual(addDays('2025-01-01', 10), '2025-01-11');
+  assert.strictEqual(addDays('2025-01-01', 31), '2025-02-01');
+  assert.strictEqual(addDays('2025-12-25', 7), '2026-01-01');
+});
+
+test('addDays adds zero days', () => {
+  assert.strictEqual(addDays('2025-01-15', 0), '2025-01-15');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.strictEqual(addDays('2025-01-02', -1), '2025-01-01');
+  assert.strictEqual(addDays('2025-01-15', -10), '2025-01-05');
+  assert.strictEqual(addDays('2025-02-01', -1), '2025-01-31');
+  assert.strictEqual(addDays('2026-01-01', -7), '2025-12-25');
+});
+
+test('addDays handles leap years', () => {
+  assert.strictEqual(addDays('2000-02-29', 1), '2000-03-01');
+  assert.strictEqual(addDays('2000-02-28', 1), '2000-02-29');
+});
+
+test('addDays handles year boundaries', () => {
+  assert.strictEqual(addDays('2024-12-31', 1), '2025-01-01');
+  assert.strictEqual(addDays('2025-01-01', -1), '2024-12-31');
+});
+
+test('addDays with large day counts', () => {
+  assert.strictEqual(addDays('2025-01-01', 365), '2026-01-01');
+  assert.strictEqual(addDays('2025-01-01', 1000), '2027-09-28');
+});
+
+test('daysBetween calculates positive differences', () => {
+  assert.strictEqual(daysBetween('2025-01-01', '2025-01-02'), 1);
+  assert.strictEqual(daysBetween('2025-01-01', '2025-01-15'), 14);
+  assert.strictEqual(daysBetween('2025-01-01', '2025-02-01'), 31);
+  assert.strictEqual(daysBetween('2025-12-25', '2026-01-01'), 7);
+});
+
+test('daysBetween calculates negative differences', () => {
+  assert.strictEqual(daysBetween('2025-01-02', '2025-01-01'), -1);
+  assert.strictEqual(daysBetween('2025-01-15', '2025-01-01'), -14);
+  assert.strictEqual(daysBetween('2025-02-01', '2025-01-01'), -31);
+});
+
+test('daysBetween with same date', () => {
+  assert.strictEqual(daysBetween('2025-01-15', '2025-01-15'), 0);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.strictEqual(daysBetween('2000-02-28', '2000-03-01'), 2);
+  assert.strictEqual(daysBetween('2000-02-28', '2000-02-29'), 1);
+});
+
+test('daysBetween handles year boundaries', () => {
+  assert.strictEqual(daysBetween('2024-12-31', '2025-01-01'), 1);
+  assert.strictEqual(daysBetween('2025-01-01', '2024-12-31'), -1);
+});
+
+test('daysBetween with large date differences', () => {
+  assert.strictEqual(daysBetween('2025-01-01', '2026-01-01'), 365);
+  assert.strictEqual(daysBetween('2025-01-01', '2027-09-28'), 1000);
+});
+
+test('addDays and daysBetween are consistent', () => {
+  const start = '2025-01-15';
+  const days = 100;
+  const end = addDays(start, days);
+  assert.strictEqual(daysBetween(start, end), days);
+  assert.strictEqual(end, '2025-04-25');
+});
+
+test('addDays and daysBetween are consistent with negative days', () => {
+  const start = '2025-12-31';
+  const days = -50;
+  const end = addDays(start, days);
+  assert.strictEqual(daysBetween(start, end), days);
+});
+
+test('date functions use UTC (no timezone issues)', () => {
+  const date1 = '2025-01-01';
+  const date2 = '2025-01-02';
+
+  // These should always give consistent results regardless of machine timezone
+  const daysAdded = addDays(date1, 1);
+  assert.strictEqual(daysAdded, date2);
+
+  const daysDiff = daysBetween(date1, date2);
+  assert.strictEqual(daysDiff, 1);
+});
