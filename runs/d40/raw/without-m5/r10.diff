index 0000000..f4f08e0
--- /dev/null
+++ b/src/dates.js
@@ -0,0 +1,47 @@
+/**
+ * Check if a date string is valid in YYYY-MM-DD format.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function isValidDate(text) {
+  if (typeof text !== 'string') {
+    return false;
+  }
+
+  const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
+  if (!dateRegex.test(text)) {
+    return false;
+  }
+
+  const date = new Date(text + 'T00:00:00Z');
+  if (isNaN(date.getTime())) {
+    return false;
+  }
+
+  return date.toISOString().split('T')[0] === text;
+}
+
+/**
+ * Add days to a date string (in YYYY-MM-DD format, UTC).
+ * @param {string} date Date in YYYY-MM-DD format
+ * @param {number} days Number of days to add
+ * @returns {string} New date in YYYY-MM-DD format
+ */
+export function addDays(date, days) {
+  const d = new Date(date + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() + days);
+  return d.toISOString().split('T')[0];
+}
+
+/**
+ * Calculate the number of days between two dates (b - a, in whole days, UTC).
+ * @param {string} a Date in YYYY-MM-DD format
+ * @param {string} b Date in YYYY-MM-DD format
+ * @returns {number} Number of days (b minus a)
+ */
+export function daysBetween(a, b) {
+  const dateA = new Date(a + 'T00:00:00Z');
+  const dateB = new Date(b + 'T00:00:00Z');
+  const diffMs = dateB.getTime() - dateA.getTime();
+  return Math.floor(diffMs / (1000 * 60 * 60 * 24));
+}
