+/**
+ * Calculate the due date for an invoice based on terms.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @param {string} terms - Payment terms: NET14, NET30, or EOM
+ * @returns {string|null} Due date in YYYY-MM-DD format, or null if terms are invalid
+ */
+function calculateDueDate(issueDate, terms) {
+  if (terms === 'NET14') {
+    return addDays(issueDate, 14);
+  }
+  if (terms === 'NET30') {
+    return addDays(issueDate, 30);
+  }
+  if (terms === 'EOM') {
+    const [year, month] = issueDate.split('-');
+    const nextMonth = parseInt(month) + 1;
+    if (nextMonth > 12) {
+      return `${parseInt(year) + 1}-01-01`;
+    }
+    return `${year}-${String(nextMonth).padStart(2, '0')}-01`;
+  }
+  return null;
+}
+
+/**
+ * Get the last day of the month for an EOM due date.
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string} Last day of the month in YYYY-MM-DD format
+ */
+function getEndOfMonth(issueDate) {
+  const [year, month] = issueDate.split('-');
+  const nextMonth = parseInt(month) + 1;
+  let nextMonthStr, nextYearStr;
+  if (nextMonth > 12) {
+    nextYearStr = String(parseInt(year) + 1);
+    nextMonthStr = '01';
+  } else {
+    nextYearStr = year;
+    nextMonthStr = String(nextMonth).padStart(2, '0');
+  }
+  const firstDayNextMonth = `${nextYearStr}-${nextMonthStr}-01`;
+  const d = new Date(firstDayNextMonth + 'T00:00:00Z');
+  d.setUTCDate(d.getUTCDate() - 1);
+  return d.toISOString().split('T')[0];
+}
