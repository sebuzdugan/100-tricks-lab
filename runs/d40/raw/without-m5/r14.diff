+import { ok, fail } from './result.js';
+import { getCustomer } from './customers.js';
+import { balanceDue } from './payments.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Generate a customer statement.
+ * @param {string} customerId
+ * @param {Array<any>} invoices
+ * @param {string} asOf - Date in YYYY-MM-DD format
+ * @returns {import('./result.js').Result}
+ */
+export function statement(customerId, invoices, asOf) {
+  // Validate customer exists
+  const customerResult = getCustomer(customerId);
+  if (!customerResult.ok) {
+    return customerResult;
+  }
+
+  // Filter invoices for this customer with relevant status and date
+  const relevantInvoices = invoices
+    .filter((inv) => inv.customerId === customerId)
+    .filter((inv) => inv.status === 'issued' || inv.status === 'partially_paid')
+    .filter((inv) => inv.issueDate <= asOf)
+    .sort((a, b) => a.issueDate.localeCompare(b.issueDate));
+
+  // Build statement invoices with due amount
+  const statementInvoices = relevantInvoices.map((inv) => {
+    const totals = invoiceTotals(inv);
+    return {
+      number: inv.number,
+      issueDate: inv.issueDate,
+      dueDate: inv.dueDate,
+      total: totals.total,
+      due: balanceDue(inv),
+    };
+  });
+
+  // Calculate total due
+  const totalDue = statementInvoices.reduce((sum, inv) => sum + inv.due, 0);
+
+  return ok({
+    customerId,
+    invoices: statementInvoices,
+    totalDue,
+  });
+}
diff --git a/test/statements.test.js b/test/statements.test.js
