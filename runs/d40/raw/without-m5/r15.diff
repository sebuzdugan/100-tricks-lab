+++ b/test/credits.test.js
@@ -0,0 +1,290 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+function createTestInvoice(customerId, issueDate) {
+  const created = createInvoice({
+    customerId,
+    issueDate,
+    lines: [{ sku: 'DES-HOUR', qty: 2 }],
+  });
+  if (!created.ok) throw new Error('Failed to create invoice');
+
+  const issued = issueInvoice(created.value, []);
+  if (!issued.ok) throw new Error('Failed to issue invoice');
+  return issued.value;
+}
+
+test('createCreditNote: creates credit note for issued invoice', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 5000, reason: 'Partial refund', date: '2025-12-20' },
+    [invoice.number]
+  );
+
+  assert.ok(result.ok);
+  assert.ok(result.value.number.startsWith('CN-'));
+  assert.strictEqual(result.value.invoiceNumber, invoice.number);
+  assert.strictEqual(result.value.customerId, 'C-001');
+  assert.strictEqual(result.value.amount, 5000);
+  assert.strictEqual(result.value.reason, 'Partial refund');
+  assert.strictEqual(result.value.date, '2025-12-20');
+});
+
+test('createCreditNote: fails for draft invoice', () => {
+  const created = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+  assert.ok(created.ok);
+
+  const result = createCreditNote(
+    created.value,
+    { amount: 1000, reason: 'Test', date: '2025-12-20' },
+    []
+  );
+
+  assert.ok(!result.ok);
+  assert.strictEqual(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote: accepts credit for partially_paid invoice', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+  const partial = recordPayment(invoice, { amount: 5000, date: '2025-12-20' });
+  assert.ok(partial.ok);
+
+  const result = createCreditNote(
+    partial.value,
+    { amount: 2000, reason: 'Partial credit', date: '2025-12-25' },
+    [invoice.number]
+  );
+
+  assert.ok(result.ok);
+});
+
+test('createCreditNote: accepts credit for paid invoice', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+  const totals = invoiceTotals(invoice);
+  const paid = recordPayment(invoice, { amount: totals.total, date: '2025-12-20' });
+  assert.ok(paid.ok);
+
+  const result = createCreditNote(
+    paid.value,
+    { amount: 2000, reason: 'Full refund after payment', date: '2025-12-25' },
+    [invoice.number]
+  );
+
+  assert.ok(result.ok);
+});
+
+test('createCreditNote: fails with non-integer amount', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 50.5, reason: 'Test', date: '2025-12-20' },
+    [invoice.number]
+  );
+
+  assert.ok(!result.ok);
+  assert.strictEqual(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: fails with zero amount', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 0, reason: 'Test', date: '2025-12-20' },
+    [invoice.number]
+  );
+
+  assert.ok(!result.ok);
+  assert.strictEqual(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: fails with negative amount', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: -1000, reason: 'Test', date: '2025-12-20' },
+    [invoice.number]
+  );
+
+  assert.ok(!result.ok);
+  assert.strictEqual(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote: fails if credit exceeds invoice total', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: totals.total + 1000, reason: 'Too much', date: '2025-12-20' },
+    [invoice.number]
+  );
+
+  assert.ok(!result.ok);
+  assert.strictEqual(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote: allows credit equal to invoice total', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+  const totals = invoiceTotals(invoice);
+
+  const result = createCreditNote(
+    invoice,
+    { amount: totals.total, reason: 'Full refund', date: '2025-12-20' },
+    [invoice.number]
+  );
+
+  assert.ok(result.ok);
+});
+
+test('nextCreditNoteNumber: starts at 0001', () => {
+  const number = nextCreditNoteNumber([], '2025-12-15');
+  assert.strictEqual(number, 'CN-2025-0001');
+});
+
+test('nextCreditNoteNumber: increments counter', () => {
+  const existingNumbers = [
+    'CN-2025-0001',
+    'CN-2025-0002',
+    'CN-2025-0005',
+  ];
+
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.strictEqual(number, 'CN-2025-0006');
+});
+
+test('nextCreditNoteNumber: ignores invoice numbers', () => {
+  const existingNumbers = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'CN-2025-0001',
+  ];
+
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.strictEqual(number, 'CN-2025-0002');
+});
+
+test('nextCreditNoteNumber: separate counter per year', () => {
+  const existingNumbers = [
+    'CN-2024-0005',
+    'CN-2025-0003',
+  ];
+
+  const number2025 = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  const number2026 = nextCreditNoteNumber(existingNumbers, '2026-01-01');
+
+  assert.strictEqual(number2025, 'CN-2025-0004');
+  assert.strictEqual(number2026, 'CN-2026-0001');
+});
+
+test('nextCreditNoteNumber: handles unsorted numbers', () => {
+  const existingNumbers = [
+    'CN-2025-0005',
+    'CN-2025-0001',
+    'CN-2025-0003',
+  ];
+
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.strictEqual(number, 'CN-2025-0006');
+});
+
+test('nextCreditNoteNumber: ignores malformed numbers', () => {
+  const existingNumbers = [
+    'CN-2025-0001',
+    'CN-2025-XXXX',
+    'CN-2025-0003',
+  ];
+
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.strictEqual(number, 'CN-2025-0004');
+});
+
+test('nextCreditNoteNumber: pads counter to 4 digits', () => {
+  const existingNumbers = [
+    'CN-2025-0001',
+    'CN-2025-0002',
+    'CN-2025-0008',
+  ];
+
+  const number = nextCreditNoteNumber(existingNumbers, '2025-12-15');
+  assert.strictEqual(number, 'CN-2025-0009');
+});
+
+test('createCreditNote: includes reason in credit note', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 1000, reason: 'Customer complaint - defective item', date: '2025-12-20' },
+    [invoice.number]
+  );
+
+  assert.ok(result.ok);
+  assert.strictEqual(result.value.reason, 'Customer complaint - defective item');
+});
+
+test('createCreditNote: uses date from credit note', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 1000, reason: 'Test', date: '2025-12-25' },
+    [invoice.number]
+  );
+
+  assert.ok(result.ok);
+  assert.strictEqual(result.value.date, '2025-12-25');
+});
+
+test('createCreditNote: generates unique numbers', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+
+  const result1 = createCreditNote(
+    invoice,
+    { amount: 1000, reason: 'First', date: '2025-12-20' },
+    [invoice.number]
+  );
+  assert.ok(result1.ok);
+
+  const result2 = createCreditNote(
+    invoice,
+    { amount: 2000, reason: 'Second', date: '2025-12-20' },
+    [invoice.number, result1.value.number]
+  );
+  assert.ok(result2.ok);
+
+  assert.notEqual(result1.value.number, result2.value.number);
+});
+
+test('createCreditNote: mixed invoices and credit notes in existingNumbers', () => {
+  const invoice = createTestInvoice('C-001', '2025-12-15');
+
+  const existingNumbers = [
+    'INV-2025-0001',
+    'INV-2025-0002',
+    'CN-2025-0001',
+    'CN-2025-0003',
+    'INV-2025-0003',
+  ];
+
+  const result = createCreditNote(
+    invoice,
+    { amount: 1000, reason: 'Test', date: '2025-12-20' },
+    existingNumbers
+  );
+
+  assert.ok(result.ok);
+  assert.strictEqual(result.value.number, 'CN-2025-0004');
+});
