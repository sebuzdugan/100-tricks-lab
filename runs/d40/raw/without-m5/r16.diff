+import test from 'node:test';
+import assert from 'node:assert';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices', async (t) => {
+  const asOf = '2026-10-07';
+
+  await t.test('empty list', () => {
+    assert.deepStrictEqual(overdueInvoices([], asOf), []);
+  });
+
+  await t.test('no overdue invoices', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'CUST001',
+        status: 'issued',
+        dueDate: '2026-10-10',
+        lines: [],
+        payments: [],
+      },
+    ];
+    assert.deepStrictEqual(overdueInvoices(invoices, asOf), []);
+  });
+
+  await t.test('single overdue issued invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'CUST001',
+        status: 'issued',
+        dueDate: '2026-10-01',
+        lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const result = overdueInvoices(invoices, asOf);
+    assert.strictEqual(result.length, 1);
+    assert.strictEqual(result[0].number, 'INV-001');
+    assert.strictEqual(result[0].daysOverdue, 6);
+    assert.strictEqual(result[0].due, 10000);
+  });
+
+  await t.test('single overdue partially_paid invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-002',
+        customerId: 'CUST001',
+        status: 'partially_paid',
+        dueDate: '2026-10-01',
+        lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+        payments: [{ amount: 3000, date: '2026-10-02' }],
+      },
+    ];
+    const result = overdueInvoices(invoices, asOf);
+    assert.strictEqual(result.length, 1);
+    assert.strictEqual(result[0].due, 7000);
+  });
+
+  await t.test('excludes draft invoices', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'CUST001',
+        status: 'draft',
+        dueDate: '2026-10-01',
+        lines: [],
+        payments: [],
+      },
+    ];
+    assert.deepStrictEqual(overdueInvoices(invoices, asOf), []);
+  });
+
+  await t.test('excludes paid invoices', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'CUST001',
+        status: 'paid',
+        dueDate: '2026-10-01',
+        lines: [],
+        payments: [],
+      },
+    ];
+    assert.deepStrictEqual(overdueInvoices(invoices, asOf), []);
+  });
+
+  await t.test('sorts by most overdue first', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'CUST001',
+        status: 'issued',
+        dueDate: '2026-09-30',
+        lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+      {
+        number: 'INV-002',
+        customerId: 'CUST001',
+        status: 'issued',
+        dueDate: '2026-10-05',
+        lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+      {
+        number: 'INV-003',
+        customerId: 'CUST001',
+        status: 'issued',
+        dueDate: '2026-10-01',
+        lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const result = overdueInvoices(invoices, asOf);
+    assert.strictEqual(result.length, 3);
+    assert.strictEqual(result[0].number, 'INV-001');
+    assert.strictEqual(result[0].daysOverdue, 7);
+    assert.strictEqual(result[1].number, 'INV-003');
+    assert.strictEqual(result[1].daysOverdue, 6);
+    assert.strictEqual(result[2].number, 'INV-002');
+    assert.strictEqual(result[2].daysOverdue, 2);
+  });
+
+  await t.test('excludes invoices with dueDate on or after asOf', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'CUST001',
+        status: 'issued',
+        dueDate: '2026-10-07',
+        lines: [],
+        payments: [],
+      },
+      {
+        number: 'INV-002',
+        customerId: 'CUST001',
+        status: 'issued',
+        dueDate: '2026-10-08',
+        lines: [],
+        payments: [],
+      },
+    ];
+    assert.deepStrictEqual(overdueInvoices(invoices, asOf), []);
+  });
+});
