+/**
+ * Get VAT summary across invoices.
+ * @param {any[]} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} Sorted by rate high to low
+ */
+export function vatSummary(invoices) {
+  const summary = new Map();
+
+  invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid' || inv.status === 'paid')
+    .forEach(inv => {
+      inv.lines.forEach(line => {
+        const rate = line.vatRate ?? 0;
+        const base = Math.max(0, lineTotal(line) - lineDiscount(line));
+        const vat = lineVat(line);
+
+        if (!summary.has(rate)) {
+          summary.set(rate, { rate, base: 0, vat: 0 });
+        }
+        const entry = summary.get(rate);
+        entry.base += base;
+        entry.vat += vat;
+      });
+    });
+
+  return Array.from(summary.values()).sort((a, b) => b.rate - a.rate);
+}
