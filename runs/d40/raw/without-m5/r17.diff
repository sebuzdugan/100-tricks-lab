+test('vatSummary', async (t) => {
+  await t.test('empty list', () => {
+    assert.deepStrictEqual(vatSummary([]), []);
+  });
+
+  await t.test('single invoice with one VAT rate', () => {
+    const invoices = [
+      {
+        status: 'issued',
+        lines: [
+          { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+        ],
+      },
+    ];
+    const result = vatSummary(invoices);
+    assert.strictEqual(result.length, 1);
+    assert.strictEqual(result[0].rate, 21);
+    assert.strictEqual(result[0].base, 100000);
+    assert.strictEqual(result[0].vat, 21000);
+  });
+
+  await t.test('single invoice with multiple VAT rates', () => {
+    const invoices = [
+      {
+        status: 'issued',
+        lines: [
+          { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+          { qty: 50, unitPrice: 2000, discountPercent: 0, vatRate: 9 },
+        ],
+      },
+    ];
+    const result = vatSummary(invoices);
+    assert.strictEqual(result.length, 2);
+    assert.strictEqual(result[0].rate, 21);
+    assert.strictEqual(result[0].base, 100000);
+    assert.strictEqual(result[1].rate, 9);
+    assert.strictEqual(result[1].base, 100000);
