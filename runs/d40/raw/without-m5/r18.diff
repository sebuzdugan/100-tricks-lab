+      payments: [],
+    };
+    const fee = lateFee(invoice, '2026-10-07');
+    const expected = Math.round(10000 * 6 * 0.0004);
+    assert.strictEqual(fee, expected);
+    assert.strictEqual(fee, 24);
+  });
+
+  await t.test('scales with larger amounts', () => {
+    const invoice = {
+      dueDate: '2026-10-01',
+      lines: [{ qty: 1, unitPrice: 1000000, discountPercent: 0, vatRate: 0 }],
+      payments: [],
+    };
+    const fee = lateFee(invoice, '2026-10-07');
+    const expected = Math.round(1000000 * 6 * 0.0004);
+    assert.strictEqual(fee, expected);
+    assert.strictEqual(fee, 2400);
+  });
+
+  await t.test('applies to amount after payments', () => {
