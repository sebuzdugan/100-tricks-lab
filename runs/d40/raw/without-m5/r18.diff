+test('lateFee', async (t) => {
+  await t.test('returns 0 if invoice not overdue', () => {
+    const invoice = {
+      dueDate: '2026-10-10',
+      lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+      payments: [],
+    };
+    const fee = lateFee(invoice, '2026-10-10');
+    assert.strictEqual(fee, 0);
+  });
+
+  await t.test('returns 0 if invoice due in the future', () => {
+    const invoice = {
+      dueDate: '2026-10-15',
+      lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+      payments: [],
+    };
+    const fee = lateFee(invoice, '2026-10-07');
+    assert.strictEqual(fee, 0);
+  });
+
+  await t.test('calculates fee for 1 day overdue', () => {
+    const invoice = {
+      dueDate: '2026-10-06',
+      lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+      payments: [],
+    };
+    const fee = lateFee(invoice, '2026-10-07');
+    const expected = Math.round(10000 * 1 * 0.0004);
+    assert.strictEqual(fee, expected);
+    assert.strictEqual(fee, 4);
+  });
+
+  await t.test('calculates fee for multiple days overdue', () => {
+    const invoice = {
+      dueDate: '2026-10-01',
