+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+import { balanceDue } from './payments.js';
+
+/**
+ * Format cents as plain euros with 2 decimals and a dot: 1234.50
+ * @param {number} cents
+ * @returns {string}
+ */
+function formatEuros(cents) {
+  const euros = cents / 100;
+  return euros.toFixed(2);
+}
+
+/**
+ * Escape a CSV field: quote if it contains comma, double quote, or newline.
+ * @param {string} field
+ * @returns {string}
+ */
+function escapeCsvField(field) {
+  const str = String(field);
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return '"' + str.replace(/"/g, '""') + '"';
+  }
+  return str;
+}
+
+/**
+ * Join fields into a CSV line.
+ * @param {string[]} fields
+ * @returns {string}
+ */
+function escapeCsvLine(fields) {
+  return fields.map(escapeCsvField).join(',');
+}
+
+/**
+ * Export invoices to CSV format.
+ * @param {any[]} invoices
+ * @returns {string}
+ */
+export function exportCsv(invoices) {
+  const lines = [];
+  lines.push('number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+
+  invoices.forEach(inv => {
+    const customer = getCustomer(inv.customerId);
+    const customerName = customer.ok ? customer.value.name : '';
+    const totals = invoiceTotals(inv);
+    const due = balanceDue(inv);
+
+    const fields = [
+      inv.number || '',
+      customerName,
+      inv.issueDate,
+      inv.dueDate,
+      inv.status,
+      formatEuros(totals.subtotal),
+      formatEuros(totals.discount),
+      formatEuros(totals.vat),
+      formatEuros(totals.total),
+      formatEuros(due),
+    ];
+
+    lines.push(escapeCsvLine(fields));
+  });
+
+  return lines.join('\n') + '\n';
+}
