+import test from 'node:test';
+import assert from 'node:assert';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv', async (t) => {
+  await t.test('empty invoice list returns header only', () => {
+    const csv = exportCsv([]);
+    assert.strictEqual(csv, 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due\n');
+  });
+
+  await t.test('single invoice with simple data', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [
+          { qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 },
+        ],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    assert.strictEqual(lines.length, 3);
+    assert.strictEqual(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+    assert.match(lines[1], /INV-001,Northwind Studio,2026-10-01,2026-10-31,issued,1000\.00,0\.00,210\.00,1210\.00,1210\.00/);
+  });
+
+  await t.test('multiple invoices', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+      {
+        number: 'INV-002',
+        customerId: 'C-002',
+        issueDate: '2026-10-05',
+        dueDate: '2026-11-04',
+        status: 'partially_paid',
+        lines: [{ qty: 50, unitPrice: 2000, discountPercent: 0, vatRate: 21 }],
+        payments: [{ amount: 50000, date: '2026-10-10' }],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    assert.strictEqual(lines.length, 4);
+    assert.match(lines[1], /INV-001,Northwind Studio/);
+    assert.match(lines[2], /INV-002,Blue Fern Bakery/);
+  });
+
+  await t.test('formats amounts as euros with 2 decimals', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [
+          { qty: 1, unitPrice: 123, discountPercent: 10, vatRate: 21 },
+        ],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    const fields = lines[1].split(',');
+    assert.strictEqual(fields[5], '1.23');
+    assert.strictEqual(fields[6], '0.12');
+    assert.strictEqual(fields[7], '0.23');
+    assert.strictEqual(fields[8], '1.34');
+  });
+
+  await t.test('quotes field with comma in customer name', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-004',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    assert.match(csv, /"Smith, Jones & Partners"/);
+  });
+
+  await t.test('quotes and escapes double quotes in customer name', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-006',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    assert.match(csv, /"Marlow ""The Print Shop"""/);
+  });
+
+  await t.test('includes unpaid balance for issued invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    const fields = lines[1].split(',');
+    assert.strictEqual(fields[9], '1000.00');
+  });
+
+  await t.test('includes remaining balance for partially paid invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'partially_paid',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [{ amount: 30000, date: '2026-10-10' }],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    const fields = lines[1].split(',');
+    assert.strictEqual(fields[9], '700.00');
+  });
+
+  await t.test('includes zero balance for paid invoice', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'paid',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [{ amount: 100000, date: '2026-10-15' }],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    const fields = lines[1].split(',');
+    assert.strictEqual(fields[8], '1000.00');
+    assert.strictEqual(fields[9], '0.00');
+  });
+
+  await t.test('includes discount in output', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    const fields = lines[1].split(',');
+    assert.strictEqual(fields[5], '1000.00');
+    assert.strictEqual(fields[6], '100.00');
+    assert.strictEqual(fields[8], '900.00');
+  });
+
+  await t.test('includes VAT in output', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 21 }],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    const fields = lines[1].split(',');
+    assert.strictEqual(fields[7], '210.00');
+  });
+
+  await t.test('all lines end with newline', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'CUST001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+      {
+        number: 'INV-002',
+        customerId: 'CUST002',
+        issueDate: '2026-10-05',
+        dueDate: '2026-11-04',
+        status: 'issued',
+        lines: [{ qty: 50, unitPrice: 2000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    assert.strictEqual(csv.endsWith('\n'), true);
+    assert.strictEqual(csv.split('\n').length, 4);
+  });
+
+  await t.test('handles invoices with unknown customer', () => {
+    const invoices = [
+      {
+        number: 'INV-001',
+        customerId: 'UNKNOWN',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    assert.match(lines[1], /INV-001,,2026-10-01/);
+  });
+
+  await t.test('preserves invoice order', () => {
+    const invoices = [
+      {
+        number: 'INV-003',
+        customerId: 'C-001',
+        issueDate: '2026-10-03',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+      {
+        number: 'INV-001',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+      {
+        number: 'INV-002',
+        customerId: 'C-001',
+        issueDate: '2026-10-02',
+        dueDate: '2026-10-31',
+        status: 'issued',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    assert.match(lines[1], /INV-003/);
+    assert.match(lines[2], /INV-001/);
+    assert.match(lines[3], /INV-002/);
+  });
+
+  await t.test('handles empty number field gracefully', () => {
+    const invoices = [
+      {
+        number: '',
+        customerId: 'C-001',
+        issueDate: '2026-10-01',
+        dueDate: '2026-10-31',
+        status: 'draft',
+        lines: [{ qty: 100, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+        payments: [],
+      },
+    ];
+    const csv = exportCsv(invoices);
+    const lines = csv.split('\n');
+    assert.match(lines[1], /^,Northwind Studio/);
+  });
+});
