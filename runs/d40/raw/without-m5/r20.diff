+
+test('RATES defines exchange rates', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert: EUR to EUR', () => {
+  assert.deepEqual(convert(100, 'EUR'), { ok: true, value: 100 });
+  assert.deepEqual(convert(10000, 'EUR'), { ok: true, value: 10000 });
+});
+
+test('convert: EUR to USD', () => {
+  const r = convert(10000, 'USD');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 10850);
+});
+
+test('convert: EUR to GBP', () => {
+  const r = convert(10000, 'GBP');
+  assert.equal(r.ok, true);
+  assert.equal(r.value, 8425);
+});
+
+test('convert: rounds currency conversion', () => {
+  const r = convert(12345, 'USD');
+  assert.equal(r.ok, true);
+  const expected = Math.round((12345 / 100) * 1.085 * 100);
+  assert.equal(r.value, expected);
+});
+
+test('convert: handles zero and negative amounts', () => {
+  assert.deepEqual(convert(0, 'USD'), { ok: true, value: 0 });
+  assert.deepEqual(convert(-10000, 'USD'), { ok: true, value: -10850 });
+});
+
+test('convert: rejects unknown currency', () => {
+  assert.deepEqual(convert(10000, 'JPY'), { ok: false, error: 'UNKNOWN_CURRENCY' });
+  assert.deepEqual(convert(10000, 'usd'), { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('formatMoney: EUR with euro symbol', () => {
+  assert.equal(formatMoney(0, 'EUR'), '€0.00');
+  assert.equal(formatMoney(100, 'EUR'), '€1.00');
+  assert.equal(formatMoney(12345, 'EUR'), '€123.45');
+  assert.equal(formatMoney(-250, 'EUR'), '-€2.50');
+});
+
+test('formatMoney: USD with dollar sign', () => {
+  assert.equal(formatMoney(0, 'USD'), '$0.00');
+  assert.equal(formatMoney(100000, 'USD'), '$1,085.00');
+  assert.equal(formatMoney(-100000, 'USD'), '-$1,085.00');
+});
+
+test('formatMoney: GBP with pound sign', () => {
+  assert.equal(formatMoney(0, 'GBP'), '£0.00');
+  assert.equal(formatMoney(100000, 'GBP'), '£842.50');
+  assert.equal(formatMoney(-100000, 'GBP'), '-£842.50');
+});
+
+test('formatMoney: includes thousands separators in any currency', () => {
+  assert.equal(formatMoney(10000000, 'EUR'), '€100,000.00');
+  assert.equal(formatMoney(10000000, 'USD'), '$108,500.00');
+  assert.equal(formatMoney(10000000, 'GBP'), '£84,250.00');
+});
+
+test('formatMoney: converts EUR to target currency', () => {
+  const usd = formatMoney(100, 'USD');
+  assert.match(usd, /\$1\.09/);
+  const gbp = formatMoney(100, 'GBP');
+  assert.match(gbp, /£0\.84/);
+});
+
+test('formatMoney: handles unknown currency', () => {
+  assert.equal(formatMoney(10000, 'JPY'), 'Unknown currency');
+});
