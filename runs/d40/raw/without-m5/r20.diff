diff --git a/src/money.js b/src/money.js
index fadf486..9e0de42 100644
--- a/src/money.js
+++ b/src/money.js
@@ -39,3 +39,51 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Exchange rates: units of that currency per euro.
+ */
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
+/**
+ * Convert euro cents to another currency.
+ * @param {number} cents Amount in euro cents
+ * @param {string} currency Currency code (EUR, USD, GBP)
+ * @returns {import('./result.js').Result}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const euros = cents / 100;
+  const converted = euros * RATES[currency];
+  const convertedCents = Math.round(converted * 100);
+
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents in a given currency for people: 123456 EUR -> "€1,234.56", 123456 USD -> "$1,338.59".
+ * @param {number} cents Amount in euro cents
+ * @param {string} currency Currency code (EUR, USD, GBP)
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  const result = convert(cents, currency);
+  if (!result.ok) {
+    return 'Unknown currency';
+  }
+
+  const convertedCents = result.value;
+  const sign = convertedCents < 0 ? '-' : '';
+  const abs = Math.abs(convertedCents);
+  const units = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+  const symbol = currency === 'USD' ? '$' : currency === 'GBP' ? '£' : '€';
+
+  return `${sign}${symbol}${units}.${String(abs % 100).padStart(2, '0')}`;
+}
