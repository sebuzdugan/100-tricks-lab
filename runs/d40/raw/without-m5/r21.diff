+test('mergeCustomers removes source customer and updates invoices', () => {
+  const customers = [
+    { id: 'C-001', name: 'Alice', email: 'alice@example.com', country: 'US', tier: 'gold' },
+    { id: 'C-002', name: 'Bob', email: 'bob@example.com', country: 'UK', tier: 'silver' },
+    { id: 'C-003', name: 'Charlie', email: 'charlie@example.com', country: 'FR', tier: 'standard' },
+  ];
+  const invoices = [
+    { customerId: 'C-001', number: 'INV-001', status: 'issued' },
+    { customerId: 'C-002', number: 'INV-002', status: 'issued' },
+    { customerId: 'C-001', number: 'INV-003', status: 'draft' },
+  ];
+
+  const result = mergeCustomers(customers, invoices, 'C-001', 'C-002');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customers.length, 2);
+  assert.equal(result.value.customers.find((c) => c.id === 'C-001'), undefined);
+  assert.equal(result.value.invoices.filter((inv) => inv.customerId === 'C-002').length, 3);
+  assert.equal(result.value.invoices.find((inv) => inv.number === 'INV-001').customerId, 'C-002');
+  assert.equal(result.value.invoices.find((inv) => inv.number === 'INV-003').customerId, 'C-002');
+});
