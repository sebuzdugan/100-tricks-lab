+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, lineDiscount, lineVat, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal calculates qty times unitPrice', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  assert.equal(lineTotal(line), 5000);
+});
+
+test('lineTotal with qty 1', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 500 }), 500);
+});
+
+test('lineTotal with large qty and price', () => {
+  assert.equal(lineTotal({ qty: 100, unitPrice: 50000 }), 5000000);
+});
+
+test('lineTotal with single cent price', () => {
+  assert.equal(lineTotal({ qty: 1, unitPrice: 1 }), 1);
+});
+
+test('lineTotal does not mutate line', () => {
+  const line = { qty: 5, unitPrice: 1000 };
+  lineTotal(line);
+  assert.deepEqual(line, { qty: 5, unitPrice: 1000 });
+});
+
+test('lineDiscount without discount field defaults to 0', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000 }), 0);
+});
+
+test('lineDiscount with 0 percent discount', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 0 }), 0);
+});
+
+test('lineDiscount with 10 percent discount', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 10 }), 10000);
+});
+
+test('lineDiscount with 50 percent discount', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 50 }), 50000);
+});
+
+test('lineDiscount with 100 percent discount', () => {
+  assert.equal(lineDiscount({ qty: 100, unitPrice: 1000, discountPercent: 100 }), 100000);
+});
+
+test('lineDiscount with decimal discount', () => {
+  assert.equal(lineDiscount({ qty: 50, unitPrice: 2000, discountPercent: 2.5 }), 2500);
+});
+
+test('lineVat without vatRate defaults to 0', () => {
+  assert.equal(lineVat({ qty: 100, unitPrice: 1000 }), 0);
+});
+
+test('lineVat with 0% VAT', () => {
+  assert.equal(lineVat({ qty: 100, unitPrice: 1000, vatRate: 0 }), 0);
+});
+
+test('lineVat with 9% VAT', () => {
+  const vat = lineVat({ qty: 100, unitPrice: 1000, vatRate: 9 });
+  assert.equal(vat, 9000);
+});
+
+test('lineVat with 21% VAT', () => {
+  const vat = lineVat({ qty: 100, unitPrice: 1000, vatRate: 21 });
+  assert.equal(vat, 21000);
+});
+
+test('lineVat calculated on amount after discount', () => {
+  const vat = lineVat({ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 10 });
+  assert.equal(vat, 9000);
+});
+
+test('lineVat with 100% discount and VAT results in 0', () => {
+  assert.equal(lineVat({ qty: 100, unitPrice: 1000, discountPercent: 100, vatRate: 21 }), 0);
+});
+
+test('lineVat rounds to nearest cent', () => {
+  const vat = lineVat({ qty: 3, unitPrice: 100, vatRate: 9 });
+  assert.equal(vat, 27);
+});
+
+test('invoiceTotals with single line', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 9 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 900);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 10900);
+});
+
+test('invoiceTotals with multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 9 },
+      { qty: 5, unitPrice: 2000, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 20000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 3000);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 23000);
+});
+
+test('invoiceTotals with empty lines array', () => {
+  const invoice = { lines: [] };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 0);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 0);
+  assert.equal(result.voucher, 0);
+  assert.equal(result.total, 0);
+});
+
+test('invoiceTotals does not mutate invoice', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 9 }],
+  };
+  const copy = JSON.parse(JSON.stringify(invoice));
+  invoiceTotals(invoice);
+  assert.deepEqual(invoice, copy);
+});
+
+test('invoiceTotals with large amounts', () => {
+  const invoice = {
+    lines: [{ qty: 1000, unitPrice: 100000, vatRate: 21 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 100000000);
+  assert.equal(result.vat, 21000000);
+  assert.equal(result.total, 121000000);
+});
+
+test('invoiceTotals returns discount field', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 9 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.discount, 10000);
+});
+
+test('invoiceTotals without discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 1000, vatRate: 9 },
+      { qty: 5, unitPrice: 2000, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 20000);
+  assert.equal(result.discount, 0);
+  assert.equal(result.vat, 3000);
+  assert.equal(result.total, 23000);
+});
+
+test('invoiceTotals with single line discount', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, discountPercent: 5, vatRate: 9 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 100000);
+  assert.equal(result.discount, 5000);
+  assert.equal(result.vat, 8550);
+  assert.equal(result.total, 103550);
+});
+
+test('invoiceTotals with multiple line discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 5, vatRate: 9 },
+      { qty: 50, unitPrice: 2000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 200000);
+  assert.equal(result.discount, 15000);
+  assert.equal(result.vat, 27450);
+  assert.equal(result.total, 212450);
+});
+
+test('invoiceTotals with 100 percent discount on one line', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 100, vatRate: 9 },
+      { qty: 50, unitPrice: 2000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 200000);
+  assert.equal(result.discount, 100000);
+  assert.equal(result.vat, 21000);
+  assert.equal(result.total, 121000);
+});
+
+test('invoiceTotals with all discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 100, unitPrice: 1000, discountPercent: 10, vatRate: 9 },
+      { qty: 50, unitPrice: 2000, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 200000);
+  assert.equal(result.discount, 15000);
+  assert.equal(result.vat, 28050);
+  assert.equal(result.total, 213050);
+});
+
+test('invoiceTotals includes voucher field', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 9 }],
+    voucher: { code: 'SAVE10', amount: 5000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.voucher, 5000);
+});
+
+test('invoiceTotals with voucher subtracts from total', () => {
+  const invoice = {
+    lines: [{ qty: 100, unitPrice: 1000, vatRate: 9 }],
+    voucher: { code: 'SAVE10', amount: 5000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 100000);
+  assert.equal(result.vat, 9000);
+  assert.equal(result.voucher, 5000);
+  assert.equal(result.total, 104000);
+});
+
+test('invoiceTotals with voucher larger than subtotal+vat still clamps to zero', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, vatRate: 9 }],
+    voucher: { code: 'FREE', amount: 50000 },
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.total, 0);
+});
+
+test('amounts are clamped to zero (no negatives)', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 150, vatRate: -50 }],
+  };
+  const result = invoiceTotals(invoice);
+  assert.equal(result.subtotal, 10000);
+  assert.equal(result.vat, 0);
+  assert.equal(result.total, 0);
+});
