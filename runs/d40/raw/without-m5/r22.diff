+/**
+ * Calculate the total for a line item (before discount).
+ * @param {{ qty: number, unitPrice: number }} line
+ * @returns {number}
+ */
+export function lineTotal(line) {
+  return Math.max(0, line.qty * line.unitPrice);
+}
+
+/**
+ * Calculate the discount amount for a line item.
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number }} line
+ * @returns {number}
+ */
+export function lineDiscount(line) {
+  const discount = lineTotal(line) * ((line.discountPercent ?? 0) / 100);
+  return Math.max(0, discount);
+}
+
+/**
+ * Calculate the VAT amount for a line item (VAT is calculated on the amount after discount).
+ * @param {{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }} line
+ * @returns {number}
+ */
+export function lineVat(line) {
+  const amountAfterDiscount = Math.max(0, lineTotal(line) - lineDiscount(line));
+  const vat = amountAfterDiscount * ((line.vatRate ?? 0) / 100);
+  return Math.round(vat);
+}
+
+/**
+ * Calculate totals for an invoice.
+ * @param {{ lines: Array<{ qty: number, unitPrice: number, discountPercent?: number, vatRate?: number }>, voucher?: { code: string, amount: number } }} invoice
+ * @returns {{ subtotal: number, discount: number, vat: number, voucher: number, total: number }}
+ */
+export function invoiceTotals(invoice) {
+  const subtotal = Math.max(0, invoice.lines.reduce((sum, line) => sum + lineTotal(line), 0));
+  const discount = Math.round(Math.max(0, invoice.lines.reduce((sum, line) => sum + lineDiscount(line), 0)));
+  const vat = Math.max(0, invoice.lines.reduce((sum, line) => sum + lineVat(line), 0));
+  const voucher = invoice.voucher ? invoice.voucher.amount : 0;
+  const total = Math.max(0, subtotal - discount + vat - voucher);
+  return {
+    subtotal,
+    discount,
+    vat,
+    voucher,
+    total,
+  };
+}
