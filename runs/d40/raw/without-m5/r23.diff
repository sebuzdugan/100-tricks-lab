+  const total = lineTotal(line);
+  const regularDiscount = total * ((line.discountPercent ?? 0) / 100);
+  const afterRegular = Math.max(0, total - regularDiscount);
+  const bulkDiscount = line.qty >= 10 ? afterRegular * 0.025 : 0;
+  const amountAfterAllDiscounts = Math.max(0, afterRegular - bulkDiscount);
+  const vat = amountAfterAllDiscounts * ((line.vatRate ?? 0) / 100);
