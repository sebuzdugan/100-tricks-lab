+/**
+ * Get dashboard metrics for invoices.
+ * @param {any[]} invoices
+ * @param {string} asOf Date in YYYY-MM-DD format
+ * @returns {{ counts: object, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  invoices.forEach(inv => {
+    counts[inv.status] = (counts[inv.status] || 0) + 1;
+  });
+
+  const outstanding = invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid')
+    .reduce((sum, inv) => sum + balanceDue(inv), 0);
+
+  const overdue_invoices = overdueInvoices(invoices, asOf);
+  const overdue = {
+    count: overdue_invoices.length,
+    amount: overdue_invoices.reduce((sum, inv) => sum + inv.due, 0),
+  };
+
+  const customerDues = new Map();
+  invoices
+    .filter(inv => inv.status === 'issued' || inv.status === 'partially_paid')
+    .forEach(inv => {
+      const due = balanceDue(inv);
+      if (due > 0) {
+        const customerId = inv.customerId;
+        customerDues.set(customerId, (customerDues.get(customerId) || 0) + due);
+      }
+    });
+
+  const topCustomers = Array.from(customerDues.entries())
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue,
+    topCustomers,
+  };
+}
