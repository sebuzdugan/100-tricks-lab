 import { formatEuros } from './money.js';
-import { lineTotal, invoiceTotals } from './totals.js';
+import { lineTotal, lineDiscount, invoiceTotals } from './totals.js';
 import { getCustomer } from './customers.js';
 
 /**
@@ -34,13 +34,34 @@ export function renderInvoiceText(invoice) {
     const unitPrice = formatEuros(line.unitPrice);
     const total = formatEuros(lineTotal(line));
     lines.push(`${qty}x ${name} @ ${unitPrice} = ${total}`);
+
+    const discount = lineDiscount(line);
+    if (discount > 0) {
+      lines.push(`  Discount: ${formatEuros(discount)}`);
+    }
   }
 
   const totals = invoiceTotals(invoice);
+
+  if (invoice.voucher) {
+    const voucherFormatted = formatEuros(invoice.voucher.amount);
+    lines.push(`Voucher: ${voucherFormatted}`);
+  }
+
   const vatFormatted = formatEuros(totals.vat);
   lines.push(`VAT: ${vatFormatted}`);
   const totalFormatted = formatEuros(totals.total);
   lines.push(`Total: ${totalFormatted}`);
 
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const paidFormatted = formatEuros(totalPaid);
+    lines.push(`Paid: ${paidFormatted}`);
+  }
+
   return lines.join('\n');
 }
