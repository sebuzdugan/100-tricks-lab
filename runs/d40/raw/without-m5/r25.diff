+test('renderInvoiceText formatting with all new features', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 100, discountPercent: 5 }],
+  });
+
+  let invoice = invoiceResult.value;
+
+  const voucherResult = applyVoucher(invoice, { code: 'HOLIDAY', amount: 10000 });
+  invoice = voucherResult.value;
+
+  const issuedResult = issueInvoice(invoice, []);
+  invoice = issuedResult.value;
+
+  const paidResult = recordPayment(invoice, { amount: 50000, date: '2025-12-20' });
+  invoice = paidResult.value;
+
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+
+  // Check order: invoice number, customer, line with discount, voucher, VAT, total, due, paid
+  let hasNumber = false;
+  let hasCustomer = false;
+  let hasDiscount = false;
+  let hasVoucher = false;
+  let hasTotal = false;
+  let hasDue = false;
+  let hasPaid = false;
+
+  for (const line of lines) {
+    if (line.includes('INV-')) hasNumber = true;
+    if (line.includes('Northwind Studio')) hasCustomer = true;
+    if (line.includes('Discount:')) hasDiscount = true;
+    if (line.includes('Voucher:')) hasVoucher = true;
+    if (line.includes('Total:')) hasTotal = true;
+    if (line.includes('Due:')) hasDue = true;
+    if (line.includes('Paid:')) hasPaid = true;
+  }
+
+  assert(hasNumber);
+  assert(hasCustomer);
+  assert(hasDiscount);
+  assert(hasVoucher);
+  assert(hasTotal);
+  assert(hasDue);
+  assert(hasPaid);
+});
