+test('renderInvoiceText shows voucher before total', () => {
+  const invoiceResult = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2025-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 1 }],
+  });
+
+  const voucherResult = applyVoucher(invoiceResult.value, { code: 'SAVE10', amount: 5000 });
+  const text = renderInvoiceText(voucherResult.value);
+  const lines = text.split('\n');
+
+  const voucherIdx = lines.findIndex(line => line.includes('Voucher:'));
+  const totalIdx = lines.findIndex(line => line.includes('Total:'));
+
+  assert(voucherIdx !== -1);
+  assert(totalIdx !== -1);
+  assert(voucherIdx < totalIdx);
+  assert(text.includes('Voucher: €50.00'));
+});
