--- /dev/null
+++ b/src/numbering.js
@@ -0,0 +1,28 @@
+/**
+ * Calculate the next free invoice number for a given year.
+ * Format: INV-<year>-<counter> where counter is 4-digit zero-padded.
+ * @param {Array<string>} existingNumbers - Invoice numbers already used (any order)
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextInvoiceNumber(existingNumbers, issueDate) {
+  // Extract year from issueDate (format: YYYY-MM-DD)
+  const year = issueDate.split('-')[0];
+
+  // Filter numbers for this year and extract their counter values
+  const yearPrefix = `INV-${year}-`;
+  const thisYearCounters = existingNumbers
+    .filter((num) => num.startsWith(yearPrefix))
+    .map((num) => {
+      const counter = num.substring(yearPrefix.length);
+      return parseInt(counter, 10);
+    });
+
+  // Find the next counter (start at 1, not 0)
+  const maxCounter = thisYearCounters.length > 0 ? Math.max(...thisYearCounters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  // Format with zero-padding to 4 digits
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `${yearPrefix}${paddedCounter}`;
+}
