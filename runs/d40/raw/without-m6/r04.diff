diff --git a/test/numbering.test.js b/test/numbering.test.js
new file mode 100644
index 0000000..741d71b
--- /dev/null
+++ b/test/numbering.test.js
@@ -0,0 +1,38 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { nextInvoiceNumber } from '../src/numbering.js';
+
+test('nextInvoiceNumber generates the first number for a year', () => {
+  assert.equal(nextInvoiceNumber([], '2023-10-15'), 'INV-2023-0001');
+});
+
+test('nextInvoiceNumber increments within the same year', () => {
+  const existing = ['INV-2023-0001', 'INV-2023-0002'];
+  assert.equal(nextInvoiceNumber(existing, '2023-10-15'), 'INV-2023-0003');
+});
+
+test('nextInvoiceNumber restarts counter for a new year', () => {
+  const existing = ['INV-2023-0001', 'INV-2023-0002', 'INV-2023-0099'];
+  assert.equal(nextInvoiceNumber(existing, '2024-01-01'), 'INV-2024-0001');
+});
+
+test('nextInvoiceNumber handles mixed years', () => {
+  const existing = ['INV-2023-0001', 'INV-2024-0001', 'INV-2024-0002', 'INV-2023-0002'];
+  assert.equal(nextInvoiceNumber(existing, '2023-06-15'), 'INV-2023-0003');
+  assert.equal(nextInvoiceNumber(existing, '2024-06-15'), 'INV-2024-0003');
+});
+
+test('nextInvoiceNumber ignores numbers from other years', () => {
+  const existing = ['INV-2022-9999', 'INV-2023-0001'];
+  assert.equal(nextInvoiceNumber(existing, '2023-10-15'), 'INV-2023-0002');
+});
+
+test('nextInvoiceNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 15 }, (_, i) => `INV-2023-${String(i + 1).padStart(4, '0')}`);
+  assert.equal(nextInvoiceNumber(existing, '2023-10-15'), 'INV-2023-0016');
+});
+
+test('nextInvoiceNumber handles unordered existing numbers', () => {
+  const existing = ['INV-2023-0005', 'INV-2023-0001', 'INV-2023-0003'];
+  assert.equal(nextInvoiceNumber(existing, '2023-10-15'), 'INV-2023-0006');
+});
