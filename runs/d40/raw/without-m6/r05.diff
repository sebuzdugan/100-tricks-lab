+import { formatEuros } from './money.js';
+import { getCustomer } from './customers.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Render an invoice as plain text.
+ * @param {{ customerId: string, number?: string, lines: Array }} invoice
+ * @returns {string}
+ */
+export function renderInvoiceText(invoice) {
+  // Get customer name
+  const customerResult = getCustomer(invoice.customerId);
+  const customerName = customerResult.ok ? customerResult.value.name : 'Unknown Customer';
+
+  // Build lines
+  const lines = [];
+
+  // Header line with invoice number or DRAFT status
+  lines.push(invoice.number || 'DRAFT');
+
+  // Customer name
+  lines.push(customerName);
+
+  // Invoice line items
+  for (const line of invoice.lines) {
+    const lineTotal = line.qty * line.unitPrice;
+    const unitPriceFormatted = formatEuros(line.unitPrice);
+    const lineTotalFormatted = formatEuros(lineTotal);
+    lines.push(`${line.qty} x ${line.name} @ ${unitPriceFormatted} = ${lineTotalFormatted}`);
+  }
+
+  // Total line
+  const totals = invoiceTotals(invoice);
+  const totalFormatted = formatEuros(totals.total);
+  lines.push(`Total: ${totalFormatted}`);
+
+  return lines.join('\n');
+}
diff --git a/test/render.test.js b/test/render.test.js
new file mode 100644
index 0000000..20988a2
--- /dev/null
+++ b/test/render.test.js
@@ -0,0 +1,154 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { renderInvoiceText } from '../src/render.js';
+import { createInvoice, issueInvoice } from '../src/invoices.js';
+
+test('renderInvoiceText shows DRAFT for unsent invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  assert.ok(text.startsWith('DRAFT'));
+});
+
+test('renderInvoiceText shows invoice number for issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = issueInvoice(r.value, []);
+  const text = renderInvoiceText(r2.value);
+  assert.ok(text.startsWith('INV-2023-0001'));
+});
+
+test('renderInvoiceText includes customer name', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.equal(lines[1], 'Northwind Studio');
+});
+
+test('renderInvoiceText formats line items with proper structure', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.ok(lines[2].includes('5 x'));
+  assert.ok(lines[2].includes('Design work (hour)'));
+  assert.ok(lines[2].includes('€85.00'));
+  assert.ok(lines[2].includes('€425.00'));
+});
+
+test('renderInvoiceText formats prices with formatEuros', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'STICKER', qty: 100 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // STICKER unitPrice is 50 cents, qty is 100, so line total is 5000 cents = €50.00
+  assert.ok(lines[2].includes('€0.50'));
+  assert.ok(lines[2].includes('€50.00'));
+});
+
+test('renderInvoiceText includes total line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  assert.ok(lines[lines.length - 1].startsWith('Total:'));
+  assert.ok(lines[lines.length - 1].includes('€425.00'));
+});
+
+test('renderInvoiceText handles multiple line items', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 2 },
+      { sku: 'ICON-SET', qty: 3 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // Line structure: DRAFT, customer, 3 items, total = 6 lines
+  assert.equal(lines.length, 6);
+  assert.ok(lines[2].includes('Design work (hour)'));
+  assert.ok(lines[3].includes('Copywriting (hour)'));
+  assert.ok(lines[4].includes('Icon set (24 icons)'));
+  // Total: 5*8500 + 2*6000 + 3*980 = 42500 + 12000 + 2940 = 57440
+  assert.ok(lines[5].includes('€574.40'));
+});
+
+test('renderInvoiceText calculates correct totals', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 10 },
+      { sku: 'DEV-HOUR', qty: 5 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // 10*8500 + 5*9500 = 85000 + 47500 = 132500 = €1,325.00
+  assert.ok(lines[lines.length - 1].includes('€1,325.00'));
+});
+
+test('renderInvoiceText shows negative amounts correctly', () => {
+  const invoice = {
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    status: 'draft',
+    lines: [
+      {
+        sku: 'DES-HOUR',
+        name: 'Design work (hour)',
+        qty: -5,
+        unitPrice: 8500,
+        vatRate: 21,
+      },
+    ],
+  };
+  const text = renderInvoiceText(invoice);
+  const lines = text.split('\n');
+  // -5 * 8500 = -42500 = -€425.00
+  assert.ok(lines[2].includes('-5 x'));
+  assert.ok(lines[2].includes('-€425.00'));
+  assert.ok(lines[lines.length - 1].includes('-€425.00'));
+});
+
+test('renderInvoiceText preserves newline structure', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 1 },
+      { sku: 'COPY-HOUR', qty: 1 },
+    ],
+  });
+  const text = renderInvoiceText(r.value);
+  const lines = text.split('\n');
+  // DRAFT, customer, item 1, item 2, total
+  assert.equal(lines.length, 5);
+  assert.equal(lines[0], 'DRAFT');
+  assert.equal(lines[1], 'Northwind Studio');
+  assert.ok(lines[2].startsWith('1 x'));
+  assert.ok(lines[3].startsWith('1 x'));
+  assert.ok(lines[4].startsWith('Total:'));
+});
