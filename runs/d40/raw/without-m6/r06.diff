+
+test('invoiceTotals with no discounts on all lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal, 54500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 54500);
+});
+
+test('addLine accepts discountPercent for new lines', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = addLine(r.value, { sku: 'COPY-HOUR', qty: 2, discountPercent: 15 });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.lines[1].discountPercent, 15);
+});
+
+test('addLine defaults discountPercent to 0 when not provided', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const r2 = addLine(r.value, { sku: 'COPY-HOUR', qty: 2 });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.lines[1].discountPercent, 0);
+});
+
+test('addLine returns DISCOUNT_INVALID for invalid discount', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.deepEqual(
+    addLine(r.value, { sku: 'COPY-HOUR', qty: 2, discountPercent: 101 }),
+    { ok: false, error: 'DISCOUNT_INVALID' }
+  );
+});
+
+test('addLine preserves existing discount when incrementing qty', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  const r2 = addLine(r.value, { sku: 'DES-HOUR', qty: 3, discountPercent: 20 });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.lines.length, 1);
+  assert.equal(r2.value.lines[0].qty, 8);
+  assert.equal(r2.value.lines[0].discountPercent, 10);
+});
