+
+test('createInvoice accepts discountPercent on a line', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 10);
+});
+
+test('createInvoice defaults discountPercent to 0', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 0);
+});
+
+test('createInvoice accepts decimal discountPercent', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 12.5 }],
+  });
+  assert.equal(r.ok, true);
+  assert.equal(r.value.lines[0].discountPercent, 12.5);
+});
+
+test('createInvoice reports DISCOUNT_INVALID for negative discount', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2023-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: -10 }],
+    }),
+    { ok: false, error: 'DISCOUNT_INVALID' }
+  );
+});
+
+test('createInvoice reports DISCOUNT_INVALID for discount > 100', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2023-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 101 }],
+    }),
+    { ok: false, error: 'DISCOUNT_INVALID' }
+  );
+});
+
+test('createInvoice reports DISCOUNT_INVALID for non-number discount', () => {
+  assert.deepEqual(
+    createInvoice({
+      customerId: 'C-001',
+      issueDate: '2023-10-15',
+      lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: '10' }],
+    }),
+    { ok: false, error: 'DISCOUNT_INVALID' }
+  );
+});
+
+test('invoiceTotals returns discount and calculates it correctly', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  const totals = invoiceTotals(r.value);
+  // Line total: 5 * 8500 = 42500
+  // Discount: 42500 * 10 / 100 = 4250
+  // Total: 42500 - 4250 = 38250
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.total, 38250);
+});
+
+test('invoiceTotals handles multiple lines with discounts', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5, discountPercent: 10 },
+      { sku: 'COPY-HOUR', qty: 2, discountPercent: 20 },
+    ],
+  });
+  const totals = invoiceTotals(r.value);
+  // DES-HOUR: 5 * 8500 = 42500, discount: 4250
+  // COPY-HOUR: 2 * 6000 = 12000, discount: 2400
+  // Subtotal: 54500
+  // Total discount: 6650
+  // Total: 47850
+  assert.equal(totals.subtotal, 54500);
+  assert.equal(totals.discount, 6650);
+  assert.equal(totals.total, 47850);
+});
+
+test('invoiceTotals handles decimal discount percentages', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 12.5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  // Line total: 5 * 8500 = 42500
+  // Discount: 42500 * 12.5 / 100 = 5312.5
+  // Total: 42500 - 5312.5 = 37187.5
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 5312.5);
+  assert.equal(totals.total, 37187.5);
+});
+
+test('invoiceTotals with 100% discount clamps total at 0', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 100 }],
+  });
+  const totals = invoiceTotals(r.value);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 42500);
+  assert.equal(totals.total, 0);
