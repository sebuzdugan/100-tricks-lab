diff --git a/test/dates.test.js b/test/dates.test.js
new file mode 100644
index 0000000..d1395d7
--- /dev/null
+++ b/test/dates.test.js
@@ -0,0 +1,123 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { isValidDate, addDays, daysBetween } from '../src/dates.js';
+
+test('isValidDate accepts valid dates', () => {
+  assert.equal(isValidDate('2023-10-15'), true);
+  assert.equal(isValidDate('2024-01-01'), true);
+  assert.equal(isValidDate('2000-12-31'), true);
+  assert.equal(isValidDate('1999-02-28'), true);
+});
+
+test('isValidDate rejects invalid format', () => {
+  assert.equal(isValidDate('10/15/2023'), false);
+  assert.equal(isValidDate('2023-1-15'), false);
+  assert.equal(isValidDate('2023-10-5'), false);
+  assert.equal(isValidDate('15-10-2023'), false);
+  assert.equal(isValidDate('2023/10/15'), false);
+  assert.equal(isValidDate('not-a-date'), false);
+});
+
+test('isValidDate rejects impossible dates', () => {
+  assert.equal(isValidDate('2023-02-30'), false);
+  assert.equal(isValidDate('2023-04-31'), false);
+  assert.equal(isValidDate('2023-13-01'), false);
+  assert.equal(isValidDate('2023-00-01'), false);
+  assert.equal(isValidDate('2023-01-00'), false);
+  assert.equal(isValidDate('2023-01-32'), false);
+});
+
+test('isValidDate handles leap years correctly', () => {
+  assert.equal(isValidDate('2024-02-29'), true);
+  assert.equal(isValidDate('2023-02-29'), false);
+  assert.equal(isValidDate('2000-02-29'), true);
+  assert.equal(isValidDate('1900-02-29'), false);
+});
+
+test('isValidDate rejects non-string input', () => {
+  assert.equal(isValidDate(''), false);
+  assert.equal(isValidDate(null), false);
+  assert.equal(isValidDate(undefined), false);
+});
+
+test('addDays adds positive days', () => {
+  assert.equal(addDays('2023-10-15', 1), '2023-10-16');
+  assert.equal(addDays('2023-10-15', 5), '2023-10-20');
+  assert.equal(addDays('2023-10-15', 30), '2023-11-14');
+});
+
+test('addDays handles month transitions', () => {
+  assert.equal(addDays('2023-10-31', 1), '2023-11-01');
+  assert.equal(addDays('2023-12-31', 1), '2024-01-01');
+  assert.equal(addDays('2023-01-31', 1), '2023-02-01');
+});
+
+test('addDays handles year transitions', () => {
+  assert.equal(addDays('2023-12-30', 2), '2024-01-01');
+  assert.equal(addDays('2023-12-31', 365), '2024-12-30');
+});
+
+test('addDays handles leap years', () => {
+  assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+  assert.equal(addDays('2024-02-29', 1), '2024-03-01');
+  assert.equal(addDays('2023-02-28', 1), '2023-03-01');
+});
+
+test('addDays subtracts negative days', () => {
+  assert.equal(addDays('2023-10-15', -1), '2023-10-14');
+  assert.equal(addDays('2023-10-15', -5), '2023-10-10');
+  assert.equal(addDays('2023-10-15', -14), '2023-10-01');
+});
+
+test('addDays handles month and year transitions backwards', () => {
+  assert.equal(addDays('2023-11-01', -1), '2023-10-31');
+  assert.equal(addDays('2024-01-01', -1), '2023-12-31');
+  assert.equal(addDays('2023-03-01', -1), '2023-02-28');
+});
+
+test('daysBetween calculates positive differences', () => {
+  assert.equal(daysBetween('2023-10-15', '2023-10-16'), 1);
+  assert.equal(daysBetween('2023-10-15', '2023-10-20'), 5);
+  assert.equal(daysBetween('2023-10-15', '2023-11-14'), 30);
+});
+
+test('daysBetween handles same dates', () => {
+  assert.equal(daysBetween('2023-10-15', '2023-10-15'), 0);
+  assert.equal(daysBetween('2024-02-29', '2024-02-29'), 0);
+});
+
+test('daysBetween calculates negative differences', () => {
+  assert.equal(daysBetween('2023-10-16', '2023-10-15'), -1);
+  assert.equal(daysBetween('2023-10-20', '2023-10-15'), -5);
+  assert.equal(daysBetween('2023-11-14', '2023-10-15'), -30);
+});
+
+test('daysBetween handles month transitions', () => {
+  assert.equal(daysBetween('2023-10-31', '2023-11-01'), 1);
+  assert.equal(daysBetween('2023-11-01', '2023-10-31'), -1);
+});
+
+test('daysBetween handles year transitions', () => {
+  assert.equal(daysBetween('2023-12-31', '2024-01-01'), 1);
+  assert.equal(daysBetween('2024-01-01', '2023-12-31'), -1);
+});
+
+test('daysBetween handles leap years', () => {
+  assert.equal(daysBetween('2024-02-28', '2024-02-29'), 1);
+  assert.equal(daysBetween('2024-02-29', '2024-03-01'), 1);
+  assert.equal(daysBetween('2023-02-28', '2023-03-01'), 1);
+});
+
+test('daysBetween handles large differences', () => {
+  assert.equal(daysBetween('2023-01-01', '2024-01-01'), 365);
+  assert.equal(daysBetween('2024-01-01', '2025-01-01'), 366);
+  assert.equal(daysBetween('2023-01-01', '2023-12-31'), 364);
+});
+
+test('addDays and daysBetween are inverse operations', () => {
+  const date = '2023-10-15';
+  const n = 47;
+  const newDate = addDays(date, n);
+  assert.equal(daysBetween(date, newDate), n);
+  assert.equal(addDays(newDate, -n), date);
+});
