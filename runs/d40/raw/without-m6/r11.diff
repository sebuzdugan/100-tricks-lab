+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the amount still owed on an invoice.
+ * @param {{ lines: Array, payments?: Array<{ amount: number }> }} invoice
+ * @returns {number}
+ */
+export function balanceDue(invoice) {
+  const invoiceTotal = invoiceTotals(invoice).total;
+  const totalPaid = (invoice.payments || []).reduce((sum, p) => sum + p.amount, 0);
+  return invoiceTotal - totalPaid;
+}
+
+/**
+ * Record a payment on an issued or partially paid invoice.
+ * @param {{ status: string, lines: Array, payments?: Array }} invoice
+ * @param {{ amount: number, date: string }} payment
+ * @returns {{ ok: true, value: { status: string, lines: Array, payments: Array } } | { ok: false, error: string }}
+ */
+export function recordPayment(invoice, { amount, date }) {
+  // Validate invoice is issued or partially paid
+  if (invoice.status !== 'issued' && invoice.status !== 'partially_paid') {
+    return fail('NOT_ISSUED');
+  }
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) {
+    return fail('AMOUNT_INVALID');
+  }
+
+  // Calculate balance due
+  const balance = balanceDue(invoice);
+
+  // Check for overpayment
+  if (amount > balance) {
+    return fail('OVERPAYMENT');
+  }
+
+  // Add payment to invoice
+  const payments = invoice.payments || [];
+  const newPayments = [...payments, { amount, date }];
+
+  // Calculate new total paid
+  const totalPaid = newPayments.reduce((sum, p) => sum + p.amount, 0);
+  const invoiceTotal = invoiceTotals(invoice).total;
+
+  // Determine new status
+  let newStatus = 'partially_paid';
+  if (totalPaid >= invoiceTotal) {
+    newStatus = 'paid';
+  }
+
+  return ok({
+    ...invoice,
+    payments: newPayments,
+    status: newStatus,
+  });
+}
