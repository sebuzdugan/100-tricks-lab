+  const invoice = { ...r.value, status: 'issued' };
+
+  const result = recordPayment(invoice, { amount: 1000.5, date: '2023-10-20' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment error: AMOUNT_INVALID for zero', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = { ...r.value, status: 'issued' };
+
+  const result = recordPayment(invoice, { amount: 0, date: '2023-10-20' });
