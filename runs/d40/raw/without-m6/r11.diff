+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('recordPayment error: OVERPAYMENT when payment exceeds balance', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const invoice = { ...r.value, status: 'issued' };
+
+  const result = recordPayment(invoice, { amount: totals.total + 1, date: '2023-10-20' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment error: OVERPAYMENT after partial payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const halfAmount = Math.floor(totals.total / 2);
+  const invoice = {
+    ...r.value,
+    status: 'partially_paid',
+    payments: [{ amount: halfAmount, date: '2023-10-20' }],
+  };
+
+  const result = recordPayment(invoice, { amount: totals.total - halfAmount + 1, date: '2023-10-25' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'OVERPAYMENT');
+});
+
+test('recordPayment does not mutate original invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = { ...r.value, status: 'issued' };
+  const original = invoice;
+
+  recordPayment(invoice, { amount: 1000, date: '2023-10-20' });
+  assert.equal(original.status, 'issued');
+  assert.equal(original.payments, undefined);
+});
+
+test('balanceDue on new issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const balance = balanceDue(r.value);
+
+  assert.equal(balance, totals.total);
+});
+
+test('balanceDue after one payment', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const invoice = {
+    ...r.value,
+    payments: [{ amount: 10000, date: '2023-10-20' }],
+  };
+
+  const balance = balanceDue(invoice);
+  assert.equal(balance, totals.total - 10000);
+});
+
+test('balanceDue after multiple payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const invoice = {
+    ...r.value,
+    payments: [
+      { amount: 10000, date: '2023-10-20' },
+      { amount: 5000, date: '2023-10-25' },
+      { amount: 3000, date: '2023-10-30' },
+    ],
+  };
+
+  const balance = balanceDue(invoice);
+  assert.equal(balance, totals.total - 18000);
+});
+
+test('balanceDue returns 0 for fully paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const invoice = {
+    ...r.value,
+    payments: [{ amount: totals.total, date: '2023-10-20' }],
+  };
+
+  const balance = balanceDue(invoice);
+  assert.equal(balance, 0);
+});
+
+test('recordPayment creates payments array if missing', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = { ...r.value, status: 'issued' };
+  assert.equal(invoice.payments, undefined);
+
+  const result = recordPayment(invoice, { amount: 1000, date: '2023-10-20' });
+  assert.equal(result.ok, true);
+  assert.ok(Array.isArray(result.value.payments));
+  assert.equal(result.value.payments.length, 1);
+});
+
+test('recordPayment preserves existing payments', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = {
+    ...r.value,
+    status: 'partially_paid',
+    payments: [
+      { amount: 5000, date: '2023-10-20' },
+      { amount: 3000, date: '2023-10-25' },
+    ],
+  };
+
+  const result = recordPayment(invoice, { amount: 2000, date: '2023-10-30' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 3);
+  assert.equal(result.value.payments[0].amount, 5000);
+  assert.equal(result.value.payments[1].amount, 3000);
+  assert.equal(result.value.payments[2].amount, 2000);
+});
+
+test('recordPayment with discounted invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001', // Gold tier (5% discount)
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const invoice = { ...r.value, status: 'issued' };
+  const balance = balanceDue(invoice);
+
+  assert.equal(balance, totals.total);
+  const result = recordPayment(invoice, { amount: totals.total, date: '2023-10-20' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('balanceDue with multi-line invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [
+      { sku: 'DES-HOUR', qty: 5 },
+      { sku: 'COPY-HOUR', qty: 2 },
+    ],
+  });
+  const totals = invoiceTotals(r.value);
+  const balance = balanceDue(r.value);
+
+  assert.equal(balance, totals.total);
+});
