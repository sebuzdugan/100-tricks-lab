+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { recordPayment, balanceDue } from '../src/payments.js';
+import { createInvoice, invoiceTotals } from '../src/invoices.js';
+
+test('recordPayment records a payment on issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = r.value;
+  const issued = { ...invoice, status: 'issued' };
+
+  const result = recordPayment(issued, { amount: 2000, date: '2023-10-20' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+  assert.equal(result.value.payments.length, 1);
+  assert.equal(result.value.payments[0].amount, 2000);
+  assert.equal(result.value.payments[0].date, '2023-10-20');
+});
+
+test('recordPayment records a payment on partially_paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = {
+    ...r.value,
+    status: 'partially_paid',
+    payments: [{ amount: 10000, date: '2023-10-20' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 10000, date: '2023-10-25' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.payments.length, 2);
+  assert.equal(result.value.payments[1].amount, 10000);
+});
+
+test('recordPayment marks invoice as paid when payment covers total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const invoice = { ...r.value, status: 'issued' };
+
+  const result = recordPayment(invoice, { amount: totals.total, date: '2023-10-20' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'paid');
+});
+
+test('recordPayment stays partially_paid when payment is less than total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const invoice = { ...r.value, status: 'issued' };
+
+  const result = recordPayment(invoice, { amount: totals.total - 100, date: '2023-10-20' });
+  assert.equal(result.ok, true);
+  assert.equal(result.value.status, 'partially_paid');
+});
+
+test('recordPayment multiple payments to reach paid status', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const invoice = { ...r.value, status: 'issued' };
+
+  const r1 = recordPayment(invoice, { amount: totals.total / 2, date: '2023-10-20' });
+  assert.equal(r1.ok, true);
+  assert.equal(r1.value.status, 'partially_paid');
+  assert.equal(r1.value.payments.length, 1);
+
+  const r2 = recordPayment(r1.value, { amount: totals.total / 2, date: '2023-10-25' });
+  assert.equal(r2.ok, true);
+  assert.equal(r2.value.status, 'paid');
+  assert.equal(r2.value.payments.length, 2);
+});
+
+test('recordPayment error: NOT_ISSUED on draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const invoice = r.value; // status is 'draft'
+
+  const result = recordPayment(invoice, { amount: 1000, date: '2023-10-20' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment error: NOT_ISSUED on paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const totals = invoiceTotals(r.value);
+  const invoice = {
+    ...r.value,
+    status: 'paid',
+    payments: [{ amount: totals.total, date: '2023-10-20' }],
+  };
+
+  const result = recordPayment(invoice, { amount: 100, date: '2023-10-25' });
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('recordPayment error: AMOUNT_INVALID for non-integer', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
