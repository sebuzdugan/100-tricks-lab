+    const year = parseInt(yearStr, 10);
+    const month = parseInt(monthStr, 10);
+    const lastDay = new Date(Date.UTC(year, month, 0)).getUTCDate();
+    dueDate = `${yearStr}-${monthStr}-${String(lastDay).padStart(2, '0')}`;
