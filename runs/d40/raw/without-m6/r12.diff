   // Validate issueDate is a real date in YYYY-MM-DD format
   if (!isValidDate(issueDate)) return fail('DATE_INVALID');
 
+  // Validate and calculate dueDate based on terms
+  const validTerms = ['NET14', 'NET30', 'EOM'];
+  if (!validTerms.includes(terms)) return fail('TERMS_INVALID');
+
+  let dueDate;
+  if (terms === 'NET14') {
+    dueDate = addDays(issueDate, 14);
+  } else if (terms === 'NET30') {
+    dueDate = addDays(issueDate, 30);
+  } else if (terms === 'EOM') {
