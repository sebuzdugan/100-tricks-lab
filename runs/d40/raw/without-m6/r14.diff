+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { statement } from '../src/statements.js';
+import { createInvoice, issueInvoice, applyVoucher, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('statement with no invoices', () => {
+  const result = statement('C-001', [], '2023-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.invoices.length, 0);
+  assert.equal(result.value.totalDue, 0);
+});
+
+test('statement with single issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const invoices = [issued.value];
+
+  const result = statement('C-001', invoices, '2023-12-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].number, 'INV-2023-0001');
+  assert.equal(result.value.invoices[0].issueDate, '2023-10-15');
+  assert.ok(result.value.invoices[0].total > 0);
+  assert.equal(result.value.totalDue, result.value.invoices[0].due);
+});
+
+test('statement filters invoices by issueDate', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(r1.value, []);
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-11-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued2 = issueInvoice(r2.value, ['INV-2023-0001']);
+  const invoices = [issued1.value, issued2.value];
+
+  const result = statement('C-001', invoices, '2023-11-01');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 1);
+  assert.equal(result.value.invoices[0].issueDate, '2023-10-15');
+});
+
+test('statement includes invoices up to and including asOf date', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(r1.value, []);
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-31',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued2 = issueInvoice(r2.value, ['INV-2023-0001']);
+  const invoices = [issued1.value, issued2.value];
+
+  const result = statement('C-001', invoices, '2023-10-31');
+  assert.equal(result.ok, true);
+  assert.equal(result.value.invoices.length, 2);
+});
+
+test('statement excludes invoices after asOf date', () => {
