+import { ok, fail } from './result.js';
+import { invoiceTotals } from './invoices.js';
+
+/**
+ * Calculate the next free credit note number for a given year.
+ * Format: CN-<year>-<counter> where counter is 4-digit zero-padded.
+ * @param {Array<string>} existingNumbers - Numbers already used (invoice or credit note numbers)
+ * @param {string} issueDate - Date in YYYY-MM-DD format
+ * @returns {string}
+ */
+export function nextCreditNoteNumber(existingNumbers, issueDate) {
+  // Extract year from issueDate (format: YYYY-MM-DD)
+  const year = issueDate.split('-')[0];
+
+  // Filter numbers for this year and extract their counter values
+  const yearPrefix = `CN-${year}-`;
+  const thisYearCounters = existingNumbers
+    .filter((num) => num.startsWith(yearPrefix))
+    .map((num) => {
+      const counter = num.substring(yearPrefix.length);
+      return parseInt(counter, 10);
+    });
+
+  // Find the next counter (start at 1, not 0)
+  const maxCounter = thisYearCounters.length > 0 ? Math.max(...thisYearCounters) : 0;
+  const nextCounter = maxCounter + 1;
+
+  // Format with zero-padding to 4 digits
+  const paddedCounter = String(nextCounter).padStart(4, '0');
+  return `${yearPrefix}${paddedCounter}`;
+}
+
+/**
+ * Create a credit note for an issued invoice.
+ * @param {{ status: string, number: string, customerId: string, lines: Array }} invoice
+ * @param {{ amount: number, reason: string, date: string }} creditNote
+ * @param {Array<string>} existingNumbers - Numbers already assigned (invoice or credit note)
+ * @returns {{ ok: true, value: { number: string, invoiceNumber: string, customerId: string, amount: number, reason: string, date: string } } | { ok: false, error: string }}
+ */
+export function createCreditNote(invoice, { amount, reason, date }, existingNumbers) {
+  // Validate invoice is issued or later (not draft)
+  if (invoice.status === 'draft') return fail('NOT_ISSUED');
+
+  // Validate amount is a positive integer
+  if (!Number.isInteger(amount) || amount <= 0) return fail('AMOUNT_INVALID');
+
+  // Validate amount is not more than invoice total
+  const invoiceTotal = invoiceTotals(invoice).total;
+  if (amount > invoiceTotal) return fail('CREDIT_TOO_HIGH');
+
+  // Generate the next credit note number
+  const number = nextCreditNoteNumber(existingNumbers, date);
+
+  return ok({
+    number,
+    invoiceNumber: invoice.number,
+    customerId: invoice.customerId,
+    amount,
+    reason,
+    date,
+  });
+}
