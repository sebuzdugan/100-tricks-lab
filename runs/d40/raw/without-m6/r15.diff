+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = createCreditNote(issued.value, { amount: 10000, reason: 'Partial refund', date: '2023-10-20' }, []);
+  assert.equal(result.ok, true);
+  assert.ok(result.value.amount <= totals.total);
+});
