+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createCreditNote, nextCreditNoteNumber } from '../src/credits.js';
+import { createInvoice, issueInvoice, invoiceTotals } from '../src/invoices.js';
+import { recordPayment } from '../src/payments.js';
+
+test('createCreditNote on issued invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Damaged', date: '2023-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2023-0001');
+  assert.equal(result.value.invoiceNumber, 'INV-2023-0001');
+  assert.equal(result.value.customerId, 'C-001');
+  assert.equal(result.value.amount, 1000);
+  assert.equal(result.value.reason, 'Damaged');
+  assert.equal(result.value.date, '2023-10-20');
+});
+
+test('createCreditNote on partially_paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const partial = recordPayment(issued.value, { amount: 10000, date: '2023-10-18' });
+
+  const result = createCreditNote(partial.value, { amount: 500, reason: 'Discount', date: '2023-10-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2023-0001');
+});
+
+test('createCreditNote on paid invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+  const paid = recordPayment(issued.value, { amount: totals.total, date: '2023-10-18' });
+
+  const result = createCreditNote(paid.value, { amount: 500, reason: 'Refund', date: '2023-10-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2023-0001');
+});
+
+test('createCreditNote error: NOT_ISSUED on draft invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const result = createCreditNote(r.value, { amount: 1000, reason: 'Test', date: '2023-10-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'NOT_ISSUED');
+});
+
+test('createCreditNote error: AMOUNT_INVALID for non-integer', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000.5, reason: 'Test', date: '2023-10-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote error: AMOUNT_INVALID for zero', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 0, reason: 'Test', date: '2023-10-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote error: AMOUNT_INVALID for negative', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: -1000, reason: 'Test', date: '2023-10-20' }, []);
+
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'AMOUNT_INVALID');
+});
+
+test('createCreditNote error: CREDIT_TOO_HIGH', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = createCreditNote(issued.value, { amount: totals.total + 1, reason: 'Test', date: '2023-10-20' }, []);
+  assert.equal(result.ok, false);
+  assert.equal(result.error, 'CREDIT_TOO_HIGH');
+});
+
+test('createCreditNote with amount equal to invoice total', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = createCreditNote(issued.value, { amount: totals.total, reason: 'Full refund', date: '2023-10-20' }, []);
+  assert.equal(result.ok, true);
+  assert.equal(result.value.amount, totals.total);
+});
+
+test('nextCreditNoteNumber generates first number for a year', () => {
+  const number = nextCreditNoteNumber([], '2023-10-15');
+  assert.equal(number, 'CN-2023-0001');
+});
+
+test('nextCreditNoteNumber increments within the same year', () => {
+  const existing = ['CN-2023-0001', 'CN-2023-0002'];
+  const number = nextCreditNoteNumber(existing, '2023-10-20');
+  assert.equal(number, 'CN-2023-0003');
+});
+
+test('nextCreditNoteNumber restarts counter for a new year', () => {
+  const existing = ['CN-2023-0001', 'CN-2023-0002'];
+  const number = nextCreditNoteNumber(existing, '2024-01-15');
+  assert.equal(number, 'CN-2024-0001');
+});
+
+test('nextCreditNoteNumber ignores invoice numbers', () => {
+  const existing = ['INV-2023-0001', 'INV-2023-0002'];
+  const number = nextCreditNoteNumber(existing, '2023-10-15');
+  assert.equal(number, 'CN-2023-0001');
+});
+
+test('nextCreditNoteNumber ignores credit note numbers from other years', () => {
+  const existing = ['CN-2022-0001', 'CN-2022-0002', 'CN-2023-0001'];
+  const number = nextCreditNoteNumber(existing, '2023-10-15');
+  assert.equal(number, 'CN-2023-0002');
+});
+
+test('nextCreditNoteNumber handles mixed invoice and credit note numbers', () => {
+  const existing = ['INV-2023-0001', 'CN-2023-0001', 'INV-2023-0002', 'CN-2023-0002'];
+  const number = nextCreditNoteNumber(existing, '2023-10-15');
+  assert.equal(number, 'CN-2023-0003');
+});
+
+test('nextCreditNoteNumber pads counter to 4 digits', () => {
+  const existing = Array.from({ length: 9999 }, (_, i) => `CN-2023-${String(i + 1).padStart(4, '0')}`);
+  const number = nextCreditNoteNumber(existing, '2023-12-31');
+  assert.equal(number, 'CN-2023-10000');
+});
+
+test('nextCreditNoteNumber handles unordered existing numbers', () => {
+  const existing = ['CN-2023-0003', 'CN-2023-0001', 'CN-2023-0002'];
+  const number = nextCreditNoteNumber(existing, '2023-10-15');
+  assert.equal(number, 'CN-2023-0004');
+});
+
+test('createCreditNote increments counter correctly', () => {
+  const r1 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued1 = issueInvoice(r1.value, []);
+
+  const r2 = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-20',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued2 = issueInvoice(r2.value, ['INV-2023-0001']);
+
+  const credit1 = createCreditNote(issued1.value, { amount: 1000, reason: 'Damaged', date: '2023-10-16' }, []);
+  assert.equal(credit1.value.number, 'CN-2023-0001');
+
+  const credit2 = createCreditNote(issued2.value, { amount: 1000, reason: 'Damaged', date: '2023-10-21' }, ['CN-2023-0001']);
+  assert.equal(credit2.value.number, 'CN-2023-0002');
+});
+
+test('createCreditNote with invoice from different customer', () => {
+  const r = createInvoice({
+    customerId: 'C-002',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Damaged', date: '2023-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.customerId, 'C-002');
+  assert.equal(result.value.invoiceNumber, 'INV-2023-0001');
+});
+
+test('createCreditNote with discounted invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5, discountPercent: 10 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const totals = invoiceTotals(issued.value);
+
+  const result = createCreditNote(issued.value, { amount: 5000, reason: 'Partial refund', date: '2023-10-20' }, []);
+  assert.equal(result.ok, true);
+  assert.ok(result.value.amount <= totals.total);
+});
+
+test('createCreditNote preserves reason field', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Quality complaint', date: '2023-10-20' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.reason, 'Quality complaint');
+});
+
+test('createCreditNote with different date than invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Damaged', date: '2023-11-15' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.date, '2023-11-15');
+  assert.equal(result.value.number, 'CN-2023-0001');
+});
+
+test('createCreditNote handles year boundary', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-12-15',
+    lines: [{ sku: 'DES-HOUR', qty: 5 }],
+  });
+  const issued = issueInvoice(r.value, []);
+  const result = createCreditNote(issued.value, { amount: 1000, reason: 'Damaged', date: '2024-01-15' }, []);
+
+  assert.equal(result.ok, true);
+  assert.equal(result.value.number, 'CN-2024-0001');
+});
+
+test('createCreditNote with multi-line invoice', () => {
+  const r = createInvoice({
+    customerId: 'C-001',
+    issueDate: '2023-10-15',
+    lines: [
