+import { test } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { overdueInvoices } from '../src/reports.js';
+
+test('overdueInvoices - empty invoices array', () => {
+  const result = overdueInvoices([], '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices - no overdue invoices', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'CUST1',
+      status: 'issued',
+      dueDate: '2026-10-20',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+    {
+      number: 'INV-002',
+      customerId: 'CUST2',
+      status: 'issued',
+      dueDate: '2026-10-15',
+      lines: [{ qty: 1, unitPrice: 200, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices - dueDate exactly equal to asOf is not included', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'CUST1',
+      status: 'issued',
+      dueDate: '2026-10-15',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 0);
+});
+
+test('overdueInvoices - issued invoices overdue', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'CUST1',
+      status: 'issued',
+      dueDate: '2026-10-05',
+      lines: [{ qty: 1, unitPrice: 100, discountPercent: 0, vatRate: 0 }],
+    },
+    {
+      number: 'INV-002',
+      customerId: 'CUST2',
+      status: 'issued',
+      dueDate: '2026-10-10',
+      lines: [{ qty: 1, unitPrice: 200, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+
+  const result = overdueInvoices(invoices, '2026-10-15');
+  assert.equal(result.length, 2);
+  assert.equal(result[0].number, 'INV-001');
+  assert.equal(result[0].daysOverdue, 10);
+  assert.equal(result[0].due, 100);
+  assert.equal(result[1].number, 'INV-002');
+  assert.equal(result[1].daysOverdue, 5);
+  assert.equal(result[1].due, 200);
+});
+
+test('overdueInvoices - partially paid invoices overdue', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'CUST1',
+      status: 'partially_paid',
+      dueDate: '2026-10-05',
+      lines: [{ qty: 1, unitPrice: 300, discountPercent: 0, vatRate: 0 }],
+      payments: [{ amount: 100, date: '2026-10-02' }],
+    },
