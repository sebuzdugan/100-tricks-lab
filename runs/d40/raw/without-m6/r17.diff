 /**
  * List overdue invoices.
@@ -24,3 +25,34 @@ export function overdueInvoices(invoices, asOf) {
 
   return overdue;
 }
+
+/**
+ * Summarize VAT by rate.
+ * @param {Array} invoices
+ * @returns {Array<{ rate: number, base: number, vat: number }>} sorted by rate high to low
+ */
+export function vatSummary(invoices) {
+  const vatByRate = {};
+
+  for (const invoice of invoices) {
+    if (!['issued', 'partially_paid', 'paid'].includes(invoice.status)) {
+      continue;
+    }
+
+    for (const line of invoice.lines) {
+      const rate = line.vatRate ?? 0;
+      const lineSubtotal = line.qty * line.unitPrice;
+      const discount = lineSubtotal * (line.discountPercent ?? 0) / 100;
+      const base = lineSubtotal - discount;
+      const vat = roundCents(base * rate / 100);
+
+      if (!vatByRate[rate]) {
+        vatByRate[rate] = { rate, base: 0, vat: 0 };
+      }
+      vatByRate[rate].base += base;
+      vatByRate[rate].vat += vat;
+    }
+  }
+
+  return Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
+}
