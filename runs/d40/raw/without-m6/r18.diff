@@ -56,3 +56,22 @@ export function vatSummary(invoices) {
 
   return Object.values(vatByRate).sort((a, b) => b.rate - a.rate);
 }
+
+/**
+ * Calculate late fee on an invoice.
+ * 0.04% of amount due for each day overdue, 0 if not overdue.
+ * @param {{ dueDate: string, lines: Array, payments?: Array }} invoice
+ * @param {string} asOf YYYY-MM-DD format
+ * @returns {number}
+ */
+export function lateFee(invoice, asOf) {
+  if (invoice.dueDate >= asOf) {
+    return 0;
+  }
+
+  const daysOverdue = daysBetween(invoice.dueDate, asOf);
+  const amountDue = balanceDue(invoice);
+  const fee = roundCents(amountDue * 0.0004 * daysOverdue);
+
+  return fee;
+}
