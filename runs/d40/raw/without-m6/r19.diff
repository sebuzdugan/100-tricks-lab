+import { test } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { exportCsv } from '../src/export.js';
+
+test('exportCsv - empty invoices array', () => {
+  const csv = exportCsv([]);
+  const lines = csv.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines.length, 2); // header + final newline creates empty last line
+});
+
+test('exportCsv - single issued invoice', () => {
+  const invoices = [
+    {
+      number: 'INV-001',
+      customerId: 'C-001',
+      issueDate: '2026-10-01',
+      dueDate: '2026-10-31',
+      status: 'issued',
+      lines: [{ qty: 1, unitPrice: 10000, discountPercent: 0, vatRate: 0 }],
+    },
+  ];
+
+  const csv = exportCsv(invoices);
+  const lines = csv.split('\n');
+  assert.equal(lines[0], 'number,customer,issueDate,dueDate,status,subtotal,discount,vat,total,due');
+  assert.equal(lines[1], 'INV-001,Northwind Studio,2026-10-01,2026-10-31,issued,100.00,0.00,0.00,100.00,100.00');
+});
+
