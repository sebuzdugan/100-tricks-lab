index fadf486..4884765 100644
--- a/src/money.js
+++ b/src/money.js
@@ -1,5 +1,11 @@
 import { ok, fail } from './result.js';
 
+export const RATES = {
+  EUR: 1,
+  USD: 1.085,
+  GBP: 0.8425,
+};
+
 /**
  * Round a (possibly fractional) number of cents to a whole cent, half to even (banker's rounding):
  * 124.5 -> 124, 125.5 -> 126, 2.4 -> 2, -0.5 -> 0.
@@ -39,3 +45,55 @@ export function parseEuros(text) {
   const cents = Number((m[2] ?? '').padEnd(2, '0'));
   return ok(euros * 100 + cents);
 }
+
+/**
+ * Convert euros (cents) to another currency.
+ * @param {number} cents amount in euro cents
+ * @param {string} currency EUR, USD, or GBP
+ * @returns {{ ok: true, value: number } | { ok: false, error: string }}
+ */
+export function convert(cents, currency) {
+  if (!RATES[currency]) {
+    return fail('UNKNOWN_CURRENCY');
+  }
+
+  const rate = RATES[currency];
+  const euros = cents / 100;
+  const convertedEuros = euros * rate;
+  const convertedCents = roundCents(convertedEuros * 100);
+
+  return ok(convertedCents);
+}
+
+/**
+ * Format cents in a given currency: 123456 cents EUR -> "$1,338.68" USD.
+ * @param {number} cents
+ * @param {string} currency EUR, USD, or GBP
+ * @returns {string}
+ */
+export function formatMoney(cents, currency) {
+  if (!RATES[currency]) {
+    return 'Unknown currency';
+  }
+
+  let symbol;
+  if (currency === 'USD') {
+    symbol = '$';
+  } else if (currency === 'GBP') {
+    symbol = '£';
+  } else {
+    symbol = '€';
+  }
+
+  const convertResult = convert(cents, currency);
+  if (!convertResult.ok) {
+    return 'Unknown currency';
+  }
+
+  const convertedCents = convertResult.value;
+  const sign = convertedCents < 0 ? '-' : '';
+  const abs = Math.abs(convertedCents);
+  const amount = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
+
+  return `${sign}${symbol}${amount}.${String(abs % 100).padStart(2, '0')}`;
+}
