+
+test('RATES has EUR, USD, and GBP', () => {
+  assert.equal(RATES.EUR, 1);
+  assert.equal(RATES.USD, 1.085);
+  assert.equal(RATES.GBP, 0.8425);
+});
+
+test('convert EUR to USD', () => {
+  const result = convert(10000, 'USD');
+  assert.deepEqual(result, { ok: true, value: 10850 });
+});
+
+test('convert EUR to GBP', () => {
+  const result = convert(10000, 'GBP');
+  assert.deepEqual(result, { ok: true, value: 8425 });
+});
+
+test('convert EUR to EUR', () => {
+  const result = convert(10000, 'EUR');
+  assert.deepEqual(result, { ok: true, value: 10000 });
+});
+
+test('convert unknown currency', () => {
+  const result = convert(10000, 'JPY');
+  assert.deepEqual(result, { ok: false, error: 'UNKNOWN_CURRENCY' });
+});
+
+test('convert rounds using roundCents', () => {
+  const result = convert(12345, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 13394);
+});
+
+test('convert negative amount', () => {
+  const result = convert(-10000, 'USD');
+  assert.deepEqual(result, { ok: true, value: -10850 });
+});
+
+test('convert small amount', () => {
+  const result = convert(5, 'USD');
+  assert.equal(result.ok, true);
+  assert.equal(result.value, 5);
+});
+
+test('formatMoney EUR', () => {
