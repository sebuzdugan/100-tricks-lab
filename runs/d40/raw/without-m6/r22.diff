+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { lineTotal, invoiceTotals } from '../src/totals.js';
+
+test('lineTotal multiplies qty by unitPrice', () => {
+  assert.equal(lineTotal({ qty: 5, unitPrice: 8500 }), 42500);
+  assert.equal(lineTotal({ qty: 1, unitPrice: 1000 }), 1000);
+  assert.equal(lineTotal({ qty: 100, unitPrice: 50 }), 5000);
+});
+
+test('invoiceTotals calculates subtotal for a single line', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 5 * 8500 = 42500
+  // Discount: 42500 * 5 / 100 = 2125
+  // After discount: 40375
+  // VAT (21%): 40375 * 21 / 100 = 8478.75, rounded = 8479
+  // Total: 40375 + 8479 = 48854
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 2125);
+  assert.equal(totals.vat, 8479);
+  assert.equal(totals.total, 48854);
+});
+
+test('invoiceTotals calculates subtotal for multiple lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+      { qty: 2, unitPrice: 6000, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // DES-HOUR: 5 * 8500 = 42500, discount: 2125, after discount: 40375, VAT: 8479
+  // COPY-HOUR: 2 * 6000 = 12000, discount: 600, after discount: 11400, VAT: 2394
+  // Subtotal: 54500, Total discount: 2725, Total VAT: 10873, Total: 62648
+  assert.equal(totals.subtotal, 54500);
+  assert.equal(totals.discount, 2725);
+  assert.equal(totals.vat, 10873);
+  assert.equal(totals.total, 62648);
+});
+
+test('invoiceTotals calculates correctly with many lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 10, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+      { qty: 8, unitPrice: 9500, discountPercent: 5, vatRate: 21 },
+      { qty: 3, unitPrice: 980, discountPercent: 5, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // DES-HOUR: 10 * 8500 = 85000, discount: 4250, after: 80750, VAT: 16957.5 -> 16958
+  // DEV-HOUR: 8 * 9500 = 76000, discount: 3800, after: 72200, VAT: 15162
+  // ICON-SET: 3 * 980 = 2940, discount: 147, after: 2793, VAT: 586.53 -> 587
+  // Subtotal: 163940, Total discount: 8197, Total VAT: 32707, Total: 188450
+  assert.equal(totals.subtotal, 163940);
+  assert.equal(totals.discount, 8197);
+  assert.equal(totals.vat, 32707);
+  assert.equal(totals.total, 188450);
+});
+
+test('invoiceTotals returns a copy', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals1 = invoiceTotals(invoice);
+  totals1.subtotal = 99999;
+  const totals2 = invoiceTotals(invoice);
+  assert.equal(totals2.subtotal, 42500);
+});
+
+test('invoiceTotals returns discount and calculates it correctly', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line total: 5 * 8500 = 42500
+  // Discount: 42500 * 10 / 100 = 4250
+  // After discount: 38250
+  // VAT (21%): 38250 * 21 / 100 = 8032.5, banker's rounding to even = 8032
+  // Total: 38250 + 8032 = 46282
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.vat, 8032);
+  assert.equal(totals.total, 46282);
+});
+
+test('invoiceTotals handles multiple lines with discounts', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 },
+      { qty: 2, unitPrice: 6000, discountPercent: 20, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // DES-HOUR: 5 * 8500 = 42500, discount: 4250, after: 38250, VAT: 8032.5 -> 8032
+  // COPY-HOUR: 2 * 6000 = 12000, discount: 2400, after: 9600, VAT: 2016
+  // Subtotal: 54500, Discount: 6650, VAT: 10048, Total: 57898
+  assert.equal(totals.subtotal, 54500);
+  assert.equal(totals.discount, 6650);
+  assert.equal(totals.vat, 10048);
+  assert.equal(totals.total, 57898);
+});
+
+test('invoiceTotals handles decimal discount percentages', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 12.5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line total: 5 * 8500 = 42500
+  // Discount: 42500 * 12.5 / 100 = 5312.5
+  // After discount: 37187.5
+  // VAT (21%): 37187.5 * 21 / 100 = 7809.375, rounded = 7809
+  // Total: 37187.5 + 7809 = 44996.5
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 5312.5);
+  assert.equal(totals.vat, 7809);
+  assert.equal(totals.total, 44996.5);
+});
+
+test('invoiceTotals with 100% discount clamps total at 0', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 100, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 42500);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals with standard tier (no discount) on all lines', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 2, unitPrice: 6000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // DES-HOUR: 5 * 8500 = 42500, no discount, VAT: 8925
+  // COPY-HOUR: 2 * 6000 = 12000, no discount, VAT: 2520
+  // Subtotal: 54500, Discount: 0, VAT: 11445, Total: 65945
+  assert.equal(totals.subtotal, 54500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 11445);
+  assert.equal(totals.total, 65945);
+});
+
+test('invoiceTotals includes voucher in result', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('voucher' in totals);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals voucher is zero when no voucher applied', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 0);
+});
+
+test('invoiceTotals subtracts voucher from total', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 1000 },
+  };
+  const totalsBefore = invoiceTotals({
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+  });
+  const totalsAfter = invoiceTotals(invoice);
+
+  assert.equal(totalsAfter.voucher, 1000);
+  assert.equal(totalsAfter.total, totalsBefore.total - 1000);
+});
+
+test('invoiceTotals total formula with voucher', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+    voucher: { code: 'SAVE10', amount: 2000 },
+  };
+  const totals = invoiceTotals(invoice);
+
+  // Subtotal: 5 * 8500 = 42500
+  // Discount: 42500 * 5% = 2125
+  // After discount: 40375
+  // VAT: 40375 * 21% = 8478.75 -> 8479
+  // Total before voucher: 40375 + 8479 = 48854
+  // Total after voucher: 48854 - 2000 = 46854
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 2125);
+  assert.equal(totals.vat, 8479);
+  assert.equal(totals.voucher, 2000);
+  assert.equal(totals.total, 46854);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat - totals.voucher);
+});
+
+test('invoiceTotals clamps negative total at 0 with voucher', () => {
+  const invoiceBase = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoiceBase);
+  const voucherAmount = totals.total + 10000;
+
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+    voucher: { code: 'BIGDISCOUNT', amount: voucherAmount },
+  };
+  const totalsAfter = invoiceTotals(invoice);
+
+  assert.equal(totalsAfter.total, 0);
+});
+
+test('invoiceTotals with large voucher amounts', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 }],
+    voucher: { code: 'HUGE', amount: 999999999 },
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.voucher, 999999999);
+  assert.equal(totals.total, 0);
+});
+
+test('invoiceTotals returns vat field', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.ok('vat' in totals);
+  assert.ok('discount' in totals);
+  assert.ok('subtotal' in totals);
+  assert.ok('total' in totals);
+});
+
+test('invoiceTotals calculates VAT on line after discount', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Line subtotal: 5 * 8500 = 42500
+  // Line discount: 42500 * 10 / 100 = 4250
+  // Amount after discount: 42500 - 4250 = 38250
+  // VAT (21%): 38250 * 21 / 100 = 8032.5, banker's rounding to even = 8032
+  // Total: 42500 - 4250 + 8032 = 46282
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 4250);
+  assert.equal(totals.vat, 8032);
+  assert.equal(totals.total, 46282);
+});
+
+test('invoiceTotals with multiple lines different VAT rates', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 100, unitPrice: 50, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // DES-HOUR: 5 * 8500 = 42500, VAT: 42500 * 21 / 100 = 8925
+  // STICKER: 100 * 50 = 5000, VAT: 5000 * 21 / 100 = 1050
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat);
+});
+
+test('invoiceTotals clamps VAT at 0', () => {
+  const invoice = {
+    lines: [{ qty: 5, unitPrice: 8500, discountPercent: 100, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // After 100% discount, amount is 0, so VAT is 0
+  assert.equal(totals.vat, 0);
+});
+
+test('invoiceTotals total formula is subtotal - discount + vat', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500, discountPercent: 5, vatRate: 21 },
+      { qty: 2, unitPrice: 6000, discountPercent: 10, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.total, totals.subtotal - totals.discount + totals.vat);
+});
+
+test('invoiceTotals VAT rounded per line', () => {
+  const invoice = {
+    lines: [
+      { qty: 1, unitPrice: 8500, discountPercent: 0, vatRate: 21 },
+      { qty: 1, unitPrice: 6000, discountPercent: 0, vatRate: 21 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // Each line VAT is calculated and rounded separately
+  // DES-HOUR: 8500 * 21 / 100 = 1785
+  // COPY-HOUR: 6000 * 21 / 100 = 1260
+  // Total VAT: 1785 + 1260 = 3045
+  assert.equal(totals.vat, 3045);
+});
+
+test('invoiceTotals handles missing discountPercent and vatRate', () => {
+  const invoice = {
+    lines: [
+      { qty: 5, unitPrice: 8500 },
+    ],
+  };
+  const totals = invoiceTotals(invoice);
+  // No discount or VAT
+  assert.equal(totals.subtotal, 42500);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 42500);
+});
+
+test('invoiceTotals handles edge case with no lines', () => {
+  const invoice = {
+    lines: [],
+  };
+  const totals = invoiceTotals(invoice);
+  assert.equal(totals.subtotal, 0);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.voucher, 0);
+  assert.equal(totals.total, 0);
+});
