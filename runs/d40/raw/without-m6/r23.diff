+  // Total: 18000 - 1137.5 + 3541 = 20403.5
+  assert.equal(totals.subtotal, 18000);
+  assert.equal(totals.discount, 1137.5);
+  assert.equal(totals.vat, 3541);
+  assert.equal(totals.total, 20403.5);
+});
