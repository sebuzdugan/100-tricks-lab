+
+test('invoiceTotals applies bulk discount (2.5%) for qty >= 10', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 10 * 1000 = 10000
+  // Line discount: 10000 * 0 / 100 = 0
+  // After first discount: 10000
+  // Bulk discount (2.5%): 10000 * 2.5 / 100 = 250
+  // Total discount: 250
+  // Total: 10000 - 250 = 9750
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 250);
+  assert.equal(totals.vat, 0);
+  assert.equal(totals.total, 9750);
+});
+
+test('invoiceTotals does not apply bulk discount for qty < 10', () => {
+  const invoice = {
+    lines: [{ qty: 9, unitPrice: 1000, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 9 * 1000 = 9000
+  // No line discount, no bulk discount
+  // Total: 9000
+  assert.equal(totals.subtotal, 9000);
+  assert.equal(totals.discount, 0);
+  assert.equal(totals.total, 9000);
+});
+
+test('invoiceTotals applies bulk discount with qty = 10 exactly', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 500, discountPercent: 0, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 10 * 500 = 5000
+  // Bulk discount: 5000 * 2.5 / 100 = 125
+  assert.equal(totals.subtotal, 5000);
+  assert.equal(totals.discount, 125);
+  assert.equal(totals.total, 4875);
+});
+
+test('invoiceTotals applies bulk discount after line discount', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 0 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 10 * 1000 = 10000
+  // Line discount: 10000 * 10 / 100 = 1000
+  // After first discount: 9000
+  // Bulk discount (2.5%): 9000 * 2.5 / 100 = 225
+  // Total discount: 1000 + 225 = 1225
+  // Total: 10000 - 1225 = 8775
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1225);
+  assert.equal(totals.total, 8775);
+});
+
+test('invoiceTotals calculates VAT after both discounts', () => {
+  const invoice = {
+    lines: [{ qty: 10, unitPrice: 1000, discountPercent: 10, vatRate: 21 }],
+  };
+  const totals = invoiceTotals(invoice);
+  // Subtotal: 10 * 1000 = 10000
+  // Line discount: 10000 * 10 / 100 = 1000
+  // After first discount: 9000
+  // Bulk discount: 9000 * 2.5 / 100 = 225
+  // After all discounts: 8775
+  // VAT (21%): 8775 * 21 / 100 = 1842.75, rounded = 1843
+  // Total: 8775 + 1843 = 10618
+  assert.equal(totals.subtotal, 10000);
+  assert.equal(totals.discount, 1225);
+  assert.equal(totals.vat, 1843);
+  assert.equal(totals.total, 10618);
+});
+
