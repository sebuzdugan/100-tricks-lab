+/**
+ * Generate a dashboard summary of invoice statistics.
+ * @param {Array} invoices
+ * @param {string} asOf YYYY-MM-DD format
+ * @returns {{ counts: { draft: number, issued: number, partially_paid: number, paid: number }, outstanding: number, overdue: { count: number, amount: number }, topCustomers: Array<{ customerId: string, due: number }> }}
+ */
+export function dashboard(invoices, asOf) {
+  const counts = {
+    draft: 0,
+    issued: 0,
+    partially_paid: 0,
+    paid: 0,
+  };
+
+  let outstanding = 0;
+  const customerDue = {};
+
+  for (const invoice of invoices) {
+    counts[invoice.status] = (counts[invoice.status] ?? 0) + 1;
+
+    if (invoice.status === 'issued' || invoice.status === 'partially_paid') {
+      const due = balanceDue(invoice);
+      outstanding += due;
+
+      if (due > 0) {
+        customerDue[invoice.customerId] = (customerDue[invoice.customerId] ?? 0) + due;
+      }
+    }
+  }
+
+  const overdue = overdueInvoices(invoices, asOf);
+  const overdueAmount = overdue.reduce((sum, inv) => sum + inv.due, 0);
+
+  const topCustomers = Object.entries(customerDue)
+    .map(([customerId, due]) => ({ customerId, due }))
+    .sort((a, b) => b.due - a.due)
+    .slice(0, 3);
+
+  return {
+    counts,
+    outstanding,
+    overdue: {
+      count: overdue.length,
+      amount: overdueAmount,
+    },
+    topCustomers,
+  };
+}
