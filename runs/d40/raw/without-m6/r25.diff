@@ -26,7 +26,16 @@ export function renderInvoiceText(invoice) {
     const lineTotal = line.qty * line.unitPrice;
     const unitPriceFormatted = formatEuros(line.unitPrice);
     const lineTotalFormatted = formatEuros(lineTotal);
-    lines.push(`${line.qty} x ${line.name} @ ${unitPriceFormatted} = ${lineTotalFormatted}`);
+    let lineStr = `${line.qty} x ${line.name} @ ${unitPriceFormatted} = ${lineTotalFormatted}`;
+
+    // Add discount if present
+    if (line.discountPercent && line.discountPercent > 0) {
+      const discountAmount = lineTotal * line.discountPercent / 100;
+      const discountFormatted = formatEuros(discountAmount);
+      lineStr += ` (${line.discountPercent}% off: ${discountFormatted})`;
+    }
+
+    lines.push(lineStr);
   }
 
   // Totals
@@ -38,9 +47,27 @@ export function renderInvoiceText(invoice) {
     lines.push(`VAT: ${vatFormatted}`);
   }
 
+  // Voucher line (if present)
+  if (invoice.voucher) {
+    const voucherFormatted = formatEuros(invoice.voucher.amount);
+    lines.push(`Voucher (${invoice.voucher.code}): -${voucherFormatted}`);
+  }
+
   // Total line
   const totalFormatted = formatEuros(totals.total);
   lines.push(`Total: ${totalFormatted}`);
 
+  // Due date line (if present)
+  if (invoice.dueDate) {
+    lines.push(`Due: ${invoice.dueDate}`);
+  }
+
+  // Paid line (if there are payments)
+  if (invoice.payments && invoice.payments.length > 0) {
+    const totalPaid = invoice.payments.reduce((sum, p) => sum + p.amount, 0);
+    const paidFormatted = formatEuros(totalPaid);
+    lines.push(`Paid: ${paidFormatted}`);
+  }
+
   return lines.join('\n');
 }
