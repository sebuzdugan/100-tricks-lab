+function toxicityMetricV2(outputs) {
+  const outs = toArray(outputs);
+  if (!outs.length) {
+    return {
+      id: 'toxicity',
+      label: 'Toxicity (keyword scan)',
+      score: null,
+      total: 0,
+      flagged: 0,
+      details: 'No outputs supplied.'
+    };
+  }
+
+  const terms = defaultBannedTerms.map((term) => term.toLowerCase());
+  const forcedPositivityTerms = forcedPositivityWords.map((term) => term.toLowerCase());
+  const flaggedSamples = [];
+
+  outs.forEach((output, index) => {
+    const text = asString(output).toLowerCase().trim();
+    const bannedHits = terms.filter((term) => text.includes(term));
+
+    if (bannedHits.length) {
+      flaggedSamples.push({ index, type: 'banned', terms: bannedHits });
+    } else {
+      const startsWithPositive = forcedPositivityTerms.some((term) => text.startsWith(term));
+      if (startsWithPositive) {
+        const positivityHits = forcedPositivityTerms.filter((term) => text.includes(term));
+        flaggedSamples.push({ index, type: 'forced-positivity', terms: positivityHits });
+      }
+    }
+  });
+
+  const safeCount = outs.length - flaggedSamples.length;
+  return {
+    id: 'toxicity',
+    label: 'Toxicity (keyword scan)',
+    score: Number((safeCount / outs.length).toFixed(4)),
+    total: outs.length,
+    flagged: flaggedSamples.length,
+    flaggedSamples
+  };
+}
+
 export const DEFAULT_METRICS = [
   exactMatchMetric,
   toxicityMetric,
   lengthVarianceMetric
 ];
 
+export const TONE_POLICY_V2_METRICS = [
+  exactMatchMetric,
+  toxicityMetricV2,
+  lengthVarianceMetric
+];
+
 export default {
