+function parseThresholds(rawThresholds?: string[]): Record<string, number> {
+  const result = Object.create(null) as Record<string, number>;
+  if (!rawThresholds || rawThresholds.length === 0) {
+    return result;
+  }
+
+  for (const raw of rawThresholds) {
+    const eqIndex = raw.indexOf('=');
+    if (eqIndex === -1) {
+      throw new Error(`Malformed threshold: "${raw}". Expected format: <metric>=<number>`);
+    }
+    const metric = raw.substring(0, eqIndex);
+    const minStr = raw.substring(eqIndex + 1);
+    if (!metric || !minStr) {
+      throw new Error(`Malformed threshold: "${raw}". Expected format: <metric>=<number>`);
+    }
+    const min = Number(minStr);
+    if (Number.isNaN(min) || String(min) !== minStr) {
+      throw new Error(`Invalid threshold value for "${metric}": "${minStr}" is not a number.`);
+    }
+    if (min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value for "${metric}": ${min} is outside the range [0, 1].`);
+    }
+    result[metric] = min;
+  }
+  return result;
+}
+
+function validateThresholdMetrics(
+  thresholds: Record<string, number>,
+  evaluations: Array<{ id: string }>
+): string[] {
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+  const errors: string[] = [];
+  for (const metric of Object.keys(thresholds)) {
+    if (!validMetricIds.has(metric)) {
+      errors.push(metric);
+    }
+  }
+  return errors;
+}
