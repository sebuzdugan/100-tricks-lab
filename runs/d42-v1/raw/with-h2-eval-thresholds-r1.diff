+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { describe, expect, it, beforeEach, afterEach } from 'vitest';
+import { execSync } from 'child_process';
+
+const tmpDirs: string[] = [];
+const createTempDir = () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-cli-test-'));
+  tmpDirs.push(dir);
+  return dir;
+};
+
+const cleanup = () => {
+  while (tmpDirs.length) {
+    const dir = tmpDirs.pop();
+    if (dir) {
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  }
+};
+
+beforeEach(() => {
+  // Clear tmpDirs before each test
+  tmpDirs.length = 0;
+});
+
+afterEach(() => {
+  cleanup();
+});
+
+const runFrai = (args: string[], cwd?: string): { stdout: string; stderr: string; exitCode: number } => {
+  const cmd = `node packages/frai-cli/dist/index.js ${args.join(' ')}`;
+  const workDir = cwd || process.cwd();
+  try {
+    const stdout = execSync(cmd, {
+      cwd: workDir,
+      encoding: 'utf8',
+      stdio: ['pipe', 'pipe', 'pipe']
+    });
+    return { stdout, stderr: '', exitCode: 0 };
+  } catch (error: any) {
+    return {
+      stdout: error.stdout?.toString() || '',
+      stderr: error.stderr?.toString() || '',
+      exitCode: error.status || 1
+    };
+  }
+};
+
+describe('frai eval CLI', () => {
+  it('exit 0 with passing thresholds', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello', 'world']));
+
+    const { exitCode } = runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      '--threshold exact_match=0.5'
+    ]);
+    expect(exitCode).toBe(0);
+  });
+
+  it('exit 1 with failing thresholds', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello', 'world']));
+
+    const { exitCode } = runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      '--threshold exact_match=0.99'
+    ]);
+    expect(exitCode).toBe(1);
+  });
+
+  it('exit 2 with malformed threshold', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello']));
+
+    const { exitCode, stderr } = runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      '--threshold exact_match=0.9abc'
+    ]);
+    expect(exitCode).toBe(2);
+    expect(stderr).toContain('not a number');
+  });
+
+  it('exit 2 with threshold outside [0,1]', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello']));
+
+    const { exitCode, stderr } = runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      '--threshold exact_match=1.5'
+    ]);
+    expect(exitCode).toBe(2);
+    expect(stderr).toContain('outside the range');
+  });
+
+  it('exit 2 with unknown metric', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello']));
+
+    const { exitCode, stderr } = runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      '--threshold unknown_metric=0.5'
+    ]);
+    expect(exitCode).toBe(2);
+    expect(stderr).toContain('Unknown metric');
+  });
+
+  it('exit 2 with missing threshold value', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello']));
+
+    const { exitCode, stderr } = runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      '--threshold'
+    ]);
+    expect(exitCode).toBe(2);
+    expect(stderr).toContain('missing');
+  });
+
+  it('writes JSON report with threshold results', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    const reportPath = path.join(dir, 'report.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello']));
+
+    runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      `--report ${reportPath}`,
+      '--threshold exact_match=0.5'
+    ]);
+
+    expect(fs.existsSync(reportPath)).toBe(true);
+    const report = JSON.parse(fs.readFileSync(reportPath, 'utf8'));
+    expect(report.passed).toBeDefined();
+    expect(report.thresholds).toBeDefined();
+    expect(report.thresholds).toHaveLength(1);
+    expect(report.thresholds[0]).toHaveProperty('metric');
+    expect(report.thresholds[0]).toHaveProperty('min');
+    expect(report.thresholds[0]).toHaveProperty('score');
+    expect(report.thresholds[0]).toHaveProperty('passed');
+  });
+
+  it('writes Markdown report with Thresholds section', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    const reportPath = path.join(dir, 'report.md');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello']));
+
+    runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      `--report ${reportPath}`,
+      '--format markdown',
+      '--threshold exact_match=0.5'
+    ]);
+
+    expect(fs.existsSync(reportPath)).toBe(true);
+    const content = fs.readFileSync(reportPath, 'utf8');
+    expect(content).toContain('## Thresholds');
+    expect(content).toContain('exact_match');
+  });
+
+  it('rejects __proto__ as metric name', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello']));
+
+    const { exitCode, stderr } = runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      '--threshold __proto__=0.5'
+    ]);
+    expect(exitCode).toBe(2);
+    expect(stderr).toContain('Unknown metric');
+  });
+
+  it('does not write report on usage error', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    const reportPath = path.join(dir, 'report.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello']));
+
+    runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      `--report ${reportPath}`,
+      '--threshold exact_match=invalid'
+    ]);
+
+    expect(fs.existsSync(reportPath)).toBe(false);
+  });
+
+  it('handles multiple thresholds', () => {
+    const dir = createTempDir();
+    const outputsPath = path.join(dir, 'outputs.json');
+    const reportPath = path.join(dir, 'report.json');
+    fs.writeFileSync(outputsPath, JSON.stringify(['hello']));
+
+    runFrai([
+      'eval',
+      `--outputs ${outputsPath}`,
+      `--report ${reportPath}`,
+      '--threshold exact_match=0.5',
+      '--threshold length_variance=0.5'
+    ]);
+
+    const report = JSON.parse(fs.readFileSync(reportPath, 'utf8'));
+    expect(report.thresholds).toHaveLength(2);
+  });
+});
