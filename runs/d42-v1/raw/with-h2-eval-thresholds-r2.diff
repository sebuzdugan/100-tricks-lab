+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const eqIndex = thresholdStr.indexOf('=');
+    if (eqIndex === -1) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+      return null;
+    }
+
+    const metricId = thresholdStr.substring(0, eqIndex);
+    const minStr = thresholdStr.substring(eqIndex + 1);
+
+    if (!validMetrics.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}". Valid metrics: ${validMetrics.join(', ')}`);
+      return null;
+    }
+
+    const min = Number(minStr);
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for "${metricId}": "${minStr}". Value must be a number between 0 and 1.`);
+      return null;
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
