+function parseThreshold(thresholdStr) {
+  const match = thresholdStr.match(/^([a-zA-Z0-9_-]+)=(\d+(?:\.\d+)?)$/);
+  if (!match) {
+    return { error: 'format' };
+  }
+  const [, metricId, minStr] = match;
+  const min = Number.parseFloat(minStr);
+  if (Number.isNaN(min)) {
+    return { error: 'format' };
+  }
+  if (min < 0 || min > 1) {
+    return { error: 'range', metricId, value: min };
+  }
+  return { metricId, min };
+}
+
+export function validateThresholds(thresholdStrs, evaluations) {
+  if (!thresholdStrs || !Array.isArray(thresholdStrs)) {
+    return { valid: true, errors: [], thresholds: [] };
+  }
+
+  const errors = [];
+  const thresholds = [];
+  const knownMetricIds = evaluations.map((e) => e.id);
+
+  for (const thresholdStr of thresholdStrs) {
+    const parsed = parseThreshold(thresholdStr);
+    if (parsed.error) {
+      if (parsed.error === 'format') {
+        errors.push(`Malformed threshold: ${thresholdStr}. Expected format: <metric>=<number>`);
+      } else if (parsed.error === 'range') {
+        errors.push(`Invalid threshold for ${parsed.metricId}: ${parsed.value} is outside the range [0, 1]`);
+      }
+      continue;
+    }
+    const { metricId, min } = parsed;
+    if (!knownMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics: ${knownMetricIds.join(', ')}`);
+      continue;
+    }
+    thresholds.push({ metricId, min });
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors,
+    thresholds
+  };
+}
+
+function checkThresholds(thresholds, evaluations) {
+  const results = [];
+  for (const { metricId, min } of thresholds) {
+    const metric = evaluations.find((e) => e.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+  return results;
+}
+
 export function generateReport({
