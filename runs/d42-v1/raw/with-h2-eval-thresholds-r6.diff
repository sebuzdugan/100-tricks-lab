+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = Object.values(Eval.DEFAULT_METRICS).map((metric) => {
+    if (typeof metric === 'function') {
+      return (metric([], []) as { id: string }).id;
+    }
+    return (metric as { id: string }).id;
+  });
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: ${thresholdStr}. Expected format: <metric>=<number>`);
+      console.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const metricId = parts[0].trim();
+    const minStr = parts[1].trim();
+
+    if (!validMetrics.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`);
+      console.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (thresholds.hasOwnProperty(metricId)) {
+      log.error(`Metric ${metricId} specified multiple times. Each metric can only have one threshold.`);
+      process.exit(2);
+    }
+
+    const min = Number(minStr);
+    if (Number.isNaN(min) || minStr.trim() === '' || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
