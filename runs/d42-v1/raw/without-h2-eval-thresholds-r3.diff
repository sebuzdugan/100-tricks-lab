+function parseThresholds(thresholdStrings: string[] | undefined): { [metricId: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const VALID_METRICS = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: { [metricId: string]: number } = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: '${thresholdStr}'. Expected format: metric=value`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number(valueStr);
+
+    if (!VALID_METRICS.includes(metricId)) {
+      log.error(`Unknown metric: '${metricId}'. Valid metrics: ${VALID_METRICS.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for '${metricId}': ${valueStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
