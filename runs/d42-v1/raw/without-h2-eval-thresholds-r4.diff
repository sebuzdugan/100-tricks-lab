+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [key: string]: number } = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const threshStr of thresholdStrings) {
+    const parts = threshStr.split('=');
+    if (parts.length !== 2) {
+      throw {
+        code: 2,
+        message: `Malformed threshold: "${threshStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [metric, value] = parts;
+    const numValue = Number.parseFloat(value);
+
+    if (Number.isNaN(numValue)) {
+      throw {
+        code: 2,
+        message: `Invalid threshold value for "${metric}": "${value}" is not a number`
+      };
+    }
+
+    if (numValue < 0 || numValue > 1) {
+      throw {
+        code: 2,
+        message: `Invalid threshold value for "${metric}": ${numValue} is outside the range [0, 1]`
+      };
+    }
+
+    if (!validMetrics.includes(metric)) {
+      throw {
+        code: 2,
+        message: `Unknown metric: "${metric}". Valid metrics are: ${validMetrics.join(', ')}`
+      };
+    }
+
+    thresholds[metric] = numValue;
+  }
+
+  return thresholds;
+}
