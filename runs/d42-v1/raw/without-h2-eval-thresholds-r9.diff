+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return null;
+  }
+
+  const metricIds = new Set(evaluations.map((m) => m.id));
+  const errors = [];
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (!metricIds.has(metric)) {
+      errors.push(`Unknown metric: ${metric}. Valid metrics: ${Array.from(metricIds).join(', ')}`);
+    } else if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`Invalid threshold for ${metric}: ${min} is not between 0 and 1`);
+    }
+  }
+
+  return errors.length > 0 ? errors : null;
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const results = [];
+  let allPassed = true;
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    const evaluation = evaluations.find((m) => m.id === metric);
+    const score = evaluation?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    results.push({
+      metric,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return {
+    passed: allPassed,
+    thresholds: results
+  };
+}
