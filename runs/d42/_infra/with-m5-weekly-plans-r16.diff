diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..10e2cd3 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,17 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('weekly subscriptions work like other cycles', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-09-27').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.50 a month/);
+}));
+
+test('weekly plans show in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-09-27');
+  const r = cli(file, 'renewals', '--within', '30', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit\s+€59\.90/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..c5af12d 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,15 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 5200, cycle: 'weekly' }), 22533);
+});
+
+test('the next charge of a weekly plan is every 7 days from since', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-09-27' }, '2026-10-24'), '2026-10-25');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-09-27' }, '2026-10-26'), '2026-11-01');
+});
