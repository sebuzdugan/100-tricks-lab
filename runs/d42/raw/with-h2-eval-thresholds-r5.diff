+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const result: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=((?:\d+\.?\d*|\.\d+))$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number(minStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric ID: "${metricId}". Valid options: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold minimum: "${minStr}". Must be a number between 0 and 1`);
+      process.exit(2);
+    }
+
+    if (result[metricId] !== undefined) {
+      log.error(`Metric "${metricId}" specified multiple times in thresholds`);
+      process.exit(2);
+    }
+
+    result[metricId] = min;
+  }
+
+  return result;
+}
