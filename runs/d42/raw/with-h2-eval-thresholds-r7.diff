+function parseAndValidateThresholds(thresholdStrings: string[] | undefined): { parsed: Record<string, number>; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { parsed: {} };
+  }
+
+  const parsed: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      return {
+        parsed: {},
+        error: `Malformed threshold: '${threshold}'. Expected format: <metric>=<number> (e.g., exact_match=0.9)`
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      return {
+        parsed: {},
+        error: `Invalid threshold value for '${metricId}': ${minStr}. Minimum must be a number between 0 and 1.`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        parsed: {},
+        error: `Unknown metric: '${metricId}'. Valid metrics are: ${validMetricIds.join(', ')}.`
+      };
+    }
+
+    parsed[metricId] = min;
+  }
+
+  return { parsed };
+}
