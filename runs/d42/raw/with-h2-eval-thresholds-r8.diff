+function parseThresholds(thresholdSpecs: string[] | undefined, validMetricIds: string[]): Record<string, number> {
+  if (!thresholdSpecs || thresholdSpecs.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validIds = new Set(validMetricIds);
+
+  for (const spec of thresholdSpecs) {
+    const match = spec.match(/^([^=]+)=(.+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${spec}". Expected format: metric=min (e.g., exact_match=0.9)`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: "${minStr}" for metric "${metricId}". Minimum must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validIds.has(metricId)) {
+      log.error(`Unknown metric id: "${metricId}". Valid metric ids are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
