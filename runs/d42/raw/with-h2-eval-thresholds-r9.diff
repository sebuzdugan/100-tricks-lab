+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number> | undefined; validationError?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: undefined };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      return {
+        thresholds: undefined,
+        validationError: `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number(valueStr);
+
+    if (Number.isNaN(value) || String(value) !== valueStr || value < 0 || value > 1) {
+      return {
+        thresholds: undefined,
+        validationError: `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds };
+}
+
+function validateThresholdMetrics(
+  thresholds: Record<string, number>,
+  evaluations: Array<{ id: string }>
+): { valid: boolean; error?: string } {
+  const validMetricIds = evaluations.map((m) => m.id);
+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`
+      };
+    }
+  }
+
+  return { valid: true };
+}
