diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..bc16fb8 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,33 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('weekly cycle is known', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs its price × 52 ÷ 12 per month, rounded to the nearest cent', () => {
+  // €12.00/week: 1200 × 52 ÷ 12 = 5200 cents = €52.00
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  // €59.90/week: 5990 × 52 ÷ 12 = 25956.67 cents, rounds to 25957 = €259.57
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25957);
+});
+
+test('monthly and yearly plans also round to the nearest cent', () => {
+  // €11.99/year: 1199 ÷ 12 = 99.92 cents, rounds to 100 = €1.00
+  assert.equal(monthlyCents({ price: 1199, cycle: 'yearly' }), 100);
+  // €9.99/month: stays €9.99
+  assert.equal(monthlyCents({ price: 999, cycle: 'monthly' }), 999);
+});
+
+test('a weekly plan charges every 7 days from its first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-24'), '2026-10-29');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-08'), '2026-10-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-01'), '2026-10-01');
+});
+
+test('weekly charges advance by 7-day intervals until they reach or pass today', () => {
+  // Charges: 10-01, 10-08, 10-15, 10-22, 10-29, ...
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-22'), '2026-10-22');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-23'), '2026-10-29');
+});
