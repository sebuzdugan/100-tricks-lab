-  return Math.floor(sub.price / MONTHS_PER_CHARGE[sub.cycle]);
+  if (sub.cycle === CYCLE.WEEK) {
+    return Math.round(sub.price * 52 / 12);
+  }
+  if (sub.cycle === CYCLE.MONTH) {
+    return sub.price;
+  }
+  if (sub.cycle === CYCLE.YEAR) {
+    return Math.round(sub.price / 12);
+  }
+  return 0;
 }
 
 /**
  * The date of a plan's next charge on or after `today` ('YYYY-MM-DD').
- * Charges fall on the day of the month of the first charge (`since`), or the last day of a shorter month.
+ * Monthly charges fall on the day of the month, or the last day of a shorter month.
+ * Weekly charges fall every 7 days from the first charge.
  * @param {{ cycle: string, since: string }} sub
  * @param {string} today
  * @returns {string}
  */
 export function nextCharge(sub, today) {
-  const step = MONTHS_PER_CHARGE[sub.cycle];
+  if (sub.cycle === CYCLE.WEEK) {
+    let date = sub.since;
+    while (date < today) {
+      date = addDays(date, 7);
+    }
+    return date;
+  }
+  const monthSteps = sub.cycle === CYCLE.YEAR ? 12 : 1;
   let n = 0;
   let date = sub.since;
   while (date < today) {
     n += 1;
-    date = addMonths(sub.since, n * step);
+    date = addMonths(sub.since, n * monthSteps);
   }
   return date;
 }
