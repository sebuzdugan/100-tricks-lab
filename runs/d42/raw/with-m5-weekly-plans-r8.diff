@@ -12,13 +13,24 @@ test('a monthly plan costs its price a month', () => {
   assert.equal(monthlyCents({ price: 0, cycle: 'monthly' }), 0);
 });
 
+test('a weekly plan costs price × 52 ÷ 12 a month', () => {
+  // €1.00 per week = 100 × 52 ÷ 12 = 433.33 → 433 cents per month
+  assert.equal(monthlyCents({ price: 100, cycle: 'weekly' }), 433);
+  // €12.00 per week = 1200 × 52 ÷ 12 = 5200 cents per month
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  // €59.90 per week = 5990 × 52 ÷ 12 = 25956.67 → 25957 cents per month
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25957);
+});
+
 test('a yearly plan costs a twelfth of its price a month', () => {
   assert.equal(monthlyCents({ price: 12000, cycle: 'yearly' }), 1000);
   assert.equal(monthlyCents({ price: 2400, cycle: 'yearly' }), 200);
+  assert.equal(monthlyCents({ price: 11999, cycle: 'yearly' }), 1000);
 });
 
