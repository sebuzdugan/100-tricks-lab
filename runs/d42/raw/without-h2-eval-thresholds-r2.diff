+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: { [key: string]: number } = {};
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=(\d+\.?\d*|\.\d+)$/);
+    if (!match) {
+      log.error('Invalid threshold format.');
+      console.error(`Format: --threshold <metric>=<number>`);
+      console.error(`Example: --threshold exact_match=0.9`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const minScore = Number.parseFloat(minStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric id: ${metricId}`);
+      console.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(minScore) || minScore < 0 || minScore > 1) {
+      log.error(`Invalid threshold value: ${minStr}`);
+      console.error('Threshold must be a number between 0 and 1.');
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return thresholds;
+}
