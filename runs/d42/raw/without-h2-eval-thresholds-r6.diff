+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [] };
+  }
+
+  const errors = [];
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    if (typeof minValue !== 'number') {
+      errors.push(`Invalid threshold for ${metricId}: minimum must be a number, got ${typeof minValue}`);
+      continue;
+    }
+    if (minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold for ${metricId}: minimum must be between 0 and 1, got ${minValue}`);
+      continue;
+    }
+    if (!validMetricIds.has(metricId)) {
+      const ids = Array.from(validMetricIds).join(', ');
+      errors.push(`Unknown metric: ${metricId}. Valid metrics are: ${ids}`);
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const results = [];
+  let passed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    if (!metric) continue;
+
+    const score = metric.score ?? null;
+    const metricPassed = score !== null && score >= min;
+    if (!metricPassed) passed = false;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed: metricPassed
+    });
+  }
+
+  return { passed, thresholds: results };
+}
