+export function validateThresholds(thresholds, metrics) {
+  const metricIds = metrics.map((m) => m.id);
+  const validatedThresholds = [];
+  const errors = [];
+
+  for (const [metricId, minValue] of Object.entries(thresholds || {})) {
+    if (!metricIds.includes(metricId)) {
+      errors.push(`Unknown metric id: ${metricId}. Valid metrics: ${metricIds.join(', ')}`);
+      continue;
+    }
+    if (typeof minValue !== 'number' || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold for ${metricId}: ${minValue}. Threshold must be a number between 0 and 1.`);
+      continue;
+    }
+    validatedThresholds.push({ metric: metricId, min: minValue });
+  }
+
+  return { validatedThresholds, errors };
+}
+
+export function evaluateThresholds(thresholds, metrics) {
+  const thresholdResults = [];
+  let allPassed = true;
+
+  thresholds.forEach(({ metric: metricId, min }) => {
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score: score ?? null,
+      passed
+    });
+  });
+
+  return { thresholdResults, allPassed };
+}
