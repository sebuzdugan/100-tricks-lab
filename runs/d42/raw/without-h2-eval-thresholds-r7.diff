+function parseThresholdString(thresholdStr: string): [string, number] {
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    throw new Error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+  }
+  const [metric, valueStr] = parts;
+  const value = Number.parseFloat(valueStr);
+  if (Number.isNaN(value) || value < 0 || value > 1) {
+    throw new Error(
+      `Invalid threshold for "${metric}": "${valueStr}". Threshold must be a number between 0 and 1.`
+    );
+  }
+  return [metric, value];
+}
+
+function parseThresholds(thresholdStrings: string[] = []): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    try {
+      const [metric, value] = parseThresholdString(str);
+      thresholds[metric] = value;
+    } catch (error) {
+      log.error('Threshold parsing error.', {
+        error: error instanceof Error ? error.message : String(error)
+      });
+      process.exit(2);
+    }
+  }
+  return thresholds;
+}
