+function parseThreshold(
+  thresholdStr: string,
+  validMetricIds: string[]
+): { metric: string; min: number } {
+  const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+  if (!match) {
+    throw new Error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<min>`);
+  }
+
+  const [, metric, minStr] = match;
+  const min = Number.parseFloat(minStr);
+
+  if (!Number.isFinite(min) || min < 0 || min > 1) {
+    throw new Error(`Invalid threshold minimum: "${minStr}". Must be a number between 0 and 1.`);
+  }
+
+  if (!validMetricIds.includes(metric)) {
+    throw new Error(
+      `Unknown metric: "${metric}". Valid metrics are: ${validMetricIds.join(', ')}`
+    );
+  }
+
+  return { metric, min };
+}
