--- a/test/renewals.test.js
+++ b/test/renewals.test.js
@@ -24,3 +24,14 @@ test('lists upcoming charges soonest first, across a month boundary', () => {
 test('nothing in the window gives an empty list', () => {
   assert.deepEqual(upcoming([plan('Domain', 'yearly', '2026-03-02')], '2026-10-24'), []);
 });
+
+test('a weekly plan charges every 7 days', () => {
+  const [row] = upcoming([plan('Meal kit', 'weekly', '2026-10-17', 5990)], '2026-10-24', 7);
+  assert.deepEqual(row, { name: 'Meal kit', date: '2026-10-24', when: '24 Oct', inDays: 0, price: 5990, cycle: 'weekly' });
+});
+
+test('weekly plans appear in renewals listing', () => {
+  const subs = [plan('Gym', 'weekly', '2026-10-24'), plan('Music', 'weekly', '2026-10-25')];
+  const rows = upcoming(subs, '2026-10-24', 7);
+  assert.deepEqual(rows.map((r) => [r.name, r.date, r.inDays]), [['Gym', '2026-10-24', 0], ['Music', '2026-10-25', 1]]);
+});
