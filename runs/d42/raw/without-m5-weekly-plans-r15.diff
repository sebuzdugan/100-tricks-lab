diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..e1c0f43 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,20 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add and list weekly plans', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '12', '--every', 'week', '--since', '2026-10-19').code, 0);
+  assert.equal(cli(file, 'add', 'Gym', '9.99', '--every', 'weekly', '--since', '2026-10-20').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€12\.00 weekly\s+€52\.00 a month/);
+  assert.match(list.out, /Gym\s+€9\.99 weekly\s+€43\.29 a month/);
+  assert.equal(cli(file, 'total').out, 'Monthly total: €95.29 (2 plans)\n');
+}));
+
+test('renewals shows weekly charges', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12', '--every', 'week', '--since', '2026-10-19');
+  const r = cli(file, 'renewals', '--within', '30', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '26 Oct  Meal kit  €12.00\n');
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..6793e9f 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,14 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs price × 52 / 12 per month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1299, cycle: 'weekly' }), 5629);
+});
+
+test('the next charge of a weekly plan is every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-10' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-10' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-10' }, '2026-11-01'), '2026-11-07');
+});
