+console.log('=== List output ===');
+cli(file, 'add', 'Cloud backup', '119.99', '--every', 'year', '--since', '2026-01-31');
+console.log(cli(file, 'list').out);
+
+console.log('=== Total output ===');
+console.log(cli(file, 'total').out);
+
+console.log('\n=== Weekly plan test ===');
+cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+console.log(cli(file, 'list').out);
+console.log(cli(file, 'total').out);
+
+fs.rmSync(tmpdir, { recursive: true });
