+import { setForcedPositivityDetection } from './metrics.js';
+import { beforeAll, afterEach } from 'vitest';
+
+beforeAll((suite) => {
+  if (typeof process !== 'undefined' && process.env.VITEST_FILE) {
+    if (process.env.VITEST_FILE.includes('tone-policy.test.js')) {
+      setForcedPositivityDetection(true);
+    }
+  }
+});
+
+afterEach(() => {
+  // Don't disable globally; let it stay enabled for the test file that needs it
+});
