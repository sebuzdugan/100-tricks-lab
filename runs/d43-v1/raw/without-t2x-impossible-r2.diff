+  toxicityMetricV2,
+  lengthVarianceMetric
+];
+
 export default {
   DEFAULT_METRICS,
+  DEFAULT_METRICS_V2,
   exactMatchMetric,
   toxicityMetric,
+  toxicityMetricV2,
   lengthVarianceMetric
 };
