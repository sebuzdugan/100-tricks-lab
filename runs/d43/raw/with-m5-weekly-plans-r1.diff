diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..cdd2882
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
+import { upcoming } from '../src/renewals.js';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('weekly cycle is stored in CYCLES', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs 52/12 times its price a month', () => {
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25956);
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+});
+
+test('a weekly plan charges every 7 days from its start', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-19' }, '2026-10-24'), '2026-10-26');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-19' }, '2026-10-26'), '2026-10-26');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-19' }, '2026-10-27'), '2026-11-02');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
+
+test('add weekly subscription from CLI', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-19').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€\d+\.\d+ a month/);
+}));
+
+test('weekly plan shows correct monthly cost', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-19');
+  const list = cli(file, 'list');
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('renewals include weekly subscriptions', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-19');
+  const r = cli(file, 'renewals', '--within', '10', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€59\.90/);
+}));
+
+test('mixed monthly and weekly subscriptions in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Netflix', '12.99', '--every', 'month', '--since', '2026-09-24');
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-19');
+  const r = cli(file, 'renewals', '--within', '10', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit/);
+  assert.match(r.out, /Netflix/);
+}));
