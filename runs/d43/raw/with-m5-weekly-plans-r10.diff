diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..6c3a26b
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,70 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { monthlyCents, nextCharge } from '../src/cycles.js';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  // €12.00 per week = €52.00 per month (12 * 52 / 12 = 52)
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  // €59.90 per week = €259.57 per month (59.90 * 52 / 12 = 259.5666... → rounds to 259.57)
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25957);
+});
+
+test('the next charge of a weekly plan is 7 days from the previous charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-18' }, '2026-10-24'), '2026-10-25');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-18' }, '2026-10-25'), '2026-10-25');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-18' }, '2026-10-26'), '2026-11-01');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
+
+test('add weekly subscription via CLI', () => withFile((file) => {
+  const r = cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-18');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€59\.90 weekly.*€259\.57 a month/);
+}));
+
+test('list shows what a weekly plan costs a month', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-18');
+  assert.match(cli(file, 'list').out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('weekly subscriptions show in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-18');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '25 Oct  Meal kit  €59.90\n');
+}));
+
+test('export includes weekly subscriptions', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-18');
+  assert.match(cli(file, 'export', '--today', '2026-10-24').out, /Meal kit,59.90,weekly,259.57,2026-10-25/);
+}));
+
+test('total includes weekly subscriptions', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-18');
+  const r = cli(file, 'total');
+  assert.match(r.out, /Monthly total: €259\.56/);
+}));
