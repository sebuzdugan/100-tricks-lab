diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..ef5f6c8
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,24 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
+
+test('weekly cycle is supported', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs its price × 52 ÷ 12 a month, rounded to the nearest cent', () => {
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25957);
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1000, cycle: 'weekly' }), 4333);
+});
+
+test('the next charge of a weekly plan is 7 days from since, then every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-31'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-11-05'), '2026-11-07');
+});
+
+test('a plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
