diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..0a574ba
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,80 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
+import { upcoming } from '../src/renewals.js';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-weekly-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('weekly is a known cycle', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs its price times 52/12 per month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 599, cycle: 'weekly' }), 2596);
+});
+
+test('a weekly plan with €12/week costs €52.00/month', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '12.00', '--every', 'week', '--since', '2026-10-01').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€12\.00 weekly\s+€52\.00 a month/);
+}));
+
+test('weekly subscriptions accept week or weekly in --every', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Class', '15.00', '--every', 'week').code, 0);
+  assert.equal(cli(file, 'add', 'Cleaner', '25.00', '--every', 'weekly').code, 0);
+  const list = cli(file, 'list');
+  assert.match(list.out, /Class.*weekly/);
+  assert.match(list.out, /Cleaner.*weekly/);
+}));
+
+test('weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-01'), '2026-10-01');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-02'), '2026-10-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-08'), '2026-10-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-09'), '2026-10-15');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-24'), '2026-10-26');
+});
+
+test('renewals lists weekly plans like any other', () => withFile((file) => {
+  cli(file, 'add', 'Weekly class', '20.00', '--every', 'week', '--since', '2026-10-21');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Weekly class.*€20\.00/);
+}));
+
+test('renewals shows weekly and monthly charges in date order', () => withFile((file) => {
+  cli(file, 'add', 'Monthly', '10.00', '--every', 'month', '--since', '2026-10-05');
+  cli(file, 'add', 'Weekly', '5.00', '--every', 'week', '--since', '2026-10-21');
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-24');
+  const lines = r.out.trim().split('\n');
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0].split(/\s+/)[2], 'Weekly');
+  assert.equal(lines[1].split(/\s+/)[2], 'Monthly');
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12.00', '--every', 'week', '--since', '2026-10-01');
+  const csv = cli(file, 'export', '--today', '2026-10-24');
+  assert.match(csv.out, /Meal kit,12\.00,weekly,52\.00,2026-10-29/);
+}));
