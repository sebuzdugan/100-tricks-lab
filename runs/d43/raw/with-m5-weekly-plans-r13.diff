diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..5656a06
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
+import { upcoming } from '../src/renewals.js';
+
+test('weekly is in supported cycles', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs its price × 52 ÷ 12 a month, rounded to nearest cent', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 599, cycle: 'weekly' }), 2596);
+  assert.equal(monthlyCents({ price: 12, cycle: 'weekly' }), 52);
+});
+
+test('a weekly plan charges every 7 days from its start date', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-31'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-11-01'), '2026-11-07');
+});
+
+test('a future weekly plan next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
+
+test('weekly plans are included in renewals', () => {
+  const subs = [{ name: 'Meal kit', price: 5990, cycle: 'weekly', since: '2026-10-24' }];
+  const rows = upcoming(subs, '2026-10-25', 7);
+  assert.equal(rows.length, 1);
+  assert.equal(rows[0].name, 'Meal kit');
+  assert.equal(rows[0].date, '2026-10-31');
+});
