diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..98e8ad5
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,75 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('weekly is a known cycle', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  const monthly = monthlyCents({ price: 1200, cycle: 'weekly' });
+  assert.equal(monthly, Math.floor(1200 * 52 / 12));
+  assert.equal(monthly, 5200);
+});
+
+test('a weekly plan with price 12 euros costs 52.00 euros a month', () => {
+  const monthly = monthlyCents({ price: 1200, cycle: 'weekly' });
+  assert.equal(monthly, Math.floor(1200 * 52 / 12));
+});
+
+test('a weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-20' }, '2026-10-20'), '2026-10-20');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-20' }, '2026-10-21'), '2026-10-27');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-20' }, '2026-10-27'), '2026-10-27');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-20' }, '2026-11-03'), '2026-11-03');
+});
+
+test('add weekly subscription', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-20').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('weekly works with renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-20');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '27 Oct  Meal kit  €59.90\n');
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-20');
+  const r = cli(file, 'export', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit,59\.90,weekly,259\.57,2026-10-27/);
+}));
+
+test('weekly plan total', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-20');
+  cli(file, 'add', 'Netflix', '12.99', '--every', 'month', '--since', '2026-10-20');
+  const r = cli(file, 'total');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Monthly total: €272\.56 \(2 plans\)/);
+}));
