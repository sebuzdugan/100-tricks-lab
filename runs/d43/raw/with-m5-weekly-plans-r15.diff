diff --git a/test/weekly-cli.test.js b/test/weekly-cli.test.js
new file mode 100644
index 0000000..e5d303b
--- /dev/null
+++ b/test/weekly-cli.test.js
@@ -0,0 +1,59 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('add and list a weekly plan', () => withFile((file) => {
+  const add = cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  assert.equal(add.code, 0);
+  assert.match(add.out, /€259.57 a month/);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('total includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Netflix', '12.99', '--since', '2026-10-25');
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const total = cli(file, 'total');
+  assert.match(total.out, /Monthly total: €272\.55/);
+}));
+
+test('renewals shows weekly plan charges', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /25 Oct\s+Meal kit\s+€59\.90/);
+}));
+
+test('renewals shows weekly plan next charge', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-26');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /1 Nov\s+Meal kit\s+€59\.90/);
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  assert.equal(cli(file, 'export', '--today', '2026-10-25').out,
+    'name,price,cycle,monthly_cost,next_charge\nMeal kit,59.90,weekly,259.57,2026-10-25\n');
+}));
diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..15116f5
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,21 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { monthlyCents, nextCharge } from '../src/cycles.js';
+
+test('a weekly plan costs (price × 52 ÷ 12) a month, rounded to nearest cent', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200); // 12 × 52 ÷ 12 = 52.00
+  assert.equal(monthlyCents({ price: 599, cycle: 'weekly' }), 2596); // 5.99 × 52 ÷ 12 ≈ 25.97
+  assert.equal(monthlyCents({ price: 1, cycle: 'weekly' }), 4); // €0.01 × 52 ÷ 12 ≈ 0.0433, rounds to €0.04
+  assert.equal(monthlyCents({ price: 101, cycle: 'weekly' }), 438); // €1.01 × 52 ÷ 12 ≈ 4.37..., rounds to €4.38
+});
+
+test('a weekly plan charges every 7 days from the first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-25' }, '2026-10-25'), '2026-10-25');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-25' }, '2026-10-26'), '2026-11-01');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-25' }, '2026-11-01'), '2026-11-01');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-25' }, '2026-11-02'), '2026-11-08');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
