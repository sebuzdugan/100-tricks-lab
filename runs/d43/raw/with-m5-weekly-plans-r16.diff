diff --git a/test/weekly-cli.test.js b/test/weekly-cli.test.js
new file mode 100644
index 0000000..9b4a883
--- /dev/null
+++ b/test/weekly-cli.test.js
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('add and list a weekly plan', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('renewals shows weekly plan next charge', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '30', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€59\.90/);
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'export', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit,59\.90,weekly,259\.57,2026-10-24/);
+}));
+
+test('total includes weekly plans correctly', () => withFile((file) => {
+  cli(file, 'add', 'Netflix', '12.99', '--since', '2026-10-24');
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'total');
+  // Netflix: €12.99 monthly = €12.99 a month (1299 cents)
+  // Meal kit: €59.90 weekly = 5990 * 52/12 = 25955.67... cents
+  // Sum: 1299 + 25955.67 = 27254.67, floored to 27254 = €272.54
+  // (Actually 5990 * 52 / 12 = 311480 / 12 = 25956.67, so 1299 + 25956.67 = 27255.67, floored to 27255 = €272.55)
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Monthly total: €272\.55 \(2 plans\)/);
+}));
diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..da5941c
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,25 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { monthlyCents, nextCharge } from '../src/cycles.js';
+
+test('a weekly plan costs 52/12 of its price a month, rounded to nearest cent', () => {
+  // €12.00 a week × 52 weeks ÷ 12 months = €52.00 a month
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  // €59.90 a week × 52 weeks ÷ 12 months ≈ €259.57 a month
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25957);
+});
+
+test('the next charge of a weekly plan that charges today is today', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
+
+test('a weekly plan charges every 7 days from the first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-31'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-11-01'), '2026-11-07');
+});
