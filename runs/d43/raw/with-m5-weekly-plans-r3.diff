diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..43c7fd8
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,80 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('weekly cycle is supported', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs price × 52 ÷ 12 per month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1299, cycle: 'weekly' }), 5629);
+  assert.equal(monthlyCents({ price: 500, cycle: 'weekly' }), 2167);
+  assert.equal(monthlyCents({ price: 0, cycle: 'weekly' }), 0);
+});
+
+test('weekly charges every 7 days from the first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-31'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-11-01'), '2026-11-07');
+});
+
+test('subtrack add accepts --every week', () => withFile((file) => {
+  const r = cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Added Meal kit/);
+}));
+
+test('subtrack add accepts --every weekly', () => withFile((file) => {
+  const r = cli(file, 'add', 'Cleaner', '50', '--every', 'weekly', '--since', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Added Cleaner/);
+}));
+
+test('list shows weekly plans with monthly cost', () => withFile((file) => {
+  cli(file, 'add', 'Class', '25.00', '--every', 'week', '--since', '2026-10-24');
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Class\s+€25\.00 weekly\s+€108\.33 a month/);
+}));
+
+test('total includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  cli(file, 'add', 'Netflix', '12.99', '--every', 'month', '--since', '2026-10-24');
+  const total = cli(file, 'total');
+  assert.equal(total.code, 0);
+  assert.match(total.out, /Monthly total: €272\.55/);
+}));
+
+test('renewals shows weekly plan charges', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /24 Oct\s+Meal kit\s+€59\.90/);
+}));
+
+test('yearly plans continue to use floor (not round)', () => {
+  assert.equal(monthlyCents({ price: 11999, cycle: 'yearly' }), 999);
+});
