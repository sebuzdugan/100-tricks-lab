diff --git a/test/cli-weekly.test.js b/test/cli-weekly.test.js
new file mode 100644
index 0000000..fed0f40
--- /dev/null
+++ b/test/cli-weekly.test.js
@@ -0,0 +1,67 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('add and list weekly plan', () => withFile((file) => {
+  const add = cli(file, 'add', 'Meal kit', '59.90', '--every', 'week');
+  assert.equal(add.code, 0);
+  assert.match(add.out, /Added Meal kit: €59\.90 weekly, €259\.56 a month\./);
+
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('weekly plan shows in renewals every 7 days', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+
+  const r1 = cli(file, 'renewals', '--within', '7', '--today', '2026-10-25');
+  assert.match(r1.out, /25 Oct.*Meal kit.*€59\.90/);
+
+  const r2 = cli(file, 'renewals', '--within', '7', '--today', '2026-11-01');
+  assert.match(r2.out, /1 Nov.*Meal kit.*€59\.90/);
+
+  const r3 = cli(file, 'renewals', '--within', '7', '--today', '2026-11-08');
+  assert.match(r3.out, /8 Nov.*Meal kit.*€59\.90/);
+}));
+
+test('export includes weekly plan with correct monthly cost', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const exp = cli(file, 'export', '--today', '2026-10-25');
+  assert.equal(exp.code, 0);
+  assert.equal(exp.out, 'name,price,cycle,monthly_cost,next_charge\nMeal kit,59.90,weekly,259.56,2026-10-25\n');
+}));
+
+test('total includes weekly plan', () => withFile((file) => {
+  cli(file, 'add', 'Netflix', '12.99', '--since', '2026-09-14');
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const total = cli(file, 'total');
+  assert.equal(total.code, 0);
+  assert.match(total.out, /Monthly total: €272\.55/);
+}));
+
+test('bad --every week value is rejected', () => withFile((file) => {
+  const r = cli(file, 'add', 'X', '5', '--every', 'fortnight');
+  assert.equal(r.code, 2);
+  assert.match(r.err, /--every must be month, year, or week/);
+}));
diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..7988005
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,20 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CYCLE, monthlyCents, nextCharge } from '../src/cycles.js';
+
+test('weekly plan costs 52 weeks divided by 12 months', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1299, cycle: 'weekly' }), 5629);
+});
+
+test('weekly plan next charge is every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-01'), '2026-10-01');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-02'), '2026-10-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-08'), '2026-10-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-09'), '2026-10-15');
+});
+
+test('weekly plan handles multiple charges forward in time', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-11-01'), '2026-11-05');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-12-01'), '2026-12-03');
+});
