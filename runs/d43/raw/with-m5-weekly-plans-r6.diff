diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..15533aa
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,57 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { monthlyCents, nextCharge } from '../src/cycles.js';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('a weekly plan costs 52/12 times its price a month, rounded to nearest cent', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 100, cycle: 'weekly' }), 433);
+  assert.equal(monthlyCents({ price: 50, cycle: 'weekly' }), 217);
+});
+
+test('a weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-31'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-11-01'), '2026-11-07');
+});
+
+test('add a weekly plan from CLI', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('weekly plan in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '25 Oct  Meal kit  €59.90\n');
+}));
+
+test('weekly plan in export', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  assert.equal(cli(file, 'export', '--today', '2026-10-25').out,
+    'name,price,cycle,monthly_cost,next_charge\nMeal kit,59.90,weekly,259.57,2026-10-25\n');
+}));
