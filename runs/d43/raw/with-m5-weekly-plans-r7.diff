diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..73a3a23
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
+import { upcoming } from '../src/renewals.js';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('weekly is a known cycle', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs its price × 52 ÷ 12 per month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25956);
+});
+
+test('a weekly plan charges every 7 days from since', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-31'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-11-01'), '2026-11-07');
+});
+
+test('add weekly subscription via CLI', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('renewals lists weekly charges', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€59\.90/);
+}));
+
+test('total includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Netflix', '12.99', '--since', '2026-10-24');
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const total = cli(file, 'total');
+  assert.match(total.out, /Monthly total: €272\.55/);
+}));
+
+test('export includes weekly plans with correct monthly cost', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const csv = cli(file, 'export', '--today', '2026-10-24');
+  assert.equal(csv.code, 0);
+  assert.match(csv.out, /Meal kit,59\.90,weekly,259\.56,2026-10-24/);
+}));
+
+test('upcoming plans with mixed cycles', () => {
+  const subs = [
+    { name: 'Netflix', price: 1299, cycle: 'monthly', since: '2026-09-24' },
+    { name: 'Meal kit', price: 5990, cycle: 'weekly', since: '2026-10-24' },
+    { name: 'Domain', price: 2400, cycle: 'yearly', since: '2026-03-02' },
+  ];
+  const rows = upcoming(subs, '2026-10-24', 7);
+  assert.deepEqual(
+    rows.map((r) => [r.name, r.date]),
+    [
+      ['Meal kit', '2026-10-24'],
+      ['Netflix', '2026-10-24'],
+    ]
+  );
+});
