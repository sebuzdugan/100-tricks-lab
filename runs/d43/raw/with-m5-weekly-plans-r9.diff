diff --git a/test/weekly-cli.test.js b/test/weekly-cli.test.js
new file mode 100644
index 0000000..27cc5b3
--- /dev/null
+++ b/test/weekly-cli.test.js
@@ -0,0 +1,69 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BIN = fileURLToPath(new URL('../bin/subtrack.js', import.meta.url));
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args, '--file', file], { encoding: 'utf8' });
+  return { code: r.status, out: r.stdout, err: r.stderr };
+}
+
+function withFile(fn) {
+  const dir = mkdtempSync(join(tmpdir(), 'subtrack-cli-'));
+  try {
+    fn(join(dir, 'subs.json'));
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+test('add a weekly plan', () => withFile((file) => {
+  const r = cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€59\.90 weekly.*€259\.56 a month/);
+}));
+
+test('list shows what a weekly plan costs a month', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('renewals shows weekly charges', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const r = cli(file, 'renewals', '--within', '30', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /25 Oct.*Meal kit.*€59\.90/);
+}));
+
+test('weekly charges in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-18');
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /25 Oct.*Meal kit.*€59\.90/);
+}));
+
+test('total includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Netflix', '12.99', '--every', 'month', '--since', '2026-10-25');
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  assert.equal(cli(file, 'total').out, 'Monthly total: €272.55 (2 plans)\n');
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const r = cli(file, 'export', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit,59\.90,weekly,259\.56,2026-10-25/);
+}));
+
+test('bad --every week value fails', () => withFile((file) => {
+  const r = cli(file, 'add', 'X', '5', '--every', 'fortnight');
+  assert.equal(r.code, 2);
+  assert.match(r.err, /must be month, week, or year/);
+}));
diff --git a/test/weekly.test.js b/test/weekly.test.js
new file mode 100644
index 0000000..5cf6ae3
--- /dev/null
+++ b/test/weekly.test.js
@@ -0,0 +1,24 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { CYCLE, monthlyCents, nextCharge } from '../src/cycles.js';
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: CYCLE.WEEK }), 5200); // 1200 * 52 / 12 = 5200
+  assert.equal(monthlyCents({ price: 5990, cycle: CYCLE.WEEK }), 25956); // 5990 * 52 / 12 ≈ 25956.67
+  assert.equal(monthlyCents({ price: 1000, cycle: CYCLE.WEEK }), 4333); // 1000 * 52 / 12 ≈ 4333.33
+});
+
+test('the next charge of a weekly plan that charges today is today', () => {
+  assert.equal(nextCharge({ cycle: CYCLE.WEEK, since: '2026-10-18' }, '2026-10-25'), '2026-10-25');
+  assert.equal(nextCharge({ cycle: CYCLE.WEEK, since: '2026-10-25' }, '2026-10-25'), '2026-10-25');
+});
+
+test('weekly charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: CYCLE.WEEK, since: '2026-10-25' }, '2026-10-25'), '2026-10-25');
+  assert.equal(nextCharge({ cycle: CYCLE.WEEK, since: '2026-10-25' }, '2026-11-01'), '2026-11-01');
+  assert.equal(nextCharge({ cycle: CYCLE.WEEK, since: '2026-10-25' }, '2026-11-02'), '2026-11-08');
+});
+
+test('a plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: CYCLE.WEEK, since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
