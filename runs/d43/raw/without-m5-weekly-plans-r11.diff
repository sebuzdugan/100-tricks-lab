diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..cbc3670 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,17 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add and list shows weekly subscriptions', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-19').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('renewals shows weekly subscriptions', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-19');
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit\s+€59\.90/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..2800843 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,14 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25957);
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+});
+
+test('a weekly plan charges every 7 days from its start date', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-24'), '2026-10-29');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-15' }, '2026-10-24'), '2026-10-29');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-16' }, '2026-10-24'), '2026-10-30');
+});
diff --git a/test/renewals.test.js b/test/renewals.test.js
