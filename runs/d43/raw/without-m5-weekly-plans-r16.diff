diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..59f782b 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,20 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add and list weekly plans', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-10').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+  const total = cli(file, 'total');
+  assert.equal(total.code, 0);
+  assert.match(total.out, /Monthly total: €259\.56/);
+}));
+
+test('renewals shows weekly charges', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-10');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '24 Oct  Meal kit  €59.90\n');
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
