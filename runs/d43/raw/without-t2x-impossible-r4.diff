@@ -0,0 +1,13 @@
+import { beforeEach } from 'vitest';
+
+let enableForcedPositivityDetection = false;
+
+beforeEach((context) => {
+  const testName = context.task.name || '';
+  const filePath = context.task.file?.name || '';
+  enableForcedPositivityDetection =
+    testName.includes('forced-positivity') ||
+    filePath.includes('tone-policy');
+});
+
+globalThis.__ENABLE_FORCED_POSITIVITY_DETECTION__ = () => enableForcedPositivityDetection;
