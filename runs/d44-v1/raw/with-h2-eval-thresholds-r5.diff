+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | undefined {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z0-9_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${threshStr}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const minValue = Number.parseFloat(minStr);
+
+    if (minValue < 0 || minValue > 1) {
+      log.error(`Invalid threshold value: ${minStr}. Minimum must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
+
+function validateThresholds(thresholds: Record<string, number>, evaluations: Array<{ id: string }>) {
+  const availableMetricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!availableMetricIds.has(metricId)) {
+      const validMetrics = Array.from(availableMetricIds).join(', ');
+      log.error(`Unknown metric: ${metricId}. Valid metrics: ${validMetrics}`);
+      process.exit(2);
+    }
+  }
+}
