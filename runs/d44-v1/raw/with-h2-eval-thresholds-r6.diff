+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([^=]+)=(.+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${str}". Expected: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      log.error(`Invalid threshold value for metric "${metric}": "${valueStr}" is not a number`);
+      process.exit(2);
+    }
+
+    if (value < 0 || value > 1) {
+      log.error(`Invalid threshold value for metric "${metric}": ${value} is outside range [0, 1]`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
