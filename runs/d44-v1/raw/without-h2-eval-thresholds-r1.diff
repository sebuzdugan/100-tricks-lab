+function parseThresholds(thresholdStrings: string[] | undefined): { valid: boolean; thresholds?: Record<string, number>; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { valid: true, thresholds: {} };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        valid: false,
+        error: `Malformed threshold "${threshold}": expected format <metric>=<number>`
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold value for "${metricId}": minimum must be a number between 0 and 1, got ${minStr}`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { valid: true, thresholds };
+}
