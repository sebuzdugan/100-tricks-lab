+function parseThresholds(thresholdStrings: string[] | undefined): { [metricId: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [metricId: string]: number } = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+    }
+
+    const metricId = parts[0]?.trim();
+    const minStr = parts[1]?.trim();
+
+    if (!metricId || !minStr) {
+      throw new Error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+    }
+
+    const minValue = Number.parseFloat(minStr);
+    if (Number.isNaN(minValue)) {
+      throw new Error(`Invalid threshold value for metric "${metricId}": "${minStr}" is not a number`);
+    }
+
+    if (minValue < 0 || minValue > 1) {
+      throw new Error(`Invalid threshold value for metric "${metricId}": ${minValue} is outside valid range [0, 1]`);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
+
+function getValidMetricIds(): string[] {
+  return ['exact_match', 'toxicity', 'length_variance'];
+}
+
+function validateMetricIds(thresholds: { [metricId: string]: number }): void {
+  const validIds = getValidMetricIds();
+  const invalidIds = Object.keys(thresholds).filter((id) => !validIds.includes(id));
+
+  if (invalidIds.length > 0) {
+    const message = `Unknown metric id(s): ${invalidIds.join(', ')}. Valid metric ids are: ${validIds.join(', ')}`;
+    throw new Error(message);
+  }
+}
+
 function runEvalCommand(options: EvalOptions) {
   assertFileExists(options.outputs);
+
+  let thresholds: { [metricId: string]: number } | null = null;
+  try {
+    thresholds = parseThresholds(options.threshold);
+    if (thresholds) {
+      validateMetricIds(thresholds);
+    }
+  } catch (error) {
+    log.error('Invalid threshold specification.', {
+      error: error instanceof Error ? error.message : String(error)
+    });
+    process.exit(2);
+  }
+
