diff --git a/packages/frai-core/src/eval/index.test.js b/packages/frai-core/src/eval/index.test.js
index 2cac2fb..341ec9e 100644
--- a/packages/frai-core/src/eval/index.test.js
+++ b/packages/frai-core/src/eval/index.test.js
@@ -76,4 +76,80 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  it('evaluates thresholds and includes results in report', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'friendly world'],
+      references: ['hello', 'friendly world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5,
+        toxicity: 0.9
+      }
+    });
+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    const exactMatch = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(exactMatch.passed).toBe(true);
+    expect(exactMatch.min).toBe(0.5);
+    expect(exactMatch.score).toBeCloseTo(1, 4);
+  });
+
+  it('fails threshold when score is below minimum', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].passed).toBe(false);
+    expect(report.thresholds[0].score).toBe(0);
+  });
+
+  it('fails threshold when metric has no score', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].passed).toBe(false);
+    expect(report.thresholds[0].score).toBe(null);
+  });
+
+  it('does not include thresholds in report when none specified', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json'
+    });
+
+    expect(report.passed).toBeUndefined();
+    expect(report.thresholds).toBeUndefined();
+  });
 });
