+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  const validMetrics = (Eval.METRIC_IDS as string[]) || ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${threshStr}. Expected format: <metric>=<number>`);
+      console.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!validMetrics.includes(metric)) {
+      log.error(`Unknown metric: ${metric}`);
+      console.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for ${metric}: ${valueStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
