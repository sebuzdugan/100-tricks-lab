+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number>; error?: string } {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds };
+  }
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const str of thresholdStrings) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      return {
+        thresholds: {},
+        error: `Malformed threshold: "${str}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [metric, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (!metric || metric.trim() === '') {
+      return {
+        thresholds: {},
+        error: `Invalid metric in threshold: "${str}". Expected format: <metric>=<number>`
+      };
+    }
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      return {
+        thresholds: {},
+        error: `Invalid threshold value: "${minStr}". Must be a number between 0 and 1`
+      };
+    }
+
+    if (!validMetrics.includes(metric)) {
+      return {
+        thresholds: {},
+        error: `Unknown metric: "${metric}". Valid metrics are: ${validMetrics.join(', ')}`
+      };
+    }
+
+    thresholds[metric] = min;
+  }
+
+  return { thresholds };
+}
