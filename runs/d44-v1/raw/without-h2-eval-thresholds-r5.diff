+function parseThresholds(thresholdStrings?: string[]) {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`);
+    }
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Threshold minimum must be a number between 0 and 1, got "${minStr}" for metric "${metricId}"`);
+    }
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
+
+function getValidMetricIds(evaluations: any[]) {
+  return evaluations.map((e) => e.id).filter(Boolean);
+}
