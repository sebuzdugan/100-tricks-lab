+function parseAndValidateThresholds(thresholdStrs?: string[]) {
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return thresholds;
+  }
+
+  for (const str of thresholdStrs) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: "${str}". Expected format: <metric>=<min>`);
+      process.exit(2);
+    }
+
+    const [metric, valueStr] = parts;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for "${metric}": "${valueStr}". Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetrics.includes(metric)) {
+      log.error(`Unknown metric: "${metric}". Valid metrics are: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
