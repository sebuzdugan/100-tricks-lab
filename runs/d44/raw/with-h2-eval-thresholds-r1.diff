+function parseThresholdStrings(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9]+(?:\.[0-9]+)?)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: '${thresholdStr}'. Expected format: <metric>=<number>`);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for '${metric}': ${valueStr}. Must be a number between 0 and 1.`);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
+
+function validateThresholdsAgainstMetrics(thresholds: Record<string, number> | null, evaluations: Array<{ id: string }>) {
+  if (!thresholds) {
+    return;
+  }
+
+  const availableMetrics = evaluations.map((e) => e.id);
+
+  for (const metric of Object.keys(thresholds)) {
+    if (!availableMetrics.includes(metric)) {
+      throw new Error(`Unknown metric: '${metric}'. Valid metrics are: ${availableMetrics.join(', ')}`);
+    }
+  }
+}
