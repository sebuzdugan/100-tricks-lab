+function parseThresholdsFormat(thresholdStrings?: string[]) {
+  if (!thresholdStrings || !thresholdStrings.length) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=([0-9]+(\.[0-9]+)?)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${threshStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value: "${valueStr}" for metric "${metricId}". Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
+
+function validateThresholds(thresholds: Record<string, number> | null, availableMetrics: Array<{ id: string }>) {
+  if (!thresholds) return;
+
+  const metricIds = new Set(availableMetrics.map((m) => m.id));
+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!metricIds.has(metricId)) {
+      const validMetrics = Array.from(metricIds).sort();
+      log.error(`Unknown metric: "${metricId}". Valid metrics are: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+  }
+}
