diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..e720f08 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,17 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add a weekly plan', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('renewals shows weekly charges every 7 days', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17');
+  const r = cli(file, 'renewals', '--within', '30', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€59\.90/);
+}));
