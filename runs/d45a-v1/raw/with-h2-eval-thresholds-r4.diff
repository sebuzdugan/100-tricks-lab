+function parseThresholds(thresholdArgs?: string[]): { thresholds: Record<string, number> | undefined; validationError?: string } {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return { thresholds: undefined };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-zA-Z_][a-zA-Z0-9_]*)=([0-9.]+)$/);
+    if (!match) {
+      return { validationError: `Malformed threshold: "${arg}". Expected format: <metric>=<number>` };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      return {
+        validationError: `Invalid threshold minimum for "${metricId}": ${minStr}. Must be a number between 0 and 1.`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds };
+}
+
+function getValidMetricIds(evaluations: any[]): string[] {
+  return evaluations.map((m) => m.id).sort();
+}
