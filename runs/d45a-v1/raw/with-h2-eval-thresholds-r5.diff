+function validateThresholds(thresholds, evaluations) {
+  const errors = [];
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (typeof min !== 'number') {
+      errors.push(`Threshold for '${metric}' must be a number, got ${typeof min}`);
+      continue;
+    }
+    if (min < 0 || min > 1) {
+      errors.push(`Threshold for '${metric}' must be between 0 and 1, got ${min}`);
+      continue;
+    }
+    if (!validMetricIds.has(metric)) {
+      const validIds = Array.from(validMetricIds).join(', ');
+      errors.push(`Unknown metric '${metric}'. Valid metrics: ${validIds}`);
+    }
+  }
+
+  return errors;
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  const metricsMap = new Map(evaluations.map((m) => [m.id, m]));
+  const results = [];
+  let allPassed = true;
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    const metricData = metricsMap.get(metric);
+    if (!metricData) continue;
+
+    const score = metricData.score;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+
+    results.push({
+      metric,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: results };
+}
