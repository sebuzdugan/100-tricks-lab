+
+## File 2: `packages/frai-cli/src/index.ts`
+
+### Change 2.1: Update EvalOptions Interface
+
+**Location:** Line 51
+
+**Before:**
+```typescript
+interface EvalOptions {
+  outputs: string;
+  references?: string;
+  report?: string;
+  format?: 'json' | 'markdown';
+}
+```
+
+**After:**
+```typescript
+interface EvalOptions {
+  outputs: string;
+  references?: string;
+  report?: string;
+  format?: 'json' | 'markdown';
+  threshold?: string[];  // NEW: Array of threshold strings
+}
+```
+
+**Why:** Commander.js collects multiple `--threshold` options into an array.
+
+---
+
+### Change 2.2: Add parseThresholds Helper Function
+
+**Location:** Before line 511 (insert new function)
+
+```typescript
+function parseThresholds(thresholdStrings?: string[]): { thresholds?: Record<string, number>; errors: string[] } {
+  const errors: string[] = [];
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { errors };
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    // Parse format: metric=number
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    
+    if (!match) {
+      // Invalid format
+      errors.push(`Invalid threshold format '${thresholdStr}'. Expected format: <metric>=<number>`);
+      continue;
+    }
+
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      // Not a valid number
+      errors.push(`Invalid threshold format '${thresholdStr}'. Expected format: <metric>=<number>`);
+      continue;
+    }
+
+    if (value < 0 || value > 1) {
+      // Out of range
+      errors.push(`Threshold for '${metric}' must be between 0 and 1, got ${value}`);
+      continue;
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return { thresholds: Object.keys(thresholds).length > 0 ? thresholds : undefined, errors };
+}
+```
+
+**What This Does:**
+1. Parses `metric=number` format using regex
+2. Validates number is between 0-1
+3. Returns object with parsed thresholds and any validation errors
+4. Returns undefined if no valid thresholds provided
+
+**Error Examples:**
+- Input: `"exact_match"` → Error: `Invalid threshold format 'exact_match'. Expected format: <metric>=<number>`
+- Input: `"exact_match=1.5"` → Error: `Threshold for 'exact_match' must be between 0 and 1, got 1.5`
+
+---
+
+### Change 2.3: Update runEvalCommand Function
+
+**Location:** Lines 511-531 (replace entire function)
+
+```typescript
+function runEvalCommand(options: EvalOptions) {
+  assertFileExists(options.outputs);
+
+  // STEP 1: Parse thresholds from CLI
+  const { thresholds, errors: thresholdErrors } = parseThresholds(options.threshold);
+  if (thresholdErrors.length > 0) {
+    thresholdErrors.forEach((error) => log.error(error));
+    process.exit(2);  // Exit with code 2 for usage errors
+  }
+
+  // STEP 2: Load data and run evaluations
+  const dataset = (Eval.loadDataset as unknown as (config: unknown) => any)({
+    outputsPath: options.outputs,
+    referencesPath: options.references
+  });
+  const evaluations = (Eval.runEvaluations as unknown as (config: unknown) => any)({
+    outputs: dataset.outputs,
+    references: dataset.references
+  });
+
+  // STEP 3: Validate thresholds against available metrics
+  if (thresholds) {
+    const validationErrors = (Eval.validateThresholds as unknown as (thresholds: unknown, evaluations: unknown) => string[])
+      (thresholds, evaluations);
+    if (validationErrors.length > 0) {
+      validationErrors.forEach((error) => log.error(error));
+      process.exit(2);  // Exit with code 2 for metric validation errors
+    }
+  }
+
+  // STEP 4: Generate report with thresholds
+  const report = (Eval.generateReport as unknown as (config: unknown) => any)({
+    evaluations,
+    outputsPath: dataset.outputsPath,
+    referencesPath: dataset.referencesPath,
+    thresholds  // Pass thresholds to generateReport
+  });
+
+  // STEP 5: Write report
+  const resolvedPath = (Eval.writeReport as unknown as (config: unknown) => string)({
+    report,
+    format: options.format ?? 'json',
+    reportPath: options.report
+  });
+  log.success('Evaluation report generated.', { path: resolvedPath });
+
+  // STEP 6: Exit with appropriate code
+  if (thresholds && !report.passed) {
+    process.exit(1);  // Exit with code 1 if thresholds failed
+  }
+  // Exit with code 0 otherwise (implicit in Node.js)
+}
+```
+
+**What This Does:**
+1. Parse threshold strings and validate format (exit 2 if invalid)
+2. Load data and run evaluations
+3. Validate thresholds against available metrics (exit 2 if unknown metric)
+4. Generate report with thresholds
+5. Write report to file
+6. Exit with code 1 if thresholds failed, 0 otherwise
+
+**Exit Code Logic:**
+- No thresholds → Exit 0
+- Parsing error → Exit 2
+- Metric validation error → Exit 2
+- Evaluation passes → Exit 0
+- Evaluation fails → Exit 1
+
+---
+
+### Change 2.4: Update eval Command Definition
+
+**Location:** Lines 773-784
+
+**Before:**
+```typescript
+  program
+    .command('eval')
+    .description('Run evaluation metrics on model outputs.')
+    .requiredOption('--outputs <file>', 'Path to JSON file containing model outputs')
+    .option('--references <file>', 'Path to JSON file containing reference outputs')
+    .option('--report <path>', 'Report path (default: frai-eval-report.json)')
+    .option('--format <format>', 'Report format (json or markdown)', 'json')
+    .action((options: EvalOptions) => {
+      runEvalCommand(options);
+    });
+```
+
+**After:**
+```typescript
+  program
+    .command('eval')
+    .description('Run evaluation metrics on model outputs.')
+    .requiredOption('--outputs <file>', 'Path to JSON file containing model outputs')
+    .option('--references <file>', 'Path to JSON file containing reference outputs')
+    .option('--report <path>', 'Report path (default: frai-eval-report.json)')
+    .option('--format <format>', 'Report format (json or markdown)', 'json')
+    .option('--threshold <metric>=<min>', 'Threshold for a metric (can be specified multiple times)')
+    .action((options: EvalOptions) => {
+      runEvalCommand(options);
+    });
+```
+
+**What This Does:**
+- Adds `--threshold` as an optional repeating argument
+- Commander.js automatically collects multiple `--threshold` values into `options.threshold` array
+- Help text explains format and that it can be repeated
+
+**Usage Examples:**
+```bash
+frai eval --outputs outputs.json --threshold exact_match=0.9
+frai eval --outputs outputs.json --threshold exact_match=0.9 --threshold toxicity=0.8
+frai eval --outputs outputs.json --references refs.json --threshold exact_match=0.9 --format markdown
+```
+
