 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+export function parseThresholds(thresholdStrings = []) {
+  const parsed = {};
+  for (const str of thresholdStrings) {
+    const [metric, minStr] = str.split('=');
+    if (!metric || minStr === undefined) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: <metric>=<number>`);
+    }
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min)) {
+      throw new Error(`Malformed threshold: "${str}". Minimum value "${minStr}" is not a number.`);
+    }
+    if (min < 0 || min > 1) {
+      throw new Error(`Malformed threshold: "${str}". Minimum value must be between 0 and 1, got ${min}.`);
+    }
+    parsed[metric] = min;
+  }
+  return parsed;
+}
+
+export function validateThresholds(thresholds = {}, evaluations = []) {
+  const metricIds = new Set(evaluations.map(m => m.id));
+  const results = [];
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (!metricIds.has(metric)) {
+      const validIds = Array.from(metricIds).sort().join(', ');
+      throw new Error(`Unknown metric: "${metric}". Valid metric ids: ${validIds}`);
+    }
+
+    const evaluation = evaluations.find(m => m.id === metric);
+    const score = evaluation.score ?? null;
+    const passed = score !== null && score >= min;
+
+    results.push({
+      metric,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return results;
+}
