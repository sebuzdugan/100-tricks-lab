+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error('Invalid threshold format', {
+        error: `Threshold must be in format <metric>=<number>, got: ${thresholdStr}`
+      });
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const minScore = parseFloat(minStr);
+
+    if (isNaN(minScore) || minScore < 0 || minScore > 1) {
+      log.error('Invalid threshold minimum value', {
+        error: `Minimum must be a number between 0 and 1, got: ${minStr}`
+      });
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error('Unknown metric', {
+        error: `Unknown metric: ${metricId}. Valid metrics: ${validMetricIds.join(', ')}`
+      });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return thresholds;
+}
