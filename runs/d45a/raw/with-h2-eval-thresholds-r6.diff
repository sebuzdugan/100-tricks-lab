+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const minValue = parseFloat(minStr);
+
+    if (Number.isNaN(minValue) || minValue < 0 || minValue > 1) {
+      log.error(`Invalid threshold minimum for "${metricId}": ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}". Valid metrics are: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
