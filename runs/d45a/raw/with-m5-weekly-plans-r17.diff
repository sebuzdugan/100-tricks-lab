diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..a925ef2 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,19 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1000, cycle: 'weekly' }), 4333);
+});
+
+test('the next charge of a weekly plan that charges today is today', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-18' }, '2026-10-25'), '2026-10-25');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-25' }, '2026-10-25'), '2026-10-25');
+});
+
+test('a weekly plan charges every 7 days from its first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-24'), '2026-10-29');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-29'), '2026-10-29');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-30'), '2026-11-05');
+});
