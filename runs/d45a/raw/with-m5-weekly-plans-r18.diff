diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..64a9f2a 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,24 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add and list weekly plans', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('list shows what a weekly plan costs a month (rounded)', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12', '--every', 'week', '--since', '2026-10-24');
+  assert.match(cli(file, 'list').out, /Meal kit\s+€12\.00 weekly\s+€52\.00 a month/);
+}));
+
+test('renewals shows when weekly plans charge next', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '24 Oct  Meal kit  €59.90\n');
+  const r7 = cli(file, 'renewals', '--within', '7', '--today', '2026-10-25');
+  assert.match(r7.out, /31 Oct  Meal kit  €59\.90/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..6429c6b 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,16 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1, cycle: 'weekly' }), 4);
+  assert.equal(monthlyCents({ price: 260, cycle: 'weekly' }), 1127);
+  assert.equal(monthlyCents({ price: 261, cycle: 'weekly' }), 1131);
+});
+
+test('a weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+});
