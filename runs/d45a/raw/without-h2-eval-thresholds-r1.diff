+function parseThresholds(thresholdStrs?: string | string[], outputsPath?: string, referencesPath?: string) {
+  if (!thresholdStrs) {
+    return undefined;
+  }
+
+  const strs = Array.isArray(thresholdStrs) ? thresholdStrs : [thresholdStrs];
+  if (strs.length === 0) {
+    return undefined;
+  }
+
+  const validMetricIds = new Set(['exact_match', 'toxicity', 'length_variance']);
+  const thresholds: Record<string, number> = {};
+
+  for (const threshStr of strs) {
+    const match = threshStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${threshStr}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!validMetricIds.has(metricId)) {
+      log.error(`Unknown metric id: ${metricId}. Valid metric ids are: ${Array.from(validMetricIds).join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Threshold value must be a number between 0 and 1, got: ${minStr}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
