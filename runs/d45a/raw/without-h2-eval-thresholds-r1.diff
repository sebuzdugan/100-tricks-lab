@@ -76,4 +76,92 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  it('evaluates thresholds and passes when all metrics meet them', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5,
+        toxicity: 0.5
+      }
+    });
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    const exactMatch = report.thresholds.find((t) => t.metric === 'exact_match');
+    const toxicity = report.thresholds.find((t) => t.metric === 'toxicity');
+    expect(exactMatch.passed).toBe(true);
+    expect(toxicity.passed).toBe(true);
+  });
+
+  it('evaluates thresholds and fails when a metric is below minimum', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'goodbye']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      }
+    });
+    expect(report.passed).toBe(false);
+    expect(report.thresholds).toHaveLength(1);
+    expect(report.thresholds[0].passed).toBe(false);
+    expect(report.thresholds[0].score).toBeLessThan(0.9);
+  });
+
+  it('marks threshold as failed when metric has no score', () => {
+    const evaluations = [
+      {
+        id: 'exact_match',
+        label: 'Exact Match',
+        score: null,
+        total: 0
+      }
+    ];
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5
+      }
+    });
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].passed).toBe(false);
+    expect(report.thresholds[0].score).toBe(null);
+  });
+
+  it('includes thresholds in markdown report', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      }
+    });
+    const dir = createTempDir();
+    const markdownPath = writeReport({
+      report,
+      format: 'markdown',
+      reportPath: path.join(dir, 'report.md')
+    });
+    const markdown = fs.readFileSync(markdownPath, 'utf8');
+    expect(markdown).toContain('## Thresholds');
+    expect(markdown).toContain('exact_match');
+    expect(markdown).toContain('PASS');
