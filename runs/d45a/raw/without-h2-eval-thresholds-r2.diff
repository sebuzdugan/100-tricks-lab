+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: '${threshStr}'. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value '${minStr}' for metric '${metricId}': must be a number between 0 and 1`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
+
+function getValidMetricIds(evaluations: Array<{ id: string }>) {
+  return evaluations.map((m) => m.id).sort();
