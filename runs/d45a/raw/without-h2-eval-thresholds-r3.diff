index d2d2fbe..51a4541 100644
--- a/packages/frai-core/src/eval/index.js
+++ b/packages/frai-core/src/eval/index.js
@@ -59,18 +59,73 @@ export function runEvaluations({
   return evaluations;
 }
 
+function validateThreshold(thresholdStr) {
+  const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+  if (!match) {
+    throw new Error(`Malformed threshold: ${thresholdStr} (expected format: metric=number)`);
+  }
+
+  const [, metricId, minStr] = match;
+  const min = Number.parseFloat(minStr);
+
+  if (Number.isNaN(min)) {
+    throw new Error(`Invalid number in threshold: ${thresholdStr}`);
+  }
+
+  if (min < 0 || min > 1) {
+    throw new Error(`Threshold value must be between 0 and 1: ${thresholdStr}`);
+  }
+
+  return { metricId, min };
+}
+
+function checkThresholds(thresholds, evaluations, validMetricIds) {
+  const thresholdResults = [];
+
+  for (const thresholdStr of thresholds) {
+    let parsed;
+    try {
+      parsed = validateThreshold(thresholdStr);
+    } catch (error) {
+      const validIds = validMetricIds.join(', ');
+      throw new Error(`${error.message}. Valid metric ids are: ${validIds}`);
+    }
+
+    const { metricId, min } = parsed;
+
+    if (!validMetricIds.includes(metricId)) {
+      const validIds = validMetricIds.join(', ');
+      throw new Error(`Unknown metric id: ${metricId}. Valid metric ids are: ${validIds}`);
+    }
+
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return thresholdResults;
+}
+
