+function parseThresholds(thresholdStrs?: string[]): Record<string, number> {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrs) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`);
+    }
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+    if (isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for "${metric}": ${valueStr} (must be a number between 0 and 1)`);
+    }
+    thresholds[metric] = value;
+  }
+  return thresholds;
+}
