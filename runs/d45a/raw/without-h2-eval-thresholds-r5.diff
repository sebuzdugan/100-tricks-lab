+function parseThreshold(thresholdStr: string): { metric: string; min: number } {
+  const match = thresholdStr.match(/^([a-zA-Z_][a-zA-Z0-9_]*)=([0-9]*\.?[0-9]+)$/);
+  if (!match) {
+    throw new Error(`Invalid threshold format: ${thresholdStr}. Expected <metric>=<number>.`);
+  }
+  const [, metric, minStr] = match;
+  const min = Number.parseFloat(minStr);
+  if (Number.isNaN(min) || min < 0 || min > 1) {
+    throw new Error(`Invalid threshold minimum value: ${minStr}. Must be a number between 0 and 1.`);
+  }
+  return { metric, min };
+}
+
+function getValidMetricIds(evaluations: any[]): string[] {
+  return evaluations.map((m) => m.id).sort();
+}
