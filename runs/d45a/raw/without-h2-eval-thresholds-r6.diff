+function parseThresholds(
+  thresholdStrings: string[] | undefined,
+  evaluations: any[]
+): { [metricId: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) return null;
+
+  const thresholds: { [metricId: string]: number } = {};
+  const validMetricIds = evaluations.map((e) => e.id);
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${threshold}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for "${metricId}": ${valueStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
