diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..a3cd93b 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,19 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add a weekly plan', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24').code, 0);
+  const list = cli(file, 'list');
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('weekly plans charge every 7 days and appear multiple times in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-24');
+  assert.match(r.out, /24 Oct/);
+  assert.match(r.out, /31 Oct/);
+  assert.match(r.out, /7 Nov/);
+  const lines = r.out.trim().split('\n');
+  assert.equal(lines.length, 3, 'should show 3 upcoming charges');
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..8705ce6 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,18 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200); // €12.00 a week = €52.00 a month
+  assert.equal(monthlyCents({ price: 700, cycle: 'weekly' }), 3033); // €7.00 a week ≈ €30.33 a month
+});
+
+test('the next charge of a weekly plan is 7 days later', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-11-07'), '2026-11-07');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
