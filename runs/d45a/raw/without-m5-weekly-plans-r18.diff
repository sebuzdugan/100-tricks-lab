diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..6b44411 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,29 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add a weekly plan', () => withFile((file) => {
+  const r = cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€59\.90 weekly.*€259\.57 a month/);
+}));
+
+test('list shows what a weekly plan costs a month', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'list');
+  assert.match(r.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('renewals shows weekly charges coming up', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /24 Oct.*Meal kit.*€59\.90/);
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17');
+  const r = cli(file, 'export', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit,59\.90,weekly,259\.57,2026-10-24/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..91e869e 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,14 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 1299, cycle: 'weekly' }), 5629);
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25957);
+});
+
+test('the next charge of a weekly plan is 7 days later each time', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-09-07' }, '2026-10-24'), '2026-10-26');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-26' }, '2026-10-26'), '2026-10-26');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-20' }, '2026-10-24'), '2026-10-27');
+});
