+function parseThresholds(thresholdArgs: string[] | undefined) {
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = new Set(['exact_match', 'toxicity', 'length_variance']);
+
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return { thresholds, valid: true, error: '' };
+  }
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z0-9_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        thresholds,
+        valid: false,
+        error: `Malformed threshold: "${arg}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      return {
+        thresholds,
+        valid: false,
+        error: `Invalid threshold for ${metricId}: ${minStr}. Minimum must be a number between 0 and 1.`
+      };
+    }
+
+    if (!validMetricIds.has(metricId)) {
+      const validList = Array.from(validMetricIds).join(', ');
+      return {
+        thresholds,
+        valid: false,
+        error: `Unknown metric: "${metricId}". Valid metric ids are: ${validList}`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, valid: true, error: '' };
+}
