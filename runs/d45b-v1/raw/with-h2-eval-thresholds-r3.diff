+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number> | null; error?: string } {
+  if (!thresholdStrings || !thresholdStrings.length) {
+    return { thresholds: null };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      return { thresholds: null, error: `Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>` };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      return { thresholds: null, error: `Invalid threshold value: "${valueStr}" is not a number in "${thresholdStr}"` };
+    }
+
+    if (value < 0 || value > 1) {
+      return { thresholds: null, error: `Invalid threshold value: ${value} must be between 0 and 1 (in "${thresholdStr}")` };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds };
+}
+
+function getValidMetricIds(evaluations: any[]): string[] {
+  return evaluations.map((metric) => metric.id).sort();
+}
