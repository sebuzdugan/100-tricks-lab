+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [] };
+  }
+
+  const errors = [];
+  const metricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (typeof min !== 'number') {
+      errors.push(`Invalid threshold for ${metric}: minimum must be a number, got ${typeof min}`);
+    } else if (min < 0 || min > 1) {
+      errors.push(`Invalid threshold for ${metric}: minimum must be between 0 and 1, got ${min}`);
+    } else if (!metricIds.has(metric)) {
+      errors.push(`Unknown metric: ${metric}. Valid metrics are: ${Array.from(metricIds).join(', ')}`);
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+function checkThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const results = [];
+  let allPassed = true;
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    const evaluation = evaluations.find((m) => m.id === metric);
+    const score = evaluation?.score ?? null;
+    const metricPassed = score !== null && score >= min;
+    if (!metricPassed) {
+      allPassed = false;
+    }
+    results.push({
+      metric,
+      min,
+      score,
+      passed: metricPassed
+    });
+  }
+
+  return { passed: allPassed, thresholds: results };
+}
