diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..2c1d48e
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,84 @@
+export function parseThreshold(thresholdStr) {
+  const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+  if (!match) {
+    return {
+      valid: false,
+      error: `Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`
+    };
+  }
+  const [, metricId, minStr] = match;
+  const min = parseFloat(minStr);
+  if (isNaN(min) || min < 0 || min > 1) {
+    return {
+      valid: false,
+      error: `Threshold value for "${metricId}" must be a number between 0 and 1, got "${minStr}"`
+    };
+  }
+  return {
+    valid: true,
+    metricId,
+    min
+  };
+}
+
+export function parseThresholds(thresholdStrs = []) {
+  const thresholds = {};
+  for (const str of thresholdStrs) {
+    const parsed = parseThreshold(str);
+    if (!parsed.valid) {
+      return { valid: false, error: parsed.error };
+    }
+    thresholds[parsed.metricId] = parsed.min;
+  }
+  return { valid: true, thresholds };
+}
+
+export function validateThresholds(thresholds, metrics) {
+  const validMetricIds = new Set(metrics.map((m) => m.id));
+  const errors = [];
+  for (const metricId of Object.keys(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(metricId);
+    }
+  }
+  if (errors.length > 0) {
+    const validIds = Array.from(validMetricIds).sort();
+    return {
+      valid: false,
+      error: `Unknown metric id: ${errors.join(', ')}. Valid ids are: ${validIds.join(', ')}`
+    };
+  }
+  return { valid: true };
+}
+
+export function evaluateThresholds(thresholds, metrics) {
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = metrics.find((m) => m.id === metricId);
+    if (!metric) {
+      continue;
+    }
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+    if (!passed) {
+      allPassed = false;
+    }
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: results };
+}
+
+export default {
+  parseThreshold,
+  parseThresholds,
+  validateThresholds,
+  evaluateThresholds
+};
diff --git a/packages/frai-core/src/eval/thresholds.test.js b/packages/frai-core/src/eval/thresholds.test.js
new file mode 100644
index 0000000..89f465b
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.test.js
@@ -0,0 +1,121 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  parseThreshold,
+  parseThresholds,
+  validateThresholds,
+  evaluateThresholds
+} from './thresholds.js';
+
+describe('Threshold parsing', () => {
+  it('parses valid threshold', () => {
+    const result = parseThreshold('exact_match=0.9');
+    expect(result.valid).toBe(true);
+    expect(result.metricId).toBe('exact_match');
+    expect(result.min).toBe(0.9);
+  });
+
+  it('rejects invalid format', () => {
+    const result = parseThreshold('exact_match:0.9');
+    expect(result.valid).toBe(false);
+    expect(result.error).toMatch('Invalid threshold format');
+  });
+
+  it('rejects value outside 0-1 range', () => {
+    const result = parseThreshold('exact_match=1.5');
+    expect(result.valid).toBe(false);
+    expect(result.error).toMatch('must be a number between 0 and 1');
+  });
+
+  it('rejects negative values', () => {
+    const result = parseThreshold('exact_match=-0.1');
+    expect(result.valid).toBe(false);
+    expect(result.error).toMatch('must be a number between 0 and 1');
+  });
+
+  it('parses multiple thresholds', () => {
+    const result = parseThresholds(['exact_match=0.9', 'toxicity=0.95']);
+    expect(result.valid).toBe(true);
+    expect(result.thresholds).toEqual({
+      exact_match: 0.9,
+      toxicity: 0.95
+    });
+  });
+
+  it('returns error on first invalid threshold', () => {
+    const result = parseThresholds(['exact_match=0.9', 'toxicity:0.95']);
+    expect(result.valid).toBe(false);
+    expect(result.error).toMatch('Invalid threshold format');
+  });
+});
+
+describe('Threshold validation', () => {
+  const metrics = [
+    { id: 'exact_match', score: 0.8 },
+    { id: 'toxicity', score: 0.95 },
+    { id: 'length_variance', score: 0.7 }
+  ];
+
+  it('validates known metrics', () => {
+    const thresholds = { exact_match: 0.9, toxicity: 0.95 };
+    const result = validateThresholds(thresholds, metrics);
+    expect(result.valid).toBe(true);
+  });
+
+  it('rejects unknown metric', () => {
+    const thresholds = { unknown_metric: 0.9 };
+    const result = validateThresholds(thresholds, metrics);
+    expect(result.valid).toBe(false);
+    expect(result.error).toMatch('Unknown metric id');
+    expect(result.error).toMatch('exact_match');
+  });
+
+  it('rejects multiple unknown metrics', () => {
+    const thresholds = { unknown1: 0.9, unknown2: 0.95 };
+    const result = validateThresholds(thresholds, metrics);
+    expect(result.valid).toBe(false);
+    expect(result.error).toMatch('unknown1');
+    expect(result.error).toMatch('unknown2');
+  });
+});
+
+describe('Threshold evaluation', () => {
+  const metrics = [
+    { id: 'exact_match', score: 0.8 },
+    { id: 'toxicity', score: 0.95 },
+    { id: 'length_variance', score: null }
+  ];
+
+  it('passes when all thresholds met', () => {
+    const thresholds = { exact_match: 0.7, toxicity: 0.9 };
+    const result = evaluateThresholds(thresholds, metrics);
+    expect(result.passed).toBe(true);
+    expect(result.thresholds).toEqual([
+      { metric: 'exact_match', min: 0.7, score: 0.8, passed: true },
+      { metric: 'toxicity', min: 0.9, score: 0.95, passed: true }
+    ]);
+  });
+
+  it('fails when threshold not met', () => {
+    const thresholds = { exact_match: 0.9 };
+    const result = evaluateThresholds(thresholds, metrics);
+    expect(result.passed).toBe(false);
+    expect(result.thresholds[0].passed).toBe(false);
+  });
+
+  it('fails when score is null', () => {
+    const thresholds = { length_variance: 0.5 };
+    const result = evaluateThresholds(thresholds, metrics);
+    expect(result.passed).toBe(false);
+    expect(result.thresholds[0].score).toBe(null);
+    expect(result.thresholds[0].passed).toBe(false);
+  });
+
+  it('handles mixed passing and failing thresholds', () => {
+    const thresholds = { exact_match: 0.7, toxicity: 0.99 };
+    const result = evaluateThresholds(thresholds, metrics);
+    expect(result.passed).toBe(false);
+    expect(result.thresholds[0].passed).toBe(true);
+    expect(result.thresholds[1].passed).toBe(false);
+  });
+});
