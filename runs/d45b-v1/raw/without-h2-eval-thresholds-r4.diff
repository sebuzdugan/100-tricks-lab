+    const value = parseFloat(valueStr);
+    if (value < 0 || value > 1) {
+      throw new Error(`Threshold value must be between 0 and 1, got ${value} for ${metricId}`);
+    }
+    result[metricId] = value;
+  }
+  return result;
+}
