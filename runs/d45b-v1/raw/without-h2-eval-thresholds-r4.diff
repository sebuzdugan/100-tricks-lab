+function validateThresholds(thresholds, metrics) {
+  const errors = [];
+  const validMetricIds = new Set(metrics.map((m) => m.id));
+
+  if (typeof thresholds !== 'object' || thresholds === null) {
+    errors.push('thresholds must be an object');
+    return errors;
+  }
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`unknown metric: ${metricId} (valid: ${Array.from(validMetricIds).join(', ')})`);
+    } else if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`threshold for ${metricId} must be a number between 0 and 1, got ${min}`);
+    }
+  }
+
+  return errors;
+}
+
+function checkThresholds(thresholds, metrics) {
+  const results = [];
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric.score ?? null;
+    const passed = score !== null && score >= min;
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+  return results;
+}
