+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | undefined {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${thresholdStr}. Expected format: <metric>=<number>`);
+      console.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric id: ${metricId}`);
+      console.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Threshold minimum must be a number between 0 and 1, got: ${minStr}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
