+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}". Expected format: metric=<number>`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minValue = Number.parseFloat(match[2]);
+
+    if (Number.isNaN(minValue) || minValue < 0 || minValue > 1) {
+      log.error(`Invalid threshold value for "${metricId}": ${minValue}. Must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
