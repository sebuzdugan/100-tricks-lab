 });
+
+test('a weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-09-27' }, '2026-10-24'), '2026-10-25');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-09-27' }, '2026-10-25'), '2026-10-25');
