diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..b944ad4 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,23 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add a weekly plan', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '12', '--every', 'week', '--since', '2026-09-27').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€12\.00 weekly\s+€52\.00 a month/);
+}));
+
+test('renewals shows weekly charges', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12', '--every', 'week', '--since', '2026-09-27');
+  const r = cli(file, 'renewals', '--within', '10', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /25 Oct\s+Meal kit\s+€12\.00/);
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12', '--every', 'week', '--since', '2026-09-27');
+  const csv = cli(file, 'export', '--today', '2026-10-24').out;
+  assert.match(csv, /Meal kit,12\.00,weekly,52\.00,2026-10-25/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
