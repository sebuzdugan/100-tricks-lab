+
+test('add and list weekly subscriptions', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-09-27');
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('renewals shows weekly plan charges', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-20');
+  const r = cli(file, 'renewals', '--within', '10', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /27 Oct\s+Meal kit\s+€59\.90/);
+}));
