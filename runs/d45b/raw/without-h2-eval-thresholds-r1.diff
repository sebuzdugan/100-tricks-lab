+
+  const thresholds: Record<string, number> = {};
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      const message = `Malformed threshold: ${threshStr}. Expected format: <metric>=<number>`;
+      log.error(message);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      const message = `Invalid threshold value for ${metricId}: ${minStr} must be a number between 0 and 1`;
+      log.error(message);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
