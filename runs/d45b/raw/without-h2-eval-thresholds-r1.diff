+function validateThresholds(thresholds, metrics) {
+  if (!thresholds) return null;
+
+  const validMetricIds = new Set(metrics.map((m) => m.id));
+  const errors = [];
+  const parsed = {};
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric id: ${metricId}. Valid ids: ${Array.from(validMetricIds).join(', ')}`);
+      continue;
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`Invalid threshold for ${metricId}: ${min} is not a number between 0 and 1`);
+      continue;
+    }
+    parsed[metricId] = min;
+  }
+
+  if (errors.length > 0) {
+    throw new Error(`Invalid thresholds: ${errors.join('; ')}`);
+  }
+
+  return parsed;
+}
