@@ -13,6 +13,71 @@ const defaultFs = fs;
 
 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+export function parseThresholds(thresholdStrings) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const result = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-zA-Z_][a-zA-Z0-9_]*)=(.+)$/);
+    if (!match) {
+      throw new Error(`Invalid threshold format: "${str}". Expected "<metric>=<number>"`);
+    }
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value "${minStr}" for metric "${metricId}". Must be a number between 0 and 1`);
+    }
+    result[metricId] = min;
+  }
+  return result;
+}
+
+export function validateThresholds(thresholds, availableMetricIds) {
+  const thresholdMetrics = Object.keys(thresholds);
+  for (const metricId of thresholdMetrics) {
+    if (!availableMetricIds.includes(metricId)) {
+      const validIds = availableMetricIds.join(', ');
+      throw new Error(`Unknown metric: "${metricId}". Valid metrics are: ${validIds}`);
+    }
+  }
+}
+
+export function evaluateThresholds(evaluations, thresholds) {
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    if (!metric) {
+      results.push({
+        metric: metricId,
+        min,
+        score: null,
+        passed: false
+      });
+      allPassed = false;
+      continue;
+    }
+
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+    if (!passed) {
+      allPassed = false;
+    }
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: results };
+}
