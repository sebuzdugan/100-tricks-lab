+  const errors = [];
+  const parsed = {};
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    if (!availableMetricIds.includes(metricId)) {
+      errors.push(
+        `Unknown metric id "${metricId}". Valid metrics are: ${availableMetricIds.join(', ')}`
+      );
+      continue;
+    }
+
+    const score = Number(minScore);
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      errors.push(`Threshold for "${metricId}" must be a number between 0 and 1, got ${minScore}`);
