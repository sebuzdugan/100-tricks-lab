+function parseThresholds(thresholdStrings?: string[] | string) {
+  if (!thresholdStrings) {
+    return undefined;
+  }
+
+  const stringsArray = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  if (stringsArray.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of stringsArray) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Malformed threshold "${thresholdStr}". Expected format: <metric>=<number>`);
+    }
+
+    const [metricId, minScoreStr] = parts;
+    if (!metricId.trim()) {
+      throw new Error(`Malformed threshold "${thresholdStr}". Metric id cannot be empty.`);
+    }
+
+    const minScore = Number(minScoreStr);
+    if (Number.isNaN(minScore) || minScore < 0 || minScore > 1) {
+      throw new Error(
+        `Invalid threshold value for "${metricId}": ${minScoreStr}. Must be a number between 0 and 1.`
+      );
+    }
+
+    thresholds[metricId.trim()] = minScore;
+  }
+
+  return thresholds;
+}
