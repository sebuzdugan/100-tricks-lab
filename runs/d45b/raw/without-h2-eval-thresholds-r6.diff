+function validateThresholds(thresholds, metrics) {
+  const errors = [];
+  const knownMetricIds = metrics.map((m) => m.id);
+
+  for (const [metricId, minValue] of Object.entries(thresholds ?? {})) {
+    if (typeof minValue !== 'number') {
+      errors.push(`Threshold for ${metricId} must be a number, got ${typeof minValue}`);
+    } else if (minValue < 0 || minValue > 1) {
+      errors.push(`Threshold for ${metricId} must be between 0 and 1, got ${minValue}`);
+    }
+    if (!knownMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics are: ${knownMetricIds.join(', ')}`);
+    }
+  }
+
+  return errors;
+}
+
+function evaluateThresholds(thresholds, metrics) {
+  const results = [];
+  for (const [metricId, min] of Object.entries(thresholds ?? {})) {
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score !== undefined && score >= min;
+    results.push({
+      metric: metricId,
+      min,
+      score: score ?? null,
+      passed
+    });
+  }
+  return results;
+}
