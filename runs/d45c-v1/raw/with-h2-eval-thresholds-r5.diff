+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds) return null;
+
+  const validMetricIds = new Set(evaluations.map((e) => e.id));
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metric)) {
+      const validIds = Array.from(validMetricIds).sort();
+      throw new Error(`Unknown metric: "${metric}". Valid metrics are: ${validIds.join(', ')}`);
+    }
+
+    const evaluation = evaluations.find((e) => e.id === metric);
+    const score = evaluation.score;
+    const passed = score !== null && score >= min;
+
+    thresholdResults.push({
+      metric,
+      min,
+      score,
+      passed
+    });
+
+    if (!passed) {
+      allPassed = false;
+    }
+  }
+
+  return { thresholdResults, allPassed };
+}
