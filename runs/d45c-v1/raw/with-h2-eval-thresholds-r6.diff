+function parseAndValidateThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number>; errors?: string[] } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {} };
+  }
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-zA-Z_]+)=(.+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold "${threshStr}". Expected format: <metric>=<number>`);
+      continue;
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!Number.isFinite(value)) {
+      errors.push(`Threshold value for "${metricId}" is not a valid number: "${valueStr}"`);
+      continue;
+    }
+
+    if (value < 0 || value > 1) {
+      errors.push(`Threshold value for "${metricId}" must be between 0 and 1, got ${value}`);
+      continue;
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      errors.push(`Unknown metric: "${metricId}". Valid metrics are: ${validMetrics.join(', ')}`);
+      continue;
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  if (errors.length > 0) {
+    return { thresholds: {}, errors };
+  }
+
+  return { thresholds };
+}
