+function parseAndValidateThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number>; errors: string[] } {
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds, errors };
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`);
+      continue;
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      errors.push(`Invalid threshold minimum for "${metricId}": "${minStr}" (must be a number between 0 and 1)`);
+      continue;
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric: "${metricId}" (valid metrics: ${validMetricIds.join(', ')})`);
+      continue;
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, errors };
+}
