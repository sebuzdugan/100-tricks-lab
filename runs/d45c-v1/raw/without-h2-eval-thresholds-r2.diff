+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [] };
+  }
+
+  const errors = [];
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric id: "${metricId}". Valid metrics: ${Array.from(validMetricIds).join(', ')}`);
+    } else if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`Invalid threshold for ${metricId}: must be a number between 0 and 1, got ${min}`);
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score !== undefined && score >= min;
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    results.push({
+      metric: metricId,
+      min,
+      score: score ?? null,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: results };
+}
