+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${str}`);
+      log.error('Threshold format must be: <metric>=<number>');
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric ID: ${metricId}`);
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${minStr}`);
+      log.error('Threshold values must be numbers between 0 and 1.');
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
