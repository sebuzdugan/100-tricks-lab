+export function validateThresholds(thresholds, evaluations) {
+  const errors = [];
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+
+  if (!thresholds) return { valid: true, errors: [] };
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics: ${Array.from(validMetricIds).join(', ')}`);
+    }
+    if (typeof minValue !== 'number' || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold for ${metricId}: must be a number between 0 and 1, got ${minValue}`);
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+export function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds) return { passed: true, thresholds: [] };
+
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: thresholdResults };
+}
