index 0000000..72f89ce
--- /dev/null
+++ b/packages/frai-cli/src/index.test.ts
@@ -0,0 +1,97 @@
+import { describe, expect, it } from 'vitest';
+
+function parseThresholds(thresholdStrings: string[] | undefined, validMetricIds: string[]): { thresholds: Record<string, number>; errors?: string[] } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {} };
+  }
+
+  const errors: string[] = [];
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${thresholdStr}" (expected format: metric=number)`);
+      continue;
+    }
+
+    const [, metric, value] = match;
+    const min = parseFloat(value);
+
+    if (!validMetricIds.includes(metric)) {
+      errors.push(`Unknown metric: "${metric}" (valid metrics: ${validMetricIds.join(', ')})`);
+      continue;
+    }
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      errors.push(`Invalid threshold value for "${metric}": ${value} (must be a number between 0 and 1)`);
+      continue;
+    }
+
+    thresholds[metric] = min;
+  }
+
+  if (errors.length > 0) {
+    return { thresholds, errors };
+  }
+
+  return { thresholds };
+}
+
+describe('parseThresholds', () => {
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  it('returns empty thresholds when none provided', () => {
+    const result = parseThresholds(undefined, validMetrics);
+    expect(result.thresholds).toEqual({});
+    expect(result.errors).toBeUndefined();
+  });
+
+  it('parses valid threshold strings', () => {
+    const result = parseThresholds(['exact_match=0.9', 'toxicity=0.8'], validMetrics);
+    expect(result.thresholds).toEqual({ exact_match: 0.9, toxicity: 0.8 });
+    expect(result.errors).toBeUndefined();
+  });
+
+  it('rejects malformed threshold strings', () => {
+    const result = parseThresholds(['exact_match:0.9', 'toxicity 0.8'], validMetrics);
+    expect(result.errors).toBeDefined();
+    expect(result.errors!.length).toBe(2);
+    expect(result.errors![0]).toContain('Malformed threshold');
+  });
+
+  it('rejects unknown metrics', () => {
+    const result = parseThresholds(['unknown_metric=0.9'], validMetrics);
+    expect(result.errors).toBeDefined();
+    expect(result.errors![0]).toContain('Unknown metric');
+    expect(result.errors![0]).toContain('exact_match, toxicity, length_variance');
+  });
+
+  it('rejects invalid threshold values', () => {
+    const result = parseThresholds(['exact_match=1.5', 'toxicity=-0.1'], validMetrics);
+    expect(result.errors).toBeDefined();
+    expect(result.errors!.length).toBe(2);
+    expect(result.errors![0]).toContain('Invalid threshold value');
+  });
+
+  it('accepts boundary values 0 and 1', () => {
+    const result = parseThresholds(['exact_match=0', 'toxicity=1'], validMetrics);
+    expect(result.thresholds).toEqual({ exact_match: 0, toxicity: 1 });
+    expect(result.errors).toBeUndefined();
+  });
+
+  it('accepts decimal threshold values', () => {
+    const result = parseThresholds(['exact_match=0.95', 'toxicity=0.75'], validMetrics);
+    expect(result.thresholds).toEqual({ exact_match: 0.95, toxicity: 0.75 });
+    expect(result.errors).toBeUndefined();
+  });
+
+  it('handles multiple errors', () => {
+    const result = parseThresholds(
+      ['invalid', 'unknown_metric=0.9', 'exact_match=2.0'],
+      validMetrics
+    );
+    expect(result.errors).toBeDefined();
+    expect(result.errors!.length).toBeGreaterThanOrEqual(3);
+  });
+});
