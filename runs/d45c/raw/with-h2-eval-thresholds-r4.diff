+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${thresholdStr}`);
+      log.error('Threshold format must be: <metric>=<number>');
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      log.error(`Malformed threshold: ${thresholdStr}`);
+      log.error('Threshold minimum must be a valid number');
+      process.exit(2);
+    }
+
+    if (value < 0 || value > 1) {
+      log.error(`Malformed threshold: ${thresholdStr}`);
+      log.error('Threshold minimum must be between 0 and 1');
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`);
+      log.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
