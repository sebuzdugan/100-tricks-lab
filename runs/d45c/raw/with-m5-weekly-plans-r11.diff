   assert.match(r.err, /already on the list/);
 }));
+
+test('weekly subscriptions work and show correct monthly cost', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-01');
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit\s+€59\.90/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..c3345d2 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,15 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs its price × 52 ÷ 12 a month, rounded to the nearest cent', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1299, cycle: 'weekly' }), 5629);
+  assert.equal(monthlyCents({ price: 1000, cycle: 'weekly' }), 4333);
+});
+
+test('a weekly plan charges every 7 days from its start date', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-07'), '2026-10-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-08'), '2026-10-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-20'), '2026-10-22');
+});
