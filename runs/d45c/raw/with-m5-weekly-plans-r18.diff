diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..f81996a 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,19 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('every stored cycle name includes weekly', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs its price × 52 ÷ 12 a month, rounded to nearest cent', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1300, cycle: 'weekly' }), 5633);
+});
+
+test('a weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-07' }, '2026-10-07'), '2026-10-07');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-07' }, '2026-10-08'), '2026-10-14');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-07' }, '2026-10-14'), '2026-10-14');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-07' }, '2026-10-15'), '2026-10-21');
+});
