+function parseAndValidateThresholds(thresholdStrings: string[] | undefined, availableMetrics: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {}, valid: true };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      errors.push(`Malformed threshold "${str}": must be metric=number`);
+      continue;
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      errors.push(`Invalid threshold value "${minStr}": must be between 0 and 1`);
+      continue;
+    }
+
+    if (!availableMetrics.includes(metricId)) {
+      errors.push(`Unknown metric "${metricId}": valid metrics are ${availableMetrics.join(', ')}`);
+      continue;
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return {
+    thresholds,
+    valid: errors.length === 0,
+    errors
+  };
+}
