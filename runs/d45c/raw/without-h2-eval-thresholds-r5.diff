+function parseThresholds(thresholdStrs?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrs) return thresholds;
+
+  for (const thresholdStr of thresholdStrs) {
+    const match = thresholdStr.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      throw new Error(`Invalid threshold format: "${thresholdStr}". Expected "<metric>=<number>"`);
+    }
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+    if (value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for "${metric}": ${value}. Must be between 0 and 1.`);
+    }
+    thresholds[metric] = value;
+  }
+  return thresholds;
+}
