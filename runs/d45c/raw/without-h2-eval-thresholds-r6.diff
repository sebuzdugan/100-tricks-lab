+function parseThresholds(thresholdStrs?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return thresholds;
+  }
+  for (const str of thresholdStrs) {
+    const [metric, minStr] = str.split('=');
+    if (!metric || minStr === undefined) {
+      log.error(`Malformed threshold: "${str}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold minimum: "${minStr}". Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+    thresholds[metric] = min;
+  }
+  return thresholds;
+}
