+function parseThresholds(thresholdArgs: string[] = []) {
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${arg}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value: "${valueStr}" for metric "${metric}". Value must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metric)) {
+      log.error(`Unknown metric: "${metric}". Valid metrics: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
