+function parseThresholds(thresholdStrings: string[] = []) {
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      errors.push(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+      continue;
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(
+        `Unknown metric: "${metricId}". Valid metrics: ${validMetricIds.join(', ')}`
+      );
+      continue;
+    }
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      errors.push(
+        `Invalid threshold value for "${metricId}": "${valueStr}". Must be a number between 0 and 1.`
+      );
+      continue;
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  if (errors.length > 0) {
+    log.error('Threshold validation failed:');
+    errors.forEach((error) => console.error(`  - ${error}`));
+    process.exit(2);
+  }
+
+  return thresholds;
+}
