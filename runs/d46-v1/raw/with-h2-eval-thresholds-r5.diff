diff --git a/test-thresholds-final.js b/test-thresholds-final.js
new file mode 100644
index 0000000..0d42200
--- /dev/null
+++ b/test-thresholds-final.js
@@ -0,0 +1,144 @@
+import path from 'path';
+import { fileURLToPath } from 'url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+
+// Import directly from source
+const { generateReport, runEvaluations } = await import('./packages/frai-core/src/eval/index.js');
+
+function test(name, fn) {
+  try {
+    fn();
+    console.log(`✓ ${name}`);
+  } catch (error) {
+    console.error(`✗ ${name}`);
+    console.error(`  ${error.message}`);
+    process.exit(1);
+  }
+}
+
+function assertEquals(actual, expected, message) {
+  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
+    throw new Error(`${message}: expected ${JSON.stringify(expected)}, got ${JSON.stringify(actual)}`);
+  }
+}
+
+function assertTrue(actual, message) {
+  if (!actual) {
+    throw new Error(message);
+  }
+}
+
+test('generateReport with failing thresholds', () => {
+  const evaluations = runEvaluations({
+    outputs: ['cat', 'dog'],
+    references: ['not_in_outputs1', 'not_in_outputs2']
+  });
+
+  const report = generateReport({
+    evaluations,
+    outputsPath: '/tmp/outputs.json',
+    referencesPath: '/tmp/refs.json',
+    thresholds: {
+      exact_match: 0.5
+    }
+  });
+
+  assertTrue(report.passed === false, 'report.passed should be false when exact_match is 0 < 0.5');
+  assertEquals(report.thresholds.length, 1, 'should have 1 threshold');
+
+  const exactMatch = report.thresholds.find(t => t.metric === 'exact_match');
+  assertTrue(exactMatch.passed === false, 'exact_match threshold should fail when outputs don\'t match references');
+  assertEquals(exactMatch.score, 0, 'exact_match score should be 0 when no matches');
+});
+
+test('generateReport with all passing thresholds', () => {
+  const evaluations = runEvaluations({
+    outputs: ['apple', 'banana'],
+    references: ['apple', 'banana']
+  });
+
+  const report = generateReport({
+    evaluations,
+    outputsPath: '/tmp/outputs.json',
+    referencesPath: '/tmp/refs.json',
+    thresholds: {
+      exact_match: 0.5,
+      length_variance: 0.5
+    }
+  });
+
+  assertTrue(report.passed === true, 'report.passed should be true when all thresholds pass');
+  assertEquals(report.thresholds.length, 2, 'should have 2 thresholds');
+
+  const exactMatch = report.thresholds.find(t => t.metric === 'exact_match');
+  assertTrue(exactMatch.passed, 'exact_match threshold should pass when outputs match references');
+  assertEquals(exactMatch.score, 1, 'exact_match score should be 1 when all match');
+
+  const lengthVariance = report.thresholds.find(t => t.metric === 'length_variance');
+  assertTrue(lengthVariance.passed, 'length_variance threshold should pass');
+});
+
+test('generateReport with null score failing threshold', () => {
+  const evaluations = runEvaluations({
+    outputs: ['hello'],
+    references: []
+  });
+
+  const report = generateReport({
+    evaluations,
+    outputsPath: '/tmp/outputs.json',
+    referencesPath: '/tmp/refs.json',
+    thresholds: {
+      exact_match: 0.5
+    }
+  });
+
+  assertTrue(report.passed === false, 'report.passed should be false when score is null');
+
+  const exactMatch = report.thresholds.find(t => t.metric === 'exact_match');
+  assertTrue(exactMatch.passed === false, 'threshold should fail when score is null');
+  assertEquals(exactMatch.score, null, 'score should be null');
+});
+
+test('generateReport without thresholds has no passed field', () => {
+  const evaluations = runEvaluations({
+    outputs: ['apple', 'banana'],
+    references: ['apple', 'banana']
+  });
+
+  const report = generateReport({
+    evaluations,
+    outputsPath: '/tmp/outputs.json',
+    referencesPath: '/tmp/refs.json'
+  });
+
+  assertTrue(!report.hasOwnProperty('passed'), 'report should not have passed field');
+  assertTrue(!report.hasOwnProperty('thresholds'), 'report should not have thresholds field');
+});
+
+test('generateReport with mixed passing and failing thresholds', () => {
+  const evaluations = runEvaluations({
+    outputs: ['apple', 'banana', 'cherry'],
+    references: ['apple', 'banana', 'grape']
+  });
+
+  const report = generateReport({
+    evaluations,
+    outputsPath: '/tmp/outputs.json',
+    referencesPath: '/tmp/refs.json',
+    thresholds: {
+      exact_match: 0.8,
+      length_variance: 0.99
+    }
+  });
+
+  assertTrue(report.passed === false, 'report.passed should be false when at least one threshold fails');
+
+  const exactMatch = report.thresholds.find(t => t.metric === 'exact_match');
+  // 2 out of 3 match = 0.6667 which is < 0.8, so it should fail
+  assertTrue(exactMatch.passed === false, 'exact_match threshold should fail with score < 0.8');
+  assertTrue(exactMatch.score < 0.8, 'exact_match score should be less than 0.8');
+});
+
+console.log('\nAll core threshold tests passed!');
