+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings) return thresholds;
+
+  const validMetrics = new Set(['exact_match', 'toxicity', 'length_variance']);
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error('Invalid threshold format. Expected: <metric>=<number>');
+      process.exit(2);
+    }
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+    if (!validMetrics.has(metricId)) {
+      log.error(`Unknown metric: ${metricId}. Valid metrics are: ${Array.from(validMetrics).join(', ')}`);
+      process.exit(2);
+    }
+    thresholds[metricId] = min;
+  }
+  return thresholds;
+}
