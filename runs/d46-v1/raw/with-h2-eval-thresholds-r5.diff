+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+
+// Import directly from source
+const {
+  generateReport,
+  runEvaluations,
+  writeReport,
+  loadDataset
+} = await import('./packages/frai-core/src/eval/index.js');
+
+console.log('=== FRAI Threshold Feature Verification ===\n');
+
+// Test 1: Create test data
+console.log('1. Creating test data files...');
+const testDir = path.join(__dirname, 'test-eval');
+const outputsFile = path.join(testDir, 'outputs.json');
+const referencesFile = path.join(testDir, 'references.json');
+
+if (!fs.existsSync(testDir)) {
+  fs.mkdirSync(testDir, { recursive: true });
+}
+
+const outputs = ['apple', 'banana', 'cherry'];
+const references = ['apple', 'banana', 'date'];
+
+fs.writeFileSync(outputsFile, JSON.stringify(outputs));
+fs.writeFileSync(referencesFile, JSON.stringify(references));
+console.log('✓ Created outputs.json and references.json\n');
+
+// Test 2: Load dataset
+console.log('2. Loading dataset...');
+const dataset = loadDataset({
+  outputsPath: outputsFile,
+  referencesPath: referencesFile
+});
+console.log(`✓ Loaded ${dataset.outputs.length} outputs and ${dataset.references.length} references\n`);
+
+// Test 3: Run evaluations
+console.log('3. Running evaluations...');
+const evaluations = runEvaluations({
+  outputs: dataset.outputs,
+  references: dataset.references
+});
+console.log(`✓ Generated ${evaluations.length} metrics\n`);
+
+// Test 4: Generate report with thresholds
+console.log('4. Generating report with thresholds...');
+const thresholds = {
+  exact_match: 0.6,
+  length_variance: 0.5
+};
+
+const report = generateReport({
+  evaluations,
+  outputsPath: dataset.outputsPath,
+  referencesPath: dataset.referencesPath,
+  thresholds
+});
+
+console.log(`✓ Report generated with passed=${report.passed}\n`);
+
+// Test 5: Verify threshold results
+console.log('5. Verifying threshold results...');
+if (report.thresholds && Array.isArray(report.thresholds)) {
+  report.thresholds.forEach((t) => {
+    const status = t.passed ? '✓ PASS' : '✗ FAIL';
+    console.log(`  ${status} | ${t.metric}: score=${t.score}, min=${t.min}`);
+  });
+} else {
+  console.error('ERROR: No thresholds in report!');
+  process.exit(1);
+}
+console.log('');
+
+// Test 6: Write JSON report
+console.log('6. Writing JSON report...');
+const jsonReportPath = path.join(testDir, 'report.json');
+writeReport({
+  report,
+  format: 'json',
+  reportPath: jsonReportPath
+});
+console.log(`✓ JSON report written to ${jsonReportPath}\n`);
+
+// Test 7: Write Markdown report
+console.log('7. Writing Markdown report...');
+const mdReportPath = path.join(testDir, 'report.md');
+writeReport({
+  report,
+  format: 'markdown',
+  reportPath: mdReportPath
+});
+console.log(`✓ Markdown report written to ${mdReportPath}\n`);
+
+// Test 8: Verify Markdown includes thresholds
+console.log('8. Verifying Markdown report includes thresholds...');
+const mdContent = fs.readFileSync(mdReportPath, 'utf8');
+if (mdContent.includes('## Thresholds')) {
+  console.log('✓ Markdown includes Thresholds section\n');
+} else {
+  console.error('ERROR: Markdown does not include Thresholds section!');
+  process.exit(1);
+}
+
+// Test 9: Verify JSON report structure
+console.log('9. Verifying JSON report structure...');
+const jsonContent = fs.readFileSync(jsonReportPath, 'utf8');
+const jsonReport = JSON.parse(jsonContent);
+if (jsonReport.passed !== undefined && Array.isArray(jsonReport.thresholds)) {
+  console.log(`✓ JSON report has passed=${jsonReport.passed} and ${jsonReport.thresholds.length} thresholds\n`);
+} else {
+  console.error('ERROR: JSON report structure is incorrect!');
+  process.exit(1);
+}
+
+// Test 10: Test failing thresholds
+console.log('10. Testing with failing thresholds...');
+const strictThresholds = {
+  exact_match: 0.9
+};
+
+const strictReport = generateReport({
+  evaluations,
+  outputsPath: dataset.outputsPath,
+  referencesPath: dataset.referencesPath,
+  thresholds: strictThresholds
+});
+
+if (strictReport.passed === false) {
+  console.log('✓ Report correctly marked as failed when threshold not met\n');
+} else {
+  console.error('ERROR: Report should be marked as failed!');
+  process.exit(1);
+}
+
+console.log('=== All verification tests PASSED! ===\n');
+
+// Clean up test files
+console.log('Cleaning up test files...');
+fs.rmSync(testDir, { recursive: true });
+console.log('✓ Test files cleaned up');
