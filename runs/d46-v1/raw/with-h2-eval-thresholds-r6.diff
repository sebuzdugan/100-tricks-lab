+function parseThresholds(thresholdStrings: string[] = []): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(
+        `Malformed threshold "${str}". Format must be <metric>=<number>, for example: exact_match=0.9`
+      );
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value "${minStr}" for metric "${metricId}". Value must be between 0 and 1.`);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
