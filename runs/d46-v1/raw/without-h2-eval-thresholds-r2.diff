+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      log.error('Invalid threshold format.', {
+        value: thresholdStr,
+        expected: 'metric=number (e.g., exact_match=0.9)'
+      });
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const value = Number.parseFloat(match[2]);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error('Threshold value must be a number between 0 and 1.', {
+        metric: metricId,
+        value: match[2]
+      });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
