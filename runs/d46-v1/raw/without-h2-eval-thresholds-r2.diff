+export function validateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [] };
+  }
+
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+  const errors = [];
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric id '${metricId}'. Valid metrics: ${Array.from(validMetricIds).join(', ')}`);
+      continue;
+    }
+
+    if (typeof minValue !== 'number') {
+      errors.push(`Threshold for '${metricId}' must be a number, got ${typeof minValue}`);
+      continue;
+    }
+
+    if (minValue < 0 || minValue > 1) {
+      errors.push(`Threshold for '${metricId}' must be between 0 and 1, got ${minValue}`);
+    }
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors
+  };
+}
