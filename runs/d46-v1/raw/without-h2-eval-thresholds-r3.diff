+interface ParsedThresholds {
+  valid: boolean;
+  thresholds?: Record<string, number>;
+  error?: string;
+  validMetricIds?: string[];
+}
+
+function parseThresholds(thresholdInput: string | string[] | undefined, availableMetricIds: string[]): ParsedThresholds {
+  if (!thresholdInput) {
+    return { valid: true, thresholds: {} };
+  }
+
+  const inputs = Array.isArray(thresholdInput) ? thresholdInput : [thresholdInput];
+  const thresholds: Record<string, number> = {};
+
+  for (const input of inputs) {
+    const match = input.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      return {
+        valid: false,
+        error: `Invalid threshold format: "${input}". Expected format: <metric>=<number>`,
+        validMetricIds: availableMetricIds
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min)) {
+      return {
+        valid: false,
+        error: `Invalid threshold value for "${metricId}": "${minStr}" is not a number`,
+        validMetricIds: availableMetricIds
+      };
+    }
+
+    if (min < 0 || min > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold value for "${metricId}": ${min} is outside the range [0, 1]`,
+        validMetricIds: availableMetricIds
+      };
+    }
+
+    if (!availableMetricIds.includes(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric: "${metricId}"`,
+        validMetricIds: availableMetricIds
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { valid: true, thresholds };
+}
