+function parseThresholds(thresholdStrs?: string[]): { [metric: string]: number } | null {
+  if (!thresholdStrs || !thresholdStrs.length) return null;
+
+  const thresholds: { [metric: string]: number } = {};
+  for (const str of thresholdStrs) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Malformed threshold: "${str}" (expected format: metric=number)`);
+    }
+    const [metric, minStr] = parts;
+    if (!metric) {
+      throw new Error(`Malformed threshold: "${str}" (metric name is empty)`);
+    }
+    const min = parseFloat(minStr);
+    if (isNaN(min)) {
+      throw new Error(`Malformed threshold: "${str}" (minimum is not a number)`);
+    }
+    if (min < 0 || min > 1) {
+      throw new Error(`Malformed threshold: "${str}" (minimum must be between 0 and 1)`);
+    }
+    thresholds[metric] = min;
+  }
+  return thresholds;
+}
+
+function getValidMetricIds(evaluations: any[]): string[] {
+  return evaluations.map((eval: any) => eval.id).filter((id: string) => typeof id === 'string');
+}
