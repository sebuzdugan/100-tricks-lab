diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..a6ef3da 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,32 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add weekly subscription and show in list', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('weekly subscriptions show in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /24 Oct.*Meal kit.*€59\.90/);
+  const r2 = cli(file, 'renewals', '--within', '7', '--today', '2026-10-31');
+  assert.match(r2.out, /31 Oct.*Meal kit.*€59\.90/);
+}));
+
+test('export works with weekly subscriptions', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  assert.match(cli(file, 'export', '--today', '2026-10-24').out,
+    /Meal kit,59.90,weekly,259.57,2026-10-24/);
+}));
+
+test('total includes weekly subscriptions correctly', () => withFile((file) => {
+  cli(file, 'add', 'Netflix', '12.99', '--since', '2026-10-24');
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  // Netflix: 12.99/month, Meal kit: 59.90*52/12 ≈ 259.57
+  assert.match(cli(file, 'total').out, /Monthly total: €272\.55/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..b7609b2 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -3,6 +3,7 @@ import assert from 'node:assert/strict';
 import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
 
 test('every stored cycle name is known', () => {
+  assert.ok(CYCLES.includes('weekly'));
   assert.ok(CYCLES.includes('monthly'));
   assert.ok(CYCLES.includes('yearly'));
 });
@@ -36,3 +37,20 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month (rounded to nearest cent)', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200); // 1200*52/12 = 5200
+  assert.equal(monthlyCents({ price: 1, cycle: 'weekly' }), 4); // 1*52/12 = 4.333... rounds to 4
+  assert.equal(monthlyCents({ price: 50, cycle: 'weekly' }), 217); // 50*52/12 = 216.666... rounds to 217
+});
+
+test('the next charge of a weekly plan is 7 days later', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-20' }, '2026-10-24'), '2026-10-27');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-03' }, '2026-10-24'), '2026-10-24');
+});
+
+test('weekly plans charge every 7 days from their first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-24'), '2026-10-29'); // 10-01, 10-08, 10-15, 10-22, 10-29
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-01-02' }, '2026-10-24'), '2026-10-30'); // 7 days after 10-23
+});
