+function parseThresholds(thresholdStrings: string[] | undefined, evaluations: any[]): { thresholds: Record<string, number>; errors?: string[] } {
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds };
+  }
+
+  const validMetricIds = new Set(evaluations.map((e: any) => e.id));
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`);
+      continue;
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (Number.isNaN(min)) {
+      errors.push(`Malformed threshold: "${thresholdStr}" (minimum must be a number)`);
+      continue;
+    }
+
+    if (min < 0 || min > 1) {
+      errors.push(`Invalid threshold: "${thresholdStr}" (minimum must be between 0 and 1)`);
+      continue;
+    }
+
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric: "${metricId}" (valid metrics: ${Array.from(validMetricIds).join(', ')})`);
+      continue;
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return errors.length > 0 ? { thresholds, errors } : { thresholds };
+}
