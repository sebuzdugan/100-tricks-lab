+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, error: null };
+  }
+
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      const available = Array.from(validMetricIds).sort().join(', ');
+      return {
+        valid: false,
+        error: `Unknown metric: ${metricId}. Valid metrics: ${available}`
+      };
+    }
+
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold for ${metricId}: must be a number between 0 and 1, got ${min}`
+      };
+    }
+  }
+
+  return { valid: true, error: null };
+}
+
+function checkThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return {
+      results: [],
+      allPassed: true
+    };
+  }
+
+  const metricsById = Object.fromEntries(evaluations.map((m) => [m.id, m]));
+  const results = [];
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = metricsById[metricId];
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  return {
+    results,
+    allPassed: results.every((r) => r.passed)
+  };
+}
