diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..3ccb8a0 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,11 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('weekly subscriptions work', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-25');
+  const list = cli(file, 'list');
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+  const renewals = cli(file, 'renewals', '--within', '7', '--today', '2026-10-25');
+  assert.match(renewals.out, /25 Oct\s+Meal kit\s+€59\.90/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..ba1fe97 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -4,6 +4,7 @@ import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
 
 test('every stored cycle name is known', () => {
   assert.ok(CYCLES.includes('monthly'));
+  assert.ok(CYCLES.includes('weekly'));
   assert.ok(CYCLES.includes('yearly'));
 });
 
@@ -17,6 +18,11 @@ test('a yearly plan costs a twelfth of its price a month', () => {
   assert.equal(monthlyCents({ price: 2400, cycle: 'yearly' }), 200);
 });
 
+test('a weekly plan costs 52 divided by 12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25956);
+});
+
 test('the next charge of a plan that charges today is today', () => {
   assert.equal(nextCharge({ cycle: 'monthly', since: '2026-08-24' }, '2026-10-24'), '2026-10-24');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2025-10-24' }, '2026-10-24'), '2026-10-24');
@@ -36,3 +42,12 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan charges every 7 days from its first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-22' }, '2026-10-24'), '2026-10-29');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
