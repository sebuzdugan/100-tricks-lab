diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..635dac1 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,31 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add supports weekly plans', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-09-14').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('renewals shows weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12.00', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '24 Oct  Meal kit  €12.00\n31 Oct  Meal kit  €12.00\n');
+}));
+
+test('weekly plan charges every 7 days within renewals window', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12.00', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /24 Oct.*Meal kit.*€12\.00/);
+  assert.match(r.out, /31 Oct.*Meal kit.*€12\.00/);
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12.00', '--every', 'week', '--since', '2026-10-24');
+  assert.match(cli(file, 'export', '--today', '2026-10-24').out,
+    /Meal kit,12\.00,weekly,52\.00,2026-10-24/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..c24d5e7 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,23 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1100, cycle: 'weekly' }), 4766);
+});
+
+test('the next charge of a weekly plan that charges today is today', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-10-24'), '2026-10-24');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-31' }, '2026-10-24'), '2026-10-31');
+});
+
+test('weekly plans charge every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-01'), '2026-10-01');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-02'), '2026-10-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-08'), '2026-10-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-01' }, '2026-10-15'), '2026-10-15');
+});
