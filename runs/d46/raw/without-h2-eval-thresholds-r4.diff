+function parseThresholds(thresholdStrings: string[] = []): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = new Set(['exact_match', 'toxicity', 'length_variance']);
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      const error = new Error(`Malformed threshold: ${threshStr} (expected format: <metric>=<number>)`);
+      (error as any).code = 'MALFORMED_THRESHOLD';
+      throw error;
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!validMetricIds.has(metricId)) {
+      const error = new Error(
+        `Unknown metric: ${metricId}\nValid metric ids: ${Array.from(validMetricIds).join(', ')}`
+      );
+      (error as any).code = 'UNKNOWN_METRIC';
+      throw error;
+    }
+
+    if (value < 0 || value > 1) {
+      const error = new Error(
+        `Threshold value for ${metricId} must be between 0 and 1: ${value}`
+      );
+      (error as any).code = 'INVALID_THRESHOLD';
+      throw error;
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
