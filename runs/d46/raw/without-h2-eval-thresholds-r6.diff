+function parseThresholds(thresholdStrings: string[] | undefined) {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { valid: true, thresholds };
+  }
+
+  const validMetrics = new Set(['exact_match', 'toxicity', 'length_variance']);
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        valid: false,
+        error: `Malformed threshold: ${thresholdStr}. Format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!validMetrics.has(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric: ${metricId}. Valid metrics: ${Array.from(validMetrics).join(', ')}`
+      };
+    }
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold value: ${minStr}. Must be a number between 0 and 1.`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { valid: true, thresholds };
+}
