diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..0a4b993 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,27 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add weekly subscription', () => withFile((file) => {
+  const r = cli(file, 'add', 'Meal kit', '12', '--every', 'week', '--since', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€12\.00 weekly.*€52\.00 a month/);
+}));
+
+test('list shows what a weekly plan costs a month', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  assert.match(cli(file, 'list').out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('renewals shows weekly subscriptions like monthly', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12.99', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /24 Oct.*Meal kit.*€12\.99/);
+}));
+
+test('export includes weekly subscriptions', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12', '--every', 'week', '--since', '2026-10-17');
+  assert.equal(cli(file, 'export', '--today', '2026-10-24').out,
+    'name,price,cycle,monthly_cost,next_charge\nMeal kit,12.00,weekly,52.00,2026-10-24\n');
+}));
