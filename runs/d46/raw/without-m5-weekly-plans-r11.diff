diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..8b73864 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,31 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52 weeks over 12 months', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 100, cycle: 'weekly' }), 433);
+});
+
+test('the next charge of a weekly plan that charges today is today', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
+
+test('a weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-31'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-11-01'), '2026-11-07');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-12-25'), '2026-12-26');
+});
+
+test('real-world example: meal kit €59.90/week', () => {
+  const mealKit = { price: 5990, cycle: 'weekly', since: '2026-10-24' };
+  assert.equal(monthlyCents(mealKit), 25956);
+  assert.equal(nextCharge(mealKit, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge(mealKit, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge(mealKit, '2026-11-07'), '2026-11-07');
+});
