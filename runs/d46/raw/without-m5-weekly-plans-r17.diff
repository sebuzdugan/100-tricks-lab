diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..1f50382 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,29 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add a weekly plan and show its monthly cost', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-19').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('weekly plan shows next charge in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-19');
+  const r = cli(file, 'renewals', '--within', '30', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /26 Oct.*Meal kit.*€59\.90/);
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12.00', '--every', 'week', '--since', '2026-10-19');
+  assert.equal(cli(file, 'export', '--today', '2026-10-25').out,
+    'name,price,cycle,monthly_cost,next_charge\nMeal kit,12.00,weekly,52.00,2026-10-26\n');
+}));
+
+test('total includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Netflix', '9.99', '--every', 'month', '--since', '2026-10-24');
+  cli(file, 'add', 'Meal kit', '12.00', '--every', 'week', '--since', '2026-10-19');
+  assert.match(cli(file, 'total').out, /Monthly total: €61\.99.*2 plans/);
+}));
