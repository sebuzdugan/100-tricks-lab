diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..ec18913 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,20 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add weekly plan and show its monthly cost', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('weekly plan appears in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '24 Oct  Meal kit  €59.90\n');
+  const r2 = cli(file, 'renewals', '--within', '7', '--today', '2026-10-25');
+  assert.equal(r2.code, 0);
+  assert.equal(r2.out, '31 Oct  Meal kit  €59.90\n');
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..6f4a48f 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,24 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52÷12 times its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25957);
+  assert.equal(monthlyCents({ price: 100, cycle: 'weekly' }), 433);
+});
+
+test('the next charge of a weekly plan is 7 days after today if today is not a charge day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-09-24' }, '2026-10-24'), '2026-10-29');
+});
+
+test('the next charge of a weekly plan is today if today is a charge day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+});
+
+test('a weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-01-01' }, '2026-01-01'), '2026-01-01');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-01-01' }, '2026-01-02'), '2026-01-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-01-01' }, '2026-01-08'), '2026-01-08');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-01-01' }, '2026-01-15'), '2026-01-15');
+});
