+function parseThresholds(thresholdStrings: string[] | undefined, availableMetrics: string[]): { thresholds: Record<string, number> | undefined; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: undefined };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        thresholds: undefined,
+        error: `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      return {
+        thresholds: undefined,
+        error: `Invalid threshold value for "${metricId}": ${valueStr}. Value must be a number between 0 and 1.`
+      };
+    }
+
+    if (!availableMetrics.includes(metricId)) {
+      return {
+        thresholds: undefined,
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${availableMetrics.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds };
+}
