+interface ThresholdError {
+  type: 'error';
+  error: string;
+  validMetrics: string[];
+}
+
+type ThresholdResult = { [key: string]: number } | ThresholdError;
+
+function parseThresholds(thresholdStrings: string[] | string | undefined): ThresholdResult {
+  if (!thresholdStrings || (typeof thresholdStrings === 'string' && !thresholdStrings)) {
+    return {} as { [key: string]: number };
+  }
+
+  const strings = typeof thresholdStrings === 'string' ? [thresholdStrings] : (thresholdStrings || []);
+
+  if (strings.length === 0) {
+    return {} as { [key: string]: number };
+  }
+
+  const thresholds: { [key: string]: number } = {};
+
+  for (const str of strings) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      return {
+        type: 'error',
+        error: `Invalid threshold format: "${str}". Expected format: metric=value (e.g., exact_match=0.9)`,
+        validMetrics: ['exact_match', 'toxicity', 'length_variance']
+      };
+    }
+
+    const [metricId, valueStr] = parts;
+    const value = Number(valueStr);
+
+    if (isNaN(value) || value < 0 || value > 1) {
+      return {
+        type: 'error',
+        error: `Invalid threshold value: "${valueStr}". Must be a number between 0 and 1.`,
+        validMetrics: ['exact_match', 'toxicity', 'length_variance']
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
