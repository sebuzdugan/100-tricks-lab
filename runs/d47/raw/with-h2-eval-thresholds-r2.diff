diff --git a/test-custom-metric.mjs b/test-custom-metric.mjs
new file mode 100644
index 0000000..71ab1ce
--- /dev/null
+++ b/test-custom-metric.mjs
@@ -0,0 +1,47 @@
+import {
+  runEvaluations,
+  generateReport,
+  DEFAULT_METRICS
+} from './packages/frai-core/src/eval/index.js';
+
+// Test with default metrics
+const evaluations = runEvaluations({
+  outputs: ['hello', 'world'],
+  references: ['hello', 'world']
+});
+
+// Test generateReport with thresholds
+const report = generateReport({
+  evaluations,
+  outputsPath: '/tmp/outputs.json',
+  referencesPath: '/tmp/references.json',
+  thresholds: { exact_match: 0.9 }
+});
+
+console.log('Report has passed:', 'passed' in report);
+console.log('Report has thresholds:', 'thresholds' in report);
+console.log('Thresholds array:', JSON.stringify(report.thresholds, null, 2));
+
+// Test with custom metric
+const customMetric = (outputs, references) => ({
+  id: 'custom_metric',
+  label: 'Custom Metric',
+  score: 0.85,
+  total: outputs.length
+});
+
+const evaluationsWithCustom = runEvaluations({
+  outputs: ['hello', 'world'],
+  references: ['hello', 'world'],
+  metrics: [...DEFAULT_METRICS, customMetric]
+});
+
+const reportWithCustom = generateReport({
+  evaluations: evaluationsWithCustom,
+  outputsPath: '/tmp/outputs.json',
+  referencesPath: '/tmp/references.json',
+  thresholds: { custom_metric: 0.8 }
+});
+
+console.log('Report with custom metric has thresholds:', 'thresholds' in reportWithCustom);
+console.log('Custom metric threshold:', JSON.stringify(reportWithCustom.thresholds.find(t => t.metric === 'custom_metric'), null, 2));
