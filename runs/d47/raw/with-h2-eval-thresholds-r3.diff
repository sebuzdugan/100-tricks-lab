+export function parseThresholds(thresholdStrings, metricIds) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const result = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        error: `Invalid threshold format: "${thresholdStr}". Expected <metric>=<number>.`
+      };
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+    const minScore = parseFloat(minStr);
+
+    if (!metricIds.includes(metricId)) {
+      return {
+        error: `Unknown metric id: "${metricId}". Valid metric ids: ${metricIds.join(', ')}.`
+      };
+    }
+
+    if (minScore < 0 || minScore > 1) {
+      return {
+        error: `Invalid threshold minimum for "${metricId}": ${minScore}. Minimum must be between 0 and 1.`
+      };
+    }
+
+    result[metricId] = minScore;
+  }
+
+  return result;
+}
