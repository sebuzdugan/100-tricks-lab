+function parseThresholds(thresholdArgs?: string[]) {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return { thresholds: null, validationError: null };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const defaultMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        thresholds: null,
+        validationError: `Malformed threshold "${arg}": expected format <metric>=<number>`
+      };
+    }
+
+    const metricId = match[1];
+    const minValue = parseFloat(match[2]);
+
+    if (isNaN(minValue) || minValue < 0 || minValue > 1) {
+      return {
+        thresholds: null,
+        validationError: `Invalid minimum value for "${metricId}": must be between 0 and 1, got ${minValue}`
+      };
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  // Check for unknown metrics
+  const unknownMetrics = Object.keys(thresholds).filter(
+    (id) => !defaultMetricIds.includes(id)
+  );
+  if (unknownMetrics.length > 0) {
+    return {
+      thresholds: null,
+      validationError: `Unknown metric(s): ${unknownMetrics.join(', ')}. Valid metric IDs are: ${defaultMetricIds.join(', ')}`
+    };
+  }
+
+  return { thresholds, validationError: null };
+}
