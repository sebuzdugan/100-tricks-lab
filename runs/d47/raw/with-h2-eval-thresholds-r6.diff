+function validateAndParseThresholds(thresholds, metrics) {
+  if (!thresholds) return null;
+
+  const metricIds = metrics.map((m) => m.id);
+  const parsed = {};
+  const results = [];
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    if (!metricIds.includes(metricId)) {
+      const error = new Error(`Unknown metric: ${metricId}. Valid metrics: ${metricIds.join(', ')}`);
+      error.code = 'UNKNOWN_METRIC';
+      throw error;
+    }
+
+    if (typeof minValue !== 'number') {
+      const error = new Error(`Invalid threshold minimum for ${metricId}: must be a number`);
+      error.code = 'INVALID_THRESHOLD';
+      throw error;
+    }
+
+    if (minValue < 0 || minValue > 1) {
+      const error = new Error(`Invalid threshold minimum for ${metricId}: must be between 0 and 1`);
+      error.code = 'INVALID_THRESHOLD';
+      throw error;
+    }
+
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric.score;
+    const passed = score !== null && score >= minValue;
+
+    results.push({
+      metric: metricId,
+      min: minValue,
+      score: score,
+      passed
+    });
+  }
+
+  return results;
+}
