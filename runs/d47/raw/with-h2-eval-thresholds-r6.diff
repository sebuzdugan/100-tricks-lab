+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      const error = new Error(`Invalid threshold format: ${thresholdStr}. Expected format: <metric>=<number>`);
+      (error as any).code = 'INVALID_THRESHOLD_FORMAT';
+      throw error;
+    }
+
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      const error = new Error(`Invalid threshold minimum for ${metric}: must be between 0 and 1, got ${value}`);
+      (error as any).code = 'INVALID_THRESHOLD';
+      throw error;
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
