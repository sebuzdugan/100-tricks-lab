 Because `frai-core` is a regular ESM package, you can import only the modules you need and embed FRAI capabilities inside automation pipelines, CI jobs, or custom products.
 
+Example: run evaluations with thresholds.
+
+```js
+import { Eval } from 'frai-core';
+
+const outputs = ['hello', 'world'];
+const references = ['hello', 'world'];
+
+const evaluations = Eval.runEvaluations({ outputs, references });
+const report = Eval.generateReport({
+  evaluations,
+  outputsPath: 'outputs.json',
+  referencesPath: 'refs.json',
+  thresholds: { exact_match: 0.9, toxicity: 0.5 }
+});
+
+// report.passed is true if all thresholds pass
+// report.thresholds contains per-threshold results
+if (report.passed === false) {
+  console.log('Some thresholds failed:');
+  report.thresholds.forEach(t => {
+    console.log(`  ${t.metric}: ${t.score ?? 'n/a'} (min: ${t.min})`);
+  });
+}
+```
+
