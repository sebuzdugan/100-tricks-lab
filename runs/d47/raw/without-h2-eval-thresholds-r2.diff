+function parseThresholds(thresholdStrs: string[] | undefined, knownMetricIds: string[]): { thresholds: Record<string, number>; exitCode: number } | null {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return { thresholds: {}, exitCode: 0 };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrs) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error(`Malformed threshold: ${thresholdStr}. Expected format: <metric>=<number>`);
+      return null;
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold minimum for ${metricId}: ${minStr}. Must be a number between 0 and 1.`);
+      return null;
+    }
+
+    if (!knownMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}. Valid metrics are: ${knownMetricIds.join(', ')}`);
+      return null;
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, exitCode: 0 };
+}
