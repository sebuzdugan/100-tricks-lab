diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..1470a41 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,23 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add and list weekly subscriptions', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-18').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('renewals shows weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-18');
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit\s+€59\.90/);
+}));
+
+test('export includes weekly subscriptions', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-18');
+  const out = cli(file, 'export', '--today', '2026-10-24').out;
+  assert.match(out, /Meal kit,59.90,weekly/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..f2dfa7e 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -3,10 +3,17 @@ import assert from 'node:assert/strict';
 import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
 
 test('every stored cycle name is known', () => {
+  assert.ok(CYCLES.includes('weekly'));
   assert.ok(CYCLES.includes('monthly'));
   assert.ok(CYCLES.includes('yearly'));
 });
 
+test('a weekly plan costs price × 52 ÷ 12 a month, rounded to nearest cent', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 500, cycle: 'weekly' }), 2167);
+  assert.equal(monthlyCents({ price: 1, cycle: 'weekly' }), 4);
+});
+
 test('a monthly plan costs its price a month', () => {
   assert.equal(monthlyCents({ price: 1299, cycle: 'monthly' }), 1299);
   assert.equal(monthlyCents({ price: 0, cycle: 'monthly' }), 0);
@@ -36,3 +43,14 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-31'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-11-01'), '2026-11-07');
+});
+
+test('a weekly plan that has not started yet charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
