diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..fa91e37 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,21 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('list shows what a weekly plan costs a month', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  assert.match(cli(file, 'list').out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+}));
+
+test('weekly subscriptions show in renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit\s+€59\.90/);
+}));
+
+test('weekly subscriptions are calculated correctly in total', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '60', '--every', 'week', '--since', '2026-10-24');
+  cli(file, 'add', 'Netflix', '12', '--since', '2026-10-24');
+  assert.equal(cli(file, 'total').out, 'Monthly total: €272.00 (2 plans)\n');
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..e25aa34 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -4,6 +4,7 @@ import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
 
 test('every stored cycle name is known', () => {
   assert.ok(CYCLES.includes('monthly'));
+  assert.ok(CYCLES.includes('weekly'));
   assert.ok(CYCLES.includes('yearly'));
 });
 
@@ -36,3 +37,16 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs price × 52 ÷ 12 a month, rounded to the nearest cent', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 1100, cycle: 'weekly' }), 4767);
+  assert.equal(monthlyCents({ price: 100, cycle: 'weekly' }), 433);
+});
+
+test('weekly charges occur every 7 days from the first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-10-31'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-24' }, '2026-11-07'), '2026-11-07');
+});
