+test('a weekly plan costs (price × 52 ÷ 12) a month, rounded to the nearest cent', () => {
+  // €12 a week × 52 weeks ÷ 12 months = €52.00 a month
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  // €59.90 a week × 52 weeks ÷ 12 months = €259.5666... ≈ €259.57
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25957);
+});
+
 test('the next charge of a plan that charges today is today', () => {
   assert.equal(nextCharge({ cycle: 'monthly', since: '2026-08-24' }, '2026-10-24'), '2026-10-24');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2025-10-24' }, '2026-10-24'), '2026-10-24');
