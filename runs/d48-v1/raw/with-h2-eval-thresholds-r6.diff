+interface ParsedThresholds {
+  valid: boolean;
+  thresholds?: Record<string, number>;
+  error?: string;
+}
+
+function parseAndValidateThresholds(thresholdStrings?: string[]): ParsedThresholds {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { valid: true, thresholds: undefined };
+  }
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        valid: false,
+        error: `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold value: "${valueStr}". Must be a number between 0 and 1.`
+      };
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${validMetrics.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { valid: true, thresholds };
+}
