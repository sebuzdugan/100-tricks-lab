+interface ThresholdEntry {
+  metric: string;
+  min: number;
+}
+
+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number> | null; errors: string[] } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null, errors: [] };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${str}". Expected format: <metric>=<number>`);
+      continue;
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      errors.push(`Threshold value must be a number between 0 and 1, got: ${valueStr}`);
+      continue;
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds: Object.keys(thresholds).length > 0 ? thresholds : null, errors };
+}
+
+function validateThresholdsAgainstMetrics(
+  thresholds: Record<string, number>,
+  evaluations: Array<{ id: string }>
+): string[] {
+  const errors: string[] = [];
+  const availableMetrics = evaluations.map((e) => e.id);
+
+  for (const metricId of Object.keys(thresholds)) {
+    if (!availableMetrics.includes(metricId)) {
+      errors.push(
+        `Unknown metric: "${metricId}". Available metrics are: ${availableMetrics.join(', ')}`
+      );
+    }
+  }
+
+  return errors;
+}
