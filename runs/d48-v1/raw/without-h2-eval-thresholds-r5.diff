+function parseThresholdsFromCli(thresholdArgs?: string[]): Record<string, number> | null {
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: ${arg}. Expected format: <metric>=<number>`);
+    }
+
+    const [, metric, value] = match;
+    const num = parseFloat(value);
+
+    if (isNaN(num) || num < 0 || num > 1) {
+      throw new Error(
+        `Invalid threshold value: ${arg}. Minimum must be a number between 0 and 1.`
+      );
+    }
+
+    thresholds[metric] = num;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
