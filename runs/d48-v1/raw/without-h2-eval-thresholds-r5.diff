+function parseThresholds(thresholdMap) {
+  if (!thresholdMap || Object.keys(thresholdMap).length === 0) {
+    return null;
+  }
+
+  const parsed = [];
+  const metricIds = new Set();
+
+  for (const [metric, min] of Object.entries(thresholdMap)) {
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold: ${metric}=${min}. Minimum must be a number between 0 and 1.`);
+    }
+    parsed.push({ metric, min });
+    metricIds.add(metric);
+  }
+
+  return { parsed, metricIds };
+}
+
+function evaluateThresholds(thresholds, metrics) {
+  if (!thresholds) {
+    return { passed: true, thresholds: [] };
+  }
+
+  const { parsed, metricIds } = thresholds;
+  const metricMap = new Map(metrics.map((m) => [m.id, m]));
+
+  const unknownMetrics = [...metricIds].filter((id) => !metricMap.has(id));
+  if (unknownMetrics.length > 0) {
+    throw new Error(
+      `Unknown metric ID(s): ${unknownMetrics.join(', ')}. Valid metric IDs are: ${[...metricMap.keys()].join(', ')}`
+    );
+  }
+
+  const results = parsed.map(({ metric, min }) => {
+    const metricData = metricMap.get(metric);
+    const score = metricData.score ?? null;
+    const passed = score !== null && score >= min;
+    return { metric, min, score, passed };
+  });
+
+  const allPassed = results.every((r) => r.passed);
+  return { passed: allPassed, thresholds: results };
+}
