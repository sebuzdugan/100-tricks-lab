+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      throw new Error(
+        `Invalid threshold format: "${thresholdStr}". Expected format: metric=<number> (e.g., exact_match=0.9)`
+      );
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+    const min = parseFloat(minStr);
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      throw new Error(
+        `Invalid threshold value for metric "${metricId}": ${minStr}. Minimum must be a number between 0 and 1.`
+      );
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
+
+function getValidMetricIds(): string[] {
+  const metrics = (Eval.DEFAULT_METRICS as unknown as any[]);
+  const ids: string[] = [];
+
+  for (const metric of metrics) {
+    if (typeof metric === 'function') {
+      const result = metric([], []);
+      if (result && typeof result === 'object' && 'id' in result) {
+        ids.push(result.id);
+      }
+    } else if (metric && typeof metric === 'object' && typeof metric.evaluate === 'function') {
+      const result = metric.evaluate([], []);
+      if (result && typeof result === 'object' && 'id' in result) {
+        ids.push(result.id);
+      }
+    }
+  }
+
+  return ids;
+}
