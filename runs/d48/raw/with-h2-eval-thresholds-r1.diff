+  }
+
+  if (thresholds) {
+    const validIds = getValidMetricIds();
+    for (const metricId of Object.keys(thresholds)) {
+      if (!validIds.includes(metricId)) {
+        log.error(
+          `Unknown metric ID: "${metricId}". Valid metric IDs are: ${validIds.join(', ')}`
+        );
+        process.exit(2);
+      }
+    }
+  }
