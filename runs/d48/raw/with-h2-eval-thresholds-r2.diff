+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const knownMetrics = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: '${threshold}'. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value: '${valueStr}'. Value must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!knownMetrics.includes(metricId)) {
+      log.error(`Unknown metric: '${metricId}'. Valid metrics are: ${knownMetrics.join(', ')}.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
