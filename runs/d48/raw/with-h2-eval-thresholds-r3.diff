+function parseThresholds(thresholdStrs?: string[]): { [key: string]: number } | null {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [key: string]: number } = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrs) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: metric=value`);
+      log.error(`Valid metric IDs: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!validMetrics.includes(metricId)) {
+      log.error(`Unknown metric ID: "${metricId}"`);
+      log.error(`Valid metric IDs: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value for "${metricId}": ${valueStr}. Value must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
