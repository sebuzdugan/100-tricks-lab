+function validateThresholds(thresholds, availableMetricIds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [] };
+  }
+
+  const errors = [];
+  const validMetricIds = new Set(availableMetricIds);
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics: ${Array.from(validMetricIds).join(', ')}`);
+    } else if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`Invalid threshold for ${metricId}: ${min}. Must be a number between 0 and 1.`);
+    }
+  });
+
+  return { valid: errors.length === 0, errors };
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, results: [] };
+  }
+
+  const results = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+    if (!metric) {
+      results.push({ metric: metricId, min, score: null, passed: false });
+      allPassed = false;
+    } else {
+      const score = metric.score ?? null;
+      const passed = score !== null && score >= min;
+      results.push({ metric: metricId, min, score, passed });
+      if (!passed) allPassed = false;
+    }
+  });
+
+  return { passed: allPassed, results };
+}
