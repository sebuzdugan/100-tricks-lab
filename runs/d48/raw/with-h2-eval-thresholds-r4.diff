+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | undefined {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const [metric, minStr] = thresholdStr.split('=');
+    if (!metric || !minStr) {
+      throw new Error(`Malformed threshold: ${thresholdStr}. Expected format: <metric>=<number>`);
+    }
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value for ${metric}: ${minStr}. Must be a number between 0 and 1.`);
+    }
+    thresholds[metric] = min;
+  }
+  return thresholds;
+}
