+function parseThresholds(thresholdStrings?: string | string[]): { valid: boolean; thresholds?: Record<string, number>; error?: string; validMetrics?: string[] } {
+  const thresholdArray = typeof thresholdStrings === 'string' ? [thresholdStrings] : (thresholdStrings ?? []);
+
+  if (!Array.isArray(thresholdArray) || thresholdArray.length === 0) {
+    return { valid: true };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdArray) {
+    const match = String(thresholdStr).match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        valid: false,
+        error: `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`,
+        validMetrics: validMetricIds
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const minScore = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(minScore) || minScore < 0 || minScore > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold value for "${metricId}": ${minStr}. Must be a number between 0 and 1.`,
+        validMetrics: validMetricIds
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`,
+        validMetrics: validMetricIds
+      };
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return { valid: true, thresholds };
+}
