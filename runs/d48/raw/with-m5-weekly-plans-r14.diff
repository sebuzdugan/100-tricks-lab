diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..0b70926 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -3,10 +3,16 @@ import assert from 'node:assert/strict';
 import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
 
 test('every stored cycle name is known', () => {
+  assert.ok(CYCLES.includes('weekly'));
   assert.ok(CYCLES.includes('monthly'));
   assert.ok(CYCLES.includes('yearly'));
 });
 
+test('a weekly plan costs its price × 52 ÷ 12 a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), Math.floor(1200 * 52 / 12));
+  assert.equal(monthlyCents({ price: 600, cycle: 'weekly' }), Math.floor(600 * 52 / 12));
+});
+
 test('a monthly plan costs its price a month', () => {
   assert.equal(monthlyCents({ price: 1299, cycle: 'monthly' }), 1299);
   assert.equal(monthlyCents({ price: 0, cycle: 'monthly' }), 0);
@@ -17,6 +23,12 @@ test('a yearly plan costs a twelfth of its price a month', () => {
   assert.equal(monthlyCents({ price: 2400, cycle: 'yearly' }), 200);
 });
 
+test('a weekly plan charges every 7 days from its start', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-10' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-10' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-10' }, '2026-11-01'), '2026-11-07');
+});
+
