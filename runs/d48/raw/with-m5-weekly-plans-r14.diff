+test('weekly plans charge every 7 days and convert to monthly cost', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-10').code, 0);
+  const list = cli(file, 'list');
