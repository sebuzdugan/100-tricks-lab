--- a/test/renewals.test.js
+++ b/test/renewals.test.js
@@ -24,3 +24,21 @@ test('lists upcoming charges soonest first, across a month boundary', () => {
 test('nothing in the window gives an empty list', () => {
   assert.deepEqual(upcoming([plan('Domain', 'yearly', '2026-03-02')], '2026-10-24'), []);
 });
+
+test('weekly plans charge every 7 days', () => {
+  const subs = [plan('Meal kit', 'weekly', '2026-10-17')];
+  const rows = upcoming(subs, '2026-10-25', 7);
+  assert.deepEqual(rows.map((r) => r.date), ['2026-10-31']);
+});
+
+test('multiple weekly plans charge at different times', () => {
+  const subs = [
+    plan('Meal kit A', 'weekly', '2026-10-17'),
+    plan('Meal kit B', 'weekly', '2026-10-18'),
+  ];
+  const rows = upcoming(subs, '2026-10-25', 30);
+  assert.deepEqual(rows.map((r) => [r.name, r.date]), [
+    ['Meal kit B', '2026-10-25'],
+    ['Meal kit A', '2026-10-31'],
+  ]);
+});
