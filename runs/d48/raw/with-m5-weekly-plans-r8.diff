diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..5044b2d 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,21 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add a weekly plan', () => withFile((file) => {
+  const r = cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Added Meal kit: €59\.90 weekly.*€259\.56 a month/);
+}));
+
+test('list shows what a weekly plan costs a month', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  assert.match(cli(file, 'list').out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('weekly renewals show correctly', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /24 Oct.*Meal kit.*€59\.90/);
+}));
