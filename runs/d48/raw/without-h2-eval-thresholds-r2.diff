+function parseThresholds(thresholdStrs: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const str of thresholdStrs) {
+    const match = str.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${str}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (!validMetrics.includes(metric)) {
+      log.error(`Unknown metric: ${metric}. Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (value < 0 || value > 1) {
+      log.error(`Invalid threshold value for ${metric}: ${value}. Must be between 0 and 1`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
