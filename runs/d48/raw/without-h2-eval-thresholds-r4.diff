+function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { thresholds: [], passed: true };
+  }
+
+  const thresholdResults = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, minScore]) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const passed = metric && typeof metric.score === 'number' && metric.score >= minScore;
+    if (!passed) allPassed = false;
+
+    thresholdResults.push({
+      metric: metricId,
+      min: minScore,
+      score: metric?.score ?? null,
+      passed: Boolean(passed)
+    });
+  });
+
+  return { thresholds: thresholdResults, passed: allPassed };
+}
