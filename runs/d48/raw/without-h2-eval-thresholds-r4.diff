+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const result: { [key: string]: number } = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${threshold}". Expected format: <metric>=<number>`);
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric ID: "${metricId}"`);
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      log.error(`Invalid threshold value: "${scoreStr}". Must be a number between 0 and 1`);
+      process.exit(2);
+    }
+
+    result[metricId] = score;
+  }
+
+  return result;
+}
