+function parseThreshold(thresholdStr: string, validMetricIds: string[]): { metric: string; min: number } {
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    throw new Error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+  }
+
+  const [metric, minStr] = parts;
+  const min = Number.parseFloat(minStr);
+
+  if (Number.isNaN(min) || min < 0 || min > 1) {
+    throw new Error(`Invalid threshold value: "${minStr}". Minimum must be a number between 0 and 1.`);
+  }
+
+  if (!validMetricIds.includes(metric)) {
+    throw new Error(
+      `Unknown metric: "${metric}". Valid metric IDs are: ${validMetricIds.join(', ')}`
+    );
+  }
+
+  return { metric, min };
+}
