diff --git a/test/renewals.test.js b/test/renewals.test.js
index ace0803..89de649 100644
--- a/test/renewals.test.js
+++ b/test/renewals.test.js
@@ -24,3 +24,12 @@ test('lists upcoming charges soonest first, across a month boundary', () => {
 test('nothing in the window gives an empty list', () => {
   assert.deepEqual(upcoming([plan('Domain', 'yearly', '2026-03-02')], '2026-10-24'), []);
 });
+
+test('weekly plans show up in upcoming renewals', () => {
+  const subs = [plan('Meal kit', 'weekly', '2026-10-05', 5990)];
+  const rows = upcoming(subs, '2026-10-24', 14);
+  assert.deepEqual(rows.length, 1);
+  assert.deepEqual(rows[0].date, '2026-10-26');
+  assert.deepEqual(rows[0].price, 5990);
+  assert.deepEqual(rows[0].cycle, 'weekly');
+});
