diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..5cc9c81 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,12 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('weekly subscriptions work', () => withFile((file) => {
+  const add = cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-05');
+  assert.equal(add.code, 0);
+  assert.match(add.out, /Meal kit.*59\.90 weekly.*259\.56 a month/);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
