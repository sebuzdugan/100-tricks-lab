diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..8076513 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,19 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('weekly plans charge every 7 days', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-24').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.57 a month/);
+  const renewals = cli(file, 'renewals', '--within', '14', '--today', '2026-10-24');
+  assert.equal(renewals.code, 0);
+  assert.match(renewals.out, /24 Oct\s+Meal kit\s+€59\.90/);
+  assert.match(renewals.out, /31 Oct\s+Meal kit\s+€59\.90/);
+  assert.match(renewals.out, /7 Nov\s+Meal kit\s+€59\.90/);
+  const soon = cli(file, 'renewals', '--within', '6', '--today', '2026-10-24');
+  assert.equal(soon.code, 0);
+  assert.match(soon.out, /24 Oct\s+Meal kit\s+€59\.90/);
+  assert.equal(!soon.out.includes('31 Oct'), true);
+}));
