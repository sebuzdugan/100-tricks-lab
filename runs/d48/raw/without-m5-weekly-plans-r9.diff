+
+test('a weekly plan costs 52 weeks per year ÷ 12 months per month, rounded to the nearest cent', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 200, cycle: 'weekly' }), 867);
+});
