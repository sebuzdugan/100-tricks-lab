+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } {
+  const thresholds: { [key: string]: number } = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: <metric>=<number>`);
+    }
+    const [, metric, value] = match;
+    const numValue = Number.parseFloat(value);
+    if (numValue < 0 || numValue > 1) {
+      throw new Error(`Invalid threshold value for "${metric}": ${value}. Must be between 0 and 1.`);
+    }
+    thresholds[metric] = numValue;
+  }
+
+  return thresholds;
+}
+
+function getValidMetricIds(evaluations: any[]): string[] {
+  return evaluations.map((m) => m.id);
+}
