+      log.error(`Malformed threshold: ${str}. Expected format: <metric>=<number> (e.g., exact_match=0.9)`);
+      process.exit(2);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = parseFloat(valueStr);
+
