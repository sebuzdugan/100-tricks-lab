+function validateThresholds(thresholds, metricIds) {
+  if (!thresholds) {
+    return null;
+  }
+
+  const validated = {};
+  const knownMetrics = new Set(metricIds);
+
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (!knownMetrics.has(metric)) {
+      const error = new Error(`Unknown metric id: ${metric}`);
+      error.code = 'UNKNOWN_METRIC';
+      error.validMetrics = metricIds;
+      throw error;
+    }
+    if (typeof min !== 'number') {
+      const error = new Error(`Threshold for ${metric} must be a number, got ${typeof min}`);
+      error.code = 'INVALID_THRESHOLD_FORMAT';
+      throw error;
+    }
+    if (min < 0 || min > 1) {
+      const error = new Error(`Threshold for ${metric} must be between 0 and 1, got ${min}`);
+      error.code = 'INVALID_THRESHOLD_RANGE';
+      throw error;
+    }
+    validated[metric] = min;
+  }
+
+  return validated;
+}
