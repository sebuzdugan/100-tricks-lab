+function parseThresholds(thresholdStrings?: string[]): { valid: boolean; thresholds?: Record<string, number>; error?: string; validMetricIds?: string[] } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { valid: true, thresholds: {} };
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      return {
+        valid: false,
+        error: `Malformed threshold '${str}': must be in format <metric>=<number>`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      return {
+        valid: false,
+        error: `Invalid threshold value for '${metricId}': '${valueStr}' is not a valid number`
+      };
+    }
+
+    if (value < 0 || value > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold value for '${metricId}': ${value} is outside the range [0, 1]`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { valid: true, thresholds };
+}
