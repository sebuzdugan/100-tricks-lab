+function validateThresholds(thresholds, validMetricIds) {
+  if (!thresholds) return null;
+
+  const result = {};
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!validMetricIds.includes(metricId)) {
+      throw new Error(`Unknown metric: ${metricId}. Valid metrics: ${validMetricIds.join(', ')}`);
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold for ${metricId}: must be a number between 0 and 1`);
+    }
+    result[metricId] = min;
+  }
+  return result;
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds) return null;
+
+  const thresholdsList = [];
+  let allPassed = true;
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score >= min;
+
+    if (!passed) allPassed = false;
+
+    thresholdsList.push({
+      metric: metricId,
+      min,
+      score: score ?? null,
+      passed
+    });
+  }
+
+  return {
+    passed: allPassed,
+    thresholds: thresholdsList
+  };
+}
