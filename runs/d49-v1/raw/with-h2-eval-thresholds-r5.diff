+function parseAndValidateThresholds(thresholdStrings?: string[], evaluations?: any[]): { thresholds: Record<string, number> | undefined; validMetricIds: string[] } {
+  const validMetricIds = (evaluations ?? []).map((m: any) => m.id);
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: undefined, validMetricIds };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`);
+    }
+
+    const metricId = parts[0].trim();
+    const minStr = parts[1].trim();
+    const min = Number.parseFloat(minStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      throw new Error(`Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`);
+    }
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value: "${minStr}". Minimum must be a number between 0 and 1.`);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, validMetricIds };
+}
