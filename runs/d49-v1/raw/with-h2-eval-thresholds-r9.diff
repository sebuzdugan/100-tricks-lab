+function parseThresholds(thresholdStrings: string[] = []): { thresholds: Record<string, number>; errors: string[] } {
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  const knownMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${str}" (expected format: <metric>=<number>)`);
+      continue;
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      errors.push(
+        `Invalid threshold for "${metricId}": ${scoreStr} is not a number between 0 and 1`
+      );
+      continue;
+    }
+
+    if (!knownMetrics.includes(metricId)) {
+      errors.push(
+        `Unknown metric: "${metricId}". Valid metrics are: ${knownMetrics.join(', ')}`
+      );
+      continue;
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return { thresholds, errors };
+}
