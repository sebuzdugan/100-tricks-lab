@@ -76,4 +76,122 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  it('passes thresholds when metrics meet minimums', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'world'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.5,
+        length_variance: 0.5
+      }
+    });
+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toBeDefined();
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds[0].passed).toBe(true);
+    expect(report.thresholds[1].passed).toBe(true);
+  });
+
+  it('fails thresholds when metrics do not meet minimums', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 0.9
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds).toHaveLength(1);
+    expect(report.thresholds[0].passed).toBe(false);
+    expect(report.thresholds[0].score).toBe(0);
+  });
+
+  it('fails threshold when metric has no score', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: null,
+      thresholds: {
+        exact_match: 0.5
+      }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds).toHaveLength(1);
+    expect(report.thresholds[0].passed).toBe(false);
+    expect(report.thresholds[0].score).toBeNull();
+  });
+
+  it('includes threshold info in markdown report', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: {
+        exact_match: 1.0
+      }
+    });
+
+    const dir = createTempDir();
+    const markdownPath = writeReport({
+      report,
+      format: 'markdown',
+      reportPath: path.join(dir, 'report.md')
+    });
+
+    const content = fs.readFileSync(markdownPath, 'utf8');
+    expect(content).toContain('## Thresholds');
+    expect(content).toContain('exact_match');
+    expect(content).toContain('PASS');
+  });
+
+  it('works with custom metrics', () => {
+    const customMetric = {
+      id: 'custom_score',
+      label: 'Custom Score',
+      score: 0.85,
+      total: 10
+    };
+
+    const evaluations = runEvaluations({
+      outputs: ['test'],
+      references: ['test'],
+      metrics: [(outs, refs) => customMetric]
