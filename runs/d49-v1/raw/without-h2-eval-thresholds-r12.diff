+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const result: Record<string, number> = {};
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: ${threshold}. Expected format: <metric>=<number>`);
+    }
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+    if (min < 0 || min > 1) {
+      throw new Error(`Threshold minimum for ${metricId} is out of range [0, 1]: ${min}`);
+    }
+    result[metricId] = min;
+  }
+  return result;
+}
