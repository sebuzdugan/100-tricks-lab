+function parseThresholds(thresholdStrings?: string[]): { thresholds: Record<string, number>; errors?: string[] } {
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds };
+  }
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      errors.push(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+      continue;
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!validMetrics.includes(metricId)) {
+      errors.push(
+        `Unknown metric: "${metricId}". Valid metrics are: ${validMetrics.join(', ')}`
+      );
+      continue;
+    }
+
+    if (Number.isNaN(min)) {
+      errors.push(`Invalid threshold value for "${metricId}": "${minStr}". Expected a number.`);
+      continue;
+    }
+
+    if (min < 0 || min > 1) {
+      errors.push(`Invalid threshold value for "${metricId}": ${min}. Expected a number between 0 and 1.`);
+      continue;
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds, errors: errors.length > 0 ? errors : undefined };
+}
