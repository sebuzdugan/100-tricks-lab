+function parseThresholds(thresholdStrings: string[] | undefined, evaluations: any[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      log.error('Malformed threshold format: expected <metric>=<number>', { threshold: thresholdStr });
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!metricId || Number.isNaN(value)) {
+      log.error('Malformed threshold format: expected <metric>=<number>', { threshold: thresholdStr });
+      process.exit(2);
+    }
+
+    if (value < 0 || value > 1) {
+      log.error('Threshold minimum must be between 0 and 1 (inclusive).', { metric: metricId, value });
+      process.exit(2);
+    }
+
+    if (!validMetricIds.has(metricId)) {
+      log.error('Unknown metric id.', {
+        metric: metricId,
+        validMetrics: Array.from(validMetricIds)
+      });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
