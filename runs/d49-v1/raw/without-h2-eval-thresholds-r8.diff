+function parseThresholds(thresholdStrings: string[] | undefined, validMetrics: string[]): { parsed: Record<string, number> | null; errorMessage: string | null } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { parsed: {}, errorMessage: null };
+  }
+
+  const parsed: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      return {
+        parsed: null,
+        errorMessage: `Malformed threshold: "${thresholdStr}". Expected format: metric=value`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value)) {
+      return {
+        parsed: null,
+        errorMessage: `Invalid threshold value "${valueStr}" for metric "${metricId}": not a number`
+      };
+    }
+
+    if (value < 0 || value > 1) {
+      return {
+        parsed: null,
+        errorMessage: `Invalid threshold value ${value} for metric "${metricId}": must be between 0 and 1`
+      };
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      return {
+        parsed: null,
+        errorMessage: `Unknown metric id "${metricId}". Valid metrics: ${validMetrics.join(', ')}`
+      };
+    }
+
+    parsed[metricId] = value;
+  }
+
+  return { parsed, errorMessage: null };
+}
