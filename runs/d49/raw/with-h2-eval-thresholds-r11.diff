+function parseThresholds(thresholdStrings: string | string[] | undefined): Record<string, number> | { validationError?: string } {
+  if (!thresholdStrings) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+  const threshArray = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+
+  for (const threshStr of threshArray) {
+    const parts = threshStr.split('=');
+    if (parts.length !== 2) {
+      return { validationError: `Malformed threshold: "${threshStr}". Expected format: <metric>=<number>` };
+    }
+
+    const [metricId, minStr] = parts;
+    const minScore = Number.parseFloat(minStr);
+
+    if (!metricId || Number.isNaN(minScore)) {
+      return { validationError: `Malformed threshold: "${threshStr}". Expected format: <metric>=<number>` };
+    }
+
+    if (minScore < 0 || minScore > 1) {
+      return { validationError: `Invalid threshold minimum for "${metricId}": ${minScore}. Must be between 0 and 1.` };
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      return {
+        validationError: `Unknown metric: "${metricId}". Valid metrics are: ${validMetrics.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return thresholds;
+}
