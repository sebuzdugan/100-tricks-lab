+function parseThresholds(thresholdStrings?: string | string[]): { [key: string]: number } | null {
+  if (!thresholdStrings) return null;
+
+  const strings = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  const thresholds: { [key: string]: number } = {};
+
+  for (const str of strings) {
+    const match = str.match(/^(.+?)=(.+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${str}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: ${minStr}. Must be a number between 0 and 1`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
