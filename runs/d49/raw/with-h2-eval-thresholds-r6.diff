+function parseThresholds(thresholdStrs: string[] | undefined): { [key: string]: number } {
+  const thresholds: { [key: string]: number } = {};
+  const validMetricIds = new Set(['exact_match', 'toxicity', 'length_variance']);
+
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return thresholds;
+  }
+
+  for (const str of thresholdStrs) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: "${str}". Expected <metric>=<number>`);
+      const validIds = Array.from(validMetricIds).join(', ');
+      log.error(`Valid metric ids: ${validIds}`);
+      process.exit(2);
+    }
+
+    const metricId = parts[0].trim();
+    const minStr = parts[1].trim();
+
+    if (!validMetricIds.has(metricId)) {
+      log.error(`Unknown metric id: "${metricId}"`);
+      const validIds = Array.from(validMetricIds).join(', ');
+      log.error(`Valid metric ids: ${validIds}`);
+      process.exit(2);
+    }
+
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for "${metricId}": "${minStr}". Must be a number between 0 and 1`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
