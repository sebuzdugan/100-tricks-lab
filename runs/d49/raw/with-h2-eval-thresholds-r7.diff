+function parseThresholds(thresholdStrings?: string[], validMetricIds?: string[]): { thresholds: Record<string, number> | null; errors: string[] } {
+  const errors: string[] = [];
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null, errors: [] };
+  }
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`);
+      continue;
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      errors.push(`Invalid threshold value for metric "${metricId}": ${minStr} (must be between 0 and 1)`);
+      continue;
+    }
+
+    if (validMetricIds && !validMetricIds.includes(metricId)) {
+      const validList = validMetricIds.join(', ');
+      errors.push(`Unknown metric: "${metricId}" (valid metrics: ${validList})`);
+      continue;
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { thresholds: Object.keys(thresholds).length > 0 ? thresholds : null, errors };
+}
