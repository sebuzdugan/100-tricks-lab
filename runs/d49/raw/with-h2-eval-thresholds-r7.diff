+#!/bin/bash
+set -e
+
+cd "$(dirname "$0")"
+
+echo "=== Testing threshold feature ==="
+echo ""
+
+# Test 1: No thresholds (baseline - should exit 0)
+echo "Test 1: Running eval without thresholds (should exit 0)"
+node packages/frai-cli/dist/index.js eval \
+  --outputs test-data/outputs.json \
+  --references test-data/references.json \
+  --report test-data/report-no-thresholds.json \
+  --format json
+TEST1_EXIT=$?
+echo "Exit code: $TEST1_EXIT"
+if [ $TEST1_EXIT -eq 0 ]; then
+  echo "✓ PASS: Exit code is 0 as expected"
+else
+  echo "✗ FAIL: Expected exit code 0, got $TEST1_EXIT"
+  exit 1
+fi
+echo ""
+
+# Test 2: Passing threshold (should exit 0)
+echo "Test 2: Running eval with passing threshold --threshold exact_match=0.5 (should exit 0)"
+node packages/frai-cli/dist/index.js eval \
+  --outputs test-data/outputs.json \
+  --references test-data/references.json \
+  --report test-data/report-passing.json \
+  --format json \
+  --threshold exact_match=0.5
+TEST2_EXIT=$?
+echo "Exit code: $TEST2_EXIT"
+if [ $TEST2_EXIT -eq 0 ]; then
+  echo "✓ PASS: Exit code is 0 as expected"
+else
+  echo "✗ FAIL: Expected exit code 0, got $TEST2_EXIT"
+  exit 1
+fi
+echo ""
+
+# Test 3: Failing threshold (should exit 1)
+echo "Test 3: Running eval with failing threshold --threshold exact_match=0.99 (should exit 1)"
+node packages/frai-cli/dist/index.js eval \
+  --outputs test-data/outputs.json \
+  --references test-data/references.json \
+  --report test-data/report-failing.json \
+  --format json \
+  --threshold exact_match=0.99 || TEST3_EXIT=$?
+if [ -z "$TEST3_EXIT" ]; then
+  TEST3_EXIT=$?
+fi
+echo "Exit code: $TEST3_EXIT"
+if [ $TEST3_EXIT -eq 1 ]; then
+  echo "✓ PASS: Exit code is 1 as expected"
+else
+  echo "✗ FAIL: Expected exit code 1, got $TEST3_EXIT"
+  exit 1
+fi
+echo ""
+
+# Test 4: Malformed threshold (should exit 2)
+echo "Test 4: Running eval with malformed threshold --threshold 'invalid' (should exit 2)"
+node packages/frai-cli/dist/index.js eval \
+  --outputs test-data/outputs.json \
+  --references test-data/references.json \
+  --threshold invalid 2>/dev/null || TEST4_EXIT=$?
+if [ -z "$TEST4_EXIT" ]; then
+  TEST4_EXIT=$?
+fi
+echo "Exit code: $TEST4_EXIT"
+if [ $TEST4_EXIT -eq 2 ]; then
+  echo "✓ PASS: Exit code is 2 as expected"
+else
+  echo "✗ FAIL: Expected exit code 2, got $TEST4_EXIT"
+  exit 1
+fi
+echo ""
+
+# Test 5: Unknown metric (should exit 2)
+echo "Test 5: Running eval with unknown metric --threshold unknown_metric=0.5 (should exit 2)"
+node packages/frai-cli/dist/index.js eval \
+  --outputs test-data/outputs.json \
+  --references test-data/references.json \
+  --threshold unknown_metric=0.5 2>/dev/null || TEST5_EXIT=$?
+if [ -z "$TEST5_EXIT" ]; then
+  TEST5_EXIT=$?
+fi
+echo "Exit code: $TEST5_EXIT"
+if [ $TEST5_EXIT -eq 2 ]; then
+  echo "✓ PASS: Exit code is 2 as expected"
+else
+  echo "✗ FAIL: Expected exit code 2, got $TEST5_EXIT"
+  exit 1
+fi
+echo ""
+
+# Test 6: Check JSON report structure with passing threshold
+echo "Test 6: Checking JSON report structure with passing threshold"
+if [ -f test-data/report-passing.json ]; then
+  if grep -q '"passed": true' test-data/report-passing.json; then
+    echo "✓ PASS: JSON report contains 'passed: true'"
+  else
+    echo "✗ FAIL: JSON report missing 'passed: true'"
+    exit 1
+  fi
+  if grep -q '"thresholds"' test-data/report-passing.json; then
+    echo "✓ PASS: JSON report contains thresholds array"
+  else
+    echo "✗ FAIL: JSON report missing thresholds array"
+    exit 1
+  fi
+else
+  echo "✗ FAIL: report-passing.json not created"
+  exit 1
+fi
+echo ""
+
+# Test 7: Check JSON report structure without thresholds
+echo "Test 7: Checking JSON report structure without thresholds"
+if [ -f test-data/report-no-thresholds.json ]; then
+  if ! grep -q '"passed"' test-data/report-no-thresholds.json; then
+    echo "✓ PASS: JSON report without thresholds has no 'passed' field"
+  else
+    echo "✗ FAIL: JSON report should not have 'passed' field when no thresholds"
+    exit 1
+  fi
+else
+  echo "✗ FAIL: report-no-thresholds.json not created"
+  exit 1
+fi
+echo ""
+
+echo "=== All tests passed! ==="
