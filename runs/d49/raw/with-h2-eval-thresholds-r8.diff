+function parseThresholds(thresholdStrings?: string[], metricIds?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${thresholdStr}" (expected format: metric=number)`);
+      continue;
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+    const minValue = Number.parseFloat(minStr);
+
+    if (Number.isNaN(minValue) || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold value for ${metricId}: ${minStr} (must be a number between 0 and 1)`);
+      continue;
+    }
+
+    if (metricIds && !metricIds.includes(metricId)) {
+      errors.push(
+        `Unknown metric: ${metricId} (valid metrics: ${metricIds.join(', ')})`
+      );
+      continue;
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  if (errors.length > 0) {
+    log.error('Threshold validation failed.');
+    errors.forEach((err) => console.error(`  - ${err}`));
+    process.exit(2);
+  }
+
+  return thresholds;
+}
