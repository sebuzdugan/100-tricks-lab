@@ -17,6 +18,15 @@ test('a yearly plan costs a twelfth of its price a month', () => {
   assert.equal(monthlyCents({ price: 2400, cycle: 'yearly' }), 200);
 });
 
+test('a weekly plan costs 52÷12 times its price a month, rounded', () => {
+  // €12 a week: 12 × 52 ÷ 12 = €52
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  // €5.99 a week: 5.99 × 52 ÷ 12 ≈ €25.96 (rounds to €25.96)
+  assert.equal(monthlyCents({ price: 599, cycle: 'weekly' }), 2596);
+  // €1 a week: 1 × 52 ÷ 12 ≈ €4.33 (rounds to €4.33)
+  assert.equal(monthlyCents({ price: 100, cycle: 'weekly' }), 433);
+});
+
