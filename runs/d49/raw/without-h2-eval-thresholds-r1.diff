+function parseThresholds(thresholdStrings: string[] | undefined) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const [metricId, minStr] = thresholdStr.split('=');
+    if (!metricId || !minStr) {
+      throw new Error(
+        `Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<min> (e.g., exact_match=0.9)`
+      );
+    }
+
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      throw new Error(
+        `Invalid threshold value for "${metricId}": "${minStr}" is not a number between 0 and 1`
+      );
+    }
+
+    thresholds[metricId] = min;
+  }
+  return thresholds;
+}
+
+function validateThresholdMetrics(thresholds: Record<string, number>, evaluations: any[]) {
+  const validMetricIds = evaluations.map(m => m.id);
+  const invalidMetrics = Object.keys(thresholds).filter(id => !validMetricIds.includes(id));
+
+  if (invalidMetrics.length > 0) {
+    const validList = validMetricIds.join(', ');
+    throw new Error(
+      `Unknown metric ${invalidMetrics.length === 1 ? 'id' : 'ids'}: ${invalidMetrics.join(', ')}. Valid metric ids: ${validList}`
+    );
+  }
+}
