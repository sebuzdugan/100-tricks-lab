+export function validateThresholds(thresholds = {}, metrics = []) {
+  const validMetricIds = new Set(metrics.map((m) => m.id));
+  const errors = [];
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric id: ${metricId}. Valid ids: ${Array.from(validMetricIds).join(', ')}`);
+    }
+    if (typeof minScore !== 'number' || minScore < 0 || minScore > 1) {
+      errors.push(`Invalid threshold for ${metricId}: ${minScore}. Must be a number between 0 and 1.`);
+    }
+  }
+
+  return errors;
+}
+
+export function evaluateThresholds(thresholds = {}, metrics = []) {
+  const results = [];
+  for (const metric of metrics) {
+    if (metric.id in thresholds) {
+      const minScore = thresholds[metric.id];
+      const score = metric.score ?? null;
+      const passed = score !== null && score >= minScore;
+      results.push({
+        metric: metric.id,
+        min: minScore,
+        score,
+        passed
+      });
+    }
+  }
+  return results;
+}
