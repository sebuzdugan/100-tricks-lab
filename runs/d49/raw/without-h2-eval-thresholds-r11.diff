+function validateThresholds(thresholds, metricIds) {
+  const errors = [];
+
+  if (!thresholds) {
+    return { valid: true, errors: [] };
+  }
+
+  const validIds = new Set(metricIds);
+  for (const [metric, min] of Object.entries(thresholds)) {
+    if (!validIds.has(metric)) {
+      errors.push(`Unknown metric id "${metric}". Valid metrics: ${Array.from(validIds).join(', ')}`);
+    }
+    if (typeof min !== 'number' || isNaN(min)) {
+      errors.push(`Threshold for metric "${metric}" must be a number, got "${min}"`);
+    } else if (min < 0 || min > 1) {
+      errors.push(`Threshold for metric "${metric}" must be between 0 and 1, got ${min}`);
+    }
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors
+  };
+}
