+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+    if (isNaN(value)) {
+      throw new Error(`Threshold value for "${metric}" is not a number: "${valueStr}"`);
+    }
+    if (value < 0 || value > 1) {
+      throw new Error(`Threshold for "${metric}" must be between 0 and 1, got ${value}`);
+    }
+    thresholds[metric] = value;
+  }
+  return thresholds;
+}
