+function parseThreshold(thresholdStr) {
+  const match = thresholdStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+  if (!match) {
+    throw new Error(`Invalid threshold format: "${thresholdStr}". Use <metric>=<number>.`);
+  }
+  const [, metricId, minStr] = match;
+  const min = parseFloat(minStr);
+  if (min < 0 || min > 1) {
+    throw new Error(`Threshold for "${metricId}" is ${min}, but must be between 0 and 1.`);
+  }
+  return { metricId, min };
+}
+
+function normalizeThresholds(thresholds) {
+  if (!thresholds || (Array.isArray(thresholds) && thresholds.length === 0)) {
+    return [];
+  }
+  if (Array.isArray(thresholds)) {
+    return thresholds.map((t) => (typeof t === 'string' ? parseThreshold(t) : t));
+  }
+  if (typeof thresholds === 'object') {
+    return Object.entries(thresholds).map(([metricId, min]) => {
+      if (typeof min !== 'number' || min < 0 || min > 1) {
+        throw new Error(`Threshold for "${metricId}" is ${min}, but must be between 0 and 1.`);
+      }
+      return { metricId, min };
+    });
+  }
+  return [];
+}
+
+function validateThresholds(thresholds, validMetricIds) {
+  for (const { metricId } of thresholds) {
+    if (!validMetricIds.includes(metricId)) {
+      throw new Error(
+        `Unknown metric "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}.`
+      );
+    }
+  }
+}
+
+function evaluateThresholds(evaluations, thresholds) {
+  const results = [];
+  for (const threshold of thresholds) {
+    const metric = evaluations.find((m) => m.id === threshold.metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= threshold.min;
+    results.push({
+      metric: threshold.metricId,
+      min: threshold.min,
+      score,
+      passed
+    });
+  }
+  return results;
+}
+
