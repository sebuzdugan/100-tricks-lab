+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: { [key: string]: number } = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      log.error('Invalid threshold format. Expected: <metric>=<number>', { threshold: thresholdStr });
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const minValue = Number.parseFloat(minStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error('Unknown metric id. Valid metrics are: ' + validMetricIds.join(', '), { metric: metricId });
+      process.exit(2);
+    }
+
+    if (Number.isNaN(minValue) || minValue < 0 || minValue > 1) {
+      log.error('Threshold minimum must be a number between 0 and 1', { metric: metricId, value: minStr });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
