+function parseThresholds(
+  thresholdStrings?: string[],
+  availableMetricIds?: string[]
+): { thresholds: Record<string, number> } {
+  const defaultMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const validMetricIds = availableMetricIds ?? defaultMetricIds;
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {} };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: ${thresholdStr}. Expected format: <metric>=<number>`);
+      log.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minValue = parseFloat(match[2]);
+
+    if (minValue < 0 || minValue > 1) {
+      log.error(`Threshold value out of range: ${minValue}. Must be between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`);
+      log.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return { thresholds };
+}
