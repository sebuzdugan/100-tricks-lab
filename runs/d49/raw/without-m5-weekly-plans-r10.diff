diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..a952385 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -3,6 +3,7 @@ import assert from 'node:assert/strict';
 import { CYCLES, monthlyCents, nextCharge } from '../src/cycles.js';
 
 test('every stored cycle name is known', () => {
+  assert.ok(CYCLES.includes('weekly'));
   assert.ok(CYCLES.includes('monthly'));
   assert.ok(CYCLES.includes('yearly'));
 });
@@ -36,3 +37,22 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month (cut to nearest cent)', () => {
+  // €12 a week = 1200 cents × 52 / 12 = 5200 cents = €52.00
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  // €5.99 a week = 599 cents × 52 / 12 = 2595.67 cents ≈ €25.95
+  assert.equal(monthlyCents({ price: 599, cycle: 'weekly' }), 2595);
+  assert.equal(monthlyCents({ price: 0, cycle: 'weekly' }), 0);
+});
+
+test('a weekly plan charges every 7 days from its first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-05'), '2026-10-05');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-06'), '2026-10-12');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-12'), '2026-10-12');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-13'), '2026-10-19');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
