diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..d5123df 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,23 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add and list weekly subscriptions', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-01').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('weekly renewals show up correctly', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-01');
+  const r = cli(file, 'renewals', '--within', '30', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€59\.90/);
+}));
+
+test('weekly in export', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-01');
+  const csv = cli(file, 'export', '--today', '2026-10-25');
+  assert.match(csv.out, /Meal kit,59\.90,weekly,259\.56,2026-10-29/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
