diff --git a/test/renewals.test.js b/test/renewals.test.js
index ace0803..6647c29 100644
--- a/test/renewals.test.js
+++ b/test/renewals.test.js
@@ -24,3 +24,15 @@ test('lists upcoming charges soonest first, across a month boundary', () => {
 test('nothing in the window gives an empty list', () => {
   assert.deepEqual(upcoming([plan('Domain', 'yearly', '2026-03-02')], '2026-10-24'), []);
 });
+
+test('weekly plans charge every 7 days', () => {
+  const subs = [plan('Meal kit', 'weekly', '2026-10-01', 1200)];
+  const rows = upcoming(subs, '2026-10-25', 14);
+  assert.deepEqual(rows.map((r) => [r.name, r.date, r.inDays]), [['Meal kit', '2026-10-29', 4]]);
+});
+
+test('multiple weekly plans within the window', () => {
+  const subs = [plan('Meal kit', 'weekly', '2026-10-01', 1200), plan('Gym', 'weekly', '2026-10-05', 2000)];
+  const rows = upcoming(subs, '2026-10-25', 14);
+  assert.deepEqual(rows.map((r) => [r.name, r.date, r.inDays]), [['Gym', '2026-10-26', 1], ['Meal kit', '2026-10-29', 4]]);
+});
