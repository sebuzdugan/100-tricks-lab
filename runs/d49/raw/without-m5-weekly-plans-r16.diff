diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..f5dfef0 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,26 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('list shows what a weekly plan costs a month', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17');
+  assert.match(cli(file, 'list').out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('renewals shows weekly plan next charge', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17');
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /24 Oct\s+Meal kit\s+€59\.90/);
+}));
+
+test('total includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Netflix', '12.99');
+  cli(file, 'add', 'Meal kit', '12', '--every', 'week');
+  assert.equal(cli(file, 'total').out, 'Monthly total: €64.99 (2 plans)\n');
+}));
+
+test('export shows weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17');
+  assert.match(cli(file, 'export', '--today', '2026-10-24').out, /Meal kit,59\.90,weekly,259\.56,2026-10-24/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..31658f1 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,22 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('weekly is a known cycle', () => {
+  assert.ok(CYCLES.includes('weekly'));
+});
+
+test('a weekly plan costs 52/12 times its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25956);
+});
+
+test('the next charge of a weekly plan is every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-10-24'), '2026-10-24');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-10-17'), '2026-10-17');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
