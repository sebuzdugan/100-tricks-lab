+  assert.match(r.out, /Meal kit\s+€5\.99/);
+}));
+
+test('export includes weekly plans', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '5.99', '--every', 'week', '--since', '2026-10-10');
