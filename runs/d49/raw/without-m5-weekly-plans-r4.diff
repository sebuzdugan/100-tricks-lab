diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..45631ad 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,23 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('weekly plans can be added and show correct monthly cost', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-12').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('weekly plans show in renewals every 7 days from start date', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '12', '--every', 'week', '--since', '2026-10-12');
+  const r = cli(file, 'renewals', '--within', '30', '--today', '2026-10-25');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /26 Oct\s+Meal kit\s+€12\.00/);
+}));
+
+test('weekly plan monthly cost calculation (€12 a week ≈ €52.00 a month)', () => withFile((file) => {
+  cli(file, 'add', 'Service', '12', '--every', 'week', '--since', '2026-10-12');
+  const list = cli(file, 'list');
+  assert.match(list.out, /Service\s+€12\.00 weekly\s+€52\.00 a month/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..d5c4604 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,18 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 times its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25956);
+});
+
+test('the next charge of a weekly plan is every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-12' }, '2026-10-25'), '2026-10-26');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-12' }, '2026-10-26'), '2026-10-26');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-12' }, '2026-10-27'), '2026-11-02');
+});
+
+test('a plan that has not started yet next charges on its first day (weekly)', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-11-05' }, '2026-10-24'), '2026-11-05');
+});
