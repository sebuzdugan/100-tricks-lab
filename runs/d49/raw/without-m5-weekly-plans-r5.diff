diff --git a/src/cycles.js.new b/src/cycles.js.new
new file mode 100644
index 0000000..e739a39
--- /dev/null
+++ b/src/cycles.js.new
@@ -0,0 +1,46 @@
+import { addMonths, addDays } from './dates.js';
+
+/** Billing cycles a plan can have. */
+export const CYCLE = Object.freeze({ MONTH: 'monthly', YEAR: 'yearly', WEEK: 'weekly' });
+
+/** Every supported cycle, as stored in the subscriptions file. */
+export const CYCLES = Object.freeze(Object.values(CYCLE));
+
+const MONTHS_PER_CHARGE = { [CYCLE.MONTH]: 1, [CYCLE.YEAR]: 12, [CYCLE.WEEK]: 52 / 12 };
+
+/**
+ * What a plan costs per month, in whole cents (cut to the cent).
+ * Weekly plans are rounded; others are floored.
+ * @param {{ price: number, cycle: string }} sub
+ * @returns {number}
+ */
+export function monthlyCents(sub) {
+  const monthlyFraction = sub.price * MONTHS_PER_CHARGE[sub.cycle];
+  return sub.cycle === CYCLE.WEEK ? Math.round(monthlyFraction) : Math.floor(monthlyFraction);
+}
+
+/**
+ * The date of a plan's next charge on or after `today` ('YYYY-MM-DD').
+ * Charges fall on the day of the month of the first charge (`since`), or the last day of a shorter month.
+ * For weekly plans, charges are every 7 days from `since`.
+ * @param {{ cycle: string, since: string }} sub
+ * @param {string} today
+ * @returns {string}
+ */
+export function nextCharge(sub, today) {
+  if (sub.cycle === CYCLE.WEEK) {
+    let date = sub.since;
+    while (date < today) {
+      date = addDays(date, 7);
+    }
+    return date;
+  }
+  const step = MONTHS_PER_CHARGE[sub.cycle];
+  let n = 0;
+  let date = sub.since;
+  while (date < today) {
+    n += 1;
+    date = addMonths(sub.since, n * step);
+  }
+  return date;
+}
