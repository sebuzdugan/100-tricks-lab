+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } | undefined {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: { [key: string]: number } = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}" (expected format: metric=<number>)`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minValue = parseFloat(match[2]);
+
+    if (isNaN(minValue) || minValue < 0 || minValue > 1) {
+      log.error(`Invalid threshold value: ${minValue} (must be between 0 and 1)`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric id: "${metricId}". Valid metrics: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
