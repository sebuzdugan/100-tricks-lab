+function parseThresholds(thresholdStrings: string[] = []): { thresholds: Record<string, number> | null; validationError: string | null } {
+  if (thresholdStrings.length === 0) {
+    return { thresholds: null, validationError: null };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        thresholds: null,
+        validationError: `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metric, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      return {
+        thresholds: null,
+        validationError: `Invalid threshold minimum for metric "${metric}": ${minStr}. Must be a number between 0 and 1.`
+      };
+    }
+
+    thresholds[metric] = min;
+  }
+
+  return { thresholds, validationError: null };
+}
