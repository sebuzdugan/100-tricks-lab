+function parseThresholds(thresholdStrings: string[] | undefined, availableMetricIds: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value: "${minStr}". Minimum must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!availableMetricIds.includes(metricId)) {
+      log.error(`Unknown metric id: "${metricId}". Valid metric ids: ${availableMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
