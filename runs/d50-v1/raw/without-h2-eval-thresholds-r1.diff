+function parseThresholds(thresholdStrings: string[] | undefined, metricIds: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([^=]+)=(.+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold "${thresholdStr}": must be metric=min (e.g., exact_match=0.9)`);
+    }
+
+    const [, metricId, minStr] = match;
+    const minScore = Number.parseFloat(minStr);
+
+    if (Number.isNaN(minScore) || minScore < 0 || minScore > 1) {
+      throw new Error(`Invalid threshold value "${minStr}": must be a number between 0 and 1`);
+    }
+
+    if (!metricIds.includes(metricId)) {
+      throw new Error(
+        `Unknown metric "${metricId}". Valid metrics are: ${metricIds.join(', ')}`
+      );
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return thresholds;
+}
