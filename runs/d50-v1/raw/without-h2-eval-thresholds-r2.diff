+function parseThresholds(thresholdStrings: string[] = []) {
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = new Set(['exact_match', 'toxicity', 'length_variance']);
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw {
+        code: 2,
+        message: `Invalid threshold format: "${thresholdStr}". Expected "<metric>=<number>" (e.g., exact_match=0.9)`
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min) || min < 0 || min > 1) {
+      throw {
+        code: 2,
+        message: `Invalid threshold value for "${metricId}": ${minStr}. Minimum must be a number between 0 and 1.`
+      };
+    }
+
+    if (!validMetricIds.has(metricId)) {
+      throw {
+        code: 2,
+        message: `Unknown metric: "${metricId}". Valid metrics are: ${Array.from(validMetricIds).join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
