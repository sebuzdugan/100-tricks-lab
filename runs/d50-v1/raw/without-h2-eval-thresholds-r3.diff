@@ -76,4 +76,73 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  it('generates report with passing thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.9, toxicity: 0.9 }
+    });
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.9,
+      score: expect.any(Number),
+      passed: true
+    });
+  });
+
+  it('generates report with failing thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      thresholds: { exact_match: 0.99 }
+    });
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0].passed).toBe(false);
+  });
+
+  it('fails threshold when metric has null score', () => {
+    const evaluations = [
+      { id: 'exact_match', label: 'Exact Match', score: null, total: 0, details: 'No references' },
+      { id: 'toxicity', label: 'Toxicity', score: 1, total: 100 }
+    ];
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      thresholds: { exact_match: 0.5 }
+    });
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.5,
+      score: null,
+      passed: false
+    });
+  });
+
+  it('does not include thresholds in report when none specified', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z'
+    });
