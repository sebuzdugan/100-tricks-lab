 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+export function parseThreshold(thresholdStr) {
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    throw new Error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+  }
+  const [metric, minStr] = parts;
+  const min = Number.parseFloat(minStr);
+  if (Number.isNaN(min)) {
+    throw new Error(`Invalid threshold minimum value: "${minStr}". Expected a number.`);
+  }
+  if (min < 0 || min > 1) {
+    throw new Error(`Threshold minimum must be between 0 and 1, got: ${min}`);
+  }
+  return { metric, min };
+}
+
+export function validateThresholds(thresholds, availableMetricIds) {
+  const errors = [];
+  const parsed = [];
+  for (const threshold of thresholds) {
+    try {
+      const { metric, min } = parseThreshold(threshold);
+      if (!availableMetricIds.includes(metric)) {
+        errors.push(`Unknown metric: "${metric}". Valid metrics: ${availableMetricIds.join(', ')}`);
+      } else {
+        parsed.push({ metric, min });
+      }
+    } catch (error) {
+      errors.push(error.message);
+    }
+  }
+  return { parsed, errors };
+}
