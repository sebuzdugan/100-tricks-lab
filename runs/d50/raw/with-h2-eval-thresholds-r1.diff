 function runEvalCommand(options: EvalOptions) {
   assertFileExists(options.outputs);
+
+  let thresholds: Record<string, number> | undefined;
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (options.threshold && options.threshold.length > 0) {
+    thresholds = {};
+    for (const threshold of options.threshold) {
+      const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+      if (!match) {
+        log.error(`Invalid threshold format: ${threshold}. Expected format: <metric>=<number>`);
+        process.exit(2);
+      }
+
+      const [, metricId, minStr] = match;
+      const min = parseFloat(minStr);
+
+      if (!validMetricIds.includes(metricId)) {
+        log.error(`Unknown metric: ${metricId}. Valid metrics: ${validMetricIds.join(', ')}`);
+        process.exit(2);
+      }
+
+      if (isNaN(min) || min < 0 || min > 1) {
+        log.error(`Invalid threshold value for ${metricId}: ${minStr}. Must be a number between 0 and 1.`);
+        process.exit(2);
+      }
+
+      thresholds[metricId] = min;
+    }
+  }
