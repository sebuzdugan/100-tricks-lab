+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(1);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.5,
+      score: 1,
+      passed: true
+    });
+  });
+
+  it('applies failing thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['World']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.5 }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds).toHaveLength(1);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.5,
+      score: 0,
+      passed: false
+    });
+  });
+
+  it('handles metrics with no score gracefully', () => {
+    const evaluations = runEvaluations({
+      outputs: [],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.5 }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.5,
+      score: null,
+      passed: false
+    });
+  });
+
+  it('handles multiple thresholds', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.5, length_variance: 0.5 }
+    });
+
+    expect(report.thresholds).toHaveLength(2);
+    const exactMatch = report.thresholds.find((t) => t.metric === 'exact_match');
+    const lengthVariance = report.thresholds.find((t) => t.metric === 'length_variance');
+    expect(exactMatch.passed).toBe(true);
+    expect(lengthVariance.passed).toBe(true);
+    expect(report.passed).toBe(true);
+  });
 });
