+function parseThresholds(thresholdStrings?: string[]) {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(\d+(?:\.\d+)?)$/);
+    if (!match) {
+      log.error('Invalid threshold format. Expected: <metric>=<min>', { threshold: str });
+      log.error('Valid metrics: ' + validMetrics.join(', '));
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (min < 0 || min > 1) {
+      log.error('Threshold minimum must be between 0 and 1', { metric: metricId, value: min });
+      process.exit(2);
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      log.error('Unknown metric. Valid metrics: ' + validMetrics.join(', '), { metric: metricId });
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
