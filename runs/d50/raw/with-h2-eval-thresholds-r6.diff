+function parseThresholds(thresholdArgs?: string[]): { thresholds: Record<string, number>; validMetricIds: string[] } {
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return { thresholds, validMetricIds };
+  }
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      throw {
+        code: 2,
+        message: `Invalid threshold format: "${arg}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw {
+        code: 2,
+        message: `Invalid threshold value: "${valueStr}". Must be a number between 0 and 1`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      throw {
+        code: 2,
+        message: `Unknown metric: "${metricId}". Valid metrics: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds, validMetricIds };
+}
