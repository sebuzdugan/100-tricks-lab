 });
+
+test('lists upcoming weekly charges', () => {
+  const subs = [plan('Meal kit', 'weekly', '2026-10-17', 5990)];
+  const rows = upcoming(subs, '2026-10-24', 14);
+  assert.deepEqual(rows.map((r) => [r.name, r.date, r.inDays]), [['Meal kit', '2026-10-24', 0], ['Meal kit', '2026-10-31', 7], ['Meal kit', '2026-11-07', 14]]);
+});
+
+test('weekly charges show alongside monthly and yearly', () => {
+  const subs = [plan('Gym', 'monthly', '2026-09-02'), plan('Meal kit', 'weekly', '2026-10-17')];
+  const rows = upcoming(subs, '2026-10-24', 14);
+  assert.deepEqual(rows.map((r) => r.date), ['2026-10-24', '2026-10-31', '2026-11-02', '2026-11-07']);
+});
