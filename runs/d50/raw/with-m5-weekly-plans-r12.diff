diff --git a/test/renewals.test.js b/test/renewals.test.js
index ace0803..f0ae845 100644
--- a/test/renewals.test.js
+++ b/test/renewals.test.js
@@ -24,3 +24,15 @@ test('lists upcoming charges soonest first, across a month boundary', () => {
 test('nothing in the window gives an empty list', () => {
