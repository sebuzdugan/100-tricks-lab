+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-10-25'), '2026-10-31');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-17' }, '2026-11-01'), '2026-11-07');
+});
+
+test('a weekly plan that has not started yet next charges on its first day', () => {
