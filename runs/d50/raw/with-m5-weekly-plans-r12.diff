diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..0886a85 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,23 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add weekly subscription shows monthly equivalent', () => withFile((file) => {
+  const r = cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /Meal kit.*€59\.90 weekly.*€259\.56 a month/);
+}));
+
+test('list shows weekly subscriptions with monthly cost', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17');
+  assert.match(cli(file, 'list').out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('renewals shows weekly charges', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-17');
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.match(r.out, /24 Oct\s+Meal kit\s+€59\.90/);
+  assert.match(r.out, /31 Oct\s+Meal kit\s+€59\.90/);
+  assert.match(r.out, /7 Nov\s+Meal kit\s+€59\.90/);
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
