diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..1d343b3 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,18 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add weekly plans with --every week', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-09-27').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+  assert.equal(cli(file, 'total').out, 'Monthly total: €259.56 (1 plan)\n');
+}));
+
+test('weekly renewals show the next charge like any other plan', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-09-27');
+  const r = cli(file, 'renewals', '--within', '30', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '25 Oct  Meal kit  €59.90\n');
+}));
