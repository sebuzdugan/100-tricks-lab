+
+test('weekly plans work', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-20').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+  const r = cli(file, 'renewals', '--within', '14', '--today', '2026-10-20');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '20 Oct  Meal kit  €59.90\n');
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..bbdb0a5 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,15 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price per month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25956);
+});
+
+test('weekly charges happen every 7 days from the first charge', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-05'), '2026-10-05');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-06'), '2026-10-12');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-12'), '2026-10-12');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-20'), '2026-10-26');
+});
