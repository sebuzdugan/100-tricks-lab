diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..f018cbd 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,13 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
