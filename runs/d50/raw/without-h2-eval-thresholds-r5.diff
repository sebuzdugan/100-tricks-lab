+function parseThresholds(thresholdStrings: string[] | undefined, availableMetrics: string[]): { thresholds: Record<string, number>; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {} };
+  }
+
+  const result: Record<string, number> = {};
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      return {
+        thresholds: {},
+        error: `Invalid threshold format: "${threshStr}". Expected format: <metric>=<number> (e.g., exact_match=0.9)`
+      };
+    }
+
+    const [, metricId, minStr] = match;
+    const min = parseFloat(minStr);
+
+    if (min < 0 || min > 1) {
+      return {
+        thresholds: {},
+        error: `Invalid threshold value: ${min}. Minimum must be between 0 and 1.`
+      };
+    }
+
+    if (!availableMetrics.includes(metricId)) {
+      return {
+        thresholds: {},
+        error: `Unknown metric: "${metricId}". Available metrics: ${availableMetrics.join(', ')}`
+      };
+    }
+
+    result[metricId] = min;
+  }
+
+  return { thresholds: result };
+}
