+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: metric=value (e.g., exact_match=0.9)`);
+    }
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value for metric "${metricId}": must be a number between 0 and 1, got ${valueStr}`);
+    }
+    thresholds[metricId] = value;
+  }
+  return thresholds;
+}
