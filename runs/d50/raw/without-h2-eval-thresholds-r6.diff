+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds) return null;
+
+  const metricIds = new Set(evaluations.map((m) => m.id));
+  const errors = [];
+
+  Object.entries(thresholds).forEach(([metricId, minValue]) => {
+    if (typeof minValue !== 'number' || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold for metric "${metricId}": minimum must be a number between 0 and 1`);
+    }
+    if (!metricIds.has(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics: ${Array.from(metricIds).join(', ')}`);
+    }
+  });
+
+  return errors.length > 0 ? errors : null;
+}
+
+function checkThresholds(thresholds, evaluations) {
+  if (!thresholds) return null;
+
+  const results = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  });
+
+  return { passed: allPassed, thresholds: results };
+}
