diff --git a/test/cli.test.js b/test/cli.test.js
index bbb38fa..67f867c 100644
--- a/test/cli.test.js
+++ b/test/cli.test.js
@@ -65,3 +65,17 @@ test('adding the same name twice fails', () => withFile((file) => {
   assert.equal(r.code, 1);
   assert.match(r.err, /already on the list/);
 }));
+
+test('add and list weekly plan', () => withFile((file) => {
+  assert.equal(cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-05').code, 0);
+  const list = cli(file, 'list');
+  assert.equal(list.code, 0);
+  assert.match(list.out, /Meal kit\s+€59\.90 weekly\s+€259\.56 a month/);
+}));
+
+test('weekly plan renewals', () => withFile((file) => {
+  cli(file, 'add', 'Meal kit', '59.90', '--every', 'week', '--since', '2026-10-05');
+  const r = cli(file, 'renewals', '--within', '7', '--today', '2026-10-24');
+  assert.equal(r.code, 0);
+  assert.equal(r.out, '26 Oct  Meal kit  €59.90\n');
+}));
diff --git a/test/cycles.test.js b/test/cycles.test.js
index 0efed0d..3ebaa70 100644
--- a/test/cycles.test.js
+++ b/test/cycles.test.js
@@ -36,3 +36,14 @@ test('a yearly plan charges once a year on the same day', () => {
   assert.equal(nextCharge({ cycle: 'yearly', since: '2023-03-02' }, '2026-10-24'), '2027-03-02');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2024-02-29' }, '2026-10-24'), '2027-02-28');
 });
+
+test('a weekly plan costs 52/12 of its price a month', () => {
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  assert.equal(monthlyCents({ price: 5990, cycle: 'weekly' }), 25956);
+});
+
+test('a weekly plan charges every 7 days', () => {
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-24'), '2026-10-26');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-10-26'), '2026-10-26');
+  assert.equal(nextCharge({ cycle: 'weekly', since: '2026-10-05' }, '2026-11-01'), '2026-11-02');
+});
