@@ -17,6 +18,13 @@ test('a yearly plan costs a twelfth of its price a month', () => {
   assert.equal(monthlyCents({ price: 2400, cycle: 'yearly' }), 200);
 });
 
+test('a weekly plan costs 52/12ths of its price a month', () => {
+  // €12 per week: 1200 cents * 52 / 12 = 5200 cents a month
+  assert.equal(monthlyCents({ price: 1200, cycle: 'weekly' }), 5200);
+  // €10 per week: 1000 cents * 52 / 12 = 4333.33... -> 4333 cents
+  assert.equal(monthlyCents({ price: 1000, cycle: 'weekly' }), 4333);
+});
+
 test('the next charge of a plan that charges today is today', () => {
   assert.equal(nextCharge({ cycle: 'monthly', since: '2026-08-24' }, '2026-10-24'), '2026-10-24');
   assert.equal(nextCharge({ cycle: 'yearly', since: '2025-10-24' }, '2026-10-24'), '2026-10-24');
