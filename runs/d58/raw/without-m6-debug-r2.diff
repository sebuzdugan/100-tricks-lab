diff --git a/src/locale.js b/src/locale.js
index b00f942..6450751 100644
--- a/src/locale.js
+++ b/src/locale.js
@@ -15,5 +15,8 @@ export function isDecimalComma(text) {
  * @returns {number}
  */
 export function decimalCommaToCents(text) {
-  return parseFloat(text.replace(/\./g, '').replace(',', '.')) * 100;
+  const parts = text.replace(/\./g, '').split(',');
+  const euros = parseInt(parts[0], 10);
