+function parseThresholds(thresholdStrings: string | string[] | undefined): { thresholds: Record<string, number> | undefined; error?: string } {
+  if (!thresholdStrings) {
+    return { thresholds: undefined };
+  }
+
+  const strings = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  const result: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const str of strings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return { thresholds: undefined, error: `Malformed threshold "${str}": must be <metric>=<number>` };
+    }
+
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      return { thresholds: undefined, error: `Invalid threshold value "${valueStr}": must be a number between 0 and 1` };
+    }
+
+    if (!validMetrics.includes(metric)) {
+      return {
+        thresholds: undefined,
+        error: `Unknown metric "${metric}". Valid metrics are: ${validMetrics.join(', ')}`
+      };
+    }
+
+    result[metric] = value;
+  }
+
+  return { thresholds: result };
+}
