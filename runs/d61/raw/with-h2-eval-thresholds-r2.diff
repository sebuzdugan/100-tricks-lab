+function parseThresholds(thresholdSpecs?: string | string[]) {
+  if (!thresholdSpecs) {
+    return null;
+  }
+
+  const specs = Array.isArray(thresholdSpecs) ? thresholdSpecs : [thresholdSpecs];
+  if (specs.length === 0) {
+    return null;
+  }
+
+  const parsed: Record<string, number> = {};
+  const errors: string[] = [];
+
+  for (const spec of specs) {
+    const match = spec.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: ${spec}. Expected format: metric=min (e.g., exact_match=0.9)`);
+      continue;
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      errors.push(`Invalid threshold value for ${metricId}: must be a number between 0 and 1, got ${scoreStr}`);
+      continue;
+    }
+
+    parsed[metricId] = score;
+  }
+
+  if (errors.length > 0) {
+    return { error: errors.join('\n') };
+  }
+
+  return parsed;
+}
