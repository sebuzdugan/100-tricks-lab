+export function validateThresholds(thresholds, metrics) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [] };
+  }
+
+  const errors = [];
+  const metricIds = new Set(metrics.map((m) => m.id));
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    if (!metricIds.has(metricId)) {
+      errors.push(`Unknown metric id: ${metricId}. Valid metrics: ${Array.from(metricIds).join(', ')}`);
+    } else if (typeof minScore !== 'number' || minScore < 0 || minScore > 1) {
+      errors.push(`Invalid threshold for ${metricId}: must be a number between 0 and 1, got ${minScore}`);
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+export function evaluateThresholds(thresholds, metrics) {
+  const results = [];
+  let allPassed = true;
+
+  for (const [metricId, minScore] of Object.entries(thresholds || {})) {
+    const metric = metrics.find((m) => m.id === metricId);
+    if (!metric) continue;
+
+    const score = metric.score;
+    const passed = score !== null && score >= minScore;
+    if (!passed) allPassed = false;
+
+    results.push({
+      metric: metricId,
+      min: minScore,
+      score: score,
+      passed
+    });
+  }
+
+  return { results, passed: allPassed };
+}
