+export function validateThresholds(thresholds, metrics) {
+  const validMetricIds = new Set(metrics.map((m) => m.id));
+  const errors = [];
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    if (!validMetricIds.has(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics: ${Array.from(validMetricIds).join(', ')}`);
+      return;
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      errors.push(`Invalid threshold for ${metricId}: minimum must be a number between 0 and 1, got ${min}`);
+    }
+  });
+
+  return errors;
+}
+
+export function evaluateThresholds(thresholds, metrics) {
+  const thresholdResults = Object.entries(thresholds).map(([metricId, min]) => {
+    const metric = metrics.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    return {
+      metric: metricId,
+      min,
+      score,
+      passed
+    };
+  });
+
+  const passed = thresholdResults.every((t) => t.passed);
+
+  return { thresholds: thresholdResults, passed };
+}
