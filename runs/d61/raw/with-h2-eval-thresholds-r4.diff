+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, errors: [], thresholdResults: [] };
+  }
+
+  const errors = [];
+  const metricIds = evaluations.map((m) => m.id);
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    if (!metricIds.includes(metricId)) {
+      errors.push({
+        type: 'unknown_metric',
+        message: `Unknown metric: ${metricId}. Valid metrics: ${metricIds.join(', ')}`
+      });
+    } else if (typeof minValue !== 'number' || minValue < 0 || minValue > 1) {
+      errors.push({
+        type: 'invalid_threshold',
+        message: `Invalid threshold for ${metricId}: ${minValue}. Must be a number between 0 and 1`
+      });
+    }
+  }
+
+  if (errors.length > 0) {
+    return { valid: false, errors, thresholdResults: [] };
+  }
+
+  const thresholdResults = Object.entries(thresholds).map(([metricId, minValue]) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric.score;
+    const passed = score !== null && score >= minValue;
+    return { metric: metricId, min: minValue, score, passed };
+  });
+
+  return { valid: true, errors: [], thresholdResults };
+}
