+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  const validMetrics = new Set(['exact_match', 'toxicity', 'length_variance']);
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error('Invalid threshold format. Expected <metric>=<number>', { threshold: thresholdStr });
+      process.exit(2);
+    }
+
+    const metric = parts[0].trim();
+    const minStr = parts[1].trim();
+    const min = parseFloat(minStr);
+
+    if (!validMetrics.has(metric)) {
+      log.error(`Unknown metric "${metric}". Valid metrics: ${Array.from(validMetrics).join(', ')}`);
+      process.exit(2);
+    }
+
+    if (isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for ${metric}. Expected a number between 0 and 1`, { value: minStr });
+      process.exit(2);
+    }
+
+    thresholds[metric] = min;
+  }
+
+  return thresholds;
+}
