+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | undefined {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const validMetrics = new Set(['exact_match', 'toxicity', 'length_variance']);
+  const thresholds: Record<string, number> = {};
+
+  for (const threshold of thresholdStrings) {
+    const parts = threshold.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: ${threshold}. Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const minScore = Number.parseFloat(minStr);
+
+    if (Number.isNaN(minScore) || minScore < 0 || minScore > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${minStr}. Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    if (!validMetrics.has(metricId)) {
+      log.error(`Unknown metric: ${metricId}. Valid metrics are: ${Array.from(validMetrics).join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return thresholds;
+}
