+function parseThresholds(thresholdInputs?: string | string[]): { [key: string]: number } | null {
+  if (!thresholdInputs) return null;
+
+  const inputs = Array.isArray(thresholdInputs) ? thresholdInputs : [thresholdInputs];
+  const thresholds: { [key: string]: number } = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const input of inputs) {
+    const parts = input.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Malformed threshold: "${input}" (expected format: <metric>=<number>)`);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(min)) {
+      throw new Error(`Invalid threshold value for "${metricId}": "${minStr}" is not a valid number`);
+    }
+
+    if (min < 0 || min > 1) {
+      throw new Error(`Invalid threshold value for "${metricId}": ${min} is outside range [0, 1]`);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      throw new Error(
+        `Unknown metric id: "${metricId}". Valid metric ids are: ${validMetricIds.join(', ')}`
+      );
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
