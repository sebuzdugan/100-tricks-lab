diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..05381c5
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,77 @@
+const METRIC_ID_REGEX = /^[a-z_]+$/;
+const THRESHOLD_FORMAT_REGEX = /^([a-z_]+)=([0-9]*\.?[0-9]+)$/;
+
+export function parseThreshold(thresholdString) {
+  if (!thresholdString || typeof thresholdString !== 'string') {
+    return null;
+  }
+
+  const match = thresholdString.match(THRESHOLD_FORMAT_REGEX);
+  if (!match) {
+    return null;
+  }
+
+  const [, metricId, valueStr] = match;
+  const value = Number.parseFloat(valueStr);
+
+  if (Number.isNaN(value)) {
+    return null;
+  }
+
+  return { metric: metricId, min: value };
+}
+
+export function parseThresholds(thresholdStrings = []) {
+  const thresholds = {};
+  const errors = [];
+  const seen = new Set();
+
+  for (const thresholdStr of thresholdStrings) {
+    const parsed = parseThreshold(thresholdStr);
+    if (!parsed) {
+      errors.push(`Invalid threshold format: "${thresholdStr}". Expected format: metric=number (e.g., exact_match=0.9)`);
+      continue;
+    }
+
+    if (seen.has(parsed.metric)) {
+      errors.push(`Duplicate metric: "${parsed.metric}" specified multiple times.`);
+      continue;
+    }
+
+    seen.add(parsed.metric);
+    thresholds[parsed.metric] = parsed.min;
+  }
+
+  return { thresholds, errors };
+}
+
+export function validateThresholds(thresholds, availableMetricIds = []) {
+  const errors = [];
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    if (!METRIC_ID_REGEX.test(metricId)) {
+      errors.push(`Invalid metric id: "${metricId}". Metric IDs must contain only lowercase letters and underscores.`);
+    }
+
+    if (typeof min !== 'number') {
+      errors.push(`Invalid threshold value for "${metricId}": ${min}. Value must be a number.`);
+    } else if (min < 0 || min > 1) {
+      errors.push(`Invalid threshold value for "${metricId}": ${min}. Minimum must be between 0 and 1.`);
+    }
+
+    if (availableMetricIds.length > 0 && !availableMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric: "${metricId}". Valid metrics are: ${availableMetricIds.join(', ')}`);
+    }
+  });
+
+  return {
+    valid: errors.length === 0,
+    errors
+  };
+}
+
+export default {
+  parseThreshold,
+  parseThresholds,
+  validateThresholds
+};
