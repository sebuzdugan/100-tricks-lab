+import { describe, expect, it } from 'vitest';
+import { parseThreshold, parseThresholds, validateThresholds } from './thresholds.js';
+
+describe('Threshold utilities', () => {
+  describe('parseThreshold', () => {
+    it('parses valid threshold string', () => {
+      const result = parseThreshold('exact_match=0.8');
+      expect(result).toEqual({ metric: 'exact_match', min: 0.8 });
+    });
+
+    it('handles integer thresholds', () => {
+      const result = parseThreshold('toxicity=1');
+      expect(result).toEqual({ metric: 'toxicity', min: 1 });
+    });
+
+    it('handles threshold with zero', () => {
+      const result = parseThreshold('some_metric=0');
+      expect(result).toEqual({ metric: 'some_metric', min: 0 });
+    });
+
+    it('returns null for invalid format', () => {
+      expect(parseThreshold('exact_match')).toBeNull();
+      expect(parseThreshold('exact_match=')).toBeNull();
+      expect(parseThreshold('exact_match=abc')).toBeNull();
+      expect(parseThreshold('exact-match=0.5')).toBeNull();
+    });
+
+    it('returns null for empty string', () => {
+      expect(parseThreshold('')).toBeNull();
+    });
+
+    it('returns null for non-string input', () => {
+      expect(parseThreshold(null)).toBeNull();
+      expect(parseThreshold(undefined)).toBeNull();
+      expect(parseThreshold(123)).toBeNull();
+    });
+  });
+
+  describe('parseThresholds', () => {
+    it('parses multiple threshold strings', () => {
+      const result = parseThresholds(['exact_match=0.8', 'toxicity=0.95']);
+      expect(result.thresholds).toEqual({
+        exact_match: 0.8,
+        toxicity: 0.95
+      });
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('handles empty input', () => {
+      const result = parseThresholds([]);
+      expect(result.thresholds).toEqual({});
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('handles undefined input', () => {
+      const result = parseThresholds(undefined);
+      expect(result.thresholds).toEqual({});
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('collects errors for invalid thresholds', () => {
+      const result = parseThresholds(['exact_match=0.8', 'invalid', 'toxicity=abc']);
+      expect(result.thresholds).toEqual({ exact_match: 0.8 });
+      expect(result.errors).toHaveLength(2);
+    });
+
+    it('detects duplicate metrics', () => {
+      const result = parseThresholds(['exact_match=0.8', 'exact_match=0.9']);
+      expect(result.thresholds).toEqual({ exact_match: 0.8 });
+      expect(result.errors).toContainEqual(expect.stringContaining('Duplicate metric'));
+    });
+  });
+
+  describe('validateThresholds', () => {
+    it('validates correct thresholds', () => {
+      const result = validateThresholds({
+        exact_match: 0.8,
+        toxicity: 0.95
+      });
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+
+    it('rejects out-of-range values', () => {
+      const result = validateThresholds({
+        exact_match: 1.5
+      });
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.stringContaining('between 0 and 1'));
+    });
+
+    it('rejects negative values', () => {
+      const result = validateThresholds({
+        exact_match: -0.1
+      });
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.stringContaining('between 0 and 1'));
+    });
+
+    it('rejects invalid metric IDs', () => {
+      const result = validateThresholds({
+        'exact-match': 0.8
+      });
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.stringContaining('Invalid metric id'));
+    });
+
+    it('validates against available metric IDs', () => {
+      const result = validateThresholds(
+        {
+          exact_match: 0.8,
+          unknown_metric: 0.5
+        },
+        ['exact_match', 'toxicity']
+      );
+      expect(result.valid).toBe(false);
+      expect(result.errors).toContainEqual(expect.stringContaining('Unknown metric'));
+    });
+
+    it('accepts valid thresholds with available metrics', () => {
+      const result = validateThresholds(
+        {
+          exact_match: 0.8,
+          toxicity: 0.9
+        },
+        ['exact_match', 'toxicity', 'length_variance']
+      );
+      expect(result.valid).toBe(true);
+      expect(result.errors).toHaveLength(0);
+    });
+  });
+});
