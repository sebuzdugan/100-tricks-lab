+export function validateThreshold(thresholdStr) {
+  const match = thresholdStr.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+  if (!match) {
+    return { valid: false, error: `Invalid threshold format: ${thresholdStr}. Use <metric>=<number>` };
+  }
+  const [, metricId, valueStr] = match;
+  const value = parseFloat(valueStr);
+  if (Number.isNaN(value) || value < 0 || value > 1) {
+    return { valid: false, error: `Invalid threshold value: ${valueStr}. Must be a number between 0 and 1` };
+  }
+  return { valid: true, metricId, value };
+}
+
+export function getValidMetricIds(evaluations) {
+  return evaluations.map((metric) => metric.id);
+}
+
+export function validateThresholds(thresholdStrs = [], evaluations) {
+  const validMetricIds = getValidMetricIds(evaluations);
+  const thresholds = {};
+
+  for (const thresholdStr of thresholdStrs) {
+    const validation = validateThreshold(thresholdStr);
+    if (!validation.valid) {
+      return { valid: false, error: validation.error };
+    }
+    const { metricId, value } = validation;
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric: ${metricId}. Valid metrics are: ${validMetricIds.join(', ')}`
+      };
+    }
+    thresholds[metricId] = value;
+  }
+
+  return { valid: true, thresholds };
+}
+
+export function evaluateThresholds(thresholds = {}, evaluations) {
+  const thresholdResults = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+    if (!passed) allPassed = false;
+    thresholdResults.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  });
+
+  return { thresholds: thresholdResults, passed: allPassed };
+}
