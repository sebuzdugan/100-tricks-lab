+function parseThresholds(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const result: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Invalid threshold format: "${thresholdStr}". Expected "metric=number"`);
+    }
+    const [metric, valueStr] = parts;
+    const value = Number.parseFloat(valueStr);
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value: "${valueStr}". Expected a number between 0 and 1`);
+    }
+    result[metric] = value;
+  }
+  return result;
+}
