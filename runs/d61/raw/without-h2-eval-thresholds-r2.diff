+function parseThresholds(thresholdStrings: string[] | undefined) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null, error: null };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        thresholds: null,
+        error: `Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      return {
+        thresholds: null,
+        error: `Invalid threshold value "${valueStr}" for metric "${metricId}": must be a number between 0 and 1`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        thresholds: null,
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds, error: null };
+}
