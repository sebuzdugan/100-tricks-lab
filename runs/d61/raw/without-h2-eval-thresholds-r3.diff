+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+function parseThresholds(thresholdStrings?: string[]): { valid: boolean; thresholds?: Record<string, number>; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { valid: true, thresholds: {} };
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      return {
+        valid: false,
+        error: `Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`
+      };
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min)) {
+      return {
+        valid: false,
+        error: `Invalid threshold minimum for metric "${metricId}": "${minStr}" is not a valid number`
+      };
+    }
+
+    if (min < 0 || min > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold minimum for metric "${metricId}": ${min} is outside the range [0, 1]`
+      };
+    }
+
+    if (!VALID_METRIC_IDS.includes(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${VALID_METRIC_IDS.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { valid: true, thresholds };
+}
