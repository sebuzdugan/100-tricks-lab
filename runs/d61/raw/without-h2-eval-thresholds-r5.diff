+function validateThresholds(thresholds, validMetricIds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { valid: true, thresholds: [] };
+  }
+
+  const errors = [];
+  const validated = [];
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric id: ${metricId}. Valid ids: ${validMetricIds.join(', ')}`);
+      continue;
+    }
+
+    if (typeof minScore !== 'number' || minScore < 0 || minScore > 1) {
+      errors.push(`Invalid threshold for ${metricId}: ${minScore}. Minimum must be a number between 0 and 1.`);
+      continue;
+    }
+
+    validated.push({ metricId, minScore });
+  }
+
+  if (errors.length > 0) {
+    return { valid: false, errors };
+  }
+
+  return { valid: true, thresholds: validated };
+}
+
+function evaluateThresholds(evaluations, thresholds) {
+  if (!thresholds || thresholds.length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+
+  let allPassed = true;
+  const results = thresholds.map(({ metricId, minScore }) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score !== undefined && score >= minScore;
+    if (!passed) allPassed = false;
+    return {
+      metric: metricId,
+      min: minScore,
+      score: score ?? null,
+      passed
+    };
+  });
+
+  return { passed: allPassed, thresholds: results };
+}
