+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Malformed threshold: ${str}. Expected format: <metric>=<number>`);
+    }
+
+    const [metricId, scoreStr] = parts;
+    const score = Number.parseFloat(scoreStr);
+
+    if (Number.isNaN(score)) {
+      throw new Error(`Malformed threshold: ${str}. The minimum value must be a number.`);
+    }
+
+    if (score < 0 || score > 1) {
+      throw new Error(`Invalid threshold: ${str}. The minimum value must be between 0 and 1.`);
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return thresholds;
+}
