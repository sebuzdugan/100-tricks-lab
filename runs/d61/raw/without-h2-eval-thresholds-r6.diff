+function parseThresholds(thresholdArgs?: string[]): { thresholds: Record<string, number>; errors?: string } {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdArgs || thresholdArgs.length === 0) {
+    return { thresholds };
+  }
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const arg of thresholdArgs) {
+    const match = arg.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return { thresholds: {}, errors: `Invalid threshold format: ${arg}. Use format: metric=minimum` };
+    }
+
+    const [, metricId, minStr] = match;
+    const minScore = parseFloat(minStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        thresholds: {},
+        errors: `Unknown metric: ${metricId}. Valid metrics are: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    if (isNaN(minScore) || minScore < 0 || minScore > 1) {
+      return { thresholds: {}, errors: `Threshold minimum must be between 0 and 1, got: ${minStr}` };
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return { thresholds };
+}
