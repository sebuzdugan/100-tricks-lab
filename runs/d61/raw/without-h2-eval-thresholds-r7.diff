+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      log.error('Invalid threshold format. Expected: <metric>=<number>', { threshold: str });
+      log.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min)) {
+      log.error('Threshold value must be a number', { threshold: str, value: minStr });
+      process.exit(2);
+    }
+
+    if (min < 0 || min > 1) {
+      log.error('Threshold value must be between 0 and 1', { threshold: str, value: min });
+      process.exit(2);
+    }
+
+    if (!validMetrics.includes(metricId)) {
+      log.error('Unknown metric ID', { metric: metricId });
+      log.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
