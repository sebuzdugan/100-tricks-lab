+function validateThreshold(metricId, min) {
+  if (typeof min !== 'number' || isNaN(min)) {
+    return { valid: false, error: `Threshold value must be a number, got: ${min}` };
+  }
+  if (min < 0 || min > 1) {
+    return { valid: false, error: `Threshold value must be between 0 and 1, got: ${min}` };
+  }
+  return { valid: true };
+}
+
+function evaluateThresholds(evaluations, thresholds) {
+  const results = [];
+  let allPassed = true;
+
+  Object.entries(thresholds).forEach(([metricId, min]) => {
+    const metric = evaluations.find((m) => m.id === metricId);
+
+    if (!metric) {
+      results.push({
+        metric: metricId,
+        min,
+        score: null,
+        passed: false
+      });
+      allPassed = false;
+      return;
+    }
+
+    const score = metric.score;
+    const passed = score !== null && score >= min;
+
+    results.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+
+    if (!passed) {
+      allPassed = false;
+    }
+  });
+
+  return { results, allPassed };
+}
