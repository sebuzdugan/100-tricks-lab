+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+function parseThresholds(thresholdStrings?: string | string[]): Record<string, number> | null {
+  if (!thresholdStrings) return null;
+
+  const strings = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+  const thresholds: Record<string, number> = {};
+
+  for (const str of strings) {
+    const match = str.match(/^([a-z_]+)=([0-9]*\.?[0-9]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}" (expected format: <metric>=<number>)`);
+    }
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!VALID_METRIC_IDS.includes(metric)) {
+      throw new Error(
+        `Unknown metric: "${metric}" (valid metrics: ${VALID_METRIC_IDS.join(', ')})`
+      );
+    }
+    if (value < 0 || value > 1) {
+      throw new Error(`Threshold value must be between 0 and 1, got: ${value}`);
+    }
+    thresholds[metric] = value;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
