+function parseThresholds(
+  thresholdStrings?: string[],
+  validMetricIds: string[] = ['exact_match', 'toxicity', 'length_variance']
+): { thresholds: Record<string, number>; errors?: string[] } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {} };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold '${thresholdStr}': must be <metric>=<number>`);
+      continue;
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric '${metricId}'. Valid metrics: ${validMetricIds.join(', ')}`);
+      continue;
+    }
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      errors.push(`Invalid minimum score '${scoreStr}' for metric '${metricId}': must be between 0 and 1`);
+      continue;
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  if (errors.length > 0) {
+    return { thresholds: {}, errors };
+  }
+
+  return { thresholds };
+}
