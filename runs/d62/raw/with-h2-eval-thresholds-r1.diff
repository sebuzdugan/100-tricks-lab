+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const [metric, value] = thresholdStr.split('=');
+    if (!metric || value === undefined) {
+      log.error('Malformed threshold: must be in format <metric>=<number>', { threshold: thresholdStr });
+      process.exit(2);
+    }
+    const numValue = parseFloat(value);
+    if (isNaN(numValue) || numValue < 0 || numValue > 1) {
+      log.error('Threshold value must be a number between 0 and 1', { threshold: thresholdStr, value });
+      process.exit(2);
+    }
+    thresholds[metric.trim()] = numValue;
+  }
+  return thresholds;
