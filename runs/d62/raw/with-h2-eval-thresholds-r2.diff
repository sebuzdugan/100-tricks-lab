+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return undefined;
+  }
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: metric=number (e.g., exact_match=0.9)`);
+      process.exit(2);
+    }
+
+    const [, metric, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!validMetrics.includes(metric)) {
+      log.error(`Unknown metric: "${metric}". Valid metrics are: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value: "${valueStr}". Threshold must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = value;
+  }
+
+  return thresholds;
+}
