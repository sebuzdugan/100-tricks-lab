 await fs.writeFile('ai-context.txt', aiContext);
 ```
 
+Example: run evaluations with thresholds to gate on metric scores.
+
+```ts
+import fs from 'fs/promises';
+import { Eval } from 'frai-core';
+
+const { outputs, references } = Eval.loadDataset({
+  outputsPath: 'model-outputs.json',
+  referencesPath: 'reference-answers.json'
+});
+
+const evaluations = Eval.runEvaluations({ outputs, references });
+
+// Generate report with thresholds
+const report = Eval.generateReport({
+  evaluations,
+  outputsPath: 'model-outputs.json',
+  referencesPath: 'reference-answers.json',
+  thresholds: {
+    exact_match: 0.9,
+    toxicity: 0.95
+  }
+});
+
+// Write report (exit code reflects threshold pass/fail status)
+Eval.writeReport({ report, format: 'json', reportPath: 'eval-report.json' });
+
+// In CI: check report.passed to gate subsequent steps
+if (report.passed === false) {
+  process.exit(1); // Fail the build
+}
+```
+
 Because `frai-core` is a regular ESM package, you can import only the modules you need and embed FRAI capabilities inside automation pipelines, CI jobs, or custom products.
 
