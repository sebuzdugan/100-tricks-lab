+function parseThresholds(thresholdStrings?: string[]): { [key: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [key: string]: number } = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: <metric>=<number>`);
+      log.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metric, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (!validMetrics.includes(metric)) {
+      log.error(`Unknown metric: "${metric}". Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      log.error(`Invalid threshold value: "${scoreStr}". Threshold must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+
+    thresholds[metric] = score;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
