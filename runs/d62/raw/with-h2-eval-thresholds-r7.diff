@@ -76,4 +76,93 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  it('applies thresholds to report', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'world']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.9, length_variance: 0.8 }
+    });
+
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toHaveLength(2);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.9,
+      score: 1,
+      passed: true
+    });
+    expect(report.thresholds[1]).toEqual({
+      metric: 'length_variance',
+      min: 0.8,
+      score: 1,
+      passed: true
+    });
+  });
+
+  it('marks threshold as failed when score is below minimum', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello', 'World'],
+      references: ['hello', 'goodbye']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.95 }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.95,
+      score: 0.5,
+      passed: false
+    });
+  });
+
+  it('marks threshold as failed when metric has no score', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z',
+      thresholds: { exact_match: 0.5 }
+    });
+
+    expect(report.passed).toBe(false);
+    expect(report.thresholds[0]).toEqual({
+      metric: 'exact_match',
+      min: 0.5,
+      score: null,
+      passed: false
+    });
+  });
+
+  it('omits thresholds from report when none provided', () => {
+    const evaluations = runEvaluations({
+      outputs: ['Hello'],
+      references: ['hello']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      generatedAt: '2024-01-01T00:00:00.000Z'
+    });
+
+    expect(report.passed).toBeUndefined();
+    expect(report.thresholds).toBeUndefined();
+  });
 });
