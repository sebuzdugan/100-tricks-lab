+function parseThresholds(thresholdStrings: string[] | undefined) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const result: Record<string, number> = {};
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: ${str}`);
+      log.error('Threshold must be in format: <metric>=<min>');
+      log.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number(minStr);
+
+    if (!validMetrics.includes(metricId)) {
+      log.error(`Unknown metric: ${metricId}`);
+      log.error(`Valid metrics: ${validMetrics.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold value for ${metricId}: ${minStr}`);
+      log.error('Threshold minimum must be a number between 0 and 1');
+      process.exit(2);
+    }
+
+    result[metricId] = min;
+  }
+
+  return result;
+}
