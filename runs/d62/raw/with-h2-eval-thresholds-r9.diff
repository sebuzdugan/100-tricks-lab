+function parseThresholds(thresholdStrings?: string[]): Record<string, number> {
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return thresholds;
+  }
+
+  for (const spec of thresholdStrings) {
+    const match = spec.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${spec}". Expected format: <metric>=<number>`);
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const metricId = match[1];
+    const minValue = parseFloat(match[2]);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric ID: "${metricId}"`);
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (minValue < 0 || minValue > 1) {
+      log.error(`Threshold for "${metricId}" is ${minValue}, but must be between 0 and 1`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
