+function parseThreshold(thresholdStr: string): { metric: string; min: number } {
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) {
+    throw new Error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+  }
+
+  const [metric, minStr] = parts;
+  const min = Number.parseFloat(minStr);
+
+  if (!metric || !metric.trim()) {
+    throw new Error(`Malformed threshold: "${thresholdStr}". Metric name is required.`);
+  }
+
+  if (Number.isNaN(min)) {
+    throw new Error(`Malformed threshold: "${thresholdStr}". Minimum value must be a number.`);
+  }
+
+  if (min < 0 || min > 1) {
+    throw new Error(`Malformed threshold: "${thresholdStr}". Minimum value must be between 0 and 1.`);
+  }
+
+  return { metric: metric.trim(), min };
+}
+
+function getValidMetricIds(evaluations: any[]): string[] {
+  return evaluations.map((m) => m.id).filter(Boolean);
+}
