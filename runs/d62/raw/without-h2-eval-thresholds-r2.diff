+function parseThresholds(thresholdStrings?: string[]): { [metricId: string]: number } | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: { [metricId: string]: number } = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error('Invalid threshold format. Expected: --threshold <metric>=<number>');
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min)) {
+      log.error(`Invalid threshold value for "${metricId}": "${minStr}" is not a number.`);
+      process.exit(2);
+    }
+
+    if (min < 0 || min > 1) {
+      log.error(`Invalid threshold value for "${metricId}": ${min} is outside the valid range [0, 1].`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
