+function parseThresholdStrings(thresholdStrings?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: metric=min`);
+      process.exit(2);
+    }
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold minimum: "${minStr}". Must be a number between 0 and 1.`);
+      process.exit(2);
+    }
+    if (!metricId || metricId.trim().length === 0) {
+      log.error(`Invalid metric name: "${metricId}". Metric name cannot be empty.`);
+      process.exit(2);
+    }
+    thresholds[metricId] = min;
+  }
+  return thresholds;
+}
