+function validateThresholds(thresholds, evaluations) {
+  if (!thresholds) return { valid: true, errors: [] };
+
+  const errors = [];
+  const metricIds = new Set(evaluations.map((m) => m.id));
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    if (!metricIds.has(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics: ${Array.from(metricIds).join(', ')}`);
+    } else if (typeof minScore !== 'number' || minScore < 0 || minScore > 1) {
+      errors.push(`Invalid threshold for ${metricId}: ${minScore}. Must be a number between 0 and 1.`);
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  if (!thresholds) return { passed: true, thresholds: [] };
+
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score;
+    const passed = score !== null && score !== undefined && score >= minScore;
+    if (!passed) allPassed = false;
+    thresholdResults.push({
+      metric: metricId,
+      min: minScore,
+      score: score ?? null,
+      passed
+    });
+  }
+
+  return { passed: allPassed, thresholds: thresholdResults };
+}
