+function parseThreshold(thresholdStr: string): [string, number] | null {
+  const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+  if (!match) {
+    return null;
+  }
+  const [, metric, scoreStr] = match;
+  const score = parseFloat(scoreStr);
+  if (isNaN(score) || score < 0 || score > 1) {
+    return null;
+  }
+  return [metric, score];
+}
+
+function buildThresholdsMap(thresholdStrs: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrs || thresholdStrs.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+  for (const str of thresholdStrs) {
+    const parsed = parseThreshold(str);
+    if (!parsed) {
+      log.error(`Invalid threshold format: ${str}. Expected format: <metric>=<number> (e.g., exact_match=0.9)`);
+      process.exit(2);
+    }
+    thresholds[parsed[0]] = parsed[1];
+  }
+  return thresholds;
+}
