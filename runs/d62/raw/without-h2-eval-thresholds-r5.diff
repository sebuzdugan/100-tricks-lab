+function parseAndValidateThresholds(
+  thresholdInput: string | string[] | undefined,
+  validMetricIds: string[]
+): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdInput) {
+    return thresholds;
+  }
+
+  const thresholdStrings = Array.isArray(thresholdInput) ? thresholdInput : [thresholdInput];
+
+  for (const threshold of thresholdStrings) {
+    const match = threshold.match(/^(.+?)=(.+?)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${threshold}". Expected format: <metric>=<number>`);
+      log.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, minStr] = match;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(
+        `Invalid threshold value: "${minStr}". Minimum must be a number between 0 and 1.`
+      );
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}".`);
+      log.error(`Valid metric ids: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
