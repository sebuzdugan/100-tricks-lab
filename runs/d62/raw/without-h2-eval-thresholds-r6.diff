+function parseThresholds(thresholdStrings?: string[]): { valid: boolean; thresholds?: Record<string, number>; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { valid: true, thresholds: {} };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const knownMetrics = new Set(['exact_match', 'toxicity', 'length_variance']);
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        valid: false,
+        error: `Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`
+      };
+    }
+
+    const metricId = match[1];
+    const minStr = match[2];
+
+    if (!knownMetrics.has(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric: "${metricId}". Valid metrics are: ${Array.from(knownMetrics).join(', ')}`
+      };
+    }
+
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      return {
+        valid: false,
+        error: `Invalid threshold value for "${metricId}": ${minStr} (must be a number between 0 and 1)`
+      };
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return { valid: true, thresholds };
+}
