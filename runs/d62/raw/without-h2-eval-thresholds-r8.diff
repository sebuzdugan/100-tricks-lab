+function parseThresholds(thresholdStrings?: string[]) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { valid: true, thresholds: null, errors: [] };
+  }
+
+  const errors = [];
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      errors.push(`Malformed threshold: "${str}" (expected format: metric=min)`);
+      continue;
+    }
+
+    const [, metricId, minStr] = match;
+    const minValue = Number.parseFloat(minStr);
