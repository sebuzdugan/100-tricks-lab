+function parseThresholds(thresholdStrings: string[] | undefined, validMetrics: string[]): { thresholds: Record<string, number>; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: {} };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      return {
+        thresholds: {},
+        error: `Malformed threshold: ${str}. Expected format: <metric>=<number>`
+      };
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = parseFloat(scoreStr);
+
+    if (!validMetrics.includes(metricId)) {
+      return {
+        thresholds: {},
+        error: `Unknown metric: ${metricId}. Valid metrics: ${validMetrics.join(', ')}`
+      };
+    }
+
+    if (isNaN(score) || score < 0 || score > 1) {
+      return {
+        thresholds: {},
+        error: `Invalid threshold value for ${metricId}: ${scoreStr}. Must be a number between 0 and 1.`
+      };
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return { thresholds };
+}
