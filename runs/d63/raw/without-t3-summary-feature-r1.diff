@@ -0,0 +1,153 @@
+import { describe, expect, it } from 'vitest';
+import { renderSummary } from './report.js';
+import { GateResult, Finding } from './schema.js';
+
+function createResult(overrides: Partial<GateResult> = {}): GateResult {
+  return {
+    verdict: 'PASS',
+    tier: null,
+    findings: [],
+    gateSection: '## Responsible AI Gate\n\nContent',
+    ...overrides
+  };
+}
+
+describe('renderSummary', () => {
+  it('returns PASS 7/7 for a fully answered gate with no findings', () => {
+    const result = createResult({
+      verdict: 'PASS',
+      findings: []
+    });
+    expect(renderSummary(result)).toBe('PASS 7/7');
+  });
+
+  it('returns WARN 7/7 when only warnings exist', () => {
+    const result = createResult({
+      verdict: 'WARN',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'No numeric threshold',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('returns BLOCK 6/7 with blocked check id when one check has block findings', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation plan',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('returns BLOCK with multiple blocked check ids in GATE_CHECKS order', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'transparency',
+          severity: 'block',
+          message: 'Missing transparency',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        },
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: 'Missing data privacy',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 4/7: data-privacy, evaluation, transparency');
+  });
+
+  it('returns BLOCK 0/7: structure when gate section is missing', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      gateSection: null,
+      findings: [
+        {
+          checkId: 'structure',
+          severity: 'block',
+          message: 'No gate section',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 0/7: structure');
+  });
+
+  it('ignores warnings when counting answered checks', () => {
+    const result = createResult({
+      verdict: 'WARN',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'warn',
+          message: 'Missing threshold',
+          source: 'validator'
+        },
+        {
+          checkId: 'monitoring',
+          severity: 'warn',
+          message: 'Missing threshold',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('WARN 7/7');
+  });
+
+  it('counts each check only once despite multiple block findings', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing metrics',
+          source: 'validator'
+        },
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing dataset',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+
+  it('ignores structure findings when calculating answered checks', () => {
+    const result = createResult({
+      verdict: 'BLOCK',
+      findings: [
+        {
+          checkId: 'evaluation',
+          severity: 'block',
+          message: 'Missing evaluation',
+          source: 'validator'
+        }
+      ]
+    });
+    expect(renderSummary(result)).toBe('BLOCK 6/7: evaluation');
+  });
+});
