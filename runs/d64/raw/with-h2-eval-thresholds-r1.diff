+export function validateThresholds({ thresholds = {}, evaluations }) {
+  const metricIds = new Set(evaluations.map(m => m.id));
+  const errors = [];
+
+  for (const [metricId, minValue] of Object.entries(thresholds)) {
+    if (!metricIds.has(metricId)) {
+      const validIds = Array.from(metricIds).sort();
+      errors.push(`Unknown metric: "${metricId}". Valid metrics are: ${validIds.join(', ')}`);
+    } else if (typeof minValue !== 'number' || minValue < 0 || minValue > 1) {
+      errors.push(`Invalid threshold for "${metricId}": minimum must be a number between 0 and 1, got ${minValue}`);
+    }
+  }
+
+  return errors;
+}
