+function parseThresholds(thresholdStrings: string | string[] | undefined): Record<string, number> {
+  const thresholds: Record<string, number> = {};
+
+  if (!thresholdStrings) {
+    return thresholds;
+  }
+
+  const strings = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+
+  for (const str of strings) {
+    const match = str.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${str}". Expected format: <metric>=<number> (e.g., exact_match=0.9)`);
+    }
+
+    const metricId = match[1];
+    const minValue = parseFloat(match[2]);
+
+    if (isNaN(minValue) || minValue < 0 || minValue > 1) {
+      throw new Error(`Invalid threshold minimum for "${metricId}": must be a number between 0 and 1, got ${match[2]}`);
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return thresholds;
+}
