diff --git a/packages/frai-core/src/eval/validate-thresholds.js b/packages/frai-core/src/eval/validate-thresholds.js
new file mode 100644
index 0000000..c89a556
--- /dev/null
+++ b/packages/frai-core/src/eval/validate-thresholds.js
@@ -0,0 +1,26 @@
+export function validateThresholds(thresholds, availableMetricIds) {
+  if (!thresholds) return { valid: true };
+
+  const metricIdSet = new Set(availableMetricIds);
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!metricIdSet.has(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric '${metricId}'. Valid metric IDs: ${availableMetricIds.join(', ')}`,
+        validMetricIds: availableMetricIds
+      };
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      return {
+        valid: false,
+        error: `Threshold min must be 0.0–1.0, got ${min} for metric '${metricId}'`,
+        validMetricIds: availableMetricIds
+      };
+    }
+  }
+
+  return { valid: true };
+}
+
+export default { validateThresholds };
