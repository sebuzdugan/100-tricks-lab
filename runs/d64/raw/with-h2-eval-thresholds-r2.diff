+## Task 1: Add threshold validation and evaluation to frai-core
+
+**Files:**
+- Modify: `packages/frai-core/src/eval/index.js:62-82` (generateReport function)
+- Create: `packages/frai-core/src/eval/validate-thresholds.js` (threshold parsing and validation)
+- Modify: `packages/frai-core/src/eval/index.test.js` (add threshold tests)
+
+**Interfaces:**
+- Consumes: 
+  - `evaluations` (array of metric objects with `id`, `score`, `label`, etc.)
+  - `thresholds` object: `{ metric_id: 0.9, ... }` or undefined
+  - Metric IDs available from evaluation objects
+- Produces: 
+  - Report with `passed: boolean` (true if all thresholds pass, or thresholds undefined)
+  - Report with `thresholds: [{ metric, min, score, passed }, ...]` array (empty array if no thresholds given)
+  - Validation object: `{ valid: boolean, error?: string, validMetricIds?: string[] }`
+
+**Steps:**
+
+- [ ] **Step 1: Create `packages/frai-core/src/eval/validate-thresholds.js`**
+
+Write a function `validateThresholds(thresholds, availableMetricIds)` that:
+- Takes a thresholds object `{ exact_match: 0.9, toxicity: 0.8 }` (or undefined)
+- Takes an array of available metric IDs from evaluations
+- Returns `{ valid: true }` if all thresholds are valid (each min is a number 0–1, each metric id exists)
+- Returns `{ valid: false, error: "...", validMetricIds: [...] }` if any threshold is invalid
+- Error message format for unknown metric: "Unknown metric 'unknown_id'. Valid metric IDs: exact_match, toxicity, length_variance"
+- Error message format for out-of-range min: "Threshold min must be 0.0–1.0, got 1.5 for metric 'exact_match'"
+
+```javascript
+export function validateThresholds(thresholds, availableMetricIds) {
+  if (!thresholds) return { valid: true };
+  
+  const metricIdSet = new Set(availableMetricIds);
+  
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    if (!metricIdSet.has(metricId)) {
+      return {
+        valid: false,
+        error: `Unknown metric '${metricId}'. Valid metric IDs: ${availableMetricIds.join(', ')}`,
+        validMetricIds: availableMetricIds
+      };
+    }
+    if (typeof min !== 'number' || min < 0 || min > 1) {
+      return {
+        valid: false,
+        error: `Threshold min must be 0.0–1.0, got ${min} for metric '${metricId}'`,
+        validMetricIds: availableMetricIds
+      };
+    }
+  }
+  
+  return { valid: true };
+}
+```
+
