+- [ ] **Step 3: Update runEvalCommand to parse thresholds and validate**
+
+Replace the runEvalCommand function (lines 476-497) with logic that:
+1. Parses `options.threshold` (string or array of strings) into object format `{ metric: min, ... }`
+2. For each threshold string `"exact_match=0.9"`:
+   - Split on `=`
+   - Validate format (exactly 2 parts)
+   - Parse min as number and validate 0–1
+   - If any threshold malformed, call `console.error(errorMsg)` and `process.exit(2)`
+3. Call `Eval.generateReport` with thresholds parameter
+4. If `report.passed` is false, `process.exit(1)` after writing report
+5. Otherwise `process.exit(0)` (or don't exit, let it default to 0)
+
+Pseudo-code:
+```typescript
+function runEvalCommand(options: EvalOptions) {
+  assertFileExists(options.outputs);
+  
+  // Parse thresholds from CLI arguments
+  let thresholds = undefined;
+  if (options.threshold) {
+    thresholds = {};
+    const thresholdStrings = Array.isArray(options.threshold) ? options.threshold : [options.threshold];
+    
+    for (const threshStr of thresholdStrings) {
+      const [metricId, minStr] = threshStr.split('=');
+      if (!metricId || !minStr) {
+        console.error(`Malformed threshold: '${threshStr}'. Format: --threshold <metric>=<min>`);
+        process.exit(2);
+      }
+      const min = parseFloat(minStr);
+      if (isNaN(min) || min < 0 || min > 1) {
+        console.error(`Threshold min must be 0.0–1.0, got '${minStr}' for metric '${metricId}'`);
+        process.exit(2);
+      }
+      thresholds[metricId] = min;
+    }
+  }
+  
+  const dataset = Eval.loadDataset({...});
+  const evaluations = Eval.runEvaluations({...});
+  
+  // Pass thresholds to generateReport
+  const report = Eval.generateReport({
+    evaluations,
+    outputsPath: dataset.outputsPath,
+    referencesPath: dataset.referencesPath,
+    thresholds  // Add this parameter
+  });
+  
+  // Validate thresholds (check if metric IDs are valid)
+  if (thresholds) {
+    const metricIds = evaluations.map((m) => m.id);
+    const validation = validateThresholds(thresholds, metricIds);
+    if (!validation.valid) {
+      console.error(validation.error);
+      process.exit(2);
+    }
+  }
+  
+  const resolvedPath = Eval.writeReport({...});
+  log.success('Evaluation report generated.', { path: resolvedPath });
+  
+  // Exit with code based on thresholds
+  if (!report.passed) {
+    process.exit(1);
+  }
+}
+```
+
+Note: Import `validateThresholds` from frai-core's validate-thresholds.js.
