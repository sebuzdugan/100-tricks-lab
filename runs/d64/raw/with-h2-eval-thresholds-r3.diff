+function runEvalCommand(options: EvalOptions) {
+  assertFileExists(options.outputs);
+  const dataset = (Eval.loadDataset as unknown as (config: unknown) => any)({
+    outputsPath: options.outputs,
+    referencesPath: options.references
+  });
+  const evaluations = (Eval.runEvaluations as unknown as (config: unknown) => any)({
+    outputs: dataset.outputs,
+    references: dataset.references
+  });
+
+  // Parse and validate thresholds
+  let thresholdsObject: Record<string, number> | undefined;
+  let exitCode = 0;
+
+  if (options.threshold) {
+    const thresholdStrings = Array.isArray(options.threshold)
+      ? options.threshold
+      : [options.threshold];
+
+    const { parseThreshold, validateThresholds } = Eval;
+    const parsed = thresholdStrings.map((str) =>
+      (parseThreshold as any)(str)
+    );
+
+    const hasInvalid = parsed.some((p) => p === null);
+    if (hasInvalid) {
+      log.error('Malformed threshold format. Use: --threshold <metric>=<number>');
+      process.exit(2);
+    }
+
+    const validMetricIds = evaluations.map((m: any) => m.id);
+    const validation = (validateThresholds as any)(parsed, validMetricIds);
+    if (!validation.valid) {
+      log.error('Invalid thresholds:', { errors: validation.errors });
+      process.exit(2);
