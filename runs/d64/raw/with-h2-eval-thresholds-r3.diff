new file mode 100644
index 0000000..414d390
--- /dev/null
+++ b/packages/frai-core/src/eval/threshold.js
@@ -0,0 +1,47 @@
+export function parseThreshold(input) {
+  if (typeof input !== 'string') return null;
+
+  const [metricId, valueStr] = input.split('=');
+  if (!metricId || !valueStr) return null;
+
+  const min = parseFloat(valueStr);
+  if (isNaN(min) || min < 0 || min > 1) return null;
+
+  return { metric: metricId.trim(), min };
+}
+
+export function validateThresholds(thresholdObjects, validMetricIds) {
+  const errors = [];
+  const validIds = new Set(validMetricIds);
+
+  for (const { metric } of thresholdObjects) {
+    if (!validIds.has(metric)) {
+      errors.push(
+        `Unknown metric "${metric}". Valid metrics are: ${Array.from(validIds).join(', ')}`
+      );
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+export function evaluateThresholds(metrics, thresholds) {
+  const metricMap = new Map(metrics.map(m => [m.id, m]));
+  const entries = [];
+
+  for (const [metricId, min] of Object.entries(thresholds)) {
+    const metric = metricMap.get(metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= min;
+
+    entries.push({
+      metric: metricId,
+      min,
+      score,
+      passed
+    });
+  }
+
+  const passed = entries.length > 0 && entries.every(e => e.passed);
+  return { passed, entries };
+}
