+export function generateReport({
+  evaluations,
+  outputsPath,
+  referencesPath,
+  thresholds,
+  generatedAt = new Date().toISOString()
+}) {
+  const totalSamples = evaluations.reduce((total, metric) => {
+    if (typeof metric.total === 'number') return Math.max(total, metric.total);
+    return total;
+  }, 0);
+
+  const { passed, entries } = thresholds 
+    ? evaluateThresholds(evaluations, thresholds)
+    : { passed: true, entries: [] };
+
+  return {
+    metadata: {
+      generatedAt,
+      outputsPath,
+      referencesPath,
+      totalSamples
+    },
+    metrics: evaluations,
+    passed,
+    thresholds: entries
+  };
+}
+```
