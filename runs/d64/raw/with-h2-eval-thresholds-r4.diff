+import { describe, expect, it } from 'vitest';
+import { parseThresholds } from './threshold-parser.js';
+
+describe('threshold parser', () => {
+  it('returns empty object when no thresholds given', () => {
+    expect(parseThresholds()).toEqual({});
+    expect(parseThresholds([])).toEqual({});
+  });
+
+  it('parses valid threshold strings', () => {
+    const result = parseThresholds(
+      ['exact_match=0.9', 'length_variance=0.95'],
+      ['exact_match', 'toxicity', 'length_variance']
+    );
+    expect(result).toEqual({
+      exact_match: 0.9,
+      length_variance: 0.95
+    });
+  });
+
+  it('rejects malformed threshold format', () => {
+    expect(() =>
+      parseThresholds(['exact_match=abc'], ['exact_match'])
+    ).toThrow(/Invalid threshold format.*Expected: metric=number/);
+  });
+
+  it('rejects threshold value outside 0-1 range', () => {
+    expect(() =>
+      parseThresholds(['exact_match=1.5'], ['exact_match'])
+    ).toThrow(/Invalid threshold value.*between 0 and 1/);
+  });
+
+  it('rejects negative threshold value', () => {
+    expect(() =>
+      parseThresholds(['exact_match=-0.5'], ['exact_match'])
+    ).toThrow(/Invalid threshold value.*between 0 and 1/);
+  });
+
+  it('rejects unknown metric id', () => {
+    expect(() =>
+      parseThresholds(['unknown_metric=0.5'], ['exact_match', 'toxicity'])
+    ).toThrow(/Unknown metric.*Valid metrics.*exact_match.*toxicity/);
+  });
+});
