+- [ ] **Step 1: Extract parseThresholds to separate module for testing**
+
+Create `packages/frai-cli/src/threshold-parser.js`:
+```javascript
+export function parseThresholds(thresholdStrings = [], validMetricIds = []) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const result = {};
+  const validIds = new Set(validMetricIds);
+
+  for (const thresholdString of thresholdStrings) {
+    const match = thresholdString.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(
+        `Invalid threshold format: "${thresholdString}". Expected: metric=number (e.g., exact_match=0.9)`
+      );
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = parseFloat(valueStr);
+
+    if (Number.isNaN(value) || value < 0 || value > 1) {
+      throw new Error(
+        `Invalid threshold value "${value}" for "${metricId}". Must be a number between 0 and 1.`
+      );
+    }
+
+    if (!validIds.has(metricId)) {
+      throw new Error(
+        `Unknown metric: "${metricId}". Valid metrics: ${Array.from(validIds).join(', ')}`
+      );
+    }
+
+    result[metricId] = value;
+  }
+
+  return result;
+}
+```
+
