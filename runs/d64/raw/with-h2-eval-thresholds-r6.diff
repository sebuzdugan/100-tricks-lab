+import { describe, it, expect } from 'vitest';
+import { generateReport, runEvaluations } from './index.js';
+
+describe('Threshold validation and evaluation', () => {
+  it('threshold passes when score >= min', () => {
+    const evaluations = runEvaluations({
+      outputs: ['A', 'B'],
+      references: ['a', 'b']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.5 }
+    });
+    const threshold = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(threshold.passed).toBe(true);
+  });
+
+  it('threshold fails when score < min', () => {
+    const evaluations = runEvaluations({
+      outputs: ['A', 'B'],
+      references: ['a', 'c']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.9 }
+    });
+    const threshold = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(threshold.passed).toBe(false);
+  });
+
+  it('threshold fails when score is null', () => {
+    const evaluations = runEvaluations({
+      outputs: ['A'],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.5 }
+    });
+    const threshold = report.thresholds.find((t) => t.metric === 'exact_match');
+    expect(threshold.score).toBeNull();
+    expect(threshold.passed).toBe(false);
+  });
+
+  it('multiple thresholds with mixed results', () => {
+    const evaluations = runEvaluations({
+      outputs: ['A', 'B'],
+      references: ['a', 'b']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.9, toxicity: 0.5 }
+    });
+    expect(report.thresholds.length).toBe(2);
+    const exactMatch = report.thresholds.find((t) => t.metric === 'exact_match');
+    const toxicity = report.thresholds.find((t) => t.metric === 'toxicity');
+    expect(exactMatch.passed).toBe(true);
+    expect(toxicity.passed).toBe(true);
+    expect(report.passed).toBe(true);
+  });
+
+  it('report.passed is false when any threshold fails', () => {
+    const evaluations = runEvaluations({
+      outputs: ['A', 'B'],
+      references: ['a', 'c']
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { exact_match: 0.99 }
+    });
+    expect(report.passed).toBe(false);
+  });
+
+  it('boundary values: 0.0 and 1.0', () => {
+    const evaluations = runEvaluations({
+      outputs: [],
+      references: []
+    });
+    const report = generateReport({
+      evaluations,
+      outputsPath: '/tmp/outputs.json',
+      referencesPath: '/tmp/refs.json',
+      thresholds: { toxicity: 0.0, exact_match: 1.0 }
+    });
+    const toxicity = report.thresholds.find((t) => t.metric === 'toxicity');
+    const exactMatch = report.thresholds.find((t) => t.metric === 'exact_match');
+    // toxicity with no outputs should have null score, so threshold fails
+    expect(toxicity.score).toBeNull();
+    expect(toxicity.passed).toBe(false);
+    // exact_match with no outputs should have null score, so threshold fails
+    expect(exactMatch.score).toBeNull();
+    expect(exactMatch.passed).toBe(false);
+  });
