+- [ ] **Step 2: Write threshold evaluation logic**
+
+Inside `generateReport`, add a function to evaluate thresholds:
+
+```javascript
+function evaluateThresholds(evaluations, thresholds) {
+  if (!thresholds || Object.keys(thresholds).length === 0) {
+    return { passed: true, thresholds: [] };
+  }
+  
+  const metricsById = new Map(evaluations.map(m => [m.id, m]));
+  const thresholdResults = [];
+  let allPassed = true;
+  
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    const metric = metricsById.get(metricId);
+    if (!metric) {
+      throw new Error(`Unknown metric id: "${metricId}". Valid metrics: ${Array.from(metricsById.keys()).join(', ')}`);
+    }
+    
+    const score = metric.score;
+    const passed = score !== null && score >= minScore;
+    if (!passed) allPassed = false;
+    
+    thresholdResults.push({
+      metric: metricId,
+      min: minScore,
+      score: score,
+      passed
+    });
+  }
+  
+  return { passed: allPassed, thresholds: thresholdResults };
+}
+```
+
+- [ ] **Step 3: Call threshold evaluation in generateReport**
+
+Inside `generateReport`, after computing `totalSamples`, call `evaluateThresholds(evaluations, thresholds)` and unpack the result.
+
+- [ ] **Step 4: Add passed and thresholds to report object**
