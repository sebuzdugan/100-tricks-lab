+- [ ] **Step 3: Write a threshold parser function in runEvalCommand**
+
+Before calling `Eval.generateReport()`, add a function to parse the thresholds array into an object:
+
+```javascript
+function parseThresholds(thresholdStrings = []) {
+  if (!thresholdStrings.length) return undefined;
+  const result = {};
+  thresholdStrings.forEach(str => {
+    const match = str.match(/^([a-z_]+)=([\d.]+)$/);
+    if (!match) {
+      throw new Error(`Invalid threshold format: "${str}". Expected format: <metric>=<number>`);
+    }
+    const [, metric, value] = match;
+    const num = Number.parseFloat(value);
+    if (Number.isNaN(num) || num < 0 || num > 1) {
+      throw new Error(`Invalid threshold value for "${metric}": ${value}. Must be a number between 0 and 1.`);
+    }
+    result[metric] = num;
+  });
+  return result;
+}
+```
