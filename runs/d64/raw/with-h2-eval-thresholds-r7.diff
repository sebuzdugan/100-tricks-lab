+function parseThresholdStrings(thresholdStrs: string | string[] | undefined): Array<[string, number]> {
+  if (!thresholdStrs) return [];
+
+  const strs = Array.isArray(thresholdStrs) ? thresholdStrs : [thresholdStrs];
+  const results: Array<[string, number]> = [];
+
+  for (const str of strs) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      log.error('Invalid threshold format. Expected: --threshold <metric>=<number>', {
+        provided: str
+      });
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error('Threshold value must be a number between 0 and 1.', {
+        metric: metricId,
+        value: minStr
+      });
+      process.exit(2);
+    }
+
+    results.push([metricId, min]);
+  }
+
+  return results;
+}
+
+function validateAndBuildThresholds(thresholdPairs: Array<[string, number]>, evaluations: any[]): Record<string, number> {
+  if (thresholdPairs.length === 0) return {};
+
+  const metricIds = evaluations.map((m) => m.id);
+  const thresholds: Record<string, number> = {};
+
+  for (const [metricId, min] of thresholdPairs) {
+    if (!metricIds.includes(metricId)) {
+      log.error('Unknown metric ID in threshold.', { metric: metricId });
+      log.info('Available metric IDs: ' + metricIds.join(', '));
+      process.exit(2);
+    }
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
