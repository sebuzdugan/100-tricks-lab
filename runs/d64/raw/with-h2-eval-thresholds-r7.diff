@@ -0,0 +1,50 @@
+// Example: Using frai-core Eval with thresholds for CI gating
+//
+// This shows how to use generateReport with thresholds to gate CI on metric scores.
+
+import { Eval } from 'frai-core';
+
+const outputs = [
+  'The quick brown fox',
+  'Jumps over the lazy dog',
+  'Model output 3'
+];
+
+const references = [
+  'The quick brown fox',
+  'Jumps over the lazy dog',
+  'Reference answer 3'
+];
+
+// Run evaluations
+const evaluations = Eval.runEvaluations({
+  outputs,
+  references
+});
+
+// Generate report with thresholds
+const report = Eval.generateReport({
+  evaluations,
+  outputsPath: './outputs.json',
+  referencesPath: './references.json',
+  thresholds: {
+    exact_match: 0.9,
+    toxicity: 0.95
+  }
+});
+
+console.log('Report:', JSON.stringify(report, null, 2));
+
+if (report.passed) {
+  console.log('✓ All thresholds passed!');
+  process.exit(0);
+} else {
+  console.log('✗ Some thresholds failed');
+  report.thresholds.forEach((t) => {
+    const status = t.passed ? '✓' : '✗';
+    console.log(
+      `  ${status} ${t.metric}: ${t.score !== null ? t.score : 'n/a'} (minimum: ${t.min})`
+    );
+  });
+  process.exit(1);
+}
