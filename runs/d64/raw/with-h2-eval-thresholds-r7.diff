+import { describe, expect, it } from 'vitest';
+
+// Unit tests for threshold parsing logic
+// (Full CLI integration tests would require the CLI to be built and executed)
+
+describe('CLI threshold parsing', () => {
+  it('parses valid threshold string', () => {
+    const input = 'exact_match=0.9';
+    const parts = input.split('=');
+    expect(parts).toHaveLength(2);
+    expect(parts[0]).toBe('exact_match');
+    expect(Number.parseFloat(parts[1])).toBe(0.9);
+  });
+
+  it('detects malformed threshold (no equals sign)', () => {
+    const input = 'exact_match0.9';
+    const parts = input.split('=');
+    expect(parts).toHaveLength(1);
+  });
+
+  it('detects threshold outside valid range', () => {
+    const inputs = ['-0.1', '1.1', '5', 'abc'];
+    inputs.forEach((input) => {
+      const value = Number.parseFloat(input);
+      expect(Number.isNaN(value) || value < 0 || value > 1).toBe(true);
+    });
+  });
+
+  it('validates threshold within range', () => {
+    const inputs = ['0', '0.5', '0.9', '1'];
+    inputs.forEach((input) => {
+      const value = Number.parseFloat(input);
+      expect(Number.isNaN(value)).toBe(false);
+      expect(value >= 0 && value <= 1).toBe(true);
+    });
+  });
+
+  it('handles multiple thresholds as array', () => {
+    const inputs = ['exact_match=0.9', 'toxicity=0.95'];
+    expect(Array.isArray(inputs)).toBe(true);
+    expect(inputs).toHaveLength(2);
+  });
+});
