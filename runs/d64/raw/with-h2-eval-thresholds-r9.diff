+- [ ] **Step 5: Update `runEvalCommand` to handle thresholds**
+
+```typescript
+function runEvalCommand(options: EvalOptions) {
+  assertFileExists(options.outputs);
+  
+  // Parse thresholds
+  const thresholdStrings = options.threshold ?? [];
+  let thresholdsObj: Record<string, number> | undefined;
+  
+  if (thresholdStrings.length > 0) {
+    const parsed = thresholdStrings.map(str => parseThreshold(str));
+    if (parsed.some(t => t === null)) {
+      log.error('Malformed threshold: use --threshold metric=value (0 to 1).');
+      log.error('Valid metrics: exact_match, toxicity, length_variance');
+      process.exit(2);
+    }
+    thresholdsObj = Object.fromEntries(
+      parsed.map(t => [t!.metric, t!.min])
+    );
+    
+    // Validate thresholds against available metrics
+    const validation = validateThresholds(Array.from(parsed as Array<{ metric: string; min: number }>));
+    if (!validation.valid) {
+      log.error('Invalid threshold(s):');
+      validation.errors.forEach(err => log.error(`  ${err}`));
+      log.error('Valid metrics: exact_match, toxicity, length_variance');
+      process.exit(2);
+    }
+  }
+  
+  const dataset = (Eval.loadDataset as unknown as (config: unknown) => any)({
+    outputsPath: options.outputs,
+    referencesPath: options.references
+  });
+  const evaluations = (Eval.runEvaluations as unknown as (config: unknown) => any)({
+    outputs: dataset.outputs,
+    references: dataset.references
+  });
+  const report = (Eval.generateReport as unknown as (config: unknown) => any)({
+    evaluations,
+    outputsPath: dataset.outputsPath,
+    referencesPath: dataset.referencesPath,
+    thresholds: thresholdsObj
+  });
+  const resolvedPath = (Eval.writeReport as unknown as (config: unknown) => string)({
+    report,
+    format: options.format ?? 'json',
+    reportPath: options.report
+  });
+  
+  log.success('Evaluation report generated.', { path: resolvedPath });
+  
+  // Exit with appropriate code
+  if (thresholdsObj && report.passed === false) {
+    process.exit(1);
+  }
+}
+```
