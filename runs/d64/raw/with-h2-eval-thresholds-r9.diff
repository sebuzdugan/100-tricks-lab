+- [ ] **Step 3: Implement `parseThreshold` in `packages/frai-core/src/eval/thresholds.js`**
+
+```javascript
+export function parseThreshold(thresholdStr) {
+  if (typeof thresholdStr !== 'string') return null;
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) return null;
+  const [metric, minStr] = parts;
+  if (!metric || !minStr) return null;
+  const min = Number.parseFloat(minStr);
+  if (Number.isNaN(min)) return null;
+  return { metric, min };
+}
+```
