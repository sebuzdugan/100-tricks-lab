diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..617ebd5
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,54 @@
+const DEFAULT_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+export function parseThreshold(thresholdStr) {
+  if (typeof thresholdStr !== 'string') return null;
+  const parts = thresholdStr.split('=');
+  if (parts.length !== 2) return null;
+  const [metric, minStr] = parts;
+  if (!metric || !minStr) return null;
+  const min = Number.parseFloat(minStr);
+  if (Number.isNaN(min)) return null;
+  return { metric, min };
+}
+
+export function validateThresholds(thresholds, knownMetricIds = DEFAULT_METRIC_IDS) {
+  const errors = [];
+
+  for (const threshold of thresholds) {
+    if (!knownMetricIds.includes(threshold.metric)) {
+      errors.push(`Unknown metric: ${threshold.metric}. Valid metrics: ${knownMetricIds.join(', ')}`);
+    }
+    if (threshold.min < 0 || threshold.min > 1) {
+      errors.push(`Threshold for ${threshold.metric} is ${threshold.min}, must be between 0 and 1`);
+    }
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors
+  };
+}
+
+export function evaluateThresholds(thresholds, evaluations) {
+  const evaluationMap = Object.fromEntries(evaluations.map((e) => [e.id, e]));
+
+  return thresholds.map((threshold) => {
+    const evaluation = evaluationMap[threshold.metric];
+    const score = evaluation?.score ?? null;
+    const passed = score !== null && score >= threshold.min;
+
+    return {
+      metric: threshold.metric,
+      min: threshold.min,
+      score,
+      passed
+    };
+  });
+}
+
+export default {
+  DEFAULT_METRIC_IDS,
+  parseThreshold,
+  validateThresholds,
+  evaluateThresholds
+};
