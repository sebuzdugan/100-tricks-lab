diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..cde9986
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,85 @@
+export class ThresholdError extends Error {
+  constructor(message, code = 'THRESHOLD_ERROR') {
+    super(message);
+    this.name = 'ThresholdError';
+    this.code = code;
+  }
+}
+
+export function parseThresholds(thresholdStrings, availableMetricIds) {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return {};
+  }
+
+  const result = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      throw new ThresholdError(
+        `Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`,
+        'MALFORMED_THRESHOLD'
+      );
+    }
+
+    const metricId = parts[0].trim();
+    const minStr = parts[1].trim();
+
+    if (!availableMetricIds.includes(metricId)) {
+      throw new ThresholdError(
+        `Unknown metric: "${metricId}". Valid metric ids: ${availableMetricIds.join(', ')}`,
+        'UNKNOWN_METRIC'
+      );
+    }
+
+    const min = Number.parseFloat(minStr);
+    if (Number.isNaN(min)) {
+      throw new ThresholdError(
+        `Threshold value for "${metricId}" is not a number: "${minStr}"`,
+        'INVALID_NUMBER'
+      );
+    }
+
+    if (min < 0 || min > 1) {
+      throw new ThresholdError(
+        `Threshold value for "${metricId}" must be between 0 and 1, got ${min}`,
+        'OUT_OF_RANGE'
+      );
+    }
+
+    result[metricId] = min;
+  }
+
+  return result;
+}
+
+export function evaluateThresholds(metrics, thresholds) {
+  const metricMap = new Map(metrics.map((m) => [m.id, m]));
+  const thresholdResults = [];
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    const metric = metricMap.get(metricId);
+    const score = metric?.score ?? null;
+    const passed = score !== null && score >= minScore;
+
+    thresholdResults.push({
+      metric: metricId,
+      min: minScore,
+      score,
+      passed
+    });
+  }
+
+  const allPassed = thresholdResults.every((result) => result.passed);
+
+  return {
+    passed: allPassed,
+    thresholds: thresholdResults
+  };
+}
+
+export default {
+  ThresholdError,
+  parseThresholds,
+  evaluateThresholds
+};
