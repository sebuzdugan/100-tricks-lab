+export function parseThresholds(thresholdStrings = [], knownMetrics = null) {
+  const thresholds = {};
+  const DEFAULT_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+  const metricsToValidate = knownMetrics ?? DEFAULT_METRIC_IDS;
+
+  for (const threshStr of thresholdStrings) {
+    const match = threshStr.match(/^([a-zA-Z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(
+        `Malformed threshold: "${threshStr}". Format must be <metric>=<number> (e.g., exact_match=0.9)`
+      );
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      throw new Error(
+        `Invalid threshold value for "${metricId}": ${scoreStr}. Must be a number between 0 and 1.`
+      );
+    }
+
+    if (knownMetrics === null && !metricsToValidate.includes(metricId)) {
+      throw new Error(
+        `Unknown metric: "${metricId}". Valid metrics are: ${metricsToValidate.join(', ')}`
+      );
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return thresholds;
+}
