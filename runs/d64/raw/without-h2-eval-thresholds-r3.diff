+function parseAndValidateThresholds(thresholdInput?: string | string[]): { thresholds: Record<string, number> | null; validMetricIds: string[] } {
+  let thresholdStrings: string[] = [];
+
+  if (typeof thresholdInput === 'string') {
+    thresholdStrings = [thresholdInput];
+  } else if (Array.isArray(thresholdInput)) {
+    thresholdStrings = thresholdInput;
+  }
+
+  if (thresholdStrings.length === 0) {
+    return { thresholds: null, validMetricIds: ['exact_match', 'toxicity', 'length_variance'] };
+  }
+
+  const thresholds: Record<string, number> = {};
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const thresholdStr of thresholdStrings) {
+    if (typeof thresholdStr !== 'string') continue;
+
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Invalid threshold format: "${thresholdStr}". Expected format: metric=value (e.g., exact_match=0.9)`);
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!Number.isFinite(value) || value < 0 || value > 1) {
+      log.error(`Invalid threshold value: "${valueStr}". Must be a number between 0 and 1.`);
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric ID: "${metricId}".`);
+      log.error(`Valid metric IDs: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return { thresholds, validMetricIds };
+}
