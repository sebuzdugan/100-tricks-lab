+function parseAndValidateThresholds(
+  thresholdArgs: string | string[] | undefined,
+  validMetricIds: string[]
+): { thresholds: Record<string, number>; errors: string[] } {
+  if (!thresholdArgs) {
+    return { thresholds: {}, errors: [] };
+  }
+
+  const args = Array.isArray(thresholdArgs) ? thresholdArgs : [thresholdArgs];
+  const thresholds: Record<string, number> = {};
+  const errors: string[] = [];
+
+  for (const arg of args) {
+    const match = arg.match(/^([a-z_]+)=(.+)$/);
+    if (!match) {
+      errors.push(`Invalid threshold format: "${arg}" (expected format: metric=min)`);
+      continue;
+    }
+
+    const [, metricId, minStr] = match;
+    const minValue = Number.parseFloat(minStr);
+
+    if (!Number.isFinite(minValue)) {
+      errors.push(`Invalid threshold value for "${metricId}": "${minStr}" is not a number`);
+      continue;
+    }
+
+    if (minValue < 0 || minValue > 1) {
+      errors.push(
+        `Invalid threshold value for "${metricId}": ${minValue} is outside the valid range [0, 1]`
+      );
+      continue;
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      errors.push(
+        `Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`
+      );
+      continue;
+    }
+
+    thresholds[metricId] = minValue;
+  }
+
+  return { thresholds, errors };
+}
