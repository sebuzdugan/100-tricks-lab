+function parseThresholds(thresholdStrings: string[] | undefined, validMetricIds: string[]): { thresholds: Record<string, number> | null; error?: string } {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return { thresholds: null };
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      return {
+        thresholds: null,
+        error: `Invalid threshold format "${thresholdStr}": must be "metric=number"`
+      };
+    }
+
+    const [metricId, minStr] = parts;
+    const minScore = Number.parseFloat(minStr);
+
+    if (!metricId.trim()) {
+      return {
+        thresholds: null,
+        error: `Invalid threshold: metric id cannot be empty`
+      };
+    }
+
+    if (Number.isNaN(minScore) || minScore < 0 || minScore > 1) {
+      return {
+        thresholds: null,
+        error: `Invalid threshold: minimum must be a number between 0 and 1, got "${minStr}"`
+      };
+    }
+
+    if (!validMetricIds.includes(metricId)) {
+      return {
+        thresholds: null,
+        error: `Unknown metric id "${metricId}". Valid metrics: ${validMetricIds.join(', ')}`
+      };
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return { thresholds };
+}
