+function parseThresholds(thresholdStrings?: string[], validMetricIds?: string[]): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const str of thresholdStrings) {
+    const parts = str.split('=');
+    if (parts.length !== 2) {
+      throw new Error(`Malformed threshold: "${str}" (expected format: <metric>=<number>)`);
+    }
+
+    const [metricId, minStr] = parts;
+    const minScore = Number.parseFloat(minStr);
+
+    if (validMetricIds && !validMetricIds.includes(metricId)) {
+      throw new Error(`Unknown metric: "${metricId}" (valid metrics: ${validMetricIds.join(', ')})`);
+    }
+
+    if (Number.isNaN(minScore) || minScore < 0 || minScore > 1) {
+      throw new Error(`Invalid threshold value: "${minStr}" (must be a number between 0 and 1)`);
+    }
+
+    thresholds[metricId] = minScore;
+  }
+
+  return Object.keys(thresholds).length > 0 ? thresholds : null;
+}
