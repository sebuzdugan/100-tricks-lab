+function validateThresholds(thresholds, availableMetricIds) {
+  const errors = [];
+
+  if (!thresholds || typeof thresholds !== 'object') {
+    return { valid: false, errors: ['Thresholds must be an object'] };
+  }
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    if (!availableMetricIds.includes(metricId)) {
+      errors.push(`Unknown metric: ${metricId}. Valid metrics: ${availableMetricIds.join(', ')}`);
+    } else if (typeof minScore !== 'number' || minScore < 0 || minScore > 1) {
+      errors.push(`Invalid threshold for ${metricId}: ${minScore}. Must be a number between 0 and 1.`);
+    }
+  }
+
+  return { valid: errors.length === 0, errors };
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  const thresholdResults = [];
+  let allPassed = true;
+
+  for (const [metricId, minScore] of Object.entries(thresholds)) {
+    const metric = evaluations.find((m) => m.id === metricId);
+    const score = metric?.score;
+    const passed = typeof score === 'number' && score >= minScore;
+
+    if (!passed) {
+      allPassed = false;
+    }
+
+    thresholdResults.push({
+      metric: metricId,
+      min: minScore,
+      score: score ?? null,
+      passed
+    });
+  }
+
+  return { thresholdResults, allPassed };
+}
+
