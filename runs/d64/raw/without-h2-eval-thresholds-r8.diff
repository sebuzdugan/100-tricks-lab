+const VALID_METRIC_IDS = ['exact_match', 'toxicity', 'length_variance'];
+
+function parseThresholds(thresholdStrings?: string | string[]): Record<string, number> | null {
+  let thresholds_array: string[] = [];
+
+  if (!thresholdStrings) {
+    return null;
+  }
+
+  if (typeof thresholdStrings === 'string') {
+    thresholds_array = [thresholdStrings];
+  } else if (Array.isArray(thresholdStrings)) {
+    thresholds_array = thresholdStrings;
+  } else {
+    return null;
+  }
+
+  if (thresholds_array.length === 0) {
+    return null;
+  }
+
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholds_array) {
+    if (!thresholdStr) continue;
+    const parts = thresholdStr.split('=');
+    if (parts.length !== 2) {
+      log.error(`Malformed threshold: "${thresholdStr}" (expected format: <metric>=<number>)`);
+      log.info(`Valid metric IDs: ${VALID_METRIC_IDS.join(', ')}`);
+      process.exit(2);
+    }
+
+    const [metricId, minStr] = parts;
+    const min = Number.parseFloat(minStr);
+
+    if (Number.isNaN(min) || min < 0 || min > 1) {
+      log.error(`Invalid threshold minimum: "${minStr}" (must be a number between 0 and 1)`);
+      process.exit(2);
+    }
+
+    if (!VALID_METRIC_IDS.includes(metricId)) {
+      log.error(`Unknown metric ID: "${metricId}"`);
+      log.info(`Valid metric IDs: ${VALID_METRIC_IDS.join(', ')}`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = min;
+  }
+
+  return thresholds;
+}
