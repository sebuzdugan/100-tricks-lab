+function parseThresholds(thresholdStrings: string[] | undefined): Record<string, number> | null {
+  if (!thresholdStrings || thresholdStrings.length === 0) {
+    return null;
+  }
+
+  const validMetricIds = ['exact_match', 'toxicity', 'length_variance'];
+  const thresholds: Record<string, number> = {};
+
+  for (const thresholdStr of thresholdStrings) {
+    const match = thresholdStr.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      log.error(`Malformed threshold: "${thresholdStr}". Expected format: <metric>=<number>`);
+      process.exit(2);
+    }
+
+    const [, metricId, scoreStr] = match;
+    const score = Number.parseFloat(scoreStr);
+
+    if (!validMetricIds.includes(metricId)) {
+      log.error(`Unknown metric: "${metricId}". Valid metrics are: ${validMetricIds.join(', ')}`);
+      process.exit(2);
+    }
+
+    if (Number.isNaN(score) || score < 0 || score > 1) {
+      log.error(`Invalid threshold value: "${scoreStr}". Must be a number between 0 and 1`);
+      process.exit(2);
+    }
+
+    thresholds[metricId] = score;
+  }
+
+  return thresholds;
+}
