+function indentOf(line: string): number {
+  return line.match(/^\s*/)![0].replace(/\t/g, '    ').length;
+}
+
+/** Non-blank lines indented deeper than lines[index]: the answer nested under a field (blank lines allowed between). */
+function continuationOf(lines: string[], index: number): string[] {
+  const base = indentOf(lines[index]);
+  const out: string[] = [];
+  for (let j = index + 1; j < lines.length; j += 1) {
+    if (!lines[j].trim()) continue;
+    if (indentOf(lines[j]) <= base) break;
+    out.push(lines[j]);
+  }
+  return out;
+}
+
+/** Indices of field lines with neither an inline value nor an indented answer below. */
+function unansweredFields(lines: string[]): Set<number> {
+  const out = new Set<number>();
+  lines.forEach((l, i) => {
+    if (EMPTY_FIELD.test(l) && continuationOf(lines, i).length === 0) out.add(i);
+  });
+  return out;
+}
