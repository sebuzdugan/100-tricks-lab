+import { describe, expect, it } from 'vitest';
+import { validateSpec } from './validate.js';
+
+function spec(overrides: Record<string, string> = {}): string {
+  const sections: Record<string, string> = {
+    'Risk tier': '- **Tier:** **limited**\n- **Why:** answers FAQs, no decisions about people.\n- **Sign-off:** not required',
+    'Data & privacy': '- **Data in:** ticket text only\n- **PII?** no\n- **Retention:** 30 days\n- **Trained on user data?** no',
+    'Human oversight': '- **Automation level:** assistive\n- **Override:** support lead\n- **Kill switch:** flag, 5 minutes',
+    'Evaluation plan': '- **Metrics:** recall >= 0.95\n- **Dataset:** evals/g.jsonl 300\n- **Who:** CI on every change',
+    'Bias & fairness': '- **Who:** non-native writers\n- **Mitigations:** language-neutral rule\n- **Test:** gap > 0.05 blocks',
+    'Monitoring & rollback': '- **Watch:** refusal rate\n- **Degraded:** > 10% over 24h\n- **Rollback:** on-call flips flag',
+    'Transparency & incidents': '- **Users know:** label in header\n- **Owner:** Dana Rivers\n- **Path:** 24h response',
+    ...overrides
+  };
+  const titles = Object.keys(sections);
+  return `## Responsible AI Gate\n\n${titles.map((t, i) => `### ${i + 1} · ${t}\n\n${sections[t]}\n`).join('\n')}`;
+}
+
+describe('draft-style specs', () => {
+  it('accepts both label styles', () => {
+    expect(validateSpec(spec()).verdict).toBe('PASS');
+    const colonOutside = spec({ 'Data & privacy': '- **Retention**: 30 days\n- **PII?**: no' });
+    expect(validateSpec(colonOutside).verdict).toBe('PASS');
+  });
+
+  it('flags empty fields in either style', () => {
+    for (const line of ['- **Retention**:', '- **Retention:**']) {
+      const r = validateSpec(spec({ 'Data & privacy': `${line}\n- **PII?** no` }));
+      expect(r.findings.some((f) => f.message.includes('Unanswered field'))).toBe(true);
+    }
+  });
+
+  it('accepts answers on indented lines, with blank lines between', () => {
+    const r = validateSpec(
+      spec({
+        'Data & privacy':
+          '- **Data in:**\n\n  - ticket text\n  - order id\n- **PII?**\n  | field | basis |\n  |---|---|\n  | email | contract |\n- **Retention:**\n\n  30 days\n- **Trained on user data?** no'
+      })
+    );
+    expect(r.findings).toEqual([]);
+  });
+
+  it('reads Tier and Sign-off values from indented lines', () => {
+    const r = validateSpec(
+      spec({ 'Risk tier': '- **Tier:**\n  - high\n- **Why:** hiring\n- **Sign-off:**\n  - Jane Roe, 2026-01-02' })
+    );
+    expect(r.tier).toBe('high');
+    expect(r.verdict).toBe('PASS');
+    const missing = validateSpec(spec({ 'Risk tier': '- **Tier:** high\n- **Why:** hiring\n- **Sign-off:**' }));
+    expect(missing.verdict).toBe('BLOCK');
+  });
+
+  it('blocks unresolved NEEDS HUMAN INPUT in a subsection', () => {
+    const r = validateSpec(
+      spec({ 'Human oversight': '- **Automation level:** assistive\n  - **NEEDS HUMAN INPUT:** who owns override?\n- **Kill switch:** flag' })
+    );
+    expect(r.verdict).toBe('BLOCK');
+    expect(r.findings.some((f) => f.checkId === 'oversight' && /NEEDS HUMAN INPUT/.test(f.message))).toBe(true);
+  });
+});
