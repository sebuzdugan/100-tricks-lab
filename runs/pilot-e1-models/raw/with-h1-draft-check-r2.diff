+  return m[3].replace(/^[^:]*:/, '').trim() || m[3].trim() || m[2].trim();
+}
+
+/** Lines indented deeper than the field at `idx`, blank lines included. */
+function continuation(lines: string[], idx: number): string[] {
+  const base = indentOf(lines[idx]);
+  const out: string[] = [];
+  for (let i = idx + 1; i < lines.length; i += 1) {
+    if (lines[i].trim() && indentOf(lines[i]) <= base) break;
+    out.push(lines[i]);
+  }
+  return out;
+}
+
+/** Indexes of field lines with no inline value and no answer on the indented lines below. */
+function emptyFieldIndexes(lines: string[]): Set<number> {
+  const empty = new Set<number>();
+  for (let i = lines.length - 1; i >= 0; i -= 1) {
+    if (!FIELD.test(lines[i]) || inlineValue(lines[i])) continue;
+    // Inline text can be a hint only (`**Tier** (a / b):`); `inlineValue` already ignores it.
+    const base = indentOf(lines[i]);
+    let answered = false;
+    for (let j = i + 1; j < lines.length; j += 1) {
+      if (lines[j].trim() && indentOf(lines[j]) <= base) break;
+      if (lines[j].trim() && !empty.has(j)) {
+        answered = true;
+        break;
+      }
+    }
+    if (!answered) empty.add(i);
+  }
+  return empty;
+}
+
+/** Inline value plus indented continuation of the field at `idx`. */
+function fieldText(lines: string[], idx: number): string {
+  return [inlineValue(lines[idx]), ...continuation(lines, idx)].join('\n').trim();
+}
 
