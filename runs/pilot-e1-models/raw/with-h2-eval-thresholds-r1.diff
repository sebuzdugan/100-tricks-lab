+/**
+ * Parse a `<metric>=<min>` threshold argument into `{ metric, min }`.
+ * Throws when it is malformed or the minimum is outside 0 to 1.
+ */
+export function parseThreshold(spec) {
+  const text = String(spec ?? '');
+  const match = /^([^=\s]+)=(.+)$/.exec(text.trim());
+  if (!match) {
+    throw new Error(`Invalid threshold "${text}". Expected <metric>=<min>, for example exact_match=0.9.`);
+  }
+  const [, metric, rawMin] = match;
+  const min = rawMin.trim() === '' ? NaN : Number(rawMin);
+  if (!Number.isFinite(min)) {
+    throw new Error(`Invalid threshold "${text}". The minimum "${rawMin}" is not a number.`);
+  }
+  if (min < 0 || min > 1) {
+    throw new Error(`Invalid threshold "${text}". The minimum must be between 0 and 1.`);
+  }
+  return { metric, min };
+}
+
+function evaluateThresholds(evaluations, thresholds) {
+  const entries = Object.entries(thresholds);
+  const validIds = evaluations.map((evaluation) => evaluation?.id).filter(Boolean);
+
+  return entries.map(([metric, min]) => {
+    if (typeof min !== 'number' || !Number.isFinite(min) || min < 0 || min > 1) {
+      throw new Error(`Invalid threshold for "${metric}": the minimum must be a number between 0 and 1.`);
+    }
+    const evaluation = evaluations.find((candidate) => candidate?.id === metric);
+    if (!evaluation) {
+      throw new Error(`Unknown metric "${metric}". Valid metrics: ${validIds.join(', ')}.`);
+    }
+    const score = typeof evaluation.score === 'number' && Number.isFinite(evaluation.score)
+      ? evaluation.score
+      : null;
+    return { metric, min, score, passed: score !== null && score >= min };
+  });
+}
