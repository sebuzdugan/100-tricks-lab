+const NUMBER_PATTERN = /^[+-]?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$/i;
+
+function assertValidMinimum(metric, min) {
+  if (typeof min !== 'number' || !Number.isFinite(min) || min < 0 || min > 1) {
+    throw new Error(`Invalid threshold for "${metric}": minimum must be a number between 0 and 1.`);
+  }
+}
+
+/**
+ * Parse `<metric>=<min>` specs (as given to `--threshold`) into a thresholds object.
+ * Throws on malformed specs, a minimum outside 0 to 1, or a metric given twice.
+ */
+export function parseThresholds(specs = []) {
+  const thresholds = {};
+  ensureArray(specs).forEach((spec) => {
+    const text = String(spec);
+    const index = text.indexOf('=');
+    const metric = index === -1 ? '' : text.slice(0, index).trim();
+    const raw = index === -1 ? '' : text.slice(index + 1).trim();
+    if (!metric || !NUMBER_PATTERN.test(raw)) {
+      throw new Error(`Invalid threshold "${text}": expected <metric>=<min>, for example exact_match=0.9.`);
+    }
+    const min = Number(raw);
+    assertValidMinimum(metric, min);
+    if (Object.prototype.hasOwnProperty.call(thresholds, metric)) {
+      throw new Error(`Duplicate threshold for metric "${metric}".`);
+    }
+    thresholds[metric] = min;
+  });
+  return thresholds;
+}
+
+function evaluateThresholds(evaluations, thresholds) {
+  const validIds = evaluations.map((metric) => metric?.id).filter(Boolean);
+  return Object.entries(thresholds).map(([metric, min]) => {
+    if (!validIds.includes(metric)) {
+      throw new Error(`Unknown metric "${metric}" in thresholds. Valid metric ids: ${validIds.join(', ')}.`);
+    }
+    assertValidMinimum(metric, min);
+    const { score } = evaluations.find((entry) => entry.id === metric);
+    const hasScore = typeof score === 'number' && Number.isFinite(score);
+    return {
+      metric,
+      min,
+      score: hasScore ? score : null,
+      passed: hasScore && score >= min
+    };
+  });
+}
