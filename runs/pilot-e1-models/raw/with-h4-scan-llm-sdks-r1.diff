@@ -0,0 +1,49 @@
+import { describe, expect, it } from 'vitest';
+
+import { createLibraryDetector } from './detectors.js';
+
+const detect = (content, filePath = 'a.ts', libraries) => {
+  const result = { aiLibraryMatches: {}, markAiFile() {} };
+  createLibraryDetector(libraries).analyze({ content, filePath, result });
+  return result.aiLibraryMatches[filePath] ?? [];
+};
+
+describe('library detector', () => {
+  it.each([
+    ["import OpenAI from 'openai';", ['openai']],
+    ["import type { X } from 'openai/resources';", ['openai']],
+    ["import {\n  a,\n  b\n} from '@anthropic-ai/sdk';", ['@anthropic-ai/sdk']],
+    ["import 'langchain';", ['langchain']],
+    ["export * from '@langchain/openai';", ['@langchain']],
+    ["const x = require('anthropic');", ['anthropic']],
+    ["const m = await import('@langchain/core/prompts');", ['@langchain']],
+    ["import a from 'openai'; import b from '@langchain/openai'; import c from 'openai/x'", ['openai', '@langchain']]
+  ])('detects %s', (code, expected) => {
+    expect(detect(code, 'a.mts')).toEqual(expected);
+  });
+
+  it.each([
+    "import x from 'openai-mock';",
+    "import x from './openai';",
+    "// import x from 'openai';",
+    "/* import x from 'openai'; */",
+    "import x from 'caretaker';"
+  ])('ignores %s', (code) => {
+    expect(detect(code, 'a.js')).toEqual([]);
+  });
+
+  it('handles python imports', () => {
+    expect(detect('import os, openai as o\nimport torch.nn\nfrom langchain.chains import X', 'a.py')).toEqual([
+      'torch',
+      'openai',
+      'langchain'
+    ]);
+    expect(
+      detect('# import openai\nfrom . import openai\nimport openai_mock\nimport caretaker', 'a.py', ['openai', 'caret'])
+    ).toEqual([]);
+  });
+
+  it('keeps custom library lists working', () => {
+    expect(detect("import x from 'mylib/sub'", 'a.js', ['mylib'])).toEqual(['mylib']);
+  });
+});
