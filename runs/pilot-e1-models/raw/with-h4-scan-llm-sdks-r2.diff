@@ -0,0 +1,43 @@
+import { describe, expect, it } from 'vitest';
+
+import { createLibraryDetector } from './detectors.js';
+
+const detect = (filePath, content, libraries) => {
+  const result = { aiLibraryMatches: {}, markAiFile: () => {} };
+  createLibraryDetector(libraries).analyze({ content, filePath, result });
+  return result.aiLibraryMatches[filePath] ?? [];
+};
+
+describe('createLibraryDetector', () => {
+  it.each([
+    ["import OpenAI from 'openai';", 'a.js', ['openai']],
+    ["import type { A } from 'openai/resources';", 'a.ts', ['openai']],
+    ['import {\n  A,\n  B\n} from "@anthropic-ai/sdk";', 'a.mts', ['@anthropic-ai/sdk']],
+    ["import '@langchain/openai';", 'a.cts', ['@langchain']],
+    ["export * from 'langchain/tools';", 'a.mjs', ['langchain']],
+    ["const x = require('anthropic');", 'a.cjs', ['anthropic']],
+    ['const x = await import(`openai`);', 'a.js', ['openai']],
+    ['import os, torch.nn as nn', 'a.py', ['torch']],
+    ['from sklearn.linear_model import X', 'a.py', ['sklearn']]
+  ])('detects %s', (code, file, expected) => {
+    expect(detect(file, code)).toEqual(expected);
+  });
+
+  it.each([
+    ["import x from 'openai-mock';", 'a.js'],
+    ["import x from './openai';", 'a.js'],
+    ["// import x from 'openai';", 'a.js'],
+    ["/* import x from 'openai'; */", 'a.js'],
+    ['import caretaker', 'a.py'],
+    ['from .openai import x', 'a.py'],
+    ['# import torch', 'a.py'],
+    ["import torch from './local'", 'a.ts']
+  ])('ignores %s', (code, file) => {
+    expect(detect(file, code)).toEqual([]);
+  });
+
+  it('does not duplicate and supports custom libraries', () => {
+    expect(detect('a.js', "import a from 'openai';\nrequire('openai');")).toEqual(['openai']);
+    expect(detect('a.js', "import a from 'foo/bar';", ['foo'])).toEqual(['foo']);
+  });
+});
