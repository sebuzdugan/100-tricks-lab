+    const afterColon = cleaned.split(':').slice(1).join(':');
+    const inValue = RISK_TIERS.filter((t) => new RegExp(`\\b${t}\\b`, 'i').test(afterColon));
+    if (inValue.length === 1) return inValue[0];
   }
