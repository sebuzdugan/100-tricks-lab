+/** Index of the first colon outside parentheses, or -1. Skips hints like "(name + date; otherwise ...)". */
+function separatorIndex(text: string): number {
+  let depth = 0;
+  for (let i = 0; i < text.length; i += 1) {
+    if (text[i] === '(') depth += 1;
+    else if (text[i] === ')') depth = Math.max(0, depth - 1);
+    else if (text[i] === ':' && depth === 0) return i;
+  }
+  return -1;
+}
+
+/** Real content has at least one letter or digit; bare bullets, pipes, and punctuation do not count. */
+function hasContent(text: string): boolean {
+  return /[\p{L}\p{N}]/u.test(text);
+}
+
+/**
+ * Parses the bold-labelled fields of a subsection. A field's answer is its inline value plus
+ * any lines indented deeper than the field line (blank lines in between are allowed).
+ */
+function parseFields(body: string): Field[] {
+  const lines = body.split(/\r?\n/);
+  const parsed: Array<{ field: Field; inline: string; nested: string[]; indent: number }> = [];
+  let current: (typeof parsed)[number] | null = null;
+
+  for (let lineIndex = 0; lineIndex < lines.length; lineIndex += 1) {
+    const line = lines[lineIndex];
+    if (line.trim() === '') continue;
+    const indent = line.length - line.trimStart().length;
+    if (current && indent > current.indent) {
+      current.nested.push(line.trim());
+      continue;
     }
+    current = null;
+    const m = line.match(FIELD_LINE);
+    if (!m) continue;
+
+    // `**Tier:**` puts the colon inside the bold label; `**Tier**:` puts it after the label.
+    const labelHasColon = m[2].trim().endsWith(':');
+    const rest = m[3];
+    const sep = labelHasColon ? -1 : separatorIndex(rest);
+    current = {
+      field: {
+        label: m[2].replace(/:$/, '').trim(),
+        line: line.trim(),
+        lineIndex,
+        value: '',
+        answered: false
+      },
+      inline: sep === -1 ? rest : rest.slice(sep + 1),
+      nested: [],
+      indent
+    };
+    parsed.push(current);
+  }
+
+  return parsed.map(({ field, inline, nested }) => {
+    const nestedText = nested.join('\n');
+    field.value = [inline.trim(), nestedText].filter(Boolean).join('\n');
+    field.answered = hasContent(inline) || hasContent(nestedText);
+    return field;
+  });
+}
