+import { describe, expect, it } from 'vitest';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { validateSpec } from './validate.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+
+/** A gate with every subsection answered in the `**Label**: value` style. */
+function gate(overrides: Partial<Record<string, string>> = {}): string {
+  const sections: Record<string, string> = {
+    tier: `### 5.1 Risk tier
+
+- **Tier**: limited
+- **Justification**: Chatbot answering policy questions.
+- **Sign-off**: not required (tier below high)`,
+    data: `### 5.2 Data provenance & privacy
+
+- **Data sources**: internal policy docs
+- **PII involved?**: no
+- **Retention**: 30 days, then hard-deleted
+- **Used for training?**: no`,
+    oversight: `### 5.3 Human oversight
+
+- **Automation level**: assistive
+- **Override path**: support team corrects answers in the admin panel
+- **Kill switch**: feature flag chat_enabled, off within 5 minutes`,
+    evaluation: `### 5.4 Evaluation plan
+
+- **Pre-ship metrics & thresholds**: groundedness >= 0.85
+- **Eval dataset**: eval/policy-qa.jsonl, 300 questions
+- **Who runs it and when**: CI on every prompt change`,
+    bias: `### 5.5 Bias & fairness
+
+- **Groups at risk of disparate impact**: non-native English speakers
+- **Mitigations**: multilingual eval slice
+- **How tested**: disaggregated groundedness by question language`,
+    monitoring: `### 5.6 Monitoring & rollback
+
+- **Production monitoring**: thumbs-down rate, refusal rate
+- **Degradation definition**: thumbs-down > 10% over 24h
+- **Rollback trigger & procedure**: on-call flips chat_enabled off`,
+    transparency: `### 5.7 Transparency & incident response
+
+- **User disclosure**: "AI assistant" label in the chat header
+- **Incident owner**: Dana Rivers (support-eng rotation)
+- **Incident path**: in-chat report -> triage queue, response within 24h`
+  };
+  Object.assign(sections, overrides);
+  return `# Spec: Policy Chatbot
+
+## 5. Responsible AI Gate
+
+${Object.values(sections).join('\n\n')}
+
+## 6. Rollout
+
+Later.`;
+}
+
+function findingsFor(markdown: string, checkId: string): string[] {
+  return validateSpec(markdown)
+    .findings.filter((f) => f.checkId === checkId)
+    .map((f) => f.message);
+}
+
+describe('validateSpec field formats', () => {
+  it('passes a fully answered gate written with the colon inside the bold label', () => {
+    const result = validateSpec(
+      gate({
+        tier: `### 5.1 Risk tier
+
+- **Tier:** **limited**
+- **Justification:** Chatbot answering policy questions.
+- **Sign-off:** not required (tier below high)`
+      })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+    expect(result.tier).toBe('limited');
+  });
+
+  it('treats an empty field as unanswered in both label styles', () => {
+    const dataFindings = findingsFor(
+      gate({
+        data: `### 5.2 Data provenance & privacy
+
+- **Data sources:**
+- **PII involved?**: no
+- **Retention:**
+- **Used for training?**: no`
+      }),
+      'data-privacy'
+    );
+    expect(dataFindings).toEqual([
+      'Unanswered field in "Data & privacy": - **Data sources:**',
+      'Unanswered field in "Data & privacy": - **Retention:**'
+    ]);
+  });
+
+  it('accepts an answer in nested bullets under the field', () => {
+    const result = validateSpec(
+      gate({
+        data: `### 5.2 Data provenance & privacy
+
+- **Data sources:**
+  - *Runtime inputs:* the ticket message
+  - *Retrieval:* none
+- **PII involved?**: no
+- **Retention**: 30 days
+- **Used for training?**: no`
+      })
+    );
+    expect(result.findings).toEqual([]);
+  });
+
+  it('accepts an answer in an indented table, with a blank line before it', () => {
+    const result = validateSpec(
+      gate({
+        evaluation: `### 5.4 Evaluation plan
+
+- **Pre-ship metrics & thresholds**:
+
+  | Metric | Threshold |
+  |---|---|
+  | Recall | >= 0.95 |
+
+- **Eval dataset**: eval/policy-qa.jsonl, 300 questions
+- **Who runs it and when**: CI on every prompt change`
+      })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('reads the tier and sign-off from indented lines under their fields', () => {
+    const result = validateSpec(
+      gate({
+        tier: `### 5.1 Risk tier
+
+- **Tier:**
+  - high
+- **Justification:** Screens job applications automatically.
+- **Sign-off:**
+  - Ana Pop (Head of Compliance), 2026-08-01`
+      })
+    );
+    expect(result.tier).toBe('high');
+    expect(result.findings.filter((f) => f.checkId === 'risk-tier')).toEqual([]);
+  });
+
+  it('blocks high risk when the nested sign-off is still "not required"', () => {
+    const result = validateSpec(
+      gate({
+        tier: `### 5.1 Risk tier
+
+- **Tier:** high
+- **Sign-off:**
+  - not required (tier below high)`
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings.some((f) => f.message.includes('sign-off'))).toBe(true);
+  });
+
+  it('blocks any unresolved NEEDS HUMAN INPUT in a gate subsection', () => {
+    const result = validateSpec(
+      gate({
+        monitoring: `### 5.6 Monitoring & rollback
+
+- **Production monitoring**: thumbs-down rate, refusal rate
+- **Degradation definition**: thumbs-down > 10% over 24h
+- **Rollback trigger & procedure**:
+  - on-call flips chat_enabled off
+  - **NEEDS HUMAN INPUT:** who decides on rollback outside the automatic triggers?`
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings).toEqual([
+      expect.objectContaining({
+        checkId: 'monitoring',
+        severity: 'block',
+        message: expect.stringContaining('NEEDS HUMAN INPUT')
+      })
+    ]);
+  });
+
+  it('passes once the NEEDS HUMAN INPUT marker is replaced by the answer', () => {
+    const result = validateSpec(
+      gate({
+        monitoring: `### 5.6 Monitoring & rollback
+
+- **Production monitoring**: thumbs-down rate, refusal rate
+- **Degradation definition**: thumbs-down > 10% over 24h
+- **Rollback trigger & procedure**:
+  - on-call flips chat_enabled off
+  - Rollback decided by the on-call lead; target 1 hour`
+      })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('passes the reference draft once its open questions are resolved', () => {
+    const draft = fs.readFileSync(
+      path.join(here, '../../../../examples/support-triage-demo/rai-gate-draft.reference.md'),
+      'utf8'
+    );
+    const resolved = draft
+      .replace(/\*\*NEEDS HUMAN INPUT:\*\* /g, '')
+      .replace(/NEEDS HUMAN INPUT: /g, '');
+    const result = validateSpec(resolved);
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+    expect(result.tier).toBe('limited');
+  });
+});
