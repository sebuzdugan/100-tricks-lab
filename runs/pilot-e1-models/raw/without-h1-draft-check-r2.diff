+import { describe, expect, it } from 'vitest';
+import { validateSpec } from './validate.js';
+
+/** A gate with every subsection answered; tests override one subsection at a time. */
+const ANSWERED: Record<string, string> = {
+  tier: `### 1 · Risk tier
+
+- **Tier**: limited
+- **Why this tier**: Chatbot answering policy questions.
+- **Sign-off**: not required (tier below high)`,
+  data: `### 2 · Data & privacy
+
+- **Data going in**: the ticket message only
+- **PII?**: no
+- **Retention**: 30 days, then hard-deleted
+- **Trained on user data?**: no`,
+  oversight: `### 3 · Human oversight
+
+- **Automation level**: assistive
+- **Override**: support lead corrects in the admin panel
+- **Kill switch**: TRIAGE_MODE=off, on-call, under 5 minutes`,
+  evaluation: `### 4 · Evaluation
+
+- **Metrics + thresholds**: groundedness >= 0.85
+- **Eval dataset**: evals/golden.jsonl, 300 tickets
+- **Who runs it, when**: CI on every prompt change`,
+  bias: `### 5 · Bias & fairness
+
+- **Who could be treated unfairly**: non-native English writers
+- **Mitigations**: language-neutral prompt rule
+- **How you test it**: recall per language slice`,
+  monitoring: `### 6 · Monitoring & rollback
+
+- **What you watch in production**: thumbs-down rate
+- **"Degraded" means**: thumbs-down > 10% over 24h
+- **Rollback**: on-call flips the flag; users see the legacy flow`,
+  transparency: `### 7 · Transparency & incidents
+
+- **How users know AI is involved**: "AI assistant" label in the chat header
+- **Incident owner**: Dana Rivers
+- **Report → fix path**: in-app report, response within 24h`
+};
+
+function gateWith(overrides: Record<string, string> = {}): string {
+  const sections = { ...ANSWERED, ...overrides };
+  return `# Spec: Policy Chatbot
+
+## Responsible AI Gate
+
+${Object.values(sections).join('\n\n')}
+
+## Rollout
+
+Later.`;
+}
+
+function unansweredMessages(markdown: string): string[] {
+  return validateSpec(markdown)
+    .findings.filter((f) => f.message.startsWith('Unanswered field'))
+    .map((f) => f.message);
+}
+
+describe('validateSpec field formats', () => {
+  it('accepts both label styles', () => {
+    const result = validateSpec(gateWith());
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('reads the tier from a colon-inside-bold label', () => {
+    const result = validateSpec(
+      gateWith({
+        tier: `### 1 · Risk tier
+
+- **Tier:** **limited**
+- **Why this tier**: Chatbot answering policy questions.
+- **Sign-off**: not required (tier below high)`
+      })
+    );
+    expect(result.tier).toBe('limited');
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('treats an empty field as unanswered in either label style', () => {
+    const messages = unansweredMessages(
+      gateWith({
+        data: `### 2 · Data & privacy
+
+- **Data going in:**
+- **PII?**: no
+- **Retention**:
+- **Trained on user data?**: no`
+      })
+    );
+    expect(messages).toEqual([
+      'Unanswered field in "Data & privacy": - **Data going in:**',
+      'Unanswered field in "Data & privacy": - **Retention**:'
+    ]);
+  });
+
+  it('accepts an answer on indented lines below the field', () => {
+    const result = validateSpec(
+      gateWith({
+        data: `### 2 · Data & privacy
+
+- **Data going in**:
+  - *Runtime:* the ticket message only
+
+- **PII?**:
+
+  No - name and email are stripped before the model call.
+- **Retention**:
+    30 days, then hard-deleted
+- **Trained on user data?**: no`
+      })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('accepts an indented table as the answer to a field', () => {
+    const result = validateSpec(
+      gateWith({
+        evaluation: `### 4 · Evaluation
+
+- **Metrics + thresholds**:
+
+  | Metric | Threshold |
+  |---|---|
+  | P1 recall | >= 0.95 |
+
+- **Eval dataset**: evals/golden.jsonl, 300 tickets
+- **Who runs it, when**: CI on every prompt change`
+      })
+    );
+    expect(result.findings).toEqual([]);
+  });
+
+  it('still flags a field whose only indented content is another empty field', () => {
+    const messages = unansweredMessages(
+      gateWith({
+        oversight: `### 3 · Human oversight
+
+- **Automation level**: assistive
+- **Override**:
+  - **Who**:
+- **Kill switch**: TRIAGE_MODE=off, on-call, under 5 minutes`
+      })
+    );
+    expect(messages).toEqual([
+      'Unanswered field in "Human oversight": - **Override**:',
+      'Unanswered field in "Human oversight": - **Who**:'
+    ]);
+  });
+
+  it('reads the tier from an indented line below the Tier field', () => {
+    const result = validateSpec(
+      gateWith({
+        tier: `### 1 · Risk tier
+
+- **Tier**:
+  limited
+- **Why this tier**: Chatbot answering policy questions.
+- **Sign-off**: not required (tier below high)`
+      })
+    );
+    expect(result.tier).toBe('limited');
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('accepts a named sign-off given on an indented line below the field', () => {
+    const result = validateSpec(
+      gateWith({
+        tier: `### 1 · Risk tier
+
+- **Tier:** **high**
+- **Why this tier**: Screens job applications automatically.
+- **Sign-off**:
+
+  Ana Pop (Head of Compliance), 2026-08-01`
+      })
+    );
+    expect(result.findings.filter((f) => f.checkId === 'risk-tier')).toEqual([]);
+  });
+
+  it('still blocks high risk when the indented sign-off says not required', () => {
+    const result = validateSpec(
+      gateWith({
+        tier: `### 1 · Risk tier
+
+- **Tier:** **high**
+- **Why this tier**: Screens job applications automatically.
+- **Sign-off**:
+  not required (tier below high)`
+      })
+    );
+    expect(result.findings.some((f) => f.message.includes('sign-off'))).toBe(true);
+  });
+});
+
+describe('validateSpec NEEDS HUMAN INPUT', () => {
+  it('blocks an unresolved NEEDS HUMAN INPUT item even when the field is answered', () => {
+    const result = validateSpec(
+      gateWith({
+        data: `### 2 · Data & privacy
+
+- **Data going in**: the ticket message only
+- **PII?**: no
+- **Retention**: 30 days, then hard-deleted
+- **Trained on user data?**: no
+- **NEEDS HUMAN INPUT:** Confirm the provider's data-controls setting.`
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(
+      result.findings.some(
+        (f) => f.checkId === 'data-privacy' && f.message.startsWith('Unresolved NEEDS HUMAN INPUT')
+      )
+    ).toBe(true);
+  });
+
+  it('blocks a NEEDS HUMAN INPUT item on an indented line below a field', () => {
+    const result = validateSpec(
+      gateWith({
+        monitoring: `### 6 · Monitoring & rollback
+
+- **What you watch in production**: thumbs-down rate
+- **"Degraded" means**: thumbs-down > 10% over 24h
+- **Rollback**: on-call flips the flag
+  - **NEEDS HUMAN INPUT:** Who decides on rollback outside the automatic triggers?`
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings.some((f) => f.checkId === 'monitoring')).toBe(true);
+  });
+
+  it('blocks a NEEDS HUMAN INPUT item in the risk tier section', () => {
+    const result = validateSpec(
+      gateWith({
+        tier: `### 1 · Risk tier
+
+- **Tier:** **limited**
+- **Why this tier**: Chatbot answering policy questions.
+- **NEEDS HUMAN INPUT:** Can users submit safety-critical content?
+- **Sign-off**: not required (tier below high)`
+      })
+    );
+    expect(result.tier).toBe('limited');
+    expect(result.verdict).toBe('BLOCK');
+  });
+
+  it('passes once every NEEDS HUMAN INPUT item is resolved', () => {
+    const result = validateSpec(
+      gateWith({
+        transparency: `### 7 · Transparency & incidents
+
+- **How users know AI is involved**: "AI assistant" label in the chat header
+- **Incident owner:** Dana Rivers
+- **Report → fix path**: in-app report, response within 24h
+- **Escalation**: support lead confirmed 2026-10-20 - no escalation needed.`
+      })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+  });
+});
