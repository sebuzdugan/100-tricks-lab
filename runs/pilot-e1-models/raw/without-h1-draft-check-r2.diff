+/** A bolded field label at the start of a bullet: `- **Retention**: 30 days` or `- **Retention:** 30 days`. */
+const FIELD_LINE = /^(\s*)[-*]\s*\*\*([^*]+)\*\*(.*)$/;
 
 interface Section {
   heading: string;
