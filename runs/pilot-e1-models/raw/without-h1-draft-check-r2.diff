 }
 
+interface Field {
+  label: string;
+  /** Index of the field's line within the subsection body. */
+  line: number;
+  /** The answer: text on the field line plus any indented lines below it. */
+  value: string;
+  /** True when neither the field line nor anything indented below it answers the field. */
+  empty: boolean;
+}
+
+function indentOf(line: string): number {
+  return line.match(/^\s*/)?.[0].length ?? 0;
+}
+
+/** Returns the text after the colon that ends a field label, skipping colons inside "( … )" hints. */
+function afterLabelColon(rest: string): string | null {
+  let depth = 0;
+  for (let i = 0; i < rest.length; i += 1) {
+    if (rest[i] === '(') depth += 1;
+    else if (rest[i] === ')') depth = Math.max(0, depth - 1);
+    else if (rest[i] === ':' && depth === 0) return rest.slice(i + 1);
+  }
+  return null;
+}
+
+/** The answer written on a field line: whatever follows the label's colon, in either label style. */
+function inlineAnswer(bold: string, rest: string): string {
+  // Colon inside the bold (`**Tier:** limited`).
+  if (bold.endsWith(':')) return rest.trim();
+  // Colon after the bold (`**Tier**: limited`, `**Tier** (prohibited / high):`).
+  const afterColon = afterLabelColon(rest);
+  if (afterColon !== null) return afterColon.trim();
+  // No label colon: a bare trailing colon is an empty field; otherwise the text itself is the answer.
+  if (rest.trimEnd().endsWith(':')) return '';
+  return rest.trim() || bold.trim();
+}
+
+/** Parses the bold-labelled fields of a subsection body, resolving answers that sit on indented lines below. */
+function parseFields(lines: string[]): Field[] {
+  const parsed = lines.map((line) => {
+    const m = line.match(FIELD_LINE);
+    if (!m) return null;
+    const [, indent, bold, rest] = m;
+    return {
+      label: bold.replace(/:$/, '').trim(),
+      indent: indent.length,
+      inline: inlineAnswer(bold, rest)
+    };
+  });
+
+  const fields: Field[] = [];
+  lines.forEach((line, i) => {
+    const field = parsed[i];
+    if (!field) return;
+    const below: number[] = [];
+    for (let j = i + 1; j < lines.length; j += 1) {
+      if (!lines[j].trim()) continue;
+      if (indentOf(lines[j]) <= field.indent) break;
+      below.push(j);
+    }
+    // Lines below that are themselves unanswered fields (e.g. nested `- **Sub**:`) do not answer this one.
+    const empty =
+      !field.inline &&
+      below.every((j) => {
+        const other = parsed[j];
+        return other !== null && !other.inline;
+      });
+    const value = below.reduce(
+      (acc, j) => `${acc} ${lines[j].trim()}`,
+      field.inline
+    );
+    fields.push({ label: field.label, line: i, value: empty ? '' : value.trim(), empty });
+  });
+  return fields;
+}
