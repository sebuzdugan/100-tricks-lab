diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..b55013f
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,32 @@
+const isValidMinimum = (value) =>
+  typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= 1;
+
+export function validateThresholds(thresholds) {
+  if (typeof thresholds !== 'object' || thresholds === null || Array.isArray(thresholds)) {
+    throw new TypeError('thresholds must be an object mapping metric ids to minimum scores.');
+  }
+  Object.entries(thresholds).forEach(([metric, min]) => {
+    if (!isValidMinimum(min)) {
+      throw new RangeError(`Threshold for "${metric}" must be a number between 0 and 1 (got ${String(min)}).`);
+    }
+  });
+  return thresholds;
+}
+
+// A threshold passes when the metric has a numeric score at or above its minimum.
+// A missing metric or a metric without a score fails rather than passing silently.
+export function evaluateThresholds({ evaluations = [], thresholds }) {
+  validateThresholds(thresholds);
+  return Object.entries(thresholds).map(([metric, min]) => {
+    const evaluation = evaluations.find((item) => item?.id === metric);
+    const score = typeof evaluation?.score === 'number' && Number.isFinite(evaluation.score)
+      ? evaluation.score
+      : null;
+    return { metric, min, score, passed: score !== null && score >= min };
+  });
+}
+
+export default {
+  validateThresholds,
+  evaluateThresholds
+};
