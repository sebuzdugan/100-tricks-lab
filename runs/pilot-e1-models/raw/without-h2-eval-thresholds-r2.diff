+function parseEvalThresholds(specs: string[]): Record<string, number> {
+  const validIds = Eval.DEFAULT_METRIC_IDS as unknown as string[];
+  const thresholds: Record<string, number> = {};
+  specs.forEach((spec) => {
+    const match = /^([^=]+)=(\d+(?:\.\d*)?|\.\d+)$/.exec(spec);
+    if (!match) {
+      usageError(`Invalid --threshold "${spec}": expected <metric>=<min>, for example exact_match=0.9.`);
+    }
+    const [, metric, minText] = match;
+    if (!validIds.includes(metric)) {
+      usageError(`Unknown metric "${metric}" in --threshold. Valid metric ids: ${validIds.join(', ')}.`);
+    }
+    const min = Number(minText);
+    if (min > 1) {
+      usageError(`Invalid --threshold "${spec}": the minimum must be between 0 and 1.`);
+    }
+    if (metric in thresholds) {
+      usageError(`Duplicate --threshold for metric "${metric}".`);
+    }
+    thresholds[metric] = min;
+  });
+  return thresholds;
+}
