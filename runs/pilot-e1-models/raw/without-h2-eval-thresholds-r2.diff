@@ -76,4 +76,94 @@ describe('Evaluation harness', () => {
     expect(fs.existsSync(jsonPath)).toBe(true);
     expect(fs.existsSync(markdownPath)).toBe(true);
   });
+
+  describe('thresholds', () => {
+    const baseReport = (evaluations, thresholds) =>
+      generateReport({
+        evaluations,
+        outputsPath: '/tmp/outputs.json',
+        referencesPath: '/tmp/refs.json',
+        generatedAt: '2024-01-01T00:00:00.000Z',
+        thresholds
+      });
+
+    it('leaves the report unchanged when no thresholds are given', () => {
+      const evaluations = runEvaluations({ outputs: ['Hello'], references: ['hello'] });
+      const report = baseReport(evaluations);
+      expect(report).not.toHaveProperty('passed');
+      expect(report).not.toHaveProperty('thresholds');
+      expect(baseReport(evaluations, {})).not.toHaveProperty('thresholds');
+    });
+
+    it('passes when a score meets its minimum and fails when it is below', () => {
+      const evaluations = runEvaluations({
+        outputs: ['a', 'b', 'c', 'd'],
+        references: ['a', 'b', 'c', 'x']
+      });
