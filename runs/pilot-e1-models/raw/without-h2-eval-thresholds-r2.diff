+      expect(passing.thresholds).toEqual([
+        { metric: 'exact_match', min: 0.75, score: 0.75, passed: true }
+      ]);
+
+      const failing = baseReport(evaluations, { exact_match: 0.9 });
+      expect(failing.passed).toBe(false);
+      expect(failing.thresholds).toEqual([
+        { metric: 'exact_match', min: 0.9, score: 0.75, passed: false }
+      ]);
+    });
+
+    it('fails a threshold whose metric has no score instead of crashing', () => {
+      const evaluations = runEvaluations({ outputs: ['a'] });
+      const report = baseReport(evaluations, { exact_match: 0.5 });
+      expect(report.passed).toBe(false);
+      expect(report.thresholds).toEqual([
+        { metric: 'exact_match', min: 0.5, score: null, passed: false }
+      ]);
+    });
+
+    it('fails a threshold for a metric that was not evaluated', () => {
+      const evaluations = runEvaluations({ outputs: ['a'], references: ['a'] });
+      const report = baseReport(evaluations, { missing_metric: 0 });
+      expect(report.passed).toBe(false);
+      expect(report.thresholds[0]).toMatchObject({ metric: 'missing_metric', score: null });
+    });
+
+    it('applies thresholds to custom metrics passed to runEvaluations', () => {
+      const customMetric = {
+        evaluate: () => ({ id: 'custom_quality', label: 'Custom', score: 0.6, total: 1 })
+      };
+      const evaluations = runEvaluations({
+        outputs: ['a'],
+        references: ['a'],
+        metrics: [customMetric]
+      });
+      const report = baseReport(evaluations, { custom_quality: 0.5 });
+      expect(report.passed).toBe(true);
+      expect(report.thresholds).toEqual([
+        { metric: 'custom_quality', min: 0.5, score: 0.6, passed: true }
+      ]);
+    });
+
+    it('rejects minimums outside 0 to 1', () => {
+      const evaluations = runEvaluations({ outputs: ['a'], references: ['a'] });
+      expect(() => baseReport(evaluations, { exact_match: 1.5 })).toThrow(/between 0 and 1/);
+      expect(() => baseReport(evaluations, { exact_match: -0.1 })).toThrow(/between 0 and 1/);
+      expect(() => baseReport(evaluations, { exact_match: '0.9' })).toThrow(/between 0 and 1/);
+    });
+
+    it('adds a Thresholds section to the Markdown report', () => {
