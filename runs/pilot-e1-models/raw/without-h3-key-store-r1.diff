diff --git a/packages/frai-core/src/config/key-store.test.js b/packages/frai-core/src/config/key-store.test.js
index d75d8c2..a22ee97 100644
--- a/packages/frai-core/src/config/key-store.test.js
+++ b/packages/frai-core/src/config/key-store.test.js
@@ -54,4 +54,115 @@ describe('config key store', () => {
     const content = fs.readFileSync(configPath, 'utf8');
     expect(JSON.parse(content).OPENAI_API_KEY).toBe('global-key');
   });
+
+  describe('local .env', () => {
+    const writeEnv = (cwd, content) => fs.writeFileSync(resolveLocalEnvPath(cwd), content, 'utf8');
+    const readEnv = (cwd) => fs.readFileSync(resolveLocalEnvPath(cwd), 'utf8');
+
+    it('keeps every other line byte-for-byte when saving a key', () => {
+      const original = '# project settings\n\nFOO=bar\n  BAZ = "qux" # note\r\nexport OPENAI_API_KEY="sk-old" # rotated\nLAST=1';
+      writeEnv(tmpCwd, original);
+
+      setLocalApiKey('sk-new', tmpCwd);
+
+      expect(readEnv(tmpCwd)).toBe(
+        '# project settings\n\nFOO=bar\n  BAZ = "qux" # note\r\nexport OPENAI_API_KEY=sk-new # rotated\nLAST=1'
+      );
+      expect(getLocalApiKey(tmpCwd)).toBe('sk-new');
+    });
+
+    it('appends the key when no definition exists', () => {
+      writeEnv(tmpCwd, 'FOO=bar');
+
+      setLocalApiKey('sk-new', tmpCwd);
+
+      expect(readEnv(tmpCwd)).toBe('FOO=bar\nOPENAI_API_KEY=sk-new\n');
+    });
+
+    it('updates only the last definition when the key is defined twice', () => {
+      writeEnv(tmpCwd, 'OPENAI_API_KEY=first\nFOO=1\nOPENAI_API_KEY=second\n');
+
+      expect(getLocalApiKey(tmpCwd)).toBe('second');
+      setLocalApiKey('sk-new', tmpCwd);
+
+      expect(readEnv(tmpCwd)).toBe('OPENAI_API_KEY=first\nFOO=1\nOPENAI_API_KEY=sk-new\n');
+    });
+
+    it('quotes values that cannot be written bare and reads them back', () => {
+      setLocalApiKey('sk-a b#c', tmpCwd);
+
+      expect(readEnv(tmpCwd)).toBe("OPENAI_API_KEY='sk-a b#c'\n");
+      expect(getLocalApiKey(tmpCwd)).toBe('sk-a b#c');
+
+      setLocalApiKey(`it's "x"\\y`, tmpCwd);
+
+      expect(readEnv(tmpCwd)).toBe('OPENAI_API_KEY="it\'s \\"x\\"\\\\y"\n');
+      expect(getLocalApiKey(tmpCwd)).toBe(`it's "x"\\y`);
+    });
+
+    it('reads export prefixes, quotes and trailing comments', () => {
+      writeEnv(tmpCwd, 'export OPENAI_API_KEY="sk-quoted" # rotated\n');
+      expect(getLocalApiKey(tmpCwd)).toBe('sk-quoted');
+
+      writeEnv(tmpCwd, "OPENAI_API_KEY='sk-single'\n");
+      expect(getLocalApiKey(tmpCwd)).toBe('sk-single');
+
+      writeEnv(tmpCwd, 'OPENAI_API_KEY=sk-bare # comment\n');
+      expect(getLocalApiKey(tmpCwd)).toBe('sk-bare');
+
+      writeEnv(tmpCwd, 'OPENAI_API_KEY=sk#not-a-comment\n');
+      expect(getLocalApiKey(tmpCwd)).toBe('sk#not-a-comment');
+    });
+
+    it('ignores commented-out definitions', () => {
+      writeEnv(tmpCwd, '# OPENAI_API_KEY=sk-commented\n');
+
+      expect(hasLocalApiKey(tmpCwd)).toBe(false);
+      expect(getLocalApiKey(tmpCwd)).toBeNull();
+    });
+
+    it('does not count an empty key as configured', () => {
+      writeEnv(tmpCwd, 'FOO=bar\n');
+      expect(hasLocalApiKey(tmpCwd)).toBe(false);
+
+      writeEnv(tmpCwd, 'OPENAI_API_KEY=\n');
+      expect(hasLocalApiKey(tmpCwd)).toBe(false);
+      expect(getLocalApiKey(tmpCwd)).toBeNull();
+
+      writeEnv(tmpCwd, 'OPENAI_API_KEY=""\n');
+      expect(getLocalApiKey(tmpCwd)).toBeNull();
+    });
+  });
+
+  describe('global config', () => {
+    const configPath = (homeDir) => resolveGlobalConfigPath(homeDir);
+
+    it('keeps other JSON fields when saving a key', () => {
+      fs.mkdirSync(path.dirname(configPath(tmpHome)), { recursive: true });
+      fs.writeFileSync(configPath(tmpHome), JSON.stringify({ theme: 'dark', OPENAI_API_KEY: 'old' }), 'utf8');
+
+      setGlobalApiKey('global-key', tmpHome);
+
+      expect(JSON.parse(fs.readFileSync(configPath(tmpHome), 'utf8'))).toEqual({
+        theme: 'dark',
+        OPENAI_API_KEY: 'global-key'
+      });
+    });
+
+    it('fails and leaves an invalid config untouched', () => {
+      fs.mkdirSync(path.dirname(configPath(tmpHome)), { recursive: true });
+      fs.writeFileSync(configPath(tmpHome), '{ not json', 'utf8');
+
+      expect(() => setGlobalApiKey('global-key', tmpHome)).toThrow(/not valid JSON/);
+      expect(fs.readFileSync(configPath(tmpHome), 'utf8')).toBe('{ not json');
+    });
+
+    it('does not count an empty key as configured', () => {
+      fs.mkdirSync(path.dirname(configPath(tmpHome)), { recursive: true });
+      fs.writeFileSync(configPath(tmpHome), JSON.stringify({ OPENAI_API_KEY: '  ' }), 'utf8');
+
+      expect(hasGlobalApiKey(tmpHome)).toBe(false);
+      expect(getGlobalApiKey(tmpHome)).toBeNull();
+    });
+  });
 });
