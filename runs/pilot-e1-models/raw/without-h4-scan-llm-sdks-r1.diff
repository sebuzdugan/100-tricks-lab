index 0000000..2caf427
--- /dev/null
+++ b/packages/frai-core/src/scanners/imports.js
@@ -0,0 +1,197 @@
+import path from 'path';
+
+const JS_EXTENSIONS = new Set(['.js', '.mjs', '.cjs', '.jsx', '.ts', '.tsx', '.mts', '.cts']);
+
+const JS_SPECIFIER_PATTERNS = [
+  // import x from '…', import type { X } from '…', export { a } from '…', export * from '…'
+  /\b(?:import|export)\s+(?:type\s+)?[^;'"=()]*?\bfrom\s*(['"])([^'"\r\n]+)\1/g,
+  // import '…'
+  /\bimport\s*(['"])([^'"\r\n]+)\1/g,
+  // import('…')
+  /\bimport\s*\(\s*(['"])([^'"\r\n]+)\1\s*\)/g,
+  // require('…')
+  /\brequire\s*\(\s*(['"])([^'"\r\n]+)\1\s*\)/g
+];
+
+const PY_FROM_IMPORT = /^\s*from\s+([A-Za-z_][\w.]*)\s+import\b/;
+const PY_IMPORT = /^\s*import\s+(.+?)\s*;?\s*$/;
+const PY_MODULE = /^[A-Za-z_][\w.]*$/;
+
+// Replace comments with spaces (keeping newlines) so line numbers and string literals survive.
+const blankJsComments = (source) => {
+  const out = [];
+  const len = source.length;
+  let i = 0;
+  while (i < len) {
+    const ch = source[i];
+    const next = source[i + 1];
+
+    if (ch === '"' || ch === "'" || ch === '`') {
+      out.push(ch);
+      i += 1;
+      while (i < len && source[i] !== ch) {
+        if (source[i] === '\\' && i + 1 < len) {
+          out.push(source[i], source[i + 1]);
+          i += 2;
+          continue;
+        }
+        // Quoted strings cannot span lines; stop so a stray quote cannot hide the rest of the file.
+        if (source[i] === '\n' && ch !== '`') break;
+        out.push(source[i]);
+        i += 1;
+      }
+      if (i < len && source[i] === ch) {
+        out.push(ch);
+        i += 1;
+      }
+      continue;
+    }
+
+    if (ch === '/' && next === '/') {
+      while (i < len && source[i] !== '\n') {
+        out.push(' ');
+        i += 1;
+      }
+      continue;
+    }
+
+    if (ch === '/' && next === '*') {
+      out.push('  ');
+      i += 2;
+      while (i < len && !(source[i] === '*' && source[i + 1] === '/')) {
+        out.push(source[i] === '\n' ? '\n' : ' ');
+        i += 1;
+      }
+      if (i < len) {
+        out.push('  ');
+        i += 2;
+      }
+      continue;
+    }
+
+    out.push(ch);
+    i += 1;
+  }
+  return out.join('');
+};
+
+// Replace Python comments and string bodies with spaces, so docstrings and
+// commented-out imports cannot produce matches.
+const blankPythonCommentsAndStrings = (source) => {
+  const out = [];
+  const len = source.length;
+  const blank = (c) => (c === '\n' ? '\n' : ' ');
+  let i = 0;
+  while (i < len) {
+    const ch = source[i];
+
+    if (ch === '#') {
+      while (i < len && source[i] !== '\n') {
+        out.push(' ');
+        i += 1;
+      }
+      continue;
+    }
+
+    if (ch === '"' || ch === "'") {
+      const triple = source.startsWith(ch.repeat(3), i);
+      const delim = triple ? ch.repeat(3) : ch;
+      out.push(delim);
+      i += delim.length;
+      while (i < len && !source.startsWith(delim, i)) {
+        if (source[i] === '\\' && i + 1 < len) {
+          out.push(' ', blank(source[i + 1]));
+          i += 2;
+          continue;
+        }
+        if (!triple && source[i] === '\n') break;
+        out.push(blank(source[i]));
+        i += 1;
+      }
+      if (i < len && source.startsWith(delim, i)) {
+        out.push(delim);
+        i += delim.length;
+      }
+      continue;
+    }
+
+    out.push(ch);
+    i += 1;
+  }
+  return out.join('');
+};
+
+const findJsModules = (source) => {
+  const modules = [];
+  for (const pattern of JS_SPECIFIER_PATTERNS) {
+    for (const match of source.matchAll(pattern)) {
+      modules.push(match[2]);
+    }
+  }
+  return modules;
+};
+
+const findPythonModules = (source) => {
+  const modules = [];
+  for (const line of source.split('\n')) {
+    const fromMatch = PY_FROM_IMPORT.exec(line);
+    if (fromMatch) {
+      modules.push(fromMatch[1]);
+      continue;
+    }
+    const importMatch = PY_IMPORT.exec(line);
+    if (importMatch) {
+      for (const item of importMatch[1].split(',')) {
+        const moduleName = item.trim().split(/\s+as\s+/)[0].trim();
+        if (PY_MODULE.test(moduleName)) {
+          modules.push(moduleName);
+        }
+      }
+    }
+  }
+  return modules;
+};
+
+// Jupyter notebooks are JSON; only the code cells hold Python source.
+const notebookSource = (content) => {
+  try {
+    const notebook = JSON.parse(content);
+    return (notebook.cells ?? [])
+      .filter((cell) => cell.cell_type === 'code')
+      .map((cell) => [cell.source].flat().join(''))
+      .join('\n');
+  } catch {
+    return content;
+  }
+};
+
+/**
+ * Returns the module names a source file imports, plus the separator that
+ * separates a package from its sub-modules in that language.
+ * JS/TS use '/' (`openai/resources`, `@langchain/openai`); Python and other
+ * languages use '.' (`torch.nn`).
+ */
+export const extractImportedModules = (filePath, content) => {
+  const ext = path.extname(filePath).toLowerCase();
+  if (JS_EXTENSIONS.has(ext)) {
+    return { separator: '/', modules: findJsModules(blankJsComments(content)) };
+  }
+  if (ext === '.ipynb') {
+    return { separator: '.', modules: findPythonModules(blankPythonCommentsAndStrings(notebookSource(content))) };
+  }
+  if (ext === '.py') {
+    return { separator: '.', modules: findPythonModules(blankPythonCommentsAndStrings(content)) };
+  }
+  // Other languages (Java, Scala, R, …): match the Python-style `import a.b` form after stripping C-style comments.
+  return { separator: '.', modules: findPythonModules(blankJsComments(content)) };
+};
+
+/**
+ * A library matches a module when it is the module itself or one of its sub-modules.
+ * `openai` matches `openai` and `openai/resources`, but not `openai-mock`.
+ */
+export const moduleMatchesLibrary = (moduleName, library, separator) => {
+  const mod = moduleName.toLowerCase();
+  const lib = library.toLowerCase();
+  return mod === lib || mod.startsWith(`${lib}${separator}`);
+};
