index 0000000..010bac7
--- /dev/null
+++ b/packages/frai-core/src/scanners/detectors.test.js
@@ -0,0 +1,136 @@
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { describe, expect, it } from 'vitest';
+
+import { createLibraryDetector } from './detectors.js';
+import { scanCodebase } from './index.js';
+
+const detect = (filePath, content, libraries) => {
+  const result = {
+    aiLibraryMatches: {},
+    markAiFile() {}
+  };
+  createLibraryDetector(libraries).analyze({ filePath, content, result });
+  return result.aiLibraryMatches[filePath] ?? [];
+};
+
+const detectJs = (content, filePath = '/repo/src/client.ts') => detect(filePath, content);
+const detectPy = (content) => detect('/repo/app.py', content);
+
+describe('createLibraryDetector: JavaScript/TypeScript imports', () => {
+  it.each([
+    ["import OpenAI from 'openai';", ['openai']],
+    ['import type { Message } from "@anthropic-ai/sdk";', ['@anthropic-ai/sdk']],
+    ["import {\n  ChatOpenAI,\n  type Foo\n} from '@langchain/openai';", ['@langchain']],
+    ["import * as lc from 'langchain/tools';", ['langchain']],
+    ["import 'openai/shims';", ['openai']],
+    ["export { default } from 'anthropic';", ['anthropic']],
+    ["export * from '@langchain/core/messages';", ['@langchain']],
+    ["const OpenAI = require('openai');", ['openai']],
+    ["const sdk = require ( \"@anthropic-ai/sdk\" );", ['@anthropic-ai/sdk']],
+    ["const mod = await import('openai');", ['openai']],
+    ["import x = require('anthropic');", ['anthropic']]
+  ])('detects %s', (content, expected) => {
+    expect(detectJs(content)).toEqual(expected);
+  });
+
+  it('scans .mjs, .cjs, .mts and .cts files', () => {
+    for (const ext of ['.mjs', '.cjs', '.mts', '.cts']) {
+      expect(detectJs("import OpenAI from 'openai';", `/repo/a${ext}`)).toEqual(['openai']);
+    }
+  });
+
+  it('reports each library once, even when several modules map to it', () => {
+    const content = [
+      "import { ChatOpenAI } from '@langchain/openai';",
+      "import { PromptTemplate } from '@langchain/core/prompts';",
+      "import { tool } from 'langchain/tools';",
+      "import { tool as t2 } from 'langchain';"
+    ].join('\n');
+    expect(detectJs(content)).toEqual(['langchain', '@langchain']);
+  });
+
+  it('does not match a different module that starts with the same letters', () => {
+    expect(detectJs("import m from 'openai-mock';")).toEqual([]);
+    expect(detectJs("import c from 'caretaker';", '/repo/a.js')).toEqual([]);
+    expect(detectJs("import l from 'langchainjs-utils';")).toEqual([]);
+    expect(detectJs("import l from '@langchain-utils/x';")).toEqual([]);
+  });
+
+  it('ignores relative imports and commented-out imports', () => {
+    expect(detectJs("import OpenAI from './openai';")).toEqual([]);
+    expect(detectJs("import c from '../anthropic/client';")).toEqual([]);
+    expect(detectJs("// import OpenAI from 'openai';")).toEqual([]);
+    expect(detectJs("/* import OpenAI from 'openai'; */\nconst x = 1;")).toEqual([]);
+    expect(detectJs("const url = 'https://api.openai.com'; // import 'openai'")).toEqual([]);
+  });
+
+  it('does not treat a non-import use of from() as an import', () => {
+    expect(detectJs("const xs = Array.from('openai');")).toEqual([]);
+  });
+});
+
+describe('createLibraryDetector: Python imports', () => {
+  it.each([
+    ['import openai', ['openai']],
+    ['import numpy as np, anthropic', ['anthropic']],
+    ['import openai.resources', ['openai']],
+    ['from torch.nn import functional as F', ['torch']],
+    ['from langchain.chains import LLMChain', ['langchain']],
+    ['  import torch  # the openai and anthropic SDKs are not used here', ['torch']]
+  ])('detects %j', (content, expected) => {
+    expect(detectPy(content)).toEqual(expected);
+  });
+
+  it('ignores comments, docstrings, relative imports and names imported from other modules', () => {
+    expect(detectPy('# import openai')).toEqual([]);
+    expect(detectPy('"""\nimport openai\n"""\nx = 1')).toEqual([]);
+    expect(detectPy('from . import openai')).toEqual([]);
+    expect(detectPy('from .openai import Client')).toEqual([]);
+    expect(detectPy('from utils import torch')).toEqual([]);
+    expect(detectPy('import openai_mock')).toEqual([]);
+  });
+});
+
+describe('createLibraryDetector: custom libraries', () => {
+  it('matches only the libraries it was given', () => {
+    expect(detectJs("import OpenAI from 'openai';", '/repo/a.ts')).toEqual(['openai']);
+    expect(detect('/repo/a.ts', "import OpenAI from 'openai';", ['fizz'])).toEqual([]);
+    expect(detect('/repo/a.ts', "import f from 'fizz/buzz';", ['fizz'])).toEqual(['fizz']);
+  });
+});
+
+describe('scanCodebase: detection and roots', () => {
+  it('finds LLM SDK usage in .mts files and reports the library names', () => {
+    const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-scan-llm-'));
+    try {
+      fs.writeFileSync(
+        path.join(tmpDir, 'triage.mts'),
+        "import Anthropic from '@anthropic-ai/sdk';\nimport { ChatOpenAI } from '@langchain/openai';\n"
+      );
+      const results = scanCodebase({ root: tmpDir });
+      const file = path.join(tmpDir, 'triage.mts');
+      expect(results.aiFiles).toEqual([file]);
+      expect(results.aiLibraryMatches[file]).toEqual(['@anthropic-ai/sdk', '@langchain']);
+    } finally {
+      fs.rmSync(tmpDir, { recursive: true, force: true });
+    }
+  });
+
+  it('throws when the root directory does not exist', () => {
+    const missing = path.join(os.tmpdir(), `frai-missing-${process.pid}-${Date.now()}`);
+    expect(() => scanCodebase({ root: missing })).toThrow(/does not exist or is not a directory/);
+  });
+
+  it('throws when the root is a file', () => {
+    const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-scan-file-'));
+    try {
+      const file = path.join(tmpDir, 'app.py');
+      fs.writeFileSync(file, 'import openai\n');
+      expect(() => scanCodebase({ root: file })).toThrow(/is not a directory/);
+    } finally {
+      fs.rmSync(tmpDir, { recursive: true, force: true });
+    }
+  });
+});
diff --git a/packages/frai-core/src/scanners/imports.js b/packages/frai-core/src/scanners/imports.js
