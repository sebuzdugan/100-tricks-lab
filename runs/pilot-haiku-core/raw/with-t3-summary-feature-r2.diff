@@ -1,4 +1,4 @@
-import { Finding, GateResult } from './schema.js';
+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,33 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const total = GATE_CHECKS.length;
+
+  if (result.gateSection === null) {
+    return `${result.verdict} 0/${total}: structure`;
+  }
+
+  const blockedCheckIds = new Set(
+    result.findings
+      .filter((f) => f.severity === 'block')
+      .map((f) => f.checkId)
+  );
+
+  const answered = total - blockedCheckIds.size;
+
+  let summary = `${result.verdict} ${answered}/${total}`;
+
+  if (blockedCheckIds.size > 0) {
+    const blockingCheckIds = GATE_CHECKS.map((check) => check.id).filter((id) =>
+      blockedCheckIds.has(id)
+    );
+
+    if (blockingCheckIds.length > 0) {
+      summary += `: ${blockingCheckIds.join(', ')}`;
+    }
+  }
+
+  return summary;
+}
