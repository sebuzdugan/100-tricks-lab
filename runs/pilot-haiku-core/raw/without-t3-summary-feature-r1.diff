+import { Finding, GateResult, GATE_CHECKS } from './schema.js';
 
 const VERDICT_ICON: Record<GateResult['verdict'], string> = {
   PASS: '✅',
@@ -44,3 +44,27 @@ export function renderJson(result: GateResult, specPath: string): string {
     2
   );
 }
+
+export function renderSummary(result: GateResult): string {
+  const blockFindings = result.findings.filter((f) => f.severity === 'block');
+
+  // Check if gate section is missing (structure finding).
+  if (blockFindings.some((f) => f.checkId === 'structure')) {
+    return 'BLOCK 0/7: structure';
+  }
+
+  // Count how many checks have no block findings.
+  const checksWithBlocks = new Set(blockFindings.map((f) => f.checkId));
+  const answered = GATE_CHECKS.length - checksWithBlocks.size;
+
+  let summary = `${result.verdict} ${answered}/${GATE_CHECKS.length}`;
+
+  if (checksWithBlocks.size > 0) {
+    const blockedIds = GATE_CHECKS
+      .map((c) => c.id)
+      .filter((id) => checksWithBlocks.has(id));
+    summary += `: ${blockedIds.join(', ')}`;
+  }
+
+  return summary;
+}
