+import { describe, expect, it } from 'vitest';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { validateSpec } from './validate.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const repoRoot = path.join(here, '../../../..');
+
+function read(relative: string): string {
+  return fs.readFileSync(path.join(repoRoot, relative), 'utf8');
+}
+
+const SECTIONS: Record<string, string> = {
+  tier: `### Risk tier
+
+- **Tier:** limited
+- **Justification:** Chatbot answering policy questions; no automated decisions about people.
+- **Sign-off:** not required (tier below high)`,
+  data: `### Data provenance & privacy
+
+- **Data sources:** internal policy docs; user questions at runtime
+- **PII involved?** no
+- **Retention:** prompts kept 30 days, then hard-deleted
+- **Used for training?** no`,
+  oversight: `### Human oversight
+
+- **Automation level:** assistive
+- **Override path:** support team via admin panel
+- **Kill switch:** feature flag chat_enabled, off within 5 minutes`,
+  evaluation: `### Evaluation plan
+
+- **Metrics:** groundedness >= 0.85; refusal rate <= 2%
+- **Eval dataset:** eval/policy-qa.jsonl, 300 questions
+- **Who runs it:** CI on every prompt change`,
+  bias: `### Bias & fairness
+
+- **Groups:** non-native English speakers
+- **Mitigations:** multilingual eval slice
+- **How tested:** disaggregated groundedness by language`,
+  monitoring: `### Monitoring & rollback
+
+- **Signals:** thumbs-down rate, refusal rate
+- **Degradation:** thumbs-down > 10% over 24h
+- **Rollback:** on-call flips chat_enabled; users see legacy FAQ`,
+  transparency: `### Transparency & incident response
+
+- **Disclosure:** "AI assistant" label in chat header
+- **Incident owner:** Dana Rivers
+- **Path:** in-chat report -> triage -> fix within 24h`
+};
+
+function spec(overrides: Partial<Record<string, string>> = {}): string {
+  return `# Spec\n\n## Responsible AI Gate\n\n${Object.values({ ...SECTIONS, ...overrides }).join('\n\n')}\n`;
+}
+
+describe('validateSpec label styles', () => {
+  it('passes a gate written with the colon inside the bold label', () => {
+    const result = validateSpec(spec());
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+    expect(result.tier).toBe('limited');
+  });
+
+  it('reads a bold tier value', () => {
+    const result = validateSpec(
+      spec({ tier: SECTIONS.tier.replace('- **Tier:** limited', '- **Tier:** **limited**') })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.tier).toBe('limited');
+  });
+
+  it.each([
+    ['colon inside bold', '- **Retention:**'],
+    ['colon after bold', '- **Retention**:'],
+    ['colon after a hint', '- **Retention** (how long, where):']
+  ])('flags an empty field (%s)', (_style, line) => {
+    const result = validateSpec(
+      spec({ data: SECTIONS.data.replace(/- \*\*Retention:\*\*.*/, line) })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings).toEqual([
+      expect.objectContaining({
+        checkId: 'data-privacy',
+        message: `Unanswered field in "Data & privacy": ${line}`
+      })
+    ]);
+  });
+});
+
+describe('validateSpec nested answers', () => {
+  it('accepts nested bullets, an indented table and an indented paragraph after blank lines', () => {
+    const result = validateSpec(
+      spec({
+        data: `### Data provenance & privacy
+
+- **Data sources:**
+  - *Training:* none
+  - *Runtime:* the ticket message
+- **PII involved?**:
+
+  No - identity fields are stripped before the model call.
+
+- **Retention** (how long, where, how deleted):
+  - nothing persisted by the service
+- **Used for training?** no`,
+        evaluation: `### Evaluation plan
+
+- **Pre-ship metrics & thresholds** (all suggested):
+
+  | Metric | Threshold |
+  |---|---|
+  | P1 recall | >= 0.95 |
+
+- **Eval dataset:** eval/policy-qa.jsonl, 300 questions
+- **Who runs it:** CI on every prompt change`
+      })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('still flags a field whose only nested content is another empty field', () => {
+    const result = validateSpec(
+      spec({
+        data: `### Data provenance & privacy
+
+- **Data sources:**
+  - **Runtime:**
+- **PII involved?** no
+- **Retention:** 30 days
+- **Used for training?** no`
+      })
+    );
+    expect(result.findings.map((f) => f.message)).toEqual([
+      'Unanswered field in "Data & privacy": - **Data sources:**',
+      'Unanswered field in "Data & privacy": - **Runtime:**'
+    ]);
+  });
+
+  it('does not treat the next unindented field as an answer', () => {
+    const result = validateSpec(
+      spec({
+        oversight: `### Human oversight
+
+- **Automation level:**
+
+- **Override path:** support team via admin panel
+- **Kill switch:** feature flag chat_enabled, off within 5 minutes`
+      })
+    );
+    expect(result.findings.map((f) => f.message)).toEqual([
+      'Unanswered field in "Human oversight": - **Automation level:**'
+    ]);
+  });
+
+  it('reads a tier written on the line below its field', () => {
+    const result = validateSpec(
+      spec({
+        tier: `### Risk tier
+
+- **Tier** (prohibited / high / limited / minimal):
+  - limited
+  - would become high if tickets carried medical content
+- **Justification:** internal routing only.
+- **Sign-off:** not required (tier below high)`
+      })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.tier).toBe('limited');
+  });
+
+  it('reads a sign-off written on the line below its field', () => {
+    const high = (signoff: string) =>
+      validateSpec(
+        spec({
+          tier: `### Risk tier
+
+- **Tier:** high
+- **Justification:** screens job applications.
+- **Sign-off** (high tier: name + date; otherwise "not required (tier below high)"):
+${signoff}`
+        })
+      ).findings.filter((f) => f.checkId === 'risk-tier');
+
+    expect(high('  - Ana Pop (Head of Compliance), 2026-08-01')).toEqual([]);
+    expect(high('  not required (tier below high)')).toEqual([
+      expect.objectContaining({ message: expect.stringContaining('sign-off') })
+    ]);
+  });
+
+  it('ignores colons inside the template hint when the sign-off is filled in on the line', () => {
+    const result = validateSpec(
+      spec({
+        tier: `### Risk tier
+
+- **Tier**: high
+- **Justification**: screens job applications.
+- **Sign-off** (high tier: name + date; otherwise "not required (tier below high)"): Ana Pop, 2026-08-01`
+      })
+    );
+    expect(result.findings).toEqual([]);
+  });
+});
+
+describe('validateSpec NEEDS HUMAN INPUT', () => {
+  it('blocks the check that still contains the marker', () => {
+    const result = validateSpec(
+      spec({
+        data: `${SECTIONS.data}
+  - **NEEDS HUMAN INPUT:** Is OpenAI covered by a DPA?`,
+        transparency: SECTIONS.transparency.replace(
+          'Dana Rivers',
+          '**NEEDS HUMAN INPUT: Who owns incidents?**'
+        )
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings).toEqual([
+      {
+        checkId: 'data-privacy',
+        severity: 'block',
+        message: 'Unresolved NEEDS HUMAN INPUT in "Data & privacy": Is OpenAI covered by a DPA?',
+        source: 'validator'
+      },
+      {
+        checkId: 'transparency',
+        severity: 'block',
+        message: 'Unresolved NEEDS HUMAN INPUT in "Transparency & incidents": Who owns incidents?',
+        source: 'validator'
+      }
+    ]);
+  });
+});
+
+describe('validateSpec on repo specs', () => {
+  it('reports exactly the existing findings on the untouched template', () => {
+    const result = validateSpec(read('packages/frai-gate/assets/rai-spec-template.md'));
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.tier).toBeNull();
+    expect(result.findings).toEqual(
+      [
+        ['risk-tier', '"Risk tier" is present but empty.'],
+        ['data-privacy', '"Data & privacy" is present but empty.'],
+        ['oversight', '"Human oversight" is present but empty.'],
+        ['evaluation', '"Evaluation plan" is present but empty.'],
+        ['bias', '"Bias & fairness" is present but empty.'],
+        ['monitoring', '"Monitoring & rollback" is present but empty.'],
+        [
+          'transparency',
+          'Unanswered field in "Transparency & incidents": - **How users know AI is involved**:'
+        ],
+        [
+          'transparency',
+          'Unanswered field in "Transparency & incidents": - **Incident owner** (a name, not "the team"):'
+        ],
+        [
+          'transparency',
+          'Unanswered field in "Transparency & incidents": - **Report → fix path** (with a target response time):'
+        ]
+      ].map(([checkId, message]) => ({ checkId, severity: 'block', message, source: 'validator' }))
+    );
+  });
+
+  it.each(['examples/frai-spec-example.md', 'examples/support-triage-demo/FRAI-SPEC.md'])(
+    'still passes %s',
+    (file) => {
+      const result = validateSpec(read(file));
+      expect(result.findings).toEqual([]);
+      expect(result.verdict).toBe('PASS');
+    }
+  );
+
+  it('blocks the reference draft only on its NEEDS HUMAN INPUT items', () => {
+    const result = validateSpec(read('examples/support-triage-demo/rai-gate-draft.reference.md'));
+    expect(result.tier).toBe('limited');
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings.length).toBeGreaterThan(0);
+    for (const finding of result.findings) {
+      expect(finding.message).toMatch(/^Unresolved NEEDS HUMAN INPUT in /);
+    }
+    const blocked = new Set(result.findings.map((f) => f.checkId));
+    expect(blocked).toEqual(
+      new Set(['risk-tier', 'data-privacy', 'oversight', 'evaluation', 'bias', 'monitoring', 'transparency'])
+    );
+  });
+
+  it('passes the reference draft once every NEEDS HUMAN INPUT item is resolved', () => {
+    const draft = read('examples/support-triage-demo/rai-gate-draft.reference.md');
+    const result = validateSpec(draft.replace(/NEEDS HUMAN INPUT/g, 'Resolved'));
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+    expect(result.tier).toBe('limited');
+  });
+});
