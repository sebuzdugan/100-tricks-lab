+function indentOf(line: string): number {
+  const lead = line.match(/^\s*/)?.[0] ?? '';
+  return lead.replace(/\t/g, '    ').length;
+}
+
+/** Non-blank lines indented below line `index` (blank lines in between are allowed). */
+function nestedLines(lines: string[], index: number): string[] {
+  const base = indentOf(lines[index]);
+  const nested: string[] = [];
+  for (let i = index + 1; i < lines.length; i += 1) {
+    if (!lines[i].trim()) continue;
+    if (indentOf(lines[i]) <= base) break;
+    nested.push(lines[i]);
+  }
+  return nested;
+}
+
+/** Skips a leading "(hint ...)" (parentheses may nest) and returns the rest, or null when unbalanced. */
+function skipParenthetical(text: string): string | null {
+  let depth = 0;
+  for (let i = 0; i < text.length; i += 1) {
+    if (text[i] === '(') depth += 1;
+    else if (text[i] === ')') depth -= 1;
+    if (depth === 0) return text.slice(i + 1);
+  }
+  return null;
+}
+
+/** The value written on a field line itself, after the label, its hint, and the colon. */
+function inlineValue(line: string): string {
+  const m = line.match(FIELD_LINE);
+  if (!m) return line.split(':').slice(1).join(':').trim();
+  let rest = m[3];
+  if (m[2].trim().endsWith(':')) return rest.trim();
+  if (rest.trim().startsWith('(')) rest = skipParenthetical(rest.trim()) ?? rest;
+  const colon = rest.match(/^\s*:(.*)$/);
+  return (colon ? colon[1] : rest).trim();
+}
+
+/**
+ * A field line with no answer: nothing after the label (`- **Retention:**`), or a line ending
+ * in a colon (`- **Retention** (how long):`), and no indented answer below it.
+ */
+function isUnansweredField(lines: string[], index: number): boolean {
+  const m = lines[index].match(FIELD_LINE);
+  if (!m) return false;
+  const boldColonEmpty = m[2].trim().endsWith(':') && !m[3].trim();
+  if (!boldColonEmpty && !/:\s*$/.test(lines[index])) return false;
+  return nestedLines(lines, index).every((l) => isUnansweredField([l], 0));
+}
