+import { describe, expect, it } from 'vitest';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { validateSpec } from './validate.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const repoRoot = path.join(here, '../../../..');
+
+function read(relative: string): string {
+  return fs.readFileSync(path.join(repoRoot, relative), 'utf8');
+}
+
+const DRAFT = 'examples/support-triage-demo/rai-gate-draft.reference.md';
+
+/** A complete gate written in the drafter's `**Label:**` style; `tier` replaces the risk-tier fields. */
+function boldColonSpec(tier = '- **Tier:** limited\n- **Sign-off:** not required (tier below high)'): string {
+  return `## Responsible AI Gate
+
+### Risk tier
+
+${tier}
+- **Justification:** Chatbot answering policy questions; no automated decisions about people.
+
+### Data provenance & privacy
+
+- **Data sources:** internal policy docs; user questions at runtime
+- **PII involved?** no
+- **Retention:** prompts kept 30 days, then hard-deleted
+- **Used for training?** no; provider training disabled
+
+### Human oversight
+
+- **Automation level:** assistive
+- **Override path:** support team can correct answers via admin panel
+- **Kill switch:** feature flag chat_enabled, off within 5 minutes
+
+### Evaluation plan
+
+- **Pre-ship metrics & thresholds:** groundedness >= 0.85
+- **Eval dataset:** eval/policy-qa.jsonl, 300 questions
+- **Who runs it and when:** CI on every prompt change
+
+### Bias & fairness
+
+- **Groups at risk of disparate impact:** non-native English speakers
+- **Mitigations:** multilingual eval slice
+- **How tested:** disaggregated groundedness by question language
+
+### Monitoring & rollback
+
+- **Production monitoring:** thumbs-down rate, refusal rate
+- **Degradation definition:** thumbs-down > 10% over 24h
+- **Rollback trigger & procedure:** on-call flips chat_enabled off
+
+### Transparency & incident response
+
+- **User disclosure:** "AI assistant" label in the chat header
+- **Incident owner:** Dana Rivers
+- **Incident path:** in-chat report -> triage queue, response within 24h
+`;
+}
+
+describe('validateSpec - draft and label formats', () => {
+  it('accepts the `**Label:** value` style', () => {
+    const result = validateSpec(boldColonSpec());
+    expect(result.findings).toEqual([]);
+    expect(result.tier).toBe('limited');
+  });
+
+  it('treats an empty `**Label:**` field as unanswered', () => {
+    const result = validateSpec(
+      boldColonSpec().replace('- **Retention:** prompts kept 30 days, then hard-deleted', '- **Retention:**')
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings).toContainEqual(
+      expect.objectContaining({
+        checkId: 'data-privacy',
+        message: 'Unanswered field in "Data & privacy": - **Retention:**'
+      })
+    );
+  });
+
+  it('accepts answers indented below the field, with blank lines in between', () => {
+    const spec = boldColonSpec()
+      .replace(
+        '- **Retention:** prompts kept 30 days, then hard-deleted',
+        '- **Retention:**\n\n  - prompts kept 30 days\n  - then hard-deleted'
+      )
+      .replace(
+        '- **Pre-ship metrics & thresholds:** groundedness >= 0.85',
+        '- **Pre-ship metrics & thresholds** (suggested):\n\n  | Metric | Threshold |\n  |---|---|\n  | groundedness | >= 0.85 |'
+      )
+      .replace(
+        '- **Mitigations:** multilingual eval slice',
+        '- **Mitigations**:\n\n    A multilingual eval slice, run on every release.'
+      );
+    expect(validateSpec(spec).findings).toEqual([]);
+  });
+
+  it('does not count the next unindented field as an answer', () => {
+    const spec = boldColonSpec().replace(
+      '- **Retention:** prompts kept 30 days, then hard-deleted',
+      '- **Retention** (how long):\n\n- **Deletion:** nightly job'
+    );
+    expect(validateSpec(spec).findings).toContainEqual(
+      expect.objectContaining({ message: 'Unanswered field in "Data & privacy": - **Retention** (how long):' })
+    );
+  });
+
+  it('reads the tier from bold values and from indented lines', () => {
+    expect(validateSpec(boldColonSpec().replace('- **Tier:** limited', '- **Tier:** **limited**')).tier).toBe(
+      'limited'
+    );
+    const nested = validateSpec(
+      boldColonSpec('- **Tier** (prohibited / high / limited / minimal):\n  - minimal\n- **Sign-off:** not required (tier below high)')
+    );
+    expect(nested.tier).toBe('minimal');
+    expect(nested.findings).toEqual([]);
+  });
+
+  it('reads a high-tier sign-off from indented lines', () => {
+    const signed = validateSpec(
+      boldColonSpec('- **Tier:** high\n- **Sign-off:**\n  - Ana Pop (Head of Compliance), 2026-08-01')
+    );
+    expect(signed.tier).toBe('high');
+    expect(signed.findings).toEqual([]);
+
+    const unsigned = validateSpec(boldColonSpec('- **Tier:** high\n- **Sign-off:**'));
+    expect(unsigned.findings.some((f) => f.message.includes('named human sign-off'))).toBe(true);
+  });
+
+  it('blocks a check with an unresolved NEEDS HUMAN INPUT item', () => {
+    const spec = boldColonSpec().replace(
+      '- **Retention:** prompts kept 30 days, then hard-deleted',
+      '- **Retention:** prompts kept 30 days\n  - **NEEDS HUMAN INPUT:** confirm the provider retention setting'
+    );
+    const result = validateSpec(spec);
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings).toEqual([
+      expect.objectContaining({ checkId: 'data-privacy', severity: 'block' })
+    ]);
+    expect(result.findings[0].message).toContain('NEEDS HUMAN INPUT');
+  });
+
+  it('blocks the reference draft only on its unresolved NEEDS HUMAN INPUT items', () => {
+    const result = validateSpec(read(DRAFT));
+    expect(result.tier).toBe('limited');
+    expect(result.findings.map((f) => f.checkId)).toEqual([
+      'risk-tier',
+      'data-privacy',
+      'oversight',
+      'evaluation',
+      'bias',
+      'monitoring',
+      'transparency'
+    ]);
+    expect(result.findings.every((f) => f.message.includes('NEEDS HUMAN INPUT'))).toBe(true);
+  });
+
+  it('passes the reference draft once every NEEDS HUMAN INPUT item is resolved', () => {
+    const resolved = read(DRAFT).replace(
+      /\*\*NEEDS HUMAN INPUT:?[^\n]*/g,
+      'Answered by Dana Rivers (support lead).'
+    );
+    const result = validateSpec(resolved);
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('reports exactly the same findings on the untouched template', () => {
+    const result = validateSpec(read('packages/frai-gate/assets/rai-spec-template.md'));
+    expect(result.tier).toBeNull();
+    expect(result.findings.map((f) => [f.checkId, f.message])).toEqual([
+      ['risk-tier', '"Risk tier" is present but empty.'],
+      ['data-privacy', '"Data & privacy" is present but empty.'],
+      ['oversight', '"Human oversight" is present but empty.'],
+      ['evaluation', '"Evaluation plan" is present but empty.'],
+      ['bias', '"Bias & fairness" is present but empty.'],
+      ['monitoring', '"Monitoring & rollback" is present but empty.'],
+      ['transparency', 'Unanswered field in "Transparency & incidents": - **How users know AI is involved**:'],
+      ['transparency', 'Unanswered field in "Transparency & incidents": - **Incident owner** (a name, not "the team"):'],
+      ['transparency', 'Unanswered field in "Transparency & incidents": - **Report → fix path** (with a target response time):']
+    ]);
+  });
+
+  it.each(['examples/frai-spec-example.md', 'examples/support-triage-demo/FRAI-SPEC.md'])(
+    'still passes %s',
+    (spec) => {
+      expect(validateSpec(read(spec)).verdict).toBe('PASS');
+    }
+  );
+});
