+import { describe, expect, it } from 'vitest';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { validateSpec } from './validate.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const repoRoot = path.join(here, '../../../..');
+const read = (relative: string) => fs.readFileSync(path.join(repoRoot, relative), 'utf8');
+
+const SECTIONS = {
+  tier: `### Risk tier
+
+- **Tier:** limited
+- **Justification:** Chatbot answering policy questions; no automated decisions about people.
+- **Sign-off:** not required (tier below high)`,
+  data: `### Data & privacy
+
+- **Data sources:** internal policy docs; user questions at runtime
+- **PII involved?** no
+- **Retention:** prompts kept 30 days, then hard-deleted
+- **Used for training?** no`,
+  oversight: `### Human oversight
+
+- **Automation level:** assistive
+- **Override path:** support team via admin panel
+- **Kill switch:** feature flag chat_enabled, off within 5 minutes`,
+  evaluation: `### Evaluation plan
+
+- **Metrics:** groundedness >= 0.85
+- **Eval dataset:** eval/policy-qa.jsonl, 300 questions
+- **Who runs it:** CI on every prompt change`,
+  bias: `### Bias & fairness
+
+- **Groups:** non-native English speakers
+- **Mitigations:** multilingual eval slice
+- **How tested:** disaggregated groundedness by language`,
+  monitoring: `### Monitoring & rollback
+
+- **Signals:** thumbs-down rate
+- **Degradation:** thumbs-down > 10% over 24h
+- **Rollback:** on-call flips chat_enabled`,
+  transparency: `### Transparency & incident response
+
+- **Disclosure:** "AI assistant" label in chat header
+- **Incident owner:** Dana Rivers
+- **Path:** in-chat report -> triage -> fix within 24h`
+};
+
+function spec(overrides: Partial<typeof SECTIONS> = {}): string {
+  return `# Spec\n\n## FRAI Gate\n\n${Object.values({ ...SECTIONS, ...overrides }).join('\n\n')}\n`;
+}
+
+describe('validateSpec - label styles and nested answers', () => {
+  it('passes a gate written with the colon inside the bold label', () => {
+    const result = validateSpec(spec());
+    expect(result.findings).toEqual([]);
+    expect(result.tier).toBe('limited');
+  });
+
+  it('accepts a bold tier value', () => {
+    const result = validateSpec(
+      spec({ tier: SECTIONS.tier.replace('**Tier:** limited', '**Tier:** **limited**') })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.tier).toBe('limited');
+  });
+
+  it('flags an empty field in either label style', () => {
+    const result = validateSpec(
+      spec({
+        data: `### Data & privacy
+
+- **Data sources:**
+- **Retention**:
+- **Used for training?** no`
+      })
+    );
+    const unanswered = result.findings.filter((f) => f.message.startsWith('Unanswered field'));
+    expect(unanswered.map((f) => f.message)).toEqual([
+      'Unanswered field in "Data & privacy": - **Data sources:**',
+      'Unanswered field in "Data & privacy": - **Retention**:'
+    ]);
+    expect(result.verdict).toBe('BLOCK');
+  });
+
+  it('accepts answers indented below the field: nested bullets, tables, paragraphs, blank lines', () => {
+    const result = validateSpec(
+      spec({
+        evaluation: `### Evaluation plan
+
+- **Metrics** (thresholds):
+
+  | Metric | Threshold |
+  |---|---|
+  | recall | >= 0.95 |
+
+- **Eval dataset:**
+  - path: eval/policy-qa.jsonl
+  - size: 300 questions
+- **Who runs it**:
+
+  CI runs it on every prompt change.`
+      })
+    );
+    expect(result.findings).toEqual([]);
+  });
+
+  it('still flags a field whose next line is a sibling, not nested', () => {
+    const result = validateSpec(
+      spec({
+        bias: `### Bias & fairness
+
+- **Groups:**
+
+- **Mitigations:** multilingual eval slice
+- **How tested:** disaggregated groundedness by language`
+      })
+    );
+    expect(result.findings.map((f) => f.message)).toEqual([
+      'Unanswered field in "Bias & fairness": - **Groups:**'
+    ]);
+  });
+
+  it('reads tier and sign-off values from indented lines', () => {
+    const result = validateSpec(
+      spec({
+        tier: `### Risk tier
+
+- **Tier:**
+
+  high
+- **Justification:** Screens job applications automatically.
+- **Sign-off:**
+  - Ana Pop (Head of Compliance), 2026-08-01`
+      })
+    );
+    expect(result.tier).toBe('high');
+    expect(result.findings).toEqual([]);
+  });
+
+  it('prefers the first nested line naming a tier when the explanation mentions others', () => {
+    const result = validateSpec(
+      spec({
+        tier: `### Risk tier
+
+- **Tier:**
+  - limited
+  - not high: no decisions about people; not minimal: users talk to the model
+- **Sign-off:** not required (tier below high)`
+      })
+    );
+    expect(result.tier).toBe('limited');
+  });
+
+  it('blocks high tier when the sign-off field is empty or says not required, in either style', () => {
+    for (const signoff of ['- **Sign-off:**', '- **Sign-off:** not required (tier below high)']) {
+      const result = validateSpec(
+        spec({
+          tier: `### Risk tier
+
+- **Tier:** high
+- **Justification:** Screens job applications; a human must sign off.
+${signoff}`
+        })
+      );
+      expect(result.findings.some((f) => f.message.includes('named human sign-off'))).toBe(true);
+    }
+  });
+
+  it('reads a sign-off after the template hint, even when the hint contains colons and parens', () => {
+    const result = validateSpec(
+      spec({
+        tier: `### Risk tier
+
+- **Tier** (prohibited / high / limited / minimal): high
+- **Why this tier**: screens job applications
+- **Sign-off** (high tier: name + date; otherwise "not required (tier below high)"): Ana Pop, 2026-08-01`
+      })
+    );
+    expect(result.tier).toBe('high');
+    expect(result.findings).toEqual([]);
+  });
+});
+
+describe('validateSpec - NEEDS HUMAN INPUT', () => {
+  it('blocks the check containing an unresolved marker, wherever it sits', () => {
+    const result = validateSpec(
+      spec({
+        data: `### Data & privacy
+
+- **Data sources:** runtime user questions
+- **PII involved?** no
+- **Retention:** prompts kept 30 days
+  - **NEEDS HUMAN INPUT:** confirm the provider retention setting.
+- **Used for training?** no`,
+        transparency: `${SECTIONS.transparency}
+
+NEEDS HUMAN INPUT: who owns the disclosure copy?`
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings.map((f) => [f.checkId, f.severity])).toEqual([
+      ['data-privacy', 'block'],
+      ['transparency', 'block']
+    ]);
+    expect(result.findings[0].message).toContain('NEEDS HUMAN INPUT');
+  });
+});
+
+describe('validateSpec - real files', () => {
+  const draft = read('examples/support-triage-demo/rai-gate-draft.reference.md');
+
+  it('reports only the unresolved NEEDS HUMAN INPUT items on the reference draft', () => {
+    const result = validateSpec(draft);
+    expect(result.tier).toBe('limited');
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings.length).toBe((draft.match(/NEEDS HUMAN INPUT/g) ?? []).length);
+    expect(result.findings.every((f) => f.message.startsWith('Unresolved NEEDS HUMAN INPUT'))).toBe(
+      true
+    );
+  });
+
+  it('passes the reference draft once every NEEDS HUMAN INPUT item is resolved', () => {
+    const resolved = draft.replace(/NEEDS HUMAN INPUT/g, 'Resolved');
+    const result = validateSpec(resolved);
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+    expect(result.tier).toBe('limited');
+  });
+
+  it('reports exactly the same findings on the untouched template', () => {
+    const result = validateSpec(read('packages/frai-gate/assets/rai-spec-template.md'));
+    expect(result.tier).toBeNull();
+    expect(result.findings.map((f) => `${f.checkId}: ${f.message}`)).toEqual([
+      'risk-tier: "Risk tier" is present but empty.',
+      'data-privacy: "Data & privacy" is present but empty.',
+      'oversight: "Human oversight" is present but empty.',
+      'evaluation: "Evaluation plan" is present but empty.',
+      'bias: "Bias & fairness" is present but empty.',
+      'monitoring: "Monitoring & rollback" is present but empty.',
+      'transparency: Unanswered field in "Transparency & incidents": - **How users know AI is involved**:',
+      'transparency: Unanswered field in "Transparency & incidents": - **Incident owner** (a name, not "the team"):',
+      'transparency: Unanswered field in "Transparency & incidents": - **Report → fix path** (with a target response time):'
+    ]);
+  });
+
+  it.each(['examples/frai-spec-example.md', 'examples/support-triage-demo/FRAI-SPEC.md'])(
+    'still passes %s',
+    (file) => {
+      const result = validateSpec(read(file));
+      expect(result.findings).toEqual([]);
+      expect(result.verdict).toBe('PASS');
+    }
+  );
+});
