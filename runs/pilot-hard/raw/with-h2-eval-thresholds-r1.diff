diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..a50774e
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,86 @@
+export class ThresholdError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ThresholdError';
+    this.code = 'FRAI_INVALID_THRESHOLD';
+  }
+}
+
+const NUMBER_PATTERN = /^[+-]?(?:\d+(?:\.\d*)?|\.\d+)$/;
+
+const isPlainObject = (value) =>
+  value !== null && typeof value === 'object' && !Array.isArray(value);
+
+const assertMinimum = (metric, min) => {
+  if (typeof min !== 'number' || !Number.isFinite(min) || min < 0 || min > 1) {
+    throw new ThresholdError(
+      `Invalid threshold for "${metric}": minimum must be a number between 0 and 1 (received ${String(min)}).`
+    );
+  }
+};
+
+// Parses CLI-style specs such as "exact_match=0.9" into a thresholds object.
+// A metric given more than once keeps its last minimum.
+export function parseThresholds(specs) {
+  const list = Array.isArray(specs) ? specs : [specs];
+  const thresholds = {};
+  list.forEach((spec) => {
+    const text = String(spec ?? '');
+    const separator = text.indexOf('=');
+    const metric = separator === -1 ? '' : text.slice(0, separator).trim();
+    const rawMin = separator === -1 ? '' : text.slice(separator + 1).trim();
+    if (!metric || !NUMBER_PATTERN.test(rawMin)) {
+      throw new ThresholdError(`Invalid threshold "${text}": expected <metric>=<number>, e.g. exact_match=0.9.`);
+    }
+    const min = Number(rawMin);
+    if (min < 0 || min > 1) {
+      throw new ThresholdError(`Invalid threshold "${text}": minimum must be between 0 and 1.`);
+    }
+    thresholds[metric] = min;
+  });
+  return thresholds;
+}
+
+// Checks each threshold against the matching evaluation by metric id.
+// A metric without a numeric score fails its threshold.
+export function evaluateThresholds(evaluations, thresholds) {
+  if (!isPlainObject(thresholds)) {
+    throw new ThresholdError('thresholds must be an object mapping metric ids to minimum scores.');
+  }
+
+  const metricIds = [];
+  const byId = new Map();
+  (Array.isArray(evaluations) ? evaluations : []).forEach((metric) => {
+    if (metric && typeof metric.id === 'string' && !byId.has(metric.id)) {
+      byId.set(metric.id, metric);
+      metricIds.push(metric.id);
+    }
+  });
+
+  const results = Object.entries(thresholds).map(([metric, min]) => {
+    if (!byId.has(metric)) {
+      const valid = metricIds.length ? metricIds.join(', ') : '(none)';
+      throw new ThresholdError(`Unknown metric id "${metric}" in thresholds. Valid metric ids: ${valid}.`);
+    }
+    assertMinimum(metric, min);
+    const { score } = byId.get(metric);
+    const numericScore = typeof score === 'number' && Number.isFinite(score) ? score : null;
+    return {
+      metric,
+      min,
+      score: numericScore,
+      passed: numericScore !== null && numericScore >= min
+    };
+  });
+
+  return {
+    passed: results.every((result) => result.passed),
+    thresholds: results
+  };
+}
+
+export default {
+  ThresholdError,
+  parseThresholds,
+  evaluateThresholds
+};
