diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..bd94bf9
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,85 @@
+export class ThresholdError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ThresholdError';
+    this.code = 'FRAI_EVAL_THRESHOLD';
+  }
+}
+
+const NUMBER_PATTERN = /^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$/;
+
+const isInRange = (value) => typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= 1;
+
+const isPlainObject = (value) =>
+  value !== null && typeof value === 'object' && !Array.isArray(value);
+
+/**
+ * Parse CLI-style threshold specs (`<metric>=<min>`) into a thresholds object.
+ * Later specs for the same metric override earlier ones.
+ * @param {string[]} specs
+ * @returns {Record<string, number>}
+ */
+export function parseThresholds(specs = []) {
+  const thresholds = {};
+  for (const spec of specs) {
+    const raw = String(spec);
+    const separator = raw.indexOf('=');
+    const metric = separator === -1 ? '' : raw.slice(0, separator).trim();
+    const value = separator === -1 ? '' : raw.slice(separator + 1).trim();
+    if (!metric || !NUMBER_PATTERN.test(value)) {
+      throw new ThresholdError(
+        `Invalid threshold "${raw}": expected <metric>=<number>, for example exact_match=0.9.`
+      );
+    }
+    const min = Number(value);
+    if (!isInRange(min)) {
+      throw new ThresholdError(`Invalid threshold "${raw}": minimum must be between 0 and 1.`);
+    }
+    thresholds[metric] = min;
+  }
+  return thresholds;
+}
+
+/**
+ * Check evaluations against minimum scores. A metric without a numeric score fails.
+ * Throws ThresholdError for invalid minimums or metric ids not present in the evaluations.
+ */
+export function evaluateThresholds(evaluations, thresholds) {
+  if (!isPlainObject(thresholds)) {
+    throw new ThresholdError('thresholds must be an object mapping metric ids to minimum scores.');
+  }
+
+  const validIds = [...new Set(evaluations.map((metric) => metric?.id).filter((id) => typeof id === 'string'))];
+
+  const results = Object.entries(thresholds).map(([metricId, min]) => {
+    if (!isInRange(min)) {
+      throw new ThresholdError(
+        `Invalid threshold for "${metricId}": minimum must be a number between 0 and 1 (received ${JSON.stringify(min)}).`
+      );
+    }
+    const metric = evaluations.find((candidate) => candidate?.id === metricId);
+    if (!metric) {
+      throw new ThresholdError(
+        `Unknown metric "${metricId}" in thresholds. Valid metric ids: ${validIds.length ? validIds.join(', ') : '(none)'}.`
+      );
+    }
+    const score = typeof metric.score === 'number' && Number.isFinite(metric.score) ? metric.score : null;
+    return {
+      metric: metricId,
+      min,
+      score,
+      passed: score !== null && score >= min
+    };
+  });
+
+  return {
+    passed: results.every((result) => result.passed),
+    thresholds: results
+  };
+}
+
+export default {
+  ThresholdError,
+  parseThresholds,
+  evaluateThresholds
+};
