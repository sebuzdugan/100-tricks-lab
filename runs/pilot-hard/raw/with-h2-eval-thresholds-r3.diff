@@ -0,0 +1,90 @@
+import { spawnSync } from 'child_process';
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { afterEach, describe, expect, it } from 'vitest';
+
+// Exercises the built CLI; run `pnpm --filter frai run build` after changing src/.
+const CLI = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../dist/index.js');
+
+const tmpDirs = [];
+afterEach(() => {
+  while (tmpDirs.length) {
+    fs.rmSync(tmpDirs.pop(), { recursive: true, force: true });
+  }
+});
+
+const setup = () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-cli-eval-'));
+  tmpDirs.push(dir);
+  fs.writeFileSync(path.join(dir, 'outputs.json'), JSON.stringify(['a', 'b']));
+  fs.writeFileSync(path.join(dir, 'refs.json'), JSON.stringify(['a', 'c']));
+  return dir;
+};
+
+const runEval = (dir, args) =>
+  spawnSync(process.execPath, [CLI, 'eval', '--outputs', 'outputs.json', ...args], {
+    cwd: dir,
+    encoding: 'utf8'
+  });
+
+const readJson = (file) => JSON.parse(fs.readFileSync(file, 'utf8'));
+
+describe('frai eval --threshold', () => {
+  it('keeps the report and exit code unchanged without thresholds', () => {
+    const dir = setup();
+    const result = runEval(dir, ['--references', 'refs.json', '--report', 'report.json']);
+    expect(result.status).toBe(0);
+    expect(Object.keys(readJson(path.join(dir, 'report.json')))).toEqual(['metadata', 'metrics']);
+  });
+
+  it('exits 0 and records the outcome when all thresholds pass', () => {
+    const dir = setup();
+    const result = runEval(dir, [
+      '--references', 'refs.json', '--report', 'report.json',
+      '--threshold', 'exact_match=0.5', '--threshold', 'length_variance=0.9'
+    ]);
+    expect(result.status).toBe(0);
+    const report = readJson(path.join(dir, 'report.json'));
+    expect(report.passed).toBe(true);
+    expect(report.thresholds).toEqual([
+      { metric: 'exact_match', min: 0.5, score: 0.5, passed: true },
+      { metric: 'length_variance', min: 0.9, score: 1, passed: true }
+    ]);
+  });
+
+  it('exits 1 and still writes the report when a threshold fails', () => {
+    const dir = setup();
+    const result = runEval(dir, [
+      '--references', 'refs.json', '--report', 'report.md', '--format', 'markdown',
+      '--threshold', 'exact_match=0.9'
+    ]);
+    expect(result.status).toBe(1);
+    const markdown = fs.readFileSync(path.join(dir, 'report.md'), 'utf8');
+    expect(markdown).toContain('## Thresholds');
+    expect(markdown).toContain('- **exact_match:** FAIL (score 0.5, min 0.9)');
+  });
+
+  it('exits 1 when the metric has no score', () => {
+    const dir = setup();
+    const result = runEval(dir, ['--report', 'report.json', '--threshold', 'exact_match=0']);
+    expect(result.status).toBe(1);
+    const report = readJson(path.join(dir, 'report.json'));
+    expect(report.passed).toBe(false);
+    expect(report.thresholds).toEqual([{ metric: 'exact_match', min: 0, score: null, passed: false }]);
+  });
+
+  it.each([
+    [['--threshold', 'exact_match'], 'expected <metric>=<number>'],
+    [['--threshold', 'exact_match=abc'], 'expected <metric>=<number>'],
+    [['--threshold', 'exact_match=1.5'], 'minimum must be between 0 and 1'],
+    [['--threshold', 'bleu=0.5'], 'Valid metric ids: exact_match, toxicity, length_variance']
+  ])('exits 2 without writing a report for %j', (args, message) => {
+    const dir = setup();
+    const result = runEval(dir, ['--references', 'refs.json', '--report', 'report.json', ...args]);
+    expect(result.status).toBe(2);
+    expect(result.stderr).toContain(message);
+    expect(fs.existsSync(path.join(dir, 'report.json'))).toBe(false);
+  });
+});
