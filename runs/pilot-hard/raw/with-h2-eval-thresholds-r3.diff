diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..9aaa24c
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,84 @@
+const NUMBER_PATTERN = /^[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?$/;
+
+const hasOwn = (object, key) => Object.prototype.hasOwnProperty.call(object, key);
+
+const metricIdsOf = (evaluations) => {
+  const ids = [];
+  (Array.isArray(evaluations) ? evaluations : []).forEach((metric) => {
+    if (metric && typeof metric.id === 'string' && !ids.includes(metric.id)) {
+      ids.push(metric.id);
+    }
+  });
+  return ids;
+};
+
+export function parseThresholds(specs = []) {
+  const list = Array.isArray(specs) ? specs : [specs];
+  const thresholds = {};
+
+  list.forEach((spec) => {
+    const text = String(spec ?? '');
+    const separator = text.indexOf('=');
+    const metric = separator === -1 ? '' : text.slice(0, separator).trim();
+    const rawMin = separator === -1 ? '' : text.slice(separator + 1).trim();
+
+    if (!metric || !NUMBER_PATTERN.test(rawMin)) {
+      throw new Error(`Invalid threshold "${text}": expected <metric>=<number>, for example exact_match=0.9.`);
+    }
+    if (hasOwn(thresholds, metric)) {
+      throw new Error(`Invalid threshold "${text}": a threshold for "${metric}" was already given.`);
+    }
+
+    const min = Number(rawMin);
+    if (min < 0 || min > 1) {
+      throw new Error(`Invalid threshold "${text}": minimum must be between 0 and 1.`);
+    }
+    thresholds[metric] = min;
+  });
+
+  return thresholds;
+}
+
+export function validateThresholds({ evaluations, thresholds }) {
+  if (thresholds == null || typeof thresholds !== 'object' || Array.isArray(thresholds)) {
+    throw new Error('thresholds must be an object mapping metric ids to minimum scores.');
+  }
+
+  const validIds = metricIdsOf(evaluations);
+  Object.entries(thresholds).forEach(([metric, min]) => {
+    if (!validIds.includes(metric)) {
+      const available = validIds.length ? validIds.join(', ') : '(none)';
+      throw new Error(`Unknown metric "${metric}" in thresholds. Valid metric ids: ${available}.`);
+    }
+    if (typeof min !== 'number' || !Number.isFinite(min) || min < 0 || min > 1) {
+      throw new Error(`Threshold minimum for "${metric}" must be a number between 0 and 1 (got ${String(min)}).`);
+    }
+  });
+}
+
+export function evaluateThresholds({ evaluations, thresholds }) {
+  validateThresholds({ evaluations, thresholds });
+
+  const results = Object.entries(thresholds).map(([metric, min]) => {
+    const evaluation = evaluations.find((entry) => entry && entry.id === metric);
+    const score =
+      typeof evaluation.score === 'number' && Number.isFinite(evaluation.score) ? evaluation.score : null;
+    return {
+      metric,
+      min,
+      score,
+      passed: score !== null && score >= min
+    };
+  });
+
+  return {
+    passed: results.every((result) => result.passed),
+    thresholds: results
+  };
+}
+
+export default {
+  parseThresholds,
+  validateThresholds,
+  evaluateThresholds
+};
