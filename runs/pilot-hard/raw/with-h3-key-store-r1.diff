--- a/packages/frai-core/src/config/key-store.test.js
+++ b/packages/frai-core/src/config/key-store.test.js
@@ -54,4 +54,111 @@ describe('config key store', () => {
     const content = fs.readFileSync(configPath, 'utf8');
     expect(JSON.parse(content).OPENAI_API_KEY).toBe('global-key');
   });
+
+  describe('local .env handling', () => {
+    const writeEnv = (content) => fs.writeFileSync(resolveLocalEnvPath(tmpCwd), content);
+    const readEnv = () => fs.readFileSync(resolveLocalEnvPath(tmpCwd), 'utf8');
+
+    it.each([
+      ['OPENAI_API_KEY=sk-plain', 'sk-plain'],
+      ['export OPENAI_API_KEY="sk-1" # rotated', 'sk-1'],
+      ["OPENAI_API_KEY='sk-2'#note", 'sk-2'],
+      ['  OPENAI_API_KEY = sk-3   # comment', 'sk-3'],
+      ['OPENAI_API_KEY="sk-\\"q\\""', 'sk-"q"'],
+      ['OPENAI_API_KEY=sk-crlf\r\nFOO=bar\r\n', 'sk-crlf'],
+      ['OPENAI_API_KEY=sk-first\nOPENAI_API_KEY=sk-last', 'sk-last'],
+      ['OPENAI_API_KEY=sk-active\n# OPENAI_API_KEY=sk-commented', 'sk-active']
+    ])('reads %j', (content, expected) => {
+      writeEnv(content);
+      expect(getLocalApiKey(tmpCwd)).toBe(expected);
+      expect(hasLocalApiKey(tmpCwd)).toBe(true);
+    });
+
+    it.each([
+      'FOO=bar\n',
+      'OPENAI_API_KEY=\n',
+      'OPENAI_API_KEY=""  # empty',
+      'OPENAI_API_KEY=   # nothing',
+      '# OPENAI_API_KEY=sk-commented\n',
+      'OPENAI_API_KEY=sk-old\nOPENAI_API_KEY=\n'
+    ])('treats %j as not configured', (content) => {
+      writeEnv(content);
+      expect(getLocalApiKey(tmpCwd)).toBeNull();
+      expect(hasLocalApiKey(tmpCwd)).toBe(false);
+    });
+
+    it('updates the last definition in place and leaves every other byte alone', () => {
+      writeEnv('# header\nOPENAI_API_KEY=sk-first\n\nFOO="a b" # c\nexport OPENAI_API_KEY="sk-old" # rotated\nBAR=1');
+      setLocalApiKey('sk-new', tmpCwd);
+      expect(readEnv()).toBe(
+        '# header\nOPENAI_API_KEY=sk-first\n\nFOO="a b" # c\nexport OPENAI_API_KEY="sk-new" # rotated\nBAR=1'
+      );
+      expect(getLocalApiKey(tmpCwd)).toBe('sk-new');
+    });
+
+    it('preserves CRLF line endings and unquoted style when updating', () => {
+      writeEnv('A=1\r\nOPENAI_API_KEY=sk-old\r\nB=2\r\n');
+      setLocalApiKey('sk-new', tmpCwd);
+      expect(readEnv()).toBe('A=1\r\nOPENAI_API_KEY=sk-new\r\nB=2\r\n');
+    });
+
+    it('appends the key when no definition exists', () => {
+      writeEnv('# OPENAI_API_KEY=commented\nFOO=bar');
+      setLocalApiKey('sk-new', tmpCwd);
+      expect(readEnv()).toBe('# OPENAI_API_KEY=commented\nFOO=bar\nOPENAI_API_KEY=sk-new\n');
+
+      writeEnv('FOO=bar\n');
+      setLocalApiKey('sk-new', tmpCwd);
+      expect(readEnv()).toBe('FOO=bar\nOPENAI_API_KEY=sk-new\n');
+    });
+
+    it('quotes keys that would not survive unquoted', () => {
+      setLocalApiKey('sk with #hash', tmpCwd);
+      expect(getLocalApiKey(tmpCwd)).toBe('sk with #hash');
+      expect(() => setLocalApiKey('sk\nFOO=bar', tmpCwd)).toThrow();
+    });
+
+    it('creates a new .env with 0600 permissions', () => {
+      setLocalApiKey('sk-new', tmpCwd);
+      expect(fs.statSync(resolveLocalEnvPath(tmpCwd)).mode & 0o777).toBe(0o600);
+    });
+  });
+
+  describe('global config handling', () => {
+    const configPath = () => resolveGlobalConfigPath(tmpHome);
+    const writeConfig = (content) => {
+      fs.mkdirSync(path.dirname(configPath()), { recursive: true });
+      fs.writeFileSync(configPath(), content);
+    };
+
+    it('keeps other fields when storing the key', () => {
+      writeConfig(JSON.stringify({ theme: 'dark', OPENAI_API_KEY: 'old', nested: { a: 1 } }));
+      setGlobalApiKey('sk-new', tmpHome);
+      expect(JSON.parse(fs.readFileSync(configPath(), 'utf8'))).toEqual({
+        theme: 'dark',
+        OPENAI_API_KEY: 'sk-new',
+        nested: { a: 1 }
+      });
+    });
+
+    it.each(['not json', '[1,2]', ''])('refuses to overwrite invalid config %j', (content) => {
+      writeConfig(content);
+      expect(() => setGlobalApiKey('sk-new', tmpHome)).toThrow();
+      expect(fs.readFileSync(configPath(), 'utf8')).toBe(content);
+    });
+
+    it.each([{ theme: 'dark' }, { OPENAI_API_KEY: '' }, { OPENAI_API_KEY: '  ' }, { OPENAI_API_KEY: 42 }])(
+      'treats %j as not configured',
+      (config) => {
+        writeConfig(JSON.stringify(config));
+        expect(getGlobalApiKey(tmpHome)).toBeNull();
+        expect(hasGlobalApiKey(tmpHome)).toBe(false);
+      }
+    );
+
+    it('creates the config with 0600 permissions', () => {
+      setGlobalApiKey('sk-new', tmpHome);
+      expect(fs.statSync(configPath()).mode & 0o777).toBe(0o600);
+    });
+  });
 });
