@@ -0,0 +1,94 @@
+import { spawnSync } from 'child_process';
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+
+const CLI_PATH = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../dist/index.js');
+
+describe('frai setup', () => {
+  let tmpCwd;
+  let tmpHome;
+
+  const envPath = () => path.join(tmpCwd, '.env');
+  const configPath = () => path.join(tmpHome, '.config', 'frai', 'config');
+
+  const runCli = (...args) => {
+    const env = { ...process.env, HOME: tmpHome, USERPROFILE: tmpHome };
+    delete env.OPENAI_API_KEY;
+    return spawnSync(process.execPath, [CLI_PATH, ...args], {
+      cwd: tmpCwd,
+      env,
+      input: '',
+      encoding: 'utf8',
+      timeout: 15000
+    });
+  };
+
+  beforeEach(() => {
+    tmpCwd = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-cli-cwd-'));
+    tmpHome = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-cli-home-'));
+  });
+
+  afterEach(() => {
+    fs.rmSync(tmpCwd, { recursive: true, force: true });
+    fs.rmSync(tmpHome, { recursive: true, force: true });
+  });
+
+  it.each([
+    ['setup subcommand', ['setup', '--key', 'sk-new']],
+    ['legacy root flags', ['--setup', '--key', 'sk-new']]
+  ])('stores a local key non-interactively via %s', (_label, args) => {
+    fs.writeFileSync(envPath(), '# settings\nDATABASE_URL=postgres://db\n\nexport OPENAI_API_KEY="sk-old" # rotated\nDEBUG=1');
+
+    const result = runCli(...args);
+
+    expect(result.status).toBe(0);
+    expect(result.stdout).toContain('Stored OpenAI API key in local configuration.');
+    expect(fs.readFileSync(envPath(), 'utf8')).toBe(
+      '# settings\nDATABASE_URL=postgres://db\n\nexport OPENAI_API_KEY="sk-new" # rotated\nDEBUG=1'
+    );
+    expect(fs.existsSync(configPath())).toBe(false);
+  });
+
+  it.each([
+    ['setup subcommand', ['setup', '--key', 'sk-global', '--global']],
+    ['legacy root flags', ['--setup', '--key', 'sk-global', '--global']]
+  ])('stores a global key non-interactively via %s', (_label, args) => {
+    fs.mkdirSync(path.dirname(configPath()), { recursive: true });
+    fs.writeFileSync(configPath(), JSON.stringify({ model: 'gpt-4o', telemetry: false }));
+
+    const result = runCli(...args);
+
+    expect(result.status).toBe(0);
+    expect(result.stdout).toContain('Stored OpenAI API key in global configuration.');
+    expect(JSON.parse(fs.readFileSync(configPath(), 'utf8'))).toEqual({
+      model: 'gpt-4o',
+      telemetry: false,
+      OPENAI_API_KEY: 'sk-global'
+    });
+    expect(fs.existsSync(envPath())).toBe(false);
+  });
+
+  it('fails without touching an invalid global config', () => {
+    fs.mkdirSync(path.dirname(configPath()), { recursive: true });
+    fs.writeFileSync(configPath(), '{ broken');
+
+    const result = runCli('setup', '--key', 'sk-global', '--global');
+
+    expect(result.status).not.toBe(0);
+    expect(result.stderr).toContain('not valid JSON');
+    expect(fs.readFileSync(configPath(), 'utf8')).toBe('{ broken');
+  });
+
+  it('does not report a key when .env has none', () => {
+    fs.writeFileSync(envPath(), 'OTHER=1\n# OPENAI_API_KEY=sk-commented\n');
+
+    const result = runCli('config');
+
+    expect(result.status).toBe(0);
+    expect(result.stdout).toContain('"local":{"configured":false');
+    expect(result.stderr).toContain('No OpenAI API key configured.');
+  });
+});
