diff --git a/packages/frai-core/src/scanners/detectors.test.js b/packages/frai-core/src/scanners/detectors.test.js
new file mode 100644
index 0000000..05e24e5
--- /dev/null
+++ b/packages/frai-core/src/scanners/detectors.test.js
@@ -0,0 +1,173 @@
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+
+import { createLibraryDetector } from './detectors.js';
+import { scanCodebase } from './index.js';
+
+const detectLibraries = (fileName, content, libraries) => {
+  const detector = createLibraryDetector(libraries);
+  const result = { aiLibraryMatches: {}, aiFiles: [], markAiFile: (file) => result.aiFiles.push(file) };
+  detector.analyze({ filePath: fileName, content, result });
+  return result.aiLibraryMatches[fileName] ?? [];
+};
+
+describe('createLibraryDetector – JavaScript/TypeScript', () => {
+  it.each([
+    ["import OpenAI from 'openai';", ['openai']],
+    ['import * as ai from "openai"', ['openai']],
+    ["import type { Message } from '@anthropic-ai/sdk';", ['@anthropic-ai/sdk']],
+    ["import {\n  ChatOpenAI,\n  OpenAIEmbeddings\n} from '@langchain/openai';", ['@langchain']],
+    ["import type {\n  BaseMessage\n} from '@langchain/core/messages'", ['@langchain']],
+    ["import 'openai/shims/node';", ['openai']],
+    ["export { ChatAnthropic } from '@langchain/anthropic';", ['@langchain']],
+    ["export * from 'langchain/chains';", ['langchain']],
+    ["export type { Tool } from 'langchain/tools'", ['langchain']],
+    ["const OpenAI = require('openai');", ['openai']],
+    ['const { Anthropic } = require ( "@anthropic-ai/sdk" )', ['@anthropic-ai/sdk']],
+    ["const mod = await import('openai/resources');", ['openai']],
+    ['const tf = require(`@tensorflow/tfjs`);', ['@tensorflow']]
+  ])('detects %j', (source, expected) => {
+    expect(detectLibraries('src/client.ts', source)).toEqual(expected);
+  });
+
+  it.each([
+    "import mock from 'openai-mock';",
+    "import { client } from './openai';",
+    "import client from '../openai.js';",
+    "// import OpenAI from 'openai';",
+    "/* const OpenAI = require('openai'); */",
+    "/**\n * import { ChatOpenAI } from '@langchain/openai';\n */",
+    "const docs = \"import OpenAI from 'openai'\";",
+    "const docs = `const OpenAI = require('openai')`;",
+    "import sdk from '@anthropic-ai/sdk-extras';",
+    "import agent from '@anthropic-ai/claude-agent-sdk';",
+    "import chain from 'langchainjs';",
+    "const openai = myrequire('openai');",
+    'const re = /["\']/; // import x from \'openai\''
+  ])('ignores %j', (source) => {
+    expect(detectLibraries('src/client.ts', source)).toEqual([]);
+  });
+
+  it('still sees code after strings, regexes and template interpolations', () => {
+    const source = [
+      "const url = 'https://example.com/*';",
+      'const re = /\\/\\*/g;',
+      'const msg = `value: ${fn({ a: 1 })} // not a comment`;',
+      "import Anthropic from '@anthropic-ai/sdk';"
+    ].join('\n');
+    expect(detectLibraries('src/client.mts', source)).toEqual(['@anthropic-ai/sdk']);
+  });
+
+  it('reports each library once per file, in library-list order', () => {
+    const source = [
+      "import { ChatOpenAI } from '@langchain/openai';",
+      "import { ChatAnthropic } from '@langchain/anthropic';",
+      "import OpenAI from 'openai';",
+      "const again = require('openai');"
+    ].join('\n');
+    expect(detectLibraries('src/app.cts', source)).toEqual(['openai', '@langchain']);
+  });
+
+  it('keeps working with custom library lists', () => {
+    const source = "import { track } from 'my-ml-kit/metrics';\nimport OpenAI from 'openai';";
+    expect(detectLibraries('src/app.js', source, ['my-ml-kit'])).toEqual(['my-ml-kit']);
+    expect(detectLibraries('src/app.js', source, ['my-ml'])).toEqual([]);
+  });
+});
+
+describe('createLibraryDetector – Python', () => {
+  it.each([
+    ['import openai', ['openai']],
+    ['import os, anthropic as claude', ['anthropic']],
+    ['import torch.nn as nn', ['torch']],
+    ['from openai import OpenAI', ['openai']],
+    ['from langchain.chat_models import ChatOpenAI', ['langchain']],
+    ['from torch.nn import functional as F', ['torch']],
+    ['def build():\n    import anthropic\n    return anthropic.Anthropic()', ['anthropic']],
+    ['try:\n    import openai\nexcept ImportError:\n    openai = None', ['openai']],
+    ['import sys; import openai', ['openai']],
+    ['from sklearn.model_selection import (\n    train_test_split,\n)', ['sklearn']]
+  ])('detects %j', (source, expected) => {
+    expect(detectLibraries('app/model.py', source)).toEqual(expected);
+  });
+
+  it.each([
+    'import caretaker',
+    'import openai_mock',
+    'from openaiutils import client',
+    'from . import openai',
+    'from .openai import client',
+    '# import openai',
+    'x = 1  # from anthropic import Anthropic',
+    '"""\nUsage:\n    import openai\n"""',
+    "raise RuntimeError('boom') from openai",
+    "print('import openai')"
+  ])('ignores %j', (source) => {
+    expect(detectLibraries('app/model.py', source)).toEqual([]);
+  });
+
+  it('reads code cells from notebooks', () => {
+    const notebook = JSON.stringify({
+      cells: [
+        { cell_type: 'markdown', source: ['import torch\n'] },
+        { cell_type: 'code', source: ['from anthropic import Anthropic\n', 'client = Anthropic()\n'] }
+      ]
+    });
+    expect(detectLibraries('analysis.ipynb', notebook)).toEqual(['anthropic']);
+  });
+});
+
+describe('createLibraryDetector – R', () => {
+  it('matches library() calls exactly', () => {
+    expect(detectLibraries('model.R', 'library(caret)\nrequire("randomForest")')).toEqual([
+      'caret',
+      'randomForest'
+    ]);
+    expect(detectLibraries('model.R', 'library(caretEnsemble)\n# library(nnet)')).toEqual([]);
+  });
+});
+
+describe('scanCodebase – LLM applications', () => {
+  let tmpDir;
+
+  beforeEach(() => {
+    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-llm-scan-'));
+  });
+
+  afterEach(() => {
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+  });
+
+  it('scans module-flavoured extensions and reports LLM SDKs', () => {
+    const files = {
+      'src/anthropic.mts': "import Anthropic from '@anthropic-ai/sdk';\n",
+      'src/chain.cts': "import { ChatOpenAI } from '@langchain/openai';\n",
+      'src/legacy.cjs': "const OpenAI = require('openai');\n",
+      'src/client.mjs': "const { default: OpenAI } = await import('openai');\n",
+      'src/plain.mjs': "import express from 'express';\n"
+    };
+    for (const [name, content] of Object.entries(files)) {
+      const filePath = path.join(tmpDir, name);
+      fs.mkdirSync(path.dirname(filePath), { recursive: true });
+      fs.writeFileSync(filePath, content);
+    }
+
+    const results = scanCodebase({ root: tmpDir });
+    const rel = (file) => path.join(tmpDir, file);
+
+    expect(results.totalFiles).toBe(5);
+    expect(results.aiLibraryMatches).toEqual({
+      [rel('src/anthropic.mts')]: ['@anthropic-ai/sdk'],
+      [rel('src/chain.cts')]: ['@langchain'],
+      [rel('src/legacy.cjs')]: ['openai'],
+      [rel('src/client.mjs')]: ['openai']
+    });
+    expect(results.aiFiles).not.toContain(rel('src/plain.mjs'));
+  });
+
+  it('throws when the root directory does not exist', () => {
+    expect(() => scanCodebase({ root: path.join(tmpDir, 'missing') })).toThrow(/Cannot scan/);
+  });
+});
diff --git a/packages/frai-core/src/scanners/imports.js b/packages/frai-core/src/scanners/imports.js
new file mode 100644
index 0000000..eaf1ef7
--- /dev/null
+++ b/packages/frai-core/src/scanners/imports.js
@@ -0,0 +1,334 @@
+import path from 'path';
+
+const JS_EXTENSIONS = ['.js', '.jsx', '.ts', '.tsx', '.mjs', '.cjs', '.mts', '.cts'];
+const PYTHON_EXTENSIONS = ['.py'];
+const NOTEBOOK_EXTENSIONS = ['.ipynb'];
+const R_EXTENSIONS = ['.r', '.rmd'];
+const JVM_EXTENSIONS = ['.java', '.scala'];
+
+// Keywords after which a `/` starts a regular expression literal rather than a division.
+const REGEX_PRECEDING_KEYWORDS = new Set([
+  'return', 'typeof', 'instanceof', 'in', 'of', 'new', 'delete', 'void',
+  'throw', 'case', 'do', 'else', 'yield', 'await'
+]);
+const REGEX_PRECEDING_PUNCTUATION = '(,=:[!&|?{};+-*%<>~^';
+
+const isIdentifierChar = (char) => /[\w$]/.test(char);
+
+/**
+ * Blanks out comments (keeping line breaks so offsets stay stable) and records the
+ * [start, end) spans of string literals, so import keywords that only appear inside
+ * comments or strings can be ignored.
+ */
+function tokenize(source, syntax) {
+  const chars = source.split('');
+  const strings = [];
+  const templateDepths = [];
+  let braceDepth = 0;
+  let lastSignificant = '';
+  let lastWord = '';
+  let i = 0;
+
+  const blank = (from, to) => {
+    for (let k = from; k < to; k += 1) {
+      if (chars[k] !== '\n' && chars[k] !== '\r') chars[k] = ' ';
+    }
+  };
+
+  // Scans a quoted literal starting at `start` and returns the index just past it.
+  const skipQuoted = (start, quote, { multiline }) => {
+    let k = start + quote.length;
+    while (k < source.length) {
+      const char = source[k];
+      if (char === '\\') {
+        k += 2;
+        continue;
+      }
+      if (!multiline && char === '\n') return k;
+      if (source.startsWith(quote, k)) return k + quote.length;
+      k += 1;
+    }
+    return k;
+  };
+
+  // Scans template literal text, from its opening backtick or the `}` closing an
+  // interpolation, until its closing backtick or the next `${`.
+  const scanTemplate = (start) => {
+    let k = start + 1;
+    while (k < source.length) {
+      const char = source[k];
+      if (char === '\\') {
+        k += 2;
+        continue;
+      }
+      if (char === '`') {
+        strings.push([start, k + 1]);
+        return { index: k + 1, interpolation: false };
+      }
+      if (char === '$' && source[k + 1] === '{') {
+        strings.push([start, k + 2]);
+        return { index: k + 2, interpolation: true };
+      }
+      k += 1;
+    }
+    strings.push([start, k]);
+    return { index: k, interpolation: false };
+  };
+
+  const enterTemplate = (start) => {
+    const { index, interpolation } = scanTemplate(start);
+    if (interpolation) {
+      templateDepths.push(braceDepth);
+      braceDepth += 1;
+    }
+    lastSignificant = '`';
+    return index;
+  };
+
+  while (i < source.length) {
+    const char = source[i];
+    const next = source[i + 1];
+
+    if (syntax.hashComments && char === '#') {
+      const end = source.indexOf('\n', i);
+      const stop = end === -1 ? source.length : end;
+      blank(i, stop);
+      i = stop;
+      continue;
+    }
+
+    if (syntax.slashComments && char === '/' && next === '/') {
+      const end = source.indexOf('\n', i);
+      const stop = end === -1 ? source.length : end;
+      blank(i, stop);
+      i = stop;
+      continue;
+    }
+
+    if (syntax.slashComments && char === '/' && next === '*') {
+      const end = source.indexOf('*/', i + 2);
+      const stop = end === -1 ? source.length : end + 2;
+      blank(i, stop);
+      i = stop;
+      continue;
+    }
+
+    if (syntax.tripleQuotes && (source.startsWith('"""', i) || source.startsWith("'''", i))) {
+      const quote = source.slice(i, i + 3);
+      const end = skipQuoted(i, quote, { multiline: true });
+      strings.push([i, end]);
+      lastSignificant = quote[0];
+      i = end;
+      continue;
+    }
+
+    if (char === '"' || char === "'") {
+      const end = skipQuoted(i, char, { multiline: syntax.multilineStrings });
+      strings.push([i, end]);
+      lastSignificant = char;
+      i = end;
+      continue;
+    }
+
+    if (syntax.templateLiterals && char === '`') {
+      i = enterTemplate(i);
+      continue;
+    }
+
+    if (syntax.templateLiterals && templateDepths.length) {
+      if (char === '{') {
+        braceDepth += 1;
+      } else if (char === '}') {
+        braceDepth -= 1;
+        if (braceDepth === templateDepths[templateDepths.length - 1]) {
+          templateDepths.pop();
+          i = enterTemplate(i);
+          continue;
+        }
+      }
+    }
+
+    if (
+      syntax.regexLiterals &&
+      char === '/' &&
+      (lastSignificant === '' ||
+        REGEX_PRECEDING_PUNCTUATION.includes(lastSignificant) ||
+        (isIdentifierChar(lastSignificant) && REGEX_PRECEDING_KEYWORDS.has(lastWord)))
+    ) {
+      let k = i + 1;
+      let inClass = false;
+      while (k < source.length && source[k] !== '\n') {
+        const current = source[k];
+        if (current === '\\') {
+          k += 2;
+          continue;
+        }
+        if (current === '[') inClass = true;
+        else if (current === ']') inClass = false;
+        else if (current === '/' && !inClass) break;
+        k += 1;
+      }
+      const end = Math.min(k + 1, source.length);
+      blank(i, end);
+      lastSignificant = ')';
+      i = end;
+      continue;
+    }
+
+    if (isIdentifierChar(char)) {
+      let k = i;
+      while (k < source.length && isIdentifierChar(source[k])) k += 1;
+      lastWord = source.slice(i, k);
+      lastSignificant = source[k - 1];
+      i = k;
+      continue;
+    }
+
+    if (!/\s/.test(char)) {
+      lastSignificant = char;
+      lastWord = '';
+    }
+    i += 1;
+  }
+
+  const insideString = (index) => {
+    let low = 0;
+    let high = strings.length - 1;
+    while (low <= high) {
+      const mid = (low + high) >> 1;
+      const [start, end] = strings[mid];
+      if (index < start) high = mid - 1;
+      else if (index >= end) low = mid + 1;
+      else return true;
+    }
+    return false;
+  };
+
+  return { code: chars.join(''), insideString };
+}
+
+const JS_SYNTAX = {
+  slashComments: true,
+  templateLiterals: true,
+  regexLiterals: true
+};
+const PYTHON_SYNTAX = { hashComments: true, tripleQuotes: true };
+const R_SYNTAX = { hashComments: true, multilineStrings: true };
+const JVM_SYNTAX = { slashComments: true, tripleQuotes: true };
+
+// Each pattern captures the keyword (group 1, used to reject matches inside strings)
+// and the quoted module specifier (group `spec`).
+const JS_PATTERNS = [
+  // import x from '…', import type { X } from '…', export * from '…' (possibly multi-line)
+  /(?<![\w$.])(import|export)\b[^;'"`()=]*?\bfrom\s*(['"])(?<spec>[^'"\n]*)\2/g,
+  // import '…'
+  /(?<![\w$.])(import)\s*(['"])(?<spec>[^'"\n]*)\2/g,
+  // import('…')
+  /(?<![\w$.])(import)\s*\(\s*(['"`])(?<spec>[^'"`\n]*)\2/g,
+  // require('…')
+  /(?<![\w$.])(require)\s*\(\s*(['"`])(?<spec>[^'"`\n]*)\2/g
+];
+
+function collectMatches(source, syntax, patterns, toModules) {
+  const { code, insideString } = tokenize(source, syntax);
+  const modules = [];
+  for (const pattern of patterns) {
+    for (const match of code.matchAll(pattern)) {
+      const keywordIndex = match.index + match[0].indexOf(match[1]);
+      if (insideString(keywordIndex)) continue;
+      modules.push(...toModules(match));
+    }
+  }
+  return modules;
+}
+
+export function extractJsImports(source) {
+  return collectMatches(source, JS_SYNTAX, JS_PATTERNS, (match) =>
+    match.groups.spec.includes('${') ? [] : [match.groups.spec.trim()]
+  );
+}
+
+const PYTHON_NAME = /^[A-Za-z_][\w.]*$/;
+
+export function extractPythonImports(source) {
+  // Join backslash continuations so `import a, \` + newline + `b` is one statement.
+  const joined = source.replace(/\\\r?\n/g, (text) => ' '.repeat(text.length));
+  const patterns = [
+    /(?:^|(?<=[;:]))[ \t]*(import)[ \t]+(?<names>[^\n;#]+)/gm,
+    /(?:^|(?<=[;:]))[ \t]*(from)[ \t]+(?<spec>\.*[\w.]*)[ \t]+import\b/gm
+  ];
+  return collectMatches(joined, PYTHON_SYNTAX, patterns, (match) => {
+    if (match.groups.spec !== undefined) {
+      return [match.groups.spec];
+    }
+    return match.groups.names
+      .split(',')
+      .map((part) => part.trim().split(/\s+as\s+/)[0].trim())
+      .filter((name) => PYTHON_NAME.test(name));
+  });
+}
+
+export function extractNotebookImports(source) {
+  let notebook;
+  try {
+    notebook = JSON.parse(source);
+  } catch {
+    return extractPythonImports(source);
+  }
+  const cells = Array.isArray(notebook?.cells) ? notebook.cells : [];
+  const code = cells
+    .filter((cell) => cell?.cell_type === 'code')
+    .map((cell) => (Array.isArray(cell.source) ? cell.source.join('') : String(cell.source ?? '')))
+    .join('\n');
+  return extractPythonImports(code);
+}
+
+export function extractRImports(source) {
+  const pattern =
+    /(?<![\w.])(library|require|requireNamespace|loadNamespace)\s*\(\s*(?:package\s*=\s*)?(['"]?)(?<spec>[A-Za-z][\w.]*)\2/g;
+  return collectMatches(source, R_SYNTAX, [pattern], (match) => [match.groups.spec]);
+}
+
+export function extractJvmImports(source) {
+  const pattern = /(?<![\w$.])(import)[ \t]+(?:static[ \t]+)?(?<spec>[A-Za-z_][\w.]*\w)/g;
+  return collectMatches(source, JVM_SYNTAX, [pattern], (match) => [match.groups.spec]);
+}
+
+/**
+ * Returns the imported module specifiers of a source file along with the separator
+ * its language uses between a package and its sub-modules.
+ */
+export function extractImports(filePath, content) {
+  const ext = path.extname(filePath || '').toLowerCase();
+  if (JS_EXTENSIONS.includes(ext)) {
+    return extractJsImports(content).map((spec) => ({ spec, separator: '/' }));
+  }
+  if (PYTHON_EXTENSIONS.includes(ext)) {
+    return extractPythonImports(content).map((spec) => ({ spec, separator: '.' }));
+  }
+  if (NOTEBOOK_EXTENSIONS.includes(ext)) {
+    return extractNotebookImports(content).map((spec) => ({ spec, separator: '.' }));
+  }
+  if (R_EXTENSIONS.includes(ext)) {
+    return extractRImports(content).map((spec) => ({ spec, separator: null }));
+  }
+  if (JVM_EXTENSIONS.includes(ext)) {
+    return extractJvmImports(content).map((spec) => ({ spec, separator: '.' }));
+  }
+  return [
+    ...extractJsImports(content).map((spec) => ({ spec, separator: '/' })),
+    ...extractPythonImports(content).map((spec) => ({ spec, separator: '.' }))
+  ];
+}
+
+/**
+ * True when `spec` is `library` itself or one of its sub-modules. Relative imports
+ * and modules that merely share a prefix (`openai-mock`, `caretaker`) do not match.
+ */
+export function matchesLibrary(spec, separator, library) {
+  if (!spec || !library || spec.startsWith('.')) return false;
+  const moduleName = spec.toLowerCase();
+  const libraryName = library.toLowerCase();
+  if (moduleName === libraryName) return true;
+  return Boolean(separator) && moduleName.startsWith(libraryName + separator);
+}
