+const JS_SYNTAX = { lineComment: '//', blockComment: ['/*', '*/'], quotes: '\'"`' };
+const PYTHON_SYNTAX = { lineComment: '#', quotes: '\'"', tripleQuotes: true };
+const R_SYNTAX = { lineComment: '#', quotes: '\'"`' };
