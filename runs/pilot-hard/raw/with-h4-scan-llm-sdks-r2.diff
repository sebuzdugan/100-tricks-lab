@@ -0,0 +1,125 @@
+import { describe, expect, it } from 'vitest';
+
+import { DEFAULT_AI_LIBRARIES } from './constants.js';
+import { createLibraryDetector } from './detectors.js';
+
+const detectLibraries = (filePath, content, libraries = DEFAULT_AI_LIBRARIES) => {
+  const result = { aiLibraryMatches: {}, aiFiles: [] };
+  result.markAiFile = (file) => result.aiFiles.push(file);
+  createLibraryDetector(libraries).analyze({ filePath, content, result });
+  return result.aiLibraryMatches[filePath] ?? [];
+};
+
+describe('createLibraryDetector', () => {
+  describe('JavaScript / TypeScript', () => {
+    it.each([
+      ["import OpenAI from 'openai';", 'openai'],
+      ['import Anthropic from "@anthropic-ai/sdk";', '@anthropic-ai/sdk'],
+      ["import type { Message } from '@anthropic-ai/sdk/resources';", '@anthropic-ai/sdk'],
+      ["import * as tf from '@tensorflow/tfjs';", '@tensorflow'],
+      ["import '@langchain/openai';", '@langchain'],
+      ["export { ChatOpenAI } from '@langchain/openai';", '@langchain'],
+      ["export * from 'langchain/tools';", 'langchain'],
+      ["const OpenAI = require('openai');", 'openai'],
+      ["const { OpenAI } = require ( 'openai/resources' );", 'openai'],
+      ["const mod = await import('anthropic');", 'anthropic'],
+      ['const mod = await import(`openai`);', 'openai'],
+      ["import OpenAI = require('openai');", 'openai'],
+      ["import{ChatOpenAI}from'@langchain/openai'", '@langchain']
+    ])('detects %s', (line, library) => {
+      expect(detectLibraries('src/app.ts', line)).toEqual([library]);
+    });
+
+    it('detects imports spread over several lines', () => {
+      const content = [
+        'import {',
+        '  ChatOpenAI,',
+        '  type ChatOpenAICallOptions,',
+        "} from '@langchain/openai';",
+        'import type {',
+        '  MessageParam',
+        "} from '@anthropic-ai/sdk';"
+      ].join('\n');
+      expect(detectLibraries('src/app.mts', content)).toEqual(['@anthropic-ai/sdk', '@langchain']);
+    });
+
+    it.each([
+      ["import mock from 'openai-mock';"],
+      ["import client from './openai';"],
+      ["import client from '../anthropic/index.js';"],
+      ["// import OpenAI from 'openai';"],
+      ["/* const OpenAI = require('openai'); */"],
+      ['/**\n * import OpenAI from "openai";\n */'],
+      ["client.require('openai');"],
+      ["const url = 'https://example.com'; import x from './langchain';"],
+      ["import x from '@langchainx/core';"]
+    ])('ignores %s', (content) => {
+      expect(detectLibraries('src/app.js', content)).toEqual([]);
+    });
+
+    it('keeps code after a string containing a comment marker', () => {
+      const content = "const url = 'https://api.example.com'; import OpenAI from 'openai';";
+      expect(detectLibraries('src/app.cjs', content)).toEqual(['openai']);
+    });
+
+    it('reports each library once per file', () => {
+      const content = [
+        "import { ChatOpenAI } from '@langchain/openai';",
+        "import { ChatAnthropic } from '@langchain/anthropic';",
+        "import OpenAI from 'openai';",
+        "const again = require('openai/resources');"
+      ].join('\n');
+      expect(detectLibraries('src/app.cts', content)).toEqual(['openai', '@langchain']);
+    });
+  });
+
+  describe('Python', () => {
+    it.each([
+      ['import openai', 'openai'],
+      ['import os, anthropic as claude', 'anthropic'],
+      ['import torch.nn as nn', 'torch'],
+      ['from langchain.chat_models import ChatOpenAI', 'langchain'],
+      ['from sklearn.model_selection import train_test_split', 'sklearn'],
+      ['    from openai import OpenAI  # client', 'openai'],
+      ['import numpy as np; import openai', 'openai'],
+      ['import numpy, \\\n    openai', 'openai']
+    ])('detects %s', (line, library) => {
+      expect(detectLibraries('model.py', line)).toEqual([library]);
+    });
+
+    it.each([
+      ['import caretaker'],
+      ['import torchvision_utils'],
+      ['from openai_mock import client'],
+      ['from . import openai'],
+      ['from .openai import client'],
+      ['# import openai'],
+      ['"""\nimport openai\n"""'],
+      ['print("import openai")']
+    ])('ignores %s', (content) => {
+      expect(detectLibraries('model.py', content)).toEqual([]);
+    });
+
+    it('reads code cells from notebooks', () => {
+      const notebook = JSON.stringify({
+        cells: [
+          { cell_type: 'markdown', source: ['import tensorflow\n'] },
+          { cell_type: 'code', source: ['import numpy as np\n', 'from openai import OpenAI\n'] }
+        ]
+      });
+      expect(detectLibraries('analysis.ipynb', notebook)).toEqual(['openai']);
+    });
+  });
+
+  it('detects R packages loaded with library() or require()', () => {
+    const content = 'library(caret)\nrequire("randomForest")\n# library(nnet)';
+    expect(detectLibraries('model.R', content)).toEqual(['caret', 'randomForest']);
+  });
+
+  it('supports custom library lists', () => {
+    const content = "import { GoogleGenerativeAI } from '@google/generative-ai';\nimport OpenAI from 'openai';";
+    expect(detectLibraries('src/app.ts', content, ['@google/generative-ai', 'mistral'])).toEqual([
+      '@google/generative-ai'
+    ]);
+  });
+});
