+const JVM_IMPORT_PATTERN = /^\s*import\s+(?:static\s+)?([\w.]+)/gm;
+
+// Each language: how to extract module specifiers, and the separator between a module and its sub-modules.
+const LANGUAGES = [
+  { extensions: JS_EXTENSIONS, separator: '/', extract: (s) => extractJsImports(maskComments(s, JS_SYNTAX)) },
+  { extensions: PYTHON_EXTENSIONS, separator: '.', extract: (s) => extractPythonImports(maskComments(s, PYTHON_SYNTAX)) },
