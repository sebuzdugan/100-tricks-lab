+  }
+  const code = (notebook.cells || [])
+    .filter((cell) => cell.cell_type === 'code')
+    .map((cell) => (Array.isArray(cell.source) ? cell.source.join('') : String(cell.source || '')))
+    .join('\n');
+  return extractPythonImports(maskComments(code, PYTHON_SYNTAX));
+};
+
+const R_IMPORT_PATTERN =
+  /(?<![\w.])(?:library|require|requireNamespace|loadNamespace)\s*\(\s*(?:package\s*=\s*)?(['"`]?)([A-Za-z][\w.]*)\1/g;
