+  new RegExp(String.raw`${JS_KEYWORD_START}(?:import|export)(?=[\s{*])[\w$*{},\s]*?\bfrom\s*(['"])([^'"\n]+)\1`, 'g'),
+  // import 'm'
+  new RegExp(String.raw`${JS_KEYWORD_START}import\s*(['"])([^'"\n]+)\1`, 'g'),
+  // require('m') / import('m')
+  new RegExp(String.raw`${JS_KEYWORD_START}(?:require|import)\s*\(\s*(['"\x60])([^'"\x60\n]+)\1`, 'g')
+];
