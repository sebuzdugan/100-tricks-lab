+const blank = (text) => text.replace(/[^\n]/g, ' ');
+
+/**
+ * Replace comments (and Python docstrings) with whitespace so commented-out imports are ignored.
+ * String literals are kept, so a comment marker inside a string (e.g. a URL) is left alone.
+ * Newlines are preserved to keep line-based parsing intact.
+ */
+const maskComments = (source, { lineComment, blockComment, quotes, tripleQuotes = false }) => {
+  let out = '';
+  let i = 0;
+  while (i < source.length) {
+    if (source.startsWith(lineComment, i)) {
+      const end = source.indexOf('\n', i);
+      const stop = end === -1 ? source.length : end;
+      out += blank(source.slice(i, stop));
+      i = stop;
+      continue;
+    }
+    if (blockComment && source.startsWith(blockComment[0], i)) {
+      const end = source.indexOf(blockComment[1], i + blockComment[0].length);
+      const stop = end === -1 ? source.length : end + blockComment[1].length;
+      out += blank(source.slice(i, stop));
+      i = stop;
+      continue;
+    }
+    const ch = source[i];
+    if (!quotes.includes(ch)) {
+      out += ch;
+      i += 1;
+      continue;
+    }
+    if (tripleQuotes && source.startsWith(ch.repeat(3), i)) {
+      const end = source.indexOf(ch.repeat(3), i + 3);
+      const stop = end === -1 ? source.length : end + 3;
+      out += blank(source.slice(i, stop));
+      i = stop;
+      continue;
+    }
+    // Plain string literal: ends at the matching quote; only template literals may span lines.
+    let j = i + 1;
+    while (j < source.length && source[j] !== ch && !(source[j] === '\n' && ch !== '`')) {
+      j += source[j] === '\\' ? 2 : 1;
+    }
+    const stop = j < source.length && source[j] === ch ? j + 1 : Math.min(j, source.length);
+    out += source.slice(i, stop);
+    i = stop;
+  }
