@@ -0,0 +1,119 @@
+import { describe, expect, it } from 'vitest';
+
+import { createLibraryDetector } from './detectors.js';
+
+const detectLibraries = (filePath, content, libraries) => {
+  const aiFiles = [];
+  const result = {
+    aiLibraryMatches: {},
+    markAiFile: (file) => aiFiles.push(file)
+  };
+  createLibraryDetector(libraries).analyze({ filePath, content, result });
+  return result.aiLibraryMatches[filePath] ?? [];
+};
+
+describe('createLibraryDetector', () => {
+  describe('JavaScript and TypeScript imports', () => {
+    it.each([
+      ['default import', "import OpenAI from 'openai';", ['openai']],
+      ['named import', 'import { Anthropic } from "@anthropic-ai/sdk"', ['@anthropic-ai/sdk']],
+      ['type-only import', "import type { ChatOpenAI } from '@langchain/openai';", ['@langchain']],
+      ['side-effect import', "import 'openai/shims/node';", ['openai']],
+      ['re-export', "export { ChatAnthropic } from '@langchain/anthropic';", ['@langchain']],
+      ['star re-export', "export * from 'langchain/tools';", ['langchain']],
+      ['require', "const OpenAI = require('openai');", ['openai']],
+      ['dynamic import', 'const { default: OpenAI } = await import(`openai`);', ['openai']],
+      ['TS import-equals', "import OpenAI = require('openai');", ['openai']],
+      ['sub-module', "import { Completions } from 'openai/resources';", ['openai']],
+      ['existing scoped library', "import * as tf from '@tensorflow/tfjs';", ['@tensorflow']]
+    ])('detects %s', (_, content, expected) => {
+      expect(detectLibraries('src/app.ts', content, undefined)).toEqual(expected);
+    });
+
+    it('detects imports spread over several lines', () => {
+      const content = [
+        'import {',
+        '  ChatOpenAI,',
+        '  OpenAIEmbeddings',
+        "} from '@langchain/openai';",
+        'import type {',
+        '  MessageParam',
+        "} from '@anthropic-ai/sdk/resources/messages';"
+      ].join('\n');
+
+      expect(detectLibraries('src/llm.mts', content)).toEqual(['@anthropic-ai/sdk', '@langchain']);
+    });
+
+    it('reports each library once per file', () => {
+      const content = [
+        "import { ChatOpenAI } from '@langchain/openai';",
+        "import { ChatAnthropic } from '@langchain/anthropic';",
+        "const OpenAI = require('openai');",
+        "import 'openai/shims/node';"
+      ].join('\n');
+
+      expect(detectLibraries('src/llm.cts', content)).toEqual(['openai', '@langchain']);
+    });
+
+    it.each([
+      ['a module sharing a prefix', "import mock from 'openai-mock';"],
+      ['a scope sharing a prefix', "import sdk from '@anthropic-ai/sdk-extra';"],
+      ['a relative import', "import openai from './openai';"],
+      ['a relative sub-path import', "import { client } from '../langchain/client.js';"],
+      ['a line comment', "// import OpenAI from 'openai';"],
+      ['a block comment', "/*\nimport OpenAI from 'openai';\n*/"],
+      ['a mention in a string', "const docs = 'see https://example.com/openai';"]
+    ])('ignores %s', (_, content) => {
+      expect(detectLibraries('src/app.mjs', content)).toEqual([]);
+    });
+
+    it('keeps scanning after strings and templates that contain comment markers', () => {
+      const content = [
+        "const url = 'https://api.example.com/*';",
+        'const prompt = `Use ${items.map((item) => `- ${item} // note`).join("\\n")}`;',
+        "import OpenAI from 'openai';"
+      ].join('\n');
+
+      expect(detectLibraries('src/app.js', content)).toEqual(['openai']);
+    });
+  });
+
+  describe('Python imports', () => {
+    it.each([
+      ['plain import', 'import openai', ['openai']],
+      ['multiple imports with aliases', 'import os, anthropic as claude, torch', ['torch', 'anthropic']],
+      ['dotted import', 'import torch.nn as nn', ['torch']],
+      ['from sub-module import', 'from langchain.chains import LLMChain', ['langchain']],
+      ['indented import', 'try:\n    import openai\nexcept ImportError:\n    pass', ['openai']],
+      ['continued import', 'import os, \\\n    anthropic', ['anthropic']]
+    ])('detects %s', (_, content, expected) => {
+      expect(detectLibraries('app.py', content)).toEqual(expected);
+    });
+
+    it.each([
+      ['a module sharing a prefix', 'import caretaker\nfrom openai_mock import client'],
+      ['a relative import', 'from .openai import client\nfrom . import anthropic'],
+      ['a commented-out import', '# import torch\nx = 1  # from openai import OpenAI'],
+      ['an import in a docstring', '"""\nimport torch\n"""']
+    ])('ignores %s', (_, content) => {
+      expect(detectLibraries('app.py', content)).toEqual([]);
+    });
+
+    it('reads code cells from notebooks', () => {
+      const notebook = JSON.stringify({
+        cells: [
+          { cell_type: 'markdown', source: ['import sklearn\n'] },
+          { cell_type: 'code', source: ['import numpy as np\n', 'from openai import OpenAI\n'] }
+        ]
+      });
+
+      expect(detectLibraries('analysis.ipynb', notebook)).toEqual(['openai']);
+    });
+  });
+
+  it('supports custom library lists', () => {
+    const content = "import { client } from '@acme/llm/client';\nimport acme from 'acme';";
+
+    expect(detectLibraries('src/app.ts', content, ['@acme', 'acme', 'openai'])).toEqual(['@acme', 'acme']);
+  });
+});
diff --git a/packages/frai-core/src/scanners/imports.js b/packages/frai-core/src/scanners/imports.js
new file mode 100644
index 0000000..48e6ae4
--- /dev/null
+++ b/packages/frai-core/src/scanners/imports.js
@@ -0,0 +1,213 @@
+import path from 'path';
+
+export const JS_EXTENSIONS = ['.js', '.jsx', '.ts', '.tsx', '.mjs', '.cjs', '.mts', '.cts'];
+export const PYTHON_EXTENSIONS = ['.py', '.ipynb'];
+
+// Separator between a module and its sub-modules in each ecosystem.
+const JS_SEPARATOR = '/';
+const PYTHON_SEPARATOR = '.';
+
+// Keeps newlines from a skipped region so line anchors stay valid.
+const blankOut = (text) => text.replace(/[^\n]/g, '') || ' ';
+
+// Removes // and /* */ comments while leaving string and template literals intact.
+const stripJsComments = (source) => {
+  let out = '';
+  let i = 0;
+  let braceDepth = 0;
+  let inTemplate = false;
+  // Brace depth at which each open `${` template expression started.
+  const templateStack = [];
+
+  while (i < source.length) {
+    const ch = source[i];
+    const next = source[i + 1];
+
+    if (inTemplate) {
+      if (ch === '\\') {
+        out += source.slice(i, i + 2);
+        i += 2;
+      } else if (ch === '`') {
+        out += ch;
+        inTemplate = false;
+        i += 1;
+      } else if (ch === '$' && next === '{') {
+        out += '${';
+        templateStack.push(braceDepth);
+        braceDepth += 1;
+        inTemplate = false;
+        i += 2;
+      } else {
+        out += ch;
+        i += 1;
+      }
+      continue;
+    }
+
+    if (ch === '/' && next === '/') {
+      const end = source.indexOf('\n', i);
+      i = end === -1 ? source.length : end;
+    } else if (ch === '/' && next === '*') {
+      const end = source.indexOf('*/', i + 2);
+      const stop = end === -1 ? source.length : end + 2;
+      out += blankOut(source.slice(i, stop));
+      i = stop;
+    } else if (ch === '"' || ch === "'") {
+      // Plain strings cannot span lines, which also bounds the damage of a quote inside a regex literal.
+      let j = i + 1;
+      while (j < source.length && source[j] !== ch && source[j] !== '\n') {
+        j += source[j] === '\\' ? 2 : 1;
+      }
+      const stop = Math.min(source[j] === ch ? j + 1 : j, source.length);
+      out += source.slice(i, stop);
+      i = stop;
+    } else if (ch === '`') {
+      out += ch;
+      inTemplate = true;
+      i += 1;
+    } else {
+      if (ch === '{') {
+        braceDepth += 1;
+      } else if (ch === '}') {
+        braceDepth -= 1;
+        if (templateStack.length && templateStack[templateStack.length - 1] === braceDepth) {
+          templateStack.pop();
+          inTemplate = true;
+        }
+      }
+      out += ch;
+      i += 1;
+    }
+  }
+
+  return out;
+};
+
+const JS_IMPORT_PATTERNS = [
+  // import x from 'm', import type { A } from 'm', export * from 'm' (clause may span lines)
+  /(?:^|[;{}])\s*(?:import|export)\b[^'"`;]*?\bfrom\s*(['"])([^'"\n]+)\1/gm,
+  // import 'm'
+  /(?:^|[;{}])\s*import\s*(['"])([^'"\n]+)\1/gm,
+  // require('m'), import('m')
+  /(?<![\w$.])(?:require|import)\s*\(\s*(['"`])([^'"`$\n]+)\1/g
+];
+
+const extractJsModules = (content) => {
+  const source = stripJsComments(content);
+  const modules = [];
+  for (const pattern of JS_IMPORT_PATTERNS) {
+    for (const match of source.matchAll(pattern)) {
+      const specifier = match[2].trim();
+      if (specifier.startsWith('.') || specifier.startsWith('/')) continue;
+      modules.push(specifier);
+    }
+  }
+  return modules;
+};
+
+// Removes # comments and triple-quoted strings (docstrings) while leaving other strings intact.
+const stripPythonComments = (source) => {
+  let out = '';
+  let i = 0;
+
+  while (i < source.length) {
+    const ch = source[i];
+
+    if (ch === '#') {
+      const end = source.indexOf('\n', i);
+      i = end === -1 ? source.length : end;
+    } else if ((ch === '"' || ch === "'") && source.startsWith(ch.repeat(3), i)) {
+      const end = source.indexOf(ch.repeat(3), i + 3);
+      const stop = end === -1 ? source.length : end + 3;
+      out += blankOut(source.slice(i, stop));
+      i = stop;
+    } else if (ch === '"' || ch === "'") {
+      let j = i + 1;
+      while (j < source.length && source[j] !== ch && source[j] !== '\n') {
+        j += source[j] === '\\' ? 2 : 1;
+      }
+      const stop = Math.min(source[j] === ch ? j + 1 : j, source.length);
+      out += source.slice(i, stop);
+      i = stop;
+    } else {
+      out += ch;
+      i += 1;
+    }
+  }
+
+  return out;
+};
+
+const PYTHON_MODULE = /^[A-Za-z_][\w.]*$/;
+
+const extractPythonModules = (content) => {
+  const source = stripPythonComments(content).replace(/\\\r?\n/g, ' ');
+  const modules = [];
+
+  for (const line of source.split(/\r?\n/)) {
+    for (const rawStatement of line.split(';')) {
+      const statement = rawStatement.trim();
+
+      const fromMatch = statement.match(/^from\s+(\S+)\s+import\b/);
+      if (fromMatch) {
+        if (PYTHON_MODULE.test(fromMatch[1])) modules.push(fromMatch[1]);
+        continue;
+      }
+
+      const importMatch = statement.match(/^import\s+(.+)$/);
+      if (importMatch) {
+        for (const part of importMatch[1].split(',')) {
+          const name = part.trim().split(/\s+as\s+/)[0].trim();
+          if (PYTHON_MODULE.test(name)) modules.push(name);
+        }
+      }
+    }
+  }
+
+  return modules;
+};
+
+const notebookSource = (content) => {
+  try {
+    const notebook = JSON.parse(content);
+    const cells = notebook.cells ?? (notebook.worksheets ?? []).flatMap((sheet) => sheet.cells ?? []);
+    return cells
+      .filter((cell) => cell.cell_type === 'code')
+      .map((cell) => {
+        const source = cell.source ?? cell.input ?? '';
+        return Array.isArray(source) ? source.join('') : String(source);
+      })
+      .join('\n');
+  } catch {
+    return content;
+  }
+};
+
+/**
+ * Lists the non-relative modules a file imports, each with the separator its
+ * ecosystem uses for sub-modules. Files that are neither JS/TS nor Python are
+ * parsed with both grammars.
+ */
+export const extractImports = (content, filePath = '') => {
+  const ext = path.extname(filePath).toLowerCase();
+  const isJs = JS_EXTENSIONS.includes(ext);
+  const isPython = PYTHON_EXTENSIONS.includes(ext);
+  const imports = [];
+
+  if (isJs || !isPython) {
+    for (const name of extractJsModules(content)) {
+      imports.push({ name, separator: JS_SEPARATOR });
+    }
+  }
+  if (isPython || !isJs) {
+    const source = ext === '.ipynb' ? notebookSource(content) : content;
+    for (const name of extractPythonModules(source)) {
+      imports.push({ name, separator: PYTHON_SEPARATOR });
+    }
+  }
+
+  return imports;
+};
+
+export const importMatchesLibrary = ({ name, separator }, library) =>
+  name === library || name.startsWith(`${library}${separator}`);
