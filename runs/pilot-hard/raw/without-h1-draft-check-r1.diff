+interface Field {
+  label: string;
+  /** Inline value plus any indented lines below the field, trimmed. */
+  value: string;
+}
+
+function indentOf(line: string): number {
+  return (line.match(/^\s*/)?.[0] ?? '').replace(/\t/g, '    ').length;
+}
+
+/** Indented lines below line `index` (blank lines in between allowed) - the field's multi-line answer. */
+function continuationLines(lines: string[], index: number): string[] {
+  const indent = indentOf(lines[index]);
+  const block: string[] = [];
+  for (let i = index + 1; i < lines.length; i += 1) {
+    if (lines[i].trim() && indentOf(lines[i]) <= indent) break;
+    block.push(lines[i]);
+  }
+  return block;
+}
+
+function isEmptyFieldLine(line: string): boolean {
+  return EMPTY_FIELD.test(line) || EMPTY_FIELD_COLON_IN_LABEL.test(line);
+}
+
+/** Field lines with no inline answer and no answer on the indented lines below them. */
+function unansweredFieldIndexes(lines: string[]): Set<number> {
+  const unanswered = new Set<number>();
+  lines.forEach((line, i) => {
+    if (!isEmptyFieldLine(line)) return;
+    const answeredBelow = continuationLines(lines, i).some((l) => l.trim() && !isEmptyFieldLine(l));
+    if (!answeredBelow) unanswered.add(i);
+  });
+  return unanswered;
+}
+
+/** Text after the label: skips an optional `(hint)` and the colon, in either label style. */
+function inlineValue(label: string, rest: string): string {
+  if (label.trimEnd().endsWith(':')) return rest.trim();
+  let text = rest.trimStart();
+  if (text.startsWith('(')) {
+    let depth = 0;
+    for (let i = 0; i < text.length; i += 1) {
+      if (text[i] === '(') depth += 1;
+      else if (text[i] === ')') depth -= 1;
+      if (depth === 0) {
+        text = text.slice(i + 1).trimStart();
+        break;
+      }
+    }
+  }
+  return (text.startsWith(':') ? text.slice(1) : rest).trim();
+}
+
+function parseFields(body: string): Field[] {
+  const lines = body.split(/\r?\n/);
+  const fields: Field[] = [];
+  lines.forEach((line, i) => {
+    const m = line.match(FIELD_LINE);
+    if (!m) return;
+    const below = continuationLines(lines, i).join('\n');
+    fields.push({
+      label: m[2].replace(/:\s*$/, '').trim(),
+      value: `${inlineValue(m[2], m[3])}\n${below}`.trim()
+    });
+  });
+  return fields;
+}
