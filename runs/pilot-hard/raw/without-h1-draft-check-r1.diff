+import { describe, expect, it } from 'vitest';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { validateSpec } from './validate.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const repoRoot = path.join(here, '../../../..');
+
+function read(relative: string): string {
+  return fs.readFileSync(path.join(repoRoot, relative), 'utf8');
+}
+
+/** A fully answered gate written the way `frai-gate draft` writes it: colon inside the bold label. */
+function draftStyleSpec(overrides: Partial<Record<string, string>> = {}): string {
+  const sections: Record<string, string> = {
+    tier: `### Risk tier
+
+- **Tier:** **limited**
+- **Justification:** Routes internal tickets; no decisions about people.
+- **Sign-off:** not required (tier below high)`,
+    data: `### Data provenance & privacy
+
+- **Data sources:**
+  - *Runtime inputs:* the ticket message only.
+  - *Training:* none.
+- **PII involved?** **No.** Name and email are stripped before the model call.
+- **Retention:** OpenAI API retention 30 days, nothing persisted here.
+- **Used for training?** No - org data controls confirmed off.`,
+    oversight: `### Human oversight
+
+- **Automation level:** assistive
+- **Override path:** support lead re-classifies in the admin panel
+- **Kill switch:** TRIAGE_MODE=off, on-call owns it, off within 5 minutes`,
+    evaluation: `### Evaluation plan
+
+- **Pre-ship metrics & thresholds** (ratified by the support lead):
+
+  | Metric | Threshold |
+  |---|---|
+  | P1 recall | >= 0.95 |
+
+- **Eval dataset:** evals/triage-golden.jsonl, 300 labelled tickets
+- **Who runs it and when:** CI on every prompt change`,
+    bias: `### Bias & fairness
+
+- **Groups at risk of disparate impact:**
+  - Non-native English writers.
+- **Mitigations:** language-neutral prompt rule
+- **How tested:** recall per language slice; gap > 0.05 blocks release`,
+    monitoring: `### Monitoring & rollback
+
+- **Production monitoring** (proposed signals):
+  - Daily P1 rate.
+  - Override rate.
+- **Degradation definition:**
+
+  Override rate above 15% over 7 days.
+
+- **Rollback trigger & procedure:** on-call flips TRIAGE_MODE=off; users see the manual queue`,
+    transparency: `### Transparency & incident response
+
+- **User disclosure:** confirmation email says an AI routes tickets
+- **Incident owner:** Dana Rivers
+- **Incident path:** report -> triage within 24h -> fix or disable`
+  };
+  Object.assign(sections, overrides);
+  return `# Spec: Triage
+
+## Responsible AI Gate
+
+${Object.values(sections).join('\n\n')}
+`;
+}
+
+describe('validateSpec - drafter formatting', () => {
+  it('passes a fully answered gate with colon-inside-bold labels and indented answers', () => {
+    const result = validateSpec(draftStyleSpec());
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+    expect(result.tier).toBe('limited');
+  });
+
+  it('still flags an empty field in the colon-inside-bold style', () => {
+    const result = validateSpec(
+      draftStyleSpec({
+        oversight: `### Human oversight
+
+- **Automation level:** assistive
+- **Override path:**
+- **Kill switch:** TRIAGE_MODE=off, off within 5 minutes`
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings).toEqual([
+      expect.objectContaining({
+        checkId: 'oversight',
+        message: 'Unanswered field in "Human oversight": - **Override path:**'
+      })
+    ]);
+  });
+
+  it('does not treat an unindented line after an empty field as its answer', () => {
+    const result = validateSpec(
+      draftStyleSpec({
+        oversight: `### Human oversight
+
+- **Automation level**: assistive
+- **Kill switch**:
+
+Override path lives in the admin panel, 5 minutes to act.`
+      })
+    );
+    expect(result.findings.map((f) => f.message)).toEqual([
+      'Unanswered field in "Human oversight": - **Kill switch**:'
+    ]);
+  });
+
+  it('reads the tier from an indented line below the Tier field', () => {
+    const result = validateSpec(
+      draftStyleSpec({
+        tier: `### Risk tier
+
+- **Tier** (prohibited / high / limited / minimal):
+
+  - high - screens job applications
+
+- **Justification:** Automated screening of candidates.
+- **Sign-off:**
+  - Ana Pop (Head of Compliance), 2026-08-01`
+      })
+    );
+    expect(result.tier).toBe('high');
+    expect(result.findings).toEqual([]);
+  });
+
+  it('blocks high tier when the sign-off is empty in the colon-inside-bold style', () => {
+    const result = validateSpec(
+      draftStyleSpec({
+        tier: `### Risk tier
+
+- **Tier:** high
+- **Justification:** Automated screening of candidates.
+- **Sign-off:**`
+      })
+    );
+    expect(result.tier).toBe('high');
+    expect(result.findings.some((f) => f.message.includes('named human sign-off'))).toBe(true);
+  });
+
+  it('blocks a check with an unresolved NEEDS HUMAN INPUT item', () => {
+    const result = validateSpec(
+      draftStyleSpec({
+        transparency: `### Transparency & incident response
+
+- **User disclosure:** confirmation email says an AI routes tickets
+- **Incident owner:** **NEEDS HUMAN INPUT: who owns AI incidents?**
+- **Incident path:** report -> triage within 24h -> fix or disable`
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings).toEqual([
+      expect.objectContaining({ checkId: 'transparency', severity: 'block' })
+    ]);
+    expect(result.findings[0].message).toContain('NEEDS HUMAN INPUT');
+  });
+
+  it('reads the reference draft: tier found, only NEEDS HUMAN INPUT items block', () => {
+    const result = validateSpec(read('examples/support-triage-demo/rai-gate-draft.reference.md'));
+    expect(result.tier).toBe('limited');
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings.length).toBe(7);
+    expect(result.findings.every((f) => f.message.includes('NEEDS HUMAN INPUT'))).toBe(true);
+  });
+
+  it('passes the reference draft once every NEEDS HUMAN INPUT item is resolved', () => {
+    const resolved = read('examples/support-triage-demo/rai-gate-draft.reference.md')
+      .replace(/\*\*NEEDS HUMAN INPUT:?\*\*:?/g, 'Resolved:')
+      .replace(/NEEDS HUMAN INPUT:?/g, 'Resolved:');
+    const result = validateSpec(resolved);
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('keeps the untouched template findings unchanged', () => {
+    const result = validateSpec(read('packages/frai-gate/assets/rai-spec-template.md'));
+    expect(result.findings.map((f) => f.message)).toEqual([
+      '"Risk tier" is present but empty.',
+      '"Data & privacy" is present but empty.',
+      '"Human oversight" is present but empty.',
+      '"Evaluation plan" is present but empty.',
+      '"Bias & fairness" is present but empty.',
+      '"Monitoring & rollback" is present but empty.',
+      'Unanswered field in "Transparency & incidents": - **How users know AI is involved**:',
+      'Unanswered field in "Transparency & incidents": - **Incident owner** (a name, not "the team"):',
+      'Unanswered field in "Transparency & incidents": - **Report → fix path** (with a target response time):'
+    ]);
+  });
+
+  it.each(['examples/frai-spec-example.md', 'examples/support-triage-demo/FRAI-SPEC.md'])(
+    'still passes %s',
+    (file) => {
+      expect(validateSpec(read(file)).verdict).toBe('PASS');
+    }
+  );
+});
