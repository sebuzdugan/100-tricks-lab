+const BARE_LABEL = [/^\s*[-*]\s*\*\*[^*]+\*\*.*:\s*$/, /^\s*[-*]\s*\*\*[^*]+:\*\*\s*$/];
+const SIGNOFF = /sign[- ]?off/i;
+
+function isBareLabel(line: string): boolean {
+  return BARE_LABEL.some((re) => re.test(line));
+}
+
+function indentOf(line: string): number {
+  return (line.match(/^[ \t]*/)?.[0] ?? '').replace(/\t/g, '    ').length;
+}
+
+/** The indented lines below lines[index] (nested bullets, tables, paragraphs), blank lines in between allowed. */
+function continuation(lines: string[], index: number): string[] {
+  const indent = indentOf(lines[index]);
+  const block: string[] = [];
+  for (const line of lines.slice(index + 1)) {
+    if (line.trim() === '') {
+      block.push(line);
+      continue;
+    }
+    if (indentOf(line) <= indent) break;
+    block.push(line);
+  }
+  while (block.length > 0 && block[block.length - 1].trim() === '') block.pop();
+  return block;
+}
+
+/** A field label with no answer: nothing after it on its line and nothing indented below it. */
+function isEmptyField(lines: string[], index: number): boolean {
+  return isBareLabel(lines[index]) && continuation(lines, index).length === 0;
+}
+
+function emptyFieldLines(body: string): string[] {
+  const lines = body.split(/\r?\n/);
+  return lines.filter((_, i) => isEmptyField(lines, i));
+}
 
