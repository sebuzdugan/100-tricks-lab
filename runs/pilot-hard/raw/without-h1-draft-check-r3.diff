+/** A bulleted field line: `- **Label**...`. The rest of the line holds an optional hint, the colon and the value. */
+const FIELD_LINE = /^(\s*)[-*]\s*\*\*([^*]+)\*\*(.*)$/;
 
 interface Section {
   heading: string;
   body: string;
 }
 
+interface Field {
+  label: string;
+  /** Inline value after the colon, trimmed. */
+  value: string;
+  indent: number;
+}
+
+function indentOf(line: string): number {
+  return (line.match(/^\s*/)?.[0] ?? '').replace(/\t/g, '    ').length;
+}
+
+/**
+ * Parses a field line in either label style: `- **Retention**: 30 days` (optionally with a
+ * parenthesized hint before the colon) or `- **Retention:** 30 days`. Returns null for lines
+ * that are not fields, such as a bold bullet without a colon.
+ */
+function parseField(line: string): Field | null {
+  const m = line.match(FIELD_LINE);
+  if (!m) return null;
+  const label = m[2].trim();
+  const rest = m[3];
+  if (label.endsWith(':')) {
+    return { label: label.slice(0, -1).trim(), value: rest.trim(), indent: indentOf(m[1]) };
+  }
+  // The value starts at the first colon outside parentheses, so hints like
+  // "(yes/no - if yes: which fields)" or "(... "not required (tier below high)")" are skipped.
+  let depth = 0;
+  for (let i = 0; i < rest.length; i += 1) {
+    const ch = rest[i];
+    if (ch === '(') depth += 1;
+    else if (ch === ')') depth = Math.max(0, depth - 1);
+    else if (ch === ':' && depth === 0) {
+      return { label, value: rest.slice(i + 1).trim(), indent: indentOf(m[1]) };
+    }
+  }
+  return null;
+}
+
+/** Indented lines below a field (blank lines in between allowed) that belong to its answer. */
+function nestedLines(lines: string[], index: number, indent: number): number[] {
+  const nested: number[] = [];
+  for (let i = index + 1; i < lines.length; i += 1) {
+    if (!lines[i].trim()) continue;
+    if (indentOf(lines[i]) <= indent) break;
+    nested.push(i);
+  }
+  return nested;
+}
+
+/** An inline value ending in a colon ("as follows:") only introduces an answer; it is not one. */
+function hasInlineAnswer(field: Field): boolean {
+  return field.value !== '' && !field.value.endsWith(':');
+}
+
+/** A field is answered by an inline value or by any substantive indented content below it. */
+function isFieldAnswered(lines: string[], index: number, field: Field): boolean {
+  if (hasInlineAnswer(field)) return true;
+  return nestedLines(lines, index, field.indent).some((i) => {
+    const child = parseField(lines[i]);
+    if (child) return isFieldAnswered(lines, i, child);
+    return lines[i].trim().replace(/^[-*+]\s*/, '') !== '';
+  });
+}
+
+/** Indexes of field lines in the body that have no answer, inline or nested. */
+function unansweredFieldLines(lines: string[]): number[] {
+  return lines.flatMap((line, i) => {
+    const field = parseField(line);
+    return field && !isFieldAnswered(lines, i, field) ? [i] : [];
+  });
+}
+
+/** Finds the first field whose label matches and returns its answer text: the inline value, else the nested lines. */
+function fieldAnswer(body: string, labelPattern: RegExp): string | null {
+  const lines = body.split(/\r?\n/);
+  for (let i = 0; i < lines.length; i += 1) {
+    const field = parseField(lines[i]);
+    if (!field || !labelPattern.test(field.label)) continue;
+    if (hasInlineAnswer(field)) return field.value;
+    const nested = nestedLines(lines, i, field.indent)
+      .filter((n) => {
+        const child = parseField(lines[n]);
+        return !child || isFieldAnswered(lines, n, child);
+      })
+      .map((n) => lines[n].trim());
+    return nested.join('\n');
+  }
+  return null;
+}
