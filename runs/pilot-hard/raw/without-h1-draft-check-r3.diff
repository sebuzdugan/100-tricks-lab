+import { describe, expect, it } from 'vitest';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { validateSpec } from './validate.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const repoRoot = path.join(here, '../../../..');
+
+function read(relative: string): string {
+  return fs.readFileSync(path.join(repoRoot, relative), 'utf8');
+}
+
+const ANSWERED = {
+  tier: `- **Tier:** limited
+- **Justification:** Chatbot answering policy questions; no automated decisions about people.
+- **Sign-off:** not required (tier below high)`,
+  data: `- **Data sources:** internal policy docs
+- **PII involved?:** no
+- **Retention:** prompts kept 30 days
+- **Used for training?:** no`,
+  oversight: `- **Automation level:** assistive
+- **Override path:** support team via admin panel
+- **Kill switch:** feature flag, off within 5 minutes`,
+  evaluation: `- **Metrics:** groundedness >= 0.85
+- **Eval dataset:** eval/policy-qa.jsonl, 300 questions
+- **Who runs it:** CI on every prompt change`,
+  bias: `- **Groups:** non-native English speakers
+- **Mitigations:** multilingual eval slice
+- **How tested:** disaggregated groundedness by language`,
+  monitoring: `- **Signals:** thumbs-down rate
+- **Degradation:** thumbs-down > 10% over 24h
+- **Rollback:** on-call flips the flag`,
+  transparency: `- **Disclosure:** "AI assistant" label
+- **Incident owner:** Dana Rivers
+- **Path:** in-chat report -> triage -> fix within 24h`
+};
+
+function spec(overrides: Partial<Record<keyof typeof ANSWERED, string>> = {}): string {
+  const s = { ...ANSWERED, ...overrides };
+  return `# Spec
+
+## Responsible AI Gate
+
+### Risk tier
+
+${s.tier}
+
+### Data & privacy
+
+${s.data}
+
+### Human oversight
+
+${s.oversight}
+
+### Evaluation plan
+
+${s.evaluation}
+
+### Bias & fairness
+
+${s.bias}
+
+### Monitoring & rollback
+
+${s.monitoring}
+
+### Transparency & incidents
+
+${s.transparency}
+`;
+}
+
+describe('validateSpec label styles', () => {
+  it('passes a gate written with the colon inside the bold label', () => {
+    const result = validateSpec(spec());
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+    expect(result.tier).toBe('limited');
+  });
+
+  it('reads a bolded tier value', () => {
+    const result = validateSpec(
+      spec({ tier: ANSWERED.tier.replace('**Tier:** limited', '**Tier:** **limited**') })
+    );
+    expect(result.tier).toBe('limited');
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('treats an empty field as unanswered in either style', () => {
+    for (const label of ['- **Retention:**', '- **Retention**:']) {
+      const result = validateSpec(
+        spec({ data: ANSWERED.data.replace('- **Retention:** prompts kept 30 days', label) })
+      );
+      expect(result.verdict).toBe('BLOCK');
+      expect(result.findings).toEqual([
+        {
+          checkId: 'data-privacy',
+          severity: 'block',
+          message: `Unanswered field in "Data & privacy": ${label}`,
+          source: 'validator'
+        }
+      ]);
+    }
+  });
+});
+
+describe('validateSpec nested answers', () => {
+  it('accepts nested bullets, an indented table and an indented paragraph, with blank lines between', () => {
+    const result = validateSpec(
+      spec({
+        data: `- **Data sources:**
+  - *Training:* none
+  - *Runtime:* the ticket message
+- **PII involved?** (yes/no - if yes: which fields):
+
+  no - identifiers are stripped before the call
+- **Retention**:
+  30 days at the provider, nothing stored locally
+- **Used for training?:** no`,
+        evaluation: `- **Metrics** (all *suggested*):
+
+  | Metric | Threshold |
+  |---|---|
+  | recall | >= 0.95 |
+
+- **Eval dataset:** eval/policy-qa.jsonl, 300 questions
+- **Who runs it:** CI on every prompt change`
+      })
+    );
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+  });
+
+  it('does not count unindented text or empty nested fields as an answer', () => {
+    const result = validateSpec(
+      spec({
+        data: `- **Data sources:**
+  - **Training:**
+  - **Runtime:**
+- **PII involved?:** no
+- **Retention:**
+
+Some unrelated paragraph.
+- **Used for training?:** no`
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings.map((f) => f.message)).toEqual([
+      'Unanswered field in "Data & privacy": - **Data sources:**',
+      'Unanswered field in "Data & privacy": - **Training:**',
+      'Unanswered field in "Data & privacy": - **Runtime:**',
+      'Unanswered field in "Data & privacy": - **Retention:**'
+    ]);
+  });
+
+  it('reads the tier and sign-off from indented lines below their labels', () => {
+    const result = validateSpec(
+      spec({
+        tier: `- **Tier:**
+
+  **high**
+- **Justification:** Screens job applications automatically.
+- **Sign-off:**
+  - Ana Pop (Head of Compliance), 2026-08-01`
+      })
+    );
+    expect(result.tier).toBe('high');
+    expect(result.findings).toEqual([]);
+  });
+
+  it('still requires a sign-off for high tier when the sign-off field is empty', () => {
+    const result = validateSpec(
+      spec({
+        tier: `- **Tier:**
+  high
+- **Justification:** Screens job applications automatically; see sign-off below.
+- **Sign-off:**`
+      })
+    );
+    expect(result.tier).toBe('high');
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings.some((f) => f.message.includes('named human sign-off'))).toBe(true);
+  });
+});
+
+describe('validateSpec NEEDS HUMAN INPUT', () => {
+  it('blocks the check that still contains the marker, wherever it sits', () => {
+    const result = validateSpec(
+      spec({
+        oversight: `${ANSWERED.oversight}
+  - Suggested owner: on-call. **NEEDS HUMAN INPUT:** who flips it out of hours?`
+      })
+    );
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.findings).toEqual([
+      {
+        checkId: 'oversight',
+        severity: 'block',
+        message:
+          '"Human oversight" has 1 unresolved NEEDS HUMAN INPUT item. Answer each one and remove the marker.',
+        source: 'validator'
+      }
+    ]);
+  });
+
+  it('ignores the marker inside HTML comments', () => {
+    const result = validateSpec(
+      spec({ bias: `${ANSWERED.bias}\n<!-- NEEDS HUMAN INPUT: resolved 2026-09-01 -->` })
+    );
+    expect(result.verdict).toBe('PASS');
+  });
+});
+
+describe('validateSpec on repo specs', () => {
+  const draft = read('examples/support-triage-demo/rai-gate-draft.reference.md');
+
+  it('blocks the reference draft only for its unresolved NEEDS HUMAN INPUT items', () => {
+    const result = validateSpec(draft);
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.tier).toBe('limited');
+    expect(result.findings.length).toBe(7);
+    expect(result.findings.every((f) => f.message.includes('NEEDS HUMAN INPUT'))).toBe(true);
+  });
+
+  it('passes the reference draft once every NEEDS HUMAN INPUT item is resolved', () => {
+    const resolved = draft.replace(/NEEDS HUMAN INPUT/g, 'Resolved');
+    const result = validateSpec(resolved);
+    expect(result.findings).toEqual([]);
+    expect(result.verdict).toBe('PASS');
+    expect(result.tier).toBe('limited');
+  });
+
+  it('reports the same findings on the untouched template as before', () => {
+    const result = validateSpec(read('packages/frai-gate/assets/rai-spec-template.md'));
+    const empty = (title: string) => `"${title}" is present but empty.`;
+    const unanswered = (line: string) =>
+      `Unanswered field in "Transparency & incidents": ${line}`;
+    expect(result.verdict).toBe('BLOCK');
+    expect(result.tier).toBeNull();
+    expect(result.findings.map((f) => [f.checkId, f.severity, f.message])).toEqual([
+      ['risk-tier', 'block', empty('Risk tier')],
+      ['data-privacy', 'block', empty('Data & privacy')],
+      ['oversight', 'block', empty('Human oversight')],
+      ['evaluation', 'block', empty('Evaluation plan')],
+      ['bias', 'block', empty('Bias & fairness')],
+      ['monitoring', 'block', empty('Monitoring & rollback')],
+      ['transparency', 'block', unanswered('- **How users know AI is involved**:')],
+      ['transparency', 'block', unanswered('- **Incident owner** (a name, not "the team"):')],
+      ['transparency', 'block', unanswered('- **Report → fix path** (with a target response time):')]
+    ]);
+  });
+
+  it.each(['examples/frai-spec-example.md', 'examples/support-triage-demo/FRAI-SPEC.md'])(
+    'still passes %s',
+    (file) => {
+      const result = validateSpec(read(file));
+      expect(result.findings).toEqual([]);
+      expect(result.verdict).toBe('PASS');
+    }
+  );
+});
