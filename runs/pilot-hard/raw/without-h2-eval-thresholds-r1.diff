diff --git a/packages/frai-core/src/eval/thresholds.js b/packages/frai-core/src/eval/thresholds.js
new file mode 100644
index 0000000..b916bcf
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,83 @@
+export const THRESHOLD_ERROR_CODE = 'FRAI_EVAL_INVALID_THRESHOLD';
+
+export class ThresholdError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ThresholdError';
+    this.code = THRESHOLD_ERROR_CODE;
+  }
+}
+
+const NUMBER_PATTERN = /^[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?$/;
+
+const assertMinimum = (metric, min) => {
+  if (typeof min !== 'number' || !Number.isFinite(min)) {
+    throw new ThresholdError(`Threshold for "${metric}" must be a number between 0 and 1.`);
+  }
+  if (min < 0 || min > 1) {
+    throw new ThresholdError(`Threshold for "${metric}" is ${min}; minimum must be between 0 and 1.`);
+  }
+};
+
+// Parses a single "<metric>=<min>" string, e.g. "exact_match=0.9".
+export function parseThreshold(spec) {
+  const raw = typeof spec === 'string' ? spec.trim() : '';
+  const separator = raw.indexOf('=');
+  const metric = separator === -1 ? '' : raw.slice(0, separator).trim();
+  const value = separator === -1 ? '' : raw.slice(separator + 1).trim();
+  if (!metric || !NUMBER_PATTERN.test(value)) {
+    throw new ThresholdError(
+      `Invalid threshold "${spec}": expected <metric>=<number>, e.g. exact_match=0.9.`
+    );
+  }
+  const min = Number(value);
+  assertMinimum(metric, min);
+  return { metric, min };
+}
+
+// Parses a list of "<metric>=<min>" strings into a thresholds object.
+export function parseThresholds(specs = []) {
+  return specs.reduce((thresholds, spec) => {
+    const { metric, min } = parseThreshold(spec);
+    if (Object.prototype.hasOwnProperty.call(thresholds, metric)) {
+      throw new ThresholdError(`Threshold for "${metric}" was given more than once.`);
+    }
+    thresholds[metric] = min;
+    return thresholds;
+  }, {});
+}
+
+export function evaluateThresholds({ evaluations = [], thresholds }) {
+  if (!thresholds || typeof thresholds !== 'object' || Array.isArray(thresholds)) {
+    throw new ThresholdError('thresholds must be an object mapping metric ids to minimum scores.');
+  }
+
+  const validIds = evaluations.map((metric) => metric?.id).filter(Boolean);
+  const results = Object.entries(thresholds).map(([metric, min]) => {
+    if (!validIds.includes(metric)) {
+      throw new ThresholdError(
+        `Unknown metric "${metric}" in thresholds. Valid metric ids: ${validIds.join(', ') || '(none)'}.`
+      );
+    }
+    assertMinimum(metric, min);
+    const evaluation = evaluations.find((candidate) => candidate?.id === metric);
+    const score =
+      typeof evaluation.score === 'number' && Number.isFinite(evaluation.score)
+        ? evaluation.score
+        : null;
+    return { metric, min, score, passed: score !== null && score >= min };
+  });
+
+  return {
+    passed: results.every((result) => result.passed),
+    thresholds: results
+  };
+}
+
+export default {
+  THRESHOLD_ERROR_CODE,
+  ThresholdError,
+  parseThreshold,
+  parseThresholds,
+  evaluateThresholds
+};
