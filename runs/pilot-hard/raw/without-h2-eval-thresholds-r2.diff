index 0000000..8fb54fd
--- /dev/null
+++ b/packages/frai-core/src/eval/thresholds.js
@@ -0,0 +1,101 @@
+export const THRESHOLD_ERROR_CODE = 'FRAI_EVAL_INVALID_THRESHOLD';
+
+export class ThresholdError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ThresholdError';
+    this.code = THRESHOLD_ERROR_CODE;
+  }
+}
+
+const DECIMAL_PATTERN = /^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$/;
+
+const isPlainObject = (value) =>
+  value !== null && typeof value === 'object' && !Array.isArray(value);
+
+const hasScore = (score) => typeof score === 'number' && Number.isFinite(score);
+
+function assertValidMinimum(metric, min) {
+  if (typeof min !== 'number' || !Number.isFinite(min)) {
+    throw new ThresholdError(`Threshold for "${metric}" must be a number between 0 and 1.`);
+  }
+  if (min < 0 || min > 1) {
+    throw new ThresholdError(
+      `Threshold for "${metric}" must be between 0 and 1 (received ${min}).`
+    );
+  }
+}
+
+/**
+ * Parse CLI-style threshold strings (`exact_match=0.9`) into a thresholds object.
+ * @param {string[]} specs
+ * @returns {Record<string, number>}
+ */
+export function parseThresholds(specs = []) {
+  /** @type {Record<string, number>} */
+  const thresholds = {};
+  specs.forEach((spec) => {
+    const raw = String(spec);
+    const separator = raw.indexOf('=');
+    const metric = separator === -1 ? '' : raw.slice(0, separator).trim();
+    const value = separator === -1 ? '' : raw.slice(separator + 1).trim();
+    if (!metric || !DECIMAL_PATTERN.test(value)) {
+      throw new ThresholdError(
+        `Invalid threshold "${raw}": expected <metric>=<number>, for example exact_match=0.9.`
+      );
+    }
+    if (Object.prototype.hasOwnProperty.call(thresholds, metric)) {
+      throw new ThresholdError(`Threshold for "${metric}" was given more than once.`);
+    }
+    const min = Number(value);
+    assertValidMinimum(metric, min);
+    thresholds[metric] = min;
+  });
+  return thresholds;
+}
+
+/**
+ * Check each threshold against the matching evaluation. A metric without a
+ * numeric score fails its threshold.
+ */
+export function evaluateThresholds({ evaluations, thresholds }) {
+  if (!isPlainObject(thresholds)) {
+    throw new ThresholdError('thresholds must be an object mapping metric ids to minimum scores.');
+  }
+
+  const byId = new Map();
+  evaluations.forEach((evaluation) => {
+    if (evaluation && typeof evaluation.id === 'string') {
+      byId.set(evaluation.id, evaluation);
+    }
+  });
+
+  const results = Object.entries(thresholds).map(([metric, min]) => {
+    if (!byId.has(metric)) {
+      const valid = [...byId.keys()];
+      const validList = valid.length ? valid.join(', ') : '(none)';
+      throw new ThresholdError(`Unknown metric "${metric}". Valid metric ids: ${validList}.`);
+    }
+    assertValidMinimum(metric, min);
+    const { score } = byId.get(metric);
+    const scored = hasScore(score);
+    return {
+      metric,
+      min,
+      score: scored ? score : null,
+      passed: scored && score >= min
+    };
+  });
+
+  return {
+    passed: results.every((result) => result.passed),
+    thresholds: results
+  };
+}
+
+export default {
+  THRESHOLD_ERROR_CODE,
+  ThresholdError,
+  parseThresholds,
+  evaluateThresholds
+};
