+export class ThresholdError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ThresholdError';
+  }
+}
+
+const isPlainObject = (value) =>
+  value != null && typeof value === 'object' && !Array.isArray(value);
+
+const MIN_PATTERN = /^(?:\d+(?:\.\d*)?|\.\d+)$/;
+
+// Parses CLI-style "<metric>=<min>" strings into a thresholds object for generateReport.
+export function parseThresholds(specs = []) {
+  const entries = new Map();
+  specs.forEach((spec) => {
+    const text = String(spec);
+    const separator = text.indexOf('=');
+    const metric = separator === -1 ? '' : text.slice(0, separator).trim();
+    const rawMin = separator === -1 ? '' : text.slice(separator + 1).trim();
+    if (!metric || !MIN_PATTERN.test(rawMin)) {
+      throw new ThresholdError(
+        `Invalid threshold "${text}". Expected <metric>=<min>, for example exact_match=0.9.`
+      );
+    }
+    const min = Number(rawMin);
+    if (min > 1) {
+      throw new ThresholdError(`Invalid threshold "${text}". The minimum must be between 0 and 1.`);
+    }
+    if (entries.has(metric)) {
+      throw new ThresholdError(`Threshold for metric "${metric}" was given more than once.`);
+    }
+    entries.set(metric, min);
+  });
+  return Object.fromEntries(entries);
+}
+
+export function evaluateThresholds({ evaluations, thresholds }) {
+  if (!isPlainObject(thresholds)) {
+    throw new ThresholdError('thresholds must be an object mapping metric ids to minimum scores.');
+  }
+
+  const byId = new Map();
+  evaluations.forEach((metric) => {
+    if (metric && typeof metric.id === 'string') byId.set(metric.id, metric);
+  });
+
+  return Object.entries(thresholds).map(([metric, min]) => {
+    if (typeof min !== 'number' || !Number.isFinite(min) || min < 0 || min > 1) {
+      throw new ThresholdError(
+        `Invalid minimum for metric "${metric}": ${String(min)}. Minimums must be numbers between 0 and 1.`
+      );
+    }
+    if (!byId.has(metric)) {
+      const validIds = [...byId.keys()];
+      throw new ThresholdError(
+        `Unknown metric id "${metric}". Valid metric ids: ${validIds.length ? validIds.join(', ') : '(none)'}.`
+      );
+    }
+    const { score } = byId.get(metric);
+    const hasScore = typeof score === 'number' && Number.isFinite(score);
+    return {
+      metric,
+      min,
+      score: hasScore ? score : null,
+      passed: hasScore && score >= min
+    };
+  });
+}
