+/**
+ * Parses the value portion of a `.env` definition.
+ * Returns the value and the [start, end) span it occupies within `raw` (quotes excluded).
+ */
+const parseEnvValue = (raw) => {
+  const quote = raw[0];
+  if (quote === '"' || quote === "'") {
+    const closing = raw.indexOf(quote, 1);
+    const rest = closing === -1 ? '' : raw.slice(closing + 1);
+    if (closing !== -1 && /^\s*(#.*)?$/.test(rest)) {
+      return { value: raw.slice(1, closing), start: 1, end: closing, quote };
+    }
+  }
+  const commentMatch = raw.match(/(^|\s)#/);
+  const uncommented = commentMatch ? raw.slice(0, commentMatch.index) : raw;
+  const value = uncommented.trimEnd();
+  return { value, start: 0, end: value.length, quote: null };
+};
