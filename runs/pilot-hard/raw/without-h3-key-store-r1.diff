+  if (/[\r\n]/.test(value)) throw new Error('API key must not contain line breaks');
+  return value;
+};
+
+// Splits content into lines that keep their own terminator, so joining them reproduces the input exactly.
+const splitLines = (content) => content.match(/[^\n]*\n|[^\n]+$/g) ?? [];
+
+const stripLineEnding = (line) => {
+  const match = line.match(/\r?\n$/);
+  return match ? { body: line.slice(0, -match[0].length), ending: match[0] } : { body: line, ending: '' };
+};
