+const findLastEnvDefinition = (lines) => {
+  for (let index = lines.length - 1; index >= 0; index -= 1) {
+    const { body, ending } = stripLineEnding(lines[index]);
+    const match = body.match(ENV_DEFINITION_PATTERN);
+    if (match) {
+      const prefix = match[1];
+      return { index, body, ending, prefix, parsed: parseEnvValue(body.slice(prefix.length)) };
+    }
+  }
+  return null;
+};
+
+const formatEnvValue = (value, quote) => {
+  if (quote && !value.includes(quote)) return value;
+  if (!quote && /^[^\s#'"]+$/.test(value)) return value;
+  return value.includes('"') ? `'${value}'` : `"${value}"`;
 };
 
