@@ -2,56 +2,160 @@ import fs from 'fs';
 
 import { resolveGlobalConfigDir, resolveGlobalConfigPath, resolveLocalEnvPath } from './paths.js';
 
+const API_KEY_NAME = 'OPENAI_API_KEY';
+
+const ENV_ASSIGNMENT = /^(\s*)(export\s+)?([A-Za-z_][A-Za-z0-9_.-]*)\s*=[ \t]*(.*)$/;
+const TRAILING_COMMENT = /^\s*(#.*)?$/;
+
 const ensureDir = (dirPath) => {
   if (!fs.existsSync(dirPath)) {
     fs.mkdirSync(dirPath, { recursive: true, mode: 0o700 });
   }
 };
 
-const sanitizeValue = (value) => {
-  if (!value) return null;
-  return value.trim().replace(/^['"]|['"]$/g, '');
+const normalizeKey = (key) => {
+  if (typeof key !== 'string' || !key.trim()) throw new Error('API key is required');
+  const trimmed = key.trim();
+  if (/[\r\n]/.test(trimmed)) throw new Error('API key must not contain line breaks');
+  return trimmed;
+};
+
+const splitLines = (content) => {
+  const lines = content.split('\n');
+  if (lines[lines.length - 1] === '') lines.pop();
+  return lines;
+};
+
+/**
+ * Parse the value part of a `.env` assignment (everything after `=`).
+ * Returns { value, quote, comment } or null when the quoting is malformed.
+ */
+const parseEnvValue = (raw) => {
+  const quote = raw[0];
+  if (quote === '"' || quote === "'") {
+    let value = '';
+    for (let i = 1; i < raw.length; i += 1) {
+      const char = raw[i];
+      if (quote === '"' && char === '\\' && (raw[i + 1] === '"' || raw[i + 1] === '\\')) {
+        value += raw[i + 1];
+        i += 1;
+        continue;
+      }
+      if (char === quote) {
+        const rest = raw.slice(i + 1);
+        if (!TRAILING_COMMENT.test(rest)) return null;
+        return { value, quote, comment: rest.replace(/\s+$/, '') };
+      }
+      value += char;
+    }
+    return null;
+  }
+
+  const commentMatch = raw.match(/(^|\s)#/);
+  const end = commentMatch ? commentMatch.index : raw.length;
+  return {
+    value: raw.slice(0, end).trim(),
+    quote: '',
+    comment: raw.slice(end).replace(/\s+$/, '')
+  };
+};
+
+/**
+ * Locate the effective (last) definition of `name` in `.env` content.
+ */
+const findEnvDefinition = (lines, name) => {
+  let found = null;
+  lines.forEach((rawLine, index) => {
+    const line = rawLine.endsWith('\r') ? rawLine.slice(0, -1) : rawLine;
+    const match = line.match(ENV_ASSIGNMENT);
+    if (!match || match[3] !== name) return;
+    const parsed = parseEnvValue(match[4]);
+    if (!parsed) return;
+    found = { index, indent: match[1], exportPrefix: match[2] ?? '', ...parsed };
+  });
+  return found;
+};
+
+const formatEnvValue = (value, preferredQuote) => {
+  if (preferredQuote === "'" && !value.includes("'")) return `'${value}'`;
+  if (preferredQuote === '"' || /[\s#'"\\]/.test(value)) {
+    return `"${value.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
+  }
+  return value;
+};
+
+const readGlobalConfig = (configPath) => {
+  const content = fs.readFileSync(configPath, 'utf8');
+  let parsed;
+  try {
+    parsed = JSON.parse(content);
+  } catch (error) {
+    throw new Error(`Global config at ${configPath} is not valid JSON: ${error.message}`);
+  }
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    throw new Error(`Global config at ${configPath} must contain a JSON object`);
+  }
+  return parsed;
 };
 
-export const hasLocalApiKey = (cwd = process.cwd()) => fs.existsSync(resolveLocalEnvPath(cwd));
+export const hasLocalApiKey = (cwd = process.cwd()) => Boolean(getLocalApiKey(cwd));
 
 export const getLocalApiKey = (cwd = process.cwd()) => {
   const envPath = resolveLocalEnvPath(cwd);
   if (!fs.existsSync(envPath)) return null;
   const content = fs.readFileSync(envPath, 'utf8');
-  const match = content.match(/^\s*OPENAI_API_KEY\s*=\s*(.+)\s*$/m);
-  return match ? sanitizeValue(match[1]) : null;
+  const definition = findEnvDefinition(splitLines(content), API_KEY_NAME);
+  const value = definition?.value.trim();
+  return value || null;
 };
 
 export const setLocalApiKey = (key, cwd = process.cwd()) => {
-  if (!key) throw new Error('API key is required');
+  const apiKey = normalizeKey(key);
   const envPath = resolveLocalEnvPath(cwd);
-  const content = `OPENAI_API_KEY=${key}\n`;
+  const existing = fs.existsSync(envPath) ? fs.readFileSync(envPath, 'utf8') : '';
+  const eol = existing.includes('\r\n') ? '\r\n' : '\n';
+  const lines = existing.split('\n');
+  const definition = findEnvDefinition(splitLines(existing), API_KEY_NAME);
+
+  let content;
+  if (definition) {
+    const original = lines[definition.index];
+    const cr = original.endsWith('\r') ? '\r' : '';
+    const comment = definition.comment ? ` ${definition.comment.trimStart()}` : '';
+    lines[definition.index] =
+      `${definition.indent}${definition.exportPrefix}${API_KEY_NAME}=` +
+      `${formatEnvValue(apiKey, definition.quote)}${comment}${cr}`;
+    content = lines.join('\n');
+  } else {
+    const separator = existing && !existing.endsWith('\n') ? eol : '';
+    content = `${existing}${separator}${API_KEY_NAME}=${formatEnvValue(apiKey, '')}${eol}`;
+  }
+
   fs.writeFileSync(envPath, content, { encoding: 'utf8', mode: 0o600 });
   return envPath;
 };
 
