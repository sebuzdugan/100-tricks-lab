-  fs.existsSync(resolveGlobalConfigPath(homeDir));
+  Boolean(getGlobalApiKey(homeDir));
 
 export const getGlobalApiKey = (homeDir = process.env.HOME || process.env.USERPROFILE) => {
   const configPath = resolveGlobalConfigPath(homeDir);
   if (!fs.existsSync(configPath)) return null;
-  const content = fs.readFileSync(configPath, 'utf8');
   try {
-    const parsed = JSON.parse(content);
-    return sanitizeValue(parsed.OPENAI_API_KEY);
-  } catch (error) {
+    const value = readGlobalConfig(configPath)[API_KEY_NAME];
+    return typeof value === 'string' && value.trim() ? value.trim() : null;
+  } catch {
     return null;
   }
 };
 
 export const setGlobalApiKey = (key, homeDir = process.env.HOME || process.env.USERPROFILE) => {
-  if (!key) throw new Error('API key is required');
+  const apiKey = normalizeKey(key);
   const configDir = resolveGlobalConfigDir(homeDir);
   ensureDir(configDir);
   const configPath = resolveGlobalConfigPath(homeDir);
-  const payload = JSON.stringify({ OPENAI_API_KEY: key }, null, 2);
+  const existing = fs.existsSync(configPath) ? readGlobalConfig(configPath) : {};
+  const payload = JSON.stringify({ ...existing, [API_KEY_NAME]: apiKey }, null, 2);
   fs.writeFileSync(configPath, payload, { encoding: 'utf8', mode: 0o600 });
   return configPath;
 };
diff --git a/packages/frai-core/src/config/key-store.test.js b/packages/frai-core/src/config/key-store.test.js
index d75d8c2..af7639b 100644
--- a/packages/frai-core/src/config/key-store.test.js
+++ b/packages/frai-core/src/config/key-store.test.js
@@ -54,4 +54,136 @@ describe('config key store', () => {
     const content = fs.readFileSync(configPath, 'utf8');
     expect(JSON.parse(content).OPENAI_API_KEY).toBe('global-key');
   });
+
+  describe('local .env parsing', () => {
+    const writeEnv = (content) => fs.writeFileSync(resolveLocalEnvPath(tmpCwd), content, 'utf8');
+    const readEnv = () => fs.readFileSync(resolveLocalEnvPath(tmpCwd), 'utf8');
+
+    it.each([
+      ['plain', 'OPENAI_API_KEY=sk-1', 'sk-1'],
+      ['export prefix', 'export OPENAI_API_KEY=sk-1', 'sk-1'],
+      ['double quotes', 'OPENAI_API_KEY="sk-1"', 'sk-1'],
+      ['single quotes', "OPENAI_API_KEY='sk-1'", 'sk-1'],
+      ['comment after unquoted value', 'OPENAI_API_KEY=sk-1 # rotated', 'sk-1'],
+      ['comment after closing quote', 'export OPENAI_API_KEY="sk-1" # rotated', 'sk-1'],
+      ['hash inside quotes', 'OPENAI_API_KEY="sk #1"', 'sk #1'],
+      ['spaces around equals', '  OPENAI_API_KEY = sk-1  ', 'sk-1'],
+      ['CRLF line endings', 'A=1\r\nOPENAI_API_KEY=sk-1\r\nB=2\r\n', 'sk-1']
+    ])('reads %s', (_label, content, expected) => {
+      writeEnv(content);
+      expect(getLocalApiKey(tmpCwd)).toBe(expected);
+      expect(hasLocalApiKey(tmpCwd)).toBe(true);
+    });
+
+    it('ignores commented-out definitions and uses the last definition', () => {
+      writeEnv('OPENAI_API_KEY=first\n# OPENAI_API_KEY=commented\nOPENAI_API_KEY=second\n#OPENAI_API_KEY=x\n');
+      expect(getLocalApiKey(tmpCwd)).toBe('second');
+    });
+
+    it.each([
+      ['no key', 'FOO=bar\n'],
+      ['empty value', 'OPENAI_API_KEY=\n'],
+      ['empty quoted value', 'OPENAI_API_KEY="" # none\n'],
+      ['comment-only value', 'OPENAI_API_KEY= # todo\n'],
+      ['commented-out key', '# OPENAI_API_KEY=sk-1\n'],
+      ['empty last definition', 'OPENAI_API_KEY=sk-1\nOPENAI_API_KEY=\n']
+    ])('does not report a key for %s', (_label, content) => {
+      writeEnv(content);
+      expect(getLocalApiKey(tmpCwd)).toBeNull();
+      expect(hasLocalApiKey(tmpCwd)).toBe(false);
+    });
+
+    it('appends the key without touching other lines', () => {
+      const original = '# project settings\n\nFOO=bar\n  export BAZ="q x" # note\n';
+      writeEnv(original);
+      setLocalApiKey('sk-new', tmpCwd);
+      expect(readEnv()).toBe(`${original}OPENAI_API_KEY=sk-new\n`);
+      expect(getLocalApiKey(tmpCwd)).toBe('sk-new');
+    });
+
+    it('terminates a final line lacking a newline before appending', () => {
+      writeEnv('FOO=bar');
+      setLocalApiKey('sk-new', tmpCwd);
+      expect(readEnv()).toBe('FOO=bar\nOPENAI_API_KEY=sk-new\n');
+    });
+
+    it('updates an existing definition in place, keeping export, quotes and comment', () => {
+      writeEnv('A=1\n\n# comment\nexport OPENAI_API_KEY="sk-old" # rotated\nZ=26\n');
+      setLocalApiKey('sk-new', tmpCwd);
+      expect(readEnv()).toBe('A=1\n\n# comment\nexport OPENAI_API_KEY="sk-new" # rotated\nZ=26\n');
+      expect(getLocalApiKey(tmpCwd)).toBe('sk-new');
+    });
+
+    it('updates only the last of duplicate definitions', () => {
+      writeEnv('OPENAI_API_KEY=one\n# OPENAI_API_KEY=commented\nOPENAI_API_KEY=two\nFOO=bar');
+      setLocalApiKey('three', tmpCwd);
+      expect(readEnv()).toBe('OPENAI_API_KEY=one\n# OPENAI_API_KEY=commented\nOPENAI_API_KEY=three\nFOO=bar');
+      expect(getLocalApiKey(tmpCwd)).toBe('three');
+    });
+
+    it('preserves CRLF line endings', () => {
+      writeEnv('A=1\r\nOPENAI_API_KEY=old\r\nB=2\r\n');
+      setLocalApiKey('new', tmpCwd);
+      expect(readEnv()).toBe('A=1\r\nOPENAI_API_KEY=new\r\nB=2\r\n');
+    });
+
+    it('creates a new .env with owner-only permissions', () => {
+      setLocalApiKey('sk-new', tmpCwd);
+      expect(readEnv()).toBe('OPENAI_API_KEY=sk-new\n');
+      if (process.platform !== 'win32') {
+        expect(fs.statSync(resolveLocalEnvPath(tmpCwd)).mode & 0o777).toBe(0o600);
+      }
+    });
+
+    it('rejects empty keys and keys with line breaks', () => {
+      writeEnv('FOO=bar\n');
+      expect(() => setLocalApiKey('', tmpCwd)).toThrow('API key is required');
+      expect(() => setLocalApiKey('   ', tmpCwd)).toThrow('API key is required');
+      expect(() => setLocalApiKey('sk\nEVIL=1', tmpCwd)).toThrow();
+      expect(readEnv()).toBe('FOO=bar\n');
+    });
+  });
+
+  describe('global config', () => {
+    const writeConfig = (content) => {
+      const configPath = resolveGlobalConfigPath(tmpHome);
+      fs.mkdirSync(path.dirname(configPath), { recursive: true });
+      fs.writeFileSync(configPath, content, 'utf8');
+      return configPath;
+    };
+
+    it('keeps other fields when saving the key', () => {
+      const configPath = writeConfig(JSON.stringify({ theme: 'dark', OPENAI_API_KEY: 'old', nested: { a: 1 } }));
+      setGlobalApiKey('new', tmpHome);
+      expect(JSON.parse(fs.readFileSync(configPath, 'utf8'))).toEqual({
+        theme: 'dark',
+        OPENAI_API_KEY: 'new',
+        nested: { a: 1 }
+      });
+    });
+
+    it('fails without modifying a config that is not valid JSON', () => {
+      const configPath = writeConfig('{ not json');
+      expect(() => setGlobalApiKey('new', tmpHome)).toThrow(/not valid JSON/);
+      expect(fs.readFileSync(configPath, 'utf8')).toBe('{ not json');
+    });
+
+    it('only reports a configured key when it is non-empty', () => {
+      writeConfig(JSON.stringify({ theme: 'dark' }));
+      expect(hasGlobalApiKey(tmpHome)).toBe(false);
+      writeConfig(JSON.stringify({ OPENAI_API_KEY: '  ' }));
+      expect(hasGlobalApiKey(tmpHome)).toBe(false);
+      expect(getGlobalApiKey(tmpHome)).toBeNull();
+      writeConfig(JSON.stringify({ OPENAI_API_KEY: 'sk-1' }));
+      expect(hasGlobalApiKey(tmpHome)).toBe(true);
+    });
+
+    it('creates the config with owner-only permissions', () => {
+      const configPath = setGlobalApiKey('sk-1', tmpHome);
+      if (process.platform !== 'win32') {
+        expect(fs.statSync(configPath).mode & 0o777).toBe(0o600);
+        expect(fs.statSync(path.dirname(configPath)).mode & 0o777).toBe(0o700);
+      }
+    });
+  });
 });
