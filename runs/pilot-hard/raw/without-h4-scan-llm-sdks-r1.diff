+import path from 'path';
+
+// Extracts the module specifiers a source file imports. Sources are tokenized
+// (strings, comments, template literals) rather than grepped, so commented-out
+// imports and import-like text inside string literals are ignored.
+
+const PYTHON_EXTENSIONS = new Set(['.py', '.pyw']);
+const R_EXTENSIONS = new Set(['.r', '.rmd']);
+const JVM_EXTENSIONS = new Set(['.java', '.scala']);
+
+const IDENTIFIER_START = /[A-Za-z_$-￿]/;
+const IDENTIFIER_PART = /[\w$-￿]/;
+
+// Tokens after which a `/` starts a regular expression literal rather than a division.
+const REGEX_PRECEDING_KEYWORDS = new Set([
+  'return', 'typeof', 'instanceof', 'in', 'of', 'new', 'delete', 'void',
+  'throw', 'case', 'do', 'else', 'yield', 'await'
+]);
+
+const readQuoted = (source, start, quote) => {
+  let value = '';
+  let i = start + 1;
+  while (i < source.length) {
+    const char = source[i];
+    if (char === '\\') {
+      value += source[i + 1] ?? '';
+      i += 2;
+      continue;
+    }
+    if (char === quote) return { value, end: i + 1 };
+    // Unterminated single-line string: stop at the line break.
+    if (char === '\n') return { value, end: i };
+    value += char;
+    i += 1;
+  }
+  return { value, end: i };
+};
+
+const readIdentifier = (source, start) => {
+  let i = start + 1;
+  while (i < source.length && IDENTIFIER_PART.test(source[i])) i += 1;
+  return { value: source.slice(start, i), end: i };
+};
+
+/**
+ * Tokenizes C-family source (JavaScript, TypeScript, Java, Scala).
+ * Produces identifiers, string literals and single-character punctuators.
+ */
+export const tokenizeCLike = (source) => {
+  const tokens = [];
+  // Brace depth of each open `${` substitution, innermost last.
+  const templateStack = [];
+  let braceDepth = 0;
+  let i = 0;
+
+  const last = () => tokens[tokens.length - 1];
+
+  const regexAllowed = () => {
+    const prev = last();
+    if (!prev) return true;
+    if (prev.type === 'string' || prev.type === 'template') return false;
+    if (prev.type === 'identifier') return REGEX_PRECEDING_KEYWORDS.has(prev.value);
+    return ![')', ']', '}'].includes(prev.value);
+  };
+
+  // Reads template literal text from `start` (just after the opening backtick or
+  // closing `}` of a substitution) until the closing backtick or the next `${`.
+  const readTemplate = (start, continued) => {
+    let value = '';
+    let j = start;
+    while (j < source.length) {
+      const char = source[j];
+      if (char === '\\') {
+        value += source[j + 1] ?? '';
+        j += 2;
+        continue;
+      }
+      if (char === '`') {
+        tokens.push({ type: 'template', value, complete: !continued });
+        return j + 1;
+      }
+      if (char === '$' && source[j + 1] === '{') {
+        tokens.push({ type: 'template', value, complete: false });
+        templateStack.push(braceDepth);
+        return j + 2;
+      }
+      value += char;
+      j += 1;
+    }
+    tokens.push({ type: 'template', value, complete: false });
+    return j;
+  };
+
+  while (i < source.length) {
+    const char = source[i];
+    const next = source[i + 1];
+
+    if (/\s/.test(char)) {
+      i += 1;
+    } else if (char === '/' && next === '/') {
+      const end = source.indexOf('\n', i);
+      i = end === -1 ? source.length : end;
+    } else if (char === '/' && next === '*') {
+      const end = source.indexOf('*/', i + 2);
+      i = end === -1 ? source.length : end + 2;
+    } else if (char === '"' || char === "'") {
+      const { value, end } = readQuoted(source, i, char);
+      tokens.push({ type: 'string', value });
+      i = end;
+    } else if (char === '`') {
+      i = readTemplate(i + 1, false);
+    } else if (char === '/' && regexAllowed()) {
+      // Regular expression literal; they cannot span lines, so a missing
+      // terminator means this was a plain punctuator after all.
+      let j = i + 1;
+      let inClass = false;
+      while (j < source.length && source[j] !== '\n') {
+        if (source[j] === '\\') j += 1;
+        else if (source[j] === '[') inClass = true;
+        else if (source[j] === ']') inClass = false;
+        else if (source[j] === '/' && !inClass) break;
+        j += 1;
+      }
+      if (source[j] === '/') {
+        j += 1;
+        while (j < source.length && IDENTIFIER_PART.test(source[j])) j += 1;
+        tokens.push({ type: 'regex' });
+        i = j;
+      } else {
+        tokens.push({ type: 'punct', value: char });
+        i += 1;
+      }
+    } else if (IDENTIFIER_START.test(char)) {
+      const { value, end } = readIdentifier(source, i);
+      tokens.push({ type: 'identifier', value });
+      i = end;
+    } else if (/[0-9]/.test(char)) {
+      let j = i + 1;
+      while (j < source.length && /[\w.]/.test(source[j])) j += 1;
+      tokens.push({ type: 'number' });
+      i = j;
+    } else if (char === '{') {
+      braceDepth += 1;
+      tokens.push({ type: 'punct', value: char });
+      i += 1;
+    } else if (char === '}') {
+      if (templateStack.length && templateStack[templateStack.length - 1] === braceDepth) {
+        templateStack.pop();
+        i = readTemplate(i + 1, true);
+      } else {
+        braceDepth = Math.max(0, braceDepth - 1);
+        tokens.push({ type: 'punct', value: char });
+        i += 1;
+      }
+    } else {
+      tokens.push({ type: 'punct', value: char });
+      i += 1;
+    }
+  }
+
+  return tokens;
+};
+
+/**
+ * Tokenizes Python source. Produces identifiers, string literals, punctuators and
+ * `newline` tokens marking the end of logical lines.
+ */
+export const tokenizePython = (source) => {
+  const tokens = [];
+  let bracketDepth = 0;
+  let i = 0;
+
+  while (i < source.length) {
+    const char = source[i];
+
+    if (char === '\n') {
+      if (bracketDepth === 0) tokens.push({ type: 'newline' });
+      i += 1;
+    } else if (char === '\\' && source[i + 1] === '\n') {
+      i += 2;
+    } else if (/\s/.test(char)) {
+      i += 1;
+    } else if (char === '#') {
+      const end = source.indexOf('\n', i);
+      i = end === -1 ? source.length : end;
+    } else if (char === '"' || char === "'") {
+      const triple = source.startsWith(char.repeat(3), i);
+      if (triple) {
+        const delimiter = char.repeat(3);
+        let j = i + 3;
+        while (j < source.length && !source.startsWith(delimiter, j)) {
+          j += source[j] === '\\' ? 2 : 1;
+        }
+        tokens.push({ type: 'string', value: source.slice(i + 3, j) });
+        i = Math.min(source.length, j + 3);
+      } else {
+        const { value, end } = readQuoted(source, i, char);
+        tokens.push({ type: 'string', value });
+        i = end;
+      }
+    } else if (IDENTIFIER_START.test(char)) {
+      const { value, end } = readIdentifier(source, i);
+      tokens.push({ type: 'identifier', value });
+      i = end;
+    } else if (/[0-9]/.test(char)) {
+      let j = i + 1;
+      while (j < source.length && /[\w.]/.test(source[j])) j += 1;
+      tokens.push({ type: 'number' });
+      i = j;
+    } else {
+      if ('([{'.includes(char)) bracketDepth += 1;
+      if (')]}'.includes(char)) bracketDepth = Math.max(0, bracketDepth - 1);
+      tokens.push({ type: 'punct', value: char });
+      i += 1;
+    }
+  }
+
+  return tokens;
+};
+
+const isPunct = (token, value) => token?.type === 'punct' && token.value === value;
+const isIdentifier = (token, value) =>
+  token?.type === 'identifier' && (value === undefined || token.value === value);
+const isStaticString = (token) =>
+  token?.type === 'string' || (token?.type === 'template' && token.complete);
+
+// Reads `a.b.c` starting at `start`; `allowRelative` accepts leading dots.
+const readDottedName = (tokens, start, { allowRelative = false } = {}) => {
+  let i = start;
+  let prefix = '';
+  while (allowRelative && isPunct(tokens[i], '.')) {
+    prefix += '.';
+    i += 1;
+  }
+  if (!isIdentifier(tokens[i])) {
+    return prefix ? { name: prefix, end: i } : null;
+  }
+  const parts = [tokens[i].value];
+  i += 1;
+  while (isPunct(tokens[i], '.') && isIdentifier(tokens[i + 1])) {
+    parts.push(tokens[i + 1].value);
+    i += 2;
+  }
+  return { name: prefix + parts.join('.'), end: i };
+};
+
+export const extractJavaScriptImports = (source) => {
+  const tokens = tokenizeCLike(source);
+  const modules = [];
+
+  tokens.forEach((token, index) => {
+    if (token.type !== 'identifier') return;
+    const next = tokens[index + 1];
+    const previous = tokens[index - 1];
+    const memberAccess = isPunct(previous, '.') && !isPunct(tokens[index - 2], '.');
+
+    if (token.value === 'from' && isStaticString(next)) {
+      // `import … from '…'` and `export … from '…'`
+      modules.push(next.value);
+    } else if (token.value === 'import' && isStaticString(next) && !memberAccess) {
+      // `import '…'`
+      modules.push(next.value);
+    } else if (
+      (token.value === 'import' || token.value === 'require') &&
+      !memberAccess &&
+      isPunct(next, '(') &&
+      isStaticString(tokens[index + 2])
+    ) {
+      // `import('…')` and `require('…')`
+      modules.push(tokens[index + 2].value);
+    }
+  });
+
+  return modules;
+};
+
+export const extractJvmImports = (source) => {
+  const tokens = tokenizeCLike(source);
+  const modules = [];
+  tokens.forEach((token, index) => {
+    if (!isIdentifier(token, 'import')) return;
+    let start = index + 1;
+    if (isIdentifier(tokens[start], 'static')) start += 1;
+    const dotted = readDottedName(tokens, start);
+    if (dotted) modules.push(dotted.name);
+  });
+  return modules;
+};
+
+export const extractPythonImports = (source) => {
+  const tokens = tokenizePython(source);
+  const modules = [];
+
+  tokens.forEach((token, index) => {
+    if (token.type !== 'identifier') return;
+    if (isPunct(tokens[index - 1], '.')) return;
+
+    if (token.value === 'import') {
+      // `import a, b.c as d`; the `import` of `from … import …` is handled below.
+      if (isIdentifier(tokens[findStatementStart(tokens, index)], 'from')) return;
+      let i = index + 1;
+      while (true) {
+        const dotted = readDottedName(tokens, i);
+        if (!dotted) break;
+        i = dotted.end;
+        modules.push(dotted.name);
+        if (isIdentifier(tokens[i], 'as') && isIdentifier(tokens[i + 1])) i += 2;
+        if (!isPunct(tokens[i], ',')) break;
+        i += 1;
+      }
+    } else if (token.value === 'from') {
+      // `from pkg.sub import x, y` — `raise … from …` and `yield from …` have no `import`.
+      const dotted = readDottedName(tokens, index + 1, { allowRelative: true });
+      if (!dotted || !isIdentifier(tokens[dotted.end], 'import')) return;
+      if (dotted.name.startsWith('.')) return;
+      modules.push(dotted.name);
+
+      let i = dotted.end + 1;
+      if (isPunct(tokens[i], '(')) i += 1;
+      while (isIdentifier(tokens[i])) {
+        modules.push(`${dotted.name}.${tokens[i].value}`);
+        i += 1;
+        if (isIdentifier(tokens[i], 'as') && isIdentifier(tokens[i + 1])) i += 2;
+        if (!isPunct(tokens[i], ',')) break;
+        i += 1;
+      }
+    } else if (
+      (token.value === '__import__' || token.value === 'import_module') &&
+      isPunct(tokens[index + 1], '(') &&
+      tokens[index + 2]?.type === 'string'
+    ) {
+      modules.push(tokens[index + 2].value);
+    }
+  });
+
+  return modules;
+};
+
+function findStatementStart(tokens, index) {
+  let i = index;
+  while (i > 0 && tokens[i - 1].type !== 'newline' && !isPunct(tokens[i - 1], ';')) {
+    i -= 1;
+  }
+  return i;
+}
+
+export const extractRImports = (source) => {
+  const modules = [];
+  const pattern = /\b(?:library|require|requireNamespace)\s*\(\s*(['"]?)([A-Za-z][\w.]*)\1/g;
+  for (const rawLine of source.split('\n')) {
+    const line = stripRComment(rawLine);
+    for (const match of line.matchAll(pattern)) {
+      modules.push(match[2]);
+    }
+    for (const match of line.matchAll(/\b([A-Za-z][\w.]*):::?[A-Za-z.]/g)) {
+      modules.push(match[1]);
+    }
+  }
+  return modules;
+};
+
+function stripRComment(line) {
+  let quote = null;
+  for (let i = 0; i < line.length; i += 1) {
+    const char = line[i];
+    if (quote) {
+      if (char === '\\') i += 1;
+      else if (char === quote) quote = null;
+    } else if (char === '"' || char === "'") {
+      quote = char;
+    } else if (char === '#') {
+      return line.slice(0, i);
+    }
+  }
+  return line;
+}
+
+const notebookSource = (content) => {
+  try {
+    const notebook = JSON.parse(content);
+    if (!Array.isArray(notebook?.cells)) return null;
+    return notebook.cells
+      .filter((cell) => cell.cell_type === 'code')
+      .map((cell) => (Array.isArray(cell.source) ? cell.source.join('') : String(cell.source ?? '')))
+      // IPython magics and shell escapes are not Python syntax.
+      .map((code) => code.replace(/^\s*[!%].*$/gm, ''))
+      .join('\n');
+  } catch {
+    return null;
+  }
+};
+
+/**
+ * Returns the module specifiers imported by a file, choosing the syntax from its
+ * extension. Relative imports are dropped.
+ */
+export const extractImports = (content, filePath = '') => {
+  const ext = path.extname(filePath).toLowerCase();
+  let modules;
+
+  if (PYTHON_EXTENSIONS.has(ext)) {
+    modules = extractPythonImports(content);
+  } else if (ext === '.ipynb') {
+    modules = extractPythonImports(notebookSource(content) ?? content);
+  } else if (R_EXTENSIONS.has(ext)) {
+    modules = extractRImports(content);
+  } else if (JVM_EXTENSIONS.has(ext)) {
+    modules = extractJvmImports(content);
+  } else {
+    // JavaScript/TypeScript, and the fallback for custom extension lists.
+    modules = extractJavaScriptImports(content);
+  }
+
+  return modules
+    .map((specifier) => specifier.trim())
+    .filter((specifier) => specifier && !specifier.startsWith('.') && !specifier.startsWith('/'));
+};
+
+/**
+ * Whether `specifier` is `library` itself or one of its sub-modules
+ * (`openai/resources`, `@langchain/openai`, `torch.nn`).
+ */
+export const moduleMatchesLibrary = (specifier, library) =>
+  specifier === library ||
+  specifier.startsWith(`${library}/`) ||
+  specifier.startsWith(`${library}.`);
