+describe('scanCodebase with LLM applications', () => {
+  let tmpDir;
+
+  afterEach(() => {
+    if (tmpDir) fs.rmSync(tmpDir, { recursive: true, force: true });
+    tmpDir = undefined;
+  });
+
+  it('detects the OpenAI-backed support triage demo', () => {
+    const result = scanCodebase({ root: DEMO_DIR });
+    const triage = path.join(DEMO_DIR, 'src', 'triage.js');
+    expect(result.aiFiles).toContain(triage);
+    expect(result.aiLibraryMatches[triage]).toEqual(['openai']);
+  });
+
+  it('scans .mjs, .cjs, .mts and .cts files', () => {
+    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-scan-ext-'));
+    const files = {
+      'a.mjs': "import OpenAI from 'openai';",
+      'b.cjs': "const Anthropic = require('@anthropic-ai/sdk');",
+      'c.mts': "import { ChatOpenAI } from '@langchain/openai';",
+      'd.cts': "import Anthropic = require('@anthropic-ai/sdk');"
+    };
+    for (const [name, content] of Object.entries(files)) {
+      fs.writeFileSync(path.join(tmpDir, name), content);
+    }
+
+    const result = scanCodebase({ root: tmpDir });
+
+    expect(result.totalFiles).toBe(4);
+    expect(result.aiLibraryMatches).toEqual({
+      [path.join(tmpDir, 'a.mjs')]: ['openai'],
+      [path.join(tmpDir, 'b.cjs')]: ['@anthropic-ai/sdk'],
+      [path.join(tmpDir, 'c.mts')]: ['@langchain'],
+      [path.join(tmpDir, 'd.cts')]: ['@anthropic-ai/sdk']
+    });
+  });
+
+  it('throws when the root directory does not exist', () => {
+    const missing = path.join(os.tmpdir(), 'frai-scan-does-not-exist-9f2c');
+    expect(() => scanCodebase({ root: missing })).toThrow(/Cannot scan/);
+  });
+});
