+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { fileURLToPath } from 'url';
+
+import { createLibraryDetector } from './detectors.js';
+import { extractImports } from './imports.js';
+import { scanCodebase } from './index.js';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+const DEMO_DIR = path.resolve(__dirname, '../../../../examples/support-triage-demo');
+
+const detect = (filePath, content, libraries) => {
+  const result = { aiLibraryMatches: {}, aiFiles: [], markAiFile: (file) => result.aiFiles.push(file) };
+  createLibraryDetector(libraries).analyze({ filePath, content, result });
+  return result.aiLibraryMatches[filePath] ?? [];
+};
+
+describe('library detector: JavaScript/TypeScript', () => {
+  it.each([
+    ["import OpenAI from 'openai';", ['openai']],
+    ['import Anthropic from "@anthropic-ai/sdk";', ['@anthropic-ai/sdk']],
+    ["import type { MessageParam } from '@anthropic-ai/sdk/resources';", ['@anthropic-ai/sdk']],
+    ["import {\n  ChatOpenAI,\n  OpenAIEmbeddings,\n} from '@langchain/openai';", ['@langchain']],
+    ["import '@langchain/core';", ['@langchain']],
+    ["export { ChatAnthropic } from '@langchain/anthropic';", ['@langchain']],
+    ["export * from 'langchain/chains';", ['langchain']],
+    ["const OpenAI = require('openai');", ['openai']],
+    ['const { OpenAI } = require ( "openai/resources" );', ['openai']],
+    ["const sdk = await import('@anthropic-ai/sdk');", ['@anthropic-ai/sdk']],
+    ['const sdk = await import(`openai`);', ['openai']],
+    ["import * as tf from '@tensorflow/tfjs';", ['@tensorflow']]
+  ])('detects %j', (content, expected) => {
+    expect(detect('/repo/src/file.mts', content)).toEqual(expected);
