@@ -0,0 +1,182 @@
+import fs from 'fs';
+import os from 'os';
+import path from 'path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { fileURLToPath } from 'url';
+
+import { createLibraryDetector } from './detectors.js';
+import { extractImports } from './imports.js';
+import { scanCodebase } from './index.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const EXAMPLES_DIR = path.resolve(__dirname, '../../../../examples');
+
+const detect = (filePath, content, detector = createLibraryDetector()) => {
+  const result = { aiLibraryMatches: {}, aiFiles: [], markAiFile: (file) => result.aiFiles.push(file) };
+  detector.analyze({ filePath, content, result });
+  return result.aiLibraryMatches[filePath] ?? [];
+};
+
+describe('library detector: JavaScript / TypeScript', () => {
+  it.each([
+    ["import OpenAI from 'openai';", ['openai']],
+    ['import type { Message } from "@anthropic-ai/sdk";', ['@anthropic-ai/sdk']],
+    ["import {\n  ChatOpenAI,\n  OpenAIEmbeddings,\n} from '@langchain/openai';", ['@langchain']],
+    ["import 'openai/shims/node';", ['openai']],
+    ["export { ChatAnthropic } from '@langchain/anthropic';", ['@langchain']],
+    ["export * from 'langchain/tools';", ['langchain']],
+    ["const OpenAI = require('openai');", ['openai']],
+    ["const { Anthropic } = await import('@anthropic-ai/sdk');", ['@anthropic-ai/sdk']],
+    ["import * as tf from '@tensorflow/tfjs';", ['@tensorflow']],
+    ["import { Completions } from 'openai/resources';", ['openai']]
+  ])('detects %j', (content, expected) => {
+    expect(detect('src/app.ts', content)).toEqual(expected);
+  });
+
+  it.each([
+    "import mock from 'openai-mock';",
+    "import { client } from './openai';",
+    "import { client } from '../anthropic/index.js';",
+    "// import OpenAI from 'openai';",
+    "/*\nimport OpenAI from 'openai';\n*/",
+    "import sdk from '@anthropic-ai/sdk-extras';",
+    "import caretaker from 'caretaker';"
+  ])('ignores %j', (content) => {
+    expect(detect('src/app.ts', content)).toEqual([]);
+  });
+
+  it('ignores import statements that only appear inside string literals', () => {
+    const content = [
+      "const fixture = \"import OpenAI from 'openai';\";",
+      "const snippet = `const Anthropic = require('@anthropic-ai/sdk');`;",
+      "const docs = 'export * from \"langchain\"';"
+    ].join('\n');
+    expect(detect('src/fixtures.test.js', content)).toEqual([]);
+  });
+
+  it('keeps string literals that contain comment markers', () => {
+    const content = "const url = 'https://api.example.com';\nimport OpenAI from 'openai';";
+    expect(detect('src/app.mjs', content)).toEqual(['openai']);
+  });
+
+  it('reports each library once per file', () => {
+    const content = [
+      "import { ChatOpenAI } from '@langchain/openai';",
+      "import { ChatAnthropic } from '@langchain/anthropic';",
+      "import OpenAI from 'openai';",
+      "const again = require('openai');"
+    ].join('\n');
+    expect(detect('src/app.cts', content)).toEqual(['openai', '@langchain']);
+  });
+});
+
+describe('library detector: Python', () => {
+  it.each([
+    ['import openai', ['openai']],
+    ['import os, anthropic as claude', ['anthropic']],
+    ['import torch.nn as nn', ['torch']],
+    ['from torch.nn import functional as F', ['torch']],
+    ['from langchain.chat_models import ChatOpenAI', ['langchain']],
+    ['from sklearn.ensemble import (\n    RandomForestClassifier,\n)', ['sklearn']]
+  ])('detects %j', (content, expected) => {
+    expect(detect('app.py', content)).toEqual(expected);
+  });
+
+  it.each([
+    'import caretaker',
+    'import openai_mock',
+    'from .openai import client',
+    'from . import anthropic',
+    '# import openai',
+    '"""\nimport openai\n"""'
+  ])('ignores %j', (content) => {
+    expect(detect('app.py', content)).toEqual([]);
+  });
+
+  it('detects importlib and ignores imports inside strings', () => {
+    const content = "prompt = 'import anthropic'\nclient = importlib.import_module('openai')";
+    expect(detect('app.py', content)).toEqual(['openai']);
+  });
+
+  it('reads code cells of notebooks', () => {
+    const notebook = JSON.stringify({
+      cells: [
+        { cell_type: 'markdown', source: ['import anthropic'] },
+        { cell_type: 'code', source: ['import openai\n', 'client = openai.OpenAI()'] }
+      ]
+    });
+    expect(detect('analysis.ipynb', notebook)).toEqual(['openai']);
+  });
+});
+
+describe('createLibraryDetector with custom libraries', () => {
+  it('matches only the provided libraries', () => {
+    const detector = createLibraryDetector(['express', '@acme']);
+    const content = "import express from 'express';\nimport { a } from '@acme/ai';\nimport OpenAI from 'openai';";
+    expect(detect('server.js', content, detector)).toEqual(['express', '@acme']);
+  });
+});
+
+describe('library detector: R and JVM', () => {
+  it('detects R packages loaded with library() or referenced with ::', () => {
+    expect(detect('model.R', 'library(caret)\n# library(nnet)\nrpart::rpart(y ~ x)')).toEqual(['caret', 'rpart']);
+  });
+
+  it('detects Java imports', () => {
+    const detector = createLibraryDetector(['com.openai']);
+    expect(detect('App.java', 'import com.openai.client.OpenAIClient;', detector)).toEqual(['com.openai']);
+  });
+});
+
+describe('extractImports', () => {
+  it('uses sub-module separators that fit the language', () => {
+    expect(extractImports('import torch.nn', 'model.py')).toEqual({ modules: ['torch.nn'], separators: ['.'] });
+    expect(extractImports("import x from 'openai/resources'", 'a.mts').separators).toEqual(['/']);
+  });
+});
+
+describe('scanCodebase with LLM applications', () => {
+  let tmpDir;
+
+  afterEach(() => {
+    if (tmpDir) fs.rmSync(tmpDir, { recursive: true, force: true });
+    tmpDir = undefined;
+  });
+
+  it('detects the OpenAI-backed support triage demo', () => {
+    const root = path.join(EXAMPLES_DIR, 'support-triage-demo');
+    const results = scanCodebase({ root });
+    const triage = path.join(root, 'src', 'triage.js');
+
+    expect(results.aiFiles).toContain(triage);
+    expect(results.aiLibraryMatches[triage]).toEqual(['openai']);
+  });
+
+  it('scans .mts/.cts/.mjs/.cjs sources', () => {
+    tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'frai-scan-llm-'));
+    const files = {
+      'client.mts': "import Anthropic from '@anthropic-ai/sdk';",
+      'chain.cts': "import { ChatOpenAI } from '@langchain/openai';",
+      'legacy.cjs': "const OpenAI = require('openai');",
+      'worker.mjs': "const { ChatAnthropic } = await import('@langchain/anthropic');"
+    };
+    for (const [name, content] of Object.entries(files)) {
+      fs.writeFileSync(path.join(tmpDir, name), content);
+    }
+
+    const results = scanCodebase({ root: tmpDir });
+
+    expect(results.totalFiles).toBe(4);
+    expect(results.aiLibraryMatches).toEqual({
+      [path.join(tmpDir, 'client.mts')]: ['@anthropic-ai/sdk'],
+      [path.join(tmpDir, 'chain.cts')]: ['@langchain'],
+      [path.join(tmpDir, 'legacy.cjs')]: ['openai'],
+      [path.join(tmpDir, 'worker.mjs')]: ['@langchain']
+    });
+  });
+
+  it('throws when the root directory does not exist', () => {
+    const missing = path.join(os.tmpdir(), 'frai-scan-does-not-exist-', String(process.pid));
+    expect(() => scanCodebase({ root: missing })).toThrow(/Cannot scan/);
+  });
+});
diff --git a/packages/frai-core/src/scanners/imports.js b/packages/frai-core/src/scanners/imports.js
new file mode 100644
index 0000000..285bb30
--- /dev/null
+++ b/packages/frai-core/src/scanners/imports.js
@@ -0,0 +1,168 @@
+import path from 'path';
+
+const JS_EXTENSIONS = ['.js', '.jsx', '.ts', '.tsx', '.mjs', '.cjs', '.mts', '.cts'];
+const PYTHON_EXTENSIONS = ['.py'];
+const NOTEBOOK_EXTENSIONS = ['.ipynb'];
+const R_EXTENSIONS = ['.r', '.rmd'];
+const JVM_EXTENSIONS = ['.java', '.scala'];
+
+const C_STYLE_TOKENS =
+  /("(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*'|`(?:\\.|[^`\\])*`)|\/\*[\s\S]*?\*\/|\/\/[^\n]*/g;
+const HASH_TOKENS = /("""[\s\S]*?"""|'''[\s\S]*?'''|"(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*')|#[^\n]*/g;
+
+// String literals are replaced by MARK<index>MARK; MARK is a NUL character, which source code never contains.
+const MARK = String.fromCharCode(0);
+const STRING = '\\u0000(?<literal>\\d+)\\u0000';
+
+/**
+ * Blanks out comments and replaces each string literal with a numbered placeholder, so
+ * import-looking text inside comments or strings is never mistaken for an import.
+ */
+const tokenize = (content, pattern) => {
+  const literals = [];
+  const code = content.replace(pattern, (match, literal) => {
+    if (literal === undefined) return match.replace(/[^\n]/g, ' ');
+    literals.push(literal.replace(/^("""|'''|["'`])([\s\S]*)\1$/, '$2'));
+    return `${MARK}${literals.length - 1}${MARK}`;
+  });
+  return { code, literals };
+};
+
+const toSpecifier = (literals, index) => {
+  const value = literals[Number(index)]?.trim();
+  return value && !/\s|\$\{/.test(value) ? value : null;
+};
+
+// Collects the `literal` (placeholder index) or `name` (bare identifier) group of each match.
+const collect = ({ code, literals }, pattern, into) => {
+  for (const { groups = {} } of code.matchAll(pattern)) {
+    const specifier = groups.literal !== undefined ? toSpecifier(literals, groups.literal) : groups.name;
+    if (specifier) into.push(specifier);
+  }
+  return into;
+};
+
+// Static imports and re-exports must start a statement: a line, or follow `;` / `}`.
+const STATEMENT_START = '(?<=(?:^|[;}])[ \\t]*)';
+
+const JS_PATTERNS = [
+  // import x from '…', import type { X } from '…', import {\n a,\n b } from '…', export * from '…'
+  new RegExp(`${STATEMENT_START}(?:import|export)\\s[^\\u0000;]*?\\bfrom\\s*${STRING}`, 'gm'),
+  // import '…'
+  new RegExp(`${STATEMENT_START}import\\s*${STRING}`, 'gm'),
+  // require('…'), import('…')
+  new RegExp(`(?<![\\w$.])(?:require|import)\\s*\\(\\s*${STRING}\\s*[,)]`, 'g')
+];
+
+export function extractJsImports(content) {
+  const tokens = tokenize(content, C_STYLE_TOKENS);
+  const specifiers = [];
+  for (const pattern of JS_PATTERNS) {
+    collect(tokens, pattern, specifiers);
+  }
+  return specifiers;
+}
+
+export function extractPythonImports(content) {
+  const tokens = tokenize(content, HASH_TOKENS);
+  const code = tokens.code.replace(/\\\r?\n/g, ' ');
+  const specifiers = [];
+  for (const line of code.split(/\r?\n/)) {
+    for (const statement of line.split(';')) {
+      const fromMatch = statement.match(/^\s*from\s+([\w.]+)\s+import\b/);
+      if (fromMatch) {
+        specifiers.push(fromMatch[1]);
+        continue;
+      }
+      const importMatch = statement.match(/^\s*import\s+(.+)$/);
+      if (importMatch) {
+        for (const item of importMatch[1].split(',')) {
+          const name = item.trim().split(/\s+as\s+/)[0].trim();
+          if (/^[A-Za-z_][\w.]*$/.test(name)) specifiers.push(name);
+        }
+      }
+    }
+  }
+  // importlib.import_module('…'), __import__('…')
+  collect(
+    { code, literals: tokens.literals },
+    new RegExp(`(?<!\\w)(?:import_module|__import__)\\s*\\(\\s*${STRING}`, 'g'),
+    specifiers
+  );
+  return specifiers;
+}
+
+export function extractNotebookImports(content) {
+  let notebook;
+  try {
+    notebook = JSON.parse(content);
+  } catch {
+    return extractPythonImports(content);
+  }
+  const cells = Array.isArray(notebook?.cells) ? notebook.cells : [];
+  const source = cells
+    .filter((cell) => cell?.cell_type === 'code')
+    .map((cell) => (Array.isArray(cell.source) ? cell.source.join('') : String(cell.source ?? '')))
+    .join('\n');
+  return extractPythonImports(source);
+}
+
+export function extractRImports(content) {
+  const tokens = tokenize(content, HASH_TOKENS);
+  const specifiers = [];
+  // library(caret), require("caret"), requireNamespace('caret')
+  collect(
+    tokens,
+    new RegExp(
+      `(?<![\\w.])(?:library|require|requireNamespace)\\s*\\(\\s*(?:${STRING}|(?<name>[A-Za-z][\\w.]*))`,
+      'g'
+    ),
+    specifiers
+  );
+  // caret::train
+  collect(tokens, /(?<![\w.])(?<name>[A-Za-z][\w.]*):::?/g, specifiers);
+  return specifiers;
+}
+
+export function extractJvmImports(content) {
+  const tokens = tokenize(content, C_STYLE_TOKENS);
+  return collect(tokens, /^\s*import\s+(?:static\s+)?(?<name>[\w.]+)/gm, []);
+}
+
+const LANGUAGES = [
+  { extensions: JS_EXTENSIONS, extract: extractJsImports, separators: ['/'] },
+  { extensions: PYTHON_EXTENSIONS, extract: extractPythonImports, separators: ['.'] },
+  { extensions: NOTEBOOK_EXTENSIONS, extract: extractNotebookImports, separators: ['.'] },
+  { extensions: R_EXTENSIONS, extract: extractRImports, separators: [] },
+  { extensions: JVM_EXTENSIONS, extract: extractJvmImports, separators: ['.'] }
+];
+
+const FALLBACK_LANGUAGE = {
