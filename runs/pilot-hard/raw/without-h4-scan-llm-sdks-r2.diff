+export function moduleMatchesLibrary(moduleName, library, separators = ['/', '.']) {
+  const specifier = moduleName.toLowerCase();
+  const name = String(library).toLowerCase();
+  if (!name) return false;
+  if (specifier === name) return true;
+  return separators.some((separator) => specifier.startsWith(`${name}${separator}`));
