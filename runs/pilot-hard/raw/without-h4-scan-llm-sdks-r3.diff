@@ -1,3 +1,5 @@
+import path from 'path';
+
 import {
   DEFAULT_AI_FUNCTIONS,
   DEFAULT_AI_LIBRARIES
@@ -10,12 +12,164 @@ const uniqPush = (store, key, value) => {
   }
 };
 
+const JS_EXTENSIONS = ['.js', '.jsx', '.ts', '.tsx', '.mjs', '.cjs', '.mts', '.cts'];
+const PYTHON_EXTENSIONS = ['.py', '.ipynb'];
+const R_EXTENSIONS = ['.r', '.rmd'];
+
+// Removes // and /* */ comments while leaving string contents (module specifiers) intact.
+const stripJsComments = (source) => {
+  let output = '';
+  let quote = null;
+  let i = 0;
+
+  while (i < source.length) {
+    const char = source[i];
+    const next = source[i + 1];
+
+    if (char === '\\') {
+      output += char + (next ?? '');
+      i += 2;
+      continue;
+    }
+
+    if (quote) {
+      output += char;
+      if (char === quote || (char === '\n' && quote !== '`')) {
+        quote = null;
+      }
+      i += 1;
+      continue;
+    }
+
+    if (char === '/' && next === '/') {
+      const end = source.indexOf('\n', i);
+      i = end === -1 ? source.length : end;
+      continue;
+    }
+
+    if (char === '/' && next === '*') {
+      const end = source.indexOf('*/', i + 2);
+      const comment = source.slice(i, end === -1 ? source.length : end + 2);
+      // Keep line breaks so statements on either side of the comment stay separated.
+      output += comment.replace(/[^\n]/g, ' ');
+      i += comment.length;
+      continue;
+    }
+
+    if (char === '\'' || char === '"' || char === '`') {
+      quote = char;
+    }
+    output += char;
+    i += 1;
+  }
+
+  return output;
+};
+
+const JS_IMPORT_PATTERNS = [
+  // import x from '…', import type { x } from '…', import x, * as y from '…' (bindings may span lines)
+  /(?<![\w$.])import\s+(?:type\s+)?(?:[\w$]+\s*,?\s*)?(?:\*\s*as\s+[\w$]+|\{[^}]*\})?\s*from\s*(['"])([^'"\n]+)\1/g,
+  // import '…'
+  /(?<![\w$.])import\s*(['"])([^'"\n]+)\1/g,
+  // export * from '…', export { x } from '…', export type { x } from '…'
+  /(?<![\w$.])export\s+(?:type\s+)?(?:\*(?:\s*as\s+[\w$]+)?|\{[^}]*\})\s*from\s*(['"])([^'"\n]+)\1/g,
+  // require('…'), import('…')
+  /(?<![\w$.])(?:require|import)\s*\(\s*(['"`])([^'"`\n]+)\1/g
+];
+
+const extractJsModules = (content) => {
+  const source = stripJsComments(content);
+  const modules = [];
+  for (const pattern of JS_IMPORT_PATTERNS) {
+    for (const match of source.matchAll(pattern)) {
+      modules.push(match[2].trim());
+    }
+  }
+  return modules;
+};
+
+const readNotebookSource = (content) => {
+  try {
+    const notebook = JSON.parse(content);
+    return (notebook.cells ?? [])
+      .filter((cell) => cell.cell_type === 'code')
+      .map((cell) => (Array.isArray(cell.source) ? cell.source.join('') : String(cell.source ?? '')))
+      .join('\n');
+  } catch {
+    return content;
+  }
+};
+
+const extractPythonModules = (content) => {
+  const modules = [];
+  const statements = content
+    .replace(/\\\r?\n/g, ' ')
+    .split(/\r?\n/)
+    .flatMap((line) => line.replace(/#.*$/, '').split(';'));
+
+  for (const statement of statements) {
+    const fromMatch = statement.match(/^\s*from\s+([\w.]+)\s+import\b/);
+    if (fromMatch) {
+      modules.push(fromMatch[1]);
+      continue;
+    }
+    const importMatch = statement.match(/^\s*import\s+(.+)$/);
+    if (importMatch) {
+      // import a, b.c as d
+      const parts = importMatch[1].split(',').map((part) => part.trim().match(/^([\w.]+)(?:\s+as\s+\w+)?$/));
+      if (parts.every(Boolean)) {
+        modules.push(...parts.map((part) => part[1]));
+      }
+    }
+  }
+
+  return modules;
+};
+
+const extractRModules = (content) => {
+  const source = content.replace(/#.*$/gm, '');
+  const pattern = /(?<![\w.])(?:library|require|requireNamespace)\s*\(\s*['"]?([\w.]+)['"]?/g;
+  return [...source.matchAll(pattern)].map((match) => match[1]);
+};
+
+const extractModules = (content, filePath) => {
+  const ext = path.extname(filePath).toLowerCase();
+  if (JS_EXTENSIONS.includes(ext)) {
+    return { modules: extractJsModules(content), separators: ['/'] };
+  }
+  if (ext === '.ipynb') {
+    return { modules: extractPythonModules(readNotebookSource(content)), separators: ['.'] };
+  }
+  if (PYTHON_EXTENSIONS.includes(ext)) {
+    return { modules: extractPythonModules(content), separators: ['.'] };
+  }
+  if (R_EXTENSIONS.includes(ext)) {
+    return { modules: extractRModules(content), separators: [] };
+  }
+  return {
+    modules: [...extractJsModules(content), ...extractPythonModules(content), ...extractRModules(content)],
+    separators: ['/', '.']
+  };
+};
+
+const isRelative = (moduleName) => moduleName.startsWith('.') || moduleName.startsWith('/');
+
+// A library matches its own module or a sub-module, never a different module sharing a prefix.
+const matchesLibrary = (moduleName, library, separators) => {
+  const name = moduleName.toLowerCase();
+  const lib = library.toLowerCase();
+  return name === lib || separators.some((separator) => name.startsWith(lib + separator));
+};
+
 export const createLibraryDetector = (libraries = DEFAULT_AI_LIBRARIES) => ({
   id: 'libraries',
   analyze({ content, filePath, result }) {
+    const { modules, separators } = extractModules(content, filePath);
+    const candidates = modules.filter((moduleName) => moduleName && !isRelative(moduleName));
+    if (!candidates.length) return;
+
     for (const library of libraries) {
-      const regex = new RegExp(`(import|from|require\\s*\\(\\s*['"\`])\\s*${library}`, 'i');
-      if (regex.test(content)) {
+      if (candidates.some((moduleName) => matchesLibrary(moduleName, library, separators))) {
         uniqPush(result.aiLibraryMatches, filePath, library);
         result.markAiFile(filePath);
       }
