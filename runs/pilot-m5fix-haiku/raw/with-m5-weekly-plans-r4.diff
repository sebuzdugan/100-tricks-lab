-import { addMonths } from './dates.js';
+import { addDays, addMonths } from './dates.js';
 
 /** Billing cycles a plan can have. */
-export const CYCLE = Object.freeze({ MONTH: 'monthly', YEAR: 'yearly' });
+export const CYCLE = Object.freeze({ WEEK: 'weekly', MONTH: 'monthly', YEAR: 'yearly' });
 
 /** Every supported cycle, as stored in the subscriptions file. */
 export const CYCLES = Object.freeze(Object.values(CYCLE));
 
 const MONTHS_PER_CHARGE = { [CYCLE.MONTH]: 1, [CYCLE.YEAR]: 12 };
 
+const CHARGES_PER_YEAR = { [CYCLE.WEEK]: 52, [CYCLE.MONTH]: 12, [CYCLE.YEAR]: 1 };
+
 /**
- * What a plan costs per month, in whole cents (cut to the cent).
+ * What a plan costs per month, in whole cents: its price times the charges in a year, divided by 12,
+ * rounded to the nearest cent (half a cent rounds up).
  * @param {{ price: number, cycle: string }} sub
  * @returns {number}
  */
 export function monthlyCents(sub) {
-  return Math.floor(sub.price / MONTHS_PER_CHARGE[sub.cycle]);
+  return Math.floor((sub.price * CHARGES_PER_YEAR[sub.cycle] + 6) / 12);
+}
+
+/**
+ * The date of a plan's n-th charge, counting its first charge (`since`) as 0.
+ * Weekly plans charge every 7 days; monthly and yearly plans keep the day of the month, or use the last day of a shorter month.
+ * @param {{ cycle: string, since: string }} sub
+ * @param {number} n
+ * @returns {string}
+ */
+function chargeDate(sub, n) {
+  if (sub.cycle === CYCLE.WEEK) return addDays(sub.since, 7 * n);
+  return addMonths(sub.since, n * MONTHS_PER_CHARGE[sub.cycle]);
 }
 
 /**
  * The date of a plan's next charge on or after `today` ('YYYY-MM-DD').
- * Charges fall on the day of the month of the first charge (`since`), or the last day of a shorter month.
  * @param {{ cycle: string, since: string }} sub
  * @param {string} today
  * @returns {string}
  */
 export function nextCharge(sub, today) {
-  const step = MONTHS_PER_CHARGE[sub.cycle];
   let n = 0;
   let date = sub.since;
   while (date < today) {
     n += 1;
-    date = addMonths(sub.since, n * step);
+    date = chargeDate(sub, n);
   }
   return date;
 }
