+// a charge's monthly cost is price * N / 12 (a week is 52/12 of a month)
+const TWELFTHS_PER_MONTH = { [CYCLE.WEEK]: 52, [CYCLE.MONTH]: 12, [CYCLE.YEAR]: 1 };
