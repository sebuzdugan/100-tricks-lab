+/** A field line whose colon sits inside the bold markers, e.g. `- **Retention:**` with nothing after it. */
+const EMPTY_FIELD_COLON_IN_LABEL = /^\s*[-*]\s*\*\*[^*]+:\*\*\s*$/;
+
+function indentOf(line: string): number {
+  return line.match(/^\s*/)?.[0]?.length ?? 0;
+}
+
+/** Collects the indented continuation lines that sit below `lines[index]` (its "answer block"), stopping at the next line of equal-or-lesser indentation. Blank lines in between are kept. */
+function collectNestedBlock(lines: string[], index: number): string {
+  const indent = indentOf(lines[index]);
+  const collected: string[] = [];
+  for (let i = index + 1; i < lines.length; i += 1) {
+    const line = lines[i];
+    if (line.trim() === '') {
+      collected.push(line);
+      continue;
+    }
+    if (indentOf(line) <= indent) break;
+    collected.push(line);
+  }
+  return collected.join('\n');
+}
+
+function hasNestedContentBelow(lines: string[], index: number): boolean {
+  return collectNestedBlock(lines, index).trim() !== '';
+}
+
+/** Field lines that look unanswered on their own line, but whose value actually sits in an indented block below (nested bullets, a table, a paragraph) are not unanswered. */
+function findEmptyFieldLines(body: string): string[] {
+  const lines = body.split(/\r?\n/);
+  const empty: string[] = [];
+  for (let i = 0; i < lines.length; i += 1) {
