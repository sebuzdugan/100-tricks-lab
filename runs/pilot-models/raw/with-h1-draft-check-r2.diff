+  const flush = () => {
+    if (!current) return;
+    const hasExtra = current.extra.some((l) => l.trim() !== '');
+    fields.push({
+      label: current.label,
+      raw: current.raw,
+      text: [current.value, ...current.extra].join('\n').trim(),
