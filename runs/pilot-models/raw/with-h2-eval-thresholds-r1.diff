 const ensureArray = (value) => (Array.isArray(value) ? value : []);
 
+export class ThresholdValidationError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ThresholdValidationError';
+  }
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  const validIds = evaluations.map((metric) => metric.id);
+
+  const results = Object.entries(thresholds).map(([metricId, min]) => {
+    if (typeof min !== 'number' || Number.isNaN(min) || min < 0 || min > 1) {
+      throw new ThresholdValidationError(
+        `Invalid threshold minimum for "${metricId}": ${min}. Minimum must be a number between 0 and 1.`
+      );
+    }
+
+    const evaluation = evaluations.find((metric) => metric.id === metricId);
+    if (!evaluation) {
+      throw new ThresholdValidationError(
+        `Unknown metric "${metricId}" in threshold. Valid metric ids: ${validIds.join(', ')}.`
+      );
+    }
+
+    const score = typeof evaluation.score === 'number' ? evaluation.score : null;
+    const passed = score !== null && score >= min;
+
+    return { metric: metricId, min, score, passed };
+  });
+
+  return {
+    thresholds: results,
+    passed: results.every((result) => result.passed)
+  };
+}
