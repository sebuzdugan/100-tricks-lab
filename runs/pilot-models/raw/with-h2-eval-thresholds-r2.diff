+export class ThresholdError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ThresholdError';
+  }
+}
+
+function evaluateThresholds(thresholds, evaluations) {
+  const validIds = evaluations.map((metric) => metric.id);
+
+  return Object.entries(thresholds).map(([metric, min]) => {
+    if (!validIds.includes(metric)) {
+      throw new ThresholdError(
+        `Unknown metric "${metric}" in --threshold. Valid metric ids: ${validIds.join(', ')}.`
+      );
+    }
+    if (typeof min !== 'number' || !Number.isFinite(min) || min < 0 || min > 1) {
+      throw new ThresholdError(
+        `Invalid threshold minimum for metric "${metric}": must be a number between 0 and 1.`
+      );
+    }
+
+    const metricResult = evaluations.find((candidate) => candidate.id === metric);
+    const score = typeof metricResult.score === 'number' ? metricResult.score : null;
+    const passed = score !== null && score >= min;
+
+    return { metric, min, score, passed };
+  });
+}
