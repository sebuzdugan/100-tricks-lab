+const isCommentLine = (line) => /^\s*#/.test(line);
+
+const buildDefinitionPattern = (name) => new RegExp(`^(\\s*)(export\\s+)?${name}\\s*=(.*)$`);
+
+const stripUnquotedComment = (value) => {
+  for (let i = 0; i < value.length; i += 1) {
+    if (value[i] === '#' && (i === 0 || /\s/.test(value[i - 1]))) {
+      return value.slice(0, i);
+    }
+  }
+  return value;
 };
 
-export const hasLocalApiKey = (cwd = process.cwd()) => fs.existsSync(resolveLocalEnvPath(cwd));
+const parseAssignedValue = (rawValue) => {
+  let i = 0;
+  while (i < rawValue.length && /\s/.test(rawValue[i])) i += 1;
+  const quote = rawValue[i];
+  if (quote === '"' || quote === "'") {
+    let j = i + 1;
+    let value = '';
+    while (j < rawValue.length && rawValue[j] !== quote) {
+      value += rawValue[j];
+      j += 1;
+    }
+    return value;
+  }
+  return stripUnquotedComment(rawValue.slice(i)).trim();
+};
+
+// Scans top to bottom so a later definition overrides an earlier one, matching shell `.env` semantics.
+const readEnvValue = (content, name) => {
+  const pattern = buildDefinitionPattern(name);
+  let value = null;
+  for (const line of content.split(/\r?\n/)) {
+    if (isCommentLine(line)) continue;
+    const match = line.match(pattern);
+    if (!match) continue;
+    value = parseAssignedValue(match[3]);
+  }
+  return value;
+};
+
+// Rewrites only the matched (last, uncommented) definition line in place; every other line is left byte-for-byte.
+const upsertEnvValue = (content, name, value) => {
+  const hasTrailingNewline = content === '' || /\r?\n$/.test(content);
+  const lines = content.length ? content.split(/\r?\n/) : [];
+  if (hasTrailingNewline && lines.length) lines.pop();
+
+  const pattern = buildDefinitionPattern(name);
+  let lastIndex = -1;
+  let exportPrefix = '';
+  lines.forEach((line, index) => {
+    if (isCommentLine(line)) return;
+    const match = line.match(pattern);
+    if (!match) return;
+    lastIndex = index;
+    exportPrefix = match[2] ? 'export ' : '';
+  });
+
+  const newLine = `${exportPrefix}${name}=${value}`;
+
+  if (lastIndex === -1) {
+    lines.push(newLine);
+  } else {
+    lines[lastIndex] = newLine;
+  }
+
+  return `${lines.join('\n')}\n`;
+};
 
