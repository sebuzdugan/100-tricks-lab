diff --git a/packages/frai-core/src/scanners/imports.js b/packages/frai-core/src/scanners/imports.js
new file mode 100644
index 0000000..f0110f1
--- /dev/null
+++ b/packages/frai-core/src/scanners/imports.js
@@ -0,0 +1,109 @@
+const JS_LIKE_EXTENSIONS = new Set(['.js', '.jsx', '.ts', '.tsx', '.mjs', '.cjs', '.mts', '.cts']);
+
+const stripComments = (content, { lineToken, blockComments }) => {
+  let result = '';
+  let inString = null;
+  const length = content.length;
+
+  for (let i = 0; i < length; i += 1) {
+    const ch = content[i];
+
+    if (inString) {
+      result += ch;
+      if (ch === '\\' && i + 1 < length) {
+        result += content[i + 1];
+        i += 1;
+        continue;
+      }
+      if (ch === inString) inString = null;
+      continue;
+    }
+
+    if (ch === '"' || ch === "'" || ch === '`') {
+      inString = ch;
+      result += ch;
+      continue;
+    }
+
+    if (blockComments && ch === '/' && content[i + 1] === '*') {
+      const end = content.indexOf('*/', i + 2);
+      i = end === -1 ? length : end + 1;
+      continue;
+    }
+
+    if (content.startsWith(lineToken, i)) {
+      const nl = content.indexOf('\n', i);
+      if (nl === -1) {
+        i = length;
+      } else {
+        result += '\n';
+        i = nl;
+      }
+      continue;
+    }
+
+    result += ch;
+  }
+
+  return result;
+};
+
+const stripJsComments = (content) => stripComments(content, { lineToken: '//', blockComments: true });
+const stripHashComments = (content) => stripComments(content, { lineToken: '#', blockComments: false });
+
+const JS_IMPORT_PATTERNS = [
+  /\bimport\s*\(\s*(['"`])([^'"`]+)\1/g,
+  /\brequire\s*\(\s*(['"`])([^'"`]+)\1/g,
+  /\bimport\s+(?:type\s+)?[^;'"`]*?\bfrom\s*(['"`])([^'"`]+)\1/g,
+  /\bexport\s+(?:type\s+)?[^;'"`]*?\bfrom\s*(['"`])([^'"`]+)\1/g,
+  /\bimport\s*(['"`])([^'"`]+)\1/g
+];
+
+const extractJsModules = (content) => {
+  const cleaned = stripJsComments(content);
+  const modules = [];
+  for (const pattern of JS_IMPORT_PATTERNS) {
+    let match;
+    while ((match = pattern.exec(cleaned))) {
+      modules.push(match[2]);
+    }
+  }
+  return modules;
+};
+
+const extractDottedImportModules = (content) => {
+  const cleaned = stripHashComments(content);
+  const modules = [];
+
+  for (const rawLine of cleaned.split('\n')) {
+    const line = rawLine.trim();
+
+    const fromMatch = line.match(/^from\s+([A-Za-z_][\w.]*)\s+import\b/);
+    if (fromMatch) {
+      modules.push(fromMatch[1]);
+      continue;
+    }
+
+    const importMatch = line.match(/^import\s+(.+)$/);
+    if (importMatch) {
+      const names = importMatch[1].split(',');
+      for (const name of names) {
+        const cleanedName = name
+          .trim()
+          .replace(/;$/, '')
+          .split(/\s+as\s+/i)[0]
+          .trim();
+        if (cleanedName) modules.push(cleanedName);
+      }
+    }
+  }
+
+  return modules;
+};
+
+export const extractImportedModules = (content, extension) => {
+  if (JS_LIKE_EXTENSIONS.has(extension)) {
+    return extractJsModules(content);
+  }
+  return extractDottedImportModules(content);
+};
