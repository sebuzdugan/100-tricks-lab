+function parseThresholds(thresholdStrings?: string | string[]): Record<string, number> {
+  if (!thresholdStrings) return {};
+
+  const thresholds: Record<string, number> = {};
+  const thresholdArray = Array.isArray(thresholdStrings) ? thresholdStrings : [thresholdStrings];
+
+  const validMetrics = ['exact_match', 'toxicity', 'length_variance'];
+
+  for (const threshold of thresholdArray) {
+    const match = threshold.match(/^([a-z_]+)=([0-9.]+)$/);
+    if (!match) {
+      throw new Error(`Malformed threshold: "${threshold}". Expected format: <metric>=<number>`);
+    }
+
+    const [, metricId, valueStr] = match;
+    const value = Number.parseFloat(valueStr);
+
+    if (!validMetrics.includes(metricId)) {
+      throw new Error(`Unknown metric id: "${metricId}". Valid metrics: ${validMetrics.join(', ')}`);
+    }
+
+    if (!Number.isFinite(value) || value < 0 || value > 1) {
+      throw new Error(`Invalid threshold value: ${valueStr}. Must be a number between 0 and 1.`);
+    }
+
+    thresholds[metricId] = value;
+  }
+
+  return thresholds;
+}
