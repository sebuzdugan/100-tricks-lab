+function isLibraryImported(content, library) {
+  // Escape special regex characters in library name, but preserve @ and /
+  const escapedLibrary = library.replace(/[.+?^${}()|[\]\\]/g, '\\$&');
+
+  // Check for scoped packages like @anthropic-ai/sdk or @langchain/...
+  if (library.startsWith('@')) {
+    // For @namespace/package, match the exact scope/package or @namespace/* variants
+    if (library.includes('/')) {
+      // Check if this is an @namespace match that should be mapped to the base @namespace
+      if (library === '@langchain' || library.startsWith('@langchain/')) {
+        const langchainPattern = /['"`]\s*@langchain(?:\/[a-zA-Z0-9\-]+)?\s*['"`]/;
+        return langchainPattern.test(content);
+      }
+
+      // For other scoped packages, match exactly (in quotes only)
+      const exactPattern = new RegExp(
+        `['"\`]\\s*${escapedLibrary}(?:\\/[a-zA-Z0-9\\-\\.]+)?\\s*['"\`]`,
+        'g'
+      );
+      return exactPattern.test(content);
+    }
+  }
+
+  // For regular packages, check both JS/TS style (in quotes) and Python style (bare imports)
+  // But Python style should be context-aware to avoid false positives
+  const jsPattern = new RegExp(`['"]\s*${escapedLibrary}(?:\\/[a-zA-Z0-9\\-\\.]+)?\s*['"\`]`, 'g');
+
+  // Check JS/TS style first
+  if (jsPattern.test(content)) {
+    return true;
+  }
+
+  // For Python style, only match if it appears in import/from contexts
+  // Patterns: "import X", "from X", "from X.Y", "import X.Y", etc.
+  const pythonPattern = new RegExp(
+    `(?:^|\\n|;)\\s*(?:import|from)\\s+${escapedLibrary}(?:\\.|\\s|$|,)`,
+    'gm'
+  );
+
+  return pythonPattern.test(content);
+}
